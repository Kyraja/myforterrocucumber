..!interpreter english translate noabbrev
..**************************************************************
.. FOP-Name       : APLANISTVERGL.BFUSS
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : "Knoten ”ffnen"-FOP
.. Functionality  :
.. Includes
..**************************************************************
.set trans -
.type integer xstufe ? _F|defined(U|xstufe)
..
.continue END ? M|ianzstufe = 0 
.continue END ? M|tzeilen = 0
..
.formula U|xstufe = 0
..
!HEADER
.continue END ? U|xstufe = M|ianzstufe
.select screen header
..
!LINE
.select screen line
.formula U|xstufe = U|xstufe + 1 ? _G|mehr
.continue HEADER ? _G|mehr
.continue LINE   ? M|tbaumstat = "-" ; M|tbaumstat = ""
.continue LINE   ? M|tbaumstufe = M|ianzstufe
..
.. declarations for some parameters which might be used in subroutines
.type integer  xrowsbefore  ? _F|defined(U|xrowsbefore)
..
!OPEN: handle opening of the knot by calling of some subroutines
.formula U|xrowsbefore = M|tzeilen
.continue GETKNOT ? _F|defined(M|beforeopen)
.input 'M|beforeopen' ? _F|empty(M|beforeopen)
..
!GETKNOT
.formula M|tbaumstat = "-" ? M|ianzstufe > 0
.continue DETAILS ? _F|defined(M|openknot)
.input 'M|openknot' ? _F|empty(M|openknot)
..
.continue DETAILS ? _F|defined(M|afteropen)
.input 'M|afteropen' ? _F|empty(M|afteropen)
.continue DETAILS
..
!DETAILS: loading row details of clicked row in the mask header by a subroutine
.continue LINE 
..
!END
.continue
