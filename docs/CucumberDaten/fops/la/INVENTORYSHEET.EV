..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVENTORYSHEET.EV
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.type text texthinweis  ? _F|defined(U|texthinweis)
.type text sys          ? _F|defined(U|sys)
..
.copy M|bposnr = G|TRUE    ? _M|bplsarts & _M|bplsartn & _M|bartspls & _M|bartnpln & _M|bartnapls & _M|bplsartna & _M|bplsbehnartn & _M|bplsbehnarts & _M|bplsbehnartna
.. Sortierungen: jetzigen Positionsnummern
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bposnr"
.. Sortierungen: Platzsuchwort und Artikelsuchwort
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsarts"
.. Sortierungen: Platzsuchwort und Artikelnummer
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsartn"
.. Sortierungen: Artikelsuchwort und Platzsuchwort
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartspls"
.. Sortierungen: Artikelnummer und Platznummer
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartnpln"
.. Sortierungen: Artikelname und Platzsuchwort
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartnapls"
.. Sortierungen: Platzsuchwort und Artikelname
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsartna"
.. Sortierungen: Platzsuchwort, BehÑlternummer und Artikelnummer
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsbehnartn"
.. Sortierungen: Platzsuchwort, BehÑlternummer und Artikelsuchwort
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsbehnarts"
.. Sortierungen: Platzsuchwort, BehÑlternummer und Artikelbezeichnung
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsbehnartna"
..
.. Leerzeilen
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bleerzeilen"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "zaehllistenr"
.continue TAB     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue END
..
!RADIOBU: Handle radio button for type of sort
.copy M|bposnr        = G|FALSE  ? M|bposnr        & G|evtvar <> "bposnr"
.copy M|bplsarts      = G|FALSE  ? M|bplsarts      & G|evtvar <> "bplsarts"
.copy M|bplsartn      = G|FALSE  ? M|bplsartn      & G|evtvar <> "bplsartn"
.copy M|bartspls      = G|FALSE  ? M|bartspls      & G|evtvar <> "bartspls"
.copy M|bartnpln      = G|FALSE  ? M|bartnpln      & G|evtvar <> "bartnpln"
.copy M|bartnapls     = G|FALSE  ? M|bartnapls     & G|evtvar <> "bartnapls"
.copy M|bplsartna     = G|FALSE  ? M|bplsartna     & G|evtvar <> "bplsartna"
.copy M|bplsbehnartn  = G|FALSE  ? M|bplsbehnartn  & G|evtvar <> "bplsbehnartn"
.copy M|bplsbehnarts  = G|FALSE  ? M|bplsbehnarts  & G|evtvar <> "bplsbehnarts"
.copy M|bplsbehnartna = G|FALSE  ? M|bplsbehnartna & G|evtvar <> "bplsbehnartna"

.copy M|bposnr = G|TRUE    ? _M|bplsarts & _M|bplsartn & _M|bartspls & _M|bartnpln & _M|bartnapls & _M|bplsartna & _M|bplsbehnartn & _M|bplsbehnarts & _M|bplsbehnartna
.formula M|sort = 1  ? M|bposnr
.formula M|sort = 2  ? M|bplsartn
.formula M|sort = 3  ? M|bartnpln
.formula M|sort = 4  ? M|bplsartna
.formula M|sort = 5  ? M|bplsarts
.formula M|sort = 6  ? M|bartspls
.formula M|sort = 7  ? M|bartnapls
.formula M|sort = 8  ? M|bplsbehnartn
.formula M|sort = 9  ? M|bplsbehnarts
.formula M|sort = 10 ? M|bplsbehnartna
..
.set trans +
.. Items are renumbered when sorting occurs and written into the stocktaking lines
.formula U|texthinweis = "Beim Umsortieren werden die Positionsnummern neu berechnet und in die Inventurzeilen geschrieben."
.set trans -
..
.note ZÑhlliste wird fÅr den Druck aktualisiert.
.formula M|hinweis = U|texthinweis
.formula M|hinweis = ""              ? G|evtvar = "bposnr"
.continue CLRTAB
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
.copy M|gedruckt = G|FALSE
.continue END
..
!TAB: Tabelle fÅllen und temporÑre Datei lîschen / fill table and delete temporary file
.copy M|gedruckt = G|FALSE
.input 'M|tab'  ? _F|empty(M|tab)
..
.formula U|sys = "rm -f " + U|iosort
.system 'U|sys' background
.formula U|sys = "rm -f " + U|invobj
.system 'U|sys' background
..*****************************************************************************
!END
.continue
