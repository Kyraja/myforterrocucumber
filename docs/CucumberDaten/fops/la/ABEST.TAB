..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABEST.TAB
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Erzeugt eine Tabellenzeile im Artikelbestand
.. Ablauf         : Tabellenzeige-EFOP des Artikelbestands
.. Includes       :
.. include la/ABEST.BA
.. include la/ABEST.LJ2
..*****************************************************************************
.set trans -
.type ID2   xtart      ? _F|defined(U|xtart)
.type GD    xanf       ? _F|defined(U|xanf)
.type GD    xend       ? _F|defined(U|xend)
.type text  xnum       ? _F|defined(U|xnum)
.type text  xid        ? _F|defined(U|xid)
.type text  xsuch      ? _F|defined(U|xsuch)
.type text  xtlgrid    ? _F|defined(U|xtlgrid)
.type text  xtjlgrid   ? _F|defined(U|xtjlgrid)
.type text  xtjlgrid2  ? _F|defined(U|xtjlgrid2)
.type P5:1  xbestand   ? _F|defined(U|xbestand)
.type bool  xbanf      ? _F|defined(U|xbanf)
.type text  xsel       ? _F|defined(U|xsel)
.type A79   xbsart     ? _F|defined(U|xbsart)
..
.formula U|xbsart = H|bsart
.continue SPEZ   ? M|blgruppe
.. externe Lagergruppeneigenschaften prÅfen
.formula U|xsel ="$,,art=" + H|id + ";lgruppe=" + M|klgruppe^id +  ";@gruppe=3;@ablageart=(Active)"
.load 6 warehousedata 'U|xsel'
.. wenn nicht mehr, dann regulÑr auf externer Lagergruppe prÅfen
.continue INTERN ? _G|mehr
.formula U|xbsart = 6|bsart
.load 6
..
!INTERN 
.continue SPEZ  ?  M|beigen & M|bfremd & M|bumlagern & M|blohnfert
.continue SPEZ  ? F|equals(U|xbsart, "(InhouseProduction)") & M|beigen
.continue SPEZ  ? F|equals(U|xbsart, "(ExternalProcurement)") & M|bfremd
.continue SPEZ  ? F|equals(U|xbsart, "(Relocation)") & M|bumlagern
.continue SPEZ  ? F|equals(U|xbsart, "(Subcontracting)") & M|blohnfert
.continue END
..
!SPEZ
.formula H|lgruppean = M|klgruppe^id  ? _M|blgruppe
.select group 'M|grliste' 'M|select'  ?  M|blgruppe & U|xbanf
.formula U|xbanf = G|FALSE
..
.formula U|xid     = H|id
.formula U|xnum    = H|nummer
.formula U|xsuch   = H|such
.formula U|xanf    = M|von
.formula U|xend    = M|bis
.formula U|xtlgrid = M|klgruppe^id
..
..  geplante Zu- und AbgÑnge aus Plankarte
.input "la/ABEST.BA"
..  Zu-/AbgÑnge, Anfangs-/Endbestand aus LJ
..  Receipts/issues, opening balances/ closing balance of stock journal
.input "la/ABEST.LJ2"
..
.assign U|xbestand = H|aufgrp^bestand
.assign U|xbestand = F|sysinfo(7)^wgruppe^bestand ? F|empty(U|xbestand)
.continue END ? U|xpmge=0 & U|xmge=0 & U|xzumge=0 & U|xabmge=0 & U|xabest=0 & U|xebest=0 & U|xaktbest =0 & _M|bnullzeilen
..
.make screen line +O
.formula M|tartikel  = H|id
.assign  M|bsart     = U|xbsart
.formula M|pmge      = U|xpmge
.formula M|mge       = U|xmge
.formula M|zumge     = U|xzumge
.formula M|abmge     = U|xabmge
.formula M|korrmge   = U|xrkorr
.formula M|abest     = U|xabest
.formula M|ebest     = U|xebest
.formula M|aktbest   = U|xaktbest
.formula M|pebest    = M|ebest - M|pmge + M|mge
..
!END
.continue
