..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VSTATUS.DET
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
..
.. Funktion       : Infosystem VSTATUS, alles aufklappen
...Includes       :
.. include la/BSTATUS.FARBE
..*****************************************************************************
.set trans -
.type integer xletzte  ? _F|defined(U|xletzte)
.type bool    xdel     ? _F|defined(U|xdel)
.type GL15    xverwend ? _F|defined(U|xverwend)
.type PS86:1  xprojekt ? _F|defined(U|xprojekt)
.type ARTR51002 xzug   ? _F|defined(U|xzug)
..
.continue AUFKLAPP    ?  M|bstl=-1
.continue ENDHOL
..
!AUFKLAPP
.continue ENDHOL ? M|tbaumstufe + 1 > M|anzstufen & _M|letzte
.formula M|bstl  = +1
.formula M|aufzu = "icon:folder_opened"
..
!AUFRES: im VSTATUS aufklappen
.select add M|reserv
.continue SELLINE   ? _G|mehr
.formula U|xverwend = ""
.formula U|xprojekt = ""
.formula U|xzug = ""
.formula U|xverwend = M|verwendung
.copy U|xprojekt   = M|projekt
.copy U|xzug = M|zug
.formula M|stufe =  M|tbaumstufe + 1
.select add H|vor
.continue ENDHOL    ? _G|mehr
.input 'M|tab'      ? _F|empty(M|tab)
..
.continue AUFKLAPP  ?  M|bstl=-1
..
!SELLINE
.formula M|verwendung = U|xverwend  ? _F|empty(U|xverwend) & F|empty(M|verwendung)
.copy M|projekt = U|xprojekt        ? _F|empty(U|xprojekt) & F|empty(M|projekt)
.copy M|zug = U|xzug                ? _F|empty(U|xzug) & F|empty(M|zug)
.select screen line
.continue ENDHOL    ? _G|mehr
.continue AUFKLAPP  ?  M|bstl=-1
.continue SELLINE
..
!ENDHOL: alles geholt
.select screen header
.formula U|xletzte = M|tzeilen
.assign P|maskkontextfop = "Plan" ? M|letzte
.copy M|detail = G|FALSE          ? M|letzte
.continue LETZTE                  ? M|letzte
.select screen line
.input "la/BSTATUS.FARBE"
.continue END
..
!LETZTE
.select screen line 'U|xletzte'
.continue END ? _G|mehr
..
.assign M|color = "-1 -1 -1"
.colour -background 'M|color' 'M|aktzeile'
.copy U|xdel = G|FALSE 
.copy U|xdel = G|TRUE   ? _F|empty(M|aufzu)
..
!DEL
.make screen line -O    ?  U|xdel
.continue DEL           ? _F|empty(M|aufzu)
..
.formula U|xletzte = M|aktzeile
.formula U|xletzte = U|xletzte - 1 
.continue END ? U|xletzte <= 0
.continue LETZTE 
..
!END
.continue
