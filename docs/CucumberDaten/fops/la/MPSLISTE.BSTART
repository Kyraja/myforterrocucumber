..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : MPSLISTE.BSTART
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
..
.. Program flow   :
...Includes       :
..*****************************************************************************
.set trans -
.type integer  xisuch          ? _F|defined(U|xisuch)
.type PS2  xvart           ? _F|defined(U|xvart)
.type bool xbleadingdigit  ? _F|defined(U|xbleadingdigit)
.type text xselect         ? _F|defined(U|xselect)
..
.. initialize with '0': search "nummer"
.. this index is used to assign the query key at end of fop
.formula U|xisuch = 0
..
.. does configuration allow leading numbers in search word?
.. only need to check config one time
.formula U|xbleadingdigit = F|sysinfo(18)^swziffern
..
.. initialize search parameters
.. only reading group 1: products !
.formula U|xselect = "$,,;@gruppe=1"
..
.. adding parameters for search word
.. if search word allows leading numbers, the search word key is
.. always used instead of the number key
.continue NOSUCH ? M|kartvon = "" & M|kartbis = ""
.continue SUCH   ? U|xbleadingdigit
.continue NOSUCH ? ( M|kartvon << 1 ) /"(0-9)"
.continue NOSUCH ? ( M|kartbis << 1 ) /"(0-9)"
..
!SUCH
.formula M|kartvon = -M|kartvon
.formula M|kartbis = -M|kartbis
.formula U|xselect = U|xselect + ";such=" + M|kartvon + "!" + M|kartbis
.formula U|xisuch = 1
..
!NOSUCH
.continue TEST  ? U|xisuch > 0
.formula U|xselect = U|xselect + ";nummer=" + M|kartvon + "!" + M|kartbis
.formula U|xisuch = 0
..
!TEST
.assign U|xvart = U|xselect + ";@lesen=" + 'FALSE'
.continue ERRRANGE   ? _G|mehr
.input "is/TABLEEREN"
..
.input 'M|tab'
.continue END
..*****************************************************************************
!END
.continue
..
!ERRRANGE
.error
.end 1
