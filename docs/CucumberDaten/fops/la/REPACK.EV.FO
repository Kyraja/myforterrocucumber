.set trans -
..
..<META M|='la/REPACK'>
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue ITEM    ?  G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "kbuposition"
.continue STRUKT  ?  G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue COUNT   ?  G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "kbuanzpackmit"
.continue DIFF    ?  G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "kbudiffpackmit"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!STRUKT
.formula P|maskkontextfop = "struktur anzahl"
.continue END
..
!COUNT 
.formula P|maskkontextfop = "anzahl status"
.continue END
..
!DIFF 
.formula P|maskkontextfop = "diff"
.continue END
..
!ITEM
.assign M|kposition = 'F|formatstr("%,,;@gruppe=2;@autostart=(Yes);artikel={1};mge=;packanw=;fmenge=;kunde={2};kopf={3};.stufe=0;.kotyp=(4)", M|kartikel^id, M|kkunde^id, M|kvorgang^id)'
.continue END
..
..*****************************************************************************
!END
.continue
