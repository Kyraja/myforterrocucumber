..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : PLANSHOW.BFUSS
..  Datum          : 04.05.2004
..  Version        :
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Infosystem, Berichtsfuss
..                   Artikel mit Anzahl Plankartenzeilen
..
..  Functionality  : Infosystem,
..*****************************************************************************
.set trans -
.type text xsys xpart xplgruppe
.type IP9 xanz
..
?'M|anz' 'M|part' 'M|plgruppe' ? M|anz>0
.output terminal
.formula U|xsys = "sort -nr +0 -1 -o " + M|tmpname + " " + M|tmpname
.system 'U|xsys' background
.copy M|sammeln = G|false
..
!HOLEN
.select from 'U|xout' U|xanz U|xpart U|xplgruppe
.continue         ? _G|mehr
.continue         ? U|xanz < M|kanz
.formula M|anz       = U|xanz
.formula M|part      = U|xpart
.formula M|plgruppe  = U|xplgruppe
.input 'M|tab'
..
.continue HOLEN
