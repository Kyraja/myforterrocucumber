..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APLANISTVERGL.STUFE
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :  
.. Functionality  :
..
..*****************************************************************************
..
.set trans -
.type bool    xgleich      ? _F|defined(U|xbgleich)
.type bool    xtreffer     ? _F|defined(U|xtreffer)
.type bool    xzweit       ? _F|defined(U|xzweit)
.type bool    xfirst       ? _F|defined(U|xfirst)
.type integer xiaktzeile   ? _F|defined(U|xiaktzeile)
.type DVS1    xmerkmgepos  ? _F|defined(U|xmerkmgepos)
.type DVS1    xmerkmgeneg  ? _F|defined(U|xmerkmgeneg)
.type DVS1    xmerkwertpos ? _F|defined(U|xmerkwertpos)
.type DVS1    xmerkwertneg ? _F|defined(U|xmerkwertneg)
.type DVS1    xmerk1       ? _F|defined(U|xmerk1)
.type DVS1    xmerk2       ? _F|defined(U|xmerk2)
.type DVS1    xmerk3       ? _F|defined(U|xmerk3)
.type DVS1    xmerk4       ? _F|defined(U|xmerk4)
..
.formula U|xmerkmgepos = ""
.formula U|xmerkmgeneg = ""
.formula U|xmerkwertpos = ""
.formula U|xmerkwertneg = ""
..
.formula U|xmerk1= ""
.formula U|xmerk2= ""
.formula U|xmerk3= ""
.formula U|xmerk4= ""
..
.copy U|xzweit = G|FALSE
.copy U|xfirst = G|FALSE
..
.select screen header
.continue END ? M|tzeilen = 0
.formula U|xiaktzeile = M|tzeilen
..
!LAST: Select last line
.select screen line 'U|xiaktzeile'
.continue END ? _G|mehr
..
.continue SEL
..
!SEL: auswerten
.continue FIRST ? _U|xfirst
.copy U|xtreffer = G|FALSE 
.copy U|xtreffer = G|TRUE              ?  'U|xmerk1' = 'M|abwz'
.copy U|xgleich = G|FALSE
.copy U|xgleich = G|TRUE               ?  'M|abwmgepos' = 'U|xmerkmgepos'
.formula U|xmerkmgepos = M|abwmgepos
.formula U|xmerk1      = M|abwz        ? _U|xgleich 
.formula M|abwmgepos   = ""            ?  U|xgleich
.formula M|abwmgepos   = U|xmerk1      ?  M|tstufe = "0"
.copy U|xtreffer = G|FALSE 
.copy U|xtreffer = G|TRUE              ?  'U|xmerk2' = 'M|abwz'
.copy U|xgleich = G|FALSE
.copy U|xgleich = G|TRUE               ?  'M|abwmgeneg' = 'U|xmerkmgeneg'
.formula U|xmerkmgeneg = M|abwmgeneg 
.formula U|xmerk2      = M|abwz        ? _U|xgleich 
.formula M|abwmgeneg   = ""            ?  U|xgleich
.formula M|abwmgeneg   = U|xmerk2      ?  M|tstufe = "0"
.copy U|xtreffer = G|FALSE 
.copy U|xtreffer = G|TRUE              ?  'U|xmerk3' = 'M|abwz'
.copy U|xgleich = G|FALSE
.copy U|xgleich = G|TRUE               ?  'M|abwwertpos' = 'U|xmerkwertpos'
.formula U|xmerkwertpos = M|abwwertpos   
.formula U|xmerk3       = M|abwz       ? _U|xgleich 
.formula M|abwwertpos   = ""           ?  U|xgleich
.formula M|abwwertpos   = U|xmerk3      ?  M|tstufe = "0"
.copy U|xtreffer = G|FALSE 
.copy U|xtreffer = G|TRUE              ?  'U|xmerk4' = 'M|abwz'
.copy U|xgleich = G|FALSE
.copy U|xgleich = G|TRUE               ?  'M|abwwertneg' = 'U|xmerkwertneg'
.formula U|xmerkwertneg = M|abwwertneg
.formula U|xmerk4       = M|abwz       ? _U|xgleich 
.formula M|abwwertneg   = ""           ?  U|xgleich
.formula M|abwwertneg   = U|xmerk4      ?  M|tstufe = "0"
..
!FIRST
.continue STUFE ? M|tstufe ="0"
.continue FNNULL ? U|xfirst
..
!NNULL: Stufe <> 0, Last Line
.formula U|xmerkmgepos  = M|abwmgepos
.formula U|xmerkmgeneg  = M|abwmgeneg
.formula U|xmerkwertpos = M|abwwertpos
.formula U|xmerkwertneg = M|abwwertneg
.copy U|xfirst = G|TRUE
..
!FNNULL
.continue ZWEIT ? U|xzweit
.make screen line -o                  
.formula U|xiaktzeile = M|aktzeile   
.continue END  ? U|xiaktzeile = 0
.continue LAST
..
!ZWEIT
.make screen line -o 
.formula U|xiaktzeile = M|aktzeile - 1
.continue LAST
..
!STUFE: Stufe = 0, Zeile stehen lassen, xiaktzeile um eins verringern
.formula M|tbaumstat = "+"  ? M|t2baumstat = "+"
.formula U|xiaktzeile = M|aktzeile - 1
.formula U|xzweit = G|TRUE
.continue END  ? U|xiaktzeile = 0
.formula U|xmerk1= ""
.formula U|xmerk2= ""
.formula U|xmerk3= ""
.formula U|xmerk4= ""
.formula U|xmerkmgepos = ""
.formula U|xmerkmgeneg = ""
.formula U|xmerkwertpos = ""
.formula U|xmerkwertneg = ""
.copy U|xfirst = G|FALSE
.continue LAST
..
..*****************************************************************************
!END
.continue
