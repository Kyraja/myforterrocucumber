..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APLANROLL.EV
.. Autor          : foe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem Absatzplanwerte: Eventbehandlung
.. Functionality  :
.. Ablauf         : Behandelt alle Feld- und Button-Events
..*****************************************************************************
.set trans -
..
.. ----- Kopfteil-Events -----
.continue INIT       ? G|evtartengl="SCREEN_ENTER"
.continue ARTBER     ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kart"
.continue KUMMU      ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kumuliert"
.continue STARTVOR   ? G|evtartengl="BUTTON_BEFORE"  & G|evtvar="bstart"
.continue STARTNACH  ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bstart"
.continue
..
!INIT: Initialisiert Lagergruppe und Typ
.input "is/ABASFARBEN.DEF"
.formula M|farbe1 = U|xabasgrouplight 
.formula M|farbe2 = U|xabasgroupdark
.formula M|farbe3 = U|xabaslightgreen3
.formula M|farbe4 = U|xabasabaslightgreen2
..
.assign M|ktyp = "(RollingForecast)"
.copy M|klgruppe = F|sysinfo(10)^intlgruppe
.continue END
..
!STARTVOR: Prueft, ob Artikel (kart)
..         im Maskenkopf ausgefuellt sind und leert die Tabelle
..
.continue ARTOK ? _F|empty(M|kart)
.error Bitte zuerst Artikel eintragen.
.end 1
..
!ARTOK
.continue DATOK ? 'M|kadatum'="" ; 'M|kedatum'=""
.continue DATOK ? M|kadatum < M|kedatum
.error Zeitbereich nicht korrekt.
.input "is/TABLEEREN"
.end 1
..
!DATOK
.input "is/TABLEEREN"
.continue
..
!STARTNACH
.input 'M|tab'   ? _F|empty(M|tab)
.continue
..
!ARTBER: Feldaustritt Absatzplanwerte iskartber
..
.. Kopfteil fuellen
.continue ENDBER     ?  F|empty(M|kart)
..
.select add M|kart
.continue ENDBER     ? _G|mehr
.assign M|waehr = M|kart^inlwaehr
.continue ENDBER
..
!ENDBER
.make screen line --     ? M|tzeilen > 0
.continue END
..
!ENDART
.make screen line --     ? M|tzeilen > 0
.continue END
..
!KUMMU
.make screen line --     ? M|tzeilen > 0
.continue END
..
!END
.continue
