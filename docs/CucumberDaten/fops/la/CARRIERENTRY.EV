..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CARRIERENTRY.EV
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : General events info system CARRIERENTRY
..*****************************************************************************
..<META M|='la/CARRIERENTRY'>
.set trans -
..
.. Clear colors here / set new colors at end of EFOP
.colour -foreground -1 -1 -1 -background -1 -1 -1 kkreislauf 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 ksender 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 ksendergln 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 ksenderustid 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 kabm 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 kdatumvon 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 kdatumbis 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 kdokuart 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 kdatumauszug 0
.colour -foreground -1 -1 -1 -background -1 -1 -1 kkoaznr 0
..
.. event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue KREIS    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kkreislauf"
.continue ABM      ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kabm"
.continue PARTNER  ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpartner"
.continue ARTIKEL  ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kartikel"
.continue WERK     ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kwerk"
.continue KONTO    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kerfassenkonto"
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT     ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kdatumvon"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kdatumbis"
.. ----------- ---------- ---------- -------------------------------------------
.continue EDIPRNT  ?  G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kbuediprint"
.continue EDIDAT   ?  G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kbudateizeigen"
.continue BUWERK   ?  G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kbukonto"
.. ----------- ---------- ---------- -------------------------------------------
.continue END      ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kkoaznr"
.continue END      ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kdatumauszug"
.continue END      ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kdokuart"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!ABM
.formula M|kschema = M|kabm^imschema^id
.continue END
..
!EDIPRNT
.continue END    ?  F|empty(M|kschema)
.command -parallel 'F|formatstr("(Infosystem) EDIPRINT ? schema={1}|bstart=", M|kschema^id)'
.continue END
..
!EDIDAT
.continue END    ?  F|empty(M|kschema) ; F|empty(M|kdateiname)
.command -parallel 'F|formatstr("(Infosystem) EDIDAT ? kschema={1}|kdateiname={2}|bstart=", M|kschema^id, M|kdateiname)'
.continue END
..
!KREIS
.continue END    ?  F|empty(M|kkreislauf)
.copy M|ksender = M|kkreislauf^sendempf
.continue END    ?  F|empty(M|ksender)
.formula M|ksendergln = M|ksender^gln
.formula M|ksenderustid = M|ksender^ustid
.formula M|kempfaenger = M|ksender^frbez
.formula M|kpartner = ""
.formula M|kartikel = ""
.formula M|kwerk = ""
.formula M|kwerkbez = ""
.continue END
..
!BUWERK
.assign M|kerfassenkontonr = F|formatstr("%,,;nummer=;such=;sucherw=;artikel={1};partner={2};werk={3};werkname=;@autostart=(Yes)", M|kartikel^id, M|kpartner^id, M|kwerk)
.continue KONTO  ? G|mehr
.continue END
..
!PARTNER
.continue END
..
!ARTIKEL
.continue END
..
!WERK
.formula M|kwerkbez = ""
.continue END
..
!KONTO
.copy M|kartikel = M|kerfassenkontonr^artikel
.copy M|kpartner = M|kerfassenkontonr^partner
.copy M|kwerk = M|kerfassenkontonr^werk
.copy M|kwerkbez = M|kerfassenkontonr^werkname
.continue END
..
!INIT: remove rows, clear header fields
.make screen line --  ?  M|tzeilen > 0
.continue END
..
..*****************************************************************************
!END
.colour -foreground -1 -1 -1 -background 'M|colrequired' kkreislauf 0 ? F|empty(M|ksender) ; F|empty(M|ksendergln) ; F|empty(M|ksenderustid)
.colour -foreground -1 -1 -1 -background 'M|colrequired' ksender 0 ? F|empty(M|ksender)
.colour -foreground -1 -1 -1 -background 'M|colrequired' ksendergln 0 ? F|empty(M|ksendergln)
.colour -foreground -1 -1 -1 -background 'M|colrequired' ksenderustid 0 ? F|empty(M|ksenderustid)
.colour -foreground -1 -1 -1 -background 'M|colrequired' kabm 0 ? F|empty(M|kabm)
.colour -foreground -1 -1 -1 -background 'M|colrequired' kdatumvon 0 ? F|empty(M|kdatumvon)
.colour -foreground -1 -1 -1 -background 'M|colrequired' kdatumbis 0 ? F|empty(M|kdatumbis)
.colour -foreground -1 -1 -1 -background 'M|colrequired' kdokuart 0 ? F|empty(M|kdokuart)
.colour -foreground -1 -1 -1 -background 'M|colrequired' kdatumauszug 0 ? F|empty(M|kdatumauszug)
.colour -foreground -1 -1 -1 -background 'M|colrequired' kkoaznr 0 ? F|empty(M|kkoaznr)
.continue
