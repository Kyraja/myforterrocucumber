..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVSHEETCENTER.DEVALL
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : FOP zum Abwerten aller Zeilen in IS INVSHEETCENTER
..
.. include la/INVSHEETCENTER.DEV
..*****************************************************************************
.set trans -
.type bool U|xfirstline ? _F|defined(U|xfirstline)
..
.continue LINE ? U|xfirstline
..
!HEADER
.select screen header
..
!LINE
.select screen line
.continue END                   ? _G|mehr
.set trans +
.formula M|thinweis = "Z„hlliste ist bereits abgeschlossen." ?  M|tzaehlliste^ablagef
.set trans -
.continue LINE                  ?  M|tzaehlliste^ablagef 
.input "la/INVSHEETCENTER.DEV"
.copy U|xfirstline = G|TRUE
.continue LINE
..
..*****************************************************************************
!END
.continue
