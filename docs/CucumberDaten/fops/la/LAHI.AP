..!interpreter english translate noabbrev
.. ---------------------------------------------------------
.. FOP-Name             : LAHI.AP
.. Autor                : ns
.. Verantwortlich       : tiwe
.. Kontrolle            : cl
.. Funktion             : Lagerpl„tze werden aufgeklappt
.. ---------------------------------------------------------
.set trans -
..
.load 2 location 'F|formatstr("$,,lager={1};@gruppe=1;@ablageart=(Active);@ordnung=such", 1|id)'
!LADEDATEN
.continue END ? _G|mehr
..
.make screen line +O
..
.formula M|tbaumtext     = 2|sucherw
.formula M|tbaumtext     = 2|such ? F|empty(M|tbaumtext)
.formula M|tbaumstat     = ""
.formula M|tbaumstufe    = 3
..
.assign M|tplatz      = 2|id
.formula M|tpname        = 2|sucherw
.copy M|tleer       = 2|leer
.copy M|tdispo      = 2|dispo
.copy M|tauslief    = 2|auslief
.copy M|tzuplatz    = 2|zuplatz
.copy M|tabplatz    = 2|abplatz
..
.input "la/LAHI.LG"
.input "la/LAHI.LL"
..
.load 2 location
.continue LADEDATEN
.. ---------------------------------------------------------
!END
.continue
