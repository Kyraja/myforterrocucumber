..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : STOCKTAKINGDIFF.EV
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
.. Includes
.. include la/STOCKTAKINGDIFF.EMPTY
..*****************************************************************************
.set trans -
..
.continue ZLSNR     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "zlsnr"
.continue AZLSNR    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "zlvon"
.continue AZLSNR    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "zlbis"
.continue ANHANG    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "banhaengen"
.continue ABWPROZ   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "abwprozent"
.continue NURABW    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bnurabweichungen"
.continue PREISZL   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "preisauszl"
.continue END
..
!ZLSNR: number of inventory sheet
.continue TABLEEREN ? M|bfertig
.assign M|zlvon = ""
.assign M|zlbis = ""
.continue TABLEEREN  ? _M|banhaengen
.continue END
..
!AZLSNR: range
.continue TABLEEREN ? M|bfertig
.formula M|anhang  = ""
.assign M|zlsnr    = ""
.copy M|banhaengen = G|FALSE
.continue TABLEEREN
..
!ANHANG
.formula M|tmpfile = ""
.formula M|anhang  = ""
.continue TABLEEREN
!NURABW
.continue TABLEEREN
!PREISZL
.continue TABLEEREN
..
!TABLEEREN: empty table
.copy M|bfertig = G|FALSE
.input "la/STOCKTAKINGDIFF.EMPTY"
.input "is/TABLEEREN" 
.continue END
!ABWPROZ: deviation in %
.continue ERR01 ? M|abwprozent > 100
.continue ERR01 ? M|abwprozent < 0
.copy M|bnurabweichungen = G|true  ? M|abwprozent > 0
.continue TABLEEREN
!ERR01: deviation has to be between 0 and 100
.error Abweichung muss zwischen 0 und 100 % liegen.
.formula M|abwprozent = ""
.end 1
..
..*****************************************************************************
!END
.continue
