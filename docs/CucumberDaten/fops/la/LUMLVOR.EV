..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LUMLVOR.EV
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem, Umlagerungsvorschl„ge
..*****************************************************************************
.set trans -
..
.continue SREPORT ? G|evtartengl="BUTTON_AFTER"    & G|evtvar="icoattdispo"
.continue BV      ? G|evtartengl="BUTTON_BEFORE"   & G|evtvar="bstart"
.continue BSEL    ? G|evtartengl="BUTTON_AFTER"    & G|evtvar="bselect"
.continue FAV     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="von"
.continue SELECT  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="bis"
.continue SELECT  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="klgruppe"
.continue SELECT  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kablgruppe"
.continue ART     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kart"
.continue SELECT  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kkl"
.continue TOL     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="tol"
.continue SELECT  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="krit"
.continue SELECT  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kprojekt"
.continue BASIS   ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kbasisartikel"
.continue END
..
!SREPORT: View schedule report
.continue END ? F|empty(M|icoattdispo)
.command -parallel 'F|formatstr("<(Infosystem)>{1}<(Call)> ? artikel={2}|lgruppe={3}|bstart=", "10430", M|art^id, M|lgruppe^id)'
.continue END
..
!BV: Before start button
.continue END ? M|selektion
.copy M|krit = G|TRUE  ? M|tol <> 0
.continue ERROR01 ? 'M|bis' <> "" & M|bis < M|von
.copy M|selektion = G|false
.formula M|select = "$,,bsart==(Relocation);"
.formula M|select = M|select + "@ablageart=(Active);"                             ?  F|empty(M|kprojekt)
.formula M|select = M|select + "@ablageart=(Both);projekt=" + M|kprojekt^id + ";" ? _F|empty(M|kprojekt)
.formula M|select = M|select + "tsterm="    + 'M|von' + "!" + 'M|bis' + ";"
.formula M|select = M|select + "lief="+ M|kkl^id + ";" ? _F|empty(M|kkl)
.formula M|select = M|select + "lgruppe=" + M|klgruppe^id + ";" ? _F|empty(M|klgruppe)
.formula M|select = M|select + "ablgruppe=" + M|kablgruppe^id + ";" ? _F|empty(M|kablgruppe)
.formula M|select = M|select + "betreuer=" + M|betreuer^id + ";" ? _F|empty(M|betreuer)
.continue NOPART ? F|empty(M|kart)
.formula M|select = M|select + "art=" + M|kart^id + ";"
.formula M|select = M|select + "@gruppe=2.4.5;einplan=1;mateinplan=1;@ordnung=term"
.continue SELECT
..
!NOPART: Part is not selected
.formula M|select = M|select + "kopf==`;bveinplan=1;@ordnung=sterm"
.continue SELECT
..
!BSEL
.formula M|kprojekt  = ""
.formula M|select    = ""
.formula M|bis       = ""
.formula M|von       = ""
.formula M|kart      = ""
.formula M|kkl       = ""
.formula M|klgruppe  = ""
.formula M|kablgruppe  = ""
.formula G|evtfeldneu  = "%"
.input "is/AUSWAHL"
.formula M|selektion = M|select <> "!"
.continue CLRTAB
..
!TOL: Activate critical flag
.copy M|krit = G|true
.continue SELECT
..
!FAV: Set end date to start date
.copy M|bis = M|von
..
!BASIS
.formula M|kart = "" ? _F|empty(M|kbasisartikel)
.continue SELECT
..
!ART
.assign M|kbasisartikel = M|kart^basisartikel ? _F|empty(M|kart)
.continue SELECT
..
!SELECT
.copy M|selektion = G|false
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Illegal date period
.error von-Termin ist gr”áer als bis-Termin
.end 1
