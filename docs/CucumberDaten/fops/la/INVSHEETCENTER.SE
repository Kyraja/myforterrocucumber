..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVSHEETCENTER.SE
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Initializes buffer of mask.
..*****************************************************************************
.set trans -
.type text    xdParam  ? _F|defined(U|xdParam)
..
.. Initializations
..
.. Icons
.formula M|rotz   = G|icoerror
.formula M|gelbz  = G|icowarn
.formula M|gruenz = G|icook
.formula M|blauz  = G|icomessage
..
.formula M|process        = "icon:process"
.formula M|flash          = "icon:flash"
.formula M|lock           = "icon:lock"
.formula M|inveroeffnet   = "icon:ok"
.formula M|bestandsabschl = "icon:ok"
.formula M|invabgeschl    = "icon:ok"
.formula M|screenedit     = "icon:screen_edit"
.formula M|screenview     = "icon:screen_view"
..
!INI: Parameterdatei einlesen
.input "ARB"
.formula U|xdParam = U|xarb + "INVENTUR.INI"
.input 'U|xdParam'
..
.assign M|stichtag = G|datum
.copy M|dummy      = G|FALSE
.assign M|ablage   = "(Active)"
.copy M|bposnr     = G|TRUE
..*****************************************************************************
!END
.continue
