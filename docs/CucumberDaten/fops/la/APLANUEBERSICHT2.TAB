..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APLANUEBERSICHT2.TAB
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : "Knoten ”ffnen"-FOP
.. Functionality  :
...Includes       :
..                  la/ZEITTEXT
..*****************************************************************************
.set trans -
.. Anzahl Spalten in Masken-Tabelle
.type integer     xispalten   ? _F|defined(U|xispalten)
.. Aktuelle Spalte
.type integer     xiszaehl    ? _F|defined(U|xiszaehl)
.. Aktuelle Zeile
.type integer     xizeile     ? _F|defined(U|xizeile)
.. Anfangsposition relativ zur Gesamtanzahl der Werte
.type integer     xianfzeile  ? _F|defined(U|xianfzeile)
.type integer     xiaktpos0   ? _F|defined(U|xiaktpos0)
.type integer     xiaktpos    ? _F|defined(U|xiaktpos)
.type integer     xivonpos    ? _F|defined(U|xivonpos)
.type integer     xibispos    ? _F|defined(U|xibispos)
.type integer     ximaxpos    ? _F|defined(U|ximaxpos)
.type integer     xixpos      ? _F|defined(U|xixpos)
.. Anfang- und Enddatum des dargestellten Zeitabschnitts
.type GD      xanfdat     ? _F|defined(U|xanfdat)
.type GD      xenddat     ? _F|defined(U|xenddat)
.type GD      xdvondat    ? _F|defined(U|xdvondat)
.type GD      xdbisdat    ? _F|defined(U|xdbisdat)
.type text    xtztext     ? _F|defined(U|xtztext)
.type text    xtext       ? _F|defined(U|xtext)
.type text    xtraster    ? _F|defined(U|xtraster)
.type text    xtselect    ? _F|defined(U|xtselect)
.type text    xtnselect   ? _F|defined(U|xtnselect)
.type text    xttypch     ? _F|defined(U|xttypch)
.type bool    xbok        ? _F|defined(U|xbok)
.type bool    xbstart     ? _F|defined(U|xbstart)
.type ID126   xideplan    ? _F|defined(U|xideplan)
.type ID126   xindeplan   ? _F|defined(U|xindeplan)
.type integer     xistufe     ? _F|defined(U|xistufe)
.type text    xtbaumaufzu ? _F|defined(U|xtbaumaufzu)
..
.formula M|xpos      = 1
.formula U|ximaxpos  = 0
.formula U|xistufe   = M|tbaumstufe
.formula U|xispalten = 12
.formula U|xizeile   = 0
.continue UPLAN1
..
!Z1
.formula M|xpos      = U|xixpos          ? _G|mehr
.formula U|xiaktpos0 = 0
.formula U|xiaktpos  = 0
.formula U|xivonpos  = 0
.formula U|xibispos  = 0
.copy U|xbok      = G|FALSE
.continue END                            ? _G|mehr
..
.formula M|select  = "$,,eplan=" + 'U|xideplan'
.. Plandaten 'P', Basisdaten 'B' oder Istdaten 'I'
.formula U|xttypch = F|value(M|kart,"A227")
.formula M|select  = M|select + ";typ=" + 'U|xttypch' + ";abschn="
.formula M|select  = M|select + ";@ordnung=eplan,typ,abschn,archiv"
.formula M|select  = M|select + ";@ablageart=(Both);@gruppe=1"
..
!KOPF
.load 0 valuesequence 'M|select'
.continue Z2                 ? _G|mehr
..
.make screen line +O
.formula M|tbaumstufe = U|xistufe
.formula M|eplan      = 'U|xideplan'
.copy M|leplan   = M|eplan^le
.formula M|lefehl     = M|eplan^lefehl
.formula M|art        = M|kart
.formula U|xiszaehl   = 0
.copy U|xbok       = G|TRUE
.formula U|xianfzeile = M|xpos
.formula U|xtraster   = '0|raster^zraster^raster'
.formula M|tbaumstat  = U|xtbaumaufzu
..
!WANF
.continue WZENDE          ? _(U|xiszaehl < U|xispalten)
.continue WZEILE          ? U|xianfzeile > 0
.formula U|xiszaehl      = U|xiszaehl + 1
.formula U|xianfzeile    = U|xianfzeile + 1
.formula U|xtext         = "wert" + 'U|xiszaehl'
.formula M|wert.U|xiszaehl = 0.0
.continue WANF
..
!WZEILE
.continue WNEXT   ? 0|tzeilen <= 0|aktzeile
.continue WZEILE1 ? 0|aktzeile = 0
.load 0 line
.continue WZEILEA
..
!WZEILE1
.formula U|xiaktpos = U|xiaktpos0 + 0|tzeilen       ? U|xianfzeile > 0|tzeilen
.formula U|xiaktpos = U|xiaktpos0 + U|xianfzeile -1 ? U|xianfzeile <= 0|tzeilen
.continue WNEXT                                      ? U|xianfzeile > 0|tzeilen
.load 0 line 'U|xianfzeile'
..
!WZEILEA
.continue WNEXT                   ? _G|mehr
.formula U|xiaktpos = U|xiaktpos + 1
.continue WZEILE                  ? M|vondatakt > 0|bisdat
..
.. Felder
.formula U|xiszaehl = U|xiszaehl + 1
.continue WZEILE                  ? M|xpos > U|xiaktpos
.formula U|xtext    = "wert" + 'U|xiszaehl'
.formula U|xanfdat  = 0|vondat   ? U|xiszaehl = 1
.formula U|xenddat  = 0|bisdat
.formula U|xivonpos = U|xiaktpos ? U|xiszaehl = 1
.formula U|xibispos = U|xiaktpos
.formula M|wert.U|xiszaehl = 0|mge
..
.continue WSPALTE ? U|xizeile > 1 ; _U|xbok
..
.formula M|datvon.U|xiszaehl = 0|vondat
.formula M|datbis.U|xiszaehl = 0|bisdat
..
!ZEITTEXT
.formula U|xdvondat = 0|vondat
.formula U|xdbisdat = 0|bisdat
.input "la/ZEITTEXT"
.formula M|ztext.U|xiszaehl = U|xtztext
..
!WSPALTE
.continue WZENDE ? _(U|xiszaehl < U|xispalten)
.continue WZEILE
..
!WNEXT
.formula U|xiaktpos0 = U|xiaktpos0 + 0|tzeilen
..
!WZENDE
.continue Z2                             ? _(U|xiszaehl < U|xispalten)
.formula U|ximaxpos        = U|xiaktpos ? U|ximaxpos = 0
.formula U|xiszaehl        = U|xiszaehl + 1
.formula U|xtext           = "wert" + 'U|xiszaehl'
.formula M|wert.U|xiszaehl   = 0.0
.formula M|datvon.U|xiszaehl = ""
.formula M|datbis.U|xiszaehl = ""
.formula M|ztext.U|xiszaehl  = ""
.continue WZENDE                         ? U|xiszaehl < U|xispalten
..
!Z2
.continue Z3                             ? U|xizeile > 1 ; _U|xbok
.formula U|xixpos    = U|xivonpos
.formula U|xixpos    = U|xibispos - 9   ? M|xpos <= 0
.formula M|vondatakt = U|xanfdat
.formula M|bisdatakt = U|xenddat
..
!Z3: N„chsten Unterplan holen
.continue UPLAN1                         ? U|xbstart = G|TRUE
.select salesplanning
.continue END                            ? _G|mehr
.assign U|xideplan H|id              ?  G|mehr
.formula U|xtbaumaufzu = "+"                       ?  G|mehr
.formula U|xtbaumaufzu = ""                        ? _G|mehr
.reserve
.load 1 salesplanning
.assign U|xindeplan 1|id          ? G|mehr
.formula U|xtselect "$,,vor=" + 'U|xideplan' + ";@gruppe=1"
.load 1 salesplanning 'U|xtselect'
.formula U|xtbaumaufzu = "+"                       ?  G|mehr
.formula U|xtbaumaufzu = ""                        ? _G|mehr
.select
.continue Z1
..
!UPLAN1: Ersten Unterplan holen
.formula U|xtselect "$,,vor=" + 'M|eplan^id' + ";@gruppe=1"
.select salesplanning 'U|xtselect'
.continue END                                     ? _G|mehr
.formula U|xistufe = U|xistufe + 1
.assign U|xideplan H|id
.continue END                                     ? _G|mehr
.reserve
.load 1 salesplanning 'U|xtselect'
.assign U|xindeplan 1|id     ? G|mehr
.formula U|xtnselect "$,,vor=" + 'U|xindeplan' + ";@gruppe=1"
.load 1 salesplanning 'U|xtnselect'
.formula U|xtbaumaufzu = ""                        ? _G|mehr
.formula U|xtbaumaufzu = "+"                       ?  G|mehr
.select
..
.copy U|xbstart  = G|FALSE
.continue Z1
..
!END
.continue
