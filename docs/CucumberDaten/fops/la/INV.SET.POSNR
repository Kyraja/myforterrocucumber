..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INV.SET.POSNR
.. Autor/Author   : Marco Machmer
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Funktion fÅr Button Positionsnummern
..
.. Ablauf         :
..
..*****************************************************************************
.set trans -
..
.input ARB
..
.type text  xcom                ? _F|defined(U|xcom)
.type text  xdParam             ? _F|defined(U|xdParam)
.type integer xlposnr           ? _F|defined(U|xlposnr)
.type bool  xbBasisNull         ? _F|defined(U|xbBasisNull)
.type bool  xbIDIFF2Z           ? _F|defined(U|xbIDIFF2Z)
.type bool  xbIDIFFmitDummys    ? _F|defined(U|xbIDIFFmitDummys)
.type bool  xbmitArtName        ? _F|defined(U|xbmitArtName)
.type text  xdIDIFFprint        ? _F|defined(U|xdIDIFFprint)
.type text  xInvObjSchl         ? _F|defined(U|xInvObjSchl)
.type text  xInvObjSchlAbl      ? _F|defined(U|xInvObjSchlAbl)
..
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
!EPROCDEF
.continue EL001 ? tzeilen <> 0
.end .
..
!EL001
.continue EL002 ? evtkommd <> G|kaktname14
.continue FI002
..
!EL002: alle inv-objekte dieser zÑhlliste holen, die schon auf platte sind
.. so holt man die inv-objekte: die rohlingslose selektion
.formula U|xcom = "$,,"
.formula U|xcom = U|xcom + ";zlsnr=" + M|nummer + ";end=nein;@ordnung=posnr.rueckwaerts;@gruppe=1;@ablageart=(Both)"
.select stocktaking 'U|xcom'
.formula U|xlposnr = H|posnr ? G|mehr
..
!FI002
.select screen line 1
..
!LOOP001
.continue ELOP001 ? _G|mehr
.continue EL003 ? _((M|lock) & (M|posnr = 0))
.formula U|xlposnr = U|xlposnr + 1
.formula M|posnr = U|xlposnr
..
!EL003
.select screen line
.continue LOOP001
..
!ELOP001
..
