..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BSTATUS.FARBE
.. Autor          : es
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Zeilen nach M|aktzeile abwechselnd colorieren
..*****************************************************************************
.set trans -
..
.continue END ? F|empty(M|tzeilen)
..
.type integer xstartzl ? _F|defined(U|xstartzl)
.formula U|xstartzl = M|aktzeile
..
!NEXTROW
.assign M|color = M|bgtable2
.assign M|color = M|bgtable1 ? (M|tbaumstufe // 2) <>  0
.colour -background 'M|color' 'M|aktzeile'
.select screen line
.continue NEXTROW ? G|mehr
.select screen line 'U|xstartzl'
..*****************************************************************************
!END
.continue
