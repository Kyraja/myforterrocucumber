..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CARRIERENTRY.TAB
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : adds new table rows with data from the carrier account
...Includes       :
..      include  la/CARRIERENTRY.KUARTNR
..*****************************************************************************
..<META M|='la/CARRIERENTRY'>
.set trans -
..
.. event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue KONTO   ?  G|evtartengl = "FIELD_EXIT"    & G|evtvar = "tbehaelterkonto"
.continue ZUMGE   ?  G|evtartengl = "FIELD_EXIT"    & G|evtvar = "tzugang"
.continue ABMGE   ?  G|evtartengl = "FIELD_EXIT"    & G|evtvar = "tabgang"
.continue BELEG   ?  G|evtartengl = "FIELD_EXIT"    & G|evtvar = "tbeleg"
.continue DATUM   ?  G|evtartengl = "FIELD_EXIT"    & G|evtvar = "tbelegdatum"
.. ----------- ---------- ---------- -------------------------------------------
.continue BEFORE  ?  G|evtartengl = "ROW_INSERTION_BEFORE"
.continue AFTER   ?  G|evtartengl = "ROW_INSERTION_AFTER"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!KONTO
.colour -foreground -1 -1 -1 -background 'M|colquantity' tzugang 'M|aktzeile' ? _F|empty(M|tbehaelterkonto)
.colour -foreground -1 -1 -1 -background 'M|colquantity' tabgang 'M|aktzeile' ? _F|empty(M|tbehaelterkonto)
.colour -foreground -1 -1 -1 -background -1 -1 -1 tzugang 'M|aktzeile' ?  F|empty(M|tbehaelterkonto)
.colour -foreground -1 -1 -1 -background -1 -1 -1 tabgang 'M|aktzeile' ?  F|empty(M|tbehaelterkonto)
.formula M|tpartner = M|tbehaelterkonto^partner^id
.formula M|tartikel = M|tbehaelterkonto^artikel^id
.formula M|twerk = M|tbehaelterkonto^werk
.formula M|tkuartnr = ""
.input "CARRIERENTRY.KUARTNR"
.colour -foreground -1 -1 -1 -background -1 -1 -1 tkuartnr 'M|aktzeile' ? _F|empty(M|tkuartnr)
.colour -foreground -1 -1 -1 -background 'M|colerror' tkuartnr 'M|aktzeile' ? F|empty(M|tkuartnr)
.continue END
..
!ZUMGE
.formula M|tabgang = 0.0 ? _F|empty(M|tzugang)
.continue COLQTY
..
!ABMGE
.formula M|tzugang = 0.0 ? _F|empty(M|tabgang)
.continue COLQTY
..
!COLQTY
.colour -foreground -1 -1 -1 -background 'M|colquantity' tzugang 'M|aktzeile' ? _F|empty(M|tbehaelterkonto) & F|empty(M|tzugang) & F|empty(M|tabgang)
.colour -foreground -1 -1 -1 -background 'M|colquantity' tabgang 'M|aktzeile' ? _F|empty(M|tbehaelterkonto) & F|empty(M|tzugang) & F|empty(M|tabgang)
.colour -foreground -1 -1 -1 -background -1 -1 -1 tzugang 'M|aktzeile' ? _F|empty(M|tzugang) ; _F|empty(M|tabgang)
.colour -foreground -1 -1 -1 -background -1 -1 -1 tabgang 'M|aktzeile' ? _F|empty(M|tzugang) ; _F|empty(M|tabgang)
.continue END
..
!BELEG
.continue END
..
!DATUM
.continue END
..
..
!BEFORE
.continue END ? M|aktzeile=0
.copy M|kletzteskonto = M|tbehaelterkonto
.continue END
..
!AFTER
.continue END ? F|empty(M|kletzteskonto)
.copy M|tbehaelterkonto = M|kletzteskonto
.colour -foreground -1 -1 -1 -background 'M|colquantity' tzugang 'M|aktzeile'
.colour -foreground -1 -1 -1 -background 'M|colquantity' tabgang 'M|aktzeile'
.formula M|tpartner = M|tbehaelterkonto^partner^id
.formula M|tartikel = M|tbehaelterkonto^artikel^id
.formula M|twerk = M|tbehaelterkonto^werk
.input "CARRIERENTRY.KUARTNR"
.colour -foreground -1 -1 -1 -background 'M|colerror' tkuartnr 'M|aktzeile' ? F|empty(M|tkuartnr)
.continue END
..
..*****************************************************************************
!END
.continue
