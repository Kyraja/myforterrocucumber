..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LMB.FA
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : set defaults
..*****************************************************************************
.set trans -
..---------------------------- Kopfteil/Header:--------------------------------
.continue LOGGING ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "protokoll"
.continue STORAGE ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "zurueck"
.continue ARTIKEL ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kartvon"
.continue ARTIKEL ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kartbis"
.continue BASIS   ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbasisvon"
.continue BASIS   ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbasisbis"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "vorhalt"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "gewicht"
..-------------------------------------------------------------------------------
..
!ARTIKEL: Turn switch for selection bar off
.copy M|selektion = G|FALSE
.formula M|kbasisvon = ""
.formula M|kbasisbis = ""
.continue CLRTAB
..
!BASIS: base product - Turn switch for selection bar off
.copy M|selektion = G|FALSE
.formula M|kartvon = ""
.formula M|kartbis = ""
.continue CLRTAB
..
!LOGGING: Log only
.copy M|zurueck   = G|FALSE
.copy M|protokoll = G|TRUE
.continue CLRTAB
..
!STORAGE: Log and storage
.copy M|protokoll = G|FALSE
.copy M|zurueck   = G|TRUE
.continue CLRTAB
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
