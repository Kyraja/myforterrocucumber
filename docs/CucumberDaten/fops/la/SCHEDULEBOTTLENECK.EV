..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SCHEDULEBOTTLENECK.EV
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.type integer xzn ? _F|defined(U|xzn)
..
.. Kopffelder leeren
.formula M|merkzn = ""
.formula M|anzahl = ""
.formula M|krit = ""
.formula M|rueck = ""
.formula M|fanzahl = ""
.formula M|fkrit = ""
.formula M|frueck = ""
..
.continue VERKAUF     ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "bverkauf"
.continue FERT        ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "bfertigung"
.continue DATUM       ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "von"
.continue DATUM       ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "bis"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "artikel"
.continue BSTART      ? G|evtartengl = "BUTTON_AFTER" &  G|evtvar = "bstart"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "auftrag"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "ba"
.continue POSAUFTRAG  ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "posauftrag"
.continue FV          ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "fv"
.continue END
..
!BA
.continue TABLEEREN ? F|empty(M|ba)
.formula M|fv = ""
.continue TABLEEREN
..
!FV 
.continue TABLEEREN ? F|empty(M|fv)
.formula M|ba = ""
.continue TABLEEREN
..
!POSAUFTRAG
.continue TABLEEREN ? F|empty(M|posauftrag)
.continue ERROR4    ? M|posauftrag^objgruppe <> 22
.formula M|auftrag = M|posauftrag^kopf
.continue TABLEEREN
..
!DATUM
.continue ERROR3    ? 'M|von:8' > 'M|bis:8' & _F|empty(M|bis) & _F|empty(M|von)
.copy M|bis = M|von ? F|empty(M|bis) & G|evtvar = "von"
.continue TABLEEREN
..
!VERKAUF
.copy M|bfertigung = G|FALSE           ?  M|bverkauf
.formula M|ba = ""                     ?  M|bverkauf
.formula M|fv = ""                     ?  M|bverkauf
.protection ba                         ?  M|bverkauf
.protection fv                         ?  M|bverkauf
.protection -reset auftrag             ?  M|bverkauf
.protection -reset posauftrag          ?  M|bverkauf
.assign P|maskkontextfop = "Verkauf"   ?  M|bverkauf
.copy M|bfertigung = G|TRUE            ? _M|bverkauf
.formula M|auftrag = ""                ? _M|bverkauf
.formula M|posauftrag = ""             ? _M|bverkauf
.protection auftrag                    ? _M|bverkauf
.protection posauftrag                 ? _M|bverkauf
.protection -reset ba                  ? _M|bverkauf
.protection -reset fv                  ? _M|bverkauf
.assign P|maskkontextfop = "Fertigung" ? _M|bverkauf
.continue TABLEEREN
..
!FERT
.copy M|bverkauf = G|FALSE             ?  M|bfertigung
.formula M|auftrag = ""                ?  M|bfertigung
.formula M|posauftrag = ""             ?  M|bfertigung
.protection auftrag                    ?  M|bfertigung
.protection posauftrag                 ?  M|bfertigung
.protection -reset ba                  ?  M|bfertigung
.protection -reset fv                  ?  M|bfertigung
.assign P|maskkontextfop = "Fertigung" ?  M|bfertigung
.copy M|bverkauf = G|TRUE              ? _M|bfertigung
.protection -reset auftrag             ? _M|bfertigung
.protection -reset posauftrag          ? _M|bfertigung
.formula M|ba = ""                     ? _M|bfertigung
.formula M|fv = ""                     ? _M|bfertigung
.protection ba                         ? _M|bfertigung
.protection fv                         ? _M|bfertigung
.assign P|maskkontextfop = "Verkauf"   ? _M|bfertigung
.continue TABLEEREN
..
!BSTART
.input 'M|tab' ? _F|empty(M|tab)
.continue END
..
!TABLEEREN
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR3
.error Falsche Bereichseingabe!
.formula M|von = "" ? G|evtvar = "von"
.cursor von         ? G|evtvar = "von"
.formula M|bis = "" ? G|evtvar = "bis"
.cursor bis         ? G|evtvar = "bis"
.end 1
..
!ERROR4
.error -field M|posauftrag -message Bitte Auftragsposition ausw„hlen!
.formula M|posauftrag = ""
.end 1

