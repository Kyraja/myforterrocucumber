..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MPSLISTE.EV
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
..
.set trans -
..-----------------------------------------------------------------------------
.. Kopfteil
..-----------------------------------------------------------------------------
.continue TABINIT    ? G|evtartengl="FIELD_EXIT" & G|evtvar="kartvon"
.continue TABINIT    ? G|evtartengl="FIELD_EXIT" & G|evtvar="kartbis"
.continue LGRUPPE    ? G|evtartengl="FIELD_EXIT" & G|evtvar="klgruppe"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kgesneggelb"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kgesneggruen"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kgesposgelb"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kgesposgruen"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kzposgelb"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kzposgruen"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kzneggelb"
.continue SUMME      ? G|evtartengl="FIELD_EXIT" & G|evtvar="kzneggruen"
..-----------------------------------------------------------------------------
.. Tabellenteil
..-----------------------------------------------------------------------------
.continue WERTE      ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bwertereihe"
.continue END
..
!SUMME
.continue ERROR1 ? M|kzneggruen > M|kzneggelb ; M|kzposgruen > M|kzposgelb ; M|kgesneggruen > M|kgesneggelb ; M|kgesposgruen > M|kgesposgelb
.continue ERROR2 ? M|kgesneggelb < 0 ; M|kgesneggruen < 0 ; M|kgesposgelb < 0 ; M|kgesposgruen < 0 ; M|kzneggelb < 0 ; M|kzposgelb < 0 ; M|kzposgruen < 0 ; M|kzneggruen < 0
.continue TABINIT
..
!WERTE
.load 3 valuesequence 'M|wertereihe'
.continue END ? _G|mehr
.command -parallel 'F|formatstr("{1}<{2}>", 3|id, "(View)")'
.load 3
.continue END
..
!LGRUPPE: intern, wenn leer
.copy M|klgruppe = F|sysinfo(10)^intlgruppe ? F|empty(M|klgruppe)
.continue TABINIT
..
!TABINIT: remove old rows
.input "is/TABLEEREN"
.continue END
..
!ERROR1
.error Angabe fÅr Abweichung nicht korrekt!
.continue LEER
..
!ERROR2
.error Negative Angaben sind nicht erlaubt!
.continue LEER
..
!LEER:
.formula M|kgesneggelb = M|kgesneggruen +10 ?  G|evtvar="kgesneggelb"
.cursor kgesneggelb 0                      ?  G|evtvar="kgesneggelb"
.formula M|kgesneggruen = ""                ?  G|evtvar="kgesneggruen"
.cursor kgesneggruen 0                     ?  G|evtvar="kgesneggruen"
.formula M|kgesposgelb = M|kgesposgruen +10 ?  G|evtvar="kgesposgelb"
.cursor kgesposgelb 0                      ?  G|evtvar="kgesposgelb"
.formula M|kgesposgruen = ""                ?  G|evtvar="kgesposgruen"
.cursor kgesposgruen 0                     ?  G|evtvar="kgesposgruen"
.formula M|kzposgelb = M|kzposgruen +10     ?  G|evtvar="kzposgelb"
.cursor kzposgelb 0                        ?  G|evtvar="kzposgelb"
.formula M|kzposgruen = ""                  ?  G|evtvar="kzposgruen"
.cursor kzposgruen 0                       ?  G|evtvar="kzposgruen"
.formula M|kzneggelb = M|kzneggruen +10     ?  G|evtvar="kzneggelb"
.cursor kzneggelb 0                        ?  G|evtvar="kzneggelb"
.formula M|kzneggruen = ""                  ?  G|evtvar="kzneggruen"
.cursor kzneggruen                         ?  G|evtvar="kzneggruen"
.end 1
..
..*****************************************************************************
!END
.continue
