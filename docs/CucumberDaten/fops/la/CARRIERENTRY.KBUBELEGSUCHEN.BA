..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CARRIERENTRY.KBUBELEGSUCHEN.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : Gather container movements for a specific carrier account
...Includes       :
..      include  la/CARRIERENTRY.KUARTNR
..*****************************************************************************
..<META M|='la/CARRIERENTRY'>
.set trans -
..
.colour -foreground -1 -1 -1 -background 'M|colerror' kdatumvon 0 ? F|empty(M|kdatumvon)
.colour -foreground -1 -1 -1 -background 'M|colerror' kdatumbis 0 ? F|empty(M|kdatumbis)
..
.. Check required arguments
.continue ERROR  ?  F|empty(M|kerfassenkonto)
.continue NOZRAUM ? F|empty(M|kdatumvon) ; F|empty(M|kdatumbis)
..
.select screen line 'F|formatstr("$,,;tbehaelterkontonr=={1}", M|kerfassenkontonr)'
.continue DUPLI  ?  G|mehr
..
.select screen line 'M|tzeilen' ? M|tzeilen > 0
..
.select containeraccounting 'F|formatstr("$,,;@gruppe=1;@ablageart=(Active);bestkorr=(No);bhkto={1};beldat={2}!{3}", M|kerfassenkonto^id, M|kdatumvon, M|kdatumbis)'
.continue EROWS ? _G|mehr
!NEXT
.make screen line +O
.colour -foreground -1 -1 -1 -background 'M|colquantity' tzugang 'M|aktzeile'
.colour -foreground -1 -1 -1 -background 'M|colquantity' tabgang 'M|aktzeile'
.copy M|tbehaelterkonto = M|kerfassenkonto
.formula M|tpartner = M|tbehaelterkonto^partner^id
.formula M|tartikel = M|tbehaelterkonto^artikel^id
.formula M|twerk = M|tbehaelterkonto^werk
.formula M|tbeleg = H|ebeleg
.formula M|tbeleg = H|lskopf^nummer ? F|empty(M|tbeleg)
.formula M|tbelegdatum = H|beldat
.input "CARRIERENTRY.KUARTNR"
.colour -foreground -1 -1 -1 -background 'M|colerror' tkuartnr 'M|aktzeile' ? F|empty(M|tkuartnr)
.select containeraccounting
.continue NEXT ? G|mehr
!EROWS
.make screen line +O
..
..*****************************************************************************
!END
.continue
..
..
!ERROR
.error -field M|kerfassenkonto -message Kein Konto angegeben.
.end 1
..
!DUPLI
.error -field M|kerfassenkonto -message Dieses Konto ist in der Tabelle bereits enthalten.
.end 1
..
!NOZRAUM
.error -field M|kdatumvon -message Geben Sie den Zeitraum fÅr den LadungstrÑgerkontoauszug an!
.end 1
