..!interpreter english translate noabbrev
.. ---------------------------------------------------------
.. FOP-Name             : LAHI.EV
.. Autor                : ns
.. Verantwortlich       : tiwe
.. Kontrolle            : cl
.. Funktion             : Infosystem -> LAHI
...Includes             :
.. include la/LAHI.AL
.. include la/LAHI.AP
.. include la/LAHI.SH
.. include la/LAHI.CL
.. ---------------------------------------------------------
..
.type integer xisStufe
.type text    xisStr
..
.set trans -
..  ---------- ----- Kopfteil/Header ------- ---------------
.continue FeldAV     ? G|evtartengl="FIELD_EXIT"    & G|evtvar="grvon"
.continue FeldAB     ? G|evtartengl="FIELD_EXIT"    & G|evtvar="grbis"
.continue FeldAT     ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kopfstufe"
.continue checkInput ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="kopfstufe"
.continue preSelect  ? G|evtartengl="BUTTON_BEFORE"  & G|evtvar="bselect"
.continue Select     ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bselect"
.continue checkVB    ? G|evtartengl="BUTTON_BEFORE"  & G|evtvar="bstart"
..  ---------- ----- Tabelle/Table --------- ---------------
.continue flapTree   ? G|evtartengl="BUTTON_AFTER" & G|evtvar="tbaumaufzu"
.continue chngLine   ? G|evtartengl="ROW_CHANGED"
.. ---------------------------------------------------------
.set trans +
.continue
..
!FeldAV
.formula M|grbis         = M|grvon
..
!FeldAB
.formula M|select        = M|grvon + "!" + M|grbis
.copy M|kbsel       = G|FALSE
.input "la/LAHI.CL"
.input "is/TABLEEREN"
.continue
..
..  ---------- ---------- ---------- ----------
..  ---------- ---------- ---------- ----------
..
!FeldAT
.input "la/LAHI.CL"
.input "is/TABLEEREN"
.continue
..
..  ---------- ---------- ---------- ----------
..  ---------- ---------- ---------- ----------
..
!checkInput
.. es sind folgende Werte erlaubt : 0..2
..
.. 0  ->  Lagergruppen
.. 1  ->  L„ger
.. 2  ->  Lagerpl„tze
..
.continue Info            ? M|kopfstufe < 0
.continue Info            ? M|kopfstufe > 2
.continue
..
!Info: Wrong level deepth
.error Anzeigetiefe kann nur Werte von 0 bis 2 annehmen
.end 1
..
!preSelect
.input "la/LAHI.CL"
.input "is/TABLEEREN"
.continue
..
!Select
.assign M|grvon         = ""
.assign M|grbis         = ""
.assign G|evtfeldneu    = "%"
.input "is/AUSWAHL"
.copy M|kbsel = M|select <> "!"
.continue
..
!checkVB
.continue Fehler          ? M|grbis <> "" & -M|grbis < -M|grvon
.formula M|select = "$,,;@ablageart=(Active);@ordnung=such" ? F|empty(M|select) ; M|select="!"
.input "la/LAHI.CL"
.input "is/TABLEEREN"
.continue
..
!Fehler
.error  Von-Gruppe ist gr”áer als bis-Gruppe
.input "la/LAHI.CL"
.input "is/TABLEEREN"
.end 1
..
!flapTree: Open and close knot
.input "la/LAHI.SH"
..
.formula U|xisStr           = M|tbaumstat
.formula U|xisStufe         = M|tbaumstufe
..
.continue turnDown        ? U|xisStr = "+"
.continue turnUp          ? U|xisStr = "-"
.continue
..
!turnUp: Close
.formula M|tbaumstat     =  "+"
.select screen line
.continue                 ? _G|mehr
..
!loop
.make screen line -O   ? M|tbaumstufe > U|xisStufe
.continue loop            ? M|tbaumstufe > U|xisStufe
.continue
..
!turnDown: Open
.formula M|tbaumstat     =  "-"
..
.continue AufLager        ? U|xisStufe = 1
.continue AufPlatz        ? U|xisStufe = 2
..
.. Auf anderen Stufen ist kein Aufklappen m”glich
.set errorreport +
.error Das Aufklappen der Stufe 'U|xisStufe' ist verboten!
.end 1
..
.. ------------------------
.. L„ger werden aufgeklappt
.. ------------------------
..
!AufLager
.load 0 add M|tggruppe
.input "la/LAHI.AL"
.continue
..
.. ------------------------------
.. Lagerpl„tze werden aufgeklappt
.. ------------------------------
..
!AufPlatz
.load 0 add M|tggruppe
.load 1 add M|tllager
.input "la/LAHI.AP"
.continue
..
!chngLine
..
.input "la/LAHI.SH"
.continue
