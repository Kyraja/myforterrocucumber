..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SCHEDOVERVIEW.EV
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl                        
.. Functionality  :
..*****************************************************************************
.set trans -
..
.input "is/TABLEEREN"
.continue MAX       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "maxanz"
.continue DLAUF     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dlauf"
.continue BSTART    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue END
..
!MAX
.continue ERROR2 ? F|empty(M|maxanz)
.continue END

!DLAUF
.continue ERROR1 ? M|dlauf:8 > G|datum:8
.continue END
..
!BSTART
.input 'M|tab' ? _F|empty(M|tab)
.continue END
..*****************************************************************************
!END
.continue
..
!ERROR1
.error Eingetragenes Datum liegt in der Zukunft.
.end 1
..
!ERROR2
.error -field M|maxanz -message Bitte tragen Sie eine maximale Anzahl angezeigter Dispositionsl„ufe ein.
.end 1

