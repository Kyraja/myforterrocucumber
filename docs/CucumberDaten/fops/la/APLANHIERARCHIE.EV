..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APLANHIERARCHIE.EV
.. Autor          : foe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem Absatzplanungshierarchie: Eventbehandlung
.. Functionality  :
.. Ablauf         : Behandelt alle Feld- und Button-Events, insbes. auch
..                  das Druecken auf Auf-/Zu-Button.
..
..
.. includes       : Dateien, die hier benutzt werden
..
..  include  la/HOL.APLANHIERARCHIE
..  include  la/APLANLEEREN
..*****************************************************************************
..
.type VID99 xvid     ? _F|defined(U|xvid)
.type integer   xistufe  ? _F|defined(U|xistufe)
.type text  xtkomm   ? _F|defined(U|xtkomm)
.type ID126 xplan    ? _F|defined(U|xplan)
..
.set trans -
..  ---------------------------------------------------------------------------
..  Kopfteil
..  ---------------------------------------------------------------------------
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="planung"
.continue LEEREN     ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="bstart"
.continue KBUSTUFE   ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="kbustufe"
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="bspez"
.continue MASKEIN    ? G|evtartengl="SCREEN_ENTER"
..  ---------------------------------------------------------------------------
..  Tabellenteil
..  ---------------------------------------------------------------------------
.continue KLAPPEN    ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="tbaumaufzu"
.continue TBUSTUFE   ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="tbustufe"
.continue WECHSEL    ? G|evtartengl="ROW_CHANGED"
.continue END
..
!MASKEIN: Maskeneintritt
.copy M|bspez = G|FALSE
.continue END
..
!PLANUNG: Daten fuer Kopf holen
.formula M|select   = ""
.continue END                                   ? F|empty(planung)
.assign U|xplan  = M|planung
.formula M|select   = 'U|xplan'
.continue END
..
!START: Startbutton
.set trans +
.error Bitte erst Planungsobjekt eintragen ? F|empty(M|planung)
.end 1                                     ? F|empty(M|planung)
.error Plausibilit„tsprfung               ? F|empty(M|select)
.end 1                                     ? F|empty(M|select)
..
.set trans -
.copy M|bstartbut = G|TRUE
.input "la/HOL.APLANHIERARCHIE"
.continue END
..
!KLAPPEN
.continue AUFKL ? M|tbaumstat="+"
.continue ZUKLA ? M|tbaumstat="-"
.continue END
..
!AUFKL: Stufe aufklappen
.copy M|bstartbut  = G|FALSE
.formula M|stufe      = M|tbaumstufe
.formula M|tbaumstat  = "-"
.input "la/HOL.APLANHIERARCHIE"
.continue WECHSEL
..
!ZUKLA: Stufe zuklappen
.formula U|xistufe    = M|tbaumstufe
.. Die zugeklappte Stufe kennzeichnen
.formula M|tbaumstat  = "+"
.select screen line
.continue WECHSEL ? _G|mehr
..
!ZUNEXT: Zeilen der untergeordnten Planungseinheiten l”schen
.make screen line -O  ? M|tbaumstufe > U|xistufe
.continue ZUNEXT         ? M|tbaumstufe > U|xistufe
.continue WECHSEL
..
!KBUSTUFE: Kopfobjekt anzeigen
.assign U|xvid = M|kplaneinheit
.continue DOBUSTUFE
..
!TBUSTUFE: Zeilenobjekt anzeigen
.assign U|xvid = M|tplaneinheit
..
!DOBUSTUFE
.continue END ? F|empty(U|xvid)
.command -parallel 'U|xvid'
.continue END
..
!WECHSEL
.select screen line 'G|evtzeile'  ? G|evtzeile <> M|aktzeile
.copy M|kbaumstufe      = M|tbaumstufe
.copy M|kplaneinheit    = M|tplaneinheit
.copy M|kname           = M|tname
.copy M|kartber         = M|tartber
.copy M|klgruppe        = M|tlgruppe
.copy M|kkunde          = M|tkunde
.copy M|kpkober         = M|tpkober
.copy M|kuebplan        = M|tuebplan
.copy M|kaktiv          = M|taktiv
.copy M|kauto           = M|tauto
.copy M|kmanuellplanbar = M|tmanuellplanbar
.copy M|kplanung        = M|tplanung
.copy M|kspezplan       = M|tspezplan
.copy M|kgesamt         = M|tgesamt
.continue END
..
!LEEREN
.input "la/APLANLEEREN"
.input "is/TABLEEREN"
.continue PLANUNG  ? G|evtartengl="FIELD_EXIT"    & G|evtvar="planung"
.continue START    ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bstart"
.continue END
..
!END
.continue
