..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : STOCKTAKINGDIFF.SE
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.type text    xdParam  ? _F|defined(U|xdParam)
..
.. set colours
.input "is/ABASFARBEN.DEF"
.assign M|warnfarbe = U|xabaslightgreen
..
.formula M|tmpfile = ""
.copy M|bfertig    = G|false
.formula M|anhang  = ""
.copy M|auswaehr   = G|inland
..
.. nur Mengenabweichung anzeigen
.copy M|bnurabweichungen = G|true
.. als default wird der Preis aus der Bewertung gezogen
.copy M|preisauszl = G|false
.. Materialkostenverbuchung
.copy M|bew = F|sysinfo(18)^bew
..
.. Ablageart
.assign M|ablage = "(Active)"
..
.. Standardkontierung
.formula M|wgruppe = ""
.assign M|wgruppe = F|sysinfo(7)^wgruppe
.continue ERROR ? _G|mehr
..
.. Bestandskonto
.formula M|bestand = ""
.assign M|bestand  = M|wgruppe^bestand
..
.. Kostenstelle
.formula M|kstelle = ""
.assign M|kstelle = M|wgruppe^wgkst
..
.. Konto Mengenabweichung
.assign M|kontoabmgeabw = M|wgruppe^bvausinventab
.assign M|kontozumgeabw = M|wgruppe^bvausinventzu
.formula M|khinweis   = ""   
.set trans +
.formula M|khinweis = "In der Standardwarengruppe fehlt das Inventurdifferenzkonto fÅr den Zugang."  ? F|empty(M|kontozumgeabw)
.formula M|khinweis = "In der Standardwarengruppe fehlt das Inventurdifferenzkonto fÅr den Abgang."  ? F|empty(M|kontoabmgeabw)
.set trans -
..
.. Konto Preisabweichung
.assign M|kontopreisabw = M|wgruppe^bewdiff
.continue ERROR2 ? _G|mehr
..
!INI: Parameterdatei einlesen
.input "ARB"
.formula U|xdParam = U|xarb + "INVENTUR.INI"
.input 'U|xdParam'
..
.continue END
..
!ERROR
.error Firmenstamm Standardkontierungen fehlt!
.end 1
..
!ERROR2
.error Konto fÅr Bewertungsdifferenzen in der Warengruppe fehlt!
.end 1
..
..*****************************************************************************
!END
.continue
