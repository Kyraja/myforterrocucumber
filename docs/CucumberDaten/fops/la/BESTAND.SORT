..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BESTAND.SORT
.. Autor          : tiwe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. FunktionalitÑt : PrÅft ob es mîglich ist, die Tabelle zu sortieren
.. Programfluss   : Event bevor Zeilen sortiert werden
..*****************************************************************************
..Variablen
..*****************************************************************************
.type bool xbaufgeklappt   ? _F|defined(U|xbaufgeklappt)
..*****************************************************************************
.set trans -
.continue PLAN    ? M|plankarte
.continue BESTAND ? M|bestandssicht
!PLAN: Plankartensicht - sortieren ist erlaubt
.continue END
!BESTAND: Bestandssicht - hier prÅfen, ob man normal oder detailliert sucht
.continue DETAIL ? _F|empty(M|kcharge)
.continue DETAIL ? _F|empty(M|kverw)
.continue DETAIL ? _F|empty(M|kprojekt)
.continue DETAIL ? _F|empty(M|selbehaelter)
.continue NORMAL
!DETAIL: detaillierte Suche - hier ist sortieren erlaubt
.continue END
!NORMAL: normale Suche
.continue AUFKLP ? M|details
.continue CHECK  ? _M|details
!AUFKLP: hier soll alles aufgeklappt werden - sortieren ist NICHT erlaubt
.input "is/VERBOTEN"
!CHECK: hier soll nicht aufgeklappt werden - vielleicht wurde manuell aufgeklappt
.copy U|xbaufgeklappt = G|false
.select screen header
.select screen line
.continue END ? _G|mehr
!NXTLINE
.copy U|xbaufgeklappt = G|true ? M|taufzu = M|iconauf
.continue NOSORT ? U|xbaufgeklappt 
.select screen line
.continue NXTLINE ? G|mehr
.continue END 
!NOSORT: hier wurde manuell aufgeklappt - sortierten ist nicht erlaubt
.input "is/VERBOTEN"
..*****************************************************************************
..Programmende
..*****************************************************************************
!END
.continue
