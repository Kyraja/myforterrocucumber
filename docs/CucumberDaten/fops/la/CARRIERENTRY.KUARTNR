..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CARRIERENTRY.KUARTNR
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : Find the customer product number for a product + customer / customer ref
..*****************************************************************************
..<META M|='la/CARRIERENTRY'>
.set trans -
..
.continue END  ?  F|empty(M|tartikel) ; F|empty(M|tpartner)
..
.. Get customer product number from  customer product properties
.load 1 parts 'F|formatstr("$,,;@gruppe=6;art={1};kl={2}", M|tartikel^id, M|tpartner^id)'
.load 1 parts 'F|formatstr("$,,;@gruppe=6;art={1};kl={2}", M|tartikel^id, M|tpartner^firma^id)'  ? _G|mehr & F|defined(M|tpartner^firma) & _F|empty(M|tpartner^firma)
.load 1 parts 'F|formatstr("$,,;@gruppe=6;art={1};kl={2}", M|tartikel^id, "`")'  ? _G|mehr
.copy M|tkuartnr = 1|kuartnr ? G|mehr
.load 1 ? F|defined(1|id)
.. 
..*****************************************************************************
!END
.continue
