..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVSHEETCENTER.TAB
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Creates a table row.
..*****************************************************************************
.set trans -
..
.type text xtable ? _F|defined(U|xtable)
..
.formula M|tmpfile = "rmtmp/XZLIDIXX"+T|sekundenz+pid+".TMP"
.output addedto 'M|tmpfile'
.input "DATEI.F"
..
.make screen line +O
.assign M|tzaehlliste = H|id
'H|id'
.output
.formula M|zlsuch = H|such
.assign M|tzlerst = H|erfass
.copy M|gedruckt = H|gedruckt
.. Inventur er”ffnet am GD2
.copy M|startdat = H|startdat
.. Inventur Bestandsabschluss B
.copy M|bend = H|bend
.. Inventur Bestandsabschluss am GD2
.copy M|benddat = H|benddat
.. Inventur abgeschlossen am
.copy M|enddat = H|enddat
..
.formula M|bueroeffnenz    = "icon:ok"          ? _F|empty(M|startdat)
.formula M|bueroeffnenz    = "icon:process"     ?  F|empty(M|startdat)
.formula M|bubestandsabz   = "icon:ok"          ?  M|bend = G|TRUE
.formula M|bubestandsabz   = "icon:flash"       ?  M|bend = G|FALSE
.formula M|buabschliessenz = "icon:ok"          ? _F|empty(M|enddat)
.formula M|buabschliessenz = "icon:lock"        ?  F|empty(M|enddat)
.formula M|buzeigenz       = "icon:screen_view" 
.formula M|bubearbeitenz   = "icon:screen_edit" ?  F|empty(M|enddat)
..
.continue END
..
..*****************************************************************************
!END
.continue
