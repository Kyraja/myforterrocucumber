.set trans -
.type text xtstring
..
.formula M|klemge     = 0
.formula M|kdlemge    = 0
.formula M|klfbestand = 0
..
.continue END ? F|empty(M|kart) ; F|empty(M|klgruppe)
..Platzmengen
.formula U|xtstring = "$,,;@ordnung=artikel,lgruppe;@ablageart=(Active)"
.formula U|xtstring = U|xtstring + ";artikel=" + M|kart^id ? _F|empty(M|kart)
.formula U|xtstring = U|xtstring + ";lgruppe=" + M|klgruppe^id ? _F|empty(M|klgruppe)
.select group "40:3" 'U|xtstring'
.continue END ? _G|mehr
..
.formula M|klemge  = H|bestand
.formula M|kdlemge = H|dbestand
.formula M|kle     = H|le
..
!END
.continue
