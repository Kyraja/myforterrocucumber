..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : PLAN.KOPFINIT
..  Datum          : 19.05.2011
..  Version        :
..  Autor          : es
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Infosystem Plankarte: Kopfteil initialisieren
..
..*****************************************************************************
.type text GL70 xhinweis  ?  _F|defined(U|xhinweis)
.atext -language 'G|bsprache' U|xhinweis 5998 Plankarte muss von der Disposition noch aktualisiert werden
.set trans -
.select screen header
.copy M|klgruppe = M|intlgruppe ? F|empty(M|klgruppe)
..
.continue ERROR1 ? F|empty(M|kart)
.continue ERROR2 ? F|empty(M|klgruppe)
..
.. Kopfteil fÅllen
.select add M|kart
.continue ENDLG ? _G|mehr
.formula M|vorgnachficon = ""            ?  F|empty(H|nachfolgeartikel)
.formula M|vorgnachficon = M|nachfolgerz ? _F|empty(H|nachfolgeartikel) & H|lbsdatum < G|datum
..
.. Artikel an aktuelle Lagergruppe anpassen
.copy H|lgruppean = M|klgruppe  ?  M|klgruppe^id<>M|intlgruppe^id
..
.formula M|lein      = H|le
.. use  operating language
.formula M|dispo     = H|dispo
.formula M|dispoa    = H|dispoa
.formula M|bsart     = H|bsart
.formula M|eart      = H|eart
.formula M|earta     = H|earta
.formula M|gbest     = H|gbest
.formula M|mind      = H|mindest
.formula M|minbsmge  = H|minbsmge
.formula M|maxbsmge  = H|maxbsmge
.formula M|losgr     = H|losgr
.formula M|losbi     = H|losbild
.formula M|hinweis   = ""
.formula M|hinweis   = U|xhinweis ? _H|disponiert
.formula M|bfrist    = H|bfrist
.formula M|bfrist    = H|efrist ? _(F|equals(H|bsart, "(InhouseProduction)") ; F|equals(H|bsart, "(Relocation)"))
.formula M|kbfrist   = H|kbfrist
.formula M|zlgbestand    = H|zlgbestand
.formula M|zfixlgbestand = H|zfixlgbestand
.continue ENDLG
..
!ENDLG
.continue
..
!ERROR1: Part is missing
.error -field M|kart -message Bitte zuerst Artikel eintragen!
.end 1
..
!ERROR2: Warehouse is missing
.error -field M|klgruppe -message Bitte zuerst Lagergruppe eintragen!
.end 1
