..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : HBMGE.BSTART
.. Datum/Date     : 08.11.05
.. Version        : 2006r1
.. Autor/Author   : ak
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
.set trans -
.type text  xtsel xmarke
.type realx xranzahl
.type PS2   xlohnfert
.type PS1   xlief
..
.input "is/TABLEEREN"
.input 'M|bkopf'        ?  _F|empty(M|bkopf)
..
.formula M|klfbestand = 0
.continue HOLMZ             ?  F|empty(M|kba)
.input 'M|tab'          ? _F|empty(M|tab)
.continue END0
..
!HOLMZ
.continue HOL77             ? _F|empty(M|klgruppe) ; F|empty(M|kart)
..
.. Halbfabrikat eingegeben UND keine Lagergruppe eingegeben
.. zuerst alle Lagergruppenmengen des Halbfabrikats ausgeben
.formula U|xtsel = "$,,;@ordnung=artikel,lgruppe;@ablageart=(Active)"
.formula U|xtsel = U|xtsel + ";artikel=" + M|kart^id ? _F|empty(M|kart)
.load 5 group "40:5" 'U|xtsel'
..
!HOL55
.continue HOL77 ? _G|mehr
.continue HOL66 ?  F|empty(5|lgruppe)
..
.make screen line +0
.copy M|lgruppe = 5|lgruppe
.formula M|zuomge    = 5|dbestand
.formula M|lzuomge   = M|zuomge
.formula M|leinh     = 5|le
.formula M|faktor    = 1.0
..
!HOL66
.load 5 squantity
.continue HOL55
..
!HOL77: Selektion zusammenbauen
.. nur Dispo-MZs mit Beschaffungen aus dem Lager
.formula U|xtsel = "$,einplan=1;bs^dnr=40;@ordnung=lgruppe,artikel,einplan,bs;@ablageart=(Both)"
.formula U|xtsel = U|xtsel + ";artikel=" + M|kart^id  ?  _F|empty(M|kart)
.formula U|xtsel = U|xtsel + ";lgruppe=" + 'M|klgruppe^id'  ?  _F|empty(M|klgruppe)
..
!HOL0
.load 9 mallocation 'U|xtsel'
..
!HOL10
.continue END0        ? _G|mehr
.input 'M|tab'    ? _F|empty(M|tab)
.load 9 mallocation
.continue HOL10
..
!END0
.input 'M|bfuss'  ? _F|empty(M|bfuss)
.continue
