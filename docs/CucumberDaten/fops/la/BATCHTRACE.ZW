..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BATCHTRACE.ZW
.. Autor          : fwester
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Zeigt beim Wechsel die Details des markierten Elementes an.
.. Ablauf         : Zeile-wechsel-EFOP
..
.. Functionality  : For every line break this shows details of the marked element.
.. Program flow   : Changing line efop
..*****************************************************************************
.set trans -
..
.select screen line 'G|evtzeile'
.continue END ? _G|mehr
..
.continue BOOKING ? M|ttyp = M|typbuchung
.continue LOTS
..
!BOOKING
.copy M|buchung = M|tbuchung
.copy M|budat = M|tbudat
.copy M|ursache = M|tursache
.copy M|vom = M|tvom
.copy M|lief = M|tlief
.assign M|artikel = M|buchung^art
.copy M|storniert = M|buchung^storniert
.copy M|stornolj = M|buchung^stornolj
.assign M|fert = M|buchung^fert
.copy M|mge = M|tmge
.copy M|rueckmge = M|trueckmge
.copy M|restmge = M|trestmge
.copy M|kle = M|tle
..
!LOTS
.assign M|vcharge = M|tvcharge
.assign M|vexnum = M|tvcharge^exnum
.assign M|ncharge = M|tncharge
.assign M|nexnum = M|tncharge^exnum
.continue END ? M|ttyp = M|typbuchung
.formula M|buchung = ""
.formula M|budat = ""
.assign M|ursache = ""
.formula M|vom = ""
.formula M|lief = ""
.formula M|artikel = ""
.formula M|fert = ""
.formula M|mge = 0.0
.assign M|kle = ""
..*****************************************************************************
!END
.continue
