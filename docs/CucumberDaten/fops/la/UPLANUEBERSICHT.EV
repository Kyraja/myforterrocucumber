..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : UPLANUEBERSICHT.EV
.. Autor          : foe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Maskensteuerung Planungsuebersicht (Wert)
.. Functionality  :
..
...Includes       :
..                  la/ZEITTEXT
..
..*****************************************************************************
.set trans -
.type A227 xkarttext
..
.assign U|xkarttext = "(RollingForecast)"
.continue KART           ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kart"
.continue STUFE          ? G|evtartengl="FIELD_EXIT"    & G|evtvar="anzstufen"
.continue BUSTART        ? G|evtvar="bstart"     & G|evtartengl="BUTTON_AFTER"
.continue KLAPP          ? G|evtvar="tbaumaufzu" & G|evtartengl="BUTTON_BEFORE"
.continue END
..
!KART
.input "is/TABLEEREN"
.continue FEHLER ? M|kart = U|xkarttext ; F|empty(M|kart)
.continue END
..
!STUFE
.input "is/TABLEEREN"
.continue END
..
!KLAPP
.assign M|stufe = 2
.continue END
..
!BUSTART: Startbutton
.formula M|vondatakt = M|adatum
.formula M|bisdatakt = M|edatum
..
!DATEN
.continue FEHLER1 ?  F|empty(M|plan)
.continue HOLE    ? _F|empty(M|kart)
.error Bitte zuerst die Art der Werte eintragen.
.end 1
..
!HOLE
.input 'M|tab' ? _F|empty(M|tab)
.continue END
..
!FEHLER
.error Die Art "Rollierender Plan" ist hier nicht erlaubt. ? M|kart = U|xkarttext
.error Die Art der Werte muss gefÅllt sein.                ? F|empty(M|kart)
.assign M|kart = "(BasicData)"
.. Kopffelder leeren
.formula M|vondatakt = ""
.formula M|bisdatakt = ""
.formula M|ztext1    = ""
.formula M|ztext2    = ""
.formula M|ztext3    = ""
.formula M|ztext4    = ""
.formula M|ztext5    = ""
.formula M|ztext6    = ""
.formula M|ztext7    = ""
.formula M|ztext8    = ""
.formula M|ztext9    = ""
.formula M|ztext10   = ""
.formula M|ztext11   = ""
.formula M|ztext12   = ""
.end 1
..
!FEHLER1
.error Bitte zuerst eine Planungseinheit eintragen.
.end 1
..
!END
.continue
