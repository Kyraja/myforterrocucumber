..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ZEITTEXT
.. Autor          : foe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Darstellung von Zeitr„umen
.. Functionality  :
.. Schnittstelle  : ben”tigt folgende Angaben:
..            xdanfdat - Anfangsdatum des darzustellenden Zeitabschnitts  GD
..            xdenddat - Enddatum des darzustellenden Zeitabschnitts      GD
..            xtraster - Raster des darzustellenden Zeitabschnitts        text
..            xtztext  - Zeittext (Ergebnis)                              text
..
..*****************************************************************************
.set trans +
.. Variablen
.type GW4     xwoche1    ? _defined(xwoche1)
.type GW4     xwoche2    ? _defined(xwoche2)
..
!ZEITEXT
.continue TAG     ? 'U|xtraster' = "Tag"
.continue WOCHE   ? 'U|xtraster' = "Woche"
.continue MONAT   ? 'U|xtraster' = "Monat"
.continue QUARTAL ? 'U|xtraster' = "Quartal"
.continue JAHR    ? 'U|xtraster' = "Jahr"
.continue MONAT
..
!TAG
.formula U|xtztext = 'U|xdvondat'
.continue END
..
!WOCHE
.formula U|xwoche1          = U|xdvondat
.formula U|xwoche2          = U|xdbisdat - 3
.continue SONST  ? 'U|xwoche1' <> 'U|xwoche2'
.formula U|xtztext   = 'U|xwoche1'
.continue END
..
!MONAT
.continue SONST  ? ('U|xdvondat' >> 7) <> ('U|xdbisdat' >> 7)
.formula U|xtztext   = 'U|xdvondat' >> 7
.continue END
..
!QUARTAL
.formula U|xtztext   =  U|xtztext >> 4
.formula U|xtztext   =  "1/" + U|xtztext ? ('U|xdvondat' >> 4) = ('U|xdbisdat' >> 4)
.continue SONST  ? ('U|xdvondat' >> 4) <> ('U|xdbisdat' >> 4)
.continue END
..
!JAHR
.formula U|xtztext   =  'U|xdvondat' >> 4 ? ('U|xdvondat' >> 4) = ('U|xdbisdat' >> 4)
.continue SONST  ? ('U|xdvondat' >> 4) <> ('U|xdbisdat' >> 4)
.continue END
..
!SONST
.formula U|xtztext   = 'U|xdvondat'
.formula U|xtztext   = U|xtztext  + "-"
.formula U|xtztext   = U|xtztext  + 'U|xdbisdat'
.continue END
..
..*****************************************************************************
!END
.continue
