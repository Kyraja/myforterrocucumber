..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVSHEETCENTER.EV
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Central handling of events with simple function.
..
.. include la/INVSHEETCENTER.DEV
.. include la/INVSHEETCENTER.DEVALL
..*****************************************************************************
.set trans -
.type text    xdParam  ? _F|defined(U|xdParam)
.type text    sys      ? _F|defined(U|sys)
.type text    xtcomm   ? _F|defined(U|xtcomm)
..
.copy M|bposnr = G|TRUE    ? _M|bplsarts & _M|bplsartn & _M|bartspls & _M|bartnpln & _M|bartnapls & _M|bplsartna
..------------------------- Header -------------------------------------------
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bposnr"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsarts"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsartn"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartspls"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartnpln"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartnapls"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsartna"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsbehnartn"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsbehnarts"
.continue RADIOBU     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bplsbehnartna"
.input "is/TABLEEREN" ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "zaehllistevon"
.input "is/TABLEEREN" ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "zaehllistebis"
.input "is/TABLEEREN" ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "nurnichtgedruckt"
.continue AASCII      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "aascii"
.continue AASCII      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "aarb"
.continue BU6         ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "buneu"
.continue KABW        ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kinvabw"
.continue DELETE      ? G|evtartengl = "ROW_DELETION_AFTER"
..------------------------- Table --------------------------------------------
.continue FORBIDD ? G|evtartengl = "ROW_INSERTION_BEFORE"
.continue BU1     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bueroeffnen"
.continue BU1     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bueroeffnen2"
.continue AKTU    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bueroeffnen2"
.continue BU2     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bubestandsab"
.continue BU2     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bubestandsab2"
.continue AKTU    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bubestandsab2"
.continue BU3     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buabschliessen"
.continue BU3     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "buabschliessen2"
.continue AKTU    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buabschliessen2"
.continue BU4     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buzeigen"
.continue BU4     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "buzeigen2"
.continue AKTU    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buzeigen2"
.continue BU5     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bubearbeiten"
.continue BU5     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bubearbeiten2"
.continue AKTU    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bubearbeiten2"
.continue ABW     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "invabw"
.continue ASCII   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "ascii2inv"
..
.continue END
..
!AASCII
.formula M|ascii = M|aarb + "/" + M|aascii ? _F|empty(M|aarb)
.formula M|ascii = M|aascii                ?  F|empty(M|aarb)
.formula M|ascii = "" ? F|empty(M|aascii)
.continue END
..
!KABW: Alle ZÑhllistenzeilen abwerten
.input "la/INVSHEETCENTER.DEVALL"
.continue END
..
!ABW: ZÑhlliste abwerten
.input "la/INVSHEETCENTER.DEV"
.continue END
..
!ASCII: ZÑhlliste aus ASCII-Datei fÅllen
.continue ERROR7 ? bubestandsab = "icon:ok"
.input "la/INVSHEETCENTER.ASCII"
.continue END
..
!DELETE: Zeile lîschen /delete row  -> tmpfile fÅr Inventurdifferenzliste neu aufbauen
.select screen header
.formula M|tmpfile = "rmtmp/XZLIDIXX"+T|sekundenz+pid+".TMP"
.output new 'M|tmpfile'
.input "DATEI.F"
..
!SELECT
.select screen line
.output       ? _G|mehr
.continue END ? _G|mehr
'M|tzaehlliste^id'
.continue SELECT
..
!BU6: ZÑhlliste neu
.formula U|xtcomm = 'F|formatstr("<(Stocktaking)><(New)>")'
.end 0 'U|xtcomm'
..
!BU1: Inventur erîffnen
.continue ERROR1 ? _F|empty(M|startdat)
.formula U|xtcomm = 'F|formatstr("<(Stocktaking)>{1}<(Release)>", M|tzaehlliste)'
.continue BUWEB ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bueroeffnen2"
.command -wait 'U|xtcomm'
.continue AKTU
..
!BU2: Bestandsabschluss
.continue ERROR2 ? M|bend = G|TRUE
.continue ERROR4 ? F|empty(M|startdat) & M|bueroeffnenz<>"icon:ok"
.formula U|xtcomm = 'F|formatstr("<(Stocktaking)>{1}<(Done)>", M|tzaehlliste)'
.continue BUWEB ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bubestandsab2"
.command -wait 'U|xtcomm'
.continue AKTU
..
!BU3: Inventur abschlie·en
.continue ERROR3 ? _F|empty(M|enddat)
.continue ERROR5 ? F|empty(benddat) & M|bubestandsabz<>"icon:ok"
.formula U|xtcomm = 'F|formatstr("<(Stocktaking)>{1}<(Transfer)>", M|tzaehlliste)'
.continue BUWEB ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "buabschliessen2"
.command -wait 'U|xtcomm'
.continue AKTU
..
!BU4: ZÑhlliste zeigen
.formula U|xtcomm = 'F|formatstr("<(Stocktaking)>{1}<(View)>", M|tzaehlliste)'
.continue BUWEB ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "buzeigen2"
.command -wait 'U|xtcomm'
.continue AKTU
..
!BU5: ZÑhlliste bearbeiten
.formula U|xtcomm = 'F|formatstr("<(Stocktaking)>{1}<(Edit)>", M|tzaehlliste)'
.continue BUWEB ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bubearbeiten2"
.command -wait 'U|xtcomm'
.continue AKTU
..
!BUWEB
.end 0 'U|xtcomm'
..
!AKTU: Tabelle aktualisieren
.input "is/TABLEEREN"  ? M|tzeilen > 0
.input "is/HOL.LISTE"
.continue END
..
!RADIOBU: Handle radio button for type of order
.formula M|ordnungsart = 1  ? M|bposnr
.formula M|ordnungsart = 2  ? M|bplsartn
.formula M|ordnungsart = 3  ? M|bartnpln
.formula M|ordnungsart = 4  ? M|bplsartna
.formula M|ordnungsart = 5  ? M|bplsarts
.formula M|ordnungsart = 6  ? M|bartspls
.formula M|ordnungsart = 7  ? M|bartnapls
.formula M|ordnungsart = 8  ? M|bplsbehnartn
.formula M|ordnungsart = 9  ? M|bplsbehnarts
.formula M|ordnungsart = 10 ? M|bplsbehnartna
..
.copy M|bposnr        = G|FALSE  ? M|bposnr    & G|evtvar <> "bposnr"
.copy M|bplsarts      = G|FALSE  ? M|bplsarts  & G|evtvar <> "bplsarts"
.copy M|bplsartn      = G|FALSE  ? M|bplsartn  & G|evtvar <> "bplsartn"
.copy M|bartspls      = G|FALSE  ? M|bartspls  & G|evtvar <> "bartspls"
.copy M|bartnpln      = G|FALSE  ? M|bartnpln  & G|evtvar <> "bartnpln"
.copy M|bartnapls     = G|FALSE  ? M|bartnapls & G|evtvar <> "bartnapls"
.copy M|bplsartna     = G|FALSE  ? M|bplsartna & G|evtvar <> "bplsartna"
.copy M|bplsbehnartn  = G|FALSE  ? M|bplsbehnartn  & G|evtvar <> "bplsbehnartn"
.copy M|bplsbehnarts  = G|FALSE  ? M|bplsbehnarts  & G|evtvar <> "bplsbehnarts"
.copy M|bplsbehnartna = G|FALSE  ? M|bplsbehnartna & G|evtvar <> "bplsbehnartna"
..
.copy M|bposnr = G|TRUE    ? _M|bplsarts & _M|bplsartn & _M|bartspls & _M|bartnpln & _M|bartnapls & _M|bplsartna & _M|bplsbehnartn & _M|bplsbehnarts & _M|bplsbehnartna
..
!HINWEIS
.. Items are renumbered when sorting occurs and written into the stocktaking lines
.set trans +
.formula M|hinweis = ""   ? M|bposnr
.formula M|hinweis = "Beim Umsortieren werden die Positionsnummern neu berechnet und in die Inventurzeilen geschrieben." ? _M|bposnr
.set trans -
.continue CLRTAB 
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
.input "is/HOL.LISTE"
.formula U|sys = "rm -f " + M|tmpfile
.system 'U|sys' background
.formula M|ordnungsart = 1  ? M|bposnr
.formula M|ordnungsart = 2  ? M|bplsartn
.formula M|ordnungsart = 3  ? M|bartnpln
.formula M|ordnungsart = 4  ? M|bplsartna
.formula M|ordnungsart = 5  ? M|bplsarts
.formula M|ordnungsart = 6  ? M|bartspls
.formula M|ordnungsart = 7  ? M|bartnapls
.formula M|ordnungsart = 8  ? M|bplsbehnartn
.formula M|ordnungsart = 9  ? M|bplsbehnarts
.formula M|ordnungsart = 10 ? M|bplsbehnartna
..
.continue END
..
!ERROR1
.error Inventur ist bereits erîffnet!
.end 1
..
!ERROR2
.error Bestandsabschluss bereits durchgefÅhrt!
.end 1
..
!ERROR3
.error Inventur ist bereits beendet!
.end 1
..
!ERROR4
.error Bestandabschluss nur fÅr geîffnete ZÑhllisten mîglich!
.end 1
..
!ERROR5
.error Inventurabschluss nur fÅr ZÑhllisten mit Bestandabschluss mîglich!
.end 1
..
!ERROR6
.error Tabelle nicht gefÅllt! Keine öbergabe mîglich!
.end 1
..
!ERROR7
.error Bestandsabschluss bereits erfolgt! ZÑhlliste aus ASCII-Datei fÅllen nicht mehr mîglich.
.end 1
..
!FORBIDD: Operation is forbidden
.error
.end 1
..*****************************************************************************
!END
.continue
