..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BATCHTRACE.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Prueft Eingabeparameter und loescht unstimmige Maskenausgaben.
.. Ablauf         : Button-vor-EFOP
..
.. Functionality  : Checks input fields and deletes unneccessary mask outputs.
.. Program flow   : Before button efop
..*****************************************************************************
.set trans -
..
.continue ERROR1 ? F|empty(M|charge)
..
.. Clear table
.make screen line -- ? M|tzeilen > 0
..
.. Clear details
.formula M|vcharge = ""
.formula M|vexnum = ""
.formula M|ncharge = ""
.formula M|nexnum = ""
.formula M|buchung = ""
.formula M|budat = ""
.assign M|ursache = ""
.formula M|vom = ""
.formula M|lief = ""
.formula M|artikel = ""
.formula M|mge = 0.0
.formula M|rueckmge = 0.0
.assign M|kle = ""
..
.. Initializations
.formula M|stufe = 0
.copy M|beldatum = M|abbeldat
.copy M|istwurzel = G|TRUE
.formula M|kbauminfo = G|hdatname59
.formula M|vchargeauf = ""
.formula M|nchargeauf = ""
..
.continue FWD ? M|vorwaerts
.copy M|nchargeauf = M|charge
.formula M|kbaumicon = M|pluspfad
.continue END
..
!FWD: Forward
.copy M|vchargeauf = M|charge
.formula M|kbaumicon = M|minuspfad
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -line 0 -field M|charge -message Es fehlt die Angabe der Charge.
.end 1
