..*****************************************************************************
.set trans -
.. Eintrag ins Feld iskba
.continue NYR ? M|kba<>""
..
.protection - klffert
.protection - klgruppe
.formula M|klffert     = ""
.formula M|klffertname = ""
.formula M|kbaeinh     = ""
.formula M|kbamge      = 0.0
.continue AUSGANG
..
!NYR
.select workorder 'M|kba'
.continue OK ? H|snba=""
.formula M|kba      = ""
.error Bitte Betriebsauftrag eintragen.
.end 1
..
!OK
.copy M|klffert     = H|art
.formula M|kbaeinh       = H|art^le
.formula M|klffertname   = H|art^namebspr
.formula M|kbamge        = H|mge
.formula M|klemge        = 0
.formula M|kdlemge       = 0
.formula M|klfbestand    = 0
.formula M|kle           = ""
.formula M|klgruppe      = ""
.protection klffert
.protection klgruppe
..
!AUSGANG
.make screen line -- ? M|tzeilen > 0
.continue
