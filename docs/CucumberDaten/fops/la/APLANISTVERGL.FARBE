..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : APLANISTVERGL.FARBE
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.continue END ?  M|tzeilen = 0
.continue END ? _M|farbe
..
!HEADER
.select screen header
..
!LINE
.select screen line
.continue END ? _G|mehr
..
.assign M|color = M|bgtable2
.assign M|color = M|bgtable1 ? (M|tbaumstufe // 2) <>  0
.colour -background 'M|color' 'M|aktzeile'  ? M|tstufe <> "0"
.colour -background 'M|bgtable3' 'M|aktzeile'  ? M|tstufe = "0"
.continue LINE
..
..**************************************************************
!END
.continue
