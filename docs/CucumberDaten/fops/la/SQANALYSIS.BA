..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SQANALYSIS.BA
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.type text      xtedp       ? _F|defined(U|xtedp)
.type text      xtsys       ? _F|defined(U|xtsys)
.type text      xtout       ? _F|defined(U|xtout)
.type text      xterr       ? _F|defined(U|xterr)
.type DVM2      origftext   ? _F|defined(U|origftext)
.type DVM2      copyftext   ? _F|defined(U|copyftext)
..
.continue UMBUCH    ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "umbuch"
.continue END
..
!UMBUCH
.select screen header
..
!NOTUMBUCH
.formula U|xtedp = "./rmtmp/XXEDP.SQANALYSIS." + G|aufrufernr + ".TMP"
.formula U|xtout = U|xtedp + ".OUT"
.formula U|xterr = U|xtedp + ".ERR"
..
!LINE
.select screen line
.continue END    ? _G|mehr
.continue LINE   ?  F|empty(M|tmge) ; F|empty(M|tlezu) ; F|empty(M|tfaktorzu)
.continue EDP    ?  G|mehr & M|tmark
.continue LINE
..
!EDP
.output new 'xtedp'
.input "DATEI.F"
.continue BEH ? F|sysinfo(18)^behaelter
..
?param;artikel;beldat;beleg;ljtext1;buart;rowop;mge;ze;zele;platz;platz2;ze2;zele2;verw;verw2;projekt;projekt2;charge1;charge2;lffert;lffert2   ?  F|sysinfo(18)^projekt
?param;artikel;beldat;beleg;ljtext1;buart;rowop;mge;ze;zele;platz;platz2;ze2;zele2;verw;verw2;charge1;charge2;lffert;lffert2                    ? _F|sysinfo(18)^projekt
..
.. belnr (Beleg), M|jtext (Buchungstext)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tprojekt),"NNNN",M|tprojekt^id)';'F|condexpr(F|empty(M|tprojektzu),"NNNN",M|tprojektzu^id)';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';'M|tfertig^id';'M|tfertigzu^id'  ? F|sysinfo(18)^projekt & _F|empty(M|tfertig)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';'M|tfertig^id';'M|tfertigzu^id'  ?  _F|sysinfo(18)^projekt & _F|empty(M|tfertig)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tprojekt),"NNNN",M|tprojekt^id)';'F|condexpr(F|empty(M|tprojektzu),"NNNN",M|tprojektzu^id)';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';NNNN;NNNN           ? F|sysinfo(18)^projekt & F|empty(M|tfertig)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';NNNN;NNNN            ?  _F|sysinfo(18)^projekt & F|empty(M|tfertig)
.continue OUTPUT
..
!BEH
?param;artikel;beldat;beleg;ljtext1;buart;rowop;mge;ze;zele;platz;platz2;ze2;zele2;verw;verw2;behaelter;behaelterzu;projekt;projekt2;charge1;charge2;lffert;lffert2  ? F|sysinfo(18)^projekt
?param;artikel;beldat;beleg;ljtext1;buart;rowop;mge;ze;zele;platz;platz2;ze2;zele2;verw;verw2;behaelter;behaelterzu;charge1;charge2;lffert;lffert2  ?   _F|sysinfo(18)^projekt
..
.. belnr (Beleg), M|jtext (Buchungstext)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tbehaelter),"NNNN",M|tbehaelter^id)';'F|condexpr(F|empty(M|tbehaelterzu),"NNNN",M|tbehaelterzu^id)';'F|condexpr(F|empty(M|tprojekt),"NNNN",M|tprojekt^id)';'F|condexpr(F|empty(M|tprojektzu),"NNNN",M|tprojektzu^id)';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';'M|tfertig^id';'M|tfertigzu^id'  ? F|sysinfo(18)^projekt & _F|empty(M|tfertig)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tbehaelter),"NNNN",M|tbehaelter^id)';'F|condexpr(F|empty(M|tbehaelterzu),"NNNN",M|tbehaelterzu^id)';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';'M|tfertig^id';'M|tfertigzu^id'  ?  _F|sysinfo(18)^projekt & _F|empty(M|tfertig)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tbehaelter),"NNNN",M|tbehaelter^id)';'F|condexpr(F|empty(M|tbehaelterzu),"NNNN",M|tbehaelterzu^id)';'F|condexpr(F|empty(M|tprojekt),"NNNN",M|tprojekt^id)';'F|condexpr(F|empty(M|tprojektzu),"NNNN",M|tprojektzu^id)';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';NNNN;NNNN           ? F|sysinfo(18)^projekt & F|empty(M|tfertig)
?'M|aktzeile';'M|tartikel^id';'M|beldat:8';'M|belnr';'M|ljtext';(4);1;'M|tmge(L="0")';'M|tle';'M|tfaktor';'M|tlplatz^id';'M|tlplatzzu^id';'M|tlezu';'M|tfaktorzu';'M|tverw';'M|tverwzu';'F|condexpr(F|empty(M|tbehaelter),"NNNN",M|tbehaelter^id)';'F|condexpr(F|empty(M|tbehaelterzu),"NNNN",M|tbehaelterzu^id)';'F|condexpr(F|empty(M|tcharge),"NNNN",M|tcharge^id)';'F|condexpr(F|empty(M|tchargezu),"NNNN",M|tchargezu^id)';NNNN;NNNN            ? _F|sysinfo(18)^projekt & F|empty(M|tfertig)
..
!OUTPUT
.output
.formula U|xtsys = "edpimport.sh"
.. Datei 
.formula U|xtsys = U|xtsys + " -b 29"
.formula U|xtsys = U|xtsys + " -c EKS"
.. Tippkomando
.formula U|xtsys = U|xtsys + " -a DO"
.. Gruppenwechselfeld Kopf:erstes Tabellenfeld
.formula U|xtsys = U|xtsys + " -Z param:rowop"
.formula U|xtsys = U|xtsys + " -p " + 'G|einmalpw'
.. Eingabedatei
.formula U|xtsys = U|xtsys + " -I " + 'U|xtedp'
.. EDP Option
.formula U|xtsys = U|xtsys + " -o FOPMODE=0"
.. Feldwert nicht „ndern
.formula U|xtsys = U|xtsys + " -n NNNN"
.formula U|xtsys = U|xtsys + " > " + 'U|xtout' + " 2> " + 'U|xterr'
.system 'U|xtsys' background
.continue MEHR ? G|mehr
.protection -reset hinweis 'M|aktzeile'
.formula U|origftext = ""
.formula U|copyftext = ""
.assign U|origftext = "U|xterr"
.assign U|copyftext = "M|hinweis"
.input "is/COPY.FREETEXT"
.type DVMR2 xbatext ? _F|defined(U|xbatext)
.file -screen -tempname U|xbatext
.output new 'U|xbatext'
.input "DATEI.F"
.input -text 'M|hinweis'
..
.formula M|iconlbu = "icon:stop" 
..
.continue LINE  
..
!MEHR
.formula M|iconlbu = "icon:save"
.protection hinweis 'M|aktzeile'
.copy M|tmark = G|FALSE
.protection tmge 'M|aktzeile'
.protection tprojektzu 'M|aktzeile'
.protection tlezu 'M|aktzeile'
.protection tfaktorzu 'M|aktzeile'
.protection tchargezu 'M|aktzeile'
.protection tmark 'M|aktzeile'
.continue LINE   
..
..*****************************************************************************
!END
.continue
