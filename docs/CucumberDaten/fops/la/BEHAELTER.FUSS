..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BEHAELTER.FUSS
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Infosystem um Zeilen bereinige, die nicht den passenden 
..                  Beh„lter haben
..*****************************************************************************
.set trans -
..
.continue END ? M|tzeilen = 0
..
.select screen header
..
!LINE
.select screen line        
.continue END ? _G|mehr
.continue DELLINE
..
!DEL
.make screen line -o
.continue END ? M|tzeilen = 0
...
!DELLINE
.continue DEL ? F|empty(M|tbehaelter)
.continue DEL ? M|selbehaelter^id <> M|tbehaelter^id
.continue LINE
..
!END
.continue

