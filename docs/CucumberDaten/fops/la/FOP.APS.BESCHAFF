..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FOP.APS.BESCHAFF
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Etagis Aufruf aus IS BSTATUS
..*****************************************************************************
.set trans -
.type text xpfad   ? _F|defined(U|xpfad)
.type text xwindir ? _F|defined(U|xwindir)
..
.. von "/" zu "\" wechseln
.formula U|xwindir = 'F|regreplaceall(G|clwindir, "\/", "\\")'
..
.formula U|xpfad = "aps\gui\etagisviewer.exe"
.formula U|xpfad = U|xpfad + " /ini=" + U|xwindir + "\aps\gui\etagis_viewer.ini"
.formula U|xpfad = U|xpfad + " /mandantini=" + U|xwindir + "\mandant.ini"
.formula U|xpfad = U|xpfad + " /exportdir=" + U|xwindir + "\aps\daten"
.formula U|xpfad = U|xpfad + " /edp"
.formula U|xpfad = U|xpfad + " /abasgantt=procurement "
.formula U|xpfad = U|xpfad + G|dblquote + "/abasganttid=" + 'M|select' + G|dblquote
..
.pc.exec 'U|xpfad'                                                                                          
..
..*****************************************************************************
!END
.continue

