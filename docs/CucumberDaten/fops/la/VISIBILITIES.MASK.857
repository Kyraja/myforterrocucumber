..!interpreter declaration english translate
..
.. This EFOP switches the row details of mask 857 into old or new layout.
.. It is called automatically from the executable files of abas ERP.
..
.. DO NOT INSERT IT INTO fop.txt!!!
..
.. OLDVALUMV: material valuation
.. OLDVALUPA: production activity
.. delete part of kontextfop
.set trans -
.formula P|maskkontextfop ='F|regreplaceall(P|maskkontextfop," OLDVALU", "")'
.formula P|maskkontextfop ='F|regreplaceall(P|maskkontextfop," OLDVALUMV", "")'
.formula P|maskkontextfop ='F|regreplaceall(P|maskkontextfop," OLDVALUPA", "")'
.. calculate part of kontextfop
.formula P|maskkontextfop = P|maskkontextfop + " OLDVALU" ? M|bewss=false
.formula P|maskkontextfop = P|maskkontextfop + " OLDVALUMV" ? M|bewss=false & (F|value(M|kosart, "AS208")="(PostWarehouseStock)" ; F|value(M|kosart, "AS208")="(PostWIPStock)")
.formula P|maskkontextfop = P|maskkontextfop + " OLDVALUPA" ? M|bewss=false & (F|value(M|kosart, "AS208")="(PostProductionCosts)" ; F|value(M|kosart, "AS208")="(PostProductionCostsWIP)")
..'F|value(M|kosart, "AS208")'
..'P|maskkontextfop'
.continue
