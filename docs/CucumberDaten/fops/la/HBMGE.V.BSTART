.set trans -
.type text xtstring
..
.continue          ? _F|empty(M|klgruppe)
.continue OK       ? _F|empty(M|kart) ; _F|empty(M|klohnfert) ; _F|empty(M|kba) ; _F|empty(M|klief)
.error Bitte zuerst Halbfabrikat / Beistellung oder Lohnfertigung eintragen.
.end 1
..
!OK
.continue ENDLG ? F|empty(M|kart)
..
..  Artikelmenge (Åber alle LG) des Halbfabrikats/Beistellung ausgeben
.formula U|xtstring = "$,,;@ordnung=artikel;@ablageart=(Active)"
.formula U|xtstring = U|xtstring + ";artikel=" + M|kart^id ? _F|empty(M|kart)
.select group "40:7" 'U|xtstring'
..
.formula M|klemge  = H|bestand     ? G|mehr
.formula M|kdlemge = H|dbestand ? G|mehr
.formula M|kle     = H|le      ? G|mehr
..
!ENDLG
.input "is/TABLEEREN"
.continue
