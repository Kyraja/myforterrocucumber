..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SCHEDREPORT.EV
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.type text    xtmp    ? _F|defined(U|xtmp)
.type text    xkom    ? _F|defined(U|xkom)
.type text    xueb    ? _F|defined(U|xueb)
.type text    xd      ? _F|defined(U|xd)
.type text    xteiler ? _F|defined(U|xteiler)
.type bool    xfirst  ? _F|defined(U|xfirst)
.type text    xtext   ? _F|defined(U|xtext)
.type text    xsys    ? _F|defined(U|xsys)
.type text    xdatei  ? _F|defined(U|xdatei)       
.set trans -
..
.formula U|xdatei = "la/DISPOSERV.PAR"
.. 
.formula M|permdispoz = "icon:media_play_green" ?   F|filenotempty(U|xdatei)
.formula M|permdispoz = "icon:abort"            ?  _F|filenotempty(U|xdatei)
..
.copy U|xfirst = G|FALSE
..
!PROT: letzter Dispositionslauf
.up
.output terminal
.input "BILDB.F"
.formula U|xtmp = "X" + pid + ".TMP"
.formula U|xkom= "tail -1 la/MTFJ > " + U|xtmp + " 2>${DEVNULL:-/dev/null}"
.system 'U|xkom' background
.continue LEEREMTFJ  ? _G|mehr
.continue PL1
..
!LEEREMTFJ: Leerzeile in la/MTFJ
.formula U|xtext = "la/MTFJ"
.output addedto 'U|xtext' 


.output
.continue KOPF
..
!PL1
.select from 'U|xtmp' U|xd ^
.continue ERROR2 ? _G|mehr
..
.formula U|xteiler = (U|xd>>"")<<""
.formula M|startam = U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""      
.formula M|startum =  U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""
.formula M|endam   = U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""
.formula M|endum   = U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""
.formula M|dnummer = U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""
.formula M|zeichen = U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""
.formula M|status  = U|xteiler<<" "
.formula U|xteiler = (U|xteiler>>" ")>>""
.formula M|kenner  = U|xteiler<<" "
..
.select from
.formula U|xkom="rm "+U|xtmp
.system 'U|xkom' background
.continue END    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "protokoll"
..
!KOPF
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "von"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bis"
.continue BESCH     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "eigen"
.continue BESCH     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "fremd"
.continue TYPALLE   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "alle"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp1"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp2"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp3"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp4"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp5"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp6"
.continue RADIOBU   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "dtyp7"
.continue NORADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "artikel"
.continue NORADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "lgruppe"
.continue NORADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ebetreuer"
.continue NORADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "fbetreuer"
.continue BSTART    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue PROT      ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "protokoll"
.continue DISPO     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "dispo"
.continue TABLEEREN
..
!BESCH 
.copy M|fremd = G|FALSE   ? M|fremd & G|evtvar = "eigen"
.copy M|eigen = G|FALSE   ? M|eigen & G|evtvar = "fremd"
.copy M|fremd = G|FALSE   ? _M|eigen & _M|fremd
.continue TABLEEREN
..
!DISPO: Dispoprotokoll starten
.command -parallel "(Scheduling)"
.continue END
..
!TYPALLE
.copy M|dtyp1 = G|FALSE  ? M|alle
.copy M|dtyp2 = G|FALSE  ? M|alle
.copy M|dtyp3 = G|FALSE  ? M|alle
.copy M|dtyp4 = G|FALSE  ? M|alle
.copy M|dtyp5 = G|FALSE  ? M|alle
.copy M|dtyp6 = G|FALSE  ? M|alle
.copy M|dtyp7 = G|FALSE  ? M|alle
.formula M|artikel = ""
.formula M|lgruppe = ""
.copy M|dtyp1 = G|TRUE   ? _M|alle
.continue TABLEEREN
..
!RADIOBU
.copy M|alle  = G|FALSE
.copy M|dtyp1 = G|FALSE  ? M|dtyp1 & G|evtvar <> "dtyp1"
.copy M|dtyp2 = G|FALSE  ? M|dtyp2 & G|evtvar <> "dtyp2"
.copy M|dtyp3 = G|FALSE  ? M|dtyp3 & G|evtvar <> "dtyp3"
.copy M|dtyp4 = G|FALSE  ? M|dtyp4 & G|evtvar <> "dtyp4"
.copy M|dtyp5 = G|FALSE  ? M|dtyp5 & G|evtvar <> "dtyp5"
.copy M|dtyp6 = G|FALSE  ? M|dtyp6 & G|evtvar <> "dtyp6"
.copy M|dtyp7 = G|FALSE  ? M|dtyp7 & G|evtvar <> "dtyp7"
.formula M|artikel = ""
.copy M|alle  = G|TRUE ? _M|dtyp1 & _M|dtyp2 & _M|dtyp3 & _M|dtyp4 & _M|dtyp5 & _M|dtyp6 & _M|dtyp7
.continue TABLEEREN
..
!NORADIOBU
.copy M|alle   = G|TRUE
.copy M|dtyp1  = G|FALSE
.copy M|dtyp2  = G|FALSE
.copy M|dtyp3  = G|FALSE
.copy M|dtyp4  = G|FALSE
.copy M|dtyp5  = G|FALSE
.copy M|dtyp6  = G|FALSE
.copy M|dtyp7  = G|FALSE
.continue PRODUCT   ? G|evtvar = "artikel"
.continue TABLEEREN ? G|evtvar = "lgruppe"
.continue TABLEEREN ? G|evtvar = "ebetreuer"
.continue TABLEEREN ? G|evtvar = "fbetreuer"
.continue END
..
!PRODUCT
.continue TABLEEREN ? _F|empty(M|artikel)
.copy M|alle       = G|TRUE 
.formula M|lgruppe = ""
.continue TABLEEREN
..
!TABLEEREN
.input "is/TABLEEREN"
.continue END
..
!BSTART
.continue ERROR1 ? _F|empty(M|bis) & _F|empty(M|von) & 'M|von:8' > 'M|bis:8'
.continue ERROR ? (_M|alle & _M|dtyp1 & _M|dtyp2 & _M|dtyp3 & _M|dtyp4 & _M|dtyp5 & _M|dtyp6 & _M|dtyp7) & F|empty(M|artikel)
.formula M|select = "$,,"
.formula M|select = M|select + ";bearbtyp==D 11"
.formula M|select = M|select + ";erfass=" + 'M|von' + "!" + 'M|bis'
.formula M|select = M|select + ";@ordnung=bearbtyp,prio"
.continue NODTYP ? _F|empty(M|ebetreuer)
.continue NODTYP ? _F|empty(M|fbetreuer)
.continue NODTYP ? _F|empty(M|artikel)
.continue NODTYP ? M|eigen
.continue NODTYP ? M|fremd
.continue ALLE   ? M|alle & F|empty(M|artikel)
.continue DTYP1  ? M|dtyp1             
.continue DTYP2  ? M|dtyp2
.continue DTYP3  ? M|dtyp3
.continue DTYP4  ? M|dtyp4
.continue DTYP5  ? M|dtyp5
.continue DTYP6  ? M|dtyp6
.continue DTYP7  ? M|dtyp7
.continue ERROR
..
!ALLE: Alle Fehlertypen auflisten
.formula M|select = M|select + ";prio=1!"
.continue SELECT
..
!DTYP1: Negativer Bestand / (NegativeStock)
.. typ = 2
.formula M|select = M|select + ";menge<>0;prio=2" 
.continue SELECT
..
!DTYP2: Fehlmenge / (Shortage)
.. typ = 3
.formula M|select = M|select + ";menge<>0;prio=3" 
.continue SELECT
..
!DTYP3: öberdeckung / (SurplusStock)
.. typ = 4
.formula M|select = M|select + ";menge<>0;prio=4" 
.continue SELECT
..
!DTYP4: Plankarte mit zu vielen BS/RES/MZ / (TooManyProcurements) (TooManyReservations) (TooManyReservations)
.. typ = 5,6,7
.formula M|select = M|select + ";prio=1!"
.continue SELECT
..
!DTYP5: Konfiguration / (SchedParamIncorrect)
.. typ = 1
.formula M|select = M|select + ";prio=1" 
.continue SELECT
..
!DTYP6: Zyklus
.. typ = 8
.formula M|select = M|select + ";prio=8" 
.continue SELECT
..
!DTYP7: gesperrte Artikel
..gesperrter Artikel,  wie Fehlmenge behandeln
.. typ = 3
.formula M|select = M|select + ";menge<>0;prio=3"
.. die gesperrten Artikel werden im Tabellenfop raussortiert 
.continue SELECT
..
!NODTYP: Artikel und Lagergruppe
.formula M|select = M|select + ";prio=1!"
.formula M|select = M|select + ";vorgang="+M|artikel^id+";bezobj="+M|lgruppe^id  ? _F|empty(M|artikel) & _F|empty(M|lgruppe)
.formula M|select = M|select + ";vorgang="+M|artikel^id+";bezobj<>`"             ? _F|empty(M|artikel) &  F|empty(M|lgruppe)
.formula M|select = M|select + ";vorgang^ebetreuer="+M|ebetreuer^id                 ? _F|empty(M|ebetreuer)
.formula M|select = M|select + ";vorgang^fbetreuer="+M|fbetreuer^id                 ? _F|empty(M|fbetreuer)
.formula M|select = M|select + ";vorgang^bsart=(InhouseProduction)"                 ? M|eigen
.formula M|select = M|select + ";vorgang^bsart=(ExternalProcurement)"               ? M|fremd
.copy U|xfirst = G|TRUE
.continue SELECT
..
!SELECT
.select group 'M|grliste' 'M|select'
.continue SNODTYP ? _G|mehr & (_F|empty(M|artikel) ; _F|empty(M|ebetreuer) ; _F|empty(M|fbetreuer)) & U|xfirst
.continue END     ? _G|mehr
.continue TAB
..
!SNODTYP
.formula M|select = "$,,;bearbtyp==D 11;prio=3;@ordnung=bearbtyp,prio"
.copy U|xfirst = G|FALSE
.continue SELECT
..
!TAB
.input 'M|tab'
..
.select continue
.continue SECOND ? _G|mehr & (_F|empty(M|artikel) ; _F|empty(M|ebetreuer) ; _F|empty(M|fbetreuer)) & U|xfirst
.continue END    ? _G|mehr
.continue TAB 
..
!SECOND: 2. Schleife fÅr Artikel und Lagergruppe
.formula M|select = "$,,;bearbtyp==D 11;prio=1!"
.formula M|select = M|select + ";vorgang^artex="+M|artikel^id+";bezobj="+M|lgruppe^id ? _F|empty(M|artikel) & _F|empty(M|lgruppe)
.formula M|select = M|select + ";vorgang^artex="+M|artikel^id+";bezobj<>`"            ? _F|empty(M|artikel) &  F|empty(M|lgruppe)
.formula M|select = M|select + ";vorgang^artex^ebetreuer="+M|ebetreuer^id             ? _F|empty(M|ebetreuer)
.formula M|select = M|select + ";vorgang^artex^fbetreuer="+M|fbetreuer^id             ? _F|empty(M|fbetreuer)
.formula M|select = M|select + ";vorgang^artex^bsart=(InhouseProduction)"             ?  M|eigen
.formula M|select = M|select + ";vorgang^artex^bsart=(ExternalProcurement)"           ?  M|fremd
.copy U|xfirst = G|FALSE
.continue SELECT
..*****************************************************************************
!END
.continue
..*****************************************************************************
!ERROR
.error -message Bitte Artikel eintragen.
.end 1
..
!ERROR1
.error -field M|bis -message Falscher Zeitraum!
.formula M|bis = ""
.end 1
..
!ERROR2
.error -message Protokolljournal la/MTFJ nicht gefunden oder nicht lesbar.
.end 1
