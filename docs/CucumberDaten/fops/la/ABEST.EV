..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABEST.EV
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
..*****************************************************************************
.set trans -
..
.type bool xbanf     ? _F|defined(U|xbanf)
.type text xselect   ? _F|defined(U|xselect)
.type P2:1 xvar      ? _F|defined(U|xvar)
..
..---------------------------- Kopfteil/Header:--------------------------------
.continue ARTIKEL     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue BLGRUPPE    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "blgruppe"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "beigen"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bfremd"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bumlagern"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "blohnfert"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bnullzeilen"
.continue KLGRUPPE    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "klgruppe"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "von"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bis"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "vartikel"
.continue TABLEEREN   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bartikel"
.continue
..
!BLGRUPPE: all warehouse groups
.continue NOBLGRUPPE  ? _M|blgruppe
.formula M|klgruppe   = ""
.copy M|beigen = G|FALSE
.copy M|bfremd = G|FALSE
.copy M|bumlagern = G|FALSE
.copy M|blohnfert = G|FALSE
.protection M|beigen
.protection M|bfremd
.protection M|bumlagern
.protection M|blohnfert
.continue TABLEEREN
..
!NOBLGRUPPE
.assign M|klgruppe = F|sysinfo(10)^intlgruppe
.protection -reset M|beigen
.protection -reset M|bfremd
.protection -reset M|bumlagern
.protection -reset M|blohnfert
.continue TABLEEREN
..
!ARTIKEL
.continue ERROR3 ? _M|blgruppe & _M|beigen & _M|bfremd & _M|bumlagern & _M|blohnfert
.formula M|von     = F|fystartdate(F|getfy(G|datum)) ? F|empty(M|von)
.formula M|bis     = "."                       ? F|empty(M|bis)
.continue ERROR1                               ? M|bis < M|von
.formula M|select  = "$,,@gruppe=1;"       ?  M|blgruppe
.formula M|select  = "$,,"                 ? _M|blgruppe
.copy U|xbanf = G|TRUE
..
.formula M|select  = M|select + ";@numsuch=" + M|vartikel + "!" + M|bartikel
.formula U|xselect = M|select + ";@lesen=nein"
.assign U|xvar = U|xselect
.continue ERROR2 ? _G|mehr
.input "is/TABLEEREN"
..
!HOL: query database
.input "is/HOL.LISTE"
.continue
..
!KLGRUPPE: Lagergruppe / warehouse group
.protection -reset M|beigen
.protection -reset M|bfremd
.protection -reset M|bumlagern
.protection -reset M|blohnfert
.continue FIRMA               ? F|empty(M|klgruppe)
.formula M|blgruppe = G|FALSE
.continue TABLEEREN
..
!FIRMA: interne Lagergruppe / internal warehouse group
.assign M|klgruppe = F|sysinfo(10)^intlgruppe
.continue TABLEEREN
..
!TABLEEREN
.input "is/TABLEEREN"
.continue
..*****************************************************************************
..
!ERROR1
.error -line 0 -field M|von -message Kein korrekter Zeitraum.
.end 1
..
!ERROR2
.cursor vartikel  0
.error
.end 1
..
!ERROR3
.error Bitte eine Beschaffungsart w„hlen.
.end 1
