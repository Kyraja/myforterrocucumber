..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SQDELETE.EDP
.. Author         : tiwe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Function       : EDP-Handling fÅr SQDELETE
..                 
.. Functionality  : Lîschen von Platzmengen 
..
..
.. Variablen
.set trans -
.type text U|xtwork ? _F|defined(xtwork)
.type text U|xterr  ? _F|defined(xterr)
.type text U|xtcmd  ? _F|defined(xtcmd)
..
.formula U|xtwork = "rmtmp/SQDELETE."+'M|aktzeile'+".EDP"
.formula U|xterr  = "rmtmp/SQDELETE."+'M|aktzeile'+".ERR"
.input "DATEI.F"
.output new 'U|xtwork'
#!database=40:3          
#!action=delete
#!password='G|einmalpw'
id;
'M|tplatzmenge^id'
.output
.formula U|xtcmd = "edpimport.sh -c EKS -P -I " +'U|xtwork'
.formula U|xtcmd = 'U|xtcmd' + " 2> "+'U|xterr'
.system 'U|xtcmd' background
.formula M|tedpdat    = 'U|xtwork'
.formula M|tedperrdat = 'U|xterr'
.continue EDPOK  ? G|mehr
..Das Lîschen der Platzmenge konnte nicht ausgefÅhrt werden 
.continue ERR01 
!EDPOK
.formula M|tstatus = M|loeschenokay
.continue ENDE
..************************************************************
.. Programmende
..************************************************************
!ENDE
.continue
..************************************************************
.. Fehlerhandling
..************************************************************
!ERR01
.copy M|edpfehler = G|true
.formula M|tstatus = M|loeschenfehler
.continue ENDE
