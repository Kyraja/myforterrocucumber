..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APLANISTVERGL.SE
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..
.. Includes
.. include la/APLANISTVERGL2.TAB
..*****************************************************************************
.set trans -
.. read colors
.input "is/ABASFARBEN.DEF"
..
.. set common colors
.assign M|bgtable3   = U|xabasstructuretop 
.assign M|bgtable2   = U|xabasstructuresub
.assign M|bgtable1   = "-1 -1 -1"
..
.. Initializations
.assign M|closeknot  = "is/CLOSE.EVENTNODE"
.assign M|openknot   = "la/APLANISTVERGL2.TAB"
.assign M|afterclose = "la/APLANISTVERGL.FARBE"
..
.assign P|maskkontextfop = ""
..
.. Set Icons
.formula M|rotz   = G|icoerror
.formula M|gelbz  = G|icowarn
.formula M|gruenz = G|icook
.formula M|abwz   = "icon:attention"
..
.. Feldvorbelegungen
.. Abweichung Menge
.formula M|mgeposgelb  = 80
.formula M|mgeposgruen = 10
.formula M|mgeneggelb  = 80
.formula M|mgeneggruen = 10
.. Abweichung Wert
.formula M|wertposgelb    = 80
.formula M|wertposgruen   = 10
.formula M|wertneggelb    = 80
.formula M|wertneggruen   = 10
..
.assign M|anzstufen  = 0
.protection gdistplan
..
..*****************************************************************************
!END
.continue
