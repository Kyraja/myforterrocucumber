..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INV.HOL.ZL
.. Autor/Author   : Marco Machmer
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Holt eine Z„hlliste
..
.. Ablauf         :
.. Besonderheiten : ist immer Unterprogramm
..                  INI-datei INVENTUR.INI muá im aufrufenden
..                  eingezogen sein
..                  liefert folgende variablen
..                        xzlnr       ... z„hlistennummer
..                        xzlsnr      ... z„hllistensatznummer
..                        xistartdat  ... inventurstart datum
..                        xistartzeit ... inventurstart zeit
..                        xbablage    ... ablageflag
..                        xIOSchl     ... schlssel fr Inv-Obj
..  
..*****************************************************************************
.set trans -
.type bool  xbablage    ? _F|defined(U|xbablage)
.type text  xIOSchl     ? _F|defined(U|xIOSchl)
.type date  xistartdat  ? _F|defined(U|xistartdat)
.type time  xistartzeit ? _F|defined(U|xistartzeit)
.type text  xzlnr       ? _F|defined(U|xzlnr)
.type text  xzlsnr      ? _F|defined(U|xzlsnr)
..
.end ? txname / "*INV.HOL.ZL"
..
.read "Z„hllistennummer (RETURN fr Selektionsleiste)" U|xzlnr
..
.continue EL001 ? _(+U|xzlnr > 0)
.select stocktaking 'U|xzlnr'
.continue FI001
..
!EL001
.select stocktaking "%?"
..
!FI001
.continue EL002 ? _G|mehr
.continue EL003 ? _gruppe = 2
.formula U|xzlnr       = H|nummer
.formula U|xzlsnr      = (dnsn >> "asn=") << " "
.formula U|xistartdat  = H|startdat
.formula U|xistartzeit = H|startzeit
.formula U|xbablage    = H|end
..
.. schlssel fr inv-obj
.continue EL004 ? _U|xbablage
.formula U|xIOSchl = U|xInvObjSchlAbl
.continue FI002
..
!EL004
.formula U|xIOSchl = U|xInvObjSchl
.continue FI002
..
!EL003
.box Fehler
Objekt 'xzlnr' ist keine Z„hlliste!
..
.formula U|xzlnr = ""
.continue
..
!EL002
.box Fehler
Konnte Z„hlliste 'U|xzlnr' nicht finden!
..
.formula U|xzlnr = ""
.continue
..
!FI002
..
