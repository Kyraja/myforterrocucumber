..  Funktion       : Infosystem, Berichtskopf
..                   Artikel mit Anzahl Plankartenzeilen
..
..*****************************************************************************
.set trans -
.type text xout
..
.formula M|part = "0"
.formula M|plgruppe = "0"
.formula M|anz = 0
..
.formula U|xout = "XPLAN" + 'G|pid' + ".TMP"
.formula M|tmpname = U|xout
..
.output new 'U|xout'
.input "DATEI.F"
.copy M|sammeln = G|true
.continue
