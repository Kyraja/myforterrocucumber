..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : PLANSHOW.TAB
..  Datum          : 04.05.2004
..  Version        :
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Infosystem, Tabellenzeigfop, Artikel mit Anzahl
..                   Plankartenzeilen
..
..  Functionality  : Infosystem, Table-View-FOP, Product with Plan-chart-lines


..  Ablauf         :
..
..*****************************************************************************
.set trans -
.continue LIST ? _M|sammeln
..
!COLLECT: Sammeln
.continue     ?  H|art^gruppe <>1
.continue GRW ? 'H|art^id' <> part ; 'H|lgruppe^id' <> plgruppe
.formula M|anz = M|anz + 1
.continue
..
!GRW: Gruppenwechsel - Group changed
'M|anz' 'M|part' 'M|plgruppe'
.formula M|anz = 1
.formula M|part = 'H|art^id'
.formula M|plgruppe = 'H|lgruppe^id'
..
.continue
..
!LIST: auflisten
.continue ? M|anz = 0 & M|part = "0" & M|plgruppe = "0"
..
!HOL:
.select parts 'M|part'
.continue ? dispo = "C"
..
.make screen line +O
..
.formula M|artsuch  = M|part
.formula M|tanz     = M|anz
.formula M|tlgruppe = M|plgruppe
.continue
