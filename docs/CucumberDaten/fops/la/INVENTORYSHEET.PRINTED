..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVENTORYSHEET.PRINTED
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Executes the Inventory sheet for ".printed".
..*****************************************************************************
.set trans -
..
.continue END ? P|vorschau
.continue END ? M|gedruckt
..
.select object lock 'M|zaehllistenr^id'
.continue ERROR1  ? _G|mehr
.continue NOLOCK  ? _G|gesperrt
.action +
.continue SUCCESS ? P|erg=0
.. Print process failed
.continue REWORK
..
!SUCCESS: Document was printed
.copy H|gedruckt = G|TRUE
.copy M|gedruckt = H|gedruckt
.rewrite
..
!REWORK
.select -
.action -
.continue ERROR2 ? P|erg<>0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Inventory sheet missing
.error Keine Z„hlliste vorhanden!
.end 1
..
!ERROR2: Print process failed
.error Druck gescheitert
.end 1
..
!NOLOCK: Lock failed
.error Z„hlliste konnte nicht gesperrt werden!
.end 1
