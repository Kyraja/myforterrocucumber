..
..  --------------------------
..
..
..  mh, 13.10.2008: "tgart" only in row in abas, but must be in header for ATLAS-msg
..
.formula T|xtversion = "02"
..
.file -tempname T|xtatausfuhrtmpdatei
.output new 'T|xtatausfuhrtmpdatei'
.input "DATEI.F"
..
!NEXTHEAD
.select screen header
.continue ENDHEAD ? _T|mehr
!NEXTHD2
.select screen line
.continue ENDHEAD ? _T|mehr
.continue NEXTHD2 ?  M|tpatlasgem
.continue NEXTHD2 ? _M|tbmelden
..
..  group rows by tgart
.formula T|xtGART = M|tgart^schl
..
..
..
.. Satzart UNBI
..
.formula T|xVERSION = T|xtversion
.formula T|xABSENDER = M|ksender
.formula T|xABSQUALIFIER = ""
.formula T|xADRRUECK = ""
.formula T|xEMPF = M|kuebzollst
.formula T|xEMPQUALIFIER = M|kuebzollst
.formula T|xEMPFWEITER = ""
.. JJJJMMTT
.formula T|xDATERST = 'M|kdatum:8'
.. HHMM
.formula T|xZEITERST = (("00" + ('M|kzeit' << ":")) >> 2) + (("00" + ('M|kzeit' >> ":")) >> 2)
.formula T|xUEFOLGENR = ""
.formula T|xUEBNRALT = ""
.formula T|xUEBNRNEU = ""
.formula T|xDATREF = ""
.formula T|xUEBDATUM = 'M|kdatum:8'
.formula T|xSYNTAXKENN = ""
.formula T|xSYNTAXVERSNO = ""
.formula T|xREFPASSEMP = ""
.formula T|xREFPASSEMPQU = ""
.formula T|xTESTKENN = ""
..
.formula T|xLFDNR = T|xLFDNR + 1
UNBI#'T|xVERSION'#'T|xABSENDER'#'T|xABSQUALIFIER'#'T|xADRRUECK'#'T|xEMPF'#'T|xEMPQUALIFIER'#'T|xEMPFWEITER'#'T|xDATERST'#'T|xZEITERST'#'T|xUEFOLGENR'#'T|xUEBNRALT'#'T|xUEBNRNEU'#'T|xDATREF'#'T|xUEBDATUM'#'T|xSYNTAXKENN'#'T|xSYNTAXVERSNO'#'T|xREFPASSEMP'#'T|xREFPASSEMPQU'#'T|xTESTKENN'#####'T|xLFDNR'#
..
..
..
.. Satzart UNHI
..
.formula T|xVERSION = T|xtversion
.formula T|xREFERENZNR = M|krefnummer
.formula T|xNACHRTYP = "CUSDEC"
.formula T|xVERSFRGNR = ""
.formula T|xBELEGART = ""
.formula T|xVERWORG = ""
.formula T|xVORGSCH = ""
..
.formula T|xLFDNR = T|xLFDNR + 1
UNHI#'T|xVERSION'#'T|xREFERENZNR'#'T|xNACHRTYP'#'T|xVERSFRGNR'#'T|xBELEGART'#'T|xVERWORG'#'T|xVORGSCH'#################'T|xLFDNR'#
..
..
..
.. Satzart BGMI
..
.formula T|xVERSION = 'T|xtversion'
.formula T|xBELEGNR = M|kvorgang^nummer
.formula T|xBELEGDAT = M|kvorgang^term:8
.formula T|xFUNKTION = ""
.formula T|xANTWORTART = ""
.formula T|xZAHLDAT = ""
.formula T|xVDATVOR = ""
..
.formula T|xLFDNR = T|xLFDNR + 1
BGMI#'T|xVERSION'#'T|xBELEGNR'#'T|xBELEGDAT'#'T|xFUNKTION'#'T|xANTWORTART'#'T|xZAHLDAT'#'T|xVDATVOR'#################'T|xLFDNR'#
..
..
..
.. Satzart LOC1
..
.formula T|xAUSFLAND = 'F|sysinfo(10)^staat^iso2'
.formula T|xBESTLAND = 'M|kvstaat^iso2'
.formula T|xWALADORTC = M|kladeortcode
.formula T|xWALADSTRH = M|kladeortstr
.formula T|xWALADPLZ = M|kladeortplz
.formula T|xWALADORT = M|kladeortort
.formula T|xWALADORTZ = M|kladeortzus
.formula T|xAUSZOSTDNR = 'M|kuebzollst'
.formula T|xAUSFZSTEAM = ""
.formula T|xVORAZSTDR = ""
..
.formula T|xLFDNR = T|xLFDNR + 1
LOC1#'T|xAUSFLAND'#'T|xBESTLAND'#'T|xWALADORTC'#'T|xWALADSTRH'#'T|xWALADPLZ'#'T|xWALADORT'#'T|xWALADORTZ'#'T|xAUSZOSTDNR'#'T|xAUSFZSTEAM'#'T|xVORAZSTDR'##############'T|xLFDNR'#
