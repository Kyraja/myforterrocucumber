TDT1#'T|xBEZNR'#'T|xVERSCHARTC'#'T|xBEFMINVZWEIG'#'T|xBEFMABART'#'T|xBEFMABVKZ'#'T|xBEFMABSTAAT'#'T|xBEFMGRVZWEIG'#'T|xBEFMGRART'#'T|xBEFMGRVKZ'#'T|xBEFMGRSTAAT'#'T|xGESTAMTPLZ'#'T|xGESTVVANFG'#'T|xGESTVVENDE'###########'T|xLFDNR'#
