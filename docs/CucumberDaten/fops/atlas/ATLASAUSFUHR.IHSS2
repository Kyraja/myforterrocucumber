..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATLASAUSFUHR.IHSS-2
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Schreibt IHSS-Datei ABAS-ATLAS Version 2 aus dem Infosystem
.. Functionality  : Writes IHSS file ATLAS-ATLAS Version 2 from infosystem.
..*****************************************************************************
.set trans -
..
.type text   xtversion
..
.type text   xt1     ? _F|defined(T|xt1)
.type text   xt2     ? _F|defined(T|xt2)
.type text   xt3     ? _F|defined(T|xt3)
.type text   xt4     ? _F|defined(T|xt4)
.type text   xt5     ? _F|defined(T|xt5)
..
.. one "messsage" for each tgart^schl
.type text   xtGART
..
.. row counter
.type integer  xLFDNR
..
.. header information
.type text xVERSION
..
.. Ansprechpartner
.type text xANSSTELL
.type text xANSSACHB
.type text xANSTELEFON
.type text xANSTELEFAX
.type text xANSEMAIL
..
..
.. Satzart UNBI
..
.type text xABSENDER
.type text xABSQUALIFIER
.type text xADRRUECK
.type text xEMPF
.type text xEMPQUALIFIER
.type text xEMPFWEITER
.type text xDATERST
.type text xZEITERST
.type text xUEFOLGENR
.type text xUEBNRALT
.type text xUEBNRNEU
.type text xDATREF
.type text xUEBDATUM
.type text xSYNTAXKENN
.type text xSYNTAXVERSNO
.type text xREFPASSEMP
.type text xREFPASSEMPQU
.type text xTESTKENN
..
..
.. Satzart UNHI
..
.type text xREFERENZNR
.type text xNACHRTYP
.type text xVERSFRGNR
.type text xBELEGART
.type text xVERWORG
.type text xVORGSCH
..
..
.. Satzart BGMI
..
.type text xBELEGNR
.type text xBELEGDAT
.type text xFUNKTION
.type text xANTWORTART
.type text xZAHLDAT
.type text xVDATVOR


.. Satzart LOC1
..
.type text xAUSFLAND
