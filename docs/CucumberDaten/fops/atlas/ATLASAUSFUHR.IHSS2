..
..
..
.. Satzart EXP1
..
.continue EEXP1   ?  F|empty(M|kspediteur)
..
.formula T|xAUSFUEHRER = 'M|kspedtin'
.formula T|xAUSDZOLLNUM = "0"            ? _M|kspedzolld
.formula T|xAUSDZOLLNUM = "1"            ?  M|kspedzolld
.formula T|xAUSNAME1 = M|kspediteur^sucherw
.formula T|xAUSNAME2 = M|kspediteur^ans<<";"
.formula T|xAUSNAME3 = M|kspediteur^ans>>";"
.formula T|xAUSSTR1 = M|kspediteur^str<<";"
.formula T|xAUSSTR2 = M|kspediteur^str>>";"
.formula T|xAUSORT = M|kspediteur^nort
.formula T|xAUSFPLZ = M|kspediteur^plz
.formula T|xAUSLAND = M|kspediteur^staat^iso2
.formula T|xANSSTELL = ""
.formula T|xANSSACHB = ""
.formula T|xANSTELEFON = ""
.formula T|xANSTELEFAX = ""
.formula T|xANSEMAIL = ""
..
.formula T|xLFDNR = T|xLFDNR + 1
EXP1#'T|xAUSFUEHRER'#'T|xAUSDZOLLNUM'#'T|xAUSNAME1'#'T|xAUSNAME2'#'T|xAUSNAME3'#'T|xAUSSTR1'#'T|xAUSSTR2'#'T|xAUSORT'#'T|xAUSFPLZ'#'T|xAUSLAND'#'T|xANSSTELL'#'T|xANSSACHB'#'T|xANSTELEFON'#'T|xANSTELEFAX'#'T|xANSEMAIL'#########'T|xLFDNR'#
..
!EEXP1
..
..
..
.. Satzart DT1
..
.continue EDT1    ?  F|empty(M|ksender)
..
.formula T|xANMELDER = 'M|ksender'
.formula T|xANMDZOLLNUM = "1"
.formula T|xANMNAME1 = 'F|sysinfo(10)^sucherw'
.formula T|xANMNAME2 = 'F|sysinfo(10)^ans'<<";"
.formula T|xANMNAME3 = 'F|sysinfo(10)^ans'>>";"
.formula T|xANMSTR1 = 'F|sysinfo(10)^str'<<";"
.formula T|xANMSTR2 = 'F|sysinfo(10)^str'>>";"
.formula T|xANMORT = 'F|sysinfo(10)^nort'
.formula T|xANMPLZ = 'F|sysinfo(10)^plz'
.formula T|xANMLAND = 'F|sysinfo(10)^staat^iso2'
.formula T|xANSSTELL = ""
.formula T|xANSSACHB = M|kzollverant^sucherw     ?  _F|empty(M|kzollverant)
.formula T|xANSTELEFON = M|kzollverant^tele      ?  _F|empty(M|kzollverant)
.formula T|xANSTELEFAX = M|kzollverant^fax       ?  _F|empty(M|kzollverant)
.formula T|xANSEMAIL = M|kzollverant^email       ?  _F|empty(M|kzollverant)
.formula T|xANSSACHB = M|kzollverantn            ?  _F|empty(M|kzollverantn)
.formula T|xANSEMAIL = M|kzollverante            ?  _F|empty(M|kzollverante)
..
.formula T|xLFDNR = T|xLFDNR + 1
DT1#'T|xANMELDER'#'T|xANMDZOLLNUM'#'T|xANMNAME1'#'T|xANMNAME2'#'T|xANMNAME3'#'T|xANMSTR1'#'T|xANMSTR2'#'T|xANMORT'#'T|xANMPLZ'#'T|xANMLAND'#'T|xANSSTELL'#'T|xANSSACHB'#'T|xANSTELEFON'#'T|xANSTELEFAX'#'T|xANSEMAIL'#########'T|xLFDNR'#
..
!EDT1
..
..
..
.. Satzart AE1
..
.continue EAE1    ?  F|empty(M|kvertreter)
..
.formula T|xVERTRETER = 'M|kvertin'
.formula T|xVERDZOLLNUM = "0"            ? _M|kverzolld
.formula T|xVERDZOLLNUM = "1"            ?  M|kverzolld
.formula T|xVERNAME1 = M|kvertreter^sucherw
.formula T|xVERNAME2 = M|kvertreter^ans<<";"
.formula T|xVERNAME3 = M|kvertreter^ans>>";"
.formula T|xVERSTR1 = M|kvertreter^str<<";"
.formula T|xVERSTR2 = M|kvertreter^str>>";"
.formula T|xVERORT = M|kvertreter^nort
.formula T|xVERPLZ = M|kvertreter^plz
.formula T|xVERLAND = M|kvertreter^staat^iso2
.formula T|xANSSTELL = ""
.formula T|xANSSACHB = ""
.formula T|xANSTELEFON = ""
.formula T|xANSTELEFAX = ""
.formula T|xANSEMAIL = ""
