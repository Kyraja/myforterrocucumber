FTK1#'T|xREGNRFSYS'#'T|xVERMTEIL1'#'T|xVERMTEIL2'#'T|xVERMTEIL3'#'T|xVERMTEIL4'#'T|xVERMTEIL5'#'T|xAUSERSTATT1'#'T|xAUSERSTATT2'#'T|xAUSERSTATT3'#'T|xAUSERSTATT4'#'T|xAUSERSTATT5'#'T|xAUSERSTAAC'#'T|xAUSERSTATZW'#'T|xAUSERSTATZB'#'T|xAUSSICHKTO'#'T|xAUSERSTATKVC'#'T|xKENNRSEND'#######'T|xLFDNR'#
..
