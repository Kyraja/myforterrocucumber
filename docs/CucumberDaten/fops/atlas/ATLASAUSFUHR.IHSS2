..
..
.. Satzart GIS1
..
.formula T|xZEIPANMELD = (("00" + ('M|kzeit' << ":")) >> 2) + (("00" + ('M|kzeit' >> ":")) >> 2)
.formula T|xBESOUMSTC = ""
.formula T|xBFKOSTZWC = ""
.formula T|xGFVORGAC = 'M|tgart^schl'
.formula T|xBTKONSTC = 'M|kbetkonst^kbezbspr'
.formula T|xCONTCODL = ""
.formula T|xGESROHM = 'M|kbruttogew'
.formula T|xBEWILLIGUNG = 'F|sysinfo(10)^atlasnr'
..
.formula T|xLFDNR = T|xLFDNR + 1
GIS1#'T|xZEIPANMELD'#'T|xBESOUMSTC'#'T|xBFKOSTZWC'#'T|xGFVORGAC'#'T|xBTKONSTC'#'T|xCONTCODL'#'T|xGESROHM'####'T|xBEWILLIGUNG'#############'T|xLFDNR'#
