..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUSFUHR.EDI2IHSS
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type text   xtsystem   ? _F|defined(xtsystem)
.type integer    xiunbi     ? _F|defined(xiunbi)
.formula T|xiunbi = 0
..
.continue END     ?  F|empty(T|xvatedi)  ;  F|empty(T|xvatvorgang)
..
.select edifact 'T|xvatedi^id'
.continue END     ? _T|mehr
..
.. construct export file name
.input "ATLASAUSFUHRDATEI"
..
!NROW
.select line
.continue ENDHOL  ? _T|mehr
.continue ENDHOL  ?  H|text1 = "UNBI"  &  T|xiunbi > 0
.continue NEWFILE ?  H|text1 = "UNBI"
.continue NROW    ?  T|xiunbi = 0
.continue ROW
..
!NEWFILE
.formula T|xiunbi = H|aktzeile
.file -tempname T|xtatausfuhrtmpdatei
.output new 'T|xtatausfuhrtmpdatei' -encoding ISO-8859-1
.input "DATEI.F"
..
!ROW
'text1'#'text2'#'text3'#'text4'#'text5'#'text6'#'text7'#'text8'#'text9'#'text10'#'text11'#'text12'#'text13'#'text14'#'text15'#'text16'#'text17'#'text18'#'text19'#'text20'#'text21'#'text22'#'text23'#'text24'#'text25'#
.continue NROW
..
!ENDHOL
.output
.formula T|xtsystem = "cp -f " + 'T|xtatausfuhrtmpdatei' + " " + 'T|xtatausfuhrdatei' + "_" + 'T|xiunbi' + ".TXT"
.system 'T|xtsystem' background
..
.. end of rows, or new unbi block?
.continue NEWFILE ?  H|aktzeile > 0  &  H|aktzeile <> H|ozeilen
..*****************************************************************************
!END
.continue
