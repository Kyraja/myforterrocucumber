..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATLASAUSFUHR.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : FÅllt Infosystemzeilen aus Vorgang.
.. Functionality  : Fills infosystem table rows from transaction.
...Includes       :
..  include     atlas/ATLASAUSFUHR.UNTERLAGE
..*****************************************************************************
.set trans -
..
.make screen line +O
..
.. is item flagged for export..?
.assign M|tpatlasrel = H|patlasrel
.assign M|tpatlasgem = H|patlasgem
.formula   M|tblirelev  = H|lirelev
.formula   M|tbrerelev  = H|rerelev
.formula   M|tbmelden   = H|patlasrel
..
.. general information about item
.assign M|tartex  = H|artex^id
.assign M|ttename = H|artex^sucherw
.assign M|tofmge  = H|ofmge
.assign M|tmge    = H|mge
.assign M|the     = H|he
.assign M|tpreis  = H|preis
.assign M|tpwert  = H|pwert
.assign M|tnwert  = H|nwert
.assign M|tland   = H|kopf^land^id
..
..  ------------------------------------
..
..  NT6     Positionsnummer der Ware
.assign M|tpos = 'H|pnum'
..
..  P12:3   Warennummer
.assign M|tpahnum = H|pahnum^id
..
..  PS39:2  Ladeort
.assign M|tladeort = H|lgruppe^id
..
..  P12:3   Art des GeschÑftsvorgangs  (NT6)
.assign M|tgart    = H|pgart^id
.assign M|tgart    = H|kopf^gart^id   ?  F|empty(H|pgart)
..
..  A215    Packmitteltyp
.assign M|tpmtyp   = H|pmtyp
..
..  GL70    Vermerk
.assign M|tpatvermerk = H|patvermerk
..
..  PS97:1  Ursprungsbundesland
.assign M|tregion = H|iregion^id
..
..  MP6.3   Eigenmasse der Ware
.assign M|tgewicht = H|posgewicht
.assign M|tgewicht = H|gewicht * H|mge    ?  F|empty(M|tgewicht)
..
..  MP6.3   Rohmasse der Ware
.assign M|trohmasse = M|tgewicht
..
..  ARTR51000   Menge fÅr Aussenhandelsstatistik
.assign M|tintramge = H|intramge
..
..  ARTR52000 (R9.2) Statistischer Wert (Intrastat)
.assign M|tswert = H|swert
..
..  PS64:5  Typ der Vorpapiere
.assign M|tvorpapier = H|vorpapier^id
..
..  IP6     Anzahl der PackstÅcke
.assign M|tpmanz = H|pmanz
..
..  I9      PackstÅcknummer
.assign M|tpacknr = H|packnr
..
..  P70     Vorpapier
.assign M|tpdoku = H|pdoku^id
..
..  PS64:8  Unterlage
.assign M|tunt1 = H|unterlage^id
.input "ATLASAUSFUHR.UNTERLAGE"
..
..  Verfahren
.assign M|tpatverfan  = H|patverfan^id
.assign M|tpatverfvor = H|patverfvor^id
.assign M|tpatverfwei = H|patverfwei^id
..
..  Verpackungsart
.assign M|tverpackart = H|verpackart
..
..*****************************************************************************
!END
.continue
