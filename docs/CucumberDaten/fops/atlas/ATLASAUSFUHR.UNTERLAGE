..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATLASAUSFUHR.UNTERLAGE
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Ermittlerung der Unterlagen zu einer Vorgangsposition
.. Functionality  : x
..*****************************************************************************
.set trans -
..
.type text   xfeldunt    ? _F|defined(T|xfeldunt)
.type text   xfeldtyp    ? _F|defined(T|xfeldtyp)
.type text   xfeldqua    ? _F|defined(T|xfeldqua)
.type text   xfeldref    ? _F|defined(T|xfeldref)
.type text   xfeldzus    ? _F|defined(T|xfeldzus)
.type text   xfelddetail ? _F|defined(T|xfelddetail)
.type text   xfeldausst  ? _F|defined(T|xfeldausst)
.type text   xfeldguedat ? _F|defined(T|xfeldguedat)
.type text   xfeldwert   ? _F|defined(T|xfeldwert)
.type text   xfeldabsqua ? _F|defined(T|xfeldabsqua)
.type text   xfeldabseinh? _F|defined(T|xfeldabseinh)
.type text   xfeldabswert? _F|defined(T|xfeldabswert)
..
..
.. event handling
.. ----------- ----- Tabellenteil Korrekturen ----------------------------------
.continue AHNUM   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "tpahnum"
.continue START   ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "bstart"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
..*****************************************************************************
!START
..
..  Erste Unterlage aus Vorgangsposition
..
.formula M|tunt1         =  H|unterlage^id
.formula M|tunt1typ      =  M|tunt1^kbezbspr<<4
.formula M|tunt1qua      =  M|tunt1^kbezbspr<<-5<<3
.formula M|tunt1ref      =  M|tunt1^such
.formula M|tunt1zus      = ""
.formula M|tunt1detail   =  M|tunt1^kbezbspr
.formula M|tunt1ausst    = ""
.formula M|tunt1guedat   = ""
.formula M|tunt1wert     = ""
.formula M|tunt1absqua   = ""
.formula M|tunt1abseinh  = ""
.formula M|tunt1abswert  = ""
..
.continue AHNUM
..
..*****************************************************************************
!LISTE
..
..  BEISPIEL: Unterlagen aus einer "Liste"
..
.type text   xtuntliste  ? _F|defined(T|xtuntliste)
.type text   xtkbezbspr  ? _F|defined(T|xtkbezbspr)
.type text   xtselUNT    ? _F|defined(T|xtselUNT)
.type integer    xi1         ? _F|defined(T|xi1)
.type P109:2 xvunterlage ? _F|defined(T|xvunterlage)
.type text   xttrenn     ? _F|defined(T|xttrenn)
..
.. Liste der Unterlagen, woher..?
.formula T|xtuntliste = "8GGK;3LLB-A18;9DEF"
.formula T|xttrenn = ";"
..
.. Liste mit Trenner abschliessen
.formula T|xtuntliste = T|xtuntliste + 'T|xttrenn'
..
..
.formula T|xi1 = 0
!NUNT1
.formula T|xi1 = T|xi1 + 1
.continue EUNT1   ? T|xi1 > 9
..
.formula T|xfeldunt    = "tunt" + 'xi1'
.formula T|xfeldtyp    = "tunt" + 'xi1' + "typ"
.formula T|xfeldqua    = "tunt" + 'xi1' + "qua"
.formula T|xfeldref    = "tunt" + 'xi1' + "ref"
.formula T|xfeldzus    = "tunt" + 'xi1' + "zus"
.formula T|xfelddetail = "tunt" + 'xi1' + "detail"
.formula T|xfeldausst  = "tunt" + 'xi1' + "ausst"
.formula T|xfeldguedat = "tunt" + 'xi1' + "guedat"
.formula T|xfeldwert   = "tunt" + 'xi1' + "wert"
.formula T|xfeldabsqua = "tunt" + 'xi1' + "absqua"
.formula T|xfeldabseinh= "tunt" + 'xi1' + "abseinh"
.formula T|xfeldabswert= "tunt" + 'xi1' + "abswert"
..
.continue CLEAR   ?  F|empty(T|xtuntliste)
..
.formula T|xtkbezbspr = T|xtuntliste<<T|xttrenn
.formula T|xtuntliste = T|xtuntliste>>(T|xtkbezbspr+T|xttrenn)
..
.formula T|xtselUNT = "$,,;kbezbspr==" + 'T|xtkbezbspr'
.assign T|xvunterlage = 'T|xtselUNT'
.continue CLEAR   ? _T|mehr
.continue CLEAR   ?  F|empty(T|xvunterlage)
..
.. get values from object
.formula M|.xfeldunt    = T|xvunterlage^id
.formula M|.xfeldtyp    = T|xvunterlage^kbezbspr<<4
.formula M|.xfeldqua    = T|xvunterlage^kbezbspr<<-5<<3
.formula M|.xfeldref    = T|xvunterlage^such
.formula M|.xfeldzus    = ""
.formula M|.xfelddetail = T|xvunterlage^kbezbspr
.formula M|.xfeldausst  = ""
.formula M|.xfeldguedat = ""
.formula M|.xfeldwert   = ""
.formula M|.xfeldabsqua = ""
.formula M|.xfeldabseinh= ""
.formula M|.xfeldabswert= ""
.continue NUNT1
..
.. clear detail fields
!CLEAR
.formula M|.xfeldunt    = ""
.formula M|.xfeldtyp    = ""
.formula M|.xfeldqua    = ""
.formula M|.xfeldref    = ""
.formula M|.xfeldzus    = ""
.formula M|.xfelddetail = ""
.formula M|.xfeldausst  = ""
.formula M|.xfeldguedat = ""
.formula M|.xfeldwert   = ""
.formula M|.xfeldabsqua = ""
.formula M|.xfeldabseinh= ""
.formula M|.xfeldabswert= ""
.continue NUNT1
!EUNT1
..
.continue END
..
..*****************************************************************************
!AHNUM
..
..  Unterlagen aus dem Freitext der Warennummer
..
.continue END     ?  F|empty(M|tpahnum)
.continue END     ?  F|empty(M|tpahnum^ftext)
..
.. quick check, if free text has been generated properly
.type text   xtpruef     ? _F|defined(T|xtpruef)
.select from 'M|tpahnum^ftext' xtpruef^
.select from
.continue LEER    ? _( T|xtpruef/"#!ATUNTERLAGEN*" )
..
.type text   xtzeile     ? _F|defined(T|xtzeile)
.type text   xtfeld      ? _F|defined(T|xtfeld)
.type text   xtrest      ? _F|defined(T|xtrest)
.type integer    xi          ? _F|defined(T|xi)
.type integer    xi2         ? _F|defined(T|xi2)
.type integer    xilen       ? _F|defined(T|xilen)
..
.type text   xtname      ? _F|defined(T|xtname)
.type text   xtname1     ? _F|defined(T|xtname1)
.type text   xtname2     ? _F|defined(T|xtname2)
.type text   xtname3     ? _F|defined(T|xtname3)
.type text   xtname4     ? _F|defined(T|xtname4)
.type text   xtname5     ? _F|defined(T|xtname5)
.type text   xtname6     ? _F|defined(T|xtname6)
.type text   xtname7     ? _F|defined(T|xtname7)
.type text   xtname8     ? _F|defined(T|xtname8)
.type text   xtname9     ? _F|defined(T|xtname9)
.type text   xtname10    ? _F|defined(T|xtname10)
.type text   xtname11    ? _F|defined(T|xtname11)
.type text   xtname12    ? _F|defined(T|xtname12)
.type text   xtname13    ? _F|defined(T|xtname13)
.type text   xtname14    ? _F|defined(T|xtname14)
.type text   xtname15    ? _F|defined(T|xtname15)
.type text   xtname16    ? _F|defined(T|xtname16)
..
.type text   xtstaat     ? _F|defined(T|xtstaat)
.type PS97:1 xvstaat     ? _F|defined(T|xvstaat)
.type P109:2 xvunt       ? _F|defined(T|xvunt)
.type text   xtselUNT    ? _F|defined(T|xtselUNT)
..
..
..  check: default country or specific country (destination)
..
.formula T|xtstaat = M|kvstaat^such + "#*"
!CHECK
.select from 'M|tpahnum^ftext' xtzeile^
.continue ECHECK  ? _T|mehr
.continue CHECK   ?  T|xtzeile<<1 = "#" ; F|empty(T|xtzeile)
.formula T|xtzeile = 'T|xtzeile'
.continue CHECK   ? +T|xtzeile < 3
.continue CHECK   ? _(T|xtzeile/T|xtstaat)
.continue CHECKOK
!ECHECK
.select from
.continue END     ?  T|xtstaat = "-#*"
.formula T|xtstaat = "-#*"
.continue CHECK
!CHECKOK
.select from
..
..
.. first row: field names
..
!FIRST
.select from 'M|tpahnum^ftext' xtzeile^
.continue EROW  ? _T|mehr
.continue FIRST ?  T|xtzeile<<1 = "#" ; F|empty(T|xtzeile)
.formula T|xtzeile = 'T|xtzeile'
.continue FIRST ? +T|xtzeile < 3
.formula T|xi = 0
!NNAME
.formula T|xtfeld = T|xtzeile<<"#"
.formula T|xilen  = 0 - +T|xtfeld - 1
.formula T|xtrest = T|xtzeile<<T|xilen
.formula T|xtzeile = 'T|xtrest'
.formula T|xi = T|xi + 1
.formula T|xtname.xi = T|xtfeld
.continue ENAME   ?  T|xi > 15
.continue NNAME   ? _F|empty(T|xtzeile)
!ENAME
..
..
..  data row
..
.. count documents in infosystem ATLASAUSFUHR
.formula T|xi2 = 0
..
!NROW
.select from 'M|tpahnum^ftext' xtzeile^
.continue EROW  ? _T|mehr
.continue NROW  ?  T|xtzeile<<1 = "#" ; F|empty(T|xtzeile)
.formula T|xtzeile = 'T|xtzeile'
.continue NROW  ? +T|xtzeile < 3
.continue NROW  ? _(T|xtzeile/T|xtstaat)
.formula T|xi = 0
!NFIELD
.formula T|xtfeld = T|xtzeile<<"#"
.. careful with dontchange placeholder
.formula T|xilen  = 0 - +T|xtfeld - 1
.formula T|xtrest = T|xtzeile<<T|xilen
.formula T|xtfeld = ""   ? T|xtfeld = "~"
.formula T|xtzeile = 'T|xtrest'
.formula T|xi = T|xi + 1
.. assign new value fields depending on  field names used in ftext
.formula T|xtname = T|xtname.xi
.type text   xtwert.xtname       ? _F|defined(T|xtwert.xtname)
.formula T|xtwert.xtname = T|xtfeld
.continue EFIELD  ?  T|xi > 15
.continue NFIELD  ? _F|empty(T|xtzeile)
!EFIELD
..
.formula T|xi2 = T|xi2 + 1
.continue EROW    ? T|xi2 > 9
..
.formula T|xfeldunt    = "tunt" + 'xi2'
.formula T|xfeldtyp    = "tunt" + 'xi2' + "typ"
.formula T|xfeldqua    = "tunt" + 'xi2' + "qua"
.formula T|xfeldref    = "tunt" + 'xi2' + "ref"
.formula T|xfeldzus    = "tunt" + 'xi2' + "zus"
.formula T|xfelddetail = "tunt" + 'xi2' + "detail"
.formula T|xfeldausst  = "tunt" + 'xi2' + "ausst"
.formula T|xfeldguedat = "tunt" + 'xi2' + "guedat"
.formula T|xfeldwert   = "tunt" + 'xi2' + "wert"
.formula T|xfeldabsqua = "tunt" + 'xi2' + "absqua"
.formula T|xfeldabseinh= "tunt" + 'xi2' + "abseinh"
.formula T|xfeldabswert= "tunt" + 'xi2' + "abswert"
..
.formula M|.xfeldtyp    = T|xtwert.kxunttyp        ?  F|defined(T|xtwert.kxunttyp)
.formula M|.xfeldqua    = T|xtwert.kxuntqua        ?  F|defined(T|xtwert.kxuntqua)
.formula M|.xfeldref    = T|xtwert.kxuntref        ?  F|defined(T|xtwert.kxuntref)
.formula M|.xfeldzus    = T|xtwert.kxuntzus        ?  F|defined(T|xtwert.kxuntzus)
.formula M|.xfelddetail = T|xtwert.kxuntdet        ?  F|defined(T|xtwert.kxuntdet)
.formula M|.xfeldausst  = T|xtwert.kxuntdataus     ?  F|defined(T|xtwert.kxuntdataus)
.formula M|.xfeldguedat = T|xtwert.kxuntdatgue     ?  F|defined(T|xtwert.kxuntdatgue)
.formula M|.xfeldwert   = T|xtwert.kxuntwert       ?  F|defined(T|xtwert.kxuntwert)
.formula M|.xfeldabsqua = T|xtwert.kxabsmgequa     ?  F|defined(T|xtwert.kxabsmgequa)
.formula M|.xfeldabseinh= T|xtwert.kxabsmgeeinh    ?  F|defined(T|xtwert.kxabsmgeeinh)
.formula M|.xfeldabswert= T|xtwert.kxabsmgewert    ?  F|defined(T|xtwert.kxabsmgewert)
..
.formula T|xtselUNT    =  "$,,;kbezbspr==" + M|.xfeldtyp
.formula T|xtselUNT    =  T|xtselUNT + "-" + M|.xfeldqua   ? _F|empty(M|.xfeldqua)
.assign M|.xfeldunt =  T|xtselUNT
..
.continue NROW
!EROW
..
..
.. clear remaining fields (e.g. if swapping goods number and the new number
.. has fewer documents associated)
..
!LEER
.type integer xi2      ? _F|defined(T|xi2)
.formula xi2 = 0   ? _( T|xtpruef/"#!ATUNTERLAGEN*" )
!LNEXT
.formula T|xi2 = T|xi2 + 1
.continue END    ?  T|xi2 > 9
.formula T|xfeldunt    = "tunt" + 'xi2'
.formula T|xfeldtyp    = "tunt" + 'xi2' + "typ"
.formula T|xfeldqua    = "tunt" + 'xi2' + "qua"
.formula T|xfeldref    = "tunt" + 'xi2' + "ref"
.formula T|xfeldzus    = "tunt" + 'xi2' + "zus"
.formula T|xfelddetail = "tunt" + 'xi2' + "detail"
.formula T|xfeldausst  = "tunt" + 'xi2' + "ausst"
.formula T|xfeldguedat = "tunt" + 'xi2' + "guedat"
.formula T|xfeldwert   = "tunt" + 'xi2' + "wert"
.formula T|xfeldabsqua = "tunt" + 'xi2' + "absqua"
.formula T|xfeldabseinh= "tunt" + 'xi2' + "abseinh"
.formula T|xfeldabswert= "tunt" + 'xi2' + "abswert"
.formula M|.xfeldunt    = ""
.formula M|.xfeldtyp    = ""
.formula M|.xfeldqua    = ""
.formula M|.xfeldref    = ""
.formula M|.xfeldzus    = ""
.formula M|.xfelddetail = ""
.formula M|.xfeldausst  = ""
.formula M|.xfeldguedat = ""
.formula M|.xfeldwert   = ""
.formula M|.xfeldabsqua = ""
.formula M|.xfeldabseinh= ""
.formula M|.xfeldabswert= ""
.continue LNEXT
..
..*****************************************************************************
!END
.continue
