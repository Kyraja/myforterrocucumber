..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATUNTERLAGEN.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Allgemeine Events im Infosystem ATUNTERLAGEN
.. Functionality  : General events in infosystem ATUNTERLAGEN
..*****************************************************************************
.set trans -
..
.type PS97:1 xvstaat
.type PS12:3 xvahnum
.type integer    xi
..
.. event evaluation
.. ----------- ----- Header ----------------------------------------------------
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kahnum"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kvstaat"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kuntliste"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbnurahnum"
.. ----------- ----- Table -----------------------------------------------------
.continue TUNT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "tunt"
.continue CHANGE  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar / "t*"
.. ----------- ---------- ---------- -------------------------------------------
.. no inserting/deleting of rows, if showing quick list only
.continue FORBID  ? T|evtartengl = "ROW_INSERTION_BEFORE"    &  M|kbnurahnum
.continue FORBID  ? T|evtartengl = "ROW_INSERTION_AFTER"   &  M|kbnurahnum
.continue FORBID  ? T|evtartengl = "ROW_DELETION_BEFORE"    &  M|kbnurahnum
.continue FORBID  ? T|evtartengl = "ROW_DELETION_AFTER"   &  M|kbnurahnum
.continue FORBID  ? T|evtartengl = "ROW_MOVE_BEFORE"    &  M|kbnurahnum
.continue FORBID  ? T|evtartengl = "ROW_MOVE_AFTER"   &  M|kbnurahnum
.. ----------- ---------- ---------- -------------------------------------------
.. must not remove "deleted" row, if deletion has to be saved
.continue DELROWV ? T|evtartengl = "ROW_DELETION_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.. keep country information when inserting new row
.continue NEWROWX ? T|evtartengl = "BUTTON_BEFORE"      & T|evtvar = "kbuzeile"
.continue NEWROWV ? T|evtartengl = "ROW_INSERTION_BEFORE"
.continue NEWROW  ? T|evtartengl = "ROW_INSERTION_AFTER"
.. ----------- ---------- ---------- -------------------------------------------
.. must not move rows, messes up order when saving
.continue FORBID  ? T|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!DELROWV
.. row is not saved yet - ok to delete
.continue END     ?  F|empty(M|tahnum) ; M|tbuspeichern = "icon:screen_new"
.. "mark" row for later deletion when saving
.formula M|tunt        = ""
.formula M|tunttyp     = ""
.formula M|tuntqua     = ""
.formula M|tuntref     = ""
.formula M|tuntzus     = ""
.formula M|tuntdet     = ""
.formula M|tuntdataus  = ""
.formula M|tuntdatgue  = ""
.formula M|tuntwert    = ""
.formula M|tabsmgequa  = ""
.formula M|tabsmgeeinh = ""
.formula M|tabsmgewert = ""
.. iconify
.formula M|tbuspeichern = "icon:screen_delete"
.formula M|tbmark = true
.formula M|tstatusz = ""
.continue FORBID
..
!NEWROWX
.formula T|xvstaat = M|kvstaat^id
.formula T|xvahnum = M|kahnum
.make screen line +O
.continue ROWFILL
!NEWROWV
.continue FORBID  ? M|aktzeile = 0
.continue END     ? M|aktzeile = M|ozeilen
.formula T|xvstaat = M|tvstaat^id
.formula T|xvahnum = M|tahnum
.make screen line +O
.continue ROWFILL
!NEWROW
.continue END     ? M|aktzeile < M|ozeilen
.formula T|xi = M|aktzeile - 1
.select screen line 'T|xi'
.formula T|xvstaat = M|tvstaat^id
.formula T|xvahnum = M|tahnum
.formula T|xi = T|xi + 1
.select screen line 'T|xi'
!ROWFILL
.formula M|tvstaat    = T|xvstaat^id
.formula M|tahnum     = T|xvahnum^id
.formula M|ttyp       = T|xvahnum^typ
.formula M|tahnum8    = T|xvahnum^ahnum
.formula M|tahnum2    = T|xvahnum^ahnum2
.formula M|tahnumzus  = T|xvahnum^ahnumzus
.formula M|tahnumzus2 = T|xvahnum^ahnumzus2
.formula M|tahnumnat  = T|xvahnum^ahnumnat
.formula M|tbuspeichern = "icon:screen_new"
.continue END     ?  T|evtvar = "kbuzeile"
.continue FORBID
..
!TUNT
.formula M|tunttyp     = M|tunt^kbezbspr<<4
.formula M|tuntqua     = M|tunt^kbezbspr<<-5<<3
.formula M|tuntref     = M|tunt^such
.formula M|tuntzus     = ""
.formula M|tuntdet     = M|tunt^kbezbspr
.formula M|tuntdataus  = ""
.formula M|tuntdatgue  = ""
.formula M|tuntwert    = ""
.formula M|tabsmgequa  = ""
.formula M|tabsmgeeinh = ""
.formula M|tabsmgewert = ""
.continue CHANGE
..
!CHANGE
.formula M|tbuspeichern = "icon:screen_edit"    ? _F|empty(M|tunt)  &  M|tbuspeichern <> "icon:screen_new"
.formula M|tbuspeichern = "icon:screen_delete"  ?  F|empty(M|tunt)
.formula M|tbmark = true
.formula M|tstatusz = ""
.continue END
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..
..*****************************************************************************
!END
.continue
