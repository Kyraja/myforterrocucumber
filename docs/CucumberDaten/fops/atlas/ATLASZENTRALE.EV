.set trans -
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkl"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kvstaat"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kstichtag"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbverkauf"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbeinkauf"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kboffen"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kberledigt"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbvorschau"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbliefer"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbrechnung"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kdatumvon"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kdatumbis"
.. ----------- ----- Tabellenteil ----------------------------------------------
.continue FORBID  ? T|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue
