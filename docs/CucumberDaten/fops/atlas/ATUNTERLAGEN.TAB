..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATUNTERLAGEN.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Zeilen-FOP: Warennummern und Unterlagen-Details
.. Functionality  : row efop: goods number and document details
..*****************************************************************************
.set trans -
..
.continue START   ?  F|defined(xbftextgen)
.type bool xbftextgen    ? _F|defined(T|xbftextgen)
.type bool xbftextvorh   ? _F|defined(T|xbftextvorh)
.type text   xtstaat     ? _F|defined(T|xtstaat)
.type PS97:1 xvstaat     ? _F|defined(T|xvstaat)
.type P109:2 xvunt       ? _F|defined(T|xvunt)
.type text   xtselUNT    ? _F|defined(T|xtselUNT)
.type text   xtzeile     ? _F|defined(T|xtzeile)
.type text   xtelem      ? _F|defined(T|xtelem)
.type text   xtfeld      ? _F|defined(T|xtfeld)
.type text   xtrest      ? _F|defined(T|xtrest)
.type integer    xi          ? _F|defined(T|xi)
.type integer    xilen       ? _F|defined(T|xilen)
.type text   xtname      ? _F|defined(T|xtname)
.type text   xtname1     ? _F|defined(T|xtname1)
.type text   xtname2     ? _F|defined(T|xtname2)
.type text   xtname3     ? _F|defined(T|xtname3)
.type text   xtname4     ? _F|defined(T|xtname4)
.type text   xtname5     ? _F|defined(T|xtname5)
.type text   xtname6     ? _F|defined(T|xtname6)
.type text   xtname7     ? _F|defined(T|xtname7)
.type text   xtname8     ? _F|defined(T|xtname8)
.type text   xtname9     ? _F|defined(T|xtname9)
.type text   xtname10    ? _F|defined(T|xtname10)
.type text   xtname11    ? _F|defined(T|xtname11)
.type text   xtname12    ? _F|defined(T|xtname12)
.type text   xtname13    ? _F|defined(T|xtname13)
.type text   xtname14    ? _F|defined(T|xtname14)
.type text   xtname15    ? _F|defined(T|xtname15)
.type text   xtname16    ? _F|defined(T|xtname16)
..
..
!START
.. Document data only exists if goods number ftext is not empty.
.. The first row must start with #!ATUNTERLAGEN, this marks
.. the free text as generated by this infosystem.
.formula T|xbftextgen  = false
.formula T|xbftextvorh = _F|empty(H|ftext)
.continue EFTEXT  ? _T|xbftextvorh
.select from 'H|ftext' xtzeile^
.formula T|xbftextgen  = ( T|xtzeile/"#!ATUNTERLAGEN*" )
.select from
!EFTEXT
..
.. Additional empty row to group detail rows if details are shown, and if
.. last or current row do have document details.
.continue EGROUP  ? M|ozeilen = 0
.continue EGROUP  ? M|kbnurahnum
.continue EGROUP  ? F|empty(M|tunt) & _T|xbftextgen
.make screen line +O
.protection -line 'M|aktzeile'
!EGROUP
..
.. data row - goods number details
.make screen line +O
.formula M|tahnum      = H|id
.formula M|ttyp        = H|typ
.formula M|tahnum8     = H|ahnum
.formula M|tahnum2     = H|ahnum2
.formula M|tahnumzus   = H|ahnumzus
.formula M|tahnumzus2  = H|ahnumzus2
.formula M|tahnumnat   = H|ahnumnat
.formula M|tvstaat     = ""
.formula M|tbftextvorh = T|xbftextvorh
.formula M|tstatusz    = G|icokrit ?  _T|xbftextgen & T|xbftextvorh
.protection -line 'M|aktzeile'  ?  M|kbnurahnum
..
.. exit efop, if..
.. * no document detail data exists
.. * checkbox "only goods numbers" is marked
.continue END     ? _T|xbftextgen
.continue END     ?  M|kbnurahnum
..
..*****************************************************************************
..
.. read ftext in goods number and extract document information
..
!FIRST: field names
.select from 'H|ftext' xtzeile^
.continue EROW  ? _T|mehr
.continue FIRST ?  T|xtzeile<<1 = "#" ; F|empty(T|xtzeile)
.formula T|xtzeile = 'T|xtzeile'
.continue FIRST ? +T|xtzeile < 3
.formula T|xi = 0
!NNAME
.formula T|xtfeld = T|xtzeile<<"#"
.formula T|xilen  = 0 - +T|xtfeld - 1
.formula T|xtrest = T|xtzeile<<T|xilen
.formula T|xtzeile = 'T|xtrest'
.formula T|xi = T|xi + 1
.formula T|xtname.xi = T|xtfeld
.continue ENAME   ?  T|xi > 15
.continue NNAME   ? _F|empty(T|xtzeile)
!ENAME
..
!NROW: data row (detail data for one document in each row)
.select from 'H|ftext' xtzeile^
.continue EROW  ? _T|mehr
.continue NROW  ?  T|xtzeile<<1 = "#" ; F|empty(T|xtzeile)
.formula T|xtzeile = 'T|xtzeile'
.continue NROW  ? +T|xtzeile < 3
.formula T|xi = 0
!NFIELD
.formula T|xtfeld = T|xtzeile<<"#"
.. careful with dontchange placeholder
.formula T|xilen  = 0 - +T|xtfeld - 1
.formula T|xtrest = T|xtzeile<<T|xilen
.formula T|xtfeld = ""   ? T|xtfeld = "~"
.formula T|xtzeile = 'T|xtrest'
.formula T|xi = T|xi + 1
.. assign new value fields depending on  field names used in ftext
.formula T|xtname = T|xtname.xi
.type text   xtwert.xtname       ? _F|defined(T|xtwert.xtname)
.formula T|xtwert.xtname = T|xtfeld
.continue EFIELD  ?  T|xi > 15
.continue NFIELD  ? _F|empty(T|xtzeile)
!EFIELD
..
.make screen line +O   ? _F|empty(M|tunt)
.. goods number details
.formula M|tahnum      =  H|id
.formula M|ttyp        =  H|typ
.formula M|tahnum8     =  H|ahnum
.formula M|tahnum2     =  H|ahnum2
.formula M|tahnumzus   =  H|ahnumzus
.formula M|tahnumzus2  =  H|ahnumzus2
.formula M|tahnumnat   =  H|ahnumnat
.formula M|tbftextvorh = true
.. country of destination
.formula T|xtstaat = ""
.formula T|xvstaat = ""
.formula T|xtstaat = T|xtwert.kxvstaat           ?  F|defined(T|xtwert.kxvstaat)
.formula T|xvstaat = T|xtstaat                   ?  T|xtstaat <> "-"
.. misc document data
.assign M|tvstaat   =  T|xvstaat^id
.formula M|tunttyp     =  T|xtwert.kxunttyp      ?  F|defined(T|xtwert.kxunttyp)
.formula M|tuntqua     =  T|xtwert.kxuntqua      ?  F|defined(T|xtwert.kxuntqua)
.formula M|tuntref     =  T|xtwert.kxuntref      ?  F|defined(T|xtwert.kxuntref)
.formula M|tuntzus     =  T|xtwert.kxuntzus      ?  F|defined(T|xtwert.kxuntzus)
.formula M|tuntdet     =  T|xtwert.kxuntdet      ?  F|defined(T|xtwert.kxuntdet)
.formula M|tuntdataus  =  T|xtwert.kxuntdataus   ?  F|defined(T|xtwert.kxuntdataus)
.formula M|tuntdatgue  =  T|xtwert.kxuntdatgue   ?  F|defined(T|xtwert.kxuntdatgue)
.formula M|tuntwert    =  T|xtwert.kxuntwert     ?  F|defined(T|xtwert.kxuntwert)
.formula M|tabsmgequa  =  T|xtwert.kxabsmgequa   ?  F|defined(T|xtwert.kxabsmgequa)
.formula M|tabsmgeeinh =  T|xtwert.kxabsmgeeinh  ?  F|defined(T|xtwert.kxabsmgeeinh)
.formula M|tabsmgewert =  T|xtwert.kxabsmgewert  ?  F|defined(T|xtwert.kxabsmgewert)
.formula M|tstatusz    =  G|icovkrit             ? _F|empty(M|tuntdatgue) & M|tuntdatgue < T|datum
.. reference of actual document object
.formula T|xtselUNT    =  "$,,;kbezbspr==" + M|tunttyp
.formula T|xtselUNT    =  T|xtselUNT + "-" + M|tuntqua   ? _F|empty(M|tuntqua)
.assign M|tunt      =  T|xtselUNT
..
.. store information for summary of documents into M|kuntliste
.continue NROW    ?  F|empty(M|kahnum) ;  ( M|kvstaat <> M|tvstaat  &  _F|empty(M|tvstaat) )
.formula T|xtelem = M|tunttyp                            ?  F|empty(M|tuntqua)
.formula T|xtelem = M|tunttyp + "-" + M|tuntqua          ? _F|empty(M|tuntqua)
.. #-entries first (all non-specific countries), õ-entries last (specific country match)
.formula M|kuntliste = T|xtelem + "#;" + M|kuntliste     ?  F|empty(M|tvstaat)
.formula M|kuntliste = M|kuntliste + T|xtelem + "õ;"     ? _F|empty(M|tvstaat)
.continue NROW
..
!EROW
.select from
..
.. refine summary of documents by country of destination
.. important: the list shows documents for default destination first!
.. EXAMPLE
..   only default:
..      3AAL#;3LLB-A23#;                    -> 3AAL;3LLB-A23;
..   first default, then country specific:
..      3AAL#;3LLB-A23#;3AALõ;3LLB-A19õ;
..      drop default -> 3AALõ;3LLB-A19õ;    -> 3AAL;3LLB-A19;
.continue ESUM    ?  F|empty(M|kuntliste)
.continue COUNTRY ?  M|kuntliste / "*õ;*"
!DEFAULT
.formula M|kuntliste = F|regreplaceall(M|kuntliste,"#;",";")
.continue ESUM
!CUT
.formula M|kuntliste = M|kuntliste>>"#;"
!COUNTRY
.continue CUT     ?  M|kuntliste / "*#;*"
.formula M|kuntliste = F|regreplaceall(M|kuntliste,"õ;",";")
!ESUM
..
..*****************************************************************************
!END
.continue
