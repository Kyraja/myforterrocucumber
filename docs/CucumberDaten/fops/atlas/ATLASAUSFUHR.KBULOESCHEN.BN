..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATLASAUSFUHR.KBULOESCHEN.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Storno einer Zollanmeldung durch Aufruf von Infosystem
..                  ATLASEXPORT + Vorgang + Button:L”schen
.. Functionality  : Cancel of customs registration by calling infosystem
..                  ATLASEXPORT + transaction no + button:delete
..*****************************************************************************
.set trans -
..
.continue END     ?  F|empty(M|kedi)
.continue END     ?  M|kedi^status = -9
..
..
.type text   xtfehler
.type text   xtsystem
..
.type text   xtdelatlasvorgang    ? _F|defined(xtdelatlasvorgang)
.type text   xtdelatlasvorgangout ? _F|defined(xtdelatlasvorgangout)
.type text   xtdelatlasvorgangerr ? _F|defined(xtdelatlasvorgangerr)
..
..
.. assign temporary files
.file -tempname T|xtdelatlasvorgang
.file -tempname T|xtdelatlasvorgangout
.file -tempname T|xtdelatlasvorgangerr
..
.output new 'T|xtdelatlasvorgang'
.input "DATEI.F"
#!action=do
#!typedcmd=38
#!flddelimiter=#
such         #kedi          #kvorgang          #kbuloeschen
ATLASEXPORT  #'M|kedi^id'   #'M|kvorgang^id'   #1
.output
..
.formula T|xtsystem = "edpimport.sh -p " + 'T|einmalpw' + " -c EKS -I " + 'T|xtdelatlasvorgang' + " >> " + 'T|xtdelatlasvorgangout' + " 2>> " + 'T|xtdelatlasvorgangerr'
.system 'T|xtsystem'  background
..
..
..*****************************************************************************
..
.. refresh data
..
.input "ATLASPARAMS"
.assign T|xvatvorgang = M|kvorgang^id
.assign T|xvatedi = ""
.input "ATLASSTATUS"
.assign M|katlasgem = T|xbatgemeldet
.assign M|kedi = T|xvatedi^id
..
..*****************************************************************************
!END
.input "atlas/ATLASAUSFUHR.BSTART.BV"
.continue
