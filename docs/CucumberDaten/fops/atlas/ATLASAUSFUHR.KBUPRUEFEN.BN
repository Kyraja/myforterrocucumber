.. warnings
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  ksender      ?  F|empty(ksender)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kzollstelle  ?  F|empty(kzollstelle)  &  M|kbzollausbda
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kauszollst   ?  F|empty(kauszollst)   &  M|kbzollausvor
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kuebzollst   ?  F|empty(kuebzollst)
