.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  klbed        ?  F|empty(klbed)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kincoterm    ?  F|empty(kincoterm)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kincoort     ?  F|empty(kincoort)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kincoland    ?  F|empty(kincoland)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kvzweig      ?  F|empty(kvzweig)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kbefmkz      ?  F|empty(kbefmkz)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kbefmart     ?  F|empty(kbefmart)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kbefmstaat   ?  F|empty(kbefmstaat)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kbruttogew   ?  F|empty(kbruttogew)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  krebetr      ?  F|empty(krebetr)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kland        ?  F|empty(kland)
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  katvermerk   ?  F|empty(katvermerk)
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  katvermerk2  ?  F|empty(katvermerk2)
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  katvermerk3  ?  F|empty(katvermerk3)
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  katvermerk4  ?  F|empty(katvermerk4)
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  katvermerk5  ?  F|empty(katvermerk5)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kzollverantn ?  F|empty(kzollverantn)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kzollverante ?  F|empty(kzollverante)
..
.. external number
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  krefnummer   ?  F|empty(krefnummer)
..
.. optional for sea or air transport
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  kregnummer   ?  F|empty(kregnummer)
..
.. not supported in default abas ERP
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  kvertreter   ?  F|empty(kvertreter)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kvertin      ?  F|empty(kvertin)   & _F|empty(kvertreter)
..
.. not supported in default abas ERP
..arbe -VORDERGRUND 'T|xabasblack' -HINTERGRUND 'T|xabasyellow'  ksubsped     ?  F|empty(ksubsped)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  ksubtin      ?  F|empty(ksubtin)   & _F|empty(ksubsped)
..
..
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kspediteur   ?  F|empty(kspediteur) &  M|kbetkonst<<1 = "1"
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kspedtin     ?  F|empty(kspedtin)   & _F|empty(kspediteur)
..
..
.. check required table fields
..
!NROW
.select screen line
.continue EROW    ? _T|mehr
.. reset colors
.colour -foreground -1 -1 -1   -background -1 -1 -1  tladeort  'M|aktzeile'
.colour -foreground -1 -1 -1   -background -1 -1 -1  tgart     'M|aktzeile'
.colour -foreground -1 -1 -1   -background -1 -1 -1  tpmtyp    'M|aktzeile'
.. warnings
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  tladeort  'M|aktzeile'  ?  F|empty(tladeort)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  tgart     'M|aktzeile'  ?  F|empty(tgart)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  tpmtyp    'M|aktzeile'  ?  F|empty(tpmtyp)
.continue NROW
!EROW
..
..*****************************************************************************
!END
.continue
