.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kkl          ?  F|empty(kkl)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  kvstaat      ?  F|empty(kvstaat)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow'  katlasgem    ?  F|empty(katlasgem)
