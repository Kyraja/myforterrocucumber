..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATLASEXPORT.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Allgemeines Eventhandling
.. Functionality  : General event handling
..*****************************************************************************
.set trans -
..
.type bool xbneu
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue KBEDI   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbedi"
.continue KBDATEI ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbdateien"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kedi"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kvorgang"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kverz"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kexportfop"
.. ----------- ----- Tabellenteil ----------------------------------------------
.continue FORBID  ? T|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!KBEDI: only one checkbox - invert other field
.formula T|xbneu = M|.evtvar
.formula M|kbedi =  T|xbneu
.formula M|kbdateien = _T|xbneu
.continue INIT
..
!KBDATEI: only one checkbox - invert other field
.formula T|xbneu = M|.evtvar
.formula M|kbedi = _T|xbneu
.formula M|kbdateien = T|xbneu
.continue INIT
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue
