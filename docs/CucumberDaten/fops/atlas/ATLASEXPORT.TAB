..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ATLASEXPORT.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Erstellen einer Tabellenzeile fr eine Datei, Dateiname
..                  steht in T|xtfopname
.. Functionality  : create table row for a file, file name is stored in
..                  T|xtfopname
..  include     atlas/ATLASPARAMS
..  include     atlas/ATLASSTATUS
..*****************************************************************************
.set trans -
..
.type text       xt1             ? _F|defined(T|xt1)
.type text       xt2             ? _F|defined(T|xt2)
.type text       xt3             ? _F|defined(T|xt3)
.type text       xtlebendig      ? _F|defined(T|xtlebendig)
.type text       xtablage        ? _F|defined(T|xtablage)
..
.. files or edi?
.continue FILES   ?  M|kbdateien
..
..
!EDIMSG
.make screen line +O
.assign M|tedi = H|id
.assign M|tvorgang = 1|id
..
.input "ATLASPARAMS"
.assign T|xvatvorgang = M|tvorgang^id
.input "ATLASAUSFUHRDATEI"
.formula T|xtfopname = T|xtatausfuhrdatei>>'M|kverz'
.formula M|tdatei = T|xtfopname      ?  F|fileexists(T|xtatausfuhrdatei)
.continue ICONZ
..
..
!FILES
.. extract transaction number from filename
.formula T|xt1 = T|xtfopname >> "AUSFUHR_"
.formula T|xt2 = T|xt1<<"_"
.formula T|xt1 = T|xt1>>"_"
.formula T|xt3 = T|xt1<<"_"
.formula T|xt3 = T|xt1 ? +T|xt3=0
.formula T|xtlebendig = T|xt2 + " "  + T|xt3
.formula T|xtablage   = T|xt2 + " +" + T|xt3
..
.. create table row
.make screen line +O
.formula M|tdatei = T|xtfopname
.assign M|tvorgang = T|xtablage
.assign M|tvorgang = T|xtlebendig     ? _T|mehr
..
.. must know transaction for additional information
.continue ICONZ   ?  F|empty(M|tvorgang)
..
.input "ATLASPARAMS"
.assign T|xvatvorgang = M|tvorgang^id
.input "ATLASSTATUS"
.assign M|tedi = T|xvatedi^id
.continue ICONZ
..
..
!ICONZ: status icon
.formula M|tstatus  = ""
.formula M|tstatusz = G|icowarn     ? _F|empty(M|tedi)
.formula M|tstatusz = G|icook      ?  M|tedi^status = 0
.formula M|tstatusz = "icon:ball_blue"       ?  M|tedi^status = 2
.formula M|tstatusz = "icon:ball_orange"     ?  M|tedi^status = -9
..*****************************************************************************
!END
.continue
