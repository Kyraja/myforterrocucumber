..
such;daustyp;kkreis;konzfa;konzhist;mdkenn;bukreis;adatum;edatum;bilkart;guvkart;nbmon;bkunde;bliefer;bkonto;bmitarb;ustsep;nullwert;bezzp;impdat;ktoobj;ezmandnr;ustpos;ursbetr;urhbetr;dasbetr;dahbetr;twaehr;tkurs;periode;peranf;perend;tbudat;soll
..
.. use internal data representation to ensure language independency
.set reference +
.formula xnbmon   = M|nbmon
.formula xbkunde  = M|bkunde
.formula xbliefer = M|bliefer
.formula xbkonto  = M|bkunde
.formula xbmitarb = M|bmitarb
.formula xbacurr  = M|bilkart
.formula xplcurr  = M|guvkart
.formula xustsep  = M|ustsep
.formula xnullwert= M|nullwert
.set reference -
..
.formula xkonzfa = M|konzfa
.formula xkkreis = M|kkreis
.. Map numbers of consolidation group an group company to group accounting numbers
.continue GETROW ? M|glabb = ""
.load 0 consolidation 'M|glabb'
!KRNUMBER
.load 0 line
.continue GETROW ? _mehr
.formula xkkreis = 0|konznr ? M|kkreis^id = 0|ktoobj^id
.formula xkonzfa = 0|konznr ? M|konzfa^id = 0|ktoobj^id
.continue KRNUMBER
..
.. loop over the export object
!GETROW
.select screen line
..quit program if no further rows available
.continue XMESSAGE1 ? _mehr
.formula xkontonr = 'M|ktoobj'
.formula xkontonr = 'M|ktoobj^dnr' + " " + 'M|konznr' ? _(M|konznr = "")
.set reference +
.formula xsoll = M|soll
.set reference -
..
'M|such';(105);'xkkreis';'xkonzfa';'M|konzhist';'M|mdkenn';'M|bukreis';'M|adatum:8';'M|edatum:8';'xbacurr';'xplcurr';'xnbmon';'xbkunde';'xbliefer';'xbkonto';'xbmitarb';'xustsep';'xnullwert';'M|bezzp:8';'xexpdatei';'xkontonr';'M|ktoobj';'M|ustpos';'M|dasbetr';'M|dahbetr';'M|dasbetr';'M|dahbetr';'M|twaehr';1.00;'M|periode';'M|peranf:8';'M|perend:8';'M|perend:8';'xsoll';
..Set next row
.continue GETROW
..
!XMESSAGE1
.. test if path for export file is defined
.continue XCOPY2CONS ? _F|empty(M|pfadkmand)
.continue END ? G|edp
..
.. copy import file from client tempdir to win client tempdir
.output terminal
.pc.copy -PC 'xexpdatei' 'xexpdatei'
.continue COPYERROR ? _mehr
.box
Erzeugte Exportdatei: 'xexpdatei'
.continue END
..
!XCOPY2CONS
.. copy import file from client tempdir to win/tmp of consolidation client
.output terminal
.type text xsys ? _defined(xsys)
.type text xscppath ? _defined(xscppath)
.continue ERRO2 ? _F|fileexists(xexpdatei)
.formula xscppath = 'M|pfadkmand'
.formula xsys =  "scp " + 'xexpdatei' + " " + 'xscppath' + " >" + 'xscpout' + " 2>" +'xscperr'
.system 'xsys'
.continue ERR01 ? F|filesize('xscperr') > 0
.set trans +
.formula xmeldung = F|formatstr("Exportdatei: {1} nach {2} kopiert.", xexpdatei, xscppath)
.set trans -
.box
'xmeldung'
.continue END
..
!COPYERROR
.error Exportdatei konnte nicht auf Clientrechner kopiert werden.
.end
..
!ERR01
.error Fehler beim Kopieren.
.editing -readonly 'xscperr'
.end
..
!ERR02
.error Exportdatei 'xexpdateix' existiert nicht.
.end
..
!ERR03
.error Kein TMP-Verzeichnis definiert.
.end
..
!END
