.set trans -
.continue START ? (evtartengl="BUTTON_AFTER" & evtvar = "dastart" )
.end 1
..
!START
..
.continue ERR03 ? _F|fileexists('E|TMP')
..
.input "ARB"
..
.. use fix settings of numerical representation
.set thoussep ""
.set decpoint  ","
.. -----------------------------------------------------
.. variable declaration
.. name of export fi
.type text xexpdatei
..
.. local variable of mapping between ident numbers
.type text xkontonr
..
.. message
.type text xmeldung
..
.. internal representation of booleans
.type text xnbmon:1 xbkunde:1 xbliefer:1 xbkonto:1 xbmitarb:1 xustsep:1 xnullwert:1 xsoll:1
..
.. typ of currency of balanca sheet accounts
.type text xbacurr
..
.. typ of currency of profit and loss accounts
.type text xplcurr
..
.. local variable for time
.type text xtime
..
.. local variable of T|mandant without spaces.
.type NT100 xmandant
..
.. group accounting number of group company
.type text xkonzfa
..
.. group accounting numer of consoldiation group
.type text xkkreis
..
.. scp error file
.type text xscperr
.formula xscperr='E|TMP'+"/KONSSCP.ERR"
..
.. scp output file
.type text xscpout
.formula xscpout='E|TMP'+"/KONSSCP.OUT"
.. -----------------------------------------------------
.. program initialisation
.. explicit setting of separator for 1000s
.set thoussep   ""
..
.. explicit setting of separator for decimals
.set decpoint "."
..
.. export file is in temp dir
.formula xtime='zeit' << ":" + 'zeit' >> ":"
..
.type text xtchar ? _defined(xtchar)
.type text xtrest ? _defined(xtrest)
.. mandant in upper case
.formula xtrest=-T|mandant
!NEXTLETTER
.. cut next character
.formula xtchar = xtrest<<1
.. string without first character
.formula xtrest = xtrest<<-1
.. append letter, if it is a letter
.formula xmandant = xmandant + xtchar ? xtchar / "/ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/"
.continue NEXTLETTER ? +xtrest > 0
.formula xexpdatei = "rmtmp/KONZEXP" + 'datum:8' + "T" + 'xtime' + 'xmandant' + 'pid' + ".IMP"
..
.. redirect output stream in file
.output new 'xexpdatei'
.input "DATEI.F"
..
