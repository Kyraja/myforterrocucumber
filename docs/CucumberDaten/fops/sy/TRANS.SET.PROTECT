..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.SET.PROTECT
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Steuert Schreibschutze. Bei Aktivierung eines Schreibschutzes
.. wird auch der zugehoerige Wert zurueckgesetzt.
.. Ablauf          : Unterprogramm
..
.. Functionality   : Controls the write protections. If a write protection is set,
.. its particular value will be reset.
.. Program flow    : Subroutine
...Includes        :
.. include sy/TRANS.PROTECT.DICTIONARY
.. include sy/TRANS.PROTECT.OPERATION
.. include sy/TRANS.PROTECT.LANGUAGE
.. include sy/TRANS.PROTECT.OPTION
..*****************************************************************************
.set trans -
..
.. The category controls the code running
.continue FATAL ? F|empty(M|category)
.continue 'M|category'
..
!CLIENT: Client was changed
.continue LANGCL ? M|polyglot
.protection butransall 0
.continue DICTION
..
!LANGCL
.protection -reset butransall 0
.continue DICTION ? M|lgspr = M|lgspren
.protection bufolangen 0
..
!DICTION: Protect dictionarys
.input "sy/TRANS.PROTECT.DICTIONARY"
..
!OPERAT: Protect operations
.input "sy/TRANS.PROTECT.OPERATION"
..
!LANG: Protect languages
.input "sy/TRANS.PROTECT.LANGUAGE"
..
!OPTION: Protect options
.input "sy/TRANS.PROTECT.OPTION"
..
!OPTION2: Protect limits of a dictionary
.copy M|hasopt = M|optcomplete ; M|optnottrans ; M|optnumber ; M|opttrans ; M|optcorrupt
.assign M|lastopt = "" ? _M|hasopt
.continue PLIMITS ? _M|hasopt ; _M|optnumber
.. Reset limits
.protection -reset lowlim 0
.protection -reset uplim 0
.continue OPTION3
..
!PLIMITS: Protect limits
.protection lowlim 0
.protection uplim 0
.assign M|lowlim = 0
.assign M|uplim = 0
..
!OPTION3: Reset name of file, infosystem or edit button for a list of files
.copy M|hasfop = M|fopstd ; M|fopow ; M|foparb ; M|fopone ; M|foptrans
.assign M|lastfop = "" ? _M|hasfop
.continue PALL3 ? _M|hasfop ; M|fopstd ; M|fopow
.continue FOPARB ? M|foparb
.continue FOPLIST ? M|foptrans
.continue INFOSYS ? M|dicinfosys
.protection -reset filename 0
.protection infosys 0
.assign M|infosys = ""
.continue END
..
!INFOSYS: Reset infosystem
.protection -reset infosys 0
.protection filename 0
.assign M|filename = ""
.continue END
..
!FOPARB: Reset file name
.protection -reset filename 0
.protection infosys 0
.assign M|infosys = ""
.continue END
..
!FOPLIST: Reset edit button for a list of files
.protection filename 0
.assign M|filename = ""
.protection infosys 0
.assign M|infosys = ""
.continue END
..
!PALL3: Standard or own -> protect name of file, infosystem and edit button for a list of files
.protection filename 0
.assign M|filename = ""
.protection infosys 0
.assign M|infosys = ""
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
