..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : DISPLAYS.TAB
.. Autor         : fwester
.. Verantwortlich: fwester
.. Kontrolle     : xg
.. Funktion      : Erzeugt eine Zeile in der Tabelle.
.. Ablauf        : Tabellen-EFOP
..
.. Functionality : Creates one row in the table.
.. Program flow  : Table efop
..*****************************************************************************
.set trans -
..
.make screen line +O
.formula M|tbaumstufe  = M|stufe
.formula M|typeofelem  = M|elementtype
.formula M|tlineoffile = M|lineoffile
.formula M|tmomofelem  = M|motherrow
.formula M|trootofelem = M|rootrow
..
.continue SCREEN ? M|elementtype = M|screennode
.continue USER   ? M|elementtype = M|usernode
.continue PID    ? M|elementtype = M|pidleaf
.continue FATAL
..
!SCREEN: Set tree details for a screen
.formula M|tbaumtext = ( U|xnewscreen * "-#X" )
.formula M|tbaumicon = M|path2screen
.formula M|tbauminfo = M|screentext + " - " + M|interface + M|screensep + M|tbaumtext
.formula M|tbaumstat = "+"
.formula M|tbaumstat = "-" ? (G|evtvar = "bstart" & M|tbaumstufe < M|anzstufen)
.formula M|tscreen = U|xnewscreen
.continue END
..
!USER: Set tree details for an user
.formula M|tbaumtext = M|usersymbol
.formula M|tbaumicon = M|path2user
.formula M|tbauminfo = M|usertext + " - " + M|client + M|screensep + M|usersymbol
.formula M|tbaumstat = "+"
.formula M|tbaumstat = "-" ? (G|evtvar = "bstart" & M|tbaumstufe < M|anzstufen)
.copy M|tusersymbol = M|usersymbol
.copy M|tclient = M|client
.continue END
..
!PID: Set tree details for a pid
.formula M|tbaumtext = M|pid
.formula M|tbaumicon = M|path2pid
.formula M|tbauminfo = M|pidtext + " - " + M|host + M|screensep + M|pid
.formula M|tbaumstat = ""
.copy M|tinterface = M|interface
.copy M|thost = M|host
.copy M|tlocation = M|location
.copy M|tpid = M|pid
.copy M|tcallerno = M|callerno
.copy M|tdateofpid = M|dateofpid
.copy M|ttimeofpid = M|timeofpid
.formula M|tscreen = U|xnewscreen
.copy M|tclient = M|client
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
