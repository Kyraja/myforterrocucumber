..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.PROTECT.OPTION
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Schuetzt die Rubrik "Option".
.. Ablauf          : Unterprogramm
..
.. Functionality   : Protects the category "option".
.. Program flow    : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xmark ? _F|defined(U|xmark)
..
.. Initializations
.assign U|xmark = "END"
..
.copy M|hasdo = M|doadd ; M|dogen ; M|doedit ; M|dosubedit ; M|dotest ; M|doteststrict ; M|doinsert ; M|dotrans ; M|dotransfocmd ; M|dorepair ; M|domsgdat ; M|domsgclean
.assign M|lastdo = "" ? _M|hasdo
.continue HASADO ? M|hasdo
..
..Something went wrong, protect every single option
!FOP
.protection fopall 0
.copy M|fopall = G|FALSE
.protection fopstd 0
.copy M|fopstd = G|FALSE
.protection fopow 0
.copy M|fopow = G|FALSE
.protection foparb 0
.copy M|foparb = G|FALSE
.protection fopone 0
.copy M|fopone = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
.continue 'U|xmark' ? U|xmark <> "END"
..
!OPT
.protection optcomment 0
.copy M|optcomment = G|FALSE
.protection optcomplete 0
.copy M|optcomplete = G|FALSE
.protection optnottrans 0
.copy M|optnottrans = G|FALSE
.protection opttrans 0
.copy M|opttrans = G|FALSE
.protection optcorrupt 0
.copy M|optcorrupt = G|FALSE
.protection optnumber 0
.copy M|optnumber = G|FALSE
.protection charsetutf16 0
.copy M|charsetutf16 = G|FALSE
.protection alwaysen 0
.copy M|alwaysen = G|FALSE
.protection csvformat 0
.copy M|csvformat = G|FALSE
.continue 'U|xmark'
..
!HASADO: An operation is selected
.continue GERMAN ? _M|polyglot
.continue TOOLOFF ? _M|toolmode
.. use tool options and deactivate normal ones
.. the same as if german
.continue TOOLSON
..-----------------------------------------------------------------------------
!TOOLOFF: Use normal options and deactivate tool options
.assign U|xmark = "ALWAYS2"
.continue OPT
..
!ALWAYS2: Polyglot and tool mode not activated
.copy M|fopall = G|FALSE
.continue ADDING ? M|doadd
.continue FOCMD  ? M|dotransfocmd
.continue TRANS  ? M|dotrans
.assign U|xmark = "END"
.continue FOP
..
!ADDING
.continue ADDING1 ? M|dicinfosys
.continue ADDING2 ? M|dicfop ; M|dictxt
.continue ADDING3 ? M|dicawa
.protection foparb 0
.copy M|foparb = G|FALSE
.protection fopone 0
.copy M|fopone = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
.continue ADDING2 ? M|dicmask ; dicascii
.protection fopstd 0
.copy M|fopstd = G|FALSE
.protection fopow 0
.copy M|fopow = G|FALSE
.continue DFLT1
..
!ADDING1
.protection -reset fopow 0
.protection -reset fopone 0
.protection -reset fopstd 0
.protection foparb 0
.copy M|foparb = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
.continue DFLT1
..
!ADDING2
.protection -reset fopstd 0
.protection -reset fopow 0
.continue DFLT1 ? M|dicmask ; dicascii
.protection -reset foparb 0
.protection -reset fopone 0
.protection -reset foptrans 0
.continue DFLT1
..
!ADDING3
.protection -reset fopstd 0
.protection -reset fopow 0
.protection -reset foparb 0
.protection fopone 0
.copy M|fopone = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
.continue DFLT1
..
!FOCMD
.protection fopstd 0
.copy M|fopstd = G|FALSE
.protection fopow 0
.copy M|fopow = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
..
.protection -reset foparb 0
.protection -reset fopone 0
.continue DFLT1
..
!TRANS
.continue TRANS1 ? M|dicfop
.continue TRANS2 ? M|dicinfosys
.protection fopstd 0
.copy M|fopstd = G|FALSE
.protection fopow 0
.copy M|fopow = G|FALSE
.protection foparb 0
.copy M|foparb = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
.protection fopone 0
.copy M|fopone = G|FALSE
.continue DFLT1 ? M|dicawa ; M|dichelp ; M|dicmask ; M|dicascii
.continue END
..
!TRANS1
.protection -reset fopstd 0
.protection -reset fopow 0
.protection -reset foparb 0
.protection -reset fopone 0
.protection -reset foptrans 0
.continue DFLT1
..
!TRANS2
.protection -reset fopstd 0
.protection -reset fopow 0
.protection -reset fopone 0
.protection foparb 0
.copy M|foparb = G|FALSE
.protection foptrans 0
.copy M|foptrans = G|FALSE
.continue DFLT1
..-----------------------------------------------------------------------------
..=============================================================================
..-----------------------------------------------------------------------------
!GERMAN: Installation is german only
.continue TOOLSON ? M|toolmode
.. Use normal options and deactivate tool options while adding or numbering
.assign U|xmark = "END"
.continue FOP ? _(M|doadd ; M|dotrans ; M|dotransfocmd)
.assign U|xmark = "ALWAYS3"
.continue OPT
..
!ALWAYS3
.protection foptrans 0
.copy M|foptrans = G|FALSE
.copy M|fopall = G|FALSE
..
.. Protect certain options for files while adding or numbering text
.. 3 cases differ: normally and infosystem as well as property files
.continue NORMAL   ? _(M|dicinfosys ; M|dicawa ; M|dictxt)
.continue TXTCMD   ? M|dictxt
.continue AWAADDS  ? M|dicawa & M|doadd
.continue AWATRANS ? M|dicawa & M|dotrans
..
.. Different options for adding and numbering infosystems
.. always the same
.protection foparb 0
.copy M|foparb = G|FALSE
.protection -reset fopow 0
.protection -reset fopone 0
.protection -reset fopstd 0
.continue DFLT1
..
!TXTCMD: Translate FO commands does only support one or working space
.continue NORMAL ? _M|dotransfocmd
.protection fopow 0
.copy M|fopow = G|FALSE
.protection fopstd 0
.copy M|fopstd = G|FALSE
.protection -reset fopone 0
.protection -reset foparb 0
.continue DFLT1
..
!AWAADDS: Adding from property files does not support single ones
.protection fopone 0
.copy M|fopone = G|FALSE
.protection -reset fopow 0
.protection -reset fopstd 0
.protection -reset foparb 0
.continue DFLT1
..
!AWATRANS: Translating property files does generally support standard and own files
.protection fopone 0
.copy M|fopone = G|FALSE
.protection fopow 0
.copy M|fopow = G|FALSE
.protection fopstd 0
.copy M|fopstd = G|FALSE
.protection foparb 0
.copy M|foparb = G|FALSE
.continue DFLT1
..
!NORMAL: Reset options for files
.protection -reset fopow 0
.protection -reset fopone 0
.protection -reset fopstd 0
.protection -reset foparb 0
.continue DFLT1
..-----------------------------------------------------------------------------
!TOOLSON: Use tool options and deactivate normal ones
.assign U|xmark = "END"
.continue FOP ? _(M|dogen ; M|doinsert ; M|dosubedit)
.assign U|xmark = "ALWAYS4"
.continue FOP
..
!ALWAYS4: Sometimes protected
.continue TGEN    ? M|dogen
.continue TINSERT ? M|doinsert
.assign U|xmark = "END"
.continue OPT
..
!TGEN: Protect options while generating
.protection optcomment 0
.copy M|optcomment = G|FALSE
.protection -reset alwaysen 0
.protection -reset optcomplete 0
.protection -reset optnottrans 0
.protection -reset opttrans 0
.protection -reset optcorrupt 0
.protection -reset optnumber 0
.protection -reset charsetutf16 0
.protection -reset csvformat 0
.continue DFLT2
..
!TINSERT: Protect options while inserting
.protection alwaysen 0
.copy M|alwaysen = G|FALSE
.protection optnumber 0
.copy M|optnumber = G|FALSE
.protection opttrans 0
.copy M|opttrans = G|FALSE
.protection optcorrupt 0
.copy M|optcorrupt = G|FALSE
.protection -reset optcomment 0
.protection -reset optcomplete 0
.protection -reset optnottrans 0
.protection -reset charsetutf16 0
.protection -reset csvformat 0
.continue DFLT2
..-----------------------------------------------------------------------------
..=============================================================================
..
!DFLT1: If neccessary this will set default for option file area
.copy M|hasfop = M|fopstd ; M|fopow ; M|foparb ; M|fopone ; M|foptrans
.continue END ? M|hasfop
.continue DOONE ? M|dotransfocmd
.continue DOONE ? M|doadd & (M|dicinfosys ; M|dictxt ; M|dicfop)
.continue DOOW  ? M|doadd & (M|dicawa ; M|dicmask ; M|dicascii)
.continue DOONE ? (M|dicinfosys ; M|dictxt)
.continue DOONE ? M|dotrans & (M|dicfop ; M|dicinfosys)
.copy M|fopall = G|TRUE
.assign M|lastfop = ""
.continue END
..
!DOONE: Default file option while adding from one file or infosystem
.copy M|fopone = G|TRUE
.assign M|lastfop = "fopone"
.continue END
..
!DOOW: Default file option while adding from own files or infosystems
.copy M|fopow = G|TRUE
.assign M|lastfop = "fopow"
.continue END
..
!DFLT2: If neccessary this will set default for option area of a dictionary
.copy M|hasopt = M|optcomplete ; M|optnottrans ; M|optnumber ; M|opttrans ; M|optcorrupt
.continue END ? M|hasopt
.copy M|optnottrans = G|TRUE
.assign M|lastopt = "optnottrans"
..****************************************************************************
!END
.continue
