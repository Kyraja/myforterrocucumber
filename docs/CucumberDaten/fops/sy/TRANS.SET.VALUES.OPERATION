..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.SET.VALUES.OPERATION
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Simuliert Radio button group fuer die Operationswahl.
.. Ablauf          : Unterprogramm sowie Feldaustritts-EFOP
..
.. Functionality   : Simulates a radio button group for the selection of a operation.
.. Program flow    : Subroutine and field exit efop
...Includes                    :
.. include sy/TRANS.PROTECT.DICTIONARY
.. include sy/TRANS.SET.PROTECT
..*****************************************************************************
.set trans -
..
.copy M|doadd        = G|evtvar = "doadd"
.copy M|dogen        = G|evtvar = "dogen"
.copy M|doedit       = G|evtvar = "doedit"
.copy M|dosubedit    = G|evtvar = "dosubedit"
.copy M|dotest       = G|evtvar = "dotest"
.copy M|doteststrict = G|evtvar = "doteststrict"
.copy M|doinsert     = G|evtvar = "doinsert"
.copy M|dotransfocmd = G|evtvar = "dotransfocmd"
.copy M|dotrans      = G|evtvar = "dotrans"
.copy M|dorepair     = G|evtvar = "dorepair"
.copy M|domsgdat     = G|evtvar = "domsgdat"
.copy M|domsgclean   = G|evtvar = "domsgclean"
..
.. Will set protections and reset values below if new operation is selected
.continue END ? _M|lastdo = "" & M|lastdo = G|evtvar
.formula M|lastdo = G|evtvar
.formula M|category = "LANG"
.input "sy/TRANS.SET.PROTECT"
..****************************************************************************
!END
.continue
