..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FOPTXTP.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Wertet eine Zeile der fop.txt aus. Kommentare werden
..                  gesammelt (max. 10) bis die n„chste Datenzeile ausgegben
..                  wird.
.. Functionality  : Evaluates one row of fop.txt. Comments are collected
..                  (max 10), until next data row is shown.
..*****************************************************************************
.set trans -
..
..<META M|='sy/FOPTXTP' > 
..
.. row
.type text  xtzeile  ? _F|defined(U|xtzeile)
.type text  xt1      ? _F|defined(U|xt1)
.type text  xt2      ? _F|defined(U|xt2)
.type text  xtfeld1  ? _F|defined(U|xtfeld1)
.type text  xtfeld2  ? _F|defined(U|xtfeld2)
.type text  xtfeld3  ? _F|defined(U|xtfeld3)
.type text  xtfeld4  ? _F|defined(U|xtfeld4)
.type text  xtfeld5  ? _F|defined(U|xtfeld5)
.type text  xtfeld6  ? _F|defined(U|xtfeld6)
.type text  xtfeld7  ? _F|defined(U|xtfeld7)
.type text  xtfeld8  ? _F|defined(U|xtfeld8)
.type text  xtfeld9  ? _F|defined(U|xtfeld9)
..
.type integer xikomzaehl  ? _F|defined(U|xikomzaehl)
.type text  xtkommentar   ? _F|defined(U|xtkommentar)
..
.. evaluate 1st letter of row
.formula U|xt1 = U|xtzeile<<1
.. mask number
.formula U|xt2 = U|xtzeile<<" "
..
.. collect #-comments
.. ignore empty row / rows starting with whitespace
.. show other rows
.continue COMMENT ?  U|xt1 = "#"
.continue END     ?  U|xt1 = " "
.continue END     ?  U|xt1 = ""
.continue SHOW    ? _F|empty(M|kmaske) & (M|kmaske=U|xt2 ; U|xt2="*")
.continue FILTER  ? _F|empty(M|kmaske)
.continue SHOW
..
!COMMENT: collext max last 10 comments
.continue END     ?  U|xikomzaehl > 10
.formula U|xtkommentar = U|xtkommentar + ";"         ? U|xikomzaehl > 0
.formula U|xtkommentar = U|xtkommentar + U|xtzeile
.formula U|xikomzaehl = U|xikomzaehl + 1
.continue END
..
!FILTER: wrong mask number -> clear comments
.formula U|xtkommentar = ""
.formula U|xikomzaehl  = 0
.continue END
..
!SHOW: create table row for row from fop.txt
.. split up space-separated row
.formula U|xtfeld1 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld2 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld3 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld4 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld5 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld6 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld7 = ""
.formula U|xtfeld7 = U|xtzeile << " "        ? U|xtzeile/"[*] *"
.formula U|xtzeile = U|xtzeile >> U|xtfeld7  ? U|xtzeile/"[*] *"
.formula U|xtzeile = 'U|xtzeile'
.formula U|xtfeld8 = U|xtzeile << " "
.formula U|xtzeile = U|xtzeile >> " "
.formula U|xtfeld9 = 'U|xtzeile'
..
.make screen line +O
.formula M|tmasknrtext = U|xtfeld1
.formula M|tmasknummer = -1          ? _(U|xtfeld1/"*(0-9)*")
.formula M|tmasknummer = U|xtfeld1   ?   U|xtfeld1/"*(0-9)*"
.formula M|tkommando   = U|xtfeld2
.formula M|tereignis   = U|xtfeld3
.formula M|ttaste      = U|xtfeld4
.formula M|tmaskfeld   = U|xtfeld5
.formula M|tkopftab    = U|xtfeld6
.formula M|tsteuerzeichen = U|xtfeld7
.formula M|tfopname    = U|xtfeld8
.formula M|tfopparam   = U|xtfeld9
.formula M|tzeilnummer = M|aktzeile
.formula M|tkommentar  = U|xtkommentar
.copy M|tbdoppel    = G|false
..
.. reset comment row count
.formula U|xtkommentar = ""
.formula U|xikomzaehl  = 0
..*****************************************************************************
!END
.continue
