..!interpreter english translate noabbrev
..*****************************************************************************
.. Name              : EXPLORER.TEST
.. Author            : tiwe
.. Verantwortlich    : tiwe
.. Kontrolleur       : cl
.. Functionality	   :  Testet die Vorbelegungen 
..                      Pfade:
..                      1. Wenn Pfad leer ist, darf es kein KÅrzel geben   
..                      2. Wenn Pfad gefÅllt ist, darf das KÅrzel nicht leer sein
..                      3. Ein ausgefÅllter Pfad muss mit / enden
..                      4. Ein ls -l auf den Pfad muss ein Ergebnis liefern (G|mehr) 
..                     Dateiendung: 
..                      1. Wenn der Typ gefÅllt ist, muss entweder Datei enthÑlt oder Dateiendung ausgefÅllt sein
..                      2. Wenn der Typ leer ist, darf nichts in Datei enthÑlt oder der Dateiendung stehen
..                      3. Dateiendungen mÅssen mit einem . beginnnen
..                     Sicherungen: 
..                      1. PrÅfen ob es den Sicherungsordner gibt
..
..
..*****************************************************************************
.. Variablen
..*****************************************************************************
.set trans -
.type text xtcmdtestpath     ? _F|defined(U|xtcmdtestpath)
.type text xtzaehlerdat      ? _F|defined(U|xtzaehlerdat)
.type text xtzaehlerpfad     ? _F|defined(U|xtzaehlerpfad)
..*****************************************************************************
.. Verteilen der Variablen
..*****************************************************************************
.continue PFAD  ? _F|empty(U|xtzaehlerpfad)
.continue DATEI ? _F|empty(U|xtzaehlerdat)
.continue SICH  ? U|xtvariable = ""
.continue ENDE
..******************************************************************************
.. PrÅfen der Pfade
..******************************************************************************
!PFAD
.. Pfad und KÅrzel auf leer prÅfen
.set trans +
.continue PFERR01 ? F|empty(M|pfadvor.xtzaehlerpfad)   & _F|empty(M|kuerzelvor.xtzaehlerpfad)
.continue PFERR02 ? _F|empty(M|pfadvor.xtzaehlerpfad)  & F|empty(M|kuerzelvor.xtzaehlerpfad)
.continue PFERR03 ? _F|regmatch(M|pfadvor.xtzaehlerpfad,".*\/")
.set trans -
.formula U|xtcmdtestpath = "ls -l " + 'M|pfadvor.xtzaehlerpfad' + "*"
.system 'U|xtcmdtestpath' background
.continue PFERR04 ? _G|mehr
.formula M|statuspfad.xtzaehlerpfad = M|icongruen
.continue ENDE
..******************************************************************************
.. PrÅfen der Dateien
..******************************************************************************
!DATEI
.set trans +
.continue DTERR01 ? _F|empty(M|dattyp.xtzaehlerdat) & F|empty(M|datenthaelt.xtzaehlerdat) & F|empty(M|datendung.xtzaehlerdat)
.continue DTERR02 ? F|empty(M|dattyp.xtzaehlerdat) & _F|empty(M|datenthaelt.xtzaehlerdat)
.continue DTERR02 ? F|empty(M|dattyp.xtzaehlerdat) & _F|empty(M|datendung.xtzaehlerdat)
.continue DTERR03 ? _F|strindex(M|datendung.xtzaehlerdat, ".") = 1 & _F|empty(M|datendung.xtzaehlerdat)
.formula M|statusdattyp.xtzaehlerdat = M|icongruen
.set trans -
.continue ENDE
..******************************************************************************
.. PrÅfen der Sicherung
..******************************************************************************
!SICH
.continue ENDE
..*****************************************************************************
.. Programmende
..*****************************************************************************
!ENDE
.continue
..*****************************************************************************
.. Fehlerhandling
..*****************************************************************************
!PFERR01:
.formula M|fehlerpfad.xtzaehlerpfad = "Pfad leer, KÅrzel eingegeben."
.continue ENDE
!PFERR02:
.formula M|fehlerpfad.xtzaehlerpfad = "KÅrzel leer, Pfad eingegeben."
.continue ENDE
!PFERR03:
.formula M|fehlerpfad.xtzaehlerpfad = "Pfad endet nicht mit einem Slash (/)."
.continue ENDE
!PFERR04
.formula M|fehlerpfad.xtzaehlerpfad = "Pfad existiert nicht."
.continue ENDE
!DTERR01
.formula M|fehlerdattyp.xtzaehlerdat = "Feld Datei enthÑlt oder Feld Dateiendung definieren."
.continue ENDE
!DTERR02
.formula M|fehlerdattyp.xtzaehlerdat = "Dateityp nicht gefÅllt."
.continue ENDE
!DTERR03
.formula M|fehlerdattyp.xtzaehlerdat = "Dateiendung muss mit einem Punkt (.) anfangen."
.continue ENDE
