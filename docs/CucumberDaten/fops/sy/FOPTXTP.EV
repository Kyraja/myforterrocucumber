..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FOPTXTP.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Einfache Events fÅr Infosystem FOPTXTP
.. Functionality  : Simple events for infosystem FOPTXTP
..*****************************************************************************
.set trans -
..
..<META M|='sy/FOPTXTP' > 
..
.type text   xtfoppath
.type text   xtfehler
..
..  event evaluation
.. ----------- ----- Kopfteil --------------------------------------------------
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kmaske"
.. ----------- ----- Tabellenteil ----------------------------------------------
.continue EDIT    ? G|evtartengl = "BUTTON_AFTER"    &  G|evtvar = "tbufopedit"
.continue FORBID  ? G|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!EDIT
.continue END     ?  F|empty(M|tfopname)
.continue END     ? _F|isfopname(M|tfopname)
.formula U|xtfoppath = F|foppath(M|tfopname)
.continue NOEXIST ? _F|fileexists(U|xtfoppath)
.continue ISDIR   ?  F|isdir(U|xtfoppath)
.continue NOREAD  ? _F|filereadable(U|xtfoppath)
.editing -readonly 'U|xtfoppath'
.continue END
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue
..
..
!NOEXIST
.set trans +
.formula U|xtfehler = F|formatstr("Das FOP {1} ist nicht vorhanden.", M|tfopname)
.set trans -
.error 'U|xtfehler'
.end 1
..
!ISDIR
.set trans +
.formula U|xtfehler = F|formatstr("Das FOP {1} ist keine Datei.", M|tfopname)
.set trans -
.error 'U|xtfehler'
.end 1
..
!NOREAD
.set trans +
.formula U|xtfehler = F|formatstr("Das FOP {1} kann nicht gelesen werden.", U|xtfoppath)
.set trans -
.error 'U|xtfehler'
.end 1
