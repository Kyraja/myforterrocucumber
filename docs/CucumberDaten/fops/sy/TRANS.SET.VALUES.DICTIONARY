..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.SET.VALUES.DICTIONARY
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Simuliert Radio button group fuer die Woerterbuchwahl.
.. Ablauf          : Unterprogramm sowie Feldaustritts-EFOP
..
.. Functionality   : Simulates a radio button group for the selection of a dictionary.
.. Program flow    : Subroutine andField exit efop
...Includes        :
.. include sy/TRANS.SET.PROTECT
..*****************************************************************************
.set trans -
..
.copy M|dicown     = G|evtvar = "dicown"
.copy M|dicprogram = G|evtvar = "dicprogram"
.copy M|dicfop     = G|evtvar = "dicfop"
.copy M|dictxt     = G|evtvar = "dictxt"
.copy M|dicmask    = G|evtvar = "dicmask"
.copy M|dicascii   = G|evtvar = "dicascii"
.copy M|dichelp    = G|evtvar = "dichelp"
.copy M|dicvartab  = G|evtvar = "dicvartab"
.copy M|dicawa     = G|evtvar = "dicawa"
.copy M|dicall     = G|evtvar = "dicall"
.copy M|dicinfosys = G|evtvar = "dicinfosys"
.copy M|dicgui     = G|evtvar = "dicgui"
..
.. Will set protections and reset values below if new dictionary is selected
.continue END ? _F|empty(M|lastdic) & M|lastdic = G|evtvar
.protection -reset toolmode 0
..
!LASTDIC
.assign M|lastdic = G|evtvar
.assign M|category = "OPERAT"
.input "sy/TRANS.SET.PROTECT"
.continue END
..****************************************************************************
!END
.continue
