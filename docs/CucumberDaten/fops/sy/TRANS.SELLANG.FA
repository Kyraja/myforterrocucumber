..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.SELLANG.FA
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Behandelt den Feldaustritt von "M|sellang", indem ja nach
.. Modus die Sprachschalter aktiviert bzw. deaktiviert werden.
.. Ablauf          : Feldaustritts-EFOP
..
.. Functionality   : Depending on the mode of the field "M|sellang" this program
.. will activate or deactivate the switches for the each language.
.. Program flow    : Exit field efop
..*****************************************************************************
.set trans -
..
.continue END ? M|sellang = M|somelang
.continue L1  ? M|sellang = M|alllang
.continue L2  ? M|sellang = M|onelang
..
..Installed languages
.type text xinstlang
.formula U|xinstlang = M|instlang
.formula U|xinstlang = M|outlang ? M|dicall ; M|dicfop ; M|dictxt ; M|dicawa
.formula U|xinstlang = M|outlang ? _M|polyglot & M|dicmask
..weiter L2 ? _M|polyglot
.copy M|langde = (" " + U|xinstlang + " ") / "*D*"
.copy M|langen = (" " + U|xinstlang + " ") / "*E*"
.copy M|langfr = (" " + U|xinstlang + " ") / "*F*"
.copy M|langes = (" " + U|xinstlang + " ") / "*S*"
.copy M|langit = (" " + U|xinstlang + " ") / "*I*"
.copy M|langpl = (" " + U|xinstlang + " ") / "*P*"
.copy M|langru = (" " + U|xinstlang + " ") / "*R*"
.copy M|langhu = (" " + U|xinstlang + " ") / "*U*"
.copy M|langcs = (" " + U|xinstlang + " ") / "*C*"
.copy M|langtr = (" " + U|xinstlang + " ") / "*T*"
.copy M|langfirst = (" " + U|xinstlang + " ") / "*1*"
.copy M|langsecond = (" " + U|xinstlang + " ") / "*2*"
.copy M|langthird = (" " + U|xinstlang + " ") / "*3*"
.copy M|langenus = (" " + U|xinstlang + " ") / "*A*"
.copy M|langro = (" " + U|xinstlang + " ") / "*O*"
.copy M|langid = (" " + U|xinstlang + " ") / "*B*"
.copy M|langnl = (" " + U|xinstlang + " ") / "*N*"
.copy M|langmk = (" " + U|xinstlang + " ") / "*M*"
.copy M|langbg = (" " + U|xinstlang + " ") / "*X*"
.copy M|langsr = (" " + U|xinstlang + " ") / "*Y*"
.copy M|langsl = (" " + U|xinstlang + " ") / "*L*"
.copy M|langsk = (" " + U|xinstlang + " ") / "*W*"
.copy M|langpt = (" " + U|xinstlang + " ") / "*G*"
.copy M|langzhs = (" " + U|xinstlang + " ") / "*Q*"
.copy M|langzh = (" " + U|xinstlang + " ") / "*H*"
.copy M|langel = (" " + U|xinstlang + " ") / "*Z*"
.copy M|langar = (" " + U|xinstlang + " ") / "*V*"
.copy M|langth = (" " + U|xinstlang + " ") / "*K*"
.copy M|langfa = (" " + U|xinstlang + " ") / "*J*"
.copy M|langvi = (" " + U|xinstlang + " ") / "*9*"
.copy M|langur = (" " + U|xinstlang + " ") / "*8*"
.copy M|langja = (" " + U|xinstlang + " ") / "*7*"
.continue END
..
!L1: All languages was pushed
.copy M|langde = G|TRUE
.copy M|langen = G|TRUE
.copy M|langfr = G|TRUE
.copy M|langes = G|TRUE
.copy M|langit = G|TRUE
.copy M|langpl = G|TRUE
.copy M|langru = G|TRUE
.copy M|langhu = G|TRUE
.copy M|langcs = G|TRUE
.copy M|langtr = G|TRUE
.copy M|langfirst = G|TRUE
.copy M|langsecond = G|TRUE
.copy M|langthird = G|TRUE
.copy M|langenus = G|TRUE
.copy M|langro = G|TRUE
.copy M|langid = G|TRUE
.copy M|langnl = G|TRUE
.copy M|langmk = G|TRUE
.copy M|langbg = G|TRUE
.copy M|langsr = G|TRUE
.copy M|langsl = G|TRUE
.copy M|langsk = G|TRUE
.copy M|langpt = G|TRUE
.copy M|langzhs = G|TRUE
.copy M|langzh = G|TRUE
.copy M|langel = G|TRUE
.copy M|langar = G|TRUE
.copy M|langth = G|TRUE
.copy M|langfa = G|TRUE
.copy M|langvi = G|TRUE
.copy M|langur = G|TRUE
.copy M|langja = G|TRUE
.continue END
..
!L2: One language was pushed
.copy M|langde = G|FALSE
.copy M|langen = G|FALSE
.copy M|langfr = G|FALSE
.copy M|langes = G|FALSE
.copy M|langit = G|FALSE
.copy M|langpl = G|FALSE
.copy M|langru = G|FALSE
.copy M|langhu = G|FALSE
.copy M|langcs = G|FALSE
.copy M|langtr = G|FALSE
.copy M|langfirst = G|FALSE
.copy M|langsecond = G|FALSE
.copy M|langthird = G|FALSE
.copy M|langenus = G|FALSE
.copy M|langro = G|FALSE
.copy M|langid = G|FALSE
.copy M|langnl = G|FALSE
.copy M|langmk = G|FALSE
.copy M|langbg = G|FALSE
.copy M|langsr = G|FALSE
.copy M|langsl = G|FALSE
.copy M|langsk = G|FALSE
.copy M|langpt = G|FALSE
.copy M|langzhs = G|FALSE
.copy M|langzh = G|FALSE
.copy M|langel = G|FALSE
.copy M|langar = G|FALSE
.copy M|langth = G|FALSE
.copy M|langfa = G|FALSE
.copy M|langvi = G|FALSE
.copy M|langur = G|FALSE
.copy M|langja = G|FALSE
..****************************************************************************
!END
.continue
