..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FOPTXTP.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Einlesen von fop.txt, Anzeige in Tabelle
.. Functionality  : Reads fop.txt, shows in table
..*****************************************************************************
.set trans -
..
..<META M|='sy/FOPTXTP' > 
..
.. system / files names
.type text xtdateiname
.type text xtsystem
.type text xtzeile
.type text xtfehler
..
.. comment might be several rows before the actual fop.txt entry
.type integer xikomzaehl  ? _F|defined(U|xikomzaehl)
.type text  xtkommentar   ? _F|defined(U|xtkommentar)
..
.. initialize comment fields
.formula U|xtkommentar = ""
.formula U|xikomzaehl = 0
..
.. verify if fop.txt exists
.formula U|xtdateiname = "fop.txt"
.continue ERRFILE  ? _F|fileexists(U|xtdateiname)
..
.file -tempname U|xtdateiname
.formula U|xtsystem = "cp fop.txt " + 'U|xtdateiname'
.system 'U|xtsystem' background
.continue ERRCOPY  ?  _G|mehr
..
.make screen line --
.formula M|kdoppel = 0
!READ
.select from 'U|xtdateiname' U|xtzeile^
.continue EREAD  ? _G|mehr
.input 'M|tab'
.continue READ
!EREAD
..*****************************************************************************
!END
.continue 
..
..
!ERRFILE
.formula U|xtfehler = F|formatstr("Die Datei {1} ist nicht vorhanden!", U|xtdateiname)
.error 'U|xtfehler'
.end 1
..
!ERRCOPY
.error Fehler beim Kopieren der Datei fop.txt.
.end 1
