..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KILL.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Killt Prozess(e).
.. Functionality  : Kills process(es).
..*****************************************************************************
.set trans -
..
.continue END ? _M|confirmed
..
.. Declarations
.type text xhost xscreen xpid
.type DVM2 xproclist xttylist
..
.. Initializations
.copy U|xproclist = M|tableofkills
.make screen line --
..
!NEXT
.select from 'U|xproclist' U|xpid U|xhost^
.continue KILL ? _G|mehr
.input 'M|tab' ? _F|empty(M|tab)
.continue NEXT
..
!KILL: Start terminating
.copy U|xhost = M|host
.copy U|xscreen = M|displaycode
.continue DISPLAY ? F|empty(M|processid)
..
.. Kill one process
.input "is/KILL.PIDLIST"
.continue END
..
!DISPLAY: Kill display
.copy U|xttylist = M|tableofttys
.input "is/KILL.SCREEN"
..*****************************************************************************
!END
.continue
