..!interpreter english translate
.. 7.1 vom 06.11.96
..
..  Verantwortlich : cl
..  Kontrolle      : amk
..
.end .  ?  txname / "*NODRUCK.EZL"
.set trans +
.type text xtyes xtquest
.formula xtyes   = "ja"
.formula xtquest = "Druck l”schen? (" + xtyes + "/ ) "
.up
 'xobj          '

  Nummer       Datum  Suchwort Kunde/Lieferant
------------------------------------------------------------------------
.page
.continue AN ? xw="A" ; xw="I"
.continue AU ? xw="B" ; xw="F"
.continue LS ? xw="C" ; xw="G"
.continue RE ? xw="D" ; xw="H"
.continue ZA ? xw="E"

!AN
.select sales printable quotations  ?  xw = "A"
.select purchasing printable quotations  ?  xw = "I"
.continue ? _mehr
.formula xnum=num
.formula xsuch=such
.add kunde  ?  xw = "A"
.add lief   ?  xw = "I"
'xnum      ' '   vom' 'xsuch ' 'name                                     '

.read 'xtquest' XL
.reserve ? xl<>-xtyes
.continue AN ? xl<>-xtyes
.output new "WERF.WEG"
.printed
.output terminal
.select
.continue AN

!AU
.select sales printable sorders ? xw="B"
.select purchasing printable porders ? xw="F"
.continue ? _mehr
.formula xnum=num
.formula xsuch=such
.add kunde ? xw="B"
.add lief ? xw="F"
'xnum      ' '   vom' 'xsuch ' 'name                                     '

.read 'xtquest' XL
.reserve ? XL<>-xtyes
.continue AU ? XL<>-xtyes
.output new "WERF.WEG"
.printed
.output terminal
.select
.continue AU


!LS
.select sales printable delnotes ? xw="C"
.select purchasing printable delnotes ? xw="G"
.continue ? _mehr
.formula xnum=num
.formula xsuch=such
.add kunde ? xw="C"
.add lief ? xw="G"
'xnum      ' '   vom' 'xsuch ' 'name                                     '

.read 'xtquest' XL
.reserve ? xl<>-xtyes
.continue LS ? xl<>-xtyes
.output new "WERF.WEG"
.printed
.output terminal
.select
.continue LS


!RE
.select sales printable invoices ? xw="D"
.select purchasing printable invoices ? xw="H"
.continue ? _mehr
.formula xnum=num
.formula xsuch=such
.add kunde ? xw="D"
.add lief ? xw="H"
'xnum      ' '   vom' 'xsuch ' 'name                                     '

.read 'xtquest' XL
.reserve ? xl<>-xtyes
.continue RE ? xl<>-xtyes
.output new "WERF.WEG"
.printed
.output terminal
.select
.continue RE

!ZA
.select sales printable payments
.continue ? _mehr
.continue ZA ? bs="G" ; bs="B"
.formula xnum=num
.add konto
.formula xsuch=such
'xnum      ' '   vom' 'xsuch ' 'name                                     '
Rechnungsbetrag:'  urbetr'      offener Betrag:'  rebetr'
.read 'xtquest' XL
.reserve ? xl<>-xtyes
.continue ZA ? xl<>-xtyes
.output new "WERF.WEG"
.printed
.output terminal
.select
.continue ZA
