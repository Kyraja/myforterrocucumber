..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : DISPLAYS.REPOS.TABLE
.. Autor         : fwester
.. Verantwortlich: fwester
.. Kontrolle     : xg
.. Funktion      : Neuberechung der Beziehungen unterhalb des aktuellen Elementes,
.. indem der Wert des Parameters xrowdiff addiert wird.
.. Ablauf        : Unterprogramm
..
.. Functionality : Calculates relations of the current element by adding the
.. parameter xrowdiff.
.. Program flow  : Subroutine
..*****************************************************************************
.set trans -
.continue END ? _F|defined(U|xrowsbefore)
..
.. Declarations
.type integer xrowdiff  ? _F|defined(U|xrowdiff)
.type integer xlastroot ? _F|defined(U|xlastroot)
.type integer xlastmom  ? _F|defined(U|xlastmom)
.type integer xlastrow  ? _F|defined(U|xlastrow)
.formula U|xlastrow  = M|aktzeile
.formula U|xrowdiff  = M|tzeilen - U|xrowsbefore
.formula U|xlastroot = M|trootofelem
.formula U|xlastmom  = M|tmomofelem
..
!UPDATE: Updates root element while knot has changed
.select screen line 'U|xlastroot'
.continue FATAL ? _G|mehr
.formula M|stufe = M|tbaumstufe
.continue USER ? M|typeofelem = M|usernode
.input 'M|sumchilds' ? _F|empty(M|sumchilds)
.formula M|usersofscr = U|xsum2
.formula M|usersofscr = 1 ? M|userview
.formula M|pidsofscr = U|xsum3
.continue LASTROW
..
!USER
.input 'M|sumchilds' ? _F|empty(M|sumchilds)
.formula M|scrofuser = U|xsum2
.formula M|scrofuser = 1 ? _M|userview
.formula M|pidsofuser = U|xsum3
..
!LASTROW: Load last row of changed knot
.select screen line 'U|xlastrow'
.continue FATAL ? _G|mehr
..
!GETROW
.select screen line
.continue END ? _G|mehr
.continue NEWROOT ? U|xlastroot < M|trootofelem
.continue NEWMOM  ? U|xlastmom  < M|tmomofelem
.continue GETROW
..
!NEWROOT
.formula M|trootofelem = M|trootofelem + U|xrowdiff
.continue FATAL ? M|trootofelem < 1 & M|trootofelem > M|tzeilen
!NEWMOM
.formula M|tmomofelem = M|tmomofelem + U|xrowdiff
.continue FATAL ? M|tmomofelem < 1 & M|tmomofelem > M|tzeilen
.continue GETROW
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
