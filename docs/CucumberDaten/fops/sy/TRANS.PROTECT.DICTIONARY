..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.PROTECT.DICTIONARY
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Schuetzt die Rubrik "Woerterbuch".
.. Ablauf          : Unterprogramm
..
.. Functionality   : Protects the category "Dictionary".
.. Program flow    : Subroutine
..*****************************************************************************
.set trans -
..
.continue GERMAN ? _M|polyglot
.. Multilingual
.protection -reset dicown 0
.protection -reset dicprogram 0
.protection -reset dicfop 0
.protection -reset dictxt 0
.protection -reset dicmask 0
.protection -reset dicascii 0
.protection -reset dichelp 0
.protection -reset dicvartab 0
.protection -reset dicawa 0
.protection -reset dicall 0
.protection -reset dicinfosys 0
.protection -reset dicgui 0
.continue DEFAULT
..
!GERMAN: Not multilingual
.protection dicown 0
.protection dicprogram 0
.protection dicfop 0
.protection -reset dictxt
.protection -reset dicmask 0
.protection dicascii 0
.protection dichelp 0
.protection dicvartab 0
.protection -reset dicawa 0
.protection dicall 0
.protection -reset dicinfosys 0
.protection dicgui 0
.copy M|dicown = G|FALSE
.copy M|dicprogram = G|FALSE
.copy M|dicfop = G|FALSE
.copy M|dicmask = G|FALSE
.copy M|dicascii = G|FALSE
.copy M|dichelp = G|FALSE
.copy M|dicvartab = G|FALSE
.copy M|dicawa = G|FALSE
.copy M|dicgui = G|FALSE
.copy M|dicall = G|FALSE
..
!DEFAULT: If neccessary this will set default for dictionary
.copy M|hasdic = M|dicown ; M|dicprogram ; M|dicfop ; M|dictxt ; M|dicmask ; M|dicascii ; M|dichelp ; M|dicvartab ; M|dicawa ; M|dicall ; M|dicinfosys ; M|dicgui
.continue END ? M|hasdic
.copy M|dictxt = G|TRUE
.assign M|lastdic = "dictxt"
..****************************************************************************
!END
.continue
