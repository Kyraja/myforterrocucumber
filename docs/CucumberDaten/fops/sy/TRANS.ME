..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.ME
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Initialisiert das Infosystem TRANS.
.. Ablauf          : Maskeneintritts-EFOP
..
.. Functionality   : Initializes the infosystem TRANS.
.. Program flow    : Mask entry efop
...Includes        :
.. include sy/TRANS.SET.POLYGLOT
.. include sy/TRANS.SET.PROTECT
.. include sy/TRANS.SET.OUTPUTLANG
..*****************************************************************************
.. Dialog
.assign M|boxtext1 = "Das vorhandene Teilwîrterbuch ist jÅnger als sein Original!"
.assign M|boxtext2 = "Dieses Teilwîrterbuch verwerfen und ein neues erzeugen?"
.set trans -
..
.. Read client directory from environment and abort if it won't be found
.assign M|clientdir = E|MANDANTDIR
.input "is/GET.ABSPATH.CLIENTDIR"
.continue ERROR1 ? F|empty(M|clientdir)
.assign M|homedir = E|HOMEDIR
..
.. Letters for dictionarys
.assign M|letter4ku = "u"
.assign M|letter4cc = "c"
.assign M|letter4lg = "l"
.assign M|letter4tx = "t"
.assign M|letter4ma = "m"
.assign M|letter4me = "e"
.assign M|letter4sh = "s"
.assign M|letter4vt = "v"
.assign M|letter4pr = "p"
.assign M|letter4is = "i"
.assign M|letter4ng = "n"
.assign M|letter4all = "ucltmesvpn"
..
.. Names of dictionarys
.assign M|msgkudic = "msg.ku.dic"
.assign M|msgccdic = "msg.cc.dic"
.assign M|msglgdic = "msg.lg.dic"
.assign M|msgtxdic = "msg.tx.dic"
.assign M|msgmadic = "msg.ma.dic"
.assign M|msgmedic = "msg.me.dic"
.assign M|msgshdic = "msg.sh.dic"
.assign M|msgvtdic = "msg.vt.dic"
.assign M|msgprdic = "msg.pr.dic"
.assign M|msgngdic = "msg.ng.dic"
..
.. Names of subdictionarys
.assign M|msgku = "msg.ku"
.assign M|msgcc = "msg.cc"
.assign M|msglg = "msg.lg"
.assign M|msgtx = "msg.tx"
.assign M|msgma = "msg.ma"
.assign M|msgme = "msg.me"
.assign M|msgsh = "msg.sh"
.assign M|msgvt = "msg.vt"
.assign M|msgpr = "msg.pr"
.assign M|msgng = "msg.ng"
..
.. List of all common subdictionarys
.formula M|allcommonsub = M|msgcc + " " + M|msgtx + " " + M|msglg + " " + M|msgma + " " + M|msgme + " " + M|msgsh + " " + " " + M|msgvt + " " + M|msgpr + " " + M|msgng
..
.. Const.
.assign M|maxtext = 3000
.file -screen -tempname M|tmpfile ? _M|quiet
.copy M|langsrc = G|TRUE
..
.assign M|langtxt1 = F|sysinfo(18)^spr1
.assign M|langtxt2 = F|sysinfo(18)^spr2
.assign M|langtxt3 = F|sysinfo(18)^spr3
..
.assign M|onelang = "(ALanguage)"
.assign M|somelang = "(SeveralLanguages)"
.assign M|cfglang = "(InstalledLanguages)"
.assign M|alllang = "(AllLanguages)"
..
.assign M|lgspren = "(English)"
.assign M|lgsprde = "(German)"
..
.. Get installed languages and set multilingual switch
.input "sy/TRANS.SET.POLYGLOT"
..
.. Get fo language
.assign M|lgspr = F|sysinfo(18)^lgspra
..
.. Get installed output language
.input "sy/TRANS.SET.OUTPUTLANG"
..
.assign M|category = "CLIENT"
.input "sy/TRANS.SET.PROTECT"
.cursor doedit 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -message Die Umgebungsvariable MANDANTDIR ist leer!
.end 1
