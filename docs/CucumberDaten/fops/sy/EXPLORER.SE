..!interpreter english translate noabbrev
..*****************************************************************************
.. Name              : EXPLORER.SE
.. Author            : tiwe
.. Verantwortlich    : tiwe
.. Kontrolleur       : cl
.. Functionality	   : Maskeneintritt / Screen enter
..                        Icons vorbelegen
..                        Vorbelegungen Åber Input-Datei sy/EXPLORER.INPUT
..
.. include sy/EXPLORER.INPUT
.. include sy/EXPLORER.TEST
..*****************************************************************************
.set trans -
..Variablen
.type text xtcmd          ? _F|defined(U|xtcmd)
.type text xtcmdtest      ? _F|defined(U|xtcmdtest)
.type text xtline         ? _F|defined(U|xtline)
.type text xtslash        ? _F|defined(U|xtslash)
.type text xtkennzeichen   ? _F|defined(U|xtkennzeichen)
.type text xtkuerzel      ? _F|defined(U|xtkuerzel)
.type text xtinhalt1      ? _F|defined(U|xtinhalt1)
.type text xtinhalt2      ? _F|defined(U|xtinhalt2)
.type bool xbinput        ? _F|defined(U|xbinput)
.type text xtzaehlerdat   ? _F|defined(U|xtzaehlerdat)
.type text xtzaehlerpfad  ? _F|defined(U|xtzaehlerpfad)
..
.. xbinput steht auf ja, wenn man die Input-Datei geîffnet hat
.. nun werden die Vorbelegungen aktualisiert
.continue NEUINP ? U|xbinput
..Icons vorbelegen
.formula M|icondatei        = "icon:text_edit"
.formula M|icondateigesperrt = "icon:text_edit_disabled"
.formula M|iconverzzu        = "icon:folder_closed"
.formula M|iconzurueck       = "icon:arrow_blue_up"
.formula M|icontreffer       = "icon:ok"
.formula M|icondiff          = "icon:console"
.formula M|iconcopy          = "icon:replace"
.formula M|iconvorbelegung   = "icon:text"
.formula M|iconnovorbelegung = "icon:text_empty_disabled"
.formula M|icongruen         = "icon:ball_green"
.formula M|iconrot          = "icon:ball_red"
.formula M|einszurueck       = M|iconzurueck
.. Mandantenverzeichnis ermitteln
.formula U|xtcmd = "pwd > rmtmp/EXPLORER.PWD"
.system 'U|xtcmd' background
.continue ERROR1 ? _G|mehr
.select from "rmtmp/EXPLORER.PWD" U|xtline ^
.formula U|xtslash = "/"
.formula M|pfad1 = U|xtline + 'U|xtslash'
.formula M|mandantverz = M|pfad1
.continue ERROR1 ? F|empty(M|pfad1) 
.. Pfade und KÅrzel vorbelegen aus Input-Datei vorbelegen
!NEUINP
.. Alle Vorbelegungen erstmal leeren und neu einlesen
.formula M|pfadvor1 = ""
.formula M|pfadvor2 = ""
.formula M|pfadvor3 = ""
.formula M|pfadvor4 = ""
.formula M|pfadvor5 = ""
.formula M|pfadvor6 = ""
.formula M|pfadvor7 = ""
.formula M|kuerzelvor1 = ""
.formula M|kuerzelvor2 = ""
.formula M|kuerzelvor3 = ""
.formula M|kuerzelvor4 = ""
.formula M|kuerzelvor5 = ""
.formula M|kuerzelvor6 = ""
.formula M|kuerzelvor7 = ""
.formula M|statuspfad1 = ""
.formula M|statuspfad2 = ""
.formula M|statuspfad3 = ""
.formula M|statuspfad4 = ""
.formula M|statuspfad5 = ""
.formula M|statuspfad6 = ""
.formula M|statuspfad7 = ""
.formula M|textedittool = ""
.copy M|texteditverw = G|false
.formula M|difftool = ""
.copy M|diffverw = G|false
.formula M|dattyp1 = ""
.formula M|dattyp2 = ""
.formula M|dattyp3 = ""
.formula M|dattyp4 = ""
.formula M|dattyp5 = ""
.formula M|datenthaelt1 = ""
.formula M|datenthaelt2 = ""
.formula M|datenthaelt3 = ""
.formula M|datenthaelt4 = ""
.formula M|datenthaelt5 = ""
.formula M|datendung1 = ""
.formula M|datendung2 = ""
.formula M|datendung3 = ""
.formula M|datendung4 = ""
.formula M|datendung5 = ""
.formula M|statusdattyp1 = ""
.formula M|statusdattyp2 = ""
.formula M|statusdattyp3 = ""
.formula M|statusdattyp4 = ""
.formula M|statusdattyp5 = ""
.formula M|sichverz = ""
.formula M|sichverw = ""
.formula M|statussich = ""
.select from "sy/EXPLORER.INPUT" U|xtline ^
.continue ERROR2 ? _G|mehr
.formula M|inputdatanz = M|iconvorbelegung
!LOOPINP
.formula U|xtkennzeichen    = U|xtline << "#"
.formula U|xtline           = U|xtline >> "#"
.formula U|xtkuerzel        = U|xtline << "#"
.formula U|xtline           = U|xtline >> "#"
.formula U|xtinhalt1        = U|xtline << "#"
.formula U|xtline           = U|xtline >> "#"
.formula U|xtinhalt2        = U|xtline << "#"
.continue PATH1     ? U|xtkennzeichen = "PATH1" 
.continue PATH2     ? U|xtkennzeichen = "PATH2"
.continue PATH3     ? U|xtkennzeichen = "PATH3"
.continue PATH4     ? U|xtkennzeichen = "PATH4"
.continue PATH5     ? U|xtkennzeichen = "PATH5"
.continue COMPARE   ? U|xtkennzeichen = "COMPARE"
.continue COPY      ? U|xtkennzeichen = "COPY"
.continue TEDIT     ? U|xtkennzeichen = "TEDIT"
.continue DIFF      ? U|xtkennzeichen = "DIFF" 
.continue FILE1     ? U|xtkennzeichen = "FILE1"
.continue FILE2     ? U|xtkennzeichen = "FILE2"
.continue FILE3     ? U|xtkennzeichen = "FILE3"
.continue FILE4     ? U|xtkennzeichen = "FILE4"
.continue FILE5     ? U|xtkennzeichen = "FILE5"
.continue BACKUP    ? U|xtkennzeichen = "BACKUP"
.continue NEXT
!PATH1: Pfad 1
.formula M|pfadvor1    = 'U|xtinhalt1'
.formula M|kuerzelvor1 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "1"
.formula M|fehlerpfad1 = ""
.formula M|statuspfad1 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT 
!PATH2: Pfad 2
.formula M|pfadvor2    = 'U|xtinhalt1'
.formula M|kuerzelvor2 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "2"
.formula M|fehlerpfad2 = ""
.formula M|statuspfad2 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT 
!PATH3: Pfad 3
.formula M|pfadvor3    = 'U|xtinhalt1'
.formula M|kuerzelvor3 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "3"
.formula M|fehlerpfad3 = ""
.formula M|statuspfad3 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT 
!PATH4: Pfad 4
.formula M|pfadvor4    = 'U|xtinhalt1'
.formula M|kuerzelvor4 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "4"
.formula M|fehlerpfad4 = ""
.formula M|statuspfad4 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT 
!PATH5: Pfad 5
.formula M|pfadvor5    = 'U|xtinhalt1'
.formula M|kuerzelvor5 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "5"
.formula M|fehlerpfad5 = ""
.formula M|statuspfad5 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT 
!COMPARE: Vergleichspfad
.formula M|pfadvor6 = 'U|xtinhalt1'
.formula M|kuerzelvor6 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "6"
.formula M|fehlerpfad6 = ""
.formula M|statuspfad6 = M|iconrot
.input "sy/EXPLORER.TEST"
.protection M|vergleichen        ? F|empty(M|pfadvor6)
.protection -reset M|vergleichen ? _F|empty(M|pfadvor6)
.continue NEXT
!COPY: Pfad fÅr zusÑtzliche Kopie
.formula M|pfadvor7   = 'U|xtinhalt1'
.formula M|kuerzelvor7 = 'U|xtkuerzel'
.formula U|xtzaehlerpfad = "7"
.formula M|fehlerpfad7 = ""
.formula M|statuspfad7 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT
!TEDIT: Anbindung Texteditor
.formula M|textedittool = 'U|xtinhalt1'
.copy M|texteditverw = G|true  ? U|xtkuerzel = "yes"
.copy M|texteditverw = G|false ? U|xtkuerzel = "no"
.continue NEXT
!DIFF: Anbindung diff-Tool
.formula M|difftool = 'U|xtinhalt1'
.copy M|diffverw  = G|true  ? U|xtkuerzel = "yes"
.copy M|diffverw  = G|false ? U|xtkuerzel = "no"
.continue NEXT 
!BACKUP: Sicherung im Zielsystem
..Die Sicherung ist immer im Zielsystem
.continue NEXT ? F|empty(M|pfadvor6)
.formula M|sichverz = 'U|xtinhalt1'
.copy M|sichverw = G|true     ? U|xtkuerzel = "yes"
.copy M|sichverw = G|false    ? U|xtkuerzel = "no"
.continue NEXT ? _M|sichverw 
..PrÅfen ob es Sicherungsverzeichnis gibt
.continue NEXT ? F|empty(M|sichverz)
.formula U|xtcmd = "ls -l " + 'M|pfadvor6' + 'M|sichverz'
.system 'U|xtcmd' background
.continue ERROR3 ? _G|mehr
.formula M|statussich = M|icongruen 
.continue NEXT
!FILE1: Dateityp 1
.formula M|dattyp1      = 'U|xtkuerzel'
.formula M|datendung1   = 'U|xtinhalt2'   ? U|xtinhalt1 = "Extension"
.formula M|datenthaelt1 = 'U|xtinhalt2'   ? U|xtinhalt1 = "Content"
.formula U|xtzaehlerdat    = 1
.formula M|fehlerdattyp1 = ""
.formula M|statusdattyp1 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT
!FILE2: Dateityp 2
.formula M|dattyp2      = 'U|xtkuerzel'
.formula M|datendung2   = 'U|xtinhalt2'   ? U|xtinhalt1 = "Extension"
.formula M|datenthaelt2 = 'U|xtinhalt2'   ? U|xtinhalt1 = "Content"
.formula U|xtzaehlerdat    = 2
.formula M|fehlerdattyp2 = ""
.formula M|statusdattyp2 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT
!FILE3: Dateityp 3
.formula M|dattyp3      = 'U|xtkuerzel'
.formula M|datendung3   = 'U|xtinhalt2'   ? U|xtinhalt1 = "Extension"
.formula M|datenthaelt3 = 'U|xtinhalt2'   ? U|xtinhalt1 = "Content"
.formula U|xtzaehlerdat    = 3
.formula M|fehlerdattyp3 = ""
.formula M|statusdattyp3 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT
!FILE4: Dateityp 4
.formula M|dattyp4      = 'U|xtkuerzel'
.formula M|datendung4   = 'U|xtinhalt2'   ? U|xtinhalt1 = "Extension"
.formula M|datenthaelt4 = 'U|xtinhalt2'   ? U|xtinhalt1 = "Content"
.formula U|xtzaehlerdat    = 4
.formula M|fehlerdattyp4 = ""
.formula M|statusdattyp4 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT
!FILE5: Dateityp 5
.formula M|dattyp5      = 'U|xtkuerzel'
.formula M|datendung5   = 'U|xtinhalt2'   ? U|xtinhalt1 = "Extension"
.formula M|datenthaelt5 = 'U|xtinhalt2'   ? U|xtinhalt1 = "Content"
.formula U|xtzaehlerdat    = 5
.formula M|fehlerdattyp5 = ""
.formula M|statusdattyp5 = M|iconrot
.input "sy/EXPLORER.TEST"
.continue NEXT
!NEXT
.formula U|xtzaehlerpfad = ""
.formula U|xtzaehlerdat  = ""
.select from "sy/EXPLORER.INPUT" U|xtline ^
.continue LOOPINP ? G|mehr
.continue ENDE ?  U|xbinput
.. Optionen vorbelgen
.copy M|sicherheit = G|true
.copy M|nurdatei   = G|false
.copy M|nurdiffszeigen    = G|false
.copy M|nurtrefferzeigen  = G|false
.. Diff vorbelegen
.formula M|diffdat1 = ""
.formula M|diffdat2 = ""
.formula M|diffkomplett1 = ""
.formula M|diffkomplett2 = ""
..Programmende
!ENDE
.continue
..Fehlerhandling
!ERROR1: konnte Mandantenverzeichnis nicht ermitteln
.error Konnte Mandantenverzeichnis nicht ermitteln.
..
.end 1
!ERROR2: Input-Datei konnte nicht gelesen werden
.error Input-Datei konnte nicht gelesen werden.
..
.formula M|inputdatanz = M|iconnovorbelegung
.end 1
!ERROR3: Konnte Sicherungsverzeichnis nicht ermitteln
.set trans +
.formula M|fehlersich = F|formatstr("Kein Verzeichnis {1} in {2} gefunden.",'M|sichverz','M|pfadvor6')
.set trans -
.formula M|statussich = M|iconrot 
.copy M|sichverw = G|false
.continue NEXT

