..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.PROTECT.LANGUAGE
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Schuetzt die Rubrik "Sprache".
.. Ablauf          : Unterprogramm
.. Functionality   : Protects the category "language".
.. Program flow    : Subroutine
...Includes        :
.. include sy/TRANS.SELLANG.FA
..*****************************************************************************
.set trans -
..
.copy M|hasdo = M|doadd ; M|dogen ; M|doedit ; M|dosubedit; M|dotest ; M|doteststrict ; M|doinsert ; M|dotrans ; M|dotransfocmd ; M|dorepair ; M|domsgdat
.formula M|lastdo = "" ? _M|hasdo
.continue RESET ? M|hasdo & (M|dotest ; M|doteststrict ; M|doinsert ; M|dogen)
..
.. Protect languages and clear their values
.protection sellang 0
.protection alwaysen 0
.protection langde 0
.protection langen 0
.protection langfr 0
.protection langes 0
.protection langit 0
.protection langpl 0
.protection langru 0
.protection langhu 0
.protection langcs 0
.protection langtr 0
.protection langfirst 0
.protection langsecond 0
.protection langthird 0
.protection langenus 0
.protection langro 0
.protection langid 0
.protection langnl 0
.protection langmk 0
.protection langbg 0
.protection langsr 0
.protection langsl 0
.protection langsk 0
.protection langpt 0
.protection langzhs 0
.protection langzh 0
.protection langel 0
.protection langar 0
.protection langth 0
.protection langfa 0
.protection langvi 0
.protection langur 0
.protection langja 0
..
.copy M|sellang = M|somelang
.copy M|alwaysen = G|FALSE
.copy M|langde = G|FALSE
.copy M|langen = G|FALSE
.copy M|langfr = G|FALSE
.copy M|langes = G|FALSE
.copy M|langit = G|FALSE
.copy M|langpl = G|FALSE
.copy M|langru = G|FALSE
.copy M|langhu = G|FALSE
.copy M|langcs = G|FALSE
.copy M|langtr = G|FALSE
.copy M|langfirst = G|FALSE
.copy M|langsecond = G|FALSE
.copy M|langthird = G|FALSE
.copy M|langenus = G|FALSE
.copy M|langro = G|FALSE
.copy M|langid = G|FALSE
.copy M|langnl = G|FALSE
.copy M|langmk = G|FALSE
.copy M|langbg = G|FALSE
.copy M|langsr = G|FALSE
.copy M|langsl = G|FALSE
.copy M|langsk = G|FALSE
.copy M|langpt = G|FALSE
.copy M|langzhs = G|FALSE
.copy M|langzh = G|FALSE
.copy M|langel = G|FALSE
.copy M|langar = G|FALSE
.copy M|langth = G|FALSE
.copy M|langfa = G|FALSE
.copy M|langvi = G|FALSE
.copy M|langur = G|FALSE
.copy M|langja = G|FALSE
.continue END
..
!RESET: Reset protection
.protection -reset sellang 0
.protection -reset alwaysen 0 ? M|dogen
.assign M|sellang = M|cfglang
.input "sy/TRANS.SELLANG.FA"
.protection -reset langde 0
.protection -reset langen 0
.protection -reset langfr 0
.protection -reset langes 0
.protection -reset langit 0
.protection -reset langpl 0
.protection -reset langru 0
.protection -reset langhu 0
.protection -reset langcs 0
.protection -reset langtr 0
.protection -reset langfirst 0
.protection -reset langsecond 0
.protection -reset langthird 0
.protection -reset langenus 0
.protection -reset langro 0
.protection -reset langid 0
.protection -reset langnl 0
.protection -reset langmk 0
.protection -reset langbg 0
.protection -reset langsr 0
.protection -reset langsl 0
.protection -reset langsk 0
.protection -reset langpt 0
.protection -reset langzhs 0
.protection -reset langzh 0
.protection -reset langel 0
.protection -reset langar 0
.protection -reset langth 0
.protection -reset langfa 0
.protection -reset langvi 0
.protection -reset langur 0
.protection -reset langja 0
..****************************************************************************
!END
.continue
