..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name        : TRANS.PROTECT.OPERATION
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Schuetzt die Rubrik "Operation".
.. Ablauf          : Unterprogramm
..
.. Functionality   : Protects the category "Operation".
.. Program flow    : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xmark ? _F|defined(U|xmark)
..
.. Initializations
.assign U|xmark = "END"
..
.copy M|hasdic = M|dicown ; M|dicprogram ; M|dicfop ; M|dictxt ; M|dicmask ; M|dicascii ; M|dichelp ; M|dicvartab ; M|dicawa ; M|dicall ; M|dicinfosys ; M|dicgui
.assign M|lastdic = "" ? _M|hasdic
.continue HASADIC ? M|hasdic
.. Something went wrong, protect every single operation
..
!OPS: Reset and protect normal operations
.protection doadd 0
.copy M|doadd = G|FALSE
.protection doedit 0
.copy M|doedit = G|FALSE
.protection dotest 0
.copy M|dotest = G|FALSE
.protection doteststrict 0
.copy M|doteststrict = G|FALSE
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.protection dotrans 0
.copy M|dotrans = G|FALSE
.protection dorepair 0
.copy M|dorepair = G|FALSE
.protection domsgclean 0
.copy M|domsgclean = G|FALSE
.continue 'U|xmark' ? U|xmark <> "END"
..
!TOOLS: reset and protect tools
.protection doinsert 0
.copy M|doinsert = G|FALSE
.protection dogen 0
.copy M|dogen = G|FALSE
.protection dosubedit 0
.copy M|dosubedit = G|FALSE
.protection domsgdat 0
.copy M|domsgdat = G|FALSE
.continue 'U|xmark'
..
!HASADIC: A dictionary is selected
.continue GERMAN ? _M|polyglot
..=============================================================================
..-----------------------------------------------------------------------------
.. Installation is multilingual
.continue TOOLOFF ? _M|toolmode
.. use tool operations and deactivate normal ones
.. the same as if multilingual
.continue TOOLSON
..-----------------------------------------------------------------------------
!TOOLOFF: Use normal operations and deactivate tools
.assign U|xmark = "ALWAYS2"
.continue TOOLS
..
!ALWAYS2: Nothing is always protected
.continue PROGRAM ? M|dicprogram ; M|dicgui
.protection -reset dorepair 0
.continue CLEANUP ? M|dicown ; M|dicvartab
.protection -reset domsgclean 0
.continue INFO ? M|dicinfosys
..
!RESET1
.protection -reset doteststrict 0
.continue ALLDIC ? M|dicall
.protection -reset doedit 0
.protection -reset dotest 0
..
.. Sometimes protected or not
.continue OWNPROG ? M|dicown ; M|dicprogram ; M|dicgui
.continue VARTAB  ? M|dicvartab
.continue TXT     ? M|dictxt
.continue FOP     ? M|dicfop
.continue REST    ? M|dicmask ; M|dicascii ; M|dichelp ; M|dicawa
.error -number 1111
.end 1
..
!INFO: Operation for infosystem
.protection -reset doadd 0
.protection -reset dotrans 0
.protection doedit 0
.copy M|doedit = G|FALSE
.protection dotest 0
.copy M|dotest = G|FALSE
.protection doteststrict 0
.copy M|doteststrict = G|FALSE
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.continue DEFAULT
..
!ALLDIC: Only strict testing is allowed
.protection doadd 0
.copy M|doadd = G|FALSE
.protection doedit 0
.copy M|doedit = G|FALSE
.protection dotest 0
.copy M|dotest = G|FALSE
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.protection dotrans 0
.copy M|dotrans = G|FALSE
.protection domsgclean 0
.copy M|domsgclean = G|FALSE
.continue DEFAULT
..
!OWNPROG: Actions for own text and program notes
.protection doadd 0
.copy M|doadd = G|FALSE
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.protection dotrans 0
.copy M|dotrans = G|FALSE
.continue DEFAULT
..
!VARTAB: Actions for vartab
.protection -reset doadd 0
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.protection dotrans 0
.copy M|dotrans = G|FALSE
.continue DEFAULT
..
!TXT: Actions for FO correspondence
.protection dotrans 0
.copy M|dotrans = G|FALSE
..
.protection -reset doadd 0
.protection -reset dotransfocmd 0
.continue DEFAULT
..
!FOP: Actions for FO operating
.protection dotrans 0
.copy M|dotrans = G|FALSE
..
.protection -reset doadd 0
.continue DEFAULT
..
!PROGRAM
.protection dorepair 0
.copy M|dorepair = G|FALSE
.protection domsgclean 0
.copy M|domsgclean = G|FALSE
.continue RESET1
..
!CLEANUP
.protection domsgclean 0
.copy M|domsgclean = G|FALSE
.continue RESET1
..
!REST: Actions for masks, ascii menus, help menus, gui menus and web applications
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
..
.protection -reset doadd 0
.protection -reset dotrans 0
.continue DEFAULT
..-----------------------------------------------------------------------------
..=============================================================================
..-----------------------------------------------------------------------------
!GERMAN: Installation is german only
.continue TOOLSON ? M|toolmode
.. use normal operations and deactivate tools
.assign U|xmark = "ALWAYS3"
.continue TOOLS
..
!ALWAYS3: Always the same
.protection -reset doadd 0
.protection -reset dorepair 0
.protection -reset domsgclean 0
..
.continue AWAPROT ? M|dicawa
.continue MAPROT  ? M|dicmask
.continue ISPROT  ? M|dicinfosys
.continue FOPROT
..
!RESET2
.protection -reset dotrans 0
..
!RESET3
.protection -reset doedit 0
.protection -reset dotest 0
.protection -reset doteststrict 0
.continue DEFAULT
..
!FOPROT: Protect unsupported operations for FO correspondence
.protection dotrans 0
.copy M|dotrans = G|FALSE
.protection -reset dotransfocmd 0
.continue RESET3
..
!ISPROT: Protect not supported operations for infosystem
.protection doedit 0
.copy M|doedit = G|FALSE
.protection dotest 0
.copy M|dotest = G|FALSE
.protection dotrans 0
.copy M|dotrans = G|FALSE
.protection doteststrict 0
.copy M|doteststrict = G|FALSE
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.continue DEFAULT
..
!MAPROT: Protect not supported operation for masks
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.protection doadd 0
.copy M|doadd = G|FALSE
.continue RESET3
..
!AWAPROT: Protect not supported operations for property files
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.continue RESET2
..-----------------------------------------------------------------------------
!TOOLSON: Use tool operations and deactivate normal ones
.assign U|xmark = "ALWAYS4"
.continue OPS
..
!ALWAYS4: Always not protected
.protection -reset domsgdat 0
.continue DICINFO ? M|dicinfosys
.protection -reset dogen 0
.protection -reset doinsert 0
..
.. Sometimes protected
.continue DICALL ? M|dicall
.protection -reset dosubedit 0
.continue FOCMD
..
!DICINFO: Protected while dictionary "Infosystem" is selected
.protection doinsert 0
.copy M|doinsert = G|FALSE
.protection dogen 0
.copy M|dogen = G|FALSE
.protection dosubedit 0
.copy M|dosubedit = G|FALSE
.continue DEFAULT
..
!DICALL: Protect edit while all dictionarys are selected
.protection dosubedit 0
.copy M|dosubedit = G|FALSE
..
!FOCMD: Protect translation of FO commands while FO operating is not selected
.continue RFOCMD ? M|dicfop ; dictxt
.protection dotransfocmd 0
.copy M|dotransfocmd = G|FALSE
.continue DEFAULT
..
!RFOCMD: Reset protection of translation of FO commands while FO dictionary are selected
.protection -reset dotransfocmd 0
.continue DEFAULT
..-----------------------------------------------------------------------------
..=============================================================================
..
!DEFAULT: If neccessary this will set default for operation
.copy M|hasdo = M|doadd ; M|dogen ; M|doedit ; M|dosubedit ; M|dotest ; M|doteststrict ; M|doinsert; M|dotransfocmd ; M|dotrans ; M|dorepair ; M|domsgdat ; M|domsgclean
.continue END ? M|hasdo
.continue TOOLMODE ? M|toolmode
..
.. Defaults for normal operations
.continue DOADD ? M|dicinfosys
.continue DOTEST ? M|dicall
..
.. Default for all other non tool mode cases
.copy M|doedit = G|TRUE
.assign M|lastdo = "doedit"
.continue END
..
!DOTEST: Default for all dictionarys
.copy M|doteststrict = G|TRUE
.assign M|lastdo = "doteststrict"
.continue END
..
!DOADD: Default for dictionary "Infosystem"
.copy M|doadd = G|TRUE
.assign M|lastdo = "doadd"
.continue END
..
!TOOLMODE: Defaults for tool mode
.continue DOGEN ? M|dicall
.continue DOMAKE ? M|dicinfosys
..
.. Default for all other tool mode cases
.copy M|dosubedit = G|TRUE
.assign M|lastdo = "dosubedit"
.continue END
..
!DOGEN: Tool mode default for all dictionarys
.copy M|dogen = G|TRUE
.assign M|lastdo = "dogen"
.continue END
..
!DOMAKE: Tool mode default for dictionary "Infosystem"
.copy M|domsgdat = G|TRUE
.assign M|lastdo = "domsgdat"
..****************************************************************************
!END
.continue
