..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name                    : DISPLAYS.ME
.. Autor                       : fwester
.. Verantwortlich              : fwester
.. Kontrolle                   : xg
.. Funktion                    : Initialisiert den Maskenpuffer.
.. Ablauf                      : Maskeneintritts-EFOP
..
.. Functionality               : Initializes buffer of mask.
.. Program flow                : Mask entry EFOP
..
...Includes                    :
.. include sy/DISPLAYS.OPEN.NODE
.. include sy/DISPLAYS.REPOS.TABLE
.. include is/CLOSE.EVENTNODE
.. include sy/DISPLAYS.SUM.CHILDS
..*****************************************************************************
..
.. Names of elements
.set trans +
.formula M|screentext = "Bildschirm"
.formula M|usertext   = "Benutzer"
.formula M|pidtext    = "Prozess"
.set trans -
..
.. Numbers of elements
.formula M|screennode = 1
.formula M|usernode   = 2
.formula M|pidleaf    = 3
..
.. Field separator
.formula M|fieldsep  = "!"
.formula M|screensep = ":"
..
.. Time and date
.formula M|lenofdate = 10
.formula M|lenoftime = F|typelength("Z")
.formula M|pidexpiry = 0
..
.. Icon names
.formula M|path2screen = "icon:workstation"
.formula M|path2user   = "icon:user"
.formula M|path2pid    = "icon:process"
..
.. Temporary files
.file -screen -tempname M|treeviewfile
.file -screen -tempname M|usersfile
..
.. Callparameters
.assign M|callparam = "52552"
..
.. EFOP names
.formula M|openknot   = "sy/DISPLAYS.OPEN.NODE"
.formula M|afteropen  = "sy/DISPLAYS.REPOS.TABLE"
.formula M|closeknot  = "is/CLOSE.EVENTNODE"
.formula M|afterclose = "sy/DISPLAYS.REPOS.TABLE"
.formula M|rowdetails = "sy/DISPLAYS.ZW"
.formula M|cleartable = "is/TABLEEREN"
.formula M|sumchilds  = "sy/DISPLAYS.SUM.CHILDS"
..
.formula M|anzstufen = 3
.formula M|instno = F|sysinfo(18)^instnr
.formula M|expiry = F|sysinfo(18)^verfall
..
.. Set initial protections
.protection treeviewfile 0
..*****************************************************************************
!END
.continue
