..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LIST.ENUM
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : ba
.. Funktion       : Ermittelt Werte einer statischen Aufz„hlung.
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : ja
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   arg1         Nummer der Aufzaehlung
..   arg2         Optional Typ der Aufzaehlung
..
.. Functionality  : Get values of an enumeration.
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : yes
..
..   Argument     meaning
..   ---------------------------------------------------------
..   arg1         Number of enumeration
..   arg2         Optional type of enumeration
..*****************************************************************************
.set trans -
..
.. Declarations
.type integer xxenumber      ? _F|defined(U|xxenumber)
.type NT1     xxetype        ? _F|defined(U|xxetype)
.type bool    xxoutput       ? _F|defined(U|xxoutput)
.type text    xxallowedtypes ? _F|defined(U|xxallowedtypes)
.type integer xx             ? _F|defined(U|xx)
.type text    xxfoundtype    ? _F|defined(U|xxfoundtype)
.type text    xxneededtype   ? _F|defined(U|xxneededtype)
.type text    xxevarname     ? _F|defined(U|xxevarname)
.type text    xxdeclare      ? _F|defined(U|xxdeclare)
..
.. Initializations
.assign U|xxenumber = -1
.assign U|xxetype = ""
.assign U|xxallowedtypes = "k K n N u U s S"
.assign U|xx = 0
.copy U|xxoutput = G|TRUE
.assign U|xxevarname = "xxmyenum"
.atext -language 'G|lsprache' U|xxdeclare 1789 art
..
.. One or two arguments accepted
.continue ARGUMENTS ? G|argc > 1 & G|argc < 5
..
.. FOP is possibly called as an subroutine
.continue USAGE ? _F|defined(U|xenumnumber)
.continue USAGE ?  F|empty(U|xenumnumber)
.assign U|xxenumber = U|xenumnumber
.assign U|xxetype = U|xenumtype ? F|defined(U|xenumtype)
.copy U|xxoutput = _U|xnooutput ? F|defined(U|xnooutput)
.continue VALIDATE
..
!ARGUMENTS: FOP has arguments, get them
.assign U|xxenumber = F|trim(G|arg1) ? F|defined(G|arg1)
.assign U|xxetype   = F|trim(G|arg2) ? F|defined(G|arg2)
.continue VALIDATE
..
!VALIDATE: Validating arguments
.. Load enumeration
.continue ERROR1 ? U|xxenumber <= 0
.set enumerationtype 'U|xxenumber'
.continue ERROR1 ? _G|mehr
..
.. Validate type of enumeration
.continue ERROR2 ? F|strindex(U|xxallowedtypes, U|xxetype) = 0
.assign U|xxfoundtype = "A" + 'U|xxenumber'
.continue SAMETYPES ? F|empty(U|xxetype)
.assign U|xxneededtype = "A" + U|xxetype + 'U|xxenumber'
.continue ENUMTYPE
..
!SAMETYPES: Found and needed types are the equal
.assign U|xxneededtype = U|xxfoundtype
..
!ENUMTYPE: Validate enum type
.continue ERROR3 ? _F|compatible('U|xxfoundtype', 'U|xxneededtype')
..
.output terminal ? U|xxoutput
..
!FOR: Save enumeration values into an array
.formula U|xx = U|xx + 1
.. Declare found type
.'F|expr(U|xxdeclare + " " + U|xxfoundtype + " " + U|xxevarname + F|tostring(U|xx))'
.continue ERROR2 ? _F|defined(F|expr("U|" + U|xxevarname + F|tostring(U|xx)))
.assign U|xxmyenum.U|xx = F|expr("(" + 'G|enumposcode.U|xx' + ")")
.println 'U|xxmyenum.U|xx' 'F|value(U|xxmyenum.U|xx,F|tostring(U|xxneededtype))' ? U|xxoutput
.continue FOR ? U|xx < G|enumnumpos
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!USAGE
.set trans +
.output terminal
.println st/LIST.ENUM arg1 arg2
.println Parameter:         Bedeutung:
.println
.println xenumnumber (arg1) Nummer der Aufz„hlung
.println xenumtype   (arg2) Optional Typ der Aufz„hlung (K|N|U|S)
.set trans -
.end 1
..
!ERROR1: Unknown number of enumeration
.error -message Eine Aufz„hlung der Nummer 'U|xxenumber' ist unbekannt!
.end 1
..
!ERROR2: Unknown type of enumeration
.error -message Ein Aufz„hlungstyp A'U|xxetype' ist unbekannt!
.end 1
..
!ERROR3: Incompatible enumeration types
.error -message Die Aufz„hlungstypen 'U|xxfoundtype' und 'U|xxneededtype' sind zueinander nicht kompatibel!
.end 1
