..!interpreter english translate noabbrev src=de
..*****************************************************************************
.. FOP-Name        : TRANS.SET.VALUES.LANGUAGE
.. Autor           : fwester
.. Verantwortlich  : fwester
.. Kontrolle       : cl
.. Funktion        : Simuliert im Modus "eine Sprache" des Feldes "M|sellang"
.. eine radio button group fuer die Sprachauswahl im Infosystem.
.. Ablauf          : Feldaustritts-EFOP
..
.. Functionality   : While mode of "M|sellang" is "one language" this will
.. simulate a radio button group for the selection of a language.
.. Program flow    : Field exit efop
..*****************************************************************************
.set trans -
..
.continue ALWAYS  ? G|evtvar = "alwaysen"
.continue ENGLISH ? G|evtvar = "langenus"
.continue MULTI ? M|sellang <> M|onelang
..
.copy M|langenus = G|FALSE
..
!ONELANG: One language was pushed
.copy M|langde = G|evtvar = "langde"
.copy M|langen = G|evtvar = "langen"
.copy M|langfr = G|evtvar = "langfr"
.copy M|langes = G|evtvar = "langes"
.copy M|langit = G|evtvar = "langit"
.copy M|langpl = G|evtvar = "langpl"
.copy M|langru = G|evtvar = "langru"
.copy M|langhu = G|evtvar = "langhu"
.copy M|langcs = G|evtvar = "langcs"
.copy M|langtr = G|evtvar = "langtr"
.copy M|langfirst = G|evtvar = "langfirst"
.copy M|langsecond = G|evtvar = "langsecond"
.copy M|langthird = G|evtvar = "langthird"
.copy M|langenus = G|evtvar = "langenus"
.copy M|langro = G|evtvar = "langro"
.copy M|langid = G|evtvar = "langid"
.copy M|langnl = G|evtvar = "langnl"
.copy M|langmk = G|evtvar = "langmk"
.copy M|langbg = G|evtvar = "langbg"
.copy M|langsr = G|evtvar = "langsr"
.copy M|langsl = G|evtvar = "langsl"
.copy M|langsk = G|evtvar = "langsk"
.copy M|langpt = G|evtvar = "langpt"
.copy M|langzhs = G|evtvar = "langzhs"
.copy M|langzh = G|evtvar = "langzh"
.copy M|langel = G|evtvar = "langel"
.copy M|langar = G|evtvar = "langar"
.copy M|langth = G|evtvar = "langth"
.copy M|langfa = G|evtvar = "langfa"
.copy M|langvi = G|evtvar = "langvi"
.copy M|langur = G|evtvar = "langur"
.copy M|langja = G|evtvar = "langja"
.continue END
..
!ENGLISH: English was pushed
.copy M|alwaysen = G|FALSE ? _M|langenus
.continue ONELANG ? M|sellang = M|onelang
.continue MULTI
..
!ALWAYS: Always English was pushed
.continue ONELANG ? M|sellang = M|onelang
.continue END
..
!MULTI: We have more than one language
.assign M|sellang = M|somelang ? M|sellang = M|cfglang ; M|sellang = M|alllang
..****************************************************************************
!END
.continue
