..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtcmd xtdatei xtsuch xtid xtpvorgang xtpvnum xtprojekt xtprojsuch xtnummer xykoobjekt xtmp xtstack xtaind xtpind xtselindex
.type text    xtsumme xtbedarf xtangebot xtuebuntlast xtauslastung xtfarbe xttip xtftaufzu xtvar xtindex xttitelx xttitely
.type text    xtmonat1 xtmonat2 xtmonat3 xtmonat4 xtmonat5 xtmonat6 xtmonat7 xtmonat8 xtmonat9 xtmonat10 xtmonat11 xtmonat12
.type text    xt1 xt2 xt3 xt4 xt5 xt6 xysel
.type real    xrwert xr1 xrsz1 xrsz2 xrsz3 xrsz4 xrsz5 xrsz6 xrsz7 xr01
.type real    xrma1 xrma2 xrma3 xrma4 xrma5 xrma6 xrma7 xrma8 xrma9 xrma10 xrma11 xrma12
.type real    xrmb1 xrmb2 xrmb3 xrmb4 xrmb5 xrmb6 xrmb7 xrmb8 xrmb9 xrmb10 xrmb11 xrmb12
.type real    xrwa1  xrwa2  xrwa3  xrwa4  xrwa5  xrwa6  xrwa7  xrwa8  xrwa9  xrwa10
.type real    xrwa11 xrwa12 xrwa13 xrwa14 xrwa15 xrwa16 xrwa17 xrwa18 xrwa19 xrwa20
.type real    xrwa21 xrwa22 xrwa23 xrwa24 xrwa25 xrwa26 xrwa27 xrwa28 xrwa29 xrwa30
.type real    xrwa31 xrwa32 xrwa33 xrwa34 xrwa35 xrwa36 xrwa37 xrwa38 xrwa39 xrwa40
.type real    xrwa41 xrwa42 xrwa43 xrwa44 xrwa45 xrwa46 xrwa47 xrwa48 xrwa49 xrwa50
.type real    xrwa51 xrwa52 xrwa53
.type real    xrwb1  xrwb2  xrwb3  xrwb4  xrwb5  xrwb6  xrwb7  xrwb8  xrwb9  xrwb10
.type real    xrwb11 xrwb12 xrwb13 xrwb14 xrwb15 xrwb16 xrwb17 xrwb18 xrwb19 xrwb20
.type real    xrwb21 xrwb22 xrwb23 xrwb24 xrwb25 xrwb26 xrwb27 xrwb28 xrwb29 xrwb30
.type real    xrwb31 xrwb32 xrwb33 xrwb34 xrwb35 xrwb36 xrwb37 xrwb38 xrwb39 xrwb40
.type real    xrwb41 xrwb42 xrwb43 xrwb44 xrwb45 xrwb46 xrwb47 xrwb48 xrwb49 xrwb50
.type real    xrwb51 xrwb52 xrwb53
.type realx   xxfaktor xxangewicht xxanteil xx1
.type integer xijahr ximonat xiwoche xitag xidatei xizeile xifarbe xistufe xisort xianzat xivar ximerkzeile xi1
.type GD      xd1 xdatum xdadatum xdedatum
.type GW4     xwoche xwkw1
.type bool    xbok xbstart xbmehr xybnoprsel xbangebot xbbedarf
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Zeilen_Texte -----
.set trans +
.translate -LANGUAGE 'G|bsprache' -TEXT "Summe"             -VARIABLE U|xtsumme
.formula U|xtsumme     = "Summe"                                                ? F|empty(U|xtsumme)
.translate -LANGUAGE 'G|bsprache' -TEXT "KapazitÑtsbedarf"  -VARIABLE U|xtbedarf
.formula U|xtbedarf     = "KapazitÑtsbedarf"                                    ? F|empty(U|xtbedarf)
.translate -LANGUAGE 'G|bsprache' -TEXT "KapazitÑtsangebot" -VARIABLE U|xtangebot
.formula U|xtangebot    = "KapazitÑtsangebot"                                   ? F|empty(U|xtangebot)
.translate -LANGUAGE 'G|bsprache' -TEXT "öber-/Unterlast"   -VARIABLE U|xtuebuntlast
.formula U|xtuebuntlast = "öber-/Unterlast"                                     ? F|empty(U|xtuebuntlast)
.translate -LANGUAGE 'G|bsprache' -TEXT "Auslastung %"      -VARIABLE U|xtauslastung
.formula U|xtauslastung = "Auslastung %"                                        ? F|empty(U|xtauslastung)
.translate -LANGUAGE 'G|bsprache' -TEXT "Januar"    -VARIABLE U|xtmonat1
.formula U|xtmonat1  = "Januar"                                                 ? F|empty(U|xtmonat1)
.translate -LANGUAGE 'G|bsprache' -TEXT "Februar"   -VARIABLE U|xtmonat2
.formula U|xtmonat2  = "Februar"                                                ? F|empty(U|xtmonat2)
.translate -LANGUAGE 'G|bsprache' -TEXT "MÑrz"      -VARIABLE U|xtmonat3
.formula U|xtmonat3  = "MÑrz"                                                   ? F|empty(U|xtmonat3)
.translate -LANGUAGE 'G|bsprache' -TEXT "April"     -VARIABLE U|xtmonat4
.formula U|xtmonat4  = "April"                                                  ? F|empty(U|xtmonat4)
.translate -LANGUAGE 'G|bsprache' -TEXT "Mai"       -VARIABLE U|xtmonat5
.formula U|xtmonat5  = "Mai"                                                    ? F|empty(U|xtmonat5)
.translate -LANGUAGE 'G|bsprache' -TEXT "Juni"      -VARIABLE U|xtmonat6
.formula U|xtmonat6  = "Juni"                                                   ? F|empty(U|xtmonat6)
.translate -LANGUAGE 'G|bsprache' -TEXT "Juli"      -VARIABLE U|xtmonat7
.formula U|xtmonat7  = "Juli"                                                   ? F|empty(U|xtmonat7)
.translate -LANGUAGE 'G|bsprache' -TEXT "August"    -VARIABLE U|xtmonat8
.formula U|xtmonat8  = "August"                                                 ? F|empty(U|xtmonat8)
.translate -LANGUAGE 'G|bsprache' -TEXT "September" -VARIABLE U|xtmonat9
.formula U|xtmonat9  = "September"                                              ? F|empty(U|xtmonat9)
.translate -LANGUAGE 'G|bsprache' -TEXT "Oktober"   -VARIABLE U|xtmonat10
.formula U|xtmonat10 = "Oktober"                                                ? F|empty(U|xtmonat10)
.translate -LANGUAGE 'G|bsprache' -TEXT "November"  -VARIABLE U|xtmonat11
.formula U|xtmonat11 = "November"                                               ? F|empty(U|xtmonat11)
.translate -LANGUAGE 'G|bsprache' -TEXT "Dezember"  -VARIABLE U|xtmonat12
.formula U|xtmonat12 = "Dezember"                                               ? F|empty(U|xtmonat12)
.set trans -
.continue 'xprocst.xprocsp'
!PROC002: ----- Diagramm -----
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.copy U|xbangebot = G|false
.copy U|xbbedarf  = G|false
.continue EL001 ? _(M|ybwochen)
.formula U|xttip   = ""
.formula U|xiwoche = 1
!LOOP001: ==============================
.continue ELOP001 ? _(U|xiwoche < 54)
.formula U|xttip = U|xttip + ";"                            ? _F|empty(U|xttip)
.formula U|xttip = U|xttip + "KW " + F|tostring(U|xiwoche)
.formula U|xiwoche = U|xiwoche + 1
.continue LOOP001
!ELOP001: ==============================
.continue FI001
!EL001
.formula U|xttip = U|xtmonat1
.formula U|xttip = U|xttip + ";" + U|xtmonat2
.formula U|xttip = U|xttip + ";" + U|xtmonat3
.formula U|xttip = U|xttip + ";" + U|xtmonat4
.formula U|xttip = U|xttip + ";" + U|xtmonat5
.formula U|xttip = U|xttip + ";" + U|xtmonat6
.formula U|xttip = U|xttip + ";" + U|xtmonat7
.formula U|xttip = U|xttip + ";" + U|xtmonat8
.formula U|xttip = U|xttip + ";" + U|xtmonat9
.formula U|xttip = U|xttip + ";" + U|xtmonat10
.formula U|xttip = U|xttip + ";" + U|xtmonat11
.formula U|xttip = U|xttip + ";" + U|xtmonat12
!FI001
.set trans +
.formula U|xttitelx = "Summe öber- / Unterlast nach "
.formula U|xttitely = "Stunden "
.set trans -
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.formula U|xtsel = U|xttitelx + M|yaggrtyp
.chart -PARAM -TITLECHART 'U|xtsel'
.chart -PARAM -TITLEY 'U|xttitely'
.chart -PARAM -MARKERX 'U|xttip'
.chart -PARAM -ANGLEX 45
.chart -PARAM -DECIMALSY 2
.chart -PARAM -3D NO
.chart -param -stacktype STACKED
.select screen line     ? G|evtzeile = 0
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL002 ? _((((G|evtzeile = 0) & (M|ytname = U|xtsumme)) ; ((G|evtzeile > 0) & (M|ytobjekt^id = U|xtid))) & (M|ytdatenebene <> U|xtauslastung))
.formula U|ximonat = 1
.formula U|xiwoche = 1
.copy U|xbangebot = G|true      ? M|ytdatenebene = U|xtangebot
.copy U|xbbedarf  = G|true      ? M|ytdatenebene = U|xtbedarf
.continue EL003 ? _(M|ybwochen)
!LOOP003: ==============================
.continue ELOP003 ? _(F|defined(M|ytweek.xiwoche))
.formula U|xrwa.xiwoche = M|ytweek.xiwoche  ? M|ytdatenebene = U|xtangebot
.formula U|xrwb.xiwoche = M|ytweek.xiwoche  ? M|ytdatenebene = U|xtbedarf
.formula U|xiwoche U|xiwoche + 1
.continue LOOP003
!ELOP003: ==============================
.continue FI003
!EL003
!LOOP004: ==============================
.continue ELOP004 ? _(F|defined(M|ytmon.ximonat))
.formula U|xrwa.ximonat = M|ytmon.ximonat   ? M|ytdatenebene = U|xtangebot
.formula U|xrwb.ximonat = M|ytmon.ximonat   ? M|ytdatenebene = U|xtbedarf
.formula U|ximonat U|ximonat + 1
.continue LOOP004
!ELOP004: ==============================
!FI003
!EL002
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue EL004 ? _(U|xbbedarf)
.chart -STARTVALUES 'U|xtbedarf'
.formula U|xiwoche = 1
!LOOP005: ==============================
.continue ELOP005 ? _(((_(M|ybwochen)) & (U|xiwoche < 13)) ; ((M|ybwochen) & (U|xiwoche < 54)))
.formula U|xtfarbe = "255 184 55"
.formula U|xttip = U|xtbedarf  + ";KW " + F|tostring(xiwoche) + ";" + 'U|xrwb.xiwoche'  ?  M|ybwochen
.formula U|xttip = U|xtbedarf  + ";"    + U|xtmonat.xiwoche   + ";" + 'U|xrwb.xiwoche'  ? _M|ybwochen
.formula U|xrwert = U|xrwb.xiwoche
.continue EL005 ? _((U|xbangebot) & (U|xbbedarf))
.formula U|xrwert = U|xrwa.xiwoche  ? U|xrwa.xiwoche < U|xrwb.xiwoche
!EL005
.chart -VALUE 'U|xrwert' -RGBCOLOR 'U|xtfarbe' -TIP 'U|xttip'
.formula U|xiwoche U|xiwoche + 1
.continue LOOP005
!ELOP005: ==============================
!EL004
.continue EL006 ? _(U|xbangebot)
.chart -STARTVALUES 'U|xtangebot'
.formula U|xiwoche = 1
!LOOP006: ==============================
.continue ELOP006 ? _(((_(M|ybwochen)) & (U|xiwoche < 13)) ; ((M|ybwochen) & (U|xiwoche < 54)))
.formula U|xtfarbe = "140 230 125"
.formula U|xttip = U|xtangebot + ";KW " + F|tostring(xiwoche) + ";" + 'U|xrwa.xiwoche'  ?  M|ybwochen
.formula U|xttip = U|xtangebot + ";"    + U|xtmonat.xiwoche   + ";" + 'U|xrwa.xiwoche'  ? _M|ybwochen
.formula U|xrwert = U|xrwa.xiwoche
.continue EL007 ? _((U|xbangebot) & (U|xbbedarf))
.formula U|xrwert = 0           ? U|xrwa.xiwoche < U|xrwb.xiwoche
!EL007
.chart -VALUE 'U|xrwert' -RGBCOLOR 'U|xtfarbe' -TIP 'U|xttip'
.formula U|xiwoche U|xiwoche + 1
.continue LOOP006
!ELOP006: ==============================
!EL006
.continue EL008 ? _((U|xbangebot) & (U|xbbedarf))
.chart -STARTVALUES 'U|xtuebuntlast'
.formula U|xiwoche = 1
!LOOP007: ==============================
.continue ELOP007 ? _(((_(M|ybwochen)) & (U|xiwoche < 13)) ; ((M|ybwochen) & (U|xiwoche < 54)))
.formula U|xtfarbe = "255 50 55"
.formula U|xttip = U|xtangebot + ";KW " + F|tostring(xiwoche) + ";" + 'U|xrwa.xiwoche'  ?  M|ybwochen
.formula U|xttip = U|xtangebot + ";"    + U|xtmonat.xiwoche   + ";" + 'U|xrwa.xiwoche'  ? _M|ybwochen
.formula U|xrwert = 0
.continue EL009 ? _((U|xbangebot) & (U|xbbedarf))
.formula U|xrwert = U|xrwb.xiwoche - U|xrwa.xiwoche  ? U|xrwa.xiwoche < U|xrwb.xiwoche
!EL009
.chart -VALUE 'U|xrwert' -RGBCOLOR 'U|xtfarbe' -TIP 'U|xttip'
.formula U|xiwoche U|xiwoche + 1
.continue LOOP007
!ELOP007: ==============================
!EL008
.cursor ytchart 'G|evtzeile'        ? G|evtzeile > 0
.chart -SHOW ytchart 1              ? G|evtzeile > 0
.chart -SHOW ychart 0               ? G|evtzeile = 0
.continue 'xprocst.xprocsp'
!PROC003: ----- YearWeek -----
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "MONTH", "")  ?  M|ybwochen &  F|regmatch(P|maskkontextfop, ".*MONTH.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "MONTH"                ? _M|ybwochen & _F|regmatch(P|maskkontextfop, ".*MONTH.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "WEEK", "")   ? _M|ybwochen &  F|regmatch(P|maskkontextfop, ".*WEEK.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "WEEK"                 ?  M|ybwochen & _F|regmatch(P|maskkontextfop, ".*WEEK.*")
.continue 'xprocst.xprocsp'
!PROC004: ----- VariablenWocheDatum -----
.formula U|xdadatum = 'M|yjahr' + "0101"
.formula U|xdedatum = 'M|yjahr' + "1231"
.formula U|xwoche = F|tostring(M|yjahr) + "0104"
.formula U|xwkw1  = F|tostring(U|xwoche)
.formula U|xwoche = U|xwkw1
.formula U|xiwoche = 1
!LOOP008: ==============================
.continue ELOP008 ? _(U|xiwoche <= 53)
.formula U|xtsel = U|xwoche:8
.type integer  xitab.xtsel          ? _F|defined(M|xitab.xtsel)
.formula U|xitab.xtsel = U|xiwoche
.formula U|xwoche  = U|xwoche  + 7
.formula U|xiwoche = U|xiwoche + 1
.continue LOOP008
!ELOP008: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- neue_Zeile -----
.output new 'U|xtftaufzu'
.make screen line +O
.assign  M|ytobjekt     = 0|id
.assign  M|ytpersonal   = 0|id              ? M|yaggrtypk = "PERS"
.assign  M|ytgewerk     = 0|id              ? M|yaggrtypk = "GEW"
.assign  M|ytverantwkst = 0|id              ? M|yaggrtypk = "03"
.assign  M|ytpersonal   = 0|id              ? M|yaggrtypk = "PERS"
.assign  M|ytperstypk   = 0|yprjmperstypk   ? M|yaggrtypk = "PERS"
.formula M|ytname       = 0|namebspr
.formula M|ytfarbe      = U|xtfarbe
.formula M|yftaufzu     = U|xtftaufzu
.output new 'M|yftaufzu'
.continue 'xprocst.xprocsp'
!PROC006: ----- Auslastungzeile -----
.continue EL010 ? _((M|ybkapangebot) & (M|ybkapbedarf))
.formula U|xivar = 1
!LOOP009: ==============================
.continue ELOP009 ? _(F|defined(M|ytmon.xivar))
.formula U|xrmb.xivar = M|ytmon.xivar
.formula U|xivar = U|xivar + 1
.continue LOOP009
!ELOP009: ==============================
.formula U|xivar = 1
!LOOP010: ==============================
.continue ELOP010 ? _(F|defined(M|ytweek.xivar))
.formula U|xrwb.xivar = M|ytweek.xivar
.formula U|xivar = U|xivar + 1
.continue LOOP010
!ELOP010: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC005
!RET002
.formula xprocsp = xprocsp - 1
.formula M|ytdatenebene = U|xtuebuntlast
.formula U|xivar = 1
!LOOP011: ==============================
.continue ELOP011 ? _(F|defined(M|ytmon.xivar))
.formula M|ytmon.xivar = U|xrma.xivar - U|xrmb.xivar
.formula U|xivar = U|xivar + 1
.continue LOOP011
!ELOP011: ==============================
.formula U|xivar = 1
!LOOP012: ==============================
.continue ELOP012 ? _(F|defined(M|ytweek.xivar))
.formula M|ytweek.xivar = U|xrwa.xivar - U|xrwb.xivar
.formula U|xivar = U|xivar + 1
.continue LOOP012
!ELOP012: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC005
!RET003
.formula xprocsp = xprocsp - 1
.formula M|ytdatenebene = U|xtauslastung
.formula U|xivar = 1
!LOOP013: ==============================
.continue ELOP013 ? _(F|defined(M|ytmon.xivar))
.formula M|ytmon.xivar = U|xrmb.xivar / U|xrma.xivar * 100      ? U|xrma.xivar  <> 0
.formula U|xivar = U|xivar + 1
.continue LOOP013
!ELOP013: ==============================
.formula U|xivar = 1
!LOOP014: ==============================
.continue ELOP014 ? _(F|defined(M|ytweek.xivar))
.formula M|ytweek.xivar = U|xrwb.xivar / U|xrwa.xivar * 100     ? U|xrwa.xivar  <> 0
.formula U|xivar = U|xivar + 1
.continue LOOP014
!ELOP014: ==============================
!EL010
.continue 'xprocst.xprocsp'
!PROC007: ----- Sollzeit_Personal -----
.input "java:de.alltrotec.ps.control.StaffWorkDays@ALLPS"
.formula U|xtindex = F|nextelem(U|xbwd, xtindex)
!LOOP015: ==============================
.continue ELOP015 ? _(_(F|empty(U|xtindex)))
.continue EL011 ? _(U|xbwd.xtindex)
.formula U|xdatum  = U|xtindex
.formula U|ximonat = F|month(U|xdatum)
.formula U|xwoche  = U|xdatum
.formula U|xwoche  = F|tostring(U|xwoche)
.formula U|xtsel   = U|xwoche:8
.formula U|xiwoche = U|xitab.xtsel                                              ? F|defined(U|xitab.U|xtsel)
.formula M|ytmon.ximonat  = M|ytmon.ximonat  + (U|xrtt.xtindex * U|xxfaktor)
.formula M|ytweek.xiwoche = M|ytweek.xiwoche + (U|xrtt.xtindex * U|xxfaktor)    ? F|defined(U|xitab.U|xtsel)
'9|such' # '9|id' #  'U|xdatum:8' # 'U|xrtt.xtindex' # 'U|xxfaktor' #
!EL011
.formula U|xtindex = F|nextelem(U|xbwd, xtindex)
.continue LOOP015
!ELOP015: ==============================
.continue 'xprocst.xprocsp'
!PROC008: ----- Daten_holen -----
.continue EL012 ? _((U|xtid <> U|xt2) ; (M|tzeilen = 0))
.output NEW WERF.WEG
.continue EL013 ? _(M|tzeilen <> 0)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC006
!RET004
.formula xprocsp = xprocsp - 1
!EL013
.formula U|xtsuch     = U|xt1
.formula U|xtid       = U|xt2
.formula U|xtpvorgang = U|xt3
.formula U|xxanteil   = U|xx1
.continue EL014 ? _((U|xtfarbe = U|xabasbgtable1) ; (F|empty(U|xtfarbe)))
.formula U|xtfarbe = U|xabasbgtable2
.continue FI014
!EL014
.formula U|xtfarbe = U|xabasbgtable1
!FI014
.load 0 object 'U|xtid'
.continue EL015 ? _(G|mehr)
.continue EL016 ? _(M|ybkapangebot)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC005
!RET005
.formula xprocsp = xprocsp - 1
.formula U|xrsz1 = 0
.formula U|xrsz2 = 0
.formula U|xrsz3 = 0
.formula U|xrsz4 = 0
.formula U|xrsz5 = 0
.formula U|xrsz6 = 0
.formula U|xrsz7 = 0
.formula M|ytdatenebene = U|xtangebot
.continue BRK001 ? _(M|yaggrtypk = "PERS")
.load 9 add M|ytobjekt
.formula U|xtpind = 9|nummer
.continue EL017 ? _(((F|defined(U|xtpers.xtpind)) ; (F|empty(M|ystammkstelle))) & ((F|defined(U|xtselpers.xtpind)) ; (_(M|ybbelproj))))
.formula U|xxfaktor = 9|yprjmkapazitaet / 100
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC007
!RET006
.formula xprocsp = xprocsp - 1
!EL017
.continue ESAC001
!BRK001
.continue BRK002 ? _(M|yaggrtypk = "GEW")
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";id=="               + M|ypersonal^id             ? _F|empty(M|ypersonal)
.formula U|xtsel = U|xtsel + ";yprjminaktiv==(No)"
.formula U|xtsel = U|xtsel + ";yprjmpplanrelev==(Yes)"
.formula U|xtsel = U|xtsel + ";yprjmgewerk1<>`"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrpersonal' 'U|xtsel'
!LOOP016: ==============================
.continue ELOP016 ? _(G|mehr)
.formula U|xr1 = 0
.formula U|xr1 = 9|yprjmgewerkant1  ? 9|yprjmgewerk1^id = 0|id
