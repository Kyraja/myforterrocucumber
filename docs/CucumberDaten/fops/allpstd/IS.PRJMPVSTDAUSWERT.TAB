!LOOP012: ==============================
.continue ELOP012 ? _(G|mehr)
.formula U|xtselindex = 9|nummer
.type text xtselpers.xtselindex     ? _F|defined(U|xtselpers.xtselindex)
.load 9 continue
.continue LOOP012
