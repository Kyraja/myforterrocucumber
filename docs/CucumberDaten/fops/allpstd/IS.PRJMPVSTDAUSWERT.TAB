!EL054
.continue EL064 ? _(U|xbok)
.continue EL065 ? _((M|ybbelproj) & (U|xbstart))
.continue EL066 ? _(_(F|empty(0|ypersonal)))
.formula U|xtselindex = 0|ypersonal^nummer
.type text xtselpers.xtselindex     ? _F|defined(U|xtselpers.xtselindex)
!EL066
.continue EL067 ? _(_(F|empty(0|yprojteam)))
.formula U|xtnummer = ((0|yprojteam^id)<<",")<<-1
.continue EL068 ? _(_(F|defined(U|xbselteam.xtnummer)))
.type bool xbselteam.xtnummer
.load 9 add 0|yprojteam
.load 9 line
!LOOP011: ==============================
.continue ELOP011 ? _((G|mehr) & (_(U|xbselteam.xtnummer)))
.formula U|xtselindex = 9|ypersonal^nummer
.type text xtselpers.xtselindex     ? _F|defined(U|xtselpers.xtselindex)
.load 9 line
.continue LOOP011
!ELOP011: ==============================
!EL068
!EL067
.continue EL069 ? _(_(F|empty(0|ykstelle)))
.formula U|xtnummer = ((0|ykstelle^id)<<",")<<-1
.continue EL070 ? _(_(F|defined(U|xbselkstelle.xtnummer)))
.type bool xbselkstelle.xtnummer
.formula U|xtsel = "$,,kstelle==" + 0|ykstelle^id + ";@filingmode=(Active)"
