..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
.input "allpze/PZE.KONFIG.INI"      ? F|fileexists("allpze/PZE.KONFIG.INI")
..====================================================
.type text    xtcmd xtsel xykoobjekt xtpersonal xtdatum
.type real    xrarbzeit xrfaktzeit xrgkzeit xrnfaktzeit xrfcstd xrpzestd xrgzkonto
.type real    xrtallgarbabs xrtallgabwabs xrtallgabwurabs xrtallgabwkrabs xrtallgabwsaabs xrtallgabwgzabs xrtgesabs
.type integer ximerkzeile
.type GD      xddatum xdadatum xdedatum
.type bool    xbmehr xbpze xbnfreipze xbnfreiabw xbapexists
.type text    xtfarbesdet xtfarbe2det xtfarbef2det xtfarbee2det xtfarbesft xtfarbe2ft xtfarbef2ft xtfarbee2ft
.type integer xyred xygreen xyblue xyhue
.type realx   xysat xyval
.type bool    xybrgb2hsv xybhsv2rgb
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Stundenzettel_laden -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'F|month(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";yprojekt=="  +  H|id
.formula U|xtsel = U|xtsel + ";@ablageart=lebendig;@zeilen=ja;@ordnung=ypersonal"
.load 0 group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL001 ? _(G|mehr)
.load 0 line '0|selzeile'
.make screen line +O
.copy    M|ytpersonal  = 0|ypersonal
.formula M|ytpersname  = 0|ypersonal^namebspr
.assign  M|ytprojekt   = H|id
.formula M|ytprojname  = H|namebspr
.formula M|ythinweis1  = 0|ythinweis1
.formula M|ythinweis2  = 0|ythinweis2
.copy    M|ytbfreigabe = 0|ybfreigabe
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yadatum="    + M|ystdvondatum:8 + "!" + M|ystdbisdatum:8
.formula U|xtsel = U|xtsel + ";ypersonal==" + 0|ypersonal^id
.formula U|xtsel = U|xtsel + ";yprojekt=="  + H|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|ytarbzeit  = M|ytarbzeit  + 1|yarbzeit
.formula M|ytfaktzeit = M|ytfaktzeit + 1|yfaktzeit
.load 1 continue
.continue LOOP001
!ELOP001: ==============================
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- FarbenDefineieren -----
.input "allpstart/PRJM.FARBEN.DEF"
.formula U|xyred   =  U|xtfarbes<<" "
.formula U|xygreen = (U|xtfarbes>>" ")<<" "
.formula U|xyblue  =  U|xtfarbes>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xyhue = U|xyhue + 20
.formula U|xyhue = U|xyhue - 360        ? U|xyhue > 360
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbesdet = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbe2<<" "
.formula U|xygreen = (U|xtfarbe2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbe2>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xyhue = U|xyhue + 20
.formula U|xyhue = U|xyhue - 360        ? U|xyhue > 360
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbe2det = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbef2<<" "
.formula U|xygreen = (U|xtfarbef2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbef2>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xyhue = U|xyhue + 20
.formula U|xyhue = U|xyhue - 360        ? U|xyhue > 360
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbef2det = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbee2<<" "
.formula U|xygreen = (U|xtfarbee2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbee2>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xyhue = U|xyhue + 20
.formula U|xyhue = U|xyhue - 360        ? U|xyhue > 360
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbee2det = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbes<<" "
.formula U|xygreen = (U|xtfarbes>>" ")<<" "
.formula U|xyblue  =  U|xtfarbes>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xysat = U|xysat - (U|xysat * 0.2)
.formula U|xyval = U|xyval - (U|xyval * 0.08)
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbesft = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbe2<<" "
.formula U|xygreen = (U|xtfarbe2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbe2>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xysat = U|xysat - (U|xysat * 0.2)
.formula U|xyval = U|xyval - (U|xyval * 0.08)
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbe2ft = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbef2<<" "
.formula U|xygreen = (U|xtfarbef2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbef2>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xysat = U|xysat - (U|xysat * 0.2)
.formula U|xyval = U|xyval - (U|xyval * 0.08)
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbef2ft = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbee2<<" "
.formula U|xygreen = (U|xtfarbee2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbee2>$" "
.copy    U|xybrgb2hsv = G|true
.copy    U|xybhsv2rgb = G|false
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xysat = U|xysat - (U|xysat * 0.2)
.formula U|xyval = U|xyval - (U|xyval * 0.08)
.copy    U|xybrgb2hsv = G|false
.copy    U|xybhsv2rgb = G|true
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbee2ft = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.continue 'xprocst.xprocsp'
!PROC003: ----- Farbe_Zeile -----
.continue EL002 ? _(M|tbaumstufe = 1)
.continue EL003 ? _(M|ytarbeitstag)
.colour -background 'U|xtfarbes' 'M|aktzeile'
.colour -background 'U|xtfarbe2' ytarbzeit    'M|aktzeile'
.colour -background 'U|xtfarbe2' ytgkzeit     'M|aktzeile'
.colour -background 'U|xtfarbe2' ytfaktzeit   'M|aktzeile'
.colour -background 'U|xtfarbe2' ytnfaktzeit  'M|aktzeile'
.colour -background 'U|xtfarbef2' ytallgarbabs   'M|aktzeile'
.colour -background 'U|xtfarbef2' ytallgabwabs   'M|aktzeile'
.colour -background 'U|xtfarbef2' ytallgabwurabs 'M|aktzeile'
.colour -background 'U|xtfarbef2' ytallgabwkrabs 'M|aktzeile'
.colour -background 'U|xtfarbef2' ytallgabwgzabs 'M|aktzeile'
.colour -background 'U|xtfarbef2' ytallgabwsaabs 'M|aktzeile'
.colour -background 'U|xtfarbee2' ytpzestd         'M|aktzeile'
.colour -background 'U|xtfarbee2' ytabwpzeprojzeit 'M|aktzeile'
.colour -background 'U|xtfarbee2' ytgzkonto        'M|aktzeile'
.continue FI003
!EL003
.colour -background 'U|xtfarbesft' 'M|aktzeile'
.colour -background 'U|xtfarbe2ft' ytarbzeit    'M|aktzeile'
.colour -background 'U|xtfarbe2ft' ytgkzeit     'M|aktzeile'
.colour -background 'U|xtfarbe2ft' ytfaktzeit   'M|aktzeile'
.colour -background 'U|xtfarbe2ft' ytnfaktzeit  'M|aktzeile'
.colour -background 'U|xtfarbef2ft' ytallgarbabs   'M|aktzeile'
.colour -background 'U|xtfarbef2ft' ytallgabwabs   'M|aktzeile'
.colour -background 'U|xtfarbef2ft' ytallgabwurabs 'M|aktzeile'
.colour -background 'U|xtfarbef2ft' ytallgabwkrabs 'M|aktzeile'
.colour -background 'U|xtfarbef2ft' ytallgabwgzabs 'M|aktzeile'
.colour -background 'U|xtfarbef2ft' ytallgabwsaabs 'M|aktzeile'
.colour -background 'U|xtfarbee2ft' ytpzestd         'M|aktzeile'
.colour -background 'U|xtfarbee2ft' ytabwpzeprojzeit 'M|aktzeile'
.colour -background 'U|xtfarbee2ft' ytgzkonto        'M|aktzeile'
!FI003
.continue FI002
!EL002
.colour -background 'U|xtfarbesdet' 'M|aktzeile'
.colour -background 'U|xtfarbe2det' ytarbzeit    'M|aktzeile'
.colour -background 'U|xtfarbe2det' ytgkzeit     'M|aktzeile'
.colour -background 'U|xtfarbe2det' ytfaktzeit   'M|aktzeile'
.colour -background 'U|xtfarbe2det' ytnfaktzeit  'M|aktzeile'
.colour -background 'U|xtfarbef2det' ytallgarbabs   'M|aktzeile'
.colour -background 'U|xtfarbef2det' ytallgabwabs   'M|aktzeile'
.colour -background 'U|xtfarbef2det' ytallgabwurabs 'M|aktzeile'
.colour -background 'U|xtfarbef2det' ytallgabwkrabs 'M|aktzeile'
.colour -background 'U|xtfarbef2det' ytallgabwgzabs 'M|aktzeile'
.colour -background 'U|xtfarbef2det' ytallgabwsaabs 'M|aktzeile'
.colour -background 'U|xtfarbee2det' ytpzestd         'M|aktzeile'
.colour -background 'U|xtfarbee2det' ytabwpzeprojzeit 'M|aktzeile'
.colour -background 'U|xtfarbee2det' ytgzkonto        'M|aktzeile'
!FI002
.continue 'xprocst.xprocsp'
!PROC004: ----- LeistungsmeldungZeile -----
.make screen line +O
.formula M|tbaumstufe = 2
.formula M|ytartarbeit = H|yaufgabe^namebspr    ? _F|empty(H|yaufgabe)
.formula M|ytartarbeit = H|ytaetschl^namebspr   ?  F|empty(H|ytaetschl)
.assign  M|ytleistmeld = H|id
.copy    M|ytprojekt   = H|yprojekt
.formula M|ytprojname  = H|yprojekt^namebspr
.copy    M|ytaufgabe   = H|yaufgabe
.copy    M|yttaetschl  = H|ytaetschl
.formula M|ytdatum          = H|yedatum
.formula M|ytarbzeit        = H|yarbzeit
.formula M|ytfaktzeit       = H|yfaktzeit
.formula M|ytnfaktzeit      = H|yarbzeit - H|yfaktzeit
.continue EL004 ? _(H|ytaetschl^ydirindik = "I")
.formula M|ytgkzeit        = H|yarbzeit
.formula M|ytallgarbabs    = H|yarbzeit     ? _H|ytaetschl^yabwesend
.formula M|ytallgabwabs    = H|yarbzeit     ?  H|ytaetschl^yabwesend
.continue EL005 ? _((H|ypersperstypk = "EM") & (H|ytaetschl^yabwesend))
.formula M|ytallgabwurabs  = H|yarbzeit     ?  H|ytaetschl^yanwesendk<<1 =  "U"
.formula M|ytallgabwkrabs  = H|yarbzeit     ?  H|ytaetschl^yanwesendk<<1 =  "K"
.formula M|ytallgabwgzabs  = H|yarbzeit     ?  H|ytaetschl^yanwesendk<<1 =  "G"
.formula M|ytallgabwsaabs  = H|yarbzeit     ?  H|ytaetschl^yanwesendk<<1 <> "U" & H|ytaetschl^yanwesendk<<1 <> "K" & H|ytaetschl^yanwesendk<<1 <> "G"
!EL005
!EL004
.continue 'xprocst.xprocsp'
!PROC005: ----- TabelleLaden -----
.copy U|xdadatum = M|ystdvondatum
.copy U|xdedatum = M|ystdbisdatum
.load 9 add M|ypersonal
.input "java:de.alltrotec.ps.control.StaffWorkDays@ALLPS"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.copy    U|xbpze = F|sysinfo(10)^ykonfigprjm^ypzebpze
.copy U|xddatum = M|ystdvondatum
!LOOP002: ==============================
.continue ELOP002 ? _(U|xddatum <= M|ystdbisdatum)
.formula U|xtdatum         = U|xddatum:8
.copy U|xbapexists         = G|false
.formula U|xrarbzeit       = 0
.formula U|xrfaktzeit      = 0
.formula U|xrnfaktzeit     = 0
.formula U|xrgkzeit        = 0
.formula U|xrtallgarbabs   = 0
.formula U|xrtallgabwabs   = 0
.formula U|xrtallgabwurabs = 0
.formula U|xrtallgabwkrabs = 0
.formula U|xrtallgabwgzabs = 0
.formula U|xrtallgabwsaabs = 0
.formula U|xrpzestd        = 0
.formula U|xrgzkonto       = 0
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" + M|ypersonal^id
.formula U|xtsel = U|xtsel + ";yedatum=="   + U|xddatum:8
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.copy U|xbapexists = G|true
.continue EL006 ? _(M|ybdetail)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC004
!RET002
.formula xprocsp = xprocsp - 1
!EL006
.formula U|xrarbzeit  = U|xrarbzeit   + H|yarbzeit
.formula U|xrfaktzeit = U|xrfaktzeit  + H|yfaktzeit
.formula U|xrnfaktzeit= U|xrnfaktzeit + H|yarbzeit - H|yfaktzeit
.continue EL007 ? _(H|ytaetschl^ydirindik = "I")
.formula U|xrgkzeit        = U|xrgkzeit        + H|yarbzeit
.formula U|xrtallgarbabs   = U|xrtallgarbabs   + H|yarbzeit      ? _H|ytaetschl^yabwesend
.formula U|xrtallgabwabs   = U|xrtallgabwabs   + H|yarbzeit      ?  H|ytaetschl^yabwesend
.continue EL008 ? _((H|ypersperstypk = "EM") & (H|ytaetschl^yabwesend))
.formula U|xrtallgabwurabs = U|xrtallgabwurabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 =  "U"
.formula U|xrtallgabwkrabs = U|xrtallgabwkrabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 =  "K"
.formula U|xrtallgabwgzabs = U|xrtallgabwgzabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 =  "G"
.formula U|xrtallgabwsaabs = U|xrtallgabwsaabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 <> "U" & H|ytaetschl^yanwesendk<<1 <> "K" & H|ytaetschl^yanwesendk<<1 <> "G"
!EL008
!EL007
.select continue
.continue LOOP003
!ELOP003: ==============================
.continue EL009 ? _(((_(M|ybnonull)) & (_(U|xbapexists))) ; (U|xbapexists))
.select screen line 'U|ximerkzeile'     ?  M|ybdetail
.make screen line +O
.formula M|tbaumstufe = 1
.formula M|ytdatum    = U|xddatum
.copy    M|ytarbeitstag = U|xbwd.U|xtdatum
.formula M|ytsollzeit   = U|xrtt.U|xtdatum
.continue EL010 ? _(U|xbapexists)
.continue EL011 ? _(U|xbpze)
.formula U|xrgzkonto = 0
.formula U|xrpzestd  = 0
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" + U|xtpersonal
.formula U|xtsel = U|xtsel + ";ydatum=="    + U|xddatum:8
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgristzeiten' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xrpzestd  = U|xrpzestd   + 9|yistzeit
.load 9 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" + U|xtpersonal
.formula U|xtsel = U|xtsel + ";ydatum=="    + U|xddatum:8
.formula U|xtsel = U|xtsel + ";ygueltig==(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@ordnung=ypersonal,yzeitstempel;@richtung=(1)"
.load 9 group 'U|xydbgrgleitzeitkto' 'U|xtsel'
.formula U|xrgzkonto = 9|ysaldo ? G|mehr
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" + U|xtpersonal
.formula U|xtsel = U|xtsel + ";yadatum=="   + U|xddatum:8
.formula U|xtsel = U|xtsel + ";yfreigabek=BEA"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrabwesenheit' 'U|xtsel'
.copy U|xbnfreiabw = G|mehr
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" + U|xtpersonal
.formula U|xtsel = U|xtsel + ";ydatum=="    + U|xddatum:8
.formula U|xtsel = U|xtsel + ";ygueltig=(Yes)"
.formula U|xtsel = U|xtsel + ";yfreigabek<>GEN"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrperszeiten' 'U|xtsel'
.copy U|xbnfreipze = G|mehr
!EL011
.formula M|tbaumstat  = "-"         ?  M|ybdetail
.formula M|tbaumstat  = "+"         ? _M|ybdetail
.formula M|ytbunfreiabw     = "icon:attention"  ? U|xbnfreiabw
.formula M|ytbunfreipze     = "icon:attention"  ? U|xbnfreipze
.formula M|ytarbzeit        = U|xrarbzeit
.formula M|ytgkzeit         = U|xrgkzeit
.formula M|ytfaktzeit       = U|xrfaktzeit
.formula M|ytnfaktzeit      = U|xrnfaktzeit
.formula M|ytallgarbabs     = U|xrtallgarbabs
.formula M|ytallgabwabs     = U|xrtallgabwabs
.formula M|ytallgabwurabs   = U|xrtallgabwurabs
.formula M|ytallgabwkrabs   = U|xrtallgabwkrabs
.formula M|ytallgabwgzabs   = U|xrtallgabwgzabs
.formula M|ytallgabwsaabs   = U|xrtallgabwsaabs
.formula M|ytpzestd         = U|xrpzestd
.formula M|ytabwpzeprojzeit =(U|xrpzestd + U|xrtallgabwabs) - U|xrarbzeit
.formula M|ytgzkonto        = U|xrgzkonto
!EL010
.formula U|ximerkzeile = M|tzeilen
.select screen line 'M|tzeilen'
!EL009
.formula U|xddatum = U|xddatum + 1
.continue LOOP002
!ELOP002: ==============================
.select screen header
.select screen line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
.select screen line
.continue LOOP005
!ELOP005: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.formula M|ystdvondatum = 'G|datum:8'<<6 + "01"
.formula M|ystdvondatum =  M|ystdvondatum - 1
.formula M|ystdvondatum = 'M|ystdvondatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdvondatum + 31
.formula M|ystdbisdatum = 'M|ystdbisdatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdbisdatum - 1
.copy    M|ybnonull     = G|true
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "ypersonal")
.input 'U|xtupprjmsel'
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "ystdvondatum")
.continue EL012 ? _(F|empty(M|ystdvondatum))
.assign M|ystdbisdatum = ""
.continue FI012
!EL012
.formula M|ystdvondatum = 'M|ystdvondatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdvondatum + 31
.formula M|ystdbisdatum = 'M|ystdbisdatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdbisdatum - 1
!FI012
.continue ESAC002
!BRK004
.input 'U|xtupprjmsel'
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "buttonvor")
.continue EL013 ? _(F|empty(M|ypersonal))
.set TRANS +
.box Hinweis
Bitte zuerst das Personal wÑhlen.
.set TRANS -
.error
.end 1
.continue FI013
!EL013
.continue EL014 ? _((F|empty(M|ystdvondatum)) & (F|empty(M|ystdbisdatum)))
.set TRANS +
.box Hinweis
Bitte zuerst einen Zeitraum wÑhlen.
.set TRANS -
.error
.end 1
.continue FI014
!EL014
.continue BRK006 ? _(G|evtvar = "bstart")
.make screen line --
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ybufreigabe")
.set trans +
.formula U|xtsel = "Achtung"
.box -button yes:no -title 'U|xtsel'
Nach der Freigabe sind fÅr das Personal keine Stundenbuchungen
im betreffenden Zeitraum mehr mîglich.

Wirklich freigeben?
.set trans -
.continue EL015 ? _(_(G|box = G|boxyes))
.error
.end 1
!EL015
.continue ESAC003
!BRK007
!ESAC003: =====   ENDCASE   =====
!FI014
!FI013
.continue ESAC001
!BRK005
.continue BRK008 ? _(G|evtart = "buttonnach")
.continue BRK009 ? _(G|evtvar = "bstart")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC005
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK009
.continue BRK010 ? _(G|evtvar = "ybufreigabe")
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'F|month(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";ypersonal==" +  M|ypersonal^id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select lock group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL016 ? _(G|mehr)
.continue EL017 ? _(H|ybgesabschluss)
.set TRANS +
.box Hinweis
Der Stundenzettel ist bereits fÅr Lohn/Abrechnung freigegeben.
.set TRANS -
.continue FI017
!EL017
.copy H|ybgesabschluss = G|true
.rewrite
!FI017
.continue FI016
!EL016
.set TRANS +
.box Hinweis
Kein Stundenzettel im betreffenden Zeitraum fÅr das Personal gefunden.
.set TRANS -
!FI016
.continue ESAC004
!BRK010
.continue BRK011 ? _(G|evtvar = "ybualleauf")
.make screen line --
.copy M|ybdetail = G|true
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC005
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK011
.continue BRK012 ? _(G|evtvar = "ybuallezu")
.make screen line --
.copy M|ybdetail = G|false
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC005
!RET006
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK012
.continue BRK013 ? _(G|evtvar = "tbaumaufzu")
.continue EL018 ? _(M|tbaumstufe = 1)
.continue BRK014 ? _(M|tbaumstat = "+")
.formula M|tbaumstat = "-"
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" +  M|ypersonal^id
.formula U|xtsel = U|xtsel + ";yedatum=="   + 'M|ytdatum'
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@ordnung=ypersonal,yedatum"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC004
!RET007
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP006
!ELOP006: ==============================
.continue ESAC005
!BRK014
.continue BRK015 ? _(M|tbaumstat = "-")
.formula M|tbaumstat = "+"
.select screen line
.continue EL019 ? _(G|mehr)
!LOOP007: ==============================
.continue ELOP007 ? _(M|tbaumstufe = 2)
.make screen line -O
.continue LOOP007
!ELOP007: ==============================
!EL019
.continue ESAC005
!BRK015
!ESAC005: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC002
!RET008
.formula xprocsp = xprocsp - 1
.select screen header
.select screen line
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC003
!RET009
.formula xprocsp = xprocsp - 1
.select screen line
.continue LOOP008
!ELOP008: ==============================
!EL018
.continue ESAC004
!BRK013
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK008
