..!interpreter english declaration noabbrev
.. at 2016-09-21, 08:50
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.PROJLEISTKAT.FF
..==  Pfad              : allpstd
..==  Funktion          : Projektleistungsartikel in Maske eintragen
..==  Erstellungsdatum  : 29.03.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbgrprojleistkat)
..====================================================
.type text    xtsys     ? _F|defined(U|xtsys)
.type text    xtsel     ? _F|defined(U|xtsel)
.type text    xtid      ? _F|defined(U|xtid)
.type text    xtart     ? _F|defined(U|xtart)
.type bool    xbkat     ? _F|defined(U|xbkat)
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- ArtikelTeilestamm -----
.continue EL001 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|regmatch(G|evtfeldneu, "\*.*"))) & (_(F|regmatch(G|evtfeldneu, "\$.*"))) & (_(F|regmatch(G|evtfeldneu, "\%.*"))))
.formula G|evtfeldneu = "?"     ? G|evtfeldneu = "!"
.continue EL002 ? _((F|regmatch(G|evtfeldneu, "\?")) ; (F|regmatch(G|evtfeldneu, "!,.*")) ; (F|regmatch(G|evtfeldneu, "\d.*")) ; (F|regmatch(G|evtfeldneu, "[a-zA-Z].*")))
.formula U|xtsel = "$,,.yprjmprkatart="
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==PQ"             ? G|evtvar = "yvkartikel"
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==ML"             ? G|evtvar = "ymaschvkart"
.formula U|xtsel = U|xtsel + ";grbez=;@noswd=" + G|evtfeldneu
.load 1 part 'U|xtsel'
.continue EL003 ? _(G|mehr)
.formula U|xtid = 1|id
.load 1 continue
.continue EL004 ? _(G|mehr)
.formula U|xtsel = "%,,.yprjmprkatart="
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==PQ"             ? G|evtvar = "yvkartikel"
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==ML"             ? G|evtvar = "ymaschvkart"
.formula U|xtsel = U|xtsel + ";grbez=;@noswd=" + G|evtfeldneu + ";@autostart=(Yes)"
.load 1 part 'U|xtsel'
.continue EL005 ? _(G|mehr)
.formula U|xtid = 1|id
.continue EL006 ? _(1|gruppe = 4)
.continue EL007 ? _(_('1|zptyp(L=":")' = "(SOPOItemPOS)"))
.set TRANS +
.box Fehler
Es dÅrfen nur Artikel, Dienstleistungen und Zusatzpositionen vom Typ AU/BE Position eingetragen werden.
.set TRANS -
.formula U|xtid = M|.evtvar^id
!EL007
!EL006
.continue FI005
!EL005
.formula U|xtid = M|.evtvar^id
!FI005
.continue FI004
!EL004
.load 1 part 'U|xtid'
.continue EL008 ? _(G|mehr)
.continue EL009 ? _(1|gruppe = 4)
.continue EL010 ? _(_('1|zptyp(L=":")' = "(SOPOItemPOS)"))
.set TRANS +
.box Fehler
Es dÅrfen nur Artikel, Dienstleistungen und Zusatzpositionen vom Typ AU/BE Position eingetragen werden.
.set TRANS -
.formula U|xtid = M|.evtvar^id
!EL010
!EL009
.continue FI008
!EL008
.formula U|xtid = M|.evtvar^id
!FI008
!FI004
.continue FI003
!EL003
.continue EL011 ? _((G|evtfeldneu = "!") ; (G|evtfeldneu = "?"))
.set TRANS +
.box Hinweis
Keine Leistung zum Projekt 'M|yprojekt' gefunden.
.set TRANS -
.formula U|xtid = ""
.continue FI011
!EL011
.formula U|xtsel = "$,,@noswd=" + G|evtfeldneu
.load 1 part 'U|xtsel'
.continue EL012 ? _(G|mehr)
.set TRANS +
.box
'G|evtfeldneu': ist kein Projektleitsungsartikel.
.set TRANS -
.continue FI012
!EL012
.set TRANS +
.box
'G|evtfeldneu': nicht gefunden
.set TRANS -
!FI012
.error
.end 1
!FI011
!FI003
!EL002
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL013 ? _((G|evtkommd <> G|kaktname12) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|empty(G|evtfeldneu))))
.formula U|xtid  = G|evtfeldneu
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ybleistkat)
.copy U|xbkat = G|FALSE
.continue EL014 ? _(5|ybleistkat)
.continue EL015 ? _((_(F|empty(M|yprojekt^yprojleistkatid))) & (_(M|yprojekt^yprojleistkatid = "(0,0,0)")))
.load 0 group 'U|xydbgrprojleistkat' 'M|yprojekt^yprojleistkatid'
.copy U|xbkat = G|mehr
.continue FI015
!EL015
.continue EL016 ? _((_(F|empty(M|yprojekt^yteilprojektzu^yprojleistkatid))) & (_(M|yprojekt^yteilprojektzu^yprojleistkatid = "(0,0,0)")))
.load 0 group 'U|xydbgrprojleistkat' 'M|yprojekt^yteilprojektzu^yprojleistkatid'
.copy U|xbkat = G|mehr
!EL016
!FI015
.continue EL017 ? _(_(U|xbkat))
.formula U|xtsel = "$,,yprojekt==" + M|yprojekt^id                      ?  F|empty(M|yprojekt^yteilprojektzu)
.formula U|xtsel = "$,,yprojekt==" + M|yprojekt^yteilprojektzu^id       ? _F|empty(M|yprojekt^yteilprojektzu)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrprojleistkat' 'U|xtsel'
.copy U|xbkat = G|mehr
!EL017
!EL014
.continue EL018 ? _(U|xbkat)
.continue EL019 ? _((_(G|evtfeldneu = "!")) & (_(G|evtfeldneu = "?")))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.formula U|xtart = U|xtid
.formula U|xtid  = ""
!EL019
.formula U|xtsel = "$,.id=" + 0|id
.formula U|xtsel = U|xtsel + ";yteil=" + U|xtart
.formula U|xtsel = U|xtsel + ";yteilname=;.yteil^yprjmprkatart="
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==PQ"     ? G|evtvar = "yvkartikel"
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==ML"     ? G|evtvar = "ymaschvkart"
.formula U|xtsel = U|xtsel + ";@rows=(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group 'U|xydbgrprojleistkat' 'U|xtsel'
.continue EL020 ? _(G|mehr)
.load 1 line '1|selzeile'
.formula U|xtid = 1|yteil^id
.load 1 continue
.continue EL021 ? _(G|mehr)
.formula U|xtsel = "%,,
.formula U|xtsel = U|xtsel + ";.yprjmprkatart="
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==PQ"     ? G|evtvar = "yvkartikel"
.formula U|xtsel = U|xtsel + ";.yprjmprkatartk==ML"     ? G|evtvar = "ymaschvkart"
.formula U|xtsel = U|xtsel + ";.yteil="
.formula U|xtsel = U|xtsel + ";yteilname="
.formula U|xtsel = U|xtsel + ";.nummer=" + 0|nummer
.formula U|xtsel = U|xtsel + ";.@rows=(Yes)"
.formula U|xtsel = U|xtsel + ";.@filingmode=(Active)"
.formula U|xtsel = U|xtsel + ";@autostart=(Yes)"
.load 1 group 'U|xydbgrprojleistkat' 'U|xtsel'
.load 1 line '1|selzeile'                               ?  G|mehr
.formula U|xtid = M|.evtvar^id                          ? _G|mehr
.formula U|xtid = 1|yteil^id                            ?  G|mehr
!EL021
.continue FI020
!EL020
.continue EL022 ? _((G|evtfeldneu = "!") ; (G|evtfeldneu = "?"))
.set TRANS +
.box Hinweis
Keine Leistung im Projektleistungskatalog '0|nummer' gefunden.
.set TRANS -
.formula U|xtid = ""
.continue FI022
!EL022
.set TRANS +
.box
'G|evtfeldneu': ist nicht im Projektleistungskatalog '0|nummer' enthalten.
.set TRANS -
.error
.end 1
!FI022
!FI020
.formula G|evtfeldneu = U|xtid
.continue FI018
!EL018
.continue EL023 ? _((5|ybleistkat) & (M|yprojekt^yprojekttyp^yprkaterf))
.set TRANS +
.box Fehler
Zum Projekt existiert kein Projektleistungskatalog.
.set TRANS -
.error
.end 1
.continue FI023
!EL023
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.formula G|evtfeldneu = U|xtid
!FI023
!FI018
!EL013
.continue
