#!group=1
#!dontchange=xxxxxx
.continue BRK010 ? _(U|xbneu = G|TRUE)
such;name;artpg;klpg;typ;gltvon;gltbis;mgeab;mpe\
mgrenze;mpreis
?'M|yprojleistkat^such';'M|yprojleistkat^namebspr';'U|xtartpg';'M|yprg';(49);'M|ytgltvon:8';'M|ytgltbis:8';1;'M|ytmpe(L="0")'\  ? _F|empty(M|ytmpe)
?'M|yprojleistkat^such';'M|yprojleistkat^namebspr';'U|xtartpg';'M|yprg';(49);'M|ytgltvon:8';'M|ytgltbis:8';1;'U|xtpe'\          ?  F|empty(M|ytmpe)
'M|ytmgrenze(L="0")';'M|ytmpreis(L="0")'\
.continue ESAC004
!BRK010
.continue BRK011 ? _(U|xbneu = G|FALSE)
id;gltvon;gltbis;mgeab;mpe\
zeilenop;mgrenze;mpreis
?'M|ytpreis^id';'M|ytgltvon:8';'M|ytgltbis:8';1;'M|ytmpe(L="0")'\   ? _F|empty(M|ytmpe)
?'M|ytpreis^id';'M|ytgltvon:8';'M|ytgltbis:8';1;'U|xtpe'\           ?  F|empty(M|ytmpe)
?-*;xxxxxx;xxxxxx\                                                  ? _U|xbneu & M|tbaumstat = "-"
?+;'M|ytmgrenze(L="0")';'M|ytmpreis(L="0")'\                        ? _U|xbneu & M|tbaumstat = "-"
?1;'M|ytmgrenze(L="0")';'M|ytmpreis(L="0")'\                        ? _U|xbneu & M|tbaumstat = "+"
.continue ESAC004
