.assign M|ybspeichern = G|TRUE         ?  G|evtvar <> "ybspeichern"
!EL114
.continue ESAC006
!BRK047
.continue BRK057 ? _(G|evtart = "zeileeinvor")
.continue EL115 ? _(M|ybnurzeigen)
.error
.end 1
!EL115
