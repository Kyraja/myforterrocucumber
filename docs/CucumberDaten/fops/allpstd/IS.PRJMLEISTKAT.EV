..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtbox xtedpdat xtedpout xtedperr xtedpmsg xtdatei xtprojleistkatid
.type text    xtid xtindex xtnummer xtartpg xtklpg xtart xtpg xtpe xtteil xtfarbe0 xtfarbe1 xtfarbe2 xtfarbe3 xt1
.type integer xivzeile xinzeile xivstufe xinstufe xidatei
.type bool    xbmehr xbok xbart xbpreis xbstaffel xbneu xybmeldung xbkd xbpr xbra xbrv
.type GD      xdgltvon xdgltbis
.type P3:2    xpaupos
.type TAZ1    xpmpe
.type AZK28032 xyprgtyp
.'F|expr("type P" + U|xydbgrprojekt + " xpprojekt")
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Farbe_setzen -----
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.colour -BACKGROUND 'xtfarbe.tbaumstufe' 'M|aktzeile'
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Schutz_Artikel -----
.protection ytart     'M|aktzeile'      ? _F|empty(M|ytart)
.protection ytgltvon  'M|aktzeile'
.protection ytgltbis  'M|aktzeile'
.protection ytmgeab   'M|aktzeile'
.protection ytmgrenze 'M|aktzeile'
.protection ytmpreis  'M|aktzeile'
.protection ytmpe     'M|aktzeile'
.protection -LINE     'M|aktzeile'      ?  M|ybnurzeigen
.continue 'xprocst.xprocsp'
!PROC003: ----- Schutz_Preis_Kopf -----
.protection ytart     'M|aktzeile'
.protection -LINE     'M|aktzeile'      ?  M|ybnurzeigen
.continue 'xprocst.xprocsp'
!PROC004: ----- Schutz_Preis_Zeile -----
.protection ytart     'M|aktzeile'
.protection ytgltvon  'M|aktzeile'
.protection ytgltbis  'M|aktzeile'
.protection ytmgeab   'M|aktzeile'
.protection -LINE     'M|aktzeile'      ?  M|ybnurzeigen
.continue 'xprocst.xprocsp'
!PROC005: ----- ArtikelPruefen -----
.copy U|xbok = G|TRUE
.continue EL001 ? _(9|gruppe = 4)
.copy U|xbok = G|FALSE  ? _'9|zptyp(L=":")' = "(SOPOItemPOS)"
!EL001
.continue EL002 ? _(U|xbok)
.copy U|xbok = G|FALSE  ? F|empty(9|yprjmprkatart)
!EL002
.continue EL003 ? _(U|xbok)
.assign U|xyprgtyp   = "KD"             ?  M|yprg<<1 / "(09)"
.assign U|xyprgtyp   = M|yprg<<2        ? _M|yprg<<1 / "(09)"
.continue BRK001 ? _(U|xyprgtyp = "KD")
.copy U|xbok = G|FALSE  ? _9|yprjmbgltkd
.continue ESAC001
!BRK001
.continue BRK002 ? _(U|xyprgtyp = "PR")
.copy U|xbok = G|FALSE  ? _9|yprjmbgltpr
.continue ESAC001
!BRK002
.continue BRK003 ? _(U|xyprgtyp = "RA")
.copy U|xbok = G|FALSE  ? _9|yprjmbgltra
.continue ESAC001
!BRK003
.continue BRK004 ? _(U|xyprgtyp = "RV")
.copy U|xbok = G|FALSE  ? _9|yprjmbgltrv
.continue ESAC001
!BRK004
!ESAC001: =====   ENDCASE   =====
!EL003
.continue 'xprocst.xprocsp'
!PROC006: ----- Preis_ueber_Preisfindung -----
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpakl)
.assign U|xpakl      = ""
.assign U|xpaklprg   = M|yprg
.assign U|xpaev      = "(86)"
.assign U|xpaartikel = M|ytart^id
.assign U|xpamge     = 1.0
.assign U|xpakonddat = G|datum
.input 'U|xtupartpreis'
.assign M|ytmpreis   = U|xpapreis
.assign M|ytmpe      = U|xpape
.continue 'xprocst.xprocsp'
!PROC007: ----- Preise_zum_Artikel -----
.formula U|xtsel = "$,,typ==(49);artpg==" + U|xtartpg + ";klpg==" + U|xtklpg + ";@filingmode=(Active);@group=1"
.load 0 group "82:1" 'U|xtsel'
.continue EL004 ? _(G|mehr)
!REPT001: ==============================
.make screen line +O
.formula M|ytbuzeilerein   = "icon:plus"
.formula M|ytbupreisrein   = "icon:plus"
.formula M|ytbuzeileraus   = "icon:minus"
.formula M|tbaumstufe = 1
.assign  M|ytpreis   = 0|id             ? U|xtklpg = M|yprg
.formula M|ytgltvon  = 0|gltvon
.formula M|ytgltbis  = 0|gltbis
.formula M|ytmgeab   = 0|mgeab
.copy    M|ytmpe     = 0|mpe
.copy    M|ybspeichern = G|TRUE         ? G|evtvar = "ybuladepreise"
.formula M|ytbaumaufzu = "icon:folder_opened"
.formula M|tbaumstat   = "-"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC003
!RET001
.formula xprocsp = xprocsp - 1
.load 0 line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL005 ? _(0|aktzeile > 1)
.make screen line +O
.formula M|ytbuzeilerein   = "icon:plus"
.formula M|ytbupreisrein   = "icon:plus"
.formula M|ytbuzeileraus   = "icon:minus"
.formula M|tbaumstufe = 2
.copy    M|ybspeichern = G|TRUE     ? G|evtvar = "ybuladepreise"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC004
!RET002
.formula xprocsp = xprocsp - 1
!EL005
.assign  M|ytpreis   = 0|id     ? U|xtklpg = M|yprg
.formula M|ytmgrenze = 0|mgrenze
.formula M|ytmpreis  = 0|mpreis
.copy    M|ytmpe     = 0|mpe
.load 0 line
.continue LOOP002
!ELOP002: ==============================
.load 0 continue
.continue REPT001 ? _(_(G|mehr))
!EL004
.continue 'xprocst.xprocsp'
!PROC008: ----- Tabelle_laden -----
.select add M|yprojleistkat
.continue EL006 ? _(G|mehr)
.select line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.make screen line +O
.formula M|ytbuzeilerein   = "icon:plus"
.formula M|ytbupreisrein   = "icon:plus"
.formula M|ytbuzeileraus   = "icon:minus"
.formula M|tbaumstufe      = 0
.assign  M|ytart           = H|yteil^id
.assign  M|ytprjmprkatartk = H|yprjmprkatartk
.copy    M|ytmpe           = H|ype
.copy    M|ytmpe           = H|yteil^vpe    ? F|empty(H|ype)
.formula U|xtartpg = M|ytart^vprg
.formula U|xtklpg  = M|yprg
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC006
!RET004
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC007
!RET005
.formula xprocsp = xprocsp - 1
.select line
.continue LOOP003
!ELOP003: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC001
!RET006
.formula xprocsp = xprocsp - 1
!EL006
.continue 'xprocst.xprocsp'
!PROC009: ----- Zeile_rein -----
.continue EL007 ? _(_(M|ybnurzeigen))
.formula U|xivzeile = M|aktzeile
.formula U|xinzeile = M|aktzeile + 1
.formula U|xivstufe = M|tbaumstufe
.formula U|xtid     = M|ytpreis^id
.select screen line 'U|xinzeile'        ? U|xinzeile <= M|tzeilen
.formula U|xinstufe = M|tbaumstufe      ? U|xinzeile <= M|tzeilen
.select screen line 'G|evtzeile'
.assign U|xbart     = G|TRUE    ?                    U|xinstufe = 0
.assign U|xbpreis   = G|TRUE    ? M|tbaumstufe = 0
.assign U|xbpreis   = G|TRUE    ? M|tbaumstufe = 1 & U|xinstufe = 0
.assign U|xbpreis   = G|TRUE    ? M|tbaumstufe = 1 & U|xinstufe = 1
.assign U|xbstaffel = G|TRUE    ? M|tbaumstufe = 1
.assign U|xbstaffel = G|TRUE    ? M|tbaumstufe = 2
.assign U|xbstaffel = G|FALSE
.assign U|xbpreis   = G|FALSE   ? M|yprg<<2 = "RA"
.formula U|xtpe     = 'M|ytmpe(L="0")'
.continue EL008 ? _((G|evtvar = "ytbuzeilerein") & (_(U|xbart)))
.set TRANS +
.box Hinweis
An dieser Position kann keine Leistungsposition eingefÅgt werden.
.set TRANS -
.error          ? G|menue = 0
.end 1          ? G|menue = 0
!EL008
.continue EL009 ? _((G|evtvar = "ytbupreisrein") & (_(U|xbpreis)))
.set TRANS +
.box Hinweis
An dieser Position kann kein Preis eingefÅgt werden.
.set TRANS -
.error          ? G|menue = 0
.end 1          ? G|menue = 0
!EL009
.formula U|xivstufe = "0"       ? G|evtvar = "ytbuzeilerein"
.formula U|xivstufe = "1"       ? G|evtvar = "ytbupreisrein"
.make screen line +O
.formula M|tbaumstufe = U|xivstufe
.assign  M|ytmpe      = U|xtpe
.continue BRK005 ? _(M|tbaumstufe = 0)
.formula M|ytbuzeilerein   = "icon:plus"
.formula M|ytbupreisrein   = "icon:plus"
.formula M|ytbuzeileraus   = "icon:minus"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK005
.continue BRK006 ? _(M|tbaumstufe = 1)
.formula M|ytbaumaufzu   = "icon:folder_opened"
.formula M|ytbuzeilerein = "icon:plus"
.formula M|ytbupreisrein = "icon:plus"
.formula M|ytbuzeileraus = "icon:minus"
.assign  M|ytmgeab       = G|TRUE
.formula M|tbaumstat     = "-"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC003
!RET008
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK006
.continue BRK007 ? _(M|tbaumstufe = 2)
.formula M|ytbuzeilerein   = "icon:plus"
.formula M|ytbupreisrein   = "icon:plus"
.formula M|ytbuzeileraus   = "icon:minus"
.formula M|ytpreis         = U|xtid
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC004
!RET009
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK007
!ESAC002: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET010" 
.continue PROC001
!RET010
.formula xprocsp = xprocsp - 1
!EL007
.continue 'xprocst.xprocsp'
!PROC010: ----- Fehlermenue -----
!REPT002: ==============================
.set TRANS +
.menu(0,0,2) Fehler beim Speichern der Preise
EDP Datei anzeigen      >>.edit -READONLY 'U|xtedpdat'
?Ausgabedatei anzeigen  >>.edit -READONLY 'U|xtedpout'  ?  F|filenotempty(U|xtedpout)
?Fehlerdatei anzeigen   >>.edit -READONLY 'U|xtedperr'  ?  F|filenotempty(U|xtedperr)
?Hinweisdatei anzeigen  >>.edit -READONLY 'U|xtedpmsg'  ?  F|filenotempty(U|xtedpmsg)
.set TRANS -
.continue REPT002 ? _(G|menue = 0)
.error
.end 1
.continue 'xprocst.xprocsp'
!PROC011: ----- Zeile_loeschen -----
.continue BRK008 ? _(M|tbaumstufe = 0)
.continue EL010 ? _(G|evtzeile <> M|tzeilen)
.formula U|xtartpg = M|ytart
.select screen line
.continue EL011 ? _(M|tbaumstufe > 0)
.set TRANS +
.menu Hinweis
Die Preise zum Artikel 'U|xtartpg' werden endgÅltig gelîscht.
.set TRANS -
.continue EL012 ? _(G|menue <> 0)
.file -TEMPNAME U|xtedpdat
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedperr
.file -TEMPNAME U|xtedpmsg
.output NEW 'U|xtedpdat'
.input DATEI.F
!LOOP004: ==============================
.continue ELOP004 ? _((M|tbaumstufe > 0) & (M|aktzeile > G|evtzeile))
.continue EL013 ? _((M|tbaumstufe = 1) & (_(F|empty(M|ytpreis))))
#!EDP_LANGCODE='G|bsprache'
#!action=delete
#!database=82
#!group=1
#!dontchange=xxxxxx

id;
'M|ytpreis^id';
.output NEW WERF.WEG
.formula U|xtsys = "edpimport.sh -c EKS -o UPDATEMODE=STRICT -T -r REF -p " + G|einmalpw
.formula U|xtsys = U|xtsys + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'U|xtsys' BACKGROUND
.continue EL014 ? _(G|mehr)
.continue EL015 ? _(F|filenotempty(U|xtedperr))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET011" 
.continue PROC010
!RET011
.formula xprocsp = xprocsp - 1
!EL015
.continue FI014
!EL014
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET012" 
.continue PROC010
!RET012
.formula xprocsp = xprocsp - 1
!FI014
!EL013
.make screen line -O
.continue LOOP004
!ELOP004: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET013" 
.continue PROC001
!RET013
.formula xprocsp = xprocsp - 1
.continue FI012
!EL012
.error
.end 1
!FI012
!EL011
!EL010
.select screen line 'G|evtzeile'
.make screen line -     ? G|evtvar = "ytbuzeileraus"
.continue ESAC003
!BRK008
.continue BRK009 ? _(M|tbaumstufe = 1)
.continue EL016 ? _(_(F|empty(M|ytpreis)))
.set TRANS +
.menu Hinweis
Die Preise werden endgÅltig gelîscht.
.set TRANS -
!EL016
.continue EL017 ? _((G|menue <> 0) ; (F|empty(M|ytpreis)))
.continue EL018 ? _(_(F|empty(M|ytpreis)))
.file -TEMPNAME U|xtedpdat
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedperr
.file -TEMPNAME U|xtedpmsg
.output NEW 'U|xtedpdat'
.input DATEI.F
#!EDP_LANGCODE='G|bsprache'
#!action=delete
#!database=82
#!group=1
#!dontchange=xxxxxx

id;
'M|ytpreis^id';
.output NEW WERF.WEG
.formula U|xtsys = "edpimport.sh -c EKS -o UPDATEMODE=STRICT -T -r REF -p " + G|einmalpw
.formula U|xtsys = U|xtsys + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'U|xtsys' BACKGROUND
.continue EL019 ? _(G|mehr)
.continue EL020 ? _(F|filenotempty(U|xtedperr))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET014" 
.continue PROC010
!RET014
.formula xprocsp = xprocsp - 1
!EL020
.continue FI019
!EL019
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET015" 
.continue PROC010
!RET015
.formula xprocsp = xprocsp - 1
!FI019
!EL018
.select screen line 'G|evtzeile'
.make screen line -O    ? G|evtvar = "ytbuzeileraus"
!LOOP005: ==============================
.continue ELOP005 ? _((M|tbaumstufe > 1) & (M|aktzeile > G|evtzeile))
.make screen line -O
.continue LOOP005
!ELOP005: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET016" 
.continue PROC001
!RET016
.formula xprocsp = xprocsp - 1
.assign M|ybspeichern = G|TRUE
.continue FI017
!EL017
.error
.end 1
!FI017
.continue ESAC003
!BRK009
!ESAC003: =====   ENDCASE   =====
.continue 'xprocst.xprocsp'
!PROC012: ----- Speichern -----
.file -TEMPNAME U|xtedpdat
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedperr
.file -TEMPNAME U|xtedpmsg
.output NEW 'U|xtedpdat'
.input DATEI.F
.assign U|xbmehr = G|FALSE
.select screen header
.select screen line
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.continue EL021 ? _(M|tbaumstufe = 0)
.formula U|xtartpg  = M|ytart^vprg
.formula U|xtpe     ='M|ytmpe(L="0")'
.formula U|xtpe     = "xxxxxx"      ? F|empty(M|ytmpe)
.formula U|xtnummer = M|ytart^nummer
!EL021
.continue EL022 ? _(M|tbaumstufe < 2)
?xxxxxx;xxxxxx              ? U|xbmehr &  U|xbneu
?xxxxxx;xxxxxx;xxxxxx       ? U|xbmehr & _U|xbneu
.assign U|xbmehr G|FALSE
!EL022
.continue EL023 ? _(M|tbaumstufe = 1)
.formula U|xtindex = "z" + 'M|aktzeile'
.type GD xdv.xtnummer.xtindex           ? _F|defined(U|xdv.xtnummer.xtindex)
.type GD xdb.xtnummer.xtindex           ? _F|defined(U|xdb.xtnummer.xtindex)
.assign U|xdv.xtnummer.xtindex = M|ytgltvon
.assign U|xdb.xtnummer.xtindex = M|ytgltbis
.formula U|xt1 = ""
.formula U|xt1 = F|nextelem(U|xdv.xtnummer, xt1)
!LOOP007: ==============================
.continue ELOP007 ? _(_(F|empty(U|xt1)))
.continue EL024 ? _((U|xt1 <> U|xtindex) & ((M|ytgltvon <= U|xdb.xtnummer.xt1) ; (F|empty(U|xdb.xtnummer.xt1))) & ((M|ytgltbis >= U|xdv.xtnummer.xt1) ; (F|empty(U|xdv.xtnummer.xt1))))
.set TRANS +
.box Hinweis            ? G|evtart =  "maskabbr"
.menu Hinweis           ? G|evtart <>  "maskabbr"
Es gibt öberlappungen bei dem GÅltigkeitsdatum
in Zeile 'M|aktzeile'
?Bitte korrigieren.     ? G|evtart <>  "maskabbr"
.set TRANS -
.continue EL025 ? _((G|evtart <>  "maskabbr") & (G|menue = 0))
.error
.end 1
!EL025
!EL024
.formula U|xt1 = F|nextelem(U|xdv.xtnummer, xt1)
.continue LOOP007
!ELOP007: ==============================
.assign U|xbmehr = G|TRUE
.assign U|xbneu  = F|empty(M|ytpreis)
#!EDP_LANGCODE='G|bsprache'
?#!action=new                                   ?  U|xbneu
?#!action=update                                ? _U|xbneu
