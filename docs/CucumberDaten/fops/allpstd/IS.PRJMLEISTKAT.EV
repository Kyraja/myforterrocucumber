!BRK057
.continue BRK058 ? _(G|evtart = "zeileeinnach")
.continue EL116 ? _((G|evtzeile > 1) & (G|evtzeile < M|tzeilen))
.formula U|xivzeile = M|aktzeile - 1
.formula U|xinzeile = M|aktzeile + 1
.select screen line 'U|xivzeile'
.formula U|xivstufe = M|tbaumstufe
.formula U|xtid     = M|ytpreis^id
.select screen line 'U|xinzeile'
.formula U|xinstufe = M|tbaumstufe
.select screen line 'G|evtzeile'
.continue EL117 ? _((U|xivstufe <> 0) ; (U|xinstufe <> 0))
.continue EL118 ? _((U|xivstufe = 0) & (U|xinstufe = 1))
.formula M|tbaumstufe  = 1
.formula M|ytbaumaufzu = "icon:folder_opened"
.formula M|tbaumstat   = "-"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET064" 
.continue PROC003
!RET064
.formula xprocsp = xprocsp - 1
!EL118
