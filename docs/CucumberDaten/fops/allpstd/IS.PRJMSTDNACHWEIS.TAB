..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMSTDNACHWEIS.TAB
..==  Pfad              : allpstd
..==  Funktion          :
..==  Erstellungsdatum  : 08.04.2011
..==  Autor             : A.Otto, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2015 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type integer xnum1         ? _F|defined(U|xnum1)
.type integer xnum2         ? _F|defined(U|xnum2)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Leistungsmeldungen -----
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xnum1 = 0|nummer
.formula U|xnum2 = 0|ystornolm^nummer    ? _F|empty(0|ystornolm)
.formula U|xnum2 = 0                     ?  F|empty(0|ystornolm)
.continue EL001 ? _(((F|empty(M|yvkvorgang)) ; ((_(F|empty(M|yvkvorgang))) & ((0|ymzlsnum    = M|yvkvorgang^nummer) ; (0|ymzrenum    = M|yvkvorgang^nummer)))) & ((F|empty(M|yvkpos)) ; ((_(F|empty(M|yvkpos))) & ((0|ylsposid   = M|yvkpos^id ) ; (0|yreposid   = M|yvkpos^id )))) & ((F|empty(M|yvkartikel)) ; ((_(F|empty(M|yvkartikel))) & (0|ymaschvkart = M|yvkartikel^id ))) & (_(0|ymaschzeit = 0)) & ((U|xnum2 = 0) ; ((U|xnum2 <> 0) & (_(F|defined(U|xbstorno.xnum2))))) & (_(F|defined(U|xbstorno.xnum1))))
.formula U|xtvkpos = ""
.formula U|xtvknum = ""
.formula U|xtvkpos = 0|ymzreposid       ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 0|ymzrenum         ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvkpos = 0|ymzlsposid       ? _M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 0|ymzlsnum         ? _M|yvkvorgang^typ = G|REKO
'0|ymaschvkart^id'#'0|ypvorgang^id'#'0|ypersonal^id'#'0|ymzpreis'#'0|ymaschzeit'#'0|ymzwert'#'0|ypvorgang^yklassifizierung^id'#'U|xtvkpos'#'0|ypvorgang^yarbpaket^id'#'0|id'#'0|ymaschvkart^namebspr'#'0|ypersonal^such'#'0|yedatum:8'#MZ#'0|ymaschvkart^such'#'0|ypvorgang^yklassifizierung^such'#'0|ypvorgang^yarbpaket^such'#'U|xtvknum'#
!EL001
.continue EL002 ? _(((F|empty(M|yvkvorgang)) ; ((_(F|empty(M|yvkvorgang))) & ((0|ylsnum    = M|yvkvorgang^nummer) ; (0|yrenum    = M|yvkvorgang^nummer)))) & ((F|empty(M|yvkpos)) ; ((_(F|empty(M|yvkpos))) & ((0|ylsposid   = M|yvkpos^id ) ; (0|yreposid   = M|yvkpos^id )))) & ((F|empty(M|yvkartikel)) ; ((_(F|empty(M|yvkartikel))) & (0|yvkartikel = M|yvkartikel^id ))) & ((U|xnum2 = 0) ; ((U|xnum2 <> 0) & (_(F|defined(U|xbstorno.xnum2))))) & (_(F|defined(U|xbstorno.xnum1))))
.formula U|xtvkpos = ""
.formula U|xtvknum = ""
.formula U|xtvkpos = 0|yreposid         ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 0|yrenum           ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvkpos = 0|ylsposid         ? _M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 0|ylsnum           ? _M|yvkvorgang^typ = G|REKO
'0|yvkartikel^id'#'0|ypvorgang^id'#'0|ypersonal^id'#'0|ylmpreis'#'0|yfaktzeit'#'0|ylmwert'#'0|ypvorgang^yklassifizierung^id'#'U|xtvkpos'#'0|ypvorgang^yarbpaket^id'#'0|id'#'0|yvkartikel^namebspr'#'0|ypersonal^such'#'0|yedatum:8'##'0|yvkartikel^such'#'0|ypvorgang^yklassifizierung^such'#'0|ypvorgang^yarbpaket^such'#'U|xtvknum'#
.load 3 group 'U|xydbgrmatmeldung' 'F|expr("$,,yleistmeld == " + 0|id)'
!LOOP002: ==============================
.continue ELOP002 ? _(mehr)
.load 3 line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xtvkpos = ""
.formula U|xtvknum = ""
.formula U|xtvkpos = 0|yreposid         ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 0|yrenum           ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvkpos = 0|ylsposid         ? _M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 0|ylsnum           ? _M|yvkvorgang^typ = G|REKO
'3|yteil^id'#'0|ypvorgang^id'#'0|ypersonal^id'#'3|ytmmpreis'#'3|ymge'#'3|ytmmwert'#'0|ypvorgang^yklassifizierung^id'#'U|xtvkpos'#'0|ypvorgang^yarbpaket^id'#'3|id'#'0|yvkartikel^namebspr'#'0|ypersonal^such'#'0|yedatum:8'#MM#'3|yteil^such'#'0|ypvorgang^yklassifizierung^such'#'0|ypvorgang^yarbpaket^such'#'U|xtvknum'#
.load 3 line
.continue LOOP003
!ELOP003: ==============================
.load 3 continue
.continue LOOP002
!ELOP002: ==============================
!EL002
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Submeldungen -----
.load 1 group 'U|xydbgrsubmeldung' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.load 1 line '1|selzeile'
.continue EL003 ? _(((((M|yvkvorgang^nummer = 1|ytsmlsnum) ; (M|yvkvorgang^nummer = 1|ytsmrenum)) & (_F|empty(M|yvkvorgang))) ; (F|empty(M|yvkvorgang))) & ((((M|yvkpos^id = 1|ytsmlsposid) ; (M|yvkpos^id = 1|ytsmreposid)) & (_F|empty(M|yvkpos))) ; (F|empty(M|yvkpos))) & ((F|empty(M|yvkartikel)) ; ((_(F|empty(M|yvkartikel))) & (1|yteil = M|yvkartikel^id ))))
.formula U|xtvkpos = ""
.formula U|xtvknum = ""
.formula U|xtvkpos = 1|ytsmreposid      ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 1|ytsmrenum        ?  M|yvkvorgang^typ = G|REKO
.formula U|xtvkpos = 1|ytsmlsposid      ? _M|yvkvorgang^typ = G|REKO
.formula U|xtvknum = 1|ytsmlsnum        ? _M|yvkvorgang^typ = G|REKO
'1|yteil^id'#'1|ytpvorgang^id'#'1|ytsubpersname'#'1|ytsmpreis'#'1|ymge'#'1|ytsmwert'#'1|ytpvorgang^yklassifizierung^id'#'U|xtvkpos'#'1|ytpvorgang^yarbpaket^id'#'1|zid'#'1|yteil^namebspr'#'1|ytsubpersname'#'1|ytdatum:8'##'1|yteil^such'#'1|ytpvorgang^yklassifizierung^such'#'1|ytpvorgang^yarbpaket^such'#'U|xtvknum'#
!EL003
.load 1 continue
.continue LOOP004
!ELOP004: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL004 ? _((_(F|empty(M|yprojekt))) ; ((F|empty(M|yvkvorgang)) & (F|empty(M|yvkpos))))
.continue EL005 ? _(_(M|ybstorno))
.load 8 group 'U|xydbgrlnachweis' 'F|expr("$,,yprojekt==" + H|id + ";ystornolm<>`;@filingmode=(Active)")'
!LOOP005: ==============================
.continue ELOP005 ? _(mehr)
.formula U|xnum1 = 8|nummer
.formula U|xnum2 = 8|ystornolm^nummer
.type bool xbstorno.xnum1   ? _F|defined(U|xbstorno.xnum1)
.type bool xbstorno.xnum2   ? _F|defined(U|xbstorno.xnum2)
.load 8 continue
.continue LOOP005
!ELOP005: ==============================
!EL005
.output addedto 'U|xtperfrepdat'
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=" + H|id
.formula U|xtsel = U|xtsel + ";yreposid=" + M|yvkpos^id             ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|reko
.formula U|xtsel = U|xtsel + ";ylsposid=" + M|yvkpos^id             ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|liko
.formula U|xtsel = U|xtsel + ";ylsnum="   + M|yvkvorgang^nummer     ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|liko
.formula U|xtsel = U|xtsel + ";yrenum="   + M|yvkvorgang^nummer     ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|reko
.formula U|xtsel = U|xtsel + ";yadatum<=" + M|ystdbisdatum:8        ? _F|empty(M|ystdbisdatum)
.formula U|xtsel = U|xtsel + ";yedatum>=" + M|ystdvondatum:8        ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";ypvorgang^yklassifizierung=" + M|ygewerk^id      ?   _F|empty(M|ygewerk)
.formula U|xtsel = U|xtsel + ";ypvorgang^yarbpaket="        + M|yarbpaket^id    ?   _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt="    + H|id
.formula U|xtsel = U|xtsel + ":ytsmreposid=" + M|yvkpos^id          ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|reko
.formula U|xtsel = U|xtsel + ";ytsmlsposid=" + M|yvkpos^id          ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|liko
.formula U|xtsel = U|xtsel + ";ytsmlsnum="   + M|yvkvorgang^nummer  ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|liko
.formula U|xtsel = U|xtsel + ";ytsmrenum="   + M|yvkvorgang^nummer  ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|reko
.formula U|xtsel = U|xtsel + ";ytdatum="
.formula U|xtsel = U|xtsel + M|ystdvondatum:8                       ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + "!" + M|ystdbisdatum:8                 ? _F|empty(M|ystdbisdatum)
.formula U|xtsel  =  'U|xtsel' + ";@ordnung=ytsubpersname;@zeilen=(1)"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.continue FI004
!EL004
.continue EL006 ? _(_(M|ybstorno))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yreposid=" + M|yvkpos^id             ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|reko
.formula U|xtsel = U|xtsel + ";ylsposid=" + M|yvkpos^id             ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|liko
.formula U|xtsel = U|xtsel + ";ylsnum="   + M|yvkvorgang^nummer     ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|liko
.formula U|xtsel = U|xtsel + ";yrenum="   + M|yvkvorgang^nummer     ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|reko
.formula U|xtsel = U|xtsel + ";yadatum<=" + M|ystdbisdatum:8        ? _F|empty(M|ystdbisdatum)
.formula U|xtsel = U|xtsel + ";yedatum>=" + M|ystdvondatum:8        ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";ypvorgang^yklassifizierung=" + M|ygewerk^id      ?   _F|empty(M|ygewerk)
.formula U|xtsel = U|xtsel + ";ypvorgang^yarbpaket="        + M|yarbpaket^id    ?   _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";ystornolm<>`"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 8 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(mehr)
.formula U|xnum1 = 8|nummer
.formula U|xnum2 = 8|ystornolm^nummer
.type bool xbstorno.xnum1   ? _F|defined(U|xbstorno.xnum1)
.type bool xbstorno.xnum2   ? _F|defined(U|xbstorno.xnum2)
.load 8 continue
.continue LOOP006
!ELOP006: ==============================
!EL006
.output addedto 'U|xtperfrepdat'
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yreposid=" + M|yvkpos^id             ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|reko
.formula U|xtsel = U|xtsel + ";ylsposid=" + M|yvkpos^id             ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|liko
.formula U|xtsel = U|xtsel + ";ylsnum="   + M|yvkvorgang^nummer     ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|liko
.formula U|xtsel = U|xtsel + ";yrenum="   + M|yvkvorgang^nummer     ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|reko
.formula U|xtsel = U|xtsel + ";yadatum<=" + M|ystdbisdatum:8        ? _F|empty(M|ystdbisdatum)
.formula U|xtsel = U|xtsel + ";yedatum>=" + M|ystdvondatum:8        ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";ypvorgang^yklassifizierung=" + M|ygewerk^id      ?   _F|empty(M|ygewerk)
.formula U|xtsel = U|xtsel + ";ypvorgang^yarbpaket="        + M|yarbpaket^id    ?   _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + "ytsmreposid=" + M|yvkpos^id + ";"         ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|reko
.formula U|xtsel = U|xtsel + "ytsmlsposid=" + M|yvkpos^id + ";"         ? _F|empty(M|yvkpos)     & M|yvkpos^kopf^typ = G|liko
.formula U|xtsel = U|xtsel + "ytsmlsnum="   + M|yvkvorgang^nummer + ";" ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|liko
.formula U|xtsel = U|xtsel + "ytsmrenum="   + M|yvkvorgang^nummer + ";" ? _F|empty(M|yvkvorgang) & M|yvkvorgang^typ  = G|reko
.formula U|xtsel = U|xtsel + ";ytdatum="
.formula U|xtsel = U|xtsel + M|ystdvondatum:8                           ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + "!"   + M|ystdbisdatum:8                   ? _F|empty(M|ystdbisdatum)
.formula U|xtsel = U|xtsel + ";@ordnung=ytsubpersname;@zeilen=(1)"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
!FI004
.input 'F|foppath("IFOP.IS.PRJMSTDNACHWEIS.TAB")'     ? F|fileexists(F|foppath("IFOP.IS.PRJMSTDNACHWEIS.TAB"))
.continue
