..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : FOP.SUBIMPORTKONF.EV
..==  Pfad              : allpstd
..==  Funktion          :
..==  Erstellungsdatum  : 06.04.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
..====================================================
.type text    xtsys xtsel xt1
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- CheckImportscript -----
.continue EL001 ? _((_(F|empty(M|yimpskript))) & (_(F|fileexists(M|yimpskript))))
.formula U|xt1 = M|yimpskript
.set trans +
.box Fehler
Das Import-Skript 'U|xt1' existiert nicht.
.set trans -
.error (0)  ?  G|evtart = "maskpruef"
.end 1      ?  G|evtart = "maskpruef"
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskpruef")
.continue EL002 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue EL003 ? _(F|empty(M|yarchivpfad))
.set TRANS +
.box -BUTTON yes:no -TITLE Hinweis
Sie haben keinen Archivpfad angegeben.
Importkonfiguration ohne Archivpfad speichern?
.set TRANS -
.continue EL004 ? _(_(G|box = G|boxyes))
.cursor yarchivpfad 0
.error
.end 1
!EL004
!EL003
!EL002
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "yimpskript")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
.continue
