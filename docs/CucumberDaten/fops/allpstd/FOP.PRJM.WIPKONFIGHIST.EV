..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xttransdat xterrtext xtvar
.type integer ximonat xijahr
.type GD      xdatum
.type bool    xyballschutz xbok
.type integer xprocsp     ? _F|defined(U|xprocsp)
.set DEMAND -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL001 ? _(_(G|evtkommd = G|kaktname10))
.copy M|ysaltperwipabs = M|yperwipabs
.continue EL002 ? _((G|evtkommd = G|kaktname13) & (M|yperwipabs))
.protection -EXCEPTION buinfosys  0
.protection -EXCEPTION buaktion   0
.protection -EXCEPTION budruck    0
.protection -EXCEPTION yperwipabs 0
.protection -ALL
!EL002
!EL001
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL003 ? _((M|yccverwenden) ; (M|ypcverwenden))
.formula U|xterrtext = ""
.set TRANS +
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Abzug der abgerechneten Leistungen"           ?  F|empty(M|yabzabgerechn)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Ermittlung der WiP-Leistungsart"              ?  F|empty(M|yermwipleiart)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Ermittlung abgerechnete Stunden"              ?  F|empty(M|yermabgerstd)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Ermittlung Wert Eigenleistungen"              ?  F|empty(M|yermeigwert)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Ermittlung WiP-Wert abgerechnete Leistungen"  ?  F|empty(M|yermabgeigwert)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Bestandskonto WiP"                            ?  F|empty(M|ybestandskto)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Konto WiP-BestandsverÑnderung"                ?  F|empty(M|ybvkto)
.set TRANS -
.continue EL004 ? _(M|yccverwenden)
.set TRANS +
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Vergleich WiP mit Auftragswert"           ?  F|empty(M|yccvglwipaufwrt)
.set TRANS -
!EL004
.continue EL005 ? _(M|ypcverwenden)
.set TRANS +
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Vergleich WiP mit Auftragswert"           ?  F|empty(M|ypcvglwipaufwrt)
.set TRANS -
!EL005
.continue EL006 ? _(_(F|empty(U|xterrtext)))
.set TRANS +
.formula U|xterrtext = "Vor dem Speichern bitte folgende Pflichtfelder fÅllen:;" + U|xterrtext
.set TRANS -
.formula U|xtvar     = "yabzabgerechn"    ?  F|empty(M|yabzabgerechn)
.formula U|xtvar     = "yermwipleiart"    ?  F|empty(M|yermwipleiart)
.formula U|xtvar     = "yermaberstd"      ?  F|empty(M|yermabgerstd)
.formula U|xtvar     = "yermeigwert"      ?  F|empty(M|yermeigwert)
.formula U|xtvar     = "yermabgeigwert"   ?  F|empty(M|yermabgeigwert)
.formula U|xtvar     = "ybestandskto"     ?  F|empty(M|ybestandskto)
.formula U|xtvar     = "ybvkto"           ?  F|empty(M|ybvkto)

.formula U|xtvar     = "yccvglwipaufwrt"  ?  F|empty(M|yccvglwipaufwrt)
.formula U|xtvar     = "ypcvglwipaufwrt"  ?  F|empty(M|ypcvglwipaufwrt)
.box Fehler
'U|xterrtext                                                            '
.cursor 'U|xtvar' 0
.error
.end 1
!EL006
!EL003
.continue
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "maskaus")
.continue EL007 ? _(G|evtkommd <> G|kaktname12)
.continue EL008 ? _(M|ysaltperwipabs <> M|yperwipabs)
.continue EL009 ? _(M|yperwipabs)
.copy    U|xbok             =  G|TRUE
.formula U|xtsel            = "$,,ystichtag==" + 'M|ybewertdat' + ";ybabgeschlossen==" + 'M|ysaltperwipabs' + ";@ablageart=(1)"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.select lock group 'U|xydbgrwipstat' '0|id'
.continue EL010 ? _(G|mehr)
.copy H|ybabgeschlossen = G|TRUE
.rewrite
.continue FI010
!EL010
.copy U|xbok = G|FALSE
!FI010
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.formula U|xtsel = "$,,ystichtag==" + 'M|ybewertdat' + ";ybabgeschlossen==0" + ";@ablageart=(1)"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
.continue EL011 ? _(G|mehr)
.set TRANS +
.box Fehler
Der WiP Abschluss konnte nicht fÅr alle Projekte gesetzt werden.
Der Gesamtabschluss wird nicht gesetzt.
.set TRANS -
.copy M|ybabgeschlossen = G|FALSE
.rewrite screen
!EL011
.continue FI009
!EL009
.continue EL012 ? _(G|TRUE)
.continue FI012
!EL012
.file -TEMPNAME U|xttransdat
.output NEW 'U|xttransdat'
.input DATEI.F
#!EDP_LANGCODE='G|bsprache'
#!ACTION=VIEW
id;ybustorno;
.copy    U|xbok             =  G|TRUE
.formula U|xtsel            = "$,,ystichtag==" + 'M|ybewertdat' + ";ybabgeschlossen==" + 'M|ysaltperwipabs' + ";@ablageart=(1)"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
?'0|ytransdat^id';;     ? _F|empty(0|ytransdat)
.copy U|xbok =  G|FALSE ? _F|empty(0|ytransdat)
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.output NEW WERF.WG
.formula U|xtsys = "edpimport.sh -c EKS -p " + G|einmalpw + " " + U|xttransdat
.system 'U|xtsys' BACKGROUND            ? _U|xbok
.copy    U|xbok             =  G|TRUE
.formula U|xtsel            = "$,,ystichtag==" + 'M|ybewertdat' + ";ybabgeschlossen==" + 'M|ysaltperwipabs' + ";@ablageart=(1)"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.select lock group 'U|xydbgrwipstat' '0|id'
.continue EL013 ? _(G|mehr)
.continue EL014 ? _((F|empty(H|ytransdat)) ; (H|ytransdat^ystorno))
.assign H|ytransaktion    = ""
.assign H|ytransdat       = ""
.copy   H|ybabgeschlossen = G|FALSE
.rewrite
.continue FI014
!EL014
.copy U|xbok = G|FALSE
!FI014
.continue FI013
!EL013
.copy U|xbok = G|FALSE
!FI013
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
.continue EL015 ? _(_(U|xbok))
.set TRANS +
.box Fehler
Der WiP Abschluss konnte nicht fÅr alle Projekte zurÅckgenommen werden.
.set TRANS -
!EL015
!FI012
!FI009
!EL008
!EL007
.continue
.continue ESAC001
!BRK003
.continue BRK004 ? _(G|evtart = "feldaus")
.continue BRK005 ? _(G|evtvar = "yperwipabs")
.copy M|yperwipabs = F|oldvalue(M|yperwipabs)   ? _G|EDP
.continue ESAC002
!BRK005
