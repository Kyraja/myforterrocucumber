..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.RVERTRAG.EV
..==  Pfad              : allpstd
..==  Funktion          :
..==  Erstellungsdatum  : 14.07.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtprg
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskaus")
.continue EL001 ? _(_(F|empty(M|ykunde)))
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"           ? _F|defined(5|ybleistkat)
.continue EL002 ? _(5|ybleistkat)
.formula U|xtprg = "RV" + M|nummer
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprg==" + U|xtprg
.formula U|xtsel = U|xtsel + ";@ablageart=(1)
.select group 'U|xydbgrprojleistkat' 'U|xtsel'
.continue EL003 ? _(_(G|mehr))
.continue EL004 ? _(G|evtkommd <> G|kaktname14)
.set trans +
.box -BUTTON yes:no -TITLE kein Leistungskatalog gefunden
Es wird ein neuer Leistungskatalog angelegt.
.set trans -
!EL004
.continue EL005 ? _((G|box = G|boxyes) ; (G|evtkommd = G|kaktname14))
.formula xtcmd = "make " + G|hdatname.xydbprojleistkat + " GROUP" + 'U|xygrprojleistkat'
.'U|xtcmd'
.formula H|such = U|xtprg
.formula H|name = M|name
.formula H|yprg = U|xtprg
.rewrite
!EL005
!EL003
!EL002
!EL001
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "buttonnach")
.continue BRK003 ? _(G|evtvar = "ybuprojleistkat")
.continue EL006 ? _(G|evtkommd <> G|kaktname14)
.formula U|xtprg = "RV" + M|nummer
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprg==" + U|xtprg
.formula U|xtsel = U|xtsel + ";@ablageart=(1)
.select group 'U|xydbgrprojleistkat' 'U|xtsel'
.continue EL007 ? _(G|mehr)
.formula U|xtcmd = G|kkomname38 + " PRJMLEISTKAT "
.formula U|xtcmd = U|xtcmd + "? yprojleistkat=" + H|id
.formula U|xtcmd = U|xtcmd + "|bstart="
.command -WAIT 'U|xtcmd'
.continue FI007
!EL007
.set TRANS +
.box Hinweis
FÅr diesen Rahmenvertrag existiert noch kein Leistungskatalog.
.set TRANS -
!FI007
!EL006
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK002
.continue BRK004 ? _(G|evtart = "feldaus")
.continue BRK005 ? _(G|evtvar = "ykunde")
.formula M|such = "RV" + M|ykunde^nummer
.continue ESAC003
!BRK005
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK004
!ESAC001: =====   ENDCASE   =====
.continue
