..!interpreter english declaration noabbrev
.. at 2017-08-22, 16:32
.set trans -
..========================================================================
..==  Name              : IS.PRJMWIPLISTE.EV
..==  Pfad              : allpstd
..==  Funktion          : Event FOP an IS PRJMWIPLISTE
..==  Erstellungsdatum  : 03.11.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/LART.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
.input "allpstart/TRANS.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtwipdarst xtabrechtyp xt2abrechtyp xtindex xttmpdat xtsumme xterrtext xtprojekt xttext xtid
.type text    xtedpdat xtedpmsg xtedpout xtedperr xtmerkaupos
.type text    xttransini xttransdat xttransprot xttransleer xttransd xttranst
.type GD19    xd19
.type GD      xdvm xd1 xdatum xbudat xdmerkbezugsdatum
.type integer ximonat xizeile xiselzeile xianz ximzeile
.type real    xrnwert xrpwert
.type real    xrgksatzfremd  xreigzuschlag  xrfremdzuschlag  xrsonstzuschlag  xrfertzuschlag  xrgeszuschlag
.type real    xrpgksatzfremd xrpeigzuschlag xrpfremdzuschlag xrpsonstzuschlag xrpfertzuschlag xrpgeszuschlag
.type real    xrwipsatz xrwipstdsatz xrzvksatz xrzvkstdsatz
.type real    xrvkreeigen xrvkrefremd xrvkresonst xrvkrefert xrvkrenwert
.type real    xrtpeigen xrtpfremd xrtpsonst xrtpfert xrtppwert
.type real    xrtpverwert xrtpverbr xrtpverbrek xrmumbverbr xrmumbverbrek xrstatbudgetwert xrnullrech
.type real    xreigstdverbr xreigstdabger xreigstdltabrech xrwipeigstdrechn
.type real    xreigstdkorr xrwipeigstdtats xreigvkwertabger xreigwertverbr xreigwertabger
.type real    xrwipeigwertrechn xreigwertkorr xrwipeigwerttats
.type real    xrmataufmabe xrfremdverbrek xrfremdverbr xrfremdvkwertabger xrfremdabger
.type real    xrwipfremdrechn xrfremdkorr xrwipfremdtats
.type real    xrsonstverbr xrsonstvkwertabger xrsonstabger xrwipsonstrechn xrsonstkorr xrwipgeskorr
.type real    xrfertflbestand xrfertwubestand xrfertvkwertwu xrwipfertrechn xrfertkorr
.type real    xrgesvkwertabger xrgesabger xrwipgesrechn xrwipgestats xrfertstellgrad
.type real    xraufwerterreicht xrwipsonsttats xrwipferttats xrfertvkwertabger xreigaufwert
.type real    xrfremdaufwert xrsonstaufwert xrfertaufwert xraufwertgesamt xraufwertman xraufwertkorr
.type real    xrwipgesverlfr xrwipgesfestg xrwipeigwertverlfr xrwipeigwertfestg xrwipfremdverlfr
.type real    xrwipfremdfestg xrwipsonstverlfr xrwipsonstfestg xrwipfertverlfr xrgessonstbewkorr xrwipfertfestg
.type real    xrwipvormon xrwipstdobudget xrwipwertobudget xrbudgetkorr xrrestbudgetwert xrrestbudgetstd
.type real    xrnachtranfwert xrnachtrfordwert
.type realx   xxeigkorrstd1 xxeigkorrstd2 xxeigkorrwert1 xxeigkorrwert2
.type bool    xyberlaubt xbfehler xbmehr xbok xbstart xbabschluss xbwipneu
.type symtab  xstsubprojects    ? _F|defined(U|xstsubprojects)
.type symtab  xystclosingvars   ? _F|defined(U|xystclosingvars)
.type P86:1   xpproject         ? _F|defined(U|xpproject)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- LoadWIPKonfigHist -----
.assign M|ywipkonfighist = ""
.formula U|xtsel = "$,,ybewertdat==" + M|ystichdatum:8 + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrwipkonfighist' 'U|xtsel'
.assign M|ywipkonfighist = 0|id         ? G|mehr
.continue 'xprocst.xprocsp'
!PROC002: ----- SpaltenEinAusblenden -----
.input allpstart/FOP.PRJM.UP.LOADCONFIG ? _F|defined(5|ypmwipperiode)
.continue EL001 ? _(F|empty(M|ywipkonfighist))
.formula P|maskkontextfop = P|maskkontextfop + " " + "BUDGET"                   ?  5|ypmwipbudget          & _F|regmatch(P|maskkontextfop, ".*BUDGET.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "BUDGET", "")     ? _5|ypmwipbudget          &  F|regmatch(P|maskkontextfop, ".*BUDGET.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "FERTLEIST"                ? _F|empty(5|ypmfertleist) & _F|regmatch(P|maskkontextfop, ".*FERTLEIST.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "FERTLEIST", "")  ?  F|empty(5|ypmfertleist) &  F|regmatch(P|maskkontextfop, ".*FERTLEIST.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "SONSTKOST"                ? _F|empty(5|ypmsonstkost) & _F|regmatch(P|maskkontextfop, ".*SONSTKOST.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "SONSTKOST", "")  ?  F|empty(5|ypmsonstkost) &  F|regmatch(P|maskkontextfop, ".*SONSTKOST.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "KOMP"                     ?  5|ypmabzabgerechnk = "KOMP" & _F|regmatch(P|maskkontextfop, ".*KOMP.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "KOMP", "")       ? _5|ypmabzabgerechnk = "KOMP" &  F|regmatch(P|maskkontextfop, ".*KOMP.*")
.continue FI001
!EL001
.load 9 add M|ywipkonfighist
.formula P|maskkontextfop = P|maskkontextfop + " " + "BUDGET"                   ?  9|ywipbudget             & _F|regmatch(P|maskkontextfop, ".*BUDGET.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "BUDGET", "")     ? _9|ywipbudget             &  F|regmatch(P|maskkontextfop, ".*BUDGET.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "FERTLEIST"                ? _F|empty(9|yktofertleist) & _F|regmatch(P|maskkontextfop, ".*FERTLEIST.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "FERTLEIST", "")  ?  F|empty(9|yktofertleist) &  F|regmatch(P|maskkontextfop, ".*FERTLEIST.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "SONSTKOST"                ? _F|empty(9|yktosonstkost) & _F|regmatch(P|maskkontextfop, ".*SONSTKOST.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "SONSTKOST", "")  ?  F|empty(9|yktosonstkost) &  F|regmatch(P|maskkontextfop, ".*SONSTKOST.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "KOMP"                     ?  9|yabzabgerechnk = "KOMP" & _F|regmatch(P|maskkontextfop, ".*KOMP.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "KOMP", "")       ? _9|yabzabgerechnk = "KOMP" &  F|regmatch(P|maskkontextfop, ".*KOMP.*")
!FI001
.continue 'xprocst.xprocsp'
!PROC003: ----- WiPVorperiode -----
.input allpstart/FOP.PRJM.UP.LOADCONFIG ? _F|defined(5|ypmwipperiode)
.formula U|xtsel = "$,,ybewertdat>=" + M|ystichdatum:8 + ";@filingmode=(Active);@order=ybewertdat.(Forwards)"
.load 0 group 'U|xydbgrwipkonfighist' 'U|xtsel'
.continue EL002 ? _(G|mehr)
.formula U|xtsel = 0|ywipperiodek
.copy M|ystichdatum = 0|ybewertdat  ? G|evtart = "maskein"
.continue FI002
!EL002
.formula U|xtsel = 5|ypmwipperiodek
.continue EL003 ? _((_(F|empty(5|ypmwipvorper))) & (_(F|empty(5|ypmwipperab))) & ((5|ypmwippernum = 1) ; (5|ypmwippernum = 2)))
.formula U|xtsel = 5|ypmwipperiode2k    ? M|ystichdatum >  5|ypmwipvorper & 5|ypmwippernum = 2
.formula U|xtsel = 5|ypmwipperiode2k    ? M|ystichdatum <= 5|ypmwipvorper & 5|ypmwippernum = 1
!EL003
.formula U|xd19 = M|ystichdatum
.continue BRK001 ? _(U|xtsel = "M")
.continue ESAC001
!BRK001
.continue BRK002 ? _(U|xtsel = "Q")
.continue EL004 ? _(F|empty(5|ypmwipperab))
.formula U|ximonat = 1  ? F|month(M|ystichdatum) <= 3
.formula U|ximonat = 2  ? F|month(M|ystichdatum) >  3 & F|month(M|ystichdatum) <= 6
.formula U|ximonat = 3  ? F|month(M|ystichdatum) >  6 & F|month(M|ystichdatum) <= 9
.formula U|ximonat = 4  ? F|month(M|ystichdatum) >  9
.formula U|xd19 = ">" + 'U|ximonat' + "Q" + 'F|year(U|xd19)' + "Y"
.continue FI004
!EL004
.formula U|xd19 = ">" + 'F|month(5|ypmwipperab)' + "M" + 'F|year(M|ystichdatum)' + "Y"
.formula U|xd1  = U|xd19
!LOOP001: ==============================
.continue ELOP001 ? _(U|xd1 < M|ystichdatum)
.formula U|xd19 = ">" + 'F|month(U|xd19)' + "M" + 'F|year(U|xd19)' + "Y+3M"     ? _G|evtart = "maskpruef"
.formula U|xd19 = ">" + 'F|month(U|xd19)' + "M" + 'F|year(U|xd19)' + "Y-3M"     ?  G|evtart = "maskpruef"
.formula U|xd19 = ">" + 'F|month(U|xd19)' + "M" + 'F|year(U|xd19)' + "Y"
.formula U|xd1  = U|xd19
.continue LOOP001
!ELOP001: ==============================
!FI004
.continue ESAC001
!BRK002
.continue BRK003 ? _(U|xtsel = "Y")
.continue EL005 ? _(G|evtart = "maskein")
.continue EL006 ? _(F|empty(5|ypmwipperab))
.formula U|xd19 = ">" + 'F|year(M|ystichdatum)' + "Y-1Y"
.formula U|xd19 = ">" + 'F|year(U|xd19)' + "Y"
.continue FI006
!EL006
.formula U|xd19 = ">" + 'F|month(5|ypmwipperab)' + "M" + 'F|year(M|ystichdatum)' + "Y"  ?  F|month(M|ystichdatum) <= F|month(5|ypmwipperab)
.formula U|xd19 = ">" + 'F|year(M|ystichdatum)' + "Y-1Y"                                ?  F|month(M|ystichdatum) >  F|month(5|ypmwipperab)
.formula U|xd19 = ">" + 'F|month(5|ypmwipperab)' + "M" + 'F|year(U|xd19)' + "Y"         ?  F|month(M|ystichdatum) >  F|month(5|ypmwipperab)
!FI006
.continue FI005
!EL005
.formula U|xd19 = ">" + 'F|year(M|ystichdatum)' + "Y"                                   ?  F|empty(5|ypmwipperab)
.formula U|xd19 = ">" + 'F|month(5|ypmwipperab)' + "M" + 'F|year(M|ystichdatum)' + "Y"  ? _F|empty(5|ypmwipperab)
!FI005
.continue ESAC001
!BRK003
.assign  M|ystichdatum = ""
.formula M|ymonat      = 0
.formula M|yjahr       = ""
.assign  M|yvorwipstichdatum = ""
.formula M|yvorwipmonat      = 0
.formula M|yvorwipjahr       = ""
.set trans +
.box Hinweis
Bitte erst die Periode der WiP-Ermittlung in der ProjectSuite-Konfiguration eintragen.
.set trans -
.error
.end 1
!ESAC001: =====   ENDCASE   =====
.formula M|ystichdatum = U|xd19
!FI002
.formula M|ymonat      = F|month(M|ystichdatum)
.formula M|yjahr       ='F|year(M|ystichdatum)'
.continue BRK004 ? _(U|xtsel = "M")
.formula U|xd1 = (M|ystichdatum:8)<<6 + "01"
.formula U|xd1 = U|xd1 - 1
.continue ESAC002
!BRK004
.continue BRK005 ? _(U|xtsel = "Q")
.formula U|xd19 = ">" + 'F|month(M|ystichdatum)' + "M" + 'F|year(M|ystichdatum)' + "Y-3M"
.formula U|xd19 = ">" + 'F|month(U|xd19)'        + "M" + 'F|year(U|xd19)'        + "Y"
.formula U|xd1  = U|xd19
.continue ESAC002
!BRK005
.continue BRK006 ? _(U|xtsel = "Y")
.assign  U|xd19 = ">" + 'F|month(M|ystichdatum)' + "M" + 'F|year(M|ystichdatum)' + "Y-1Y"
.formula U|xd1  = U|xd19
.continue ESAC002
!BRK006
!ESAC002: =====   ENDCASE   =====
.formula M|yvorwipstichdatum = U|xd1
.formula M|yvorwipmonat      = F|month(M|yvorwipstichdatum)
.formula M|yvorwipjahr       ='F|year(M|yvorwipstichdatum)'
.continue 'xprocst.xprocsp'
!PROC004: ----- Farbe -----
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL007 ? _(_(M|aktzeile = 1))
.colour -BACKGROUND 'U|xtfarbe1'  ytprojekt       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytname          'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytprojname      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytverantwkst    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytabrechtyp     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytwipeigstdrechn  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' yteigstdkorr      'M|aktzeile'    ?  F|protected(M|yteigstdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee2' yteigstdkorr      'M|aktzeile'    ? _F|protected(M|yteigstdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee1' ytwipeigstdtats   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytwipeigwerttats  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef1' ytwipfremdrechn    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef1' ytfremdkorr        'M|aktzeile'   ?  F|protected(M|ytfremdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbef2' ytfremdkorr        'M|aktzeile'   ? _F|protected(M|ytfremdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbef1' ytwipfremdtats     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes1' ytwipsonstrechn    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes1' ytsonstkorr        'M|aktzeile'   ?  F|protected(M|ytsonstkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbes2' ytsonstkorr        'M|aktzeile'   ? _F|protected(M|ytsonstkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbes1' ytwipsonsttats     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgeskorr       'M|aktzeile'   ?  F|protected(M|ytwipgeskorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytwipgeskorr       'M|aktzeile'   ? _F|protected(M|ytwipgeskorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgestats       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytaufwerterreicht  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytaufwertman       'M|aktzeile'   ?  F|protected(M|ytaufwertman, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytaufwertman       'M|aktzeile'   ? _F|protected(M|ytaufwertman, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytaufwertkorr      'M|aktzeile'   ?  F|protected(M|ytaufwertkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytaufwertkorr      'M|aktzeile'   ? _F|protected(M|ytaufwertkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgesverlfr     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytgessonstbewkorr  'M|aktzeile'   ?  F|protected(M|ytgessonstbewkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytgessonstbewkorr  'M|aktzeile'   ? _F|protected(M|ytgessonstbewkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgesfestg      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytwipvormon        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytbv               'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytbem             'M|aktzeile'  ?  F|protected(M|ytbem, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbe2'  ytbem             'M|aktzeile'  ? _F|protected(M|ytbem, M|aktzeile)
.continue EL008 ? _(_(F|empty(M|ytprojekt)))
.formula M|ytbuabschluss = "icon:cube_green"   ? _M|ytbabgeschlossen
.formula M|ytbuabschluss = "icon:package"      ?  M|ytbabgeschlossen &  F|empty(M|ytwipstatistik^ytransaktion)
.formula M|ytbuabschluss = "icon:ok"           ?  M|ytbabgeschlossen & _F|empty(M|ytwipstatistik^ytransaktion)
!EL008
!EL007
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- PositionCheck -----
.copy U|xbok = G|TRUE
.continue EL009 ? _(8|konto^gv)
.continue EL010 ? _(8|art^gruppe = 4)
.copy U|xbok = G|FALSE      ? '8|art^kategorie(L="0")' = "(68)"
!EL010
.continue FI009
!EL009
.copy U|xbok = G|FALSE
!FI009
.continue 'xprocst.xprocsp'
!PROC006: ----- ZeileAktualisieren -----
.formula M|ytermabgerstd     = H|yermabgerstd
.formula M|ytwipstdsatz      = H|ywipstdsatz
.formula M|ytzielvksatz      = H|yzielvksatz
.formula M|yteigstdverbr     = H|yeigstdverbr
