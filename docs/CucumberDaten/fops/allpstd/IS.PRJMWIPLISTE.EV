.formula U|xrvkresonst = U|xrvkresonst + U|xrnwert                                                      ? 7|pland =  G|inland
.formula U|xrvkresonst = U|xrvkresonst + F|fxamount(G|inland,U|xrnwert,M|ystichdatum,7|pland,G|TRUE)    ? 7|pland <> G|inland
.formula U|xrnwert     = 7|yprjmpfertleist                              ? _7|kobrutto
.formula U|xrnwert     = 7|yprjmpfertleist  / (1 + (7|stsatz / 100))    ?  7|kobrutto
.formula U|xrvkrefert  = U|xrvkrefert  + U|xrnwert                                                      ? 7|pland =  G|inland
.formula U|xrvkrefert  = U|xrvkrefert  + F|fxamount(G|inland,U|xrnwert,M|ystichdatum,7|pland,G|TRUE)    ? 7|pland <> G|inland
.formula U|xrnwert     = 7|nwert                                        ? _7|kobrutto
.formula U|xrnwert     = 7|nwert - 7|stwert                             ?  7|kobrutto
.formula U|xrvkrenwert = U|xrvkrenwert + U|xrnwert                                                      ? 7|pland =  G|inland
.formula U|xrvkrenwert = U|xrvkrenwert + F|fxamount(G|inland,U|xrnwert,M|ystichdatum,7|pland,G|TRUE)    ? 7|pland <> G|inland
