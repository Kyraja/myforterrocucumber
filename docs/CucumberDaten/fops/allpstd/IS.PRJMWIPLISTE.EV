!PROC031: ----- WiP_gesamt_rechnerisch_tatsaechlich -----
.formula H|yaufwertgesamt = 0   ? G|evtvar = "ybuberech" ;  G|evtvar = "bstart"
.continue EL142 ? _(0|yabzabgerechnk = "SUM")
.formula H|ygesvkwertabger = U|xrvkrenwert
.formula H|ygesabger       = H|ygesvkwertabger / (1 + U|xrpgeszuschlag / 100)
.formula H|ywipgesrechn    = H|ywipeigwertrechn + H|ywipfremdrechn + H|ywipsonstrechn -  H|ygesabger
.formula H|ywipgestats = H|ywipgesrechn + H|ywipgeskorr
.continue FI142
!EL142
.formula H|ywipgesrechn    = H|ywipeigwertrechn + H|ywipfremdrechn    + H|ywipsonstrechn + H|ywipfertrechn
.formula H|ywipgestats     = H|ywipeigwerttats  + H|ywipfremdtats     + H|ywipsonsttats  + H|ywipferttats
.formula H|ygesvkwertabger = H|yeigvkwertabger  + H|yfremdvkwertabger + H|ysonstvkwertabger
.formula H|ygesabger       = H|yeigwertabger    + H|yfremdabger       + H|ysonstabger
!FI142
.continue 'xprocst.xprocsp'
!PROC032: ----- Gesamtsummen_und_Vormonat -----
.formula H|yaufwerterreicht = (H|yaufwertgesamt + H|yaufwertkorr) * H|yfertstellgrad                                                                    ?  0|yccfertgrad
.formula H|yaufwerterreicht = H|yaufwertgesamt + H|yaufwertkorr - H|ygesabger                                                                           ? _0|yccfertgrad &  0|yabzabgerechnk = "SUM"
.formula H|yaufwerterreicht = H|yaufwertgesamt + H|yaufwertkorr - H|yeigvkwertabger - H|yfremdvkwertabger - H|ysonstvkwertabger - H|yfertvkwertabger    ? _0|yccfertgrad & _0|yabzabgerechnk = "SUM"
.continue EL143 ? _(H|yabrechtypk = "AUFW")
.formula H|yaufwerterreicht = 0     ? H|yaufwerterreicht < 0
.formula H|ywipgesverlfr    = H|ywipgestats
