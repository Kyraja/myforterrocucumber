.formula M|ytrestbudgetwert  = H|yrestbudgetwert
.formula M|ytrestbudgetstd   = H|yrestbudgetstd
.formula M|ytwipvormon       = H|ywipvormon
.formula M|ytbv              = H|ywipgesfestg - H|ywipvormon
.continue 'xprocst.xprocsp'
!PROC007: ----- WiP_Abschluss -----
.continue EL011 ? _((F|month(5|ypmwipstartdatum) <> F|month(M|ystichdatum)) ; (F|year(5|ypmwipstartdatum)  <> F|year(M|ystichdatum)))
.formula U|xtsel = "$,,yprojekt==" + M|ytprojekt^id + ";ystichtag==" + M|yvorwipstichdatum:8
.formula U|xtsel = U|xtsel + ";yauposid==`"
.formula U|xtsel = U|xtsel + ";ytpposid==`"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrwipstat' 'U|xtsel'
.continue EL012 ? _(G|mehr)
.copy U|xbok = H|ybabgeschlossen
.continue FI012
!EL012
.continue EL013 ? _(M|ytprojekt^yadatum > M|yvorwipstichdatum)
.copy U|xbok = G|TRUE
.continue FI013
!EL013
.copy U|xbok = G|FALSE
!FI013
!FI012
.continue FI011
!EL011
.copy U|xbok = G|TRUE
!FI011
.continue EL014 ? _(U|xbok)
.action +
.formula U|xtsel = "$,,yprojekt==" + M|ytprojekt^id + ";ystichtag==" + M|ystichdatum:8
.formula U|xtsel = U|xtsel + ";@ablageart=(Active)"
.load 9 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.select lock add 9|id
.continue EL015 ? _(G|mehr)
.copy    H|ybabgeschlossen  = G|TRUE
.formula H|ywipablbearb     = G|bzeichen
.formula H|ywipabldat       = G|datum
.rewrite
.select -
.continue FI015
!EL015
.set trans +
.box Hinweis
WiP Abschluss fÅr Projekt 'M|ytprojekt^such' kann nicht durchgefÅhrt werden.
.set trans -
.error
.end 1
!FI015
.load 9 continue
.continue LOOP003
!ELOP003: ==============================
.action -
.continue FI014
!EL014
.continue EL016 ? _(G|evtvar = "ytbuabschluss")
.set trans +
.box Fehler
Der WiP der Vorperiode ist noch nicht abgeschlossen.
WiP kann nicht abgeschlossen werden.
.set trans -
.error
.end 1
!EL016
!FI014
.continue 'xprocst.xprocsp'
!PROC008: ----- WiP_gesamt_verlustfrei -----
.continue EL017 ? _(0|yccvglwipaufwrtk = "SUM")
.formula H|ywipgesverlfr = F|min(H|ywipgestats,H|yaufwerterreicht)
.formula H|ywipgesverlfr = 0                                        ? H|yaufwerterreicht <= 0 & H|ywipgestats >= 0
.formula H|ywipgesverlfr = H|ywipgestats                            ?                           H|ywipgestats <  0
.continue FI017
!EL017
.formula H|ywipgesverlfr = H|ywipeigwertfestg + H|ywipfremdfestg + H|ywipsonstfestg + H|ywipfertfestg
!FI017
.continue 'xprocst.xprocsp'
!PROC009: ----- Korrekturwert_Eigenleistung_Wert -----
.continue EL018 ? _((H|ywipeigwerttats = 0) ; ((H|ywipeigwerttats  <  0) & (H|ywipeigwertrechn <= 0) & (H|ywipeigwerttats  <> 0)) ; ((H|ywipeigwerttats  >  0) & (H|ywipeigwertrechn >= 0) & (H|ywipeigwerttats  <> 0)))
.continue EL019 ? _(H|ywipeigwerttats = 0)
.formula H|yeigstdkorr = H|yeigwertkorr / H|ywipstdsatz ? _H|ywipstdsatz = 0 & H|ywipeigwertrechn >= 0
.formula H|yeigstdkorr = H|yeigwertkorr / H|yzielvksatz ? _H|yzielvksatz = 0 & H|ywipeigwertrechn <  0
.continue FI019
!EL019
.formula H|yeigstdkorr = H|yeigwertkorr / H|ywipstdsatz ? _H|ywipstdsatz = 0 & H|ywipeigwerttats >= 0
.formula H|yeigstdkorr = H|yeigwertkorr / H|yzielvksatz ? _H|yzielvksatz = 0 & H|ywipeigwerttats <  0
!FI019
.continue FI018
!EL018
.formula U|xxeigkorrwert1 = H|ywipeigwertrechn          ? H|ywipeigwertrechn >= 0
.formula U|xxeigkorrwert1 = H|ywipeigwertrechn * (-1)   ? H|ywipeigwertrechn <  0
.formula U|xxeigkorrwert2 = H|ywipeigwerttats           ? H|ywipeigwerttats  >= 0
.formula U|xxeigkorrwert2 = H|ywipeigwerttats  * (-1)   ? H|ywipeigwerttats  <  0
.continue EL020 ? _(H|ywipeigwertrechn >= 0)
.formula U|xxeigkorrstd1 = U|xxeigkorrwert1 / H|ywipstdsatz
.formula U|xxeigkorrstd2 = U|xxeigkorrwert2 / H|yzielvksatz
.formula H|yeigstdkorr   = (U|xxeigkorrstd1 + U|xxeigkorrstd2) * (-1)
.continue FI020
!EL020
.formula U|xxeigkorrstd1 = U|xxeigkorrwert1 / H|yzielvksatz
.formula U|xxeigkorrstd2 = U|xxeigkorrwert2 / H|ywipstdsatz
.formula H|yeigstdkorr   = U|xxeigkorrstd1 + U|xxeigkorrstd2
!FI020
!FI018
.continue 'xprocst.xprocsp'
!PROC010: ----- Korrekturwert_Eigenleistung_Stunden -----
.continue EL021 ? _((H|ywipeigstdtats = 0) ; ((H|ywipeigstdtats  <  0) & (H|ywipeigstdrechn <= 0) & (H|ywipeigstdtats  <> 0)) ; ((H|ywipeigstdtats  >  0) & (H|ywipeigstdrechn >= 0) & (H|ywipeigstdtats  <> 0)))
.continue EL022 ? _(H|ywipeigstdtats = 0)
.formula H|yeigwertkorr    = H|yeigstdkorr * H|ywipstdsatz  ? H|ywipeigstdrechn >= 0
.formula H|yeigwertkorr    = H|yeigstdkorr * H|yzielvksatz  ? H|ywipeigstdrechn <  0
.continue FI022
!EL022
.formula H|yeigwertkorr    = H|yeigstdkorr * H|ywipstdsatz  ? H|ywipeigstdtats >= 0
.formula H|yeigwertkorr    = H|yeigstdkorr * H|yzielvksatz  ? H|ywipeigstdtats <  0
!FI022
.continue FI021
!EL021
.formula U|xxeigkorrstd1 = H|ywipeigstdrechn           ? H|ywipeigstdrechn >= 0
.formula U|xxeigkorrstd1 = H|ywipeigstdrechn    * (-1) ? H|ywipeigstdrechn <  0
.formula U|xxeigkorrstd2 = H|ywipeigstdtats         ? H|ywipeigstdtats  >= 0
.formula U|xxeigkorrstd2 = H|ywipeigstdtats  * (-1) ? H|ywipeigstdtats  <  0
.continue EL023 ? _(H|ywipeigstdrechn >= 0)
.formula U|xxeigkorrwert1 = U|xxeigkorrstd1 * H|ywipstdsatz
.formula U|xxeigkorrwert2 = U|xxeigkorrstd2 * H|yzielvksatz
.formula H|yeigwertkorr   = (U|xxeigkorrwert1 + U|xxeigkorrwert2) * (-1)
.continue FI023
!EL023
.formula U|xxeigkorrwert1 = U|xxeigkorrstd1 * H|yzielvksatz
.formula U|xxeigkorrwert2 = U|xxeigkorrstd2 * H|ywipstdsatz
.formula H|yeigwertkorr   = U|xxeigkorrwert1 + U|xxeigkorrwert2
!FI023
!FI021
.continue 'xprocst.xprocsp'
!PROC011: ----- Korrekturwerte_aus_Vormonat -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="   + H|yprojekt^id
.formula U|xtsel = U|xtsel + ";ystichtag=="  + M|yvorwipstichdatum:8
.formula U|xtsel = U|xtsel + ";yabrechtypk=" + U|xtabrechtyp    ? _F|empty(U|xtabrechtyp)
.formula U|xtsel = U|xtsel + ";yabrechtypk==`" + U|xtabrechtyp  ?  F|empty(U|xtabrechtyp)
.formula U|xtsel = U|xtsel + ";yauposid=="   + H|yauposid       ? _F|empty(H|yauposid)
.formula U|xtsel = U|xtsel + ";yauposid==`"                     ?  F|empty(H|yauposid)
.formula U|xtsel = U|xtsel + ";ytpposid=="   + H|ytpposid       ? _F|empty(H|ytpposid)
.formula U|xtsel = U|xtsel + ";ytpposid==`"                     ?  F|empty(H|ytpposid)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 8 group 'U|xydbgrwipstat' 'U|xtsel'
.continue EL024 ? _(G|mehr)
.formula H|yfremdkorr       = 8|yfremdkorr
.formula H|ysonstkorr       = 8|ysonstkorr
.formula H|yfertkorr        = 8|yfertkorr
.formula H|ybudgetkorr      = 8|ybudgetkorr
.formula H|ywipgeskorr      = 8|ywipgeskorr
.formula H|ygessonstbewkorr = 8|ygessonstbewkorr
.formula H|yaufwertkorr     = 8|yaufwertkorr
.formula H|ybemerkung       = 8|ybemerkung
.formula H|ywipfremdtats    = H|ywipfremdrechn + H|yfremdkorr
.formula H|ywipferttats     = H|ywipfertrechn  + H|yfertkorr
.formula H|ywipsonsttats    = H|ywipsonstrechn + H|ysonstkorr
.continue EL025 ? _(M|ywipkonfighist^yermeigwertk  = "ISMWS")
.formula H|yeigstdkorr    = 8|yeigstdkorr
.formula H|ywipeigstdtats = H|ywipeigstdrechn + H|yeigstdkorr
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC010
!RET001
.formula xprocsp = xprocsp - 1
.formula H|ywipeigwerttats = H|ywipeigwertrechn + H|yeigwertkorr
.formula H|ywipgestats     = H|ywipeigwerttats  + H|ywipfremdtats + H|ywipsonsttats + H|ywipferttats
.continue FI025
!EL025
.formula H|yeigwertkorr    = 8|yeigwertkorr
.formula H|ywipeigwerttats = H|ywipeigwertrechn + H|yeigwertkorr
.formula H|ywipgestats     = H|ywipeigwerttats + H|ywipfremdtats + H|ywipsonsttats + H|ywipferttats
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC009
!RET002
.formula xprocsp = xprocsp - 1
.formula H|ywipeigstdtats   = H|ywipeigstdrechn + H|yeigstdkorr
!FI025
.continue EL026 ? _(H|yabrechtypk = "AUFW")
.formula H|ywipgesverlfr = H|ywipgestats
.continue FI026
!EL026
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC008
!RET003
.formula xprocsp = xprocsp - 1
!FI026
.load 8
.continue EL027 ? _((((2|ystatusk = "FTAB") ; (2|ystatusk = "ABS") ; (2|ystatusk = "08")) & (((F|month(2|yftabdatum) <= F|month(M|ystichdatum)) & (F|year(2|yftabdatum)   = F|year(M|ystichdatum))) ; (F|year(2|yftabdatum)  <  F|year(M|ystichdatum))) & (F|rec(U|xystclosingvars, ypmtabwipnull))) ; (((2|ystatusk = "ABS") ; (2|ystatusk = "08")) & (((F|month(2|yabldat) <= F|month(M|ystichdatum)) & (F|year(2|yabldat)   = F|year(M|ystichdatum))) ; (F|year(2|yabldat)  <  F|year(M|ystichdatum)))))
.formula H|ywipgesfestg = 0
.continue FI027
!EL027
.formula H|ywipgesfestg = H|ywipgesverlfr + H|ygessonstbewkorr
!FI027
!EL024
.continue 'xprocst.xprocsp'
