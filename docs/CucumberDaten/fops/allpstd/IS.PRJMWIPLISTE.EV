.formula M|ytaufwerterreicht = H|yaufwerterreicht
.formula M|ytgkfremdsatzwert = H|ygkfremdsatzwert
.formula M|ytfremdzuschlwert = H|yfremdzuschlwert
.formula M|ytwipsonsttats    = H|ywipsonsttats
.formula M|ytwipferttats     = H|ywipferttats
.formula M|ytsonstzuschlwert = H|ysonstzuschlwert
.formula M|ytfertvkwertabger = H|yfertvkwertabger
.formula M|ytgksatzfremdwert = H|ygksatzfremdwert
.formula M|ytfertzuschlwert  = H|yfertzuschlwert
.formula M|yteigzuschlwert   = H|yeigzuschlwert
.formula M|yteigaufwert      = H|yeigaufwert
