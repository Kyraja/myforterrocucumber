..!INTERPRETER ENGLISH DECLARATION NOABBREV
..*****************************************************************************
.. Name           : allpstd/FOP.PRJMSTDPROKST.DRUCKNACH
.. Datum/Date     : 22.03.2011
.. Version        :
.. Autor/Author   : A.Otto / alltrotec GmbH
.. Copyright      :
.. Beschreibung/
.. Description    : -StundenzetteldatensÑtze nach Druck als gedruckt kennzeichnen
..                  -wird nur bei Druck auf echtem Drucker ausgefÅhrt oder auf Verteiler
..
...Includes       :
..*****************************************************************************
..
.type text xtsel                ? _F|defined(xtsel)
.type bool xbprotoan            ? _F|defined(U|xbprotoan)
.type text xtstdprokstprot      ? _F|defined(U|xtstdprokstprot)
..
.input "allpstart/PRJM.KONFIG.INI"      ? _F|defined(U|xydbgrstundenzettel)
..
..Protokoll an oder aus
.formula U|xtstdprokstprot = "allpstd/PRJMSTDPROKST.PROTOKOLL.DRUCK"
..      .formula U|xbprotoan = G|TRUE
..
..*****************************************************************************
.input DATEI.F
.continue SP01  ? _U|xbprotoan
.output ADDEDTO 'U|xtstdprokstprot'
Programm gestartet 'G|zeit'   'G|datum'  P|drucker^drtypn: 'P|drucker^drtypn'  #  P|drucker^gruppe: 'P|drucker^gruppe' # Drucker:'P|drucker^id' - 'P|drucker^nummer'
..
!SP01:wenn auf echtem Drucker, Stundenzettel als gedruckt markieren
.continue       ? _P|drucker^drtypn = 80 & _P|drucker^gruppe=2 & _P|drucker^drtypn = 97 & _P|drucker^drtypn = 65 & _P|drucker^drtypn = 70
..
.formula U|xtsel = "$,,ymonat=" + 'F|month(M|yvondatum)' + ";yjahr=" + 'F|year(M|yvondatum)' + ";ypersonal=" + M|ypersonal^id
.formula U|xtsel = U|xtsel + ";@ablageart=lebendig"
.select lock nowait group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue NOSPERR       ? _G|gesperrt
.formula H|ybgedruckt = G|TRUE
.rewrite
..
.continue END   ? _U|xbprotoan
..
.output ADDEDTO 'U|xtstdprokstprot'
Datensatz gekennzeichnet  'zeit'   'datum'
..
.continue END
..
!NOSPERR
..Datensatz konnte nicht zum Schreiben geladen werden
.continue END   ? _U|xbprotoan
..
.output ADDEDTO 'U|xtstdprokstprot'
Konnte Datensatz nicht sperren 'G|zeit'   'G|datum'
..
!END
.continue SP04  ? _U|xbprotoan
..
.output ADDEDTO 'U|xtstdprokstprot'
Programm zu Ende 'zeit'   'datum'
..
!SP04
.continue
