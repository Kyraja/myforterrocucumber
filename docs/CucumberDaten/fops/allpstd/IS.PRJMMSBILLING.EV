..!interpreter english declaration noabbrev
.. at 2016-10-25, 16:54
.set trans -
..========================================================================
..==  Name              : IS.PRJMMSBILLING.EV
..==  Pfad              : allpstd
..==  Funktion          : EV Fop fÅr IS PRJMMSBILLING
..==  Erstellungsdatum  : 17.05.2016
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text      xtcmd xtsel xtprojekt
.type integer   xizeile ximerkzeile
.type bool      xbmehr
.type ARTR52000 xrauwert xrrewert
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Farben -----
.input "is/ABASFARBEN.DEF"  ? _F|defined(U|xabaslightgreen)
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.colour -background 'U|xabaslightgreen' 'M|aktzeile'    ?  F|empty(M|ytpvorgang) & _F|empty(M|ytprojekt)
.colour -background "-1 -1 -1"          'M|aktzeile'    ? _F|empty(M|ytpvorgang) ;  F|empty(M|ytprojekt)
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- aufklappen -----
.continue EL001 ? _(_(F|empty(M|ytaupos)))
.formula U|xtsel = "$,,orig==" + M|ytaupos^id + ";@filingmode=(Both)"
.load 2 group "3:2" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.copy    U|xbmehr   = G|mehr
.continue EL002 ? _('2|kotyp(L=":")' = "(PackingSlip)")
.formula U|xtsel = "$,,orig==" + 2|id + ";@filingmode=(Both)"
.load 3 group "3:2" 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.make screen line +O
.assign  M|ytrepos    = 3|id
.assign  M|ytrekopf   = 3|kopf^id
.formula M|tbaumstufe = 1
.load 9 add 3|kopf
.formula M|ytrewert = 3|pwert                                       ?  9|waehr = G|inland
.formula M|ytrewert = F|fxamount(G|inland,3|pwert,,9|waehr,G|true)  ? _9|waehr = G|inland & _9|kursfix
.formula M|ytrewert = (3|pwert * 9|ewkurs)                          ? _9|waehr = G|inland &  9|kursfix
.load 3 continue
.continue LOOP003
!ELOP003: ==============================
.continue FI002
!EL002
.make screen line +O
.assign  M|ytrepos    = 2|id
.assign  M|ytrekopf   = 2|kopf^id
.formula M|tbaumstufe = 1
.load 9 add 2|kopf
.formula M|ytrewert = 2|pwert                                       ?  9|waehr = G|inland
.formula M|ytrewert = F|fxamount(G|inland,2|pwert,,9|waehr,G|true)  ? _9|waehr = G|inland & _9|kursfix
.formula M|ytrewert = (2|pwert * 9|ewkurs)                          ? _9|waehr = G|inland &  9|kursfix
!FI002
.load 2 continue
.continue LOOP002
!ELOP002: ==============================
.continue EL003 ? _(U|xbmehr)
.select screen line 'G|evtzeile'
.formula M|ytbaumaufzu = "icon:folder_opened"
.formula M|tbaumstat   = "-"
!EL003
!EL001
.continue 'xprocst.xprocsp'
!PROC003: ----- zuklappen -----
.formula M|ytbaumaufzu = "icon:folder_closed"
.formula M|tbaumstat   = "+"
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _((G|mehr) & (M|tbaumstufe = 1))
.make screen line -O
.continue LOOP004
!ELOP004: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input "allpstart/IS.PRJM.SEL"
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "yekrechnung")
.formula M|yekrechbetreff = M|yekrechnung^betreff
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "ylief")
.formula M|yliefname      = M|ylief^namebspr
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.input "allpstart/IS.PRJM.SEL"
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "buttonvor")
.continue BRK006 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK005
.continue BRK007 ? _(G|evtart = "buttonnach")
.continue BRK008 ? _(G|evtvar = "bstart")
.input "allpstart/IS.PRJM.SEL"
.input "is/ABASFARBEN.DEF"
.formula U|xrauwert = 0
.formula U|xrrewert = 0
.select screen header
.select screen line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL004 ? _(_(F|empty(M|ytprojekt)))
.formula U|xtprojekt = M|ytprojekt^id           ? M|aktzeile = 1
.formula U|xizeile   = 0                        ? M|aktzeile = 1
.formula U|xrauwert = U|xrauwert + M|ytauwert   ? U|xtprojekt = M|ytprojekt^id
.formula U|xrrewert = U|xrrewert + M|ytrewert   ? U|xtprojekt = M|ytprojekt^id
.continue EL005 ? _((_(U|xtprojekt = M|ytprojekt^id)) ; (M|aktzeile = M|tzeilen))
.formula U|ximerkzeile = M|aktzeile + 1
.select screen line 'U|xizeile'
.make screen line +O
.assign  M|ytprojekt = U|xtprojekt
.formula M|ytpvname  = M|ytprojekt^namebspr
.formula M|ytauwert  = U|xrauwert
.formula M|ytrewert  = U|xrrewert
.select screen line 'U|ximerkzeile'
.formula U|xrauwert  = 0
.formula U|xrrewert  = 0
.formula U|xtprojekt = M|ytprojekt^id
.formula U|xizeile   = M|aktzeile - 1
!EL005
!EL004
.select screen line
.continue LOOP005
!ELOP005: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK008
.continue BRK009 ? _(G|evtvar = "ytbaumaufzu")
.continue BRK010 ? _(M|tbaumstat = "+")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK010
.continue BRK011 ? _(M|tbaumstat = "-")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK011
!ESAC005: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK009
.continue BRK012 ? _(G|evtvar = "ytburechnung")
.continue EL006 ? _(_(F|empty(M|ytaupos)))
.formula U|xtsel = "<(Sales)>" + M|ytaupos^id + "<(Invoice)>?" + M|ytaupos^id + ":offueb=|[pos]=" + M|ytaupos^id + ":artikel"
.command -wait 'U|xtsel'
.continue EL007 ? _(M|tbaumstat = "-")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC003
!RET005
.formula xprocsp = xprocsp - 1
.select screen line 'G|evtzeile'
.input 'M|tab'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
.continue FI007
!EL007
.select screen line 'G|evtzeile'
.input 'M|tab'
!FI007
.formula U|xrrewert = 0
.select screen line 'G|evtzeile'
.formula U|xtsel = "$,,ytprojekt==" + M|ytprojekt^id + ";ytpvorgang<>`"
.select screen line 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xrrewert = U|xrrewert + M|ytrewert
.select screen line
.continue LOOP006
!ELOP006: ==============================
.select screen line 'G|evtzeile'
.formula U|xtsel = "$,,ytprojekt==" + M|ytprojekt^id + ";ytpvorgang==`"
.select screen line 'U|xtsel'
.formula M|ytrewert  = U|xrrewert   ? G|mehr
!EL006
.continue ESAC004
!BRK012
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMMSBILLING.EV")'   ? F|fileexists(F|foppath("IFOP.IS.PRJMMSBILLING.EV"))
.continue
