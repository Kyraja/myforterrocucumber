..!interpreter english declaration noabbrev
.. at 2017-03-06, 11:04
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMPVSTDPLAN.TAB
..==  Pfad              : allpstd
..==  Funktion          : Tabellen EFOP zum IS PRJMPVSTDPLAN
..==  Erstellungsdatum  : 19.08.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..========================================================================
..====================================================
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Zeile_laden -----
.continue EL001 ? _((G|evtvar = "ytbuverteilen") ; (G|evtvar = "ybuverteilen") ; (G|evtart = "feldaus"))
.formula U|xi1 = 1
!LOOP001: ==============================
.continue ELOP001 ? _(F|defined(M|ytstd.xi1))
.formula M|ytstd.xi1 = 0
.formula U|xi1 = U|xi1 + 1
.continue LOOP001
!ELOP001: ==============================
.formula U|xi1 = 1
!LOOP002: ==============================
.continue ELOP002 ? _(F|defined(M|ytweek.xi1))
.formula M|ytweek.xi1 = 0
.formula U|xi1 = U|xi1 + 1
.continue LOOP002
!ELOP002: ==============================
.formula M|ytstdverteilt = 0
.formula M|ytstdvj       = 0
.formula M|ytstdfj       = 0
!EL001
.make screen line +O                        ? G|evtvar <> "ybuverteilen" & G|evtvar <> "ytbuverteilen" & G|evtart <> "feldaus"
.copy    M|ytprojekt       = 0|yprojekt
.formula M|ytprojname      = M|ytprojekt^namebspr
.assign  M|ypvorgang       = 0|id
.formula M|ypvname         = 0|namebspr
.assign  M|yaufgabe        = 0|yrefid       ? _F|empty(0|yrefid)
.copy    M|ytpvpersonal    = 0|ypersonal
.copy    M|ytpvprojteam    = 0|yprojteam
.copy    M|ytpvkstelle     = 0|ykstelle
.copy    M|yadatum         = 0|yadatum
.copy    M|yedatum         = 0|yedatum
.formula M|ytpvplanstd     = 0|ypvplanstd
.formula M|ytpvsollstd     = 0|ypvsollstd
.formula M|ytpviststd      = 0|ypviststd
.formula M|ytpvforecaststd = 0|ypvforecaststd - 0|ypviststd
.formula U|xtsel = "$,,ypvorgang==" + 0|id + ";ydatum>=" + U|xdatum:8 + ";ybsim==0;@filingmode=(Active)"
.load 9 group "P154:2" 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xi1 = F|month(9|ydatum)
.formula U|xwoche = 9|ydatum
.formula U|xwoche = F|tostring(U|xwoche)
.formula U|xtsel  = U|xwoche:8
.continue EL002 ? _(F|defined(U|xitab.xtsel))
.formula U|xiwoche = U|xitab.xtsel
.formula M|ytweek.xiwoche = M|ytweek.xiwoche + 9|ywert
!EL002
.formula M|ytstd.xi1      = M|ytstd.xi1      + 9|ywert  ? 'F|year(9|ydatum)' = 'M|yjahr'
.formula M|ytstdverteilt = M|ytstdverteilt + 9|ywert
.formula M|ytstdvj       = M|ytstdvj       + 9|ywert    ? 'F|year(9|ydatum)' < 'M|yjahr'
.formula M|ytstdfj       = M|ytstdfj       + 9|ywert    ? 'F|year(9|ydatum)' > 'M|yjahr'
.load 9 continue
.continue LOOP003
!ELOP003: ==============================
.formula M|ytpviststd = 0
.formula M|ytpvaktist = 0
.formula U|xtsel = "$,,ypvorgang==" + 0|id + ";yadatum<=" + U|xdedatum:8 + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xi1 = F|month(9|yadatum)
.formula M|ytstd.xi1     = M|ytstd.xi1 + 9|yarbzeit     ? 'F|year(9|yadatum)' = 'M|yjahr' & (F|month(9|yadatum) < F|month(G|datum) ; 'M|yjahr' < 'F|year(G|datum)')
.formula M|ytstdvj       = M|ytstdvj   + 9|yarbzeit     ? 'F|year(9|yadatum)' < 'M|yjahr'
.formula M|ytstdfj       = M|ytstdfj   + 9|yarbzeit     ? 'F|year(9|yadatum)' > 'M|yjahr'
.formula M|ytpviststd = M|ytpviststd + 9|yarbzeit       ? F|month(9|yadatum) <> F|month(G|datum) ; F|year(9|yadatum) <> F|year(G|datum)
.formula M|ytpvaktist = M|ytpvaktist + 9|yarbzeit       ? F|month(9|yadatum) =  F|month(G|datum) & F|year(9|yadatum) =  F|year(G|datum)
.load 9 continue
.continue LOOP004
!ELOP004: ==============================
.continue EL003 ? _(5|ypmsubistberech)
.formula U|xtsel = "$,,ytpvorgang==" + 0|id + ";ytdatum<=" + U|xdedatum:8 + ";yeinh<>`;@zeilen=(Yes);@filingmode=(Active)"
.load 9 group 'U|xydbgrsubmeldung' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.load 9 line '9|selzeile'
.assign U|xeinh = '9|yeinh(L="0")'
.continue EL004 ? _(_(F|empty(U|xeinh)))
.formula U|xrmge = 9|ymge
.formula U|xrmge = 9|ymge * F|unitconvfactor(U|xstunden,U|xeinh)        ? U|xstunden <> U|xeinh & F|unitconvfactor(U|xstunden,U|xeinh) <> 1
.formula U|xi1 = F|month(9|ytdatum)
.formula M|ytstd.xi1     = M|ytstd.xi1 + U|xrmge        ? 'F|year(9|ytdatum)' = 'M|yjahr' & (F|month(9|ytdatum) < F|month(G|datum) ; 'M|yjahr' < 'F|year(G|datum)')
.formula M|ytstdvj       = M|ytstdvj   + U|xrmge        ? 'F|year(9|ytdatum)' < 'M|yjahr'
.formula M|ytstdfj       = M|ytstdfj   + U|xrmge        ? 'F|year(9|ytdatum)' > 'M|yjahr'
.formula M|ytpviststd = M|ytpviststd + U|xrmge          ? F|month(9|ytdatum) <> F|month(G|datum) ; F|year(9|ytdatum) <> F|year(G|datum)
.formula M|ytpvaktist = M|ytpvaktist + U|xrmge          ? F|month(9|ytdatum) =  F|month(G|datum) & F|year(9|ytdatum) =  F|year(G|datum)
!EL004
.load 9 continue
.continue LOOP005
!ELOP005: ==============================
!EL003
.formula M|ystdplanrest      = M|ytpvplanstd   - M|ytpviststd - M|ytpvaktist
.formula M|ytstddiffvertfc   = M|ytstdverteilt - M|ytpvforecaststd
.formula M|ytstddiffistverts = M|ytpvsollstd   - M|ytpviststd - M|ytstdverteilt
.formula M|ytsumistvert      = M|ytpviststd    + M|ytstdverteilt
.formula M|ytbuverteilen = "icon:flash" ? _0|yablage & _0|ybmeilenstein & _0|ybstdvert
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.load 5 add F|sysinfo(10)^ykonfigprjm   ? _F|defined(5|ypmsubistberech)
.continue EL005 ? _(U|xbstart)
.continue EL006 ? _((_(F|empty(M|ykpvorgang))) ; (G|evtvar = "ybuverteilen") ; (G|evtvar = "ytbuverteilen"))
.load 0 add M|ykpvorgang        ? G|evtvar <> "ybuverteilen" & G|evtvar <> "ytbuverteilen"
.load 0 add M|ypvorgang         ? G|evtvar =  "ybuverteilen" ; G|evtvar =  "ytbuverteilen"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI006
!EL006
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="         + H|id
.formula U|xtsel = U|xtsel + ";yarbpaket=="        + M|yarbpaket^id             ? _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";yklassifizierung==" + M|yklassifizierung^id      ? _F|empty(M|yklassifizierung)
.formula U|xtsel = U|xtsel + ";yablage==0"                                      ? _M|ybpvinablage
.formula U|xtsel = U|xtsel + ";ydauer<>0"
.formula U|xtsel = U|xtsel + ";yistblatt==1"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@order=yissort"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.copy U|xbok = G|true
.continue EL007 ? _((_(F|empty(M|ypersonal))) ; (_(F|empty(M|yperstyp))))
.continue EL008 ? _(_(F|empty(0|ypersonal)))
.copy U|xbok = G|false        ? _F|empty(M|ypersonal) & M|ypersonal^id <> 0|ypersonal^id
.copy U|xbok = G|false        ? _F|empty(M|yperstyp)  & M|yperstypk    <> 0|ypersonal^yprjmperstypk
!EL008
.continue EL009 ? _(_(F|empty(0|yprojteam)))
.formula U|xtnummer = ((0|yprojteam^id)<<",")<<-1
.continue EL010 ? _(F|defined(U|xbteam.xtnummer))
.copy U|xbok = G|false        ? _U|xbteam.xtnummer
.continue FI010
!EL010
.type bool xbteam.xtnummer
.load 9 add 0|yprojteam
.load 9 line
!LOOP007: ==============================
.continue ELOP007 ? _((G|mehr) & (_(U|xbteam.xtnummer)))
.copy U|xbteam.xtnummer = G|true      ? _F|empty(M|ypersonal) & M|ypersonal^id = 9|ypersonal^id
.copy U|xbteam.xtnummer = G|true      ? _F|empty(M|yperstyp)  & M|yperstypk    = 9|ypersonal^yprjmperstypk
.load 9 line
.continue LOOP007
!ELOP007: ==============================
.copy U|xbok = G|false        ? _U|xbteam.xtnummer
!FI010
!EL009
.continue EL011 ? _(_(F|empty(0|ykstelle)))
.formula U|xtnummer = ((0|ykstelle^id)<<",")<<-1
.continue EL012 ? _(F|defined(U|xbkstelle.xtnummer))
.copy U|xbok = G|false        ? _U|xbkstelle.xtnummer
.continue FI012
!EL012
.type bool xbkstelle.xtnummer
.formula U|xtsel = "$,,kstelle==" + 0|ykstelle^id + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrpersonal' 'U|xtsel'
!LOOP008: ==============================
.continue ELOP008 ? _((G|mehr) & (_(U|xbkstelle.xtnummer)))
.copy U|xbkstelle.xtnummer = G|true      ? _F|empty(M|ypersonal) & M|ypersonal^id = 9|id
.copy U|xbkstelle.xtnummer = G|true      ? _F|empty(M|yperstyp)  & M|yperstypk    = 9|yprjmperstypk
.load 9 continue
.continue LOOP008
!ELOP008: ==============================
.copy U|xbok = G|false        ? _U|xbkstelle.xtnummer
!FI012
!EL011
.continue EL013 ? _((F|empty(0|ypersonal)) & (F|empty(0|yprojteam)) & (F|empty(0|ykstelle)))
.copy U|xbok = G|false
!EL013
!EL007
.continue EL014 ? _(U|xbok)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL014
.load 0 continue
.continue LOOP006
!ELOP006: ==============================
!FI006
.continue FI005
!EL005
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
!FI005
.input 'F|foppath("IFOP.IS.PRJMPVSTDPLAN.TAB")'     ? F|fileexists(F|foppath("IFOP.IS.PRJMPVSTDPLAN.TAB"))
.continue
