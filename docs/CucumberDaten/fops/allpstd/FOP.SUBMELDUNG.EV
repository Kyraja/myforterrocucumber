.assign  M|yzstyp     = ""              ? _F|defined(M|yteil^zptyp)
.copy    M|yprjmprkatart = M|yteil^yprjmprkatart
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
