!EL037
!FI036
.continue ESAC004
!BRK015
.continue BRK016 ? _(G|evtvar = "ymge")
.formula M|yekwert  = M|ymge * M|yekpreis
.formula M|ytsmwert = M|ymge * M|ytsmpreis
.continue ESAC004
!BRK016
.continue BRK017 ? _(G|evtvar = "yekpreis")
.formula M|yekwert = M|ymge * M|yekpreis
.continue ESAC004
!BRK017
.continue BRK018 ? _(G|evtvar = "yekwert")
.formula M|yekpreis = M|yekwert / M|ymge        ? _M|ymge = 0
.continue ESAC004
!BRK018
.continue BRK019 ? _(G|evtvar = "ytekreposvp")
.formula M|ytekreposid = M|ytekreposvp^id   ? _F|empty(M|ytekreposvp)
.formula M|ytekreposid = ""                 ?  F|empty(M|ytekreposvp)
.continue ESAC004
!BRK019
