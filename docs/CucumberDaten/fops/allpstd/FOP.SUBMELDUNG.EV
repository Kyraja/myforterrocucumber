!EL013
.continue EL014 ? _((_(F|defined(U|xtpvorgang.xtid))) & (G|evtkommd = G|kaktname13))
.formula U|xtid = "PV" + (M|ytpvorgang^id<<",")<<-1
.type text U|xtpvakt.xtid   ? _F|defined(U|xtpvakt.xtid)
!EL014
.select screen line
.continue LOOP004
!ELOP004: ==============================
.continue EL015 ? _(G|evtkommd = G|kaktname13)
.load 0 add M|id
.continue EL016 ? _(G|mehr)
.load 0 line "$,,ytpvorgang<>`"
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xtid = "PV" + (0|ytpvorgang^id<<",")<<-1
.type text U|xtpvold.xtid   ? _F|defined(U|xtpvold.xtid)
.continue EL017 ? _(_(F|defined(U|xtpvakt.xtid)))
.type text xtpvakt.xtid
.copy    U|xbignid    = G|TRUE
.copy    U|xbistzeit  = G|TRUE
.formula U|xtaufgabe  = ""
.formula U|xtpvorgang = 0|ytpvorgang^id
.input 'U|xtupgsvorgangakt'
!EL017
.load 0 line
