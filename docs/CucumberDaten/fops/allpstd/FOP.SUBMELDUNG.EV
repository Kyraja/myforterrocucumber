.box
'H|nummer': hat bereits die Referenz 'H|yreftyp' eingetragen.
.set TRANS -
.formula G|evtfeldneu = M|.evtvar^id
!FI025
.continue FI024
!EL024
.formula G|evtfeldneu = M|.evtvar^id
!FI024
.continue FI023
!EL023
.continue EL026 ? _((0|yistblatt) & ((F|empty(0|yreftypk)) ; (0|yreftypk = "04")))
.formula G|evtfeldneu = 0|id
