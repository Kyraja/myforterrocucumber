.input 'U|xtupprojleistkat' ? _F|empty(M|yprojekt)
.continue ESAC002
!BRK006
.continue BRK007 ? _(G|evtvar = "ytekreposvp")
.formula U|xydbgr = "4:2"
.formula U|xysel = ";projekt==" + M|yprojekt^id
.formula U|xysel = U|xysel + ";artex=;tename=;mge=;preis=;pwert=;pland=;verw=;typ=;.kotyp==(Invoice)"
.formula U|xysel = U|xysel + ";.kopf=="  + M|yekrechid  ? _F|empty(M|yekrechid)
.formula U|xysel = U|xysel + ";kopf=="                  ?  F|empty(M|yekrechid)
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue EL031 ? _(_(F|empty(G|evtfeldneu)))
.load 0 group "4:2" 'G|evtfeldneu'
.continue EL032 ? _(G|mehr)
.formula U|xt1 = ""
.set trans +
.formula U|xt1 = "Es sind nur Rechnungspositionen erlaubt."     ? _0|kotyp = G|REKO
.formula U|xt1 = "Die Position passt nicht zur Rechnung."       ? _0|kopf^id = M|yekrechid & _F|empty(M|yekrechid)
.set trans -
!EL032
.continue EL033 ? _(_(F|empty(U|xt1)))
.set trans +
.box Fehler
'U|xt1'
.set trans -
.error (0)
.end 1
!EL033
!EL031
