!ELOP006: ==============================
.continue ESAC001
!BRK003
.continue BRK004 ? _(G|evtart = "feldfuell")
.continue BRK005 ? _(G|evtvar = "ytpvorgang")
.continue EL020 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|regmatch(G|evtfeldneu, "\*.*"))) & (_(F|regmatch(G|evtfeldneu, "\$.*"))) & (_(F|regmatch(G|evtfeldneu, "\%.*"))))
.formula G|evtfeldneu = "?"     ? G|evtfeldneu = "!"
.continue EL021 ? _((F|regmatch(G|evtfeldneu, "\?")) ; (F|regmatch(G|evtfeldneu, "!,.*")) ; (F|regmatch(G|evtfeldneu, "\d.*")) ; (F|regmatch(G|evtfeldneu, "[a-zA-Z].*")))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";.yprojekt=="  + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";.yistblatt==1"
.formula U|xtsel = U|xtsel + ";@numsuch=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.select group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL022 ? _(G|mehr)
.load 0 add H|id
.select continue
.continue EL023 ? _(G|mehr)
.formula U|xtsel = "%,,"
.formula U|xtsel = U|xtsel + ";.yprojekt=="  + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";.yreftyp=="
.formula U|xtsel = U|xtsel + ";.yistblatt==1"
.formula U|xtsel = U|xtsel + ";@numsuch=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@autostart=(1);@dynschutz=(1);@gschutz=(1);@lschutz=(1)"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.select group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL024 ? _(G|mehr)
.continue EL025 ? _((H|yistblatt) & ((F|empty(H|yreftypk)) ; (H|yreftypk = "04")))
.formula G|evtfeldneu = H|id
.continue FI025
!EL025
