'0|nummer': hat bereits die Referenz '0|yreftyp' eingetragen.
.set TRANS -
.formula G|evtfeldneu = M|.evtvar^id
!FI026
!FI023
.continue FI022
!EL022
.continue EL027 ? _((G|evtfeldneu = "!") ; (G|evtfeldneu = "?"))
.set TRANS +
.box Hinweis
Kein Projektvorgang mit Referenz Beschaffung oder ohne eingetragene Referenz zum Projekt 'F|trim(F|tostring(M|yprojekt))' gefunden.
.set TRANS -
.formula G|evtfeldneu = ""
.continue FI027
!EL027
.formula U|xtsel = "$,,;@numsuch=" + G|evtfeldneu
.select group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL028 ? _(G|mehr)
.continue EL029 ? _(_(H|yistblatt))
.set TRANS +
.box
'G|evtfeldneu': ist ein Sammelvorgang.
.set TRANS -
.continue FI029
!EL029
.continue EL030 ? _((_(F|empty(H|yrefid))) & (_(H|yreftypk = "04")) & (H|yprojekt^id = M|yprojekt^id))
.set TRANS +
.box
'G|evtfeldneu': hat bereits die Referenz 'H|yreftyp' eingetragen.
.set TRANS -
.continue FI030
!EL030
.set TRANS +
.box
'G|evtfeldneu': passt nicht zum Projekt 'F|trim(F|tostring(M|yprojekt))'
.set TRANS -
!FI030
!FI029
.continue FI028
!EL028
.set TRANS +
.box
'G|evtfeldneu': nicht gefunden
.set TRANS -
!FI028
.error
.end 1
!FI027
!FI022
!EL021
!EL020
.continue ESAC002
!BRK005
