..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtzeile xtid xtaufgabe xtpvorgang xtmenue xtaupos xtaunum
.type text    xtcopyfile xtcopypath xttmppath xtarchiv xydbgr xysel xtmenu
.type text    xt1 xtprojleistkatid xttitel xttext1 xttext2
.type integer xispalte xi1
.type GD      xddat xdkonddat
.type P0      xpkunde
.type P2      xpart
.type P3:2    xpaupos
.type TAZ1    xpape
.type TAZ7    xeinh
.type bool    xbistzeit xbignid xbmehr
.type P86:1   xpproject xpprojekt
.type P142:1  xptppos
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- PV_in_Tabelle_pruefen -----
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL001 ? _((_(F|empty(M|ytpvorgang))) & (M|ytpvorgang^yprojekt^id <> M|yprojekt^id))
.assign M|ytpvorgang = ""
!EL001
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Wert_ermitteln -----
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpaartikel)
.copy    U|xpprojekt        = M|ytpvorgang^yprojekt
.assign  U|xdkonddat        = M|ytdatum
.formula U|xtprojleistkatid = M|ytpvorgang^yprojekt^yprojleistkatid
.copy    U|xpaartikel       = M|ytpvorgang^yvkartikel   ? _F|empty(M|ytpvorgang^yvkartikel)
.copy    U|xpkunde          = U|xpprojekt^ykunde
.assign  U|xpaupos          = M|ytpvorgang^yvorpos
.assign  U|xptppos          = M|ytpvorgang^ytppos
.input 'U|xtupartpreis'
.formula M|ytsmpreis = U|xyhpreis
.formula M|ytsmwert  = U|xyhpreis * M|ymge
.continue 'xprocst.xprocsp'
!PROC003: ----- Pruefung_SM_Aendern -----
.continue EL002 ? _(M|ablage)
.set TRANS +
.box Fehler
Die Submeldung befindet sich bereits in der Ablage.
.set TRANS -
.error
.end 1
.continue FI002
!EL002
.continue EL003 ? _(_(G|evtkommd = G|kaktname12))
.set TRANS +
.box Fehler
Der Vorgang ist nur im <zeigen> mîglich.
.set TRANS -
.error
.end 1
.continue FI003
!EL003
.continue EL004 ? _(M|ysperre)
.set TRANS +
.box Fehler
Die Submeldung ist derzeit zur Bearbeitung gesperrt.

gesperrt von: 'M|ysperrzeich', Zeitpunkt der Sperre: 'M|ysperrzp'
.set TRANS -
.error
.end 1
.continue FI004
!EL004
.select lock object 'M|id'
.continue EL005 ? _(_(G|mehr))
.set TRANS +
.box Fehler
Die Submeldung kann nicht zur Bearbeitung geladen werden.
.set TRANS -
.error
.end 1
!EL005
!FI004
!FI003
!FI002
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue EL006 ? _(_(G|evtkommd = G|kaktname12))
.input "allpstart/CHECK.RECORD.LOCK"
.continue EL007 ? _(G|mehr)
.continue EL008 ? _(_(F|empty(M|yprojekt)))
.copy U|xpproject = M|yprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL009 ? _(((M|yprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefpv))) ; (((M|yprojekt^ystatusk = "ABS") ; (M|yprojekt^ystatusk = "08") ; (M|yprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefpv))))
.set trans +
.formula U|xttitel = "Achtung"
.formula U|xttext1 = F|formatstr("Das Projekt {1} ist bereits abgeschlossen.", M|yprojekt^such)             ?  F|empty(M|yprojekt^ystatusk)
.formula U|xttext1 = F|formatstr("Das Projekt hat den Status {2}{1}{2}.", M|yprojekt^ystatus, G|dblquote)   ? _F|empty(M|yprojekt^ystatusk)
.formula U|xttext2 = F|formatstr("<{1}> nicht mehr erlaubt!", 'G|evtkommd')
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.error
.end 1         ? _G|wartung
!EL009
!EL008
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL010 ? _((_(F|empty(M|ytsmlsposid))) ; (_(F|empty(M|ytsmreposid))))
.set TRANS +
.box Achtung
Die Submeldung ist bereits
?im Lieferschein 'M|ytsmlsnum' eingetragen  ? _F|empty(M|ytsmlsnum)
?in der Rechnung 'M|ytsmrenum' eingetragen  ? _F|empty(M|ytsmrenum)
und darf nicht mehr bearbeitet werden!
.set TRANS -
.error
.end 1         ? _G|wartung
!EL010
.select screen line
.continue LOOP002
!ELOP002: ==============================
!EL007
!EL006
.continue EL011 ? _(_(G|evtkommd = G|kaktname10))
.assign  M|ysekrechnung   = M|yekrechid             ? _F|empty(M|yekrechid)
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.assign  M|yzstyp      = M|yteil^zptyp      ?  F|defined(M|yteil^zptyp)
.assign  M|ytsmlsposvp = M|ytsmlsposid      ? _F|empty(M|ytsmlsposid)
.assign  M|ytsmreposvp = M|ytsmreposid      ? _F|empty(M|ytsmreposid)
.assign  M|ytekreposvp = M|ytekreposid      ? _F|empty(M|ytekreposid)
.select screen line
.continue LOOP003
!ELOP003: ==============================
!EL011
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL012 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.select screen header
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL013 ? _(((_(M|ytdatum    = F|oldvalue(M|ytdatum))) ; (_(M|ytpvorgang = F|oldvalue(M|ytpvorgang)))) & (_(F|empty(M|ytpvorgang^yvkartikel))) & (F|empty(M|ytsmabrechnung)) & (F|empty(M|ytsmlsnum)) & (F|empty(M|ytsmlsposid)) & (F|empty(M|ytsmrenum)) & (F|empty(M|ytsmreposid)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
