.formula U|xtid = "PV" + (M|ytpvorgang^id<<",")<<-1
.continue EL019 ? _(_(F|defined(U|xtpvorgang.xtid)))
.type text xtpvorgang.xtid
.copy    U|xbistzeit  = G|TRUE
.formula U|xtaufgabe  = ""
.formula U|xtpvorgang = M|ytpvorgang^id
.input 'U|xtupgsvorgangakt'
!EL019
!EL018
.select screen line
