!EL038
.continue EL039 ? _(_(F|empty(M|yimportkonf)))
.continue EL040 ? _(_(F|empty(M|yimportdatei)))
.load 0 add M|yimportkonf
.continue EL041 ? _(G|mehr)
.continue EL042 ? _((_(F|empty(0|yimpskript))) & (_(F|fileexists(0|yimpskript))))
.formula U|xt1 = 0|yimpskript
.set trans +
.box Fehler
Das Import-Skript 'U|xt1' existiert nicht.
.set trans -
.error (0)
.end 1
!EL042
.formula U|xtcopyfile = "SUBIMP." + G|PID + "." + M|yimportdatei>$"\"   ?  M|yimportdatei/"*\\*"
.formula U|xtcopyfile = "SUBIMP." + G|PID + "." + M|yimportdatei        ? _M|yimportdatei/"*\\*"
.formula U|xttmppath  = "rmtmp/" + F|toupper(U|xtcopyfile)
.formula U|xtcopypath = G|dblquote + M|yimportdatei + G|dblquote + " " + G|dblquote + U|xttmppath + G|dblquote
.pc.copy 'U|xtcopypath'
.continue EL043 ? _(G|mehr)
.formula U|xtsys = "s3_conv 7 " + U|xttmppath
.system 'U|xtsys' BACKGROUND
.formula U|xispalte = 0
.select from 'U|xttmppath' xtzeile^
.continue EL044 ? _(G|mehr)
!LOOP007: ==============================
.continue ELOP007 ? _(_(F|empty(U|xtzeile)))
.formula U|xispalte = U|xispalte + 1
.formula U|xt1      = U|xtzeile<<0|ytrenner
.type text xtspalte.U|xispalte
.formula U|xtspalte.U|xispalte = F|toupper(U|xt1)
.formula U|xtzeile = U|xtzeile>>0|ytrenner
.continue LOOP007
!ELOP007: ==============================
.continue FI044
!EL044
.set TRANS +
.box Hinweis
Die Importdatei ist leer.
.set TRANS -
!FI044
.select from 'U|xttmppath' xtzeile^
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.formula U|xi1 = 0
.make screen line +O
!LOOP009: ==============================
.continue ELOP009 ? _(_(F|empty(U|xtzeile)))
.formula U|xt1 = U|xtzeile<<0|ytrenner
.formula U|xi1 = U|xi1 + 1
.continue EL045 ? _(F|defined(U|xtspalte.xi1))
.assign M|ytsubpersname = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspaltesubpers)
.assign M|ytdatum       = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspaltedatum)
.assign M|ytdatum       = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspaltedatum)
.assign M|ytazeit       = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspalteazeit)
.assign M|ytezeit       = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspalteezeit)
.assign M|ytleiort      = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspalteleiort)
.assign M|ytpvorgang    = U|xt1     ? U|xtspalte.U|xi1 = F|toupper(0|yspaltepvorgang)
.continue EL046 ? _(U|xtspalte.xi1 = F|toupper(0|yspalteteil))
.assign M|yteil          = U|xt1
!EL046
.assign M|yprjmprkatart  = U|xt1    ? U|xtspalte.U|xi1 = F|toupper(0|yspaltetyp)
.assign M|ybestellnummer = U|xt1    ? U|xtspalte.U|xi1 = F|toupper(0|yspaltebestnr)
.assign M|ytbeschreib    = U|xt1    ? U|xtspalte.U|xi1 = F|toupper(0|yspaltebeschreib)
.assign M|ymge           = U|xt1    ? U|xtspalte.U|xi1 = F|toupper(0|yspaltemge)
.assign M|yeinh          = U|xt1    ? U|xtspalte.U|xi1 = F|toupper(0|yspalteeinheit)
!EL045
.formula U|xtzeile = U|xtzeile>>0|ytrenner
.continue LOOP009
!ELOP009: ==============================
.input '0|yimpskript'   ? _F|empty(0|yimpskript)
.select from 'U|xttmppath' xtzeile^
.continue LOOP008
!ELOP008: ==============================
.continue EL047 ? _(F|fileexists(U|xttmppath))
.continue EL048 ? _(_(F|empty(M|yimportkonf^yarchivpfad)))
.formula U|xtarchiv = M|yimportkonf^yarchivpfad
.formula U|xtarchiv = U|xtarchiv + "/"          ? U|xtarchiv>>1 <> "/"
.formula U|xtarchiv = U|xtarchiv + M|yimportdatei>$"\"   ?  M|yimportdatei/"*\\*"
.formula U|xtarchiv = U|xtarchiv + M|yimportdatei        ? _M|yimportdatei/"*\\*"
.formula U|xtcopypath = G|dblquote + U|xttmppath + G|dblquote + " " + G|dblquote + U|xtarchiv + G|dblquote
.pc.copy -PC 'U|xtcopypath'
.continue EL049 ? _(G|mehr)
.formula M|yarchivdatei = U|xtarchiv
.continue FI049
!EL049
.set TRANS +
.box Hinweis
Beim Archivieren der Datei 'G|dblquote' 'M|yimportdatei' 'G|dblquote' ist ein Fehler aufgetreten.
Bitte ÅberprÅfen Sie den Archivpfad in der Importkonfiguration oder wenden sich an Ihren Systemadministrator.
.set TRANS -
!FI049
!EL048
!EL047
.continue FI043
!EL043
.set TRANS +
.box Hinweis
Beim kopieren der Datei 'G|dblquote' 'M|yimportdatei' 'G|dblquote' ist ein Fehler aufgetreten.
Bitte ÅberprÅfen Sie die Importdatei oder wenden sich an Ihren Systemadministrator.
.set TRANS -
!FI043
!EL041
.continue FI040
!EL040
.set TRANS +
.box Hinweis
Bitte wÑhlen Sie die zu importierende Datei.
.set TRANS -
!FI040
.continue FI039
!EL039
.set TRANS +
.box Hinweis
Bitte wÑhlen Sie eine Importkonfiguration.
.set TRANS -
!FI039
!FI038
.continue ESAC006
!BRK023
.continue BRK024 ? _(G|evtvar = "ytbusmkorrektur")
.load 5 add F|sysinfo(10)^ykonfigprjm
.select lock object 'M|id'
.continue EL050 ? _(G|mehr)
.select lock line 'M|aktzeile'
.set TRANS +
.menu Korrektur Zuordnung Maschinenzeit
Lieferscheinposition Ñndern   >>.formula U|xtmenu = "1"
?Lieferscheinposition entfernen>>.formula U|xtmenu = "2"         ? _F|empty(H|ytsmlsposid)
Rechnungsposition Ñndern      >>.formula U|xtmenu = "3"
?Rechnungsposition entfernen   >>.formula U|xtmenu = "4"         ? _F|empty(H|ytsmreposid)
Teilprojektposition Ñndern    >>.formula U|xtmenu = "5"
?Teilprojektposition entfernen >>.formula U|xtmenu = "6"         ? _F|empty(H|ytsmtpposid)
.set TRANS -
.continue EL051 ? _(_(G|menue = 0))
.continue EL052 ? _((U|xtmenu = "1") ; (U|xtmenu = "3") ; (U|xtmenu = "5"))
.continue EL053 ? _(U|xtmenu = "5")
.formula U|xtsel = "%,,;ypnum=;yartex=;ymge=;yptext="
.formula U|xtsel = U|xtsel + ";yteilprojekt=="  + M|yprojekt^id  ?  5|ypmabrechproj
.formula U|xtsel = U|xtsel + ";.yteilprojekt==" + M|yprojekt^id  ? _5|ypmabrechproj

.formula U|xtsel = U|xtsel + ";.ytpverrechanf<>`"
.formula U|xtsel = U|xtsel + ";.yorig<>`"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
.continue EL054 ? _(G|mehr)
.continue EL055 ? _((_(5|ypmabrechproj)) & (0|yteilprojekt^id <> M|yprojekt^id))
.set TRANS +
.box Fehler
"Abrechnung auf andere Projekte erlauben" in der ProjectSuite Konfiguration ist nicht gesetzt.
Alle abzurechnenden Submeldungen mÅssen zum Projekt 'F|trim(F|tostring(M|yprojekt))' gehîren.
.set TRANS -
.error
.end 1
!EL055
.formula H|ytsmtpposid        = 0|id
.rewrite
!EL054
.continue FI053
!EL053
.formula U|xtsel = "%,,kopf=;kopf^kunde==" + M|yprojekt^ykunde^id + ";kovom=;art=;mge=;he=;typ==(" + 'G|ARPOS' + ")"
.formula U|xtsel = U|xtsel + ";projekt=="  + M|yprojekt^id              ?  5|ypmabrechproj
.formula U|xtsel = U|xtsel + ";.projekt==" + M|yprojekt^id              ? _5|ypmabrechproj
.formula U|xtsel = U|xtsel + ";.kotyp==(" + 'G|LIKO' + ")"              ?  U|xtmenu = "1"
.formula U|xtsel = U|xtsel + ";.kotyp==(" + 'G|REKO' + ")"              ?  U|xtmenu = "3"
.load 0 group "3:2" 'U|xtsel'
.continue EL056 ? _(G|mehr)
.continue EL057 ? _(((0|kotyp = G|LIKO) & (U|xtmenu = "1")) ; ((0|kotyp = G|REKO) & (U|xtmenu = "3")))
.continue EL058 ? _((_(5|ypmabrechproj)) & (0|projekt^id <> M|yprojekt^id))
.set TRANS +
.box Fehler
"Abrechnung auf andere Projekte erlauben" in der ProjectSuite Konfiguration ist nicht gesetzt.
Alle abzurechnenden Submeldungen mÅssen zum Projekt 'F|trim(F|tostring(M|yprojekt))' gehîren.
.set TRANS -
.error
.end 1
!EL058
.formula U|xtaupos = ""
.formula U|xtaunum = ""
.continue EL059 ? _(_(F|empty(0|orig)))
.add 0|orig
.assign U|xbmehr = G|mehr
!LOOP010: ==============================
.continue ELOP010 ? _(U|xbmehr)
.continue EL060 ? _((D|kotyp = G|ABKO) ; (D|kotyp = G|LIKO))
.continue EL061 ? _(D|kotyp = G|LIKO)
.add D|orig
.assign U|xbmehr = G|mehr
.continue FI061
!EL061
.formula U|xtaupos = D|id
.formula U|xtaunum = D|kopf^nummer
.assign  U|xbmehr  = G|FALSE
!FI061
.continue FI060
!EL060
.add D|orig
.assign U|xbmehr = G|mehr
!FI060
.continue LOOP010
!ELOP010: ==============================
!EL059
.formula H|ytsmlsposid = 0|id            ? U|xtmenu = "1"
.formula H|ytsmlsnum   = 0|kopf^nummer   ? U|xtmenu = "1"
.formula H|ytsmreposid = 0|id            ? U|xtmenu = "3"
.formula H|ytsmrenum   = 0|kopf^nummer   ? U|xtmenu = "3"
.rewrite
.continue FI057
!EL057
.set TRANS +
.box Fehler
?Es sind nur Lieferscheinpositionen erlaubt.    ? U|xtmenu = "1"
?Es sind nur Rechnungspositionen erlaubt.       ? U|xtmenu = "3"
.set TRANS -
.continue
!FI057
!EL056
!FI053
.continue FI052
!EL052
.formula H|ytsmlsposid = ""      ?  U|xtmenu = "2"
.formula H|ytsmlsnum   = ""      ?  U|xtmenu = "2"
.formula H|ytsmreposid = ""      ?  U|xtmenu = "4"
.formula H|ytsmrenum   = ""      ?  U|xtmenu = "4"
.formula M|ytsmtpposid        = ""   ? U|xtmenu = "6"
.rewrite
!FI052
!EL051
.continue FI050
!EL050
.set TRANS +
.box Fehler
Die Submeldung kann nicht zur Bearbeitung geladen werden.
.set TRANS -
.continue
!FI050
.continue
.continue ESAC006
