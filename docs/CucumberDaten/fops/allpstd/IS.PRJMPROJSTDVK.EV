..!interpreter english declaration noabbrev
.. at 2016-09-05, 13:17
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMPROJSTDVK.EV
..==  Pfad              : allpstd
..==  Funktion          :
..==  Erstellungsdatum  : 28.02.2011
..==  Autor             : Sebastian Strobel, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtcmd xtsel xykoobjekt xtid xysel
.type text    xtprojekt xtpindex xtfarbe
.type text    xtvkmerk xtpemerk xtqumerk xtprmerk
.type integer xivar xipindex xizeile
.type real    xrprarb xrprfakt xrquarb xrqufakt xrpearb xrpefakt xrvkarb xrvkfakt
.type GD19    xdvon xdbis
.type GD      xddat
.type bool    xyberlaubt xbmehr
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.continue EL001 ? _(F|defined(M|ystdvondatum))
.formula U|xdvon        = "<M+1M-1Y"
.formula M|ystdvondatum = U|xdvon
!EL001
.continue EL002 ? _(F|defined(M|ystdbisdatum))
.formula U|xdbis        = ">M"
.formula m|ystdbisdatum = U|xdbis
!EL002
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldfuell")
.continue BRK003 ? _(G|evtvar = "yvkauftrag")
.formula U|xysel  = "yprjmproj=="   + M|yprojekt^id
.formula U|xysel  = U|xysel + ";betreff=;kunde=;kunde^namebspr="
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "yvkaupos")
.formula U|xysel = ";pnum=;artex=;ptext=;mge=;preis=;pwert=;
.formula U|xysel = U|xysel + ";projekt=="                             ?  F|empty(M|yprojekt) ; _F|empty(M|yvkauftrag)
.formula U|xysel = U|xysel + ";.projekt==" + M|yprojekt^id            ? _F|empty(M|yprojekt) &  F|empty(M|yvkauftrag)
.formula U|xysel = U|xysel + ";kopf^nummer="                ?  F|empty(M|yvkauftrag)
.formula U|xysel = U|xysel + ";.kopf==" + M|yvkauftrag^id   ? _F|empty(M|yvkauftrag)
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "ypvorgang")
.copy M|yprojekt  = M|ypvorgang^yprojekt    ? _F|empty(M|ypvorgang)
.input 'U|xtupprjmsel'
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ystdvondatum")
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "ystdbisdatum")
.continue EL003 ? _(M|ystdbisdatum < M|ystdvondatum)
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
!EL003
.cursor yvkauftrag 0      ? F|defined(M|yvkauftrag)
.continue ESAC003
!BRK008
.input 'U|xtupprjmsel'
.continue EL004 ? _(G|evtvar<<4 = "ykst")
.formula M|yvkauftrag  = ""
.formula M|yvkaupos    = ""
.formula M|yposnum     = ""
!EL004
!ESAC003: =====   ENDCASE   =====
.make screen line --O
.continue ESAC001
!BRK005
.continue BRK009 ? _(G|evtart = "buttonvor")
.continue BRK010 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC004
!BRK010
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK009
.continue BRK011 ? _(G|evtart = "buttonnach")
.continue BRK012 ? _(G|evtvar = "bstart")
.input 'U|xtupprjmsel'
.continue ESAC005
!BRK012
.continue BRK013 ? _(G|evtvar = "ylm")
.formula U|xtcmd = G|kkomname38 + " PRJMLM "
.formula U|xtcmd = U|xtcmd + "?ystdvondatum="     + M|ystdvondatum:8
.formula U|xtcmd = U|xtcmd + "|ystdbisdatum="     + M|ystdbisdatum:8
.formula U|xtcmd = U|xtcmd + "|yprojekt="         + M|ytprojekt^id          ? _F|empty(m|ytprojekt)
.formula U|xtcmd = U|xtcmd + "|yvkauftrag="       + M|ytvkauftrag^id        ? _F|empty(m|ytvkauftrag)
.formula U|xtcmd = U|xtcmd + "|yvkaupos="         + M|ytaupos^id            ? _F|empty(m|ytaupos)
.formula U|xtcmd = U|xtcmd + "|ypersonal="        + M|ytpersonal^id         ? _F|empty(m|ytpersonal)
.formula U|xtcmd = U|xtcmd + "|bstart="
.command -PARALLEL 'U|xtcmd'
.continue ESAC005
!BRK013
!ESAC005: =====   ENDCASE   =====
.continue ESAC001
!BRK011
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMPROJSTDVK.EV")'      ? F|fileexists(F|foppath("IFOP.IS.PRJMPROJSTDVK.EV"))
.continue
