..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMSUBMELDUNG.TAB
..==  Pfad              : allpstd
..==  Funktion          : Laden der Tabellen zeilen fr IS PRJMSUBMELDUNG
..==  Erstellungsdatum  : 13.09.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2015 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="   + H|id
.formula U|xtsel = U|xtsel + ";yekrechid=="  + M|yekrechnung^id     ? _F|empty(M|yekrechnung)
.formula U|xtsel = U|xtsel + ";ylieferant==" + M|ylief^id           ? _F|empty(M|ylief)
.formula U|xtsel = U|xtsel + ";yvondatum>="  + M|yleistzraumvon:8   ? _F|empty(M|yleistzraumvon)
.formula U|xtsel = U|xtsel + ";ybisdatum<="  + M|yleistzraumbis:8   ? _F|empty(M|yleistzraumvon)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'M|grliste' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.make screen line +O
.assign  M|ytsubmeldung    = 0|id
.copy    M|ytprojekt       = 0|yprojekt
.formula M|ytprojname      = M|ytprojekt^namebspr
.assign  M|ytekrechnung    = 0|yekrechid
.formula M|ytekrechbetreff = M|ytekrechnung^betreff
.copy    M|ytlief          = 0|ylieferant
.formula M|ytliefname      = M|ytlief^namebspr
.copy    M|ytleistzraumvon = 0|yvondatum
.copy    M|ytleistzraumbis = 0|ybisdatum
.load 0 line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.make screen line +O    ? 0|aktzeile > 1
.formula M|ytsubpersname   = 0|ytsubpersname
.copy    M|ytdatum         = 0|ytdatum
.formula M|ytbestellnummer = 0|ybestellnummer
.copy    M|ytteil          = 0|yteil
.formula M|ytteilname      = M|ytteil^namebspr
.copy    M|ytprjmprkatart  = 0|yprjmprkatart
.copy    M|ytzstyp         = M|ytteil^zptyp ? F|defined(M|ytteil^zptyp)
.formula M|ytmge           = 0|ymge
.copy    M|yteinh          = 0|yeinh
.formula M|ytbeschreib     = 0|ytbeschreib
.assign  M|ytsmlsposvp     = 0|ytsmlsposid
.assign  M|ytsmlsnum       = M|ytsmlsposvp^kopf^id
.assign  M|ytsmreposvp     = 0|ytsmreposid
.assign  M|ytsmrenum       = M|ytsmreposvp^kopf^id
.assign  M|ytsmmtppos      = 0|ytsmmtppos
.formula M|yttpsmpreis     = 0|yttpsmpreis
.continue EL001 ? _(_(F|empty(0|ytsmabrtext)))
.select from '0|ytsmabrtext'
.formula M|ytsmabrtext = 0|ytsmabrtext
!EL001
.load 0 line
.continue LOOP002
!ELOP002: ==============================
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.input 'F|foppath("IFOP.IS.PRJMSUBMELDUNG.TAB")'    ? F|fileexists(F|foppath("IFOP.IS.PRJMSUBMELDUNG.TAB"))
.continue
