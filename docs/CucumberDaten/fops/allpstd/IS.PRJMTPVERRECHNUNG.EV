!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "buttonnach")
.continue BRK006 ? _(G|evtvar = "bstart")
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yhauptprojekt=="           + M|yhauptprojekt^id  ? _F|empty(M|yhauptprojekt)
.formula U|xtsel = U|xtsel + ";yhauptprojekt^yprojleit==" + M|yhprojleit^id     ? _F|empty(M|yhprojleit)
.formula U|xtsel = U|xtsel + ";yteilprojekt=="            + M|yteilprojekt^id   ? _F|empty(M|yteilprojekt)
.formula U|xtsel = U|xtsel + ";yteilprojekt^yprojleit=="  + M|ytprojleit^id     ? _F|empty(M|ytprojleit)
.formula U|xtsel = U|xtsel + ";ydatum=" + 'M|yvondat' + "!" + 'M|ybisdat'       ? _F|empty(M|yvondat) ; _F|empty(M|ybisdat)
.formula U|xtsel = U|xtsel + ";ytransaktion=`"                                  ? _M|ybabgelegt
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.select group 'U|xydbgrtpverrechanf' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy U|xbok = G|TRUE
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue EL015 ? _((U|xbok) ; (U|xbtpok))
.make screen line +O
.assign M|yttpanf        = H|id
.assign M|yttpanfname    = H|namebspr
.copy   M|ythprojekt     = H|yhauptprojekt
.copy   M|ythprojleit    = H|yhauptprojekt^yprojleit
.copy   M|yttprojekt     = H|yteilprojekt
.copy   M|yttprojleit    = H|yteilprojekt^yprojleit
.assign M|ytverrechwert  = H|ybetrag
.assign M|ytvaeigenleist = H|yvaeigenleist
.assign M|ytvafremdleist = H|yvafremdleist
.assign M|ytvasonstkost  = H|yvasonstkost
.assign M|ytvafertleist  = H|yvafertleist
.assign M|ytgeswert      = H|yteilprojekt^ytpwert
.copy   M|ytdatum        = H|ydatum
.copy   M|ytfreidat      = H|yfreidat
.assign M|ytfreidurch    = H|yfreidurch
.copy   M|yttransaktion  = H|ytransaktion
.protection ybfreigeben 'M|aktzeile'        ? _F|empty(H|ytransaktion) ; _U|xbok
.protection ytdatum     'M|aktzeile'        ? _F|empty(H|ytransaktion) ; _U|xbok
.protection yttpanfname 'M|aktzeile'        ? _F|empty(H|ytransaktion) ; _U|xbok
.colour -BACKGROUND -1 -1 -1 'M|aktzeile'
!EL015
.select continue
.continue LOOP001
!ELOP001: ==============================
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ybufreigeben")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.input is/ABASFARBEN.DEF
.copy U|xbok = G|FALSE
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL016 ? _((_(F|empty(M|yttpanf))) & (F|empty(M|yttpanf^ytransaktion)))
.continue EL017 ? _(M|ybfreigeben)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC003
!RET002
