.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC004
!RET003
.formula xprocsp = xprocsp - 1
!EL017
.continue EL018 ? _((M|ytdatum     <> M|yttpanf^ydatum) ; (M|yttpanfname <> M|yttpanf^namebspr))
.select lock add M|yttpanf
.continue EL019 ? _(G|mehr)
.assign  H|ydatum = M|ytdatum
.formula H|name   = M|yttpanfname
.rewrite
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
!EL019
!EL018
!EL016
.copy U|xbok = G|TRUE         ? M|ybfreigeben
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue EL020 ? _(U|xbok)
.continue EL021 ? _(((F|cmdpermitted(U|xydbtrans, 12)) & (F|cmdpermitted(U|xydbtrans, 13)) & (F|cmdpermitted(U|xydbtrans, 14)) & (F|cmdpermitted(U|xydbtransdat, 12)) & (F|cmdpermitted(U|xydbtransdat, 13)) & (F|cmdpermitted(U|xydbtransdat, 14))) ; ((_(F|empty(F|sysinfo(10)^ykonfigprjm^ybatchuser))) & (F|sysinfo(10)^ykonfigprjm^ybatchuser^fremdok)))
.set TRANS +
.box -BUTTON yes:no -TITLE Hinweis
Sollen alle markierten Teilprojektverrechnungen freigegeben werden?
.set TRANS -
.continue EL022 ? _(G|box = G|boxyes)
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL023 ? _((_(F|empty(M|yttpanf))) & (M|ybfreigeben))
.load 9 add M|yttpanf
.input allpstd/FOP.PRJM.UP.TPVERRECHANF.BUCHEN
.load 9 add M|yttpanf
.continue EL024 ? _(G|mehr)
.continue EL025 ? _(_(F|empty(9|ytransaktion)))
.copy M|yttransaktion = 9|ytransaktion
.copy M|ybfreigeben   = G|false
.protection ybfreigeben 'M|aktzeile'
.protection ytdatum     'M|aktzeile'
.protection yttpanfname 'M|aktzeile'
.colour -background 'U|xabaslightgreen' 'M|aktzeile'
.continue FI025
!EL025
.set TRANS +
.box
Die Teilprojektverrechnung in Zeile 'M|aktzeile'
konnte nicht freigegeben werden.

Bitte prÅfen.
.set TRANS -
.formula M|ybfreigeben = G|FALSE
!FI025
