!ELOP003: ==============================
!LOOP004: ==============================
.continue ELOP004 ? _(_(F|empty(U|xttpid)))
.formula U|xt1 = U|xttpid<<"###"
.select lock group 'U|xydbgrprojekt' 'U|xt1'
.continue EL026 ? _(G|mehr)
.formula U|xrbetrag = 0
.formula U|xtsel = "$,,yteilprojekt==" + H|id + ";@ablageart=(1)"
.load 0 group 'U|xydbgrtpverrechanf' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xrbetrag = U|xrbetrag + 0|ybetrag
.load 0 continue
.continue LOOP005
!ELOP005: ==============================
.formula H|ytpoffwert = H|ytpwert - U|xrbetrag
.rewrite
.continue FI026
!EL026
.set TRANS +
