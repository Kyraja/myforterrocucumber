.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/TRANS.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtcmd xttpid xt1 xykoobjekt xbuchtyp xttitel xttext1 xttext2
.type real    xrbetrag
.type GD      xbudat
.type bool    xyberlaubt xbok xbtpok
.type P86:1   xpproject
.type integer xprocsp           ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Rechtepruefung_TPVerrechnungsanforderung -----
.continue EL001 ? _(U|xypmrepruefkst)
.copy U|xbok = G|FALSE
.formula U|xykoobjekt = H|yhauptprojekt^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.copy U|xbok   = G|TRUE         ? U|xyberlaubt
.formula U|xykoobjekt = H|yteilprojekt^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.copy U|xbtpok = G|TRUE         ? U|xyberlaubt
!EL001
.continue EL002 ? _(U|xypmrepruefktr)
.copy U|xbok = G|FALSE
.formula U|xykoobjekt = H|yhauptprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
.copy U|xbok   = G|TRUE       ? U|xyberlaubt
.formula U|xykoobjekt = H|yteilprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
.copy U|xbtpok = G|TRUE       ? U|xyberlaubt
!EL002
.continue EL003 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.assign U|xbok = U|xyberlaubt
!EL003
.continue 'xprocst.xprocsp'
!PROC002: ----- Rechtepruefung_Eingabe -----
.continue EL004 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = M|.evtvar^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.continue EL005 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set TRANS -
.formula M|.evtvar = ""
.continue
!EL005
!EL004
.continue EL006 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = M|.evtvar^yktr^id
.input 'U|xypmrepruefktrprog'
.continue EL007 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set TRANS -
.formula M|.evtvar  = ""
.continue
!EL007
!EL006
.continue EL008 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL009 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set TRANS -
.formula M|.evtvar = ""
.continue
!EL009
!EL008
.continue 'xprocst.xprocsp'
!PROC003: ----- Hauptprojekt_pruefen -----
.continue EL010 ? _((_(F|empty(M|ythprojekt))) & (M|ybfreigeben))
.copy U|xpproject = M|ythprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL011 ? _(((M|ythprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefvanf))) ; (((M|ythprojekt^ystatusk = "ABS") ; (M|ythprojekt^ystatusk = "08") ; (M|ythprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefvanf))))
.set trans +
.formula U|xttitel = "Fehler"
.formula U|xttext1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", M|ythprojekt^such, G|dblquote, M|ythprojekt^ystatus)
.formula U|xttext2 = "Teilprojektverrechnungen dÅrfen nicht mehr freigegeben werden!"
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.copy M|ybfreigeben = G|false
.error
.end 1
!EL011
!EL010
.continue 'xprocst.xprocsp'
!PROC004: ----- Buchungsdatum -----
.continue EL012 ? _(_(F|empty(M|ytdatum)))
.copy    U|xbudat   = M|ytdatum
.formula U|xbuchtyp = "S"
.input "allpstart/PRUEF.BUDAT"
.continue EL013 ? _(_(U|xbbuchbar))
.set TRANS +
.box Hinweis
Das Datum 'U|xbudat' liegt in einer abgeschlossenen Periode.
.set TRANS -
.copy M|ytdatum     = M|yttpanf^ydatum
.copy M|ybfreigeben = G|FALSE
.error
.end 1
!EL013
.continue FI012
!EL012
.continue EL014 ? _(G|evtvar = "ybfreigeben")
.set TRANS +
.box Hinweis
Vor der Freigabe bitte das Buchungsdatum eintragen.
.set TRANS -
.formula M|ybfreigeben = G|FALSE
.cursor ytdatum 'M|aktzeile'
.error
.end 1
!EL014
!FI012
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskende")
.end .          ? M|ybmaskezu
.continue ESAC001
!BRK002
