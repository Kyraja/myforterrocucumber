.continue EPROCDEF
!PROC001: ----- Hauptprojekt_pruefen -----
.copy U|xpproject = M|yhauptprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL001 ? _(((M|yhauptprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefvanf))) ; (((M|yhauptprojekt^ystatusk = "ABS") ; (M|yhauptprojekt^ystatusk = "08") ; (M|yhauptprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefvanf))))
.set trans +
.formula U|xttitel = "Fehler"
.formula U|xttext1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", H|yhauptprojekt^such, G|dblquote, H|yhauptprojekt^ystatus)
.formula U|xttext2 = "Teilprojektverrechnungen dÅrfen nicht mehr erfasst werden!"
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.error
.end 1
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Rechtepruefung_TPVerrechnungsanforderung -----
.continue EL002 ? _(U|xypmrepruefkst)
.assign U|xbok = G|FALSE
.formula U|xykoobjekt = H|yhauptprojekt^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.assign U|xbok   = G|TRUE       ? U|xyberlaubt
.formula U|xykoobjekt = H|yteilprojekt^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.assign U|xbtpok = G|TRUE       ? U|xyberlaubt
!EL002
.continue EL003 ? _(U|xypmrepruefktr)
.assign U|xbok = G|FALSE
.formula U|xykoobjekt = H|yhauptprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
.assign U|xbok   = G|TRUE       ? U|xyberlaubt
.formula U|xykoobjekt = H|yteilprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
.assign U|xbtpok = G|TRUE       ? U|xyberlaubt
!EL003
.continue EL004 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.assign U|xbok = U|xyberlaubt
!EL004
.continue 'xprocst.xprocsp'
!PROC003: ----- VA_Storno_Leistungsmeldungen -----
.load 1 group 'U|xydbgrlnachweis' 'F|expr("$,," + U|xtvar + "==" + 0|id + ";@ablageart=(1)")'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
