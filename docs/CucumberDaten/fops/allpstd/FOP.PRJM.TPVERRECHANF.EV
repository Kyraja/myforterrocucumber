.formula H|ytpoffwert = H|ytpwert
.load 0 group 'U|xydbgrtpverrechanf' 'F|expr("$,,yteilprojekt==" + H|id + ";@ablageart=(1)")'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
