!PROC005: ----- offener_Wert -----
.select lock group 'U|xydbgrprojekt' 'H|yteilprojekt^id'
.continue EL021 ? _(G|mehr)
.formula U|xrbetrag = 0
.formula U|xtsel = "$,,yteilprojekt==" + H|id + ";@ablageart=(1)"
.load 0 group 'U|xydbgrtpverrechanf' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xrbetrag = U|xrbetrag + 0|ybetrag
.load 0 continue
.continue LOOP004
!ELOP004: ==============================
.formula H|ytpoffwert = H|ytpwert - U|xrbetrag
.rewrite
.continue FI021
!EL021
.set TRANS +
.box Fehler
Das Teilprojekt 'M|yteilprojekt' kann nicht bearbeitet werden.

Der offene Wert kann nicht aktualisiert werden.
.set TRANS -
!FI021
.continue 'xprocst.xprocsp'
!PROC006: ----- Kostenbuchung_stornieren -----
.continue EL022 ? _(G|evtkommd = G|kaktname12)
.select group 'U|xydbgrtpverrechanf' 'M|id'
.continue EL023 ? _(G|mehr)
.continue EL024 ? _(_(F|empty(H|ytransaktion)))
