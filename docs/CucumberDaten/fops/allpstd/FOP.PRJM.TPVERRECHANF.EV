.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbprojekt)
.input "allpstart/TRANS.KONFIG.INI" ? _F|defined(U|xydbtrans)
.input "allpstart/FOP.PRJM.UP.DEF"  ? _F|defined(U|xtupstornorecht)
..====================================================
.type text    xtsys xtsel xykoobjekt xyprojekt xtvar xbuchtyp
.type text    xttransini xttransdat xttransprot xttransleer xttitel xttext1 xttext2
.type real    xrbetrag xrsumme
.type GD      xybudat xbudat
.type bool    xyberlaubt xbok xbtpok xbstorno
.type P86:1   xpproject
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
