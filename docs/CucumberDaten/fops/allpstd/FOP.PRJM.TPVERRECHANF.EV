.continue BRK012 ? _(G|evtvar = "yteilprojekt")
.assign  M|yhauptprojekt = M|yteilprojekt^yteilprojektzu^id
.formula M|such          = M|yteilprojekt^such
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET015" 
.continue PROC001
!RET015
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK012
.continue BRK013 ? _(G|evtvar = "yvaeigenleist")
.formula M|yvafremdleist = M|ybetrag - M|yvaeigenleist - M|yvasonstkost - M|yvafertleist
.continue ESAC003
!BRK013
.continue BRK014 ? _(G|evtvar = "ylohnanteil")
.formula M|yvafremdleist = M|ybetrag - M|yvaeigenleist - M|yvasonstkost - M|yvafertleist
.continue ESAC003
!BRK014
.continue BRK015 ? _(G|evtvar = "yvafremdleist")
.formula M|yvaeigenleist = M|ybetrag - M|yvafremdleist - M|yvasonstkost - M|yvafertleist
.continue ESAC003
!BRK015
.continue BRK016 ? _(G|evtvar = "ymatanteil")
.formula M|yvaeigenleist = M|ybetrag - M|yvafremdleist - M|yvasonstkost - M|yvafertleist
.continue ESAC003
!BRK016
.continue BRK017 ? _(G|evtvar = "yvasonstkost")
.formula M|yvafremdleist = M|ybetrag - M|yvaeigenleist - M|yvasonstkost - M|yvafertleist
.continue ESAC003
!BRK017
.continue BRK018 ? _(G|evtvar = "yvafertleist")
.formula M|yvafremdleist = M|ybetrag - M|yvaeigenleist - M|yvasonstkost - M|yvafertleist
.continue ESAC003
!BRK018
.continue BRK019 ? _(G|evtvar = "ydatum")
.continue EL056 ? _(_(F|empty(M|ydatum)))
.copy    U|xbudat   = M|ydatum
.formula U|xbuchtyp = "S"
.input "allpstart/PRUEF.BUDAT"
.continue EL057 ? _(_(U|xbbuchbar))
.set TRANS +
.box Hinweis
Das Datum 'U|xbudat' liegt in einer abgeschlossenen Periode.
.set TRANS -
.formula M|ydatum = ""
.error
.end 1
!EL057
!EL056
.continue ESAC003
!BRK019
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK010
!ESAC001: =====   ENDCASE   =====
.continue
