.continue EL027 ? _(G|evtvar<<5 = "ytstd")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ?_F|defined(5|ybstdvertverg)
.formula U|ximonat = G|evtvar>>"ytstd"
.formula U|xrhours = M|.evtvar
.load 9 add M|ypvorgang
.formula U|xdadatum = 'M|yjahr' + ("0" + 'U|ximonat')>>2 + "01"
.formula U|xdedatum =  U|xdadatum + 31
.formula U|xdedatum = 'U|xdedatum:8'<<6 + "01"
.formula U|xdedatum =  U|xdedatum - 1
.copy U|xdzstart = U|xdadatum
.copy U|xdzend   = U|xdedatum
.formula U|xdadatum = G|datum               ? U|xdadatum < G|datum & _5|ybstdvertverg
.formula U|xdadatum = M|ypvorgang^yadatum   ? M|ypvorgang^yadatum > U|xdadatum
.formula U|xytpuffer = "H"
.input "java:de.alltrotec.ps.control.HoursDistribution@ALLPS"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET024" 
.continue PROC010
!RET024
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET025" 
.continue PROC008
!RET025
.formula xprocsp = xprocsp - 1
.formula M|.evtvar = U|xrhours
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET026" 
.continue PROC002
!RET026
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET027" 
.continue PROC003
!RET027
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET028" 
.continue PROC006
!RET028
.formula xprocsp = xprocsp - 1
!EL027
.continue EL028 ? _(G|evtvar<<6 = "ytweek")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ?_F|defined(5|ybstdvertverg)
.formula U|xwoche = F|tostring(M|yjahr) + "0104"
.formula U|xwkw1  = F|tostring(U|xwoche)
.formula U|xiwoche = G|evtvar>>"ytweek"
.formula U|xi1     = (7 * (U|xiwoche - 1))
.formula U|xwoche  = U|xwkw1 + U|xi1
.formula U|xrhours = M|.evtvar
.load 9 add M|ypvorgang
.formula U|xdadatum =  U|xwoche - 2
.formula U|xdedatum =  U|xwoche + 4
.copy U|xdzstart = U|xdadatum
.copy U|xdzend   = U|xdedatum
.formula U|xdadatum = G|datum               ? U|xdadatum < G|datum & _5|ybstdvertverg
.formula U|xdadatum = M|ypvorgang^yadatum   ? M|ypvorgang^yadatum > U|xdadatum
.formula U|xytpuffer = "H"
.input "java:de.alltrotec.ps.control.HoursDistribution@ALLPS"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET029" 
.continue PROC010
!RET029
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET030" 
.continue PROC008
!RET030
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET031" 
.continue PROC002
!RET031
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET032" 
.continue PROC003
!RET032
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET033" 
.continue PROC006
!RET033
.formula xprocsp = xprocsp - 1
!EL028
.continue FI026
!EL026
.input 'U|xtupprjmsel'
!FI026
!ESAC005: =====   ENDCASE   =====
.continue ESAC001
!BRK015
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMPVSTDPLAN.EV")'  ? F|fileexists(F|foppath("IFOP.IS.PRJMPVSTDPLAN.EV"))
