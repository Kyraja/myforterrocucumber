..!interpreter english declaration noabbrev
.. at 2017-06-26, 14:17
.set trans -
..========================================================================
..==  Name              : IS.PRJMPVSTDPLAN.EV
..==  Pfad              : allpstd
..==  Funktion          :
..==  Erstellungsdatum  :
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtcmd xtsel xykoobjekt xtid xtnummer xtpvorgang xtedpdat xtedpout xtedpmsg xtedperr xtvar xysel xytpuffer
.type integer xi1 xijahr xivjahr ximonat xivmonat xiwoche ximonanz xiam xiem xiaj xiej
.type real    xrwert xrmge xr1
.type real    xrtstd1 xrtstd2 xrtstd3 xrtstd4 xrtstd5 xrtstd6 xrtstd7 xrtstd8 xrtstd9 xrtstd10 xrtstd11 xrtstd12 xrpvstd xraastd xrhours
.type real    xrtstdverteilt xrtstdvj xrtstdfj xrtpvplanstd xrtpvsollstd xrtpviststd xrtpvaktist xrtsumistvert xrtpvforecaststd xrstdplanrest xrtstddiffvertfc xrtstddiffistverts
.type bool    xbok xbstart xbstdvert xybnoprsel xbprotect
.type GD      xdadatum xdedatum xdatum xdzstart xdzend
.type GW4     xwoche  xwaw xwew xwkw1
.type J4      xjahr xvjahr
.type TAZ7    xeinh xstunden
.type symtab  xstsummemonth xstsummeweek
.assign U|xstunden = U|xypmstunden
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- YearWeek -----
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "MONTH", "")  ?  M|ybwochen &  F|regmatch(P|maskkontextfop, ".*MONTH.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "MONTH"                ? _M|ybwochen & _F|regmatch(P|maskkontextfop, ".*MONTH.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "WEEK", "")   ? _M|ybwochen &  F|regmatch(P|maskkontextfop, ".*WEEK.*")
.formula P|maskkontextfop = P|maskkontextfop + " " + "WEEK"                 ?  M|ybwochen & _F|regmatch(P|maskkontextfop, ".*WEEK.*")
.continue 'xprocst.xprocsp'
!PROC002: ----- Schreibschutz_Stunden -----
.continue EL001 ? _(_(F|empty(M|ypvorgang)))
.load 0 add M|ypvorgang
.continue EL002 ? _((0|yablage) ; (0|ybmeilenstein) ; (0|ybstdvert))
.protection -exception buinfosys 'M|aktzeile'
.protection -exception budruck   'M|aktzeile'
.protection -exception ytpvpersonal 'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -exception ytpvprojteam 'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -exception ytpvkstelle  'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -exception yadatum      'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -exception yedatum      'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -exception ytpvplanstd  'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -exception ytpvsollstd  'M|aktzeile'    ? _0|yablage & _0|ybmeilenstein
.protection -line 'M|aktzeile'
.continue FI002
!EL002
.continue EL003 ? _(_(0|ypvzugstd = 0))
.protection ytpvpersonal 'M|aktzeile' ? _F|empty(0|yprojteam) ; _F|empty(0|ykstelle)
.protection ytpvprojteam 'M|aktzeile'
.protection ytpvkstelle  'M|aktzeile'
.continue FI003
!EL003
.protection -reset ytpvpersonal 'M|aktzeile'
.protection -reset ytpvprojteam 'M|aktzeile'
.protection -reset ytpvkstelle  'M|aktzeile'
!FI003
.assign  U|xijahr =  F|tovalue(F|tostring(M|yjahr), "I4")
.formula U|xiaj   =  F|year(M|yadatum)
.formula U|xiej   =  F|year(M|yedatum)
.formula U|xiam   =  F|month(M|yadatum)
.formula U|xiem   =  F|month(M|yedatum)
.formula U|xwoche =  M|yadatum
.formula U|xwaw   =  F|tostring(U|xwoche)
.formula U|xwoche =  M|yedatum
.formula U|xwew   =  F|tostring(U|xwoche)
.protection ytstd1  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 1)
.protection ytstd2  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 2)  ; (U|xijahr = U|xiej & U|xiem < 2)
.protection ytstd3  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 3)  ; (U|xijahr = U|xiej & U|xiem < 3)
.protection ytstd4  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 4)  ; (U|xijahr = U|xiej & U|xiem < 4)
.protection ytstd5  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 5)  ; (U|xijahr = U|xiej & U|xiem < 5)
.protection ytstd6  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 6)  ; (U|xijahr = U|xiej & U|xiem < 6)
.protection ytstd7  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 7)  ; (U|xijahr = U|xiej & U|xiem < 7)
.protection ytstd8  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 8)  ; (U|xijahr = U|xiej & U|xiem < 8)
.protection ytstd9  'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 9)  ; (U|xijahr = U|xiej & U|xiem < 9)
.protection ytstd10 'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 10) ; (U|xijahr = U|xiej & U|xiem < 10)
.protection ytstd11 'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 11) ; (U|xijahr = U|xiej & U|xiem < 11)
.protection ytstd12 'M|aktzeile'        ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xiam > 12) ; (U|xijahr = U|xiej & U|xiem < 12)
.protection ytstd1  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 1 )
.protection ytstd2  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 2 )
.protection ytstd3  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 3 )
.protection ytstd4  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 4 )
.protection ytstd5  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 5 )
.protection ytstd6  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 6 )
.protection ytstd7  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 7 )
.protection ytstd8  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 8 )
.protection ytstd9  'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 9 )
.protection ytstd10 'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 10)
.protection ytstd11 'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 11)
.protection ytstd12 'M|aktzeile'        ? M|yjahr < U|xvjahr ; (M|yjahr = U|xvjahr & U|xivmonat > 12)
.formula U|xiwoche = 1
.formula U|xwoche = U|xwkw1
!LOOP001: ==============================
.continue ELOP001 ? _(F|defined(M|ytweek.xiwoche))
.copy U|xbprotect = G|FALSE
.copy U|xbprotect = G|TRUE  ? (U|xijahr < U|xiaj ; U|xijahr > U|xiej) ; (U|xijahr = U|xiaj & U|xwaw > U|xwoche) ; (U|xijahr = U|xiej & U|xwew < U|xwoche)
.copy U|xbprotect = G|TRUE  ?  U|xwoche + 3 < G|datum
.continue EL004 ? _(U|xbprotect)
.'F|expr("protection ytweek" + F|tostring(U|xiwoche) + " " + F|tostring(M|aktzeile))'
!EL004
.formula U|xwoche  = U|xwoche  + 7
.formula U|xiwoche = U|xiwoche + 1
.continue LOOP001
!ELOP001: ==============================
!FI002
!EL001
.continue 'xprocst.xprocsp'
!PROC003: ----- Farbe_Zeile -----
.input "is/ABASFARBEN.DEF"          ? _F|defined(U|xabasred)
.input "allpstart/PRJM.FARBEN.DEF"  ? _F|defined(U|xtfarbes)
.continue EL005 ? _(M|aktzeile = 1)
.colour -BACKGROUND "-1 -1 -1" ytstdverteilt     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytstdvj           'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytstdfj           'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytpvplanstd       'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytpvsollstd       'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytpviststd        'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytpvaktist        'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytsumistvert      'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytpvforecaststd   'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ystdplanrest      'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytstddiffvertfc   'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytstddiffistverts 'M|aktzeile'
.continue FI005
!EL005
.colour -BACKGROUND 'U|xtfarbes'  ytstdverteilt     'M|aktzeile'        ? M|ytstdverteilt + M|ytpviststd <= M|ytpvsollstd
.colour -BACKGROUND 'U|xabasred'  ytstdverteilt     'M|aktzeile'        ? M|ytstdverteilt + M|ytpviststd >  M|ytpvsollstd
.colour -BACKGROUND 'U|xtfarbe1'  ytstdvj           'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytstdfj           'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytpvplanstd       'M|aktzeile'        ?  F|protected(M|ytpvplanstd, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee2' ytpvplanstd       'M|aktzeile'        ? _F|protected(M|ytpvplanstd, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee1' ytpvsollstd       'M|aktzeile'        ?  F|protected(M|ytpvsollstd, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee2' ytpvsollstd       'M|aktzeile'        ? _F|protected(M|ytpvsollstd, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee1' ytpviststd        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytpvaktist        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytsumistvert      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytpvforecaststd   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ystdplanrest      'M|aktzeile'        ?  F|protected(M|ytpvplanstd, M|aktzeile) & M|ytpvplanstd <= M|ytpvsollstd
.colour -BACKGROUND 'U|xtfarbee2' ystdplanrest      'M|aktzeile'        ? _F|protected(M|ytpvplanstd, M|aktzeile) & M|ytpvplanstd <= M|ytpvsollstd
.colour -BACKGROUND 'U|xabasred'  ystdplanrest      'M|aktzeile'        ? M|ytpvplanstd >  M|ytpvsollstd
.colour -BACKGROUND 'U|xtfarbeb1' ytstddiffvertfc   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytstddiffistverts 'M|aktzeile'
!FI005
.formula U|ximonat = 1
!LOOP002: ==============================
.continue ELOP002 ? _(F|defined(M|ytstd.ximonat))
.copy U|xbprotect = G|FALSE
.copy U|xbprotect = G|TRUE      ? F|protected(M|ytstd.ximonat,M|aktzeile) ; F|protected(,M|aktzeile)
.formula U|xtcmd = "colour -BACKGROUND 'U|xtfarbe1' ytstd" + 'U|ximonat' + " " + 'M|aktzeile'   ?  U|xbprotect & M|aktzeile <> 1
.formula U|xtcmd = "colour -BACKGROUND 'U|xtfarbe2' ytstd" + 'U|ximonat' + " " + 'M|aktzeile'   ? _U|xbprotect & M|aktzeile <> 1
.formula U|xtcmd = "colour -BACKGROUND  -1 -1 -1    ytstd" + 'U|ximonat' + " " + 'M|aktzeile'   ?                M|aktzeile =  1
.'U|xtcmd'
.formula U|ximonat = U|ximonat + 1
.continue LOOP002
!ELOP002: ==============================
.formula U|xiwoche = 1
.formula U|xwoche = U|xwkw1
!LOOP003: ==============================
.continue ELOP003 ? _(F|defined(M|ytweek.xiwoche))
.copy U|xbprotect = G|FALSE
.copy U|xbprotect = G|TRUE  ? F|protected(M|ytweek.xiwoche,M|aktzeile) ; F|protected(,M|aktzeile)
.formula U|xtcmd = "colour -BACKGROUND 'U|xtfarbe1' ytweek" + 'U|xiwoche' + " " + 'M|aktzeile'  ?  U|xbprotect & M|aktzeile <> 1
.formula U|xtcmd = "colour -BACKGROUND 'U|xtfarbe2' ytweek" + 'U|xiwoche' + " " + 'M|aktzeile'  ? _U|xbprotect & M|aktzeile <> 1
.formula U|xtcmd = "colour -BACKGROUND  -1 -1 -1    ytweek" + 'U|xiwoche' + " " + 'M|aktzeile'  ?                M|aktzeile =  1
.'U|xtcmd'
.formula U|xwoche  = U|xwoche  + 7
.formula U|xiwoche = U|xiwoche + 1
.continue LOOP003
!ELOP003: ==============================
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'    ? M|aktzeile =  1
.continue 'xprocst.xprocsp'
!PROC004: ----- VariablenTabellenFOP -----
.formula U|xdatum   = (G|datum:8)<<6 + "01"
.formula U|xdedatum = U|xdatum + 31
.formula U|xdedatum = (U|xdedatum:8)<<6 + "01"
.formula U|xivmonat = F|month(U|xdatum)
.formula U|xvjahr   ='F|year(U|xdatum)'
.formula U|xwoche = F|tostring(M|yjahr) + "0104"
.formula U|xwkw1  = F|tostring(U|xwoche)
.formula U|xdatum = U|xwkw1 - 2     ? M|ybwochen
.formula U|xwoche = U|xwkw1
.formula U|xiwoche = 1
!LOOP004: ==============================
.continue ELOP004 ? _(U|xiwoche <= 53)
.formula U|xtsel = U|xwoche:8
.continue EL006 ? _('F|year(U|xwoche)' = 'M|yjahr')
.type integer  xitab.xtsel          ? _F|defined(M|xitab.xtsel)
.formula U|xitab.xtsel = U|xiwoche
.formula U|xdedatum = U|xwoche + 4  ? M|ybwochen
!EL006
.formula U|xwoche  = U|xwoche  + 7
.formula U|xiwoche = U|xiwoche + 1
.continue LOOP004
!ELOP004: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- FeldSpeichern -----
.file -TEMPNAME U|xtedpdat      ? F|empty(U|xtedpdat)
.file -TEMPNAME U|xtedpout      ? F|empty(U|xtedpout)
.file -TEMPNAME U|xtedpmsg      ? F|empty(U|xtedpmsg)
.file -TEMPNAME U|xtedperr      ? F|empty(U|xtedperr)
.output NEW 'U|xtedpdat'
.input DATEI.F
#!action=UPDATE
#!EDP_LANGCODE='G|bsprache'
'U|xtsel'
'U|xtvar'
.type bool xbhinweis
.copy U|xbhinweis = G|true
.output NEW WERF.WEG
.formula U|xtsys = "edpimport.sh -c EKS -t# -o UPDATEMODE=STRICT -p " + G|einmalpw + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.input "allpstart/FOP.ALL.EDP.CHECK"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC004
!RET001
.formula xprocsp = xprocsp - 1
.load 0 add M|ypvorgang
.input 'M|tab'  ? G|mehr
.formula U|xjahr   = 'F|year(G|datum)'
.formula U|ximonat =  F|month(G|datum)
.protection -RESET ytstd1  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 1 )
.protection -RESET ytstd2  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 2 )
.protection -RESET ytstd3  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 3 )
.protection -RESET ytstd4  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 4 )
.protection -RESET ytstd5  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 5 )
.protection -RESET ytstd6  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 6 )
.protection -RESET ytstd7  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 7 )
.protection -RESET ytstd8  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 8 )
.protection -RESET ytstd9  'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 9 )
.protection -RESET ytstd10 'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 10)
.protection -RESET ytstd11 'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 11)
.protection -RESET ytstd12 'M|aktzeile'         ? _M|yjahr < U|xjahr & _(M|yjahr = U|xjahr & U|ximonat > 12)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC006: ----- Summenzeile -----
.continue EL007 ? _(M|tzeilen > 0)
.continue EL008 ? _(G|evtart =  "feldaus")
.select screen header
.select screen line
.make screen line -O    ? G|mehr
!EL008
.assign  U|xstsummemonth = ""
.assign  U|xstsummeweek  = ""
.formula U|xrtstdverteilt     = 0
.formula U|xrtstdvj           = 0
.formula U|xrtstdfj           = 0
.formula U|xrtpvplanstd       = 0
.formula U|xrtpvsollstd       = 0
.formula U|xrtpviststd        = 0
.formula U|xrtpvaktist        = 0
.formula U|xrtsumistvert      = 0
.formula U|xrtpvforecaststd   = 0
.formula U|xrstdplanrest      = 0
.formula U|xrtstddiffvertfc   = 0
.formula U|xrtstddiffistverts = 0
.select screen header
.select screen line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xi1 = 1
!LOOP006: ==============================
.continue ELOP006 ? _(F|defined(M|ytstd.U|xi1))
.formula U|xtvar = F|varname(M|ytstd.U|xi1)
.type real F|map(U|xstsummemonth, U|xtvar)      ? _F|defined(F|map(U|xstsummemonth, U|xtvar))
.assign F|map(U|xstsummemonth, U|xtvar) = F|map(U|xstsummemonth, U|xtvar) + M|.U|xtvar
.formula U|xi1 = U|xi1 + 1
.continue LOOP006
!ELOP006: ==============================
.formula U|xi1 = 1
!LOOP007: ==============================
.continue ELOP007 ? _(F|defined(M|ytweek.U|xi1))
.formula U|xtvar = F|varname(M|ytweek.U|xi1)
.type real F|map(U|xstsummeweek, U|xtvar)       ? _F|defined(F|map(U|xstsummeweek, U|xtvar))
.assign F|map(U|xstsummeweek, U|xtvar) = F|map(U|xstsummeweek, U|xtvar) + M|.U|xtvar
.formula U|xi1 = U|xi1 + 1
.continue LOOP007
!ELOP007: ==============================
.formula U|xrtstdverteilt     = U|xrtstdverteilt     + M|ytstdverteilt
.formula U|xrtstdvj           = U|xrtstdvj           + M|ytstdvj
.formula U|xrtstdfj           = U|xrtstdfj           + M|ytstdfj
.formula U|xrtpvplanstd       = U|xrtpvplanstd       + M|ytpvplanstd
.formula U|xrtpvsollstd       = U|xrtpvsollstd       + M|ytpvsollstd
.formula U|xrtpviststd        = U|xrtpviststd        + M|ytpviststd
.formula U|xrtpvaktist        = U|xrtpvaktist        + M|ytpvaktist
.formula U|xrtsumistvert      = U|xrtsumistvert      + M|ytsumistvert
.formula U|xrtpvforecaststd   = U|xrtpvforecaststd   + M|ytpvforecaststd
.formula U|xrstdplanrest      = U|xrstdplanrest      + M|ystdplanrest
.formula U|xrtstddiffvertfc   = U|xrtstddiffvertfc   + M|ytstddiffvertfc
