..!interpreter english declaration noabbrev
.. at 2017-03-30, 08:54
.set trans -
..========================================================================
..==  Name              : IS.PRJMADMLMPREISE.TAB
..==  Pfad              : allpstd
..==  Funktion          : Tabellen FOP
..==  Erstellungsdatum  : 01.08.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="    + H|id
.formula U|xtsel = U|xtsel + ";yadatum<="     + M|ylmbisdatum:8     ? _F|empty(M|ylmbisdatum)
.formula U|xtsel = U|xtsel + ";yedatum>="     + M|ylmvondatum:8     ? _F|empty(M|ylmvondatum)
.formula U|xtsel = U|xtsel + ";yvkartikel=="  + M|yvkartikel^id     ? _F|empty(M|yvkartikel)
.formula U|xtsel = U|xtsel + ";ymaschvkart==" + M|yvkartikel^id     ? _F|empty(M|ymaschvkart)
.formula U|xtsel = U|xtsel + ";ylsrelev=(Yes)"                      ?  M|ybnurlsrelev
.formula U|xtsel = U|xtsel + ";yarchiv=(No)"                        ? _M|ybmldarchiv
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy U|xbok = G|false
.continue EL001 ? _((M|ybmldoffen) & ((F|empty(0|ylsposid)) & (F|empty(0|yreposid))))
.copy U|xbok = G|true
!EL001
.continue EL002 ? _((_(F|empty(0|ylsposid))) & (M|ybmldabger) & (_(U|xbok)))
.load 1 group "3:2" '0|ylsposid'
.continue EL003 ? _(G|mehr)
.copy U|xbok = G|true   ?  1|kopf^uebertr & F|empty(0|yreposid)
!EL003
!EL002
.continue EL004 ? _((_(F|empty(0|ylsposid))) & (M|ybingebls) & (_(U|xbok)))
.load 1 group "3:2" '0|ylsposid'
.continue EL005 ? _(G|mehr)
.copy U|xbok = G|true   ? _1|kopf^uebertr & F|empty(0|yreposid)
!EL005
!EL004
.continue EL006 ? _((_(F|empty(0|yreposid))) & (M|ybmldfakt) & (_(U|xbok)))
.load 1 group "3:2" '0|yreposid'
.continue EL007 ? _(G|mehr)
.copy U|xbok = G|true   ?  1|kopf^uebertr
!EL007
!EL006
.continue EL008 ? _((_(F|empty(0|yreposid))) & (M|ybingebre) & (_(U|xbok)))
.load 1 group "3:2" '0|yreposid'
.continue EL009 ? _(G|mehr)
.copy U|xbok = G|true   ? _1|kopf^uebertr
!EL009
!EL008
.continue EL010 ? _(U|xbok)
.make screen line +O
.assign  M|ytlm         = 0|id
.copy    M|ytprojekt    = 0|yprojekt
.copy    M|ytaufgabe    = 0|yaufgabe
.copy    M|ytadatum     = 0|yadatum
.copy    M|ytazeit      = 0|yazeit
.copy    M|ytezeit      = 0|yezeit
.copy    M|ytedatum     = 0|yedatum
.formula M|ytarbzeit    = 0|yarbzeit
.formula M|ytfaktzeit   = 0|yfaktzeit
.formula M|ytmaschzeit  = 0|ymaschzeit
.copy    M|ytvkartikel  = 0|yvkartikel
.copy    M|ytmaschvkart = 0|ymaschvkart
.formula M|ytlmpreis    = 0|ylmpreis
.formula M|ytlmwert     = 0|ylmwert
.formula M|ytmzpreis    = 0|ymzpreis
.formula M|ytmzwert     = 0|ymzwert
.copy M|ytblmab = _F|empty(0|yabrechnung)
.copy M|ytblmls = _F|empty(0|ylsposid)
.copy M|ytblmre = _F|empty(0|yreposid)
.copy M|ytblmva = _F|empty(0|ytpposid)
.copy M|ytbmzab = _F|empty(0|ymzabrechnung)
.copy M|ytbmzls = _F|empty(0|ymzlsposid)
.copy M|ytbmzre = _F|empty(0|ymzreposid)
.copy M|ytbmzva = _F|empty(0|ymztpposid)
!EL010
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.input 'F|foppath("IFOP.IS.PRJMADMLMPREISE.TAB")'   ? F|fileexists(F|foppath("IFOP.IS.PRJMADMLMPREISE.TAB"))
.continue
