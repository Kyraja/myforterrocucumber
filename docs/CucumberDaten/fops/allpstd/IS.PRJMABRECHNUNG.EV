..!interpreter english declaration noabbrev
.. at 2017-03-21, 08:29
.set trans -
..========================================================================
..==  Name              : IS.PRJMABRECHNUNG.EV
..==  Pfad              : allpstd
..==  Funktion          : Abrechnung von Leistungsmeldungen
..==  Erstellungsdatum  : 28.01.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtln xtname xtvtext xtdatei xtftext xtlndatei xtprojleistkatid
.type text    xtfarbeok xtfarbefehl xtindex xtabrechnung xttyp xtid xtzid xtaufgabe xtkatartk xttext
.type text    xykoobjekt xytaufrufernr xytzeitstempel xtsperrstempel
.type BGL     xt1
.type BT      xtbtext
.type GD19    xdvon xdbis
.type GD      xddat xdkonddat
.type P0      xpkunde
.type P2      xpart
.type P3:2    xpaupos
.type TAZ1    xpape
.type TAZ7    xeinh
.type integer xizeile xisort xidatei xi1
.type real    xrlmgenauigkeit
.type bool    xbok xbmehr xbbuch xbvk xbausel xbprsel xyberlaubt xbnurml xbzeilenraus
.'F|expr("type P" + U|xydbgrtpposition + " xptppos")
.'F|expr("type P" + U|xydbgrprojekt    + " xpprojekt")
.'F|expr("type P" + U|xydbgraufgabe    + " xpaufgabe")
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- IFOP_und_weiter -----
.input 'F|foppath("IFOP.IS.PRJMABRECHNUNG.EV")'     ? F|fileexists(F|foppath("IFOP.IS.PRJMABRECHNUNG.EV"))
.continue
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe_Fehler -----
.colour -BACKGROUND 'U|xtfarbefehl' 'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC003: ----- Sperre_entfernen -----
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL001 ? _(_(M|ysperre))
.continue EL002 ? _((_(F|empty(M|ytleistmeld))) & (M|ytleistmeld^ysperre))
.select lock add M|ytleistmeld
.continue EL003 ? _(G|mehr)
.assign H|ysperre = G|FALSE
.rewrite
.continue FI003
!EL003
.set TRANS +
.box Hinweis
Die Leistungsmeldung 'M|ytleistmeld'/'M|ytleistmeld^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI003
!EL002
.continue EL004 ? _((_(F|empty(M|ytmzeitmeld))) & (M|ytmzeitmeld^ysperre))
.select lock add M|ytmzeitmeld
.continue EL005 ? _(G|mehr)
.assign H|ysperre = G|FALSE
.rewrite
.continue FI005
!EL005
.set TRANS +
.box Hinweis
Die Meldung der Maschinenzeit 'M|ytmzeitmeld'/'M|ytmzeitmeld^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI005
!EL004
.continue EL006 ? _((_(F|empty(M|ytmatmeld))) & (M|ytmatmeld^ysperre))
.select lock add M|ytmatmeld
.continue EL007 ? _(G|mehr)
.assign H|ysperre = G|FALSE
.rewrite
.continue FI007
!EL007
.set TRANS +
.box Hinweis
Die Materialmeldung 'M|ytmatmeld'/'M|ytmatmeld^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI007
!EL006
.continue EL008 ? _((_(F|empty(M|ytsubmeld))) & (M|ytsubmeld^ysperre))
.select lock add M|ytsubmeld
.continue EL009 ? _(G|mehr)
.assign H|ysperre = G|FALSE
.rewrite
.continue FI009
!EL009
.set TRANS +
.box Hinweis
Die Submeldung 'M|ytsubmeld'/'M|ytsubmeld^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI009
!EL008
!EL001
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC004: ----- Kopffelder_leeren -----
.formula M|yabrechnung = ""
.formula M|yabrname    = ""
.formula M|yaufgabe    = ""
.formula M|ykunde      = ""
.formula M|ykunde2     = ""
.formula M|yprojekt    = ""
.formula M|yvorvp      = ""
.formula M|yvornum     = ""
.formula M|ybupos      = ""
.formula M|ystatus     = ""
.formula M|yftext      = ""
.formula M|ywert       = 0
.continue 'xprocst.xprocsp'
!PROC005: ----- Tabelle_leeren -----
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC003
!RET001
.formula xprocsp = xprocsp - 1
.make screen line --O
.continue 'xprocst.xprocsp'
!PROC006: ----- Abrechnungsnummer_in_LM_schreiben -----
.select lock add M|ytleistmeld
.continue EL010 ? _(G|mehr)
.formula H|yabrechnung  = M|yabrechnung^nummer  ? _M|ybvk
.formula M|ytabrechnung = M|yabrechnung^nummer  ? _M|ybvk
.formula H|yprjmid      = M|yprjmpid     ?  F|empty(H|ylsposid) & M|yabrpos^kotyp = G|LIKO
.formula H|yprjmid      = ""             ? _F|empty(H|ylsposid) & M|yabrpos^kotyp = G|LIKO
.formula H|yprjmid      = M|yprjmpid     ?  F|empty(H|yreposid) & M|yabrpos^kotyp = G|REKO
.formula H|yprjmid      = ""             ? _F|empty(H|yreposid) & M|yabrpos^kotyp = G|REKO
.formula H|ysort   = M|aktzeile ?  M|ymark
.formula H|ysort   = 0          ? _M|ymark
.rewrite
.continue FI010
!EL010
.set TRANS +
.box Fehler
Die Leistungsmeldung 'M|ytleistmeld' konnte nicht zur Bearbeitung geîffnet werden.
.set TRANS -
.copy M|ymark = G|TRUE
!FI010
.continue 'xprocst.xprocsp'
!PROC007: ----- Abrechnungsnummer_aus_LM_entfernen -----
.select lock object 'M|ytleistmeld^id'
.continue EL011 ? _(G|mehr)
.continue EL012 ? _(M|ybvk)
.formula H|yabrechnung  = ""    ?  M|ymark
.formula M|ytabrechnung = ""    ?  M|ymark
.formula H|yprjmid      = M|yprjmpid
.continue FI012
!EL012
.formula H|yabrechnung  = ""
.formula M|ytabrechnung = ""
!FI012
.formula H|ysort   = M|aktzeile ?  M|ymark
.formula H|ysort   = 0          ? _M|ymark
.rewrite
.continue FI011
!EL011
.set TZRANS +
.box Fehler
Die Leistungsmeldung 'M|ytleistmeld' konnte nicht zur Bearbeitung geîffnet werden.
.set TRANS -
.copy M|ymark = G|FALSE
.error
.end 1         ? G|evtart = "zeileloevor"
!FI011
.continue 'xprocst.xprocsp'
!PROC008: ----- LM_gebucht -----
.continue EL013 ? _(U|xybistkost)
.formula U|xbok = G|TRUE
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL014 ? _(((_(F|empty(M|ytleistmeld))) & (F|empty(M|ytleistmeld^ytransaktion))) ; ((_(F|empty(M|ytmzeitmeld))) & (F|empty(M|ytmzeitmeld^ytransaktion))))
.colour -BACKGROUND "255 220 60" ytleistmeld 'M|aktzeile'
.formula U|xbok = G|false
.continue FI014
!EL014
.colour -BACKGROUND "-1 -1 -1" ytleistmeld 'M|aktzeile'
!FI014
.select screen line
.continue LOOP002
!ELOP002: ==============================
!EL013
.continue 'xprocst.xprocsp'
!PROC009: ----- Abrechnungswert_ermitteln -----
.input "is/ABASFARBEN.DEF"  ? _F|defined(U|xabasred)
.formula M|ywert     = 0
.formula M|yfaktwert = 0
.formula M|ymenge    = 0
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL015 ? _(M|ymark)
.formula M|ywert     = M|ywert     + M|ytwert
.formula M|yfaktwert = M|yfaktwert + M|ytfaktwert
.formula M|ymenge    = M|ymenge    + M|ytmenge
!EL015
.colour -BACKGROUND "-1 -1 -1"   ytwert 'M|aktzeile'    ?  M|ytwert = M|ytfaktwert
.colour -BACKGROUND 'U|xabasred' ytwert 'M|aktzeile'    ? _M|ytwert = M|ytfaktwert
.select screen line
.continue LOOP003
!ELOP003: ==============================
.colour -BACKGROUND "-1 -1 -1"   ywert 0    ?  M|ywert = M|yfaktwert
.colour -BACKGROUND 'U|xabasred' ywert 0    ? _M|ywert = M|yfaktwert
.continue 'xprocst.xprocsp'
!PROC010: ----- Wert_ermitteln -----
.assign  U|xpprojekt        = M|ytprojekt^id
.assign  U|xpaufgabe        = M|ytaufgabe^id
.assign  U|xdkonddat        = M|ytlnadatum
.formula U|xtprojleistkatid = M|ytprojekt^yprojleistkatid
.assign U|xpkunde = 0|yprojekt^ykunde^id
.assign U|xpaupos = M|yaupos^id
.assign U|xptppos = M|yaupos^id
.input 'U|xtupartpreis'
.formula M|ytpreis    = U|xpapreis
.formula M|ytfaktwert = U|xpapreis * M|ytmenge
.continue EL016 ? _(_(U|xttyp = "MM"))
.formula M|ytpreis    = U|xyhpreis
.formula M|ytfaktwert = U|xyhpreis * M|ytmenge
.continue FI016
!EL016
.formula M|ytpreis    = U|xpapreis
.formula M|ytfaktwert = U|xpapreis * M|ytmenge
!FI016
.formula M|ytwert = M|ytfaktwert        ? M|ytwert = 0 ; G|evtvar = "yrabdr"
.continue 'xprocst.xprocsp'
!PROC011: ----- Zeile_fuellen -----
.make screen line +O        ?  G|evtart = "buttonnach" ; G|evtvar = "yabrechnung"
.copy M|ysperre = G|FALSE
.copy M|ysperre = G|TRUE    ?  M|ybzeigen
.continue EL017 ? _(U|xttyp = "MM")
.continue EL018 ? _((1|ysperre) & (_(F|empty(1|yaufrufernr))) & (_(M|ybzeigen)))
.formula U|xytaufrufernr = 1|yaufrufernr
.input "allpstart/GET.CALLERNO"
.copy    M|ysperre = G|TRUE    ? U|xytzeitstempel = 1|yaufruferzp
!EL018
.continue FI017
!EL017
.continue EL019 ? _((0|ysperre) & (_(F|empty(0|yaufrufernr))) & (_(M|ybzeigen)))
.formula U|xytaufrufernr = 0|yaufrufernr
.input "allpstart/GET.CALLERNO"
.copy    M|ysperre = G|TRUE    ? U|xytzeitstempel = 0|yaufruferzp
!EL019
!FI017
.continue BRK001 ? _(U|xttyp = "LM")
.continue EL020 ? _((M|yabrpos^dnr    = U|xydbtpposition) & (M|yabrpos^gruppe = U|xygrtpposition))
.copy M|ysperre = G|TRUE  ?  0|ytpposid <> M|yabrpos^id & (_F|empty(0|ytpposid) & _0|ytpposid = "(0,0,0)")
.continue FI020
!EL020
.copy M|ysperre = G|TRUE  ? _F|empty(0|ylsposid) & _0|ylsposid = M|yabrpos^id
.copy M|ysperre = G|TRUE  ? _F|empty(0|yreposid) & _0|yreposid = M|yabrpos^id
.copy M|ysperre = G|TRUE  ? _F|empty(0|yprjmid)  & _0|yprjmid  = M|yprjmpid
!FI020
.continue EL021 ? _(_(F|empty(0|yabrechnung)))
.assign M|ytabrechnung = 0|yabrechnung
.load 9 group 'U|xydbgrabrechnung' '0|yabrechnung'
.assign M|ytabrname    = 9|namebspr     ? G|mehr
.load 9
!EL021
.copy   M|ytaufgabe       = 0|yaufgabe
.copy   M|ytpvorgang      = 0|ypvorgang
.copy   M|ytarbpaket      = M|ytpvorgang^yarbpaket
.copy   M|ytstatus        = M|ytaufgabe^ystatus
.assign M|ytaubez         = 0|yaufgabe^namebspr
.assign M|ytleistmeld     = 0|id
.assign M|ytlnbez         = 0|namebspr
.copy   M|ytpersonal      = 0|ypersonal
.assign M|ytpersname      = 0|ypersonal^namebspr
.assign M|ytverantw       = 0|yverantw^id
.copy   M|ytprojleit      = 0|yprojekt^yprojleit    ? _F|empty(0|yprojekt)
.copy   M|ytlndatum       = 0|yedatum
.copy   M|ytlnadatum      = 0|yadatum
.copy   M|ytlnazeit       = 0|yazeit
.copy   M|ytlnezeit       = 0|yezeit
.copy   M|ytlnedatum      = 0|yedatum
.assign M|ytfaktzeit      = 0|yfaktzeit
.assign M|ytarbzeit       = 0|yarbzeit
.assign M|ytmenge         = 0|yfaktzeit
.assign M|yteinh          = 'U|xypmstunden(L="0")'
.assign M|ytlsrelev       = 0|ylsrelev
.assign M|ytarchiv        = 0|yarchiv
.assign M|ytnachtrag      = 0|ynachtrag
.assign M|ytbueberstunden = 0|ybueberstunden
.assign M|ytleiort        = 0|yleiort
.copy   M|ytprojekt       = 0|yprojekt
.copy   M|ytkunde         = 0|ykunde
.copy   M|yttaetschl      = 0|ytaetschl
.assign M|ytlsnum         = 0|ylsnum
.assign M|ytlspos         = 0|ylsposid
.assign M|ytrenum         = 0|yrenum
.assign M|ytrepos         = 0|yreposid
.assign M|yttppos         = 0|ytpposid
.copy   M|ytbfahrtkosten     = 0|ybfahrtkosten
.copy   M|ytfahrtkostenwert  = 0|yfahrtkostenwert
.copy   M|ytfahrtkostenwaehr = 0|yfahrtkostenwaehr
.copy   M|ytbspesen          = 0|ybspesen
.copy   M|ytspesenwert       = 0|yspesenwert
.copy   M|ytspesenwaehr      = 0|yspesenwaehr
.copy   M|ytbuebernachtung   = 0|ybuebernachtung
.copy   M|ytuebernachtwert   = 0|yuebernachtwert
.copy   M|ytuebernachtwaehr  = 0|yuebernachtwaehr
.copy   M|ytbabrechfrei      = 0|ybabrechfrei
.copy   M|ytabrechfreibz     = 0|yabrechfreibz
.continue EL022 ? _(_(F|empty(0|ybeschint)))
.select from '0|ybeschint'
.formula M|ylnbeschint = 0|ybeschint
!EL022
.continue EL023 ? _(_(F|empty(0|ybeschext)))
.select from '0|ybeschext'
.formula M|ylnbeschext = 0|ybeschext
!EL023
.continue EL024 ? _(_(F|empty(0|ytueberstunden)))
.select from '0|ytueberstunden'
.formula M|yttueberstunden = 0|ytueberstunden
!EL024
.continue EL025 ? _(_(F|empty(0|ylmabrtext)))
.select from '0|ylmabrtext'
.formula M|ytabrtext = 0|ylmabrtext
!EL025
.assign  M|ytbmeldpreis = G|TRUE        ? _F|empty(0|ylmpreis)
.formula M|ytpreis    = 0|ylmpreis
.formula M|ytfaktwert = 0|ylmpreis * M|ytmenge
.formula M|ytwert     = 0|ylmwert
.formula U|xpart      = 0|yvkartikel^id
.formula U|xpaartikel = 0|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.continue EL026 ? _(F|empty(0|ylmpreis))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC010
!RET002
.formula xprocsp = xprocsp - 1
!EL026
.continue EL027 ? _(M|ybvk)
.copy M|ymark = G|TRUE   ?  F|empty(0|yprjmid) &  0|ylsposid = M|yabrpos^id &  M|yabrpos^kotyp = G|LIKO
.copy M|ymark = G|TRUE   ?  F|empty(0|yprjmid) &  0|yreposid = M|yabrpos^id &  M|yabrpos^kotyp = G|REKO
.copy M|ymark = G|TRUE   ?  0|yprjmid = M|yprjmpid &  F|empty(0|ylsposid) &  M|yabrpos^kotyp = G|LIKO
.copy M|ymark = G|TRUE   ?  0|yprjmid = M|yprjmpid &  F|empty(0|yreposid) &  M|yabrpos^kotyp = G|REKO
.copy M|ymark = G|TRUE   ?  0|yprjmid = M|yprjmpid &  F|empty(0|ylsposid) & F|empty(0|yreposid) & F|empty(M|yabrpos)
.copy M|ymark = G|TRUE   ?  0|yaufgabe^yvorpos = M|yaupos^id
.copy M|ymark = G|TRUE   ?  0|ytpposid = M|yabrpos^id
.copy M|ymark = G|FALSE  ? _0|ylsrelev & F|empty(0|yprjmid) &  0|ylsposid = M|yabrpos^id &  M|yabrpos^kotyp <> G|LIKO
.copy M|ymark = G|FALSE  ? _0|ylsrelev & F|empty(0|yprjmid) &  0|yreposid = M|yabrpos^id &  M|yabrpos^kotyp <> G|REKO
.copy M|ymark = G|FALSE  ? _0|ylsrelev & 0|yprjmid <> M|yprjmpid &  F|empty(0|ylsposid) &  M|yabrpos^kotyp = G|LIKO
.copy M|ymark = G|FALSE  ? _0|ylsrelev & 0|yprjmid <> M|yprjmpid &  F|empty(0|yreposid) &  M|yabrpos^kotyp = G|REKO
.copy M|ymark = G|FALSE  ?  0|yarchiv & F|empty(0|yprjmid) &  0|ylsposid = M|yabrpos^id &  M|yabrpos^kotyp <> G|LIKO
.copy M|ymark = G|FALSE  ?  0|yarchiv & F|empty(0|yprjmid) &  0|yreposid = M|yabrpos^id &  M|yabrpos^kotyp <> G|REKO
.copy M|ymark = G|FALSE  ?  0|yarchiv & 0|yprjmid <> M|yprjmpid &  F|empty(0|ylsposid) &  M|yabrpos^kotyp = G|LIKO
.copy M|ymark = G|FALSE  ?  0|yarchiv & 0|yprjmid <> M|yprjmpid &  F|empty(0|yreposid) &  M|yabrpos^kotyp = G|REKO
.continue EL028 ? _((M|yabrpos^dnr    = U|xydbtpposition) & (M|yabrpos^gruppe = U|xygrtpposition))
.copy M|ymark = G|TRUE        ?  F|empty(0|ytpposid) & _M|ysperre
.copy M|ymark = G|TRUE        ?  0|ytpposid =  M|yabrpos^id
.copy M|ymark = G|FALSE       ?  0|ytpposid <> M|yabrpos^id & _M|yballe & (_F|empty(0|ytpposid) & _0|ytpposid = "(0,0,0)")
!EL028
.protection ymark 'M|aktzeile'  ? _M|ymark & 0|yarchiv
.continue FI027
!EL027
.continue EL029 ? _(((F|empty(M|yabrechnung)) & (F|empty(0|yabrechnung)) & (_(M|ysperre))) ; ((_(F|empty(M|yabrechnung))) & (0|yabrechnung = M|yabrechnung^nummer)) ; (((G|evtvar = "ytleistmeld") ; (G|evtvar = "ylnanfuegen")) & ((F|empty(0|yabrechnung)) ; (F|empty(M|yabrechnung))) & (_(M|ysperre)) & (false)))
.copy M|ymark = G|TRUE
!EL029
.continue EL030 ? _((_(M|ytlsrelev)) ; (((_(F|empty(0|ylsposid))) ; (_(F|empty(0|yreposid)))) & (_(M|ybvk))) ; (0|yarchiv))
.copy M|ymark = G|FALSE
.protection ymark 'M|aktzeile'
!EL030
!FI027
.continue ESAC001
!BRK001
.continue BRK002 ? _(U|xttyp = "MZ")
.continue EL031 ? _((M|yabrpos^dnr    = U|xydbtpposition) & (M|yabrpos^gruppe = U|xygrtpposition))
.copy M|ysperre = G|TRUE      ?  0|ymztpposid <> M|yabrpos^id & (_F|empty(0|ymztpposid) & _0|ymztpposid = "(0,0,0)")
.continue FI031
!EL031
.copy M|ysperre = G|TRUE      ? _F|empty(0|ymzlsposid) & _0|ymzlsposid = M|yabrpos^id
.copy M|ysperre = G|TRUE      ? _F|empty(0|ymzreposid) & _0|ymzreposid = M|yabrpos^id
.copy M|ysperre = G|TRUE      ? _F|empty(0|ymzprjmid)  & _0|ymzprjmid  = M|yprjmpid
!FI031
.continue EL032 ? _(_(F|empty(0|ymzabrechnung)))
.assign M|ytabrechnung = 0|ymzabrechnung
.load 9 group 'U|xydbgrabrechnung' '0|ymzabrechnung'
.assign M|ytabrname    = 9|namebspr     ? G|mehr
.load 9
!EL032
.copy   M|ytaufgabe    = 0|yaufgabe
.copy   M|ytpvorgang   = 0|ypvorgang
.copy   M|ytarbpaket   = M|ytpvorgang^yarbpaket
.copy   M|ytstatus     = M|ytaufgabe^ystatus
.assign M|ytaubez      = 0|yaufgabe^namebspr
.assign M|ytmzeitmeld  = 0|id
.assign M|ytlnbez      = 0|namebspr                     ?  F|empty(0|ymaschvkart)
.assign M|ytlnbez      = 0|ymaschvkart^namebspr         ? _F|empty(0|ymaschvkart)
.copy   M|ytpersonal   = 0|ypersonal
.assign M|ytpersname   = 0|ypersonal^namebspr
.copy   M|ytverantw    = 0|yverantw
.copy   M|ytprojleit   = 0|yprojekt^yprojleit           ? _F|empty(0|yprojekt)
.assign M|ytlndatum    = 0|yedatum
.assign M|ytlnadatum   = 0|yadatum
.assign M|ytlnazeit    = 0|yazeit
.assign M|ytlnezeit    = 0|yezeit
.assign M|ytlnedatum   = 0|yedatum
.assign M|ytfaktzeit   = 0|yfaktzeit
.assign M|ytarbzeit    = 0|yarbzeit
.assign M|ytmenge      = 0|ymaschzeit
.assign M|yteinh       = 'U|xypmstunden(L="0")'
.assign M|ytlsrelev    = 0|ylsrelev
.assign M|ytarchiv     = 0|yarchiv
.assign M|ytnachtrag   = 0|ynachtrag
.copy   M|ytleiort     = 0|yleiort
.copy   M|ytprojekt    = 0|yprojekt
.copy   M|ytkunde      = 0|ykunde
.copy   M|yttaetschl   = 0|ytaetschl
.assign M|ytlsnum      = 0|ymzlsnum
.assign M|ytlspos      = 0|ymzlsposid
.assign M|ytrenum      = 0|ymzrenum
.assign M|ytrepos      = 0|ymzreposid
