.formula M|ytpwert  = M|ytmge   * M|ytpreis             ? _F|protected(M|ytmge,M|aktzeile)
.formula M|ytliwert = M|ytlimge * M|ytpreis             ? _F|protected(M|ytlimge,M|aktzeile)
.formula M|ytofwert = M|ytofmge * M|ytpreis             ?  F|empty(M|ytpverrechnanf)
.formula M|ytofwert = M|ytofmge * M|ytorigpos^ypreis    ? _F|empty(M|ytpverrechnanf)
.continue ESAC006
!BRK036
.continue BRK037 ? _(G|evtvar = "yteigenleist")
.formula M|ytfremdleist = M|ytpwert  - M|yteigenleist - M|ytsonstkost - M|ytfertleist    ?  F|empty(M|ytpverrechnanf)
.formula M|ytfremdleist = M|ytliwert - M|yteigenleist - M|ytsonstkost - M|ytfertleist    ? _F|empty(M|ytpverrechnanf)
.continue ESAC006
!BRK037
.continue BRK038 ? _(G|evtvar = "ytfremdleist")
.formula M|yteigenleist = M|ytpwert  - M|ytfremdleist - M|ytsonstkost - M|ytfertleist    ?  F|empty(M|ytpverrechnanf)
.formula M|yteigenleist = M|ytliwert - M|ytfremdleist - M|ytsonstkost - M|ytfertleist    ? _F|empty(M|ytpverrechnanf)
.continue ESAC006
!BRK038
.continue BRK039 ? _(G|evtvar = "ytsonstkost")
.formula M|yteigenleist = M|ytpwert  - M|ytfremdleist - M|ytsonstkost - M|ytfertleist    ?  F|empty(M|ytpverrechnanf)
.formula M|yteigenleist = M|ytliwert - M|ytfremdleist - M|ytsonstkost - M|ytfertleist    ? _F|empty(M|ytpverrechnanf)
.continue ESAC006
!BRK039
.continue BRK040 ? _(G|evtvar = "ytfertleist")
.formula M|yteigenleist = M|ytpwert  - M|ytfremdleist - M|ytsonstkost - M|ytfertleist    ?  F|empty(M|ytpverrechnanf)
.formula M|yteigenleist = M|ytliwert - M|ytfremdleist - M|ytsonstkost - M|ytfertleist    ? _F|empty(M|ytpverrechnanf)
.continue ESAC006
!BRK040
.continue BRK041 ? _(G|evtvar = "ytposstatus")
.continue EL095 ? _(_(F|empty(M|ytposstatus)))
.set trans +
.box -BUTTON yes:no -TITLE Achtung
Wollen Sie diese Position wirklich stornieren?
.set trans -
.continue EL096 ? _(G|box = G|boxyes)
.assign  M|ytablagen   = 'G|ZEITPUNKT:14'
.continue FI096
!EL096
.formula M|ytposstatus = ""
.assign  M|ytablagen   = ""
!FI096
.continue FI095
!EL095
.assign  M|ytablagen = ""
!FI095
.continue ESAC006
!BRK041
!ESAC006: =====   ENDCASE   =====
.continue EL097 ? _(G|evtzeile > 0)
.assign M|ytbspeichern = G|TRUE       ? _G|evtvar = "ytbspeichern"
.colour -BACKGROUND -1 -1 -1          'M|aktzeile'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET043" 
.continue PROC007
!RET043
.formula xprocsp = xprocsp - 1
!EL097
.continue ESAC002
!BRK026
.continue BRK042 ? _(G|evtart = "zeileeinvor")
.continue EL098 ? _((F|sysinfo(10)^ykonfigprjm^ypmabrtypgleich) ; (M|ygesperrt))
.error
.end 1
!EL098
.continue ESAC002
!BRK042
.continue BRK043 ? _(G|evtart = "zeileeinnach")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET044" 
.continue PROC004
!RET044
.formula xprocsp = xprocsp - 1
.formula M|ytbuabrechnung = "icon:selection_disabled"   ?  F|empty(M|ytpverrechnanf)
.continue ESAC002
!BRK043
.continue BRK044 ? _(G|evtart = "zeileloevor")
.continue EL099 ? _(M|ygesperrt)
.error
.end 1
!EL099
.continue EL100 ? _(_(F|empty(M|yttppos)))
.formula U|xtsel = "$,,ytppos==" + M|yttppos^id + ";@ablageart=(1)"
.select group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL101 ? _(G|mehr)
.error
.end 1
!EL101
.formula U|xtsel = "$,,yorig==" + M|yttppos^id + ";@ablageart=(1)"
.select group 'U|xydbgrtpposition' 'U|xtsel'
.continue EL102 ? _(G|mehr)
.error
.end 1
!EL102
.formula U|xtsel = "$,,ytpposid==" + M|yttppos^id + ";@ablageart=(1)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL103 ? _(G|mehr)
.error
.end 1
!EL103
.formula U|xtsel = "$,,ymztpposid==" + M|yttppos^id + ";@ablageart=(1)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL104 ? _(G|mehr)
.error
.end 1
!EL104
.formula U|xtsel = "$,,ytmmtpposid==" + M|yttppos^id + ";@ablageart=(1);@zeilen=ja"
.select group 'U|xydbgrmatmeldung' 'U|xtsel'
.continue EL105 ? _(G|mehr)
.error
.end 1
!EL105
.formula U|xtsel = "$,,ytsmtpposid==" + M|yttppos^id + ";@ablageart=(1);@zeilen=ja"
.select group 'U|xydbgrsubmeldung' 'U|xtsel'
.continue EL106 ? _(G|mehr)
.error
.end 1
!EL106
.set trans +
.box -BUTTON yes:no -TITLE Hinweis
Soll die Teilprojektposition wirklich gelîscht werden?
.set trans -
.continue EL107 ? _(G|box = G|boxyes)
.select lock add M|yttppos
.continue EL108 ? _(G|mehr)
.delete
!EL108
.continue FI107
!EL107
.error
.end 1
!FI107
!EL100
.continue ESAC002
!BRK044
.continue BRK045 ? _(G|evtart = "zeileloenach")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET045" 
.continue PROC007
!RET045
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK045
!ESAC002: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMTPPOSITIONEN.EV")'       ? F|fileexists(F|foppath("IFOP.IS.PRJMTPPOSITIONEN.EV"))
.continue
