..!interpreter english declaration noabbrev
.. at 2017-06-16, 17:18
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMTPPOSITIONEN.EV
..==  Pfad              : allpstd
..==  Funktion          :
..==
..==  Erstellungsdatum  : 29.03.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtbox xtcmd xykoobjekt xtid xtdatei xtaufgabe xttyp xtzid xtkatartk xtprojleistkatid xbuchtyp
.type text    xysel
.type real    xrpreis xrtpwert xrtpoffwert xrliwert xrtplohnanteil xrtpmatanteil
.type real    xrfaktzeit xrwert
.type integer ximonat xijahr
.type GD      xdatum xdkonddat xbudat
.type bool    xisort
.type bool    xyberlaubt xbok xbmehr xblm xbmz xbmm xbsm
.type TAZ7    xeinh
.type P0      xpkunde
.type P3:2    xpaupos
.type P86:1   xpprojekt xpproject
.type P149:3  xpaufgabe
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Feldschutz_Teilprojekt -----
.continue EL001 ? _(F|empty(M|ytorigpos))
.continue EL002 ? _(F|empty(M|ytposstatus))
.protection -reset -line 'M|aktzeile'
.protection ytlimge  'M|aktzeile'
.protection ytliwert 'M|aktzeile'
.continue EL003 ? _(M|ytartex^gruppe = 4)
.continue EL004 ? _(('M|ytartex^zptyp(L="0")' =  "(12)") ; ('M|ytartex^zptyp(L="0")' =  "(26)") ; ('M|ytartex^zptyp(L="0")' =  "(27)") ; ('M|ytartex^zptyp(L="0")' =  "(28)"))
.protection ytmge    'M|aktzeile'
.protection ytpreis  'M|aktzeile'
.continue FI004
!EL004
.protection ytpwert 'M|aktzeile'
!FI004
.continue FI003
!EL003
.protection ytpwert 'M|aktzeile'
!FI003
.continue FI002
!EL002
.protection -exception ytposstatus 'M|aktzeile'
.protection -exception ytbspeichern 'M|aktzeile'
.protection -line 'M|aktzeile'
!FI002
.continue FI001
!EL001
.protection -line 'M|aktzeile'
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- Feldschutz_Verrechnunganforderung -----
.protection -reset -line 'M|aktzeile'
.protection ytmge       'M|aktzeile'
.protection ytpwert     'M|aktzeile'
.protection ytposstatus 'M|aktzeile'
.continue EL005 ? _(M|ytartex^gruppe = 4)
.continue EL006 ? _(('M|ytartex^zptyp(L="0")' =  "(12)") ; ('M|ytartex^zptyp(L="0")' =  "(26)") ; ('M|ytartex^zptyp(L="0")' =  "(27)") ; ('M|ytartex^zptyp(L="0")' =  "(28)"))
.protection ytlimge  'M|aktzeile'
.protection ytpreis  'M|aktzeile'
.continue FI006
!EL006
.protection ytliwert 'M|aktzeile'
!FI006
.continue FI005
!EL005
.protection ytliwert 'M|aktzeile'
!FI005
.continue 'xprocst.xprocsp'
!PROC003: ----- Preis_ermitteln -----
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpaartikel)
.assign  U|xpprojekt        = M|yteilprojekt^id
.assign  U|xpaufgabe        = ""
.assign  U|xpaupos          = M|yvorvp^id
.assign  U|xdkonddat        = M|yveranfdatum
.formula U|xtprojleistkatid = M|yteilprojekt^yprojleistkatid
.formula U|xpaartikel       = M|ytartex^id
.input 'U|xtupartpreis'
.formula M|ytpreis = U|xylepreis
.continue 'xprocst.xprocsp'
!PROC004: ----- Feldschutz_Artikeltyp -----
.protection -RESET ytliwert 'M|aktzeile'
.protection -RESET ytpwert  'M|aktzeile'
.protection -RESET ytmge    'M|aktzeile'
.protection -RESET ytpreis  'M|aktzeile'
.protection -RESET ytlimge  'M|aktzeile'
.protection -RESET ytpreis  'M|aktzeile'
.continue EL007 ? _(_(F|empty(M|ytpverrechnanf)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue FI007
!EL007
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!FI007
.continue 'xprocst.xprocsp'
!PROC005: ----- offene_Menge_zu_TPPosition -----
.formula M|ytofmge   = M|ytmge
.formula M|ytofwert  = M|ytpwert
.formula U|xtsel = "$,,yorig=="  + H|id                 ?  F|empty(M|ytorigpos)
.formula U|xtsel = "$,,yorig=="  + M|ytorigpos^id       ? _F|empty(M|ytorigpos)
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|ytofmge   = M|ytofmge   - 0|ylimge
.formula M|ytofwert  = M|ytofwert  - 0|yliwert
.formula M|ytabgmge  = M|ytabgmge  + 0|ylimge           ? 0|id <> H|id
.formula M|ytabgwert = M|ytabgwert + 0|yliwert          ? 0|id <> H|id
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.formula M|ytofwert  = M|ytofmge  * M|ytpreis           ? _F|protected(M|ytmge,M|aktzeile)   &  F|empty(M|ytpverrechnanf)
.formula M|ytofwert  = M|ytofmge  * M|ytorigpos^ypreis  ? _F|protected(M|ytlimge,M|aktzeile) & _F|empty(M|ytpverrechnanf)
.continue 'xprocst.xprocsp'
!PROC006: ----- Zeile_fuellen -----
.make screen line +O
.formula M|ytpnum         = H|ypnum
.copy    M|ytabrechtypk   = H|yabrechtypk
.copy    M|ytartex        = H|yartex
.formula M|ytartname      = M|ytartex^namebspr
.formula M|ytptext        = H|yptext
.copy    M|ytle           = M|ytartex^le
.formula M|ytmge          = H|ymge
.formula M|ytlimge        = H|ylimge
.formula M|ytpreis        = H|ypreis
.formula M|ytposstatus    = H|yposstatus
.copy    M|ytnabrechrelev = H|ynabrechrelev
.copy    M|ytablagen      = H|yablagen
.formula M|ytpwert        = H|ypwert
.formula M|ytliwert       = H|yliwert
.formula M|yteigenleist   = H|yeigenleist
.formula M|ytfremdleist   = H|yfremdleist
.formula M|ytsonstkost    = H|ysonstkost
.formula M|ytfertleist    = H|yfertleist
.assign  M|yvorvp         = H|yvorpos
.formula M|yvornum        = M|yvorvp^kopf^nummer
.colour -BACKGROUND -1 -1 -1          'M|aktzeile'
.formula M|ytbuabrechnung = "icon:selection"            ? _F|empty(M|ytpverrechnanf)
.formula M|ytbuabrechnung = "icon:selection_disabled"   ?  F|empty(M|ytpverrechnanf)
.continue 'xprocst.xprocsp'
!PROC007: ----- Wert_Kopf -----
.select screen header
.formula M|ywert         = 0    ?  F|empty(M|ytpverrechnanf)
.formula M|yliwert       = 0
.formula M|yowert        = 0
.formula M|yeigenleist   = 0    ?  F|empty(M|ytpverrechnanf)
.formula M|ylieigenleist = 0    ? _F|empty(M|ytpverrechnanf)
.formula M|yfremdleist   = 0    ?  F|empty(M|ytpverrechnanf)
.formula M|ylifremdleist = 0    ? _F|empty(M|ytpverrechnanf)
.formula M|ysonstkost    = 0    ?  F|empty(M|ytpverrechnanf)
.formula M|ylisonstkost  = 0    ? _F|empty(M|ytpverrechnanf)
.formula M|yfertleist    = 0    ?  F|empty(M|ytpverrechnanf)
.formula M|ylifertleist  = 0    ? _F|empty(M|ytpverrechnanf)
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula M|ywert         = M|ywert         + M|ytpwert                  ?  F|empty(M|ytpverrechnanf)
.formula M|yowert        = M|yowert        + M|ytofwert                 ?  F|empty(M|ytposstatus)
.formula M|yliwert       = M|yliwert       + M|ytliwert
.formula M|yeigenleist   = M|yeigenleist   + M|yteigenleist             ?  F|empty(M|ytpverrechnanf)
.formula M|ylieigenleist = M|ylieigenleist + M|yteigenleist             ? _F|empty(M|ytpverrechnanf)
.formula M|yfremdleist   = M|yfremdleist   + M|ytfremdleist             ?  F|empty(M|ytpverrechnanf)
.formula M|ylifremdleist = M|ylifremdleist + M|ytfremdleist             ? _F|empty(M|ytpverrechnanf)
.formula M|ysonstkost    = M|ysonstkost    + M|ytsonstkost              ?  F|empty(M|ytpverrechnanf)
.formula M|ylisonstkost  = M|ylisonstkost  + M|ytsonstkost              ? _F|empty(M|ytpverrechnanf)
.formula M|yfertleist    = M|yfertleist    + M|ytfertleist              ?  F|empty(M|ytpverrechnanf)
.formula M|ylifertleist  = M|ylifertleist  + M|ytfertleist              ? _F|empty(M|ytpverrechnanf)
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC008: ----- Preis_aus_Rahmen -----
.continue EL008 ? _(G|mehr)
.load 0 line
!LOOP003: ==============================
.continue ELOP003 ? _((G|mehr) & (U|xrpreis = 0))
.continue EL009 ? _(0|art^id = M|ytartex^id)
.formula U|xrpreis = 0|preis * 0|pehe                                           ? 0|pland =  G|inland
.formula U|xrpreis = F|fxamount(G|inland,0|preis,G|datum,0|pland) * 0|pehe      ? 0|pland <> G|inland
!EL009
.load 0 line
.continue LOOP003
!ELOP003: ==============================
!EL008
.continue 'xprocst.xprocsp'
!PROC009: ----- Teilprojekt_und_Verrechnungsanforderung_aktualisieren -----
.continue EL010 ? _(_(F|empty(M|yteilprojekt)))
.select lock add M|yteilprojekt
.continue EL011 ? _(G|mehr)
.formula H|ytpwert       = M|ywert
.formula H|ytpoffwert    = M|yowert
.formula H|ytpeigenleist = M|yeigenleist
.formula H|ytpfremdleist = M|yfremdleist
.formula H|ytpsonstkost  = M|ysonstkost
.formula H|ytpfertleist  = M|yfertleist
.rewrite
.continue FI011
!EL011
.set TRANS +
.box Hinweis
Das Teilprojekt 'M|yteilprojekt' kann nicht bearbeitet werden.
Werte im Teilprojekt kînnen nicht aktualisiert werden.
.set TRANS -
!FI011
!EL010
.continue EL012 ? _(_(F|empty(M|ytpverrechnanf)))
.select lock add M|ytpverrechnanf
.continue EL013 ? _(G|mehr)
.formula H|ydatum        = M|yveranfdatum
.formula H|ylzraumvon    = M|ylzraumvon
.formula H|ylzraumbis    = M|ylzraumbis
.formula H|ybetrag       = M|yliwert
.formula H|yvaeigenleist = M|ylieigenleist
.formula H|yvafremdleist = M|ylifremdleist
.formula H|yvasonstkost  = M|ylisonstkost
.formula H|yvafertleist  = M|ylifertleist
.rewrite
.continue FI013
!EL013
.set TRANS +
.box Hinweis
Die Verrechnungsanforderung 'M|ytpverrechnanf' kann nicht bearbeitet werden.
Werte der Verrechnungsanforderung kînnen nicht aktualisiert werden.
.set TRANS -
!FI013
!EL012
.continue 'xprocst.xprocsp'
!PROC010: ----- Icon_fuer_abrechenbare_Leistungen -----
.assign U|xbok = G|FALSE
.assign U|xblm = G|FALSE
.assign U|xbmz = G|FALSE
.assign U|xbmm = G|FALSE
.assign U|xbsm = G|FALSE
.continue EL014 ? _(_(F|empty(M|ytorigpos)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ytppos==" + M|ytorigpos^id
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
.assign U|xbmehr = G|mehr
!LOOP004: ==============================
.continue ELOP004 ? _(U|xbmehr)
.continue EL015 ? _(_(F|empty(0|yrefid)))
.load 1 group 'U|xydbgraufgabe' '0|yrefid'
.continue EL016 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yaufgabe==" + 1|id
.formula U|xtsel = U|xtsel + ";ylsrelev==1"
.formula U|xtsel = U|xtsel + ";ytpposid==`"
.formula U|xtsel = U|xtsel + ";yadatum=!"  + 'M|ylzraumbis'
.formula U|xtsel = U|xtsel + ";yedatum="   + 'M|ylzraumvon' + "!"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL017 ? _(G|mehr)
.assign U|xbok   = G|TRUE
.assign U|xbmehr = G|FALSE
.continue FI017
!EL017
.load 0 continue
.assign U|xbmehr = G|mehr
!FI017
.continue FI016
!EL016
.load 0 continue
.assign U|xbmehr = G|mehr
!FI016
.continue FI015
!EL015
.load 0 continue
.assign U|xbmehr = G|mehr
!FI015
.continue LOOP004
!ELOP004: ==============================
.continue EL018 ? _((_(U|xbok)) & (M|ytartex^yprjmprkatartk = "ML"))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yteilprojekt==" + M|yteilprojekt^id
.formula U|xtsel = U|xtsel + ";ytpverrechanf==`"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.select group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ytppos==" + H|id
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
.assign U|xbmehr = G|mehr
!LOOP006: ==============================
.continue ELOP006 ? _(U|xbmehr)
.continue EL019 ? _(_(F|empty(0|yrefid)))
.load 1 group 'U|xydbgraufgabe' '0|yrefid'
.assign U|xbmehr = G|mehr
.continue EL020 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yaufgabe==" + 1|id
.formula U|xtsel = U|xtsel + ";ylsrelev==1"
.formula U|xtsel = U|xtsel + ";yadatum=!"    + 'M|ylzraumbis'
.formula U|xtsel = U|xtsel + ";yedatum="     + 'M|ylzraumvon' + "!"
.formula U|xtsel = U|xtsel + ";ymaschvkart=" +  M|ytartex^id
.formula U|xtsel = U|xtsel + ";ymztpposid==`"
.formula U|xtsel = U|xtsel + ";ymaschzeit<>0"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL021 ? _(G|mehr)
.assign U|xbok   = G|TRUE
.assign U|xbmehr = G|FALSE
.continue FI021
!EL021
.load 0 continue
.assign U|xbmehr = G|mehr
!FI021
!EL020
.continue FI019
!EL019
.load 0 continue
.assign U|xbmehr = G|mehr
!FI019
.continue LOOP006
!ELOP006: ==============================
.select continue
.continue LOOP005
!ELOP005: ==============================
!EL018
!EL014
.continue EL022 ? _(_(F|empty(M|yttppos)))
.formula U|xtsel = "$,,ytpposid==" + M|yttppos^id + ";@ablageart=(1)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL023 ? _(G|mehr)
.assign U|xblm = G|TRUE
!EL023
.formula U|xtsel = "$,,ymztpposid==" + M|yttppos^id + ";@ablageart=(1)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL024 ? _(G|mehr)
.assign U|xbmz = G|TRUE
!EL024
.formula U|xtsel = "$,,ytmmtpposid==" + M|yttppos^id+ ";@ablageart=(1);@zeilen=ja"
.select group 'U|xydbgrmatmeldung' 'U|xtsel'
.continue EL025 ? _(G|mehr)
.assign U|xbmm = G|TRUE
!EL025
.formula U|xtsel = "$,,ytsmtpposid==" + M|yttppos^id + ";@ablageart=(1);@zeilen=ja"
.select group 'U|xydbgrsubmeldung' 'U|xtsel'
.continue EL026 ? _(G|mehr)
.assign U|xbsm = G|TRUE
!EL026
!EL022
.formula M|ytbuabrechnung = "icon:icecube"              ? _U|xbok & _U|xblm & _U|xbmz & _U|xbmm & _U|xbsm
.formula M|ytbuabrechnung = "icon:cube_green"           ?  U|xbok & _U|xblm & _U|xbmz & _U|xbmm & _U|xbsm
.formula M|ytbuabrechnung = "icon:package"              ? _U|xbok & (U|xblm ;  U|xbmz ;  U|xbmm ;  U|xbsm)
.formula M|ytbuabrechnung = "icon:cube_yellow"          ?  U|xbok & (U|xblm ;  U|xbmz ;  U|xbmm ;  U|xbsm)
.continue 'xprocst.xprocsp'
!PROC011: ----- Tabelle_leeren -----
.formula M|ywert         = 0
.formula M|yliwert       = 0
.formula M|yowert        = 0
.formula M|yeigenleist   = 0
.formula M|ylieigenleist = 0
.formula M|yfremdleist   = 0
.formula M|ylifremdleist = 0
.formula M|ysonstkost    = 0
.formula M|ylisonstkost  = 0
.formula M|yfertleist    = 0
.formula M|ylifertleist  = 0
.make screen line --O
.continue 'xprocst.xprocsp'
!PROC012: ----- Tabelle_laden -----
.formula U|xtsel = "$,,yteilprojekt=="  + M|yteilprojekt^id + ";ytpverrechanf==`"       ?  F|empty(M|ytpverrechnanf)
.formula U|xtsel = "$,,yteilprojekt=="  + M|ytpverrechnanf^yteilprojekt^id              ? _F|empty(M|ytpverrechnanf)
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.select group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.continue EL027 ? _((F|empty(H|ytpverrechanf)) ; (H|ytpverrechanf = "(0,0,0)"))
.formula M|ywert         = M|ywert         + H|ypwert
.formula M|yeigenleist   = M|yeigenleist   + H|yeigenleist
.formula M|yfremdleist   = M|yfremdleist   + H|yfremdleist
.formula M|ysonstkost    = M|ysonstkost    + H|ysonstkost
.formula M|yfertleist    = M|yfertleist    + H|yfertleist
.continue FI027
!EL027
.continue EL028 ? _(H|ytpverrechanf = M|ytpverrechnanf^id)
.formula M|yliwert       = M|yliwert       + H|yliwert
.formula M|ylieigenleist = M|ylieigenleist + H|yeigenleist
.formula M|ylifremdleist = M|ylifremdleist + H|yfremdleist
.formula M|ylisonstkost  = M|ylisonstkost  + H|ysonstkost
.formula M|ylifertleist  = M|ylifertleist  + H|yfertleist
!EL028
!FI027
.continue EL029 ? _((F|empty(M|ytpverrechnanf)) ; (F|empty(H|ytpverrechanf)) ; (H|ytpverrechanf = "(0,0,0)") ; (H|ytpverrechanf = M|ytpverrechnanf^id))
.assign U|xbok = G|TRUE
.continue EL030 ? _((_(F|empty(M|ytpverrechnanf))) & ((F|empty(H|ytpverrechanf)) ; (H|ytpverrechanf = "(0,0,0)")))
.formula U|xtsel = "$,,yorig=="  + H|id + ";ytpverrechanf==" + M|ytpverrechnanf^id
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
.assign U|xbok = _G|mehr
.assign U|xbok = G|FALSE        ? _F|empty(H|yposstatus)
!EL030
.continue EL031 ? _(U|xbok)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC006
!RET003
.formula xprocsp = xprocsp - 1
.continue EL032 ? _(_(F|empty(M|ytpverrechnanf)))
.assign M|yttppos     = H|id            ? _F|empty(H|yorig)
.assign M|ytorigpos   = H|yorig         ? _F|empty(H|yorig)
.assign M|ytorigpos   = H|id            ?  F|empty(H|yorig)
.formula M|ytmge          = M|ytorigpos^ymge            ? H|ytpverrechanf = M|ytpverrechnanf^id
.formula M|ytpwert        = M|ytorigpos^ypwert          ? H|ytpverrechanf = M|ytpverrechnanf^id
.formula M|yteigenleist   = 0                           ? F|empty(M|yttppos)
.formula M|ytfremdleist   = 0                           ? F|empty(M|yttppos)
.formula M|ytsonstkost    = 0                           ? F|empty(M|yttppos)
.formula M|ytfertleist    = 0                           ? F|empty(M|yttppos)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
.continue FI032
!EL032
.assign M|yttppos     = H|id
.assign M|ytorigpos   = H|yorig
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
!FI032
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC005
