..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsys     ? _F|defined(U|xtsys)
.type text    xtsel     ? _F|defined(U|xtsel)
.type text    xttitel   ? _F|defined(U|xttitel)
.type integer xizeile   ? _F|defined(U|xizeile)
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- CheckNew -----
.continue EL001 ? _(M|ueb)
.set trans +
.formula U|xttitel = "Achtung!"
.box 'U|xttitel'
Wenn "Buchen" gesetzt ist, darf keine Submeldung angelegt werden.
.set trans -
.error (0)
.end 1
.continue FI001
!EL001
.continue EL002 ? _(G|evtkommd = G|kaktname14)
.set trans +
.formula U|xttitel = "Achtung!"
.box -button ok:cancel -title 'U|xttitel'
Die Rechnung wurde noch nicht gespeichert.
Die Rechnung wird zwischengespeichert.
.set trans -
.error (0)  ? _G|box = G|boxyes
.end 1      ? _G|box = G|boxyes
!EL002
!FI001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL003 ? _(G|evtmaske = 46)
.continue BRK001 ? _(G|evtartengl = "BUTTON_BEFORE")
.continue BRK002 ? _(G|evtvar = "yprjmbusubreport")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK002
.continue BRK003 ? _(G|evtvar = "yprjmpbusubreport")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK001
.continue BRK004 ? _(G|evtartengl = "BUTTON_AFTER")
.continue BRK005 ? _(G|evtvar = "yprjmbusubreport")
.formula U|xtsel = ""
.load 0 group "147:3" 'F|expr("$,,yekrechid==" + M|id + ";@filingmode=(Active)")'
.continue EL004 ? _(G|mehr)
.load 9 add 0|id
.load 0 continue
.continue EL005 ? _(G|mehr)
.formula U|xtsel = "<(ProjectSuiteReports)> %,,nummer=;such=;sucherw=;ylieferant=;yprojekt=;yekrechid==" + M|id + ";@filingmode=(Active);@autostart=(Yes)"
.continue FI005
!EL005
.formula U|xtsel = "<(ProjectSuiteReports)>" + 9|id
!FI005
.formula U|xtsel = U|xtsel + "<(View)>"     ? _G|evtkommd = G|kaktname13 & _G|evtkommd = G|kaktname14 & _G|evtkommd = G|kaktname5
.formula U|xtsel = U|xtsel + "<(Edit)>"     ?  G|evtkommd = G|kaktname13 ;  G|evtkommd = G|kaktname14 ;  G|evtkommd = G|kaktname5
.formula U|xtsel = U|xtsel + ",(SubReport)"
.continue FI004
!EL004
.formula U|xtsel = "<(ProjectSuiteReports)><(New)>,(SubReport)"
.formula U|xtsel = U|xtsel + "?yekrechid="    + M|id
.formula U|xtsel = U|xtsel + "|ysekrechnung=" + M|id
!FI004
.command -parallel 'U|xtsel'    ? _F|empty(U|xtsel)
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "yprjmpbusubreport")
.formula U|xtsel = ""
.load 0 group "147:3" 'F|expr("$,,ytekreposid==" + M|id + ";@filingmode=(Active);@rows=(Yes)")'
.continue EL006 ? _(G|mehr)
.formula U|xizeile = 0|selzeile
.load 9 add 0|id
.load 0 continue
.continue EL007 ? _(G|mehr)
.formula U|xtsel = "%,,nummer=;such=;sucherw=;ylieferant=;yprojekt=;ytsubpersname=;ytdatum=;yteil=;ytekreposid==" + M|id + ";@filingmode=(Active);@autostart=(Yes);@rows=(Yes)"
.load 9 group "147:3" 'U|xtsel'
.continue EL008 ? _(G|mehr)
.formula U|xtsel = "<(ProjectSuiteReports)>" + 9|id
.formula U|xizeile = 9|selzeile
.continue FI008
!EL008
.formula U|xtsel = ""
!FI008
.continue FI007
!EL007
.formula U|xtsel = "<(ProjectSuiteReports)>" + 9|id
!FI007
.continue EL009 ? _(F|defined(9|id))
.continue EL010 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14) ; (G|evtkommd = G|kaktname5))
.formula U|xtsel = U|xtsel + "<(Edit)>"
.continue FI010
!EL010
.formula U|xtsel = U|xtsel + "<(View)>"
!FI010
.formula U|xtsel = U|xtsel + "?[pos]=" + 'U|xizeile'
!EL009
.continue FI006
!EL006
.formula U|xtsel = ""
.select screen header
.load 0 group "147:3" 'F|expr("$,,yekrechid==" + M|id + ";@filingmode=(Active)")'
.continue EL011 ? _(G|mehr)
.load 9 add 0|id
.load 0 continue
.continue EL012 ? _(G|mehr)
.formula U|xtsel = "%,,nummer=;such=;sucherw=;ylieferant=;yprojekt=;yekrechid==" + M|id + ";@filingmode=(Active);@autostart=(Yes)"
.load 9 group "147:3" 'U|xtsel'
.formula U|xtsel = ""
.formula U|xtsel = "<(ProjectSuiteReports)>" + 9|id     ? G|mehr
.continue FI012
!EL012
.formula U|xtsel = "<(ProjectSuiteReports)>" + 9|id
!FI012
.continue EL013 ? _(F|defined(9|id))
.select screen line 'G|evtzeile'
.continue EL014 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14) ; (G|evtkommd = G|kaktname5))
.formula U|xtsel = U|xtsel + "<(Edit)>"
.formula U|xtsel = U|xtsel + "?[insert]="
.formula U|xtsel = U|xtsel + "|#:ytekreposid=" + M|id
.formula U|xtsel = U|xtsel + "|#:ytekreposvp=" + M|id
.formula U|xtsel = U|xtsel + "|#:ytpvorgang="  + M|yprjmppvorgang^id    ? _F|empty(M|yprjmppvorgang)
.formula U|xtsel = U|xtsel + "|#:yteil="       + M|artikel^id
.formula U|xtsel = U|xtsel + "|#:ymge="        +'M|mge'
.formula U|xtsel = U|xtsel + "|#:ytbeschreib=" + M|ptext
.continue FI014
!EL014
.formula U|xtsel = U|xtsel + "<(View)>"
!FI014
!EL013
.continue FI011
!EL011
.formula U|xtsel = "<(ProjectSuiteReports)><(New)>,(SubReport)"
.formula U|xtsel = U|xtsel + "?yekrechid="    + M|id
.formula U|xtsel = U|xtsel + "|ysekrechnung=" + M|id
.select screen line 'G|evtzeile'
.formula U|xtsel = U|xtsel + "|yprojekt="      + M|projekt^id           ? _F|empty(M|projekt)
.formula U|xtsel = U|xtsel + "|[insert]=1"
.formula U|xtsel = U|xtsel + "|1:ytekreposid=" + M|id
.formula U|xtsel = U|xtsel + "|1:ytekreposvp=" + M|id
.formula U|xtsel = U|xtsel + "|#:ytpvorgang="  + M|yprjmppvorgang^id    ? _F|empty(M|yprjmppvorgang)
.formula U|xtsel = U|xtsel + "|#:yteil="       + M|artikel^id
.formula U|xtsel = U|xtsel + "|#:ymge="        +'M|mge'
.formula U|xtsel = U|xtsel + "|#:ytbeschreib=" + M|ptext
!FI011
!FI006
.command -parallel 'U|xtsel'    ? _F|empty(U|xtsel)
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK004
!ESAC001: =====   ENDCASE   =====
!EL003
.continue
