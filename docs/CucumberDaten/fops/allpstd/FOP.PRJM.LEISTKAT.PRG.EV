!EPROCDEF: ----- end procedure definitions -----
.continue   ? _F|sysinfo(18)^allpstd
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"           ? _F|defined(5|ybleistkat)
.formula U|xtprojekt        = ""
.formula U|xtprojleistkatid = ""
.formula U|xyvarprg         = "yprg"
.formula U|xyvarkunde       = "ykunde"
.formula U|xtprojekt        = M|id                  ?   M|dnr = U|xydbprojekt &  M|gruppe = U|xygrprojekt
.formula U|xtprojekt        = M|yprojekt^id         ? (_M|dnr = U|xydbprojekt ; _M|gruppe = U|xygrprojekt) & F|defined(M|yprojekt^id)
.formula U|xtprojleistkatid = M|yprojleistkatid     ?  F|defined(M|yprojleistkatid)
.formula U|xtprojleistkatid = M|yprojleistkat^id    ?  F|defined(M|yprojleistkat)
.copy    U|xyprgtyp   = M|yprgtypk                  ? F|defined(M|yprgtypk)
.copy    U|xyprgtyp   = M|yprjmprgtypk              ? F|defined(M|yprjmprgtypk)
.continue EL055 ? _(M|dnr = 3)
.formula U|xyvarprg         = "prg"
.formula U|xyvarkunde       = "kunde"
.formula U|xtprojekt        = M|yprjmproj^id
.formula U|xtprojleistkatid = M|yprjmsprleistkat^id         ?  F|empty(M|yprjmproj)
.formula U|xtprojleistkatid = M|yprjmproj^yprojleistkatid   ? _F|empty(M|yprjmproj)
!EL055
.continue BRK005 ? _(G|evtart = "maskaus")
.continue EL056 ? _(G|evtmaske = 1041)
.continue EL057 ? _((G|evtkommd = G|kaktname14) & (F|empty(M|yprojleistkatid)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
