..!interpreter english declaration noabbrev
.. at 2016-10-25, 16:54
.set trans -
..========================================================================
..==  Name              : IS.PRJMMSBILLING.TAB
..==  Pfad              : allpstd
..==  Funktion          : Laden der Tabellen zeilen fÅr IS PRJMMSBILLING
..==  Erstellungsdatum  : 17.05.2016
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- RechnungswertErmitteln -----
.load 1 add M|ytaupos
.continue EL001 ? _(G|mehr)
.load 9 add 1|kopf
.formula M|ytauwert = 1|pwert                                       ?  9|waehr = G|inland
.formula M|ytauwert = F|fxamount(G|inland,1|pwert,,9|waehr,G|true)  ? _9|waehr = G|inland & _9|kursfix
.formula M|ytauwert = (1|pwert * 9|ewkurs)                          ? _9|waehr = G|inland &  9|kursfix
.load 9
.formula U|xtsel = "$,,orig==" + 1|id + ";@filingmode=(Both)"
.load 2 group "3:2" 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy    U|xbmehr   = G|mehr
.continue EL002 ? _('2|kotyp(L=":")' = "(PackingSlip)")
.formula U|xtsel = "$,,orig==" + 2|id + ";@filingmode=(Both)"
.load 3 group "3:2" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.load 9 add 3|kopf
.formula U|xrrewert = U|xrrewert + 3|pwert                                       ?  9|waehr = G|inland
.formula U|xrrewert = U|xrrewert + F|fxamount(G|inland,3|pwert,,9|waehr,G|true)  ? _9|waehr = G|inland & _9|kursfix
.formula U|xrrewert = U|xrrewert + (3|pwert * 9|ewkurs)                          ? _9|waehr = G|inland &  9|kursfix
.load 3 continue
.continue LOOP002
!ELOP002: ==============================
.continue FI002
!EL002
.load 9 add 2|kopf
.formula U|xrrewert = U|xrrewert + 2|pwert                                       ?  9|waehr = G|inland
.formula U|xrrewert = U|xrrewert + F|fxamount(G|inland,2|pwert,,9|waehr,G|true)  ? _9|waehr = G|inland & _9|kursfix
.formula U|xrrewert = U|xrrewert + (2|pwert * 9|ewkurs)                          ? _9|waehr = G|inland &  9|kursfix
!FI002
.load 2 continue
.continue LOOP001
!ELOP001: ==============================
.continue EL003 ? _(U|xbmehr)
.formula M|ytrewert    = U|xrrewert
.formula M|ytbaumaufzu = "icon:folder_closed"
.formula M|tbaumstat   = "+"
!EL003
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "buttonnach")
.continue BRK002 ? _(G|evtvar = "bstart")
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="   + H|id
.formula U|xtsel = U|xtsel + ";ybmsrechnung==(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@order=yadatum"
.load 0 group 'M|grliste' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.make screen line +O
.assign  M|ytprojekt  = H|id
.assign  M|ytpvorgang = 0|id
.formula M|ytpvname   = 0|namebspr
.copy    M|ytstatus   = 0|ystatus
.assign  M|ytaupos    = 0|yvorpos
.assign  M|ytaukopf   = M|ytaupos^kopf^id
.copy    M|ytadatum   = 0|yadatum
.formula U|xrrewert = 0
.copy    U|xbmehr   = G|false
.continue EL004 ? _(_(F|empty(M|ytaupos)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL004
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
.continue ESAC002
!BRK002
.continue BRK003 ? _(G|evtvar = "ytburechnung")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK001
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMMSBILLING.TAB")'  ? F|fileexists(F|foppath("IFOP.IS.PRJMMSBILLING.TAB"))
.continue
