..!interpreter english declaration noabbrev
.set trans -
..========================================================================
..==  Name              : FOP.PRJM.TPPOSSTATISTIK.CRON
..==  Pfad              : allpstd
..==  Funktion          : Statistik fr Teilprojektposition anlegen
..==  Erstellungsdatum  : 21.11.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbgrtpposition)
..====================================================
.type text    xtsys xtsel xtcmd
.type GD      xdbezugsdatum
.type GD19    xdzeitpunkt xdletztlauf xd19 xdlastrun
.type ZAE1    xversionn
.type bool    xbok
.type text    xtprojekt             ? _F|defined(U|xtprojekt)
.type integer xprocsp               ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- TPPositionen_laden -----
.copy U|xbok = G|TRUE
.formula U|xtsel = "$,,ytpposid==" + 0|id + ";ybezugsdatum==" + U|xdbezugsdatum:8 + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrtpposstat' 'U|xtsel'
.continue EL001 ? _(G|mehr)
.select lock add 9|id
.continue EL002 ? _(_(G|mehr))
.set trans +
FEHLER: Teilprojektposition-Statistiksatz '9|numer' zu Teilprojektposition '0|id' kann nicht bearbeitet werden.
        Die Teilprojektposition wird bersprungen
.set trans -
.copy U|xbok = G|FALSE
!EL002
.continue FI001
!EL001
.formula U|xtcmd = "make " + G|hdatname.xydbtpposstat + " GROUP" + 'U|xygrtpposstat'
.'U|xtcmd'
!FI001
.continue EL003 ? _(U|xbok)
.formula H|such           = "S" + U|xdbezugsdatum:8
.formula H|ytpposid       = 0|id
.formula H|ybezugsdatum   = U|xdbezugsdatum
.formula H|name           = 0|name
.copy    H|yteilprojekt   = 0|yteilprojekt
.formula H|ytpverrechanf  = 0|ytpverrechanf
.formula H|yorig          = 0|yorig
.formula H|ypnum          = 0|ypnum
.formula H|yabrechtypk    = 0|yabrechtypk
.copy    H|yartex         = 0|yartex
.formula H|ymge           = 0|ymge
.formula H|ylimge         = 0|ylimge
.formula H|ypreis         = 0|ypreis
.formula H|ypwert         = 0|ypwert
.formula H|yliwert        = 0|yliwert
.formula H|yeigenleist    = 0|yeigenleist
.formula H|yfremdleist    = 0|yfremdleist
.formula H|ysonstkost     = 0|ysonstkost
.formula H|yfertleist     = 0|yfertleist
.formula H|yolimge        = 0|yolimge
.formula H|yoliwert       = 0|yoliwert
.formula H|yptext         = 0|yptext
.formula H|yvorpos        = 0|yvorpos
.formula H|yvornum        = 0|yvornum
.formula H|yposstatus     = 0|yposstatus
.formula H|yablagen       = 0|yablagen
.copy    H|ynabrechrelev  = 0|ynabrechrelev
.rewrite
!EL003
.continue 'xprocst.xprocsp'
!PROC002: ----- geloeschtePositionen -----
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.load 0 group 'U|xydbgrtpposition' '9|ytpposid'
.continue EL004 ? _(_(G|mehr))
.select lock add 9|id
.continue EL005 ? _(_(G|mehr))
.set trans +
FEHLER: Teilprojektposition-Statistiksatz '9|numer' zu Teilprojektposition '0|id' kann nicht bearbeitet werden.
        Die Teilprojektposition wird bersprungen
.set trans -
.copy U|xbok = G|FALSE
!EL005
.continue EL006 ? _(U|xbok)
.assign H|yablagen  = U|xversionn
.formula H|yolimge        = 0
.formula H|yoliwert       = 0
.rewrite
!EL006
!EL004
.load 9 continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula U|xdzeitpunkt = G|zeitpunkt
.formula U|xversionn   = G|versionneu
.formula U|xd19          = ">M"
.formula U|xdbezugsdatum = U|xd19
.continue EL007 ? _(F|empty(U|xtprojekt))
===============================================================================
.set trans +
Teilprojektposition Statistik 'G|txname'
Start:        'U|xdzeitpunkt'
Bezugsdatum:  'U|xdbezugsdatum'
.set trans -

.select lock object 'F|sysinfo(10)^ykonfigprjm^id
.continue EL008 ? _(G|mehr)
.assign U|xdletztlauf = H|ypmllauftpposstat
.assign U|xdlastrun   = H|ypmllauftpposstat
.set trans +
letzter Lauf: 'U|xdlastrun'
.set trans -
.formula U|xtsel = "$,,ytpverrechanf==`;yorig==`;yposstatus==`;@filingmode=(Active)"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.formula U|xtsel = "$,,ytpverrechanf==`;yorig==`;yposstatus<>`;yablagen>=" + 'U|xdletztlauf:14' + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
.formula U|xtsel = "$,,ybezugsdatum==" + U|xdbezugsdatum:8 + ";versionn<=" + 'U|xversionn' + ";yablagen==`" + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrtpposstat' 'U|xtsel'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.select lock object 'F|sysinfo(10)^ykonfigprjm^id
.continue EL009 ? _(G|mehr)
.formula U|xdletztlauf       = H|ypmllauftpposstat
.formula H|ypmllauftpposstat = U|xdzeitpunkt
.formula H|yvnllauftpposstat = U|xversionn
.rewrite
.set trans +
Ende:         'G|zeitpunkt'
.set trans -
===============================================================================
.continue FI009
!EL009
FEHLER: ProjectSuite Konfiguration kann nicht zum bearbeiten ge”ffnet werden.
        Eintrag letzter Statistiklauf ist nicht m”glich
!FI009
.continue FI008
!EL008
FEHLER: ProjectSuite Konfiguration kann nicht zum bearbeiten ge”ffnet werden.
PROGRAMMABBRUCH
.continue
!FI008
.continue FI007
!EL007
.load 9 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL010 ? _(G|mehr)
.formula U|xtsel = "$,,yteilprojekt==" + U|xtprojekt + ";ytpverrechanf==`;yorig==`;yposstatus==`;@filingmode=(Active)"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsel = "$,,yteilprojekt==" + U|xtprojekt + ";ytpverrechanf==`;yorig==`;yposstatus<>`;yablagen>=" + 'U|xdletztlauf:14' + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrtpposition' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP005
!ELOP005: ==============================
.formula U|xtsel = "$,,yteilprojekt==" + U|xtprojekt + ";ybezugsdatum==" + U|xdbezugsdatum:8 + ";versionn<=" + 'U|xversionn' + ";yablagen==`" + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrtpposstat' 'U|xtsel'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
!EL010
!FI007
.continue
