!RET010
.formula xprocsp = xprocsp - 1
!FI018
.formula U|xthilf1 = U|xtytprjvorgang
.continue ESAC009
!BRK039
.continue BRK040 ? _(M|ygruppierungk = "AP")
.continue EL019 ? _((_(U|xthilf1 = U|xtytarbpaket)) & (_(F|empty(U|xthilf1))))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET011" 
