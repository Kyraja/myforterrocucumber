..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
.input DATEI.F
.input is/ABASFARBEN.DEF
..====================================================
.type text    xtcmd xtsel xtsys xtread1 xtread2 xtread3 xtread4 xtread5 xtread6 xtsavedat xtles xtmmmzkenn
.type text    xtbezyspalte1 xtvkpos xtvknum
.type text    xtytvkartikel xtytprjvorgang xtytbearbeiter xtytpreis xtytmge xtytwert xtytgewerk
.type text    xtytlsposid xtytlsnum xtytarbpaket xtytlnid xtmerkmmmz
.type text    xthilf1 xthilf2 xthilf3 xthilf4 xthilf5 xthilf6 xthilf7 xthilftext
.type real    xrsumkosten xrytwert xrsumstunden
.type R7.3    xrytmge
.type real    xrgeskosten xrgesstunden xrbearbeiterstunden xrbearbeiterkosten
.type integer xianzsummen
.type GD19    xdbis
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Gruppenzeile -----
.continue EL001 ? _(F|empty(U|xtmmmzkenn))
.make screen line +O
.formula M|yzkenner = 4
.continue BRK001 ? _(M|ygruppierungk = "VKART")
.formula M|ytvkartikel = U|xtytvkartikel
.text U|xtbezyspalte1 'G|kspr' Verkaufte Leistung
.formula M|yspalte1    = U|xtbezyspalte1 + ": " + M|ytvkartikel^namebspr
.formula M|ytvkartikel = ""
.continue ESAC001
!BRK001
.continue BRK002 ? _(M|ygruppierungk = "GEW")
.formula M|ytgewerk   = U|xtytgewerk
.text U|xtbezyspalte1 'G|kspr' Gewerk
.formula M|yspalte1   = U|xtbezyspalte1 + ": " +  M|ytgewerk^namebspr
.formula M|ytgewerk = ""
.continue ESAC001
!BRK002
.continue BRK003 ? _(M|ygruppierungk = "PT")
.formula M|ytprjvorgang = U|xtytprjvorgang
.text U|xtbezyspalte1 'G|kspr' Projektvorgang
.formula M|yspalte1   = U|xtbezyspalte1 + ": " + M|ytprjvorgang^namebspr
.continue ESAC001
!BRK003
.continue BRK004 ? _(M|ygruppierungk = "AP")
.formula M|ytarbpaket = U|xtytarbpaket
.text U|xtbezyspalte1 'G|kspr' Arbeitspaket
.formula M|yspalte1   = U|xtbezyspalte1 + ": " + M|ytarbpaket^namebspr
.continue ESAC001
!BRK004
.continue BRK005 ? _(M|ygruppierungk = "LSRE")
.formula M|ytlsposid = U|xtytlsposid
.assign  M|ytlsnum   = M|ytlsposid^kopf^id
.text U|xtbezyspalte1 'G|kspr' LS/RE
.formula M|yspalte1  = U|xtbezyspalte1 + ": " +  M|ytlsnum^nummer + " " + M|ytlsnum^betreff
.formula M|ytlsposid = ""
.continue ESAC001
!BRK005
.continue BRK006 ? _(M|ygruppierungk = "LSREPOS")
.formula M|ytlsposid = U|xtytlsposid
.assign  M|ytlsnum   = M|ytlsposid^kopf^id
.text U|xtbezyspalte1 'G|kspr' LS/RE - Pos
.formula M|yspalte1  = U|xtbezyspalte1 + ": " +  M|ytlsposid^ptext
.formula M|ytlsposid = ""
.continue ESAC001
!BRK006
.continue BRK007 ? _(M|ygruppierungk = "LSREGEW")
.formula M|ytlsposid = U|xtytlsposid
.assign  M|ytlsnum   = M|ytlsposid^kopf^id
.formula M|ytgewerk  = U|xtytgewerk
.text U|xtbezyspalte1 'G|kspr' LS/RE - Pos
.formula M|yspalte1  = U|xtbezyspalte1 + ": " +  M|ytlsposid^ptext  + ";"           ? _F|empty(M|ytlsposid)
.text U|xtbezyspalte1 'G|kspr' Gewerk
.formula M|yspalte1  = M|yspalte1  + U|xtbezyspalte1 + ": " + M|ytgewerk^namebspr   ? _F|empty(M|ytgewerk)
.formula M|ytlsposid = ""
.continue ESAC001
!BRK007
.make screen line -O
!ESAC001: =====   ENDCASE   =====
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Wert_hochrechnen -----
.continue 'xprocst.xprocsp'
!PROC003: ----- Wert_ausgeben -----
.make screen line +o
.colour -background 'xabaslightgreen' 'M|aktzeile'
.continue EL002 ? _(U|xblastsum)
.formula M|ytwert = U|xrsumkosten
.formula M|ytmge  = U|xrsumstunden
.continue FI002
!EL002
.formula M|ytwert = U|xrsumkosten  - U|xrytwert
.formula M|ytmge  = U|xrsumstunden - U|xrytmge
!FI002
.formula U|xrsumstunden = U|xrytmge
.formula U|xrsumkosten  = U|xrytwert
.formula M|yzkenner     = 1
.formula U|xbgruppenausgabe = G|TRUE
.continue EL003 ? _(_(U|xblastsum))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL003
.formula U|xianzsummen = U|xianzsummen + 1
.continue 'xprocst.xprocsp'
!PROC004: ----- Unterschriften -----
.select add M|yprojekt^ykunde
.text U|xthilftext 'G|kspr' Unterschrift Projektleiter
.select -
.formula M|ymeineunterschr = U|xthilftext
.formula M|ymeineunterschr = M|ymeineunterschr + ";" + F|sysinfo(10)^ans
.formula M|yunterschriftkd = U|xthilftext
.formula M|yunterschriftkd = M|yunterschriftkd + ";" + M|yprojekt^ykunde^ans
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK008 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.formula P|maskkontextfop = P|maskkontextfop + " EINZEL "
.assign  M|ygruppierungk = "VKART"
.formula M|ydrucklogo    = F|regreplaceall('F|sysinfo(10)^ykonfigprjm^ydrlogo' ,"\\", "/")
.copy M|ybdruwert    = G|TRUE
.copy M|ybdruexttext = G|TRUE
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC004
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK008
.continue BRK009 ? _(G|evtart = "feldfuell")
.continue BRK010 ? _(G|evtvar = "yvkpos")
.continue EL004 ? _(G|evtfeldneu = "?")
.formula U|xtsel ="%,,"
.formula U|xtsel = U|xtsel + ";projekt=" + M|yprojekt^id     ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";artex="
.formula U|xtsel = U|xtsel + ";kopf^nummer=" + 'M|yvkvorgang'
.formula U|xtsel = U|xtsel + ";mge=="
.formula U|xtsel = U|xtsel + ";ptext=="
.formula U|xtsel = U|xtsel + ";typ=="
.formula U|xtsel = U|xtsel + ";.kotyp=(4)!(5)"
.formula U|xtsel = U|xtsel + ";@.gruppe=2"
.formula U|xtsel = U|xtsel + ";@ablageart=(3)"
.formula U|xtsel = U|xtsel + ";@ordnung=id.rueckwaerts"
.formula U|xtsel = U|xtsel + ";@autostart=(1)"
.select group "P3:2" 'U|xtsel'
.formula G|evtfeldneu = H|id            ?  G|mehr
.formula G|evtfeldneu = M|yvkpos^id   ? _G|mehr
!EL004
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "yvkvorgang")
.continue EL005 ? _(G|evtfeldneu = "?")
.formula U|xtsel ="%,,"
.formula U|xtsel = U|xtsel + ";yprjmproj=" + M|yprojekt^id     ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";nummer="
.formula U|xtsel = U|xtsel + ";such="
.formula U|xtsel = U|xtsel + ";sucherw="
.formula U|xtsel = U|xtsel + ";typ=" + "(4)!(5)"
.formula U|xtsel = U|xtsel + ";@ablageart=(3)"
.formula U|xtsel = U|xtsel + ";@ordnung=id.rueckwaerts"
.formula U|xtsel = U|xtsel + ";@autostart=(1)"
.select group "P3:1" 'U|xtsel'
.formula G|evtfeldneu = H|id            ?  G|mehr
.formula G|evtfeldneu = M|yvkvorgang^id   ? _G|mehr
!EL005
.continue ESAC003
!BRK011
!ESAC003: =====   ENDCASE   =====
.continue ESAC002
!BRK009
.continue BRK012 ? _(G|evtart = "feldaus")
.continue   ? M|ybaufparam & _G|evtvar = "ybaufparam"
.input 'U|xtupprjmsel'
.make screen line --O
.continue BRK013 ? _(G|evtvar = "yvkvorgang")
.assign M|yvkpos = ""             ? _F|empty(M|yvkvorgang)
.continue EL006 ? _(_(F|empty(M|yvkvorgang)))
.formula M|ystdvondatum = M|yvkvorgang^yprjmlzraumvon
.formula M|ystdbisdatum = M|yvkvorgang^yprjmlzraumbis
.continue FI006
!EL006
.formula M|ystdvondatum = ""
.formula M|ystdbisdatum = ""
!FI006
.continue EL007 ? _(_(F|empty(M|yprojekt)))
.formula M|ykdnamezuprojekt = M|yprojekt^ykunde^ans
.formula M|yplnamezuprojekt = M|yprojekt^yprojleit^yprjmlsname
.continue FI007
!EL007
.formula M|ykdnamezuprojekt = ""
.formula M|yplnamezuprojekt = ""
!FI007
.continue ESAC004
!BRK013
.continue BRK014 ? _(G|evtvar = "yvkpos")
.formula M|yvkvorgang = M|yvkpos^kopf^id   ? _F|empty(M|yvkpos)
.continue EL008 ? _(_(F|empty(M|yprojekt)))
.formula M|ykdnamezuprojekt = M|yprojekt^ykunde^ans
.formula M|yplnamezuprojekt = M|yprojekt^yprojleit^yprjmlsname
.continue FI008
!EL008
.formula M|ykdnamezuprojekt = ""
.formula M|yplnamezuprojekt = ""
!FI008
.continue ESAC004
!BRK014
.continue BRK015 ? _(G|evtvar = "yprojekt")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC004
!RET003
.formula xprocsp = xprocsp - 1
.formula M|yvkvorgang = ""
.formula M|yvkpos     = ""
.continue EL009 ? _(_(F|empty(M|yprojekt)))
.formula M|ykdnamezuprojekt = M|yprojekt^ykunde^ans
.formula M|yplnamezuprojekt = M|yprojekt^yprojleit^yprjmlsname
.continue FI009
!EL009
.formula M|ykdnamezuprojekt = ""
.formula M|yplnamezuprojekt = ""
!FI009
.continue ESAC004
!BRK015
.continue BRK016 ? _(G|evtvar = "ystdvondatum")
.formula U|xdbis     = ">" +  'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
.continue ESAC004
!BRK016
.continue BRK017 ? _(G|evtvar = "ystdbisdatum")
.continue EL010 ? _(M|ystdbisdatum < M|ystdvondatum)
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
!EL010
.cursor yvkauftrag 0      ? F|defined(M|yvkauftrag)
.continue ESAC004
!BRK017
.continue BRK018 ? _(G|evtvar = "ybsummenblatt")
.formula P|maskkontextfop = P|maskkontextfop + " EINZEL "                       ? _M|ybsummenblatt & _F|regmatch(P|maskkontextfop, F|expr(".*EINZEL.*"),G|TRUE)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "EINZEL", "")     ?  M|ybsummenblatt &  F|regmatch(P|maskkontextfop, F|expr(".*EINZEL.*"),G|TRUE)
.continue ESAC004
!BRK018
!ESAC004: =====   ENDCASE   =====
.continue ESAC002
!BRK012
.continue BRK019 ? _(G|evtart = "buttonvor")
.continue BRK020 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC005
!BRK020
!ESAC005: =====   ENDCASE   =====
.continue ESAC002
!BRK019
.continue BRK021 ? _(G|evtart = "buttonnach")
.continue BRK022 ? _(G|evtvar = "bstart")
.input "allpstart/PRJM.FARBEN.DEF"
.type text xtperfrepdat
.input DATEI.F
.file -TEMPNAME U|xtperfrepdat
.formula U|xtsavedat = "rmtmp/X.PRJMSTDNACHWEIS." + pid + ".TMP"
.continue EL011 ? _((_(F|empty(M|yprojekt))) ; ((F|empty(M|yvkvorgang)) & (F|empty(M|yvkpos))))
.input 'U|xtupprjmsel'
.continue FI011
!EL011
.input 'M|tab'
!FI011
.select add M|yprojekt^ykunde
.text M|yueberspalte1 'G|kspr' Projektvorgang       ?  M|yshowprjvorg
.text M|yueberspalte1 'G|kspr' Verkaufte Leistung   ? _M|yshowprjvorg
.select -
.formula U|xtsys = "sort -t# -k14,14"
.continue BRK023 ? _(M|ygruppierungk = "VKART")
.formula U|xtsys = U|xtsys + " -k15,15 -k1,1"
.continue ESAC007
!BRK023
.continue BRK024 ? _(M|ygruppierungk = "GEW")
.formula U|xtsys = U|xtsys + " -k16,16 -k7,7"
.continue ESAC007
!BRK024
.continue BRK025 ? _(M|ygruppierungk = "PT")
.formula U|xtsys = U|xtsys + " +14 -15 +1 -2  "
.continue ESAC007
!BRK025
.continue BRK026 ? _(M|ygruppierungk = "AP")
.formula U|xtsys = U|xtsys + " +16 -17 +8 -9 "
.continue ESAC007
!BRK026
.continue BRK027 ? _(M|ygruppierungk = "LSRE")
.formula U|xtsys = U|xtsys + " -k18,18 -k8,8  "
.continue ESAC007
!BRK027
.continue BRK028 ? _(M|ygruppierungk = "LSREPOS")
.formula U|xtsys = U|xtsys + " +7 -8  "
.continue ESAC007
!BRK028
.continue BRK029 ? _(M|ygruppierungk = "LSREGEW")
.formula U|xtsys = U|xtsys + " +7 -8 +15 -16 +6 -7  "
.continue ESAC007
!BRK029
.formula U|xtsys = U|xtsys + " -k1,1 "
!ESAC007: =====   ENDCASE   =====
.continue BRK030 ? _(M|ygruppierung2k = "VKART")
.formula U|xtsys = U|xtsys + " -k15,15 -k1,1"
.continue ESAC008
!BRK030
.continue BRK031 ? _(M|ygruppierung2k = "GEW")
.formula U|xtsys = U|xtsys + " -k16,16 -k7,7"
.continue ESAC008
!BRK031
.continue BRK032 ? _(M|ygruppierung2k = "PT")
.formula U|xtsys = U|xtsys + " +14 -15 +1 -2  "
.continue ESAC008
!BRK032
.continue BRK033 ? _(M|ygruppierung2k = "AP")
.formula U|xtsys = U|xtsys + " +16 -17 +8 -9 "
.continue ESAC008
!BRK033
.continue BRK034 ? _(M|ygruppierung2k = "LSRE")
.formula U|xtsys = U|xtsys + " -k18,18 -k8,8  "
.continue ESAC008
!BRK034
.continue BRK035 ? _(M|ygruppierung2k = "LSREPOS")
.formula U|xtsys = U|xtsys + " +7 -8  "
.continue ESAC008
!BRK035
.continue BRK036 ? _(M|ygruppierung2k = "LSREGEW")
.formula U|xtsys = U|xtsys + " +7 -8 +15 -16 +6 -7  "
.continue ESAC008
!BRK036
!ESAC008: =====   ENDCASE   =====
.formula U|xtsys = U|xtsys + " -k15,15 -k1,1"           ? M|ybsortvkartikel
.formula U|xtsys = U|xtsys + " -k12,12 -k3,3"           ? M|ybsummenblatt ; M|ybsortpersonal
.formula U|xtsys = U|xtsys + " -k4,4 -k15,15 -k1,1"     ? M|ybsummenblatt
.formula U|xtsys = U|xtsys + " -k13,13 "
.formula U|xtsys = U|xtsys + " -o " + U|xtperfrepdat + " " + U|xtperfrepdat
.system 'U|xtsys' background
.type bool xblastsum xbgruppenausgabe
.formula U|xbgruppenausgabe = false
.formula U|xblastsum = false
.type int xidescr01
.file -TEST -OPEN U|xidescr01 'U|xtperfrepdat'
.continue EL012 ? _(G|mehr)
.formula  U|xianzsummen = 0
.file -READ U|xidescr01 xtytvkartikel # xtytprjvorgang # xtytbearbeiter # xtytpreis # xtytmge # xtytwert # xtytgewerk # xtytlsposid # xtytarbpaket # xtytlnid # xtread1 # xtread2 # xtread3 # xtmmmzkenn # xtread4 # xtread5 # xtread6 # xtytlsnum #
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.assign U|xrytmge  = 'U|xtytmge'
.continue EL013 ? _(((_(U|xtmmmzkenn = "MZ")) ; ((U|xtmmmzkenn = "MZ") & (M|ybmaschinenstunde))) & ((_(U|xtmmmzkenn = "MM")) ; ((U|xtmmmzkenn = "MM") & ((M|ybmaterial) ; ((M|ybsummenblatt) & (M|ybmaterial))))) & ((M|ynullstunden) ; ((_(M|ynullstunden)) & (U|xrytmge <> 0))))
.formula U|xrytwert     = 'U|xtytwert'
.formula U|xrgeskosten  = U|xrgeskosten  + U|xrytwert
.formula U|xrgesstunden = U|xrgesstunden + U|xrytmge    ? F|empty(U|xtmmmzkenn)
.formula U|xrbearbeiterstunden = U|xrbearbeiterstunden + U|xrytmge
.formula U|xrbearbeiterkosten = U|xrbearbeiterkosten + U|xrytwert
.formula U|xrsumkosten  = U|xrsumkosten  + U|xrytwert
.formula U|xrsumstunden = U|xrsumstunden + U|xrytmge
.continue EL014 ? _((F|empty(U|xthilf1)) & (F|empty(U|xthilf2)) & (F|empty(U|xthilf3)) & (F|empty(U|xthilf4)) & (F|empty(U|xthilf5)) & (F|empty(U|xthilf6)) & (F|empty(U|xthilf7)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
!EL014
.continue EL015 ? _(_(((_(U|xtmmmzkenn = "MM")) ; ((M|ybmaterial) ; ((M|ybmaterial) ; ((M|ybsummenblatt) & (M|ybmaterial))))) & ((_(U|xtmmmzkenn = "MZ")) ; ((U|xtmmmzkenn = "MZ") & (M|ybmaschinenstunde))) & (_(F|empty(U|xtmmmzkenn)))))
.continue BRK037 ? _(M|ygruppierungk = "VKART")
.continue EL016 ? _((_(U|xthilf1 = U|xtytvkartikel)) & (_(F|empty(U|xthilf1))))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC003
!RET005
.formula xprocsp = xprocsp - 1
.continue FI016
!EL016
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
!FI016
.formula U|xthilf1 = U|xtytvkartikel
.continue ESAC009
!BRK037
.continue BRK038 ? _(M|ygruppierungk = "GEW")
.continue EL017 ? _((_(U|xthilf1 = U|xtytgewerk)) & (_(F|empty(U|xthilf1))))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC003
!RET007
.formula xprocsp = xprocsp - 1
.continue FI017
!EL017
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC002
!RET008
.formula xprocsp = xprocsp - 1
!FI017
.formula U|xthilf1 = U|xtytgewerk
.continue ESAC009
!BRK038
.continue BRK039 ? _(M|ygruppierungk = "PT")
.continue EL018 ? _((_(U|xthilf1 = U|xtytprjvorgang)) & (_(F|empty(U|xthilf1))))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
