.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Schutz -----
.protection yteigstdkorr      'M|aktzeile'
.protection yteigwertkorr     'M|aktzeile'
.protection ytfremdkorr       'M|aktzeile'
.protection ytsonstkorr       'M|aktzeile'
.protection ytwipgeskorr      'M|aktzeile'
.protection ytaufwertman      'M|aktzeile'
.protection ytaufwertkorr     'M|aktzeile'
.protection ytwipgesfestg     'M|aktzeile'
.protection ytgessonstbewkorr 'M|aktzeile'
.protection ytbudgetkorr      'M|aktzeile'
.protection ytbem             'M|aktzeile'  ? M|ytbabgeschlossen ; F|empty(M|ytwipstatistik)
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe -----
.colour -BACKGROUND 'U|xtfarbe1'  ytprojekt       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytname          'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytprojname      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytverantwkst    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytabrechtyp     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytwipeigstdrechn  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' yteigstdkorr      'M|aktzeile'    ?  F|protected(M|yteigstdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee2' yteigstdkorr      'M|aktzeile'    ? _F|protected(M|yteigstdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbee1' ytwipeigstdtats   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee1' ytwipeigwerttats  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef1' ytwipfremdrechn    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef1' ytfremdkorr        'M|aktzeile'   ?  F|protected(M|ytfremdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbef2' ytfremdkorr        'M|aktzeile'   ? _F|protected(M|ytfremdkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbef1' ytwipfremdtats     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes1' ytwipsonstrechn    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes1' ytsonstkorr        'M|aktzeile'   ?  F|protected(M|ytsonstkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbes2' ytsonstkorr        'M|aktzeile'   ? _F|protected(M|ytsonstkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbes1' ytwipsonsttats     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes1' ytwipgeskorr       'M|aktzeile'   ?  F|protected(M|ytwipgeskorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbes2' ytwipgeskorr       'M|aktzeile'   ? _F|protected(M|ytwipgeskorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgestats       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytaufwerterreicht  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytaufwertman       'M|aktzeile'   ?  F|protected(M|ytaufwertman, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytaufwertman       'M|aktzeile'   ? _F|protected(M|ytaufwertman, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytaufwertkorr      'M|aktzeile'   ?  F|protected(M|ytaufwertkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytaufwertkorr      'M|aktzeile'   ? _F|protected(M|ytaufwertkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgesverlfr     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytgessonstbewkorr  'M|aktzeile'   ?  F|protected(M|ytgessonstbewkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb2' ytgessonstbewkorr  'M|aktzeile'   ? _F|protected(M|ytgessonstbewkorr, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbeb1' ytwipgesfestg      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytwipvormon        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbeb1' ytbv               'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe1'  ytbem             'M|aktzeile'  ?  F|protected(M|ytbem, M|aktzeile)
.colour -BACKGROUND 'U|xtfarbe2'  ytbem             'M|aktzeile'  ? _F|protected(M|ytbem, M|aktzeile)
.continue EL001 ? _(_(F|empty(M|ytprojekt)))
.formula M|ytbuabschluss = "icon:cube_green"   ? _M|ytbabgeschlossen
.formula M|ytbuabschluss = "icon:package"      ?  M|ytbabgeschlossen &  F|empty(M|ytwipstatistik^ytransaktion)
.formula M|ytbuabschluss = "icon:ok"           ?  M|ytbabgeschlossen & _F|empty(M|ytwipstatistik^ytransaktion)
!EL001
.continue 'xprocst.xprocsp'
!PROC003: ----- Schreibschutz_und_Farbe_Zeilen -----
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL002 ? _(M|aktzeile > 1)
.copy    M|ytbabgeschlossen = M|ytwipstatistik^ybabgeschlossen
.formula M|ytwipabldat      = M|ytwipstatistik^ywipabldat
.formula M|ytwipablbearb     = M|ytwipstatistik^ywipablbearb
.continue EL003 ? _((M|ytbabgeschlossen) ; ((F|empty(M|ytabrechtypk)) & (F|empty(M|ytauposid))))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI003
!EL003
.protection -RESET yteigstdkorr      'M|aktzeile'
.protection -RESET yteigwertkorr     'M|aktzeile'
.protection -RESET ytfremdkorr       'M|aktzeile'
.protection -RESET ytsonstkorr       'M|aktzeile'
.protection -RESET ytwipgeskorr      'M|aktzeile'
.protection -RESET ytaufwertman      'M|aktzeile'
.protection -RESET ytaufwertkorr     'M|aktzeile'
.protection -RESET ytwipgesfestg     'M|aktzeile'
.protection -RESET ytgessonstbewkorr 'M|aktzeile'
.protection -RESET ytbudgetkorr      'M|aktzeile'
!FI003
.protection -RESET ytbem 'M|aktzeile'   ? _M|ytbabgeschlossen & _F|empty(M|ytwipstatistik)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
!EL002
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC004: ----- WiP_Datensatz_laden -----
.continue EL004 ? _(F|empty(0|ystatusk))
.assign U|xbok = G|TRUE       ? H|ystatusk = "AKT"
.assign U|xbok = G|TRUE       ? H|ystatusk = "INA"
.assign U|xbok = G|TRUE       ? H|ystatusk = "GSP"
.assign U|xbok = G|TRUE       ? H|ystatusk = "FTAB"
.assign U|xbok = G|TRUE       ? H|ystatusk = "ABS" & H|yabldat > M|yvorwipstichdatum
.assign U|xbok = G|TRUE       ? H|ystatusk = "08"  & H|yabldat > M|yvorwipstichdatum
.continue FI004
!EL004
.assign U|xbok = G|TRUE       ? 0|ystatusk = "AKT"
.assign U|xbok = G|TRUE       ? 0|ystatusk = "INA"
.assign U|xbok = G|TRUE       ? 0|ystatusk = "GSP"
.assign U|xbok = G|TRUE       ? 0|ystatusk = "FTAB"
.assign U|xbok = G|TRUE       ? 0|ystatusk = "ABS" & 0|yabldat > M|yvorwipstichdatum
.assign U|xbok = G|TRUE       ? 0|ystatusk = "08"  & 0|yabldat > M|yvorwipstichdatum
!FI004
.continue EL005 ? _(U|xbok)
.make screen line +O
.assign  M|ytwipstatistik   = 0|id
.assign  M|ytbabgeschlossen = 0|ybabgeschlossen ?  G|evtvar <> "ytbaumaufzu"
.formula M|ytwipabldat      = 0|ywipabldat
.formula M|ytwipablbearb    = 0|ywipablbearb
.assign  M|ytbabgeschlossen = U|xbabschluss     ?  G|evtvar =  "ytbaumaufzu"
.formula M|ytprojekt    = H|id                  ?  F|empty(0|yabrechtypk) &  F|empty(0|yauposid)
.formula M|ytprojname   = H|namebspr            ?  F|empty(0|yabrechtypk) &  F|empty(0|yauposid)
.copy    M|ytverantwkst = H|yverantwkst         ?  F|empty(0|yabrechtypk) &  F|empty(0|yauposid)
.formula M|ytbaumaufzu = "icon:folder_closed"   ?  F|empty(0|yabrechtypk) &  F|empty(0|yauposid)
.formula M|tbaumstufe  = 0                      ?  F|empty(0|yabrechtypk) &  F|empty(0|yauposid)
.formula M|tbaumstufe  = 1                      ? _F|empty(0|yabrechtypk) ; _F|empty(0|yauposid)
.formula M|tbaumstat   = "+"                    ?  F|empty(0|yabrechtypk) &  F|empty(0|yauposid)
.formula M|tbaumstat   = "-"                    ? _F|empty(0|yabrechtypk) ; _F|empty(0|yauposid)
.assign  M|ytstatusk   = H|ystatusk
.formula M|ytabldat    = H|yabldat
.formula M|ytftabdatum = H|yftabdatum
.formula M|ytname            = 0|namebspr
.formula M|ytprojname        = M|ytprojekt^namebspr
.formula M|ytauposid         = 0|yauposid
.assign  M|ytaupos           = 0|yauposid       ? _F|empty(0|yauposid)
.formula M|yttpposid         = 0|ytpposid
.assign  M|yttppos           = 0|ytpposid       ? _F|empty(0|ytpposid)
.assign  M|ytabrechtypk      = 0|yabrechtypk
.assign  M|ytstichtag        = 0|ystichtag
.assign  M|ytwipdarstk       = 0|ywipdarstk
.formula M|ytbem             = 0|ybemerkung
.continue EL006 ? _(_(F|empty(M|ytaupos)))
.add M|ytaupos
.formula M|ytprojname = D|kopf^nummer + " - " + D|pnum + " - " + D|ptext
!EL006
.continue EL007 ? _(_(F|empty(M|yttppos)))
.add M|yttppos
.formula M|ytprojname = D|nummer + " - " + D|ypnum + " - " + D|yptext
!EL007
.formula M|ytermabgerstd     = 0|yermabgerstd
