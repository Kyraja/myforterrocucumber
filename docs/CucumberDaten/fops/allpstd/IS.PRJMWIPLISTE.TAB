.formula M|ytwipgesrechn     = 0|ywipgesrechn
.formula M|ytwipgestats      = 0|ywipgestats
.formula M|ytfertstellgrad   = 0|yfertstellgrad
.formula M|ytaufwerterreicht = 0|yaufwerterreicht
.formula M|ytgkfremdsatzwert = 0|ygkfremdsatzwert
.formula M|ytfremdzuschlwert = 0|yfremdzuschlwert
.formula M|ytwipsonsttats    = 0|ywipsonsttats
.formula M|ytwipferttats     = 0|ywipferttats
.formula M|ytsonstzuschlwert = 0|ysonstzuschlwert
.formula M|ytfertvkwertabger = 0|yfertvkwertabger
.formula M|ytgksatzfremdwert = 0|ygksatzfremdwert
.formula M|ytfertzuschlwert  = 0|yfertzuschlwert
.formula M|yteigzuschlwert   = 0|yeigzuschlwert
.formula M|yteigaufwert      = 0|yeigaufwert
.formula M|ytfremdaufwert    = 0|yfremdaufwert
