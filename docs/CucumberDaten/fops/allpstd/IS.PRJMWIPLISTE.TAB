.formula M|ytwipgesverlfr    = 0|ywipgesverlfr
.formula M|ytgessonstbewkorr = 0|ygessonstbewkorr
.formula M|ytwipgesfestg     = 0|ywipgesfestg
.formula M|ytwipeigwertverlf = 0|ywipeigwertverlfr
.formula M|ytwipeigwertfestg = 0|ywipeigwertfestg
.formula M|ytwipfremdverlfr  = 0|ywipfremdverlfr
.formula M|ytwipfremdfestg   = 0|ywipfremdfestg
.formula M|ytwipsonstverlfr  = 0|ywipsonstverlfr
.formula M|ytwipsonstfestg   = 0|ywipsonstfestg
.formula M|ytwipfertverlfr   = 0|ywipfertverlfr
.formula M|ytwipfertfestg    = 0|ywipfertfestg
.formula M|ytwipstdobudget   = 0|ywipstdobudget
.formula M|ytwipwertobudget  = 0|ywipwertobudget
.formula M|ytbudgetkorr      = 0|ybudgetkorr
.formula M|ytrestbudgetwert  = 0|yrestbudgetwert
.formula M|ytrestbudgetstd   = 0|yrestbudgetstd
.formula M|ytwipvormon       = 0|ywipvormon
.formula M|ytbv              = 0|ywipgesfestg - 0|ywipvormon
.protection ytbudgetkorr  'M|aktzeile'  ? 0|yermabgerstdk <> "D" ; _M|ywipkonfighist^ywipbudget ; F|empty(M|ytaupos)
.continue EL008 ? _((M|ytbabgeschlossen) ; ((F|empty(0|yabrechtypk)) & (F|empty(0|yauposid))) ; (((M|ytstatusk = "FTAB") ; (M|ytstatusk = "ABS") ; (M|ytstatusk = "08")) & (((F|month(M|ytftabdatum) <= F|month(M|ystichdatum)) & (F|year(M|ytftabdatum)   = F|year(M|ystichdatum))) ; (F|year(M|ytftabdatum)  <  F|year(M|ystichdatum))) & (F|rec(U|xystclosingvars, ypmtabwipnull))) ; (((M|ytstatusk = "¶BS") ; (M|ytstatusk = "08")) & (((F|month(M|ytabldat) <= F|month(M|ystichdatum)) & (F|year(M|ytabldat)   = F|year(M|ystichdatum))) ; (F|year(M|ytabldat)  <  F|year(M|ystichdatum)))))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
!EL008
!EL005
.continue 'xprocst.xprocsp'
!PROC005: ----- Auf_Zu_klappen -----
.continue BRK001 ? _(M|tbaumstat = "+")
.continue EL009 ? _((M|tbaumstufe = 0) & (M|ytbaumaufzu <> "icon:folder_opened_disabled"))
.formula M|ytbaumaufzu = "icon:folder_opened"
.formula M|tbaumstat   = "-"
.select add M|ytprojekt
.copy U|xbok        = G|FALSE
.copy U|xbabschluss = M|ytwipstatistik^ybabgeschlossen
.formula U|xtsel = "$,,yprojekt==" + H|id + ";ystichtag==" + M|ystichdatum:8
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@order=nummer"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL010 ? _((_(F|empty(0|yabrechtypk))) ; (_(F|empty(0|yauposid))))
.copy U|xpproject = 0|yprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC004
!RET004
.formula xprocsp = xprocsp - 1
!EL010
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
!EL009
.continue ESAC001
!BRK001
.continue BRK002 ? _(M|tbaumstat = "-")
.continue EL011 ? _(M|tbaumstufe = 0)
.formula M|ytbaumaufzu = "icon:folder_closed"
.formula M|tbaumstat   = "+"
.select screen line
.assign U|xbmehr = G|mehr
!LOOP003: ==============================
.continue ELOP003 ? _(U|xbmehr)
.continue EL012 ? _(M|tbaumstufe = 1)
.assign U|xbmehr = G|FALSE      ? M|aktzeile = M|tzeilen
.make screen line -O
.continue FI012
!EL012
.assign U|xbmehr = G|FALSE
!FI012
.continue LOOP003
!ELOP003: ==============================
!EL011
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.load 5 add F|sysinfo(10)^ykonfigprjm
.continue BRK003 ? _(G|evtvar = "ybualleauf")
