.formula M|ytfremdabger      = 0|yfremdabger
.formula M|ytwipfremdrechn   = 0|ywipfremdrechn
.formula M|ytfremdkorr       = 0|yfremdkorr
.formula M|ytwipfremdtats    = 0|ywipfremdtats
.formula M|ytsonstverbr      = 0|ysonstverbr
.formula M|ytsonstvkwertabge = 0|ysonstvkwertabger
.formula M|ytsonstabger      = 0|ysonstabger
.formula M|ytwipsonstrechn   = 0|ywipsonstrechn
.formula M|ytsonstkorr       = 0|ysonstkorr
.formula M|ytfertflbestand   = 0|yfertflbestand
.formula M|ytfertwubestand   = 0|yfertwubestand
.formula M|ytfertvkwertwu    = 0|yfertvkwertwu
