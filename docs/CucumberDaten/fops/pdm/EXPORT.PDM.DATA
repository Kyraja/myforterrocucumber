..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EXPORT.PDM.DATA
.. Autor          : dsch
.. Verantwortlich : dsch
.. Kontrolle      : cl
.. Funktion       : Exportiert den gerade geÑnderten oder neu angelegten Stamm-
..                  datensatz fÅr PDM
.. Functionality  : Exports just the just modified or created Master File
..                  Record for PDM
..include pdm/PDMCENTER.INIT
..*****************************************************************************
.set trans -
.type bool xbcalledi2 ? _F|defined(U|xbcalledi2)
.type text xtcalljedi ? _F|defined(U|xtcalljedi)
..
.input "PDMCENTER.INIT"
..
.select object 'M|id'
.continue ENDPDM ? _G|mehr
..
.continue ENDPDM ? _(H|dnr = 2 & H|gruppe = 1)
.continue ENDPDM ? _F|sysinfo(18)^pdm
.continue ENDPDM ?  H|pdm
.continue ENDPDM ?  F|empty(H|pdmstatus)
..
.formula U|xtcalljedi = F|formatstr("input de.abas.edi.JEdi.java -id {1} -exportid {2} -hideProgress", U|xmodelresp, H|nummer) ? _U|xbcalledi2
.formula U|xtcalljedi = F|formatstr("input de.abas.edi2.JEdi.java -id {1} -exportid {2}", U|xmodelresp, H|nummer)              ?  U|xbcalledi2
..
.'U|xtcalljedi'
!ENDPDM
.continue
