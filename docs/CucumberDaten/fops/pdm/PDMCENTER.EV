..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PDMCENTER.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh        
.. Functionality  :
..*****************************************************************************
.set trans -
..
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "import" 
.continue RADIOBU ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "export"
.continue END
..
!RADIOBU
.input "is/TABLEEREN"
.copy M|import = G|FALSE   ? M|import & G|evtvar = "export"
.copy M|export = G|FALSE   ? M|export & G|evtvar = "import"
.copy M|import = G|TRUE    ? _M|export & _M|import
.set trans +
.formula M|status = "Warten auf Antwort"      ? M|export
.formula M|status = "Bereit zur Verarbeitung" ? M|import
.set trans -

.assign P|maskkontextfop = ""       ? M|export
.assign P|maskkontextfop = "Import" ? M|import
..
..*****************************************************************************
!END
.continue
