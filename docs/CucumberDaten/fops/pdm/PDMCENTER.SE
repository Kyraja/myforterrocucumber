..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PDMCENTER.SE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..
..include pdm/PDMCENTER.INIT
..*****************************************************************************
..
.set trans -
.continue ERROR ? _F|sysinfo(18)^pdm
..
.. I-FOP
.input "PDMCENTER.INIT"
..
.formula M|astatus  = U|xtastatus 
.formula M|status   = U|xtstatus
..
.. Automatically open the Part Screen
.copy M|partopen = U|xbpartopen
..
.. Automatically open the infosystem PDMBOMDIFF
.copy M|isopen   = U|xbisopen
..
.formula M|erfassvon = U|xderfassvon
.formula M|erfassbis = U|xderfassbis
..
.. Selection default View
.copy M|import   = U|xbimport
.copy M|export   = U|xbexport
..
.assign P|maskkontextfop = ""       ? M|export
.assign P|maskkontextfop = "Import" ? M|import
..
.continue END
..
!ERROR
.error Infosystem nicht ausfÅhrbar! PDM/PLM muss konfiguriert sein!
.end 1
..
..*****************************************************************************
!END
.continue
