..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PDMBOMDIFF.BA
.. Author         : cl
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : Creates a new productions list.
..*****************************************************************************
.set trans -
.type text  xpdmzid     ? _F|defined(U|xpdmzid)
.type text  xpdmzidstd  ? _F|defined(U|xpdmzidstd)
.type text  xanzahl     ? _F|defined(U|xanzahl)
.type text  xlge        ? _F|defined(U|xlge)
.type text  xbreite     ? _F|defined(U|xbreite)
.type text  xanzahlstd  ? _F|defined(U|xanzahlstd)
.type text  xlgestd     ? _F|defined(U|xlgestd)
.type text  xbreitestd  ? _F|defined(U|xbreitestd)
.type text  xdontchange ? _F|defined(U|xdontchange)
.type DVM2  xtmpfile    ? _F|defined(U|xtmpfile)
.type text  xtout       ? _F|defined(U|xtout)
.type text  xterr       ? _F|defined(U|xterr)
.type text  xnutzen     ? _F|defined(U|xnutzen)
.type text  xpverlust   ? _F|defined(U|xpverlust)
.type text  xvkpverlust ? _F|defined(U|xvkpverlust)
.type text  xamge       ? _F|defined(U|xamge)
.type text  xkompeig    ? _F|defined(U|xkompeig)
.type text  xlfbeist    ? _F|defined(U|xlfbeist)
.type text  xmgr        ? _F|defined(U|xmgr)
.type text  xmgrstd     ? _F|defined(U|xmgrstd)
.type text  xellme      ? _F|defined(U|xellme)
.type text  xelbme      ? _F|defined(U|xelbme)
.type bool  xbelexleer  ? _F|defined(U|xbelexleer)
.type text  xtsel       ? _F|defined(U|xtsel)
.type text  xelex       ? _F|defined(U|xelex)
.type text  xbasisart   ? _F|defined(U|xbasisart)
..
.. Initialize
.file -tempname U|xtmpfile
.file -tempname U|xtout
.file -tempname U|xterr
..
.continue ARTIKEL ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bneuestdfl"
.continue DECLARE ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bneuefl"
.continue END
..
!ARTIKEL
.continue DECLARE ?  M|noloesch
.. Artikel Ñndern, Standardfertigungsliste lîschen
.output new 'U|xtmpfile'
.input "DATEI.F"
#!database=2:1
#!action=update
#!CHARSET=EKS
id;flistestd
'M|artikel^id';;
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR02 ? _G|mehr
.continue PARTSUCCESS
..
!DECLARE: Declarations
.formula U|xdontchange = "~~~~~~~~~~"
.formula M|suchneu = M|flistestd^such ? F|empty(M|suchneu)
..
.select screen header
..
.. EDP header
.output new 'U|xtmpfile'
.input "DATEI.F"
# Fertigungsliste neu
#!database=128
#!group=1
#!action=new
#!CHARSET=EKS
#!DONTCHANGE='U|xdontchange'
#!EDP_FOPMODE=0
#!EDP_UPDATEMODE=ERRABORT
..
?artikel;such;flistestd;lgruppe\   ? _F|empty(M|suchneu) & G|evtvar = "bneuestdfl"
?artikel;such;lgruppe\             ? _F|empty(M|suchneu) & G|evtvar = "bneuefl"
..
elex;tbasisartikel;pdmposnr;pdmzid;vpos;lge;breite;ellme;elbme;anzahl;mgr;nutzen;bu;filter;ptext;pverlust;vkpverlust;amge;var;pzeit;tlzeit;tersatzt;tverschlt;tnwpflicht;tserarchiv;kompeig;lfbeist;
..
?'M|artikel^id';'M|suchneu';true;'M|lgruppe^id'\      ? G|evtvar = "bneuestdfl" &  F|empty(M|basisartikel)
?'M|artikelvergl^id';'M|suchneu';true;'M|lgruppe^id'\ ? G|evtvar = "bneuestdfl" & _F|empty(M|basisartikel)
?'M|artikel^id';'M|suchneu';'M|lgruppe^id'\           ? G|evtvar = "bneuefl"    &  F|empty(M|basisartikel)
?'M|artikelvergl^id';'M|suchneu';'M|lgruppe^id'\      ? G|evtvar = "bneuefl"    & _F|empty(M|basisartikel)
.output
..
!LINE
.formula U|xlge       = U|xdontchange
.formula U|xbreite    = U|xdontchange
.formula U|xanzahl    = U|xdontchange
.formula U|xlgestd    = U|xdontchange
.formula U|xbreitestd = U|xdontchange
.formula U|xanzahlstd = U|xdontchange
.assign U|xmgr        = U|xdontchange
.assign U|xmgrstd     = U|xdontchange
..
.select screen line
.continue EXECUTE ? _G|mehr
.continue LINE    ? M|loesch
.assign U|xpdmzid     = M|pdmzid
.formula U|xlge       = M|lge        ? _F|empty(M|lge)
.formula U|xbreite    = M|breite     ? _F|empty(M|breite)
.formula U|xanzahl    = M|anzahl     ? _F|empty(M|anzahl)
.assign U|xpdmzidstd  = M|stdpdmzid
.formula U|xlgestd    = M|lgestd     ? _F|empty(M|lgestd)
.formula U|xbreitestd = M|breitestd  ? _F|empty(M|breitestd)
.formula U|xanzahlstd = M|anzahlstd  ? _F|empty(M|anzahlstd)
.assign U|xmgr        = M|mgr        ? _F|empty(M|mgr)
.assign U|xmgrstd     = M|mgrstd     ? _F|empty(M|mgrstd)
..
.continue DOSEL1 ? M|sel1
.continue DOSEL2 ? M|sel2
..
.continue LINE
..
!DOSEL1
.formula U|xnutzen     = M|nutzenstd
.formula U|xnutzen     = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe = 2
.formula U|xpverlust   = M|pverluststd
.formula U|xpverlust   = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe = 2
.formula U|xvkpverlust = M|vkpverluststd
.formula U|xvkpverlust = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe = 2
.formula U|xamge       = M|amgestd
.formula U|xamge       = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe = 2
.formula U|xkompeig    = M|kompeigstd
.formula U|xkompeig    = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe <> 1
.formula U|xkompeig    = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe = 1 & F|equals(M|elexstd^bsart,"(Subcontracting)")
.formula U|xlfbeist    = M|lfbeiststd
.formula U|xlfbeist    = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe <> 1
.formula U|xlfbeist    = U|xdontchange   ? _F|empty(M|elexstd) & M|elexstd^gruppe = 1 & F|equals(M|elexstd^bsart,"(Subcontracting)")
.. nur bei ArbeitsgÑngen (gruppe = 0) dÅrfen die LÑnge-/Breite-Einheiten gesetzt werden
.. bei Artikeln und Fertigungsmitteln (gruppe <> 0) nicht
.formula U|xellme      = U|xdontchange   ?  F|empty(M|ellmestd)
.formula U|xellme      = U|xdontchange   ?  M|elexstd^gruppe <> 0
.formula U|xellme      = M|ellmestd      ? _F|empty(M|ellmestd) & M|elexstd^gruppe = 0
.formula U|xelbme      = U|xdontchange   ?  F|empty(M|elbmestd) 
.formula U|xelbme      = U|xdontchange   ?  M|elexstd^gruppe <> 0
.formula U|xelbme      = M|elbmestd      ? _F|empty(M|elbmestd) & M|elexstd^gruppe = 0
.. ist in der FL nur der Basisartikel eingetragen und der Artikel ist leer?
.. in diesem Fall soll in der neuen Fertigungsliste auch NUR der Baisartikel stehen, der Artikel bleibt leer
.formula U|xbelexleer = G|false
.continue NOZID1 ? F|empty(M|flzidstd)
.continue NOZID1 ? F|empty(M|nrflistestd) 
.continue NOZID1 ? F|empty(M|basisartikelstd)   
.formula U|xtsel = "$,,nummer="+'M|nrflistestd'+";such=;zid="+'M|flzidstd'+";@zeilen=ja;"
.select productionlist 'U|xtsel'
.continue NOZID1 ? _G|mehr 
.select line 'H|selzeile'
.continue NOZID1 ? _G|mehr 
.formula U|xbelexleer = G|true ? _F|empty(H|tbasisartikel) & F|empty(H|elex)
!NOZID1
.formula U|xelex       = M|elexstd^id         ? _U|xbelexleer
.formula U|xbasisart   = U|xdontchange        ? _U|xbelexleer 
.formula U|xelex       = U|xdontchange        ?  U|xbelexleer
.formula U|xbasisart   = M|basisartikelstd^id ?  U|xbelexleer  
..
.continue EDPLINE
..
!DOSEL2
.formula U|xnutzen     = M|nutzen
.formula U|xnutzen     = U|xdontchange ? _F|empty(M|elex) & M|elex^gruppe = 2
.formula U|xpverlust   = M|pverlust
.formula U|xpverlust   = U|xdontchange ? _F|empty(M|elex) & M|elex^gruppe = 2
.formula U|xvkpverlust = M|vkpverlust
.formula U|xvkpverlust = U|xdontchange ? _F|empty(M|elex) & M|elex^gruppe = 2
.formula U|xamge       = M|amge
.formula U|xamge       = U|xdontchange ? _F|empty(M|elex) & M|elex^gruppe = 2
.formula U|xkompeig    = M|kompeig
.formula U|xkompeig    = U|xdontchange ? _F|empty(M|elex) & M|elex^gruppe <> 1
.formula U|xkompeig    = U|xdontchange ? _F|empty(M|elex) & M|elex^gruppe = 1 & F|equals(M|elex^bsart,"(Subcontracting)")
.formula U|xlfbeist    = M|lfbeist
.formula U|xlfbeist    = U|xdontchange   ? _F|empty(M|elex) & M|elex^gruppe <> 1
.formula U|xlfbeist    = U|xdontchange   ? _F|empty(M|elex) & M|elex^gruppe = 1 & F|equals(M|elex^bsart,"(Subcontracting)")
.formula U|xellme      = U|xdontchange   ?  F|empty(M|ellme)
.formula U|xellme      = U|xdontchange   ?  M|elex^gruppe <> 0
.formula U|xellme      = M|ellme         ? _F|empty(M|ellme) & M|elex^gruppe = 0
.formula U|xelbme      = U|xdontchange   ?  F|empty(M|elbme)
.formula U|xelbme      = U|xdontchange   ?  M|elex^gruppe <> 0
.formula U|xelbme      = M|elbme         ? _F|empty(M|elbme) & M|elex^gruppe = 0
.. ist in der FL nur der Basisartikel eingetragen und der Artikel ist leer?
.. in diesem Fall soll in der neuen Fertigungsliste auch NUR der Baisartikel stehen, der Artikel bleibt leer
.formula U|xbelexleer = G|false
.continue NOZID2 ? F|empty(M|flzid)
.continue NOZID2 ? F|empty(M|nrfliste) 
.continue NOZID2 ? F|empty(M|basisartikelstl)   
.formula U|xtsel = "$,,nummer="+'M|nrfliste'+";such=;zid="+'M|flzid'+";@zeilen=ja;"
.select productionlist 'U|xtsel'
.continue NOZID2 ? _G|mehr 
.select line 'H|selzeile'
.continue NOZID2 ? _G|mehr 
.formula U|xbelexleer = G|true ? _F|empty(H|tbasisartikel) & F|empty(H|elex)
!NOZID2
.formula U|xelex       = M|elex^id            ? _U|xbelexleer
.formula U|xbasisart   = U|xdontchange        ? _U|xbelexleer 
.formula U|xelex       = U|xdontchange        ?  U|xbelexleer
.formula U|xbasisart   = M|basisartikelstl^id ?  U|xbelexleer  
..
!EDPLINE
..
.output addedto 'U|xtmpfile'
..
?'U|xelex';'U|xbasisart';'M|pdmpos';'U|xpdmzid';'M|vpos';'U|xlge';'U|xbreite';'U|xellme';'U|xelbme';'M|anzahl';'U|xmgr';'U|xnutzen';'M|bu';'M|filter';'M|ptext';'U|xpverlust';'U|xvkpverlust';'U|xamge';'M|var';'M|pzeit';'M|tlzeit';'M|tersatz';'M|tverschlt';'M|tnwpflicht';'M|tserarchiv';'U|xkompeig';'U|xlfbeist';\ ? M|sel2
?'U|xelex';'U|xbasisart';'M|stdpdmpos';'U|xpdmzidstd';'M|vposstd';'U|xlgestd';'U|xbreitestd';'U|xellme';'U|xelbme';'U|xanzahlstd';'U|xmgrstd';'U|xnutzen';'M|bustd';'M|filterstd';'M|ptextstd';'U|xpverlust';'U|xvkpverlust';'U|xamge';'M|varstd';'M|pzeitstd';'M|tlzeitstd';'M|tersatzstd';'M|tverschltstd';'M|tnwpflichtstd';'M|tserarchivstd';'U|xkompeig';'U|xlfbeist';\ ? M|sel1
..
.continue LINE
..
!EXECUTE: Execute import
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR01 ? _G|mehr
.continue SUCCESS
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!SUCCESS: Fertigungsliste erfolgreich erstellt
.input "is/TABLEEREN"
.continue STDSUCCESS ? G|evtvar = "bneuestdfl"
.note Die neue Fertigungsliste wurde angelegt.
.continue CLRNOSTD
..
!STDSUCCESS: Standardfertigungsliste erfolgreich erstellt
.note Die neue Standardfertigungsliste wurde angelegt.
.continue CLRSTD
..
!PARTSUCCESS
.note Standardfertigungsliste 'M|flistestd^nummer' aus Artikel erfolgreich entfernt!
.input "is/TABLEEREN"
..
!CLRSTD
.formula M|flistestd = ""     ?  F|empty(M|basisartikel)
.formula M|nrflistestd = ""   ?  F|empty(M|basisartikel)
.formula M|flbasisstd = 0     ?  F|empty(M|basisartikel)
.formula M|fliste = ""        ? _F|empty(M|basisartikel)
.formula M|nrfliste = ""      ? _F|empty(M|basisartikel)
.formula M|flbasis = 0        ? _F|empty(M|basisartikel)
.continue STDBAS  ? M|stdversbasis
.continue END ? G|evtvar = "bneuestdfl"
!STDBAS: im Basisartikel eine neue Standard-Version setzen
.output new 'U|xtmpfile'
.input "DATEI.F"
# Update auf Basiartikel neue Standard-Version
#!database=2
#!group=9
#!action=update
#!CHARSET=EKS
#!EDP_FOPMODE=0
#!EDP_UPDATEMODE=ERRABORT
id\
tversion;tstdvers;
'M|basisartikel^id'\
$,tversion=='M|artikelvergl^id';true;
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR03 ? _G|mehr
.continue END
!CLRNOSTD
.formula M|fliste = ""
.formula M|nrfliste = ""
.formula M|flbasis = 0
.continue END
..
!ERROR01: Import failed!
.error -line 0 -field M|bneuefl -message Das Erstellen der Fertigungsliste ist gescheitert! ? G|evtvar = "bneuefl"
.error -line 0 -field M|bneuestdfl -message Das Erstellen der Standardfertigungsliste ist gescheitert! ? G|evtvar = "bneuestdfl"
.output terminal
.set trans +
Fehlerdatei:
.set trans -
.input 'U|xtout'
.input 'U|xterr'
.end 1
..
!ERROR02: Import failed!
.error -message Das Lîschen der Standardfertigungsliste im Artikel 'M|artikel' ist gescheitert!
.output terminal
..
!ERROR
.set trans +
Fehlerdatei:
.set trans -
.input 'U|xtout'
.input 'U|xterr'
.end 1
!ERROR03: Setzen der Standardversion im Basisartikel
.error -message Setzen der Standardversion im Basisartikel gescheitert!
.end 1
