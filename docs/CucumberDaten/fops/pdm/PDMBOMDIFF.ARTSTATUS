..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PDMBOMDIFF.ARTSTATUS
.. Author         : tiwe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : setzt das Feld artstatusvergl und
..                  setzt den Schreibschutz fÅr stdversbasis
..*****************************************************************************
.set trans -
..
.formula M|artstatusvergl = M|artikelvergl^artstatus
.continue STDSCHU ? F|equals(M|artstatusvergl,"(ProductCreation)") 
.continue STDSCHU ? F|equals(M|artstatusvergl,"(Prototype)")
.continue STDSCHU ? F|equals(M|artstatusvergl,"(PlannedProduct)")
.continue STDSCHU ? F|equals(M|artstatusvergl,"(InDevelopment)")
.continue NOSTD
!STDSCHU: Feld stdversbasis schÅtzen, es kann nicht im Basisartikel gesetzt werden
.protection stdversbasis
.copy M|stdversbasis = G|false
.continue
!NOSTD: Hier kann der Artikel die Standardversion im Basisartikel werden
.protection -reset stdversbasis ? _F|empty(M|basisartikel)
.protection stdversbasis        ?  F|empty(M|basisartikel)
.continue
