..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABCANA.CHART.PIE
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Diagramm-Anzeige
..*****************************************************************************
.type text  xttitel    ? _F|defined(U|xttitel)
.type text  xttitel1   ? _F|defined(U|xttitel1)
.type text  xttitel2   ? _F|defined(U|xttitel2)
..
.set trans +
.formula U|xttitel  = F|formatstr("Wert (in {1})", 'G|inland')
.formula U|xttitel1 = "Prozentuale Aufteilung der ABC-Teile"
.formula U|xttitel2 = "A-Teile; B-Teile; C-Teile"
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE PIE
.chart -PARAM -DECIMALSY 2
.chart -PARAM -3D NO
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TITLECHART 'U|xttitel1'
.chart -PARAM -MARKERX 'U|xttitel2'
.chart -STARTVALUES 'U|xttitel'
.chart -VALUE 'M|awert'
.chart -VALUE 'M|bwert'
.chart -VALUE 'M|cwert'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
