!BOSTON: AUSGABE auf STAT.panummer (geholt von sk/ABL.DAT)
?'xtknr'#'xtksu'#'xtdre'#'xtanr'#'xtasu'#'xrmge'#'xrpw'#0.00#0.00#0.00#0.00#'xtms'#'xtle'# ? xtdre >= xtdvon
?'xtknr'#'xtksu'#'xtdre'#'xtanr'#'xtasu'#0.00#0.00#'xrmge'#'xrpw'#0.00#0.00#'xtms'#'xtle'# ? xtdre <= xtdvbis
.continue HA
