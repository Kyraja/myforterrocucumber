..  xtdf -> STAT.panummer, alle Treffer speichern
..  xtdo -> ABL.DAT
.select from
.occupy 'xtdo'
.output new 'xtdf'
..
!HA: von sk/ABL.DAT holen
.select from 'xtdo' xtasa # xtren # xtknr # xtksu # xdate8 # xrpw # xtanr # xtasu # xrmge # xtle # xyw
.continue DRUCK  ? _mehr
.formula xtdre=xdate8
.formula xtdbis = 'xdbis:8'
.formula xtdvvon = 'xdvvon:8'
.formula xtdvbis = 'xdvbis:8'
.formula xtdvon = 'xdvon:8'
.formula xtms="00"
..
..  Datum PrÅfen
.continue HA  ?  xtdre < xtdvvon ; xtdre > xtdbis
.continue HA  ?  xtdre > xtdvbis & xtdre < xtdvon
..
..  Springen  wenn nicht Pkt 1 im HauptmenÅ gewÑhlt wurde
.continue HA1 ? _xtstat/"*/1/*"
