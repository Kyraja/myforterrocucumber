..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : MONBER.EV
.. Autor/Author   : dr/cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Ablauf         : Zentrales EFOP
..
.. Functionality  :
.. Program flow   : Central efop
..*****************************************************************************
.set trans -
..
.type text  xtd1    ? _F|defined(U|xtd1)
.type text  xtd2    ? _F|defined(U|xtd2)
.type text  xtkey   ? _F|defined(U|xtkey)
.type text  xtin    ? _F|defined(U|xtin)
.type text  xteg    ? _F|defined(U|xteg)
..
..---------------------------- Kopfteil/Header:--------------------------------
.continue BSTART      ? G|evtartengl = "BUTTON_BEFORE"  & G|evtvar = "bstart"
.continue AUSLAN      ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "bland"
.continue AUSIEA      ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "biea"
.continue PRUEF       ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
..=============================================================================
.continue END
..
!BSTART
.continue FEHL1 ? F|empty(M|anf) ; F|empty(M|end)
.continue FEHL1 ? M|anf > M|end
.continue FEHL2 ? _M|biea & _M|bland
.input "is/TABLEEREN"
.formula U|xtd1 = "rmtmp/MONBER.D." + G|aufrufernr
.formula U|xtd2 = "rmtmp/MONBER.V." + G|aufrufernr
..
!MONBER
.output new 'U|xtd1'
.input "DATEI.F"
?1##0#  ? M|biea
?2##0#  ? M|biea
?3##0#  ? M|biea
..
.formula U|xteg=","
.formula U|xtin=""
.formula U|xtkey="$,,typ=L;@ordnung=typ,ischl;@ablageart=(Active);@gruppe=1"
.select regions 'U|xtkey'
..
!FIZ
.continue FINDEZE ? _G|mehr
.formula U|xtin = H|kenn                ?  F|equals(H|laart, "(Domestic)")
.formula U|xteg = U|xteg + H|kenn + "," ? _F|equals(H|laart, "(Domestic)")
.select regions
.continue FIZ
..
!FINDEZE
.formula M|select="$,,ktyp="+'G|REKO'+";budat="+'M|anf'+"!"+'M|end'+";@ordnung=ktyp,budat;@ablageart=(Filed);@gruppe=1"
.input "is/HOL.LISTE"
.continue END
..
!PRUEF
.continue END ?  M|biea
.select screen line
.continue FEHL0  ? _G|mehr
.continue CLRTAB ?  M|gesumsatz = 0
.continue END
..
!AUSLAN
.copy M|biea = G|FALSE
.assign P|maskkontextfop = "States"
.continue CLRTAB
..
!AUSIEA
.assign M|gesumsatz = ""
.assign P|maskkontextfop = "TypeOfState"
.copy M|bland = G|FALSE
.continue CLRTAB
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!FEHL0
.error -field M|anf -message Keine UmsÑtze und AuftrÑge im Zeitraum 'M|anf' - 'M|end' vorhanden!
.end 1
..
!FEHL1
.error -field M|anf -message Bitte geben Sie einen gÅltigen Zeitraum ein!
.end 1
..
!FEHL2
.error -field M|biea -message Bitte wÑhlen sie einen Berichtstyp!
.end 1
