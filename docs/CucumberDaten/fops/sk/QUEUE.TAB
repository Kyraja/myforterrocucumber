..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : QUEUE.TAB
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
..
.continue WSTAB ? M|bws
.continue LJTAB ? M|blj
.continue END
..
!WSTAB: nur Zug„nge anzeigen                           
.continue END ? 1|vorgang^buart = 1 & 1|vorgang^mge < 0
.continue END ? 1|vorgang^buart = 2 & 1|vorgang^mge > 0
.continue END ? 1|vorgang^buart = 3 & 1|vorgang^mge < 0
..
.continue MAKESCREEN ? F|empty(M|kursache)
.. Ursache beachten
.continue END ? M|kursache <> 1|vorgang^ursache
..
!MAKESCREEN
.make screen line +O
.copy M|bvorgentfern = G|FALSE
.protection -reset bvorgentfern 'M|aktzeile'
.protection bvorgentfern 'M|aktzeile' ? _M|bwserlaub
.assign M|tvorgang = 1|vorgang
.select add 1|vorgang^id
.assign M|platz       = H|platz
.assign M|budatvom    = H|budat
.assign M|tvorglj     = H|vorgang
.formula M|menge      = H|mge
.assign M|tartikel    = H|art
.formula M|tbeleg     = H|such << -1
.assign M|ursache     = H|ursache
.assign M|bsres       = H|bsres
.formula M|entferndat = H|entferndat
.copy M|nbewentfern   = H|nbewentfern
.continue DEL ? M|abgangzugang & F|empty(M|bsres)
.continue SEL ? F|empty(M|bsres)
..
.select object 'M|bsres^id'
.reserve link
.select link
.continue DEL ? G|bvkenn = "" & M|abgangzugang
.continue SEL ? G|bvkenn = ""
.copy M|babgang = G|TRUE 
..
!SEL
.select -
.copy M|he         = M|tvorglj^he
.copy M|le         = M|tartikel^le
.set trans +
.formula M|buart   = "Zugang"                      ? 1|vorgang^buart = 1
.formula M|buart   = "Abgang mit negativer Menge"  ? 1|vorgang^buart = 2
.formula M|buart   = "Bestandskorrektur"           ? 1|vorgang^buart = 3
.set trans -
.continue END
..
!DEL
.make screen line -O
.continue END
..
!LJTAB: nur Zug„nge anzeigen
.continue END ? 1|buart = 1 & 1|mge < 0
.continue END ? 1|buart = 2 & 1|mge > 0
.continue END ? 1|buart = 3 & 1|mge < 0
.continue END ? _1|nbewentfern & M|bentfernt
..
.make screen line +O
.copy M|bvorguebern = G|FALSE
.protection -reset bvorguebern 'M|aktzeile'
.protection bvorguebern 'M|aktzeile'  ? _M|bwserlaub
.assign M|tvorgang    = 1|id
.assign M|platz       = 1|platz
.assign M|budatvom    = 1|budat
.assign M|tvorglj     = 1|vorgang
.formula M|menge      = 1|mge
.assign M|tartikel    = 1|art
.formula M|tbeleg     = 1|such << -1
.assign M|ursache     = 1|ursache
.assign M|bsres       = 1|bsres
.formula M|entferndat = 1|entferndat
.copy M|nbewentfern   = 1|nbewentfern
.continue DEL   ? M|abgangzugang & F|empty(M|bsres)
.continue LJSEL ? F|empty(M|bsres)
..
.select object 'M|bsres^id'
.reserve link
.select link
.continue DEL   ? G|bvkenn = "" & M|abgangzugang
.continue LJSEL ? G|bvkenn = ""
.copy M|babgang = G|TRUE
..
!LJSEL
.select -
.copy M|he         = M|tvorglj^he
.copy M|le         = M|tartikel^le
.set trans +
.formula M|buart   = "Zugang"                      ? 1|buart = 1
.formula M|buart   = "Abgang mit negativer Menge"  ? 1|buart = 2
.formula M|buart   = "Bestandskorrektur"           ? 1|buart = 3
.set trans -
.continue END
..
..*****************************************************************************
!END
.continue
