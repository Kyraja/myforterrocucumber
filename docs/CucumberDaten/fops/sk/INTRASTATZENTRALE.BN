..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INTRASTATZENTRALE.BN
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..
.. Includes       :
..include sk/INTRASTATZENTRALE.ME
..include sk/INTRASTATZENTRALE.EDI.BN
..include sk/INTRASTATZENTRALE.MELD
..include sk/INTRASTATZENTRALE.LOESCH.BN
..include sk/INTRASTATZENTRALE.BSTART.BV
..*****************************************************************************
.set trans -
.type text xdnt          ? _F|defined(U|xdnt)
.type text xdnst         ? _F|defined(U|xdnst)
.type text xsys          ? _F|defined(U|xsys)
.type bool xpsei         ? _F|defined(U|xspei)
.type text xdr           ? _F|defined(U|xdr)
.type text x1cp          ? _F|defined(U|x1cp)
.type text x2cp          ? _F|defined(U|x2cp)
.type text xmv           ? _F|defined(U|xmv)
.type bool xbmark        ? _F|defined(U|xbmark)
.type text xtdatum       ? _F|defined(U|xtdatum)
.type text xsatznr       ? _F|defined(U|xsatznr)
.type text xdatnr        ? _F|defined(U|xdatnr)
.type GL11 xsteunr       ? _F|defined(U|xsteunr)
.type GL3  xustzus       ? _F|defined(U|xustzus)
.type GL3  xischl        ? _F|defined(U|xischl)
.type text xdntfe        ? _F|defined(U|xdntfe)
.type text xtmpfile      ? _F|defined(U|xtmpfile)
.type text xtout         ? _F|defined(U|xtout)
.type text xterr         ? _F|defined(U|xterr)
.type ID3  xid3          ? _F|defined(U|xid3)
.type ID4  xid4          ? _F|defined(U|xid4)
..
.file -tempname U|xtmpfile
.file -tempname U|xtout
.file -tempname U|xterr
..
.continue URL        ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "url1"      
.continue PARAM      ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bparamaktuell"
.continue RUECK      ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "rueck"
.continue START
..
!RUECK
.output new 'U|xtmpfile'
.input DATEI.F
?#!database=3:24            ? 'M|vorgang^dnr' = "3"
?#!database=4:24            ? 'M|vorgang^dnr' = "4"
#!action=modify
#!charset=eks
id;intra
'M|vorgang^id';'M|tintra'
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue FEHLER4  ? _G|mehr
..
.box
Vorgang abgeschlossen!
.input "sk/INTRASTATZENTRALE.BSTART.BV"
.continue END
..
!START
.type text xtFM0     ? _F|defined(U|xtFM0)
.type text xtFM1     ? _F|defined(U|xtFM1)
.type text xtFM2     ? _F|defined(U|xtFM2)
..
.type text xtMES0    ? _F|defined(U|xtMES0)
.type text xtMES1    ? _F|defined(U|xtMES1)
.type text xtMES2    ? _F|defined(U|xtMES2)
..
.set trans +
.formula U|xtFM0  = "Keine markierten Zeilen mit EDI-Nachrichten gefunden."
.formula U|xtFM1  = "Keine zu bearbeitenden Tabellenzeilen vorhanden."
.formula U|xtFM2  = "Zu markierten VorgÑngen gibt es noch keine EDI-Nachricht."
..
.formula U|xtMES0 = "Erstelle EDI-Nachrichten..."
.formula U|xtMES1 = "Bearbeite Vorgang:"
.formula U|xtMES2 = "Der Export von EDI-Nachrichten ist beendet."
.set trans -
..
.formula U|xdnt = ""
.formula U|xdr  = ""
.formula U|x1cp = ""
.formula U|x2cp = ""
.formula U|xmv  = ""
.assign M|mark = "(EmptyEntry)"
.copy U|xbmark   = G|FALSE
..
.continue MARK        ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "markieren"
.continue DEMARK      ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "demarkieren"
.continue EDIMELD     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "melden"
.continue EXPORTIEREN ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "exportieren"
.continue INTRASTAT   ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bintrastat"
.continue EDILOESCH   ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "ediloesch"
.continue OPEN        ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bopen"
.continue JOURNAL     ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "journal"
.continue END
..
!JOURNAL
.formula M|jdnt = M|arbver + "INTRA.J"
.formula U|xsys = "test -s " + M|jdnt
.system 'U|xsys' background
.continue NICHTS                         ? _G|mehr
.editing -readonly 'M|jdnt'
.continue END
..
!NICHTS
.error Intrastat-Journal ist leer oder nicht vorhanden!
.end 1
..
!OPEN: XML-Meldedatei îffnen
.formula U|xsys = "test -s " + M|dntver
.system 'U|xsys' background
.continue NOMELD                         ? _G|mehr

.editing 'M|dntver'
.continue END
..
!NOMELD
.error Keine XML-Meldedatei 'M|dntver' gefunden
.end 1
..
!PARAM: Parameterdatei einziehen
.input "sk/INTRASTATZENTRALE.ME"
.continue END
..
!MARK
.assign M|mark = "(SelectAll)"
.input "is/TAB.MARK"
.continue END
..
!DEMARK
.assign M|mark = "(DeselectAll)"
.input "is/TAB.MARK"
.continue END
..
!INTRASTAT
.formula M|idnt = G|bsprache+"/"+M|arbver+"INTRASTAT.PAR" ? G|bsprache <> G|isprache
.formula M|idnt = M|arbver+"INTRASTAT.PAR"                ? G|bsprache = G|isprache
.formula U|xsys = "test -s " + M|idnt
.system 'U|xsys' background
.continue KEIN                           ? _G|mehr

.editing 'M|idnt'
.continue
..
!KEIN
.error Keine 'M|idnt' gefunden
.end 1
..
!EXPORTIEREN
.continue TESTMELD ? M|testindikator
.select from 'M|dntrg' U|xsatznr # U|xdatnr^
.continue ZAEHLER ? _G|mehr
.select lock purchasing recordnumber 'U|xsatznr' ? U|xdatnr = "4"
.select lock sales recordnumber 'U|xsatznr' ? U|xdatnr = "3"
.continue FEHLER4 ? _G|mehr
.formula U|xid3 = H|id  ?  U|xdatnr = "3"
.formula U|xid4 = H|id  ?  U|xdatnr = "4"
.select
.output new 'U|xtmpfile'
.input DATEI.F
?#!database=3:24            ? U|xdatnr = "3"
?#!database=4:24            ? U|xdatnr = "4"
#!action=modify
#!charset=eks
id;intra            
?'U|xid3';'M|meldnr'   ? U|xdatnr = "3"
?'U|xid4';'M|meldnr'   ? U|xdatnr = "4"
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue FEHLER4  ? _G|mehr
..
.continue EXPORTIEREN
..
!ZAEHLER: ZÑhler schreiben
.formula M|dnt = M|arbver + "INTRA.N"
.output new 'M|dnt'
.input "DATEI.F"
'M|meldnr'
.output
..
!SCHREIBEJ: Journal schreiben
.formula M|jdnt = M|arbver + "INTRA.J"
.output addedto 'M|jdnt'
.set trans +
INTRA: ' M|meldnr' Zeitraum: 'M|datumvon' - 'M|datumbis'   erstellt am:  'G|datum' von: 'M|bzeichen' xml: 'M|dntver'
.output
.set trans -
..
.formula U|xdr = "crlf+ " + M|dntver
.system 'U|xdr' background
.formula U|x1cp = "cp " + M|dntver + " " + M|ocintra
.system 'U|x1cp' background
.formula U|xtdatum = 'G|datum:8'
.formula U|xmv = "cp " + M|dntver + " " + M|dntver + "." + 'M|meldnr' + "." + U|xtdatum
.system 'U|xmv' background
..
.. TemporÑre Dateien wieder lîschen
.formula U|xsys = "rm -f " + M|dntrg
.system 'U|xsys' background
..
.select screen header
.copy M|bgemeldet = G|TRUE
.protection -reset intra
.formula M|intra = M|meldnr
.input "sk/INTRASTATZENTRALE.NRMELD"
.input "sk/INTRASTATZENTRALE.BSTART.BV"
.continue END
..
!EDILOESCH: markierte EDI-Nachrichten lîschen
.continue FEHLER1  ?  M|tzeilen = 0
.select screen header
.copy U|xbmark = G|TRUE
..
!LLOOP: hole nur Zeilen tmark = TRUE und gefÅllter EDI-Nachricht
.select screen line
.continue DEMARK ? _G|mehr
.continue LLOOP  ? _M|tmark
.continue LLOOP  ?  F|empty(M|edinachricht)
.continue LOESCH
..
!LOESCH
.input "sk/INTRASTATZENTRALE.LOESCH.BN"
.continue LLOOP
..
!EDIMELD: Edi-Nachrichten erstellen
.continue FEHLER1  ?  M|tzeilen = 0
.select screen header
.copy U|xbmark = G|TRUE
..
!LOOP: hole nur Zeilen tmark = TRUE und leerer EDI-Nachricht
.select screen line
.continue END     ? _G|mehr
.continue LOOP    ? _M|tmark
.. ist eine abgelegte EDI-Nachricht dem Vorgang schon zugeordnet, kann auch eine
.. neue EDI-Nachricht erstellt werden.
.continue LOOP    ? _F|empty(M|edinachricht) & _M|edinachricht^ablagef
..
'U|xtMES0'
.continue EDIBN
..
!EDIMARK
.select screen line
?'U|xtMES2'  ? _G|mehr
.continue END  ? _G|mehr
.continue EDIMARK ? _M|tmark
.continue EDIMARK ? _F|empty(M|edinachricht) & _M|edinachricht^ablagef
.continue EDIBN
..
!EDIBN
'U|xtMES1' 'M|vorgang'
.input "sk/INTRASTATZENTRALE.EDI.BN"
.continue EDIMARK
..
!URL
.browser -new 'M|url0'
.continue END
..
!TESTMELD
.select screen header
..
!SELLINE
.select screen line
.continue COPY    ? _G|mehr
.continue SELLINE ? _M|tmark
.formula M|statusz = M|gruenz ? _F|empty(M|edinachricht) &  F|empty(M|tintra) & M|testindikator & F|filenotempty(M|dntver)
.formula M|tmark = G|FALSE
.continue SELLINE
..
!COPY
.formula U|xdr = "crlf+ " + M|dntver
.system 'U|xdr' background
.formula U|x1cp = "cp " + M|dntver + " " + M|ocintra
.system 'U|x1cp' background
..
!END
.continue
..
!FEHLER
.error 'U|xtFM0'
.end 1
..
!FEHLER1
.error 'U|xtFM1'
.end 1
..
!FEHLER2
.error 'U|xtFM2'
.end 1
..
!FEHLER3
.error Keine Zeile zur Meldung markiert oder EDI-Nachricht fehlt.
.end 1
..
!FEHLER4
.input 'U|xterr'
.error ZurÅckschreiben in den Lieferschein gescheitert!
.end 1
