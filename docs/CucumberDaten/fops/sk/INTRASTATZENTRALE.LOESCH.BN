..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INTRASTATZENTRALE.LOESCH.BN
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type text xtmpfile ? _F|defined(U|xtmpfile)
.type text xtout    ? _F|defined(U|xtout)
.type text xterr    ? _F|defined(U|xterr)
..
.continue END ? F|empty(M|edinachricht)
..
.file -tempname U|xtmpfile
.file -tempname U|xtout
.file -tempname U|xterr
..
.. nur l”schen, wenn Vorgang zu EDI-Nummer keine Meldungsnummer erh„lt.
.continue FEHLER1  ? _F|empty(M|vorgang^intra)
.select lock edifact 'M|edinachricht'
.continue FEHLER   ? _G|mehr
.select
.output new 'U|xtmpfile'
.input DATEI.F
#!database=53
#!action=modify
#!charset=eks
nummer53;ablagef
'M|edinachricht';1
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue FEHLER2 ? _G|mehr
..
.formula M|statusz      = M|blauz
.formula M|edinachricht = ""
.formula M|datummeld    = ""
..
..*****************************************************************************
!END
.continue
..
!FEHLER
.error EDI-Nachricht 'M|edinachricht' nicht mehr vorhanden.
.formula M|edinachricht = ""
.formula M|datummeld    = ""
.formula M|statusz      = M|blauz  ? F|empty(M|edinachricht)
.end 1
..
!FEHLER1
.error EDI-Nachricht 'M|edinachricht' kann nicht gel”scht werden, Vorgang 'M|vorgang^nummer' wurde bereits gemeldet.
.end 1
..
!FEHLER2
.input 'U|xterr'
.error  EDI-Nachricht 'M|edinachricht' konnte nicht gel”scht werden!
.end 1

