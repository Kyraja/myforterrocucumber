..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ABCANA.FEHLER
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
.type bool    xdel ? _F|defined(U|xdel)
.type integer xzn  ? _F|defined(U|xzn)
..
.continue END   ? _M|rueckschreiben
.continue ERROR ? M|tzeilen = 0
..
.formula U|xzn = 1
.select screen header
.continue END ? _G|mehr
..
!SELTAB
.continue END ? U|xzn > M|tzeilen
.select screen line 'U|xzn'
.continue END ? _G|mehr
.continue ERROR2 ? F|empty(M|riconz)
..
!TRUE
.copy U|xdel = G|TRUE ? M|riconz <> M|icongesp
.continue DEL         ? U|xdel
.continue END         ? M|tzeilen = 0
.formula U|xzn =  M|zn + 1
.continue SELTAB
..
!DEL
.make screen line -o 
.copy U|xdel = G|FALSE
.continue END         ? M|tzeilen = 0
.formula U|xzn = M|zn
.continue SELTAB
..************************************************************************
!END
.continue
..
!ERROR
.error Keine gesperrten Artikel in der Tabelle.
.end 1
..
!ERROR2
.error Artikel wurden noch nicht zurÅckgeschrieben.
.end 1
