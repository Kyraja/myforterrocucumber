..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INTRASTATZENTRALE.MELD
.. Datum          : 03.08.2010
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Intrastatistik schreiben
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type integer  xzi       ? _F|defined(U|xzi)
.type text xrgnr     ? _F|defined(U|xrgnr)
.type text xmonat    ? _F|defined(U|xmonat)
.type text xjahr     ? _F|defined(U|xjahr)
.type text xsteunr   ? _F|defined(U|xsteunr)
..
.. Rechnungsnummer fÅr Protokoll merken
.formula U|xrgnr = M|vorgang^nummer
.formula U|xsteunr = (M|steunr + "00000000000") << 11
..
.. Tabelle der EDI-Nachrichten abarbeiten
.formula U|xzi = 1
.formula M|zenr = 'U|xzi'
..
.. Edi-Nachricht laden
.load 4 edifact 'M|edinachricht'
.continue FEHLER ? _G|mehr
..
!ZEILE
.load 4 line
.continue END ? _G|mehr
..
.formula U|xmonat = ('M|datumbis:8' >> -2) >> 2
.formula U|xjahr  = ('M|datumbis:8' >> -4) >> 2
..
.. Satz in Zwischenspeicher schreiben
.output addedto 'M|dntzw'
.input "DATEI.F"
..    x1     x2         x3         x4          x5       x6       x7-x9  x10      x11       x12         x13          x14     x15      x16     x17    x18         x19       x20         x21       x22      x23     x24          x25
'4|text4'#'U|xmonat'#'U|xjahr'#'U|xsteunr'#'M|tustzus'#'M|tischl'####'4|text7'#'4|text8'#'4|text10'#'4|text20'#'4|text14'#'4|text13'#'4|text7'##'4|text16'#'4|text17'#'4|text18'#'4|text19'#'M|vorgang'#'M|zenr'#'G|datum:8'#'M|vorgang^id'
.output
..
.. Satz in Rechnungsdatei speichern
.continue ZAEHLER ? M|rgsnr = M|satznr
.output addedto 'M|dntrg'
.input "DATEI.F"
'M|satznr'#'M|vorgang^dnr'
.output
.formula M|rgsnr = M|satznr
..
!ZAEHLER: ZeilenzÑhler der Tabelle
.formula U|xzi = U|xzi + 1
.formula M|zenr = 'U|xzi'
..
.continue ZEILE
..
..*****************************************************************************
!END
.continue
..
!FEHLER
.error EDI-Nachricht existiert nicht (mehr)!
.end 1

