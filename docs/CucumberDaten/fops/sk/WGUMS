.set trans -
.. in die Var. q wird die W„hrung aus dem Firmenstamm - Konfig. geladen
.. Diese Var. wird in Kopf berschriften verwendet
.formula q = inland
..
..  xtdf -> STE.panummer
..  xtds -> STE.SRTpanummer
..
..  Datum ist in Form JJJJMMTT gespeichert
..
.set background +
.formula xtsys="sort -t# +11 -12 -o " + xtdf + " " + xtdf
.system 'xtsys'
.formula xtsys="verdwgums " + xtdf + " > " + xtds
.system 'xtsys'
.formula xtsys="verdwgug " + xtdf + " > " + xtdb
.system 'xtsys'
.set background -
..
.select from 'xtdb' xtknr # xtksu # xtmo # xtanr # xtasu # xrs1 # xrb1 # xrs2 # xrb2 # xrs3 # xrb3 # xtms #
.continue ENDE ? _mehr
.formula xrges1=xrb1
.formula xrges2=xrb2
.formula xrges3=xrb3
.formula xt1tmp=xd2bis
.formula xt1art=xd2von
.formula xt1art=xt1art + "-" + xt1tmp
.formula xt1tmp=xdvbis
.formula xt2art=xdvvon
.formula xt2art=xt2art + "-" + xt1tmp
.formula xt1tmp=xdbis
.formula xt3art=xdvon
.formula xt3art=xt3art + "-"+ xt1tmp
.page 1
.up
.set trans +
============================================================================================================================
'Mandant        '               Umsatzstatistik nach Warengruppen                                 '   datum'     Seite' sei'
'txname         '
============================================================================================================================
Warengruppe                                         '           xt1art'      '           xt2art'      '           xt3art'
                                                        TDEM          %          TDEM          %         TDEM           %
----------------------------------------------------------------------------------------------------------------------------
..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      xxxxxxx      xxxxxx      xxxxxxx      xxxxxx      xxxxxxx      xxxxxx
..
.formula xrb7=0.00
.formula xrb8=0.00
.formula xrb9=0.00
!NEXT:
.select from 'xtds' xtknr # xtksu # xtmo # xtanr # xtasu # xrs1 # xrb1 # xrs2 # xrb2 # xrs3 # xrb3 # xtms #
.continue ENDE ? _mehr
.formula xxq=""
.formula xyxsu="WG" + xtms
.select company 'xyxsu'
.formula xxq=name ? mehr
.formula xrd1=0.00
.formula xrd2=0.00
.formula xrd3=0.00
.formula xrd1=xrb1 * 100 / xrges1 ? xrges1 <> 0.00
.formula xrd2=xrb2 * 100 / xrges2 ? xrges2 <> 0.00
.formula xrd3=xrb3 * 100 / xrges3 ? xrges3 <> 0.00
.formula xrb1=(xrb1 / 1000):0
.formula xt1=xrb1
.formula xt1=xt1 << "."
.formula xt1=xt1 >> -3 + "." + xt1 >> 3 ? xrb1 > 1000
.formula xrb2=(xrb2 / 1000):0
.formula xt2=xrb2
.formula xt2=xt2 << "."
.formula xt2=xt2 >> -3 + "." + xt2 >> 3 ? xrb2 > 1000
.formula xrb3=(xrb3 / 1000):0
.formula xt3=xrb3
.formula xt3=xt3 << "."
.formula xt3=xt3 >> -3 + "." + xt3 >> 3 ? xrb3 > 1000
'xxq                                         '      '  xt3'     ' xrd3'      '  xt2'     ' xrd2'      '  xt1'     ' xrd1'
.formula xrb7=xrb7+xrb1
.formula xrb8=xrb8+xrb2
.formula xrb9=xrb9+xrb3
.continue NEXT
!ENDE:

.set trans -
.formula xt1=xrb7
.formula xt1=xt1 << "."
.formula xt1=xt1 >> -3 + "." + xt1 >> 3 ? xrb7 > 1000
.formula xt2=xrb8
.formula xt2=xt2 << "."
.formula xt2=xt2 >> -3 + "." + xt2 >> 3 ? xrb8 > 1000
.formula xt3=xrb9
.formula xt3=xt3 << "."
.formula xt3=xt3 >> -3 + "." + xt3 >> 3 ? xrb9 > 1000
.set trans +
GESAMTSUMME:                                        '  xt3'      100.00      '  xt2'      100.00      '  xt1'      100.00
.continue
