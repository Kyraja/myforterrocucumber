.end .  ?  txname / "*ALUMS"
..*****************************************************************************
..
..  xtdf -> STE.panummer
..  xtds -> STE.SRTpanummer
..
..  Sortkriterien: Artikelnummer, Lief.suchwort, Lief.nummer, Datum-Monat
..  Datum ist in Form JJJJMMTT gespeichert, mit +2.4n -2.6 ist Monat gemeint
..
.set trans +
.occupy 'xtds'
.set background +
.formula xtsys="sort -t# +3n -4 +1d -2 +0n -1 +2.4n -2.6 -o " + xtdf + " " + xtdf
.system 'xtsys'
..
..  awk wird in verdm gestartet
..  Bei Monatsausgabe: die Zahlen 5 2 bedeuten, daá aus Datum in Form JJJJMMTT
..  Monat ausgeschnitten wird (ab 5. Stelle in L„nge 2)
..
.formula xtsys="verdm " + xtdf + " 5 2 > " + xtds ? xtwahl="M"
.formula xtsys="verdm " + xtdf + " 3 1 > " + xtds ? xtwahl="K"
.system 'xtsys'
.formula xtsys="sort -t# +3n -4 +0n -1 +6nr -7 +8nr -9 -o " + xtds + " " + xtds
.system 'xtsys'
.set background -
.formula xt1art="monatlich" ? xtwahl = "M"
.formula xt1art="kumuliert" ? xtwahl = "K"
.formula xt2art="Monat"     ? xtwahl = "M"
.formula xt2art="     "     ? xtwahl = "K"
.set thoussep 'tsdtrenn'
.set decpoint 'dezpunkt'
.page 1
.up
