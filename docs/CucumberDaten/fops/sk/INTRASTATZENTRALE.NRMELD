..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INTRASTATZENTRALE.NRMELD
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type integer  xiisn ? _F|defined(U|xiisn)
.type text xsys  ? _F|defined(U|xsys)
..
!MELDNR: Meldungsnummer ermitteln
.occupy INTRA
.. Z„hler holen
.formula U|xiisn = 0
.formula M|dnt = M|arbver + "INTRA.N"
.formula U|xsys = "test -s " + M|dnt
.system 'U|xsys' background
.continue NUMMER ? _G|mehr
.input "DATEI.F"
.select from
.select from 'M|dnt' U|xiisn ^
.select from
.continue NUMMER
..
!NUMMER
.formula U|xiisn  = U|xiisn + 1
.formula M|meldnr = U|xiisn
..
..*****************************************************************************
!END
.continue
