..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INTRASTATZENTRALE.AP.BN
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.type text xtsel ? _F|defined(U|xtsel)
.set trans -
.continue FEHLER  ? M|statusz = M|gruenz & _F|empty(M|intra) & _G|evtvar="pruefen"
..
.copy M|bfarben = G|TRUE
..
.. Aufrufparameter zwischen INTRASTATZENTRALE und INTRASTATNACHRICHT
.type ID87:9 xcallparam
.assign U|xcallparam = "52591"
.input "st/CALLPARAM.EXEC"
..
.select screen line 'M|aktzeile'
..
.. Edi-Nachricht suchen
.formula U|xtsel = "$,,bezobj=" + M|vorgang^id
.formula U|xtsel = U|xtsel + ";vorart=90;imex=EX"
.formula U|xtsel = U|xtsel + ";datenart=VK" ? M|vorgang^dnr = 3
.formula U|xtsel = U|xtsel + ";datenart=EK" ? M|vorgang^dnr = 4
.load 3 edifact 'U|xtsel'
.formula M|edinachricht = 3|id     ? G|mehr
.formula M|datummeld    = 3|erfass ? G|mehr
.load 3
..
.formula M|statusz = M|blauz  ?  F|empty(M|edinachricht) &  F|empty(M|tintra)
.formula M|statusz = M|gelbz  ? _F|empty(M|edinachricht) &  F|empty(M|tintra)
.formula M|statusz = M|gruenz ? _F|empty(M|edinachricht) & _F|empty(M|tintra)
..*****************************************************************************
!END
.continue
..
!FEHLER
.error Es wurde bereits die Meldung 'M|tintra' zu diesem Vorgang erstellt.
.end 1

