..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABCANA.CHART.BALKEN
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : zeigt Daten in einem Balken-Diagramm an
..*****************************************************************************
.type text  xttitel1   ? _F|defined(U|xttitel1)
.type text  xttitel2   ? _F|defined(U|xttitel2)
..
.set trans +
.formula U|xttitel1 = F|formatstr("Wert (in {1})", 'G|inland') 
.formula U|xttitel2 = "A-Teile; B-Teile; C-Teile"
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -TITLECHART 'U|xttitel1'
.chart -PARAM -MARKERX 'U|xttitel2'
.chart -PARAM -ANGLEX 45
.chart -PARAM -DECIMALSY 2
.chart -PARAM -CLUSTERED
.chart -PARAM -3D NO
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NOCOLOR
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOZOOM
.chart -PARAM -TOOLBAR NOTOOLS
.chart -PARAM -CONTEXTMENU NONE
.chart -STARTVALUES Wert -COLOR 4
.chart -VALUE 'M|awert'
.chart -VALUE 'M|bwert'
.chart -VALUE 'M|cwert'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
