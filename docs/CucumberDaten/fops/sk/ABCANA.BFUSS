..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABCANA.BFUSS
.. Datum          : 14.03.07
.. Version        : 2007r1
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Verdichtungsskripte
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
.. Includes       :
..*****************************************************************************
.set trans -
.type text  x0       ? _F|defined(U|x0)
.type text  x1       ? _F|defined(U|x1)
.type text  x2       ? _F|defined(U|x2)
.type text  x3       ? _F|defined(U|x3)
.type text  x4       ? _F|defined(U|x4)
.type text  x5       ? _F|defined(U|x5)
.type text  x6       ? _F|defined(U|x6)
.type text  x7       ? _F|defined(U|x7)
.type text  x8       ? _F|defined(U|x8)
.type NT1   xcls     ? _F|defined(U|xcls)
.type ARTR52100 xrgums   ? _F|defined(U|xrgums)
.type ARTR52100 xawert   ? _F|defined(U|xawert)
.type ARTR52100 xbwert   ? _F|defined(U|xbwert)
.type ARTR52100 xcwert   ? _F|defined(U|xcwert)
.type ARTR52100 xsumums  ? _F|defined(U|xsumums)
.type ARTR52100 xsumpos  ? _F|defined(U|xsumpos)
.type R12.3 xsummge  ? _F|defined(U|xsummge)
.type ARTR52100 xzums    ? _F|defined(U|xzums)
.type ARTR52100 xzsumpos ? _F|defined(U|xzsumpos)
.type integer xnart  ? _F|defined(U|xnart)
.type integer xianz  ? _F|defined(U|xianz)
.type R3.2  xrpa     ? _F|defined(U|xrpa)
.type R3.2  xrpb     ? _F|defined(U|xrpb)
.type R3.2  xrpc     ? _F|defined(U|xrpc)
..
.formula U|xrpa = M|rpa
.formula U|xrpb = M|rpb
.formula U|xrpc = M|rpc
..
.occupy WERF.WEG
.output new WERF.WEG
.occupy
.set background +
.formula U|xtsys="sort -t# -k1,1 -o " + U|xtd1 + " " + U|xtd1
.system 'U|xtsys'
.continue ERROR1 ? _G|mehr
.. xtd2: alle Artikel aller Lagergruppen
.formula U|xtsys="verdfirst.sh " + U|xtd1 + " > " + U|xtd2
.system 'U|xtsys'
.continue ERROR2 ? _G|mehr
..
!HOLE
.select from 'U|xtd1' U|xid # U|xaname # U|xrgmge # U|xrgums # U|xrart # U|xpreis # U|x7 # U|x8 # U|xlgruppe #
.continue VERD     ? _G|mehr
.output addedto 'U|xtd5'
?'U|xid'#xx#'U|xrgmge'#'U|xrgums'#'U|xnart'#'U|xpreis'#'U|x7'#'U|x8'#ZZZZZZZZZZ#   ? U|xlgruppe <> M|klgruppe^such & U|xaname = "xx"
?'U|xid'#xx#'U|xrgmge'#'U|xrgums'#'U|xnart'#'U|xpreis'#'U|x7'#'U|x8'#'U|xlgruppe'# ? U|xlgruppe =  M|klgruppe^such & U|xaname = "xx"
?'U|xid'#yy#'U|xrgmge'#'U|xrgums'#'U|xnart'#'U|xpreis'#'U|x7'#'U|x8'#ZZZZZZZZZZ#   ? U|xlgruppe <> M|klgruppe^such & U|xaname = "yy"
?'U|xid'#yy#'U|xrgmge'#'U|xrgums'#'U|xnart'#'U|xpreis'#'U|x7'#'U|x8'#'U|xlgruppe'# ? U|xlgruppe =  M|klgruppe^such & U|xaname = "yy"
.continue HOLE
..
!VERD
.formula U|xtsys="sort -t# -k1,1 -k8,8 -k9,9 -o " + U|xtd5 + " " + U|xtd5
.system 'U|xtsys'
.continue ERROR1 ? _G|mehr
.. xtd4: alle Artikel einer Lagergruppe
.formula U|xtsys="verabc.sh " + U|xtd5 + " > " + U|xtd4
.system 'U|xtsys'
.continue ERROR2 ? _G|mehr
..
.formula U|xtsys="verabcg.sh " + U|xtd2 + " > " + U|xtd3
.system 'U|xtsys'
.continue ERROR2 ? _G|mehr
..
.formula U|xtsys="sort -t# -k4,4nr -o " + U|xtd2 + " " + U|xtd2
.system 'U|xtsys'
.continue ERROR1 ? _G|mehr
..
.formula U|xtsys="sort -t# -k4,4nr -o " + U|xtd4 + " " + U|xtd4
.system 'U|xtsys'
.continue ERROR1 ? _G|mehr
.set background -
..
.select from 'U|xtd3' U|xid # U|xaname # U|xrgmge # U|xrgums # U|xrart # U|xpreis #
.end 1                  ? _G|mehr
..
.formula U|xizaehl = 1
.formula U|xawert  = 0
.formula U|xbwert  = 0
.formula U|xcwert  = 0
.formula U|xsumums = 0
.formula U|xsummge = 0
.formula U|xzums   = 0
.formula M|hinweis = ""
..
!NEXT
.continue XTD4             ?  M|elgruppe & M|aauswert
..
.select from 'U|xtd2' U|xid # U|xaname # U|xmge # U|xums # U|xnart # U|xpreis #
.continue LETZT            ? _G|mehr
.continue AUSWERT
..
!XTD4
.select from 'U|xtd4' U|xid # U|xaname # U|xmge # U|xums # U|xnart # U|xpreis # U|x7 # U|x8 # U|xlgruppe #
.continue LETZT            ? _G|mehr
.continue XTD4             ? 'U|xlgruppe' <> 'M|klgruppe^such'
..
!AUSWERT
.make screen line +O
.colour -background -1 -1 -1 -foreground -1 -1 -1 'M|aktzeile'
.formula M|artikel   = U|xid
.formula M|iconz     = M|iproduct   ? _F|equals(M|artikel^bsart, "(InhouseProduction)")
.formula M|iconz     = M|ioperation ?  F|equals(M|artikel^bsart, "(InhouseProduction)")
.formula M|izaehl    = U|xizaehl
.formula M|tclass    = ""
.formula M|preis     = U|xpreis
.formula M|wert      = 0
.formula M|rp1       = 0
.formula M|mge       = U|xmge
.formula M|ums       = U|xums
.formula M|zsumme    = M|ums + U|xzums
.formula M|zsumpos   = M|ums + U|xzums ? M|ums > 0
.formula M|kum       = 0
.formula M|rp2       = 0
.copy M|legeaendert  = G|FALSE
.continue CONTINUE ? U|xaname = "xx" ; M|ums  = 0 & M|bpreis & M|tzeilen > 0
.colour -background 'M|colour' 'M|aktzeile' 
.set trans +
.formula M|hinweis = "Die Lagereinheit wurde bei mindestens einem Artikel innerhalb des selektierten Zeitraums geÑndert (siehe Markierung). Die Auswertung ist mîglicherweise verfÑlscht." ? U|xaname = "yy"
.set trans -
.copy M|legeaendert = G|TRUE
..
!CONTINUE
.copy M|lagereinh = M|artikel^le
.formula U|xzums     = M|zsumme
.formula U|xsumums   = U|xsumums + M|ums
.formula U|xsumpos   = U|xsumpos + M|ums ? M|ums > 0
.make screen line -O               ? M|ums  = 0 & M|bpreis & M|tzeilen > 0
.continue NEXT                     ? U|xums = 0 & M|bpreis
..
.formula U|xsummge = U|xsummge + M|mge
.formula U|xizaehl = U|xizaehl + 1
.continue NEXT
..
!LETZT: Letzte Zeile, Summenfeld fÅr Umsatz im Kopf fÅllen
.select screen header
.formula M|sumumsatz = U|xsumums
.formula M|sumpositiv = U|xsumpos
..
!ENDE
.formula U|xianz = 1
.formula U|xrp1  = 0.00
.formula U|xrp2  = 0.00
..
!ZEILE
.continue KOPF                                  ?  M|tzeilen = 0
.select screen line 'U|xianz'
.continue KOPF                                  ? _G|mehr
.continue KOPF                                  ?  F|empty(M|artikel)
.formula M|wert   = 0
.formula M|wert   = M|ums * 100 / U|xsumpos    ? U|xsumpos <> 0
.formula M|wert   = 0 ? M|wert < 0
.formula U|xrp1   = 0
.formula U|xrp1   = M|zsumpos / U|xsumpos * 100 ? U|xsumpos > 0
.formula U|xrp1   = 0 ? U|xrp1 < 0
.formula M|rp1    = U|xrp1
.formula U|xcls   = "C" ? U|xrp1 > (U|xrpa + U|xrpb)
.formula U|xcls   = "B" ? U|xrp1 >  U|xrpa & U|xrp1 <= (U|xrpa + U|xrpb)
.formula U|xcls   = "A" ? U|xrp1 <= U|xrpa
.formula U|xcls   = "C" ? F|empty(U|xrp1)   
.formula M|tclass = U|xcls
.formula M|tclass = "C" ? M|ums < 0
.formula M|kum    = M|mge * 100 / U|xsummge    ? U|xsummge <> 0
.formula U|xrp2   = U|xrp2 + M|kum
.formula M|rp2    = U|xrp2
.formula U|xawert = U|xawert + M|ums            ? M|tclass = "A"
.formula U|xbwert = U|xbwert + M|ums            ? M|tclass = "B"
.formula U|xcwert = U|xcwert + M|ums            ? M|tclass = "C"
.formula U|xianz  = U|xianz + 1
.continue KOPF                                   ? U|xianz > M|tzeilen
.continue ZEILE
..
!KOPF: Kopffelder fÅllen
.formula M|awert  = U|xawert
.formula M|bwert  = U|xbwert
.formula M|cwert  = U|xcwert
..
.continue
..
!ERROR1
.error Sortierung gescheitert.
.end 1
..
!ERROR2
.error Verdichten gescheitert.
.end 1
