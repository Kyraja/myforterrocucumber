..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INTRASTATZENTRALE.BUTTON
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Buttons fr aktueller Monat / Vormonat
..
.. Ablauf         :
.. Program flow   :
...Includes       :
..*****************************************************************************
.set trans -
.type date xd1
.type text xam xdatum xad xaj
..
.continue AKT     ? G|evtvar="aktmonat"
.continue VOR     ? G|evtvar="vormonat"
.continue
..
!AKT: Aktueller Monat bis Tagesdatum
.formula U|xd1 = "."
.formula U|xaj = F|year(U|xd1)
.formula U|xam = F|month(U|xd1)
.formula U|xad = F|day(U|xd1)
.formula U|xam = ("00" + U|xam) >> 2
.continue ZEITRAUM
..
!VOR: Vormonat
.formula U|xd1 = M|datumvon
.formula U|xd1 = xd1 - 1
.formula U|xaj = F|year(U|xd1)
.formula U|xam = F|month(U|xd1)
.formula U|xad = F|day(U|xd1)
.formula U|xam = ("00" + U|xam) >> 2
.continue ZEITRAUM
..
!ZEITRAUM: Zeitraum setzen
.formula U|xdatum = 'U|xaj' + 'U|xam' + "01"
.formula M|datumvon = U|xdatum
.formula M|datumbis = "."             ? G|evtvar="aktmonat"
.formula M|datumbis = U|xd1           ? G|evtvar="vormonat"
.continue
