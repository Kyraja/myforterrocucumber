!VA0
..
..  wenn keine Auswahl getroffen, wird das MenÅ angezeigt
.continue MENUE1  ?  _xtstat / "*(1234)*"
.formula xtsys = "touch " + xtda
.system 'xtsys' background
.select from 'xtda' xt1tmp
.formula xbdw = mehr
..
.. Wenn die xtda-Datei nicht vorhanden ist, kann der Letztedruck nicht
.. wiederholt werden
..
.continue VA1  ?  _xbdw
.menu Letzten Druck wiederholen
              Nein             >>  .formula xbdw = false
              Ja               >>  .formula xbdw = true
..
.continue BEENDEN  ?  F|empty(G|menue)
..
!VA1
.select from
..
..  Letzten Druck wiederholen -> die Var. xbdw = true
..  Gelesen wird der 1. Satz der STE.AUSW.panummer Datei
.select from 'xtda' xtwahl # xtvku # xtbku # xtvms # xtbms # xdate8 # xdate81 # xyw ? xbdw
.formula xdvon=xdate8
.formula xdbis=xdate81
.output terminal
                             Statistiken - Einkauf

?                      Umsatzstatistik Lieferanten/Artikel     ?  xtstat / "*2*"
?                                                              ?  xtstat / "*2*"
?                       Lieferanten, nach Umsatz sortiert      ?  xtstat / "*3*"
?                                                              ?  xtstat / "*3*"
?                          Artikel-/Lieferanten-Umsatz         ?  xtstat / "*4*"
?                                                              ?  xtstat / "*4*"
?                     Der letzte Druck wird in der Einheit     ?  xbdw  &  eurokurs > 0
?                      des letzten Laufes wiederholt ('xyw')   ?  xbdw  &  eurokurs > 0

..
!FRAGE1:
.continue FRAGE2 ? _xtstat/"*/24/*"
.continue FRAGE2 ? xbdw
.menu
Monatlich          >>  .formula xtwahl = "M"
Kumuliert          >>  .formula xtwahl = "K"
Vorheriges MenÅ    >>  .continue MENUE0
..
.continue BEENDEN  ?  F|empty(G|menue)
..
?                                   monatlich  ?  xtwahl = "M"
?                                   kumuliert  ?  xtwahl = "K"

..
!FRAGE2:
.continue FRAGE21 ? _xtstat/"*/2/*"
..
!ALIEF
.read "von Lieferant " xtvku ? _xbdw
.continue ALIEF ? XTVKU / "\?"
.formula xtvku="A" ? xtvku=""
.formula xtvsu="A" ? xtvku="A"
   von Lieferant: 'xtvku'
.formula xbn xtvku/"(09)*" ; (xtvku/"(09)*" & xtvku/"*(AZ)*")
.continue ELIEF  ? xtvku="A"
.select supplier 'xtvku'
?Lieferant 'xtvku' nicht vorhanden ? _mehr
.continue ALIEF ? _mehr
.formula T|xtvsu = H|such
.formula T|xtvku = H|such ? _xbn
..
!ELIEF
.read "bis Lieferant " xtbku ? _xbdw
.formula xbnn xtbku/"(09)*" ; (xtbku/"(09)*" & xtbku/"*(AZ)*")
.continue ELIEF ? XTBKU / "\?"
.formula xtbku="ZZZZZZZZ" ? xtbku = "" & _xbn
.formula xtbku="99999999" ? xtbku = "" & xbn
.formula xtbsu="ZZZZZZZZ" ? xtbku="ZZZZZZZZ"
   bis Lieferant: 'xtbku'
?Bitte Identnummer eingeben           ? xbn & _xbnn & xtbku <> "99999999"
?Bitte Suchwort eingeben              ? _xbn & xbnn & xtbku <> "ZZZZZZZZ"
.continue ELIEF ? (xbn & _xbnn & xtbku <> "99999999") ; (_xbn & xbnn & xtbku <> "ZZZZZZZZ")
.continue SLIEF ? xtbku = "99999999" ; xtbku="ZZZZZZZZ"
.select supplier 'xtbku'
?Lieferant 'xtbku' nicht vorhanden ? _mehr
.continue ELIEF  ? _mehr
.formula T|xtbsu = H|such
.formula T|xtbku = H|such ? _xbn
.formula T|xtbku = H|num  ? xbn
..
!SLIEF:
?Obergrenze kleiner als Untergrenze, bitte neu wÑhlen! ? xtbku < xtvku & _xbn
.continue FRAGE2 ? xtbku < xtvku & _xbn
.continue FRAGE21 ? _xbn
..
.select supplier "!" ? xtvku="A" ; xtbku = "99999999" ; xtbku="ZZZZZZZZ"
.formula xtvon = "----------------------" + xtvku
.formula xtvon = xtvon>> +H|nummerb
.formula xtbis = "----------------------" + xtbku
.formula xtbis = xtbis>> +H|nummerb
?Obergrenze kleiner als Untergrenze, bitte neu wÑhlen! ? xtbis < xtvon
.continue FRAGE2 ? xtbis < xtvon
..
!FRAGE21:
.continue FRAGE3 ? _xtstat/"*/4/*"
..
!AART
.read "von Artikel " xtvku ? _xbdw
.formula xtvku="A" ? xtvku=""
.continue AART  ? XTVKU / "\?"
   von Artikel: 'xtvku'
.formula xban  xtvku/"(09)*" ; (xtvku/"(09)*" & xtvku/"*(AZ)*")
..
!BART
.read "bis Artikel " xtbku ? _xbdw
.formula xtbku="ZZZZZZZZZZZZZZZ" ? xtbku = "" & _xban
.formula xtbku="999999999999999" ? xtbku = "" & xban
.continue BART  ? XTBKU / "\?"
.formula xbnan  xtbku/"(09)*" ; (xtbku/"(09)*" & xtbku/"*(AZ)*")
   bis Artikel: 'xtbku'
?Bitte Identnummer eingeben           ? xban & _xbnan & xtbku<>"999999999999999"
?Bitte Suchwort eingeben              ? _xban & xbnan & xtbku<>"ZZZZZZZZZZZZZZZ"
.continue BART ? (xban & _xbnan & xtbku<>"999999999999999") ; (_xban & xbnan & xtbku<>"ZZZZZZZZZZZZZZZ")
?Obergrenze kleiner als Untergrenze, bitte neu wÑhlen! ? xtbku < xtvku & _xban
.continue FRAGE2 ? xtbku < xtvku & _xban
.continue FRAGE3 ? _xban
..
.select parts "!"
.formula xtvona = "----------------------" + xtvku
.formula xtvona = xtvona>> +H|nummerb
.formula xtbisa = "----------------------" + xtbku
.formula xtbisa = xtbisa>> +H|nummerb
?Obergrenze kleiner als Untergrenze, bitte neu wÑhlen! ? xtbisa < xtvona
.continue FRAGE2 ? xtbisa < xtvona
..
!FRAGE3:
..  eventuell weitere Auswahlkriterien
..  normalleweise wird "xanf" und "xend" in ZEITRAUM belegt,
..  bei Druckwiederholung allerdings steht der Zeitraum in "xdvon" und "xdbis"
..
.formula xanf = xdvon  ?  xbdw
.formula xend = xdbis  ?  xbdw
.continue FRAGE5    ?  xbdw
..
!FRAGE4: Zeitraum abfragen
.input ZEITRAUM
.formula xdvon = xanf
.formula xdbis = xend
..
!FRAGE5: wenn letzten Druck wiederholen (xbdw = true) wird, wird die FRAGE4
..       Åbersprungen. Nachfolgende Bildschirmausgabe nur bei Druckwiederholung
?Zeitraum     'xdvon' bis 'xdbis'  ?  xbdw
?                                  ?  xbdw
.type date xyindate xyoutdate
.formula xyindate = xanf
.input DATUM.JAHR
.formula xdvvon   = xyoutdate
..
..  Jahr - 2
.formula xyindate = xdvvon
.input DATUM.JAHR
.formula xd2von   = xyoutdate
..
.formula xyindate = xend
.input DATUM.JAHR
.formula xdvbis   = xyoutdate
..
..  Jahr - 2
.formula xyindate = xdvbis
.input DATUM.JAHR
.formula xd2bis   = xyoutdate
..
Vorjahr    'xdvvon' bis 'xdvbis'
Vorvorjahr 'xd2von' bis 'xd2bis'

..
..  Mit EXCEL Ausgabe nur wenn DB_Var dde = true
.formula xybmit = false
.formula xytlgp = "STATEK"
.input DDE.MENUE  ?  dde  &  xtstat / "*3*"
..
.read "Umsatz, nach Warengruppen sortiert:  Anzahl Drucke " xiaud ? xtstat/"*1*"
.read "Umsatzstatistik Lieferanten/Artikel: Anzahl Drucke " xiukd ? xtstat/"*2*"
.read "Lieferanten, nach Umsatz sortiert:   Anzahl Drucke " xiuad ? xtstat/"*3*"
.read "Artikel-/Lieferanten-Umsatz:         Anzahl Drucke " xiumd ? xtstat/"*4*"
'txname': Selektieren der Daten lÑuft...

.formula xiaud=1 ? xiaud=0
.formula xiukd=1 ? xiukd=0
.formula xiuad=1 ? xiuad=0
.formula xiumd=1 ? xiumd=0
.formula xibpd=1 ? xibpd=0
..
..  Satz in STE.AUSW.panummer speichern. Datei bei "Druck wiederholen" verwenden
..  xtwahl - monatlich(M) / kumuliert(K), default ist monatlich
..  xtvku - von Lief., xtbku - bis Lief.
..  xtvms - Textvar. leer, xtbms- Textvar. leer, Datum von bis: xdvon xdbis
..
.formula xtwahl = "M"  ?  xtwahl = ""
.output new 'xtda'
.input "DATEI.F"
..
..  brauche nicht zu schreiben, wenn Druckwiederholung
?'xtwahl' # 'xtvku' # 'xtbku' # 'xtvms' # 'xtbms' # 'xdvon:8' # 'xdbis:8' # 'auswaehr' ? _xbdw
..
..  UPRO: ABLEK starten -> es wird die Datei ABLE.DAT (xtdo) erzeugt/ergÑnzt
.input 'xtabla'
..
..  von/bis Monat, Artikelgruppe ermitteln
.formula xdate8 = xdvon:8
.formula xdate8 = (xdate8 << 6) >> 2
.formula xivm   = xdate8
.formula xdate8 = xdbis:8
.formula xdate8 = (xdate8 << 6) >> 2
.formula xibm   = xdate8
..
..  xbdw = true -> letzten Druck wiederholen
.continue DRUCK  ?  xbdw
..
..  Daten aus ABLE.DAT verarbeiten
..  xtdf -> STE.panummer, alle Treffer speichern
..  xtdo -> ABLE.DAT
.select from
.occupy 'xtdo'
.output new 'xtdf'
..
!HA: von sk/ABLE.DAT holen
.select from 'xtdo' xtasa # xtren # xtknr # xtksu # xdate8 # xrpw # xtanr # xtasu # xrmge # xtle # xtwgr # xyw
.continue DRUCK  ? _mehr
.formula xddre = xdate8      ? xdate8/"*.*"
.formula xtdre = 'xddre:8'   ? xdate8/"*.*"
.formula xtdre = xdate8      ? _xdate8/"*.*"
.formula xtd2von = 'xd2von:8'
.formula xtdbis = 'xdbis:8'
.formula xtd2bis = 'xd2bis:8'
.formula xtdvvon = 'xdvvon:8'
.formula xtdvbis = 'xdvbis:8'
.formula xtdvon = 'xdvon:8'
.formula xtms = xtwgr
..
..  Datum PrÅfen
.continue HA  ?  xtdre < xtd2von ; xtdre > xtdbis
.continue HA  ?  xtdre > xtd2bis & xtdre < xtdvvon
.continue HA  ?  xtdre > xtdvbis & xtdre < xtdvon
..
..  Springen  wenn nicht "Umsatzstatistik Lieferanten/Artikel" gewÑhlt wurde
.continue HA0 ? _xtstat/"*/2/*"
..
..  xbn = true -> Numerneingabe bei Lieferant, Lieferantenbereich wird getestet
.continue HA  ? _xbn & (xtksu < xtvku  ; xtksu > xtbku)
.continue HA  ? _mehr & (xtksu < xtvsu ;  xtksu > xtbsu)
..
.formula xtnknr= "----------------------" + xtknr ? xbn
.formula xtnknr= xtnknr>> +H|nummerb                ? xbn
..
.continue HA  ? mehr  & xbn  & (xtvon > xtnknr ; xtbis < xtnknr)
..
!HA0:
..  Springen, wenn nicht "Artikel-/Lieferanten-Umsatz" gewÑhlt wurde
.continue HA1 ? _xtstat/"*/4/*"
..
.. xban = true --> Nummerneingabe bei Artikel wird getestet
..
.formula x1tanr = ("                              " + xtanr) >> 30
.formula x1tvku = ("                              " + xtvku) >> 30
.formula x1tbku = ("                              " + xtbku) >> 30
..
.continue HA ? _xban & (xtasu < xtvku ; xtasu > xtbku)
.continue HA ?  xban & (x1tanr < x1tvku ; x1tanr > x1tbku)
..
!HA1
..
..  noch kein Euro bekannt, InlandswÑhrung eindeutig
.continue BOSTON  ?  eurokurs = 0.0
..
..  AusgabewÑhrung und VorgangswÑhrung identisch
.continue BOSTON  ?  xyw = auswaehr
..
..  Umrechnen in gewÑhlte WÑhrung
.formula xrpw = xrpw / eurokurs  ?  xyw = ainland
.formula xrpw = xrpw * eurokurs  ?  xyw = ninland
..
!BOSTON
?'xtknr'#'xtksu'#'xtdre'#'xtanr'#'xtasu'#'xrmge'#'xrpw'#0.00#0.00#0.00#0.00#'xtms'#'xtle'  ? xtdre >= xtdvon
?'xtknr'#'xtksu'#'xtdre'#'xtanr'#'xtasu'#0.00#0.00#'xrmge'#'xrpw'#0.00#0.00#'xtms'#'xtle'  ? xtdre >= xtdvvon & xtdre <= xtdvbis
?'xtknr'#'xtksu'#'xtdre'#'xtanr'#'xtasu'#0.00#0.00#0.00#0.00#'xrmge'#'xrpw'#'xtms'#'xtle'  ? xtdre >= xtd2von & xtdre <= xtd2bis
.continue HA
..
!DRUCK:
.occupy
..  in die Var. q wird die WÑhrung aus dem Firmenstamm - Konfig. geladen
..  Diese Var. wird in Kopf Åberschriften verwendet
.formula q = xyw       ?  xbdw
.formula q = inland    ? _xbdw & eurokurs = 0.0
.formula q = auswaehr  ? _xbdw & eurokurs > 0.0
..
.continue DRUCK2 ? _xtstat/"*1*"
.up
.down
.output 'geraet'
.print 'xiaud'
.input BLANKOB.F
.output terminal ...  ?   geraet  = ""
..
!DRUCK2:
.continue DRUCK3 ? _xtstat/"*2*"
.up
.down
.output 'geraet'
.print 'xiuad'
.input BLANKOB.F
.input 'xtbsta'
.output terminal ...  ?   geraet  = ""
..
!DRUCK3: Lieferanten (mit EXCEL)
.continue DRUCK4 ? _xtstat/"*3*"
.up
.down
.output 'geraet'
.print 'xiukd'
.input BLANKOB.F
.input 'xtbstk'
..
!DRUCK4:
.continue DRUCK5 ? _xtstat/"*4*"
.up
.down
.output 'geraet'
.print 'xiumd'
.input BLANKOB.F
.input 'xtalum'
.output terminal ...  ?   geraet  = ""
..
!DRUCK5:
.continue START
..
!BEENDEN
.end .
