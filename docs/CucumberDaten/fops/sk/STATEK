?                                                                  ?  xtstat / "*4*"
.menu AuswÑhlen
Umsatzstatistik Lieferanten/Artikel              >>  .formula xtstat = xtstat + "2"
Lieferanten, nach Umsatz sortiert                >>  .formula xtstat = xtstat + "3"
Artikel-/Lieferanten-Umsatz                      >>  .formula xtstat = xtstat + "4"
Verarbeitung starten                             >>  .continue VA0
Wechsel des Ausgabemediums: 'xtger             ' >>  .continue G1
