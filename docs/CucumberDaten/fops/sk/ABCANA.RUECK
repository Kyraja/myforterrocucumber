..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ABCANA.RUECK
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      :
.. Functionality  : individuelles FOP zum Zurckschreiben der ABC-Kenner in den 
..                  Artikelstamm 
..*****************************************************************************
.set trans -
.type text xtpa xtpb xtpc
.type integer xletzt ? _F|defined(U|xletzt)
..
.. Klassen schreibschtzen
.. K”nnen zuvor ber ein Kurztext im Firmenstamm mit Suchwort XABC definiert werden
.select company "XABC"
.continue KLASSEN          ?  _G|mehr
..
.formula U|xtpa=H|namebspr >> "A=" << ","
.continue FEHLER           ? U|xtpa = ""
.formula U|xtpb=H|namebspr >> "B=" << ","
.continue FEHLER           ? U|xtpb = ""
.formula U|xtpc=H|namebspr >> "C=" << ","
.continue FEHLER           ? U|xtpc = ""
..
.formula M|rpa = U|xtpa
.formula M|rpb = U|xtpb
.formula M|rpc = U|xtpc
.formula M|srpa = M|rpa
.formula M|srpb = M|srpa + M|rpb
.formula M|srpc = M|srpb + M|rpc
..
!KLASSEN
.protection rpa
.protection rpb
.protection rpc
..
.. Datum vorbelegen / default date
.. immer komplettes letztes Jahr
.formula U|xletzt = ('G|datum:8' << 4)
.formula U|xletzt = U|xletzt - 1
.formula M|anfdat = 'U|xletzt' + "0101"
.assign M|enddat = 'U|xletzt' + "1231"
.. Schreibschutz
.protection anfdat
.protection enddat
..
.. Preise vorbelegen / default prices
.assign M|preisea = "(5)"
.assign M|preiseb = "(5)"
.protection preisea
.protection preiseb
..
.. interne Lagergruppe vorbelegungen / dfeault internal warehouse group
.copy M|elgruppe = G|TRUE
.assign M|klgruppe = F|sysinfo(10)^intlgruppe
.protection klgruppe
..
.. Alle Artikel / default: all parts
.copy M|kauf = G|TRUE
.copy M|eigen = G|TRUE
.copy M|bpreis = G|FALSE
.protection kauf
.protection eigen
.protection bpreis
..
.continue END
..
..*****************************************************************************
!END
.continue
..
.set trans +
!FEHLER
.error Prozents„tze fehlen in Standardeinstellung "XABC"!
