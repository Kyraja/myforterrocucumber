..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : QUEUE.SE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
.type text xtsel  ? _F|defined(U|xtsel)
..
.continue ZEIGEN ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "nachbewaktuell"
.continue ZEIGEN ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "burevalue"
..
.copy M|trefferausgeben = G|FALSE
..
.copy M|bws = G|TRUE
.assign P|maskkontextfop = "bws"
..
.copy M|bwserlaub = G|TRUE
.copy M|bwszeigen = G|TRUE
..
.continue ERLFEHLER   ? _F|cmdpermitted(120, 13, ,1)
.continue ZEIGEN
..
!ERLFEHLER: WS „ndern nicht erlaubt
.copy M|bwserlaub = G|FALSE
..
!ZEIGEN
.continue ERL2FEHLER  ? _F|cmdpermitted(120, 12, ,1)
.formula U|xtsel =  "$,,;nummer=1;@gruppe=1;@ablageart=(Active)"
.formula M|grliste = "120:1"
.load 2 group 'M|grliste' 'U|xtsel'
..
.continue ERROR  ? _G|mehr
..
.assign M|ws = 2|id
.load 2 line 
.continue END    ? _G|mehr
.assign M|wsstartdat   = 2|wsstartdat
.assign M|wsenddat     = 2|wsenddat
.formula M|laufzeit    = 2|laufzeit
.formula M|bearbanzahl = 2|bearbanzahl
.formula M|wsstatus    = 2|wsstatus
.formula M|gtreffer    = ""
.continue END
..
!ERL2FEHLER: WS zeigen nicht erlaubt
.copy M|bwszeigen = G|FALSE
.protection bstart
.error Infosystem ist nur mit der Erlaubnis, Warteschlangen zu zeigen, startbar.
.end 1
..
..*****************************************************************************
!END
.continue
..
!ERROR
.error Keine Warteschlange 1 gefunden!
.end 1
