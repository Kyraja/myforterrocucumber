..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INTRASTATNACHRICHT.FA
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.. Kopffeld
.continue EDI      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kvorgang"
..
.. schreibbare Tabellenfelder
.continue IREGION  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "iregion"
.continue PVSTAAT  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "pvstaat"
.continue PGART    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "pgart"
.continue PVZWEIG  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "pvzweig"
.continue PAHNUM   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "pahnum"
.continue PURLAND  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "purland"
.continue INTRAMGE ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "intramge"
.continue GEWICHT  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "gewicht"
.continue NWERT    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "nwert"
.continue SWERT    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "swert"
.continue MELD     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "intra"
.continue
..
!MELD
.input "is/TABLEEREN"
.formula M|kvorgang = ""    ? M|intra <> 0
.protection buttonedi       ? M|intra <> 0
.protection buttonloesch    ? M|intra <> 0
.protection -reset kvorgang ? M|intra = 0
.formula M|versustid = M|edinachricht^kdzeich     ?  F|empty(M|versustid)
.colour -background 'M|fehlfarbe' versustid       ?  F|empty(M|versustid) & M|kvorgang^dnr = 3
.colour -background 'M|farbe' versustid           ? _F|empty(M|versustid) & M|kvorgang^dnr = 3
.continue END
..
!EDI
.input "is/TABLEEREN"
.formula M|edinachricht = ""
.formula M|land         = ""
.formula M|versustid    = ""
.protection -reset buttonedi    ? M|intra = 0
.protection -reset buttonloesch ? M|intra = 0
.continue END   ? F|empty(M|kvorgang)
.continue END   ? M|kvorgang^dnr <> 3
.formula M|versustid = M|kvorgang^versustid
.formula M|versustid = M|kvorgang^warenempf^ustid   ? F|empty(M|versustid)
.formula M|versustid = M|kvorgang^warenempf^firma^ustid ? F|empty(M|versustid) & M|kvorgang^warenempf^gruppe = 2
.colour -background 'M|fehlfarbe' versustid ?  F|empty(M|versustid) & M|kvorgang^dnr = 3
.colour -background 'M|farbe' versustid     ? _F|empty(M|versustid) & M|kvorgang^dnr = 3
.continue END
..
!IREGION
.formula M|iregschl = M|iregion^ischl
.colour -background 'M|farbe' iregschl 'M|aktzeile'     ? _F|empty(M|iregschl)
.colour -background 'M|fehlfarbe' iregschl 'M|aktzeile' ?  F|empty(M|iregschl)
.continue END
..
!PVSTAAT
.formula M|pvschl = ("   " + M|pvstaat^iso2) >> 3
.colour -background 'M|farbe' pvschl 'M|aktzeile'     ? _F|empty(M|pvschl)
.colour -background 'M|fehlfarbe' pvschl 'M|aktzeile' ?  F|empty(M|pvschl)
.continue END
..
!PVZWEIG
.formula M|schlvzweig  = (M|pvzweig^schl + " ") << 1
.colour -background 'M|farbe' schlvzweig 'M|aktzeile'     ? _F|empty(M|schlvzweig)
.colour -background 'M|fehlfarbe' schlvzweig 'M|aktzeile' ?  F|empty(M|schlvzweig)
.continue END
..
!PGART
.formula M|schl = (M|pgart^schl + "  ") << 2
.colour -background 'M|farbe' schl 'M|aktzeile'     ? _F|empty(M|schl)
.colour -background 'M|fehlfarbe' schl 'M|aktzeile' ?  F|empty(M|schl)
.continue END
..
!PAHNUM
.formula M|nrpahnum = M|pahnum^ahnum
.. pahnumname max 80 Stellen
.formula M|pahnumname = M|pahnum^namebspr << 80
.colour -background 'M|farbe' nrpahnum 'M|aktzeile'     ? _F|empty(M|nrpahnum)
.colour -background 'M|fehlfarbe' nrpahnum 'M|aktzeile' ?  F|empty(M|nrpahnum)
.continue END
..
!PURLAND
.. Iso2-Code Ursprungsland
.formula M|purschl     = ("   " + M|purland^iso2) >> 3
.colour -background 'M|farbe' purland 'M|aktzeile'     ? _F|empty(M|purland) & M|kvorgang^dnr = 3
.colour -background 'M|fehlfarbe' purland 'M|aktzeile' ?  F|empty(M|purland) & M|kvorgang^dnr = 3
.colour -background 'M|farbe' purschl 'M|aktzeile'     ? _F|empty(M|purschl)
.colour -background 'M|fehlfarbe' purschl 'M|aktzeile' ?  F|empty(M|purschl)
.continue END
..
!INTRAMGE: éndert man Åber intramge das Vorzeichen, so wird auch die Zuordnung
.. ikenn fÅr Eingang/Versendung geÑndert
.protection -reset ikenn 'M|aktzeile'
.formula M|ikenn     = 11 ? M|rintramge < 0  & M|kvorgang^dnr = 3
.formula M|ikenn     = 22 ? M|rintramge >= 0 & M|kvorgang^dnr = 3
.formula M|ikenn     = 11 ? M|rintramge >= 0 & M|kvorgang^dnr = 4
.formula M|ikenn     = 22 ? M|rintramge < 0  & M|kvorgang^dnr = 4
.protection ikenn 'M|aktzeile'
.colour -background 'M|farbe' intramge 'M|aktzeile'
.colour -background 'M|farbe' gewicht 'M|aktzeile' ? G|evtvar = "intramge"
.formula M|rintramge = M|intramge
.formula M|rintramge = M|rintramge * -1    ?  M|rintramge < 0
.formula M|intramge = 'F|round(M|rintramge)'
.copy M|bnull = G|TRUE 
.copy M|bnull = G|FALSE  ?  M|rintramge = 0 & M|rgewicht = 0 & M|artex^gruppe = 1
.colour -background 'M|fehlfarbe' intramge 'M|aktzeile' ?  M|rintramge = 0 & M|rgewicht = 0 & M|artex^gruppe = 1
.continue END  ? G|evtvar = "gewicht"
.continue GEWICHT
..
!GEWICHT
.type integer xznr ? _F|defined(U|xznr)
.formula U|xznr = 'M|aktzeile' 
.colour -background 'M|farbe' gewicht 'U|xznr'
.formula M|rgewicht = M|gewicht
.formula M|rgewicht = M|rgewicht * -1    ? M|rgewicht < 0
.formula M|gewicht = 'F|round(M|rgewicht)'
.copy M|bnull = G|TRUE 
.copy M|bnull = G|FALSE  ?  M|rintramge = 0 & M|rgewicht = 0 & M|artex^gruppe = 1
.colour -background 'M|fehlfarbe' gewicht 'M|aktzeile'  ?  M|rintramge = 0 & M|rgewicht = 0 & M|artex^gruppe = 1
.continue END ? G|evtvar = "intramge"
.continue INTRAMGE   
..
!NWERT
.formula M|rnwert = M|nwert
.formula M|rnwert = M|rnwert * -1    ? M|rnwert < 0
.formula M|nwert  = 'F|round(M|rnwert)
.colour -background 'M|farbe' nwert 'M|aktzeile'     ? _F|empty(M|nwert)
.colour -background 'M|fehlfarbe' nwert 'M|aktzeile' ?  F|empty(M|nwert)
.continue END
..
!SWERT
.formula M|rswert = M|swert
.formula M|rswert = M|rswert * -1    ? M|rswert < 0
.formula M|swert  = 'F|round(M|rswert)
.formula M|swert       = "1" ? M|swert = "0"
.colour -background 'M|farbe' swert 'M|aktzeile'     ? _F|empty(M|swert)
.colour -background 'M|fehlfarbe' swert 'M|aktzeile' ?  F|empty(M|swert)
.continue END
..
..*****************************************************************************
!END
.continue
