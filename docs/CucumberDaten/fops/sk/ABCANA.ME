..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABCANA.ME
.. Datum          : 14.03.2007
.. Version        : 2007r1
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
..
.. Ablauf         : Kopfteil fllen / fill header
..
.. Functionality  :
..
.. Program flow   :
...Includes       :
..*****************************************************************************
.type text xtpa xtpb xtpc
..
.set trans -
.. set icons
.formula M|iproduct    = "icon:product"
.formula M|ioperation  = "icon:operation"
.formula M|icongeschr  = "icon:save"
.formula M|icongesp    = "icon:stop"
..
.input "is/ABASFARBEN.DEF"
.formula M|colour = U|xabasmidred    
..
.. Rckschreibeflag
.copy M|rueckschreiben = G|FALSE
..
.formula M|anfdat = F|fystartdate(F|getfy(G|datum)) 
.assign M|enddat = 'G|datum'
..
.. alle Artikel werden betrachtet
.copy M|kauf     = G|TRUE
.copy M|eigen    = G|TRUE
..
.copy M|bpreis   = G|FALSE
.copy M|elgruppe = G|TRUE
.copy M|aauswert = G|TRUE
..
.. Prices default
.assign M|preisea = "(ValuationPrice)"
.assign M|preiseb = "(ValuationPrice)"
..
.. Vorbelegungen: internen Lagergruppe / default: internal warehouse group
.assign M|klgruppe = F|sysinfo(10)^intlgruppe
..
.. Ausgabew„hrung / Output currency
.copy M|auswaehr = G|inland
..
.. Kurztext XABC aus Firmenstamm auslesen
.formula U|xtpa = ""
.formula U|xtpb = ""
.formula U|xtpc = ""
..
.formula M|rpa = 0.0
.formula M|rpb = 0.0
.formula M|rpc = 0.0
..
.select company "XABC"
.continue VOR              ?  _G|mehr
..
.formula U|xtpa=H|namebspr >> "A=" << ","
.continue FEHLER           ? U|xtpa = ""
.formula U|xtpb=H|namebspr >> "B=" << ","
.continue FEHLER           ? U|xtpb = ""
.formula U|xtpc=H|namebspr >> "C=" << ","
.continue FEHLER           ? U|xtpc = ""
..
.formula M|rpa = U|xtpa
.formula M|rpb = U|xtpb
.formula M|rpc = U|xtpc
.formula M|srpa = M|rpa
.formula M|srpb = M|srpa + M|rpb
.formula M|srpc = M|srpb + M|rpc
.continue END
..
!VOR: Klassifizierung vorbelegen
.. Klasse A: hohe Bedeutung
.formula M|rpa=75
.. Klasse B: normale / durchschnittliche Bedeutung
.formula M|rpb=20
.. Klasse C: geringe Bedeutung
.formula M|rpc=5
.formula M|srpa = M|rpa
.formula M|srpb = M|srpa + M|rpb
.formula M|srpc = M|srpb + M|rpc
.continue END
..
.. ***************************************************************************
!END
.continue 
..
!FEHLER
.error Prozents„tze fehlen in Standardeinstellung "XABC"!
.end 1
