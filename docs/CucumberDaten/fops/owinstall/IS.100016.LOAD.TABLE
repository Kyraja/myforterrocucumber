..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : IS.100016.LOAD.TABLE
.. Date           : 15.12.16
.. Version        : 2017r2n02
.. Author         : JPE
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
..
..*****************************************************************************
.type int xiayear
.type GD xadate
.type int xi
.formula U|xiayear = 'F|year(G|datum)'
.formula U|xiayear = U|xiayear -1
.formula U|xadate = 'U|xiayear'+"0101"
.continue ERROR ? F|empty(M|qenddate)
.continue START ? M|qenddate:8 >= 'U|xadate:8'
.box
Das Endedatum muss gr”áer als 'U|xadate' sein.
.end 10
.......
.set trans -
!START
.type text xtsel xt1colour xt2colour
.type bool xbfirst xbact xbmontag xbaps
.type week xwe
.type int xi
.type gd xddate xdmon xdfrei xdend
.formula U|xdend = M|qenddate -1
.formula U|xtsel = "$,,nummer=;yb5="+'G|false'+";@gruppe=1;ywoche=!"+'U|xdend:8'
...red
.formula U|xt1colour = "255 0 0"
...green
.formula U|xt2colour = "0 255 0"
!SELECT
.formula U|xbact = G|FALSE
.load 0 file40  'U|xtsel'    ? _U|xbfirst
.load 0 file40               ?  U|xbfirst
.continue END                ? _G|mehr
.formula U|xbfirst = G|true
.continue SELECT ? 0|such ="AKT-DATEN" & _M|qakt
.continue SELECT ? 0|such ="APS"       & _M|aps
.continue SELECT ? 0|such ="PM"        & _M|pm
!SELLINE
.load 0 file40 line
.continue SELECT  ? _G|mehr
.continue SELLINE ? 0|yprogrammgelaufen
.continue SELLINe ? 0|ytflagdatum >= M|qenddate
.make screen line +O
.formula M|qnum = 0|nummer
.formula M|qzid = 0|zid
.formula M|qmontag= 0|ytflagdatum
.formula M|qfreitag= 0|yfreitag
.formula M|qorder= 0|yauftrag
.formula M|qname=0|yprogrammname
.formula M|qsuch= 0|such+"/"+'M|qname'
.formula M|qstatus = "To Do"
...CONTINUE ENDFLAG  ? 0|yprogrammgruppe^such /"APS*" ; 0|yprogrammgruppe^such = "PM"
.CONTINUE AKTDATA  ? 0|yprogrammgruppe^such /"AKT*" ; 0|yprogrammgruppe^such /"APS*" ; 0|yprogrammgruppe^such = "PM"
.. Alle Programme auáer APS und Projektmanagement laufen mit Flagdatum
.formula M|qflagdate = '0|ytflagdatum:8' + " 02:17"
.formula M|qday = M|qflagdate//1
.formula M|q459flag = M|qflagdate
.CONTINUE ENDFLAG
..
!AKTDATA
.. Aktuelle Daten laufen mit dem Pr„sentationsdatum
.formula M|qflagdate = 'M|qenddate:8' + " 02:17"
.formula M|qday = M|qflagdate//1
.formula M|q459flag = M|qflagdate
!ENDFLAG
.colour -background 'U|xt1colour' qstatus 'aktzeile'
.continue SELLINE   
!END
.continue
!ERROR
.box
enter Final Date
.end 10
