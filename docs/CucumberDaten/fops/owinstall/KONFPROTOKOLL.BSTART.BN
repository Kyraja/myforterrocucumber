..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           : owfo/KONFPROTOKOLL.BSTART.BN
.. Datum/Date     : 08.02.13
.. Version        : 2012r4n01p02
.. Autor/Author   : andre
.. Copyright      : (c) 2013
.. Funktion       :
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    -------------------------------------------------------------------------
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.mach maske zeile --
.trenner %
.art text xdimport xzeile
.art text xdimport xvkid xkunde xartikel xartnum xartname xpruefung xgewaehlt xbedingung xtmp xf1 xf2
.fo xf1 = "254 228 216"
.fo xf2 = "225 240 208"
.fo xdimport = "tmp/X.PROTXML.IMPORT"
..20130906-cs
.system 'f|expr("test -s " + xdimport)' hinter
.weiter FEHLER ? _mehr
..edi 'xdimport'
..cs-ENDE
!START:
!ZEILE:
.hol von 'xdimport' xzeile^
.weiter ENDE ? _ mehr
.weiter KOPF ? xzeile / "KOPF*"
.weiter MZEILE ? xzeile / "PRUEFUNG*"
.weiter PFAD   ? xzeile / "FALSE*"
.weiter PFAD   ? xzeile / "TRUE*"
.weiter SCHREIBEN


!KOPF:
.fo xvkid = xzeile >> "#" << "#"
.fo xkunde = xzeile >> "#" >> "#" << "#"
.fo xartikel = xzeile >> "#" >> "#" >> "#" 
.fo m|kunde = xkunde ? xkunde <> ""
.fo m|vorgang = xvkid
.fo m|artikel = xartikel
.fo m|artname = m|artikel^name
.fo m|datum   = "."
.weiter ZEILE

!MZEILE:
.mach maske zeile +O
.fo xartnum = xzeile >> "#" << "#"
.fo xartname = xzeile >> "#" >> "#" << "#"
.fo xpruefung = xzeile >> "#" >> "#" >> "#" 
.fo m|telem = xartnum
.fo m|tartname = xartname
.fo m|tpruefung = xpruefung
.weiter ZEILE

!SCHREIBEN:
.fo xtmp       = xzeile >> "#" >> "#"
.fo xbedingung = xzeile >> "#" << "#"
.fo xgewaehlt  = xbedingung >>- " " >>- "  " 
.fo xbedingung = xbedingung << 'xgewaehlt' + 'xtmp'
.fo m|gewaehlt = xgewaehlt
.fo m|tbedingung = xbedingung
.fo m|tpruefung  = xpruefung
.weiter LOEZEILE  ? m|tbedingung = ""
.weiter ZEILE

!PFAD:
.fo m|tpfad = xzeile >> "#" >> "#" << "#"
.fo m|tergebnis = true ? xzeile /"*TRUE*"
.fo m|tstufe    = 1
.fo m|tstufe    = 2  ? m|tpfad / "*;*" 
.fo m|tstufe    = 3  ? m|tpfad / "*;*;*" 
.fo m|tstufe    = 4  ? m|tpfad / "*;*;*;*" 
.FARBE -HINTERGRUND 'xf1' 'aktzeile'  ? m|tergebnis = false
.FARBE -HINTERGRUND 'xf2' 'aktzeile'  ? m|tergebnis = true
.weiter ZEILE

!LOEZEILE:
.mach maske zeile- O
.weiter ZEILE

!ENDE:
.ende

!FEHLER:
.box
Protokolldatei nicht vorhanden
.weiter ENDE

