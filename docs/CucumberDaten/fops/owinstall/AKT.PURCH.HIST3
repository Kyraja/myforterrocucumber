..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.PURCH.HIST3
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
.. creates Purchasing chain History
.. delivery note from purchase order
..
..
..
..
.. 
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat ? _F|defined(xtdat)
.type text xterrdat ? _F|defined(xterrdat)
.type text xtcom ? _F|defined(xtcom)
.type text xtsel xtnum xt2num
.type GD qenddate ? _F|defined(qenddate)
...fo U|qenddate= "."
.fo U|xtsel =  "$,,nummer=;such=="+"BDNS"+";betreff==Kommission EK-KETTE"
.select PURCHASING 'U|xtsel'
.continue ERR1 ? _G|mehr
.select line
.continue ERR2 ? _G|mehr
.fo U|xtnum = H|id
.select line
.continue ERR2 ? _G|mehr 
.fo U|xt2num = H|id
.select -
.formula U|xtdat = "tmp/XPUDELN."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
.. Create Delivery note
#!ACTION=new
#!DATABASE=4
#!GROUP=23
#!EDP_LANG=D
#!userowid=1
#!REPORT=ref num
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;\
zn;mge;
'U|xtnum';-5;K4711;1;\
1;30;

'U|xtnum';-5;K4711;1;\
1;20;

'U|xt2num';-5;K4711;1;\
1;15;

'U|xt2num';-5;K4711;1;\
1;25;
.output
.input "owinstall/EDP.EXECUTE"
.continue
..
..
.. ERRORHANDLING
!ERR1
.error Fehler beim Erzeugen der EK-KETTE: Bestellung nicht gefunden!
.end 1
..
!ERR2
.error Fehler beim Erzeugen der EK-KETTE: Bestellung hat keine Zeile!
.end 1




