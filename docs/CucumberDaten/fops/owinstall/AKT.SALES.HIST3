..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.SALES.HIST3
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. create Order from Quotation  
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat xtcom xterrdat xtsel xtnum
.type GD qenddate
.fo U|qenddate = "."
.formula U|xtsel = "$,,nummer=;typa==(Quotation);kunde==70010;"
.select sales 'U|xtsel'
.continue END  ? _G|mehr
.formula U|xtnum = H|id      
.select -
.formula U|xtdat = "tmp/X3ORDERCHAIN."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
#!DATABASE=3
#!GROUP=22
#!ACTION=NEW
.input "owinstall/HEAD.EDP"

beleg;vom;nummer;
'U|xtnum';-13;200000C;

#!ACTION=UPDATE
#!DATABASE=3
#!GROUP=30
#!EDP_UPDATEMODE=STRICT
#!LINESEPARATOR=#
#!FLDDELIMITER=;
.input "owinstall/HEAD.EDP"

nummer;wahrsch;tterm;
700001C;100; ;

.output
.input "owinstall/EDP.EXECUTE"
.continue
!END
.box
Keine Angebot angelegt
.continue





