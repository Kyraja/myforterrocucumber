..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/FV.RUECK
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtcom xterrdat
.type week xweek
.type int xi
.file -tempname U|xterrdat
.fo U|xtcom = "edpinfosys.sh -N ASRUECK -s " + G|apostroph + "woche="+'M|qfreitag:8'+",enddatum="+'M|qflagdate:8'+",alle=1,bstart=1,allerueck=1" + G|apostroph + " -f zn -p " + G|einmalpw + " 2>" + U|xterrdat
.system 'U|xtcom' background
.continue ERR ? _G|mehr
!AGAIN
.continue END ? U|xi = 9
.. Nochmal xtcom zusammenbauen, da sonst Einmalpasswort abl„uft bei zu langer laufzeit
.fo U|xtcom = "edpinfosys.sh -N ASRUECK -s " + G|apostroph + "woche="+'M|qfreitag:8'+",enddatum="+'M|qflagdate:8'+",alle=1,bstart=1,allerueck=1" + G|apostroph + " -f zn -p " + G|einmalpw + " 2>" + U|xterrdat
.system 'U|xtcom' background
.continue ERR ? _G|mehr
.formula U|xi = U|xi +1
.continue AGAIN
!END
.continue
..
..
!ERR
.. Fehlerbehandlung
.output TERMINAL
.input 'U|xterrdat'
.end 1
