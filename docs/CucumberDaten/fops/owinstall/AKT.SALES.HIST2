..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.SALES.HIST2
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. create Quotation from Chance 
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat xtcom xterrdat xtnum xt2num
.type GD qenddate
.fo U|qenddate = "."
.formula U|xtnum = "700000C"
.formula U|xt2num = "700001C"        
.formula U|xtdat = "tmp/XQUOTECHAIN."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
#!DATABASE=3
#!ACTION=RELEASE 
#!EDP_UPDATEMODE=STRICT
.input "owinstall/HEAD.EDP"

nummer;nummer;vom;gltvon;gltbis;audatum;wahrsch;
'U|xtnum';100000A;-14;-14;+28;+3;90;
'U|xt2num';100000B;-5;-5;+30;+3;70;

.output
.input "owinstall/EDP.EXECUTE"
.continue



