<Field name="anzahl" type="real">'anzahl'</Field>
?<Field name="lge" type="real">'lge'</Field>           ?  0|flme <> 0
?<Field name="breite" type="real">'breite'</Field>     ?  0|fbme <> 0
?<Field name="yabdruck" type="boolean">'h|yabdruck'</Field>   ? defined(h|yabdruck)
<Field name="ptext" type="text">'ptext'
