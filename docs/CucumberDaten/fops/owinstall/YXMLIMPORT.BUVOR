'xtrow'<Row number="'xposnum.xebene'" id="" operation="+">
<Field name="postype" type="text">A</Field>
<Field name="vpos" type="text">'vpos'</Field>
<Field name="elex" type="text">'elem'</Field>
<Field name="anzahl" type="real">'anzahl'</Field>
<Field name="lge" type="real">'lge'</Field>
