.continue
.type text xtsel ? _defined(xtsel)
.type text xtdat ? _defined(xtdat)
.type text xterrdat ? _defined(xterrdat)
.type text xt0load ? _defined(xt0load)
.type text xt1load ? _defined(xt1load)
.type text xtnum xtkun xtart
.type bool xbfirst ? _defined(xbfirst)
.type bool xb2first ? _defined(xb2first)
.type MP9.3 xrfort
.formula T|xtdat = "tmp/XEDIORDER."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'T|xtdat'
.input DATEI.F
........................
......Select Blanket 0der  with load 0
.formula U|xt0load = "$,,1:art=;1:kopf^such=;1:kopf=;@gruppe=20;@ablageart=(Active);@zeilen=(Yes);@ordnung=nummer;"
!BLORDER
.formula U|xb2first  = G|FALSE
.load 0 sales 'U|xt0load'    ? _U|xbfirst
.load 0 sales                ?  U|xbfirst
.continue END                ? _G|mehr
.formula U|xbfirst= G|TRUE
.load 0 line 
.formula U|xtnum = 0|id
.formula U|xtkun = 0|kunde^id
.formula U|xrfort = 0|fzahl  
......
..box
..'xtnum'
..'xtkun'
..'xrfort'
..continue BLORDER
.formula U|xt1load ="%,,0:num80=;0:y40kw=;0:y40woche=;0:y40importiert==(No);0:yedi==(Yes);0:y40bis=!20160318;0:y40kundenum=="+'0|kunde'+";1:y40tartikelnr=="+'0|art^id'+";@gruppe=0;@ablageart=(Active);@bereich=(Yes);@order=y40kw"
.load 1 file40 'T|xt1load' 
.input
!LOAD1
.input "owinstall/HEAD.EDP"
#!action=do
#!typedcmd=infosystem
#!dontchange=~
#!flddelimiter=#
such  #rahmen   #zekunde  #labruf  #labrufd  #uebdat  #einfzahl #kinzeilen#kartikel\
  zn#termint  #termcod                      #menge   #0:daterz
.load 1 file40 'T|xt1load'   ? _U|xb2first
.load 1 file40             ? U|xb2first
.formula U|xb2first  = G|TRUE
.continue BLORDER          ? _G|mehr
.load 1 line
'1|y40tmenge'
.continue LOAD1


