..!interpreter english translate
.type text xtdat xtcom
.formula U|xtdat = "tmp/XSER3."+'G|versionneu'
.output new 'U|xtdat'
.input DATEI.F

# Service chain - repair (Servicekette - Reparatur)
# Transaction Files
# Scenario:             Service chain "Repair" 
#							customer 			70024
#							product 			30026 (lot 50008, service product 10008)
#                           service technician 	TSCHILLING
# 							component			10111 (lot 50016)
#						Service request is dated by "."
#						Incoming packing slip for repair order is dated by "." (based on todays date)
#
# requested by:  rean  (30.10.14)
# created by  :  doda  (12.01.14)   - added this new scenario
#
# Description:          EDP-Script is executing different objects within a service chain.
#                       It will add: Lot number, Service Product, Service Request, Repair order, Packing Slip
#
# --------------------------------------------------------------------------------------------------
# Create service request and a repair order for the service request 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"


nummer;nummer;serprod;bearbeit;ursache;dringl;prio;anfstatus;techniker;anfbesch\
zeile;tbearbeit;datum;uhrzvon;tanfbesch;>repaub;!;1:lgruppe;!;.:artex;.:mge;.:repverr;<
1004;1004;1379850;SCHILLING;REPARATUR;HOCH;MITTEL;freigegeben zur Faktura;TSCHILLING;Motor wird heiss und schaltet ab\
 2;SCHILLING;.;08:30;Reparaturauftrag erfasst;;1;LG-SR-KS;+;REP;1;Nach Aufwand zzgl. Ersatzteilkosten;
#
# --------------------------------------------------------------------------------------------------
# Create incoming packing slip for the repair order 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;such\
zeile;>repaub;>repzug;ueb;<;<
1004;1004;REPAIR\
 2;;;1;;
....
.output
.formula U|xtcom = "edpimport.sh -p abas123 -I "+'U|xtdat'
.system 'U|xtcom' background
.continue
