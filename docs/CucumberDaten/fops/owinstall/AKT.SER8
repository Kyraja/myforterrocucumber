..!interpreter english translate
.type text xtdat xtcom
.formula U|xtdat = "tmp/XSER8."+'G|versionneu'
.output new 'U|xtdat'
.input DATEI.F
# Service chain (Servicekette)
# Transaction Files
# Scenario:             Service chain "cloud for mobile app" 
#							customer 			70011
#							product 			30024 (lot 50005, service product 10005)
#                           service technician 	TSCHMITZ
#
# requested by:  dr    (12.01.2015)
#
# Description:          EDP-Script is executing different objects within a service chain.
#                       It will add: Lot number, Service Product, Service Request, Service Order
# 
# Scenario:             Service chain with a service order containing various entries for a technician
#                       in order to show a certain usage. (German)
# 
# --------------------------------------------------------------------------------------------------
# Create service request along with service quotation and a release of this service quotation 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

