..!interpreter english translate
.type text xtdat xtcom
.formula U|xtdat = "tmp/XSER1."+'G|versionneu'
.output new 'U|xtdat'
.input DATEI.F

# Service chain - repair (Servicekette - Reparatur)
# Transaction Files
# Scenario:             Service chain "Repair" 
# 							customer 			70011
# 							product 			30024 (lot 50002, service product 10002)
#                            service technician 	TSCHMITZ
#  							component			10084 (lot 50012)
# 						Service request is dated by "-5"
# 						Incoming packing slip for repair order is dated by "." (based on todays date)
# 
# requested by:  dr    (05.07.2012)
# changed by  :  doda  (08.01.2015) - corrected references for customer, product and technician. removed contacts (based on rean)
# 
# Description:          EDP-Script is executing different objects within a service chain.
#                       It will add: Lot number, Service Product, Sales Invoice with stock movement, Service Request, Repair order, Packing Slip
# 
# --------------------------------------------------------------------------------------------------
# Create service request and a repair order for the service request 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;serprod;bearbeit;ursache;dringl;prio;anfstatus;techniker;anfbesch\
zeile;tbearbeit;datum;uhrzvon;tanfbesch;>repaub;!;1:lgruppe;!;.:artex;.:mge;.:repverr;<
1002;1002;1379837;SCHMITZ;REPARATUR;HOCH;MITTEL;freigegeben zur Faktura;TSCHMITZ;Motor wird heiss und schaltet ab\
 2;SCHMITZ;-5;08:30;Reparaturauftrag erfasst;;1;LG-SR-KS;+;REP;1;Nach Aufwand zzgl. Ersatzteilkosten;

#
# --------------------------------------------------------------------------------------------------
# Create incoming packing slip for the repair order 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;such\
zeile;tbearbeit;>repaub;>repzug;ueb;<;<
1002;1002;REPAIR\
 2;SCHMITZ;;;1;;
.output
.formula U|xtcom = "edpimport.sh -p abas123 -I "+'U|xtdat'
.system 'U|xtcom' background
.continue
