..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.PURCH.HIST2
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
.. creates Purchasing chain History
.. puchase order from request
..
..
..
..
.. 
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat ? _F|defined(xtdat)
.type text xterrdat ? _F|defined(xterrdat)
.type text xtcom ? _F|defined(xtcom)
.type text xtsel xtnum
.type GD qenddate ? _F|defined(qenddate)
...fo U|qenddate= "."
.fo U|xtsel =  "$,,nummer=;such=;ktyp==2;betreff==Kommission EK-KETTE"
.select PURCHASING 'U|xtsel'
.continue ERR1 ? _G|mehr
.fo U|xtnum = H|id
.select -
.formula U|xtdat = "tmp/XPURORDER."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
.. Create Purchase order
#!ACTION=new
#!DATABASE=4
#!GROUP=22
#!userowid=1
#!REPORT=ref num
.input "owinstall/HEAD.EDP"

vom;beleg;
-3;'U|xtnum';
.output
.input "owinstall/EDP.EXECUTE"
.continue
..
..
.. ERRORHANDLING
!ERR1
.error Fehler beim Erzeugen der EK-KETTE: Anfrage nicht gefunden!
.end 1





