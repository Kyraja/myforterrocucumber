..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.PURCH.HIST6
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
.. creates Purchasing chain History 2
.. delivery notes from purchase order
..
..
..
..
.. 
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat ? _F|defined(xtdat)
.type text xterrdat ? _F|defined(xterrdat)
.type text xtcom ? _F|defined(xtcom)
.type text xtsel xtnum xt2num xt3num xt4num
.type bool xbfirst
.type GD qenddate ? _F|defined(qenddate)
..fo U|qenddate= "."
.fo U|xtsel =  "$,,nummer=;such=="+"BDNS"+";betreff==Kommission EK-KETTE2"
!SEL
.select PURCHASING 'U|xtsel'   
.continue ERR1     ? _G|mehr
..
.select line
.continue ERR2     ? _G|mehr
.fo U|xtnum = H|id
.select line
.continue ERR2     ? _G|mehr
.fo U|xt2num  = H|id
..
.select PURCHASING
.continue ERR1     ? _G|mehr
.fo U|xt3num = H|id
!START
.select -
.formula U|xtdat = "tmp/XPUDELN2."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
.. Create delivery note 1
#!ACTION=new
#!DATABASE=4
#!GROUP=23
#!userowid=1
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;\
zn;offueb;
'U|xtnum';-5;Kette2;1;\
1;1;

.. Create delivery note 2
#!ACTION=new
#!DATABASE=4
#!GROUP=23
#!userowid=1
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;\
zn;offueb;

'U|xt2num';-5;Kette2;1;\
1;1;

.. Create delivery note 3
#!ACTION=new
#!DATABASE=4
#!GROUP=23
#!userowid=1
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;\
zn;offueb;

'U|xt3num';-5;Kette2;1;\
1;1;\
2;1;
.output
.input "owinstall/EDP.EXECUTE"
.continue
..
..
.. ERRORHANDLING
!ERR1
.error Fehler beim Erzeugen der EK-KETTE: Bestellung nicht gefunden!
.end 1
..
!ERR2
.error Fehler beim Erzeugen der EK-KETTE: Bestellung hat keine Zeile!
.end 1





