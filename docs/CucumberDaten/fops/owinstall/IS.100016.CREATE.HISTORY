..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : IS.1000016.CREATE.HISTORY
.. Date           : 15.12.16
.. Version        : 2017r2n02
.. Author         : JPE
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
.type text xtsel    ?_F|defined(xtsel)
.type text xt2colour xtid xtzn xtstart xtend xterror
.type text xtcom ? _F|defined(U|xtcom)
.type text xtday ? _F|defined(U|xtday)
.type text xtprevqid ? _F|defined(xtprevqid)
.formula U|xt2colour = "0 255 0"
..................
.formula xtprevqid = ""
!SELLINE
.select screen line
.continue END      ? _G|mehr
.. Datensatz auf komplett erledigt setzen
.formula H|yb5 = G|true    ? M|qnum^id <> U|xtprevqid & U|xtprevqid <> ""
.rewrite                   ? M|qnum^id <> U|xtprevqid & U|xtprevqid <> ""
..
.continue SELLINE  ?  M|qdone
.continue SELLINE  ?  M|qstatus = "DONE"
.....
.assign M|starttime = G|zeit
.formula U|xtday = M|qflagdate//1
.note -IMMEDIATELY Zeile 'M|aktzeile': 'M|qname' (Q-Date: 'M|qdate' / Flagdate: 'M|qflagdate'/ 'U|xtday')
.input 'M|qname'
.select lock object 'M|qnum^id'
.continue ERR1                  ? _G|mehr
.select object line 'M|qzid'
.continue ERR2                  ? _G|mehr
.. Zeile auf erledigt setzen
.formula H|yprogrammgelaufen = G|true
.formula M|konbis            = H|ytflagdatum ? _F|empty(H|ytflagdatum)
.. Kopf auf erledigt sezten wenn letzte Zeile erledigt wurde
.formula H|yb5               = G|true ? H|aktzeile = H|ozeilen
.rewrite
.. Atuelle Daten
.rewrite
.formula M|endtime = G|zeit
.formula M|qstatus = "DONE"
.colour -background 'U|xt2colour' qstatus 'M|aktzeile'
.. Letzte ID merken
.formula U|xtprevqid = M|qnum^id
.continue SELLINE
!END
..
.formula M|konbis = M|qenddate ? F|empty(M|konbis)
.input "owinstall/DISPO.END"
.input "owinstall/ERRORHANDLING"
.input "owinstall/SETDATE"
.input "owinstall/SETDATE.ETAGIS"
.input "owinstall/DATEMASSAGE"
!BOX
.box
Erfolgreich gelaufen
.cont
..
..
.. ERRORHANDLING
!ERR1
.error Datensatz Ladekonfig 'M|qnum^id' konnte nicht geladen werden.
.end 1
..
!ERR2
.error Zeile 'M|aktzeile' aus Infosystem im Datensatz Ladekonfig 'M|qnum^id' nicht gefunden.
.end 1
