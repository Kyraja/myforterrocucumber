..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/FV.FREI
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtcom xterrdat
.type week xweek
.file -tempname U|xterrdat
.formula U|xweek = M|qfreitag:8
....fo U|xtcom = "<(Infosystem)> FVFREIGEBEN <(Call)> ? woche="+'U|xweek'+"|enddatum="+'M|qfreitag:8'+" |bstart= |autofrei= |[invisible]=1"
.fo U|xtcom = "edpinfosys.sh -N FVFREIGEBEN -s " + G|apostroph + "woche="+'U|xweek'+",enddatum="+'M|qfreitag:8'+",bstart=1,autofrei=1" + G|apostroph + " -f zn -p " + G|einmalpw + " 2>" + U|xterrdat
.system 'U|xtcom' background
.continue ? G|mehr
..
.. Fehlerbehandlung
.output TERMINAL
.input 'U|xterrdat'
.end 1
