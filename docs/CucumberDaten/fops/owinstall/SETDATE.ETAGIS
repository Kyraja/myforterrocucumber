..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/SETDATE.ETAGIS
.. Date           :07.02.2017
.. Version        :
.. Author         :dh/abas
.. Functionality  : set date in aps/
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtd xt1 xtsys xt2
.continue ERR1 ? F|empty(M|konbis) 
.formula U|xtd = "tmp/XETAGIS"
.formula U|xtsys = "pwd > "+'xtd'
.system 'xtsys' background
.continue ERR1 ? _G|mehr
.select from 'U|xtd' xt1
.formula U|xt1 = U|xt1 +"/win/aps/gui/datum.ini"
.formula U|xt2 = "echo "+'M|qenddate:8'+" > "+ 'xt1'
.system 'U|xt2' background
.continue ERR1 ? _G|mehr
.continue
..
..
!ERR1
.error Neues Tagesdatum konnte nicht für Etagis gesetzt werden. Wenden Sie sich umgehend an den Support!
.end 1
