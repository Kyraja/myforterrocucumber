..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
..
.ein datei.f
.mache maske zeile --
.art bool xbverfÅgbar xp
..fo xp = true
..
!FV:
.hole fertigung vorschlag
.weiter PRöFUNG                    ? _ mehr
.weiter FV                         ? h|wtsterm > m|endedatum
.weiter AUSGABE

!PRöFUNG!
.hol maske kopf


!MZEILE:
.hol maske zeile
.weiter ENDE                       ? _ mehr
.weiter BESCHAFFUNGEN

!BESCHAFFUNGEN:
.hol dazu m|fv
?'art'                             ? xp
..
.hol dazu eres
!RESERVIERUNG:
.weiter ZEILE                      ? elart <> 1
?RES -'elart'-'elem^such' 'dispo'  ? xp
.weiter DISPOC                     ? dispoa = "mindestbestandsbezogen"
!MVERWENDUNG:
.merk
.merk verwendung
!HOLVERW:
.hol verwendung
?BVKENN -'bvkenn'-                 ? xp
.weiter EHOLVERW                   ? bvkenn = ""
.fo xbverfÅgbar = true             ? bvkenn = "L"
.fo xbverfÅgbar = false            ? bvkenn = "B"
?XBVERFöGBAR 'xbverfÅgbar'         ? xp
.weiter HOLVERW

!EHOLVERW:
.hol
.weiter ZEILE

!DISPOC
? DISPO C                          ? xp
.fo xbverfÅgbar = true
.weiter ZEILE


!ZEILE:
.hol zeile
.weiter EZEILE                     ? _ mehr
.weiter RESERVIERUNG

!EZEILE:
.fo m|komverfuegbar = xbverfÅgbar
.weiter MZEILE

!AUSGABE:
.mach maske zeile
.fo m|fv                = 'h|id'
.fo m|artikel           = 'm|fv^art^id'
.fo m|artname           = 'm|fv^art^name'
.fo m|mge               =  h|limge
.fo m|sdatum            =  h|wtsterm
.fo m|edatum            =  h|wtterm
.fo m|komverfuegbar     =  false
.weiter FV

!ENDE:
.ende

