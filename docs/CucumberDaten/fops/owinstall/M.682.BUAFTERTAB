.type bool xbuse
!SELLINE
.select screen line 
.continue END  ? _G|mehr
.continue SELLINE  ? _M|ytab
.formula U|xbuse = G|true   ? _M|yuse
.formula U|xbuse = G|false   ? M|yuse
.formula M|yuse = U|xbuse
.continue SELLINE
!END
.continue






