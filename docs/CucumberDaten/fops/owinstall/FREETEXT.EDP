..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/FREETEXT.EDP
.. Date           :20.1.2016
.. Version        :
.. Author         :dh/abas
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..create a HTML-Freetext in offer
..*****************************************************************************
.type text xtdat xtcom xterrdat xtsys xtfreetext
.formula U|xtfreetext = "owinstall/FREETEXT"
.formula U|xtdat = "tmp/FREETEXT." + 'G|versionneu' + ".EDP"
.formula U|xterrdat = U|xtdat + ".ERR"
.formula U|xtsys = "cp " + U|xtfreetext + " " + U|xtdat + " >" + U|xterrdat
.system 'U|xtsys' background
.input "owinstall/EDP.EXECUTE"
.continue
