..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/EDP.EXECUTE.OUT
.. Date           :10.02.2016
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :execute the EDP
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtdat     ? _F|defined(U|xtdat)
.type text U|xterrdat  ? _F|defined(U|xterrdat)
.type text U|xtcom     ? _F|defined(U|xtcom)
......
.formula U|xtcom = "edpimport.sh -p abas123 -I "+'U|xtdat' + " 2> " + 'U|xterrdat' +" -o SHOWTEXT=0 -o SHOWNOTES=0 1>"+'U|xtout'
.system 'T|xtcom' background
..
.. clean up when we don't have errors
.formula U|xtcom = "rm -f " + 'U|xtdat' + " " + 'U|xterrdat'            ?  (F|filesize(U|xterrdat) = 0)
.system 'U|xtcom' background                                            ?  (F|filesize(U|xterrdat) = 0)
.continue
