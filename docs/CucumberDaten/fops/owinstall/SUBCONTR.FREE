..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/SUBCONTR.FREE
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtcom ? _defined(xtcom)
.type text xtsel ? _defined(xtsel)
.type text xtdat ? _defined(xtdat)
.type text xterrdat ? _defined(xterrdat)
.type bool xbfirst ? _defined(xbfirst)
.type text xtlief
.type int xi   ? _defined(xb)
.formula U|xi = 0
.formula U|xtlief = "---"
.formula U|xbfirst = G|false
.formula U|xtdat = "tmp/XSUBCONTRACT."+'G|sekundenz'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
..
.output new 'U|xtdat'
.input DATEI.F
.formula U|xtsel = "$,,kopf==`;kotyp==`;lief=;wtsterm=!"+'M|qfreitag:8'+";sterm=;bsart==(Subcontracting);@gruppe=2;@ablageart=(Active);@ordnung=lief;"
!SELECT
..      .set debug + 
.select purchasing 'U|xtsel'     ? _U|xbfirst
.select purchasing             ?  U|xbfirst
.continue EXECUTE              ? _G|mehr
.formula U|xbfirst = G|true
.formula U|xi = 0  ? _U|xbfirst ; lief^id <> U|xtlief
.formula U|xi = U|xi +1
.continue LINE  ? _U|xbfirst ; H|lief^id = U|xtlief
#!action=new
#!database=4
#!group=22
#!EDP_SHOWNOTES=0
#!userowid=1
.input "owinstall/HEAD.EDP"
betreff;vom;\
zn;0:beleg;pnum
!NEW
R'H|id';'H|wtterm:8'\
!LINE
#;'H|id';'U|xi'\
.formula U|xtlief = 'H|lief^id'
.continue SELECT
!EXECUTE
.output
.input "owinstall/EDP.EXECUTE"
.continue

















