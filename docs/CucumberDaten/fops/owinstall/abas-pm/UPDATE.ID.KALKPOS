..!interpreter english translate noabbrev         
..*****************************************************************************
.. FOP-Name :		UPDATE.ID.KALKPOS
.. Date : 			18.02.2015
.. Author : 		ts
.. Responsible : 	ts
.. Supervisor : 		ts
.. Copyright : (c)  2015
.. Function : 
..*****************************************************************************
.set trans -
..
..!meta H|=P145:4
..
.type P145:3 xpkalkblatt  ? _F|defined(U|xpkalkblatt)
..      .type P145:2 xplvpos      ? _F|defined(U|xplvpos)
.type P145:4 xpkalkpos    ? _F|defined(U|xpkalkpos)
.type P145:5 xpleistlist  ? _F|defined(U|xpleistlist)
..
.select lock group "145:4" "$,,"
.continue   ? _G|mehr
!SELECT:
.assign U|xpkalkblatt = H|ykblattid
..      .assign U|xplvpos     = H|ylvposid
.assign U|xpkalkpos   = H|yoberposid
..
.formula H|ykblattid  = U|xpkalkblatt^id  ? _F|empty(U|xpkalkblatt)
..      .formula H|ylvposid   = U|xplvpos^id      ? _F|empty(U|xplvpos)
.formula H|yoberposid = U|xpkalkpos^id    ? _F|empty(U|xpkalkpos)
..
.select lock line
!SSL:
.continue REWRITE   ? _G|mehr
.assign U|xpleistlist = H|ytleistlistid
.formula H|ytleistlistid = U|xpleistlist^id   ? _F|empty(U|xpleistlist)
.select lock line
.continue SSL       ? G|mehr
..
!REWRITE:
.rewrite
..
.select lock continue
.continue SELECT    ? G|mehr
..
.continue
