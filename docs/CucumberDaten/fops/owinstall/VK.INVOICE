.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
...set trace +
.type text xtcom ? _defined(xtcom)
.type text xtsel ? _defined(xtsel)
.type text xtdat ? _defined(xtdat)
.type text xterrdat ? _defined(xterrdat)
.type bool xbfirst ? _defined(xbfirst)
.type text xtlief xthl
.formula U|xbfirst = G|FALSE
.type GD xddat
..................
.formula U|xtdat = "tmp/XVKINVOICE."+'G|sekundenz'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
.formula U|xtsel = "$,,id=;kopf^kunde=;kotyp==(SalesOrder);kopf=;art=;tterm=!"+'M|qflagdate:8'+";@gruppe=2;@bereich=ja;@ablageart=(Active);@ordnung=kopf^kunde;status=`;"
!SELECT
.select sales 'U|xtsel'     ? _U|xbfirst
.select sales              ?  U|xbfirst
.continue EXECUTE                ? _G|mehr
.fo U|xthl = H|kopf
.continue LINE  ?  U|xthl = U|xtlief & _F|empty(U|xtlief)
.continue OUT ? U|xbfirst = G|false
...continue LINE  ?  H|kopf = 'U|xtlief' 
!OUT
.formula U|xbfirst = G|true
#!action=INVOICE
#!database=3
#!EDP_SHOWNOTES=0
.input "owinstall/HEAD.EDP"
nummer;betreff;vom;budat;ueb;fakt;dfuesenden;\
id;mge;
!NEW
'H|kopf';B'H|kopf';'H|kovom:8';'M|qfreitag:8';1;1;0;\
'H|id';'H|mge';\
.formula U|xtlief = 'H|kopf'
.continue SELECT
!LINE
.formula U|xbfirst = G|true
'H|id';'H|mge';\
.formula U|xtlief = 'H|kopf'
.continue SELECT
..
!EXECUTE
.output
.input "owinstall/EDP.EXECUTE"
.continue
