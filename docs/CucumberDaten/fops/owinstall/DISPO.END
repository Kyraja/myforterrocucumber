..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/DISPO.END
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :starts dispo at the end of loading history
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
...input
.type text xtcom ? _defined(xtcom)
.type text xtdat
.type text xterrdat ? _defined(xterrdat)
..
.formula U|xtdat = "tmp/XDISPOEND."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
#!action=do
#!typedcmd=dispo
#!EDP_LANG=D
#!EDP_SHOWNOTES=0
#!EDP_TESTFLAG2=1
#!EDP_TESTFLAG459=1
#!EDP_DATE='M|qenddate:8'021700
..input "owinstall/HEAD.EDP"

param;
;
.output
..
.input "owinstall/EDP.EXECUTE"
.continue

