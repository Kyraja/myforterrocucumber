..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.PURCH.HIST4
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
.. creates Purchasing chain History
.. invoice from delivery note
..
..
..
..
.. 
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat ? _F|defined(xtdat)
.type text xterrdat ? _F|defined(xterrdat)
.type text xtcom ? _F|defined(xtcom)
.type text xtsel xtnum xtr1 xtr2 xtr3 xtr4
.type int xi
.type GD qenddate ? _F|defined(qenddate)
.type bool xbfirst  ? _F|defined(xbfirst)
.fo U|xbfirst = false
.fo U|xtsel =  "$,,nummer=;such=="+"LDNS"+";betreff==Kommission EK-KETTE"
!SEL
.select PURCHASING 'U|xtsel'  ? _U|xbfirst
.continue ERR1                ? _U|xbfirst & _G|mehr
.select PURCHASING            ? U|xbfirst
.continue START ? _G|mehr
.fo xbfirst = G|TRUE
.fo xi = xi+1
.fo U|xtr1 = H|id  ? U|xi = 1
.fo U|xtr2 = H|id  ? U|xi = 2
.fo U|xtr3 = H|id  ? U|xi = 3
.fo U|xtr4 = H|id  ? U|xi = 4
.continue SEL
!START
.formula U|xtdat = "tmp/XPUINV."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
#!ACTION=new
#!DATABASE=4
#!GROUP=24
#!userowid=1
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;
'U|xtr1';.;K4711;0;
'U|xtr2';.;K4711;1;
#!ACTION=new
#!DATABASE=4
#!GROUP=24
#!userowid=1
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;
'U|xtr3';.;K4711;1;
#!ACTION=new
#!DATABASE=4
#!GROUP=24
#!userowid=1
.input "owinstall/HEAD.EDP"

beleg;vom;ebeleg;ueb;
'U|xtr4';.;K4711;1;
.output
.input "owinstall/EDP.EXECUTE"
.continue
..
..
.. ERRORHANDLING
!ERR1
.error Fehler beim Erzeugen der EK-KETTE: Lieferscheine nicht gefunden!
.end 1


