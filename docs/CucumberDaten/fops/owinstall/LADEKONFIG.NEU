..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/LADEKONFIG.NEU
.. Date           :23.11.2016
.. Version        :
.. Author         :dh/abas
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat xtfile xtid xtyear xterrdat xttag xttext xtmaxw xtsel xtype
.type int xiyear ximonth xiweek xinum  xi
.type week xwsweek xmaxw
.type GD xdstart xdend xdorder
.type bool xbfirst xb
..test for cmdline in wineks.ini
.fo U|xtdat = "grep cmdline=-datum win/wineks.ini"
.sys 'U|xtdat' background
.continue ERROR  ? G|mehr
..FÅr Startdatum 2017
.formula U|xiyear =2017
....F|year(G|datum)
.formula U|xiyear = U|xiyear - 2
.formula U|xwsweek = 'U|xiyear'+"1101"
....EDP-File
.formula U|xtdat="tmp/KONFIG.KOPF"+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
..Setupweek
.formula U|xdstart = U|xwsweek
.formula U|xdstart = U|xdstart -2
.formula U|xdend = "31.12."+'U|xiyear'
.formula U|xmaxw ='U|xdend'
.formula U|xtmaxw = 'U|xmaxw' << 2  ? _P|jkw
.formula U|xtmaxw = 'U|xmaxw' >> 2  ? P|jkw
...'xtmaxw'
.formula U|xdend  = F|subworkdays("", "", xdend , 0)
.formula U|xdorder = U|xdend +51
.formula U|xtyear = 'U|xiyear' >> 2
.formula U|xinum  = 200
#!ACTION=STORE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
# Bediensprache des aktuellen Benutzers, da die Woche nur in Bediensprache eingegeben 
# werden kann und dieses FOP in dieser Bediensprache lÑuft
#!EDP_LANG='P|spr'

nummer;nummer;such;name;yjahr;ymontag;yfreitag;yauftrag;\
zeilenop;yprogrammgruppe;yprogrammname;ytflagdatum;ywochentag;
'U|xinum';'U|xinum';SETUP;Setup;'U|xtyear';'U|xdstart:8';'U|xdend:8';'U|xdorder:8';\
-*;;;;;\
.load 0 file40 "$,,such=SETUP!SETUP;@gruppe=4;
.formula U|xbfirst = G|false
!LINE0
.load 0 line 
.continue SETUP  ? _G|mehr
.fo U|xttag = U|xdstart//1 ? 0|yprmontag
.fo U|xttag = U|xdend//1   ? 0|yprfreitag
?+;'0|id';'0|yprogramm';'U|xdstart:8';'U|xttag';\ ? _U|xbfirst
?+;;'0|yprogramm';'U|xdstart:8';'U|xttag';\ ? U|xbfirst
.formula U|xbfirst = G|true
.continue LINE0
!SETUP
.load 0 file40 "$,,such=MAWI-SETUP!MAWI-SETUP;@gruppe=4;
.formula U|xbfirst = G|false
!LINE1
.load 0 line 
.continue SETUP2  ? _G|mehr
.fo U|xttag = U|xdstart//1 ? 0|yprmontag
.fo U|xttag = U|xdend//1   ? 0|yprfreitag
?+;'0|id';'0|yprogramm';'U|xdstart:8';'U|xttag';\     ? 0|yprmontag & _U|xbfirst
?+;'0|id';'0|yprogramm';'U|xdend:8';'U|xttag';\       ? 0|yprfreitag & _U|xbfirst
?+; ;'0|yprogramm';'U|xdstart:8';'U|xttag';\     ? 0|yprmontag &  U|xbfirst
?+; ;'0|yprogramm';'U|xdend:8';'U|xttag';\       ? 0|yprfreitag & U|xbfirst
.formula U|xbfirst = G|true
.continue LINE1
!SETUP2
.load 0 file40 "$,,such=FIBU-SETUP!FIBU-SETUP;@gruppe=4;
.formula U|xbfirst = G|false
!LINE2
.load 0 line 
.continue YEAR1  ? _G|mehr
.fo U|xttag = U|xdstart//1 ? 0|yprmontag
.fo U|xttag = U|xdend//1   ? 0|yprfreitag
?+;'0|id';'0|yprogramm';'U|xdstart:8';'U|xttag';\     ? 0|yprmontag & _U|xbfirst
?+;'0|id';'0|yprogramm';'U|xdend:8';'U|xttag';\       ? 0|yprfreitag & _U|xbfirst
?+;;'0|yprogramm';'U|xdstart:8';'U|xttag';\     ? 0|yprmontag & U|xbfirst
?+;;'0|yprogramm';'U|xdend:8';'U|xttag';\       ? 0|yprfreitag & U|xbfirst & _(0|aktzeile = 0|ozeilen)
?+;;'0|yprogramm';'U|xdend:8';'U|xttag';       ? 0|yprfreitag & U|xbfirst & 0|aktzeile = 0|ozeilen
.formula U|xbfirst = G|true
.continue LINE2
!YEAR1
.formula U|xiyear = U|xiyear +1
.formula U|xtyear = 'U|xiyear' >> 2
.formula U|xiweek = 0
.formula U|xmaxw = 'U|xiyear'+"1231"
.formula U|xtmaxw = 'U|xmaxw' << 2  ? _P|jkw
.formula U|xtmaxw = 'U|xmaxw' >> 2  ? P|jkw
...
#!ACTION=STORE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
# Bediensprache des aktuellen Benutzers, da die Woche nur in Bediensprache eingegeben 
# werden kann und dieses FOP in dieser Bediensprache lÑuft
#!EDP_LANG='P|spr'

nummer;nummer;such;name;ywoche;
..'U|xtmaxw'
!YEAR1START
.continue  YEAR2   ? 'U|xiweek' = 'U|xtmaxw'
.formula U|xinum = U|xinum +1
.formula U|xiweek = U|xiweek +1
.formula  U|xwsweek = 'U|xiweek'+P|weekform+'U|xiyear' ? _P|jkw
.formula  U|xwsweek = 'U|xiyear'+P|weekform+'U|xiweek' ? P|jkw
.formula U|xttext = "KW"+'U|xiweek'+"-"+'U|xiyear'
'U|xinum';'U|xinum';'U|xttext';'U|xttext';'U|xwsweek';
.continue YEAR1START
!YEAR2
.formula U|xiyear = U|xiyear +1
.formula U|xtyear = 'U|xiyear' >> 2
.formula U|xiweek = 0
.formula U|xmaxw = 'U|xiyear'+"1229"
.formula U|xtmaxw = 'U|xmaxw' << 2  ? _P|jkw
.formula U|xtmaxw = 'U|xmaxw' >> 2  ? P|jkw
!YEAR2START
.continue  YEAR3   ? U|xiweek = 52
...'U|xiweek' = 'U|xtmaxw'
.formula U|xinum = U|xinum +1
.formula U|xiweek = U|xiweek +1
.formula  U|xwsweek = 'U|xiweek'+ P|weekform+'U|xiyear' ? _P|jkw
.formula  U|xwsweek = 'U|xiyear'+ P|weekform+'U|xiweek' ? P|jkw 
.formula U|xttext = "KW"+'U|xiweek'+"-"+'U|xiyear'
'U|xinum';'U|xinum';'U|xttext';'U|xttext';'U|xwsweek';
.continue YEAR2START
!YEAR3
.formula U|xiyear = U|xiyear +1
.formula U|xtyear = 'U|xiyear' >> 2
.formula U|xiweek = 0
.formula U|xmaxw = 'U|xiyear'+"1229"
.formula U|xtmaxw = 'U|xmaxw' << 2   ? _P|jkw
.formula U|xtmaxw = 'U|xmaxw' >> 2  ? P|jkw
...formula U|xi = 'U|xtmaxw'
!YEAR3START
.continue  YEAR4   ? 'U|xiweek' = 'U|xtmaxw'
.formula U|xinum = U|xinum +1
.formula U|xiweek = U|xiweek +1
.....'U|xiweek'+"/"+'U|xiyear'
.formula  U|xwsweek = 'U|xiweek'+ P|weekform+'U|xiyear' ? _P|jkw
.formula  U|xwsweek = 'U|xiyear'+ P|weekform+'U|xiweek' ? P|jkw 
.formula U|xttext = "KW"+'U|xiweek'+"-"+'U|xiyear'
'U|xinum';'U|xinum';'U|xttext';'U|xttext';'U|xwsweek';
.continue YEAR3START
!YEAR4
.output 
..input 'xtdat'
..input
.input "owinstall/EDP.EXECUTE"
.formula U|xtdat="tmp/KONFIG.TAB"+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'U|xtdat'
.input DATEI.F
!LOAD
.formula U|xtsel = "$,,nummer=201!;gruppe==1"
!LOAD0
.load 0 file40 'U|xtsel' ? _U|xb
.load 0 file40           ?  U|xb   
.continue EXECUTE        ? _G|mehr
.formula U|xb            = G|TRUE
.formula U|xtype = "STDWEEK"  ? _0|ymwechsel & _0|yjwechsel
.formula U|xtype = "CLMWEEK"  ? 0|ymwechsel & _0|yjwechsel
.formula U|xtype = "CLMJWEEK"  ? 0|ymwechsel & 0|yjwechsel

#!ACTION=UPDATE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
# Bediensprache des aktuellen Benutzers, da die Woche nur in Bediensprache eingegeben 
# werden kann und dieses FOP in dieser Bediensprache lÑuft
#!EDP_LANG='P|spr'

id;ywochentyp;\
zeilenop;yprogrammgruppe;yprogrammname;ytflagdatum;
'0|id';'U|xtype';\
-*;;;;\
.....continue LOAD
.load 1 file40 'U|xtype'+"!"+'U|xtype'
!LLOAD1
.load 1 file40 line
.continue LOAD    ? _G|mehr
.load 2 file40 '1|yprgruppe^id'
.continue MAWI  ? 1|yprgruppe^such ="MAWI"
!LLOAD2
.load 2 file40 line
..input
.continue LLOAD1  ? _G|mehr
?+;'1|yprgruppe^id';'2|yprogramm';'0|ylfrei';\   ? '0|ylfrei' <> ""
?+;'1|yprgruppe^id';'2|yprogramm';'0|yldon';\   ? '0|ylfrei' = ""
.continue LLOAD2
!MAWI
.load 2 file40 line
.continue DI ? _G|mehr
?+;'1|yprgruppe^id';'2|yprogramm';'0|ymontag';\  ? '0|ylmon' <>"" & 2|yprmontag
.continue MAWI
!DI
.load 2 file40 line 1
!DIL
.continue MI ? _G|mehr
?+;'1|yprgruppe^id';'2|yprogramm';'0|yldien';\  ? '0|yldien' <>"" & 2|yprdienstag
.load 2 file40 line
.continue DIL 
!MI
.load 2 file40 line 1
!MIL
.continue DO ? _G|mehr
?+;'1|yprgruppe^id';'2|yprogramm';'0|ylmitw';\  ? '0|ylmitw' <>"" & 2|yprmittwoch
.load 2 file40 line
.continue MIL 
!DO
.load 2 file40 line 1
!DOL
.continue FR ? _G|mehr
?+;'1|yprgruppe^id';'2|yprogramm';'0|yldon';\  ? '0|yldon' <>"" & 2|yprdonnerstag
.load 2 file40 line
.continue DOL 
!FR
.load 2 file40 line 1
!FRL
.continue LLOAD1   ? _G|mehr
?+;'1|yprgruppe^id';'2|yprogramm';'0|ylfrei';\  ? '0|ylfrei' <>"" & 2|yprfreitag
.load 2 file40 line
.continue FRL 
!EXECUTE

#!ACTION=STORE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
# Bediensprache des aktuellen Benutzers, da die Woche nur in Bediensprache eingegeben 
# werden kann und dieses FOP in dieser Bediensprache lÑuft
#!EDP_LANG='P|spr'

such;such;nummer;name;\
zeilenop;yprogrammgruppe;yprogrammname;
.formula U|xinum= U|xinum +1
.formula U|xtype = "APS!APS"
.load 0 file40 'U|xtype'
'0|such';'0|such';'U|xinum';'0|namebspr';\
-*;;;\
!APSLINE
.load 0 file40 line
.continue PM  ? _G|mehr
.println +;'0|id^such';'0|yprname';  ?   0|aktzeile = 0|ozeilen
.println +;'0|id^such';'0|yprname';\ ? _(0|aktzeile = 0|ozeilen)
..
.continue APSLINE
!PM

#!ACTION=STORE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
# Bediensprache des aktuellen Benutzers, da die Woche nur in Bediensprache eingegeben 
# werden kann und dieses FOP in dieser Bediensprache lÑuft
