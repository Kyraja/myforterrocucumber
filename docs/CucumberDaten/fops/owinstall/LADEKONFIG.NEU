such;such;nummer;name;\
zeilenop;yprogrammgruppe;yprogrammname;
.formula U|xinum= U|xinum +1
.formula U|xtype = "PM!PM"
.load 0 file40 'U|xtype'
'0|such';'0|such';'U|xinum';'0|namebspr';\
-*;;;\
!PMLINE
.load 0 file40 line
.continue AKT  ? _G|mehr
.println +;'0|id^such';'0|yprname';  ?   0|aktzeile = 0|ozeilen
.println +;'0|id^such';'0|yprname';\ ? _(0|aktzeile = 0|ozeilen)
.continue PMLINE
!AKT

#!ACTION=STORE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
# Bediensprache des aktuellen Benutzers, da die Woche nur in Bediensprache eingegeben 
# werden kann und dieses FOP in dieser Bediensprache lÑuft
#!EDP_LANG='P|spr'

such;such;nummer;name;\
zeilenop;yprogrammgruppe;yprogrammname;
.formula U|xinum= U|xinum +1
.formula U|xtype = "AKT-DATEN!AKT-DATEN"
.load 0 file40 'U|xtype'
'0|such';'0|such';'U|xinum';'0|namebspr';\
-*;;;\
!AKTLINE
.load 0 file40 line
.continue NEXT  ? _G|mehr
.println +;'0|id^such';'0|yprogramm';  ?   0|aktzeile = 0|ozeilen
.println +;'0|id^such';'0|yprogramm';\ ? _(0|aktzeile = 0|ozeilen)
.continue AKTLINE
!NEXT
.output
..input 'xtdat'
.input "owinstall/EDP.EXECUTE"
...input 'U|xterrdat'
.continue
!ERROR
.box
das Programm darf nicht unter abweichendem Datum laufen
.end 10
