..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/AKT.SER.ORDER
.. Date           :16.03.16
.. Version        :
.. Author         :dh/abas
.. Functionality  :creates serviceorders from salesorders for starting for part MRA1500
..
..*****************************************************************************
..
..*****************************************************************************
.type text xtsel ? _defined(xtsel)
.type text xtdat ? _defined(xtdat)
.type text xterrdat ? _defined(xterrdat)
.type bool xbfirst
.type GD xtterm
.....EDP-FILES
.formula U|xtdat = "tmp/XSERORDER."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat' + ".ERR"
.output new 'T|xtdat'
.input DATEI.F
#!action=new
#!database=3
#!group=28
.input "owinstall/HEAD.EDP"

kunde;vom;einsatzart;vserprod;such;\
artex;mge;wtterm;zzvon;zzbis;
..........SALESOBJECTS
.formula U|xtsel = "$,,kopf=;art==30036;serprod<>`;@gruppe=2;@ablageart=(Active)"
!SALES
.select sales 'U|xtsel' ? _U|xbfirst
.select sales           ?  U|xbfirst
.continue SALES2        ? _G|mehr
.formula U|xbfirst = G|TRUE
.formula U|xtterm = H|wtterm & 5
'H|kopf^kunde^id';.;1;'H|serprod^id';D-B'H|kunde^such'\
100006;5;'U|xtterm:8';8:00;23:59;

'H|kopf^kunde^id';+10;2;'H|serprod^id';D-B'H|kunde^such'\
100004;5;+10;8:00;23:59;

'H|kopf^kunde^id';+40;2;'H|serprod^id';D-B'H|kunde^such'\
100004;5;+40;8:00;23:59;

.continue SALES
!SALES2
.formula U|xbfirst = G|FALSE
.select -
!SALES30046
.formula U|xtsel = "$,,kopf=;art==30046;serprod<>`;@gruppe=2;@ablageart=(Active)"
.select sales 'U|xtsel' ? _U|xbfirst
.select sales           ?  U|xbfirst
.continue SALES3        ? _G|mehr
.formula U|xbfirst = G|TRUE
.formula U|xtterm = H|wtterm & 2
'H|kopf^kunde^id';.;1;'H|serprod^id';D-B'H|kunde^such'\
100006;2;'U|xtterm:8';8:00;23:59;

'H|kopf^kunde^id';+10;2;'H|serprod^id';D-B'H|kunde^such'\
100004;5;+15;8:00;23:59;

'H|kopf^kunde^id';+10;2;'H|serprod^id';D-B'H|kunde^such'\
100004;5;+40;8:00;23:59;

.continue SALES30046
!SALES3
.output
.input "owinstall/EDP.EXECUTE"
.cont
.....input 'xtdat'
