..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :ow1/EFOP.DATA.SET
.. Date           :17.07.2014
.. Version        :
.. Author         :dh/abas
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type GD xd1date xd2date xd3date xd4date xt1 xt2 xt3 xt4 xt5
.type text xtdate xt1jahr xt2jahr xt1mon xt2mon xtwanf xtwend
.type text xtw xtj
.type week xw1w xw2w
.type int xi
.type bool xb
.........
.continue SETUP   ? M|such ="SETUP"
.formula M|ymwechsel = G|false
.formula M|yjwechsel = G|false
.formula M|ylmon  = ""  
.formula M|yldien = ""  
.formula M|ylmitw = ""  
.formula M|yldon  = ""  
.formula M|ylfrei = ""
.formula U|xtdate = 'M|ywoche'
.formula U|xtdate= U|xtdate << 2  ? P|jkw
.formula U|xtdate= U|xtdate >> 2  ? _P|jkw
.formula M|yjahr = U|xtdate
.formula U|xd1date = 'M|ywoche'
.formula M|ymontag = U|xd1date -2
.formula M|yfreitag = U|xd1date +2
.formula M|yauftrag = M|yfreitag + 56
.formula U|xtwanf = 'M|ymontag:8
.formula U|xtwend = 'M|yfreitag:8'
.formula M|ylmon  = U|xd1date -2 ? F|isworkday(F|sysinfo(10)^staat^id, "",U|xd1date -2)
.formula U|xt1   = M|ylmon
.formula M|yldien = U|xd1date -1 ? F|isworkday(F|sysinfo(10)^staat^id, "",U|xd1date -1)
.formula U|xt2    = M|yldien
.formula M|ylmitw = U|xd1date    ? F|isworkday(F|sysinfo(10)^staat^id, "",U|xd1date)
.formula U|xt3    = M|ylmitw
.formula M|yldon  = U|xd1date +1 ? F|isworkday(F|sysinfo(10)^staat^id, "",U|xd1date +1)
.formula U|xt4    = M|yldon
.formula M|ylfrei = U|xd1date +2 ? F|isworkday(F|sysinfo(10)^staat^id, "",U|xd1date +2)
.formula U|xt5    = M|ylfrei
.. leeren wenn Monatswechsel
.formula U|xt1 = 'F|substr(U|xt1:8, 5, 2)'
.formula U|xt2 = 'F|substr(U|xt2:8, 5, 2)'
.formula U|xt3 = 'F|substr(U|xt3:8, 5, 2)'
.formula U|xt4 = 'F|substr(U|xt4:8, 5, 2)'
.formula U|xt5 = 'F|substr(U|xt5:8, 5, 2)'
..formula M|ylmon = "" ? U|xt1 <> U|xt5
..formula M|yldien = "" ? U|xt2 <> U|xt5
..formula M|ylmitw = "" ? U|xt3 <> U|xt5
..formula M|yldon = "" ? U|xt4 <> U|xt5
..Monatswechsel
..formula U|xt1mon = 'F|substr(U|xtwanf, 6, 2)' 
..formula U|xt2mon = 'F|substr(U|xtwend, 6, 2)'
.formula M|ymwechsel = G|TRUE ? (F|day(M|ylfrei:8) >= 13 & F|day(M|ylfrei:8) <= 19) & _F|empty(M|ylfrei)
.formula M|ymwechsel = G|TRUE ? (F|day(M|yldon:8) >= 12 & F|day(M|yldon:8) <= 18) & F|empty(M|ylfrei)
..... U|xt1mon <> U|xt2mon
..'U|xt1mon' 'U|xt2mon'
..Jahreswechsel
.formula U|xt1jahr = 'F|substr(U|xtwanf, 1, 4)' 
.formula U|xt2jahr = 'F|substr(U|xtwend, 1, 4)' 
..'U|xt1jahr' 'U|xt2jahr'
.formula M|yjwechsel = G|true  ? F|month(M|ylfrei:8) = 1  & M|ymwechsel
.continue END
!SETUP
.formula U|xtdate = 'M|ywoche' 
.formula M|yjahr = 'F|substr(U|xtdate, 4, 2)' 
.formula U|xi = 'M|yjahr'
.formula M|ymontag = "1.11."+'M|yjahr'
.formula M|yfreitag = "31.12."+'M|yjahr'
.formula U|xi = xi +1
.formula U|xd1date= "01.01."+'U|xi'
.formula U|xw1w = 'U|xd1date'
.formula U|xd1date = U|xw1w
.formula M|yauftrag = U|xd1date + 51
!END
.continue


























