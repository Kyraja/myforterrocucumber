..!interpreter english translate
.type text xtdat xtcom
.formula U|xtdat = "tmp/XSER5."+'G|versionneu'
.output new 'U|xtdat'
.input DATEI.F

# Service chain (Servicekette)
# Transaction Files
# Scenario:             Service chain "Maintenance" 
# 							customer 			70011
# 							product 			30024 (lot 50001, service product 10001)
#                            service technician 	TSCHMITZ
# 							component			10084 (lot 50011)
# 						Service request is dated by "."
# 						Service quotation is dated by "+5"
# 						Service order is dated by "+5"
# 
# requested by:  dr    (05.07.2012)
# changed by  :  doda  (08.01.2015) - corrected references for customer, product and technician. removed contacts (based on rean)
# changed by  :  doda  (19.02.2015) - adjusted the import script based on new technical infrastructure (dh)
# 
# Description:          EDP-Script is executing different objects within a service chain.
#                       It will add: Service Request, Service Quotation, Service Order 
# 
# --------------------------------------------------------------------------------------------------
# Create service request along with service quotation and a release of this service quotation 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;serprod;bearbeit;ursache;dringl;prio;anfstatus;techniker;anfbesch\
zeile;tbearbeit;datum;uhrzvon;tanfbesch;>kostenvb;!;.:techniker;.:artex;.:mge;.:tterm;.:zzvon;.:zzbis;<;>kostenvf;!;1:techniker;1:artex;1:mge;1:tterm;1:zzvon;1:zzbis;!;.:artex;.:mge;.:tterm;!;.:artex;.:mge;.:tterm;<;
1005;1005;1382226;SCHMITZ;SERVICE;MITTEL;HOCH;in Bearbeitung;TSCHMITZ;Vorgezogener Wartungstermin\
 2;SCHMITZ;.;08:30;Serviceangebot erfasst;;+;TSCHMITZ;SERVICE;3.5;+5;08:30;12:00;;;1;TSCHMITZ;SERVICE;3.5;+5;09:30;13:00;+;10084;1;.;+;10057;1;5;
....
.output
.formula U|xtcom = "edpimport.sh -p abas123 -I "+'U|xtdat'
.system 'U|xtcom' background
.continue
