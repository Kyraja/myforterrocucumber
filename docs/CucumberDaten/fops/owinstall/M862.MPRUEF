..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/M862.MPRUEF
.. Date           :15.9.15
.. Version        :
.. Author         :dh/abas
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtsuch
.type int xilen
.assign U|xilen = M|nummer
.assign  M|nummer = F|string("0", 6 - F|length(M|yrange)) + 'M|yrange' ? _U|xilen = M|yrange
.formula M|nummer = "" ? _G|mehr
.formula M|ywin    = "win/tmp/" + M|nummer + "-" + M|such + ".EDP" ? F|empty(M|ywin) & G|mehr
.continue
