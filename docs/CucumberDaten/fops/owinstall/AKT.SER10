..!interpreter english translate
.type text xtdat xtcom
.formula U|xtdat = "tmp/XSER10."+'G|versionneu'
.output new 'U|xtdat'
.input DATEI.F

# Service chain (Servicekette)
# Transaction Files
# Scenario:             Service chain "cloud for mobile app" 
#							customer 			70024
#							product 			30026 (lot 50017, service product 10017)
#                           service technician 	TSCHILLING
#
# requested by:  dr    (12.01.2015)
#
# Description:          EDP-Script is executing different objects within a service chain.
#                       It will add: Lot number, Service Product, Service Request, Service Order
# 
# Scenario:             Service chain with various service orders which should display a certain usage
#                       of the technician in the mobile parts of the system
# 
# --------------------------------------------------------------------------------------------------
# Create service request along with service quotation and a release of this service quotation 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;serprod;bearbeit;ursache;dringl;prio;anfstatus;techniker;anfbesch\
zeile;tbearbeit;datum;uhrzvon;tanfbesch;>kostenvb;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;<;>kostenvf;!;1:techniker;1:artex;1:mge;1:wtterm;1:zzvon;1:zzbis;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;!;.:techniker;.:artex;.:mge;.:wtterm;.:zzvon;.:zzbis;<
