..!interpreter english translate
.type text xtdat xtcom
.formula U|xtdat = "tmp/XSER2."+'G|versionneu'
.output new 'U|xtdat'
.input DATEI.F

# Service chain - repair (Servicekette - Reparatur)
# Transaction Files
# Scenario:             Service chain "Repair" 
# 							customer 			70022
# 							product 			30025 (lot 50004, service product 10004)
#                            service technician 	THAMMER
#  							component			10063 (lot 50014)
# 						Service request is dated by "-4"
# 						Incoming packing slip for repair order is dated by "."
# 
# requested by :  dr    (05.07.2012)
# created by   :  doda  (12.01.14)   - changed product, customer, technician on request (rean)
#
# Description:          EDP-Script is executing different objects within a service chain.
#                       It will add: Lot number, Service Product, Service Request, Repair order, Packing Slip
# 
# --------------------------------------------------------------------------------------------------
# Create service request and a repair order for the service request 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;serprod;bearbeit;ursache;dringl;prio;anfstatus;techniker;anfbesch\
zeile;tbearbeit;datum;uhrzvon;tanfbesch;>repaub;!;1:lgruppe;!;.:artex;.:mge;.:repverr;<
1003;1003;1379839;HAMMER;REPARATUR;HOCH;MITTEL;freigegeben zur Faktura;;Motor wird heiss und schaltet ab\
 2;HAMMER;-4;08:30;Reparaturauftrag erfasst;;1;LG-SR-KS;+;REP;1;Nach Aufwand zzgl. Ersatzteilkosten;
#
# --------------------------------------------------------------------------------------------------
# Create incoming packing slip for the repair order 
# --------------------------------------------------------------------------------------------------
#!ACTION=STORE
#!DATABASE=122
#!GROUP=1
#!EDP_FOPMODE=0
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!EDP_UPDATEMODE=STRICT
#!EDP_STOREROWMODE=DELNONE
#!DONTCHANGE=-
.input "owinstall/HEAD.EDP"

nummer;nummer;such\
zeile;>repaub;>repzug;ueb;<;<
1003;1003;REPAIR\
 2;;;1;;
....
.output
.formula U|xtcom = "edpimport.sh -p abas123 -I "+'U|xtdat'
.system 'U|xtcom' background
.continue
