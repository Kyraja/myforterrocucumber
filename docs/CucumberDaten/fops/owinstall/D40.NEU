..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :
.. Date           :
.. Version        :
.. Author         :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text xtdat xtmon xtj xtfile
.type bool xb
.type GD xtdat xdsetup xdmon xdfrei
.type int xiaj xiam xinum xiweek xiend
.type week xwsetup
.type bool xbmonth xbjear
.fo U|xbmonth = G|false
.fo U|xbjear = G|false
.fo xtdat = "grep cmdline=-datum win/wineks.ini"
.sys 'xtdat' background
..continue ERROR  ? G|mehr
......definition outputfile
.formula U|xtfile = "owinstall/IMPORT.DATEI40.NEU"
.output new 'U|xtfile'
.input DATEI.F
#!ACTION=STORE
#!DATABASE=80
#!GROUP=1
#!LINESEPARATOR=#
#!FLDDELIMITER=;
#!CHARSET=ISO8859
#!EDP_LANG=D

nummer;nummer;such;name;ywoche;yres1;
.................
.formula U|xtdat = G|datum:8
.formula U|xtmon = 'F|substr(xtdat, 5, 2)'
.fo U|xiam = 'U|xtmon'
.formula U|xtj = 'F|substr(xtdat, 1, 4)'
.fo U|xiaj = 'U|xtj'
.formula U|xiend = U|xiaj +2
.fo U|xiaj = U|xiaj -2
.formula U|xdsetup = "01.11."+'U|xiaj'
.fo U|xwsetup = 'U|xdsetup'
..START
.select file40 "$,,nummer=;such=START!START;@gruppe=3;@sort=Nummer;"
.formula U|xinum = 1000
!LINE1
.select line 
.continue SETUP   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such';;'U|xwsetup';'H|yprname';
.continue LINE1
!SETUP
.formula U|xinum = U|xinum +1
.select file40 "$,,nummer=;such=SETUP!SETUP;@gruppe=3;@sort=Nummer;"
!LINE2
.select line 
.continue FIBU   ? _G|mehr
'U|xinum';'U|xinum';'H|such';;'U|xwsetup';'H|yprname';
.formula U|xinum = U|xinum +1
.continue LINE2
!FIBU
.select file40
!LINE3
.select line 
.continue YEAR   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such';;'U|xwsetup';'H|yprname';
.continue LINE3
!YEAR
.fo U|xiaj = U|xiaj + 1
.continue DH ? U|xiaj = U|xiend
.formula U|xiweek = 0
!WEEK
.formula U|xiweek = U|xiweek +1
.continue YEAR ? U|xiweek = 53
.formula U|xwsetup = 'U|xiweek'+"/"+'U|xiaj'
!OUTWEEK
.select file40 "$,,nummer=;such=MAWI!MAWI;@gruppe=3;@sort=Nummer;"
!LINE4
.select line 
.continue WEEKFIBU   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such'_KW'U|xiweek'/'U|xiaj';'U|xiweek'/'U|xiaj';'U|xwsetup';'H|yprname';
.continue LINE4
!WEEKFIBU
.select file40 "$,,nummer=;such=FIBU_WEEK!FIBU_WEEK;@gruppe=3;@sort=Nummer;"
!LINE5
.select line 
.continue MONTHFIBU   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such'_KW'U|xiweek'/'U|xiaj';'U|xiweek'/'U|xiaj';'U|xwsetup';'H|yprname';
.continue LINE5
!MONTHFIBU
.continue YEARFIBU  ? U|xiweek <> 2
.select file40 "$,,nummer=;such=FIBU_MONTH!FIBU_MONTH;@gruppe=3;@sort=Nummer;"
!LINE6
.select line 
.continue YEARFIBU   ? _G|mehr
.formula U|xinum = U|xinum +1
.....79140;79140;KW1/15;KW1/15;01/15;owinstall/ORDER;
'U|xinum';'U|xinum';'H|such'_KW'U|xiweek'/'U|xiaj';'U|xiweek'/'U|xiaj';'U|xwsetup';'H|yprname';
.continue LINE6
!YEARFIBU
.continue NEXT  ? U|xiweek <> 6
.select file40 "$,,nummer=;such=FIBU_YEAR!FIBU_YEAR;@gruppe=3;@sort=Nummer;"
!LINE7
.select line 
.continue NEXT   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such'_KW'U|xiweek'/'U|xiaj';'U|xiweek'/'U|xiaj';'U|xwsetup';'H|yprname';
.continue LINE7
!NEXT
.continue WEEK
!DH
!LASTWEEK
.select file40 "$,,nummer=;such=LASTWEEK!LASTWEEK;@gruppe=3;@sort=Nummer;"
!LINE8
.select line 
.continue AKTW   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such';;;'H|yprname';
.continue LINE8
!AKTW
.select file40 "$,,nummer=;such=AKTUELL!AKTUELL;@gruppe=3;@sort=Nummer;"
!LINE9
.select line 
.continue PM   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such';;;'H|yprname';
.continue LINE9
!PM
.select file40 "$,,nummer=;such=PM!PM;@gruppe=3;@sort=Nummer;"
!LINE10
.select line 
.continue APS   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such';;;'H|yprname';
.continue LINE10
!APS
.select file40 "$,,nummer=;such=APS!APS;@gruppe=3;@sort=Nummer;"
!LINE11
.select line 
.continue END   ? _G|mehr
.formula U|xinum = U|xinum +1
'U|xinum';'U|xinum';'H|such';;;'H|yprname';
.continue LINE11
!END
.output
.cont
!ERROR
.box
das Programm darf nicht unter abweichendem Datum laufen
.end 10
