.formula M|yfilenum = M|yfile^vdn
.formula M|ygroup  = M|yfile^vgr
.formula M|such    = F|substr(M|yfile^vgrtxts,2,F|length(M|yfile^vgrtxts)-2) ? F|empty(M|such)
.formula M|name    = F|substr(M|yfile^name, 18) ? F|empty(M|name)
.continue
