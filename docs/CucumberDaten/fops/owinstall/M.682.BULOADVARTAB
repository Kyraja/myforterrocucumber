..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owinstall/M.682.BULOADVARTAB
.. Date           :12.8.15
.. Version        :
.. Author         :dh/abas
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.continue ERROR  ? F|empty(M|yfile)
....
.type text xtsel xtchange xtvar xtstring
.type text xtfile xtcom xterrdat xtntype
.type bool xbfirst
.formula U|xbfirst = false
.formula U|xtsel ="$,,nummer=="+'M|yfile'+";such=;"
.make screen line --
!SELECT
.select Company 'U|xtsel'   
.continue END                    ? _G|mehr
.make screen line+
.formula M|yfield = "nummer"
.formula M|yuse = G|true
.make screen line+               ? M|ynew = "STORE"
.formula M|yfield = "nummer"     ? M|ynew = "STORE"
.formula M|yuse = G|true         ? M|ynew = "STORE"
.......
!SELLINE
.select line
.continue END             ? _G|mehr
.formula U|xtchange = H|vms
..continue SELLINE                ? H|vskip
.continue SELLINE                ? H|vitf /"BU*"
.continue SELLINE                ? H|vms = "immer geschÅtzt" & _H|vname = "itzn"
.continue SELLINE                ? H|vms = "Feld unsichtbar"
.continue SELLINE                ? H|inalias
.continue SELLINE                ? H|vname /"*res*" ; H|vname / "*versionier*"
.make screen line +
.formula U|xtvar = H|vname
.formula U|xtvar = H|vnname ? _F|empty(H|vnname)
.formula U|xtvar = U|xtvar << -2
.formula M|yfield = U|xtvar
....
.formula M|ytype = 'H|vitf'
.formula M|ytype = 'H|vitnf'  ? _F|empty(H|vitnf)
.formula M|yuse = G|true
.formula M|yuse = G|false ? M|yfield ="dateiarchivieren" ; M|yfield ="versionerstellen"
.formula M|yuse = false  ? M|yfield ="erfass"
.formula M|yuse = false  ? M|yfield ="stand"
.formula M|yuse = false  ? M|yfield ="zeichen"
.formula M|yuse = false  ? M|yfield ="guid"
.formula M|yuse = false  ? M|yfield ="markiert"
.formula M|yuse = false  ? M|yfield ="markierung"
..
.formula M|ytab = G|true ? H|vkt
.continue SELLINE
!END
.cont

!ERROR
please enter Vartab ,Database and Group
.end 10
