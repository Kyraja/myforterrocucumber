..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : WORKLIST.INFOTIMER
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : drÅckt in regelmÑ·igen AbstÑnden den Startbutton
.. Zeitintervall kann Åber die Variable infoakt manuell gesetzt werden
..
..  Includes       :
.. include fe/WORKLIST.BA
..*****************************************************************************
.set trans -
.type text     xtvergzeit       ? _F|defined(U|xtvergzeit)      
.type text     xtaktzeit        ? _F|defined(U|xtaktzeit)
.type GD19     xzaktzeit        ? _F|defined(U|xzaktzeit)
.type GD19     xzvergzeit       ? _F|defined(U|xzvergzeit)
.type GP3      xzdauer          ? _F|defined(U|xzdauer)
.type text     xtdauer          ? _F|defined(U|xtdauer)
.type text     xtdauertage      ? _F|defined(U|xtdauertage)
.type text     xtdauerstunden   ? _F|defined(U|xtdauerstunden)
.type text     xtdauerminuten   ? _F|defined(U|xtdauerminuten)
.type integer  xidauerminuten   ? _F|defined(U|xidauerminuten)
.type bool     xbstart          ? _F|defined(U|xbstart)
..
.copy U|xbstart = G|FALSE
..
..  ist es schon wieder soweit?
.formula U|xtvergzeit = 'G|datum' + " " + 'M|infozeit'
.assign U|xzvergzeit = U|xtvergzeit
.formula U|xtaktzeit = 'G|datum' + " " + 'G|zeit'
.assign U|xzaktzeit = U|xtaktzeit
.formula U|xzdauer = U|xzaktzeit - U|xzvergzeit
.formula U|xtdauer = U|xzdauer
.. wenn keine Minute vergangen ist, sind die Variablen xtdauer und xtdauertage leer
.. hier natÅrlich auch keine Aktualiserung  
.continue END   ? F|empty(U|xtdauer) 
.formula U|xtdauertage = U|xtdauer << 2
.continue START ? U|xtdauertage  <> "0D"
.formula U|xtdauerstunden = U|xtdauer << -2
.formula U|xtdauerstunden = U|xtdauerstunden <<  3
.continue START ? U|xtdauerstunden <> "00h"
.formula U|xtdauerminuten = U|xtdauer << -5
.formula U|xtdauerminuten = U|xtdauerminuten  << 3
.formula U|xtdauerminuten = U|xtdauerminuten << 2
.assign U|xidauerminuten = U|xtdauerminuten
.continue START ? U|xidauerminuten > M|infoakt
.continue END
..
!START: Startbutton drÅcken
.copy U|xbstart = G|TRUE
.input "fe/WORKLIST.BA"
.continue END 
..
..*************************************************************************
!END: Programmende
.continue
