..!interpreter declaration english translate
..*****************************************************************************
..
..  FOP-Name       : APAPIER.ELEM
..  Datum          : 22.03.05
..  Version        : 2005
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Artikelinformationen zusammenstellen
..  Functionality  : Compile product informations
..
..  Ablauf         :
..  Program flow   :
..  includes       :
..
..*****************************************************************************
.set trans -
.copy M|elemle     = D|le         ?  M|elart = 1 ; M|elart = 2 ; M|elart = 4
.assign M|elem       = D|id
.continue NOELART1      ? M|elart <> 1
.copy M|packmit = 0
.copy M|packmit = 1     ? D|packmit
..
!NOELART1
.formula M|elemsuch     = D|such
.formula M|elemnum      = D|nummer
.formula M|elemname     = D|sucherw
.assign M|tbasisartikel = M|elem^basisartikel  ? M|elart = 1
.assign M|elemwstoff = D|wstoff                ? M|elart = 1 ; M|elart = 4
.formula M|elemzeichn   = D|zeichn             ? M|elart = 1 ; M|elart = 2
..
.formula M|elemgrgr     = D|grgr               ? M|elart = 3
.continue
