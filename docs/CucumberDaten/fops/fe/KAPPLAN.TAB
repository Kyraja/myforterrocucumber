..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KAPPLAN.TAB
.. Datum          : 29.11.06
.. Version        : 2007
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Tabellen-FOP des Infosystems KAPPLAN
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
.. Includes       :
..*****************************************************************************
..
.set trans -
.type P8:2  xmgr      ? _F|defined(U|xmgr)
.type P8:1  xabtlg    ? _F|defined(U|xabtlg)
.type text  xsmgr     ? _F|defined(U|xsmgr)
.type text  xtmp      ? _F|defined(U|xtmp)
.type MP4.2 xmanz     ? _F|defined(U|xmanz)
..
.continue ERROR ? F|empty(M|adatum) ; F|empty(M|edatum)
..
.make screen line --
..
.continue NOART       ? F|empty(M|artikel)
.select add M|artikel^id
..
!ARTZEILE
.select line
.continue EARTZEILE   ? _G|mehr
.continue ARTZEILE    ?  H|elart <> 3
.formula U|xsmgr = U|xsmgr + 'mgr^num8' + "#"
.continue ARTZEILE
..
!EARTZEILE:
.continue FARTZEILE   ? F|empty(U|xsmgr)
.continue NOART
..
!FARTZEILE
.error Artikel hat keinen Arbeitsplan.
.end 1
..
!NOART
.select add M|kmgr   ?  F|empty(M|kmgr)
.select capacity
.continue MELDUNG     ? _G|mehr
.continue NAECHSTE    ?  H|gruppe = 1
.continue NAECHSTE    ? 'H|abtlg^num8' <> 'M|abtlg^num8' & M|abtlg <> ""
.continue NAECHSTE    ? 'H|nummer' <> 'M|kmgr^num8' & M|kmgr <> ""
.select capacity specific 'M|lgruppe^id'
.continue MELDUNG     ? _G|mehr
..
!ZEILE
.formula G|adatum  = M|adatum
.formula G|edatum  = M|edatum
.formula U|xmgr    = H|nummer
.formula U|xabtlg  = H|abtlg
.formula U|xtmp    = "*" + H|nummer + "*"
.formula U|xmanz   = H|manz
..
.. Belegung im Kapazit„tszeitraum M|adatum bis M|edatum
.select machloading
.continue NAECHSTE  ?  G|mbel = 0
.continue NAECHSTE  ? _U|xsmgr / 'U|xtmp' & _F|empty(U|xsmgr)
..
.make screen line +O
.formula M|belegung = G|mbel
.formula M|kapaz    = F|totalcapacityhours(H|id, M|lgruppe^id, M|adatum, M|edatum)               
.select planchart
.formula G|adatum   = M|adatum
.formula G|std      = G|mbel / U|xmanz
.. Auftragsbestand bis
.formula M|zieldat  = G|incst
.formula M|mgr      = U|xmgr
.formula M|tabtlg   = U|xabtlg
.formula M|kapbis   = M|edatum
..
!NAECHSTE
.select capacity
.continue ENDE      ? _G|mehr
.continue NAECHSTE  ?  H|gruppe = 1
.continue NAECHSTE  ? 'H|nummer' <> 'M|kmgr^num8' & _F|empty(M|kmgr)
.continue NAECHSTE  ? 'H|abtlg^num8' <> 'M|abtlg^num8' & _F|empty(M|abtlg)
.select capacity specific 'M|lgruppe^id'
.continue ZEILE
..
!MELDUNG
.error Keine Ergebnisse vorhanden.
.end 1
..
!ERROR
.error Bitte einen Zeitraum angeben.
.end 1
..
!ENDE
.end

