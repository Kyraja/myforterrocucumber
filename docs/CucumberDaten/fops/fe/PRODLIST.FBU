..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PRODLIST.FBU
.. Datum          : 30.11.2005
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem, Fertigungsvorschl„ge,
..                   Materialentnahme aufrufen
..*****************************************************************************
.set trans -
.type text xtkomm ? _F|defined(U|xtkomm)
..
.continue ERROR  ?  F|empty(M|fbu) 
..
.. fbuchung
.continue FEHLER  ? _M|bfbuerlaub
.formula U|xtkomm = "(WOIssue)"+ " ? auftrag=" + M|order^id +"| [autoclose]=1"
.command -parallel 'U|xtkomm'
..
.input "is/TABLEEREN"
.continue NAECHST          ?  _F|empty(M|kba)
.continue HOLE
..
!NAECHST
.continue BALEEREN         ? F|empty(M|kba)
.select add M|kba
.continue BALEEREN         ? _G|mehr
.select -
.continue HOLE
!BALEEREN: BA und M|select leeren
.formula M|kba    = ""
.formula M|select = ""
.continue
!HOLE: Tabelle aktualisieren / neu aufbauen
.input "is/HOL.LISTE"
.continue
..
!ERROR
.error Darf nicht manuell gebucht werden.
.end 1
..
!FEHLER
.error Eine Materialentnahme ist nicht erlaubt!
.end 1
