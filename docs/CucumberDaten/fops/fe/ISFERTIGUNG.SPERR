..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ISFERTIGUNG.SPERR
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Locks the document for the fo command ".printed".
..*****************************************************************************
.set trans -
.continue END       ? P|vorschau
.assign M|statusz = ""
.continue ERROR  ? F|empty(M|banummer^id)
.select modificationlock waitshort object 'M|banummer^id'
.continue ERROR   ? _G|mehr
.continue LOCK    ? _G|gesperrt
.continue BREAK   ?  M|printable & _H|druck ; H|druck & _M|printable
..
.action +
.select -
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!BREAK
.copy M|statusz = M|blauz
.assign M|printable = H|druck
.end 1
!LOCK
.copy M|statusz = M|gelbz
.end 1
!ERROR: Document missing
.copy M|statusz = M|rotz
.end 1
