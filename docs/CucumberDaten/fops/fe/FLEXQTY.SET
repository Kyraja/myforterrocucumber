..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FLEXQTY.SET
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.type text      xtsel        ? _F|defined(U|xtsel)
.type text      xtersteras   ? _F|defined(U|xtersteras)
.type text      xtletzteras  ? _F|defined(U|xtletzteras)
.type ARTR51001 xmerk        ? _F|defined(U|xmerk)  
.type integer   xznummer     ? _F|defined(U|xznummer)
.type ARTR51001 xmgeneu      ? _F|defined(U|xmgeneu)
.type ARTR51001 xmgegrenze     ? _F|defined(U|xmgegrenze)
..
..
.continue END ? M|aufzu = "icon:folder_closed"
.formula U|xznummer = M|zn + 1
.formula U|xtersteras = M|tba + "001"
.formula U|xtletzteras = M|tba + "999"
.formula U|xtsel = "$,,nummer="+'U|xtersteras'+"!"+'U|xtletzteras'+";gruppe=1;@ablage=(Active);rgutmge=;@ordnung=rgutmge;@richtung=rckw„rts"
.load 1 workorder 'U|xtsel'
.continue END ? _G|mehr
.formula U|xmerk = 1|rgutmge
..
!SELZEILE: Tabelle durchlaufen, dann Icon setzen
.select screen line 'U|xznummer'
.continue END ? _G|mehr
.continue END ? _F|empty(M|aufzu)
..
!FAHNE
.formula M|iconz  = ""
.formula M|iconz  = M|icon1 ? M|rueckmge = U|xmerk & _F|empty(M|rueckmge)
.formula M|merkmgeneu = U|xmgeneu
.formula M|merkmgegrenze = U|xmgegrenze
.formula U|xznummer = U|xznummer + 1
.continue END ? U|xznummer > M|tzeilen
.continue SELZEILE
..
!END
.continue
