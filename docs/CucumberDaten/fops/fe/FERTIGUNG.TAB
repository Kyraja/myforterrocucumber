.. Program flow   : Select work orders
..
.. Includes       :
..
..*****************************************************************************
.set trans -
..
.continue ? F|equals(H|typ, "(WorkSlips)")
.continue ? M|kdruck & _H|druck
..
.make screen line +O
.assign M|printable = H|druck
.formula M|banummer    = H|nummer
.formula M|vom         = H|vom
.copy M|mgr       = H|mgr
.formula M|mge         = H|mge
..
.add H|art
.copy M|artle     = D|le
.formula M|artzeichn   = D|zeichn
.assign M|artwstoff = D|wstoff
.assign M|artsuch   = D|id
.add
.continue
