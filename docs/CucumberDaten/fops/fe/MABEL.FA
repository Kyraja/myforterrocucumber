..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MABEL.FA
.. Datum          : 29.11.06
.. Version        : 2007
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Feldaustritts-FOP fr MABEL
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
.. Includes       :
..
..*****************************************************************************
.set trans -
.continue BISDAT    ? G|evtartengl="FIELD_EXIT" & G|evtvar="edat"
.continue VOMDAT    ? G|evtartengl="FIELD_EXIT" & G|evtvar="adat"
.continue LGRUPPE   ? G|evtartengl="FIELD_EXIT" & G|evtvar="lgruppe"
.continue MGR       ? G|evtartengl="FIELD_EXIT" & G|evtvar="mgident"
.continue ABTLG     ? G|evtartengl="FIELD_EXIT" & G|evtvar="abtlg"
.continue
..
!MGR: Maschinengruppe
.formula M|mgname     = M|mgident^sucherw
.formula M|abtident   = ""
.formula M|abtname    = ""
.continue LEEREN
..
!ABTLG: Abteilung
.formula M|abtname    = M|abtident^sucherw
.formula M|mgname     = ""       ? M|mgident = ""
.continue LEEREN
..
!LGRUPPE: Lagergruppe / warehouse group
.formula M|lgrname    = ""
.continue FIRMA                   ? M|lgruppe = ""
.formula M|lgrname    = M|lgruppe^sucherw
.continue LEEREN
..
!FIRMA: interne Lagergruppe / internal warehouse group
.assign M|lgruppe  = F|sysinfo(10)^intlgruppe
.formula   M|lgrname  = F|sysinfo(10)^intlgruppe^sucherw
.continue LEEREN
..
!VOMDAT: Vom-Datum
.continue ERROR1 ? F|empty(M|adat)
.continue ERROR2 ? F|empty(M|edat)
.continue ERROR3 ? M|adat > M|edat 
.formula M|dat1 = M|adat                ? M|adat < M|dat1
....
!BISDAT: Bis-Datum
.continue ERROR1 ? F|empty(M|adat)
.continue ERROR2 ? F|empty(M|edat)
.continue ERROR3 ? M|adat > M|edat 
.formula M|dat4 = M|edat     ? M|dat4 < M|edat
.continue LEEREN
..
!LEEREN: alle Kopffelder und Tabellenfelder leeren
.formula M|sbel1      = ""
.formula M|sbel2      = ""
.formula M|sbel3      = ""
.formula M|skap1      = ""
.formula M|skap2      = ""
.formula M|skap3      = ""
.formula M|ueberhang1 = ""
.formula M|ueberhang2 = ""
.formula M|ueberhang3 = ""
.formula M|mgekap     = ""
.formula M|mggkap     = ""
.continue TABLEEREN
..
!TABLEEREN: clear table
.make screen line -- ? M|tzeilen > 0
.continue ENDE
!ENDE
.continue
..Fehlerhandling
!ERROR1
.error Anfangsdatum eingeben.
.cursor adat
.end 1
!ERROR2
.error Enddatum eingeben.
.cursor edat
.end 1
!ERROR3
.error Bis-Datum kleiner als Vom-Datum.
.formula M|adat = ""
.formula M|edat = ""
.end 1

