..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRODUCTIONSTATUS.BSTART.BA
.. Author         : tiwe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Selektion der Fertigungsvorschl„ge
..
.. Program flow   :
...Includes       :
..
..*****************************************************************************
.set trans -
.type text        xtsel          ? _F|defined(U|xtsel)
..
.. Selektion der Fertigungsvorschl„ge
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";artikel="+'M|artikel^id'              ? _F|empty(M|artikel)
.formula U|xtsel = U|xtsel + ";nummer="+'M|ba'                      ? _F|empty(M|ba)
.formula U|xtsel = U|xtsel + ";betreuer="+'M|betreuer^id'           ? _F|empty(M|betreuer)
.formula U|xtsel = U|xtsel + ";wtsterm>="+'M|vom'                    ? _F|empty(M|vom)
.formula U|xtsel = U|xtsel + ";wtterm<="+'M|bis'                     ? _F|empty(M|bis)
.formula U|xtsel = U|xtsel + ";@ordnung=wtsterm;@ablage=lebendig"
.formula U|xtsel = U|xtsel + ";@gruppe=5;"
.select purchasing 'U|xtsel'
.continue END   ? _G|mehr
..
!FVLOOP: Schreiben der Zeile
.input 'M|tab'  ? _F|empty(M|tab)
..
!NEXT
.select purchasing
.continue FVLOOP ? G|mehr
..***************************************************
.. Nachlauf: nur Zeilen mit FV behalten
..***************************************************
.continue NONL ? M|nurfv = false
.select screen header
.select screen line
.continue NONL ? _G|mehr
!NLLOOP
.make screen line -o ? M|typ = "AG"
.colour -background -1 -1 -1  'M|aktzeile'
.select screen line  ? M|typ = "FV"
.continue NLLOOP ? G|mehr
!NONL
.continue END
..
!END
.continue
