..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BA.GEDRUCKT
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Locks the document for the fo command ".printed".
..*****************************************************************************
.set trans -
.continue END        ? P|vorschau
.continue END        ? F|empty(M|id)
.select modificationlock waitshort object 'M|id'
.continue ERROR   ? _G|mehr
.continue NOSPERR ? _G|gesperrt
.continue OUTPUT  ?  P|erg=0
.continue REWORK
..
!OUTPUT
.output new "WERF.WEG"
.printed
.output
..
!REWORK
.select -
.action -
..*****************************************************************************
..
!END
.continue
..*****************************************************************************
..
!NOSPERR: Lock failed
.error Vorgang konnte nicht gesperrt werden!
.copy M|statusz = M|gelbz  ? U|xbinfo
.end 1
