..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MZ.TAB
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Materialzuordnung holen.
..                  Nur manuelle Dispo wird ausgegeben (einplan = FALSE)
.. Functionality  : Select materials allocation with einplan = FALSE
..*****************************************************************************
.set trans -
..
.type text xsel          ? _F|defined(U|xsel)
.type ID4  xid           ? _F|defined(U|xid)
..
.continue END ? F|empty(M|mzid)
.assign U|xid = M|mzid
.continue ERROR ? _G|mehr
.. Clear table
.input "is/TABLEEREN"
.. Set head line
.text M|ueberschrift 'P|spr' Chargen/Seriennummer:
..
.. Build and execute query for materials allocation
.formula U|xsel="$,,reserv=" + M|mzid + ";einplan=FALSE;aktiv=TRUE;@ordnung=reserv,einplan,aktiv,pos,abeweg;@ablageart=(Both)"
.select mallocation 'U|xsel'
..
!NEXT
.continue END ? _G|mehr
..
.. Build table row
.make screen line +O
.copy M|lpsuch = H|lpsuch
.copy M|charge = H|charge
.formula M|tcharge = H|tcharge
.formula M|zuomge  = H|zuomge
.formula M|einh    = 'H|einh(L=P|spr)'
..
.select mallocation
.continue NEXT
..*****************************************************************************
!END
.continue
..
!ERROR
.error Keine gÅltige Reservierungs-ID!
.end 1
