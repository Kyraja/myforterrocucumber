..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ENGPASS.EV
.. Datum          : 29.11.06
.. Version        : 2007
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Event-FOP fÅr das IS ENGPASS
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
.. Includes       :
..*****************************************************************************
..
.set trans -
.assign M|sukapaz      = ""
.assign M|subelegt     = ""
.assign M|suverfuegbar = ""
..
.. Kopf
.continue MGR      ? G|evtartengl="FIELD_EXIT"  & G|evtvar="mgr"
.continue ABTLG    ? G|evtartengl="FIELD_EXIT"  & G|evtvar="abtlg"
.continue LGRUPPE  ? G|evtartengl="FIELD_EXIT"  & G|evtvar="lgruppe"
.continue ENDE     ? G|evtartengl="FIELD_EXIT"  & G|evtvar="krit"
.continue DATE     ? G|evtartengl="FIELD_EXIT"  & G|evtvar="kadatum"
.continue DATE     ? G|evtartengl="FIELD_EXIT"  & G|evtvar="kedatum"
.. Tabelle
.continue CALL     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bchagantt"
.continue CALL     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bchabalken"
.continue CALL     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bchgantt"
.continue CALL     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bchbalken"
.continue
..
!DATE
.continue         ? _F|empty(M|kadatum) & _F|empty(M|kedatum)
.set trans +
.error Bitte einen Zeitraum angeben.
.set trans -
.cursor kedatum ? F|empty(M|kedatum)
.cursor kadatum ? F|empty(M|kadatum)
.end 1
..
!MGR: Maschinengruppe
.formula M|mgrname     = M|mgr^sucherw
.assign M|abtlg     = ""
.continue ENDE
..
!ABTLG: Abteilung
.assign M|mgrname = ""  ? F|empty(M|mgr)
.continue ENDE
..
!LGRUPPE: Lagergruppe
.continue FIRMA     ? F|empty(M|lgruppe)
.continue ENDE
..
!FIRMA: interne Lagergruppe / internal warehouse group
.assign M|lgruppe  = F|sysinfo(10)^intlgruppe
.continue ENDE
..
!CALL
.type ID87:9 xcallparam  ? _F|defined(U|xcallparam)
.assign U|xcallparam = M|call1param  ? G|evtvar = "bchabalken"
.assign U|xcallparam = M|call2param  ? G|evtvar = "bchagantt"
.assign U|xcallparam = M|call3param  ? G|evtvar = "bchbalken"
.assign U|xcallparam = M|call4param  ? G|evtvar = "bchgantt"
.input "st/CALLPARAM.EXEC"
.continue
..
!ENDE
.input "is/TABLEEREN"
.continue
