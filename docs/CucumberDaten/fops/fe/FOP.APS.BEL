..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FOP.APS.BEL
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Start Etagis-Viewer aus Maske 8,80,71
..                  (Abteilung, Maschinengruppe und Maschinenbelegung)
..*****************************************************************************
.type text  U|xpfad   ? _F|defined(U|xpfad)
.type text  U|xwindir ? _F|defined(U|xwindir)
.set trans -
..
.. von "/" zu "\" wechseln
.formula U|xwindir = 'F|regreplaceall(G|clwindir, "\/", "\\")'
..
.formula U|xpfad = "aps\gui\etagisviewer.exe"
.formula U|xpfad = U|xpfad + " /ini=" + U|xwindir + "\aps\gui\etagis_viewer.ini"
.formula U|xpfad = U|xpfad + " /mandantini=" + U|xwindir + "\mandant.ini"
.formula U|xpfad = U|xpfad + " /exportdir=" + U|xwindir + "\aps\daten"
.formula U|xpfad = U|xpfad + " /edp"
..
.continue MABEL     ? M|nummer = "10247"
.continue ABTMASCH  ? M|dnr = 8
.continue MBEL      ? M|dnr = 4
.continue END
..
!ABTMASCH: Abteilung / Maschinengruppe
.formula U|xpfad = U|xpfad + " /abasgantt=department "  ? M|gruppe = 1
.formula U|xpfad = U|xpfad + " /abasgantt=machine "     ? M|gruppe = 2
.formula U|xpfad = U|xpfad + G|dblquote + "/abasganttid=" + 'M|id' + G|dblquote
.formula U|xpfad = U|xpfad + " /abasganttstop=" + 'M|edat:8'   ? _F|empty(M|edat)
.continue PCEXEC
..
!MABEL: Infosystem MABEL
.. oder mgident^id ??
.formula U|xpfad = U|xpfad + " /abasgantt=machine "
.formula U|xpfad = U|xpfad + G|dblquote + "/abasganttid=" + 'M|mgident' + G|dblquote
.formula U|xpfad = U|xpfad + " /abasganttstart=" + 'M|adat:8'   ? _F|empty(M|adat)
.formula U|xpfad = U|xpfad + " /abasganttstop=" + 'M|edat:8'    ? _F|empty(M|edat)
.continue PCEXEC
..
!MBEL: Maschinenbelgung
.. reicht hier mgr oder mgr^id ??? -> wird nicht mehr bei Tabelle laden aufgerufen!
.formula U|xpfad = U|xpfad + " /abasgantt=machine "
.formula U|xpfad = U|xpfad + G|dblquote + "/abasganttid=" + 'M|mgr' + G|dblquote
.formula U|xpfad = U|xpfad + " /abasganttstart=" + 'M|vom:8'   ? _F|empty(M|vom)
.formula U|xpfad = U|xpfad + " /abasganttstop=" + 'M|bis:8'    ? _F|empty(M|bis)
.continue PCEXEC
..
!PCEXEC
.pc.exec 'U|xpfad'
..*****************************************************************************
!END
.continue

