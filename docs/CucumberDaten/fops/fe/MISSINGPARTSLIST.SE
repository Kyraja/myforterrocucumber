.set trans -
..
.. Fertigungskostenverbuchung an/aus
.copy M|fkkonfig = F|sysinfo(18)^fkkonfig
.. Materialkostenverbuchung an/aus
.copy M|bew      = F|sysinfo(18)^bew
..
.input "is/ABASFARBEN.DEF"
.formula M|farbe1 = "-1 -1 -1"
.formula M|farbe2 = U|xabaslightblue
..
.formula M|drrotz    = G|icokrit
.formula M|drgruenz  = G|icoukrit
.formula M|icon1z    = "icon:box"
.formula M|icon2z    = "icon:clock"
.formula M|lengmatz  = "icon:box_red"
.formula M|ldengmatz = "icon:date_disabled"
.formula M|lkenn     = "icon:folder_opened"
.formula M|prverfuegz = "icon:package_error"
..
.. interne Lagergruppe
.assign M|klgruppe  = F|sysinfo(10)^intlgruppe
..
!END
.continue
