..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FLEXQTY.AZ
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
...Includes       :
.. include fe/FLEXQTY.SET
..*****************************************************************************
.set trans -
.type text      xtsel        ? _F|defined(U|xtsel)
.type text      xtersteras   ? _F|defined(U|xtersteras)
.type text      xtletzteras  ? _F|defined(U|xtletzteras)
.type bool      xclose       ? _F|defined(U|xclose)
.type integer   xzeile         ? _F|defined(U|xzeile)
..
.formula U|xzeile = M|zn
..
!START
.copy U|xclose = G|FALSE ? G|evtvar = "mgeneu"
.continue END            ? _M|kenn2/"*/+-/*"
.continue CLOSE          ?  M|kenn2 = "-"
.formula M|kenn2 = "-"
.formula M|kenn  = M|icon9
..
.select workorder 'M|tba^id'
.continue ERROR1 ? _G|mehr
..
.. letzten Arbeitschein ermitteln
.formula U|xtersteras = H|nummer + "001"
.formula U|xtletzteras = H|nummer + "999"
.formula U|xtsel = "$,,nummer="+'U|xtersteras'+"!"+'U|xtletzteras'+";gruppe=1;@ablage=(Active);@ordnung=nummer"
.load 1 workorder 'U|xtsel'
.continue ADD
..
!WORKORDER
.load 1 workorder
..
!ADD
.continue COLOUR ? _G|mehr
.make screen line +O
.colour -background 'M|farbe2' 'M|aktzeile'
.formula M|kenn     = ""
.formula M|kenn2    = ""
.formula M|tba      = 1|nummer
.assign M|art       = 1|ag
.formula M|verw     = 1|verw
.. rckgemeldete Menge AS
.formula M|rueckmge = 1|rgutmge
.formula M|rueckmge = 1|gutmgeauto ? 1|gutmgeauto > 1|rgutmge
.formula M|ofmge    = 1|mge
.formula M|mgeneu   = 1|mge
.formula M|verlustmge = 1|rverlust
.protection mgeneu 'M|aktzeile'
.continue WORKORDER
..
!CLOSE
.continue END  ? M|kenn2 <> "-"
.copy U|xclose = G|TRUE  ? G|evtvar = "mgeneu"
.formula M|kenn2 = "+"
.formula M|kenn  = M|icon10
..
!HMZ
.select screen line
..
!HMZ2
.continue COLOUR ? _G|mehr
.continue COLOUR ? _F|empty(M|aufzu)
..
.make screen line -O
.continue HMZ2
..
!COLOUR: Farben setzen
.select screen header
..
!CLINE
.select screen line
.continue END  ? _G|mehr
.colour -background 'M|farbe1' 'M|aktzeile' ? _F|empty(M|aufzu)
.colour -background 'M|farbe2' 'M|aktzeile' ?  F|empty(M|aufzu)
..
.continue CLINE
..
!ERROR1
.error Kein Betriebsauftrag vorhanden.
.end 1
..
..*****************************************************************************
!END
.continue ATTENTION ? G|evtvar = "aufzu" 
.continue NEW       ? U|xclose = G|TRUE & G|evtvar = "mgeneu"
.continue
..
!NEW
.select screen header
.select screen line
.formula M|kenn2 = "+"
.formula M|splitt    = G|FALSE
.select screen line 'U|xzeile'
.continue START
..
!ATTENTION
.select screen header
.select screen line 'U|xzeile'
.input "fe/FLEXQTY.SET
.continue

