..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ISFERTIGUNG.GEDRUCKT
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : 
..*****************************************************************************
.set trans -
.continue END        ? P|vorschau
.continue END        ? F|empty(M|banummer^id)
.select modificationlock waitshort object 'M|banummer^id'
.continue FAILED     ? _G|mehr
.continue SUCCESS    ? P|erg=0
..
!FAILED: Print process failed
.copy M|statusz = M|rotz
.continue REWORK
..
!SUCCESS: Document was printed
.assign M|statusz = M|gruenz
.copy M|printable = G|FALSE
..
!OUTPUT
.output new "WERF.WEG"
.printed
.output
..
!REWORK
.select -
.action -
..*****************************************************************************
..
!END
.continue
..*****************************************************************************
