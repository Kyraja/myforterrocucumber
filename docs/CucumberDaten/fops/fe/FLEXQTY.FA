..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FLEXQTY.FA
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
.continue BA         ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "ba"
.continue ARTIKEL    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "artikel"
.continue BASIS      ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "basisartikel"
.continue DISPONENT  ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "betreuer"
.continue VERW       ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kverw"
.continue END
..
!DISPONENT
.continue TABLEEREN
..
!VERW
.continue TABLEEREN
..
!BA
.continue ERROR1 ? _F|empty(M|ba^snba)
.continue TABLEEREN
..
!ARTIKEL
.assign M|basisartikel = M|artikel^basisartikel ? _F|empty(M|artikel)
.continue TABLEEREN
!BASIS
.formula M|artikel = "" ? _F|empty(M|basisartikel)
.continue TABLEEREN
..
!TABLEEREN
.input "is/TABLEEREN"
.continue END
..
!ERROR1
.error Bitte einen Betriebsauftrag und keinen Arbeitsschein eintragen.
.formula M|ba = ""
.cursor ba 
.end 1
..*****************************************************************************
!END
.continue
