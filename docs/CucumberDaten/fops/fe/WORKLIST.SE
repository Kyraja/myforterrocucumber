..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : WORKLIST.SE
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Function       : Maskeneintritts-FOP fÅr IS WORKLIST
..                  Default-Werte setzen 
.. Functionality  : 
..
..*****************************************************************************
..Variablen
.type text xtsel ? _F|defined(U|xstsel)
..
.set trans -
.copy M|bdea   = F|sysinfo(18)^bdea
.copy M|autobd = F|sysinfo(18)^autobd
.copy M|ueberbuchen = G|TRUE
.copy M|matentn = G|TRUE
..
.continue ERROR  ? M|autobd
.continue ERROR2 ? _M|bdea
.. set colour
.input "is/ABASFARBEN.DEF"
.formula M|farbe1 = "-1 -1 -1"
.formula M|farbe2 = U|xabasmidgreen
.formula M|farbe3 = U|xabasyellow
.formula M|farbe4 = U|xabasmidred
..
.. Symbole der Legende 
.formula M|leg1  = "icon:flag_green"
.formula M|leg2  = "icon:flag_yellow"
.formula M|leg3  = "icon:box_red"
.formula M|leg4  = "icon:alarmclock"
.formula M|leg5  = "icon:media_play_green"
.formula M|leg6  = "icon:ball_green"
.formula M|leg7  = "icon:plus"
.formula M|leg8  = "icon:plus_black"
.formula M|leg9  = "icon:ball_red"
.formula M|leg10 = "icon:media_pause_green"
.formula M|leg12 = "icon:media_stop_green"
.formula M|leg11 = "icon:ok"     
.formula M|leg14 = "icon:about"
.formula M|leg13 = "icon:product"
.formula M|leg15 = "icon:text"
.formula M|leg16 = "icon:information"
..
.. Vorbelegung der Felder
.formula M|endegepl = G|datum & 20  ? _F|defined(M|scan)
.. Mitarbeiter aus der Passwortdefintion ziehen
.select add G|passw
.assign M|mitarb = H|mitarb  ? _F|empty(H|mitarb)
.assign M|mitarb = ""        ?  F|defined(M|scan)
.. prÅfen ob es eine Qualifikationsliste fÅr den Mitarbeiter gibt
.. es kann nur ein Liste pro Mitarbeiter geben, KernprÅfung
.continue NOMA ? F|defined(M|scan)
.continue NOMA ? F|empty(M|mitarb)
.formula U|xtsel = "$,,such=;ma="+'M|mitarb'+";@gruppe=3;@autostart=ja;"
.select qualifications 'U|xtsel'
.copy M|qualliste = G|TRUE   ?  G|mehr
.copy M|qualliste = G|FALSE  ? _G|mehr
..
!NOMA
.formula M|bdetext = ""
.formula M|bdestatus = ""
.continue NOPRUEF ? F|empty(M|mitarb)
.set trans +
.formula M|bdetext = "Mitarbeiter hat keine Lohngruppe"   ? M|mitarb^lohn = 0
.formula M|bdestatus = M|leg9                             ? M|mitarb^lohn = 0
.formula M|bdetext = "Mitarbeiter hat keinen Schichtplan" ? F|empty(M|mitarb^splan)
.set trans -
.formula M|bdestatus = M|leg9                             ? F|empty(M|mitarb^splan)  
!NOPRUEF
..
.. Zeitdauer fÅr Infosystem aktualisieren
.formula M|infoakt = 3  ? _F|defined(M|scan)
..
.. Konfiguration
.copy M|sicherheit = G|TRUE 
.. false: keine Sicherheitabfragen (.box -no:yes) bei KomplettrÅckmeldung, Abbruch, Maschinenstillstand
.. true:  Sicherheitsabfragen bei KomplettrÅckmeldung, Abbruch, Maschinenstillstand
.copy M|durchbuchen = G|TRUE
.. true: Die enstandenen BDE-Objekte werden beim Erfassen der Endzeit uebertragen. Es entsteht eine gebuchte RÅckmeldung
.. false: Die BDE-Objekte werden nicht Åbertragen
.continue END
..
!ERROR
.error Mit der Konfiguration "Automatisches Auftragsende" der Betriebsdatenerfassung ist das Infosystem nicht ausfÅhrbar!
.end 1
..
!ERROR2
.error In der Konfiguration muss der Kenner "Auftragszeiterfassung" aktiviert sein, da das Infosystem Auftragszeiten auswertet. 
.end 1
..
.. ****************************************************************************
!END: Programmende
.continue

