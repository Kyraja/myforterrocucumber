..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PRODLIST.UEBER
.. Datum          : 08.07.2006
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem, RÅckmeldung buchen
.. Ablauf         :
..*****************************************************************************
.set trans -
.type text xtkomm ? _F|defined(U|xtkomm)
..
.continue UEBER  ?  G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buchen2"
..
.continue BOX1    ? F|empty(M|buchenz)
.continue         ? F|empty(M|order)
..
.formula U|xtkomm = "<(Workorder)>"+M|order^id+"<(Transfer)>"
.command -wait 'U|xtkomm'
..
!UEBER
.formula M|buchenz  = "icon:ball_red"
..
.. Tabelle leeren, da gebucht wurde und sich die limge dadurch Ñndert
.input "is/TABLEEREN"
.continue NAECHST                   ? _F|empty(M|kba)
.continue HOLE
..
!NAECHST
.continue BALEEREN                  ? F|empty(M|kba)
.select add M|kba
.continue BALEEREN                  ? _G|mehr
.select -
.continue HOLE
..
!BALEEREN: BA und M|select leeren
.formula M|kba    = ""
.formula M|select = ""
.continue
..
!HOLE: Tabelle aktualisieren / neu aufbauen
.input "is/HOL.LISTE"
.continue
..
!BOX1
.box
Buchen nicht mîglich!
.continue
