.. Funktion       : Maschinenbelegung bearbeiten Aufruf Åber Infosystem
..                  Aufruf Åber Infosystem
.. Program flow   :
...Includes       :
..*****************************************************************************
..
.set trans -
.type text xtvon      ? _F|defined(U|xtvon)
.type text xtbis      ? _F|defined(U|xtbis)
.type text xkomm      ? _F|defined(U|xkomm)
..
.formula U|xtvon = M|adatum
.formula U|xtbis = M|edatum
..
.add M|mgr
.formula U|xkomm = "<(Workorder)> <(Edit)>,(MachineLoadingAndScheduling)"
.formula U|xkomm = U|xkomm + "? mgr=" + 'D|nummer' +  "|vom=" + U|xtvon + "|bis=" + U|xtbis + "|lgruppe=" + 'M|lgruppe' + "|ladetab="
.command -parallel 'U|xkomm'
.add
.continue

