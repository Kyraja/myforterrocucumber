..
..  Funktion       : Infosystem, Liste der bebuchbaren Kostenstellen
..                   Tabellezeigfop
..
..  Ablauf         : Nach dem Startbutton
..
..*****************************************************************************
..
.set trans -
.continue         ?  H|gruppe <> 2
.continue         ? _H|bu
.make screen line +
.formula M|kstelle = H|id
.add H|verd
.formula M|verd    = D|id ? G|mehr
.add
.formula M|hilfsks = H|hilfsks
.add H|bezug
.formula M|bezug   = D|id ? G|mehr
.add
.add H|einh
.formula M|einh    = D|id ? G|mehr
.add
.formula M|abk     = H|abk
.formula M|sald    = H|sald
.formula M|manam   = H|manam
.continue


