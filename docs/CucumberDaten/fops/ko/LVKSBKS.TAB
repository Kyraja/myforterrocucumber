.set trans -
.continue         ?  H|gruppe <> 2
..
.make screen line +
.formula U|xtvnum    = H|verd^id
.formula M|verd    = U|xtvnum
.formula M|kstelle = H|id
.formula M|bebu    = H|bu
.continue


