..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BABNEU.SETCOO
..  Autor          : male
..  Verantwortlich : tiwe
..
..  Kontrolle      : cl
..  Funktion       : Lesen der relevanten Kostenobjekte und setzen der Maskenfelder
..*****************************************************************************
.type integer  xil                      ? _F|defined(U|xil)
.type text xtvkst                   ? _F|defined(U|xtvkst)
.type text xtbkst                   ? _F|defined(U|xtbkst)
.type text xtvktr                   ? _F|defined(U|xtvktr)
.type text xtbktr                   ? _F|defined(U|xtbktr)
.type text xtvkst xtbkst            ? _F|defined(U|xtvkst)
.type text xtd2                     ? _F|defined(U|xtd2)
.type bool xbkstidnum xbktridnum    ? _F|defined(U|xbkstidnum)
.type integer  xikst                    ? _F|defined(U|xikst)
.type bool xktr xeinz               ? _F|defined(U|xktr)
..*****************************************************************************
..
.set trans -
.continue END ? G|evtartengl = "NO_EVENT"
..
.select year 'M|anfj' 'M|anfm' 'M|endm' ? M|anfj  = M|endj ; 'M|endj'  = ""
.select period 'M|von' 'M|bis'       ? M|anfj <> M|endj & 'M|endj' <> ""
..
.file -tempname U|xtd2
..
.formula U|xikst = 1
..*****************************************************************************
!INITCOO: Init cost objects
..*****************************************************************************
.formula M|kst.U|xikst    = ""
.formula U|xikst        = U|xikst + 1
.continue INITCOO        ? U|xikst < 21
..
.continue SKST ? F|fileexists(U|xtd2) & M|zaehl > 1
..
.system 'F|expr("rm -f " + U|xtd2)' background
.output new 'U|xtd2'
.input "DATEI.F"
..
..*****************************************************************************
!KTR1
..*****************************************************************************
.continue SELKTR1 ? _M|ktr
.load 1 accountdata 'F|expr(M|vktr + "!" + M|bktr)'
..
..*****************************************************************************
!KTR2
..*****************************************************************************
.continue SELKTR1 ? _G|mehr
.continue KTR3  ? 1|gruppe <> 4
.continue KTR3  ? _M|verdktr1 & _M|verdktr2 & _1|bebuchbar
.continue KTR3  ?  M|verdktr2 & 1|bebuchbar
.continue KTR3  ? 1|ssum=0 & 1|hsum=0 & M|bebuch
'1|id'
..
..*****************************************************************************
!KTR3
..*****************************************************************************
.load 1 continue
.continue KTR2
..
..*****************************************************************************
!SELKTR1
..*****************************************************************************
.continue KST1 ? M|ktrselect = ""
.load 1 'G|hdatname5' 'M|ktrselect'
..
..*****************************************************************************
!SELKTR2
..*****************************************************************************
.continue KST1  ? _G|mehr
.continue SELKTR3 ? 1|gruppe <> 4
.continue SELKTR3 ? _M|verdktr1 & _M|verdktr2 & _1|bebuchbar
.continue SELKTR3 ?  M|verdktr2 & 1|bebuchbar
.continue SELKTR3  ? 1|ssum=0 & 1|hsum=0 & M|bebuch
'1|id'
..*****************************************************************************
!SELKTR3
..*****************************************************************************
.load 1 continue
.continue SELKTR2
..
..*****************************************************************************
!KST1
..*****************************************************************************
.continue SELKST1 ? _M|kst
.load 1 'G|hdatname5' 'F|expr(M|vkst + "!" + M|bkst)'
..
..*****************************************************************************
!KST2
..*****************************************************************************
.continue SELKST1 ? _G|mehr
.continue KST3  ?  1|gruppe <> 2
.continue KST3  ? _M|verdkst1 & _M|verdkst2 & _1|bebuchbar
.continue KST3  ?  M|verdkst2 & 1|bebuchbar
.continue KST3  ? 1|ssum=0 & 1|hsum=0 & M|bebuch
'1|id'
..*****************************************************************************
!KST3
..*****************************************************************************
.load 1 continue
.continue KST2
..
..*****************************************************************************
!SELKST1
..*****************************************************************************
.continue PRO1 ? M|kstselect = ""
.load 1 'G|hdatname5' 'M|kstselect'
..
..*****************************************************************************
!SELKST2
..*****************************************************************************
.continue PRO1  ? _G|mehr
.continue SELKST3 ? 1|gruppe <> 2
.continue SELKST3 ? _M|verdkst1 & _M|verdkst2 & _1|bebuchbar
.continue SELKST3 ?  M|verdkst2 & 1|bebuchbar
.continue SELKST3  ? 1|ssum=0 & 1|hsum=0 & M|bebuch
'1|id'
..*****************************************************************************
!SELKST3
..*****************************************************************************
.load 1 continue
.continue SELKST2
..
..*****************************************************************************
!PRO1
..*****************************************************************************
.continue SELPRO1 ? _M|projekt
.load 1 'G|hdatname86' 'F|expr(M|vprojekt + "!" + M|bprojekt)'
..
..*****************************************************************************
!PRO2
..*****************************************************************************
.continue SELPRO1 ? _G|mehr
.continue PRO3  ?  1|gruppe <> 1
.continue PRO3  ? _M|verdprojekte1 & _M|verdprojekte2 & _1|bebuchbar
.continue PRO3  ?  M|verdprojekte2 & 1|bebuchbar
..continue PRO3  ? 1|ssum=0 & 1|hsum=0 & M|bebuch
'1|id'
..*****************************************************************************
!PRO3
..*****************************************************************************
.load 1 continue
.continue PRO2
..
..*****************************************************************************
!SELPRO1
..*****************************************************************************
.continue SGL1 ? M|projektselect = ""
.load 1 'G|hdatname86' 'M|projektselect'
..
..*****************************************************************************
!SELPRO2
..*****************************************************************************
.continue SGL1  ? _G|mehr
.continue SELPRO3 ? 1|gruppe <> 1
.continue SELPRO3 ? _M|verdprojekte1 & _M|verdprojekte2 & _1|bebuchbar
.continue SELPRO3 ?  M|verdprojekte2 & 1|bebuchbar
..continue SELPRO3  ? 1|ssum=0 & 1|hsum=0 & M|bebuch
'1|id'
..*****************************************************************************
!SELPRO3
..*****************************************************************************
.load 1 continue
.continue SELPRO2
..
..*****************************************************************************
!SGL1
..*****************************************************************************
.formula U|xikst = 0
..
..*****************************************************************************
!SGL2
..*****************************************************************************
.formula U|xikst = U|xikst + 1
.continue KSTE ?  U|xikst > 20
.continue SGL2 ? 'M|ekst.U|xikst' = ""
'F|eval("M|ekst.xikst^id")'
.continue SGL2
..
..*****************************************************************************
!KSTE: Alle Kostenstellen/traeger in xtd2 geschrieben
..*****************************************************************************
.output new WERF.WEG
.output terminal
..
.. make cost objects unique in file
.system 'F|expr("sort -u " + U|xtd2 + " -o " + U|xtd2)' background
..
.type text xtd3 ? _F|defined(U|xtd3)
.file -tempname U|xtd3
.output new 'U|xtd3'
.input "DATEI.F"
..
..*****************************************************************************
!WRT1
..*****************************************************************************
.select from 'U|xtd2' U|xtkst^
.continue WRT2 ? _G|mehr
.load 1 object 'U|xtkst'
.. no check for "more". If "more" is false
.. there is a critical error!
'1|id'#'1|nummer'#'1|gruppe'
.continue WRT1
..
..*****************************************************************************
!WRT2
..*****************************************************************************
.output new WERF.WEG
.output terminal
.system 'F|expr("sort -t# -k 3,3n -k 2,2n " + U|xtd3 + " -o " + U|xtd2)' background
..
..*****************************************************************************
!SKST: Kostenstellen/-traeger in der Maske setzen
..*****************************************************************************
.type integer  xistart  ? _F|defined(U|xistart)
.type integer  xiende   ? _F|defined(U|xiende)
.type integer  xiksti   ? _F|defined(U|xiksti)
.type text xtrest   ? _F|defined(U|xtrest)
..
.formula U|xistart = 1  + ((M|zaehl - 1) * 20)
.formula U|xistart = 1   ? U|xistart <= 0
.formula U|xiende  = 20 + ((M|zaehl - 1) * 20)
.formula U|xistart = 1   ? (U|xiende - U|xistart) > 19
.formula U|xiende  = 20  ? (U|xiende - U|xistart) > 19
.formula U|xikst   = 0
.continue SKST2
..
..*****************************************************************************
!SKST2
..*****************************************************************************
.formula U|xikst   = U|xikst + 1
.continue END       ? U|xikst > U|xiende
.select from 'U|xtd2' U|xtkst # U|xtrest^
.continue END       ? _G|mehr
.continue SKST2     ? U|xikst < U|xistart
.formula U|xiksti  = U|xikst - U|xistart + 1
.assign M|kst.U|xiksti    = 'U|xtkst'
.continue SKST2
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
