..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  :
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
..
..
..*****************************************************************************
..
.type text xtquery ? _F|defined(U|xtquery)
..
.set trans -
.formula U|xtquery = "$,@gruppe=2"
.formula U|xtquery = U|xtquery + ";bezug=" + 'H|id'
.formula U|xtquery = U|xtquery + ";bez1=" + 'H|id'
.formula U|xtquery = U|xtquery + ";bez2=" + 'H|id'
.formula U|xtquery = U|xtquery + ";bez3=" + 'H|id'
.formula U|xtquery = U|xtquery + ";bez4=" + 'H|id'
.formula U|xtquery = U|xtquery + ";bez5=" + 'H|id'
.formula U|xtquery = U|xtquery + ";@verknuepfung=oder"
..
.load 0 accountdata 'U|xtquery'
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.make screen line +O
.assign M|tbezgr       = H|id
.copy M|teinheit     = H|einheit
.assign M|tkst         = 0|id
.load 0 accountdata
.continue LOOP
..
..*****************************************************************************
!END: end
..*****************************************************************************
.continue
