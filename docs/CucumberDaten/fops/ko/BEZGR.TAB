..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BEZGR.TAB
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Tabellen-FOP des Infosystems ko/BEZGR
..  Functionality  :
..*****************************************************************************
..
.set trans -
..
.type AU18 xevkz1 xevkz2  ? _F|defined(U|xevkz1)
..
..*****************************************************************************
..
.. ist
.assign U|xevkz1  = "(66)"
.. plan
.assign U|xevkz2 = "(69)"
..
.make screen line +O
.assign M|tbezgr       = H|id
.copy M|teinheit     = H|einheit
..
.type integer xivkz ? _F|defined(U|xivkz)
..
.formula U|xivkz = 0
..
..*****************************************************************************
!LOOP1
..*****************************************************************************
.formula U|xivkz = U|xivkz + 1
.continue BALDEV ? U|xivkz > 2
..
.type text xtquery ? _F|defined(U|xtquery)
..
.formula U|xtquery = "$,@gruppe=3;gruppe=3"
.formula U|xtquery = U|xtquery + ";dart=" + 'U|xevkz.U|xivkz'
.formula U|xtquery = U|xtquery + ";bzsn=" + 'H|id'
.formula U|xtquery = U|xtquery + ";gjahr=" + 'M|ajahr'
..
.load 0 rsz 'U|xtquery'
.continue LOOP1 ? _G|mehr
..
.type integer ximon    ? _F|defined(U|ximon)
.type AU18 xedart ?  _F|defined(U|xedart)
..
.assign U|xedart = 0|dart
..
.formula U|ximon = M|amonat
..
..*****************************************************************************
!LOOP2
..*****************************************************************************
.continue LOOP1 ? U|ximon > M|emonat
..
.formula M|tis.U|ximon = 0|s.U|ximon ? U|xedart = U|xevkz1
.formula M|tps.U|ximon = 0|s.U|ximon ? U|xedart = U|xevkz2
..
.formula M|tisaldo = M|tisaldo + 0|s.U|ximon ? U|xedart = U|xevkz1
.formula M|tpsaldo = M|tpsaldo + 0|s.U|ximon ? U|xedart = U|xevkz2
..
.formula U|ximon = U|ximon + 1
.continue LOOP2
..
..*****************************************************************************
!BALDEV: Compute balance and deviation
..*****************************************************************************
.formula M|tabwabs = M|tisaldo - M|tpsaldo
.formula M|tabwrel = (M|tabwabs / M|tpsaldo) * 100 ? M|tabwabs < 0
.formula M|tabwrel = (M|tabwabs / M|tisaldo) * 100 ? M|tabwabs > 0
.continue END
..
..*****************************************************************************
..
..*****************************************************************************
!END: end
..*****************************************************************************
.continue
