..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KOSTENSAETZE.EV
.. Autor          : male
.. Verantwortlich : tiwe
.. Kontrolle      : mh
.. Funktion       : Event-FOP
.. Functionality  : Event FOP
..*****************************************************************************
..
..
..*****************************************************************************
..
.set trans -
..
.continue SHOWRULE ? G|evtvar = "tbreregel"
..
.make screen line --
..
.continue SELECT   ? G|evtvar = "bauswahl"
.continue START    ? G|evtvar = "bstart"
.continue RANGE    ? G|evtvar = "kstvon" ; G|evtvar = "kstbis"
.continue PERIOD   ? G|evtvar = "anfm"
.continue PERIOD   ? G|evtvar = "anfj"
.continue PERIOD   ? G|evtvar = "endm"
.continue PERIOD   ? G|evtvar = "endj"
.continue CURRENCY ? G|evtvar = "auswaehr"
.continue END
..
..*****************************************************************************
!RANGE: Cost object range changed
..*****************************************************************************
.formula M|fselect = G|false
.formula M|kstbis  = M|kstvon ? _F|empty(M|kstvon) & F|empty(M|kstbis) & G|evtvar = "kstvon"
.type text xpvon xpbis
.formula U|xpvon = "kstvon"
.formula U|xpbis = "kstbis"
.input "is/RANGECHECK"
.continue END
..
..*****************************************************************************
!CURRENCY: Output currency changed
..*****************************************************************************
.copy M|auswaehr = G|inland ? F|empty(M|auswaehr)
.continue END
..
..*****************************************************************************
!PERIOD
..*****************************************************************************
.input "fb/IS.SETPERIOD"
.formula M|anfm = F|month(M|von) ? M|anfm > 12
.formula M|endm = F|month(M|bis) ? M|endm > 12
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.continue ERR01 ? F|empty(M|reregel)
.formula M|select = M|kstvon + "!" + M|kstbis ? _M|fselect
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!SELECT
..*****************************************************************************
.formula M|kstvon = ""
.formula M|kstbis = ""
.formula G|evtfeldneu = "%,,nummer=;such=;@datenbank=" + 'M|datnr' + ";@gruppe=2;@dschutz=ja;@gschutz=ja;"
.input "is/AUSWAHL"
.formula M|fselect = (M|select <> "!")
.continue END
..
..*****************************************************************************
!SHOWRULE
..*****************************************************************************
.type ID87:9 xcallparam
.formula U|xcallparam = "52623"
.input "st/CALLPARAM.EXEC"
.continue END
..
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Bitte eintragen.
.cursor reregel
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
