..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : LKOKOA.TAB
..  Datum          : 30.08.2001
..  Version        :
..  Autor          : S.Riemer-MÅller
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Konten mit ihren Kostenarten
..                   Tabellenzeigfop
..
..  Ablauf         : Nach dem Startbutton - dazulesen der Kostenarten
..
..*****************************************************************************
.set trans -
.type text xtid xtnum xtname xtznum xtzname
..
.continue         ? H|tzeilen=0
..
.formula U|xtid        = H|id
.formula U|xtnum       = H|num
!HZ:
.select line
.continue         ? _G|mehr
.continue HZ      ? _(M|unguelt ; (H|koartvon <= G|datum & ('H|koartbis' = "" ; H|koartbis >= G|datum)))
.add H|zkoart
.formula U|xtznum      = D|num
.add
..
.make screen line +
.formula M|konto   = U|xtid
.formula M|koart   = U|xtznum
.formula M|gvon    = H|koartvon
.formula M|gbis    = H|koartbis
.continue HZ

