..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CODIST.EV
.. Author         : ankn
.. Verantwortlich : tiwe
.. Functionality  : Common event FOP of the Infosystem ko/CODIST
..*****************************************************************************
..
.set trans -
.type text xpvon xpbis
..
.continue START          ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar = "bstart"
.continue KVCHANGED      ? G|evtartengl = "FIELD_EXIT"    &  G|evtvar  = "kovervon"
..
..
..*****************************************************************************
!START: Infosystem start
..*****************************************************************************
.input "is/TABLEEREN"
.formula U|xpvon = "kovervon"
.formula U|xpbis = "koverbis"
.input "is/RANGECHECK"
..
.formula M|select = "$,"
.formula M|select = M|select + ";" + U|xxtfield + "=" + M|kovervon + "!" + M|koverbis
.formula M|select = M|select + ";@gruppe=8;gruppe=8"
.select 'G|hdatname5' 'M|select'
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.input 'M|tab'
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue LOOP
..
..*****************************************************************************
!KVCHANGED: Cost Distributor was changed
..*****************************************************************************
..
.copy M|koverbis = M|kovervon ? F|empty(M|koverbis)
.continue
..
..*****************************************************************************
!END
..*****************************************************************************
.end
