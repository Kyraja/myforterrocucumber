..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : COMPRULE.TAB
.. Author         : ankn
.. Verantwortlich : tiwe
.. Functionality  : Table FOP of the Infosystem ko/COMPRULE
..*****************************************************************************
..
.set trans -
..
.make screen line +O
..
.formula M|tregel   = H|id
.copy    M|toptyp   = H|optyp
.copy    M|tzproz   = H|proz
.formula M|tbaumstufe   = 1
..
..*****************************************************************************
!TABLINE
..*****************************************************************************
.select line
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.copy M|tkoart       = H|koart
.copy M|tbaumstat    = H|tbaumstat
.copy    M|tproz   = H|zproz
.formula M|tbaumstufe   = 1
.select line
.continue END ? _G|mehr
.make screen line +O
.continue LOOP
..
..*****************************************************************************
!END
.continue
