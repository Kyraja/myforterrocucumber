..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
..
.set trans -
..
.continue ME       ? G|evtartengl="SCREEN_ENTER"
.continue RICHTUNG ? G|evtartengl="FIELD_EXIT"    & G|evtvar="richtung"
.continue PRKST    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="kst"
.continue VGMON    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="vgmon"
.continue BGMON    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="bgmon"
.continue VKZ      ? G|evtartengl="BUTTON_AFTER" & G|evtvar = "buvkz" & M|zpm <> ""
.continue END
..
..*****************************************************************************
!ME: Maskeneintritt
..*****************************************************************************
.formula   M|auswahl = "1!"
.formula   M|select  = "1!"
.formula   M|irichtung = 1
.formula   M|richtung = "(65)"
.formula   M|kst = ""
.copy M|gjahr = G|gjahr
.formula   M|vgmon = 1
.formula   M|bgmon = 12
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!RICHTUNG
..*****************************************************************************
.formula M|irichtung = 1 ? 'M|richtung(L="0")' = "(65)"
.formula M|irichtung = 2 ? 'M|richtung(L="0")' = "(69)"
.continue END
..
..*****************************************************************************
!PRKST
..*****************************************************************************
.continue END ?  M|irichtung = 2
.continue END ? _F|empty(M|kst^umdef)
.error Kostenstelle hat keine Umlage !
.end 1
..
..*****************************************************************************
!VGMON
..*****************************************************************************
.continue END ? M|vgmon > 0 & M|vgmon < 13 & M|vgmon <= M|bgmon
.error Unzul„ssiger Zeitraum !
.end 1
..
..*****************************************************************************
!BGMON
..*****************************************************************************
.continue END ? M|bgmon > 0 & M|bgmon < 13 & M|bgmon >= M|vgmon
.error Unzul„ssiger Zeitraum !
.end 1
..
..*****************************************************************************
!VKZ
..*****************************************************************************
.type integer xi01 ? _F|defined(U|xi01)
.type integer xi02 ? _F|defined(U|xi02)
.type integer xi03 ? _F|defined(U|xi03)
..
.select screen header
.formula U|xi01 = M|vgmon
.formula U|xi02 = M|bgmon
..
.select screen line 'G|evtzeile'
..
.continue MVKZ ? M|zpm = "-"
..
.formula M|zpm = "-"
.formula U|xi03 = U|xi01
..
..*****************************************************************************
!VKZM: VKZ merken
..*****************************************************************************
.continue EVKZM ? U|xi03 > U|xi02
..
.type text xmon.xi03
.type real xist.xi03
.type real xpf.xi03
.type real xpp.xi03
..
.formula U|xmon.U|xi03 = M|mon.U|xi03
.formula U|xist.U|xi03 = M|ist.U|xi03
.formula U|xpf.U|xi03  = M|pf.U|xi03
.formula U|xpp.U|xi03  = M|pp.U|xi03
.formula U|xi03      = U|xi03 + 1
..
.continue VKZM
..*****************************************************************************
!EVKZM
..*****************************************************************************
..
.formula U|xi03 = U|xi01
..
..*****************************************************************************
!PVKZ
..*****************************************************************************
.continue END ? U|xi03 > U|xi02
.make screen line +O
.formula M|zmonat = U|xmon.U|xi03
.formula M|zist   = U|xist.U|xi03
.formula M|zpf    = U|xpf.U|xi03
.formula M|zpp    = U|xpp.U|xi03
.formula U|xi03   = U|xi03 + 1
.continue PVKZ
..
..*****************************************************************************
!MVKZ
..*****************************************************************************
.formula U|xi03  = U|xi02 - U|xi01
.formula M|zpm = "+"
..
.select screen line
..
..*****************************************************************************
!ZRVKZ: Folgezeilen raus
..*****************************************************************************
.continue END ? U|xi03 <  0
.make screen line -O
.formula U|xi03 = U|xi03 - 1
.continue ZRVKZ
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
