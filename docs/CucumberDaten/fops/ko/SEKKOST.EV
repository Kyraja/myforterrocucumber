..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
.. Funktion       : Event-FOP im INFO-System "ko/SEKKOST"
..*****************************************************************************
..
.set trans -
..
.continue ME       ? G|evtartengl="SCREEN_ENTER"
.continue RICHTUNG ? G|evtartengl="FIELD_EXIT"    & G|evtvar="richtung"
.continue VGMON    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="vgmon"
.continue BGMON    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="bgmon"
..
.continue VKZ      ? G|evtartengl="BUTTON_AFTER" & G|evtvar = "buvkz" & M|zpm <> ""
.continue IBUNW    ? G|evtartengl="BUTTON_AFTER" & G|evtvar = "istbn"
.continue IKONW    ? G|evtartengl="BUTTON_AFTER" & G|evtvar = "istkn"
.continue PBUNW    ? G|evtartengl="BUTTON_AFTER" & G|evtvar = "pbn"
.continue PKONW    ? G|evtartengl="BUTTON_AFTER" & G|evtvar = "pkn"
..
.continue END
..
..*****************************************************************************
!ME: Maskeneintritt
..*****************************************************************************
.formula   M|auswahl = "1!"
.formula   M|select  = "1!"
.formula   M|irichtung = 2
.formula   M|richtung = "(69)"
.copy M|gjahr = G|gjahr
.formula   M|vgmon = 1
.. Anzahl Gesch„ftsmonate im GJahr ermitteln
.select company "$,gruppe=12;@gruppe=12"
..*****************************************************************************
!GJ
..*****************************************************************************
.select line
.continue EGJ ? _G|mehr
.continue GJ ? G|gjahr <> H|gjahr
.formula M|bgmon = H|anzgmon
.continue NGJ
..*****************************************************************************
!EGJ
..*****************************************************************************
.formula M|bgmon = 12
..
..*****************************************************************************
!NGJ
..*****************************************************************************
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!RICHTUNG
..*****************************************************************************
.formula M|irichtung = 1 ? 'M|richtung(L="0")' = "(65)"
.formula M|irichtung = 2 ? 'M|richtung(L="0")' = "(69)"
.continue END
..
..*****************************************************************************
!VGMON
..*****************************************************************************
.continue END ? M|vgmon > 0 & M|vgmon < 13 & M|vgmon <= M|bgmon
.error Unzul„ssiger Zeitraum !
.end 1
..
..*****************************************************************************
!BGMON
..*****************************************************************************
.continue END ? M|bgmon > 0 & M|bgmon < 13 & M|bgmon >= M|vgmon
.error Unzul„ssiger Zeitraum !
.end 1
..
..*****************************************************************************
!VKZ
..*****************************************************************************
.type integer xi01   ? _F|defined(U|xi01)
.type integer xi02   ? _F|defined(U|xi02)
.type integer xi03   ? _F|defined(U|xi03)
..
.select screen header
.formula U|xi01 = M|vgmon
.formula U|xi02 = M|bgmon
..
.select screen line 'G|evtzeile'
..
.continue MVKZ ? M|zpm = "-"
..
.formula M|zpm = "-"
.formula U|xi03 = U|xi01
..
..*****************************************************************************
!VKZM: VKZ merken
..*****************************************************************************
.continue EVKZM ? U|xi03 > U|xi02
..
.type text xmon.xi03
.type real xistmge.xi03
.type real xistwert.xi03
.type real xpfmge.xi03
.type real xpfwert.xi03
.type real xppmge.xi03
.type real xppwert.xi03
..
.formula U|xmon.U|xi03     = M|mon.U|xi03
.formula U|xistmge.U|xi03  = M|istmge.U|xi03
.formula U|xistwert.U|xi03 = M|istwert.U|xi03
.formula U|xpfmge.U|xi03   = M|pfmge.U|xi03
.formula U|xpfwert.U|xi03  = M|pfwert.U|xi03
.formula U|xppmge.U|xi03   = M|ppmge.U|xi03
.formula U|xppwert.U|xi03  = M|ppwert.U|xi03
.formula U|xi03      = U|xi03 + 1
..
.continue VKZM
..*****************************************************************************
!EVKZM
..*****************************************************************************
..
.formula U|xi03 = U|xi01
..
..*****************************************************************************
!PVKZ
..*****************************************************************************
.continue END ? U|xi03 > U|xi02
.make screen line +O
.formula M|zmonat   = U|xmon.U|xi03
.formula M|zistmge  = U|xistmge.U|xi03
.formula M|zistwert = U|xistwert.U|xi03
.formula M|zpfmge   = U|xpfmge.U|xi03
.formula M|zpfwert  = U|xpfwert.U|xi03
.formula M|zppmge   = U|xppmge.U|xi03
.formula M|zppwert  = U|xppwert.U|xi03
.formula M|zpwert   = M|zpfwert + M|zppwert
.formula U|xi03   = U|xi03 + 1
.continue PVKZ
..
..*****************************************************************************
!MVKZ
..*****************************************************************************
.formula U|xi03  = U|xi02 - U|xi01
.formula M|zpm = "+"
..
.select screen line
..
..*****************************************************************************
!ZRVKZ: Folgezeilen raus
..*****************************************************************************
.continue END ? U|xi03 <  0
.make screen line -O
.formula U|xi03 = U|xi03 - 1
.continue ZRVKZ
..
..*****************************************************************************
!IBUNW
..*****************************************************************************
.continue END ? F|empty(M|kszu) ; F|empty(M|ksab)
.type text xbef ? _F|defined(U|xbef)
..
.formula U|xbef='G|kkomname38'+ " SEKBUNW" + " ? "
.formula U|xbef=U|xbef + "   kszu="   + 'M|kszu^id'
.formula U|xbef=U|xbef + " | ksab="   + 'M|ksab^id'
.formula U|xbef=U|xbef + " | gjahr="  + 'M|gjahr'
.formula U|xbef=U|xbef + " | vgmon="  + 'M|vgmon'
.formula U|xbef=U|xbef + " | bgmon="  + 'M|bgmon'
.formula U|xbef=U|xbef + " | vkzart=(73)"
.formula U|xbef=U|xbef + " | bstart="
..
.command -parallel 'U|xbef'
..
.continue END
..
..*****************************************************************************
!IKONW
..*****************************************************************************
.continue END ? F|empty(M|kszu) ; F|empty(M|ksab)
.type text xbef ? _F|defined(U|xbef)
..
.formula U|xbef='G|kkomname38' + " SEKKONW" + " ? "
.formula U|xbef=U|xbef + "   kszu="   + 'M|kszu^id'
.formula U|xbef=U|xbef + " | ksab="   + 'M|ksab^id'
.formula U|xbef=U|xbef + " | gjahr="  + 'M|gjahr'
.formula U|xbef=U|xbef + " | vgmon="  + 'M|vgmon'
.formula U|xbef=U|xbef + " | bgmon="  + 'M|bgmon'
.formula U|xbef=U|xbef + " | vkzart=(73)"
.formula U|xbef=U|xbef + " | bstart="
..
.command -parallel 'U|xbef'
..
.continue END
..
..*****************************************************************************
!PBUNW
..*****************************************************************************
.continue END ? F|empty(M|kszu) ; F|empty(M|ksab)
.type text xbef ? _F|defined(U|xbef)
..
.formula U|xbef='G|kkomname38' + " SEKBUNW" + " ? "
.formula U|xbef=U|xbef + "   kszu="   + 'M|kszu^id'
.formula U|xbef=U|xbef + " | ksab="   + 'M|ksab^id'
.formula U|xbef=U|xbef + " | gjahr="  + 'M|gjahr'
.formula U|xbef=U|xbef + " | vgmon="  + 'M|vgmon'
.formula U|xbef=U|xbef + " | bgmon="  + 'M|bgmon'
.formula U|xbef=U|xbef + " | vkzart=(80)"
.formula U|xbef=U|xbef + " | bstart="
..
.command -parallel 'U|xbef'
..
.continue END
..
..*****************************************************************************
!PKONW
..*****************************************************************************
.continue END ? F|empty(M|kszu) ; F|empty(M|ksab)
.type text xbef ? _F|defined(U|xbef)
..
.formula U|xbef='G|kkomname38' + " SEKKONW" + " ? "
.formula U|xbef=U|xbef + "   kszu="   + 'M|kszu^id'
.formula U|xbef=U|xbef + " | ksab="   + 'M|ksab^id'
.formula U|xbef=U|xbef + " | gjahr="  + 'M|gjahr'
.formula U|xbef=U|xbef + " | vgmon="  + 'M|vgmon'
.formula U|xbef=U|xbef + " | bgmon="  + 'M|bgmon'
.formula U|xbef=U|xbef + " | vkzart=(80)"
.formula U|xbef=U|xbef + " | bstart="
..
.command -parallel 'U|xbef'
..
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

