..!interpreter english translate
..*****************************************************************************
..  Autor          : S.Riemer-MÅller
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Betriebsabrechnungsbogen neu, Berichtskopf
..
..*****************************************************************************
.set trans -
..
.type real xrwert              ? _F|defined(U|xrwert)
.type text xtkoartid xtkst     ? _F|defined(U|xtkoartid)
.type text xtznum xtzart       ? _F|defined(U|xtznum)
.type bool xbeu                ? _F|defined(U|xbeu)
.type P94:1 xbwaehr            ? _F|defined(U|xbwaehr)
.type text xtd1                ? _F|defined(U|xtd1)
.type text xtlkoartid          ? _F|defined(U|xtlkoartid)
.type text xtartint            ? _F|defined(U|xtartint)
.type P60:1.2 xpkoart          ? _F|defined(U|xpkoart)
.type integer xiksti               ? _F|defined(U|xiksti)
.type integer xikoart              ? _F|defined(U|xikoart)
.type integer xibaumstufe          ? _F|defined(U|xibaumstufe)
.type date xxwdat             ? _F|defined(U|xxwdat)
.type realx xxvnkurs           ? _F|defined(U|xxvnkurs)
.type B1  xbclosed             ? _F|defined(U|xbclosed)
..
.select year 'M|endj'
.formula U|xxvnkurs = F|fxrate(M|waehr, G|edatum, F|condexpr(_F|empty(G|bueuro) & _F|empty(G|eurokurs) & _F|empty(G|auebereuro), F|condexpr(G|adatum >= G|bueuro, G|ninland, G|ainlang), G|inland))
..
.continue EXCEL   ? 'M|atyp(L=":")' = "(Excel)"
.continue BILD    ? 'M|atyp(L=":")' = "(Terminal)"
.continue BROWSER ? 'M|atyp(L=":")' = "(Browser)"
.continue DRUCKER ? 'M|atyp(L=":")' = "(Printer)"
.continue WORD    ? 'M|atyp(L=":")' = "(Word)"
.continue END
..
.continue END     ? G|evtzeile > 0
..
..*****************************************************************************
!BILD:
..*****************************************************************************
.continue END
..
