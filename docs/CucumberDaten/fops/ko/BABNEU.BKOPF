..
..*****************************************************************************
!EXCEL:
..*****************************************************************************
.type integer xint                                                                             ?_F|defined(U|xint)
.type text xtext1 xtext2 xtext3 xtext4 xtext5 xtext6 xtext7 xtext8 xtext9 xtext10 xtext11  ?_F|defined(U|xtext1)
.type text xtkst1 xtkst2 xtkst3 xtkst4 xtkst5 xtkst6 xtkst7 xtkst8 xtkst9 xtkst10          ?_F|defined(U|xkst1)
.type text xtkst11 xtkst12 xtkst13 xtkst14 xtkst15 xtkst16 xtkst17 xtkst18 xtkst19 xtkst20 ?_F|defined(U|xkst11)
.set trans +
.formula U|xtext1  ="INFOSYSTEM BETRIEBSABRECHNUNGSBOGEN"
.formula U|xtext2  ="BAB-Formular"
.formula U|xtext3  ="GeschÑftsjahr"
.formula U|xtext4  ="GeschÑftsmonat von"
.formula U|xtext5  ="bis"
.formula U|xtext6  ="WÑhrung"
.formula U|xtext7  ="Kostenart"
.formula U|xtext8  ="Kostenartbez"
.formula U|xtext9  ="VkzArt"
.formula U|xtext10 ="Kst/Ktr" + " "
.formula U|xtext11 ="Z-Summe"
.set trans -
.formula U|xint    = 1
.formula U|xtlang  =""
..
..*****************************************************************************
!EXLOOP:
..*****************************************************************************
.continue EXWEITER ? (U|xint > 20)
.formula U|xtkst.U|xint = 'U|xtext10' +" "+ 'M|kst.U|xint'
.formula U|xint       = U|xint + 1
.continue EXLOOP
..
..*****************************************************************************
!EXWEITER:
..*****************************************************************************
.type text xthdb  ?_F|defined(U|xthdb)
.output E
.set decpoint 'G|dezpunkt'
.set thoussep 'G|tsdtrenn'
.input EXCEL.F
.. Zellenformat : Text
...fo xthdb = "[SELECT(" + dblquote + "C2:C3" + dblquote + ")]"
.formula U|xthdb = "[SELECT(" + G|dblquote + G|ddecol + "1:" + G|ddecol + "3" + G|dblquote + ")]"
.dde.exec 'G|ddekanal' 'U|xthdb'
.formula U|xthdb = "[FORMAT.NUMBER(" + G|dblquote + "@" + G|dblquote + ")]"
.dde.exec 'G|ddekanal' 'U|xthdb'
.. Zellenformat : Zahl
.formula U|xthdb = "[SELECT(" + G|dblquote + G|ddecol + "4:" + G|ddecol + "24" + G|dblquote + ")]"
.dde.exec 'G|ddekanal' 'U|xthdb'
.formula U|xthdb = "[FORMAT.NUMBER(" + G|dblquote + "#.##0,00" + G|dblquote + ")]"
.dde.exec 'G|ddekanal' 'U|xthdb'
..
'mandant';'U|xtext1';'datum'  'zeit'

'U|xtext2' :'M|babform'
'U|xtext3' :'M|anfj';'U|xtext4' :'M|anfm' 'U|xtext5' :'M|endm';'U|xtext6' :'M|waehr'

'U|xtext7';'U|xtext8';'U|xtext9';'U|xtkst1';'U|xtkst2';'U|xtkst3';'U|xtkst4';'U|xtkst5';'U|xtkst6';'U|xtkst7';'U|xtkst8';'U|xtkst9';'U|xtkst10';'U|xtkst11';'U|xtkst12';'U|xtkst13';'U|xtkst14';'U|xtkst15';'U|xtkst16';'U|xtkst17';'U|xtkst18';'U|xtkst19';'U|xtkst20';'U|xtext11'
.continue END
