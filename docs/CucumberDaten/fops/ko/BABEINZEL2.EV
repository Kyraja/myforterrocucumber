..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BABEINZEL2.EV
..  Autor          : male
..  Verantwortlich : tiwe
..
..  Kontrolle      : mh
..  Funktion       : Allgemeines Event-FOP des Infosystemens ko/BABEINZEL2
..  Functionality  : Common event FOP of the Infosystem ko/BABEINZEL2
..
.. include ko/BABEINZEL.COLORS
..
..*****************************************************************************
..
.set trans -
..
.type integer  xiz
..
..*****************************************************************************
.continue START   ? G|evtartengl = "BUTTON_BEFORE" & (G|evtvar="bstart" ; G|evtvar = "tbaumaufzu")
.continue VKZART  ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar/("bvkzart(0-9)*")
.continue PERIOD  ? G|evtvar/("anfm(0-9)*")
.continue PERIOD  ? G|evtvar/("endm(0-9)*")
.continue PERIOD  ? G|evtvar/("anfj(0-9)*")
.continue PERIOD  ? G|evtvar/("endj(0-9)*")
.continue PYEAR   ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar="bvorjahr"
.continue YPLUS   ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar="bjahrplus"
.continue YMINUS  ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar="bjahrminus"
.continue SETOFBOOKS ? G|evtvar = "bukreis"
.continue OUTCURR    ? G|evtvar = "auswaehr"
.continue POSTCURR   ? G|evtvar = "buwaehr"
.continue END
..
..*****************************************************************************
!SETOFBOOKS
..*****************************************************************************
.input "is/EVT.FIELD.SETOFBOOKS"
.continue END
..
..*****************************************************************************
!OUTCURR
..*****************************************************************************
.input "is/EVT.FIELD.OUTCURR"
.continue END
..
..*****************************************************************************
!POSTCURR
..*****************************************************************************
.input "is/EVT.FIELD.POSTCURR"
.continue END
..
..*****************************************************************************
!VKZART
..*****************************************************************************
.type text xi
.type integer  xienumcount
.type text xtenumfield
.type integer  xienumentry1 xienumentry2 xienumentry3
.type integer  xienumentry4 xienumentry5 xienumentry6
.type integer  xienumentry7
.formula U|xi        = G|evtvar >> 2
.formula U|xi        = U|xi     >> 1 ? _U|xi/("(0-9)(0-9)")
.formula U|xtenumfield  = "vkzart" + U|xi
..
.continue PI ?  M|piv
.continue SI ? _M|piv
..
..*****************************************************************************
!PI
..*****************************************************************************
.formula U|xienumcount  = 6
.. Istko
.formula U|xienumentry1 = 4
.. SIAabs
.formula U|xienumentry2 = 9
.. SIArel
.formula U|xienumentry3 = 10
.. Plfix
.formula U|xienumentry4 = 6
.. Plprop
.formula U|xienumentry5 = 7
.. Plan
.formula U|xienumentry6 = 2
.continue ENUMM
..
..*****************************************************************************
!SI
..*****************************************************************************
.formula U|xienumcount  = 7
.. Istko
.formula U|xienumentry1 = 4
.. Soll
.formula U|xienumentry2 = 3
.. SIAabs
.formula U|xienumentry3 = 9
.. SIArel
.formula U|xienumentry4 = 10
.. Plfix
.formula U|xienumentry5 = 6
.. Plprop
.formula U|xienumentry6 = 7
.. Plan
.formula U|xienumentry7 = 2
.continue ENUMM
..
..*****************************************************************************
!ENUMM: Show menu
..*****************************************************************************
.input "is/ENUMMENU"
.formula M|use.U|xi = G|true ? G|menue > 0
.input "is/TABLEEREN"     ? G|menue > 0
.continue END
..
..*****************************************************************************
!PERIOD: Setting of the period (from and to)
..*****************************************************************************
.type bool xxbknbm
.type text xi
.type text xxtsmon xxtemon xxtsyear xxteyear xxtfromd xxttod
..
.formula U|xxbknbm   = G|true
.formula U|xi        = G|evtvar >> 2
.formula U|xi        = U|xi     >> 1 ? _U|xi/("(0-9)(0-9)")
.formula U|xxtsmon   = "anfm" + U|xi
.formula U|xxtemon   = "endm" + U|xi
.formula U|xxtsyear  = "anfj" + U|xi
.formula U|xxteyear  = "endj" + U|xi
.formula U|xxtfromd  = "von"  + U|xi
.formula U|xxttod    = "bis"  + U|xi
.input "fb/IS.SETPERIOD"
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!YPLUS: Increase year
..*****************************************************************************
.type integer xistep
.formula U|xistep = 1
.input "ko/BABEINZEL2.INC.PERIODS"
.continue END
..
..*****************************************************************************
!YMINUS: Decrease year
..*****************************************************************************
.type integer xistep
.formula U|xistep = -1
.input "ko/BABEINZEL2.INC.PERIODS"
.continue END
..
..*****************************************************************************
!PYEAR: Sets the periods with each month of the previous fiscal year
..*****************************************************************************
.select period 'G|datum'
.select company "$,@gruppe=12"
.continue END ? _G|mehr
..*****************************************************************************
!PYL: loop over rows
..*****************************************************************************
.select line
.continue END  ? _G|mehr
.continue PYL  ? H|gjahr <> G|ejahr
.continue END  ? H|aktzeile < 2
.select line 'F|expr(H|aktzeile - 1)'
.type GJ xgjahr
.formula U|xgjahr = H|gjahr
.select
.input "ko/BABEINZEL2.SET.PERIODS"
.continue END
..
..*****************************************************************************
!START: Start infosystem
..*****************************************************************************
.continue ERR01     ? M|babform = ""
.continue ERR04     ? M|kstktr  = ""
.continue ERR03     ? M|waehr   = ""
..
.type integer xi
.type text xtvar
.formula U|xi = 0
..*****************************************************************************
!CHKLOOP
..*****************************************************************************
.formula U|xi = U|xi + 1
.continue CHKEND  ? U|xi > M|maxper
.continue CHKLOOP ? _(M|use.U|xi)
.formula U|xtvar = "endm" + 'U|xi'
.continue ERR02   ? M|bis.U|xi < M|von.U|xi
.continue CHKLOOP
..
..*****************************************************************************
!CHKEND
..*****************************************************************************
.input "is/TABLEEREN" ? G|evtvar = "bstart"
..
.formula U|xiz=1
..*****************************************************************************
!BV1:
..*****************************************************************************
.continue BV3   ? G|evtzeile = 0
.continue CLOSE ? 'M|tbaumstat(L="0")' = "(45)"
..
..*****************************************************************************
!BV3
..*****************************************************************************
.continue HOL
..
..*****************************************************************************
!HOL
..*****************************************************************************
.formula M|datnr  = 63
.formula M|grp    = 2
.formula M|select = M|babform^id
.input "is/HOL.LISTE"
.continue SETCOL
..
..*****************************************************************************
!SETCOL
..*****************************************************************************
.input "ko/BABEINZEL.COLORS"
.continue END
..
..*****************************************************************************
!CLOSE: close tree node
..*****************************************************************************
.type integer xibaumstufe
.formula U|xibaumstufe = M|tbaumstufe
.assign M|tbaumstat = "(43)"
.select screen line
.continue SETCOL ? _G|mehr
..
..*****************************************************************************
!CLOOP
..*****************************************************************************
.continue SETCOL ? M|tbaumstufe <= U|xibaumstufe
.make screen line -O
.continue CLOOP
..
..*****************************************************************************
!END:
..*****************************************************************************
.continue
..
..
..*****************************************************************************
!ERR01:
..*****************************************************************************
.error Kein BAB-Formular ausgew„hlt.
.cursor babform 0
.end 1
..
..*****************************************************************************
!ERR02:
..*****************************************************************************
.error Ungltiger Zeitraum.
.cursor 'U|xtvar' 0
.end 1
..
..*****************************************************************************
!ERR03:
..*****************************************************************************
.error Keine W„hrung gew„hlt.
.cursor waehr 0
.end 1
..
..*****************************************************************************
!ERR04:
..*****************************************************************************
.error Kein(e) Kostenstelle/-tr„ger gew„hlt.
.cursor kstktr 0
.end 1

