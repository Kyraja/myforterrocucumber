..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BABEINZEL2.TAB
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Tabellen-FOP des Infosystem ko/BABEINZEL2
..  Functionality  : Table FOP of the Infosystem ko/BABEINZEL2
..*****************************************************************************
..
.set trans -
..
.type integer   xibaumstufe   ? _F|defined(U|xibaumstufe)
.type integer   xizeile       ? _F|defined(U|xizeile)
.type integer   xidataindex   ? _F|defined(U|xidataindex)
.type integer   xidatacnt     ? _F|defined(U|xidatacnt)
.type bool  xbclosed      ? _F|defined(U|xbclosed)
..*****************************************************************************
..
.continue END        ? H|tzeilen=0
..
.formula U|xidataindex = 0
.formula U|xidatacnt   = 0
..
..*****************************************************************************
!DLOOP
..*****************************************************************************
.formula U|xidataindex = U|xidataindex + 1
.continue END   ?  U|xidataindex > M|maxper
.continue DLOOP ? _(M|use.U|xidataindex)
.continue DLOOP ? 'M|vkzart.U|xidataindex' = ""
.continue DLOOP ? 'M|anfm.U|xidataindex'   = ""
.continue DLOOP ? 'M|endm.U|xidataindex'   = ""
.continue DLOOP ? 'M|anfj.U|xidataindex'   = ""
.continue DLOOP ? 'M|endj.U|xidataindex'   = ""
..
.formula U|xidatacnt = U|xidatacnt + 1
.select screen header               ? G|evtzeile < 1
.select screen line 'G|evtzeile' ? G|evtzeile > 0
..
.select header
..
.continue BABZ  ? G|evtzeile = 0
.continue ZEILE
..
..*****************************************************************************
!BABZ: Zeilen des BAB-Formulars lesen
..*****************************************************************************
.load 2
.select line
..
.continue DLOOP  ? _G|mehr
.continue BABZ   ? +H|koart = 0
.continue HKOART ?  H|koart^gruppe <> 2
..
..*****************************************************************************
!HKOART: Kostenart oder Rechenregel in Puffer 2 laden
..*****************************************************************************
.continue ZEILE ? G|evtzeile > 0
.formula U|xbclosed = H|closed
.load 2 cotype 'F|expr("$,@gruppe=7;id=" + H|koart^id)' ?  M|strukturauf & H|koart^gruppe  = 2 & _U|xbclosed
.load 2 add H|koart                                   ? _M|strukturauf ; H|koart^gruppe <> 2 ;  U|xbclosed
.continue INIT
..
..*****************************************************************************
!ZEILE: Zeilenevent
..*****************************************************************************
.continue END ? 'M|tkoart' = ""
.continue END ?  M|tkoart^gruppe <> 2
.formula U|xibaumstufe = M|tbaumstufe + 1
.formula U|xbclosed    = G|false
.load 2 cotype 'M|tkoart^id'
.continue INIT
..
..*****************************************************************************
!INIT: Initialisiere Puffer 2 (Kostenart oder Rechenregel) mit Parametern
..*****************************************************************************
.formula   2|anjahr     = M|anfj.U|xidataindex
.formula   2|endjahr    = M|endj.U|xidataindex
.formula   2|anmon      = M|anfm.U|xidataindex
.formula   2|endmon     = M|endm.U|xidataindex
.copy 2|koobj      = M|kstktr
.copy 2|waehr      = M|buwaehr
.copy 2|selbukreis = M|bukreis
..
.. direkt Kopfdaten einfuegen, wenn gestartet wird
.continue INSERT ? G|evtzeile = 0
.. sonst die Daten der Tabelle einfuegen (aufklappen)
..
..*****************************************************************************
!NKOART: Naechste Kostenart aus Zeile lesen (bei Tabellenevent oder Struktur)
..*****************************************************************************
.load 2 line
.. naechste Zeile des BAB, falls durch Startbutton ausgeloest
.continue BABZ   ? _G|mehr & G|evtzeile = 0
.. Ende falls durch Tabellenbutton ausgeloest
.continue DLOOP  ? _G|mehr
.continue INSERT ? '2|koart' = ""
.continue INSERT ?  2|koart^gruppe <> 2
..
..*****************************************************************************
!INSERT: Daten einfuegen
..*****************************************************************************
.select screen line     ? U|xidatacnt > 1
.make screen line +O ? U|xidatacnt = 1
.formula U|xizeile    = 2|aktzeile ? 2|gruppe  = 2
.formula U|xizeile    = 0          ? 2|gruppe <> 2
.continue INSDATA      ? U|xidatacnt > 1
.formula M|tbaumstufe = F|condexpr(U|xizeile > 0, 1 + 2|tbaumstufe, 1) ? G|evtzeile = 0
.formula M|tbaumstufe = U|xibaumstufe                                  ? G|evtzeile > 0
.assign M|tkoart   = F|condexpr(U|xizeile > 0, 2|koart^id, 2|id)
.formula M|tleerzeile = 'M|tkoart^optyp(L=":")'="(BlankLine)"
.formula   M|tgruppe   = M|tkoart^gruppe
..
.. -
.assign M|tbaumstat = "(45)" ? M|tkoart^gruppe  = 2 &  G|evtzeile = 0 &  M|strukturauf & _U|xbclosed
.. +
.assign M|tbaumstat = "(43)" ? M|tkoart^gruppe  = 2 & (G|evtzeile > 0 ; _M|strukturauf ; U|xbclosed)
.assign M|tbaumstat = "(0)"  ? M|tkoart^gruppe <> 2
.assign M|tbaumstat = "(0)"  ? 'M|tkoart^optyp(L=":")'="(BlankLine)"
..
..*****************************************************************************
!INSDATA
..*****************************************************************************
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|ikum, 2|kikum)         ? M|vkzartn.U|xidataindex = 65
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|pfixkum, 2|kpfixkum)   ? M|vkzartn.U|xidataindex = 67
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|ppropkum, 2|kppropkum) ? M|vkzartn.U|xidataindex = 68
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|pfixkum, 2|kpfixkum)                         ? M|vkzartn.U|xidataindex = 80
.formula M|twert.U|xidataindex = M|twert.U|xidataindex + F|condexpr(U|xizeile > 0, 2|ppropkum, 2|kppropkum) ? M|vkzartn.U|xidataindex = 80
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|skum, 2|kskum)         ? M|vkzartn.U|xidataindex = 83
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|siakum, 2|ksiakum)     ? M|vkzartn.U|xidataindex = 71
.formula M|twert.U|xidataindex = F|condexpr(U|xizeile > 0, 2|sirkum, 2|ksirkum)     ? M|vkzartn.U|xidataindex = 72
..
.formula M|twert.U|xidataindex = F|fxamount(M|auswaehr, M|twert.U|xidataindex, M|bis.U|xidataindex, 2|waehr)
..
.continue BABZ     ?  2|pugruppe <> 7 & G|evtzeile = 0
.continue NKOART   ?  2|pugruppe  = 7 ; G|evtzeile > 0
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
