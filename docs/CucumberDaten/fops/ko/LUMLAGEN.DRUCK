!START
..
.set trans +
.continue ? M|tzeilen = 0
..
.type text xt01 xt02
..
.input DRUCKER1
.input BLANKOB.F ?  -geraet <> "E"
.input EXCEL.F   ?  -geraet =  "E"
..
.continue EXC01  ?  -geraet = "E"
..
.page 1
.set decpoint ,
.set thoussep .
.up
'Mandant          '                                Liste der Umlagen                  '   datum'               Seite'  sei'
'txname           '                                =================                   '   zeit'

                                                 Zeitraum: 'M|vgmon'/'M|gjahr' - 'M|bgmon'/'M|gjahr'
                                        Leistungsrichtung: 'M|richtung'
?                                                FÅr Kostenstelle: 'M|kst   ' ? M|kst <> ""
?                                                FÅr alle Kostenstellen      ? M|kst =  ""

Umlage    von KST           an KST          BGrî·e     Einheit      Monat          Ist-VKZ        PF-VKZ         PP-VKZ
---------------------------------------------------------------------------------------------------------------------------
..
.continue HMZ
..
!EXC01
.set decpoint ,
'Mandant          '                                Liste der Umlagen                  '   datum'
'txname           '                                                                    '   zeit'

                                                 Zeitraum: 'M|vgmon'/'M|gjahr' - 'M|bgmon'/'M|gjahr'
                                        Leistungsrichtung: 'M|richtung'
?                                                FÅr Kostenstelle: 'M|kst   ' ? M|kst <> ""
?                                                FÅr alle Kostenstellen      ? M|kst =  ""

Umlage;von KST;an KST;BGrî·e;Einheit;Monat;Ist-VKZ;PF-VKZ;PP-VKZ
..
!HMZ
.select screen line
.continue ENDE ? _G|mehr
..
..Nummer + Suchwort der abgebende KST
.formula U|xt01 = ""
.add M|ksab
.formula U|xt01 = D|num + "-" + D|such ? G|mehr
.add
..
..Nummer + Suchwort der empfangenden KST
.formula U|xt02 = ""
.add M|kszu
.formula U|xt02 = D|num + "-" + D|such ? G|mehr
.add
..
?'M|umla ' 'xt01           ' 'xt02           ' 'M|bezug  ' 'M|abk  '  'M|zmon ''     M|zist' '      M|zpf' '       M|zpp'?  -geraet<>"E"
?Nr.:'M|umlage';'U|xt01';'U|xt02';Nr.:'M|bezug';'M|abk';Mon: 'M|zmonat';'M|zist';'M|zpf';'M|zpp' ?  -geraet="E" & M|umlage <> ""
?'M|umlage';'U|xt01';'U|xt02';'M|bezug';'M|abk';Mon: 'M|zmonat';'M|zist';'M|zpf';'M|zpp'         ?  -geraet="E" & M|umlage = ""
.continue HMZ
..
!ENDE
?---------------------------------------------------------------------------------------------------------------------------? -geraet <> "E"
.continue













