..  Funktion       : Infosystem, Liste der bebuchbaren Kostenstellen
..
..  Ablauf         : Buttonvor - vor Start - Selectfeld fÅllen
..                   FeldprÅfung - Kostenstelle bebuchbar ?
..                   Feldaustritt von-KOstenstelle -> bis-Kostenstelle fÅllen
..
..*****************************************************************************
..
.set trans -
.continue BV      ? evtartengl="BUTTON_BEFORE"    & evtvar="bstart"
.continue FP      ? evtartengl="FIELD_VALIDATION"    & evtvar="kstvon"
.continue FP      ? evtartengl="FIELD_VALIDATION"    & evtvar="kstbis"
.continue FA      ? evtartengl="FIELD_EXIT"      & evtvar="kstvon"
.continue E0
.set trans +
..
!BV:
.formula xtvon=""
.add M|kstvon
.formula xtvon=D|num ? mehr
.add
.formula xtbis=""
.add M|kstbis
.formula xtbis=D|num ? mehr
.add
.continue F01     ? xtbis <> "" & xtbis < xtvon
.formula M|select=xtvon + "!" + xtbis
.continue E0
..
!FP:
.add M|kstvon  ? evtvar="kstvon"
.add M|kstbis  ? evtvar="kstbis"
.continue E0      ? _mehr
.continue F02     ? _D|bu
.add
.continue E0
..
!FA:
.add M|kstvon
.formula M|kstbis=D|id ? mehr
.add
.continue E0
..
!E0:
.continue
!E1:
.error
.end 1
!F01:
.box
Bis-Kostenstelle ist kleiner als die von-Kostenstelle.
.continue E1
!F02:
.box
Kostenstelle ist nicht bebuchbar.
.continue E1


