..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : FERTLEIST2.EV
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..  Funktion       : Allgemeines Event-FOP des Infosystems ko/FERTLEIST2
..  Functionality  : Common event FOP of the Infosystem ko/FERTLEIST2
..*****************************************************************************
..
.type text xxtinitexclude1
.type text xxtinitexclude2
.type bool xbineinstorno ? _F|defined(U|xbineinstorno)
..
..*****************************************************************************
..
.set trans -
..
.continue SORT    ? G|evtartengl = "ROW_MOVED_BEFORE"
..
.formula U|xxtinitexclude1 = "waehrung"
.formula U|xxtinitexclude2 = "mgrname"
..
.input "is/REINIT" ? G|evtartengl <> "FIELD_VALIDATION"
..
.continue START   ? G|evtvar = "bstart"   & G|evtartengl = "BUTTON_BEFORE"
.continue MGR     ? G|evtvar = "mgr"      & G|evtartengl = "FIELD_EXIT"
.continue UEBU    ? G|evtvar = "uebu"     & G|evtartengl = "FIELD_EXIT"
.continue UEBU    ? G|evtvar = "uebualle" & G|evtartengl = "FIELD_EXIT"
.continue STBU    ? G|evtvar = "stbu"     & G|evtartengl = "FIELD_EXIT"
.continue STBU    ? G|evtvar = "stbualle" & G|evtartengl = "FIELD_EXIT"
.continue KSTELLE ? G|evtvar = "kstelle"  & G|evtartengl = "FIELD_VALIDATION"
.continue KSTELLE ? G|evtvar = "mgkstl"   & G|evtartengl = "FIELD_VALIDATION"
.continue KART    ? G|evtvar = "kart"     & G|evtartengl = "FIELD_VALIDATION"
.continue ALL     ? G|evtvar = "alle"     & G|evtartengl = "FIELD_EXIT"
.continue KRMTYP  ? G|evtvar = "krmtyp"   & G|evtartengl = "FIELD_EXIT"
.continue END
..
..****************************************************************************
!KRMTYP
.copy U|xbineinstorno = G|FALSE
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CancelationCompletionConfirmationWithoutWOSuggestion)") ; F|equals(M|krmtyp, "(CanceledCompletionConfirmationWithoutWOSuggestion)") ; F|equals(M|krmtyp, "(CancelationCompletionConfirmation)")
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CancelationCompletionConfirmation)") ; F|equals(M|krmtyp, "(CanceledCompletionConfirmation)") ; F|equals(M|krmtyp, "(CancelationCompletionConfirmationForFiledWorkOrderSuggestion)")
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CancelationCompletionConfirmationForFiledWorkOrderSuggestion)") ; F|equals(M|krmtyp, "(CanceledCompletionConfirmationForFiledWorkOrderSuggestion)")
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CancelationRecoveryFromFiledWorkOrderSuggestion)") ; F|equals(M|krmtyp, "(CanceledRecoveryFromFiledWorkOrderSuggestion)") ; F|equals(M|krmtyp, "(CancelationRecoveryFromWorkOrder)")
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CanceledRecoveryFromWorkOrder)") ; F|equals(M|krmtyp, "(CancelationTimeEntry)") ; F|equals(M|krmtyp, "(CanceledTimeEntry)") ; F|equals(M|krmtyp, "(CancelationTimeCorrection)")
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CanceledTimeCorrection)") ; F|equals(M|krmtyp, "(CancelationTimeEntryForFiledWorkOrderSuggestion)") ; F|equals(M|krmtyp, "(CanceledTimeEntryForFiledWorkOrderSuggestion)")
.copy U|xbineinstorno = G|TRUE ? F|equals(M|krmtyp, "(CancelationTimeCorrectionForFiledWorkOrderSuggestion)") ; F|equals(M|krmtyp, "(CanceledTimeCorrectionForFiledWorkOrderSuggestion)")
.copy M|bmitstorno = G|FALSE ? _U|xbineinstorno
.copy M|bmitstorno = G|TRUE  ?  U|xbineinstorno
.input "is/TABLEEREN"
.continue END
..
!ALL 
.continue NOTALL              ?  _M|alle
.protection krmtyp
.protection -reset bmitstorno
.input "is/TABLEEREN"
.continue END
..
!NOTALL
.protection -reset krmtyp  
.copy M|bmitstorno = G|FALSE
.protection bmitstorno 
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!SORT
..*****************************************************************************
.continue ERR03 ? M|tzeilen > 0 & (_F|empty(M|mgkstl) ; _F|empty(M|kstelle))
.continue END
..
..*****************************************************************************
!UEBU
..*****************************************************************************
.formula M|uebu = G|false ? G|evtvar = "uebualle" & M|.G|evtvar = G|true
.protection uebu           ? G|evtvar = "uebualle" & M|.G|evtvar = G|true
.protection -reset uebu    ? G|evtvar = "uebualle" & M|.G|evtvar = G|false
.continue END            ? G|evtvar = "uebualle"
..
.continue END
..
..*****************************************************************************
!STBU
..*****************************************************************************
.formula M|stbu = G|false ? G|evtvar = "stbualle" & M|.G|evtvar = G|true
.protection stbu           ? G|evtvar = "stbualle" & M|.G|evtvar = G|true
.protection -reset stbu    ? G|evtvar = "stbualle" & M|.G|evtvar = G|false
.continue END
..
..*****************************************************************************
!START: start
..*****************************************************************************
.type bool xberr ? _F|defined(U|xberr)
..RangeCheck
.type GL30 xpvon ? _F|defined(U|xpvon)
.type GL30 xpbis ? _F|defined(U|xpbis)
.formula U|xpvon = "vwbuvon"
.formula U|xpbis = "vwbubis"
.input "is/RANGECHECK"
.formula U|xpvon = "vwbuuevon"
.formula U|xpbis = "vwbuuebis"
.input "is/RANGECHECK"
..
.continue ERROR05 ? _M|brm & _M|bsrm
..*****************************************************************************
!ERFASS
..*****************************************************************************
.formula U|xberr = M|erfassvon > M|erfassbis & _F|empty(M|erfassvon) & _F|empty(M|erfassbis)
.continue FIDAT ? _U|xberr
.cursor erfassvon
.continue ERR02
..
..*****************************************************************************
!FIDAT
..*****************************************************************************
.formula U|xberr = M|fidatvon > M|fidatbis & _F|empty(M|fidatvon) & _F|empty(M|fidatbis)
.continue FIDATUE ? _U|xberr
.cursor fidatvon
.continue ERR02
..
..*****************************************************************************
!FIDATUE
..*****************************************************************************
.formula U|xberr = M|fidatuevon > M|fidatuebis & _F|empty(M|fidatuevon) & _F|empty(M|fidatuebis)
.continue DATOK ? _U|xberr
.cursor fidatuevon
.continue ERR02
..
..*****************************************************************************
!DATOK
..*****************************************************************************
.formula M|grouping = 0
.formula M|grouping = 1 ? _F|empty(M|mgkstl)  & F|empty(M|kstelle)
.formula M|grouping = 2 ? _F|empty(M|kstelle) & F|empty(M|mgkstl)
..
.formula M|select  = "$,,@gruppe=1;gruppe=1;@ablageart=(3);@zeilen=(1)"
.formula M|select  = M|select + ";1:kostobj=" + 'M|kstelle^id' ? _F|empty(M|kstelle)
.formula M|select  = M|select + ";1:kstellemgr="  + 'M|mgkstl^id'  ? _F|empty(M|mgkstl)
.formula M|select  = M|select + ";0:mgr="     + 'M|mgr^id'     ? _F|empty(M|mgr)
.formula M|select  = M|select + ";0:ppsref^typ==" + 'M|krmtyp'   ? _M|alle
.formula M|select  = M|select + ";0:ppsref^typ="                 ?  M|alle
.formula M|select  = M|select + ";1:tbudat="     + 'M|erfassvon:8'  + "!" + 'M|erfassbis:8'  ? _F|empty(M|erfassvon) ; _F|empty(M|erfassbis)
.formula M|select  = M|select + ";0:lbmaxbudat=" + 'M|fidatvon:8'   + "!" + 'M|fidatbis:8'   ? _F|empty(M|fidatvon) ; _F|empty(M|fidatbis)
.formula M|select  = M|select + ";1:tlbbudat="   + 'M|fidatvon:8'   + "!" + 'M|fidatbis:8'   ? _F|empty(M|fidatvon) ; _F|empty(M|fidatbis)
.formula M|select  = M|select + ";0:uemaxbudat="  + 'M|fidatuevon:8' + "!" + 'M|fidatuebis:8' ? _F|empty(M|fidatuevon) ; _F|empty(M|fidatuebis)
.formula M|select  = M|select + ";1:tuebudat=" + 'M|fidatuevon:8' + "!" + 'M|fidatuebis:8' ? _F|empty(M|fidatuevon) ; _F|empty(M|fidatuebis)
.formula M|select  = M|select + ";1:buref^nummer="   + 'M|vwbuvon'   + "!" + 'M|vwbubis'     ? _F|empty(M|vwbuvon) ; _F|empty(M|vwbubis)
.formula M|select  = M|select + ";1:buref<>`" ?  M|stbu & _M|stbualle
.formula M|select  = M|select + ";1:buref=`"  ? _M|stbu & _M|stbualle
.formula M|select  = M|select + ";1:projekt=" + M|project^id ? _F|empty(M|project)
.formula M|select  = M|select + ";1:buueref^nummer=" + 'M|vwbuuevon' + "!" + 'M|vwbuuebis'   ? _F|empty(M|vwbuuevon) ; _F|empty(M|vwbuuebis)
.formula M|select  = M|select + ";1:buueref<>`" ?  M|uebu & _M|uebualle
.formula M|select  = M|select + ";1:buueref=`"  ? _M|uebu & _M|uebualle
.formula M|select  = M|select + ";1:kart=" + 'M|kart(L="0")' ? _F|empty(M|kart)
.formula M|select  = M|select + ";1:sonderbuart<>(DebitRow)"
.. nur Einzelkosten, keine Gemeinkosten
.formula M|select  = M|select + ";1:gemeinksdaten=0"
.. typ=2 -> Kopf
.formula M|select  = M|select + ";0:typ==2" ? M|brm & _M|bsrm
.formula M|select  = M|select + ";0:typ==3" ? _M|brm & M|bsrm
..
.formula M|select  = M|select + ";0:typ<>1"
.. gebucht (A232)
.formula M|select  = M|select + ";1:tlbstatus=(103)"  ?  M|stbu & _M|stbualle
.formula M|select  = M|select + ";1:tlbstatus<>(103)" ? _M|stbu & _M|stbualle
.. gebucht (A232)
.formula M|select  = M|select + ";1:tuestatus=(103)"  ?  M|uebu & _M|uebualle
.formula M|select  = M|select + ";1:tuestatus<>(103)" ? _M|uebu & _M|uebualle
.. keine historischen (geaenderten) Saetze
.formula M|select  = M|select + ";0:historisch=0"
..
.formula M|select = M|select + ";@ordnung=1:kstellemgr,1:kostobj" ? M|grouping = 1
.formula M|select = M|select + ";@ordnung=1:kostobj,1:kstellemgr" ? M|grouping = 2
.formula M|select = M|select + ";@ablageart=(Active)" ? M|bmitstorno & M|alle
.formula M|datnr  = 130
.formula M|grp    = 2
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!KSTELLE
..*****************************************************************************
.continue ERR01 ? _F|empty(M|.G|evtvar) & _F|eval("M|" + G|evtvar + "^bu")
.continue END
..
..*****************************************************************************
!MGR: Machine group changed
..*****************************************************************************
.copy M|mgkstl  = M|mgr^kstelle
.continue END
..
..*****************************************************************************
!KART: Cost type changed
..*****************************************************************************
.type AN105 xkart
.copy U|xkart = M|kart
.continue ERR04 ? _(U|xkart = 0 ; U|xkart = 6 ; U|xkart = 4 ; U|xkart = 5 ; U|xkart = 11 ; U|xkart = 12)
.continue END
..
..*****************************************************************************
!ERR01: Consolidation object chosen
..*****************************************************************************
.error 'M|.G|evtvar' ist nicht bebuchbar.
.end 1
..
..*****************************************************************************
!ERR02: Invalid period
..*****************************************************************************
.error UngÅltiger Zeitraum
.end 1
..
..*****************************************************************************
!ERR03: table sort not allowed if there are rows with sums per cost object
..*****************************************************************************
.error Das Umsortieren ist bei der Ausgabe mit Summenzeilen nicht mîglich.
.end 1
..
..*****************************************************************************
!ERR04: Value not allowed
..*****************************************************************************
.error Dieser Wert ist hier nicht zulÑssig.
.end 1
..
..*****************************************************************************
!ERROR05
..*****************************************************************************
.error Bitte FertigungsrÅckmeldungen und/oder ServicerÅckmeldungen auswÑhlen.
.end 1
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue

