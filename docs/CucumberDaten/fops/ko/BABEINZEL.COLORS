..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BABEINZEL.COLORS
..  Datum          : 04.09.2006
..  Version        : 1
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Setzt die Farben im Infosystem ko/BABEINZEL
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  :
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
..
..
..*****************************************************************************
.set trans -
.input "is/ABASFARBEN.DEF"
..
.select screen header
..*****************************************************************************
!LOOP
..*****************************************************************************
.select screen line
.continue END ? _G|mehr
.colour -background 'U|xabastotal'     'M|aktzeile'  ? M|tkoart^gruppe  = 2
.colour -background -1 -1 -1           'M|aktzeile'  ? M|tkoart^gruppe <> 2
.colour -background 'U|xabaswhite'     'M|aktzeile'  ? 'M|tkoart^optyp(L="0")'="(108)"
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
