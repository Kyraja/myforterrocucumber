..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ACCREP.RF
.. Author         : male
.. Verantwortlich : tiwe
.. Functionality  : Report footer of the Infosystem ko/ACCREP
..*****************************************************************************
.set trans -
..
..!meta M|=ko/ACCREP
..
.output terminal
.continue END  ? _F|fileexists(U|xttmp) ; _F|filesize(U|xttmp) > 0
.system 'F|expr("group_by.sh -n 13 -k 1 -k 2 -k 3 -k 4 -k 5 -k 6 -s 7 -s 8 -k 9 -s 10 -s 11 -s 12 -s 13 " + U|xttmp + " 1>" + U|xtdat + " 2>" + U|xterr)' background
.continue ERR01 ? _G|mehr
.continue ERR01 ?  F|filesize(U|xterr) > 0
.continue RLOOP
..
..*****************************************************************************
!RLOOP
..*****************************************************************************
.make screen line +O
.select from 'U|xtdat' M|tkonto # M|tsteuer # M|tlaart # M|tev # M|tkoart # M|tkstelle # M|tssum # M|thsum # M|tprojekt # M|tppssum # M|tpphsum # M|tpfssum # M|tpfhsum
.copy U|xbmehr = G|mehr
.make screen line -O ? _U|xbmehr
.formula M|tsaldo = M|tssum - M|thsum
.formula M|tptsaldo = M|tppssum + M|tpfssum - M|tpphsum - M|tpfhsum
.continue RLOOP ? U|xbmehr
.continue FOOT
..
..*****************************************************************************
!FOOT
..*****************************************************************************
.formula M|ssum = U|xrssum
.formula M|hsum = U|xrhsum 
.formula M|saldo = M|ssum - M|hsum
.formula M|ppssum = U|xrsprop 
.formula M|pphsum = U|xrhprop 
.formula M|pfssum = U|xrsfix 
.formula M|pfhsum = U|xrhfix 
.formula M|psaldo = M|ppssum + M|pfssum - M|pphsum - M|pfhsum
.continue END
..
..*****************************************************************************
!ERR01: GROUPBY error
..*****************************************************************************
.error Fehler beim Systemaufruf.
.input -text 'U|xterr' ? F|filesize(U|xterr) > 0
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
