..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : COMPRULE.EV
.. Author         : ankn
.. Verantwortlich : tiwe
.. Functionality  : Table FOP of the Infosystem ko/COMPRULE
..*****************************************************************************
..
.set trans -
.type text xpvon xpbis
..
.continue START   ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar = "bstart"
.continue RULESET ? G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "regelvon"
..
..*****************************************************************************
!RULESET: Set rule values
..*****************************************************************************
..
.copy M|regelbis = M|regelvon ? F|empty(M|regelbis)
.continue
..
..*****************************************************************************
!START: Infosystem start
..*****************************************************************************
.input "is/TABLEEREN"
.formula U|xpvon = "regelvon"
.formula U|xpbis = "regelbis"
.input "is/RANGECHECK"
..
.formula M|select = "$,"
.formula M|select = M|select + ";" + U|xxtfield + "=" + M|regelvon + "!" + M|regelbis
.formula M|select = M|select + ";optyp="  + 'M|optyp' ? _F|empty(M|optyp)
.formula M|select = M|select + ";@gruppe=2;gruppe=2"
.formula M|select = M|select + ";@ordnung=nummer"
.select 'G|hdatname60' 'M|select'
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.input 'M|tab'
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue LOOP
..
..*****************************************************************************
!END
.continue
