..!interpreter english translate noabbrev
..*****************************************************************************
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Tabellen-FOP des Infosystems ko/BABAUSWERT
..  Functionality  : Table FOP of the Infosystem ko/BABAUSWERT
..*****************************************************************************
..
.set trans -
..
..!meta M|=ko/BABAUSWERT
..
.type text xtret  ? _F|defined(U|xtret)
.type bool xbbuch ? _F|defined(U|xbbuch)
..
..*****************************************************************************
..
.formula U|xtret = ""
..
.load 8 add 9|id ? M|vdn = 68
..
.continue ADDAR  ? M|vdn = 68
.. else
..
.load 0 add 9|id
..
.continue ADDROW
..
..*****************************************************************************
!ADDAR: Add accounts of an account range
..*****************************************************************************
.load 1 accrange 'F|formatstr("$,id=={1};@gruppe={2}", 8|id, F|tostring(F|expr(8|gruppe+16)))'
..
..*****************************************************************************
!LPAR: Loop over account range's accounts
..*****************************************************************************
.load 1 line
.continue END    ? _G|mehr & (9|gruppe = 1 ; 9|gruppe = 3)
.continue ADDARF ? _G|mehr & (9|gruppe = 2 ; 9|gruppe = 4 ; 9|gruppe = 5)
.continue LPAR   ? F|empty(1|konto)
.load 0 add 1|konto
.formula U|xtret = "LPAR"
.continue ADDROW
..
..*****************************************************************************
!ADDARF: Add accounts of an account range form
..*****************************************************************************
.load 9 line
.continue END     ? _G|mehr
.continue ADDARF  ? F|empty(9|kbereich)
.continue ADDARF  ? 9|kbereich^gruppe <> 3 & 9|kbereich^gruppe <> 1
.load 8 add 9|kbereich
.continue ADDARF  ? _G|mehr
.continue ADDAR
..
..*****************************************************************************
!ADDROW: Add a mask row
..*****************************************************************************
.type bool xbmehr ? _F|defined(U|xbmehr)
.continue TEST1 ? G|evtzeile > 0
.make screen line +O
.assign M|tkonto = 0|id
.continue TEST1 ? G|mehr
.continue REMROW
!REMROW
.. unsupported objet type in 0|id
.make screen line -O
.continue END
!TEST1
.. any posting values available?
.select 'G|hdatname131' 'F|formatstr("$,sortgjgm={1}!{2};iwbu={3};projekt={4};bukreis=={5};@zeilen=(1);@maxtreffer=1", F|fysortdat(M|ajahr, M|amonat), F|fysortdat(M|ejahr, M|emonat), M|twaehr^id, M|tkonto^id, M|bukreis^id)' ? M|tkonto^dnr=86
.select 'G|hdatname131' 'F|formatstr("$,sortgjgm={1}!{2};iwbu={3};kstelle={4};bukreis=={5};@zeilen=(1);@maxtreffer=1", F|fysortdat(M|ajahr, M|amonat), F|fysortdat(M|ejahr, M|emonat), M|twaehr^id, M|tkonto^id, M|bukreis^id)' ? M|tkonto^dnr=5
.formula  U|xbbuch = G|mehr
.continue REMROW  ? _G|mehr & M|buch
.continue ADDROW3 ?  0|dnr<>5
.select add 0|id
.select year 'M|tajahr' 'M|tamonat' ? M|tajahr<>M|tejahr
.formula M|tasaldo = 0|asaldo
.select year 'M|tejahr' 'M|temonat' ? M|tajahr<>M|tejahr
.formula M|tesaldo = 0|esaldo
.continue ADDROW3
!ADDROW3
.. do only add a row if the event is a header event
.assign M|tid     = 0|id
.copy   M|tselbukreis = M|bukreis
.copy   M|tverd   = _M|tkonto^bebuchbar
.copy   M|tajahr  = M|ajahr
.copy   M|tejahr  = M|ejahr
.copy   M|tamonat = M|amonat
.copy   M|temonat = M|emonat
.copy   M|tadatum = M|adatum
.copy   M|tedatum = M|edatum
.copy   M|tbuch   = U|xbbuch
.copy   M|twaehr  = M|waehr
.copy   M|tbabform= M|babform
.copy   M|tstrukturauf = M|strukturauf
..
..*****************************************************************************
!ENDADDROW:
..*****************************************************************************
.select
.continue 'U|xtret' ? _F|empty(U|xtret)
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
