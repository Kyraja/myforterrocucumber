..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
..
.set trans -
..
.load 0 entryjournal 'F|formatstr("$,buchung={1};kstelle={2};konto^stat=(71)", H|buchung^id, M|ksab^id)'
.continue END    ? _G|mehr
..
.make screen line +O
.assign M|bunum     = H|buchung^id
.copy M|buursache = H|ursache
.copy M|bubudat   = H|budat
.formula   M|bubeleg   = H|beleg
.copy M|bubeldat  = H|beldat
.assign M|bukonto   = H|konto
.formula   M|isoll     = H|sbetr
.formula   M|ihaben    = H|hbetr
.formula   M|ppsoll    = H|ppropbetr
.formula   M|pphaben   = H|phpropbetr
.formula   M|pfsoll    = H|pfixbetr
.formula   M|pfhaben   = H|phfixbetr
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

