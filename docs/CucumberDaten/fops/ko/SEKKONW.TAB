..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
..
.set trans -
..
.load 0 entryjournal 'F|formatstr("$,buchung={1};kstelle={2};konto^stat=(71)", H|buchung^id, M|ksab^id)'
.continue END    ? _G|mehr
.continue INSROW ? M|aktzeile = 0
.continue INSROW ? M|konto^id <> H|konto^id ; M|kst^id <> H|kstelle^id
.continue SUM
..*****************************************************************************
!INSROW
..*****************************************************************************
.make screen line +O
.assign M|konto   = H|konto
.assign M|kst     = H|kstelle
.continue SUM
..
..*****************************************************************************
!SUM
..*****************************************************************************
.formula   M|isoll   = M|isoll + H|sbetr
.formula   M|ihaben  = M|ihaben + H|hbetr
.formula   M|ppsoll  = M|ppsoll + H|ppropbetr
.formula   M|pphaben = M|pphaben + H|phpropbetr
.formula   M|pfsoll  = M|pfsoll + H|pfixbetr
.formula   M|pfhaben = M|pfhaben + H|phfixbetr
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

