..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ACCREP.CONSOL
.. Author         : male
.. Verantwortlich : tiwe
.. Functionality  : Loop over entries for consolidated account loaded in buffer 0
..*****************************************************************************
.set trans -
..
..!meta M|=ko/ACCREP
..
.select 'G|hdatname131' 'F|formatstr("{1}{2}", M|select, F|formatstr(";{1}={2}", F|condexpr(0|dnr=5, "kstelle", "projekt"), 0|id))'
!LOOP
.continue END ? _G|mehr
.input 'M|tab'
.select continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
