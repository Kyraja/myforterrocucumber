..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
..
.set trans -
..
.continue ME       ? G|evtartengl="SCREEN_ENTER"
.continue KSZU     ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kszu"
.continue KSAB     ? G|evtartengl="FIELD_EXIT"    & G|evtvar="ksab"
.continue VGMON    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="vgmon"
.continue BGMON    ? G|evtartengl="FIELD_VALIDATION"  & G|evtvar="bgmon"
..
.continue BUNW     ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bunw"
.continue END
..
..*****************************************************************************
!ME: Maskeneintritt
..*****************************************************************************
.copy M|gjahr = G|gjahr
.formula   M|vgmon = 1
.formula   M|bgmon = 12
.copy M|waehr = G|inland
.formula   M|vkzart="(73)"
.formula   M|kszu  = ""
.formula   M|ksab  = ""
.formula   M|kszuname = ""
.formula   M|ksabname = ""
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!KSZU
..*****************************************************************************
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!KSAB
..*****************************************************************************
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!VGMON
..*****************************************************************************
.continue END ? M|vgmon > 0 & M|vgmon < 13 & M|vgmon <= M|bgmon
.error Unzul„ssiger Zeitraum !
.end 1
..
..*****************************************************************************
!BGMON
..*****************************************************************************
.continue END ? M|bgmon > 0 & M|bgmon < 13 & M|bgmon >= M|vgmon
.error Unzul„ssiger Zeitraum !
.end 1
..
..*****************************************************************************
!BUNW
..*****************************************************************************
.continue END ? F|empty(M|kszu) ; F|empty(M|ksab)
.type text xbef ? _F|defined(U|xbef)
..
.formula U|xbef='G|kkomname38' + " SEKBUNW" + " ? "
.formula U|xbef=U|xbef + "   kszu="   + 'M|kszu^id'
.formula U|xbef=U|xbef + " | ksab="   + 'M|ksab^id'
.formula U|xbef=U|xbef + " | gjahr="  + 'M|gjahr'
.formula U|xbef=U|xbef + " | vgmon="  + 'M|vgmon'
.formula U|xbef=U|xbef + " | bgmon="  + 'M|bgmon'
.set reference +
.formula U|xbef=U|xbef + " | vkzart=" + 'M|vkzart'
.set reference -
.formula U|xbef=U|xbef + " | bstart="
..
.command -parallel 'U|xbef'
..
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

