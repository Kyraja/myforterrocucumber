..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
..
.set trans -
..
..temporÑre ASCII-Datei
.type text xtdat01
..
..Umlagen-Nummer
.type ID67:1 xtuml
..
..Textvariable fÅr SYS-Befehle
.type text xtsys
..
..abgebende KST
.type ID5:2   xtksab
..
..empfangende KST
.type ID5:2.4 xtkszu
..
..temporÑre Arbeitsvariable
.type text xt01
..
.file -tempname U|xtdat01
.output new 'U|xtdat01'
.input "DATEI.F"
..
.load 1 assessment 'M|select'
..
..*****************************************************************************
!LOS:
..*****************************************************************************
.continue SORT ? _G|mehr
.continue HNDS ?  1|gruppe <> 1
..
.assign U|xtuml  = 1|id
.copy U|xtksab = 1|ksab
..
.continue HNDS ? U|xtksab <> M|kst^id & _F|empty(M|kst) & M|irichtung = 1
..
.load 2 assessment 'F|formatstr("$,,@gruppe=2;gruppe=2;zlnr={1};gjahr={2}", 1|id, M|gjahr)'
..*****************************************************************************
!HZ
..*****************************************************************************
.continue HNDS ? _G|mehr
.copy U|xtkszu = 2|kszu
.continue HNZ   ? U|xtkszu <> M|kst^id & _F|empty(M|kst) & M|irichtung = 2
'U|xtuml' # 'U|xtksab' # 'U|xtkszu' #
..
..*****************************************************************************
!HNZ
..*****************************************************************************
.load 2 continue
.continue HZ
..
..*****************************************************************************
!HNDS:
..*****************************************************************************
.load 1 continue
.continue LOS
..*****************************************************************************
!SORT:
..*****************************************************************************
.output terminal
.select from
..
.formula U|xtsys = "sort -t# +1 -2 +2 -3 -o " ? M|irichtung = 1
.formula U|xtsys = "sort -t# +2 -3 +1 -2 -o " ? M|irichtung = 2
.formula U|xtsys = U|xtsys + 'U|xtdat01' + " " + 'U|xtdat01'
.system 'U|xtsys' background
..
.input 'M|bkopf' ? _F|empty(M|bkopf)
..
..*****************************************************************************
!TAB
..*****************************************************************************
.select from 'U|xtdat01' U|xtuml # U|xtksab # U|xtkszu #
.continue FUSS ? _G|mehr
.input 'M|tab'  ? _F|empty(M|tab)
.continue TAB
..
..*****************************************************************************
!FUSS
..*****************************************************************************
.input 'M|bfuss' ? _F|empty(M|bfuss)
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
