..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : GKOST.EV
..  Datum          : 18.04.2005
..  Version        : 1
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Allgemeines Event-FOP fuer das Infosystem ko/GKOST
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  : Common event FOP for the Infosystem ko/GKOST
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
..*****************************************************************************
..
.set trans -
..
.continue ROWCHANGE  ? G|evtartengl = "ROW_CHANGED"
.continue ASHOWENTRY ? G|evtvar = "bibuzeig" & G|evtartengl = "BUTTON_BEFORE"
.continue PSHOWENTRY ? G|evtvar = "bpbuzeig" & G|evtartengl = "BUTTON_BEFORE"
..
..*****************************************************************************
!INITVALUES: Clear table and init mask header values
..*****************************************************************************
.input "is/TABLEEREN"
..
.formula M|kst        = ""
.formula M|ktr        = ""
.formula M|umlage     = ""
.formula M|monat      = ""
.formula M|istkosten  = 0.00
.formula M|plfkosten  = 0.00
.formula M|plvkosten  = 0.00
.formula M|egkzr      = 0.00
.formula M|egkzg      = 0.00
.formula M|igkzr      = 0.00
.formula M|igkzg      = 0.00
.formula M|istabgesch = G|false
.formula M|plabgesch  = G|false
.formula M|dcact      = 0.00
.formula M|dcplf      = 0.00
.formula M|dcplv      = 0.00
.formula M|umligkz    = G|false
.formula M|umlegkz    = G|false
.formula M|ibudiff    = 0.00
.formula M|pbudiff    = 0.00
..
.continue SETCORANGE ? G|evtvar = "ktrvon" & G|evtartengl = "FIELD_EXIT"
.continue SETCCRANGE ? G|evtvar = "bevon"  & G|evtartengl = "FIELD_EXIT"
.continue START      ? G|evtvar = "bstart" & G|evtartengl = "BUTTON_BEFORE"
..
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.formula M|bgmon = 12 ? M|bgmon > 12
..
.input "is/RANGECHECK"
..
.formula M|datnr   = 5
.formula M|select  = "$,gruppe=2;@gruppe=2;@numsuch="  + M|bevon + "!" + M|bebis + ";hilfsks=0;bu=1;@ordnung=nummer"
..
.input "is/HOL.LISTE"
..
..
.continue END
..
..*****************************************************************************
!SETCORANGE: Set cost object range
..*****************************************************************************
.formula M|ktrbis = M|ktrvon ? G|evtvar = "ktrvon" & +'M|ktrbis' = 0
.continue END
..
..*****************************************************************************
!SETCCRANGE: Set cost center range
..*****************************************************************************
.formula M|bebis = M|bevon ? G|evtvar = "bevon" & +'M|bebis' = 0
.continue END
..
..*****************************************************************************
!ASHOWENTRY: Show statistical entry (actual)
..*****************************************************************************
.type text xtcmd
.formula U|xtcmd = "<" + 'G|kdatname6' + ">" + 'M|ibuch^id' + "<" + 'G|kaktname12' + ">"
.formula U|xtcmd = U|xtcmd + " ? [pos]=" + 'M|ibuzeile'
.formula U|xtcmd = U|xtcmd + ":konto" ? M|ibuzeile > 0
.command -parallel 'U|xtcmd'
.continue END
..
..*****************************************************************************
!PSHOWENTRY: Show statistical entry (planned)
..*****************************************************************************
.type text xtcmd
.formula U|xtcmd = "<" + 'G|kdatname6' + ">" + 'M|pbuch^id' + "<" + 'G|kaktname12' + ">"
.formula U|xtcmd = U|xtcmd + " ? [pos]=" + 'M|pbuzeile'
.formula U|xtcmd = U|xtcmd + ":konto" ? M|pbuzeile > 0
.command -parallel 'U|xtcmd'
.continue END
..
..*****************************************************************************
!ROWCHANGE:
..*****************************************************************************
.copy M|kst    = M|tkst
.copy M|ktr    = M|tktr
.copy M|umlage = M|tumlage
.assign M|monat  = M|tmonat
.formula M|istkosten = M|tistkosten
.formula M|plfkosten = M|tplfkosten
.formula M|plvkosten = M|tplvkosten
.formula M|egkzr     = M|tegkzr
.formula M|egkzg     = M|tegkzg
.formula M|igkzr     = M|tigkzr
.formula M|igkzg     = M|tigkzg
.formula M|istabgesch = M|tistabgesch
.formula M|plabgesch  = M|tplabgesch
.formula M|dcact = M|tdcact
.formula M|dcplf = M|tdcplf
.formula M|dcplv = M|tdcplv
.formula M|umligkz = M|tumligkz
.formula M|umlegkz = M|tumlegkz
.copy M|ibuch = M|tibuch
.copy M|pbuch = M|tpbuch
.formula M|ibubetr  = M|tibubetr
.formula M|pfbubetr = M|tpfbubetr
.formula M|pvbubetr = M|tpvbubetr
.formula M|ibuzeile = M|tibuzeile
.formula M|pbuzeile = M|tpbuzeile
.formula M|ibudiff  = M|tibudiff
.formula M|pbudiff  = M|tpbudiff
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
