..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : LKOKOA.EV.KOPF
..  Datum          : 08.09.2001
..  Version        :
..  Autor          : S.Riemer-MÅller
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Konten mit ihren Kostenarten,
..                   Kopfevents
..
..  Ablauf         : Buttonvor - vor Start  -> Selectfeld fÅllen
..                   Feldaustritt von-Konto -> bis-Konto  fÅllen
..
..*****************************************************************************
..
.set trans -
.continue BV      ? evtartengl="BUTTON_BEFORE"    & evtvar="bstart"
.continue BSEL    ? evtartengl="BUTTON_AFTER"   & evtvar="bselect"
.continue FAV     ? evtartengl="FIELD_EXIT"      & evtvar="kovon"
.continue FAB     ? evtartengl="FIELD_EXIT"      & evtvar="kobis"
.continue
..
!BV:
.continue F01     ? M|kobis <> "" & M|kobis < M|kovon
.formula M|select    = "!" ? M|select = ""
.input "TABLEEREN"
.continue
..
!BSEL:
.formula M|kobis     = ""
.formula M|kovon     = ""
.formula evtfeldneu  = "%"
.input "is/AUSWAHL"
.formula M|selektion = M|select <> "!"
.continue
..
!FAV:
.formula M|kobis     = M|kovon
..
!FAB:
.formula M|select    = M|kovon + "!" + M|kobis
.formula M|selektion = "n"
.continue
..
!F01:
.error von-Kontonummer ist grî·er als bis-Kontonummer
.end 1

