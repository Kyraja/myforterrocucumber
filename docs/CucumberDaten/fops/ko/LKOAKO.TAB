..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : LKOAKO.TAB
..  Datum          : 30.08.2001
..  Version        :
..  Autor          : S.Riemer-MÅller
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Kostenarten und Konten
..                   Tabellenzeigfop
..
..  Ablauf         : Nach dem Startbutton - dazulesen der Kostenarten
..
..*****************************************************************************
.set trans -
.type text xtzident
..
.formula U|xtzid       = H|id
.formula U|xtznum      = H|num
.load 0 account 'F|formatstr("$,,gruppe=1;@gruppe=1;zkoart={1};@zeilen=(1)", H|id)'
..
!K1:
.continue         ? _G|mehr
.formula U|xtnum       = 0|num
.load 0 line '0|selzeile'
.continue KNEXT   ? _(M|unguelt ; (0|koartvon <= G|datum & ('0|koartbis' = "" ; 0|koartbis >= G|datum)))
..
.make screen line +
.formula M|koart     = U|xtzid
.formula M|konto     = U|xtnum
.formula M|gvon      = 0|koartvon
.formula M|gbis      = 0|koartbis
.continue KNEXT
!KNEXT:
.load 0 account
.continue K1
