..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KOSTENSAETZE.BKOPF
.. Autor          : male
.. Verantwortlich : tiwe
.. Kontrolle      : mh
.. Funktion       : Berichtskopf-FOP
.. Functionality  : Report header FOP
..*****************************************************************************
..
.type bool xbcurconvert
..
..*****************************************************************************
..
.set trans -
..
.formula U|xbcurconvert = M|buwaehr^id <> M|auswaehr^id
.load 2 add M|reregel
.end 1 ? _G|mehr
..
.load 9 add F|sysinfo(12)
.type integer xistartrow
.type integer xiendrow
.load 9 line
!LOOP
.continue END ? _G|mehr
.formula U|xistartrow = 9|aktzeile ? M|anfj = 9|gjahr
.formula U|xiendrow   = 9|aktzeile ? M|endj = 9|gjahr
.load 9 line
.continue LOOP
..
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Plausibilit„t: 'U|xiendrow' < 'U|xistartrow'
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue ERR01 ? U|xiendrow < U|xistartrow
.continue
