..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ACCREP.EV
.. Author         : male
.. Verantwortlich : tiwe
.. Functionality  : Screen entry FOP of the Infosystem ko/ACCREP
..*****************************************************************************
.set trans -
..
..!meta M|=ko/ACCREP
..
.continue START0 ? G|evtvar = "bstart"   & G|evtartengl = "BUTTON_BEFORE"
.make screen line --
.continue START  ? G|evtvar = "bstart"   & G|evtartengl = "BUTTON_AFTER"  
.continue SET    ? G|evtvar = "kstktr"   & G|evtartengl = "FIELD_EXIT"  
.continue PERIOD ? G|evtvar = "gjahr"    & G|evtartengl = "FIELD_EXIT"
.continue PERIOD ? G|evtvar = "gjahrbis" & G|evtartengl = "FIELD_EXIT"
.continue PERIOD ? G|evtvar = "anfmon"   & G|evtartengl = "FIELD_EXIT"
.continue PERIOD ? G|evtvar = "endmon"   & G|evtartengl = "FIELD_EXIT"
.continue PERIOD ? G|evtvar = "adatum"   & G|evtartengl = "FIELD_EXIT"
.continue PERIOD ? G|evtvar = "edatum"   & G|evtartengl = "FIELD_EXIT"
.continue END
..
..*****************************************************************************
!PERIOD: Set period
..*****************************************************************************
.type text xxtemon xxtsmon xxtsyear xxteyear xxtfromd xxttod
.formula U|xxtsmon = "anfmon"
.formula U|xxtemon = "endmon"
.formula U|xxtsyear= "gjahr"
.formula U|xxteyear= "gjahrbis"
.formula U|xxtfromd= "adatum"
.formula U|xxttod  = "edatum"
.input "fb/IS.SETPERIOD"
.continue END
..
..*****************************************************************************
!SET:
..*****************************************************************************
.copy M|kokobu = M|kstktr^bebuchbar
.continue END
..
..*****************************************************************************
!START0
..*****************************************************************************
.continue ERR01 ? F|empty(M|kostart)
.continue ERR02 ? F|empty(M|kstktr)
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.formula M|select = "$,"
.formula M|select = M|select + ";0:koart=" + M|kostart^id
.formula M|select = M|select + ";0:budat=" + 'M|adatum:8' + "!" + 'M|edatum:8' ? _F|empty(M|adatum) ; _F|empty(M|edatum)
.formula M|select = M|select + ";0:sortgjgm=" + F|fysortdat(M|gjahr, M|anfmon) + "!" + F|fysortdat(M|gjahrbis, M|endmon)
.formula M|select = M|select + ";0:iwbu=" + M|waehr^id
.formula M|select = M|select + ";1:bukreis="  + M|bukreis^id ? _F|empty(M|bukreis)
.formula M|select = M|select + ";@zeilen=(1)"
.continue CONSOL ? _M|kstktr^bebuchbar
.formula M|select = M|select + ";0:kstelle="  + M|kstktr^id ? _F|empty(M|kstktr) & M|kstktr^dnr = 5
.formula M|select = M|select + ";0:projekt="  + M|kstktr^id ? _F|empty(M|kstktr) & M|kstktr^dnr = 86
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!CONSOL
..*****************************************************************************
.. consolidation object in M|kstktr
.input 'M|bkopf'
.input "java:de.abas.jfop.is.IterateConsolidatedAccounts" bufname=0 callback=ko/ACCREP.CONSOL 'F|formatstr("account={1}", M|kstktr^id)'
.input 'M|bfuss'
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Keine Kostenart angegeben.
.end 1
..
..*****************************************************************************
!ERR02
..*****************************************************************************
.error Kostenstelle/-tr„ger nicht angegeben.
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
