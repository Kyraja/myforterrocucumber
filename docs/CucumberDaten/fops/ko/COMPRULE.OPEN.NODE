..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : COMPRULE.OPEN.NODE
.. Author         : ankn
.. Verantwortlich : tiwe
.. Functionality  : OPEN NODE FOP of the Infosystem ko/COMPRULE
..*****************************************************************************
..
.set trans -
.type integer U|xtbaumstufe ? _F|defined(U|xtbaumstufe)
.formula U|xtbaumstufe = M|tbaumstufe
.select add M|tkoart
.continue END ? _G|mehr
..
..*****************************************************************************
!LOOP
..*****************************************************************************
..
.select line
.continue END ? _G|mehr
.make screen line +O
.formula M|tbaumstufe = U|xtbaumstufe + 1
.formula M|tbaumstat  = "="    ?  H|koart^gruppe = 1
.formula M|tbaumstat  = "+"    ?  H|koart^gruppe = 2
.copy M|tkoart     = H|koart
.copy M|tproz     = H|zproz
.continue LOOP
..
..*****************************************************************************
!END
.continue
