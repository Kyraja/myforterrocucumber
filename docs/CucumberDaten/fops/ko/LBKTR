..
..  Funktion       : Infosystem, Liste der bebuchbaren KostentrÑger
..
..  Ablauf         : Buttonvor - vor Start - Selectfeld fÅllen
..                   FeldprÅfung - KostentrÑger bebuchbar ?
..                   Feldaustritt von-KostentrÑger -> bis-KostentrÑger fÅllen
..
..*****************************************************************************
..
.set trans -
.continue BV      ? evtartengl="BUTTON_BEFORE"    & evtvar="bstart"
.continue FP      ? evtartengl="FIELD_VALIDATION"    & evtvar="ktrvon"
.continue FP      ? evtartengl="FIELD_VALIDATION"    & evtvar="ktrbis"
.continue FA      ? evtartengl="FIELD_EXIT"      & evtvar="ktrvon"
.continue AUSGABE ? evtartengl="FIELD_VALIDATION"    & evtvar="atyp"
.continue E0
.set trans +
..
!AUSGABE
.type bool xbild xexcel
.formula xbild=true
.formula xexcel=true
.set trans -
.input "is/PRUEF.ATYP"
.set trans +
.continue
..
!BV:
.formula xtvon=""
.add M|ktrvon
.formula xtvon=D|num ? mehr
.add
.formula xtbis=""
.add M|ktrbis
.formula xtbis=D|num ? mehr
.add
.continue F01     ? xtbis <> "" & xtbis < xtvon
.formula M|select=xtvon + "!" + xtbis
.continue E0
..
!FP:
.add M|ktrvon  ? evtvar="ktrvon"
.add M|ktrbis  ? evtvar="ktrbis"
.continue E0      ? _mehr
.continue F02     ? _D|bu
.add
.continue E0
..
!FA:
.add M|ktrvon
.formula M|ktrbis=D|id ? mehr
.add
.continue E0
..
!E0:
.continue
!E1:
.error
.end 1
!F01:
.box
Bis-KostentrÑger ist kleiner als die von-KostentrÑger.
.continue E1
!F02:
.box
KostentrÑger ist nicht bebuchbar.
.continue E1



