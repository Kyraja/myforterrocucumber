..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : BABEINZEL2.SET.PERIODS
..  Datum          : 30.08.2007
..  Version        : 1
..  Autor          : male
..  Verantwortlich : tiwe
..
..  Kontrolle      : mh
..  Funktion       : Vorbelegung der Perioden in ko/BABEINZEL2
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  : Sets the periods in ko/BABEINZEL2
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
.type GJ  xgjahr   ? _F|defined(U|xgjahr)
.type A18 xvkzart  ? _F|defined(U|xvkzart)
..
..*****************************************************************************
..
.set trans -
..
.continue END    ? F|empty(U|xgjahr)
..
.formula U|xvkzart = "(65)" ? F|empty(U|xvkzart)
..
.select year 'U|xgjahr'
..
.type integer xi xiamon xiemon ximon
.formula U|xi     = 0
.formula U|ximon  = 0
.formula U|xiamon = G|amonat
.formula U|xiemon = G|emonat
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xi    = U|xi    + 1
.formula U|ximon = U|ximon + 1
.continue ELOOP ? U|xi > (M|maxper - 1)
..
.formula M|vkzart.U|xi  = U|xvkzart
.formula M|anfm.U|xi    = U|ximon
.formula M|endm.U|xi    = U|ximon
.formula M|anfj.U|xi    = G|ejahr
.formula M|endj.U|xi    = G|ejahr
..
.select year 'U|xgjahr' 'U|ximon' 'U|ximon'
.formula M|von.U|xi = G|adatum
.formula M|bis.U|xi = G|edatum
.formula M|use.U|xi = G|true
..
.continue LOOP
..
..*****************************************************************************
!ELOOP
..*****************************************************************************
.select year 'U|xgjahr'
.formula U|xi = M|maxper
.formula M|vkzartn.U|xi = 65
.formula M|anfm.U|xi    = G|amonat
.formula M|endm.U|xi    = G|emonat
.formula M|endm.U|xi    = 12 ? M|endm.U|xi > 12
.formula M|anfj.U|xi    = G|ejahr
.formula M|endj.U|xi    = G|ejahr
.formula M|von.U|xi     = G|adatum
.formula M|bis.U|xi     = G|edatum
.formula M|use.U|xi     = G|true
.continue END
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
