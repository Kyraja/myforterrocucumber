..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : BABEINZEL2.INC.PERIODS
..  Datum          : 07.04.2008
..  Version        : 1
..  Autor          : male
..  Verantwortlich : tiwe
..
..  Kontrolle      : mh
..  Funktion       : Verschiebung der Ausgabeperioden in ko/BABEINZEL2 (um Jahre)
..                   Eingabeparameter T|xistep (Jahre +/-)
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  : Increase/decrease report years in the periods in ko/BABEINZEL2
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..

..
..*****************************************************************************
..
.set trans -
..
.select company "$,@gruppe=12"
..
.type integer xistep ? _F|defined(U|xistep)
.continue END ? U|xistep = 0
..
.type integer  xi xizeile xinzeile
.type bool xba xbe xbgefa xbgefe
..
.formula U|xi = 0
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xi  = U|xi + 1
.continue END   ? U|xi > M|maxper
.formula U|xbgefa = G|false
.formula U|xbgefe = G|false
..
.continue LOOP  ? F|empty(M|anfm.U|xi)
.continue LOOP  ? F|empty(M|anfj.U|xi)
.continue LOOP  ? F|empty(M|endm.U|xi)
.continue LOOP  ? F|empty(M|endj.U|xi)
.continue LOOP  ? F|empty(M|von.U|xi)
.continue LOOP  ? F|empty(M|bis.U|xi)
..
.select header
..*****************************************************************************
!FL
..*****************************************************************************
.select line
.continue FL ? H|gjahr <> M|anfj.U|xi & H|gjahr <> M|endj.U|xi
.formula U|xizeile  = H|aktzeile
.formula U|xinzeile = U|xizeile + U|xistep
.continue LOOP ? U|xinzeile < 1 ; U|xinzeile > H|tzeilen
.formula U|xba =  H|gjahr  = M|anfj.U|xi
.formula U|xbe =  H|gjahr  = M|endj.U|xi
.select line 'U|xinzeile'
.continue AY ? U|xba & _U|xbgefa
.continue EY ? U|xbe & _U|xbgefe
.continue FN
..
!AY
.formula U|xbgefa  = G|true
.select year 'H|gjahr'
.formula M|anfm.U|xi = G|amonat ? M|anfm.U|xi < G|amonat
.select year 'H|gjahr' 'M|anfm.U|xi' 'M|anfm.U|xi'
.formula M|anfj.U|xi = G|ajahr
.formula M|anfm.U|xi = G|amonat
.formula M|von.U|xi  = G|adatum
.continue EY ? U|xbe
.continue FN
..
!EY
.formula U|xbgefe  = G|true
.select year 'H|gjahr'
.formula M|endm.U|xi = G|emonat ? M|endm.U|xi > G|emonat
.select year 'H|gjahr' 'M|endm.U|xi' 'M|endm.U|xi'
.formula M|endj.U|xi = G|ejahr
.formula M|endm.U|xi = G|emonat
.formula M|bis.U|xi  = G|edatum
.continue FN
..
!FN
.select line 'U|xizeile'
.continue FL    ? _U|xbgefa ; _U|xbgefe
.continue CORR1 ? (M|anfj.U|xi = M|endj.U|xi) & (M|anfm.U|xi > M|endm.U|xi)
.continue CORR2 ?  M|von > M|bis
.continue LOOP
..
..*****************************************************************************
!CORR1
..*****************************************************************************
.select period 'M|von.U|xi' 'M|bis.U|xi'
.formula M|anfj.U|xi = G|ajahr
.formula M|anfm.U|xi = G|amonat
.formula M|endj.U|xi = G|ejahr
.formula M|endm.U|xi = G|emonat
.continue LOOP
..
..*****************************************************************************
!CORR2
..*****************************************************************************
.select period 'M|bis.U|xi' 'M|bis.U|xi'
.formula M|anfj.U|xi = G|ajahr
.formula M|anfm.U|xi = G|amonat
.formula M|endj.U|xi = G|ejahr
.formula M|endm.U|xi = G|emonat
.formula M|von.U|xi  = G|adatum
.formula M|bis.U|xi  = G|edatum
.continue LOOP
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
