..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
..
.set trans -
..
.type text xt01  ? _F|defined(U|xt01)
.type integer  xi01  ? _F|defined(U|xi01)
.type integer  xi02  ? _F|defined(U|xi02)
.type integer  xi03  ? _F|defined(U|xi03)
..
..Gesch„ftsmonate merken
.formula U|xi01 = M|vgmon
.formula U|xi02 = M|bgmon
..
.. Puffer 0 enthaelt die aktuelle Kostenstelle
.. Puffer 9 enthaelt das Kostenstellenumlageelement wenn die Leistungsrichtung = 1 ist
.. Puffer 9 enthaelt die Verkehrszahlen wenn die Leistungsrichtung = 2 ist
.. Puffer 1 enthaelt das Umlageobjekt
..
.make screen line +O
.assign M|umlage   = 1|id
.assign M|kszu     = 0|id       ? M|irichtung = 2
.copy M|kszu     = 9|kszu      ? M|irichtung = 1
.copy M|ksab     = 1|ksab
..
.formula   M|tgjahr = M|gjahr
.formula   M|zpm    = "+"
.formula   M|zmonat = 'M|vgmon' + "-" + 'M|bgmon'
..
.formula M|hkst = M|kszu^hilfsks
..
.assign M|bezug = 1|ksab^bezug
.formula   M|abk     = M|bezug^einheit
..
.formula   U|xt01 = F|formatstr("$,,@gruppe=3;gruppe=3;umsn={1};kstelle={2};gjahr={3};bukreis={4}", M|umlage^id, M|kszu^id, M|gjahr, G|bukreis^id)
..
..Ist-Werte (IstUml)
.select assessment 'F|expr(U|xt01 + ";dart=(78)")'
..*****************************************************************************
!HNIST
..*****************************************************************************
.continue HPF ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L1
..*****************************************************************************
.continue C1 ? U|xi03 > 12
.formula M|istmge.U|xi03 = H|s.U|xi03
.formula M|mon.U|xi03    = H|m.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L1
..
..*****************************************************************************
!C1
..*****************************************************************************
.select add H|umnum
.continue HPF ? _G|mehr
..
.select add H|ksab
.continue HPF ? _G|mehr
..
.. IvKv
.select accountdata 'F|formatstr("$,,@gruppe=3;gruppe=3;kosn={1};gjahr={2};bukreis={3};dart=(77)", H|id, M|gjahr, G|bukreis^id)'
.continue HPF ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L2
..*****************************************************************************
.continue HPF ? U|xi03 > 12
.formula M|istvsatz.U|xi03  = H|s.U|xi03
.formula M|istgvsatz.U|xi03 = H|s.U|xi03
.formula M|istwert.U|xi03   = H|s.U|xi03:2 * M|istmge.U|xi03
.formula M|istgwert.U|xi03  = H|s.U|xi03   * M|istmge.U|xi03
.formula M|istdiff.U|xi03   = M|istgwert.U|xi03 - M|istwert.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L2
..
..*****************************************************************************
!HPF
..*****************************************************************************
..PF-Werte (PlUmlfix)
.select assessment 'F|expr(U|xt01 + ";dart=(79)")'
..
..*****************************************************************************
!HNPF
..*****************************************************************************
.continue HPP ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L3
..*****************************************************************************
.continue C3 ? U|xi03 > 12
.formula M|pfmge.U|xi03 = H|s.U|xi03
.formula M|mon.U|xi03   = H|m.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L3
..*****************************************************************************
!C3
..*****************************************************************************
.select add H|umnum
.continue HPP ? _G|mehr
..
.select add H|ksab
.continue HPP ? _G|mehr
..
.. fpkv
.select accountdata 'F|formatstr("$,,@gruppe=3;gruppe=3;kosn={1};gjahr={2};bukreis={3};dart=(87)", H|id, M|gjahr, G|bukreis^id)'
.continue HPP ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L4
..*****************************************************************************
.continue HPP ? U|xi03 > 12
.formula M|pfvsatz.U|xi03  = H|s.U|xi03
.formula M|pfgvsatz.U|xi03 = H|s.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L4
..
..*****************************************************************************
!HPP
..*****************************************************************************
..PP-Werte (86;PlUmlprop)
.select assessment 'F|expr(U|xt01 + ";dart=(86)")'
..*****************************************************************************
!HNPP
..*****************************************************************************
.continue SVKZ ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L5
..*****************************************************************************
.continue C5 ? U|xi03 > 12
.formula M|ppmge.U|xi03 = H|s.U|xi03
.formula M|mon.U|xi03 = H|m.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L5
..
..*****************************************************************************
!C5
..*****************************************************************************
.select add H|umnum
.continue SVKZ ? _G|mehr
..
.select add H|ksab
.continue SVKZ ? _G|mehr
..
.. 74;Gpkv
.select accountdata 'F|formatstr("$,,@gruppe=3;gruppe=3;kosn={1};gjahr={2};bukreis={3};dart=(74)", H|id, M|gjahr, G|bukreis^id)'
.continue SVKZ ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L6
..*****************************************************************************
.continue SVKZ ? U|xi03 > 12
.formula M|ppvsatz.U|xi03  = H|s.U|xi03
.formula M|ppgvsatz.U|xi03 = H|s.U|xi03
.formula M|ppwert.U|xi03   = H|s.U|xi03:2  * M|ppmge.U|xi03
.formula M|ppgwert.U|xi03  = H|s.U|xi03  * M|ppmge.U|xi03
.formula M|ppdiff.U|xi03   = M|ppgwert.U|xi03  - M|ppwert.U|xi03
.formula M|pfwert.U|xi03   = ((H|s.U|xi03:2  * (M|pfmge.U|xi03 +M|ppmge.U|xi03)) * (M|pfmge.U|xi03/(M|pfmge.U|xi03+M|ppmge.U|xi03))) + (M|pfvsatz.U|xi03 * (M|pfmge.U|xi03+M|ppmge.U|xi03)) ? (M|pfmge.U|xi03+M|ppmge.U|xi03) <> 0
.formula M|pfgwert.U|xi03  = ((H|s.U|xi03    * (M|pfmge.U|xi03 +M|ppmge.U|xi03)) * (M|pfmge.U|xi03/(M|pfmge.U|xi03+M|ppmge.U|xi03))) + (M|pfgvsatz.U|xi03 * (M|pfmge.U|xi03+M|ppmge.U|xi03)) ? (M|pfmge.U|xi03+M|ppmge.U|xi03) <> 0
.formula M|pfdiff.U|xi03   = M|pfgwert.U|xi03  - M|pfwert.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L6
..
..*****************************************************************************
!SVKZ: Summenverkehrszahlen in Zeile schreiben
..*****************************************************************************
.continue END ? U|xi01 > U|xi02
.formula M|zistmge  = M|zistmge  + M|istmge.U|xi01
.formula M|zistwert = M|zistwert + M|istwert.U|xi01
.formula M|zpfmge   = M|zpfmge   + M|pfmge.U|xi01
.formula M|zpfwert  = M|zpfwert  + M|pfwert.U|xi01
.formula M|zppmge   = M|zppmge   + M|ppmge.U|xi01
.formula M|zppwert  = M|zppwert  + M|ppwert.U|xi01
.formula U|xi01 = U|xi01 + 1
.continue SVKZ
..
..*****************************************************************************
!END
..*****************************************************************************
.formula M|zpwert=M|zpfwert + M|zppwert
.continue

