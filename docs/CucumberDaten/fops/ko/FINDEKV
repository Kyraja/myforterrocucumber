..!interpreter english translate
..*****************************************************************************
..
..  Name      : FINDEKV
..  Datum     : 27.12.01
..  Vers.     : 11.4n1/11.3n6/10.5n9
..  Autor     : Silvia Hertweck
..
..  Verantwortlich : tiwe
..  Kontrolle : mh
..
..
..  Funktion  : Suche nach dynamischen Kostenverteilern, deren Betr„ge ein
..              falsches Vorzeichen besitzen;
..              betroffen sind folgende Felder im dynamischen KV:
..              - kvbsum
..              - kvebsum
..              - kvbrest
..              - kvebrest
..              - kvbetr (Tabelle)
..              - kvewbetr (Tabelle)
..  Verwendung von ko/FINDEKV im Test ref_sih_kv sowie zum Auffinden von
..  fehlerhaften dynamischen Kostenverteilern in Kundendatenbest„nden.
..
..*****************************************************************************
.set trans -
.input datei.f
.output addedto DRUCK.LST
.type text xnum
.type real xb xbsum
..
!J
.select acctrnsact
.continue ENDE ? _mehr
.formula xnum=num
!ZE
.select line
.continue J ? _mehr
.continue ZE ? kstelle <> "+       "
.formula xb=betrag
.add kstelle
.continue ZE ? xb = bsum
.formula xbsum=bsum
.add
'xnum'  'xb'     'xbsum'
.continue ZE
!ENDE
.end



