.set trans -
..
..!meta M|=ko/ACCREP
..!meta H|=P131:0.1
..
.println 'H|konto^id' # 'H|steuer^id' # 'H|laart(L=":")' # 'H|ev(L=":")' # 'H|kart(L=":")' # 'H|kstelle^id' # 'H|sbetr(L="0")' # 'H|hbetr(L="0")' # 'H|projekt^id' #             0 #              0 #            0 #             0 ? H|gruppe=0
.println 'H|konto^id' #       (0,0,0) #     (EmptyEntry) #  (EmptyEntry) #    (EmptyEntry) # 'H|kstelle^id' # 'H|sbetr(L="0")' # 'H|hbetr(L="0")' # 'H|projekt^id' # 'H|ppropbetr(L="0")' # 'H|phpropbetr(L="0")' # 'H|pfixbetr(L="0")' # 'H|phfixbetr(L="0")' ? H|gruppe=1
.copy U|xrssum = U|xrssum + H|sbetr
.copy U|xrhsum = U|xrhsum + H|hbetr
.continue END ? H|gruppe = 0
.copy U|xrsprop = U|xrsprop + H|ppropbetr
.copy U|xrhprop = U|xrhprop + H|phpropbetr
.copy U|xrsfix  = U|xrsfix  + H|pfixbetr
.copy U|xrhfix  = U|xrhfix  + H|phfixbetr
.continue END
