..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : LVKSBKS.EIN
..  Datum          : 01.09.2001
..  Version        :
..  Autor          : S.Riemer-MÅller
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Liste der Verdichtungskostenstellen
..                   mit ihren bebuchbaren Kostenstellen
..
..  Ablauf         : FeldprÅfung / Feldaustritt / Startbutton
..                   - fÅr Eingabe Kostenstelle - Selectfeld fÅllen
..
..*****************************************************************
..
.set trans -
.continue KSTEIN  ? evtvar="kstein" & evtartengl="FIELD_VALIDATION"
.continue KSTEIN  ? evtvar="kstein" & evtartengl="FIELD_EXIT"
.continue KSTEIN  ? evtvar="bstart" & evtartengl="BUTTON_BEFORE"
.continue
..
!KSTEIN:
.formula xtein=""
.add M|kstein
.continue NOKST ? _mehr
.formula xtein=D|num
.continue F01   ? evtvar="kstein" & D|bu
!NOKST:
.add
.continue         ? evtartengl="FIELD_VALIDATION"
..
.formula xtkey="$,,verd<>`"
.formula xtkey="$,,verd=" + xtein ? xtein <> ""
.formula xtkey=xtkey + ";@gruppe=2;@ordnung=nummer"
.formula M|select=xtkey
..
.continue
..
!F01:
.box
Kostenstelle 'xtein' ist bebuchbar.
.error
.end 1

