..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : FERTLEIST2.TAB
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..  Funktion       : Tabellen-FOP des Infosystems ko/FERTLEIST
..  Functionality  : Table-FOP of the Infosystem ko/FERTLEIST
..*****************************************************************************
.type bool xbinstorno ? _F|defined(U|xbinstorno)
.set trans -
..
.select line 'H|selzeile'
.copy U|xkart = H|kart
.continue END ? H|typ = 2 & _M|brm 
.continue END ? H|typ = 3 & _M|bsrm
.continue END ? _(U|xkart = 6 ; U|xkart = 4 ; U|xkart = 5 ; U|xkart = 11 ; U|xkart = 12)
..
.continue INSERT ? M|grouping = 0
..
..*****************************************************************************
!GRPCHANGE
..*****************************************************************************
.continue INSERT ? F|empty(U|xplkst)
.continue INSERT ? M|grouping = 1 & U|xplkst = H|kostobj^id
.continue INSERT ? M|grouping = 2 & U|xplkst = H|kstellemgr^id
..
.. group changed
..
.make screen line +O
.formula   M|tsumme = M|grouping
.assign M|tkstelle = U|xplkst  ? M|grouping = 1
.copy M|tkstelle = M|kstelle ? M|grouping = 2
.assign M|tmgkstl  = U|xplkst  ? M|grouping = 2
.copy M|tmgkstl  = M|mgkstl  ? M|grouping = 1
.formula   M|twert    = U|xrtwert
..
.colour -background 'U|xabassubtotal' 'M|aktzeile'
..
.formula   U|xrtwert = 0
..
.continue INSERT
..
..*****************************************************************************
!INSERT
..*****************************************************************************
.continue MAKESCREEN ?  _M|alle
.copy U|xbinstorno = G|FALSE
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledTimeCorrectionForFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationTimeCorrectionForFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledTimeEntryForFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationTimeEntryForFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledTimeCorrection)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationTimeCorrection)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledTimeEntry)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationTimeEntry)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledRecoveryFromWorkOrder)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationRecoveryFromWorkOrder)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledRecoveryFromFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationRecoveryFromFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledCompletionConfirmationForFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationCompletionConfirmationForFiledWorkOrderSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledCompletionConfirmation)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationCompletionConfirmation)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CanceledCompletionConfirmationWithoutWOSuggestion)")
.copy U|xbinstorno = G|TRUE ? F|equals(H|ppsref^typ, "(CancelationCompletionConfirmationWithoutWOSuggestion)")
.continue END ? U|xbinstorno & _M|bmitstorno 
..
!MAKESCREEN
.make screen line +O
.formula M|tsumme  = 0
.copy M|tursache   = H|ppsref
.assign M|rmtyp    = H|ppsref^typ
.assign M|tbewert  = H|id
.copy M|typ        = H|typ
.copy M|reparatur  = H|reparatur
.copy M|twaehrung  = M|waehrung
.copy M|tkart      = H|kart
.copy M|tvom       = H|tbudat
.copy M|tmgr       = H|mgr
.copy M|tkstelle   = H|kostobj
.copy M|tmgkstl    = H|kstellemgr
.copy M|tprojekt   = H|projekt
.copy M|tvwbu      = H|buref
.copy M|tfidat     = H|buref^budat
.copy M|tvwbuue    = H|buueref
.copy M|tfidatue   = H|buueref^budat
.copy M|tbelast    = H|koreso
.copy M|tentlast   = H|koreha
.copy M|tgebucht   = _F|empty(H|buref)
.copy M|tgebuchtue = _F|empty(H|buueref)
.formula   M|tmge     = H|tmge
.formula   M|tbewpr   = F|fxamount(M|twaehrung, H|tbewpr , G|datum, H|tiwbu)
.formula   M|twert    = H|tmge * H|tbewpr
.formula   U|xrtwert  = U|xrtwert + M|twert
..
.formula   M|mfixsum  = M|mfixsum  + M|twert ? U|xkart = 4
.formula   M|mvarsum  = M|mvarsum  + M|twert ? U|xkart = 5
.formula   M|bsumme   = M|bsumme   + M|twert ? U|xkart = 6
.formula   M|skfixsum = M|skfixsum + M|twert ? U|xkart = 11
.formula   M|skvarsum = M|skvarsum + M|twert ? U|xkart = 12
..
.formula   M|mzsumme  = M|mzsumme  + M|tmge  ? U|xkart = 5
.formula   M|bzsumme  = M|bzsumme  + M|tmge  ? U|xkart = 6
..
.colour -background "-1 -1 -1" 'M|aktzeile'
..
.continue END ? M|grouping = 0
..
.copy U|xplkst   = M|tkstelle^id  ? M|grouping = 1
.copy U|xplkst   = M|tmgkstl^id   ? M|grouping = 2
.continue END
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue

