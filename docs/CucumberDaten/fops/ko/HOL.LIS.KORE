.set trans -
.select accountdata 'M|select'
.continue END1 ? _mehr
.formula M|stufe=M|stufe+1
.input 'M|bkopf'
!HOL0:
.continue END0 ? _mehr
.input 'M|tab'
!NEXT0:
.select account
.continue HOL0
!END0:
.input 'M|bfuss'
.formula M|stufe=M|stufe-1
.continue
!END1
.box
Keine Daten vorhanden!
.end 1

