..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BABNEU.COLORS
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Setzt die Farben im Infosystem ko/BABNEU
..*****************************************************************************
.set trans -
..
.input "is/ABASFARBEN.DEF"
..
.select screen header
..*****************************************************************************
!LOOP
..*****************************************************************************
.select screen line
.continue END ? _G|mehr
.colour -background 'U|xabastotal' 'M|aktzeile'  ? M|koart^gruppe  = 2
.colour -background -1 -1 -1       'M|aktzeile'  ? M|koart^gruppe <> 2
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

