..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : LVKTBKT.EIN
..  Datum          : 01.09.2001
..  Version        :
..  Autor          : S.Riemer-MÅller
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Liste der VerdichtungskostentrÑger
..                   mit seinen bebuchbaren KostentrÑgern
..
..  Ablauf         : FeldprÅfung / Feldaustritt / Startbutton
..                   - fÅr Eingabe KostentrÑger - Selectfeld fÅllen
..
..*****************************************************************
..
.set trans -
.continue KTREIN  ? evtvar="ktrein" & evtartengl="FIELD_VALIDATION"
.continue KTREIN  ? evtvar="ktrein" & evtartengl="FIELD_EXIT"
.continue KTREIN  ? evtvar="bstart" & evtartengl="BUTTON_BEFORE"
.continue
..
!KTREIN:
.formula xtein=""
.add M|ktrein
.continue NOKST ? _mehr
.formula xtein=D|num
.continue F01   ? evtvar="ktrein" & D|bu
!NOKST:
.add
.continue         ? evtartengl="FIELD_VALIDATION"
..
.formula xtkey="$,,verd<>`"
.formula xtkey="$,,verd=" + xtein ? xtein <> ""
.formula xtkey=xtkey + ";@gruppe=4"
.formula M|select=xtkey
..
.continue
..
!F01:
.box
KostentrÑger 'xtein' ist bebuchbar.
.error
.end 1

