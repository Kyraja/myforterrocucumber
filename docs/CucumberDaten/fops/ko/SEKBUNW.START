!START
..*****************************************************************************
.assign M|grliste = "131:1"
.formula   M|select  = F|formatstr("$,bukreis={1};@gruppe=1;gruppe=1;sortgjgm={2}!{3};kstelle={4};vkzart={5};ursache=(73);konto^stat=(66);@ordnung=0:sortgjgm,0:budat,0:bunummer;@zeilen=(1)", G|bukreis^id, F|fysortdat(M|gjahr, M|vgmon), F|fysortdat(M|gjahr, M|bgmon), M|kszu^id, F|condexpr(F|value(M|vkzart,"AU97")<>"(66)", F|value(M|vkzart,"AU97"), ""))
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

