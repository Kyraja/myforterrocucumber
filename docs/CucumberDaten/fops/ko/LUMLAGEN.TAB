..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : <rl-abas-system-berlin>
.. Verantwortlich : tiwe
.. Kontrolle      : mh
..
..*****************************************************************************
.set trans -
.type text xsel  ? _F|defined(U|xsel)
.type text xt01  ? _F|defined(U|xt01)
.type integer  xi01  ? _F|defined(U|xi01)
.type integer  xi02  ? _F|defined(U|xi02)
.type integer  xi03  ? _F|defined(U|xi03)
..
..Gesch„ftsmonate merken
.formula U|xi01 = M|vgmon
.formula U|xi02 = M|bgmon
..
.make screen line +O
.copy M|umlage = U|xtuml
.copy M|ksab   = U|xtksab
.copy M|kszu   = U|xtkszu
.copy M|tgjahr = M|gjahr
.formula   M|trichtung = M|richtung
.formula   M|zpm       = "+"
.formula   M|zmonat    = 'M|vgmon' + "-" + 'M|bgmon'
..
.copy M|bezug = M|ksab^bezug
.formula   M|abk   = M|bezug^abk
..
.formula U|xt01 = F|formatstr("$,,@gruppe=3;gruppe=3;umsn={1};kstelle={2};gjahr={3};bukreis={4}", U|xtuml, M|kszu^id, M|gjahr, G|bukreis^id)
..
..Ist-VKZ
.. IstUml
.formula U|xsel = U|xt01 + ";dart=(78)"
.select assessment 'U|xsel'
!HNIST
.continue HPF ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L1
..*****************************************************************************
.continue HPF ? U|xi03 > 12
.formula M|ist.U|xi03 = H|s.U|xi03
.formula M|mon.U|xi03 = H|m.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L1
..
..*****************************************************************************
!HPF
..*****************************************************************************
.select -
..PF-VKZ
.. PlUmlfix
.formula U|xsel = U|xt01 + ";dart=(79)"
.select assessment 'U|xsel'
..*****************************************************************************
!HNPF
..*****************************************************************************
.continue HPP ? _G|mehr
.formula U|xi03 = 1
..*****************************************************************************
!L2
..*****************************************************************************
.continue HPP ? U|xi03 > 12
.formula M|pf.U|xi03 = H|s.U|xi03
.formula M|mon.U|xi03 = H|m.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L2
..
..*****************************************************************************
!HPP
..*****************************************************************************
.select -
..PP-VKZ
.. PlUmlprop
.formula U|xsel = U|xt01 + ";dart=(86)"
.select assessment 'U|xsel'
..*****************************************************************************
!HNPP
..*****************************************************************************
.continue SVKZ ? _G|mehr
..
.formula U|xi03 = 1
..*****************************************************************************
!L3
..*****************************************************************************
.continue SVKZ ? U|xi03 > 12
.formula M|pp.U|xi03 = H|s.U|xi03
.formula M|mon.U|xi03 = H|m.U|xi03
.formula U|xi03 = U|xi03 + 1
.continue L3
..
..*****************************************************************************
!SVKZ: Summenverkehrszahlen in Zeile schreiben
..*****************************************************************************
.continue END ? U|xi01 > U|xi02
.formula M|zist = M|zist + M|ist.U|xi01
.formula M|zpf  = M|zpf  + M|pf.U|xi01
.formula M|zpp  = M|zpp  + M|pp.U|xi01
.formula U|xi01 = U|xi01 + 1
.continue SVKZ
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
