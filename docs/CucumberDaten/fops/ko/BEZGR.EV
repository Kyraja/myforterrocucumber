..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : BEZGR.EV
..  Datum          : 19.01.2006
..  Version        : 1
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Event-FOP des Infosystems ko/BEZGR
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  :
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
..*****************************************************************************
..
.set trans -
.continue START    ? G|evtvar = "bstart"   & G|evtartengl = "BUTTON_BEFORE"
.continue COCENTER ? G|evtvar = "tbkst"    & G|evtartengl = "BUTTON_BEFORE"
.continue PERIOD   ? G|evtvar = "amonat"
.continue PERIOD   ? G|evtvar = "emonat"
.continue PERIOD   ? G|evtvar = "ajahr"
.continue PERIOD   ? G|evtvar = "ejahr"
.continue PERIOD   ? G|evtvar = "adatum"
.continue PERIOD   ? G|evtvar = "edatum"
.continue INIT     ? G|evtvar = "bezgrvon" & G|evtartengl = "FIELD_EXIT"
.continue INIT     ? G|evtvar = "bezgrbis" & G|evtartengl = "FIELD_EXIT"
..
..
..*****************************************************************************
!PERIOD: Period changed
..*****************************************************************************
.set trans -
.type text xxtsmon xxtemon xxtsyear
.type text xxteyear xxtfromd xxttod
..
.formula U|xxtsmon  = "amonat"
.formula U|xxtemon  = "emonat"
.formula U|xxtsyear = "ajahr"
.formula U|xxteyear = "ejahr"
.formula U|xxtfromd = "adatum"
.formula U|xxttod   = "edatum"
..
.input "fb/IS.SETPERIOD"
.continue END
..
..*****************************************************************************
!INIT
..*****************************************************************************
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.input "is/TABLEEREN"
..RangeCheck
.type GL30 xpvon ? _F|defined(U|xpvon)
.type GL30 xpbis ? _F|defined(U|xpbis)
.formula U|xpvon = "bgrvon"
.formula U|xpbis = "bgrbis"
.input "is/RANGECHECK"
.formula M|select = 'M|bgrvon' + "!" + 'M|bgrbis'
.formula M|datnr  = 61
.formula M|grp    = 2
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!COCENTER: show cost centers
..*****************************************************************************
.type text xtsys
..
.formula U|xtsys = 'G|kkomname38' + " BEZGRKST ? "
.formula U|xtsys = U|xtsys + "bgrvon="  + 'M|tbezgr^nummer' + "|"
.formula U|xtsys = U|xtsys + "bgrbis="  + 'M|tbezgr^nummer' + "|"
.formula U|xtsys = U|xtsys + "bstart="  + "true"
.command -parallel 'U|xtsys'
.continue END
..
..*****************************************************************************
!END: end
..*****************************************************************************
.continue
