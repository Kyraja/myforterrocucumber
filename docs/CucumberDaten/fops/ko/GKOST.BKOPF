..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : GKOST.BKOPF
..  Autor          : male
..  Verantwortlich : tiwe
..  Kontrolle      : mh
..  Funktion       : Berichtskopf-FOP fuer das Infosystem ko/GKOST
..  Functionality  : Report header event FOP for the Infosystem ko/GKOST
..*****************************************************************************
.type text xtselktr    ? _F|defined(U|xtselktr)
.type text xpvon xpbis ? _F|defined(U|xpvon)
..*****************************************************************************
..
.set trans -
..
.formula U|xpvon    = "ktrvon"
.formula U|xpbis    = "ktrbis"
.input "is/RANGECHECK"
.formula U|xtselktr = "$,@gruppe=4;gruppe=4"
.formula U|xtselktr = U|xtselktr + ";@numsuch=" + M|ktrvon + "!" + M|ktrbis
.formula U|xtselktr = U|xtselktr + ";bu=1"
.formula U|xtselktr = U|xtselktr + ";@ordnung=nummer"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
