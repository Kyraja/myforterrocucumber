..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CHANGECURRENCY.YBUKONFIG.BA
.. Date           : 10.03.15
.. Version        : 2015r2n04
.. Author         : si/dr
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xterr      ? _F|defined(U|xterr)
..
.continue NOLAND        ? F|empty(M|yland)
.continue NODATE        ? F|empty(M|ydate)
..
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xterr
.continue KONF
..
!BETR
.set trans +
.text U|xttext 'G|bspri' Betriebsdaten werden geÑndert
.set trans -
.note -IMMEDIATELY 'U|xttext'
..
.output NEW 'U|xterr'
.output NEW 'U|xtedp'
#!database=12
#!group=10
#!action=update
id;lainland;laart;
'M|ybetr^id';'M|yland^id';'M|yland^laart';
.output
.edi 'U|xtedp'
.formula U|xtcmd        = "edpimport.sh -p abas123 -o SHOWTEXT=0 -o SHOWNOTES=0 -I " + U|xtedp
.formula U|xtcmd        = U|xtcmd + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue ERROR1        ? F|filesize(U|xterr) > 0
.continue ERROR1        ? _'M|ybetr^inland^id' = 'M|yland^id'
..
.colour -BACKGROUND 0 255 0 ybetr
..
!KONF
.continue END           ? 'M|ycurr^id' = 'G|inland^id'
..
.set trans +
.text U|xttext 'G|bspri' Konfiguration wird geÑndert
.set trans -
.note -IMMEDIATELY 'U|xttext'
..
.output NEW 'U|xterr'
.output NEW 'U|xtedp'
.input DATEI.F
#!EDP_TESTFLAG2=1
#!database=12
#!group=18
#!action=update
id;inland;eg;elster; 
'M|ykonfig^id';'M|ycurr^id';'G|false';'G|false';
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -o SHOWTEXT=0 -o SHOWNOTES=0 -I " + U|xtedp
.formula U|xtcmd        = U|xtcmd + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue ERROR2        ? F|filesize(U|xterr) > 0
.continue ERROR2        ? _'M|ykonf^inlnad^id' = 'M|ycurr^id'
..
.colour -BACKGROUND 0 255 0 ykonf
..
.set trans +
.text U|xttext 'G|bspri' Maskengenerierung lÑuft - bitte nicht abbrechen
.set trans -
.note -IMMEDIATELY 'U|xttext'
..
!WAEHR
.set trans +
.text U|xttext 'G|bspri' WÑhrungskurse werden geÑndert
.set trans -
.note -IMMEDIATELY 'U|xttext'
..
.continue END


!ERROR1
.set trans +
.text U|xttext 'G|bspri' Die énderung der Betriebsdaten ist fehlgeschlagen!
.set trans -
.error 'U|xttext'
.edi -READONLY 'U|xterr'
.continue END
..
!ERROR2
.set trans +
.text U|xttext 'G|bspri' Die énderung der Konfiguration ist fehlgeschlagen!
.set trans -
.error 'U|xttext'
.edi -READONLY U|xterr'
.continue END
..
!NOLAND
.set trans +
.text U|xttext 'G|bspri' Sie mÅssen erst ein neues Land eingeben!
.set trans -
.error 'U|xttext'
.continue END
..
!NODATE
.set trans +
.text U|xttext 'G|bspri' Sie mÅssen erst ein Datum eingeben!
.set trans -
.error 'U|xttext'
.continue END
..
!END
.continue
