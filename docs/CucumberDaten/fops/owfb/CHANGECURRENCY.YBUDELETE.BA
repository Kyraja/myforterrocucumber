..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CHANGECURRENCY.YBUDELETE.BA
.. Date           : 11.03.15
.. Version        : 2015r2n04
.. Author         : si/dr
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xterr      ? _F|defined(U|xterr)
..
.continue END           ? M|tzeilen = 0
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xterr
..
!LINES
.select screen line
.continue END           ? _G|mehr
..
.continue LINES         ? M|ytausschl
.continue LINES         ? F|empty(M|ytimport)
..
.note -IMMEDIATELY Zeile 'M|aktzeile' 'M|ytvarbez'
..
.set separator @
.output NEW 'U|xterr'
.output NEW 'U|xtedp'
.input DATEI.F
.input 'M|ytimport'
.output
..
.formula U|xtcmd        = "edpimport.sh -P -a DELETE -b " + 'M|ytvdn' + ":" + 'M|ytvgr' + " -I " + U|xtedp
.formula U|xtcmd        = "edpimport.sh -P -a UPDATE -b " + 'M|ytvdn' + ":" + 'M|ytvgr' + " -I " + U|xtedp      ? M|ybupdate
.formula U|xtcmd        = U|xtcmd + " -o FOPMODE=0 2>" + U|xterr
.system 'U|xtcmd' PASSWORD background
..
.formula M|ytdone       = G|true
.continue LINES         ? F|filesize(U|xterr) = 0
.formula M|ytdone       = G|false
.formula M|yterror      = U|xterr
.continue LINES
..
!END
.note -IMMEDIATELY
.continue
