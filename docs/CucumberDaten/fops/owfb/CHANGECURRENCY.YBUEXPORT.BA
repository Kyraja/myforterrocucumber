.continue END           ? M|tzeilen = 0
.continue NODATE        ? F|empty(M|ydate)
..
!LINES
.select screen line
.continue END           ? _G|mehr
..
.continue NOVARTAB      ? F|empty(M|ytvartab)
.continue NOTABFLD      ? M|yttab & F|empty(M|ytfld)
.continue NOELISTE      ? F|empty(M|ytefliste)
.continue NOFLISTE      ? F|empty(M|ytfliste)
..
.note -IMMEDIATELY Zeile 'M|aktzeile': 'M|ytvarbez'
.input owfb/CHANGECURRENCY.YTBUEXP.BA
.continue LINES
..
!NOVARTAB
.cursor ytvartab 'M|aktzeile'
.error "In dieser Zeile fehlt die Vartab!"
.continue END
..
!NOTABFLD
.cursor ytfld 'M|aktzeile'
.error "In dieser Zeile fehlt das Tabellenwechselfeld!"
.continue END
..
!NOELISTE
.cursor ytefliste 'M|aktzeile'
.error "In dieser Zeile fehlt die Export-Feldliste!"
.continue END
..
!NOFLISTE
.cursor ytfliste 'M|aktzeile'
.error "In dieser Zeile fehlt die Import-Feldliste!"
.continue END
..
!NODATE
.error "Kein Datum fÅr den Umrechnungskurs eingegeben"
.continue END
..
!END
.note -IMMEDIATELY
.continue
