..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type R7.2 U|xrinput    ? _F|defined(U|xrinput)
.type R7.2 U|xroutput   ? _F|defined(U|xroutput)
.type integer U|xiz     ? _F|defined(U|xiz)
..
.formula U|xiz          = -7
.formula U|xrinput      = 1234567,89
..
.output TERMINAL
.input BILD.F

max. Vorkommastellen:   -7
max. Nachkommastellen:  +2

Beispiel-Betrag:  'U|xrinput'
!LOOP
.formula U|xiz          = U|xiz + 1
.continue END           ? U|xiz >= 3

.formula U|xroutput     = 'F|round(U|xrinput, U|xiz)'
Genauigkeit:      '  U|xiz'       Ergebnis: 'U|xroutput'
.continue LOOP
..
!END
.output TERMINAL ...
.end 1
