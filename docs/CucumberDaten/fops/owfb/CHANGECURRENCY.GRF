.formula U|xia          = 0
!ZANLKTO
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|afako^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|afako) & _U|xttmp/" + G|dblquote + "*" + '0|afako^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|bilkto^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|bilkto) & _U|xttmp/" + G|dblquote + "*" + '0|bilkto^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|gewko^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|gewko) & _U|xttmp/" + G|dblquote + "*" + '0|gewko^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|verko^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|verko) & _U|xttmp/" + G|dblquote + "*" + '0|verko^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|erlko^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|erlko) & _U|xttmp/" + G|dblquote + "*" + '0|erlko^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.load 0 nolock continue
.continue ZANLKTO       ? G|mehr
.continue ANLIMP        ? F|empty(U|xttmp)
!TANL
.formula U|xxkto        = U|xttmp << ","
.continue FANL          ? F|empty(U|xxkto)
.formula U|xttmp        = U|xttmp >> ","
.continue TANL          ? U|xxkto/"*a"
.formula U|xtcmd        = "$,@datei=5:1;nummer=="+U|xxkto+"a"
.select nolock account 'U|xtcmd'
.continue TANL          ? G|mehr
'U|xxkto';'U|xxkto'a;KOWEG;(0,0,0);(0,0,0);'G|false';
.formula U|xia          = U|xia + 1
.continue TANL
!FANL
.output
.continue ANLIMP        ? U|xia = 0
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Duplizieren der Konten aus Anlagen
.set trans -
.continue ERRANL        ? F|filesize(U|xterr) > 0
!ANLIMP
.continue KOWEG
..jetzt die duplizierten Konten in die Zuordnungsmerkmale eintragen
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten in Abschreibungsmodellen austauschen
#!database=27
#!group=1
#!action=update
id;>bafamodell;afako;bilkto;gewko;verko;erlko;<
.formula U|xtcmd        = "$,@datei=27:10;id=;kpmodart=(Taxable)"
.load 0 nolock object 'U|xtcmd'
.continue KOWEG         ? _G|mehr
!XANLDAT
.formula U|xkto1        = ""
.formula U|xkto2        = ""
.formula U|xkto3        = ""
.formula U|xkto4        = ""
.formula U|xkto5        = ""
.formula U|xkto1        = '0|afako^nummer' + "a"
.formula U|xkto2        = '0|bilkto^nummer' + "a"
.formula U|xkto3        = '0|gew^nummer' + "a"          ? _F|empty(0|gewko)
.formula U|xkto4        = '0|verko^nummer' + "a"        ? _F|empty(0|verko)
.formula U|xkto5        = '0|erlko^nummer' + "a"        ? _F|empty(0|erlko)
'0|ansn^id';;'U|xkto1';'U|xkto2';'U|xkto3';'U|xkto4';'U|xkto5';
.load 0 nolock continue
.continue XANLDAT       ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Update der Konten in Anlagen
.set trans -
.continue KOWEG         ? F|filesize(U|xterr) = 0
!ERRANL
.error 'U|xttext'
.edi 'U|xterr'
.continue END
..
..************************************************************************************
!KOWEG: jetzt kînnen alle Konten - bis auf die statitischen Konten - gelîscht werden
..************************************************************************************
..folgende Objekte kînnen noch auf Konten verweisen:
..V-89-06 - Gliederungsabbildung (im Demosystem nicht vorgesehen)
..V-89-02 - Konsolidierungskonfiguration (hier nicht relevant, sonst nur fÅr einen echten Konsolidierungs-Mandant)
..in Zusatztabellen !? (nur relevant, wenn dort Finanzkonten vorkommen - Statistische Konten bleiben erhalten, z.B. ProjectSuite)
..
..statistische Konten bleiben erhalten - ebenso die mit dieser Aktion erzeugten Konten mit Anhang "a"
!HKO1: 
.note -IMMEDIATELY Lîschen von bebuchbaren Inlandskonten!
!KO4
.select account lock
.continue HKO5 ? _G|mehr
.continue KO4  ? _F|empty(H|stat)
.continue KO4  ?  H|nummer/"*(az)*"
.continue KO4  ? _(H|laart = "I" & H|bu)
.delete
.note -IMMEDIATELY Lîschen von bebuchbaren Inlandskonten - Konto 'H|nummer'
.continue KO4
..
!HKO5: 
.note -IMMEDIATELY Lîschen von bebuchbaren Auslandskonten!
!KO5
.select account lock
.continue HKO6 ? _G|mehr
.continue KO5  ? _F|empty(H|stat)
.continue KO5  ?  H|nummer/"*(az)*"
.continue KO5  ? _(H|laart = "A" & H|bu)
.delete
.note -IMMEDIATELY Lîschen von bebuchbaren Auslandskonten - Konto 'H|nummer'
.continue KO5
..
!HKO6
.note -IMMEDIATELY Lîschen von bebuchbaren EG-Konten!
!KO6
.select account lock
.continue HKO7 ? _G|mehr
.continue KO6  ? _F|empty(H|stat)
.continue KO6  ?  H|nummer/"*(az)*"
.continue KO6  ? _(H|laart = "E" & H|bu)
.delete
.note -IMMEDIATELY Lîschen von bebuchbaren EG-Konten - Konto 'H|nummer'
.continue KO6
..
!HKO7
.note -IMMEDIATELY Lîschen von nicht bebuchbaren Inlandskonten!
!KO10
.select account lock
.continue HKO11 ? _G|mehr
.continue KO10  ? _(H|laart = "I" & _H|bu)
.continue KO10  ?  H|nummer/"*(az)*"
.delete
.note -IMMEDIATELY Lîschen von nicht bebuchbaren Inlandskonten - Konto 'H|nummer'
.continue KO10
..
!HKO11
.note -IMMEDIATELY Lîschen von nicht bebuchbaren Auslandskonten!
!KO11
.select account lock
.continue HKO12 ? _G|mehr
.continue KO11  ? _(H|laart = "A" & _H|bu)
.continue KO11  ?  H|nummer/"*(az)*"
.delete
.note -IMMEDIATELY Lîschen von nicht bebuchbaren Auslandskonten - Konto 'H|nummer'
.continue KO11
..
!HKO12
.note -IMMEDIATELY Lîschen von nicht bebuchbaren EG-Konten!
!KO12
.select account lock
.continue END  ? _G|mehr
.continue KO12 ? _(H|laart = "E" & _bu)
.continue KO12  ?  H|nummer/"*(az)*"
.delete
.note -IMMEDIATELY Lîschen von nicht bebuchbaren EG-Konten - Konto 'H|nummer'
.continue KO12
..
!NOWARTG
.set trans +
.text U|xttext 'G|bspri' Aktion ist nur im Wartungsmodus erlaubt
.set trans -
.error 'U|xttext'
.continue END
..
!END
.note -IMMEDIATELY
.continue

