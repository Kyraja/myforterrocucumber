# Konten aus Kostenrechnungskonfiguration duplizieren
#!database=5
#!group=1
#!action=copy
id;nummer;bem;eg;ausland;kopustzuord;
.formula U|xtcmd        = "$,@datei=58:1;nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue USTZUO        ? _G|mehr
.formula U|xia          = 0
.continue ZSTS
!XSTS
.load 0 nolock continue
.continue NSTS          ? _G|mehr
!ZSTS
.load 0 nolock line
.continue XSTS          ? _G|mehr
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|ekst^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|ekst) & _U|xttmp/" + G|dblquote + "*" + '0|ekst^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|vkst^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|vkst) & _U|xttmp/" + G|dblquote + "*" + '0|vkst^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|eksk^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|eksk) & _U|xttmp/" + G|dblquote + "*" + '0|eksk^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|vksk^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|vksk) & _U|xttmp/" + G|dblquote + "*" + '0|vksk^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.load 0 nolock continue
.continue ZSTS          ? G|mehr
.continue SSTS          ? F|empty(U|xttmp)
!TSTS
.formula U|xxkto        = U|xttmp << ","
.continue NSTS          ? F|empty(U|xxkto)
.formula U|xttmp        = U|xttmp >> ","
.continue TSTS          ? U|xxkto/"*a"
.formula U|xtcmd        = "$,@datei=5:1;nummer=="+U|xxkto+"a"
.select nolock account 'U|xtcmd'
.continue TSTS          ? G|mehr
'U|xxkto';'U|xxkto'a;KOWEG;(0,0,0);(0,0,0);'G|false';
.formula U|xia          = U|xia + 1
.continue TSTS
!NSTS
.output
.continue SSTS          ? U|xia = 0
.formula M|ytimport     = U|xtedp
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Duplizieren der Konten aus SteuerschlÅsseln
.set trans -
.continue ERRSTS        ? F|filesize(U|xterr) > 0
!SSTS
..jetzt die neuen Konten in die SteuerschlÅssel eintragen
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
