# Konten aus Mitarbeitern entfernen
#!database=11
#!group=1
#!action=update
id;verd;
.formula U|xtcmd        = "$,@database=11;@group=1;nummer=!;verd<>`"
.load 0 nolock object 'U|xtcmd'
.continue WGR           ? _G|mehr
!Z1101
'0|id';(0,0,0);
.load 0 nolock continue
.continue Z1101         ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue WGR           ? F|filesize(U|xterr) = 0
.set trans +
.text U|xttext 'G|bspri' Fehler beim Lîschen der Konten aus den Mitarbeitern
.set trans -
.error 'U|xttext'
.continue END
..
!WGR: Warengruppen Ñndern
.make screen line +o
.assign M|ytvartab      = "V-12-28"
.formula M|ytvarbez     = M|ytvartab^namebspr
.formula M|ytvdn        = M|ytvartab^vdn
.formula M|ytvgr        = M|ytvartab^vgr
.formula M|ytimport     = U|xtedp
..
.note -IMMEDIATELY Kontierung in Warengruppen austauschen
..erst alle Konten kopieren
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten aus Warengruppen duplizieren
#!database=5
#!group=1
#!action=copy
id;nummer;bem;eg;ausland;kopustzuord;
.formula U|xtcmd        = "$,@datei=12:28;nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue PGR           ? _G|mehr
.formula U|xttmp        = ""
.formula U|xia          = 0
!ZWGR
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|bestand^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|bestand) & _U|xttmp/" + G|dblquote + "*" + '0|bestand^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|bestgelniber^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|bestgelniber) & _U|xttmp/" + G|dblquote + "*" + '0|bestgelniber^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|bewdiff^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|bewdiff) & _U|xttmp/" + G|dblquote + "*" + '0|bewdiff^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|bvkst^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|bvkst) & _U|xttmp/" + G|dblquote + "*" + '0|bvkst^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|bvktr^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|bvktr) & _U|xttmp/" + G|dblquote + "*" + '0|bvktr^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|korrmge^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|korrmge) & _U|xttmp/" + G|dblquote + "*" + '0|korrmge^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|lohnkst^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|lohnkst) & _U|xttmp/" + G|dblquote + "*" + '0|lohnkst^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|lohnktr^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|lohnktr) & _U|xttmp/" + G|dblquote + "*" + '0|lohnktr^nummer'+ "*" + G|dblquote
.'U|xtcmd'
..
.load 0 nolock continue
.continue ZWGR          ? G|mehr
.continue IMPWGR        ? F|empty(U|xttmp)
!TWGR
.formula U|xxkto        = U|xttmp << ","
.continue FWGR          ? F|empty(U|xxkto)
.formula U|xttmp        = U|xttmp >> ","
.continue TWGR          ? U|xxkto/"*a"
.formula U|xtcmd        = "$,@datei=5:1;nummer=="+U|xxkto+"a"
.select nolock account 'U|xtcmd'
.continue TWGR          ? G|mehr
'U|xxkto';'U|xxkto'a;KOWEG;(0,0,0);(0,0,0);'G|false';
.formula U|xia          = U|xia + 1
.continue TWGR
!FWGR
.output
.continue PGR           ? U|xia = 0
.formula M|ytimport     = U|xtedp
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Duplizieren der Konten aus Warengruppen
.set trans -
.continue ERRWGR        ? F|filesize(U|xterr) > 0
!IMPWGR
..jetzt die duplizierten Konten in die Warengruppen eintragen
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten in Warengruppen austauschen
#!database=12
#!group=28
#!action=update
id;bestand;bestgelniber;bewdiff;bvkst;bvktr;korrmge;lohnkst;lohnktr;
.formula U|xtcmd        = "$,@datei=12:28;nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue PGR           ? _G|mehr
!XWGR
.formula U|xkto1        = ""
.formula U|xkto2        = ""
.formula U|xkto3        = ""
.formula U|xkto4        = ""
.formula U|xkto5        = ""
.formula U|xkto6        = ""
.formula U|xkto7        = ""
.formula U|xkto8        = ""
.formula U|xkto1        = '0|bestand^nummer' + "a"      ? _F|empty(0|bestand)
.formula U|xkto2        = '0|bestgelniber^nummer' + "a" ? _F|empty(0|bestgelniber)
.formula U|xkto3        = '0|bewdiff^nummer' + "a"      ? _F|empty(0|bewdiff)
.formula U|xkto4        = '0|bvkst^nummer' + "a"        ? _F|empty(0|bvkst)
.formula U|xkto5        = '0|bvktr^nummer' + "a"        ? _F|empty(0|bvktr)
.formula U|xkto6        = '0|korrmge^nummer' + "a"      ? _F|empty(0|korrmge)
.formula U|xkto7        = '0|lohnkst^nummer' + "a"      ? _F|empty(0|lohnkst)
.formula U|xkto8        = '0|lohnktr^nummer' + "a"      ? _F|empty(0|lohnktr)
'0|id';'U|xkto1';'U|xkto2';'U|xkto3';'U|xkto4';'U|xkto5';'U|xkto6';'U|xkto7';'U|xkto8';
.load 0 nolock continue
.continue XWGR          ? G|mehr
.output
.formula M|ytimport     = U|xtedp
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Update der Konten in Warengruppen
.set trans -
.continue PGR           ? F|filesize(U|xterr) = 0
!ERRWGR
.formula M|yterror      = U|xterr
.error 'U|xttext'
.edi 'U|xterr'
.continue END
..
!PGR: Produktgruppen Ñndern
.make screen line +o
.assign M|ytvartab      = "V-12-29"
.formula M|ytvarbez     = M|ytvartab^namebspr
.formula M|ytvdn        = M|ytvartab^vdn
.formula M|ytvgr        = M|ytvartab^vgr
.formula M|ytimport     = U|xtedp
..
.note -IMMEDIATELY Kontierung in Produktgruppen austauschen
..erst alle Konten kopieren
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten aus Produktgruppen duplizieren
#!database=5
#!group=1
#!action=copy
id;nummer;bem;eg;ausland;kopustzuord;
.formula U|xtcmd        = "$,@datei=12:29;nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue KOREKONF      ? _G|mehr
.formula U|xttmp        = ""
.formula U|xia          = 0
!ZPGR
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|uebest^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|uebest) & _U|xttmp/" + G|dblquote + "*" + '0|uebest^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|ueaend^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|ueaend) & _U|xttmp/" + G|dblquote + "*" + '0|ueaend^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.formula U|xtcmd        = "formula U|xttmp = U|xttmp + '0|pgerlo^nummer' + "+ G|dblquote + "," + G|dblquote + " ? _F|empty(0|pgerlo) & _U|xttmp/" + G|dblquote + "*" + '0|pgerlo^nummer'+ "*" + G|dblquote
.'U|xtcmd'
.load 0 nolock continue
.continue ZPGR          ? G|mehr
.continue IMPPGR        ? F|empty(U|xttmp)
!TPGR
.formula U|xxkto        = U|xttmp << ","
.continue FPGR          ? F|empty(U|xxkto)
.formula U|xttmp        = U|xttmp >> ","
.continue TPGR          ? U|xxkto/"*a"
.formula U|xtcmd        = "$,@datei=5:1;nummer=="+U|xxkto+"a"
.select nolock account 'U|xtcmd'
.continue TPGR          ? G|mehr
'U|xxkto';'U|xxkto'a;KOWEG;(0,0,0);(0,0,0);'G|false';
.formula U|xia          = U|xia + 1
.continue TPGR
!FPGR
.output
.continue IMPPGR        ? U|xia = 0
.formula M|ytimport     = U|xtedp
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
