.type text U|xttext     ? _F|defined(U|xttext)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xttmp      ? _F|defined(U|xttmp)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type text U|xkto1      ? _F|defined(U|xkto1)
.type text U|xkto2      ? _F|defined(U|xkto2)
.type text U|xkto3      ? _F|defined(U|xkto3)
.type text U|xkto4      ? _F|defined(U|xkto4)
.type text U|xkto5      ? _F|defined(U|xkto5)
.type text U|xkto6      ? _F|defined(U|xkto6)
.type text U|xkto7      ? _F|defined(U|xkto7)
.type text U|xkto8      ? _F|defined(U|xkto8)
.type text U|xkto9      ? _F|defined(U|xkto9)
.type text U|xxkto      ? _F|defined(U|xxkto)
.type integer U|xiz     ? _F|defined(U|xiz)
.type integer U|xia     ? _F|defined(U|xia)
..
.continue NOWARTG       ? _G|wartung
..
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xtout
.file -TEMPNAME U|xterr
.formula U|xiz  = 0
.make screen line --    ? M|tzeilen > 0
..
!FIBUOPEN
.continue V1207
.select company "$,gruppe=12;@gruppe=12"
.continue V1207 ? _G|mehr
.continue V1207 ? F|empty(H|erend)
.set trans +
.text U|xttext 'G|bspri' Fibu-Erîffnung schon abgeschlossen
.set trans -
.error 'U|xttext'!
.continue END
..
!V1207: Standardkontierung
.make screen line +o
.assign M|ytvartab      = "V-12-07"
.formula M|ytvarbez     = M|ytvartab^namebspr
.formula M|ytvdn        = M|ytvartab^vdn
.formula M|ytvgr        = M|ytvartab^vgr
..
.note -IMMEDIATELY Kontierung in der Standardkontierung austauschen
..erst alle Konten kopieren
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten aus Standardkontierung duplizieren
#!database=5
#!group=1
#!action=copy
id;nummer;bem;eg;ausland;kopustzuord;
.formula U|xtcmd        = "$,@datei=12:07;nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue V0201         ? _G|mehr
!ZSTD
?'0|kasse^id';'0|kasse^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;             ? _F|empty(0|kasse)
?'0|verb^id';'0|verb^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;               ? _F|empty(0|verb)
?'0|aufw^id';'0|aufw^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;               ? _F|empty(0|aufw)
?'0|drund^id';'0|drund^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;             ? _F|empty(0|drund)
?'0|dkurs^id';'0|dkurs^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;             ? _F|empty(0|dkurs)
?'0|ford^id';'0|ford^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;               ? _F|empty(0|ford)
?'0|erlo^id';'0|erlo^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;               ? _F|empty(0|erlo)
?'0|hdkurs^id';'0|hdkurs^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;           ? _F|empty(0|hdkurs)
?'0|hdrund^id';'0|hdrund^nummer'a;KOWEG;(0,0,0);(0,0,0);nein;           ? _F|empty(0|hdrund)
.load 0 nolock continue
.continue ZSTD          ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Duplizieren der Konten aus der Standardkontierung
.set trans -
.continue ERRSTD        ? F|filesize(U|xterr) > 0
!IMPSTD
..jetzt die duplizierten Konten in die Standardkontierung eintragen
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten in der Standardkontierung austauschen
#!database=12
#!group=07
#!action=update
id;kasse;verb;aufw;dkurs;drund;verdli;verdma;ford;erlo;hdkurs;hdrund;verdku;
.formula U|xtcmd        = "$,@datei=12:07;nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue V0201         ? _G|mehr
!XSTD
.formula U|xkto1        = ""
.formula U|xkto2        = ""
.formula U|xkto3        = ""
.formula U|xkto4        = ""
.formula U|xkto5        = ""
.formula U|xkto6        = ""
.formula U|xkto7        = ""
.formula U|xkto8        = ""
.formula U|xkto9        = ""
.formula U|xkto1        = '0|kasse^nummer' + "a"        ? _F|empty(0|kasse)
.formula U|xkto2        = '0|verb^nummer' + "a"         ? _F|empty(0|verb)
.formula U|xkto3        = '0|aufw^nummer' + "a"         ? _F|empty(0|aufw)
.formula U|xkto4        = '0|dkurs^nummer' + "a"        ? _F|empty(0|dkurs)
.formula U|xkto5        = '0|drund^nummer' + "a"        ? _F|empty(0|drund)
.formula U|xkto6        = '0|ford^nummer' + "a"         ? _F|empty(0|ford)
.formula U|xkto7        = '0|erlo^nummer' + "a"         ? _F|empty(0|erlo)
.formula U|xkto8        = '0|hdkurs^nummer' + "a"       ? _F|empty(0|hdkurs)
.formula U|xkto9        = '0|hdrund^nummer' + "a"       ? _F|empty(0|hdrund)
'0|id';'U|xkto1';'U|xkto2';'U|xkto3';'U|xkto4';'U|xkto5';'U|xkto2';'U|xkto2';'U|xkto6';'U|xkto7';'U|xkto8';'U|xkto9';'U|xkto6';
.load 0 nolock continue
.continue XSTD          ? G|mehr
.output
.formula M|ytimport     = U|xtedp
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.set trans +
.text U|xttext 'G|bspri' Fehler beim Update der Konten in der Standardkontierung
.set trans -
.continue V0201         ? F|filesize(U|xterr) = 0
!ERRSTD
.formula M|yterror      = U|xterr
.error 'U|xttext'
.edi 'U|xterr'
.continue END
..
!V0201: Konten aus Artikeln entfernen
.formula U|xiz          = U|xiz + 1
.continue V0001         ? U|xiz > 3
.formula U|xia          = 0
.note -IMMEDIATELY Kontierung aus Teilestamm entfernen
....continue V0202 ? F|sysinfo(18)^bew
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten aus Warengruppen duplizieren
#!database=2
?#!group=1       ? U|xiz = 1
?#!group=4       ? U|xiz = 2
?#!group=5       ? U|xiz = 3
#!action=update
id;ekonto;vkonto;
.formula U|xtcmd        = "$,@database=2;@group=1;nummer=!"       ? U|xiz = 1
.formula U|xtcmd        = "$,@database=2;@group=4;nummer=!"       ? U|xiz = 2
.formula U|xtcmd        = "$,@database=2;@group=5;nummer=!"       ? U|xiz = 3
.load 0 nolock object 'U|xtcmd'
.continue V0201         ? _G|mehr
!Z0201
?'0|id';(0,0,0);(0,0,0);                ? _F|empty(0|ekonto) ; _F|empty(0|vkonto)
.formula U|xia          = U|xia + 1     ? _F|empty(0|ekonto) ; _F|empty(0|vkonto)
.load 0 nolock continue
.continue Z0201         ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue V0201         ? U|xia = 0
.continue V0201         ? F|filesize(U|xterr) = 0
.set trans +
.text U|xttext 'G|bspri' Fehler beim Lîschen der Konten aus dem Teilestamm
.set trans -
.error 'U|xttext'
.edi 'U|xterr'
.continue END
..
!V0001
.note -IMMEDIATELY Kontierung aus Kunden entfernen
.output NEW 'U|xterr'
.output NEW 'U|xtout'
.output NEW 'U|xtedp'
.input DATEI.F
# Konten aus Kunden entfernen
#!database=0
#!group=1
#!action=update
id;verd;
.formula U|xtcmd        = "$,@database=0;@group=1;nummer=!;verd<>`"
.load 0 nolock object 'U|xtcmd'
.continue V0101         ? _G|mehr
!Z0001
'0|id';(0,0,0);
.load 0 nolock continue
.continue Z0001         ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp + " -o FOPMODE=0 -o SHOWNOTES=0 -o SHOWTEXT=0"
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue V0101         ? F|filesize(U|xterr) = 0
.set trans +
.text U|xttext 'G|bspri' Fehler beim Lîschen der Konten aus den Kunden
.set trans -
.error 'U|xttext'
.continue END
..
!V0101
