06,'U|ximon';0.00;68.00;68000;1410;Porto;ja;\
08,'U|ximon';0.00;23.95;68150;1410;BÅrobedarf;ja;\
09,'U|ximon';0.00;33.00;60900;1410;Erstattung Fahrgeld;ja;\
