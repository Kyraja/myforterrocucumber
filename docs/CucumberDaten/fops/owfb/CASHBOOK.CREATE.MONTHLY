.output
..
.input "owinstall/EDP.EXECUTE.OUT
..
.continue ERRIMP1        ? F|filesize(U|xtout) = 0
..
.select from
.formula U|xtref        = ""
..
.select from 'U|xtout' U|xtref^
.continue ERRIMP1        ? F|empty(U|xtref) ; 'U|xtref'="(0,0,0)"
..
..jetzt noch freigeben und buchen
.output NEW 'U|xtdat'
# Kassenbuch freigeben
#!database=(CashBook)
#!group=(CashBook)
#!action=Release
#!charset=EKS
.input "owinstall/HEAD.EDP"
id
'U|xtref'

# Kassenbuch buchen
#!database=(CashBook)
#!group=(CashBook)
#!action=Transfer
#!charset=EKS
.input "owinstall/HEAD.EDP"
id
'U|xtref'
.output
..
.input "owinstall/EDP.EXECUTE
..
.continue ERRIMP2        ? _G|mehr
..
.continue END
..
..
