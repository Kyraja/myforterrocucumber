..*****************************************************************************
.. mage 07.06.16: Correction errorhandling
..*****************************************************************************
.type text U|xtdat      ? _F|defined(U|xtdat)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterrdat   ? _F|defined(U|xterrdat)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtref      ? _F|defined(U|xtref)
.type text U|xttmp      ? _F|defined(U|xttmp)
.type integer U|xiz     ? _F|defined(U|xiz)
.type GJ   U|xyear      ? _F|defined(U|xjear)
.type integer U|ximon   ? _F|defined(U|ximon)
.type GD2  U|xdate      ? _F|defined(U|xdate)
..
.formula U|xdate        = M|qflagdate           ?  F|defined(M|qflagdate)
.formula U|xdate        = G|datum               ? _F|defined(M|qflagdate)
..
.. .formula U|xiz          = G|gmonat
..
.formula U|xtdat    = "tmp/XCASHBOOK.CREATE.MONTHLY."+'G|sekundenz'
.formula U|xterrdat = U|xtdat + ".ERR"
.formula U|xtout    = U|xtdat + ".OUT"
..
.formula U|xyear        = 'F|year(U|xdate)'
.formula U|ximon       = F|month(U|xdate)
..
.output NEW 'U|xtdat'
.input DATEI.F
