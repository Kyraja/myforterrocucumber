..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CHANGECURRENCY.YTBUIMP.BA
.. Date           : 04.03.15
.. Version        : 2015r2n04
.. Author         : si/dr
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xterr      ? _F|defined(U|xterr)
..
.continue END           ? M|ytdone
.continue END           ? F|empty(M|ytimport)
.continue END           ? M|ytausschl
..
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xterr
..
.set separator @
.output NEW 'U|xterr'
.output NEW 'U|xtedp'
.input DATEI.F
.input 'M|ytimport'
.output
.formula U|xtcmd        = "edpimport.sh -P -a UPDATE -b " + 'M|ytvdn' + ":" + 'M|ytvgr'
.......formula U|xtcmd        = U|xtcmd + " -Z nummer:" + 'M|ytfld'   ? M|yttab
.formula U|xtcmd        = U|xtcmd + " -o FOPMODE=0 -o SHOWTEXT=0 -o SHOWNOTES=0"
.formula U|xtcmd        = U|xtcmd + " -I " + U|xtedp + " 2>" + U|xterr
.system 'U|xtcmd' PASSWORD background
..
.formula M|ytdone       = G|true
.continue END           ? F|filesize(U|xterr) = 0
.formula M|ytdone       = G|false
.formula M|yterror      = U|xterr
.continue END           ? G|evtvar = "ybuimport"
.edi 'U|xterr'
..
!END
.continue
