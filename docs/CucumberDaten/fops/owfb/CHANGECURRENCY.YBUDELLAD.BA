..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CHANGECURRENCY.YBUDELLAD.BA
.. Date           : 11.03.15
.. Version        : 2015r2n04
.. Author         : si/dr
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xttmp      ? _F|defined(U|xttmp)
.type text U|xtvnr      ? _F|defined(U|xtvnr)
.type text U|xtsel      ? _F|defined(U|xtsel)
.type bool U|xbupd      ? _F|defined(U|xbupd)
..
.continue NODATA        ? F|empty(M|bfuss)
.formula P|maskkontextfop = "DELETE"
.make screen line --    ? M|tzeilen > 0
..
.file -TEMPNAME U|xttmp
.output NEW 'U|xttmp'
.input DATEI.F
.input 'M|bfuss'
.output
.select from
!SELFROM
.select from 'U|xttmp' U|xtvnr ; U|xtsel ; U|xbupd ;
.continue SELECT        ? _G|mehr
..
.make screen line +o
.assign M|ytvartab      = 'U|xtvnr'
.formula M|ytvarbez     = 'M|ytvartab^name'
.formula M|ytvdn        = M|ytvartab^vdn
.formula M|ytvgr        = M|ytvartab^vgr
.formula M|ytkrit       = U|xtsel
.formula M|ybupdate     = U|xbupd
.continue SELFROM
..
!SELECT
.select screen head
.continue END           ? M|tzeilen = 0
!ZSELECT
.select screen line
.continue END           ? _G|mehr
..
.continue ZSELECT       ? F|empty(M|ytvartab)
..
.continue UPDATE        ? M|ybupdate
..
.formula U|xtcmd        = "$,@database="+'M|ytvdn'+";@group="+'M|ytvgr'+";nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue ZSELECT       ? _G|mehr
.load 0
..
.output NEW 'U|xttmp'
.input DATEI.F
.formula U|xtcmd        = "edpexport.sh -P -l " + 'M|ytvdn' + ":" + 'M|ytvgr' + " -F -f id >" + U|xttmp
.system 'U|xtcmd' PASSWORD background
.formula M|ytimport     = U|xttmp
.continue ZSELECT
..
!UPDATE
.formula U|xtcmd        = "$,@database="+'M|ytvdn'+";@group="+'M|ytvgr'+";"+'M|ytkrit'+"<>`"
.load 0 nolock object 'U|xtcmd'
.continue ZSELECT       ? _G|mehr
..
.output NEW 'U|xttmp'
.input DATEI.F
id;'M|ytkrit';
..
.continue UPD2
!UPD1
.load 0 nolock continue
!UPD2
.continue UPDE         ? _G|mehr
..
.output ADDEDTO 'U|xttmp'
'0|id';(0,0,0);
.continue UPD1
!UPDE
.output
.formula M|ytimport     = U|xttmp
.continue ZSELECT
..
!NODATA
.error "Keine Daten zum l”schen definiert!"
.continue END
..
!END
.continue
