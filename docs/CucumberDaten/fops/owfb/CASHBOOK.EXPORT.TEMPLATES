..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :     CASHBOOK.EXPORT.TEMPLATES
.. Date           :     17/11/2014
.. Version        :     1.0
.. Author         :     rasc
.. Copyright      :
.. Functionality  :     Export Templates for Cashbook, monthly
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtdat      ? _F|defined(U|xtdat)
.type text U|xtsel      ? _F|defined(U|xtsel)
.type integer U|xiz     ? _F|defined(U|xiz)
..
....input ARB
.formula U|xiz          = 0
!LOOP
.formula U|xiz          = U|xiz + 1
.continue END           ? U|xiz > 12
..
.formula U|xtsel        = "$,gj=="+'G|gjahr'+";gm=="+'U|xiz'+";kasskto=="+'F|sysinfo(7)^kasse^id'
.load 0 nolock cashbook 'U|xtsel'
.continue LOOP          ? _G|mehr
..
...formula U|xtdat        = U|xarb + "/CASHBOOK.TEMPLATE."+'U|xiz'
.formula U|xtdat        = "ow1/CASHBOOK.TEMPLATE."+'U|xiz'
.output NEW 'U|xtdat'
.input DATEI.F
kasskto;gj;gm;anfbest;\
beldat;beleg;beinn;bausg;gegenkto;kstelle;butext;0:sanpass;
'0|kasskto^nummer';'0|gj';'0|gm';'0|anfbest';\
!LINES
.load 0 nolock line
.continue LOOP          ? _G|mehr
..
'0|beldat';'0|beleg';'0|beinn';'0|bausg';'0|gegenkto^nummer';'0|kstelle^nummer';'0|butext';'G|true';\
.continue LINES
..
!END
.continue

