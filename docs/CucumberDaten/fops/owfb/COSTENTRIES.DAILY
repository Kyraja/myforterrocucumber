.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtdat ? _F|defined(U|xtdat)
.type text U|xterrdat ? _F|defined(U|xterrdat)
.type text U|xtcom ? _F|defined(U|xtcom)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type text U|xtref      ? _F|defined(U|xtref)
.type GD2  U|xdate      ? _F|defined(U|xdate)
.type GD2  U|xdstart    ? _F|defined(U|xdstart)
.type GD2  U|xdend      ? _F|defined(U|xdend)
.type GJ   U|xyear      ? _F|defined(U|xyear)
.type integer U|ximon   ? _F|defined(U|ximon)
..
.continue END           ? _F|sysinfo(18)^bew & _F|sysinfo(18)^fkkonfig
.type text xtdat ? _F|defined(U|xtdat)
.type text xterrdat ? _F|defined(U|xterrdat)
.type text xtcom ? _F|defined(U|xtcom)
.formula U|xtdat = "tmp/COSTENTRY."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat'+".ERR"
..
.formula U|xdate        = M|qflagdate      ? F|defined(M|qflagdate)
.formula U|xdate        = G|datum          ? F|empty(U|xdate)
.....formula U|xdate        = "31.01.15"
.formula U|xdstart      = F|fystartdate(F|getfy(U|xdate))
.formula U|xdend        = F|fyenddate(F|getfy(U|xdate))
.formula U|xyear        = F|getfy(U|xdate)
.formula U|ximon        = F|getfm(U|xdate)
..
..file -TEMPNAME U|xtout
..file -TEMPNAME U|xterr
..file -TEMPNAME U|xtedp
..
!STOCK
.continue PROD          ? _F|sysinfo(18)^bew
.continue SDSTOCK       ? _F|empty(F|sysinfo(12)^klbmindat)
..
.formula U|xdstart      = F|fystartdate(F|getfy(U|xdate))
..
..output NEW 'U|xtdat'
..output NEW 'U|xterr'
.output NEW 'U|xtdat'
.input DATEI.F
#!database=123
#!group=1
#!action=new
.input "owinstall/HEAD.EDP"
gjahr;adat;edat;kosart;
'U|xyear';'U|xdstart:8';'U|xdend:8';(1);
.output
.input "owinstall/EDP.EXECUTE"
..
..formula U|xtcmd        = "edpimport.sh -p abas123 -I " + U|xtedp
..formula U|xtcmd        = U|xtcmd + " > " + U|xtout + " 2>" + U|xterr
..system 'U|xtcmd' background
..
!SDSTOCK
.formula U|xdstart      = F|fystartdate('U|xyear',U|ximon)
..
.formula U|xtdat = "tmp/COSTENTRY2."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat'+".ERR"
.....
.output NEW 'U|xtdat'
...output NEW 'U|xterr'
...output NEW 'U|xtedp'
.input DATEI.F
