..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :     RECURRINGENTRY.MONTHLY
.. Date           :     11/11/2014
.. Version        :     1.0
.. Author         :     rasc
.. Copyright      :
.. Functionality  :     Recurring Entry, monthly
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type text U|xtref      ? _F|defined(U|xtref)
.type GJ   U|xyear      ? _F|defined(U|xjear)
.type integer U|xmonth  ? _F|defined(U|xmonth)
.type GD2  U|xdstart    ? _F|defined(U|xdstart)
.type GD2  U|xdend      ? _F|defined(U|xdend)
.type GD2  U|xdate      ? _F|defined(U|xdate)
..
.formula U|xdate        = M|qflagdate           ?  F|defined(M|qflagdate)
.formula U|xdate        = G|datum               ? _F|defined(M|qflagdate)
.....formula U|xdate        = "31.07.14"
..
.formula U|xyear        = 'F|year(U|xdate)'
.formula U|xmonth       = F|month(U|xdate)
.formula U|xdstart      = F|fystartdate('U|xyear',U|xmonth)
.formula U|xdend        = F|fyenddate('U|xyear',U|xmonth)
..
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xtout
.file -TEMPNAME U|xterr
..
.. .formula U|xtout = "tmp/XRECU."+'U|xyear'+"."+'U|xmonth'+".OUT"
.. .formula U|xterr = "tmp/XRECU."+'U|xyear'+"."+'U|xmonth'+".ERR"
.. .formula U|xtedp = "tmp/XRECU."+'U|xyear'+"."+'U|xmonth'+".EDP"
..
.output NEW 'U|xtedp'
.input DATEI.F
#!database=110
#!group=4
#!action=NEW
.input "owinstall/HEAD.EDP"
such;name;selerstbd;selletztbd;selladen;
DB'U|xyear'-'U|xmonth';Dauerbuchungen GJ 'U|xyear' Monat 'U|xmonth';'U|xdstart:8';'U|xdend:8';;
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -o SHOWNOTES=0 -o SHOWTEXT=0 -I " + U|xtedp
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue END           ? F|filesize(U|xterr) = 0
.continue END           ? G|edp
...error "Dauerbuchungen konnten nicht gebucht werden!"
...edi -READONLY 'U|xterr'
.continue END
..
!END
.continue
