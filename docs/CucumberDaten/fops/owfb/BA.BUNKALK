..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtsys      ? _F|defined(U|xtsys)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
..
.file -TEMPNAME U|xterr
.file -TEMPNAME U|xtout
.file -TEMPNAME U|xtedp
.output NEW 'xtedp'
.input DATEI.F
id;rowop;>bunkalk;<
..
.continue NKALK
!LJ
.formula U|xtcmd        = "%,,@database=10;@group=1;.buart=1;.ursache==Fertigung;vom=;nummer=;such=;artikel=;"
.load 0 nolock object 'U|xtcmd'
.continue LOAD2         ? G|mehr
.continue END
!LOAD1
.load 0 nolock continue
!LOAD2
.continue EDPCMD        ? _G|mehr
.output ADDEDTO 'U|xtedp'
..
'0|bsres^id';1;;
.output TERMINAL
Zugang vom '0|vom' fr Artikel '0|artikel' ...
.continue LOAD1
..
!NKALK
.formula U|xtcmd        = "%,,@database=57;@group=1;typ==Nachkalkulation;herkunft^gruppe=5;fehler==ja"
.load 0 nolock object 'U|xtcmd'
.continue NK2           ? G|mehr
.continue END
!NK1
.load 0 nolock continue
!NK2
.continue EDPCMD        ? _G|mehr
..
.output ADDEDTO 'U|xtedp'
..
'0|herkunft^id';1;;
.output TERMINAL
Nachkalkulation vom '0|stand' fr Artikel '0|artikel' ...
.continue NK1
..
!EDPCMD
.output
..edi 'U|xtedp'
..input
..
.formula U|xtsys = "edpimport.sh"
.formula U|xtsys = U|xtsys + " -a VIEW"
.formula U|xtsys = U|xtsys + " -I " + U|xtedp
.formula U|xtsys = U|xtsys + " -P -Z :rowop"
.formula U|xtsys = U|xtsys + " "
.formula U|xtsys = U|xtsys + " >> " + 'U|xtout' + " 2>> " + 'U|xterr'
.system 'U|xtsys' PASSWORD background
..
.continue END           ? F|filesize(U|xterr) = 0
.edi 'U|xterr'
.continue END
..
!END
.continue
