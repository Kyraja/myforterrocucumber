..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CHANGECURRENCY.YBUDELKOBER.BA
.. Date           : 11.03.15
.. Version        : 2015r2n04
.. Author         : abas
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
..
.file -TEMPNAME U|xtedp
..
!KBFORM
.note -IMMEDIATELY Kontenbereichsformulare werden gel”scht ...
.output NEW 'U|xtedp'
.input DATEI.F
id;
..
.formula U|xtcmd        = "$,@database=68;@group=2.4.5;@sort=Nummer;@richtung=(Backwards);nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue KOBER         ? _G|mehr
!ZKBFORM
'0|id';
.load 0 nolock continue
.continue ZKBFORM       ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -P -a DELETE -I " + U|xtedp
.system 'U|xtcmd' PASSWORD background
.continue KBFORM
..
!KOBER
.note -IMMEDIATELY Kontenbereiche werden gel”scht ...
.output NEW 'U|xtedp'
.input DATEI.F
id;
..
.formula U|xtcmd        = "$,@database=68;@group=1;@sort=Nummer;@richtung=(Backwards);nummer=!"
.load 0 nolock object 'U|xtcmd'
.continue END           ? _G|mehr
!ZKOBER
'0|id';
.load 0 nolock continue
.continue ZKBFORM       ? G|mehr
.output
.formula U|xtcmd        = "edpimport.sh -P -a DELETE -I " + U|xtedp
.system 'U|xtcmd' PASSWORD background
.continue KOBER
..
!END
.note -IMMEDIATELY 
.continue

