..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CHANGECURRENCY.SE
.. Date           : 03.03.15
.. Version        : 2015r2n04
.. Author         : si/dr
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtdat      ? _F|defined(U|xtdat)
.type text U|xtvnr      ? _F|defined(U|xtvnr)
.type bool U|xbtab      ? _F|defined(U|xbtab)
.type bool U|xbvtab     ? _F|defined(U|xbvtab)
.type text U|xtfld      ? _F|defined(U|xtfld)
.type text U|xtflist    ? _F|defined(U|xtflist)
.type text U|xtexp      ? _F|defined(U|xtexp)
.type text U|xtimp      ? _F|defined(U|xtimp)
.type text U|xttmp      ? _F|defined(U|xttmp)
.type text U|xtkrit     ? _F|defined(U|xtkrit)
.type bool U|xbaus      ? _F|defined(U|xbaus)
..
....continue NOWARTUNG     ? _G|wartung
.formula P|maskkontextfop = "CURRENCY"
..
.assign M|yland         = F|sysinfo(10)^lainland
.assign M|ycurr         = F|sysinfo(18)^inland
.assign M|ytermine      = F|sysinfo(12)^id
.formula U|xtcmd        = "$,@datei=95:1;fwaehr=="+'G|inland^id'+";iwaehr=="+'G|inland^id'
.load 0 nolock object 'U|xtcmd'
.continue NOOWN         ? _G|mehr
.assign M|yown          = 0|id
.load 0
..
.continue END           ? F|empty(M|bkopf)
..
.assign M|ykonfig       = "0k"
.assign M|ybetr         = "1"
.copy M|ylaart          = M|ybetr^lainland^laart
.formula M|yfact        = 2
..
.file -TEMPNAME U|xtexp
.file -TEMPNAME U|xtimp
.file -TEMPNAME U|xtdat
.output NEW 'U|xtdat'
.input DATEI.F
.input 'M|bkopf'
.output
..
!SELECT
.select from 'U|xtdat' U|xbaus ; U|xtvnr ; U|xbvtab ; U|xbtab ; U|xtfld ; U|xtkrit ; U|xtflist^
.continue END           ? _G|mehr
..
.make screen line +o
.formula M|ytausschl    = U|xbaus
.assign M|ytvartab      = 'U|xtvnr'
.formula M|ytvarbez     = 'M|ytvartab^name'
.formula M|ytvdn        = M|ytvartab^vdn
.formula M|ytvgr        = M|ytvartab^vgr
.....formula M|ytvvtab      = M|ytvartab^vvtab
.formula M|ytvvtab      = U|xbvtab
.formula M|yttab        = U|xbtab
.formula M|ytfld        = U|xtfld
.formula M|ytkrit       = U|xtkrit
.continue SELECT        ? F|empty(U|xtflist)
.formula U|xttmp        = 'F|regreplaceall(U|xtflist, "\;", ",")'
.output NEW 'U|xtexp'
'U|xttmp'
.output
.formula M|ytefliste    = U|xtexp
..
.set separator @
.formula U|xttmp        = U|xtflist
.....................
......continue NOTAB
.....................
.continue NOTAB         ? _U|xbtab
..
.output NEW 'U|xtimp'
.input DATEI.F
.formula U|xttmp        = U|xtflist << 'U|xtfld'
'U|xttmp'\
.formula U|xttmp        = U|xtflist >> 'U|xtfld'
.formula U|xttmp        = U|xtfld + U|xttmp
'U|xttmp'
.output
.formula M|ytfliste     = U|xtimp
.continue SELECT
..
!NOTAB
.output NEW 'U|xtimp'
.input DATEI.F
'U|xttmp'
.output
.formula M|ytfliste     = U|xtimp
.continue SELECT
..
!NOWARTUNG
.set trans +
.text U|xttext 'G|bspri' Das Infosystem darf nur im Wartungsmodus ausgefÅhrt werden
.set trans -
.error 'U|xttext'
.end 1
..
!NOOWN
.set trans +
.text U|xttext 'G|bspri' Kein eigener WÑhrungskurs vorhanden
.set trans -
.error 'U|xttext'
.end 1
..
!END
.continue
