..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type text U|xtref      ? _F|defined(U|xtref)
.type GJ   U|xyear      ? _F|defined(U|xjear)
.type integer U|xmonth  ? _F|defined(U|xmonth)
.type GD2  U|xdstart    ? _F|defined(U|xdstart)
.type GD2  U|xdend      ? _F|defined(U|xdend)
.type GD2  U|xdate      ? _F|defined(U|xdate)
..
.continue
..
.formula U|xdate        = M|qfreitag               ?  F|defined(M|qfreitag)
.formula U|xdate        = G|datum               ? _F|defined(M|qfreitag)
.formula U|xdate        = "31.01.14"
..
.formula U|xyear        = 'F|year(U|xdate)'
.formula U|xmonth       = F|month(U|xdate)
.formula U|xdstart      = F|fystartdate('U|xyear',U|xmonth)
.formula U|xdend        = F|fyenddate('U|xyear',U|xmonth)
..
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xtout
.file -TEMPNAME U|xterr
.output NEW 'U|xtedp'
.input DATEI.F
#!EDP_TESTFLAG2=1
#!EDP_DATE='U|xdate'
param;artikel;buart;wert;beleg;beldat\
zeile;mge;platz2
;30021;Zugang;283,7796;NEGBEST;'U|xdate'\
+1;161;LP-FWL-KASSEL
;30022;Zugang;320,9383;NEGBEST;'U|xdate'\
+1;1225;LP-FWL-KASSEL
;30023;Zugang;320,7832;NEGBEST;'U|xdate'\
+1;1548;LP-FWL-KASSEL
;40010;Zugang;2;NEGBEST;'U|xdate'\
+1;5752;LP-FWL-KASSEL
.output
.formula U|xtcmd        = "edpimport.sh -p abas123 -a do -b lbuch -o SHOWNOTES=0 -o SHOWTEXT=0 -I " + U|xtedp
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' background
..
.continue END           ? F|filesize(U|xterr) = 0
.continue END           ? G|edp
..error "Lagerkorrekturen konnten nicht gebucht werden!"
..edi -READONLY 'U|xterr'
.continue END
..
!END
.continue

