..***** DEAKTIVIERT dh/abas 20.04.2016 da nicht konfiguriert
.continue
.type text U|xtdat     ? _F|defined(U|xtdat)
.type text U|xterrdat  ? _F|defined(U|xterrdat)
.type text U|xtcom     ? _F|defined(U|xtcom)
...end dh/abas 11.2.16
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type GJ   U|xyear      ? _F|defined(U|xyear)
.type integer U|ximon   ? _F|defined(U|ximon)
.type GD2  U|xdate      ? _F|defined(U|xdate)
..
.formula U|xdate        = M|qflagdate           ?  F|defined(M|qflagdate)
.formula U|xdate        = G|datum               ? _F|defined(M|qflagdate)
......formula U|xdate        = "31.01.14"
.formula U|xyear        = F|getfy(U|xdate)
.formula U|ximon        = F|getfm(U|xdate)
..: RASC, 12.03.2015, atkuellen Monat erst einen Monat sp„ter schlieáen
..: RASC, 05.06.2015, im Januar die ILV 12 des Vorjahres nachholen
..  ..im ersten Jahr nach dem Aufsetzen im Januar nichts machen
..  .continue END           ? U|ximon = 1 & ('U|xyear' = 'F|nextfy(F|getfy(F|sysinfo(12)^ilviststart))')
.formula U|ximon        = U|ximon - 1
.continue START         ? U|ximon > 0
.formula U|xyear        = F|prevfy(U|xyear)
.formula U|ximon        = 12
!START
...............
.formula U|xtdat = "tmp/XIAA."+'U|xyear'+"."+'U|ximon'+"."+'G|versionneu'
.formula U|xterrdat = 'U|xtdat'+".ERR"
..
.output NEW 'U|xtdat'
.input DATEI.F
#!action=DO
#!TYPEDCMD=(IAAA)
.input "owinstall/HEAD.EDP"
param;gjahr;monat;vorschau;dokprot;bstart;
;'U|xyear';'U|ximon';'G|false';'G|true';;
.output
.input "owinstall/EDP.EXECUTE"
..
!END
.continue
