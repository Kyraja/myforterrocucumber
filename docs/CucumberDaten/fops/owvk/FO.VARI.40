..!interpreter english
.. ==================================================
.. owvk/FO.VARI.40
.. Start of the product configurator
.. Version 2.15
.. EinschrÑnkung auf Angebot aufgehoben
.. Remoteimport einzeler XML-Datei Åber budatimport
.. StÅcklistenimport ermîglicht
..
.. Initialization
.INPUT "owvk/PCONF.INI"
.. Define the variables
.TYPE TEXT xtline xtlineid xmge xnum xshell xcode xgr xpos 
..
.TYPE text xtline xtlineid
.FO T|xtline = 'M|aktzeile'
.END 1 ? T|xtline = ""
..
..
.. Start of the Configurator CapSuite
..
.SELECT screen header
.SELECT screen line 'T|xtline'
.FORMULA T|xtlineid = M|id
..
.FORMULA T|xshell = T|xcapExedir + "capuix.exe"
.FORMULA T|xcode  = "G02"
.FORMULA T|xartex = M|artex^nummer 
.FORMULA T|xgr    = M|artex^namebspr
.FORMULA T|xshell  = xshell + " /" + xcode + " " + 'xgr' +" " + 'xtlineid' + " " + 'xartex'
.FORMULA T|xtshell = 'dblquote' + 'xshell' + 'dblquote'
..
.CONTINUE DLL ? T|xbstartdll
..
!EXEC
.. Start with .pc.exec
..'xtshell'
.PC.EXEC -WAIT 'xtshell'
.CONTINUE
..
..
!DLL
.. Start with .pc.dll 
.. ab Version 2005r1
.PC.DLL 'T|xcapDllname' 'T|xcapDlldir' 'xcode' 'xgr' 'xtlineid' 'xartex'
.CONTINUE
