..!INTERPRETER ENGLISH 
.. owvk/FOP.PSCHREIB.VOR
.. Version 2.10
.. Autor: mage, ABAS Software AG
.. FOP to set the row, that should should be configured
.
..
.CONTINUE NEU  ? evtkommd = "neu" ; evtkommd = "„ndern"
.CONTINUE FREI ? evtkommd = "freigeben"
.CONTINUE ZEIG ? evtkommd = "zeigen"
..
!NEU
.. Only by use of the header-button a dummy-procuct is inserted in order to save the record
.TYPE bool xbtabok
.TYPE text xtsel
.CONTINUE NEUEND   ? _(evtvar = "schreib")
.. Check if there is a valid row
.FORMULA T|xbtabok = FALSE
!ZLOOP
.SELECT screen line
.CONTINUE ZLOOPE  ? _mehr
.FORMULA T|xbtabok = TRUE ? M|artex <> ""
.CONTINUE ZLOOPE ? T|xbtabok
.CONTINUE ZLOOP
!ZLOOPE
.. If not ok insert a dummy-procuct
.CONTINUE NEUEND ? T|xbtabok
.FORMULA T|xtsel="$,,such==TEXT;@gruppe=4;"
.SELECT Part 'T|xtsel'
.CONTINUE NEUEND ? _mehr
.SELECT screen line
.MAKE SCREEN LINE ? _mehr
.FORMULA M|artex = H|id
!NEUEND: continue at FREI
..
!FREI
.. Set the row to be configured in yznkonfig
.SELECT Screen Header
.FORMULA M|yznkonfig = 'T|evtzeile'
.CONTINUE
..
!ZEIG
.. Start CapSuite in View mode without pressing the button
.SELECT Screen Header
.FORMULA M|yznkonfig = 'T|evtzeile'
.INPUT "owvk/FO.VARI.32"
.ERROR
.END 1

!ERROR1
