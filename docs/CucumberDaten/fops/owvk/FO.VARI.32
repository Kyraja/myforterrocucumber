..!interpreter english declaration
.. ==================================================
.. owvk/FO.VARI.32
.. Start of the product configurator
.. Version 2.18
.. 2.18 Variablen Åberall mit Puffer versehen und declation Anweisung
.. 2.15 AusfÅhrung von EFOPs einstellbar
.. 2.15 Fehler in öbergabeparametern beim Freigeben behoben
.. EinschrÑnkung auf Angebot aufgehoben
.. Remoteimport einzeler XML-Datei Åber budatimport
.. StÅcklistenimport ermîglicht
..
.. Initialization
.INPUT "owvk/PCONF.INI"
.. Define the variables
.TYPE TEXT xtline xtlineid xmge xnum xtshell xcode xsachbr xpos xauf
..
.SELECT SCREEN HEADER 
.FO T|xtline = 'M|yznkonfig'
.END 1 ? T|xtline = ""
..
.CONTINUE XFREIG ? _(T|evtkommd = "freigeben")
..
.. Copy the features of the quote if you release a quote to an order 
.FORMULA T|xcode = "S05"
!LOOP
.SELECT screen line
.CONTINUE XFREIG ? _mehr
..CONTINUE LOOP ? M|artex^gruppe <> 1
.FORMULA T|xtshell  = T|xcapExedir + T|xcapExename
.FORMULA T|xtshell  = T|xtshell + " /" + T|xcode + " " + 'M|orig^id' + " " + 'M|id'
.FORMULA T|xtshell = 'T|dblquote' + 'T|xtshell' + 'T|dblquote'
.CONTINUE FGDLL ? T|xbstartdll
..
.PC.EXEC -WAIT 'T|xtshell'
.CONTINUE XLOOP
..
!FGDLL
.. 'T|xcapDlldir' 'T|xcode' 'M|orig^id' 'M|id'
.PC.DLL StartCAP 'T|xcapDlldir' 'T|xcode' 'M|orig^id' 'M|id'
..
!XLOOP
.CONTINUE LOOP
.. 
!XFREIG
..
.. Start of the Configurator CapSuite
..
.FORMULA T|xauf = M|nummer
.SELECT screen line 'T|xtline'
.FORMULA T|xtlineid = M|id
..
.FORMULA T|xtshell   = T|xcapExedir + "capuix.exe"
.FORMULA T|xcode    = "S01"  ? T|evtkommd = "Ñndern" ; T|evtkommd = "neu" ; T|evtkommd = "freigeben"
.FORMULA T|xcode    = "S01R" ? T|evtkommd = "zeigen"
.FORMULA T|xsachbr  = M|schlag         ? T|xtline =  "0"
.FORMULA T|xpos     = M|nummer         ? T|xtline =  "0"
.FORMULA T|xmge     = "1"              ? T|xtline =  "0"
.FORMULA T|xsachbr  = M|artex^namebspr ? T|xtline <> "0"
.FORMULA T|xpos     = M|pnum           ? T|xtline <> "0"
.FORMULA T|xmge     = M|mge            ? T|xtline <> "0"
.FORMULA T|xtshell   = T|xtshell + " /" + T|xcode + " " + 'T|xsachbr' + " " + 'T|xtlineid' + " " + 'T|xauf'
.FORMULA T|xtshell = 'T|dblquote' + 'T|xtshell' + 'T|dblquote'
..
.CONTINUE DLL ? T|xbstartdll
..
!EXEC
.. Start with .pc.exec
.PC.EXEC -WAIT 'T|xtshell'
.CONTINUE
..
..
!DLL
.. Start with .pc.dll 
.. ab Version 2005r1
.PC.DLL 'T|xcapDllname' 'T|xcapDlldir' 'T|xcode' 'T|xtlineid' 'T|xsachbr' 'T|xauf'
.CONTINUE
