..!interpreter english
.. ==================================================
.. owvk/FOP.ZEILELOE.VOR
.. Delete Features of the line in the the product configurator
.. Version 2.09
..
.. ueber EDP nicht m”glich, wegen pc.exec und pc.dll
.CONTINUE ? T|edp
..
.. Initialization
.INPUT "owvk/PCONF.INI"
.type text xcode xtlineid xtshell xtmenueb
..
.fo xtmenueb = "Delete features in CapSuite?"
.menu 'T|xtmenueb'
yes >>yes
no  >>no
...
.CONTINUE ? mentxt="no"
.CONTINUE ? mentxt=""
..
.. Merkmale l”schen
.FORMULA T|xtcode = "S04"
.FORMULA T|xtlineid = M|id
.FORMULA T|xtshell = T|xcapExedir + "capuix.exe /"+ T|xtcode +" " + T|xtlineid
..
.CONTINUE DLL ? T|xbstartdll
..
!EXEC
.. Start with .pc.exec
.PC.EXEC -WAIT 'T|xtshell'
.CONTINUE
..
..
!DLL
.. Start with .pc.dll 
.. ab Version 2005r1
.PC.DLL StartCAP 'T|xcapDlldir' 'xtcode' 'xtlineid'
.CONTINUE
