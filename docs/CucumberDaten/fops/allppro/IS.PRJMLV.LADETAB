.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.formula U|xdzpend = G|ZEITPUNKT
.formula U|xdauer = U|xdzpend - U|xdzpstart
.continue EL027 ? _(G|FALSE)
.box Dauer
Start: 'U|xdzpstart'
Ende: 'U|xdzpend'
Dauer: 'U|xdauer'
!EL027
.continue 'xprocst.xprocsp'
!PROC004: ----- aufklappen -----
.formula M|tbaumstat   = "-"
.formula M|tbaumicon   = "icon:folder_opened"
.formula M|ytbaumaufzu = "icon:folder_opened"   ?  F|defined(M|ytbaumaufzu)
.formula U|xistufe =  M|tbaumstufe
.formula U|xizeile =  M|aktzeile
.assign  M|ytb1    =  G|FALSE
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
.select screen line 'G|evtzeile'
.assign  M|ytb1    = G|TRUE
.continue 'xprocst.xprocsp'
!PROC005: ----- zuklappen -----
.formula M|tbaumstat   = "+"
.formula M|tbaumicon   = "icon:folder_closed"
.formula M|ytbaumaufzu = "icon:folder_closed"   ?  F|defined(M|ytbaumaufzu)
.formula U|xizeile = G|evtzeile
.select screen line 'U|xizeile'
.continue EL028 ? _(G|mehr)
.formula U|xistufe = M|tbaumstufe
.select screen line
.continue EL029 ? _(G|mehr)
!LOOP013: ==============================
.continue ELOP013 ? _(M|tbaumstufe > U|xistufe)
.make screen line -O
.continue LOOP013
!ELOP013: ==============================
!EL029
.select screen line 'U|xizeile
.continue FI028
!EL028
.error(1111)
.end 1
!FI028
.continue 'xprocst.xprocsp'
