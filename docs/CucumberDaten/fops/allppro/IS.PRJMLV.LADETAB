.formula M|ytnachtrstd    = M|ytnachtrstd    + (8|yanfeigstd * 8|yerfwahrsch / 100)                             ? _8|yakzeptanzk = "1"
.formula M|ytgesnachtrstd = M|ytgesnachtrstd + (8|yanfeigstd * 8|yerfwahrsch / 100 * 8|yfortschrittsgrad / 100) ? _8|yakzeptanzk = "1"
