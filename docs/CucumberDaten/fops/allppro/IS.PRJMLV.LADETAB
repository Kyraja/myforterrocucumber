.formula M|ytnachtrstd       = M|ytnachtrstd       + U|xrnachstd
.formula M|ytgesnachtrstd    = M|ytgesnachtrstd    + U|xrgnachtrstd
.formula M|ytleistwertplan   = M|ytleistwertplan   + U|xrlwplan
.formula M|ytfortschrittswer = M|ytfortschrittswer + U|xrfortwert
.formula M|ytgessollstd      = M|ytsollstd    + M|ytnachtrstd
.formula M|ytfertstellgrad   = 100 * M|ytfortschrittswer / M|ytvkwertman        ? M|ytvkwertman <> 0
.formula M|ytstdabw          = M|ytstdabw          + U|xrstdabw
.formula M|ytstdkorr         = M|ytstdkorr         + U|xrstdkorr
.formula M|ytstderwpreff = 0                                                            ?  M|ytfertstellgrad = 0
.formula M|ytstderwpreff = M|ytiststd / M|ytfertstellgrad * (100 - M|ytfertstellgrad)   ? _M|ytfertstellgrad = 0
.formula M|ytstderwges   = M|ytstderwpreff + M|ytstdkorr
.formula M|ytstdfc       = M|ytiststd      + M|ytstderwges
.formula M|ytstdabwbudg  = M|ytgessollstd  - M|ytstdfc
!EL024
.continue LOOP011
!ELOP011: ==============================
.select screen line 'U|ximerkzeile'
!EL023
!EL022
.load 0 continue
.continue LOOP007
!ELOP007: ==============================
.select screen line 'U|xizeile'
.formula M|ytb1 = G|TRUE
.continue FI013
!EL013
