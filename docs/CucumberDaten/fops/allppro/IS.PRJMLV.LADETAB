!PROC003: ----- Tabelle_laden -----
.formula U|xdzpstart = G|ZEITPUNKT
.formula U|xistufe = 0
.continue EL025 ? _((F|defined(M|yblvprogress)) ; (F|defined(M|yblvkalk)))
.formula U|xtsel "$,,ykblattid==" + M|ykalkblatt^id
.formula U|xtsel = U|xtsel + ";yoberposid==`;@filingmode=(Active);@order=ysort,nummer"
.load 0 group 'U|xydbgrlvkalkpos' 'U|xtsel'
!EL025
.continue EL026 ? _(F|defined(M|yblvkopie))
.formula U|xtsel "$,,ykblattid==" + M|ykalkblatt^id
.formula U|xtsel = U|xtsel + ";yoberposid==`;@filingmode=(Active);@order=ysort,nummer"
