.formula U|xtsel = U|xtsel + ";ydatum=" + M|ystdvondatum:8 + "!" + M|ystdbisdatum:8
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgristzeiten' 'U|xtsel'
