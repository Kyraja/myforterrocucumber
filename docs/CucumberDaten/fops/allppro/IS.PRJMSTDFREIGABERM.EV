.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";ypersonal==" +  0|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(No)"
.select group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL025 ? _(G|mehr)
.assign U|xbstdzettel    = G|TRUE
.assign U|xberfabschluss = H|yberfabschluss
