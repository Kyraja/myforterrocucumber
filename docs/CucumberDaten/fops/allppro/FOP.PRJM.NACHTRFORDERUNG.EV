.input "allppro/LV.KONFIG.INI"
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtid xtindex
.type text    xtedpdat xtedpout xtedperr xtedpmsg
.type integer xizeile
