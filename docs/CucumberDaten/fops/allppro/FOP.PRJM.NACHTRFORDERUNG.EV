.formula H|yakzeigstd    = M|ytakzeigstd
.formula H|yakzvkstdsatz = M|ytakzvkstdsatz
.formula H|yakzeigwert   = M|ytakzeigwert
.formula H|yakzfremdwert = M|ytakzfremdwert
.formula H|yakzsonstwert = M|ytakzsonstwert
.formula H|yakzfertwert  = M|ytakzfertwert
.formula H|yakzgeswert   = M|ytakzgeswert
.formula H|ybem1         = M|ytbem1
.formula H|ybem2         = M|ytbem2
.formula H|yerfwahrsch   = M|yterfwahrsch
.formula H|yanferwwert   = M|ytanferwwert
.formula H|ykalkposid    = ""                   ?  F|empty(M|ytkalkpos)
.formula H|ykalkposid    = M|ytkalkpos^id       ? _F|empty(M|ytkalkpos)
.copy    H|ybnachtrfordzeile = G|true
.formula H|ynachtrfordid     = M|id
.rewrite
.formula M|ytnachtranfrid    = H|id             ? F|empty(M|ytnachtranfrid)
.formula U|xtindex = H|nummer
.type text xtnachtranf.xtindex
.formula U|xtnachtranf.xtindex = H|id
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL007 ? _(G|evtkommd <> G|kaktname10)
