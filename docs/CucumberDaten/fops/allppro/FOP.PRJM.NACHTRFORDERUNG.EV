.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Daten_aus_Nachtragsanfrage_laden -----
.add M|ytsnachtranfr
.continue EL001 ? _(G|mehr)
.formula M|ytbez          = D|namebspr
.copy    M|ytprojekt      = D|yprojekt
.copy    M|ytpvurspr      = D|ypvurspr
.formula M|ytabrechtypk   = D|yabrechtypk
.copy    M|ytpvnachtr     = D|ypvnachtr
.formula M|ytlzraumvon    = D|ylzraumvon
.formula M|ytlzraumbis    = D|ylzraumbis
.assign  M|ytleistlist    = D|yleilistid
.formula M|ytanfeigstd    = D|yanfeigstd
.formula M|ytanfvkstdsatz = D|yanfvkstdsatz
.formula M|ytanfeigwert   = D|yanfeigwert
.formula M|ytanffremdwert = D|yanffremdwert
.formula M|ytanfsonstwert = D|yanfsonstwert
.formula M|ytanffertwert  = D|yanffertwert
.formula M|ytanfgeswert   = D|yanfgeswert
.formula M|ytakzeigstd    = D|yakzeigstd
.formula M|ytakzvkstdsatz = D|yakzvkstdsatz
.formula M|ytakzeigwert   = D|yakzeigwert
.formula M|ytakzfremdwert = D|yakzfremdwert
.formula M|ytakzsonstwert = D|yakzsonstwert
.formula M|ytakzfertwert  = D|yakzfertwert
.formula M|ytakzgeswert   = D|yakzgeswert
.formula M|ytbem1         = D|ybem1
.formula M|ytbem2         = D|ybem2
.formula M|yterfwahrsch   = D|yerfwahrsch
.formula M|ytanferwwert   = D|yanferwwert
.assign  M|ytkalkpos      = D|ykalkposid
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Neuberechnung_Anfragewerte_Kopf -----
.formula M|yanfgeswert = M|yanfeigwert + M|yanffremdwert + M|yanfsonstwert + M|yanffertwert
.formula M|yanferwwert = M|yanfgeswert * M|yerfwahrsch / 100
.continue 'xprocst.xprocsp'
!PROC003: ----- Neuberechnung_akzeptierte_Werte_Kopf -----
.formula M|yakzgeswert = M|yakzeigwert + M|yakzfremdwert + M|yakzsonstwert + M|yakzfertwert
.continue 'xprocst.xprocsp'
!PROC004: ----- Neuberechnung_Werte_Tabelle -----
.formula M|ytanfeigwert = M|ytanfeigstd * M|ytanfvkstdsatz              ? M|ytanfeigstd <> 0 & M|ytanfvkstdsatz <>0
.formula M|ytanfgeswert = M|ytanfeigwert + M|ytanffremdwert + M|ytanfsonstwert + M|ytanffertwert
.formula M|ytanferwwert = M|ytanfgeswert * M|yterfwahrsch / 100
.formula M|ytakzeigwert = M|ytakzeigstd * M|ytakzvkstdsatz              ? M|ytakzeigstd <> 0 & M|ytakzvkstdsatz <>0
.formula M|ytakzgeswert = M|ytakzeigwert + M|ytakzfremdwert + M|ytakzsonstwert + M|ytakzfertwert
.formula M|yanfeigstd    = 0
.formula M|yanfeigwert   = 0
.formula M|yanffremdwert = 0
.formula M|yanfsonstwert = 0
.formula M|yanffertwert  = 0
.formula M|yanfeigwert   = 0
.formula M|yakzeigstd    = 0
.formula M|yakzeigwert   = 0
.formula M|yakzfremdwert = 0
.formula M|yakzsonstwert = 0
.formula M|yakzfertwert  = 0
.formula M|yakzeigwert   = 0
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|yanfeigstd    = M|yanfeigstd    + M|ytanfeigstd
.formula M|yanfeigwert   = M|yanfeigwert   + M|ytanfeigwert
.formula M|yanffremdwert = M|yanffremdwert + M|ytanffremdwert
.formula M|yanfsonstwert = M|yanfsonstwert + M|ytanfsonstwert
.formula M|yanffertwert  = M|yanffertwert  + M|ytanffertwert
.formula M|yakzeigstd    = M|yakzeigstd    + M|ytakzeigstd
.formula M|yakzeigwert   = M|yakzeigwert   + M|ytakzeigwert
.formula M|yakzfremdwert = M|yakzfremdwert + M|ytakzfremdwert
.formula M|yakzsonstwert = M|yakzsonstwert + M|ytakzsonstwert
.formula M|yakzfertwert  = M|yakzfertwert  + M|ytakzfertwert
.select screen line
.continue LOOP001
!ELOP001: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
