..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allppro/LV.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xttemp xtlvpos xtoberposid xteinlvpos xtbaumstat xtfarbe xtid xysel
.type text    xtvarwert xtvarproz xtvarsollstd xtvariststd xtvarnachstd xtvarlwplan xtvarfortwert xtindex
.type integer xizeile xievtzeile xiknzeile xiaktzeile xistufe xivar xispalte xi1
.type integer xyvdn xyvgr ximerkzeile
.type real    xrzuschlag xrzusatz xrfertgrad xrfertwert xrvkwert
.type real    xrnachtrstd xrgnachtrstd xrnachstd xrsollstd xriststd xrvokastd xrlwplan xrfortwert xrstdkorr
.type real    xrstdabw
.type bool    xbok xbmehr xbstart xbzakt
.type GD      xdstichtag xdvm xdawoche xdewoche
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Farben -----
.input "allpstart/PRJM.FARBEN.DEF"  ? _F|defined(U|xtfarbelvpos)
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.colour -BACKGROUND 'U|xtfarbelvpos'    'M|aktzeile' ? _F|empty(M|ytkalkpos)
.colour -BACKGROUND 'U|xtfarbepvorgang' 'M|aktzeile' ? _F|empty(M|ytpvorgang)
.colour -BACKGROUND 'U|xtfarbenachtrag' 'M|aktzeile' ?  F|empty(M|ytpvorgang) & F|empty(M|ytkalkpos)
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Stichtag -----
.continue EL001 ? _(M|ybwochenbezogen)
.make screen line --o
.formula U|xdstichtag = M|ystichtag - M|ystichtag//7 + 7    ? _F|empty(M|ystichtag)
.formula U|xdstichtag = G|datum     - G|datum//7     + 7    ?  F|empty(M|ystichtag)
.formula M|ystichtag  = U|xdstichtag
.formula M|ykalwoche  = M|ystichtag
.continue FI001
!EL001
.make screen line --o
.formula U|xdstichtag = ('M|ystichtag:8')<<6 + "01"     ? _F|empty(M|ystichtag)
.formula U|xdstichtag = ('G|datum:8')<<6     + "01"     ?  F|empty(M|ystichtag)
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula M|ystichtag  =  U|xdstichtag - 1
.formula M|ykalwoche  = M|ystichtag
!FI001
.continue 'xprocst.xprocsp'
!PROC003: ----- Fertigstellungsgrad -----
.formula U|xtsel = "$,,ybezugsdatum==" + M|ystichtag:8 + ";ypvorgang==" + M|ytpvorgang^id + ";ybprojektversion=(No);ywochenbezogen==" + 'M|ybwochenbezogen(L="0")' + ";@ablageart=(1)"
.load 9 group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL002 ? _(G|mehr)
.select lock add 9|id
.continue EL003 ? _(_(G|mehr))
.set trans +
.box Fehler
Der Historiendatensatz zum Projektvorgang 'M|ytpvorgang' kann nicht bearbeitet werden
Der Fertigstellungsgrad kann nicht erfasst werden.
.set trans -
.error
.end 1
!EL003
.continue FI002
!EL002
.formula U|xtcmd = "make " + G|hdatname.xydbpvstat + " GROUP" + 'U|xygrpvstat'
.'U|xtcmd'
.formula H|such            = M|ytpvorgang^such
.formula H|name            = M|ytpvorgang^name
.copy    H|ypvorgang       = M|ytpvorgang
.copy    H|yprojekt        = M|ytpvorgang^yprojekt
.copy    H|ybezugsdatum    = M|ystichtag
.copy    H|ybwochenbezogen = M|ybwochenbezogen
!FI002
.formula H|yfertstellgrad   = M|ytfertstellgrad
.rewrite
.formula U|xdewoche = M|ystichtag
.formula U|xdawoche = U|xdewoche - 6
.continue EL004 ? _(((_(M|ybwochenbezogen)) & (('G|datum:8')<<6 = ('M|ystichtag:8')<<6)) ; ((M|ybwochenbezogen) & (G|datum >= U|xdawoche) & (G|datum <= U|xdewoche)))
.select lock add M|ytpvorgang
.continue EL005 ? _(_(G|mehr))
.set trans +
.box Fehler
Der Projektvorgang 'M|ytpvorgang' kann nicht bearbeitet werden
Der Fertigstellungsgrad kann nicht erfasst werden.
.set trans -
.continue FI005
!EL005
.formula H|yfertstellgrad   = M|ytfertstellgrad
.rewrite
!FI005
!EL004
.formula M|ytstderwpreff = 0                                                            ?  M|ytfertstellgrad = 0
.formula M|ytstderwpreff = M|ytiststd / M|ytfertstellgrad * (100 - M|ytfertstellgrad)   ? _M|ytfertstellgrad = 0
.formula M|ytstderwges   = M|ytstderwpreff + M|ytstdkorr
.formula M|ytstdfc       = M|ytiststd      + M|ytstderwges
.formula M|ytstdabwbudg  = M|ytgessollstd  - M|ytstdfc
.formula M|ytstdabw          = (M|ytsollstd * M|ytfertstellgrad / 100) + M|ytgesnachtrstd - M|ytiststd
.formula U|xistufe = M|tbaumstufe
.formula U|xizeile = M|aktzeile
!REPT001: ==============================
.formula U|xizeile = U|xizeile - 1
.select screen line 'U|xizeile'
.continue REPT001 ? _(_(F|empty(M|ytkalkpos)))
.formula U|xrfertgrad     = 0
.formula U|xrfertwert     = 0
.formula U|xrstdabw       = 0
.formula U|xrstdkorr      = 0
.formula U|xi1 = 0
.select screen line
.copy U|xbmehr = G|mehr
!LOOP002: ==============================
.continue ELOP002 ? _(U|xbmehr)
.continue EL006 ? _(M|tbaumstufe = U|xistufe)
.continue EL007 ? _(_(F|empty(M|ytpvorgang)))
.formula U|xi1 = U|xi1 + 1
.type real xrpvfertgrad.xi1 xrpvfertwert.xi1
.formula U|xrpvfertgrad.xi1 =                M|ytfertstellgrad
.formula U|xrpvfertwert.xi1 =                M|ytleistwertplan
.formula U|xrfertwert       = U|xrfertwert + M|ytleistwertplan
.formula U|xrstdabw  = U|xrstdabw  + M|ytstdabw
.formula U|xrstdkorr = U|xrstdkorr + M|ytstdkorr
!EL007
.select screen line
.copy U|xbmehr = G|mehr
.continue FI006
!EL006
.copy U|xbmehr = G|FALSE
!FI006
.continue LOOP002
!ELOP002: ==============================
.continue EL008 ? _(_(U|xrfertwert = 0))
.formula U|xrfertgrad = 0
.formula U|xtindex = ""
.formula U|xtindex = F|nextelem(U|xrpvfertgrad, xtindex)
!LOOP003: ==============================
.continue ELOP003 ? _(F|defined(U|xrpvfertgrad.xtindex))
.formula U|xrfertgrad = U|xrfertgrad + ((U|xrpvfertwert.xtindex * 100 / U|xrfertwert) * (U|xrpvfertgrad.xtindex / 100))
.formula U|xtindex = F|nextelem(U|xrpvfertgrad, xtindex)
.continue LOOP003
!ELOP003: ==============================
.select screen line 'U|xizeile'
.formula M|ytfertstellgrad = U|xrfertgrad
.formula M|ytfortschrittswer = M|ytvkwertman * M|ytfertstellgrad / 100
.formula M|ytstdabw          = U|xrstdabw
.formula M|ytstdkorr         = U|xrstdkorr
.formula M|ytstderwpreff = 0                                                            ?  M|ytfertstellgrad = 0
.formula M|ytstderwpreff = M|ytiststd / M|ytfertstellgrad * (100 - M|ytfertstellgrad)   ? _M|ytfertstellgrad = 0
.formula M|ytstderwges   = M|ytstderwpreff + M|ytstdkorr
.formula M|ytstdfc       = M|ytiststd      + M|ytstderwges
.formula M|ytstdabwbudg  = M|ytgessollstd  - M|ytstdfc
.continue FI008
!EL008
.select screen line 'U|xizeile'
!FI008
.continue EL009 ? _(M|tbaumstufe > 0)
!LOOP004: ==============================
.continue ELOP004 ? _(M|tbaumstufe > 0)
.formula U|xistufe = M|tbaumstufe
.formula U|xizeile = M|aktzeile
!REPT002: ==============================
.formula U|xizeile = U|xizeile - 1
.select screen line 'U|xizeile'
.continue REPT002 ? _(M|tbaumstufe < U|xistufe)
.formula U|xistufe    = M|tbaumstufe + 1
.formula U|xrfortwert = 0
.formula U|xrstdabw   = 0
.formula U|xrstdkorr  = 0
.select screen line
.copy U|xbmehr = G|mehr
!LOOP005: ==============================
.continue ELOP005 ? _(U|xbmehr)
.continue EL010 ? _(M|tbaumstufe = U|xistufe)
.formula U|xrstdabw  = U|xrstdabw  + M|ytstdabw
.formula U|xrstdkorr = U|xrstdkorr + M|ytstdkorr
.formula U|xrfortwert = U|xrfortwert + M|ytfortschrittswer
.select screen line
.copy U|xbmehr = G|mehr
.continue FI010
!EL010
.continue EL011 ? _(M|tbaumstufe < U|xistufe)
.copy U|xbmehr = G|FALSE
.continue FI011
!EL011
.select screen line
.copy U|xbmehr = G|mehr
!FI011
!FI010
.continue LOOP005
!ELOP005: ==============================
.select screen line 'U|xizeile'
.formula M|ytfortschrittswer = U|xrfortwert
.formula M|ytfertstellgrad   = 100 * M|ytfortschrittswer / M|ytvkwertman        ? M|ytvkwertman <> 0
.formula M|ytstdabw          = U|xrstdabw
.formula M|ytstdkorr         = U|xrstdkorr
.formula M|ytstderwpreff = 0                                                            ?  M|ytfertstellgrad = 0
.formula M|ytstderwpreff = M|ytiststd / M|ytfertstellgrad * (100 - M|ytfertstellgrad)   ? _M|ytfertstellgrad = 0
.formula M|ytstderwges   = M|ytstderwpreff + M|ytstdkorr
.formula M|ytstdfc       = M|ytiststd      + M|ytstderwges
.formula M|ytstdabwbudg  = M|ytgessollstd  - M|ytstdfc
.continue LOOP004
!ELOP004: ==============================
!EL009
.formula U|xtindex = ""
.formula U|xtindex = F|nextelem(U|xrpvfertgrad, xtindex)
!LOOP006: ==============================
.continue ELOP006 ? _(F|defined(U|xrpvfertgrad.xtindex))
.formula U|xrpvfertwert.xtindex = 0
.formula U|xtindex = F|nextelem(U|xrpvfertgrad, xtindex)
.continue LOOP006
!ELOP006: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.copy    M|ybdetail   = G|TRUE
.formula U|xdstichtag = ('G|datum:8')<<6     + "01"
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula M|ystichtag  =  U|xdstichtag - 1
.formula U|xdstichtag = G|datum     - G|datum//7     + 7
.formula M|ykalwoche  = M|ystichtag
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskende")
.end 1         ? M|ybmaskezu
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "buttonvor")
.continue BRK004 ? _(G|evtvar = "bstart")
.continue EL012 ? _(F|empty(M|ykalkblatt))
.set trans +
.box Hinweis
Bitte zuerst ein Kalkulationsblatt angeben.
.set trans -
.continue FI012
!EL012
.make screen line --O
!FI012
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "ybualleauf")
.continue EL013 ? _(F|empty(M|ykalkblatt))
.set trans +
.box Hinweis
Bitte zuerst ein Kalkulationsblatt angeben.
.set trans -
.continue FI013
!EL013
.make screen line --O
!FI013
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "ybuallezu")
.continue EL014 ? _(F|empty(M|ykalkblatt))
.set trans +
.box Hinweis
Bitte zuerst ein Kalkulationsblatt angeben.
.set trans -
.continue FI014
!EL014
.make screen line --O
!FI014
.continue ESAC002
!BRK006
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK003
.continue BRK007 ? _(G|evtart = "buttonnach")
.continue BRK008 ? _(G|evtvar = "bstart")
.input 'M|tab'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "ybualleauf")
.assign M|ybdetail = G|TRUE
.input 'M|tab'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK009
.continue BRK010 ? _(G|evtvar = "ybuallezu")
.assign M|ybdetail = G|FALSE
.input 'M|tab'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "ytbaumaufzu")
.input 'M|tab'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK011
.continue BRK012 ? _(G|evtvar = "ybuvmwerteladen")
.formula U|xdvm = ('M|ystichtag:8')<<6 + "01"
.formula U|xdvm = U|xdvm - 1
.select screen header
.select screen line
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.continue EL015 ? _(_(F|empty(M|ytpvorgang)))
.formula U|xrfertgrad     = 0
.formula U|xrfertwert     = 0
.formula U|xi1            = 0
.formula U|xtsel = "$,,ybezugsdatum==" + U|xdvm:8 + ";ypvorgang==" + M|ytpvorgang^id + ";yistblatt==1;ybprojektversion=(No);@ablageart=(1)"
.load 9 group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL016 ? _(G|mehr)
.formula M|ytfertstellgrad = 9|yfertstellgrad
.formula U|xiaktzeile = M|aktzeile
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC003
!RET005
.formula xprocsp = xprocsp - 1
.select screen line 'U|xiaktzeile'
!EL016
!EL015
.select screen line
.continue LOOP007
!ELOP007: ==============================
.continue ESAC003
!BRK012
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK007
.continue BRK013 ? _(G|evtart = "feldaus")
.continue BRK014 ? _(G|evtvar = "ykalkblatt")
.continue EL017 ? _(_(F|empty(M|ykalkblatt)))
.copy    M|ykunde      = M|ykalkblatt^ykunde
.copy    M|yverantwkst = M|ykalkblatt^yverantwkst
.continue EL018 ? _(_(F|empty(M|ykalkblatt^yprojekt)))
.copy M|ybwochenbezogen = M|ykalkblatt^yprojekt^ywochenbezogen
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
!EL018
.continue FI017
!EL017
.assign  M|ykunde      = ""
.assign  M|yverantwkst = ""
!FI017
.make screen line --O
.continue ESAC004
!BRK014
.continue BRK015 ? _(G|evtvar = "ystichtag")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK015
.continue BRK016 ? _(G|evtvar = "ybwochenbezogen")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC002
!RET008
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK016
.continue BRK017 ? _(G|evtvar = "ytfertstellgrad")
.continue EL019 ? _(F|empty(M|ytpvorgang))
.set trans +
.box Hinweis
Der Fertigstellungsgrad kann nur fÅr ProjektvorgÑnge erfasst werden.
.set trans -
.continue FI019
!EL019
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC003
!RET009
.formula xprocsp = xprocsp - 1
!FI019
.continue ESAC004
!BRK017
.continue BRK018 ? _(G|evtvar = "ytstdkorr")
.continue EL020 ? _(F|empty(M|ytpvorgang))
.set trans +
.box Hinweis
Korrektur erwartete Stunden kann nur fÅr ProjektvorgÑnge erfasst werden.
.set trans -
.continue FI020
!EL020
.formula U|xtsel = "$,,ybezugsdatum==" + M|ystichtag:8 + ";ypvorgang==" + M|ytpvorgang^id + ";ybprojektversion=(No);ywochenbezogen==" + 'M|ybwochenbezogen(L="0")' + ";@ablageart=(1)"
.load 9 group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL021 ? _(G|mehr)
.select lock add 9|id
.continue EL022 ? _(_(G|mehr))
.set trans +
.box Fehler
Der Historiendatensatz zum Projektvorgang 'M|ytpvorgang' kann nicht bearbeitet werden
Korrektur erwartete Stunden kann nicht erfasst werden.
.set trans -
.error
.end 1
!EL022
.continue FI021
!EL021
.formula U|xtcmd = "make " + G|hdatname.xydbpvstat + " GROUP" + 'U|xygrpvstat'
.'U|xtcmd'
.formula H|such            = M|ytpvorgang^such
.formula H|name            = M|ytpvorgang^name
.copy    H|ypvorgang       = M|ytpvorgang
.copy    H|yprojekt        = M|ytpvorgang^yprojekt
.copy    H|ybezugsdatum    = M|ystichtag
.copy    H|ybwochenbezogen = M|ybwochenbezogen
!FI021
.formula H|ytstdkorr   = M|ytstdkorr
.rewrite
!FI020
.formula M|ytstderwpreff = 0                                                            ?  M|ytfertstellgrad = 0
.formula M|ytstderwpreff = M|ytiststd / M|ytfertstellgrad * (100 - M|ytfertstellgrad)   ? _M|ytfertstellgrad = 0
.formula M|ytstderwges   = M|ytstderwpreff + M|ytstdkorr
.formula M|ytstdfc       = M|ytiststd      + M|ytstderwges
.formula M|ytstdabwbudg  = M|ytgessollstd  - M|ytstdfc
.continue ESAC004
!BRK018
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK013
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMLVPROGRESS.EV")'         ? F|fileexists(F|foppath("IFOP.IS.PRJMLVPROGRESS.EV"))
.continue
