..!interpreter english declaration noabbrev
.. at 2016-11-25, 11:55
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.KORERECHT.YKSTELLE.FA
..==  Pfad              : allppro
..==  Funktion          : Kostenstellen aufl”sen
..==  Erstellungsdatum  : 17.10.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..========================================================================
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtstack           ? _F|defined(U|xtstack)
.type text    xtindex           ? _F|defined(U|xtindex)
.type text    xtmp              ? _F|defined(U|xtmp)
.type integer   xprocsp ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Verdichtungskostenstelle_aufloesen -----
.formula U|xtsel = "$,,verd==" + 0|id + ";@group=" + '0|gruppe' + ";@filingmode=(Active)"
.load 0 accountdata 'U|xtsel
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xtindex = 0|nummer
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = 0|id
.continue EL001 ? _(_(0|bu))
.formula U|xtstack = U|xtstack + 0|id + "###"
!EL001
.load 0 accountdata
.continue LOOP001
!ELOP001: ==============================
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xtstack)))
.formula U|xtmp = U|xtstack<<"###"
.formula U|xtstack = U|xtstack>>"###"
.load 0 accountdata 'U|xtmp'
.continue EL002 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL002
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL003 ? _(_(F|empty(M|ykstelle)))
.continue EL004 ? _(_(M|ykstelle^bu))
.load 0 add M|ykstelle
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.formula U|xtindex    = ""
.formula U|xtindex    = F|nextelem(U|xtkst, xtindex)
!LOOP003: ==============================
.continue ELOP003 ? _(_(F|empty(U|xtindex)))
.make screen line +O
.assign  M|ykstelle = U|xtkst.xtindex
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
.continue LOOP003
!ELOP003: ==============================
!EL004
!EL003
