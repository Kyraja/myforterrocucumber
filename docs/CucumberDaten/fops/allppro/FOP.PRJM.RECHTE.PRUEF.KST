..!interpreter english declaration noabbrev
..
.set trans -
..*****************************************************************************
.. Name           : allppro/FOP.PRJM.RECHTE.PRUEF.KST
.. Datum/Date     : 28.10.2011
.. Version        :
.. Autor/Author   : alltrotec GmbH / ts
.. Copyright      :
.. Beschreibung/
.. Description    : KORE RechteprÅfung:
..                  Eingabe: xykoobjekt - ID des Kostenobjekts (muss im Hauptprogramm mit
..                                        der ID des Kostenobjektes belegt sein)
..                  Ausgabe: xyberlaubt - RÅckgabe ob Rechte am Kostenobjekt vorhanden
..
..                  Puffer: 9 - Kore-Rechtzuordnung
..                          8 - Kore-Rechtesatz
..
...Includes       :
..*****************************************************************************
..
.type bool xyberlaubt           ? _F|defined(U|xyberlaubt)
..
..
..*****************************************************************************
..
..
.assign U|xyberlaubt = G|passw^yprjmallekoobj
.continue       ?  U|xyberlaubt
.continue       ? _F|defined(U|xykoobjekt)
.continue       ?  F|empty(U|xykoobjekt)
.continue       ?  F|empty(G|passw^yprjmkorerechte)
..
..Kore-Rechtzuordnung
.load 9 add G|passw^yprjmkorerechte
.continue END   ? _G|mehr
!KRZ:
.load 9 line
.continue END   ? _G|mehr
.load 8 add 9|ykorecht
.continue KRZ   ? _G|mehr
!KOOBJEKT:
.load 8 line
.continue KRZ   ? _G|mehr
.assign U|xyberlaubt = 8|ykstelle^id = U|xykoobjekt
.continue END   ?  U|xyberlaubt
.continue KOOBJEKT
..
!END:
.load 8
.load 9
.continue
