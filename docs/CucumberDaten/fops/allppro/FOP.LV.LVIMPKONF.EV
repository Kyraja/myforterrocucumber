..!interpreter english declaration noabbrev
.. at 2017-03-27, 10:42
.set TRANS -
..========================================================================
..==  Name              : FOP.LV.LVIMPKONF.EV
..==  Pfad              : allppro
..==  Funktion          : Events an LV Import Konfiguration
..==  Erstellungsdatum  : 15.02.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allppro/LV.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtvar xtname xtwert xtdatei xtmenue
.type integer ximonat xivar xizaehler
.type bool    xbvar
.type int   xprocsp     ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set DEMAND -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|EVTART = "maskaus")
.select lock group 'U|xydbgrlvimpkonf' 'F|expr("$,,ystdkonf==1;id<>" + M|id)'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy H|ystdkonf = G|FALSE
.rewrite
.select lock continue
.continue LOOP001
!ELOP001: ==============================
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|EVTART = "maskende")
.end 1  ? M|ybmaskezu
.continue
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|EVTART = "feldaus")
.continue BRK004 ? _(G|evtvar = "ymapft")
.continue ESAC002
!BRK004
.continue EL001 ? _(G|evtvar<<4 = "ymap")
.continue EL002 ? _(_(F|empty(M|.G|evtvar)))
.formula U|xtsel = "$,,vdn==145;vgr==4;vname/==^[a-z]{2}" + M|.G|evtvar + ".*;typ==(Original);@rows=(Yes);@filingmode=(Active)"
.load 0 group "12:26" 'U|xtsel'
.continue EL003 ? _(_(G|mehr))
.formula U|xtvar = M|.G|evtvar
.set trans +
.formula U|xtsel = F|formatstr("Feld nicht gefunden: {1}", U|xtvar)
.set trans -
.box Fehler
'U|xtsel'
.continue FI003
!EL003
.load 0 line '0|selzeile
.formula U|xtvar  = F|substr(0|vname, 3)
.formula U|xtname = 0|vbeds
.load 0 continue
.continue EL004 ? _(G|mehr)
.set trans +
.formula U|xtsel = "Auswahl"
.set trans -
.file -tempname U|xtmenue
.input DATEI.F
.output new 'U|xtmenue'
'G|kommandochar''G|kommandochar''G|markechar'interpreter english noabbrev
'G|markechar'MENU:
'G|kommandochar'menu 'U|xtsel'
-                   -
'U|xtvar           ''U|xtname' >>.formula U|xtvar = "'U|xtvar'"
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.load 0 line '0|selzeile
.formula U|xtvar  = F|substr(0|vname, 3)
.formula U|xtname = 0|vbeds
'U|xtvar           ''U|xtname' >>.formula U|xtvar = "'U|xtvar'"
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
'G|kommandochar''G|kommandochar'
'G|kommandochar'formula U|xtvar = ""    ? G|menue = 0
.input 'U|xtmenue'
!EL004
.formula M|.G|evtvar = U|xtvar
!FI003
!EL002
!EL001
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK003
!ESAC001: =====   ENDCASE   =====
.continue
