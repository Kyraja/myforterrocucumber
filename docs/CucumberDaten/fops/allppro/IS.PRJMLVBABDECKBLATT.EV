!RET005
.formula xprocsp = xprocsp - 1
!EL011
!EL010
.continue 'xprocst.xprocsp'
!PROC008: ----- Werte_zu_Kostenart -----
.formula U|xrkoartwert     = 0
.formula U|xrkoartzuschlag = 0
.formula U|xtnumkoart      = H|koart^nummer
.formula U|xtsel = "$,,zkoart==" + H|koart^id + ";@ablageart=(1);@zeilen=(1)"
.load 9 group "5:1" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xtnummer = 9|nummer
.load 9 line '9|selzeile'
.continue EL012 ? _(F|defined(U|xrwert.xtnummer))
.continue EL013 ? _(((9|koartvon <= M|ybezugsdatdeck) ; (F|empty(9|koartvon))) & ((9|koartbis >= M|ybezugsdatdeck) ; (F|empty(9|koartbis))))
.continue EL014 ? _(F|defined(H|zproz))
.continue EL015 ? _((M|ybdetail) ; (M|tbaumstufe = 0) ; (G|evtvar = "ytbaumaufzu"))
.formula M|ytwerttech          = M|ytwerttech          +  U|xrwert.xtnummer
!EL015
.formula U|xrtwerttech.xistufe = U|xrtwerttech.xistufe + (U|xrwert.xtnummer * H|zproz / 100)    ? H|aktzeile = 1 ; 'H|optyp(L="0")' = "(115)"
.formula U|xrtwerttech.xistufe = U|xrtwerttech.xistufe - (U|xrwert.xtnummer * H|zproz / 100)    ? H|aktzeile > 1 & 'H|optyp(L="0")' = "(97)"
.formula U|xrkoartwert         = U|xrkoartwert         + (U|xrwert.xtnummer * H|zproz / 100)    ? H|aktzeile = 1 ; 'H|optyp(L="0")' = "(115)"
.formula U|xrkoartwert         = U|xrkoartwert         - (U|xrwert.xtnummer * H|zproz / 100)    ? H|aktzeile > 1 & 'H|optyp(L="0")' = "(97)"
.continue FI014
!EL014
.continue EL016 ? _((M|ybdetail) ; (M|tbaumstufe = 0) ; (G|evtvar = "ytbaumaufzu"))
.formula M|ytwerttech          = M|ytwerttech          + U|xrwert.xtnummer
!EL016
.formula U|xrtwerttech.xistufe = U|xrtwerttech.xistufe + U|xrwert.xtnummer
.formula U|xrkoartwert         = U|xrkoartwert         + U|xrwert.xtnummer
!FI014
!EL013
!EL012
.continue EL017 ? _(G|evtvar = "ybuneuberech")
.continue EL018 ? _(((9|koartvon <= M|ybezugsdatdeck) ; (F|empty(9|koartvon))) & ((9|koartbis >= M|ybezugsdatdeck) ; (F|empty(9|koartbis))))
.continue EL019 ? _(_(F|defined(U|xrktozuschlag.xtnummer)))
.type real U|xrktozuschlag.xtnummer
.load 8 group 'U|xydbgrzuschlagsatz' 'F|expr("$,,yaufwkonto==" + 9|id + ";yzuschlagsbasis<>`;@ablageart=(1)")'
.continue EL020 ? _(G|mehr)
.continue EL021 ? _(_(F|defined(U|xrkoartzuschlag.xtnumkoart)))
.type real xrkoartzuschlag.xtnummer
.formula U|xrkoartzuschlag.xtnummer = U|xrkoartzuschlag
!EL021
.load 7 add 8|yzuschlagsbasis
.continue EL022 ? _(G|mehr)
.formula U|xrbaswert = 0
.load 7 line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.load 6 group 'U|xydbgrdeckblatt' 'F|expr("$,,id==" + M|ydeckblatt^id + ";ytkoart==" + 7|koart^id + ";@ablageart=(1);@zeilen=(1)")'
.continue EL023 ? _(G|mehr)
.load 6 line '6|selzeile'
