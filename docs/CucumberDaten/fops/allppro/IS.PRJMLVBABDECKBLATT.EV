!ELOP003: ==============================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ykstelle=="     +  M|yverantwkst^id
.formula U|xtsel = U|xtsel + ";ygjahr="        + 'F|year(M|ybezugsdatdeck)'
.formula U|xtsel = U|xtsel + ";ybstd=0"
.formula U|xtsel = U|xtsel + ";ytzuschlsatz==" + 8|id
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(1)"
.load 7 group 'U|xydbgrzuschlsatzwert' 'U|xtsel'
.continue EL024 ? _(G|mehr)
.load 7 line '7|selzeile'
.formula U|xrktozuschlag.xtnummer = U|xrbaswert * (7|ytzs.ximonat / 100)
.continue FI024
!EL024
.formula U|xtsel = "$,,ytzuschlsatz==" + 8|id + ";ygjahr=" + 'F|year(M|ybezugsdatdeck)' + ";ybstd=1;@ablageart=(1);@zeilen=(1)"
.load 7 group 'U|xydbgrzuschlsatzwert' 'U|xtsel'
.continue EL025 ? _(G|mehr)
.load 7 line '7|selzeile'
.formula U|xrktozuschlag.xtnummer = U|xrbaswert * (7|ytzs.ximonat / 100)
!EL025
!FI024
!EL022
!EL020
!EL019
.load 8
.load 7
.load 6
.formula U|xrkoartzuschlag = U|xrkoartzuschlag + U|xrktozuschlag.xtnummer
!EL018
!EL017
.load 9 continue
.continue LOOP002
!ELOP002: ==============================
.continue EL026 ? _(_(F|defined(U|xrdbktowert.xtnumkoart)))
.type real xrdbktowert.xtnumkoart
.formula U|xrdbktowert.xtnumkoart = U|xrkoartwert
!EL026
.continue EL027 ? _((U|xbdbneu) ; (G|evtvar = "ybuuebertragen"))
.reserve
.continue EL028 ? _(_(F|defined(U|xrkoartdeck.xtnumkoart)))
.type real xrkoartdeck.xtnumkoart
.formula U|xrkoartdeck.xtnumkoart = U|xrdbktowert.xtnumkoart
.reserve
.select lock group 'U|xydbgrdeckblatt' 'F|expr("$,,id==" + M|ydeckblatt^id + ";ytkoart==" + U|xtnumkoart + ";@ablageart=(1);@zeilen=(1)")'
.continue EL029 ? _(G|mehr)
.select lock line 'H|selzeile'
.continue FI029
!EL029
.select lock add M|ydeckblatt
.make line +O
.assign H|ytkoart = U|xtnumkoart
!FI029
