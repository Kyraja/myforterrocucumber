!PROC011: ----- WerteAusLeistungsliste -----
.load 9 line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL040 ? _(_(F|empty(9|ytvkkonto)))
.formula U|xtnummer = 9|ytvkkonto^nummer
.type real xrvkwert.xtnummer    ? _F|defined(U|xrvkwert.xtnummer)
.type real xrwert.xtnummer      ? _F|defined(U|xrwert.xtnummer)
.formula U|xrvkwert.xtnummer = U|xrvkwert.xtnummer + 9|ytvkwertman
