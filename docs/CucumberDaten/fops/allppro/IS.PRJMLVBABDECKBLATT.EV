.formula U|xrtwerttech.xistufe = U|xrtwerttech.xistufe - (U|xrtwerttech.xi1 * H|zproz / 100)    ? H|aktzeile > 1 & 'H|optyp(L="0")' = "(97)"
.formula U|xrtwerttech.xi1 = 0
.formula U|xrtwertdeck.xistufe = U|xrtwertdeck.xistufe + (U|xrtwertdeck.xi1 * H|zproz / 100)    ? H|aktzeile = 1 ; 'H|optyp(L="0")' = "(115)"
.formula U|xrtwertdeck.xistufe = U|xrtwertdeck.xistufe - (U|xrtwertdeck.xi1 * H|zproz / 100)    ? H|aktzeile > 1 & 'H|optyp(L="0")' = "(97)"
