.colour -BACKGROUND 'U|xabasgreen' yevtkommd 0  ? _M|ysperre
!EL004
.continue 'xprocst.xprocsp'
!PROC007: ----- Deckblatt_eintragen -----
.continue EL010 ? _(_(F|empty(M|ydeckblatt)))
.select add M|ydeckblatt
.copy    M|ybezugsdatdeck = H|ybezugsdatum
.copy    M|yrevdatdeck    = H|yrevdatum
.assign  M|ykalkblatt     = H|ykblattid
.copy    M|ybezugsdatkalk = M|ykalkblatt^ybezugsdatum
.copy    M|yprojekt       = H|yprojekt
.copy    M|ykunde         = H|ykunde
.copy    M|yverantwkst    = H|yverantwkst
.copy    M|ybauftragseingang = H|ybauftragseingang
.copy    M|ybforecast        = H|ybforecast
.formula M|yevtkommd      = G|kaktname12
.formula P|maskkontextfop = ""
.input "is/ABASFARBEN.DEF"
.colour -BACKGROUND 'U|xabasgreen' yevtkommd 0
.continue EL011 ? _(U|xbdbneu)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
