.formula U|xdatum =  U|xdatum - 1
.formula U|xtid   = "DB" + F|tostring(G|versionneu) + "-" + G|pid
.formula U|xtcmd = "<(ProjectSuiteCalculation)><(New)>,(CoverSheet) "
.formula U|xtcmd = U|xtcmd + "?yextid="      +  U|xtid
.formula U|xtcmd = U|xtcmd + "|ykblattid="   +  M|ykalkblatt^id     ? _F|empty(M|ykalkblatt)
.formula U|xtcmd = U|xtcmd + "|yskblatt="    +  M|ykalkblatt^id     ? _F|empty(M|ykalkblatt)
.formula U|xtcmd = U|xtcmd + "|yrevdatum="   + 'U|xdatum:8'
.formula U|xtcmd = U|xtcmd + "|ybmaskezu=1"
