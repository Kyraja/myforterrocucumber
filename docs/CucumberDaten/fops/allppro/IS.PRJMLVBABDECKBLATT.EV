.input "allpstart/PRJM.KONFIG.INI"
.input "allppro/LV.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtsys xtcmd xtid xtkontowerte xtkoartrrwerte xtnummer xtnumkoart xytaufrufernr xytzeitstempel xtsperrstempel
.type integer xi1 xistufe xizeile xievtstufe ximonat
.type integer xyvdn xyvgr
.type real    xrwert xrkoartwert xrkoartzuschlag xrbaswert
.type GD      xdatum
.type bool    xbdbneu
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Sperre_entfernen -----
.continue EL001 ? _((M|ysperre) & (_(F|empty(M|ydeckblatt))))
.continue EL002 ? _(M|ydeckblatt^ysperre)
.select lock add M|ydeckblatt
.continue EL003 ? _(G|mehr)
.copy H|ysperre = G|FALSE
.rewrite
.continue FI003
!EL003
.set TRANS +
.box Hinweis
Das Deckblatt 'M|ydeckblatt^nummer' / 'M|ydeckblatt^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI003
!EL002
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe_und_Schreibschutz_Kopf -----
.protection        ybauftragseingang 0  ? _M|ysperre
.protection -RESET ybauftragseingang 0  ?  M|ysperre
.protection        ybforecast        0  ? _M|ysperre
.protection -RESET ybforecast        0  ?  M|ysperre
.continue 'xprocst.xprocsp'
!PROC003: ----- Farbe_und_Schreibschutz_Zeile -----
.protection        ytwertdeck 'M|aktzeile'  ? _M|ysperre ;  M|ytkoartrr^gruppe = 2
.protection -RESET ytwertdeck 'M|aktzeile'  ?  M|ysperre & _M|ytkoartrr^gruppe = 2
.continue 'xprocst.xprocsp'
!PROC004: ----- Farbe_und_Schreibschutz_Tabelle -----
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC003
!RET001
.formula xprocsp = xprocsp - 1
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- Tabelle_leeren -----
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.formula M|yevtkommd    = ""
.colour -BACKGROUND "-1 -1 -1" yevtkommd 0
.assign M|ysperre = G|FALSE
.make screen line --O
.continue 'xprocst.xprocsp'
!PROC006: ----- DeckblattBearbeiten -----
.continue EL004 ? _(_(F|empty(M|ydeckblatt)))
.continue EL005 ? _(_(M|ysperre))
.formula U|xytaufrufernr = G|aufrufernr
.input "allpstart/GET.CALLERNO"
.formula U|xtsperrstempel = U|xytzeitstempel
.copy M|ysperre     = G|TRUE
.continue EL006 ? _((M|ydeckblatt^ysperre) & (_(F|empty(M|ydeckblatt^yaufrufernr))))
.formula U|xytaufrufernr = M|ydeckblatt^yaufrufernr
.input "allpstart/GET.CALLERNO"
.continue EL007 ? _(U|xytzeitstempel = M|ydeckblatt^yaufruferzp)
.set trans +
.formula U|xtsel = "Achtung"
.box -button ok -title 'U|xtsel'
'F|formatstr("{1} {2} wird gerade bearbeitet.", M|ydeckblatt^grbez, M|ydeckblatt^nummer)'

Bearbeiter: 'M|ydeckblatt^ysperrzeich'
Zeitpunkt der Sperre: 'M|ydeckblatt^ysperrzp'

Das Deckblatt wird zur Anzeige geîffnet.
.set trans -
.copy M|ysperre = G|FALSE
!EL007
!EL006
.continue EL008 ? _(M|ysperre)
.select lock add M|ydeckblatt
.continue EL009 ? _(G|mehr)
.copy    H|ysperre     = G|TRUE
.formula H|ysperrzeich = G|bzeichen
.copy    H|ysperrzp    = G|zeitpunkt
.formula H|yaufrufernr = G|aufrufernr
.formula H|yaufruferzp = U|xtsperrstempel
.rewrite
.copy    M|ysperre     = G|TRUE
.continue FI009
!EL009
.set TRANS +
.box Hinweis
Das Deckblatt 'M|ydeckblatt^nummer' / 'M|ydeckblatt^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
.copy M|ysperre = G|FALSE
!FI009
!EL008
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
