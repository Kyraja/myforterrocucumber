.formula U|xrtwertdeck.xistufe = U|xrtwertdeck.xistufe + (U|xrkoartdeck.xtnumkoart * H|zproz / 100)    ? H|aktzeile = 1 ; 'H|optyp(L="0")' = "(115)"
.formula U|xrtwertdeck.xistufe = U|xrtwertdeck.xistufe - (U|xrkoartdeck.xtnumkoart * H|zproz / 100)    ? H|aktzeile > 1 & 'H|optyp(L="0")' = "(97)"
.continue FI035
!EL035
