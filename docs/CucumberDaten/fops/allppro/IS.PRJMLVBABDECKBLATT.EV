.formula U|xrtwertdeck.xistufe = U|xrtwertdeck.xistufe
!FI035
!EL033
.continue 'xprocst.xprocsp'
!PROC009: ----- BAB_Rechenregel -----
.formula M|tbaumstat   = "+"                    ? _M|ybdetail
.formula M|ytbaumaufzu = "icon:folder_closed"   ? _M|ybdetail
.formula M|tbaumstat   = "-"                    ?  M|ybdetail
.formula M|ytbaumaufzu = "icon:folder_opened"   ?  M|ybdetail
.formula U|xistufe = U|xistufe + 1
.type integer xizeile.xistufe       ? _F|defined(U|xizeile.xistufe)
.type real    xrtwerttech.xistufe   ? _F|defined(U|xrtwerttech.xistufe)
.type real    xrtwertdeck.xistufe   ? _F|defined(U|xrtwertdeck.xistufe)
.formula U|xizeile.xistufe = M|aktzeile
.reserve LIFO
.select add H|koart
