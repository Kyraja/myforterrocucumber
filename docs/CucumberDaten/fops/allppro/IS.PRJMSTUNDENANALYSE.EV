..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMSTUNDENANALYSE.EV
..==  Pfad              : allppro
..==  Funktion          : Infosystem Stundenanalyse
..==  Erstellungsdatum  : 18.01.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/LART.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xykoobjekt
.type text    xtkstvgl xtstack xtmarkerx xttip xtmp
.type text    xtfarbedirektabs xtfarballgarbabs xtfarbeurabs xtfarbekrabs xtfarbegzabs xtfarbesaabs
.type integer xivar ximonat xinitopt xi1
.type real    xrtfremdabs xrtfremdfakt    xrtfremdnf    xrteigenabs xrteigenfakt    xrteigennf    xrtabrechabs xrtallgarbabs xrtallgabwabs xrteigenallabs xrzielvksatz
.type real    xrtfremdsum xrtfremdfaktsum xrtfremdnfsum xrteigensum xrteigenfaktsum xrteigennfsum xrtabrechsum xrtallgarbsum xrtallgabwsum xrteigenallsum
.type real    xrtallgabwurabs xrtallgabwkrabs xrtallgabwsaabs xrtallgabwgzabs xrtgesabs
.type real    xrtallgabwursum xrtallgabwkrsum xrtallgabwsasum xrtallgabwgzsum
.type date    xdadat xdedat
.type GD19    xddathelp
.type integer xyred xygreen xyblue xyhue
.type realx   xysat xyval
.type bool    xybrgb2hsv xybhsv2rgb
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Continue -----
.input 'F|foppath("IFOP.IS.PRJMSTUNDENANALYSE.EV")'  ? F|fileexists(F|foppath("IFOP.IS.PRJMSTUNDENANALYSE.EV"))
.continue
.continue 'xprocst.xprocsp'
!PROC002: ----- Variablen_initilisieren -----
.formula U|xrtfremdabs     = 0
.formula U|xrtfremdfakt    = 0
.formula U|xrtfremdnf      = 0
.formula U|xrteigenabs     = 0
.formula U|xrteigenfakt    = 0
.formula U|xrteigennf      = 0
.formula U|xrtabrechabs    = 0
.formula U|xrtallgarbabs   = 0
.formula U|xrtallgabwabs   = 0
.formula U|xrteigenallabs  = 0
.formula U|xrtallgabwurabs = 0
.formula U|xrtallgabwkrabs = 0
.formula U|xrtallgabwgzabs = 0
.formula U|xrtallgabwsaabs = 0
.formula U|xrzielvksatz    = 0
.continue 'xprocst.xprocsp'
!PROC003: ----- Werte_ermitteln -----
.formula U|xtsel = "$,,yadatum=" + U|xdadat:8 + "!" + U|xdedat:8 + ";@ablageart=(1)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xtindex = "CC" + (H|ykstelle^id<<",")<<-1
.continue EL001 ? _((F|defined(U|xtkst.xtindex)) ; ((F|empty(H|ykstelle)) & (M|yballekst)))
.continue BRK001 ? _(H|ytaetschl^ydirindik = "D")
.formula U|xrtfremdabs     = U|xrtfremdabs     + H|yarbzeit      ? _H|ypersperstypk = "EM"
.formula U|xrtfremdfakt    = U|xrtfremdfakt    + H|yfaktzeit     ? _H|ypersperstypk = "EM"
.formula U|xrteigenabs     = U|xrteigenabs     + H|yarbzeit      ?  H|ypersperstypk = "EM"
.formula U|xrteigenfakt    = U|xrteigenfakt    + H|yfaktzeit     ?  H|ypersperstypk = "EM"
.continue ESAC001
!BRK001
.continue BRK002 ? _(H|ytaetschl^ydirindik = "I")
.formula U|xrteigenallabs  = U|xrteigenallabs  + H|yarbzeit      ?  H|ypersperstypk = "EM"
.formula U|xrtallgarbabs   = U|xrtallgarbabs   + H|yarbzeit      ? _H|ytaetschl^yabwesend
.formula U|xrtallgabwabs   = U|xrtallgabwabs   + H|yarbzeit      ?  H|ytaetschl^yabwesend
.continue EL002 ? _((H|ypersperstypk = "EM") & (H|ytaetschl^yabwesend))
.formula U|xrtallgabwurabs = U|xrtallgabwurabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 =  "U"
.formula U|xrtallgabwkrabs = U|xrtallgabwkrabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 =  "K"
.formula U|xrtallgabwgzabs = U|xrtallgabwgzabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 =  "G"
.formula U|xrtallgabwsaabs = U|xrtallgabwsaabs + H|yarbzeit      ?  H|ytaetschl^yanwesendk<<1 <> "U" & H|ytaetschl^yanwesendk<<1 <> "K" & H|ytaetschl^yanwesendk<<1 <> "G"
!EL002
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
!EL001
.select continue
.continue LOOP001
!ELOP001: ==============================
.formula U|xrtfremdnf = U|xrtfremdabs - U|xrtfremdfakt
.formula U|xrteigennf = U|xrteigenabs - U|xrteigenfakt
.continue 'xprocst.xprocsp'
!PROC004: ----- Abgerechnete_Stunden -----
.formula U|xtindex = ""
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xtindex)))
.continue EL003 ? _(_(F|empty(U|xtkst.xtindex)))
.formula U|xrtabrechabs  = 0
.formula U|xtsel = "$,,ktyp==5;vom=" + U|xdadat:8 + "!" + U|xdedat:8 + ";yprjmverantwkst==" + U|xtkst.xtindex + ";@ablageart=(3)"
.select sales 'U|xtsel'
..= Summe der Lohnanteile aller VK-LS Positionen mit verantw. Kostenstelle (im Kopf) = ODER(ykst1;...;ykst10) / Ziel-VK-Satz des Monats zur betreffenden Kostenstelle
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xrzielvksatz = 0
.continue EL004 ? _(_(F|empty(H|yprjmverantwkst^yprjmzvksleiart)))
.formula U|xtsel = "$,,ykstelle==" + H|yprjmverantwkst^id + ";yleiart==" + H|yprjmverantwkst^yprjmzvksleiart^id + ";ygjahr=" + 'F|getfy(H|vom)'
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(1)"
.load 9 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL005 ? _(G|mehr)
.load 9 line '9|selzeile'
.formula U|xrzielvksatz = 9|yvsf.ximonat                                         ?  9|yvland = G|inland ;  F|empty(9|yvland)
.formula U|xrzielvksatz = F|fxamount(G|inland,9|yvsf.ximonat,G|datum,H|pland)    ? _9|yvland = G|inland & _F|empty(9|yvland)
!EL005
!EL004
.continue EL006 ? _(U|xrzielvksatz <> 0)
.select line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xrtabrechabs  = U|xrtabrechabs  + (H|yprjmpeigenleist                                      / U|xrzielvksatz) ?  H|pland = G|inland
.formula U|xrtabrechabs  = U|xrtabrechabs  + (F|fxamount(G|inland,H|yprjmpeigenleist,G|datum,H|pland) / U|xrzielvksatz) ? _H|pland = G|inland
.select line
.continue LOOP004
!ELOP004: ==============================
!EL006
.select continue
.continue LOOP003
!ELOP003: ==============================
!EL003
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- Farbe1 -----
.continue EL007 ? _(_(M|yttext = "Summe"))
.colour -BACKGROUND 'U|xtfarbes'                            yttext 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                            ytkenn 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytfremdabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytfremdfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytfremdnf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            yteigenabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            yteigenfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            yteigennf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytdirektabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgarbabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwurabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwkrabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwgzabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwsaabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytindirabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2'                           ytgesabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2' -FOREGROUND 'U|xtfarbee2' ytfremdant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2' -FOREGROUND 'U|xtfarbee2' yteigenant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2'                           ytabrechabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2' -FOREGROUND 'U|xtfarbee2' ytgesamt     'M|aktzeile'
.continue FI007
!EL007
.colour -BACKGROUND 'U|xtfarbes'                           yttext 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytkenn 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdnf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigenabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigenfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigennf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytdirektabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigenant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgarbabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwurabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwkrabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwgzabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwsaabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytindirabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytabrechabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes'  ytfremdant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes'  yteigenant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytgesabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes'  ytgesamt     'M|aktzeile'
!FI007
.continue 'xprocst.xprocsp'
!PROC006: ----- Farbe2 -----
.continue EL008 ? _(_(M|yttext = "Summe"))
.colour -BACKGROUND 'U|xtfarbes'                            yttext 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                            ytkenn 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytfremdabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytfremdfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            ytfremdnf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            yteigenabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            yteigenfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'                            yteigennf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe2'   -FOREGROUND 'U|xtfarbe2' ytdirektabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgarbabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwurabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwkrabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwgzabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2'                           ytallgabwsaabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbef2' -FOREGROUND 'U|xtfarbef2' ytindirabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2' -FOREGROUND 'U|xtfarbee2' ytgesabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2'                           ytfremdant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2'                           yteigenant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2' -FOREGROUND 'U|xtfarbee2' ytabrechabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbee2'                           ytgesamt     'M|aktzeile'
.continue FI008
!EL008
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes' yttext 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytkenn 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdnf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigenabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigenfakt  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigennf    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes'  ytdirektabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgarbabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwabs   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwurabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwkrabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwgzabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytallgabwsaabs 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes'  ytindirabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytabrechabs  'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytfremdant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           yteigenant   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes' -FOREGROUND 'U|xtfarbes'  ytgesabs     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbes'                           ytgesamt     'M|aktzeile'
!FI008
.continue 'xprocst.xprocsp'
!PROC007: ----- Zeile_fuellen -----
.make screen line +O
.formula M|ytbuaktion = "icon:view"
.formula M|yttext     = 'M|yjahr' + " " + ("0" + 'U|ximonat')>>2
.formula M|ytkenn     = "h"
.formula M|ytjahr     =  M|yjahr
.formula M|ytmonat    =  U|ximonat
.formula M|ytfremdabs     = U|xrtfremdabs
.formula M|ytfremdfakt    = U|xrtfremdfakt
.formula M|ytfremdnf      = U|xrtfremdnf
.formula M|yteigenabs     = U|xrteigenabs
.formula M|yteigenfakt    = U|xrteigenfakt
.formula M|yteigennf      = U|xrteigennf
.formula M|ytdirektabs    = U|xrtfremdabs + U|xrteigenabs
.formula M|ytabrechabs    = U|xrtabrechabs
.formula M|ytallgarbabs   = U|xrtallgarbabs
.formula M|ytallgabwabs   = U|xrtallgabwabs
.formula M|ytallgabwurabs = U|xrtallgabwurabs
.formula M|ytallgabwkrabs = U|xrtallgabwkrabs
.formula M|ytallgabwgzabs = U|xrtallgabwgzabs
.formula M|ytallgabwsaabs = U|xrtallgabwsaabs
.formula M|ytindirabs     = U|xrtallgarbabs + U|xrtallgabwabs
.formula M|ytgesabs       = M|ytdirektabs + M|ytindirabs
.formula U|xtmarkerx = U|xtmarkerx + ";"            ? _F|empty(U|xtmarkerx)
.formula U|xtmarkerx = U|xtmarkerx + 'M|ytmonat'
.type real xrdirekt.ximonat xrallgarbabs.ximonat xrallgabwurabs.ximonat xrallgabwkrabs.ximonat xrallgabwgzabs.ximonat xrallgabwsaabs.ximonat
.continue EL009 ? _(_(M|ytgesabs = 0))
.formula U|xrdirekt.ximonat       = M|ytdirektabs    / M|ytgesabs * 100
.formula U|xrallgarbabs.ximonat   = M|ytallgarbabs   / M|ytgesabs * 100
.formula U|xrallgabwurabs.ximonat = M|ytallgabwurabs / M|ytgesabs * 100
.formula U|xrallgabwkrabs.ximonat = M|ytallgabwkrabs / M|ytgesabs * 100
.formula U|xrallgabwgzabs.ximonat = M|ytallgabwgzabs / M|ytgesabs * 100
.formula U|xrallgabwsaabs.ximonat = M|ytallgabwsaabs / M|ytgesabs * 100
!EL009
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC005
!RET001
.formula xprocsp = xprocsp - 1
.make screen line +O
.formula M|ytkenn  = "%"
.formula M|ytjahr  = M|yjahr
.formula M|ytmonat = U|ximonat
.formula M|ytfremdabs     = U|xrtfremdabs  / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula M|ytfremdfakt    = U|xrtfremdfakt / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula M|ytfremdnf      = U|xrtfremdnf   / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula M|yteigenabs     = U|xrteigenabs  / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula M|yteigenfakt    = U|xrteigenfakt / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula M|yteigennf      = U|xrteigennf   / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula M|ytabrechabs    = U|xrtabrechabs / (U|xrtfremdabs + U|xrteigenabs) * 100      ?  U|xrtfremdabs + U|xrteigenabs <> 0
.formula U|xrtgesabs      = U|xrtfremdabs + U|xrteigenabs + U|xrtallgarbabs + U|xrtallgabwabs
.formula M|ytgesabs       = M|ytdirektabs + M|ytindirabs
.formula M|ytfremdant     = U|xrtfremdabs   / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|yteigenant     = U|xrteigenabs   / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|ytallgarbabs   = U|xrtallgarbabs / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|ytallgabwabs   = U|xrtallgabwabs / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|ytallgabwurabs = U|xrtallgabwurabs / U|xrteigenallabs * 100   ?  U|xrteigenallabs <> 0
.formula M|ytallgabwkrabs = U|xrtallgabwkrabs / U|xrteigenallabs * 100   ?  U|xrteigenallabs <> 0
.formula M|ytallgabwgzabs = U|xrtallgabwgzabs / U|xrteigenallabs * 100   ?  U|xrteigenallabs <> 0
.formula M|ytallgabwsaabs = U|xrtallgabwsaabs / U|xrteigenallabs * 100   ?  U|xrteigenallabs <> 0
.formula M|ytgesamt       = M|ytfremdant + M|yteigenant + M|ytallgarbabs + M|ytallgabwabs
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC006
!RET002
.formula xprocsp = xprocsp - 1
.formula U|xrtfremdsum     = U|xrtfremdsum     + U|xrtfremdabs
.formula U|xrtfremdfaktsum = U|xrtfremdfaktsum + U|xrtfremdfakt
.formula U|xrtfremdnfsum   = U|xrtfremdnfsum   + U|xrtfremdnf
.formula U|xrteigensum     = U|xrteigensum     + U|xrteigenabs
.formula U|xrteigenfaktsum = U|xrteigenfaktsum + U|xrteigenfakt
.formula U|xrteigennfsum   = U|xrteigennfsum   + U|xrteigennf
.formula U|xrtabrechsum    = U|xrtabrechsum    + U|xrtabrechabs
.formula U|xrtallgarbsum   = U|xrtallgarbsum   + U|xrtallgarbabs
.formula U|xrtallgabwsum   = U|xrtallgabwsum   + U|xrtallgabwabs
.formula U|xrteigenallsum  = U|xrteigenallsum  + U|xrteigenallabs
.formula U|xrtallgabwursum = U|xrtallgabwursum + U|xrtallgabwurabs
.formula U|xrtallgabwkrsum = U|xrtallgabwkrsum + U|xrtallgabwkrabs
.formula U|xrtallgabwgzsum = U|xrtallgabwgzsum + U|xrtallgabwgzabs
.formula U|xrtallgabwsasum = U|xrtallgabwsasum + U|xrtallgabwsaabs
.continue 'xprocst.xprocsp'
