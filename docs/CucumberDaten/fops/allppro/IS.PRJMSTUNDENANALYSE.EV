.make screen line +O
.formula M|yttext  = "Summe"
.formula M|ytkenn  = "h"
.formula M|ytjahr  = M|yjahr
.formula M|ytmonat = U|ximonat
.formula M|ytfremdabs     = U|xrtfremdsum
.formula M|ytfremdfakt    = U|xrtfremdfaktsum
.formula M|ytfremdnf      = U|xrtfremdnfsum
.formula M|yteigenabs     = U|xrteigensum
.formula M|yteigenfakt    = U|xrteigenfaktsum
.formula M|yteigennf      = U|xrteigennfsum
.formula M|ytdirektabs    = U|xrtfremdsum + U|xrteigensum
.formula M|ytabrechabs    = U|xrtabrechsum
.formula M|ytallgarbabs   = U|xrtallgarbsum
.formula M|ytallgabwabs   = U|xrtallgabwsum
.formula M|ytallgabwurabs = U|xrtallgabwursum
.formula M|ytallgabwkrabs = U|xrtallgabwkrsum
.formula M|ytallgabwgzabs = U|xrtallgabwgzsum
.formula M|ytallgabwsaabs = U|xrtallgabwsasum
.formula M|ytindirabs     = U|xrtallgarbsum + U|xrtallgabwsum
.formula M|ytgesabs       = M|ytdirektabs + M|ytindirabs
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET063" 
.continue PROC005
!RET063
.formula xprocsp = xprocsp - 1
.make screen line +O
.formula M|yttext  = "Summe"
.formula M|ytkenn  = "%"
.formula M|ytjahr  = M|yjahr
.formula M|ytmonat = U|ximonat
.formula M|ytfremdabs     = U|xrtfremdsum     / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula M|ytfremdfakt    = U|xrtfremdfaktsum / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula M|ytfremdnf      = U|xrtfremdnfsum   / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula M|yteigenabs     = U|xrteigensum     / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula M|yteigenfakt    = U|xrteigenfaktsum / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula M|yteigennf      = U|xrteigennfsum   / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula M|ytabrechabs    = U|xrtabrechsum    / (U|xrtfremdsum + U|xrteigensum) * 100   ?  U|xrtfremdsum + U|xrteigensum <> 0
.formula U|xrtgesabs      = U|xrtfremdsum + U|xrteigensum + U|xrtallgarbsum + U|xrtallgabwsum
.formula M|ytfremdant     = U|xrtfremdsum   / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|yteigenant     = U|xrteigensum   / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|ytallgarbabs   = U|xrtallgarbsum / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|ytallgabwabs   = U|xrtallgabwsum / U|xrtgesabs * 100          ?  U|xrtgesabs <> 0
.formula M|ytallgabwurabs = U|xrtallgabwursum / U|xrteigenallsum * 100   ?  U|xrteigenallsum <> 0
.formula M|ytallgabwkrabs = U|xrtallgabwkrsum / U|xrteigenallsum * 100   ?  U|xrteigenallsum <> 0
.formula M|ytallgabwgzabs = U|xrtallgabwgzsum / U|xrteigenallsum * 100   ?  U|xrteigenallsum <> 0
.formula M|ytallgabwsaabs = U|xrtallgabwsasum / U|xrteigenallsum * 100   ?  U|xrteigenallsum <> 0
.formula M|ytgesamt       = M|ytfremdant + M|yteigenant + M|ytallgarbabs + M|ytallgabwabs
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET064" 
.continue PROC006
!RET064
.formula xprocsp = xprocsp - 1
.formula U|xyred   =  U|xtfarbe2<<" "
.formula U|xygreen = (U|xtfarbe2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbe2>$" "
.copy U|xybrgb2hsv = G|TRUE
.copy U|xybhsv2rgb = G|FALSE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xysat = U|xysat + (U|xysat * 0.4)
.formula U|xysat = 1                    ? U|xysat > 1
.formula U|xyval = 1                    ? U|xyval > 1
.copy U|xybrgb2hsv = G|FALSE
.copy U|xybhsv2rgb = G|TRUE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbedirektabs = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbef2<<" "
.formula U|xygreen = (U|xtfarbef2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbef2>$" "
.copy U|xybrgb2hsv = G|TRUE
.copy U|xybhsv2rgb = G|FALSE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xyhue = U|xyhue + 15
.formula U|xyhue = U|xyhue - 360        ? U|xyhue > 360
.copy U|xybrgb2hsv = G|FALSE
.copy U|xybhsv2rgb = G|TRUE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarballgarbabs = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
.formula U|xyred   =  U|xtfarbef2<<" "
.formula U|xygreen = (U|xtfarbef2>>" ")<<" "
.formula U|xyblue  =  U|xtfarbef2>$" "
.copy U|xybrgb2hsv = G|TRUE
.copy U|xybhsv2rgb = G|FALSE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xysat = U|xysat + (U|xysat * 0.4)
.formula U|xysat = 1                    ? U|xysat > 1
.formula U|xyhue = U|xyhue + 15
.formula U|xyhue = U|xyhue - 360        ? U|xyhue > 360
