..!interpreter english declaration noabbrev 
..*****************************************************************************
.. FOP-Name :		SERVICE.PROJECT.FINALCOSTING
.. Date : 			28.06.2017
.. Author : 		ts
.. Responsible : 	ts
.. Supervisor : 	ts
.. Copyright : (c)  2017
.. Function :       Nachkalkulation aller Projekte
..*****************************************************************************
..<VAR>
.type text   xtsel          ? _F|defined(U|xtsel)
.type bool   xball          ? _F|defined(U|xball)
.type symtab xstprojects    ? _F|defined(U|xstprojects)
..</VAR>
..
..<META 9|='P86:1'>
.println -loglevel 1 -screen Perform final costing for projects
.assign U|xstprojects = ""
.formula U|xtsel "$,,"          ?  U|xball
.formula U|xtsel "%,,"          ? _U|xball
.load 9 group "86:1" 'U|xtsel'
.continue END       ? _G|mehr
!PROJECT:
.type P86:1 F|map(U|xstprojects, '9|id')      ? _F|defined(F|map(U|xstprojects, '9|id'))
.assign F|map(U|xstprojects, '9|id') = 9|id
.load 9 continue
.continue PROJECT   ?  G|mehr
..
.formula U|xtsel = ""
.formula U|xtsel = F|nextelem(F|map(U|xstprojects, ""), U|xtsel) 
.continue END   ?  F|empty(U|xtsel)
!FC:
.println -loglevel 1 -screen 'F|map(U|xstprojects, U|xtsel)^such' - 'F|map(U|xstprojects, U|xtsel)'
.input "java:de.alltrotec.ps.control.ProjectFinalCosting@ALLPS" project='F|map(U|xstprojects, U|xtsel)^id'
.formula U|xtsel = F|nextelem(F|map(U|xstprojects, ""), U|xtsel)
.continue FC    ? _F|empty(U|xtsel)
!END:
.continue