!EL020
.continue EL021 ? _(_(F|empty(M|ytkoko^ygkzsfert)))
.formula U|xtvar  = "ytkoko^ygkzsfert"
.formula U|xtwert = "ytgkzsfertwert"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET010" 
