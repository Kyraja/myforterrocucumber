..!interpreter english declaration noabbrev
.. at 2017-01-31, 09:38
.set trans -
..========================================================================
..==  Name              : FOP.LV.LVKALKBLATT.EV
..==  Pfad              : allppro
..==  Funktion          : Events an LV Kalkulationsblatt
..==  Erstellungsdatum  : 24.11.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allppro/LV.KONFIG.INI"
.input "allpstart/LART.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtid xtvar xtwert xtdatei xtprojleistkatid xtftext xtkoko
.type real    xpapreis
.type integer ximonat xivar xizaehler
.type integer xyvdn xyvgr
.type bool    xbvar xbok
.type GD      xdkonddat
.type TAZ7    xeinh
.type text    xykoobjekt
.type bool    xyberlaubt
.'F|expr("type P" + U|xydbgrprojekt + " xpprojekt")
.type int   xprocsp     ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Zuschlag_ermitteln -----
.formula M|ybezugsdatum = G|DATUM       ? F|empty(M|ybezugsdatum)
.formula U|ximonat      = F|month(M|ybezugsdatum)
.continue EL001 ? _(_(F|empty(M|yverantwkst)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ykstelle=="     +  M|yverantwkst^id
.formula U|xtsel = U|xtsel + ";ygjahr="        + 'F|year(M|ybezugsdatum)'
.formula U|xtsel = U|xtsel + ";ybstd=0"
.formula U|xtsel = U|xtsel + ";ytzuschlsatz==" + M|.xtvar^id
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(1)"
.load 8 group 'U|xydbgrzuschlsatzwert' 'U|xtsel'
.continue EL002 ? _(G|mehr)
.load 8 line '8|selzeile'
.formula M|.xtwert = 8|ytzs.ximonat
.continue FI002
!EL002
.formula U|xtsel = "$,,ytzuschlsatz==" + M|.xtvar^id + ";ygjahr=" + 'F|year(M|ybezugsdatum)' + ";ybstd=1;@ablageart=(1);@zeilen=(1)"
.load 8 group 'U|xydbgrzuschlsatzwert' 'U|xtsel'
.continue EL003 ? _(G|mehr)
.load 8 line '8|selzeile'
.formula M|.xtwert = 8|ytzs.ximonat
!EL003
!FI002
.load 8
.continue FI001
!EL001
.formula U|xtsel = "$,,ytzuschlsatz==" + M|.xtvar^id + ";ygjahr=" + 'F|year(M|ybezugsdatum)' + ";ybstd=1;@ablageart=(1);@zeilen=(1)"
.load 8 group 'U|xydbgrzuschlsatzwert' 'U|xtsel'
.continue EL004 ? _(G|mehr)
.load 8 line '8|selzeile'
.formula M|.xtwert = 8|ytzs.ximonat
!EL004
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- Zuschlaege_aus_KalkSchema -----
.continue EL005 ? _(_(F|empty(M|ykalkschema)))
.select add M|ykalkschema
.continue EL006 ? _(G|mehr)
.formula U|xivar = 1
!LOOP001: ==============================
.continue ELOP001 ? _((F|defined(H|ylvhkzs.U|xivar)) ; (F|defined(H|ylvskzs.U|xivar)))
.continue EL007 ? _(F|defined(H|ylvhkzs.U|xivar))
.assign  M|yhkzs.U|xivar      = H|ylvhkzs.U|xivar
.formula M|yhkzsname.U|xivar  = H|ylvhkzs.U|xivar^namebspr
.assign  M|yhkzsartk.U|xivar  = H|ylvhkzs.U|xivar^yzsartk
.formula M|yhkzswert.U|xivar  = 0
.continue EL008 ? _(_(F|empty(M|yhkzs.U|xivar)))
.formula U|xtvar  = "yhkzs"     + F|tostring(U|xivar)
.formula U|xtwert = "yhkzswert" + F|tostring(U|xivar)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL008
!EL007
.continue EL009 ? _(F|defined(H|ylvskzs.U|xivar))
.assign  M|yskzs.U|xivar      = H|ylvskzs.U|xivar
.formula M|yskzsname.U|xivar  = H|ylvskzs.U|xivar^namebspr
.assign  M|yskzsartk.U|xivar  = H|ylvskzs.U|xivar^yzsartk
.formula M|yskzswert.U|xivar  = 0
.continue EL010 ? _(_(F|empty(M|yskzs.U|xivar)))
.formula U|xtvar  = "yskzs"     + F|tostring(U|xivar)
.formula U|xtwert = "yskzswert" + F|tostring(U|xivar)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL010
!EL009
.formula U|xivar = U|xivar + 1
.continue LOOP001
!ELOP001: ==============================
.continue FI006
!EL006
.set TRANS +
.box Fehler
Das Kalkulationsschema 'M|ykalkschema' kann nicht geladen werden.
.set TRANS -
.error
.end 1
!FI006
!EL005
.continue 'xprocst.xprocsp'
!PROC003: ----- Schreibschutz_Zuschlagsfelder -----
.formula U|xivar = 1
!LOOP002: ==============================
.continue ELOP002 ? _((F|defined(M|yhkzs.U|xivar)) ; (F|defined(M|yskzs.U|xivar)))
.continue EL011 ? _(_(F|empty(M|yhkzs.U|xivar)))
.formula P|maskkontextfop    = P|maskkontextfop + " HKZS" + F|tostring(U|xivar)
.formula M|yhkzsname.U|xivar = M|yhkzs.U|xivar^namebspr
!EL011
.continue EL012 ? _(_(F|empty(M|yskzs.U|xivar)))
.formula P|maskkontextfop    = P|maskkontextfop + " SKZS" + F|tostring(U|xivar)
.formula M|yskzsname.U|xivar = M|yskzs.U|xivar^namebspr
!EL012
.assign U|xbvar = M|yhkzs.U|xivar^ybaendzsinkb
.'F|expr("protection yhkzsname"  + F|tostring(U|xivar) + " 0")' ? _U|xbvar
.'F|expr("protection yhkzsart"   + F|tostring(U|xivar) + " 0")' ? _U|xbvar
.'F|expr("protection yhkzswert"  + F|tostring(U|xivar) + " 0")' ? _U|xbvar
.'F|expr("protection -RESET yhkzsname"  + F|tostring(U|xivar) + " 0")'  ?  U|xbvar
.'F|expr("protection -RESET yhkzsart"   + F|tostring(U|xivar) + " 0")'  ?  U|xbvar
.'F|expr("protection -RESET yhkzswert"  + F|tostring(U|xivar) + " 0")'  ?  U|xbvar
.assign U|xbvar = M|yskzs.U|xivar^ybaendzsinkb
.'F|expr("protection yskzsname"  + F|tostring(U|xivar) + " 0")' ? _U|xbvar
.'F|expr("protection yskzsart"   + F|tostring(U|xivar) + " 0")' ? _U|xbvar
.'F|expr("protection yskzswert"  + F|tostring(U|xivar) + " 0")' ? _U|xbvar
.'F|expr("protection -RESET yskzsname"  + F|tostring(U|xivar) + " 0")'  ?  U|xbvar
.'F|expr("protection -RESET yskzsart"   + F|tostring(U|xivar) + " 0")'  ?  U|xbvar
.'F|expr("protection -RESET yskzswert"  + F|tostring(U|xivar) + " 0")'  ?  U|xbvar
.formula U|xivar = U|xivar + 1
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC004: ----- Schreibschutz_Ausloese -----
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.copy M|ytbausloese = G|false                   ?  F|empty(M|yausloeseteil) & G|evtvar = "yausloeseteil"
.protection        ytbausloese 'M|aktzeile'     ?  F|empty(M|yausloeseteil)
.protection -RESET ytbausloese 'M|aktzeile'     ? _F|empty(M|yausloeseteil)
.select screen line
.continue LOOP003
!ELOP003: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- Zuschlaege_aus_KoKo -----
.continue EL013 ? _(_(F|empty(M|ytkoko)))
.formula M|ybezugsdatum = G|DATUM       ? F|empty(M|ybezugsdatum)
.formula U|ximonat      = F|month(M|ybezugsdatum)
.continue EL014 ? _(_(F|empty(M|ytkoko^ygkzseigen)))
.formula U|xtvar  = "ytkoko^ygkzseigen"
.formula U|xtwert = "ytgkzseigenwert"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
!EL014
.continue EL015 ? _(_(F|empty(M|ytkoko^ygkzsmatmontage)))
.formula U|xtvar  = "ytkoko^ygkzsmatmontage"
.formula U|xtwert = "ytgkzsmatmontwert"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
