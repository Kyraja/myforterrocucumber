.formula xprocst.xprocsp = "RET017" 
.continue PROC004
!RET017
.formula xprocsp = xprocsp - 1
.protection yprojgkkoko 0   ? _F|empty(M|yprojgkkoko) & _G|evtkommd = G|kaktname14
.colour -BACKGROUND 'U|xyfarbepflichtf' such        0
.colour -BACKGROUND 'U|xyfarbepflichtf' yverantwkst 0
!EL046
.formula M|yprojerlktname    = M|yprojerloeskto^namebspr    ? _F|empty(M|yprojerloeskto)
.assign  M|ysprojgkleistlist = M|yprojgkleistlistid         ? _F|empty(M|yprojgkleistlistid)
.assign  M|ysprojleistkat    = M|yprojleistkatid            ? _F|empty(M|yprojleistkatid)
!EL045
.continue
.continue ESAC002
!BRK002
.continue BRK003 ? _(G|EVTART = "maskpruef")
.continue EL047 ? _(G|evtkommd = G|kaktname10)
.continue EL048 ? _(M|ybfixiert)
.set CANCEL --
.load 1 group 'U|xydbgrlvkalkpos' 'F|expr("$,,ykblattid=" + M|id + ";@filingmode=(Active)")'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.load 1 line
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.continue EL049 ? _(_(F|empty(1|ytleistlistid)))
