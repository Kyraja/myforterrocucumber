.assign U|xeinh = 'M|yausloeseteil^epe(L="0")'
.assign U|xeinh = 'M|yausloeseteil^le(L="0")'   ? F|empty(U|xeinh)
.assign  M|yausloeseekeinh = 'U|xeinh(L="0")'
.formula M|yausloeseepr    = M|yausloeseteil^epr                                                 ? M|yausloeseekeinh =  M|yausloeseteil^epe
.formula M|yausloeseepr    = M|yausloeseteil^epr * M|yausloeseteil^epehe / M|yausloeseteil^elehe ? M|yausloeseekeinh <> M|yausloeseteil^epe
.formula U|xtprojleistkatid = ""
.formula U|xtprojleistkatid = M|yprojleistkatid
.load 9
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpaartikel)
