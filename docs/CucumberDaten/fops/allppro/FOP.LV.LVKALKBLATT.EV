.assign  M|yausloesevkeinh = 'U|xeinh(L="0")'
.formula M|yausloesevpr    = M|yausloeseteil^vpr                                                 ? M|yausloesevkeinh =  M|yausloeseteil^vpe
.formula M|yausloesevpr    = M|yausloeseteil^vpr * M|yausloeseteil^vpehe / M|yausloeseteil^vlehe ? M|yausloesevkeinh <> M|yausloeseteil^vpe
!FI068
.continue FI067
!EL067
