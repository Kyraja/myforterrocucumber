!EL019
.continue EL020 ? _(_(F|empty(M|ytkoko^ygkzsflfertigung)))
.formula U|xtvar  = "ytkoko^ygkzsflfertigung"
.formula U|xtwert = "ytgkzsflfertwert"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
