!PROC006: ----- Kalkulationsschema_laden -----
.continue EL023 ? _(_(F|empty(M|ykalkschema)))
.select add M|ykalkschema
.continue EL024 ? _(G|mehr)
.copy M|yprojgkkoko = H|yprojgkkoko
.file -TEMPNAME U|xtdatei
.input DATEI.F
.output NEW 'U|xtdatei'
.set TRANS +
'G|kommandochar'box Hinweis
FÅr folgende Arbeitspaketvorlagen wurde noch keine Arbeitspakete angelegt:

.set TRANS -
.make screen line --O
.select line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.make screen line +O
.copy    M|ytkoko       = H|ykoko
.assign  M|ytbgesamtsum = H|ybgesamtsum
.assign  M|ytbauswtab   = H|ytbauswtab
.protection ytgkzseigenwert    'M|aktzeile' ? F|empty(H|ykoko^ygkzseigen)        ; _H|ykoko^ygkzseigen^ybaendzsinkb
.protection ytgkzsmatmontwert  'M|aktzeile' ? F|empty(H|ykoko^ygkzsmatmontage)   ; _H|ykoko^ygkzsmatmontage^ybaendzsinkb
.protection ytgkzsfremdwert    'M|aktzeile' ? F|empty(H|ykoko^ygkzsfremd)        ; _H|ykoko^ygkzsfremd^ybaendzsinkb
.protection ytgkzssonstwert    'M|aktzeile' ? F|empty(H|ykoko^ygkzssonst)        ; _H|ykoko^ygkzssonst^ybaendzsinkb
.protection ytgkzssonstnohkwer 'M|aktzeile' ? F|empty(H|ykoko^ygkzssonstnohk)    ; _H|ykoko^ygkzssonstnohk^ybaendzsinkb
.protection ytgkzsmatfertwert  'M|aktzeile' ? F|empty(H|ykoko^ygkzsmatfertigung) ; _H|ykoko^ygkzsmatfertigung^ybaendzsinkb
.protection ytgkzsflfertwert   'M|aktzeile' ? F|empty(H|ykoko^ygkzsflfertigung)  ; _H|ykoko^ygkzsflfertigung^ybaendzsinkb
.protection ytgkzsfertwert     'M|aktzeile' ? F|empty(H|ykoko^ygkzsfert)         ; _H|ykoko^ygkzsfert^ybaendzsinkb
.protection ytgkzsfertlohnwert 'M|aktzeile' ? F|empty(H|ykoko^ygkzsfertlohn)     ; _H|ykoko^ygkzsfertlohn^ybaendzsinkb
.continue EL025 ? _(_(F|empty(H|ykoko^yvertschl)))
.load 0 add H|ykoko^yvertschl
.continue EL026 ? _(G|mehr)
.load 0 line
!EL026
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL027 ? _(_(F|empty(0|ytapvorlage)))
.load 1 group 'U|xydbgrarbpaket' 'F|expr("$,,;yausapvorlage==" + 0|ytapvorlage^id + ";yprojekt==" + M|yprojekt^id)'
.continue EL028 ? _(_(G|mehr))
.formula U|xizaehler = U|xizaehler + 1
.output ADDEDTO 'U|xtdatei'
.set TRANS +
VerteilerschlÅssel: '0|nummer' / '0|such', Zeile '0|aktzeile', Arbeitspaketvorlage '0|ytapvorlage'
.set TRANS -
!EL028
!EL027
.load 0 line
.continue LOOP005
!ELOP005: ==============================
!EL025
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET012" 
.continue PROC005
!RET012
.formula xprocsp = xprocsp - 1
.select line
.continue LOOP004
!ELOP004: ==============================
.continue EL029 ? _(U|xizaehler > 0)
.output ADDEDTO 'U|xtdatei'
'G|kommandochar''G|kommandochar'
.input 'U|xtdatei'
!EL029
!EL024
!EL023
.continue 'xprocst.xprocsp'
!PROC007: ----- Einheit_pruefen -----
.copy U|xbok = G|true
.continue EL030 ? _(_(F|empty(M|yausloeseteil)))
.add M|yausloeseteil
.continue BRK001 ? _(D|gruppe = 4)
.continue EL031 ? _((M|.evtvar <> D|le) & (M|.evtvar <> D|vhe) & (M|.evtvar <> D|ehe) & (M|.evtvar <> D|vpe) & (M|.evtvar <> D|epe))
.set TRANS +
.box
Einheit ist nicht im Artikel definiert!
.set TRANS -
.error
.end 1
!EL031
.continue ESAC001
!BRK001
.continue EL032 ? _((M|.evtvar <> D|le) & (M|.evtvar <> D|vhe) & (M|.evtvar <> D|ehe) & (M|.evtvar <> D|vpe) & (M|.evtvar <> D|epe) & (M|.evtvar <> D|ve) & (M|.evtvar <> D|ge))
.set TRANS +
.box
Einheit ist nicht im Artikel definiert!
.set TRANS -
.error
.end 1
!EL032
!ESAC001: =====   ENDCASE   =====
!EL030
.assign U|xeinh = 'M|.evtvar(L="0")'
.continue EL033 ? _((_(G|mehr)) ; (F|empty(U|xeinh)))
.set TRANS +
.box
Es sind nur in Stunden umrechenbare Einheiten erlaubt.
.set TRANS -
.error
.end 1
!EL033
.continue 'xprocst.xprocsp'
!PROC008: ----- Rechtepruefung -----
.continue EL034 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = M|yverantwkst^id
.input 'U|xypmrepruefkstprog'
.continue EL035 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr diese Kostenstelle.
.set TRANS -
.continue EL036 ? _(G|evtart = "maskein")
.error
.end 1
.continue FI036
!EL036
.copy M|yverantwkst = F|oldvalue(M|yverantwkst)
!FI036
!EL035
!EL034
.continue EL037 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL038 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr diese Kostenstelle.
.set TRANS -
.continue EL039 ? _(G|evtart = "maskein")
.error
.end 1
.continue FI039
!EL039
.copy M|yverantwkst = F|oldvalue(M|yverantwkst)
!FI039
!EL038
!EL037
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK002 ? _(G|EVTART = "maskein")
.continue EL040 ? _(_(F|empty(M|yverantwkst)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET013" 
.continue PROC008
!RET013
.formula xprocsp = xprocsp - 1
!EL040
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue EL041 ? _((G|evtkommd = G|kaktname13) & (M|ysperre))
.input "allpstart/CHECK.RECORD.LOCK"
!EL041
.continue EL042 ? _((G|evtkommd = G|kaktname13) & (M|ybfixiert))
.set TRANS +
.box Hinweis
Diese Kalkulation darf nicht mehr geÑndert werden.
.set TRANS -
.error
.end 1         ? _G|wartung
!EL042
.continue EL043 ? _(G|evtkommd = G|kaktname14)
.copy    M|ybfixiert          = G|false
.formula M|yprojgkleistlistid = ""
.assign  M|yprojekt           = ""
.copy    M|ysperre     = G|false
.formula M|ysperrzeich = ""
.formula M|ysperrzp    = ""
.continue EL044 ? _(F|empty(M|such))
.formula M|ybezugsdatum   = G|DATUM
.copy    M|ykalkschema    = 5|ylvkalkschema
.copy    M|yllvorbelvkman = 5|ylvvorbelvkman
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET014" 
.continue PROC006
!RET014
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET015" 
.continue PROC002
!RET015
.formula xprocsp = xprocsp - 1
!EL044
!EL043
.continue EL045 ? _(_(G|evtkommd = G|kaktname10))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET016" 
