.copy   U|xbok          = G|false
!EL064
!EL063
.assign U|xeinh = 'M|yausloeseteil^le(L="0")'
.continue EL065 ? _(U|xbok)
.continue EL066 ? _((_(G|mehr)) ; (F|empty(U|xeinh)))
.set TRANS +
