..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtcmd xtsel xykoobjekt xtindex xtid xtstack xttitel
.type integer xivar
.type GD19    xdvon xdbis
.type GD      xddat
.type bool    xyberlaubt xbmehr
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Stundenzettel_laden -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'F|month(M|ystdvondatum)' ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|ystdvondatum)'  ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";yprojekt=="  +  H|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(Yes);@order=ypersonal"
.load 0 group 'U|xydbgrstundenzettel' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.load 0 line '0|selzeile'
.make screen line +O
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
.copy    M|ytpersonal      = 0|ypersonal
.formula M|ytpersname      = 0|ypersonal^namebspr
.assign  M|ytprojekt       = H|id
.formula M|ytprojname      = H|namebspr
.formula M|ythinweis1      = 0|ythinweis1
.formula M|ythinweis2      = 0|ythinweis2
.copy    M|ytbfreigabe     = 0|ybfreigabe
.copy    M|ytberfabschluss = 0|yberfabschluss
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yadatum=" + M|ystdvondatum:8 + "!" + M|ystdbisdatum:8
.formula U|xtsel = U|xtsel + ";ypersonal==" + 0|ypersonal^id
.formula U|xtsel = U|xtsel + ";yprojekt==" + H|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula M|ytarbzeit  = M|ytarbzeit  + 1|yarbzeit
.formula M|ytfaktzeit = M|ytfaktzeit + 1|yfaktzeit
.load 1 continue
.continue LOOP002
!ELOP002: ==============================
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Aenderungen_speichern -----
.set trans +
.formula U|xttitel = "Achtung"
.box -BUTTON yes:no -title 'U|xttitel'
énderungen Åbernehmen?
.set trans -
.continue EL001 ? _(G|box = G|boxyes)
.input "is/ABASFARBEN.DEF"
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'F|month(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|ystdvondatum)'
.formula U|xtsel = U|xtsel + ";ypersonal==" +  M|ytpersonal^id
.formula U|xtsel = U|xtsel + ";yprojekt=="  +  M|ytprojekt^id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(Yes);@order=ypersonal"
.load 0 group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL002 ? _(G|mehr)
.load 0 line '0|selzeile'
.continue EL003 ? _(0|ybfreigabe <> M|ytbfreigabe)
.select lock add 0|id
.continue EL004 ? _(G|mehr)
.select lock line '0|zid'
.assign H|ybfreigabe = M|ytbfreigabe
.rewrite
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
.continue FI004
!EL004
.set TRANS +
.box Hinweis
Der Stundenzettel fÅr die Zeile 'M|aktzeile' konnte nicht bearbeitet werden.
.set TRANS -
.assign M|ytbfreigabe = _M|ytbfreigabe
.error
.end 1
!FI004
!EL003
.continue FI002
!EL002
.set TRANS +
.box Hinweis
Der Stundenzettel fÅr die Zeile 'M|aktzeile' konnte nicht bearbeitet werden.
.set TRANS -
.assign M|ytbfreigabe = _M|ytbfreigabe
.error
.end 1
!FI002
.select screen line
.continue LOOP003
!ELOP003: ==============================
.continue FI001
!EL001
.error
.end 1
!FI001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL005 ? _(U|xyprjmkonfig^yartstdfreigabek <> "PROJ")
.set TRANS +
.box Hinweis
Das Infosystem zur Freigabe von projektbezogenen Stunden kann nur gestartet werden,
wenn in der Projektkonfiguration als "Art der Stundenfreigabe" "projektbezogen" gewÑhlt wurde.
.set TRANS -
.error
.end 1
!EL005
.input 'U|xtupprjmsel'
.formula M|ystdvondatum = 'G|datum:8'<<6 + "01"
.formula M|ystdvondatum =  M|ystdvondatum - 1
.formula M|ystdvondatum = 'M|ystdvondatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdvondatum + 31
.formula M|ystdbisdatum = 'M|ystdbisdatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdbisdatum - 1
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "feldaus")
.continue BRK004 ? _(G|evtvar = "ystdvondatum")
.continue EL006 ? _(F|empty(M|ystdvondatum))
.assign M|ystdbisdatum = ""
.continue FI006
!EL006
.formula M|ystdvondatum = 'M|ystdvondatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdvondatum + 31
.formula M|ystdbisdatum = 'M|ystdbisdatum:8'<<6 + "01"
.formula M|ystdbisdatum =  M|ystdbisdatum - 1
!FI006
.continue ESAC002
!BRK004
.input 'U|xtupprjmsel'
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "buttonvor")
.continue BRK006 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK005
.continue BRK007 ? _(G|evtart = "buttonnach")
.continue BRK008 ? _(G|evtvar = "bstart")
.continue EL007 ? _(F|empty(M|yprojekt))
.input 'U|xtupkstarray'
.formula U|xtindex = ""
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
!LOOP004: ==============================
.continue ELOP004 ? _(_(F|empty(U|xtindex)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yverantwkst=="  + U|xtkst.xtindex        ? _F|empty(U|xtkst.xtindex)
.formula U|xtsel = U|xtsel + ";yverantwkst==`" + U|xtkst.xtindex        ?  F|empty(U|xtkst.xtindex)
.formula U|xtsel = U|xtsel + ";yprojleit=="    + M|yprojleit^id         ? _F|empty(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojverantw==" + M|yprojverantw^id      ? _F|empty(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekttyp=="  + M|yprojekttyp^id       ? _F|empty(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";ykunde=="       + M|ykunde^id            ? _F|empty(M|ykunde)
.formula U|xtsel = U|xtsel + ";ykunde2=="      + M|ykunde2^id           ? _F|empty(M|ykunde2)
.formula U|xtsel = U|xtsel + ";ystatus=="      + M|yprojstatus^id       ? _F|empty(M|yprojstatus)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrprojekt' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP005
!ELOP005: ==============================
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
.continue LOOP004
!ELOP004: ==============================
.continue FI007
!EL007
.select add M|yprojekt
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue EL008 ? _(M|ybteilprojekte)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yteilprojektzu=="        + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrprojekt' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP006
!ELOP006: ==============================
!EL008
!FI007
.continue ESAC004
!BRK008
.continue BRK009 ? _(G|evtvar = "ybuspeichern")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK009
.continue BRK010 ? _(G|evtvar = "ybumarkalle")
.select screen header
.select screen line
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.continue EL009 ? _(_(F|protected(M|ytbfreigabe,M|aktzeile)))
.assign M|ytbfreigabe = G|TRUE
!EL009
.select screen line
.continue LOOP007
!ELOP007: ==============================
.continue ESAC004
!BRK010
.continue BRK011 ? _(G|evtvar = "ybumarkkeine")
.select screen header
.select screen line
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.continue EL010 ? _(_(F|protected(M|ytbfreigabe,M|aktzeile)))
.assign M|ytbfreigabe = G|FALSE
!EL010
.select screen line
.continue LOOP008
!ELOP008: ==============================
.continue ESAC004
!BRK011
.continue BRK012 ? _(G|evtvar = "ybudetail")
.formula U|xtcmd = G|kkomname38 + " PRJMLM "
.formula U|xtcmd = U|xtcmd +"? ystdvondatum= " + 'M|ystdvondatum'
.formula U|xtcmd = U|xtcmd +"|ystdbisdatum="   + 'M|ystdbisdatum'
.formula U|xtcmd = U|xtcmd +"|yprojekt="       +  M|ytprojekt^id
.formula U|xtcmd = U|xtcmd +"|ypersonal="      +  M|ytpersonal^id
.formula U|xtcmd = U|xtcmd +"|bstart="
.comman -PARALLEL 'U|xtcmd'
.continue ESAC004
!BRK012
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMSTDFREIGABEPL.EV")'  ? F|fileexists(F|foppath("IFOP.IS.PRJMSTDFREIGABEPL.EV"))
.continue
