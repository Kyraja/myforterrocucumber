..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allppro/LV.KONFIG.INI"
.input "allpstart/LART.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtwertkat
.type real    xrprsumwert xrprsummge
.type GJ      xgj
.type integer ximonat
.type AZS28009 xwertkat
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL001 ? _(G|evtkommd = G|kaktname10)
.formula U|xtsel = "$,,yvertschl==" + M|id + ";@ablageart=(1)"
.load 0 group 'U|xydbgrkokomponente' 'U|xtsel'
.continue EL002 ? _(G|mehr)
.set trans +
.box Hinweis
Der VerteilerschlÅssel 'M|such' darf nicht gelîscht werden,
da er noch in Kostenkomponenten verwendet wird.
.set trans -
.error
.end 1
!EL002
.continue FI001
!EL001
.formula M|ysrestprozmge  = 0
.formula M|ysrestprozwert = 0
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|ysrestprozwert = M|ysrestprozwert + M|ytproz
.formula M|ysrestprozmge  = M|ysrestprozmge  + M|ytprozmge
.continue EL003 ? _(_(F|empty(M|ytteil)))
.continue EL004 ? _(M|ytteil^gruppe = 4)
.continue EL005 ? _('M|ytteil^zptyp(L="0")' <> "(7)")
.protection yteinh         'M|aktzeile'
!EL005
!EL004
!EL003
.select screen line
.continue LOOP001
!ELOP001: ==============================
!FI001
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL006 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.input allpstart/FOP.PRJM.UP.LOADCONFIG ? _F|defined(5|yktoeigenleist)
.formula U|xrprsumwert = 0
.formula U|xrprsummge  = 0
.formula U|xtwertkat   = ""
.assign  U|xwertkat    = ""
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL007 ? _(_(F|empty(M|ytekkonto)))
.assign  U|xwertkat    = ""
.load 0 group "68:1" 'F|expr("$,,konto==" + M|ytekkonto^id + ";@filingmode=(Active)")'
!LOOP003: ==============================
.continue ELOP003 ? _((G|mehr) & (F|empty(U|xwertkat)))
.continue EL008 ? _((0|id = 5|yktoeigenleist^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(EL)"
!EL008
.continue EL009 ? _((0|id = 5|yktomatmontage^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(AM)"
!EL009
.continue EL010 ? _((0|id = 5|yktofremdleist^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(FL)"
!EL010
.continue EL011 ? _((0|id = 5|yktosonstkost^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(SOKO)"
!EL011
.continue EL012 ? _((0|id = 5|yktosonstnohk^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(NOHK)"
!EL012
.continue EL013 ? _((0|id = 5|yktomatfert^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(PM)"
!EL013
.continue EL014 ? _((0|id = 5|yktoflfert^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(EPA)"
!EL014
.continue EL015 ? _((0|id = 5|yktofertleist^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(FERT)"
!EL015
.continue EL016 ? _((0|id = 5|yktofertlohn^id) & (F|empty(U|xwertkat)))
.assign U|xwertkat = "(DL)"
!EL016
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
!EL007
.continue EL017 ? _(F|empty(U|xwertkat))
.set trans +
.box Fehler
Fehler in Zeile 'M|aktzeile':
Im Konto 'M|ytekkonto' ist keine Kostengruppe eingetragen.
.set trans -
.cursor ytekkonto 'M|aktzeile'
.error
.end 1
!EL017
.formula U|xrprsumwert = U|xrprsumwert + M|ytproz
.formula U|xrprsummge  = U|xrprsummge  + M|ytprozmge
.continue EL018 ? _((U|xwertkat = "(EL)") & (F|sysinfo(10)^ykonfigprjm^ypmermeigwertk = "ISMWS") & (F|empty(M|ytleiart)))
.set trans +
.box Fehler
Fehler in Zeile 'M|aktzeile':
Bei Eigenleistungen muss eine Leistungsart eingetragen sein.
.set trans -
.cursor ytleiart 'M|aktzeile'
.error
.end 1
!EL018
.continue EL019 ? _((M|ybvertuebmge) & (M|yteinh <> M|yeinheinh))
.set trans +
.box Fehler
Fehler in Zeile 'M|aktzeile':
Bei Verteilung Åber Menge muss die Einheit in allen Zeilen der gewÑhlten Verteilungseinheit entsprechen.
.set trans -
.cursor yteinh 'M|aktzeile'
.error
.end 1
!EL019
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue EL020 ? _(U|xrprsumwert <> 100)
.set trans +
.box Fehler
Die Prozentwerte fÅr Verteilung nach Wert mÅssen in Summe 100% ergeben.
.set trans -
.error
.end 1
!EL020
.continue EL021 ? _((M|ybvertuebmge) & (U|xrprsummge  <> 100))
.set trans +
.box Fehler
Die Prozentwerte fÅr Verteilung nach Menge mÅssen in Summe 100% ergeben.
.set trans -
.error
.end 1
!EL021
.continue EL022 ? _((M|ybvertuebmge) & (F|empty(M|yeinheinh)))
.set trans +
.box Fehler
Bei Verteilung Åber Menge muss die Einheit gefÅllt sein.
.set trans -
.cursor yeinheinh 0
.error
.end 1
!EL022
!EL006
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "feldaus")
.continue BRK004 ? _(G|evtvar = "ybvertuebmge")
.assign M|ybvertuebmge = G|FALSE        ? F|empty(M|yeinheinh)
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "yeinheinh")
.assign M|ybvertuebmge = G|FALSE        ? F|empty(M|yeinheinh)
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "ytteil")
.continue EL023 ? _(F|empty(M|ytteil))
.assign  M|yteinh = ""
.continue FI023
!EL023
.add M|ytteil
.continue EL024 ? _(D|gruppe = 4)
.continue EL025 ? _(('D|zptyp(L="0")' <> "(7)") & ('D|zptyp(L="0")' <> "(12)") & ('D|zptyp(L="0")' <> "(26)"))
.set trans +
.box
Es sind nur Zusatzpositionen vom Typ "AU/BE-Position,BV", "neutrale Position" und "Text" zugelassen.
.set trans -
.error
.end 1
!EL025
!EL024
.continue EL026 ? _(D|gruppe = 4)
.continue EL027 ? _('D|zptyp(L="0")' <> "(7)")
.assign  M|yteinh = ""
.protection yteinh 'M|aktzeile'
.continue FI027
!EL027
.protection -RESET yteinh 'M|aktzeile'
.assign  M|yteinh = D|le
!FI027
.continue FI026
!EL026
.protection -RESET yteinh 'M|aktzeile'
.assign  M|yteinh = D|le
!FI026
.continue EL028 ? _((_(F|empty(M|ytteil))) & (_(F|empty(M|ytleiart))))
.continue EL029 ? _((_(F|isvalue('D|le(L="0")', "TAZ7"))) & (_(F|isvalue('D|vhe(L="0")', "TAZ7"))) & (_(F|isvalue('D|vpe(L="0")', "TAZ7"))))
.assign M|ytleiart = ""
!EL029
!EL028
.continue BRK007 ? _(D|gruppe = 1)
.continue EL030 ? _(F|sysinfo(18)^bew)
.assign M|ytvkkonto = F|sysinfo(7)^pgruppe^pgerlo^id    ?  F|empty(D|erlgrp)
.assign M|ytvkkonto = D|erlgrp^pgerlo^id                ? _F|empty(D|erlgrp)
.continue FI030
!EL030
.assign M|ytvkkonto = F|sysinfo(7)^erlo^id      ?  F|empty(D|vkonto)
.assign M|ytvkkonto = D|vkonto^id               ? _F|empty(D|vkonto)
!FI030
.continue ESAC003
!BRK007
.continue BRK008 ? _(D|gruppe = 2)
.assign M|ytvkkonto = F|sysinfo(7)^erlo^id
.continue ESAC003
!BRK008
.assign M|ytvkkonto = F|sysinfo(7)^erlo^id      ?  F|empty(D|vkonto)
.assign M|ytvkkonto = D|vkonto^id               ? _F|empty(D|vkonto)
!ESAC003: =====   ENDCASE   =====
.continue BRK009 ? _(D|gruppe = 1)
.continue EL031 ? _(F|sysinfo(18)^bew)
.assign M|ytekkonto = F|sysinfo(7)^wgruppe^bvktr^id     ?  F|empty(D|aufgrp)
.assign M|ytekkonto = D|aufgrp^bvktr^id                 ? _F|empty(D|aufgrp) & _F|empty(D|aufgrp^bvktr^id)
.assign M|ytekkonto = F|sysinfo(7)^aufw^id              ? _F|empty(D|aufgrp) &  F|empty(D|aufgrp^bvktr^id)
.continue FI031
!EL031
.assign M|ytekkonto = F|sysinfo(7)^aufw^id      ?  F|empty(D|ekonto)
.assign M|ytekkonto = D|ekonto^id               ? _F|empty(D|ekonto)
!FI031
.continue ESAC004
!BRK009
.continue BRK010 ? _(D|gruppe = 2)
.assign M|ytekkonto = F|sysinfo(7)^aufw^id
.continue ESAC004
!BRK010
.assign M|ytekkonto = F|sysinfo(7)^aufw^id      ?  F|empty(D|ekonto)
.assign M|ytekkonto = D|ekonto^id               ? _F|empty(D|ekonto)
!ESAC004: =====   ENDCASE   =====
!FI023
.continue ESAC002
!BRK006
.continue BRK011 ? _(G|evtvar = "ytleiart")
.continue EL032 ? _((_(F|empty(M|ytteil))) & (_(F|empty(M|ytleiart))))
.continue EL033 ? _((_(F|isvalue('M|ytteil^le(L="0")', "TAZ7"))) & (_(F|isvalue('M|ytteil^vhe(L="0")', "TAZ7"))) & (_(F|isvalue('M|ytteil^vpe(L="0")', "TAZ7"))))
.set trans +
.box Fehler
Die Einheit des Artikel 'F|trim(F|tostring(M|ytteil))' passt nicht zur Einheit der Leistungsart.
.set trans -
.assign M|ytleiart = F|oldvalue(M|ytleiart)
!EL033
!EL032
.copy   M|ytekkonto = M|ytleiart^ykoartf
.continue ESAC002
!BRK011
.continue BRK012 ? _(G|evtvar = "ytproz")
.formula M|ysrestprozwert = 0
.select screen header
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula M|ysrestprozwert = M|ysrestprozwert + M|ytproz
.select screen line
.continue LOOP004
!ELOP004: ==============================
.continue ESAC002
!BRK012
.continue BRK013 ? _(G|evtvar = "ytprozmge")
.formula M|ysrestprozmge  = 0
.select screen header
.select screen line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula M|ysrestprozmge  = M|ysrestprozmge  + M|ytprozmge
.select screen line
.continue LOOP005
!ELOP005: ==============================
.continue ESAC002
!BRK013
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK003
!ESAC001: =====   ENDCASE   =====
.continue
