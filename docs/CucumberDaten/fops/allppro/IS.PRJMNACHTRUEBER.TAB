.. at 2016-12-23, 13:04
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMNACHTRUEBER.TAB
..==  Pfad              : allppro
..==  Funktion          : Das Infosystem "NachtragsÅbersicht" (PRJMNACHTRUEBER) dient der Auswertung der
..==                      laufenden und akzeptierten Nachtragsanfragen und Nachtragsforderungen.
..==  Erstellungsdatum  : 28.02.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
..====================================================
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.copy    U|xbmehr        = G|false
.formula U|xtnachtrtyp   = ""
.formula U|xranfeigstd   = 0
.formula U|xranfgeswert  = 0
.formula U|xranferwwert  = 0
.formula U|xrakzeigstd   = 0
.formula U|xrakzgeswert  = 0
.formula U|xrabgerechnet = 0
.formula U|xrkuerzakz    = 0
.formula U|xrkuerzabl    = 0
.formula U|xrkuerzges    = 0
.formula U|xrpanfeigstd   = 0
.formula U|xrpanfgeswert  = 0
.formula U|xrpanferwwert  = 0
.formula U|xrpakzeigstd   = 0
.formula U|xrpakzgeswert  = 0
.formula U|xrpabgerechnet = 0
.formula U|xrpkuerzakz    = 0
.formula U|xrpkuerzabl    = 0
.formula U|xrpkuerzges    = 0
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ybezugsdatum=="   + M|ystichtag:8
.formula U|xtsel = U|xtsel + ";ywochenbezogen==" +'M|ybwochenbezogen(L="0")'
.continue EL001 ? _((F|empty(M|ypvorgang)) & (F|empty(M|ykalkpos)))
.formula U|xtsel = U|xtsel + ";yprojekt=="     +  H|id
.continue FI001
!EL001
.formula U|xtsel = U|xtsel + ";yprojekt=="   + M|yprojekt^id    ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";ypvurspr=="   + M|ypvorgang^id   ? _F|empty(M|ypvorgang)
.formula U|xtsel = U|xtsel + ";ykalkposid==" + M|ykalkpos^id    ? _F|empty(M|ykalkpos)
!FI001
.formula U|xtsel = U|xtsel + ";ybnachtrfordzeile==0"
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@ordnung=ynachtrtyp^katego,ynachtrnr"
.load 9 group 'U|xydbgrnachtrstatistik' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy    U|xbmehr      = G|true
.formula U|xtnachtrtyp = 9|ynachtrtypk  ? F|empty(U|xtnachtrtyp)
.continue EL002 ? _(U|xtnachtrtyp <> 9|ynachtrtypk)
.make screen line +O
.copy    M|ytprojekt      = 9|yprojekt
.assign  M|ytnachtrtypk   = U|xtnachtrtyp
.formula M|ytnachtrname   = U|xtsumme + " " + M|ytnachtrtyp
.formula M|ytanfeigstd    = U|xranfeigstd
.formula M|ytanfgeswert   = U|xranfgeswert
.formula M|ytakzeigstd    = U|xrakzeigstd
.formula M|ytakzgeswert   = U|xrakzgeswert
.formula M|ytabgerechnet  = U|xrabgerechnet
.formula M|ytanferwwert   = U|xranferwwert
.formula M|ytkuerzakz     = U|xrkuerzakz
.formula M|ytkuerzabl     = U|xrkuerzabl
.formula M|ytkuerzges     = U|xrkuerzges
.protection ytfortschrgrad 'M|aktzeile'
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
.formula U|xranfeigstd   = 0
.formula U|xranfgeswert  = 0
.formula U|xrakzeigstd   = 0
.formula U|xrakzgeswert  = 0
.formula U|xrabgerechnet = 0
.formula U|xranferwwert  = 0
.formula U|xrkuerzakz    = 0
.formula U|xrkuerzabl    = 0
.formula U|xrkuerzges    = 0
!EL002
.make screen line +O
.copy    M|ytprojekt      = 9|yprojekt
.assign  M|ytnachtr       = 9|yorigobjid
.copy    M|ytnachtrtypk   = 9|ynachtrtypk
.formula M|ytnachtrnr     = 9|ynachtrnr
.formula M|ytnachtrname   = 9|namebspr
.formula M|ytort          = 9|yort
.formula M|ytlzraumvon    = M|ytnachtr^ylzraumvon
.formula M|ytlzraumbis    = M|ytnachtr^ylzraumbis
.formula M|ytanfeigstd    = 9|yanfeigstd
.formula M|ytanfgeswert   = 9|yanfgeswert
.formula M|yterfass       = 9|yerfass
.formula M|ytuebergabedat = 9|yuebergabedat
.formula M|yterfwahrsch   = 9|yerfwahrsch
.copy    M|ytakpzeptanzk  = 9|yakzeptanzk
.formula M|ytantwortdat   = 9|yantwortdat
.formula M|ytauftrnrkunde = M|ytnachtr^yauftrnrkunde
.formula M|ytakzeigstd    = 9|yakzeigstd
.formula M|ytakzgeswert   = 9|yakzgeswert
.formula M|ytabgerechnet  = 9|yabgerechnet
.formula M|ytletztrechdat = 9|yletztrechdat
.formula M|ytrechnr       = 9|yrechnr
.formula M|ytanferwwert   = 9|yanferwwert                       ?  F|empty(9|yakzeptanz)
.formula M|ytkuerzakz     = 9|yakzgeswert - 9|yanfgeswert       ?  9|yakzeptanzk = "1"
.formula M|ytkuerzabl     = 9|yanfgeswert * (-1)                ?  9|yakzeptanzk = "0"
.formula M|ytkuerzges     = M|ytkuerzakz + M|ytkuerzabl
.formula M|ytfortschrgrad = 9|yfortschrittsgrad
.formula M|ytfortschrgrad = M|ytnachtr^yfortschrgrad            ?  9|yfortschrittsgrad = 0
.formula M|ytfortschrwert = M|ytakzgeswert * M|ytfortschrgrad / 100     ?  9|yakzeptanzk = "1"
.formula M|ytfortschrwert = M|ytanferwwert * M|ytfortschrgrad / 100     ? _9|yakzeptanzk = "1"
.formula M|ytbem1         = 9|ybem1
.formula M|ytbem2         = 9|ybem2
.formula U|xtnachtrtyp    = 9|ynachtrtypk
.formula U|xranfeigstd    = U|xranfeigstd    + 9|yanfeigstd
.formula U|xranfgeswert   = U|xranfgeswert   + 9|yanfgeswert
.formula U|xranferwwert   = U|xranferwwert   + M|ytanferwwert
.formula U|xrakzeigstd    = U|xrakzeigstd    + 9|yakzeigstd
.formula U|xrakzgeswert   = U|xrakzgeswert   + 9|yakzgeswert
.formula U|xrabgerechnet  = U|xrabgerechnet  + 9|yabgerechnet
.formula U|xrkuerzakz     = U|xrkuerzakz     + M|ytkuerzakz
.formula U|xrkuerzabl     = U|xrkuerzabl     + M|ytkuerzabl
.formula U|xrkuerzges     = U|xrkuerzges     + M|ytkuerzges
.formula U|xrpanfeigstd   = U|xrpanfeigstd   + 9|yanfeigstd
.formula U|xrpanfgeswert  = U|xrpanfgeswert  + 9|yanfgeswert
.formula U|xrpanferwwert  = U|xrpanferwwert  + M|ytanferwwert
.formula U|xrpakzeigstd   = U|xrpakzeigstd   + 9|yakzeigstd
.formula U|xrpakzgeswert  = U|xrpakzgeswert  + 9|yakzgeswert
.formula U|xrpabgerechnet = U|xrpabgerechnet + 9|yabgerechnet
.formula U|xrpkuerzakz    = U|xrpkuerzakz    + M|ytkuerzakz
.formula U|xrpkuerzabl    = U|xrpkuerzabl    + M|ytkuerzabl
.formula U|xrpkuerzges    = U|xrpkuerzges    + M|ytkuerzges
.formula U|xrganfeigstd   = U|xrganfeigstd   + 9|yanfeigstd
.formula U|xrganfgeswert  = U|xrganfgeswert  + 9|yanfgeswert
.formula U|xrganferwwert  = U|xrganferwwert  + M|ytanferwwert
.formula U|xrgakzeigstd   = U|xrgakzeigstd   + 9|yakzeigstd
.formula U|xrgakzgeswert  = U|xrgakzgeswert  + 9|yakzgeswert
.formula U|xrgabgerechnet = U|xrgabgerechnet + 9|yabgerechnet
.formula U|xrgkuerzakz    = U|xrgkuerzakz    + M|ytkuerzakz
.formula U|xrgkuerzabl    = U|xrgkuerzabl    + M|ytkuerzabl
.formula U|xrgkuerzges    = U|xrgkuerzges    + M|ytkuerzges
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
.load 9 continue
.continue LOOP001
!ELOP001: ==============================
.continue EL003 ? _(U|xbmehr)
.make screen line +O
.assign  M|ytprojekt      = H|id            ? F|defined(H|id)
.assign  M|ytnachtrtypk   = U|xtnachtrtyp
.formula M|ytnachtrname   = U|xtsumme + " " + M|ytnachtrtyp
.formula M|ytanfeigstd    = U|xranfeigstd
.formula M|ytanfgeswert   = U|xranfgeswert
.formula M|ytanferwwert   = U|xranferwwert
.formula M|ytakzeigstd    = U|xrakzeigstd
.formula M|ytakzgeswert   = U|xrakzgeswert
.formula M|ytabgerechnet  = U|xrabgerechnet
.formula M|ytkuerzakz     = U|xrkuerzakz
.formula M|ytkuerzabl     = U|xrkuerzabl
.formula M|ytkuerzges     = U|xrkuerzges
.protection ytfortschrgrad 'M|aktzeile'
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
.make screen line +O
.assign  M|ytprojekt      = H|id            ? F|defined(H|id)
.formula M|ytnachtrname   = U|xtsumme + " " + M|ytprojekt
.formula M|ytanfeigstd    = U|xrpanfeigstd
.formula M|ytanfgeswert   = U|xrpanfgeswert
.formula M|ytanferwwert   = U|xrpanferwwert
.formula M|ytakzeigstd    = U|xrpakzeigstd
.formula M|ytakzgeswert   = U|xrpakzgeswert
.formula M|ytabgerechnet  = U|xrpabgerechnet
.formula M|ytkuerzakz     = U|xrpkuerzakz
.formula M|ytkuerzabl     = U|xrpkuerzabl
.formula M|ytkuerzges     = U|xrpkuerzges
.protection ytfortschrgrad 'M|aktzeile'
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
!EL003
.input 'F|foppath("IFOP.IS.PRJMNACHTRUEBER.TAB")'   ? F|fileexists(F|foppath("IFOP.IS.PRJMNACHTRUEBER.TAB"))
.continue
