.input "allpstart/PRJM.KONFIG.INI"
.input "allppro/LV.KONFIG.INI"
.input "allpstart/LART.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xttemp xtkalkpos xtkoko xtextid xtid xtaltid xtindex xtkunde
.type text    xtvar xtvorgang xtvorpos xtprojsuch xtarbpaket xteinh xtedpdat xtedpout xtedperr xtedpmsg xtoberposid xtoberkalkposid
.type text    xytaufrufernr xytzeitstempel xtsperrstempel xtsummekoko
.type integer xizeile xievtzeile xiaktzeile xineuzeile xistufe ximerkstufe xivar xispalte xi1 xitvar xitp xikvar ximenue ximonat
.type real    xreigwert xrfremdwert xrsonstwert xrfertwert xrvar xrzvksatz xrstunden xrllekwert
.type R7.3    xrmgeneu xrmgealt
.type realx   xxurmge xxproz xxmgefaktor
.type R9.3    xrllmge
.type GJ      xgjahr
.type bool    xbok xbmehr xbvar xbfremdleist xbllneu xbzakt xbignid xbausloese xbnurkalk xbistblatt
.type TAZ7    xeinh xstunden
.type symtab  xstzeilen
.type ARTR52000 xrwert xrpreis
.type P94:1   xpland
.type text    xykoobjekt
.type bool    xyberlaubt
.type integer xyred xygreen xyblue xyhue
.type realx   xysat xyval
.type bool    xybrgb2hsv xybhsv2rgb
.type bool    xbparam   ? _F|defined(U|xbparam)
.type bool    xbnosave  ? _F|defined(U|xbnosave)
.type bool    xbladetab ? _F|defined(U|xbladetab)
.type bool    xbnoifop  ? _F|defined(U|xbnoifop)
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Sperre_entfernen -----
.continue EL001 ? _((M|ysperre) & (_(F|empty(M|ykalkblatt))))
.continue EL002 ? _(M|ykalkblatt^ysperre)
.select lock add M|ykalkblatt
.continue EL003 ? _(G|mehr)
.assign H|ysperre = G|FALSE
.rewrite
.continue FI003
!EL003
.set TRANS +
.box Hinweis
Das Kalkulationsblatt 'M|ykalkblatt^nummer'/'M|ykalkblatt^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI003
!EL002
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Rechtepruefung -----
.continue EL004 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = M|ykalkblatt^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.continue EL005 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr diese Kostenstelle.
.set TRANS -
.assign M|ykalkblatt  = ""
!EL005
!EL004
.continue EL006 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL007 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr diese Kostenstelle.
.set TRANS -
.assign M|ykalkblatt  = ""
!EL007
!EL006
.continue 'xprocst.xprocsp'
!PROC003: ----- Projektanlage_AU_und_AN -----
.select group "3:22" "%,,nummer=;such=;sucherw=;yprjmproj==`;@.gruppe=22;.@filingmode=(Active)"       ? G|menue = 1
.select group "3:21" "%,,nummer=;such=;sucherw=;yprjmproj==`;@.gruppe=21;.@filingmode=(Active)"       ? G|menue = 2
.continue EL008 ? _(G|mehr)
.formula U|xtvorgang  = H|id
.formula U|xtvorpos   = ""
.formula U|xtprojsuch = ""
.formula U|xtprojsuch = H|yprjmproj^such        ? _F|empty(H|yprjmproj)
.select line
!LOOP001: ==============================
.continue ELOP001 ? _(U|xbmehr)
.formula U|xtvorpos   = H|id                                    ?  F|empty(H|projekt) & F|empty(U|xtvorpos)
.formula U|xtprojsuch = U|xtprojsuch + ";" + H|projekt^such     ? _F|empty(H|projekt)
.select line
.continue LOOP001
!ELOP001: ==============================
.copy U|xbmehr = G|FALSE
.continue EL009 ? _(_(F|empty(H|yprjmproj)))
.load 0 group 'U|xydbgrpvorgang' 'F|expr("$,,yprojekt==" + H|yprjmproj^id + ";@filingmode=(Active)")'
.copy U|xbmehr = G|mehr
!EL009
.continue EL010 ? _(_(F|empty(U|xtprojsuch)))
!REPT001: ==============================
.formula U|ximenue = 0
.set TRANS +
.menu Achtung
Der gewÑhlte Auftrag enthÑlt bereits Projektzuordnungen zu den Projekten
'U|xtprojsuch                                                           '

Sie haben folgende Mîglichkeiten:
Projekt nicht diesem Vorgang zuordnen                        >>.formula U|ximenue = 1
Vorhandene Zuordnungen mit neuem Projekt Åberschreiben       >>.formula U|ximenue = 2
?Projektplan fÅr Projekt 'H|yprjmproj' anlegen               >>.formula U|ximenue = 3   ? _F|empty(H|yprjmproj) & _U|xbmehr
.set TRANS -
.continue REPT001 ? _((G|menue = 0) ; (U|ximenue <> 0))
!EL010
.continue EL011 ? _((G|menue   <> 0) & (U|ximenue <> 1))
.continue EL012 ? _((U|ximenue = 2) ; (F|empty(U|xtprojsuch)))
.formula U|xtcmd = "<(Sales)>" + H|id + "<(Edit)> ?yprjmsbutton=yprjmbukdproj"
.formula U|xtcmd = U|xtcmd + "|[invisible]=1"
.comman -WAIT 'U|xtcmd'
.select object 'U|xtvorgang'
.continue EL013 ? _(G|mehr)
.assign M|yprojekt = H|yprjmproj^id
!EL013
.continue FI012
!EL012
.continue EL014 ? _(U|ximenue = 3)
.assign M|yprojekt = H|yprjmproj^id
.continue FI014
!EL014
.box
Diese Funktion ist noch nicht fertig gestellt.
!FI014
!FI012
!EL011
.continue FI008
!EL008


!FI008
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskende")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.end 1         ? M|ybmaskezu
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "buttonnach")
.continue BRK003 ? _(G|evtvar = "ybulvbabdeckblatt")
.continue EL015 ? _(_(F|empty(M|ykalkblatt)))
.formula U|xtcmd = G|kkomname38 + " PRJMLVBABDECKBLATT ? ykalkblatt=" + M|ykalkblatt^id + "|ybmaskezu=1|bstart="
.command -PARALLEL 'U|xtcmd'
!EL015
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "ybuangebotneu")
.continue EL016 ? _((F|empty(M|ykalkblatt)) ; (M|tzeilen = 0))
.set TRANS +
.box Hinweis
Bitte erst ein Kalkulationsblatt wÑhlen und die Kalkulationsstruktur laden.
.set TRANS -
.error
.end 1
.continue FI016
!EL016
.formula U|xtsel = "$,,yprjmlvkalkid==" + M|ykalkblatt^id + ";kotyp==(" + 'G|ANKO' + ");@ablageart=(3)"
.load 0 group "3:21" 'U|xtsel'
.continue EL017 ? _(G|mehr)
!REPT002: ==============================
.set trans +
.menu(0,0,4) Hinweis
Zu diesem Kalkulationsblatt wurde schon ein Angebot erstellt.

weiteres Angebot erstellen
vorhandenes Angebot îffnen
.set trans -
.continue       ? G|menue = 0
.continue REPT002 ? _(G|menue > 2)
.continue BRK005 ? _(G|menue = 3)
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|menue = 4)
.formula U|xtsel = "%,,nummer==;such=;sucherw=;yprjmproj=;vom=;.yprjmlvkalkid==" + M|ykalkblatt^id + ";.kotyp==(" + 'G|ANKO' + ");@ablageart=(3);@autostart=(1)"
.load 0 group "3:21" 'U|xtsel'
.command -WAIT 'F|expr(0|id)'   ? G|mehr
.continue
.continue ESAC003
!BRK006
.continue
!ESAC003: =====   ENDCASE   =====
!EL017
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.select lock add M|ykalkblatt
.continue EL018 ? _(_(G|mehr))
.set TRANS +
Das Kalkulationsblatt kann nicht zum bearbeiten geîffnet werden.
Das Angebot wird nicht erstellt.
.set TRANS -
.error
.end 1
!EL018
.continue EL019 ? _(F|empty(M|ykunde))
.continue EL020 ? _(F|empty(M|ykalkblatt^ykunde))
.set trans +
.box Hinweis
Im Kalkulationsblatt ist kein Kunde eingetragen.
Bitte Kunden selektieren.
.set trans -
.continue EL021 ? _(G|mehr)
.select customer "%,,.@filingmode=(Active)"
.continue       ? _G|mehr
.formula U|xtkunde = H|id
.copy    U|xpland  = H|land
.continue FI021
!EL021
.continue
!FI021
.continue FI020
!EL020
.copy    M|ykunde   = M|ykalkblatt^ykunde
.formula U|xtkunde  = M|ykunde^id
.copy    U|xpland   = M|ykunde^land
!FI020
.continue FI019
!EL019
.formula U|xtkunde = M|ykunde^id
.copy    U|xpland  = M|ykunde^land
!FI019
.continue EL022 ? _((F|empty(5|ypmlvstdanpos)) ; (F|empty(5|ypmlvstdomanpos)) ; (F|empty(5|ypmlvtxtanpos)))
.set TRANS +
.box Hinweis
Bitte zuerst in der Projektkonfiguration die Standard-Angebots-
und Standard-Textposition fÅllen.
.set TRANS -
.error
.end 1
.continue FI022
!EL022
.continue EL023 ? _(_(5|ypmlvstdanpos^gruppe = 1))
.continue EL024 ? _(_(5|ypmlvstdanpos^gruppe = 4))
.set TRANS +
.box Hinweis
Die Standard Angebotsposition muss ein Artikel oder eine Zusatzposition vom Typ "AU/BE-Position,BV" sein.
Bitte in der Projektkonfiguration korrigieren.
.set TRANS -
.error
.end 1
.continue FI024
!EL024
.continue EL025 ? _(_('5|ypmlvstdanpos^zptyp(L="0")' = "(7)"))
.set TRANS +
.box Hinweis
Die Standard Angebotsposition muss ein Artikel oder eine Zusatzposition vom Typ "AU/BE-Position,BV" sein.
Bitte in der Projektkonfiguration korrigieren.
.set TRANS -
.error
.end 1
!EL025
!FI024
