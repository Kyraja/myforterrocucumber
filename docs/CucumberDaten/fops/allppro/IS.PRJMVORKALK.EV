!EL029
!FI028
!FI022
.copy U|xbok = G|TRUE
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _((U|xbok) & (G|mehr))
.continue EL030 ? _(M|ytistblatt)
.continue EL031 ? _((_(F|empty(M|yteinh))) ; (_(M|ytmge = 0)))
.continue EL032 ? _((M|ytmge = 0) ; (F|empty(M|yteinh)))
.cursor ytmge  'M|aktzeile'     ? M|ytmge = 0
