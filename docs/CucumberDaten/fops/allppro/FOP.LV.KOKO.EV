..!interpreter english declaration noabbrev
.. at 2017-01-20, 15:52
.set TRANS -
..========================================================================
..==  Name              : FOP.LV.KOKO.EV
..==  Pfad              : allppro
..==  Funktion          : EFOP an Kostenkomponente
..==  Erstellungsdatum  : 01.11.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allppro/LV.KONFIG.INI"
..====================================================
.type text    xtsel xtsys xtfarbe
.type integer xifarbe
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Feldpruefung_Farbe -----
.continue EL001 ? _((M|.evtvar < 0) ; (M|.evtvar > 255))
.set TRANS +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set TRANS -
.error
.end 1
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe_KoKo -----
.formula U|xtfarbe = 'M|yfarber' + " " + 'M|yfarbeg' + " " + 'M|yfarbeb'
.formula U|xtfarbe = "-1 -1 -1"                ? U|xtfarbe = "0 0 0"
.formula M|yfarbergb = U|xtfarbe        ? F|modifiable(M|yfarbergb)
.colour -BACKGROUND 'xtfarbe' ysfarbe
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL002 ? _(_(G|evtkommd = G|kaktname10))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
!EL002
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL003 ? _(G|evtkommd = G|kaktname10)
.select group 'U|xydbgrkalkschema' 'F|expr("$,,ykoko==" + M|id)'
.continue EL004 ? _(G|mehr)
.set TRANS +
.box Hinweis
Die Kostenkomponente wird noch in einem Kalkulationsschema verwendet.
Lîschen nicht mîglich.
.set TRANS -
.error
.end 1
!EL004
.select group 'U|xydbgrlvkalkblatt' 'F|expr("$,,ytkoko==" + M|id)'
.continue EL005 ? _(G|mehr)
.set TRANS +
.box Hinweis
Die Kostenkomponente wird noch in einem Kalkulationsblatt verwendet.
Lîschen nicht mîglich.
.set TRANS -
.error
.end 1
!EL005
!EL003
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "feldpruef")
.continue BRK004 ? _(G|evtvar = "yfarber")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "yfarbeg")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "yfarbeb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK006
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK003
.continue BRK007 ? _(G|evtart = "feldaus")
.continue BRK008 ? _(G|evtvar = "yvertschl")
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "yfarber")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK009
.continue BRK010 ? _(G|evtvar = "yfarbeg")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "yfarbeb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK011
.continue BRK012 ? _(G|evtvar = "ykoko")
.continue EL006 ? _((M|ykoko^id = M|id) & (_(F|empty(M|ykoko))))
.set TRANS +
.box Fehler
Der aktuelle Datensatz darf hier nicht eingetragen werden.
.set TRANS -
!EL006
.formula M|ykokoanteil = 100    ? M|ykokoanteil = 0
.continue ESAC003
!BRK012
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.continue
