.formula U|xi1 = U|xi1 + 1
.continue LOOP001
!ELOP001: ==============================
.add
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Tabelle_leeren -----
.continue EL002 ? _(F|empty(M|ykalkblatt))
.assign M|ysuch = ""
.assign M|yname = ""
.protection -RESET ysuch 0
.protection -RESET yname 0
.continue FI002
!EL002
.formula U|xtsel = "$,,ykblattid==" + M|ykalkblatt^id + ";@filingmode=(Active)"
.select group 'U|xydbgrlvkalkpos' 'U|xtsel'
.continue EL003 ? _(G|mehr)
.assign M|ykalkblatt = ""
.assign M|ysuch      = ""
.assign M|yname      = ""
.protection -RESET ysuch 0
.protection -RESET yname 0
!EL003
!FI002
.assign M|ybimport = G|false
.make screen line --O
.continue 'xprocst.xprocsp'
!PROC003: ----- Daten_pruefen -----
