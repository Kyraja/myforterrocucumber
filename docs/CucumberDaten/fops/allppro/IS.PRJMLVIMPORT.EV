.output NEW WERF.WEG
.formula U|xtsys = "xmlimport.sh"
.formula U|xtsys = U|xtsys + " -p " + G|einmalpw + " -o UPDATEMODE=STRICT -r NUM -T -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'U|xtsys' BACKGROUND
.continue EL047 ? _(G|mehr)
.continue EL048 ? _(F|empty(U|xtedpout))
!REPT002: ==============================
.set trans +
.menu
-                 -
Bei der Anlage de Kalkulation sind Fehler aufgetreten:

EDP Befehl: 'U|xtsys'

EDP Datei:        'U|xtedpdat'  >>.edit "'U|xtedpdat'"
?EDP Fehlerdatei:  'U|xtedperr'  >>.edit "'U|xtedperr'" ?  F|fileexists(U|xtedperr)
?EDP Ausgabedatei: 'U|xtedpout'  >>.edit "'U|xtedpout'" ?  F|fileexists(U|xtedpout)
.set trans -
.continue REPT002 ? _(G|menue = 0)
.continue FI048
!EL048
.continue EL049 ? _(F|empty(M|ykalkblatt))
.formula U|xtsel = "$,,yextid==" + M|yextid + ";@filingmode=(Active)"
.select group "145:3" 'U|xtsel'
.continue FI049
!EL049
.select add M|ykalkblatt
!FI049
.continue EL050 ? _(G|mehr)
.formula M|ykalkblatt = H|id
.copy    M|ybimport   = G|true
.set trans +
.box Hinweis
Die Kalkulation wurde erfolgreich mit der Nummer 'H|nummer' angelegt.
.set trans -
.continue FI050
!EL050
.set trans +
.box Fehler
Die angelegte Kalkulation 'U|xtext' konnte nicht geladen werden.
.set trans -
!FI050
!FI048
.continue FI047
!EL047
!REPT003: ==============================
.set trans +
.menu
-                 -
Bei der Anlage de Kalkulation sind Fehler aufgetreten:

EDP Befehl: 'U|xtsys'

EDP Datei:        'U|xtedpdat'  >>.edit "'U|xtedpdat'"
?EDP Fehlerdatei:  'U|xtedperr'  >>.edit "'U|xtedperr'" ?  F|fileexists(U|xtedperr)
?EDP Ausgabedatei: 'U|xtedpout'  >>.edit "'U|xtedpout'" ?  F|fileexists(U|xtedpout)
.set trans -
.continue REPT003 ? _(G|menue = 0)
!FI047
!FI035
.continue ESAC004
!BRK010
!ESAC004: =====   ENDCASE   =====
.continue ESAC002
!BRK008
.continue BRK011 ? _(G|evtart = "feldaus")
.continue BRK012 ? _(G|evtvar = "ydatei")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK012
.continue BRK013 ? _(G|evtvar = "ykalkblatt")
.continue EL051 ? _(F|empty(M|ykalkblatt))
.assign  M|ysuch  = ""
.assign  M|yname  = ""
.formula M|yextid = ""
.protection -RESET ysuch 0
.protection -RESET yname 0
.continue FI051
!EL051
.formula U|xtsel = "$,,ykblattid==" + M|ykalkblatt^id + ";@filingmode=(Active)"
.select group 'U|xydbgrlvkalkpos' 'U|xtsel'
.continue EL052 ? _(G|mehr)
.set trans +
.box Hinweis
Die Kalkulation 'M|ykalkblatt' besitzt bereits Positionen.
Ein Import ist nur fÅr leere Kalkulationen mîglich.
.set trans -
.assign  M|ysuch      = ""
.assign  M|yname      = ""
.assign  M|ykalkblatt = ""
.formula M|yextid     = ""
.protection -RESET ysuch 0
.protection -RESET yname 0
.continue
.continue FI052
!EL052
.formula M|ysuch  = M|ykalkblatt^such
.formula M|yname  = M|ykalkblatt^namebspr
.formula M|yextid = M|ykalkblatt^yextid
.protection ysuch 0
.protection yname 0
!FI052
!FI051
.continue ESAC005
!BRK013
.continue BRK014 ? _(G|evtvar = "ysuch")
.continue EL053 ? _(_(M|ysuch<<1 / "(AZ)"))
.set trans +
.box Fehler
Das Suchwort muss mit einem Buchstaben beginnen.
.set trans -
.formula M|ysuch = ""
!EL053
.continue ESAC005
!BRK014
.continue BRK015 ? _(G|evtvar = "ylvimpkonf")
.continue EL054 ? _(_(F|empty(M|ylvimpkonf)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC001
!RET006
.formula xprocsp = xprocsp - 1
!EL054
.continue ESAC005
!BRK015
.continue EL055 ? _(G|evtvar<<4 = "ymap")
.input "allppro/FOP.LV.LVIMPKONF.EV"
!EL055
!ESAC005: =====   ENDCASE   =====
.continue ESAC002
!BRK011
.continue BRK016 ? _(G|evtart = "zeilebewvor")
.error
.end 1
.continue ESAC002
!BRK016
!ESAC002: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMLVIMPORT.EV")'           ? F|fileexists(F|foppath("IFOP.IS.PRJMLVIMPORT.EV"))
.continue
