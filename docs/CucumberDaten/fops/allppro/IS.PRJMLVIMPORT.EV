.set trans +
.box Fehler
Die Variable 'M|ymap.xi1' darf nicht per FO geschrieben werden.
.set trans -
.cursor 'M|ymap.xi1' 0
.load 9 line
.copy U|xbmehr = G|mehr
.continue FI009
!EL009
.copy U|xbmehr = G|false
.copy U|xbok   = G|true
!FI009
.continue FI008
!EL008
.load 9 line
.copy U|xbmehr = G|mehr
!FI008
.continue LOOP003
!ELOP003: ==============================
.continue EL010 ? _(U|xbok)
.continue EL011 ? _(9|vitf<<2 = "TN")
.formula U|xtcmd = "type text xtvar" + 'U|xi1'
.'xtcmd'
.continue FI011
!EL011
