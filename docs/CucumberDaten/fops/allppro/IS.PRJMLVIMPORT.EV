.formula U|xiposstufe = U|xiposstufe + 1
.formula U|xtext = U|xtext >> M|ypostrenn
.continue LOOP008
!ELOP008: ==============================
.continue EL026 ? _(M|aktzeile = 1)
.continue EL027 ? _(U|xiposstufe > 0)
