.type text    xtsys xtsel xtcmd xtedpdat xtedpout xtedperr xtedpmsg
.type text    xtdatei xtext xtmenue xtvar xttitel xt1
.type integer xizeile xiposzeile xipnum xistufe xiposstufe xi1
