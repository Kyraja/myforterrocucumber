.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- LadeImportKonfig -----
.add M|ylvimpkonf
.continue EL001 ? _(G|mehr)
.formula M|ytrenner   = D|ytrenner
.formula M|ypostrenn  = D|ypostrenn
.formula M|ybstruktur = D|ybstruktur
.formula M|ymapft     = D|ymapft
.formula M|yuebzeilen = D|yuebzeilen
.formula U|xi1    = 1
!LOOP001: ==============================
.continue ELOP001 ? _(F|defined(M|ymap.U|xi1))
