.formula U|xtsel = "$,,vdn==145;vgr==4;@filingmode=(Active)"
.load 9 company 'U|xtsel'
.formula U|xipnum = 0
.formula U|xi1    = 1
!LOOP002: ==============================
.continue ELOP002 ? _(F|defined(M|ymap.xi1))
