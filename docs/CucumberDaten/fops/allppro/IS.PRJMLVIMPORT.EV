!FI010
!EL007
.formula U|xi1 = U|xi1 + 1
.continue LOOP002
!ELOP002: ==============================
.load 9
.select screen header
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xi1 = 1
!LOOP005: ==============================
.continue ELOP005 ? _((F|defined(M|ytvar.xi1)) & (F|defined(U|xtvar.xi1)))
.continue EL012 ? _(_(F|empty(M|ytvar.xi1)))
.assign U|xtvar.xi1 = 'M|ytvar.xi1'
.continue EL013 ? _(_(G|mehr))
.continue EL014 ? _(F|typeof(U|xtvar.xi1) = "TAZ1")
.formula U|xt1 = M|ytvar.xi1
.type bool xbmerk.xt1   ? _F|defined(U|xbmerk.xt1)
.continue EL015 ? _(_(U|xbmerk.xt1))
!REPT001: ==============================
.formula U|xtcmd = "cursor ytvar" + 'xi1' + " " + 'M|aktzeile'
.'U|xtcmd'
.set trans +
.formula U|xtmenue = ""
.menu(0,0,5)Achtung
Die Einheit 'M|ytvar.xi1' ist nicht angelegt.

?Einheit anlegen                                         >>.formula U|xtmenue = "ANL"   ? F|cmdpermitted(12,13) & G|false = G|true
Feld "Variable 'U|xi1'" in Zeile 'M|aktzeile' leeren.   >>.formula U|xtmenue = "LEE"
Einheit ersetzen.                                       >>.formula U|xtmenue = "ERS"
.set trans -
.continue       ? G|menue = 0
.continue REPT001 ? _(_(F|empty(U|xtmenue)))
!EL015
.continue BRK001 ? _(U|xtmenue = "ANL")
.formula U|xtcmd = "<" + G|kdatname12 + "> $,gruppe=30 <" + G|kaktname13 + ">"
.command -WAIT 'U|xtcmd'
.assign U|xtvar.xi1 = 'M|ytvar.xi1'
.continue EL016 ? _(_(G|mehr))
.set trans +
.box Fehler
Zeile 'M|aktzeile', Variable 'U|xi1':
Wert " 'M|ytvar.xi1'" kann nicht dem Feld 'M|ymap.xi1' zugewiesen werde.
.set trans -
.formula U|xtcmd = "cursor ytvar" + 'xi1' + " " + 'M|aktzeile'
.'U|xtcmd'
.error
.end 1
!EL016
.continue ESAC001
!BRK001
.continue BRK002 ? _(U|xtmenue = "LEE")
.continue EL017 ? _(U|xbmerk.xt1)
.assign M|ytvar.xi1 = ""
.continue FI017
!EL017
.set trans +
.formula U|xttitel = "Achtung"
.box -button yes:no -title 'U|xt1'
Sollen alle Felder mit Einheit "'M|ytvar.xi1'" geleert werden?
.set trans -
.assign M|ytvar.xi1  = ""
.copy U|xbmerk.xt1 = G|true   ? G|box = G|boxyes
!FI017
.continue ESAC001
!BRK002
.continue BRK003 ? _(U|xtmenue = "ERS")
.continue EL018 ? _(U|xbmerk.xt1)
.assign M|ytvar.xi1 = U|xteh.xt1
.continue FI018
!EL018
.type TAZ1 xteh.xt1     ? _F|defined(U|xteh.xt1)
.formula U|xtext = ""
.select company "$,gruppe=30"
.select line
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xtext = U|xtext + G|trennerchar + H|einheitbspr + ">>.assign U|xteh.xt1 = " + G|dblquote + H|einheitbspr + G|dblquote   ? _F|empty(U|xtext) & _H|aktiv
.formula U|xtext =                           H|einheitbspr + ">>.assign U|xteh.xt1 = " + G|dblquote + H|einheitbspr + G|dblquote   ?  F|empty(U|xtext) & _H|aktiv
.select line
.continue LOOP006
!ELOP006: ==============================
.menu
'xtext                                                                 '
.continue EL019 ? _(G|menue = 0)
.formula U|xtcmd = "cursor ytvar" + 'xi1' + " " + 'M|aktzeile'
.'U|xtcmd'
.error
.end 1
.continue FI019
!EL019
.set trans +
.formula U|xttitel = "Achtung"
.box -button yes:no -title 'U|xt1'
Sollen alle Felder mit Einheit "'M|ytvar.xi1'" durch "'U|xteh.xt1'" ersetzt werden?
.set trans -
.assign M|ytvar.xi1  = U|xteh.xt1
.copy U|xbmerk.xt1 = G|true   ? G|box = G|boxyes
!FI019
!FI018
.continue ESAC001
!BRK003
!ESAC001: =====   ENDCASE   =====
.continue FI014
