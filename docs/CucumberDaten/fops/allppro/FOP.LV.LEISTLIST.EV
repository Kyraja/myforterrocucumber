..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsys xtsel xtwert xtvar xtkalkpos xtlvid xtprojleistkatid xtarbpaket xttitel
.type text    xtedpdat xtedpout xtedpmsg xtedperr
.type real    xrzwsum xrkalkzs xpapreis
.type realx   xxmge  xxlepreis
.type GD      xdkonddat
.type GJ      xgj
.type integer ximonat xizeile xivar xievtvar ximenue
.type bool    xbvar xbmehr xbok xbmge xbausloese xbfehler xbgkkzsbnw xbkalkblatt
.type P3:2    xpaupos
.type TAZ7    xeinh xle xvhe xvpe
.type P86:1   xpprojekt
.type bool    xbnoifop      ? _F|defined(U|xbnoifop)
.type integer xprocsp       ? _F|defined(U|xprocsp)
..====================================================
.continue EPROCDEF
!PROC001: ----- checkDelete -----
.load 0 group "145:4" 'F|expr("$,,ytleistlistid==" + M|id + ";@ablageart=(Active);@zeilen=(Yes)")'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.set TRANS +
.formula U|xttitel = "Achtung"
.box -button ok:cancel -title 'U|xttitel'
Die Leistungsliste ist noch der Kalkulationsposition '0|nummer' eingetragen.
Lîschen nicht mîglich.
.set TRANS -
.error
.end 1
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.load 0 group "153:2" 'F|expr("$,,yleilistid==" + M|id + ";@ablageart=(Active);@zeilen=(No)")'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.set TRANS +
.formula U|xttitel = "Achtung"
.box -button ok:cancel -title 'U|xttitel'
Die Leistungsliste ist noch der Nachtragsanfrage '0|nummer' eingetragen.
Lîschen nicht mîglich.
.set TRANS -
.error
.end 1
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.copy M|ybdelete = G|TRUE
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe_VK-Wert -----
.colour -BACKGROUND "255 255 220" ytvkwertman 'M|aktzeile' ? M|ytvkwertman <> M|ytkostbaswert &  M|yvorbelvkmank = "KOZU"
.colour -BACKGROUND "-1 -1 -1"    ytvkwertman 'M|aktzeile' ? M|ytvkwertman =  M|ytkostbaswert &  M|yvorbelvkmank = "KOZU"
.colour -BACKGROUND "255 255 220" ytvkwertman 'M|aktzeile' ? M|ytvkwertman <> M|ytvkkondwert  &  M|yvorbelvkmank = "VKPR"
.colour -BACKGROUND "-1 -1 -1"    ytvkwertman 'M|aktzeile' ? M|ytvkwertman =  M|ytvkkondwert  &  M|yvorbelvkmank = "VKPR"
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL001 ? _(G|evtkommd = G|kaktname10)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI001
!EL001
.continue EL002 ? _(_(G|edp))
.protection -exception buinfosys 0
.protection -exception buaktion  0
.protection -exception budruck   0
.protection -all
.continue EL003 ? _(G|evtkommd = G|kaktname14)
.set TRANS +
.box Fehler
Direkte Neuanlage von Leistungslisten nicht erlaubt.
.set TRANS -
.error
.end 1
!EL003
!EL002
.formula U|xivar = 1
.continue EL004 ? _(_(G|EDP))
.formula U|xivar = 1
!LOOP003: ==============================
.continue ELOP003 ? _((F|defined(M|yhkzs.xivar)) ; (F|defined(M|yskzs.xivar)))
.continue EL005 ? _(_(F|empty(M|yhkzs.U|xivar)))
.formula P|maskkontextfop    = P|maskkontextfop + " HKZS" + F|tostring(U|xivar)
.formula M|yhkzsname.U|xivar = M|yhkzs.U|xivar^namebspr
!EL005
.continue EL006 ? _(_(F|empty(M|yskzs.U|xivar)))
.formula P|maskkontextfop    = P|maskkontextfop + " SKZS" + F|tostring(U|xivar)
.formula M|yskzsname.U|xivar = M|yskzs.U|xivar^namebspr
!EL006
.formula U|xivar = U|xivar + 1
.continue LOOP003
!ELOP003: ==============================
.select screen header
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xivar = 1
!LOOP005: ==============================
.continue ELOP005 ? _((F|defined(M|ythkzswert.xivar)) ; (F|defined(M|ytskzswert.xivar)))
.formula M|ythkzsname.xivar = M|yhkzs.xivar^namebspr
.formula M|ytskzsname.xivar = M|yskzs.xivar^namebspr
.formula U|xivar = U|xivar + 1
.continue LOOP005
!ELOP005: ==============================
.assign M|ytskalkblatt = M|ytkalkblattid    ? _F|empty(M|ytkalkblattid)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.select screen line
.continue LOOP004
!ELOP004: ==============================
!EL004
!FI001
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "zeileeinvor")
.error
.end 1
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "zeileloevor")
.error
.end 1
.continue ESAC001
!BRK003
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.FOP.LV.LEISTLIST.EV")'  ? F|fileexists(F|foppath("IFOP.FOP.LV.LEISTLIST.EV")) & _U|xbnoifop
.continue
