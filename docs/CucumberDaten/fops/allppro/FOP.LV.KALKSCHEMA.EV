.type integer xivar
.type integer   xprocsp      ? _F|defined(U|xprocsp)
..====================================================
.formula U|xprocsp = 0
.set demand -
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue EL001 ? _(_(G|evtkommd = G|kaktname10))
.formula U|xivar = 1
!LOOP001: ==============================
.continue ELOP001 ? _((F|defined(M|ylvhkzs.xivar)) ; (F|defined(M|ylvskzs.xivar)))
.formula M|ylvhkzsname.xivar = M|ylvhkzs.xivar^namebspr
.formula M|ylvskzsname.xivar = M|ylvskzs.xivar^namebspr
.formula U|xivar = U|xivar + 1
.continue LOOP001
!ELOP001: ==============================
.formula U|xivar = 1
!EL001
.copy M|yprojgkkoko = 5|yprojgkkoko     ? G|evtkommd = G|kaktname14
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "ykoko")
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "ybgesamtsum")
.continue EL002 ? _(M|ybgesamtsum)
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.assign M|ybgesamtsum = G|FALSE         ? M|aktzeile <> G|evtzeile
.select screen line
.continue LOOP002
!ELOP002: ==============================
!EL002
.continue ESAC002
!BRK004
.continue EL003 ? _((G|evtvar<<7 = "ylvhkzs") ; (G|evtvar<<7 = "ylvskzs"))
.formula U|xivar = G|evtvar<<-7
.continue EL004 ? _(((G|evtvar<<7 = "ylvhkzs") & (M|.evtvar^yzsartk = 83)) ; ((G|evtvar<<7 = "ylvskzs") & (M|.evtvar^yzsartk = 72)))
.set TRANS +
.box Hinweis
Zuschl„ge vom Typ "'M|.evtvar^yzsart'" drfen hier nicht eingetragen werden.
.set TRANS -
.copy M|.evtvar = F|oldvalue(M|.evtvar)
!EL004
.continue EL005 ? _(G|evtvar<<7 = "ylvhkzs")
.formula M|ylvhkzsname.xivar  = M|.evtvar^namebspr
!EL005
.continue EL006 ? _(G|evtvar<<7 = "ylvskzs")
.formula M|ylvskzsname.xivar  = M|.evtvar^namebspr
!EL006
!EL003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
.continue
