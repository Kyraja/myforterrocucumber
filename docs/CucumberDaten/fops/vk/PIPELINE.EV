..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PIPELINE.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Zentrale Behandlung einfacher Ereignisse.
.. Functionality  : Central handling of simple events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "wahrsch"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "ablehngrund"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "zeich"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "vonplz"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "bisplz"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "nort"
.continue ART     ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "produkt"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "partner"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "vertret"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "betreuer"
.continue DOCDAT  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "vonbelegdat"
.continue DOCDAT  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "bisbelegdat"
.continue REMIND  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "vonwiedervorlage"
.continue REMIND  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "biswiedervorlage"
.continue ORDDAT  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "vonaudatum"
.continue ORDDAT  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "bisaudatum"
.continue VALID   ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "gltvon"
.continue VALID   ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "gltbis"
.continue DECIMAL ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "auswaehr"
.continue VSTATE  ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "staat"
.continue STATE   ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "staat"
.continue VREGION ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "region"
.continue REGION  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "region"
.continue OPPORTY ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "chance"
.continue FILMODE ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "ablageart"
.continue QUOTATN ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "angebot"
.continue CLRALL  ? G|evtartengl = "FIELD_FILL"       & G|evtvar = "nurpositionen"
.continue CLRALL  ? G|evtartengl = "FIELD_FILL"       & G|evtvar = "mitalternativpos"
.continue NEWOPP  ? G|evtartengl = "BUTTON_AFTER"     & G|evtvar = "buneuerbeleg"
.continue NEWQUO  ? G|evtartengl = "BUTTON_AFTER"     & G|evtvar = "buneuerbeleg2"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "merkmal1"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "merkmal2"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "merkmal3"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "merkmal4"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "merkmal5"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "merkmal6"
.continue CLRALL  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "projekt"
.continue BASIS   ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "basisartikel"
..--------------------------------- Table  -------------------------------------
.continue RELEASE ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bfolge"
.continue RELEASE ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bildbfolge"
.continue VIEWDOC ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bzeigen"
.continue VIEWDOC ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bildbzeigen"
.continue BBRMDOC ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bildbablegen"
.continue BARMDOC ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bildbablegen"
.continue BBRMDOC ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bildbablegen2"
.continue BARMDOC ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bildbablegen2"
.continue NEWNOTE ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bildbnotiz"
.continue NEWTASK ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bildbaufgabe"
..==============================================================================
.continue END
..
!BASIS
.formula M|produkt = "" ? _F|empty(M|basisartikel) 
.continue CLRALL
..
!ART
.assign M|basisartikel = M|produkt^basisartikel ? _F|empty(M|produkt)
.continue CLRALL
..
!FILMODE: Filing mode clicked
.assign P|maskkontextfop = ""
.assign P|maskkontextfop = F|value(M|ablageart, "AS193") ? F|equals(M|ablageart, "(Filed)")
.continue CLRALL
..
!OPPORTY: Opportunities clicked
.continue OPPORON ? M|chance
..
.. No opportunties
.continue QUOTAON ? M|angebot
.continue CLRALL
..
!OPPORON: Select opportunities
.assign M|kotyp = "(Opportunity)"
.continue CLRALL
...
!QUOTATN: Quotations clicked
.continue QUOTAON ? M|angebot
..
.. No quotations
.continue OPPORON ? M|chance
.continue CLRALL
..
!QUOTAON: Select quotations
.assign M|kotyp = "(Quotation)"
.continue CLRALL
..
!DOCDAT: Exit starting or ending date of document
.copy M|belegdat = _(F|empty(M|vonbelegdat) & F|empty(bisbelegdat))
.continue CLRALL
..
!REMIND: Exit starting or ending date of reminder
.copy M|wvorlage = _(F|empty(M|vonwiedervorlage) & F|empty(biswiedervorlage))
.continue CLRALL
..
!ORDDAT: Exit starting or ending planned sales order date
.copy M|audatum = _(F|empty(M|vonaudatum) & F|empty(bisaudatum))
.continue CLRALL
..
!VALID: Exit starting or ending validity date
.copy M|glt = _(F|empty(M|gltvon) & F|empty(gltbis))
.continue CLRALL
..
!VSTATE: Validate that input is a state
.continue END ? F|empty(M|staat)
.continue ERROR5 ? _F|equals(M|staat^typ, "(Country)")
.continue END
..
!STATE: Exit state
.continue CLRALL ? F|empty(M|staat)
.continue CLRALL ? F|empty(M|region)
..
.. Clear region while region is not part of state
.continue CLRALL ? M|staat^id = M|region^staat^id
.assign M|region = ""
.continue CLRALL
..
!VREGION: Validate that input is a region
.continue END ? F|empty(M|region)
.continue ERROR6 ? _F|equals(M|region^typ, "(Region)")
.continue END
..
!REGION: Exit region
.continue CLRALL ? F|empty(M|region)
..
.. Clear region while region is not part of state
.continue CLRALL ? M|staat^id = M|region^staat^id
.assign M|staat = M|region^staat^id
.continue CLRALL
..
!NEWOPP: Create new opportunity is clicked
.type AS5 xdoctype
.assign U|xdoctype = "(Opportunity)"
.continue NEWDOC
..
!NEWQUO: Create new quotation is clicked
.type AS5 xdoctype
.assign U|xdoctype = "(Quotation)"
..
!NEWDOC: Create a new document
.continue ERROR1 ? _F|cmdpermitted(3, 14)
.formula M|auswahl = "<(Sales)>" + "<(New)>"
.formula M|auswahl = M|auswahl + "," + U|xdoctype
.continue EXEC ? F|empty(M|vertret) & F|empty(M|betreuer) & F|empty(M|produkt)
.formula M|auswahl = M|auswahl + "?"
.continue NEWSTAF ? F|empty(M|vertret)
.formula M|auswahl = M|auswahl + "vertret=" + M|vertret^id + "|"
..
!NEWSTAF: Set staff personel
.continue NEWPROD ? F|empty(M|betreuer)
.formula M|auswahl = M|auswahl + "betreuer=" + M|betreuer^id + "|"
..
!NEWPROD: Set product
.continue EXEC ? F|empty(M|produkt)
.formula M|auswahl = M|auswahl + "[insert]=|1:artex=" + M|produkt^id
..
!EXEC: Execute gui command
.command -parallel 'M|auswahl'
.continue END
..
!RELEASE: Release opportunity
.type VP99 xxmyobject
.type integer  xxmycmmd
.assign U|xxmycmmd = 3
.continue POSITION ? _F|empty(M|tbelegposition)
.assign U|xxmyobject = M|tbeleg
..
!COMMAND: Execute release
.input "is/EXEC.COMMAND4REFERENCE"
.continue END
..
!POSITION: Release opportunity and focus item
.assign U|xxmyobject = M|tbelegposition
.continue COMMAND
..
!VIEWDOC: View opportunity
.type VP99 xxmyobject
.continue VIEWPOS ? _F|empty(M|tbelegposition)
.assign U|xxmyobject = M|tbeleg
.continue COMMAND
..
!VIEWPOS: View position of opportunity and focus item
.assign U|xxmyobject = M|tbelegposition
.continue COMMAND
..
!BBRMDOC: Before button - File document using callparameter
.type ID87:9 xcallparam
.copy U|xcallparam = M|callparameter
.continue END ? F|empty(U|xcallparam)
.input "st/CALLPARAM.EXEC"
.continue END
..
!BARMDOC: After button  - File document using callparameter - Check result
.select nowait object 'M|tbeleg^id'
.continue REFRESH ? _G|mehr
.continue REFRESH ? H|ablagef
.continue REFRESH ? H|chanceabl
.continue END
..
!REFRESH: Refresh table
.input "vk/PIPELINE.BSTART.BV"
.input "vk/PIPELINE.BSTART.BN"
.continue END
..
!NEWNOTE: Create a new notice
.type ID87:9 xcallparam
.copy U|xcallparam = M|callparameter1
.continue END ? F|empty(U|xcallparam)
.input "st/CALLPARAM.EXEC"
.continue END
..
!NEWTASK: Create a new task
.type ID87:9 xcallparam
.copy U|xcallparam = M|callparameter2
.continue END ? F|empty(U|xcallparam)
.input "st/CALLPARAM.EXEC"
.continue END
..
!DECIMAL: decimal places of output currency
.input "is/EVT.FIELD.OUTCURR"
.copy M|ausnkst = M|auswaehr^nkst
.continue CLRALL
..
!CLRALL: clear output header items
.input "vk/PIPELINE.BKOPF"
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Action not allowed
.error -message Einen Beleg neu anzulegen ist dem Anwender nicht erlaubt.
.end 1
..
!ERROR2: Action not allowed
.error -message Einen Beleg freizugeben ist dem Anwender nicht erlaubt.
.end 1
..
!ERROR3: Action not allowed
.error -message Einen Beleg zu bearbeiten ist dem Anwender nicht erlaubt.
.end 1
..
!ERROR4: Document could not be locked
.error -message Der Beleg konnte nicht zum Bearbeiten gesperrt werden.
.end 1
..
!ERROR5: State is not a state
.error -line 0 -field M|staat -message 'M|staat^rnamebspr' ist kein Land!
.end 1
..
!ERROR6: State is not a state
.error -line 0 -field M|region -message 'M|region^rnamebspr' ist keine Region!
.end 1
