..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KOZEI.ESR
.. Datum          : 26.06.06
.. Version        : 2006r3
.. Autor          : rs
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       :
.. Ablauf         :
..
.. Functionality  :
.. Program flow   :
..*****************************************************************************
.set trans -
.type text  xtzs1      ? _defined(xtzs1)
.type text  xtzs2      ? _defined(xtzs2)
.type text  xtnum      ? _defined(xtnum)
.type text  xtkd       ? _defined(xtkd)
.type text  xtbankid   ? _defined(xtbankid)
.type text  xtlnnr     ? _defined(xtlnnr)
.type text  xtbetr     ? _defined(xtbetr)
.type real  xrbetr     ? _defined(xrbetr)
.type bool  xbesr      ? _defined(xbesr)
.type bool  xbl27      ? _defined(xbl27)
.type integer   xanz       ? _defined(xanz)
..
.. Generieren der Kodierzeile zur Druckausgabe einmal im ESR-Format und ESR+-Format
.formula T|xrbetr= T|xrbetr*100
.formula T|xtbetr= T|xrbetr
.formula T|xtbetr= T|xtbetr << "."
..
.. wenn Referenznummer 27 Stellen groá sein soll, dann xbtl27=true setzen
.formula T|xbl27=true
..
!TEIL: Anzahl der Stellen
.formula T|xanz = +(T|xtlnnr)
.continue ESR15 ?   T|xanz=5
.continue ESR16 ? _(T|xanz<7) & _T|xbl27
.continue ESR27 ? T|xbl27
..
!ESR15
.input "vk/KOZEI.ESR15"
.continue ESR15M         ? T|xbesr
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nach ESR und ESR+ fertig
.formula T|xtzs1 = T|xt
.formula T|xtzs2 = T|xt
.continue KOEND
..
!ESR15M
.input "vk/KOZEI.ESR15M"
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nur ESR fertig
.formula T|xtzs1 = T|xt
.formula T|xbesr = false
.input "vk/KOZEI.ESR15"
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nach ESR+ fertig
.formula T|xtzs2 = T|xt
.continue KOEND
..
!ESR16
.input "vk/KOZEI.ESR16"
.continue ESR16M ? T|xbesr
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nach ESR und ESR+ fertig
.formula T|xtzs1 = T|xt
.formula T|xtzs2 = T|xt
.continue KOEND
..
!ESR16M
.input "vk/KOZEI.ESR16M"
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nur ESR fertig
.formula T|xtzs1 = T|xt
.formula T|xbesr = false
.input "vk/KOZEI.ESR16"
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nach ESR+ fertig
.formula T|xtzs2 = T|xt
.continue KOEND
..
!ESR27
.input "vk/KOZEI.ESR27"
.continue ESR27M ? T|xbesr
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nach ESR und ESR+ fertig
.formula T|xtzs1 = T|xt
.formula T|xtzs2 = T|xt
.continue KOEND
..
!ESR27M
.input "vk/KOZEI.ESR27M"
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nur ESR fertig
.formula T|xtzs1 = T|xt
.formula T|xbesr = false
.input "vk/KOZEI.ESR27"
.input "vk/KOZEI.RUECK"
.. generierte Kodierzeile nach ESR+ fertig
.formula T|xtzs2 = T|xt
.continue KOEND
..
!KOEND
.continue
