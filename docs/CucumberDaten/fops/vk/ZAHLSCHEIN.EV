.. Funktion       : Selektionskriterien setzen
.. Ablauf         :
..
.. Functionality  :
.. Program flow   :
.. Includes       :
.. include vk/KOZEI.ESR
.. include vk/ZAHLSCHEIN.TAB
..*****************************************************************************
.set trans -
!BEGEV: Beginn / beginning
.type text  xtnum      ? _F|defined(U|xtnum)
.type text  xtkd       ? _F|defined(U|xtkd)
.type text  xtbankid   ? _F|defined(U|xtbankid)
.type text  xtlnnr     ? _F|defined(U|xtlnnr)
.type text  xtbetr     ? _F|defined(U|xtbetr)
.type real  xrbetr     ? _F|defined(U|xrbetr)
.type bool  xbesr      ? _F|defined(U|xbesr)
..
.continue BSTART  ? G|evtvar/"*bstart*"
.continue KOZEI   ? G|evtvar/"*beinzahlsch*"  & G|evtartengl="FIELD_EXIT"
.continue QRCODE  ? G|evtvar/"*qrbetrag*"     & G|evtartengl="FIELD_EXIT" & _F|empty(M|qrtyp)
.continue LEERQRFELDER  ? G|evtvar/"*vorgang*"     & G|evtartengl="FIELD_EXIT" & _F|empty(M|qrtyp)
.continue EVEND
..
!BSTART
.continue ERROR1  ? M|vorgang=""
.continue ERROR1  ? M|vorgang^dnr  <> 3
.continue ERROR1  ? M|vorgang^ktyp <> 5
..
.formula M|select = M|vorgang^id
.continue EVEND
..
!KOZEI: Kodierzeile fÅr ESR neu generieren
... BetrÑge/Values
.formula   U|xrbetr      = M|vorgang^rebetr
.assign M|rebetr      = M|vorgang^rebetr
.assign M|rewaeh      = M|vorgang^land
.assign U|xtbetr      = 'M|rebetr'
.assign M|regbetr     = U|xtbetr << ","  ?  M|beinzahlsch
.assign M|rerbetr     = U|xtbetr >> ","  ?  M|beinzahlsch
.assign M|regbetr     = ""               ? _M|beinzahlsch
.assign M|rerbetr     = ""               ? _M|beinzahlsch
.assign M|qrbetrag   = M|vorgang^rebetr  ?  M|beinzahlsch
.formula M|qrbetrag   = 0                ? _M|beinzahlsch
..
.. öbergabevariablen
.formula U|xtnum  = M|vorgang^nummer
.formula U|xtkd   = M|vorgang^kunde^nummer
.formula U|xbesr  = M|beinzahlsch
.. Identifikation der Bank
.formula U|xtbankid = M|vorgang^fabverb^bank^ident
.. Teilnehmernummer wird in dieser Schreibweise
.. fÅr den Zahlschein benîtigt 01-1613-8
.formula U|xtlnnr    = M|zstlnnr
..
.input "vk/KOZEI.ESR"
.. RÅckgabewerte fÅr die Maske
.formula M|zskodzeile  = U|xtzs1
.formula M|zs2kodzeile = U|xtzs2
.continue  EVEND
..
!QRCODE
.input "vk/ZAHLSCHEIN.TAB"
.continue  EVEND
..
!LEERQRFELDER
.formula M|zsrefnr = ""
.formula M|zstlnnr = ""
.formula M|zstlnnr = ""
.formula M|zskodzeile = ""
.formula M|zs2kodzeile = ""
.formula M|rebetr = 0
.formula M|rewaeh = ""
.formula M|regbetr = ""
.formula M|rerbetr = ""
.formula M|bank = ""
.formula M|baplz = ""
.formula M|baort = ""
..
.formula M|qrtyp = ""
.formula M|qrcoding = ""
.formula M|qrversion = ""
.formula M|qriban = ""
.formula M|qrnameemp = ""
.formula M|qrstrempf = ""
.formula M|qrhausnumemp = ""
.formula M|qrplzempf = ""
.formula M|qrortempf = ""
.formula M|qrlandemf = ""
.formula M|qrurlt = ""
.formula M|qrcode = ""
.formula M|qrbetrag = 0
.formula M|qrrewaeh = ""
.formula M|qrdatum = ""
.formula M|qrnameend = ""
.formula M|qrstrend = ""
.formula M|qrhausnumend = ""
.formula M|qrplzend = ""
.formula M|qrortend = ""
.formula M|qrlandend = ""
.formula M|qrreferenztyp = ""
.formula M|qrreferenz = ""
.formula M|qrzusatzinfo = ""
.formula M|zeadrtyp = ""
.formula M|ezpadrtyp = ""
.continue  EVEND
..
!EVEND
.continue
..
!ERROR1
.error -field M|vorgang -message Bitte Verkaufsvorgang wÑhlen.
.end 1


