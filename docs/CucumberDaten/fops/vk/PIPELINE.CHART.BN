..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PIPELINE.CHART.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Zeigt Diagramme.
.. Functionality  : Shows charts.
...Include        :
.. include vk/PIPELINE.ZEIGUMSNACHWAHR.BN
.. include vk/PIPELINE.ZEIGUMSVERTRET.BN
.. include vk/PIPELINE.ZEIGUMSBETREUER.BN
.. include vk/PIPELINE.ZEIGUMSAUDATUM.BN
..*****************************************************************************
.set trans -
..
.continue ERROR0 ? _G|grafik & _F|isFlagSet(82)
.continue ERROR1 ?  F|empty(M|tzeilen)
..
..------------------------------- Header --------------------------------------
.continue PROPLTY ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "zeigumsnachwahr"
.continue SALESMN ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "zeigumsvertret"
.continue STAFFER ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "zeigumsbetreuer"
.continue REMIND  ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "zeigumsaudatum"
..--------------------------------- Table  -------------------------------------
..==============================================================================
.continue END
..
!PROPLTY: Show chart "Totals according to propabilities"
.input "vk/PIPELINE.ZEIGUMSNACHWAHR.BN"
.continue END
..
!SALESMN: Show chart "Totals according to salesmen"
.input "vk/PIPELINE.ZEIGUMSVERTRET.BN"
.continue END
..
!STAFFER: Show chart "Totals according to staffer"
.input "vk/PIPELINE.ZEIGUMSBETREUER.BN"
.continue END
..
!REMIND: Show chart "Totals according to reminders"
.input "vk/PIPELINE.ZEIGUMSAUDATUM.BN"
.continue END
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR0: No GUI interface
.error -message Funktion nur unter abas GUI ausfÅhrbar
.continue BREAK
..
!ERROR1: No data to show
.chart -INIT
.error -message Das Diagramm ist leer, weil die Tabelle leer ist.
..
!BREAK
.end 1
