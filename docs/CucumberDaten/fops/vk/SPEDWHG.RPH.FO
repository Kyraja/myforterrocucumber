..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.RPH.FO
.. Author         : mh/calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : Report header: read adress data one time for later use 
..                  with all pack pieces
..*****************************************************************************
.set trans -
..
..<META M|='vk/SPEDWHG' >
..
..
..<BLOCK> Sender address / supplier Address (brief. description, factory, postal code, location)
..<META H|='P12:10' > 
.select add F|sysinfo(10, G|false)
.continue EFIRM   ? _G|mehr
.assign M|lians1    = H|ans   << ";" + ", " + 'H|plz' + " "  + (H|nort << ";")
.assign M|lians2    = H|ans   << ";" + ", " + 'H|str' + ", " + 'H|plz' + " " + (H|nort << ";")
.assign M|klians    = H|ans
.assign M|klistr    = H|str
.assign M|kliort    = H|nort 
.copy   M|kliduns   = H|duns
.formula M|kliiso2  = H|staat^iso2 
.formula M|kliplz   = H|plz
!EFIRM
.select -
..</BLOCK>
..
..<BLOCK> Customer adress from from (first) delivery note
..<META H|='P3:1' > 
.select sales 'M|vklsnr^id' ? _F|empty(M|vklsnr)
.select sales 'F|formatstr("$,,;@gruppe=23;@ablageart=(3);typ=(4);sped=={1}", M|vkspednr^id)' ?  F|empty(M|vklsnr)
.continue EKUANS  ? _G|mehr
..<META P|='P88:10' > 
.assign P|spr = H|warenempf^spr ? F|modifiable(P|spr) & _P|sprfoschutz
.formula M|kuans1    =  H|ans  << ";"                               ?  F|empty(H|ans2)
.formula M|kuans2    = 'H|plz'        + " " + (H|nort  << ";")      ?  F|empty(H|ans2)
.formula M|kuans1    =  H|ans2 << ";"                               ? _F|empty(H|ans2)
.formula M|kuans2    = 'H|plz2'       + " " + (H|nort2  << ";")     ? _F|empty(H|ans2)
.formula M|kempans   =  H|ans
.formula M|kempstr   =  H|str
.formula M|kempplz   =  H|plz
.formula M|kemport   =  H|nort  << ";"
.formula M|kempans   =  H|ans2                                      ? _F|empty(H|ans2)
.formula M|kempstr   =  H|str2                                      ? _F|empty(H|ans2) 
.formula M|kemport   =  H|nort2 << ";"                              ? _F|empty(H|ans2)
.formula M|kempplz   =  H|plz2                                      ? _F|empty(H|ans2)
.formula M|kduns     =  H|kunde^duns
.formula M|kfrzeich  =  H|frzeich
.formula M|kwerk     =  H|werk
.formula M|linr      =  H|reempf^frbez
.formula M|kempstaat =  H|staat^iso2
!EKUANS
.select -
..</BLOCK>
..
..<BLOCK> Customize data without individualizing infosystem
.input "SPEDWHG.FOPKOPF.FO"  ?  _F|empty(F|foppath("SPEDWHG.FOPKOPF.FO")) & _M|kbnurstandardefop
..</BLOCK>
..
..*****************************************************************************
!END
.continue
