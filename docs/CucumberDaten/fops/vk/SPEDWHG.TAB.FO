..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.TAB.FO
.. Author         : calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : add business data depending on to-be-printed layout
.. 
...Includes       :
..  include dfue/CODE39.PRUEF
..  include vk/SPED.GEWICHT.TAB
..  include vk/SPEDWHG.TAB.BMW.FO
..  include vk/SPEDWHG.TAB.DAIMLER.FO
..  include vk/SPEDWHG.TAB.GM.GTL.FO
..  include vk/SPEDWHG.TAB.VDA.4902.FO
..  include vk/SPEDWHG.TAB.VDA.4992.FO 
..  include vk/SPEDWHG.TAB.VDA.4994.FO
..  include vk/SPEDWHG.TAB.VW.GTL.FO
..*****************************************************************************
.set trans -
..
..<META M|='vk/SPEDWHG' >
.. sales item with packaging mateiral
..<META H|='P3:2' >
.. sales item for product
..<META 2|='P3:2' >
.. sales header (packing slip)
..<META 5|='P3:1' > 
.. shipping order
..<META 7|='P55:1' > 
..
.formula M|tliefnr = M|linr
..
.copy M|twerk     = 5|werk
.copy M|tkuablade = 5|ablstelle
.copy M|tlagerort = 5|laortku
..
.. Daten vom Lieferanten
.copy M|tlians1 = M|lians1
.copy M|tlians  = M|klians
.copy M|tlistr  = M|klistr
.formula M|tlians4 = ""
.formula M|tliemail = ""
..
.. Lieferanschrift (ungeschickte Feldnamen!) = Empfaenger
.copy M|tliort  = M|kemport
.copy M|tliplz  = M|kempplz
..
.. Daten zum Artikel
.continue NOPROD ? _F|defined(2|id)
.add 2|artikel
.formula M|tartbez     = 'D|vbez.P|ksi'<<";"
.formula M|tvbrstelle  = 2|zvbrstelle  
.formula M|tartzei     = 2|konstaend          
.formula M|tkanban     = 2|kanbannr             
.formula M|turlandiso2 = D|urland^iso2
.add
!NOPROD
..
.. --- VDA 4902 --------- ---------- -------------------------------------------
.input "SPEDWHG.TAB.VDA.4902.FO"  ? M|tlayout^such = "ISVDA4902K"      
.input "SPEDWHG.TAB.VDA.4902.FO"  ? M|tlayout^such = "ISVDA4902G"     
.input "SPEDWHG.TAB.VDA.4902.FO"  ? M|kballeformate      
.. --- VDA 4902 variants ------------------- --------------------------------
.input "SPEDWHG.TAB.DAIMLER.FO"   ? M|tlayout^such = "DAIMLER"    
.input "SPEDWHG.TAB.DAIMLER.FO"   ? M|kballeformate  
.. ----------- ---------- ---------- -------------------------------------------
.input "SPEDWHG.TAB.BMW.FO"       ? M|tlayout^such = "ISBMWVDA4902G"   
.input "SPEDWHG.TAB.BMW.FO"       ? M|tlayout^such = "ISBMWVDA4902K"
.input "SPEDWHG.TAB.BMW.FO"       ? M|kballeformate                                
.. --- VW GTL  ---------- ---------- -------------------------------------------
.input "SPEDWHG.TAB.VW.GTL.FO"    ? M|tlayout^such = "GTL-GROSS-VW"
.input "SPEDWHG.TAB.VW.GTL.FO"    ? M|tlayout^such = "GTL-KLEIN-VW"
.input "SPEDWHG.TAB.VW.GTL.FO"    ? M|kballeformate
.. --- GM GTL  ---------- ---------- -------------------------------------------
.input "SPEDWHG.TAB.GM.GTL.FO"    ? M|tlayout^such = "GTL-GROSS-GM"
.input "SPEDWHG.TAB.GM.GTL.FO"    ? M|tlayout^such = "GTL-KLEIN-GM"
.input "SPEDWHG.TAB.GM.GTL.FO"    ? M|kballeformate
.. --- VDA GTL 4994 ----- ---------- -------------------------------------------
.input "SPEDWHG.TAB.VDA.4994.FO"  ? M|tlayout^such = "GTL-GROSS-4994"  
.input "SPEDWHG.TAB.VDA.4994.FO"  ? M|tlayout^such = "GTL-KLEIN-4994"                              
.input "SPEDWHG.TAB.VDA.4994.FO"  ? M|kballeformate
.. --- VDA GTL 4994 ----- ---------- -------------------------------------------
.input "SPEDWHG.TAB.VDA.4992.FO"  ? M|tlayout^such = "VDA-4992"
.input "SPEDWHG.TAB.VDA.4992.FO"  ? M|kballeformate
.. ----------- ---------- ---------- -------------------------------------------
..
.. Customize data without individualizing infosystem
.input "SPEDWHG.FOPZEILE.FO"  ?  _F|empty(F|foppath("SPEDWHG.FOPZEILE.FO")) & _M|kbnurstandardefop
..
.formula M|kanzgross = M|kanzgross + 1  ? M|tlayout^pformat^nummer = "14006"
.formula M|kanzklein = M|kanzklein + 1  ? M|tlayout^pformat^nummer = "14007"
..
..*****************************************************************************
!END
.continue
