..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.TAB.GM.GTL.FO
.. Author         : calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : 
..*****************************************************************************
.set trans -
..
..
..<META M|='vk/SPEDWHG' >
..
.. sales item with packaging mateiral
..<META H|='P3:2' >
.. sales item for product
..<META 2|='P3:2' >
.. blanket order item for product
..<META 3|='P3:1.2' >
.. sales header (packing slip)
..<META 5|='P3:1' > 
.. shipping order
..<META 7|='P55:1' > 
..
..
..*****************************************************************************
.. FIELD DATA
..*****************************************************************************
..
.type text    day   ? _F|defined(U|day)
.type integer month ? _F|defined(U|month)
.type integer year  ? _F|defined(U|year)
..
.. DUNS is printed without hypen in license plate
.type text   xtDUNSnohyphen  ? _F|defined(U|xtDUNSnohyphen)
.formula U|xtDUNSnohyphen = F|regreplaceall('M|kliduns', "-", "")
..
!GM: general motors (opel)
..
..
.. A1
..
.formula M|tlimadein = "MADE IN " + M|turlandiso2  ? _F|empty(M|turlandiso2)
..
.. A2
.formula M|tkuans1 = M|kempans
.formula M|tempstr = M|kempstr
.formula M|temport = M|kemport
..
.. A3, B1,
..
.. B2
.formula M|tmathandl      = M|tvbrstelle
..
.. B3, C
.. filled in with Java
..
.. D1
.. filled in with Java 
..
.. D2
.formula U|day    =  ("00" + 'F|day(H|kopf^vom)') >>2
.formula U|month  =  F|month(H|kopf^vom)
.formula U|year   =  F|year(H|kopf^vom)
.formula M|tlsvom = 'U|day' + "JAN" + 'U|year' ? U|month=1
.formula M|tlsvom = 'U|day' + "FEB" + 'U|year' ? U|month=2
.formula M|tlsvom = 'U|day' + "MAR" + 'U|year' ? U|month=3
.formula M|tlsvom = 'U|day' + "APR" + 'U|year' ? U|month=4
.formula M|tlsvom = 'U|day' + "MAY" + 'U|year' ? U|month=5
.formula M|tlsvom = 'U|day' + "JUN" + 'U|year' ? U|month=6
.formula M|tlsvom = 'U|day' + "JUL" + 'U|year' ? U|month=7
.formula M|tlsvom = 'U|day' + "AUG" + 'U|year' ? U|month=8
.formula M|tlsvom = 'U|day' + "SEP" + 'U|year' ? U|month=9
.formula M|tlsvom = 'U|day' + "OCT" + 'U|year' ? U|month=10
.formula M|tlsvom = 'U|day' + "NOV" + 'U|year' ? U|month=11
.formula M|tlsvom = 'U|day' + "DEC" + 'U|year' ? U|month=12
..
.. E1
.. free area for supplier
..
.. E2
.formula M|tpus = 2|labnr
.formula M|tpus = M|tlsnr^nummer ? F|empty(M|tpus)
..
.. A3, D1: 2D barcodes
.continue EDUNSGM                                                       ?  F|empty(U|xtDUNSnohyphen)
.. note: different whitespaces for license plate and 2d-barcode
.formula M|tlicensepl = "UN " + U|xtDUNSnohyphen + " " + 'M|tlspcknr'
.formula M|t1jbarcode = "1J"  + M|tlicensepl
!EDUNSGM
.continue MIXED
..
..
!MIXED
.. clear  content related data fields, if "mixed label"
.continue EMIXED                                                     ?  M|tlayoutx <> "G"
.. clear product data
.formula M|tartkuartnr   = ""
.formula M|tartzei       = ""
.formula M|tlsartchg     = ""
.formula M|tpacksucherw  = ""
!EMIXED
..

..
..*****************************************************************************
.. BARCODES
..*****************************************************************************
..
..
..  2D-Barcode -- GTL GM --
..
.continue NOGTLGM ? _F|defined(U|xtDUNSnohyphen)
.continue NOGTLGM ?  F|empty(U|xtDUNSnohyphen)
..
.. Control characters are converted to controls in jasper!
.type text xtfact ? _F|defined(U|xtfact)
.type text xtrs   ? _F|defined(U|xtrs)
.type text xtgs   ? _F|defined(U|xtgs)
.type text xteot  ? _F|defined(U|xteot)
.formula U|xtfact = "06"
.formula U|xtrs   = "-RS-"
.formula U|xtgs   = "-GS-"
.formula U|xteot  = "-EOT-"
..
.. Compose barcode data
.type text xt ? _F|defined(U|xt)
.formula U|xt = U|xtrs + U|xtfact
.formula U|xt = U|xt + U|xtgs  + "P"      +  M|tartkuartnr
.formula U|xt = U|xt + U|xtgs  + "Q"      + 'M|tfmenge'
.formula U|xt = U|xt + U|xtgs  + "1J"     + "UN" + U|xtDUNSnohyphen + " " + 'M|tlspcknr'
.formula U|xt = U|xt + U|xtgs  + "20L"    +  M|tmathandl  ? _F|empty(M|tmathandl)
.formula U|xt = U|xt + U|xtgs  + "21L"    +  M|kwerk + " " + M|tkuablade
.formula U|xt = U|xt + U|xtgs  + "K"      +  M|kfrzeich
.formula U|xt = U|xt + U|xtgs  + "15K"    +  M|tkanban
.formula U|xt = U|xt + U|xtgs  + "B"      +  M|tpackkuartnr
.formula U|xt = U|xt + U|xtgs  + "7Q"     + 'M|tgewbrutto' + "GT"
.formula U|xt = U|xt + U|xtgs  + "2S"     +  M|tpus
.formula U|xt = U|xt + U|xtrs  + U|xteot
..
.. Hide control values when displaying in info system
.type text xtregex ? _F|defined(U|xtregex)
.formula U|xtregex = U|xtrs+U|xtfact+"|"+U|xtrs+"|"+U|xtgs+"|"+U|xteot
.continue DMCSIZE ? +U|xt > 255
.formula M|tgmdmccode = U|xt
.formula M|tgmdmc = F|regreplaceall(U|xt, U|xtregex, "")
..
..
!NOGTLGM
.continue
..
..
..*****************************************************************************
!END
.continue
..
!DMCSIZE
.error Die Daten fÅr den Data Matrix Code sind zu lang.      
.end 1
