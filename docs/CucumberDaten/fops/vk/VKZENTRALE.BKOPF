..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZENTRALE.BKOPF
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.type realx  xamount     ? _F|defined(U|xamount)
.type realx  xramount    ? _F|defined(U|xramount)
.type realx  xbetrag     ? _F|defined(U|xbetrag)
.type realx  xrkurs      ? _F|defined(U|xrkurs)
.type ID94:1 xiwbu       ? _F|defined(U|xiwbu)
.type ID94:1 xland       ? _F|defined(U|xland)
.type ID94:1 xauswaehr   ? _F|defined(U|xauswaehr)
.type RP7.6  xrate       ? _F|defined(U|xrate)
.type IP1    xrundung    ? _F|defined(U|xrundung)
.type realx  xiwbuamount ? _F|defined(U|xiwbuamount)
.type realx  xpreis      ? _F|defined(U|xpreis)
.type ARTR51100 xmge     ? _F|defined(U|xmge)
..
.make screen line +O
.formula M|tstufe = 0
.copy M|topen = M|iopen
.copy M|tfold = G|TRUE
.copy M|ttyp1 = M|typ2a ? H|typ = 36 & _H|ablagef
.copy M|ttyp1 = M|typ2b ? H|typ = 36 &  H|ablagef
.copy M|ttyp2 = M|typ2a ? H|typ = G|ANKO & _H|ablagef
.copy M|ttyp2 = M|typ2b ? H|typ = G|ANKO &  H|ablagef
.copy M|ttyp2 = M|typ2a ? H|typ = 33 & _H|ablagef
.copy M|ttyp2 = M|typ2b ? H|typ = 33 &  H|ablagef
.copy M|ttyp3 = M|typ2a ? H|typ = 3  & _H|ablagef
.copy M|ttyp3 = M|typ2b ? H|typ = 3  &  H|ablagef
.copy M|ttyp2a= M|typ2a ? H|typ = G|RAKO & _H|ablagef
.copy M|ttyp2a= M|typ2b ? H|typ = G|RAKO &  H|ablagef
.copy M|ttyp2 = M|typ2a ? H|typ = 31 & _H|ablagef
.copy M|ttyp2 = M|typ2b ? H|typ = 31 &  H|ablagef
.copy M|ttyp3 = M|typ2a ? H|typ = 34 & _H|ablagef
.copy M|ttyp3 = M|typ2b ? H|typ = 34 &  H|ablagef
.copy M|ttyp4 = M|typ2a ? H|typ = 4  & _H|ablagef
.copy M|ttyp4 = M|typ2b ? H|typ = 4  &  H|ablagef
.copy M|tlsart= H|lsart ? H|typ = 4
.copy M|ttyp5 = M|typ2a ? H|typ = 5  & _H|ablagef
.copy M|ttyp5 = M|typ2b ? H|typ = 5  &  H|ablagef
.copy M|tvorganga = H|vorganga ? H|typ = 5
.copy M|ttyp3 = M|typ2a ? H|typ = 35 & _H|ablagef
.copy M|ttyp3 = M|typ2b ? H|typ = 35 &  H|ablagef
.protection brerelease 'M|aktzeile'   ? H|typ <> 3 & H|typ <> 34
.protection brerelease 'M|aktzeile'   ? (H|typ = 3 ; H|typ = 34)  & H|ablagef
.assign M|uebertr = H|uebertr
.copy M|noablage = H|noablage
.formula M|wahrsch = H|wahrsch        ? H|typ = 36
.assign M|ablehngrund = H|ablehngrund ? H|typ = 36
.assign M|ttrans = H|id
.formula M|wahrsch = H|wahrsch
.formula M|gltvon = H|gltvon
.formula M|gltbis = H|gltbis
.formula M|audatum = H|audatum
.formula M|ttyp4 = M|storno    ? M|ttrans^typ = 4 & (F|equals(H|lsart, "(CancelationCustomerDelivery)") ; F|equals(H|lsart, "(PackingSlipReversal)") ; F|equals(H|lsart, "(CancelationReturnPackingSlip)"))
.formula M|ttyp4 = M|storniert ? M|ttrans^typ = 4 & (F|equals(H|lsart, "(CanceledCustomerDelivery)") ; F|equals(H|lsart, "(PackingSlipCanceled)") ; F|equals(H|lsart, "(CanceledReturnPackingSlip)"))
.formula M|ttyp5 = M|storno    ? M|ttrans^typ = 5 & (F|equals(H|vorganga, "(CancelationCreditNoteCommercial)") ; F|equals(H|vorganga, "(InvoiceReversal)"))
.formula M|ttyp5 = M|storniert ? M|ttrans^typ = 5 & (F|equals(H|vorganga, "(CanceledCreditNoteCommercial)") ; F|equals(H|vorganga, "(InvoiceCanceled)"))
.assign M|stornopartnervorg = H|stornopartnervorg
.copy M|tkritisch = M|aktkritisch
.assign M|sterm = M|aktsterm
.formula M|tref = H|frzeich
.formula M|tzeich = H|zeich
.formula M|tbetreff = H|betreff
.copy M|tauswaehr = M|auswaehr
.formula M|tdate = H|vom
.copy M|tkuli = H|kunde
.copy M|treku = H|reempf
.copy M|bruttore = H|brutto
..
.. Icon setzen: Originalvorgang
.load 5 sales 'F|formatstr("$,,;okopf=={1};@gruppe=2;@ablageart=(Both);@maxtreffer=1", H|id)'
.formula M|topen = "" ? _G|mehr
.continue NOTMORE     ? _G|mehr
.load 5
..
!NOTMORE
.copy M|tdetail = M|detail1
.copy M|trelease = M|release                     ? _H|ablagef
.formula M|trelease    = ""                      ?  H|typ = 5
.formula M|trelease    = ""                      ?  H|typ = 4  &  H|aeob
.formula M|trelease    = ""                      ?  H|typ = 31 &  H|vsperre
.formula M|tpost       = ""
.copy M|tpost = M|show                           ? _H|ablagef
.copy M|tpost = M|post                           ?  H|uebertr
.formula U|xramount    = 0
.copy M|tpland = H|land
.assign M|tnpwert = H|sumnetto
..
.. Umrechnungen
.formula U|xrundung = M|auswaehr^nkst
.assign U|xrkurs = H|kurs
.copy U|xiwbu = H|iwbu
.copy U|xland = H|land
.copy U|xauswaehr = M|auswaehr
.formula U|xrate = F|fxrate(M|auswaehr,H|budat,H|iwbu)
..
!ZEILE
.select line
.continue TOTAL ? _G|mehr
..
.formula U|xbetrag  = F|round(U|xramount,U|xrundung)
.formula U|xramount = H|npwert
..
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = U|xrate*U|xiwbuamount ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
..
.formula U|xramount   = U|xbetrag + F|round(U|xramount, U|xrundung)
.formula U|xramount   = U|xbetrag ? H|typ = 16 ; H|typ = 19 ; H|typ = 8 ; H|typ = 9 ; H|typ = 10
..
.. Bruttorechnungen sind bei Endsumme zu ende
.continue TOTAL ? (H|typ = 16 ; H|typ = 19) & H|kobrutto
.continue ZEILE ? H|ablagef
.continue ZEILE ? H|art^gruppe <> 1
.continue ZEILE ? H|kotyp <> 4
.continue ZEILE ? H|mge <= 0
..
.. wenn LS bereits gebucht, dann keine Kontrolle auf Lagerplatz n”tig
.continue ZEILE ? H|kopf^uebertr = G|FALSE
..
.. Einzelmenge auf einem Platz / Single quantities in one location
.load 0 group "40:3" 'F|formatstr("$,,;artikel={1};platz={2};@ablageart=(Active)", H|art^id, H|platz^id)'
.continue KEINLMGE ? _G|mehr
..
.. Vorgangsmenge in Lagereinheit
.formula U|xmge = H|mge * H|lehe
.continue ZEILE   ?  0|bestand >= U|xmge
..
!KEINLMGE: Kein Lagerbestand oder Lagerbestand kleiner als Liefermenge
.copy M|tshort = M|short
.continue ZEILE
..
!TOTAL: Summen
.formula U|xamount = M|ttrans^sumnetto
..
.formula U|xrate       = F|fxrate(M|auswaehr,M|ttrans^budat,M|ttrans^iwbu)
.formula U|xiwbuamount = U|xamount/U|xrkurs
.formula U|xamount     = U|xiwbuamount         ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.formula U|xamount     = U|xamount             ? U|xauswaehr = U|xland
.formula U|xamount     = U|xrate*U|xiwbuamount ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
..
.formula M|teprice = U|xamount
.formula M|tot = M|tot + U|xamount
..
.continue
