..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABLEHNVORKOMMEN.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Ausfuehren der Anfragen und Behandlung der Treffer.
.. Functionality  : Does queries and handles hits.
..*****************************************************************************
.set trans -
..
.. Reinitialize counter
.input "vk/ABLEHNVORKOMMEN.BK"
..
.. Clear table
.input "is/TABLEEREN"
..
.. Query each rejection
.load 0 object 'M|azablehnungsgrund^id'
.continue FOOTER  ? _G|mehr
.continue EMPTY   ?  0|leerok
..
!NEXTROW
.load 0 line
.continue FOOTER  ? _G|mehr
.copy M|aktablehngrund = 0|vaufzelem
.formula M|select = F|formatstr("{1};ablehngrund={2}",M|preselect, M|aktablehngrund^id)
..
!QUERY: Create an empty row for each rejection and query database
.make screen line +O
.copy M|tvktypa = M|aktvktyp
.assign M|tablehngrund = M|aktablehngrund
.copy M|tabseinheit = M|abseinheit
.copy M|treleinheit = M|releinheit
.copy M|tinland = G|inland
.copy M|tselect = M|select
..
.input "is/HOL.LISTE"
..
.formula M|stufe = M|stufe + 1
.copy M|tabsvorkommen = M|sumabs
.formula M|absvorkommen = M|absvorkommen + M|tabsvorkommen
.continue REPSUMS ? M|stufe > 1
..
.. Initialize max and min
.copy M|absmaxablehn = M|tabsvorkommen
.copy M|absminablehn = M|tabsvorkommen
..
!REPSUMS: Report sums
.copy M|absmaxablehn = M|tabsvorkommen ? M|tabsvorkommen > M|absmaxablehn
.copy M|absminablehn = M|tabsvorkommen ? M|tabsvorkommen < M|absminablehn
.continue REINIT ? _M|zeigwerte
.copy M|tnettowert = M|sumnetto
.formula M|wertabsvorkommen = M|wertabsvorkommen + M|tnettowert
..
!REINIT
.assign M|aktvktyp = ""
.assign M|sumabs = 0
.assign M|sumnetto = 0.0
.continue NEXTROW
..
!EMPTY: Enum has empty row
.assign M|aktablehngrund = ""
.formula M|select = F|formatstr("{1};ablehngrund=`",M|preselect)
.continue QUERY
..
!FOOTER: Report footer
.load 1
.input "vk/ABLEHNVORKOMMEN.BF"
..*****************************************************************************
!END
.continue
