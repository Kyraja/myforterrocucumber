..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : FOP.106.EV
..  Datum          : 01.02.2005
..  Version        :
..  Autor          : ok
..  Verantwortlich : mh
..  Kontrolle      : cl
..
..  Funktion       : Packanweisung, alle Events
..
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#PACK#01.02.2005#0#ok#
..*****************************************************************************
..
.set trans -
..
..-----------------------------------------------------------------------------
.. Kopfteil
..-----------------------------------------------------------------------------
..
.continue UEB    ? evtartengl="FIELD_EXIT"      & evtvar   ="art"
.continue MEIN   ? evtartengl="SCREEN_ENTER"        & evtkommd= G|kaktname13
.continue ZEIN   ? evtartengl="ROW_INSERTION_AFTER" & evtkommd= G|kaktname13
.continue KEEIN  ? evtartengl="FIELD_EXIT"      & evtvar   ="schl"
.continue
..
!UEB
.formula M|packmitken = M|art^packmitken
.set reference +
.formula M|schl       = "(3)"          ?  M|art^packmitken="S" & M|schl=""
.formula M|schl       = "(3)"          ?  M|art^packmitken="M" & M|schl=""
.set reference -
.formula M|anzahl     = 1    ? M|anzahl   = 0
.protection ebene    'M|aktzeile'     ?  M|art^packmitken=""
.protection minebene 'M|aktzeile'     ?  M|art^packmitken=""
.protection mitwanh  'M|aktzeile'     ?  M|art^packmitken=""
.protection auffuell 'M|aktzeile'     ?  M|art^packmitken=""
.continue BOX                       ? _M|art^packmit & M|art<>""
.continue
..
!MEIN
.select screen header
!MEZEILE
.select screen line
.end ? _mehr
.set reference +
.protection mitwanh 'M|aktzeile'    ? M|schl <> "(1)" ; M|aktzeile<>1
.set reference -
.formula M|packmitken = M|art^packmitken
.set reference +
.formula M|schl       = "(3)"                      ?  M|art^packmitken="S" & M|schl=""
.formula M|schl       = "(3)"                      ?  M|art^packmitken="M" & M|schl=""
.set reference -
.formula M|anzahl     =  1                        ? M|anzahl   = 0
.protection ebene    'M|aktzeile'     ? M|art^packmitken=""
.protection minebene 'M|aktzeile'     ? M|art^packmitken=""
.protection mitwanh  'M|aktzeile'     ? M|art^packmitken=""
.protection auffuell 'M|aktzeile'     ? M|art^packmitken=""
.continue MEZEILE
..
!KEEIN
.set reference +
.protection -reset mitwanh 'M|aktzeile' ? M|schl="(1)"
.set reference -
.continue
..
!ZEIN
.protection mitwanh 'M|aktzeile'
.continue
..
!BOX
.box
Es sind nur Packmittel erlaubt !
.formula M|art = ""
.continue


