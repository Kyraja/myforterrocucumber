..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZENTRALE.TAB
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Eingaben und formuliert die Datenbankanfrage.
.. Functionality  : Validates inputs and defines database query.
..*****************************************************************************
.set trans -
..
.continue ERROR01   ?  F|empty(M|vktyp)
..
.formula M|tot = 0.0
..
.. Build query
.formula M|select = "$,,"
..
.. Type of document
.formula M|select = M|select + ";ktyp=" + F|value(M|vktyp, "AS163")
.continue SHORT ? _F|equals(M|vktyp, "(PackingSlip)")
.continue ERROR02 ? _M|kuebertr & _M|knuebertr
.formula M|select = M|select + ";uebertr=1" ? M|kuebertr & _M|knuebertr
.formula M|select = M|select + ";uebertr=0" ? M|knuebertr & _M|kuebertr
..
!SHORT: Short text
.formula M|select = M|select + ";vorgartaz=" + M|ivorgart
.. die alte vorgart kann dann raus
.continue CUSTOM ? F|empty(M|vorgart)
.formula M|select = M|select + ";vorgart=" + M|vorgart^id
..
!CUSTOM: Contact customer
.continue INVOICE ? F|empty(M|kuli)
.formula M|select = M|select + ";kl=" + M|kuli^id
..
!INVOICE: Customer which gets the invoice
.continue REPRSNT ? F|empty(M|reku)
.formula M|select = M|select + ";reempf=" + M|reku^id
..
!REPRSNT: Representative
.continue STAFFER ? F|empty(M|rep)
.formula M|select = M|select + ";vertret=" + M|rep^id
..
!STAFFER: Staff personnel
.continue SYMBOL ? F|empty(M|betreuer)
.formula M|select = M|select + ";betreuer=" + M|betreuer^id
..
!SYMBOL: Symbol of staffer
.continue YOURREF ? F|empty(M|kzeich)
.formula M|select = M|select + ";zeich==" + M|kzeich
..
!YOURREF: Your reference
.continue NUMBER ? F|empty(M|ref)
.formula M|select = M|select + ";frzeich/" + M|ref
..
!NUMBER: Number or searchword
.continue DOCDATE ? F|empty(M|docf) & F|empty(M|doct)
.formula M|select = M|select + ";@numsuch="  + M|docf + "!" + M|doct
..
!DOCDATE: Date of document
.continue KPROJEKT ? F|empty(M|datef) & F|empty(datet)
.formula M|select = M|select + ";vom==" + 'M|datef:8'                     ? 'M|datef:8' = 'M|datet:8'
.formula M|select = M|select + ";vom=" + 'M|datef:8' + "!" + 'M|datet:8'  ? 'M|datef:8' <> 'M|datet:8'
..
!KPROJEKT: Project
.continue PACKING ? F|empty(M|kprojekt) & F|equals(M|vktyp, "(PackingSlip)")
.continue FILING  ? F|empty(M|kprojekt)
.formula M|select = M|select + ";kprojekt=" + 'M|kprojekt^id' 
.continue FILING  ? _F|equals(M|vktyp, "(PackingSlip)")
..
!PACKING
.formula M|select = M|select + ";lsart=" + F|value(M|lsart, "AS327")
..
!FILING
.formula M|select = M|select + ";@ablageart=" + F|value(M|ablageart, "AS193")
..
.type bool xcritdoc ? _F|defined(U|xcritdoc)
.copy U|xcritdoc = G|FALSE
..
.. Add certain sort order
.continue ORDDEFL ? _M|kkritisch
.continue ORDREVW ? F|equals(M|vktyp, "(BlanketOrder)")
.continue ORDREVW ? F|equals(M|vktyp, "(Quotation)")
.continue ORDREVW ? F|equals(M|vktyp, "(WebOrder)")
.continue ORDREVW ? F|equals(M|vktyp, "(Opportunity)")
.continue ORDDATE ? F|equals(M|vktyp, "(PackingSlip)")
.continue ORDDATE ? F|equals(M|vktyp, "(SalesOrder)")
.continue ORDDEFL
..
!ORDREVW: Order is date of review
.formula M|select = M|select + ";@ordnung=tterm"
.continue CRITDOC
..
!ORDDATE: Order is date of document
.formula M|select = M|select + ";@ordnung=vom"
.continue CRITDOC
..
!ORDDEFL: Default order is number of document
.formula M|select = M|select + ";@ordnung=nummer"
..
!CRITDOC: Has document critical type?
.continue CRITCAL ? F|equals(M|vktyp, "(BlanketOrder)")
.continue CRITCAL ? F|equals(M|vktyp, "(Quotation)")
.continue CRITCAL ? F|equals(M|vktyp, "(WebOrder)")
.continue CRITCAL ? F|equals(M|vktyp, "(Opportunity)")
.continue CRITCAL ? F|equals(M|vktyp, "(PackingSlip)")
.continue CRITCAL ? F|equals(M|vktyp, "(SalesOrder)")
.continue QUERY
..
!CRITCAL
.copy U|xcritdoc = G|TRUE
..
!QUERY
.formula M|grliste = "3:1"
.select group  'M|grliste' 'M|select'
..
!CHECK
.continue END ? _G|mehr
.. nur reine LS kînnen kritisch sein (stornos, stornierte und RÅcklieferungen, Kundenanlieferungen nicht)
.copy U|xcritdoc = G|FALSE ? F|equals(H|typa, "(PackingSlip)") & _F|equals(H|lsart, "(PackingSlip)")
..
.copy M|aktkritisch = G|FALSE
.assign M|aktsterm = ""
.continue EXCLCRT ?  M|kkritisch
.continue TABLE   ? _U|xcritdoc
.continue TABLE   ? _F|empty(H|ablagen)
.continue CHCRIT
..
!EXCLCRT: Critical documents only
.continue NEXTDOC ? _U|xcritdoc
.continue NEXTDOC ? _F|empty(H|ablagen)
..
!CHCRIT: Look for critical documents, but filed documents are never critical
.type ID3:1 xdocument ? _F|defined(U|xdocument)
.type GD    xduedate  ? _F|defined(U|xduedate)
..
.assign U|xdocument = H|id
.copy U|xduedate = M|ktterm
..
.input 'M|kritischefop' ? _F|empty(M|kritischefop)
.continue NEXTDOC ? _F|defined(U|xcritical)
.continue NEXTDOC ? M|kkritisch & _U|xcritical
.copy M|aktkritisch = U|xcritical
.copy M|aktsterm = U|xshipdate ? F|defined(U|xshipdate)
..
!TABLE: Create table
.input 'M|bkopf'
..
!NEXTDOC: Load next document
.select continue
.continue CHECK
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Missing type of document!
.cursor vktyp 0
.error -field M|vktyp -message Bitte mindestens eine Vorgangsart auswÑhlen!
.end 1
..
!ERROR02: Missing parameter!
.cursor kuebertr 0
.error -field M|kuebertr -message Bitte mindestens einen Buchungstatus auswÑhlen!
.end 1
