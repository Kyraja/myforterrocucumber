..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.START.BA.FO
.. Author         : calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : 
..*****************************************************************************
.set trans -
..
..<META M|='vk/SPEDWHG' >
..
.. sales item with packaging mateiral
..<META H|='P3:2' >
.. sales item for product
..<META 2|='P3:2' >
.. sales header (packing slip)
..<META 5|='P3:1' > 
.. shipping order
..<META 7|='P55:1' > 
..
.copy M|kanzgross = 0
.copy M|kanzklein = 0
..
.. read shipping order
.load 7 nolock transportcompany 'M|vkspednr^id'
..
!HEADER
.input 'M|bkopf'
..
.. AJO EventHandler created all rows with structure information
.. The TAB efops add additional data for printing
.select screen head 
!NEXT
.select screen line
.continue FOOTER ? _G|mehr
.continue NEXT   ?  F|empty(M|tpospackmit)
..
.. M-buffer has ids from packreader structure evaluation, 
.. 2-buffer and h-buffer are used in FO to show additionall data
.. Since are several boxes for the same packmaterial row and the same 
.. product row, so we must avoid doing redundant database queries
.continue READ ? M|tzeilen=0 ; _F|defined(H|id) ; _F|defined(2|id)
.continue SHOW ? M|tpospackmit^id=H|id & M|tposartikel^id=2|id
..
!READ
.select nolock sales 'M|tpospackmit^id'
.continue NEXT ? _G|mehr
.load 2 nolock sales 'M|tposartikel^id'
.continue NEXT ? _G|mehr
.load 3 nolock sales 'F|formatstr("$,,;kopf={1};artikel={2};@gruppe=2", 2|zrahmen^id, 2|artikel^id)' ? _F|empty(2|zrahmen)
..
.continue READHD ? M|tzeilen=0 ; _F|defined(5|id)
.continue SHOW ? M|tlsnr^id = 5|id
!READHD
.load 5 nolock sales 'M|tlsnr^id' 
.. 
!SHOW
.input 'M|tab'
.continue NEXT
..
!FOOTER
.input 'M|bfuss'
..
..*****************************************************************************
!END
.continue
