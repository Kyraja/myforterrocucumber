..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SPEDSAMMEL.GEDRUCKT
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Entfernen der zu "Drucken" Kennzeichnung aus dem Speditionsauftrag
.. Functionality  : Removes print marker form shipping order
..*****************************************************************************
.set trans -
..
.. Preview, not printed yet
.continue END  ?  P|vorschau
..
.. Error while printing
.continue END  ? _F|empty(P|erg)
..
.. Shipping Order + Context
..  V V-119-1  (Shipping planning)
..  I SPEDAUO  (Shipping order book)
.type P55  xvshippingorder  ? _F|defined(U|xvshippingorder)
.formula U|xvshippingorder = ""
.assign U|xvshippingorder = M|sped^id          ?  F|defined(P|aktkontext^vdn)  &  F|defined(M|sped)
.assign U|xvshippingorder = M|vkspednr^id      ? _F|empty(P|aktinfosys)        &  F|defined(M|vkspednr)
.assign U|xvshippingorder = M|tidentnumber^id  ? _F|empty(P|aktinfosys)        &  F|defined(M|tidentnumber)

.. No shipping order?
.continue END  ?  F|empty(U|xvshippingorder)
..
.. Shipping order already had its "print" marker removed.
.continue END  ? _U|xvshippingorder^druck
..
.. Remove "print" marker from shipping order
.reserve
.select transportcompany lock nowait 'U|xvshippingorder^id'
.continue EDRUCK  ? _G|mehr
.continue EDRUCK  ? _G|gesperrt
.copy H|druck = G|false
.rewrite
.continue EDRUCK  ? _G|mehr
.select -
!EDRUCK
.select
..
..*****************************************************************************
!END
.continue
