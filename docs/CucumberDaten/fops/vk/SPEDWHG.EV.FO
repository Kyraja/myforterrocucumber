..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.EV.FO
.. Author         : mh/calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : Central eventhandling for infosystem SPEDWHG
..*****************************************************************************
.set trans -
..
..<META M|='vk/SPEDWHG' >
..
..<BLOCK> Variable definitions
.type P55:1 xvsped
.type P3:1 xvls
.type bool xballe
.type bool xbstandard
.type bool xbkompakt
.type bool xbdmc 
.type bool xbsortpastnr
.type GL25 xnumvon
.type GL25 xnumbis
.type PS88:3 xlayout
.type PS88:4 xpapier
.type bool xpapiergross
.type bool xpapierklein
.type bool xpapierA4
..</BLOCK>
..
..<BLOCK> Event Evaluation
.. ----------- ----- Events -------- -------------------------------------------
.continue SPED    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "vkspednr"
.continue LS      ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "vklsnr"
.continue PFORMAT ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kpformat"
.continue PFGROSS ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kpformatgross"
.continue PFKLEIN ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kpformatklein"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "klayout"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kpastnrvon"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kpastnrbis"
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kballeformate"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kbnurstandardefop"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kbdmcdrucken"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"      & G|evtvar = "kbkompakt"
.. ----------- ---------- ---------- -------------------------------------------
.continue FORBID  ? G|evtartengl = "ROW_INSERTION_BEFORE"
.continue FORBID  ? G|evtartengl = "ROW_DELETION_BEFORE"
.continue FORBID  ? G|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue
..</BLOCK>
..
..<BLOCK> Event: new shipping order
!SPED
.formula M|vklsnr  = "" ?  M|vklsnr^sped^id <> M|vkspednr^id  &  _F|empty(M|vkspednr)
.continue INIT
..</BLOCK>
..
..<BLOCK> Event: new delivery note
!LS: 
.assign M|vkspednr = M|vklsnr^sped^id  ? _F|empty(M|vklsnr)
.continue INIT
..</BLOCK>
..
..<BLOCK> Event: paper format ref field exit
!PFORMAT
.copy M|kpformatgross = G|false
.copy M|kpformatklein = G|false
.copy M|kpformatgross = G|true  ?  M|kpformat^nummer = "14006"
.copy M|kpformatklein = G|true  ?  M|kpformat^nummer = "14007"
.continue INIT
..</BLOCK>
..
..<BLOCK> Event: paper format BIG bool field exit
!PFGROSS
.copy M|kpformatklein = G|false
.formula M|kpformat = "" ? _M|kpformatgross
.formula M|kpformat = "14006" ? M|kpformatgross 
.continue INIT
..</BLOCK>
..
..<BLOCK> Event: paper format SMALL bool field exit
!PFKLEIN
.copy M|kpformatgross = G|false
.formula M|kpformat = "" ? _M|kpformatklein
.formula M|kpformat = "14007" ? M|kpformatklein 
.continue INIT
..</BLOCK>
..
..<BLOCK> Event: a key field was changed, remove old rows
!INIT
.copy U|xvls   = M|vklsnr
.copy U|xvsped = M|vkspednr
.copy U|xballe = M|kballeformate
.copy U|xbstandard = M|kbnurstandardefop
.copy U|xbkompakt = M|kbkompakt
.copy U|xbdmc = M|kbdmcdrucken
.copy U|xnumvon = M|kpastnrvon
.copy U|xnumbis = M|kpastnrbis
.copy U|xlayout = M|klayout
.copy U|xpapier = M|kpformat
.copy U|xbsortpastnr = M|kbpastnrsort 
.copy U|xpapiergross = M|kpformatgross
.copy U|xpapierklein = M|kpformatklein
.copy U|xpapierA4 = M|kpformatA4
.input "is/KOPFLEEREN"
.copy M|kballeformate = U|xballe
.copy M|kbnurstandardefop = U|xbstandard
.copy M|kbkompakt = U|xbkompakt
.copy M|kbdmcdrucken = U|xbdmc
.copy M|vklsnr = U|xvls
.copy M|vkspednr = U|xvsped
.copy M|kpastnrvon = U|xnumvon 
.copy M|kpastnrbis = U|xnumbis 
.copy M|klayout = U|xlayout
.copy M|kpformat = U|xpapier
.copy M|kbpastnrsort = U|xbsortpastnr  
.copy M|kpformatgross = U|xpapiergross
.copy M|kpformatklein = U|xpapierklein
.copy M|kpformatA4 = U|xpapierA4
.make screen line -- ? M|tzeilen > 0
.continue END
..</BLOCK> 
..
..<BLOCK> Event: an event was triggered, which is not allowed
!FORBID: 
.error
.end 1
..</BLOCK>
..
..*****************************************************************************
!END
.continue
