..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.TAB.VW.GTL.FO
.. Author         : calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : fill data fields for label GTL VW
..*****************************************************************************
.set trans -
..
..
..<META M|='vk/SPEDWHG' >
..
.. sales item with packaging mateiral
..<META H|='P3:2' >
.. sales item for product
..<META 2|='P3:2' >
.. blanket order item for product
..<META 3|='P3:1.2' >
.. sales header (packing slip)
..<META 5|='P3:1' > 
.. shipping order
..<META 7|='P55:1' > 
..
..
..*****************************************************************************
.. FIELD DATA
..*****************************************************************************
....
.type integer     U|xint ? _F|defined(U|xint)
..
.. A1
..
.. A2
.formula M|tkuans1        = M|kempans
.formula M|tempstr        = M|kempstr
.formula M|temport        = M|kemport
.formula M|twerk          = M|kwerk
..
.. B1
.. filled by AJO eventhandler
..
.. B2
.formula M|tvbrstelle     = 5|vbrstelle 
..
.. C
.. filled by AJO eventhandler
..
.. D2
.formula M|tlsvom = "D" + " " + '5|vom:8'<<4 + "-" + ('5|vom:8'<<-4)>>-2 + "-" + '5|vom:8'>>2
.formula M|tanzpackinnertxt = 'M|tpckanzinner' + " INNER" ? M|tlayoutx="G" ; M|tlayoutx="M"
..
.. E1
.. free area for supplier
..
.. E2
.formula M|tverwschl = 3|kopf^verwschl ? F|defined(3|id)
..
.. A3, D1
.formula M|tpus  = 5|lsnredl
.formula M|tpus  = 2|labnr  ? F|empty(M|tpus)
.formula M|tpus  = 5|nummer ? F|empty(M|tpus)
..
.. DUNS is printed without hypen in license plate
.type text xtDUNSnohyphen ? _F|defined(U|xtDUNSnohyphen)
.formula U|xtDUNSnohyphen = F|regreplaceall('M|kliduns', "-", "")
.. Note: different whitespaces for license plate and 2d-barcode
.formula M|tlicensepl = "(1J) " + "UN " + U|xtDUNSnohyphen  + " " + 'M|tlspcknr' ? M|tlayoutx="S"
.formula M|tlicensepl = "(5J) " + "UN " + U|xtDUNSnohyphen  + " " + 'M|tlspcknr' ? M|tlayoutx="G"
.formula M|tlicensepl = "(6J) " + "UN " + U|xtDUNSnohyphen  + " " + 'M|tlspcknr' ? M|tlayoutx="M"
.formula M|t1jbarcode =  "1J"   + "UN"  + U|xtDUNSnohyphen  + 'M|tlspcknr'       ? M|tlayoutx="S"
.formula M|t1jbarcode =  "5J"   + "UN"  + U|xtDUNSnohyphen  + 'M|tlspcknr'       ? M|tlayoutx="G"
.formula M|t1jbarcode =  "6J"   + "UN"  + U|xtDUNSnohyphen  + 'M|tlspcknr'       ? M|tlayoutx="M"
..
.. F-Sequenz Variable: Packaging Material
.formula M|tfsequenzpack = "01001P"                                              ? M|tlayoutx="S"
.formula M|tfsequenzpack = "01001T"                                              ? M|tlayoutx="M"
.formula M|tfsequenzpack = "01000T"                                              ? M|tlayoutx="G"
..
.. F-Sequenz Variable: Product
.formula M|tfsequenzprod = "02010I"                                              ? M|tlayoutx <> "G"
..
.. Clear  content related data fields, if "mixed label"
.continue EMIXED ? M|tlayoutx <> "G"
.formula M|tartkuartnr   = ""
.formula M|tartzei       = ""
.formula M|tlsartchg     = ""
.formula M|tpacksucherw  = ""
.. FIXME: must be true if any of the contents is hazardous; but false if neither is
!EMIXED
..
..*****************************************************************************
.. BARCODES
..*****************************************************************************
..
..  2D-Barcode -- GTL VW --
..  Version 4 der VW Spezifikation!
..  F-sequences
..
.continue NOBARS  ? _F|defined(U|xtDUNSnohyphen)
.continue NOBARS  ?  F|empty(U|xtDUNSnohyphen)
..
.. Control characters are converted to controls in jasper!
.type text xtfact ? _F|defined(U|xtfact)
.type text xtrs   ? _F|defined(U|xtrs)
.type text xtgs   ? _F|defined(U|xtgs)
.type text xteot  ? _F|defined(U|xteot)
.formula U|xtfact = "06"
.formula U|xtrs   = "-RS-"
.formula U|xtgs   = "-GS-"
.formula U|xteot  = "-EOT-"
..
.. Compose barcode data
.type text xt ? _F|defined(U|xt)
.formula U|xt =         U|xtrs + U|xtfact
.. F-sequence: Packaging material
.formula U|xt = U|xt    + U|xtgs  + "F01001P"                                                               ? M|tlayoutx="S"
.formula U|xt = U|xt    + U|xtgs  + "F01001T"                                                               ? M|tlayoutx="M"
.formula U|xt = U|xt    + U|xtgs  + "F01000T"                                                               ? M|tlayoutx="G"
.formula U|xt = U|xt    + U|xtgs  + "1J"      + "UN"             + U|xtDUNSnohyphen       + 'M|tlspcknr'    ? M|tlayoutx="S"
.formula U|xt = U|xt    + U|xtgs  + "5J"      + "UN"             + U|xtDUNSnohyphen       + 'M|tlspcknr'    ? M|tlayoutx="G"
.formula U|xt = U|xt    + U|xtgs  + "6J"      + "UN"             + U|xtDUNSnohyphen       + 'M|tlspcknr'    ? M|tlayoutx="M"
.formula U|xt = U|xt    + U|xtgs  + "V"       +  M|tliefnr
.formula U|xt = U|xt    + U|xtgs  + "16K"     + 'M|tlsnr^nummer'
.formula U|xt = U|xt    + U|xtgs  + "6D"      + 'M|tlsnr^vom:8'  + "095"
..
.formula U|xt = U|xt    + U|xtgs  + "2L"      + 'M|kwerk' + "/"  + 'M|tkuablade'                            ? F|empty(M|tlagerort)
.formula U|xt = U|xt    + U|xtgs  + "2L"      + 'M|kwerk' + "/"  + 'M|tlagerort' + "/"     + 'M|tkuablade'  ? _F|empty(M|tlagerort)
.formula U|xt = U|xt    + U|xtgs  + "7Q"      + 'M|tgewbrutto'   + "KG"                                     ? M|tlayoutx <> "S"
.formula U|xt = U|xt    + U|xtgs  + "Q"       + 'M|tpckanzinner'                                            ? M|tlayoutx <> "S"
.formula U|xt = U|xt    + U|xtgs  + "B"       +  M|tpackkuartnr
..
.. No product f-sequence in mixed label
.continue SKIPMIX ? M|tlayoutx="G"
.. F-sequence: Product
.formula U|xt         = U|xt   + U|xtgs  + "F02010I"                                                               ? M|tlayoutx="S"
.formula U|xt         = U|xt   + U|xtgs  + "F02010I"                                                               ? M|tlayoutx="M"
.formula U|xt         = U|xt   + U|xtgs  + "P"      +  M|tartkuartnr 
.formula U|xt         = U|xt   + U|xtgs  + "4L"     + 'M|turlandiso2' 
.formula U|xt         = U|xt   + U|xtgs  + "2P"     + 'M|tartzei'                                                  ? _F|empty(M|tartzei)
.formula U|xt         = U|xt   + U|xtgs  + "1T"     + 'M|tlsartchg'                                                ?  M|tlayoutx="S"  & _F|empty(M|tlsartchg)
.formula U|xt         = U|xt   + U|xtgs  + "7Q"     + 'M|tfmenge'      + "PC" 
.formula U|xt         = U|xt   + U|xtgs  + "7Q"     + 'M|tgewnetto'    + "58"
!SKIPMIX
..
.. Hide control values when displaying in info system
.type text xtregex   ? _F|defined(U|xtregex)
..
.formula U|xtregex    = U|xtrs + U|xtfact+ "|"      +U|xtrs            + "|"            + U|xtgs +"|"+U|xteot
.formula U|xt         = U|xt   + U|xtrs  + U|xteot
.continue DMCSIZE                                                                                                 ? +U|xt > 255
.formula M|tvwdmccode = U|xt
.formula M|tvwdmc     = F|regreplaceall(U|xt, U|xtregex, "")
..
!NOBARS
.continue
..
..*****************************************************************************
!END
.continue
..
!DMCSIZE
.error Die Daten fÅr den Data Matrix Code sind zu lang.      
.end 1
