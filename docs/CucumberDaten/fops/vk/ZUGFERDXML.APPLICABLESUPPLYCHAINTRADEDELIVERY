..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : ZUGFERDXML.APPLICABLESUPPLYCHAINTRADEDELIVERY
..  Autor          : saac
..  Verantwortlich : teamreport
..  Kontrolle      : cl
..  Funktion       : XML-Datengenerator des Infosystems ev/EVVORGANG zur Erzeugung
..                   der Rechnungsdaten im ZUGFeRD-Format
..  Functionality  : XML data generator for the Infosystem ev/EVVORGANG to build
..                   invoice date for ZUGFeRD
..*****************************************************************************
..
.type text xModeCode           ? _F|defined(U|xModeCode)
.type text xOccurrenceDateTime ? _F|defined(U|xOccurrenceDateTime)
..
.set trans -
..
..add mapping for shipping type code here, if needed
..copy U|xModeCode = M|vart
.assign U|xOccurrenceDateTime = M|tterm:8
..
..*****************************************************************************
!OUTPUT
..*****************************************************************************
..
            <ram:ApplicableSupplyChainTradeDelivery>
.continue SHIPTOTRADEPARTY ? F|empty(U|xModeCode)
                <ram:RelatedSupplyChainConsignment>
                    <ram:SpecifiedLogisticsTransportMovement>
                        <ram:ModeCode>'U|xModeCode'</ram:ModeCode>
                    </ram:SpecifiedLogisticsTransportMovement>
                </ram:RelatedSupplyChainConsignment>
!SHIPTOTRADEPARTY
.input "ZUGFERDXML.SHIPTOTRADEPARTY"
                <ram:ActualDeliverySupplyChainEvent>
                    <ram:OccurrenceDateTime>
                        <udt:DateTimeString format="'U|xDateFormat'">'U|xOccurrenceDateTime'</udt:DateTimeString>
                    </ram:OccurrenceDateTime>
                </ram:ActualDeliverySupplyChainEvent>
            </ram:ApplicableSupplyChainTradeDelivery>
.continue
