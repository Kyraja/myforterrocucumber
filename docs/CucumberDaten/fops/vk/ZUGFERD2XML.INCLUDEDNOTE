..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : ZUGFERD2XML.INCLUDEDNOTE
..  Autor          : saac
..  Verantwortlich : teamreport
..  Kontrolle      : cl
..  Funktion       : XML-Datengenerator des Infosystems ev/EVVORGANG zur Erzeugung
..                   der Rechnungsdaten im ZUGFERD2-Format
..  Functionality  : XML data generator for the Infosystem ev/EVVORGANG to build
..                   invoice date for ZUGFERD2
..*****************************************************************************
..
.type integer xdesc                       ? _F|defined(U|xdesc)
.type text xline                          ? _F|defined(U|xline)
.type text xNoteContent                   ? _F|defined(U|xNoteContent)
.type text xNoteContentCode               ? _F|defined(U|xNoteContentCode)
.type text xNoteSubjectCode               ? _F|defined(U|xNoteSubjectCode)
.type text xNoteFText                     ? _F|defined(U|xNoteFText)
..
.set trans -
..
.continue ? F|empty(U|xNoteContent) & F|empty(U|xNoteFText)
.continue        ? F|empty(U|xNoteContent) & F|empty(U|xNoteFText)
.continue OUTPUT  ? F|empty(U|xNoteContent)
..
..HTML nachbearbeiten
.assign U|xNoteContent = F|regreplace('U|xNoteContent', "<[^>]*>", "", G|true)
.assign U|xNoteContent = F|regreplace('U|xNoteContent', "&(?!amp;)", "&amp;", G|true)
.assign U|xNoteContent = F|regreplace('U|xNoteContent', "<", "&lt;", G|true)
.assign U|xNoteContent = F|regreplace('U|xNoteContent', ">", " &gt;", G|true)
..
..*****************************************************************************
!OUTPUT
..*****************************************************************************
            <ram:IncludedNote>
.continue FTEXT ? _F|empty(U|xNoteFText)
                <ram:Content>'U|xNoteContent'</ram:Content>
.continue ENDNOTE
!FTEXT
                <ram:Content>
.file -open U|xdesc 'U|xNoteFText'
.continue ENDFTEXT ? _G|mehr
!NEXTLINE
.file -read U|xdesc U|xline ^
?'U|xline'  ? _F|empty(U|xline)
.continue ENDFTEXT ? _G|mehr
.continue NEXTLINE
!ENDFTEXT
.file -close U|xdesc
                </ram:Content>
!ENDNOTE
?               <ram:ContentCode>'U|xNoteContentCode'</ram:ContentCode>? _F|empty(U|xNoteContentCode)
?               <ram:SubjectCode>'U|xNoteSubjectCode'</ram:SubjectCode>? _F|empty(U|xNoteSubjectCode)
            </ram:IncludedNote>
..
.assign U|xNoteContent = ""
.assign U|xNoteContentCode = ""
.assign U|xNoteSubjectCode = ""
.assign U|xNoteFText = ""
.continue
