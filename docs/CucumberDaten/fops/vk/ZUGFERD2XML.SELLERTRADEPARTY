..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : ZUGFERD2.SELLERTRADEPARTY
..  Autor          : saac
..  Verantwortlich : teamreport
..  Kontrolle      : cl
..  Funktion       : XML-Datengenerator des Infosystems ev/EVVORGANG zur Erzeugung
..                   der Rechnungsdaten im ZUGFERD2-Format
..  Functionality  : XML data generator for the Infosystem ev/EVVORGANG to build
..                   invoice date for ZUGFERD2
..*****************************************************************************
..
.type text xID                ? _F|defined(U|xID)
.type text xGlobalIDGLN       ? _F|defined(U|xGlobalIDGLN)
.type text xGlobalIDUNS       ? _F|defined(U|xGlobalIDUNS)
.type text xName              ? _F|defined(U|xName)
.type text xPersonName        ? _F|defined(U|xPersonName)
.type text xDepartmentName    ? _F|defined(U|xDepartmentName)
.type text xTelephone         ? _F|defined(U|xTelephone)
.type text xFax               ? _F|defined(U|xFax)
.type text xEmail             ? _F|defined(U|xEmail)
.type text xPostcodeCode      ? _F|defined(U|xPostcodeCode)
.type text xLineOne           ? _F|defined(U|xLineOne)
.type text xLineTwo           ? _F|defined(U|xLineTwo)
.type text xCityName          ? _F|defined(U|xCityName)
.type text xCountryID         ? _F|defined(U|xCountryID)
.type text xVATID             ? _F|defined(U|xVATID)
.type text xUSTID             ? _F|defined(U|xUSTID)
..
.set trans -
..
.copy U|xID = M|frbez
.copy U|xGlobalIDGLN = F|sysinfo(10)^gln
.copy U|xGlobalIDUNS = F|sysinfo(10)^duns
.copy U|xName = F|sysinfo(10)^ans
.copy U|xPersonName = M|betr
.copy U|xDepartmentName = M|vorgang^betreuer^abtlg^namebspr
.copy U|xTelephone = M|betel
.copy U|xFax = M|befax
.copy U|xEmail = M|beemail
.copy U|xPostcodeCode = F|sysinfo(10)^plz
.copy U|xCityName = F|sysinfo(10)^nort
.copy U|xCountryID = F|sysinfo(10)^staat^iso2
.copy U|xVATID = F|sysinfo(10)^steunr
.copy U|xUSTID = F|sysinfo(10)^ustid
.copy U|xLineOne = F|sysinfo(10)^str
.continue OUTPUT ? F|strindex('U|xLineOne', "\n") = 0
.formula U|xLineOne = F|substr('F|sysinfo(10)^str', 1, F|strindex('F|sysinfo(10)^str', "\n") - 1)
.formula U|xLineTwo = F|substr('F|sysinfo(10)^str', F|strindex('F|sysinfo(10)^str', "\n") + 1)
..
..*****************************************************************************
!OUTPUT
..*****************************************************************************
..
              <ram:SellerTradeParty>
?               <ram:ID>'U|xID'</ram:ID>? _F|empty(U|xID)
?               <ram:GlobalID schemeID="0088">'U|xGlobalIDGLN'</ram:GlobalID>? _F|empty(U|xGlobalIDGLN)
?               <ram:GlobalID schemeID="0060">'U|xGlobalIDUNS'</ram:GlobalID>? _F|empty(U|xGlobalIDUNS)
                <ram:Name>'U|xName'</ram:Name>
.continue POSTALADRESS ? F|empty(U|xPersonName)
                <ram:DefinedTradeContact>
                    <ram:PersonName>'U|xPersonName'</ram:PersonName>
?                   <ram:DepartmentName>'U|xDepartmentName'</ram:DepartmentName>? _F|empty(U|xDepartmentName)
!TELEPHONE
.continue FAX          ? F|empty(U|xTelephone)
                    <ram:TelephoneUniversalCommunication>
                        <ram:CompleteNumber>'U|xTelephone'</ram:CompleteNumber>
                    </ram:TelephoneUniversalCommunication>
!FAX
.continue EMAIL        ? F|empty(U|xFax)
                    <ram:FaxUniversalCommunication>
                        <ram:CompleteNumber>'U|xFax'</ram:CompleteNumber>
                    </ram:FaxUniversalCommunication>
!EMAIL
.continue ENDCONTACT  ? F|empty(U|xEmail)
                    <ram:EmailURIUniversalCommunication>
                        <ram:URIID>'U|xEmail'</ram:URIID>
                    </ram:EmailURIUniversalCommunication>
!ENDCONTACT
                </ram:DefinedTradeContact>
!POSTALADRESS
                <ram:PostalTradeAddress>
?                   <ram:PostcodeCode>'U|xPostcodeCode'</ram:PostcodeCode>? _F|empty(U|xPostcodeCode)
?                   <ram:LineOne>'U|xLineOne'</ram:LineOne>? _F|empty(U|xLineOne)
?                   <ram:LineTwo>'U|xLineTwo'</ram:LineTwo>? _F|empty(U|xLineTwo)
?                   <ram:CityName>'U|xCityName'</ram:CityName>? _F|empty(U|xCityName)
?                   <ram:CountryID>'U|xCountryID'</ram:CountryID>? _F|empty(U|xCountryID)
                </ram:PostalTradeAddress>
.continue USITD      ? F|empty(U|xVATID)
                <ram:SpecifiedTaxRegistration>
                    <ram:ID schemeID="FC">'U|xVATID'</ram:ID>
                </ram:SpecifiedTaxRegistration>
!USITD
.continue ENDSECTION ? F|empty(U|xUSTID) ; _F|empty(U|xVATID)
                <ram:SpecifiedTaxRegistration>
                    <ram:ID schemeID="VA">'U|xUSTID'</ram:ID>
                </ram:SpecifiedTaxRegistration>
!ENDSECTION
            </ram:SellerTradeParty>
..
.continue
