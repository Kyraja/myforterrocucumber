..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KOZEI.ESR27
.. Datum          : 26.06.06
.. Version        : 2006r3
.. Autor          : rs
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Unterprogramm zur Kodierzeilenermittlung
..*****************************************************************************
.set trans -
.type text  xt      ? _defined(xt)
.type text  xt2     ? _defined(xt2)
.type text  xt3     ? _defined(xt3)
.type text  xtz     ? _defined(xtz)
.type text  xtb     ? _defined(xtb)
.type text  xtp     ? _defined(xtp)
.type text  m11     ? _defined(m11)
.type text  xtk     ? _defined(xtk)
.type text  xtk1    ? _defined(xtk1)
.type text  xtk2    ? _defined(xtk2)
.type text  xtk3    ? _defined(xtk3)
.type text  xtk4    ? _defined(xtk4)
.type text  xtk5    ? _defined(xtk5)
.type text  xtmp    ? _defined(xtmp)
.type text  xtbc    ? _defined(xtbc)
.type text  xtkon   ? _defined(xtkon)
.type text  xtzref  ? _defined(xtzref)
.type text  xtzbetr ? _defined(xtzbetr)
.type text  xtpruef ? _defined(xtpruef)
.type text  xtzbc   ? _defined(xtzbc)
.type date xdleer  ? _defined(xdleer)
..
.. 9-stellige Teilnehmernummer zusammensetzen (01-xxxx-1 --> 0100xx
..                                            (01-yyy-1  --> 01000y
.continue TLN27 ? _(T|xtlnnr /"*-*")
.formula T|xtz = T|xtlnnr << "-"
.formula T|xt2 = T|xtlnnr >> "-"
.formula T|xt3 = T|xt2 << "-"
.formula T|xt3= "0000"+ T|xt3
.formula T|xt3= T|xt3>>6
.formula T|xt2 = T|xt2 >> "-"
.formula T|xtlnnr = T|xtz+T|xt3+T|xt2
..
!TLN27: 27-stellige Referenznummer mit 9-stelliger Teilnehmernummer ohne
..      27. Stelle wird mit Modulo 10 ermittelt
..      Kunden-Nr. und Rechnungs-Nr. jeweils 8-stellig, nur m”glich
..      wenn Referenznummer 27-stellig
.formula T|xt ="0000000000"
.formula T|xtnum     = (T|xt+T|xtnum)>>8
.formula T|xtkd      = (T|xt+T|xtkd)>>8
.formula T|xtbankid  = (T|xtbankid+T|xt)<<10
.formula T|xt        = T|xtbankid+T|xtkd+T|xtnum
.formula T|xt        = T|xt>>26
..
.. Referenznummer zur Prfzifferberechnung
.formula T|xtpruef=T|xt
.. Unterprogramm zur Prfzifferberechnung (Modulo 10,
.input "vk/MOD10R"
.. Prfziffer zur Referenznummer hinzufgen
.formula T|xt=T|xt+T|xtprzi
.. Referenznummer (speichern)
.formula T|xtzref=T|xt
.. Referenznummer und Teilnehmernummer zur Kodierzeile
.formula T|xt=T|xt+"+"
.formula T|xt=T|xt+T|xtlnnr+">"
.continue  ? T|xbesr
..
.. Belegartcode von Bank
.formula T|xtbc="04"
.. BC zur Prfzifferberechnung
.formula T|xtpruef=T|xtbc
.. Unterprogramm zur Prfzifferberechnung (Modulo 10,
..
.input "vk/MOD10R"
.. Prfziffer zur Belegartcode hinzufgen
.formula T|xtzbc=T|xtbc+T|xtprzi
.formula T|xtzbc=T|xtzbc+"> "
..
.. Kodierzeile
.formula T|xt=T|xtzbc+T|xt
.continue
