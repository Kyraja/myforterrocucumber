..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : ZUGFERDXML.DELIVERYNOTEREFERENCEDDOCUMENT
..  Autor          : saac
..  Verantwortlich : teamreport
..  Kontrolle      : cl
..  Funktion       : XML-Datengenerator des Infosystems ev/EVVORGANG zur Erzeugung
..                   der Rechnungsdaten im ZUGFeRD-Format
..  Functionality  : XML data generator for the Infosystem ev/EVVORGANG to build
..                   invoice date for ZUGFeRD
..*****************************************************************************
..
.type date xVom                              ? _F|defined(U|xVom)
.type text xIssueDateTime                    ? _F|defined(U|xIssueDateTime)
.type text xDeliveryNoteReferencedDocument   ? _F|defined(U|xDeliveryNoteReferencedDocument)
..
.set trans -
..
.continue END ? _G|mehr
.continue END ? F|empty(M|position^okopf)
.continue END ? M|position^okopf^ktyp <> G|liko
..
.assign U|xDeliveryNoteReferencedDocument = M|position^okopf^nummer
.formula U|xDeliveryNoteReferencedDocument = F|trim(U|xDeliveryNoteReferencedDocument)
.assign U|xVom = M|position^okopf^vom
.continue OUTPUT ? F|empty(U|xVom)
.formula U|xIssueDateTime = 'F|year(U|xVom)' + "-"
.formula U|xIssueDateTime = U|xIssueDateTime + 'F|month(U|xVom)' + "-"             ? F|month(U|xVom) > 9
.formula U|xIssueDateTime = U|xIssueDateTime + "0" + 'F|month(U|xVom)' + "-"       ? F|month(U|xVom) < 10
.formula U|xIssueDateTime = U|xIssueDateTime + 'F|day(U|xVom)' + "T00:00:00"       ? F|day(U|xVom) > 9
.formula U|xIssueDateTime = U|xIssueDateTime + "0" + 'F|day(U|xVom)' + "T00:00:00" ? F|day(U|xVom) < 10
..
..*****************************************************************************
!OUTPUT
..*****************************************************************************
            <ram:DeliveryNoteReferencedDocument>
?               <ram:IssueDateTime>'U|xIssueDateTime'</ram:IssueDateTime>? _F|empty(U|xIssueDateTime)
                <ram:ID>'U|xDeliveryNoteReferencedDocument'</ram:ID>
            </ram:DeliveryNoteReferencedDocument>
..
..*****************************************************************************
!END
.continue
