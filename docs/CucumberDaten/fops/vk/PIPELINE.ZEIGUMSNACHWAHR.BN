..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PIPELINE.ZEIGUMSNACHWAHR.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Zeigt Balkendiagramm "Summen nach Wahrscheinlichkeit". Die
..                  dargestellten Summen sind 10-%-Intervalle und werden beim
..                  Tabelle laden im Kopf mitgepflegt.
.. Functionality  : Shows chart "Totals according to propabilities"
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xtitle xtitlex xtitley xtitleavge1
.type text xtip xtip100 xcom xprecom1 xprecom2
.type AS5  xdoctype
..
.. Initialisations
.set trans +
.formula U|xtitle = "Summen nach Wahrscheinlichkeiten"
.formula U|xtitley = "Betrag in {1}"
.formula U|xtitlex = "Wahrscheinlichkeit in %"
.formula U|xtip = "Summe bis <= {1} % Wahrscheinlichkeit ist {2} {3}"
.formula U|xtip100 = "Summe mit bis zu {1} % Wahrscheinlichkeit ist {2} {3}"
.formula U|xtitleavge1 = "Durchschnitt: {1} {2}"
.set trans -
.assign U|xdoctype = "(Opportunity)"
.formula U|xprecom1 = F|regreplace(M|preselect, ";wahrsch=[^;]*;",";")
.formula U|xprecom1 =  "<(Sales)>" + F|formatstr(U|xprecom1, "%", M|ablageart, "{1}")
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -LEGEND NONE
.chart -PARAM -MINORGRIDY
.chart -PARAM -3D YES
.chart -PARAM -BACKCOLOR 0
.chart -PARAM -CLUSTERED ? M|chance & M|angebot
.chart -PARAM -TITLECHART 'U|xtitle'
.chart -PARAM -TITLEY 'F|formatstr(F|expr(U|xtitley), M|auswaehr)'
.chart -PARAM -TITLEX 'U|xtitlex'
..
.continue QUOTAT ? F|empty(M|chsumme)
.chart -STARTVALUES 'F|value(U|xdoctype, "A5")' -COLOR 4
.formula U|xprecom2 =  F|formatstr(U|xprecom1, U|xdoctype)
.chart -CONSTANTY 'M|durchschnitt2(L="0")' -LINEWIDTH 2 -RGBCOLOR 0 0 255 -TITLE 'F|formatstr(F|tostring(U|xtitleavge1), M|durchschnitt2, M|auswaehr)' ? _F|empty(M|durchschnitt2)
..
.chart -PARAM -MARKERX "<= 10 %"
.chart -VALUE NULL ? F|empty(M|chbis10)
.formula U|xcom = U|xprecom2 + ";wahrsch=0!10;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis10(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "10", M|chbis10, M|auswaehr)' ? _F|empty(M|chbis10)
..
.chart -PARAM -MARKERX "<= 20 %"
.chart -VALUE NULL ? F|empty(M|chbis20)
.formula U|xcom = U|xprecom2 + ";wahrsch=10!!;wahrsch=!20;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis20(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "20", M|chbis20, M|auswaehr)' ? _F|empty(M|chbis20)
..
.chart -PARAM -MARKERX "<= 30 %"
.chart -VALUE NULL ? F|empty(M|chbis30)
.formula U|xcom = U|xprecom2 + ";wahrsch=20!!;wahrsch=!30;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis30(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "30", M|chbis30, M|auswaehr)' ? _F|empty(M|chbis30)
..
.chart -PARAM -MARKERX "<= 40 %"
.chart -VALUE NULL ? F|empty(M|chbis40)
.formula U|xcom = U|xprecom2 + ";wahrsch=30!!;wahrsch=!40;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis40(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "40", M|chbis40, M|auswaehr)' ? _F|empty(M|chbis40)
..
.chart -PARAM -MARKERX "<= 50 %"
.chart -VALUE NULL ? F|empty(M|chbis50)
.formula U|xcom = U|xprecom2 + ";wahrsch=40!!;wahrsch=!50;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis50(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "50", M|chbis50, M|auswaehr)' ? _F|empty(M|chbis50)
..
.chart -PARAM -MARKERX "<= 60 %"
.chart -VALUE NULL ? F|empty(M|chbis60)
.formula U|xcom = U|xprecom2 + ";wahrsch=50!!;wahrsch=!60;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis60(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "60", M|chbis60, M|auswaehr)' ? _F|empty(M|chbis60)
..
.chart -PARAM -MARKERX "<= 70 %"
.chart -VALUE NULL ? F|empty(M|chbis70)
.formula U|xcom = U|xprecom2 + ";wahrsch=60!!;wahrsch=!70;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis70(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "70", M|chbis70, M|auswaehr)' ? _F|empty(M|chbis70)
..
.chart -PARAM -MARKERX "<= 80 %"
.chart -VALUE NULL ? F|empty(M|chbis80)
.formula U|xcom = U|xprecom2 + ";wahrsch=70!!;wahrsch=!80;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis80(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "80", M|chbis80, M|auswaehr)' ? _F|empty(M|chbis80)
..
.chart -PARAM -MARKERX "<= 90 %"
.chart -VALUE NULL ? F|empty(M|chbis90)
.formula U|xcom = U|xprecom2 + ";wahrsch=80!!;wahrsch=!90;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis90(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "90", M|chbis90, M|auswaehr)' ? _F|empty(M|chbis90)
..
.chart -PARAM -MARKERX "> 90 %"
.chart -VALUE NULL ? F|empty(M|chbis100)
.formula U|xcom = U|xprecom2 + ";wahrsch=90!!;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|chbis100(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip100), "> 90", M|chbis100, M|auswaehr)' ? _F|empty(M|chbis100)
..
!QUOTAT: Quotations
.assign U|xdoctype = "(Quotation)"
.continue SHOW ? F|empty(M|ansumme)
.chart -STARTVALUES 'F|value(U|xdoctype, "A5")' -COLOR 19
.formula U|xprecom2 =  F|formatstr(U|xprecom1, U|xdoctype)
.chart -CONSTANTY 'M|durchschnitt3(L="0")' -LINEWIDTH 2 -RGBCOLOR 0 255 0 -TITLE 'F|formatstr(F|tostring(U|xtitleavge1), M|durchschnitt3, M|auswaehr)' ? _F|empty(M|durchschnitt3)
..
.chart -PARAM -MARKERX "<= 10 %"
.chart -VALUE NULL ? F|empty(M|anbis10)
.formula U|xcom = U|xprecom2 + ";wahrsch=0!10;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis10(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "10", M|anbis10, M|auswaehr)' ? _F|empty(M|anbis10)
..
.chart -PARAM -MARKERX "<= 20 %"
.chart -VALUE NULL ? F|empty(M|anbis20)
.formula U|xcom = U|xprecom2 + ";wahrsch=10!!;wahrsch=!20;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis20(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "20", M|anbis20, M|auswaehr)' ? _F|empty(M|anbis20)
..
.chart -PARAM -MARKERX "<= 30 %"
.chart -VALUE NULL ? F|empty(M|anbis30)
.formula U|xcom = U|xprecom2 + ";wahrsch=20!!;wahrsch=!30;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis30(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "30", M|anbis30, M|auswaehr)' ? _F|empty(M|anbis30)
..
.chart -PARAM -MARKERX "<= 40 %"
.chart -VALUE NULL ? F|empty(M|anbis40)
.formula U|xcom = U|xprecom2 + ";wahrsch=30!!;wahrsch=!40;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis40(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "40", M|anbis40, M|auswaehr)' ? _F|empty(M|anbis40)
..
.chart -PARAM -MARKERX "<= 50 %"
.chart -VALUE NULL ? F|empty(M|anbis50)
.formula U|xcom = U|xprecom2 + ";wahrsch=40!!;wahrsch=!50;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis50(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "50", M|anbis50, M|auswaehr)' ? _F|empty(M|anbis50)
..
.chart -PARAM -MARKERX "<= 60 %"
.chart -VALUE NULL ? F|empty(M|anbis60)
.formula U|xcom = U|xprecom2 + ";wahrsch=50!!;wahrsch=!60;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis60(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "60", M|anbis60, M|auswaehr)' ? _F|empty(M|anbis60)
..
.chart -PARAM -MARKERX "<= 70 %"
.chart -VALUE NULL ? F|empty(M|anbis70)
.formula U|xcom = U|xprecom2 + ";wahrsch=60!!;wahrsch=!70;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis70(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "70", M|anbis70, M|auswaehr)' ? _F|empty(M|anbis70)
..
.chart -PARAM -MARKERX "<= 80 %"
.chart -VALUE NULL ? F|empty(M|anbis80)
.formula U|xcom = U|xprecom2 + ";wahrsch=70!!;wahrsch=!80;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis80(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "80", M|anbis80, M|auswaehr)' ? _F|empty(M|anbis80)
..
.chart -PARAM -MARKERX "<= 90 %"
.chart -VALUE NULL ? F|empty(M|anbis90)
.formula U|xcom = U|xprecom2 + ";wahrsch=80!!;wahrsch=!90;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis90(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip), "90", M|anbis90, M|auswaehr)' ? _F|empty(M|anbis90)
..
.chart -PARAM -MARKERX "> 90 %"
.chart -VALUE NULL ? F|empty(M|anbis100)
.formula U|xcom = U|xprecom2 + ";wahrsch=90!!;nummer=;sumnetto=;land=;@datenbank=3:1;@autostart=ja" + "<(View)>"
.chart -VALUE 'M|anbis100(L="0")' -DATA 'U|xcom' -TIP 'F|formatstr(F|tostring(U|xtip100), "> 90", M|anbis100, M|auswaehr)' ? _F|empty(M|anbis100)
..
!SHOW
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
