..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ENTRYCERTIFICATE.TAB
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..
..*****************************************************************************
.type text  xselect       ? _F|defined(U|xselect)
.type ARTT40001 xtbarcode ? _F|defined(U|xtbarcode)
.type A8        xaktlaart ? _F|defined(U|xaktlaart)
.set trans -
..
.. nur laart=(EUCountry) zum Bezugszeitpunkt "vom" aus Lieferschein
.formula U|xaktlaart = ""
.formula U|xselect = F|formatstr("$,,id={1}", H|vstaat^id)
.load 6 group "97:1" 'U|xselect'
.continue END ? _G|mehr
.formula 6|bezzp = H|vom
.continue END ? _F|equals(6|aktlaart, "(EUCountry)")
.copy U|xaktlaart = 6|aktlaart
..
.formula U|xtbarcode = ""
.continue MAKESCREEN ?  _F|sysinfo(18)^habel
.formula U|xselect = F|formatstr("$,,vorgang={1};belegart={2}", H|id, "VKGELANGENSBEST")
.load 8 group "70:3" 'U|xselect'
.continue ENDNOBARCODE ? _G|mehr
.copy U|xtbarcode = 8|barcode
.continue SELECTION 
..
!ENDNOBARCODE
.copy U|xtbarcode = P|dokument^barcode
..
!SELECTION
.continue END ? M|bbarcode & _F|empty(U|xtbarcode)
.continue END ? _F|empty(M|barcode) & (F|empty(U|xtbarcode) ; M|barcode <> U|xtbarcode)
..
!MAKESCREEN
.make screen line +O
.copy M|ausgeschlossen = H|glbausgeschl
.protection ausgeschlossen 'M|aktzeile'  ?  H|glbausgeschl
.protection rueckausschl 'M|aktzeile'    ? _H|glbausgeschl
.copy M|erhalten = G|FALSE
.copy M|versendet = G|FALSE
.protection ausgeschlossen 'M|aktzeile'  ? H|glbrueck ; H|glbversandt
.protection rueckausschl 'M|aktzeile'    ? H|glbrueck ; H|glbversandt
.protection erhalten 'M|aktzeile'        ? H|glbrueck
.protection versendet 'M|aktzeile'       ? H|glbversandt
.protection erhalten 'M|aktzeile'        ? H|glbausgeschl
.protection versendet 'M|aktzeile'       ? H|glbausgeschl
.assign M|ttkunde = H|kunde
.assign M|rekunde = H|kunde2
.assign M|tkunde = H|kunde3
.assign M|lskopf = H|id
.assign M|vstaat = H|vstaat
.assign M|laart = H|vstaat^laart
.assign M|aktlaart = U|xaktlaart
.formula M|tvom = H|vom
.formula M|bem = H|glbbem
.copy M|berhalten = H|glbrueck
.formula M|amerhalten = H|glbrueckdatum
.copy M|bversendet = H|glbversandt
.formula M|amversendet = H|glbversanddatum
.copy M|bausgeschlossen = H|glbausgeschl
.formula M|bemerkung = H|glbbem
.formula M|tkadresse = H|adresse2
.formula M|tkadresse = H|adresse   ? F|empty(M|tkadresse)
.assign M|tvstaat = H|vstaat
.copy M|spr = H|spr
.copy M|tbarcode = U|xtbarcode
.formula M|drucken = G|TRUE 
.formula M|drucken = G|FALSE ? H|glbausgeschl
.continue END
..
..*****************************************************************************
!END
.continue
