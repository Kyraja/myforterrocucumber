..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : ZUGFERDXML.INVOICEETRADEPARTY
..  Autor          : saac
..  Verantwortlich : teamreport
..  Kontrolle      : cl
..  Funktion       : XML-Datengenerator des Infosystems ev/EVVORGANG zur Erzeugung
..                   der Rechnungsdaten im ZUGFeRD-Format
..  Functionality  : XML data generator for the Infosystem ev/EVVORGANG to build
..                   invoice date for ZUGFeRD
..*****************************************************************************
..
.type text xID                ? _F|defined(U|xID)
.type text xGlobalIDGLN       ? _F|defined(U|xGlobalIDGLN)
.type text xGlobalIDUNS       ? _F|defined(U|xGlobalIDUNS)
.type text xName              ? _F|defined(U|xName)
.type text xPostcodeCode      ? _F|defined(U|xPostcodeCode)
.type text xLineOne           ? _F|defined(U|xLineOne)
.type text xLineTwo           ? _F|defined(U|xLineTwo)
.type text xCityName          ? _F|defined(U|xCityName)
.type text xCountryID         ? _F|defined(U|xCountryID)
.type text xVATID             ? _F|defined(U|xVATID)
.type text xUSTID             ? _F|defined(U|xUSTID)
..
.set trans -
..
.assign U|xID = F|trim(M|kunde^nummer)
.copy U|xGlobalIDGLN = M|kunde^gln
.copy U|xGlobalIDUNS = M|kunde^duns
.copy U|xName = M|ans
.copy U|xPostcodeCode = M|plz
.copy U|xCityName = M|nort
.copy U|xCountryID = M|staat^iso2
.copy U|xVATID = M|kunde^steunr
.copy U|xUSTID = M|kunde^ustid
.copy U|xLineOne = M|str
.continue OUTPUT ? F|strindex('U|xLineOne',"\n") = 0
.formula U|xLineOne = F|substr('M|str', 1, F|strindex('M|str',"\n") - 1)
.formula U|xLineTwo = F|substr('M|str', F|strindex('M|str',"\n") + 1)
..
..*****************************************************************************
!OUTPUT
..*****************************************************************************
..
             <ram:InvoiceeTradeParty>
?               <ram:ID>'U|xID'</ram:ID>? _F|empty(U|xID)
?               <ram:GlobalID schemeID="0088">'U|xGlobalIDGLN'</ram:GlobalID>? _F|empty(U|xGlobalIDGLN)
?               <ram:GlobalID schemeID="0060">'U|xGlobalIDUNS'</ram:GlobalID>? _F|empty(U|xGlobalIDUNS)
                <ram:Name>'U|xName'</ram:Name>
!POSTALADRESS
                <ram:PostalTradeAddress>
?                   <ram:PostcodeCode>'U|xPostcodeCode'</ram:PostcodeCode>? _F|empty(U|xPostcodeCode)
?                   <ram:LineOne>'U|xLineOne'</ram:LineOne>? _F|empty(U|xLineOne)
?                   <ram:LineTwo>'U|xLineTwo'</ram:LineTwo>? _F|empty(U|xLineTwo)
?                   <ram:CityName>'U|xCityName'</ram:CityName>? _F|empty(U|xCityName)
?                   <ram:CountryID>'U|xCountryID'</ram:CountryID>? _F|empty(U|xCountryID)
                </ram:PostalTradeAddress>
.continue USITD      ? F|empty(U|xVATID)
                <ram:SpecifiedTaxRegistration>
                    <ram:ID schemeID="FC">'U|xVATID'</ram:ID>
                </ram:SpecifiedTaxRegistration>
!USITD
.continue ENDSECTION ? F|empty(U|xUSTID)
                <ram:SpecifiedTaxRegistration>
                    <ram:ID schemeID="VA">'U|xUSTID'</ram:ID>
                </ram:SpecifiedTaxRegistration>
!ENDSECTION
            </ram:InvoiceeTradeParty>
..
.continue
