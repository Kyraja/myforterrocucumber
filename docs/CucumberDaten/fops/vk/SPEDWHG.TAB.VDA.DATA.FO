..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.TAB.VDA.4902.FO
.. Author         : calbayrak
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : fill data fields for label VDA 4902
..*****************************************************************************
.set trans -
..
..<META M|='vk/SPEDWHG' >
..
.. .formula M|format       = "http://www.vda.de/de/service/bestellung/downloads/4902.pdf"
..
.. sales item with packaging mateiral
..<META H|='P3:2' >
.. sales item for product
..<META 2|='P3:2' >
.. blanket order item for product
..<META 3|='P3:2' >
.. sales header (packing slip)
..<META 5|='P3:1' > 
.. shipping order
..<META 7|='P55:1' > 
..
.. composing error message
.type text xtfehler                                                  ? _F|defined(U|xtfehler)
..
.type text xVda4902  ? _F|defined(U|xVda4902)
.set trans +
.formula U|xVda4902  = "Warenanh„nger VDA 4902, Version 4"
.set trans -
..
.formula M|tkuans1         = M|kuans1
.formula M|tkuans2         = M|kuans2
.formula M|tkuablade       = 5|ablstelle 
..
.formula M|tlscode         = "N"               + M|tlsnr^nummer
.formula M|tverwschl       = 3|kopf^verwschl ? F|defined(3|id)
..
.formula M|tkuartnrkurz    = M|tartkuartnr
.formula M|tartkuartcode   = "P"               + M|tartkuartnr       ? _F|empty(M|tartkuartnr)
..
.formula M|tlsfuecode      = "Q"               + 'M|tfmenge'         ?  M|tfmenge <> 0
..
.formula M|tliartnr        = M|tartikel^nummer                       ? _F|sysinfo(18)^swziffern
.formula M|tliartnr        = M|tartikel^such                         ?  F|sysinfo(18)^swziffern
.formula M|tliartcode      = "30S"             + M|tliartnr          ? _F|empty(M|tliartnr)
..
.formula M|tpackkuartcode  = "B"               +  M|tpackkuartnr
..
.formula M|tlicode         = "V"               +  M|tliefnr          ? _F|empty(M|tliefnr)
.formula M|tlsvom          = "D"               + 'H|kopf^vom:8'<<-2
..
.formula M|tlspckcode      = M|tlayoutx        + M|tlspcknr          ? _F|empty(M|tlayoutx)
..
.formula M|tlschgcode      = "H"               +  M|tlsartchg        ? _F|empty(M|tlsartchg)
.formula M|tlianslang      = M|lians2
.formula M|tlnorm          = U|xVda4902
..
..
.. clear  content related data fields, if "mixed label"
.continue EMIXED ?  M|tlayoutx <> "G"
.. clear product data
.formula M|tartkuartnr = "MIXED LABEL"
.formula M|tartkuartcode = ""
.formula M|tartbez = ""
.formula M|tliartnr = ""
.formula M|tliartcode = ""
.formula M|tartzei = ""
.formula M|tlsartchg = ""
.formula M|tlschgcode = ""
.formula M|tlsfuecode = ""
.formula M|tfmenge = ""
.formula M|tverpackmge = ""
!EMIXED
..
..*****************************************************************************
!END
.continue
