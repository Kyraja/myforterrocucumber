..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZENTRALE.EV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type integer xitype      ? _F|defined(U|xitype)
.type integer xitmp       ? _F|defined(U|xitmp)
.type text    xtcom       ? _F|defined(U|xtcom)
.type realx   xramount    ? _F|defined(U|xramount)
.type realx   xrkurs      ? _F|defined(U|xrkurs)
.type ID94:1  xiwbu       ? _F|defined(U|xiwbu)
.type ID94:1  xland       ? _F|defined(U|xland)
.type ID94:1  xauswaehr   ? _F|defined(U|xauswaehr)
.type RP7.6   xrate       ? _F|defined(U|xrate)
.type IP1     xrundung    ? _F|defined(U|xrundung)
.type realx   xiwbuamount ? _F|defined(U|xiwbuamount)
.type realx   xiberechnen ? _F|defined(U|xiberechnen)
.type integer xttranstyp  ? _F|defined(U|xttranstyp)
.type ARTR51000    xliefern    ? _F|defined(U|xliefern)
.type ARTR51000    xberechnen  ? _F|defined(U|xberechnen)
.type id3     xmerk       ? _F|defined(U|xmerk)
.type id3     x2merk      ? _F|defined(U|x2merk)
.type integer xistufe     ? _F|defined(U|xistufe)
.type ARTR51100 xmge      ? _F|defined(U|xmge)
..
.input "DATEI.F"
..
.assign U|xmerk = ""
.assign U|x2merk = ""
..
.formula U|xrundung    = M|auswaehr^nkst
.copy U|xauswaehr = M|auswaehr
..
.continue BSTART          ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.. Tabelle
.continue PLAN            ? G|evtvar = "tplan"
.continue VERSAND         ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "ttypversand"
.continue DETAIL          ? G|evtvar = "tdetail"
.continue P2OST           ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tpost2"
.continue POST            ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tpost"
.. freigeben
.continue TRRELEASE       ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "trelease"
.continue T2RELEASE       ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "trelease2"
.continue END
..
!BSTART
.input "is/TABLEEREN"
.type ID3 xcheck
.assign U|xcheck = "$,,;@numsuch="  + M|docf + "!" + M|doct + ";@lesen=" + 'G|FALSE'
.continue ERROR02 ? _G|mehr
.continue END
..
!PLAN: Infosystem PLANKARTE îffnen / Planning Board
.continue END ? F|empty(M|tpart)
.continue END ? M|tpart^gruppe <> 1
.command -parallel 'F|formatstr("<(Infosystem)>10044<(Call)>?kart={1}|klgruppe={2}|bstart=1", M|tpart^id, M|lgruppe^id)'
.continue END
..
!VERSAND: Versandplanung îffnen (zeigen-Modus)
.continue END ? F|empty(M|tversand)
.command -wait 'F|formatstr("<(ShippingPlanning)>{1}<(View)>", M|tversand^id)'
.continue END
..
!DETAIL: Vorgangszeilen / Transaction Detail
.continue END     ? _F|empty(M|tpart)
.continue ODETAIL ? _M|tdo
.continue FDETAIL ?  M|tdo
..
!FDETAIL: Fold Detail
.copy M|tdetail = M|detail1
.copy M|tdo = G|FALSE
..
.select screen line
..
!NDETAIL
.continue EVTZEILE ? _G|mehr
.continue EVTZEILE ? M|aktzeile = 0
.continue EVTZEILE ? F|empty(M|tpart)
..
.make screen line -O
.continue NDETAIL
..
!EVTZEILE
.select screen line 'G|evtzeile'   ? G|evtvar = "trelease" ; G|evtvar = "trelease2"
.continue FOLD                     ? G|evtvar = "trelease" ; G|evtvar = "trelease2"
.continue END
..
!ODETAIL: Open Detail
.select add M|ttrans
.copy M|tdetail = M|detail2
.copy M|tdo = G|TRUE
..
!ARTIKEL: Artikel / Dienstleistungen und ein paar Zusatzpositionen
.select line
.continue E4      ? _G|mehr
.continue ARTIKEL ? _M|mitalternativpos & H|alternativpos
.continue ARTIKEL ? H|art^gruppe = 2 ; H|art^gruppe = 3
.continue ARTIKEL ? H|typ = 16 ; H|typ = 19 ; H|typ = 51 ; H|typ = 8 ; H|typ = 9 ; H|typ = 10
.continue ARTIKEL ? _F|empty(M|kprojekt) & (M|kprojekt^id <> H|projekt^id)
..
.add H|kopf
.formula U|xistufe = M|stufe        ? _F|empty(M|tdetail)
.make screen line +O
.formula M|stufe  = U|xistufe + 1   ? _F|empty(M|tdetail)
.assign M|ttrans  = D|id
.formula M|wahrsch = D|wahrsch
.formula M|gltvon = D|gltvon
.formula M|gltbis = D|gltbis
.formula M|audatum = D|audatum
.formula M|ttyp4  = M|storno    ? M|ttrans^typ = 4 & (F|equals(D|lsart, "(CancelationCustomerDelivery)") ; F|equals(D|lsart, "(PackingSlipReversal)") ; F|equals(D|lsart, "(CancelationReturnPackingSlip)"))
.formula M|ttyp4  = M|storniert ? M|ttrans^typ = 4 & (F|equals(D|lsart, "(CanceledCustomerDelivery)") ; F|equals(D|lsart, "(PackingSlipCanceled)") ; F|equals(D|lsart, "(CanceledReturnPackingSlip)"))
.copy M|tlsart    = D|lsart     ? D|typ = 4
.formula M|ttyp5  = M|storno    ? M|ttrans^typ = 5 & (F|equals(D|vorganga, "(CancelationCreditNoteCommercial)") ; F|equals(D|vorganga, "(InvoiceReversal)"))
.formula M|ttyp5  = M|storniert ? M|ttrans^typ = 5 & (F|equals(D|vorganga, "(CanceledCreditNoteCommercial)") ; F|equals(D|vorganga, "(InvoiceCanceled)"))
.copy M|tvorganga = D|vorganga  ? D|typ = 5
.assign M|stornopartnervorg = D|stornopartnervorg
.assign U|xrkurs  = D|kurs
.copy U|xiwbu     = D|iwbu
.copy U|xland     = D|land
.formula M|tzeich = D|zeich
.formula U|xrate  = F|fxrate(U|xauswaehr,D|budat,D|iwbu)
.add
..
.copy M|boffen      = G|FALSE
.copy M|boffen      = G|TRUE       ? (H|limge - H|lifrg):3 > 0 & H|kotyp = G|ABKO 
.copy M|ttypversand = M|typversand ? H|planung <> ""
.copy M|tversand    = H|planung    ? H|planung <> ""
.copy M|tfold         = G|TRUE
.copy M|alternativpos = H|alternativpos
.assign M|tpart = H|art
.assign M|tbasisartikel = H|art^basisartikel
.formula M|tplan         = ""
.formula M|tplan = M|plan ?  H|art^gruppe = 1
.protection brerelease 'M|aktzeile'        ? _F|empty(M|tpart)
.copy M|lgruppe     = H|lgruppe
.formula M|status        = H|status
.copy M|projekt = H|projekt
.copy M|platz       = H|platz
.formula M|tqty          = H|mge
.formula M|tlehe         = H|lehe
.formula M|tle           = H|art^le  ? H|art^gruppe = 1
.formula M|sterm         = H|tsterm
.assign M|the         = H|he
.copy M|bruttore    = H|kobrutto
.formula U|xliefern      = ""
.formula U|xliefern      = (H|limge - H|fzahl - H|lifrg) ?  H|kotyp = G|RAKO
.formula U|xliefern      = (H|limge - H|lifrg)           ?  H|kotyp = G|ABKO 
.formula M|tliefern      = U|xliefern
.formula M|fzahlabgerufen = H|fzahlabgerufen
.assign U|xramount    = H|preis
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = F|round(U|xrate*U|xiwbuamount,U|xrundung) ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
.formula M|tuprice       = U|xramount
.assign U|xramount    = H|npwert
.formula U|xramount   = H|fktaplanpos^anzpwert ? H|kotyp = G|ABKO & F|equals(H|kategorie,"(Downpayment)")
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = F|round(U|xrate*U|xiwbuamount,U|xrundung) ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
.formula M|teprice       = U|xramount
.formula U|xberechnen = ""
.continue AUSGABE                              ?  H|kotyp <> G|ABKO
.formula U|xberechnen = (H|remge - H|refrg) 
.continue AUSGABE                              ?  F|empty(H|kopf^fktaplan)
.continue AUSGABE                              ? _F|equals(H|kategorie,"(Downpayment)")
.formula U|xberechnen = H|fktaplanpos^anzpwert ?  F|empty(H|fktaplanpos^sumfakturiert) &  F|empty(H|fktaplanpos^sumgebucht)
.formula U|xberechnen = ""                     ?  F|empty(H|fktaplanpos^sumfakturiert) & _F|empty(H|fktaplanpos^sumgebucht)
.formula U|xberechnen = H|remge - H|refrg      ? _F|empty(H|fktaplanpos^sumfakturiert)
.formula U|xberechnen = ""                     ?  H|ablagef
..
.formula U|xiberechnen = U|xberechnen / U|xrkurs
.formula U|xberechnen = U|xiberechnen ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.formula U|xberechnen = U|xberechnen  ? U|xauswaehr = U|xland
.formula U|xberechnen = F|round(U|xrate*U|xiberechnen,U|xrundung) ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
..
!AUSGABE   
.formula M|tberechnen = U|xberechnen
.copy M|tauswaehr   = U|xauswaehr
.copy M|tpland      = H|pland
.assign M|tnpwert     = H|npwert
..
.continue ARTIKEL ? H|art^gruppe = 2 ; H|art^gruppe = 3
.continue ARTIKEL ? (H|typ = 16 ; H|typ = 19 ; H|typ = 8 ; H|typ = 9)
.continue ARTIKEL ? H|kotyp <> 4
.continue ARTIKEL ? H|mge <= 0
.continue ARTIKEL ? H|art^gruppe = 4 ; H|art^gruppe = 5
.continue ARTIKEL ? H|ablagef
..
.. Einzelmengen auf einem Platz / Single quantities in one location
.load 0 group "40:3" 'F|formatstr("$,,;artikel={1};platz={2};@ablageart=(Active)", H|art^id, H|platz^id)'
.continue NOSQUANTITY ? _G|mehr
..
.. Vorgangsmenge in Lagereinheit
.formula U|xmge = H|mge * H|lehe
.continue ARTIKEL ?  0|bestand >= U|xmge
..
!NOSQUANTITY: hole lmenge war nicht erfolgreich!
.copy M|tshort = M|short
.continue ARTIKEL
..
!E4
.continue END ? G|evtzeile <> M|aktzeile
.copy M|tdetail = M|detail1
.copy M|tdo = G|FALSE
.continue END
..
!TRRELEASE: Release transaction
.continue END ? _F|empty(M|tpart)
.continue END ?  M|ttrans^typ = 5
.continue END ?  M|ttrans^typ = 4 & F|empty(M|trelease)
.continue END ?  M|ttrans^ablagen
.continue END ?  M|ttrans^uebertr
.continue END ?  M|ttrans^typ = 31 & M|ttrans^vsperre
..
.formula U|xtcom = "<(Sales)>"
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Release)>"  ? M|ttrans^typ = 1
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Release)>"  ? M|ttrans^typ = 36
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Release)>"  ? M|ttrans^typ = 2
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Delivery)>" ? M|teprice >=0 & M|ttrans^typ = 3 & _M|brerelease
.formula U|xtcom = U|xtcom + "<(New)>,(PackingSlip) ? lsart=(CustomerDelivery) | beleg =" + 'M|ttrans^id' ? M|teprice <0 &  M|ttrans^typ = 3 & _M|brerelease
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Invoice)>"  ? M|ttrans^typ = 3 &  M|brerelease
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Invoice)>"  ? M|ttrans^typ = 4
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Release)>"  ? M|ttrans^typ = 31
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Release)>"  ? M|ttrans^typ = 33
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Delivery)>" ? M|ttrans^typ = 34 & _M|brerelease
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Invoice)>"  ? M|ttrans^typ = 34 &  M|brerelease
.formula U|xtcom = U|xtcom + 'M|ttrans^id' + "<(Invoice)>"  ? M|ttrans^typ = 35
.command -wait 'U|xtcom'
..
!T2RELEASE
.formula M|tpost = ""
.load 4 sales 'M|ttrans^id'
.copy M|tpost = M|show     ? _4|ablagef
.formula M|trelease = ""   ?  4|ablagef
.formula M|trelease = ""   ?  4|typ = 4 & 4|aeob
.copy M|ttyp1 = M|typ2b    ?  4|ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp3) & F|empty(M|ttyp4)
.copy M|ttyp2 = M|typ2b    ?  4|typ = ANKO & 4|ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp1)
.copy M|ttyp2a= M|typ2b    ?  4|typ = RAKO & 4|ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp1)
.copy M|ttyp3 = M|typ2b    ?  4|ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp4) & F|empty(M|ttyp1)
.copy M|ttyp4 = M|typ2b    ?  4|ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) &  F|empty(M|ttyp3) & F|empty(M|ttyp1)
.load 4
.copy M|brerelease = G|FALSE ?  M|ttyp3 = M|typ2b
.protection brerelease 'M|aktzeile'  ?  M|ttyp3 = M|typ2b
.continue FOLD
..
!POST: Post transaction
.continue END      ? _F|empty(M|tpart)
.continue END      ?  M|tpost = ""
.continue OEFFNEN  ? _M|ttrans^uebertr
.continue WARNUNG  ?  F|empty(M|tshort)
..
.box Hinweis
Gesamtlagerbestand ist geringer als die Liefermenge!
Bitte vor dem Freigeben ÅberprÅfen!
..
!WARNUNG
.command -wait 'F|formatstr("<(Sales)>{1}<(Edit)>?ueb=yes", M|ttrans^id)'
..
!P2OST
.formula M|tpost = ""
.copy M|tpost = M|show      ? _M|ttrans^ablagef
.copy M|tpost = M|post      ?  M|ttrans^uebertr
.copy M|trelease = M|release ? _M|ttrans^uebertr & M|ttrans^typ = 4
.copy M|ttyp1 = M|typ2b     ? M|ttrans^ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp5)
.copy M|ttyp2 = M|typ2b     ? M|ttrans^typ = ANKO & M|ttrans^ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp1) & F|empty(M|ttyp5)
.copy M|ttyp2a= M|typ2b     ? M|ttrans^typ = RAKO & M|ttrans^ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp1) & F|empty(M|ttyp5)
.copy M|ttyp3 = M|typ2b     ? M|ttrans^ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp4) & F|empty(M|ttyp1) & F|empty(M|ttyp5)
.copy M|ttyp4 = M|typ2b     ? M|ttrans^ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp3) & F|empty(M|ttyp1) & F|empty(M|ttyp5)
.copy M|ttyp5 = M|typ2b     ? M|ttrans^ablagef & F|empty(M|ttyp1) & F|empty(M|ttyp2a) & F|empty(M|ttyp2) & F|empty(M|ttyp3) & F|empty(M|ttyp4)
.continue END
..
!OEFFNEN: Vorgang îffnen
.command -wait 'F|formatstr("<(Sales)>{1}<(View)>", M|ttrans^id)'
.continue END
..
!FOLD: Fold the trans
.continue FDETAIL  ? M|tdo
.. Icon setzen
.load 5 sales 'F|formatstr("$,,;@gruppe=2;okopf={1};@ablageart=(Both)", M|ttrans^id)'
.copy M|topen = M|iopen ? G|mehr & F|empty(M|tpart)
.formula M|topen = ""   ? _G|mehr
.load 5
.copy M|tfold  = G|TRUE
.formula U|xitype = M|ttrans^typ
.formula U|xitype = 1 ? M|ttrans^typ = 36
.formula U|xitype = 2 ? M|ttrans^typ = 33
.formula U|xitype = 2 ? M|ttrans^typ = 31
.formula U|xitype = 3 ? M|ttrans^typ = 34
.formula U|xitype = 3 ? M|ttrans^typ = 35
..
.select screen line
.continue RELEASE       ? _G|mehr
.formula U|xttranstyp = M|ttrans^typ
.formula U|xttranstyp = 1 ? M|ttrans^typ = 36
.formula U|xttranstyp = 2 ? M|ttrans^typ = 33
.formula U|xttranstyp = 2 ? M|ttrans^typ = 31
.formula U|xttranstyp = 3 ? M|ttrans^typ = 34
.formula U|xttranstyp = 3 ? M|ttrans^typ = 35
..
!L1
.continue RELEASE                          ? U|xitype >=  U|xttranstyp
.formula U|xttranstyp = 33 ? M|ttrans^typ = 33
.formula U|xttranstyp = 31 ? M|ttrans^typ = 31
.formula U|xttranstyp = 34 ? M|ttrans^typ = 34
.formula U|xttranstyp = 35 ? M|ttrans^typ = 35
..
.make screen line -O
.formula U|xttranstyp = M|ttrans^typ
.formula U|xttranstyp = 1 ? M|ttrans^typ = 36
.formula U|xttranstyp = 2 ? M|ttrans^typ = 33
.formula U|xttranstyp = 2 ? M|ttrans^typ = 31
.formula U|xttranstyp = 3 ? M|ttrans^typ = 34
.formula U|xttranstyp = 3 ? M|ttrans^typ = 35
.continue L1
..
!RELEASE
.continue END ? _(G|evtvar = "trelease" ; G|evtvar = "trelease2")
.select screen line 'G|evtzeile'
..
.. Open folder/trans
.input "vk/VKZENTRALE.AUFZU" 
.continue END
..
!WEITER
.load 2 line continue
.continue LINEEND     ? _G|mehr
..
!ZEILE
.formula U|xitmp  = M|aktzeile
..
.load 2 line
.continue LINEEND ? _G|mehr
.formula M|grliste = "3:2"
.load  1 group  'M|grliste' 'F|formatstr("$,,;orig={1};@ablageart=(Both)", 2|id)'
.continue WEITER ? _G|mehr
.continue WEITER ?  F|empty(1|kopf)
.continue WEITER ?  U|xmerk = '1|kopf^id' & U|x2merk = '1|okopf^id'
.continue KOPF
..
!LADE
.load 1 continue
.continue END    ? _G|mehr
.continue LADE   ?  F|empty(1|kopf)
..
!KOPF
.copy U|xmerk = 1|kopf
.copy U|x2merk = 1|okopf
.select add 1|kopf
.input 'M|bkopf'
.continue WEITER
..
!LINEEND
.copy M|topen = M|iopen ? U|xitmp = M|aktzeile & F|empty(M|tpart) & M|ttrans^typ <> 5
.copy M|tfold = G|TRUE  ? U|xitmp = M|aktzeile
.continue LADE
..*****************************************************************************
!END
.continue
..
!ERROR02: Wrong date!
.error
.cursor docf 0
.end 1
