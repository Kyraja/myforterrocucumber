..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SPEDWHG.TAB.GTL
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
..<META M|='vk/SPEDWHG'>
..<META H|='P3:2'>
..
.type integer xint  ? _F|defined(U|xint)
.type text    day   ? _F|defined(U|day)
.type integer month ? _F|defined(U|month)
.type integer year  ? _F|defined(U|year)
..
.. local fields 2d barcode
.type text   xtrs            ? _F|defined(T|xtrs)
.type text   xtgs            ? _F|defined(T|xtgs)
.type text   xteot           ? _F|defined(T|xteot)
.type text   xt2d01          ? _F|defined(T|xt2d01)
.type text   xt2d02          ? _F|defined(T|xt2d02)
.type text   xt2d03          ? _F|defined(T|xt2d03)
.type text   xt2d04          ? _F|defined(T|xt2d04)
.type text   xt2d05          ? _F|defined(T|xt2d05)
.type text   xt2d06          ? _F|defined(T|xt2d06)
.type text   xt2d07          ? _F|defined(T|xt2d07)
.type text   xt2d08          ? _F|defined(T|xt2d08)
.type text   xt2d09          ? _F|defined(T|xt2d09)
.type text   xt2d10          ? _F|defined(T|xt2d10)
.formula T|xtrs  = "-RS-"
.formula T|xtgs  = "-GS-"
.formula T|xteot = "-EOT-"
..
.. DUNS is printed without hypen in license plate
.type text   xtDUNSnohyphen  ? _F|defined(U|xtDUNSnohyphen)
.formula U|xtDUNSnohyphen = F|regreplaceall('M|kliduns', "-", "")
..
..
.. which GTL..?
.. ----------- ---------- ---------- -------------------------------------------
.continue VW      ? -M|tlayname/"*VW*"
.continue GM      ? -M|tlayname/"*GM*"        ;  M|kballeformate
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!GM: general motors (opel)
.. A1
.formula M|tgtllians         = M|klians
.formula M|tgtllistr         = M|klistr
.formula M|tgtlliort         = M|kliort
.formula M|tgtllians4        = ""
.formula M|tgtlliemail       = ""
.formula M|tgtlurlandiso2    = M|tartikel^urland^iso2
.formula M|tgtllimadein      = "MADE IN " + M|tgtlurlandiso2 ? _F|empty(M|tgtlurlandiso2)
.. A2
.formula M|tgtlempans        = M|kempans
.formula M|tgtlempstr        = M|kempstr
.formula M|tgtlemport        = M|kemport
.formula M|tgtlwerk          = M|kwerk
.formula M|tgtlkuablade      = M|tlsnr^ablstelle
.. A3
.formula M|tgtl2d            = ""
.formula M|tgtl2dbarcode     = ""
.. B1
.formula M|tgtlfmenge        = M|tfmenge
.. B2, B3
.. alias  "tmathandl"
.formula M|tgtlmathandl      = M|tvbrstelle
.. alias  "tgtlkanban"       = M|tkanban
.. C
.formula M|tgtlkuartnr       = M|tartkuartnr
.. D1
.formula M|tgtllicensepl     = ""
.formula M|tgtl1jbarcode     = ""
.. D2
.. .formula M|tgtllsvom         = 'H|kopf^vom:8'<<4 + "." + ('H|kopf^vom:8'<<-4)>>-2 + "." + 'H|kopf^vom:8'>>2
.formula U|day = ("00" + 'F|day(H|kopf^vom)') >>2
.formula U|month = F|month(H|kopf^vom)
.formula U|year = F|year(H|kopf^vom)
.formula M|tgtllsvom = 'U|day' + "JAN" + 'U|year' ? U|month=1
.formula M|tgtllsvom = 'U|day' + "FEB" + 'U|year' ? U|month=2
.formula M|tgtllsvom = 'U|day' + "MAR" + 'U|year' ? U|month=3
.formula M|tgtllsvom = 'U|day' + "APR" + 'U|year' ? U|month=4
.formula M|tgtllsvom = 'U|day' + "MAY" + 'U|year' ? U|month=5
.formula M|tgtllsvom = 'U|day' + "JUN" + 'U|year' ? U|month=6
.formula M|tgtllsvom = 'U|day' + "JUL" + 'U|year' ? U|month=7
.formula M|tgtllsvom = 'U|day' + "AUG" + 'U|year' ? U|month=8
.formula M|tgtllsvom = 'U|day' + "SEP" + 'U|year' ? U|month=9
.formula M|tgtllsvom = 'U|day' + "OCT" + 'U|year' ? U|month=10
.formula M|tgtllsvom = 'U|day' + "NOV" + 'U|year' ? U|month=11
.formula M|tgtllsvom = 'U|day' + "DEC" + 'U|year' ? U|month=12
.formula M|tgtlpmartnr = M|tpackkuartnr
.formula M|tgtlgewbrutto = M|tgewbrutto
.formula M|tgtlgewnetto = M|tgewnetto
.. E1
.. free area for supplier
.. E2
.formula M|tgtllsnummer      = M|tlsnr^nummer
.. alias  "tpus"
.formula M|tgtlpus           = 2|labnr
.formula M|tgtlpus           = M|tlsnr^nummer ? F|empty(M|tgtlpus)
..
.. A3, D1: 2D barcodes
.continue EDUNSGM ?  F|empty(U|xtDUNSnohyphen)
.. note: different whitespaces for license plate and 2d-barcode
.formula M|tlicensepl = "UN " + U|xtDUNSnohyphen + " " + 'M|tlspcknr'
.formula M|t1jbarcode = "1J" + M|tlicensepl
!EDUNSGM
.continue MIXED
..
..
..
!VW: volkswagen
.. A1
.formula M|tgtllians         = M|klians
.formula M|tgtllistr         = M|klistr
.formula M|tgtlliort         = M|kliort
.formula M|tgtlurlandiso2    = M|tartikel^urland^iso2
.. A2
.formula M|tgtlempans        = M|kempans
.formula M|tgtlempstr        = M|kempstr
.formula M|tgtlemport        = M|kemport
.formula M|tgtlwerk          = M|kwerk
.formula M|tgtlkuablade      = M|tlsnr^ablstelle
.formula M|tlagerort         = M|tlsnr^laortku
.. B1
.formula M|tgtlliefnr        = M|linr
.formula M|tgtllsnummer      = M|tlsnr^nummer
.. B2
.formula M|tgtlvbrstelle     = H|vbrstelle
.formula M|tgtlpacktyp       = M|tpackkuartnr
.formula M|tgtlfuellmge      = H|fmenge
.formula M|tgtlfuellmgetxt   = 'H|fmenge' + " PC"
.formula U|xint = 0
.formula U|xint = H|verpackmge / H|mge     ? H|mge<>0 
.formula M|tgtlfuellmgetxt   = 'U|xint' + " PC" ? M|tlayoutx="M"
.. C
.formula M|tgtlartnr         = M|tartkuartnr
.. D2
.. layout label  "tgtlgewbrunet"
.formula M|tgtlgewbrutto     = M|tgewbrutto
.formula M|tgtlgewnetto      = M|tgewnetto
.formula M|tgtllsdatum       = "D" + " " + 'H|kopf^vom:8'<<4 + "-" + ('H|kopf^vom:8'<<-4)>>-2 + "-" + 'H|kopf^vom:8'>>2
.formula M|tgtlteilgenstand  = M|tartzei
.formula M|tgtlchargennr     = M|tlsartchg
.formula M|tgtlanzpack       = M|tpckanz
.formula M|tgtlanzpacktxt    = 'M|tpckanz'
.formula M|tgtlanzpacktxt    = 'M|tfmenge' + " INNER" ? M|tlayoutx="G" ; M|tlayoutx="M"
.. E1
.. free area for supplier
.. E2
.formula M|tgtlverwschl      = H|verwschl
.formula M|tgtlartikelbez    = M|tartikel^vkbezbspr
.. A3, D1
.formula M|tgtlpus = H|kopf^edllsnr
.formula M|tgtlpus = 2|labnr        ? F|empty(M|tgtlpus)
.formula M|tgtlpus = M|tlsnr^nummer ? F|empty(M|tgtlpus)
.. note: different whitespaces for license plate and 2d-barcode
.formula M|tlicensepl = "(1J) " + "UN " + U|xtDUNSnohyphen + " " + 'M|tlspcknr' ? M|tlayoutx="S"
.formula M|tlicensepl = "(5J) " + "UN " + U|xtDUNSnohyphen + " " + 'M|tlspcknr' ? M|tlayoutx="G"
.formula M|tlicensepl = "(6J) " + "UN " + U|xtDUNSnohyphen + " " + 'M|tlspcknr' ? M|tlayoutx="M"
.formula M|t1jbarcode =  "1J" + "UN" + U|xtDUNSnohyphen + 'M|tlspcknr' ? M|tlayoutx="S"
.formula M|t1jbarcode =  "5J" + "UN" + U|xtDUNSnohyphen + 'M|tlspcknr' ? M|tlayoutx="G"
.formula M|t1jbarcode =  "6J" + "UN" + U|xtDUNSnohyphen + 'M|tlspcknr' ? M|tlayoutx="M"
.continue MIXED
..
..
!MIXED
.. clear  content related data fields, if "mixed label"
.continue EPMGEMEIN  ?  U|xtpackmitken <> "G"
.. clear product data
.formula M|tgtlartnr         = ""
.formula M|tgtlkuartnr       = ""
.formula M|tgtlteilgenstand  = ""
.formula M|tgtlchargennr     = ""
.formula M|tgtlartikelbez    = ""
.formula M|tgtlanzpack     = M|tfmenge  
.formula M|tgtlanzpacktxt = 'M|tfmenge' + " INNER" 
.copy M|tgefahrgut    = G|false
!EPMGEMEIN
..
..*****************************************************************************
!END
.continue
