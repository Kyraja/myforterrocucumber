..  Funktion       :
..
..  Ablauf         : Input:   xtpruef --> Zeile zur Berechnung (Prfzahl)
..                   Output:  xtprzi  --> Pruefziffer
..                   Testprogramm: <Text> TEST11 <zeigen>
..
..  Functionality  :
..
..  Program flow  :
..  Includes      :
..*****************************************************************************
.set trans -
.type integer xi1        ? _defined(xi1)
.type integer xi2        ? _defined(xi2)
.type integer xisum      ? _defined(xisum)
.type integer xmod       ? _defined(xmod)
.type integer xirest     ? _defined(xirest)
.type text xta       ? _defined(xta)
.type text xtb       ? _defined(xtb)
.type text xtref     ? _defined(xtref)
.type text xt1tmp    ? _defined(xt1tmp)
.type text xt2tmp    ? _defined(xt2tmp)
.type text xtprzi    ? _defined(xtprzi)
..
.. Modulo 11  , Faktoren zur Gewichtung
..             |5   |10  |15  |20  |25  |30
.formula T|xtp = "432765432765432765432765432765432"
.. lesen "Zeile" xtref
.. .formel xtref = "000100001200024117003266017810304"
.formula T|xtref = T|xtpruef
..
.formula T|xi1 = 0
.formula T|xt1tmp = T|xtref
.formula T|xt2tmp = T|xtp
..
!MARKE:
.. Referenz
.formula T|xta    = T|xt1tmp >> 1
.formula T|xt1tmp = T|xt1tmp >> -1
.formula T|xi1    = T|xta
.. Faktor
.formula T|xtb    = T|xt2tmp >> 1
.formula T|xt2tmp = T|xt2tmp >> -1
.formula T|xi2    = T|xtb
.. Summe
.formula T|xisum = T|xisum + (T|xi1*T|xi2)
..
.continue MARKE ? +T|xt1tmp>0 & +T|xt2tmp>0
..
.formula T|xmod=11
.formula T|xirest=T|xisum//T|xmod
.formula T|xtprzi=0 ? T|xirest=0
..
.continue ENDE ? T|xirest=0
..
.formula T|xtprzi=T|xmod-T|xirest
..
!ENDE:
.continue
