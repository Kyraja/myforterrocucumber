..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SPEDWHG.TAB.VDA.4994.FO
.. Author         : calbayrak
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : fill data fields for label VDA 4994
..*****************************************************************************
.set trans -
..
..
..<META M|='vk/SPEDWHG' >
..
.. sales item with packaging mateiral
..<META H|='P3:2' >
.. sales item for product
..<META 2|='P3:2' >
.. blanket order item for product
..<META 3|='P3:1.2' >
.. sales header
..<META 5|='P3:1' > 
.. shipping order
..<META 7|='P55:1' > 
..
..
..*****************************************************************************
.. FIELD DATA
..*****************************************************************************
..
..
.type text xday   ? _F|defined(U|xday)
.type text xmonth ? _F|defined(U|xmonth)
.type text xyear  ? _F|defined(U|xyear)
.type text xhour  ? _F|defined(U|xhour)
.type text xmin   ? _F|defined(U|xmin)
.type text U|xeta ? _F|defined(U|xeta)
..
..
.type integer xint  ? _F|defined(U|xint)
.. DUNS is printed without hypen in license plate
.type text   xtDUNSnohyphen  ? _F|defined(U|xtDUNSnohyphen)
.formula U|xtDUNSnohyphen = F|regreplaceall('M|kliduns', "-", "")
..
..
!VDA4994: VDA 4994
.. A1
.formula M|tlians         = M|klians
.formula M|tliort         = M|kliort
.formula M|tliplz         = M|kliplz
.formula M|turlandiso2    = M|tartikel^urland^iso2
.formula M|tliiso2        = M|kliiso2
..
.. A2
.formula M|tkuans1        = M|kempans
.formula M|tempstr        = M|kempstr
.formula M|temport        = M|kemport
.formula M|tempstaat      = M|kempstaat
..
..
.. A3
.. In VDA4994 We use MIX instead of G
.formula M|tlayoutx       = "MIX"                                                              ? M|tlayoutx = "G"
.. B1 
..
.. B3
..
.continue NOETA ? _F|defined(7|eindatsoll)
.continue NOETA ? F|empty(7|eindatsoll)
.formula U|xday           = ("00"   + 'F|day(7|eindatsoll)') >>2
.formula U|xmonth         = ("00"   + 'F|month(7|eindatsoll)') >>2
.formula U|xyear          = ("0000" + 'F|year(7|eindatsoll)') >>4
.formula U|xhour          = ("00"   + '7|einzsoll'<$":" ) >>2
.formula U|xmin           = ("00"   + '7|einzsoll'>$":" ) >>2
.formula U|xeta           = U|xyear + "-"      + U|xmonth         + "-"         + U|xday
.formula M|teta           = U|xeta  + "/"      + U|xhour          + ":"         + U|xmin
..
.. ETA Code Version 2015 12 22 1430
.formula M|tetacode       = U|xyear + U|xmonth + U|xday           + U|xhour     + U|xmin 
!NOETA
..
.. TODO 
.assign M|tarteinheit     = H|he
..
.. C
..
..
.. D2
.formula M|tanzpackinnertxt    = 'M|tpckanzinner'        + " INNER"                                      ? M|tlayoutx="MIX" ; M|tlayoutx="M"
.. E1
.. free area for supplier
.. E2
.formula M|tverwschl      =  3|kopf^verwschl ? F|defined(3|id)
..
..
.. A3, D1
.. note: different whitespaces for license plate and 2d-barcode
.formula M|tlicensepl     = "(1J) " + "UN "    + U|xtDUNSnohyphen + " "         + 'M|tlspcknr' ? M|tlayoutx="S"
.formula M|tlicensepl     = "(5J) " + "UN "    + U|xtDUNSnohyphen + " "         + 'M|tlspcknr' ? M|tlayoutx="MIX"
.formula M|tlicensepl     = "(6J) " + "UN "    + U|xtDUNSnohyphen + " "         + 'M|tlspcknr' ? M|tlayoutx="M"
.formula M|t1jbarcode     =  "1J"   + "UN"     + U|xtDUNSnohyphen + 'M|tlspcknr'               ? M|tlayoutx="S"
.formula M|t1jbarcode     =  "5J"   + "UN"     + U|xtDUNSnohyphen + 'M|tlspcknr'               ? M|tlayoutx="G"
.formula M|t1jbarcode     =  "6J"   + "UN"     + U|xtDUNSnohyphen + 'M|tlspcknr'               ? M|tlayoutx="M"
.continue MIXED
..
..
!MIXED
.. clear  content related data fields, if "mixed label"
.continue EMIXED                                                                            ?   M|tlayoutx <> "G"
.. clear product data
.formula M|tartkuartnr    = ""
.formula M|tartzei        = ""
.formula M|tlsartchg      = ""
.formula M|tpacksucherw   = ""
!EMIXED
..
..
..*****************************************************************************
.. BARCODES
..*****************************************************************************
..
.continue NOVDA ?  F|empty(M|tlsnr)
..
.. Control characters are converted to controls in jasper!
.type text xt    ? _F|defined(U|xt)
.type text xtrs  ? _F|defined(U|xtrs)
.type text xtgs  ? _F|defined(U|xtgs)
.type text xteot ? _F|defined(U|xteot)
.formula U|xtrs  = "-RS-"
.formula U|xtgs  = "-GS-"
.formula U|xteot = "-EOT-"
..
.type text xtkennung ? _F|defined(U|xtkennung)
.type text xtversion ? _F|defined(U|xtversion)
.formula U|xtkennung = "12PGTL3"
.formula U|xtversion = "9K01"
..
.. Compose barcode data
.formula U|xt = U|xtrs + U|xtkennung + U|xtgs + U|xtversion
.formula U|xt = U|xt + U|xtgs  + "3L"  + 'M|tliefnr'
.formula U|xt = U|xt + U|xtgs  + "4L"  + 'M|turlandiso2'
.formula U|xt = U|xt + U|xtgs  + "8V"  + 'M|kwerk' 
.formula U|xt = U|xt + U|xtgs  + "2L"  + 'M|tkuablade'   
.formula U|xt = U|xt + U|xtgs  + "20L" + 'M|tlagerort'
.formula U|xt = U|xt + U|xtgs  + "V"   + 'M|tliefnr'
.formula U|xt = U|xt + U|xtgs  + "2S"  + 'M|tlsnr^nummer'
.. Verbrauchsstelle?
.formula U|xt = U|xt + U|xtgs  + "8D"  + 'M|tetacode' + "2"
.formula U|xt = U|xt + U|xtgs  + "Q"   + 'M|tfmenge'
.. Einheit
.formula U|xt = U|xt + U|xtgs  + "2Q"  + 'M|tgewbrutto'
.formula U|xt = U|xt + U|xtgs  + "P"   +  M|tartkuartnr 
..
.formula U|xt = U|xt + U|xtgs  + "1J"  + "UN" + U|xtDUNSnohyphen + 'M|tlspcknr'   ? M|tlayoutx="S"
.formula U|xt = U|xt + U|xtgs  + "5J"  + "UN" + U|xtDUNSnohyphen + 'M|tlspcknr'   ? M|tlayoutx="G"
.formula U|xt = U|xt + U|xtgs  + "6J"  + "UN" + U|xtDUNSnohyphen + 'M|tlspcknr'   ? M|tlayoutx="M"
.formula U|xt = U|xt + U|xtgs  + "B"   +  M|tpackkuartnr
.formula U|xt = U|xt + U|xtgs  + "1T"  + 'M|tlsartchg'                            ?  M|tlayoutx="S"  & _F|empty(M|tlsartchg)
.formula U|xt = U|xt + U|xtgs  + "2P"  + 'M|tartzei'                              ? _F|empty(M|tartzei)
..
.. Hide control values when displaying in info system
.type text xtregex ? _F|defined(U|xtregex)
.type text xtfact  ? _F|defined(U|xtfact)
.formula U|xtregex = U|xtrs +U|xtfact +"|"    +U|xtrs+"|"+U|xtgs+"|"+U|xteot
.formula U|xt      = U|xt   + U|xtrs  + U|xteot
.continue DMCSIZE  ? +U|xt > 255
.formula M|tvda4994dmccode = U|xt
.formula M|tvda4994dmc = F|regreplaceall(U|xt, U|xtregex, "")
..
!NOVDA
.continue
..
..*****************************************************************************
!END
.continue
..
!DMCSIZE
.error Die Daten fÅr den Data Matrix Code sind zu lang.      
.end 1
