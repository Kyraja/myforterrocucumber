..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SPEDWBS.EV.FO
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : Write select criterias for the freight forwarding order
...Includes
..  include     is/KOPFLEEREN
..*****************************************************************************
.set trans -
..
.type text xselect
.type text xvkspednr
.type bool xbmitptext
.type bool xbohnepackzubehoer
..
..
.formula M|select = ""   ? M|select = "!"
..
..
..  Event evaluation
.. ----------- ----- Start-Button -- -------------------------------------------
.continue TABINIT         ? T|evtartengl = "FIELD_EXIT"    &  T|evtvar = "kbohnepackzubehoer"
.continue TABINIT         ? T|evtartengl = "FIELD_EXIT"    &  T|evtvar = "kbmitptext"
.continue SPED            ? T|evtartengl = "FIELD_EXIT"    &  T|evtvar/"*sped*"
.. ----------- ---------- ---------- -------------------------------------------
.continue BSTART          ? T|evtartengl = "BUTTON_BEFORE"  &  T|evtvar = "bstart"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!SPED: Selektion nach Speditionsauftrag / Selection by shipping order
.formula M|select = "$,,;@gruppe=1;ktyp=4;@ablageart=(3);sped=" + M|vkspednr^id    ? M|vkspednr<>""
.formula M|select = ""  ? M|vkspednr = ""
.continue TABINIT
..
..
!BSTART: M|select prfen  / check the value from M|select
.continue FBSTART ? F|empty(M|select)
.make screen line -- ? M|tzeilen > 0
.select sales 'M|select'
.continue END ? _G|mehr
.formula M|vkspedbeleg = M|vkspednr^nummer
.input 'M|bkopf'
.continue END 
..
!TABINIT: a key field was changed, remove old rows, clear header "output"
.formula U|xselect = M|select
.formula U|xvkspednr = M|vkspednr^id
.copy U|xbmitptext = M|kbmitptext
.copy U|xbohnepackzubehoer = M|kbohnepackzubehoer
.input "is/KOPFLEEREN"
.formula M|select = U|xselect
.formula M|vkspednr = U|xvkspednr
.copy M|kbmitptext = U|xbmitptext
.copy M|kbohnepackzubehoer = U|xbohnepackzubehoer
.make screen line -- ? M|tzeilen > 0
.continue END
..
..*****************************************************************************
!END
.continue
..
!FBSTART:
.error Bitte geben Sie einen Speditionsauftrag oder einen Lieferschein ein.
.end 1
