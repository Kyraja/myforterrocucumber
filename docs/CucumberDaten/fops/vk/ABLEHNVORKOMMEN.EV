..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABLEHNVORKOMMEN.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt zentral die Feld und Zeilenereignisse.
.. Functionality  : Central handling of field and row events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header:  -------------------------------------
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ablageart"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vomvom"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vombis"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vkpartner"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "betreuer"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "chko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "vkanko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "zeigwerte"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "zeigrelativ"
.continue VALUE   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "zeigwerte"
.continue RELATIV ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "zeigrelativ"
..==============================================================================
.continue END
..
!VALUE: Set visibility to VALUE
.assign P|maskkontextfop = F|trim(F|regreplaceall(P|maskkontextfop, "VALUE", ""))
.assign P|maskkontextfop = "VALUE" ? M|zeigwerte & F|empty(P|maskkontextfop)
.assign P|maskkontextfop = F|formatstr("{1} {2}", P|maskkontextfop, "VALUE") ? M|zeigwerte & _F|empty(P|maskkontextfop)
.continue END
..
!RELATIV: Set visibility to RELATIVE
.assign P|maskkontextfop = F|trim(F|regreplaceall(P|maskkontextfop, "RELATIVE", ""))
.assign P|maskkontextfop = "RELATIVE" ? M|zeigrelativ & F|empty(P|maskkontextfop)
.assign P|maskkontextfop = F|formatstr("{1} {2}", P|maskkontextfop, "RELATIVE") ? M|zeigrelativ & _F|empty(P|maskkontextfop)
.continue END
..
!CLRREP: Clear report
.input "vk/ABLEHNVORKOMMEN.BK"
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
