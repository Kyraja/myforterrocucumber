..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PIPELINE.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : DB-Anfrage mehrstufig durchfuehren und Treffer auswerten.
.. Functionality  : Execute query in a multi-level way and analyse hits.
..*****************************************************************************
.set trans -
..
.. Init 1st level
.formula M|stufe = 1
.input "vk/PIPELINE.BKOPF"
..
.. No levels neccessary
.continue COMPLET ? M|stufe = M|anzstufen
..
.. Start with Opportunities
.assign M|kotyp = "(Opportunity)"
..
!COMPLET: Complete database query
.formula M|select = F|formatstr(M|preselect, "$", M|ablageart, M|kotyp)
.input "is/HOL.LISTE.EVPOS"
.continue SECOND ? M|stufe < M|anzstufen
.continue TABEND
..
!SECOND: 2nd level
.formula M|stufe = M|stufe + 1
.assign M|kotyp = "(Quotation)"
.continue COMPLET
..
!TABEND: End of row filling
.formula M|summe = M|chsumme + M|ansumme
.formula M|summealtpos = M|chsummealtpos + M|ansummealtpos
..
.. Calculate average of sums
.formula M|durchschnitt1 = F|round(M|summe/10, 2)   ? _F|empty(M|summe)
.. Calculate average of sums of opportunities
.formula M|durchschnitt2 = F|round(M|chsumme/10, 2) ? _F|empty(M|chsumme)
.. Calculate average of sums of quotations
.formula M|durchschnitt3 = F|round(M|ansumme/10, 2) ? _F|empty(M|ansumme)
..
.. Calculate totals of both
.formula M|bis10 = M|chbis10 + M|anbis10
.formula M|bis20 = M|chbis20 + M|anbis20
.formula M|bis30 = M|chbis30 + M|anbis30
.formula M|bis40 = M|chbis40 + M|anbis40
.formula M|bis50 = M|chbis50 + M|anbis50
.formula M|bis60 = M|chbis60 + M|anbis60
.formula M|bis70 = M|chbis70 + M|anbis70
.formula M|bis80 = M|chbis80 + M|anbis80
.formula M|bis90 = M|chbis90 + M|anbis90
.formula M|bis100 = M|chbis100 + M|anbis100
..*****************************************************************************
!END
.continue
