..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.KENNZAHL.VKWERT.FC
..==
..==  Pfad              : owprjm
..==
..==  Funktion          :
..==
..==
..==  Erstellungsdatum  : 04.05.2011
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
.input PRJM.KONFIG.INI      ? _F|defined(U|xydbgrpvorgang)
.input LART.KONFIG.INI      ? _F|defined(U|xydbgrversatz)
..====================================================
.type text    xyindkst          ? _F|defined(U|xyindkst)
.type text    xyindpers         ? _F|defined(U|xyindpers)
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xrfcwert          ? _F|defined(U|xrfcwert)
.type real    xrpvwert          ? _F|defined(U|xrpvwert)
.type integer xianz             ? _F|defined(U|xianz)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type GD      xdstichtag        ? _F|defined(U|xdstichtag)
.type GD      xdkonddat         ? _F|defined(U|xdkonddat)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EL001 ? _(F|empty(U|xdstichtag))
.formula U|xdstichtag = ('G|datum:8')<<6      + "01"
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula U|xdstichtag =  U|xdstichtag - 1
!EL001
.continue EL002 ? _(_(F|empty(U|xtprojekt)))
.load 7 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL003 ? _(G|mehr)
.formula U|xrwert    = 0
.formula U|xrfcwert  = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP001
!ELOP001: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xt001)))
.formula U|xrfcwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
.continue LOOP002
!ELOP002: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP003: ==============================
.continue ELOP003 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP003
!ELOP003: ==============================
.continue EL004 ? _(7|yabrechtypk = "FPR")

.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt==" + 7|id
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 9 group 'U|xydbgrvkstat' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xt001  = ('9|ybezugsdatum:8')<<6 + "01"
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.formula U|xrfcwert       = U|xrfcwert       + 9|ynwert
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + 9|ynwert
.load 9 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="      + 7|id
.formula U|xtsel = U|xtsel + ";ybnachtrfordzeile==1"
.formula U|xtsel = U|xtsel + ";yakzeptanz==`"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 9 group 'U|xydbgrnachtrstatistik' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xt001  = ('9|ybezugsdatum:8')<<6 + "01"
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.formula U|xrfcwert       = U|xrfcwert       + 9|yanferwwert
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + 9|yanferwwert
.load 9 continue
.continue LOOP005
!ELOP005: ==============================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="      + 7|id
.formula U|xtsel = U|xtsel + ";ybnachtrfordzeile==0"
.formula U|xtsel = U|xtsel + ";yakzeptanz==`"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 9 group 'U|xydbgrnachtrstatistik' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xt001  = ('9|ybezugsdatum:8')<<6 + "01"
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.formula U|xrfcwert       = U|xrfcwert       + 9|yanferwwert
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + 9|yanferwwert
.load 9 continue
.continue LOOP006
!ELOP006: ==============================
.continue FI004
!EL004
..= Rechnungswert Ende Vormonat + Nicht abgerechnete erbrachte Leistungen + Reststunden aus Stundenverteilung * VK-Qualisatz
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";yadatum<=" + 'U|xdstichtag:8' + ";@ablageart=(1)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.formula U|xt001  = ('9|yadatum:8')<<6 + "01"
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.formula U|xrfcwert       = U|xrfcwert       + (9|yarbzeit * 9|ylmpreis)                ? _9|ylmpreis = 0
.formula U|xrfcwert       = U|xrfcwert       + (9|yarbzeit * 9|ypvorgang^ybudgetsatz)   ?  9|ylmpreis = 0
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + (9|yarbzeit * 9|ylmpreis)                ? _9|ylmpreis = 0
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + (9|yarbzeit * 9|ypvorgang^ybudgetsatz)   ?  9|ylmpreis = 0
.load 9 continue
.continue LOOP007
!ELOP007: ==============================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="  + U|xtprojekt
.formula U|xtsel = U|xtsel + ";yistblatt==1"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 8 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.formula U|xtsel = "$,,ypvorgang==" + 8|id + ";ydatum>" + 'U|xdstichtag:8' + ";ybsim==0;@ablageart=(1)"
.load 6 group "154:2" 'U|xtsel'
!LOOP009: ==============================
.continue ELOP009 ? _(G|mehr)
.formula U|xt001  = ('6|ydatum:8')<<6 + "01"
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.continue EL005 ? _(F|empty(8|yvkartikel))
.formula U|xrfcwert       = U|xrfcwert       + (6|ywert * 8|ybudgetsatz)
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + (6|ywert * 8|ybudgetsatz)
.continue FI005
!EL005
.input "is/PREISAUSKUNFT"   ? _F|defined(U|xpaartikel)
.copy    U|xpaartikel = 8|yvkartikel
.formula U|xpprojekt  = U|xtprojekt
.assign  U|xdkonddat  = 6|ydatum
.input 'U|xtupartpreis'
.formula U|xrfcwert       = U|xrfcwert       + (6|ywert * U|xpapreis)
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + (6|ywert * U|xpapreis)
!FI005
.load 6 continue
.continue LOOP009
!ELOP009: ==============================
.load 8 continue
.continue LOOP008
!ELOP008: ==============================
!FI004
.continue EL006 ? _(_(F|empty(U|xtkennzahl)))
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP010: ==============================
.continue ELOP010 ? _(G|mehr)
.formula U|xt001 = 9|ydatum:8
.continue EL007 ? _(_(F|defined(U|xrfcwert.xt001)))
.select lock add 9|id
.continue EL008 ? _((H|ywert     = 0) & (H|yvokawert = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI008
!EL008
.formula H|yfcwert = 0
.rewrite
!FI008
.continue FI007
!EL007
.continue EL009 ? _(U|xrfcwert.xt001 = 0)
.select lock add 9|id
.continue EL010 ? _((H|ywert     = 0) & (H|yvokawert = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI010
!EL010
.formula H|yfcwert = 0
.rewrite
!FI010
!EL009
!FI007
.load 9 continue
.continue LOOP010
!ELOP010: ==============================
.continue EL011 ? _(U|xrfcwert  = 0)
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP011: ==============================
.continue ELOP011 ? _(G|mehr)
.select lock add 9|id
.continue EL012 ? _((H|ywert     = 0) & (H|yvokawert = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI012
!EL012
.formula H|yfcwert = 0
.rewrite
!FI012
.load 9 continue
.continue LOOP011
!ELOP011: ==============================
!EL011
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
!LOOP012: ==============================
.continue ELOP012 ? _(_(F|empty(U|xt001)))
.continue EL013 ? _(_(U|xrfcwert.xt001 = 0))
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL014 ? _(G|mehr)
.select lock add 9|id
.continue EL015 ? _(G|mehr)
.assign  H|yprojekt = 7|id
.formula H|yfcwert  = U|xrfcwert.xt001
.rewrite
!EL015
.continue FI014
!EL014
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|yfcwert   =  U|xrfcwert.xt001
.rewrite
!FI014
!EL013
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
.continue LOOP012
!ELOP012: ==============================
.continue EL016 ? _(_(U|xrfcwert  = 0))
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL017 ? _(G|mehr)
.select lock add 9|id
.continue EL018 ? _(G|mehr)
.assign  H|yprojekt = 7|id
.formula H|yfcwert  = U|xrfcwert
.rewrite
!EL018
.continue FI017
!EL017
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|yfcwert    = U|xrfcwert
.rewrite
!FI017
!EL016
!EL006
!EL003
!EL002
.continue
