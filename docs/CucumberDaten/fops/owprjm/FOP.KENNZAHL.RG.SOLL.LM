..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.KENNZAHL.RG.SOLL.LM
..==
..==  Pfad              : owprjm
..==
..==  Funktion          :
..==
..==
..==  Erstellungsdatum  : 27.01.2012
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
.input PRJM.KONFIG.INI  ? _F|defined(U|xydbgrpvorgang)
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xrpvwert          ? _F|defined(U|xrpvwert)
.type integer xianz             ? _F|defined(U|xianz)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.formula U|xrwert    = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP001
!ELOP001: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP002
!ELOP002: ==============================
.continue EL001 ? _(_(F|empty(U|xtprojekt)))
.load 7 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL002 ? _(G|mehr)
.formula U|xdatum = ('G|datum:8')<<6 + "01"
.formula U|xdatum = U|xdatum - 1
.continue EL003 ? _((U|xdadatum < U|xdatum) ; (F|empty(U|xdadatum)))
.formula U|xdatum = U|xdedatum          ? U|xdedatum < U|xdatum & _F|empty(U|xdadatum)
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";yadatum=" + 'U|xdadatum' + "!" + 'U|xdatum' + ";@ablageart=(1)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xt001  = ('9|yadatum:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.formula U|xristwert      = U|xristwert      + 9|ylmwert
.formula U|xrwert         = U|xrwert         + 9|ylmwert
.formula U|xrwert.xt001   = U|xrwert.xt001   + 9|ylmwert
.load 9 continue
.continue LOOP003
!ELOP003: ==============================
!EL003
.continue EL004 ? _((U|xbberech) & (_(F|empty(U|xtkennzahl))))
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xt001 = 9|ydatum:8
.continue EL005 ? _(_(F|defined(U|xrwert.xt001)))
.select lock add 9|id
.delete     ? G|mehr
.continue FI005
!EL005
.continue EL006 ? _(U|xrwert.xt001 = 0)
.select lock add 9|id
.delete     ? G|mehr
!EL006
!FI005
.load 9 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP005: ==============================
.continue ELOP005 ? _(_(F|empty(U|xt001)))
.continue EL007 ? _(U|xrwert.xt001 <> 0)
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL008 ? _(G|mehr)
.select lock add 9|id
.continue EL009 ? _(G|mehr)
.assign  H|yprojekt = 7|id
.formula H|yfcwert  = U|xrwert.xt001
.rewrite
!EL009
.continue FI008
!EL008
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|yfcwert   =  U|xrwert.xt001
.rewrite
!FI008
!EL007
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP005
!ELOP005: ==============================
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL010 ? _(G|mehr)
.select lock add 9|id
.continue EL011 ? _(G|mehr)
.assign  H|yprojekt = 7|id
.formula H|yfcwert  = U|xristwert
.rewrite
!EL011
.continue FI010
!EL010
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|yfcwert   =  U|xristwert
.rewrite
!FI010
!EL004
.load 7 continue
!EL002
!EL001
.continue
