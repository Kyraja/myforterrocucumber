..!interpreter english declaration noabbrev
.. at 2016-04-21, 16:22
.set TRANS -
..========================================================================
..==  Name              : FOP.KENNZAHL.REWERT
..==  Pfad              : owprjm
..==  Erstellungsdatum  : 28.09.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input PRJM.KONFIG.INI  ? _F|defined(U|xydbgrpvorgang)
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type text    xtprojleistkatid  ? _F|defined(U|xtprojleistkatid)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xrpvwert          ? _F|defined(U|xrpvwert)
.type real    xpapreis          ? _F|defined(U|xpapreis)
.type integer xianz             ? _F|defined(U|xianz)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type GD      xdkonddat         ? _F|defined(U|xdkonddat)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type TAZ1    xpape             ? _F|defined(U|xpape)
.'F|expr("type P" + U|xydbgrprojekt + " xpprojekt")     ? _F|defined(U|xpprojekt)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpaartikel)
.formula U|xrwert    = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP001
!ELOP001: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP002
!ELOP002: ==============================
.continue EL001 ? _(_(F|empty(U|xtprojekt)))
.formula U|xtsel = "$,,projekt==" + U|xtprojekt + ";kotyp==(" + 'G|REKO' + ");@ablageart=(3)"
.load 7 sales 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xt001  = ('7|kopf^budat:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.type real xrpvwert.xt001       ? _F|defined(U|xrpvwert.xt001)
.formula U|xristwert      = U|xristwert      + 7|nwert                                          ?  7|pland = G|inland
.formula U|xristwert      = U|xristwert      + F|fxamount(G|inland,7|nwert,,7|pland,G|TRUE)     ? _7|pland = G|inland
.formula U|xrwert         = U|xrwert         + 7|nwert                                          ?  7|pland = G|inland
.formula U|xrwert         = U|xrwert         + F|fxamount(G|inland,7|nwert,,7|pland,G|TRUE)     ? _7|pland = G|inland
.formula U|xrwert.xt001   = U|xrwert.xt001   + 7|nwert                                          ?  7|pland = G|inland
.formula U|xrwert.xt001   = U|xrwert.xt001   + F|fxamount(G|inland,7|nwert,,7|pland,G|TRUE)     ? _7|pland = G|inland
.formula U|xrpvwert.xt001 = U|xrpvwert.xt001 + 7|nwert                                          ?  7|pland = G|inland
.formula U|xrpvwert.xt001 = U|xrpvwert.xt001 + F|fxamount(G|inland,7|nwert,,7|pland,G|TRUE)     ? _7|pland = G|inland
.load 7 continue
.continue LOOP003
!ELOP003: ==============================
.continue EL002 ? _((U|xbberech) & (_(F|empty(U|xtkennzahl))))
.formula U|xtsel = "$,,yprojekt==" + U|xtprojekt + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xt001 = 8|ydatum:8
.continue EL003 ? _(_(F|defined(U|xrwert.xt001)))
.select lock add 8|id
.delete     ? G|mehr
.continue FI003
!EL003
.continue EL004 ? _(U|xrwert.xt001 = 0)
.select lock add 8|id
.delete     ? G|mehr
!EL004
!FI003
.load 8 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP005: ==============================
.continue ELOP005 ? _(_(F|empty(U|xt001)))
.continue EL005 ? _(U|xrpvwert.xt001 <> 0)
.formula U|xtsel = "$,,yprojekt==" + U|xtprojekt + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
.continue EL006 ? _(G|mehr)
.select lock add 8|id
.continue EL007 ? _(G|mehr)
.assign  H|yprojekt = U|xtprojekt
.formula H|ywert    = U|xrpvwert.xt001
.rewrite
!EL007
.continue FI006
!EL006
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = U|xtprojekt
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = H|yprojekt^such
.formula H|name      = H|yprojekt^name
.formula H|ydatum    = 'U|xt001'
.formula H|ywert     =  U|xrpvwert.xt001
.rewrite
!FI006
.continue FI005
!EL005
.formula U|xtsel = "$,,yprojekt==" + U|xtprojekt + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.select lock group "154:1" '8|id'
.delete
.load 8 continue
.continue LOOP006
!ELOP006: ==============================
!FI005
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP005
!ELOP005: ==============================
.formula U|xtsel = "$,,yprojekt==" + U|xtprojekt + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
.continue EL008 ? _(G|mehr)
.select lock add 8|id
.continue EL009 ? _(G|mehr)
.assign  H|yprojekt = U|xtprojekt
.formula H|ywert    = U|xristwert
.rewrite
!EL009
.continue FI008
!EL008
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = U|xtprojekt
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = H|yprojekt^such
.formula H|name      = H|yprojekt^name
.formula H|ydatum    = 'U|xt001'
.formula H|ywert     =  U|xristwert
.rewrite
!FI008
!EL002
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP007: ==============================
.continue ELOP007 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP007
!ELOP007: ==============================
!EL001
.continue
