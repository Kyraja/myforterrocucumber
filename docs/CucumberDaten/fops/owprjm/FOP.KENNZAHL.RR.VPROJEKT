..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.KENNZAHL.RR.VPROJEKT
..==
..==  Pfad              : owprjm
..==
..==  Funktion          :
..==
..==
..==  Erstellungsdatum  : 01.03.2013
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Copyright         : (c) 1990 - 2013 alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
.input PRJM.KONFIG.INI  ? _F|defined(U|xydbgrpvorgang)
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type text    xtprojleistkatid  ? _F|defined(U|xtprojleistkatid)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xpapreis          ? _F|defined(U|xpapreis)
.type integer xianz             ? _F|defined(U|xianz)
.type integer xistufe           ? _F|defined(U|xistufe)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type GD      xdkonddat         ? _F|defined(U|xdkonddat)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type TAZ1    xpape             ? _F|defined(U|xpape)
.'F|expr("type P" + U|xydbgrprojekt + " xpprojekt")     ? _F|defined(U|xpprojekt)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Werte_zu_Kostenart -----
.formula U|xtsel = "$,,zkoart==" + H|koart^id + ";@ablageart=(1);@zeilen=(1)"
.load 6 group "5:1" 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.load 6 line '6|selzeile'
.formula U|xtsel = "$,,konto==" + 6|id + ";kstelle==" + 7|yvprojekt^yktr^id + ";budat<=" + 'U|xdstichtag' + ";@ablageart=(3);@gruppe=0.1"
.load 8 group "131:0.1" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL001 ? _(((8|budat >= 6|koartvon) ; (F|empty(6|koartvon))) & ((8|budat <= 6|koartbis) ; (F|empty(6|koartbis))))
.formula U|xt001  = ('8|budat:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.formula U|xristwert      = U|xristwert      + 8|betrag       ?  8|soll
.formula U|xristwert      = U|xristwert      - 8|betrag       ? _8|soll
.formula U|xrwert         = U|xrwert         + 8|betrag       ?  8|soll
.formula U|xrwert         = U|xrwert         - 8|betrag       ? _8|soll
.formula U|xrwert.xt001   = U|xrwert.xt001   + 8|betrag       ?  8|soll
.formula U|xrwert.xt001   = U|xrwert.xt001   - 8|betrag       ? _8|soll
!EL001
.load 8 continue
.continue LOOP002
!ELOP002: ==============================
.load 6 continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Rechenregel -----
.formula U|xistufe = U|xistufe + 1
.reserve LIFO
.select add H|koart
.select line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL002 ? _(H|koart^gruppe = 2)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue FI002
!EL002
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!FI002
.select line
.continue LOOP003
!ELOP003: ==============================
.select lifo
.formula U|xistufe = U|xistufe - 1
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula U|xrwert    = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP004: ==============================
.continue ELOP004 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP004
!ELOP004: ==============================
.continue EL003 ? _((F|defined(U|xtrr)) & (_(F|empty(U|xtprojekt))))
.load 7 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL004 ? _(G|mehr)
.continue EL005 ? _(_(F|empty(7|yvprojekt)))
.continue EL006 ? _(_(F|empty(7|yvprojekt^yktr)))
.select group "60:2" 'U|xtrr'
.continue EL007 ? _(G|mehr)
.select line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL008 ? _(H|koart^gruppe = 2)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.continue FI008
!EL008
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
!FI008
.select line
.continue LOOP005
!ELOP005: ==============================
!EL007
!EL006
!EL005
.continue EL009 ? _((U|xbberech) & (_(F|empty(U|xtkennzahl))))
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xt001 = 8|ydatum:8
.continue EL010 ? _(_(F|defined(U|xrwert.xt001)))
.select lock add 8|id
.delete     ? G|mehr
.continue FI010
!EL010
.continue EL011 ? _(U|xrwert.xt001 = 0)
.select lock add 8|id
.delete     ? G|mehr
!EL011
!FI010
.load 8 continue
.continue LOOP006
!ELOP006: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP007: ==============================
.continue ELOP007 ? _(_(F|empty(U|xt001)))
.continue EL012 ? _(_(U|xrwert.xt001 = 0))
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
.continue EL013 ? _(G|mehr)
.select lock add 8|id
.continue EL014 ? _(G|mehr)
.assign  H|yprojekt  = 7|id
.formula H|ywert     = U|xrwert.xt001
.rewrite
!EL014
.continue FI013
!EL013
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    ='U|xt001'
.formula H|ywert     = U|xrwert.xt001
.rewrite
!FI013
!EL012
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP007
!ELOP007: ==============================
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
.continue EL015 ? _(G|mehr)
.select lock add 8|id
.continue EL016 ? _(G|mehr)
.assign  H|yprojekt  = 7|id
.formula H|ywert     = U|xristwert
.rewrite
!EL016
.continue FI015
!EL015
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    ='U|xt001'
.formula H|ywert     = U|xristwert
.rewrite
!FI015
!EL009
!EL004
!EL003
.continue
