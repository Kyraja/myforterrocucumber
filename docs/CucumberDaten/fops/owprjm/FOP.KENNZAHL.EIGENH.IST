..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.KENNZAHL.EIGENH.IST
..==
..==  Pfad              : owprjm
..==
..==  Funktion          :
..==
..==
..==  Erstellungsdatum  : 04.05.2011
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
.input PRJM.KONFIG.INI  ? _F|defined(U|xydbgrpvorgang)
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xrfcwert          ? _F|defined(U|xrfcwert)
.type real    xrpvwert          ? _F|defined(U|xrpvwert)
.type integer xianz             ? _F|defined(U|xianz)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type GD      xdstichtag        ? _F|defined(U|xdstichtag)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EL001 ? _(F|empty(U|xdstichtag))
.formula U|xdstichtag = ('G|datum:8')<<6      + "01"
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula U|xdstichtag =  U|xdstichtag - 1
!EL001
.continue EL002 ? _(F|empty(U|xtpvorgang))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="  + U|xtprojekt       ? _F|empty(U|xtprojekt)
.formula U|xtsel = U|xtsel + ";yistblatt==1"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 7 group 'U|xydbgrpvorgang' 'U|xtsel'
.continue FI002
!EL002
.load 7 group 'U|xydbgrpvorgang' 'U|xtpvorgang'
!FI002
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xrwert    = 0
.formula U|xrfcwert  = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP002
!ELOP002: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
!LOOP003: ==============================
.continue ELOP003 ? _(_(F|empty(U|xt001)))
.formula U|xrfcwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
.continue LOOP003
!ELOP003: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP004: ==============================
.continue ELOP004 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";@ablageart=(1)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL003 ? _(9|ypersperstypk = "EM")
.formula U|xt001  = ('9|yadatum:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.formula U|xristwert      = U|xristwert      + 9|yarbzeit
.formula U|xrwert         = U|xrwert         + 9|yarbzeit
.formula U|xrwert.xt001   = U|xrwert.xt001   + 9|yarbzeit
!EL003
.load 9 continue
.continue LOOP005
!ELOP005: ==============================
.continue EL004 ? _(_(F|empty(U|xtkennzahl)))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xt001 = 9|ydatum:8
.continue EL005 ? _(_(F|defined(U|xrwert.xt001)))
.select lock add 9|id
.continue EL006 ? _((H|yvokawert = 0) & (H|yfcwert   = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI006
!EL006
.formula H|ywert = 0
.rewrite
!FI006
.continue FI005
!EL005
.continue EL007 ? _(U|xrwert.xt001 = 0)
.select lock add 9|id
.continue EL008 ? _((H|yvokawert = 0) & (H|yfcwert   = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI008
!EL008
.formula H|ywert = 0
.rewrite
!FI008
!EL007
!FI005
.load 9 continue
.continue LOOP006
!ELOP006: ==============================
.continue EL009 ? _(U|xristwert = 0)
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.select lock add 9|id
.continue EL010 ? _((H|yvokawert = 0) & (H|yfcwert   = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI010
!EL010
.formula H|ywert = 0
.rewrite
!FI010
.load 9 continue
.continue LOOP007
!ELOP007: ==============================
!EL009
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP008: ==============================
.continue ELOP008 ? _(_(F|empty(U|xt001)))
.continue EL011 ? _(_(U|xrwert.xt001   = 0))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL012 ? _(G|mehr)
.select lock add 9|id
.continue EL013 ? _(G|mehr)
.assign  H|yprojekt = 7|yprojekt^id
.formula H|ywert    = U|xrwert.xt001
.rewrite
!EL013
.continue FI012
!EL012
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|yprojekt^id
.assign  H|ypvorgang = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|ywert     =  U|xrwert.xt001
.rewrite
!FI012
!EL011
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP008
!ELOP008: ==============================
.continue EL014 ? _(_(U|xristwert = 0))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL015 ? _(G|mehr)
.select lock add 9|id
.continue EL016 ? _(G|mehr)
.assign  H|yprojekt = 7|yprojekt^id
.formula H|ywert    = U|xristwert
.rewrite
!EL016
.continue FI015
!EL015
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|yprojekt^id
.assign  H|ypvorgang = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|ywert     =  U|xristwert
.formula H|yfcwert   =  U|xrfcwert
.rewrite
!FI015
!EL014
!EL004
.load 7 continue
.continue LOOP001
!ELOP001: ==============================
.continue
