..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.KENNZAHL.EURH.FC
..==
..==  Pfad              : owprjm
..==
..==  Funktion          :
..==
..==
..==  Erstellungsdatum  : 04.05.2011
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Copyright         : (c) 1990 - 2012 alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
.input PRJM.KONFIG.INI      ? _F|defined(U|xydbgrpvorgang)
.input LART.KONFIG.INI      ? _F|defined(U|xydbgrversatz)
..====================================================
.type text    xyindkst          ? _F|defined(U|xyindkst)
.type text    xyindpers         ? _F|defined(U|xyindpers)
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xrfcwert          ? _F|defined(U|xrfcwert)
.type real    xrpvwert          ? _F|defined(U|xrpvwert)
.type integer xianz             ? _F|defined(U|xianz)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type GD      xdstichtag        ? _F|defined(U|xdstichtag)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EL001 ? _(F|empty(U|xdstichtag))
.formula U|xdstichtag = ('G|datum:8')<<6      + "01"
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula U|xdstichtag =  U|xdstichtag - 1
!EL001
.continue EL002 ? _(F|empty(U|xtpvorgang))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="  + U|xtprojekt       ? _F|empty(U|xtprojekt)
.formula U|xtsel = U|xtsel + ";yistblatt==1"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 7 group 'U|xydbgrpvorgang' 'U|xtsel'
.continue FI002
!EL002
.load 7 group 'U|xydbgrpvorgang' 'U|xtpvorgang'
!FI002
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xrwert    = 0
.formula U|xrfcwert  = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP002
!ELOP002: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
!LOOP003: ==============================
.continue ELOP003 ? _(_(F|empty(U|xt001)))
.formula U|xrfcwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
.continue LOOP003
!ELOP003: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP004: ==============================
.continue ELOP004 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ybsim==0;@ablageart=(1)"
.load 9 group "154:2" 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL003 ? _(_(F|empty(7|ypersonal)))
.formula U|xt001     = ('9|ydatum:8')<<6 + "01"
.formula U|ximonat   = F|month(9|ydatum)
.formula U|xyindpers = "P" + 7|ypersonal^nummer
.formula U|xyindkst  = "K" + 7|yprojekt^yverantwkst^nummer
.continue EL004 ? _(_(F|defined(U|xysatzgk.xt001.xyindpers)))
.type real xysatzgk.xt001.xyindpers
.continue EL005 ? _(_(F|empty(7|ypersonal^ygkleiart)))
.formula U|xtsel = "$,,yleiart==" + 7|ypersonal^ygkleiart^id + ";ygjahr=" + 'F|year(9|yadatum)' + ";ybstd=1;@ablageart=(1);@zeilen=(1)"
.load 8 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL006 ? _(G|mehr)
.load 8 line '8|selzeile'
.formula U|xysatzgk.xt001.xyindpers = 8|yvsf.ximonat                                                ?  8|yvland = G|inland ;  F|empty(8|yvland)
.formula U|xysatzgk.xt001.xyindpers = F|fxamount(G|inland,8|yvsf.ximonat,M|ystichdatum,8|yvland)    ? _8|yvland = G|inland & _F|empty(8|yvland)
!EL006
!EL005
.continue EL007 ? _(_(F|defined(U|xysatzkst.xt001.xyindkst)))
.type real xysatzkst.xt001.xyindkst
.continue EL008 ? _(_(F|empty(7|yprojekt^yverantwkst^yprjmvollleiart)))
.formula U|xtsel = "$,,ykstelle==" + 7|yprojekt^yverantwkst^id + ";yleiart==" + 7|yprojekt^yverantwkst^yprjmvollleiart^id + ";ygjahr=" + 'F|year(U|xdstichtag)' + ";ybstd=0;@ablageart=(1);@zeilen=(1)"
.load 8 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL009 ? _(G|mehr)
.load 8 line '8|selzeile'
.formula U|xysatzkst.xt001.xyindkst = 8|yvsf.ximonat                                                ?  8|yvland = G|inland ;  F|empty(8|yvland)
.formula U|xysatzkst.xt001.xyindkst = F|fxamount(G|inland,8|yvsf.ximonat,M|ystichdatum,8|yvland)    ? _8|yvland = G|inland & _F|empty(8|yvland)
.continue FI009
!EL009
.formula U|xtsel = "$,,yleiart==" + 7|yprojekt^yverantwkst^yprjmvollleiart^id + ";ygjahr=" + 'F|year(U|xdstichtag)' + ";ybstd=1;@ablageart=(1);@zeilen=(1)"
.load 8 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL010 ? _(G|mehr)
.load 8 line '8|selzeile'
.formula U|xysatzkst.xt001.xyindkst = 8|yvsf.ximonat                                              ?  8|yvland = G|inland ;  F|empty(8|yvland)
.formula U|xysatzkst.xt001.xyindkst = F|fxamount(G|inland,8|yvsf.ximonat,M|ystichdatum,8|yvland)  ? _8|yvland = G|inland & _F|empty(8|yvland)
!EL010
!FI009
!EL008
!EL007
!EL004
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.formula U|xrfcwert       = U|xrfcwert       + (9|ywert * (U|xysatzgk.xt001.xyindpers + U|xysatzkst.xt001.xyindkst))
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + (9|ywert * (U|xysatzgk.xt001.xyindpers + U|xysatzkst.xt001.xyindkst))
.continue FI003
!EL003
.type real xrfcwert.xt001       ? _F|defined(U|xrfcwert.xt001)
.formula U|xrfcwert       = U|xrfcwert       + (9|ywert * 7|ybudgetsatz)
.formula U|xrfcwert.xt001 = U|xrfcwert.xt001 + (9|ywert * 7|ybudgetsatz)
!FI003
.load 9 continue
.continue LOOP005
!ELOP005: ==============================
.continue EL011 ? _(_(F|empty(U|xtkennzahl)))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xt001 = 9|ydatum:8
.continue EL012 ? _(_(F|defined(U|xrfcwert.xt001)))
.select lock add 9|id
.continue EL013 ? _((H|ywert     = 0) & (H|yvokawert = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI013
!EL013
.formula H|yfcwert = 0
.rewrite
!FI013
.continue FI012
!EL012
.continue EL014 ? _(U|xrfcwert.xt001 = 0)
.select lock add 9|id
.continue EL015 ? _((H|ywert     = 0) & (H|yvokawert = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI015
!EL015
.formula H|yfcwert = 0
.rewrite
!FI015
!EL014
!FI012
.load 9 continue
.continue LOOP006
!ELOP006: ==============================
.continue EL016 ? _(U|xrfcwert  = 0)
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.select lock add 9|id
.continue EL017 ? _((H|ywert     = 0) & (H|yvokawert = 0) & (H|ywertzus1 = 0) & (H|ywertzus2 = 0))
.delete
.continue FI017
!EL017
.formula H|yfcwert = 0
.rewrite
!FI017
.load 9 continue
.continue LOOP007
!ELOP007: ==============================
!EL016
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
!LOOP008: ==============================
.continue ELOP008 ? _(_(F|empty(U|xt001)))
.continue EL018 ? _(_(U|xrfcwert.xt001 = 0))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL019 ? _(G|mehr)
.select lock add 9|id
.continue EL020 ? _(G|mehr)
.assign  H|yprojekt = 7|yprojekt^id
.formula H|yfcwert  = U|xrfcwert.xt001
.rewrite
!EL020
.continue FI019
!EL019
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|yprojekt^id
.assign  H|ypvorgang = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|ydatum    = 'U|xt001'
.formula H|yfcwert   =  U|xrfcwert.xt001
.rewrite
!FI019
!EL018
.formula U|xt001  = F|nextelem(U|xrfcwert, xt001)
.continue LOOP008
!ELOP008: ==============================
.continue EL021 ? _(_(U|xrfcwert  = 0))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=(1)"
.load 9 group "154:1" 'U|xtsel'
.continue EL022 ? _(G|mehr)
.select lock add 9|id
.continue EL023 ? _(G|mehr)
.assign  H|yprojekt = 7|yprojekt^id
.formula H|yfcwert  = U|xrfcwert
.rewrite
!EL023
.continue FI022
!EL022
.make ProjectSuiteValueData GROUP1
.assign  H|yprojekt  = 7|yprojekt^id
.assign  H|ypvorgang = 7|id
.assign  H|ykennzahl = U|xtkennzahl
.formula H|such      = 7|such
.formula H|name      = 7|name
.formula H|yfcwert    = U|xrfcwert
.rewrite
!FI022
!EL021
!EL011
.load 7 continue
.continue LOOP001
!ELOP001: ==============================
.continue
