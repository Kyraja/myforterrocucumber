..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.KENNZAHL.TBEURO
..==
..==  Pfad              : owprjm
..==
..==  Funktion          :
..==
..==
..==  Erstellungsdatum  : 28.09.2011
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
.input PRJM.KONFIG.INI  ? _F|defined(U|xydbgrpvorgang)
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xt001             ? _F|defined(U|xt001)
.type text    xtprojleistkatid  ? _F|defined(U|xtprojleistkatid)
.type real    xristwert         ? _F|defined(U|xristwert)
.type real    xrwert            ? _F|defined(U|xrwert)
.type real    xrpvwert          ? _F|defined(U|xrpvwert)
.type real    xpapreis          ? _F|defined(U|xpapreis)
.type integer xianz             ? _F|defined(U|xianz)
.type GD      xdatum            ? _F|defined(U|xdatum)
.type GD      xdadatum          ? _F|defined(U|xdadatum)
.type GD      xdedatum          ? _F|defined(U|xdedatum)
.type GD      xdkonddat         ? _F|defined(U|xdkonddat)
.type bool    xbberech          ? _F|defined(U|xbberech)
.type TAZ1    xpape             ? _F|defined(U|xpape)
.'F|expr("type P" + U|xydbgrprojekt + " xpprojekt")     ? _F|defined(U|xpprojekt)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpaartikel)
.formula U|xrwert    = 0
.formula U|xristwert = 0
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xt001)))
.formula U|xrwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrwert, xt001)
.continue LOOP001
!ELOP001: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP002
!ELOP002: ==============================
.continue EL001 ? _(F|empty(U|xtpvorgang))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="  + U|xtprojekt       ? _F|empty(U|xtprojekt)
.formula U|xtsel = U|xtsel + ";yistblatt==1"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 7 group 'U|xydbgrpvorgang' 'U|xtsel'
.continue FI001
!EL001
.load 7 group 'U|xydbgrpvorgang' 'U|xtpvorgang'
!FI001
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xdatum = ('G|datum:8')<<6 + "01"
.formula U|xdatum = U|xdatum - 1
.continue EL002 ? _((U|xdadatum < U|xdatum) ; (F|empty(U|xdadatum)))
.formula U|xdatum = U|xdedatum          ? U|xdedatum < U|xdatum & _F|empty(U|xdadatum)
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";yadatum=" + 'U|xdadatum' + "!" + 'U|xdatum' + ";@ablageart=(1)"
.load 8 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL003 ? _(8|ypersperstypk = "EM")
.formula U|xt001  = ('8|yadatum:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.type real xrpvwert.xt001       ? _F|defined(U|xrpvwert.xt001)
.formula U|xristwert      = U|xristwert      + 8|ylmwert
.formula U|xrwert         = U|xrwert         + 8|ylmwert
.formula U|xrwert.xt001   = U|xrwert.xt001   + 8|ylmwert
.formula U|xrpvwert.xt001 = U|xrpvwert.xt001 + 8|ylmwert
!EL003
.load 8 continue
.continue LOOP004
!ELOP004: ==============================
!EL002
.formula U|xdatum = ('G|datum:8')<<6 + "01"
.continue EL004 ? _((U|xdedatum > U|xdatum) ; (F|empty(U|xdedatum)))
.formula U|xdatum = U|xdadatum          ? U|xdadatum > U|xdatum & _F|empty(U|xdadatum)
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ydatum=" + 'U|xdatum' + "!" + 'U|xdedatum' + ";ybsim==0;@ablageart=(1)"
.load 8 group "154:2" 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xpapreis   = 0
.continue EL005 ? _(_(F|empty(7|yvkartikel)))
.assign  U|xpprojekt        = 7|yprojekt^id
.assign  U|xdkonddat        = 7|yadatum
.formula U|xpaartikel       = 7|yvkartikel^id
.formula U|xtprojleistkatid = 7|yprojekt^yprojleistkatid
.input 'U|xtupartpreis'
!EL005
.continue EL006 ? _(U|xpapreis <> 0)
.continue EL007 ? _(_(F|empty(7|ypersonal)))
.continue EL008 ? _(7|ypersonal^yperstypk = "EM")
.formula U|xt001  = ('8|ydatum:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.type real xrpvwert.xt001       ? _F|defined(U|xrpvwert.xt001)
.formula U|xrwert         = U|xrwert         + (8|ywert * U|xpapreis)
.formula U|xrwert.xt001   = U|xrwert.xt001   + (8|ywert * U|xpapreis)
.formula U|xrpvwert.xt001 = U|xrpvwert.xt001 + (8|ywert * U|xpapreis)
!EL008
.continue FI007
!EL007
.continue EL009 ? _((_(F|empty(7|yprojteam))) & (_(F|empty(7|yklassifizierung))))
.formula U|xianz = 0
.load 9 add 7|yprojteam
.load 9 line
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xianz = U|xianz + 1  ?  9|ypersonal^yperstypk = "EM"
.load 9 line
.continue LOOP006
!ELOP006: ==============================
.continue EL010 ? _(U|xianz > 0)
.formula U|xt001  = ('8|ydatum:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.type real xrpvwert.xt001       ? _F|defined(U|xrpvwert.xt001)
.formula U|xrwert         = U|xrwert         + ((8|ywert * U|xpapreis) * U|xianz / 9|tzeilen)
.formula U|xrwert.xt001   = U|xrwert.xt001   + ((8|ywert * U|xpapreis) * U|xianz / 9|tzeilen)
.formula U|xrpvwert.xt001 = U|xrpvwert.xt001 + ((8|ywert * U|xpapreis) * U|xianz / 9|tzeilen)
!EL010
.load 8
.continue FI009
!EL009
.continue EL011 ? _(TRUE)
.formula U|xt001  = ('8|ydatum:8')<<6 + "01"
.type real xrwert.xt001         ? _F|defined(U|xrwert.xt001)
.type real xrpvwert.xt001       ? _F|defined(U|xrpvwert.xt001)
.formula U|xrwert         = U|xrwert         + (8|ywert * U|xpapreis)
.formula U|xrwert.xt001   = U|xrwert.xt001   + (8|ywert * U|xpapreis)
.formula U|xrpvwert.xt001 = U|xrpvwert.xt001 + (8|ywert * U|xpapreis)
!EL011
!FI009
!FI007
!EL006
.load 8 continue
.continue LOOP005
!ELOP005: ==============================
!EL004
.continue EL012 ? _((U|xbberech) & (_(F|empty(U|xtkennzahl))))
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum<>`;@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.formula U|xt001 = 8|ydatum:8
.continue EL013 ? _(_(F|defined(U|xrpvwert.xt001)))
.select lock add 8|id
.delete     ? G|mehr
.continue FI013
!EL013
.continue EL014 ? _(U|xrpvwert.xt001 = 0)
.select lock add 8|id
.delete     ? G|mehr
!EL014
!FI013
.load 8 continue
.continue LOOP007
!ELOP007: ==============================
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP008: ==============================
.continue ELOP008 ? _(_(F|empty(U|xt001)))
.continue EL015 ? _(U|xrpvwert.xt001 <> 0)
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum=" + U|xt001 + ";@ablageart=(1)"
.load 8 group "154:1" 'U|xtsel'
.continue EL016 ? _(G|mehr)
.select lock add 8|id
.continue EL017 ? _(G|mehr)
.assign H|yprojekt  = 7|yprojekt^id
.formula H|ywert = U|xrpvwert.xt001
.rewrite
!EL017
.continue FI016
!EL016
.make ProjectSuiteValueData GROUP1
.assign H|yprojekt  = 7|yprojekt^id
.assign H|ypvorgang = 7|id
.assign H|ykennzahl = U|xtkennzahl
.formula H|such   = 7|such
.formula H|name   = 7|name
.formula H|ydatum = 'U|xt001'
.formula H|ywert  =  U|xrpvwert.xt001
.rewrite
!FI016
!EL015
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP008
!ELOP008: ==============================
.formula U|xtsel = "$,,ypvorgang==" + 7|id + ";ykennzahl==" + U|xtkennzahl + ";ydatum==`;@ablageart=lebendig"
.load 8 group "154:1" 'U|xtsel'
.continue EL018 ? _(G|mehr)
.select lock add 8|id
.continue EL019 ? _(G|mehr)
.assign H|yprojekt  = 7|yprojekt^id
.formula H|ywert = U|xristwert
.rewrite
!EL019
.continue FI018
!EL018
.make ProjectSuiteValueData GROUP1
.assign H|yprojekt  = 7|yprojekt^id
.assign H|ypvorgang = 7|id
.assign H|ykennzahl = U|xtkennzahl
.formula H|such   = 7|such
.formula H|name   = 7|name
.formula H|ydatum = 'U|xt001'
.formula H|ywert  =  U|xristwert
.rewrite
!FI018
!EL012
.formula U|xt001  = ""
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
!LOOP009: ==============================
.continue ELOP009 ? _(_(F|empty(U|xt001)))
.formula U|xrpvwert.xt001 = 0
.formula U|xt001  = F|nextelem(U|xrpvwert, xt001)
.continue LOOP009
!ELOP009: ==============================
.load 7 continue
.continue LOOP003
!ELOP003: ==============================
.continue
