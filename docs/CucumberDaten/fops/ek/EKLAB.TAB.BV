..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.TAB.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Ausgabe/Neue Zeile der Bestellvorschl„ge
.. Functionality  : Output/new row for purchase order suggestions
..*****************************************************************************
..<META M|='ek/EKLAB'>
..<META H|='P4:2'>
..<META 1|='P4:2'>
.set trans -
..
.type ARTR51200 xsumbestvor ? _F|defined(U|xsumbestvor)
.formula U|xsumbestvor = 0.0 ? M|ttyp<>M|ktypvorschlag
.formula U|xsumbestvor = U|xsumbestvor + 1|mge
..
.make screen line +O
.colour -foreground 'T|xabasblack' -background 'M|colposuggestion' 'M|aktzeile'
.formula M|ttyp = M|ktypvorschlag
..
.formula M|tbaktiv = G|false
.formula M|tbv = 1|id
.formula M|tlab = ""
.formula M|tls = ""
.formula M|tprahmen = 1|zrahmen^id
.formula M|tprahmen = H|kopf^id
.formula M|tprahmenpos = H|id
.assign M|basisartikel = 1|artex^basisartikel
.formula M|tartikel = 1|artex^id
.formula M|tartname = 1|artex^sucherw
.formula M|tlief = 1|lief^id
.formula M|tfzahl = H|fzahl
.formula M|tpackanw = H|packanw
.formula M|tmge = 1|mge
.copy M|the = 1|he
.formula M|tpreis = 1|preis
.formula M|tbeterm = 1|sterm
.formula M|tliterm = 1|tterm
.formula M|trterm = 1|rterm
.formula M|tplatz = 1|platz^id
.formula M|tfix = 1|fix
.formula M|tverwendung = 1|verw
.formula M|tedi = ""
.formula M|tedihinweis = ""
.formula M|tediuebdat = ""
.formula M|tstatusz = ""
..
.type P4:2 xconddatitem ? _F|defined(U|xconddatitem)
.type date xconddat ? _F|defined(U|xconddat)
.formula U|xconddatitem = 1|id 
.input "ek/EKLAB.GET.KONDDAT.FO"
.formula M|tkonddat = U|xconddat
.formula M|tzgltstatus = ""
.formula M|tzgltstatus = M|kstatusrot ? _F|empty(H|zgltvon) & U|xconddat<H|zgltvon
.formula M|tzgltstatus = M|kstatusrot ? _F|empty(H|zgltbis) & U|xconddat>H|zgltbis
.formula M|tbgltstatus = F|empty(M|tzgltstatus)
.formula M|tzgltstatus = "" ? ( _F|empty(H|zgltvon) ; _F|empty(H|zgltbis) ) & M|tbgltstatus
.copy M|kzgltstatus = M|kstatusrot ? _M|tbgltstatus 
..
.assign M|tsumbestvor = U|xsumbestvor
.formula M|tmaxrahmenmenge = H|maxabrufmge
.formula M|tabrufbaremenge = H|fzahlabrufoffen
.formula M|tmaxabrufbaremenge = H|fzahlabrufoffen + H|maxabrufmge - H|mge ? H|maxabrufmge <> 0.0
.formula M|tbstatusabrufbaremenge = G|true ? H|fzahlabrufoffen >= U|xsumbestvor ; M|tmaxabrufbaremenge >= U|xsumbestvor ; H|maxabrufmge = 0.0
.formula M|tzstatusabrufbaremenge = M|kstatusgelb ? H|fzahlabrufoffen < U|xsumbestvor & M|tmaxabrufbaremenge >= U|xsumbestvor & H|maxabrufmge <> 0.0
.formula M|tzstatusabrufbaremenge = M|kstatusrot ? _M|tbstatusabrufbaremenge
.copy M|kmaxmengestatus = M|kstatusrot ? _M|tbstatusabrufbaremenge 
..
..  possible actions
.formula M|tbustorno     = ""
.formula M|tbuvorschlag  = "icon:screen_view"
.formula M|tbukonvert    = "icon:screen_copy"
.formula M|tbukeinbedarf = ""
.formula M|tbusenden     = ""
..
.protection tbustorno 'M|aktzeile'
.protection tbukeinbedarf 'M|aktzeile'
.protection tbusenden 'M|aktzeile'
..
..*****************************************************************************
!END
.continue
