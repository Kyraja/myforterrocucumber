..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.TBUSENDEN.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Nachbearbeitung, nach šbertragen eines Lieferabrufs in
..                  die EDI-Datenbank
.. Functionality  : Postprocessing, after transmitting one purchase delivery
..                  forecast schedule into edi db.
...Includes       :
..  include     ek/EKLAB.BSTART.BV
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.continue NOCONF  ?  F|empty(M|kconfigentry)
.continue NOLAB   ?  F|empty(M|tlab)
.continue STORNO  ?  M|tlab^ablagef
.continue FERTIG  ? _F|empty(M|tedi)  &  ( M|tedi^status = 0 ;  M|tedi^status = 2 )
..
.. blanket order is not unique
.continue ERRSTOP ?  M|tbstop
..
.. refresh table content
.input "EKLAB.BSTART.BV"       ?  M|kbzeileakt
..*****************************************************************************
!END
.continue
..
!NOCONF
.error Das Abbildungsmodell fehlt.
.cursor kconfigentry 0
.end 1
..
!ERROR
.error Beim Erstellen der Lieferabrufdatei ist ein Fehler aufgetreten.
.end 1
..
!NOLAB
.error Die Position ist kein Lieferabruf.
.end 1
..
!FERTIG
.error Vorgang ist bereits gesendet worden.
.end 1
..
!STORNO
.error Der Lieferabruf wurde storniert.
.end 1
..
!ERRSTOP
.error Zu Lieferant und Artikel sind mehrere Rahmenauftragsposition vorhanden.
.end 1

