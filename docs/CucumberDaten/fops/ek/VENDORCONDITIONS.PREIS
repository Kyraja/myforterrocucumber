..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VENDORCONDITIONS.PREIS
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..
.. Program flow   :
...Includes       :
.. include is/PREISAUSKUNFT
..*****************************************************************************
.set trans -
.type VP5        xpakl           ? _F|defined(U|xpakl)
.type PS2:1.4.5  xpaartikel      ? _F|defined(U|xpaartikel)
.type A7         xpaev           ? _F|defined(U|xpaev)
.type GD2        xpakonddat      ? _F|defined(U|xpakonddat)
.type ARTR51000  xpamge          ? _F|defined(U|xpamge)
.type ARTR51000  xmge            ? _F|defined(U|xmge)
.type bool       xpaignrahmen    ? _F|defined(U|xpaignrahmen)
.type bool       xneedline       ? _F|defined(U|xneedline)
.type TAZ1       xpale           ? _F|defined(U|xpale)
.type PS94:1     xpainlwaehr     ? _F|defined(U|xpainlwaehr)
.type PS39:2     xlgruppe        ? _F|defined(U|xlgruppe)
..
.assign U|xpakl = M|tlief
.assign U|xpaartikel = M|kart
.formula U|xpaev = "(Purchasing)"
.formula U|xpakonddat = M|konddat
.copy U|xpaignrahmen = G|FALSE
.copy U|xpaignrahmen = G|TRUE ? M|bnorahmen
.formula U|xpamge = M|mge
.formula U|xpamge = M|mgeopt  ? _F|empty(M|tpreisopt) & G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tpreisopt"
.formula U|xpale = M|artle
.formula U|xpainlwaehr = M|waehrung
.copy U|xlgruppe = M|lgruppe
..
.copy U|xneedline = G|TRUE
.input "is/PREISAUSKUNFT"
.copy M|rahmen = G|FALSE
.assign M|herkunft3 = U|xpaherkunft3^id       
.continue NOSTAFFEL                         ?  F|empty(U|xpaherkunft1) & F|empty(U|xpaherkunft2)
.continue RAHMEN                            ?  F|empty(U|xpaherkunft1) & _M|bnorahmen
.assign M|herkunft1 = U|xpaherkunft1^id
.load 1 pricing 'U|xpaherkunft1^id'
.continue NOSTAFFEL                         ? _G|mehr
.continue NOSTAFFEL                         ?  1|tzeilen <= 1
.continue NOSTAFFEL
..
!RAHMEN
.assign M|herkunft2 = U|xpaherkunft2^id
.copy M|rahmen = G|TRUE   
.formula M|tefrist = M|herkunft2^lzeit
.assign M|tlbed = M|herkunft2^kopf^lbed
.assign M|tzbed = M|herkunft2^kopf^zbed
..
!NOSTAFFEL
.formula M|tpreis = U|xpapreis
.formula M|tmproz = U|xpaproz
.formula M|tepe = U|xpape ? _F|empty(M|tpreis)
.formula M|tehe = U|xpahe
.formula M|tpwert = U|xpapwert
.formula M|twaehrung = "" 
.formula M|twaehrung = U|xpaland ? _F|empty(M|tpwert)
.formula M|preisauskunft = M|iconpreisauskunftz
.continue END ? F|empty(M|tzbed)
.load 5 company 'M|tzbed^id'
.continue ERROR1 ? _G|mehr
.formula M|skontobetr = M|tpwert           ? 5|tzeilen = 0
.formula M|effpreis = M|skontobetr / M|mge ? 5|tzeilen = 0
.continue END                              ? 5|tzeilen = 0
.load 5 line 1
.continue ERROR1 ? _G|mehr
.formula M|skonto = 5|skonto
.copy M|skontomoeglz = M|indikatorz ? M|skonto > 0
.formula M|skontobetr = M|tpwert - 5|skonto * M|tpwert / 100
.formula M|effpreis = M|skontobetr / M|mge
.load 5
.continue END
..
!ERROR1
.error Zahlungsbedingung nicht gefunden.
.end 1
..
.. ***************************************************************************
!END
.continue

