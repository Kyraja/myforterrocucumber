..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SALIMA.EV
.. Datum/Date     : 10.01.06
.. Version        : 2006
.. Autor/Author   : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Ablauf         :
..*****************************************************************************
.type bool xbzeile     ? _F|defined(U|xbzeile)
.copy U|xbzeile = G|FALSE
..
.set trans -
..---------------------------- Kopfteil/Header:--------------------------------
.continue TABLEEREN       ? G|evtartengl = "BUTTON_BEFORE"  & G|evtvar = "bstart"
.continue BSTART          ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue DATUM           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "eedatum"
.continue DATUM           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "eadatum"
.continue DATUM           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "medatum"
.continue DATUM           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "madatum"
.continue DATUM           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "liefadatum"
.continue DATUM           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "liefedatum"
.continue MAHNUNG         ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "mahnung"
.continue ERINNERN        ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "erinnern"
.continue ABMAHN          ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "abmahn"
.continue TABLEEREN       ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "ermahnsperr"
.continue AUSWAHL         ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "btterm"
.continue AUSWAHL         ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "bvom"
..-----------------------------------------------------------------------------
.continue TABLEEREN
..
!AUSWAHL
.copy M|bvom = G|FALSE       ?  M|bvom & G|evtvar = "btterm"
.copy M|btterm = G|FALSE     ?  M|btterm & G|evtvar = "bvom"
.copy M|btterm = G|TRUE      ? _M|bvom & _M|btterm
.continue TABLEEREN
..
!ABMAHN
.continue TABLEEREN ? _M|abmahn
.copy M|btterm = G|FALSE
.copy M|bvom = G|TRUE
.copy M|abmahn   = G|TRUE
.copy M|erinnern = G|FALSE
.copy M|mahnung = G|FALSE
.assign P|maskkontextfop = "AUMA"
.protection -reset liefadatum
.protection -reset liefedatum
.protection madatum
.protection medatum
.protection eadatum
.protection eedatum
.protection ermahnsperr
.continue TABLEEREN
..
!ALLESLEER: entspricht Mahnen
.copy M|mahnung = G|TRUE
..
!MAHNUNG
.continue TABLEEREN  ? _M|mahnung
.copy M|mahnung  = G|TRUE
.copy M|abmahn   = G|FALSE
.copy M|erinnern = G|FALSE
.assign P|maskkontextfop = "LIMA"
.formula M|medatum    = "."   ? F|empty(M|medatum)
.formula M|madatum    = "-7"  ? F|empty(M|madatum)
.protection eadatum
.protection eedatum
.protection liefadatum
.protection liefedatum
.protection -reset madatum
.protection -reset medatum
.protection ermahnsperr
.continue BSTART          ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue TABLEEREN
..
!ERINNERN
.continue TABLEEREN  ?  _M|erinnern
.copy M|erinnern = G|TRUE
.copy M|mahnung  = G|FALSE
.copy M|abmahn   = G|FALSE
.assign P|maskkontextfop = "LIER"
.protection madatum
.protection medatum
.protection liefadatum
.protection liefedatum
.formula M|eadatum    = "."   ? F|empty(M|eadatum)
.formula M|eedatum    = "+7"  ? F|empty(M|eedatum)
.protection -reset eadatum
.protection -reset eedatum
.protection -reset ermahnsperr
.continue TABLEEREN
..
!DATUM
.formula M|medatum = "." ? F|empty(M|medatum) & M|mahnung
.formula M|eadatum = "." ? F|empty(M|eadatum) & M|erinnern
.continue FEHLER3 ? 'M|eadatum:8' > 'M|eedatum:8' & _F|empty(M|eedatum)
.continue FEHLER3 ? 'M|madatum:8' > 'M|medatum:8' & _F|empty(M|madatum)
.continue FEHLER3 ? 'M|liefadatum:8' > 'M|liefedatum:8'  & _F|empty(M|liefadatum) & _F|empty(M|liefedatum)
.continue FEHLER1 ? _F|empty(M|madatum) & M|madatum > G|datum & G|evtvar = "madatum"
.continue FEHLER1 ? M|medatum > G|datum & G|evtvar = "medatum"
.continue FEHLER2 ? M|eadatum < G|datum & G|evtvar = "eadatum"
.continue FEHLER2 ?  _F|empty(M|eedatum) & M|eedatum < G|datum & G|evtvar = "eedatum"
.continue TABLEEREN
..
!BSTART
.continue ALLESLEER         ? _M|mahnung  & _M|erinnern & _M|abmahn
.input "is/HOL.LISTE"
.continue END
..
!TABLEEREN
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END
.continue
..
!FEHLER1: Mahnung
.error -message Datum gr”áer Tagesdatum!
.formula M|madatum = "-7" ? G|evtvar = "madatum"
.formula M|medatum = "."  ? G|evtvar = "medatum"
.end 1
..
!FEHLER2: Erinnerung
.error -message Datum kleiner Tagesdatum!
.formula M|eadatum = "."  ? G|evtvar = "eadatum"
.formula M|eedatum = "+7" ? G|evtvar = "eedatum"
.end 1
..
!FEHLER3: Falsche Bereichseingabe
.error -message Falsche Bereichseingabe!
.formula M|eadatum = "."  ? G|evtvar = "eadatum"
.formula M|eedatum = "+7" ? G|evtvar = "eedatum"
.formula M|madatum = "-7" ? G|evtvar = "madatum"
.formula M|medatum = "."  ? G|evtvar = "medatum"
.formula M|liefadatum = "" ? G|evtvar = "liefadatum"
.formula M|liefedatum = "" ? G|evtvar = "liefedatum"
.end 1
