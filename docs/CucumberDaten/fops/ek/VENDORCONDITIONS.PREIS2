..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VENDORCONDITIONS.PREIS2
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..
.. Program flow   :
...Includes       :
.. include is/PREISAUSKUNFT
..*****************************************************************************
.set trans -
.type VP5        xpakl           ? _F|defined(U|xpakl)
.type PS2:1.4.5  xpaartikel      ? _F|defined(U|xpaartikel)
.type A7         xpaev           ? _F|defined(U|xpaev)
.type GD2        xpakonddat      ? _F|defined(U|xpakonddat)
.type ARTR51000  xpamge          ? _F|defined(U|xpamge)
.type bool       xpaignrahmen    ? _F|defined(U|xpaignrahmen)
.type bool       xneedline       ? _F|defined(U|xneedline)
.type TAZ1       xpale           ? _F|defined(U|xpale)
..
.formula U|xpakl = M|tlief^id
.formula U|xpaartikel = M|kart^id
.formula U|xpaev = "(Purchasing)"
.formula U|xpakonddat = M|konddat
.copy U|xpaignrahmen = G|FALSE
.copy U|xpaignrahmen = G|TRUE ? M|bnorahmen
.formula U|xpamge = M|mge
.formula U|xpamge = M|mgeopt  ? _F|empty(M|tpreisopt) & G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tpreisopt"
.formula U|xpale = M|artle
..
.copy U|xneedline = G|TRUE
.input "is/PREISAUSKUNFT"
.copy M|rahmen = G|FALSE
.copy M|rahmen = G|TRUE ?  F|equals(M|typ, "(BlanketOrder)")
..
.. ***************************************************************************
!END
.continue

