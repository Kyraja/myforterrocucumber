..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LIMA.EV
.. Datum/Date     : 10.01.06
.. Version        : 2006
.. Autor/Author   : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
..
.. Ablauf         :
..
..  includes       :
..  include is/HOL.LISTE
..  include ANREDE
..*****************************************************************************
.set trans -
..
.type text xspi       ? _F|defined(U|xspi)
.type text xtalt      ? _F|defined(U|xtalt)
.type text xas        ? _F|defined(U|xas)
.type text xlima      ? _F|defined(U|xlima)
.type text xtsel      ? _F|defined(U|xtsel)
..
..---------------------------- Kopfteil/Header:--------------------------------
.continue START           ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue MAHNUNG         ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "mahnung"
.continue ERINNERN        ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "erinnern"
.continue ABMAHN          ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "abmahn"
.continue LLIEF           ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "lief"
.continue END
..-----------------------------------------------------------------------------
..
!LLIEF
.input "is/TABLEEREN"       
.continue KOPFLEEREN        ?  F|empty(M|lief)
.continue END
..
!START: individuelles Kopf-FOP
.input "is/TABLEEREN"
.continue KOPFLEEREN        ?  F|empty(M|lief)
.input "ek/LIMA.KOPF"
.continue ALLESLEER         ? _M|mahnung  & _M|erinnern & _M|abmahn
.continue MAHNUNG           ?  M|mahnung  & F|empty(M|madatum) & F|empty(M|medatum)
.continue ERINNERN          ?  M|erinnern & F|empty(M|eadatum) & F|empty(M|eedatum)
.continue LIEF
..
!ALLESLEER: entspricht Mahnen
.copy M|mahnung = G|TRUE
.continue MAHNUNG
..
!ABMAHN
.continue END ? _M|abmahn
.copy M|erinnern = G|FALSE
.copy M|mahnung = G|FALSE
.formula M|madatum = ""
.formula M|medatum = ""
.protection madatum
.protection medatum
.formula M|eadatum = ""
.formula M|eedatum = ""
.protection eadatum
.protection eedatum
.protection ermahnsperr
.continue LIEF
..
!MAHNUNG
.continue END ? _M|mahnung
.copy M|erinnern = G|FALSE
.copy M|abmahn   = G|FALSE
.protection -reset madatum
.protection -reset medatum
.formula M|eadatum = ""
.formula M|eedatum = ""
.protection eadatum
.protection eedatum
.protection ermahnsperr
.formula M|medatum = "."   ?   F|empty(M|medatum)
.continue LIEF
..
!ERINNERN
.continue END ? _M|erinnern
.copy M|mahnung = G|FALSE
.copy M|abmahn  = G|FALSE
.protection -reset eadatum
.protection -reset eedatum
.protection -reset ermahnsperr
.formula M|madatum = ""
.formula M|medatum = ""
.protection madatum
.protection medatum
.protection -reset eadatum
.protection -reset eedatum
.protection -reset ermahnsperr
.continue LIEF
..
!LIEF
.continue ERROR1 ? F|empty(M|lief)
.load 1 supplier 'M|lief^id'
.copy M|spr = 1|spr
.copy M|spra = 1|sprai
.copy M|kas = 1|as
.formula M|kontakt = 1|kontakt
.copy M|limahnsperre = 1|limahnsperre
.copy P|sprfoschutz = G|FALSE
.assign P|spra = M|spra
.add M|lief
.add
.continue VA3          ?  F|empty(1|as) ; F|empty(1|kontakt)
.load 2 add 1|as
.input "ANREDE"
.continue VA5
..
!VA3: Anrede kann nicht aufgebaut werden, STD-Anrede
.text U|xas '1|sprai' Sehr geehrte Damen und Herren,
..
!VA5
.formula M|anrede = U|xas
.formula U|xtalt  = ""
.input "is/TABLEEREN"
..
!BSTART
.continue ERROR1                ?  F|empty(M|lief)
.formula M|eadatum = "."       ?  M|erinnern & F|empty(M|eadatum)
.formula U|xtsel  = "$,,typ=(3)"
.formula U|xtsel  = U|xtsel + ";lief=" + M|lief^id
.formula U|xtsel  = U|xtsel + ";@ablageart=(Active)"
.formula M|select = U|xtsel
..
.input "is/HOL.LISTE"
.continue END
..
!KOPFLEEREN
.assign M|spr           = ""
.assign M|spra          = ""
.formula M|kas          = ""
.formula M|kontakt      = ""
.formula M|ans          = ""
.formula M|str          = ""
.formula M|plz          = ""
.formula M|nort         = ""
.formula M|lakenn       = ""
.formula M|staat        = ""
.formula M|region       = ""
.formula M|anrede       = ""
.formula M|text1        = ""
.formula M|text2        = ""
.formula M|text3        = ""
.formula M|ukdnr        = ""
.formula M|limahnsperre = ""
.continue BSTART   ?   G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR1
.error -line 0 -field M|lief -message Bitte Lieferant w„hlen!
.end 1
