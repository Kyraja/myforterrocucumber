..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Allgemeine Events
.. Functionality  : general events
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.type text xtsystem
..
..
..  Event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "klieferant"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kartikel"
.continue RAHKOPF ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "krahmen"  
.continue RAHPOS  ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "krahmenpos"  
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbaktiv"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kblieferant"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbartikel"
.continue ZLIEF   ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbliefzeigen"
.continue ZRAHM   ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbrahmenzeigen"
.continue ZALLES  ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kballeszeigen"
.. ----------- ----- Bool-Umschalter ------ ------------------------------------
.continue BRUECK  ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbcmbeltterm"
.continue BZUSAM  ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbtermzusammen"
.continue BVDA    ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kbkbvdalab"
.continue BLIEF   ?  G|evtartengl = "FIELD_EXIT"      &  G|evtvar = "kblieflab"
.. ----------- ----- Button ------ ---------------------------------------------
.continue EDILOG  ?  G|evtartengl = "BUTTON_AFTER"    &  G|evtvar = "edilog"
.. ----------- ----- Tabellenteil ----------------------------------------------
.continue FORBID  ?  G|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!RAHKOPF
.formula M|klieferant = M|krahmen^lief^id
.continue TABINIT ? M|krahmenpos^kopf = M|krahmen
.. clear non-matching rahmenpos
.formula M|kartikel =""
.formula M|krahmenpos =""
.continue TABINIT
..
!RAHPOS
.formula M|kartikel = M|krahmenpos^artikel^id
.formula M|krahmen = M|krahmenpos^kopf^id
.formula M|klieferant = M|krahmen^lief^id
.continue TABINIT
..
!BVDA
.formula M|kblieflab = _M|kbkbvdalab
.continue END
!BLIEF
.formula M|kbkbvdalab = _M|kblieflab
.continue END
..
!BRUECK
.. .formel M|kbcmbeltterm = true
.continue END
!BZUSAM
.continue END
..
..
!ZLIEF
.formula M|kbrahmenzeigen = G|false
.formula M|kballeszeigen  = _M|kbliefzeigen
.continue TABINIT
!ZRAHM
.formula M|kbliefzeigen   = G|false
.formula M|kballeszeigen  = _M|kbrahmenzeigen
.continue TABINIT
!ZALLES
.formula M|kbrahmenzeigen = G|false
.formula M|kbliefzeigen   = _M|kballeszeigen
.continue TABINIT
..
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
!EDILOG
.editing "java/log/edi/edi.log"
.continue END
..*****************************************************************************
!END
.continue
