..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LIMA.ABASDMS.IDX
.. Autor          : saac
.. Verantwortlich : teamreport
.. Kontrolle      : lei
.. Funktion       : Erzeugt Indexdatei fuer abas-DMS
.. Functionality  : Creates index file for abas-DMS
..*****************************************************************************
.set trans -
..
.type text xt              ? _F|defined(U|xt)
.type P88:11 xdmsbelegart  ? _F|defined(U|xdmsbelegart)
.type VP5  xkuli           ? _F|defined(U|xkuli)
.type VID99 xid            ? _F|defined(U|xid)
..
.file -tempname U|xt
.copy U|xdmsbelegart = P|dokument^belegart ? _F|empty(P|dokument)
..
.output new 'U|xt' -encoding "UTF-8"
.input "DATEI.F"
..
.assign U|xid = M|lief
.input "STD.ABASDMS.IDX"
..
BelDat='G|datum(L="0")'
.. Kunden-/Lieferantendatena
.continue WRITE ? F|empty(M|lief)
.assign U|xkuli = 'M|lief^id'
.input "st/KULI.ABASDMS.IDX"
..
!WRITE
Betreff='M|text3'
Info='M|text1'
..
!POSANF
.select screen line
?Waehrung='M|vorgang^erfwaehr' ? M|aktzeile = 1
.continue ENDE    ? _G|mehr
.continue EPOSAUS ? F|empty(M|artikel)
.continue POSAUS  ? _M|artikel^gruppe = 4
.continue POSAUS  ? M|artikel^gruppe = 4 & F|equals(M|artikel^zptyp, "(EmptyEntry)")
.continue POSAUS  ? M|artikel^gruppe = 4 & F|equals(M|artikel^zptyp, "(SOPOItemPOS)")
.continue POSAUS  ? M|artikel^gruppe = 4 & F|equals(M|artikel^zptyp, "(NeutralItem)")
.continue EPOSAUS
..
!POSAUS
POS-ANF
abasaid='M|artikel^id'
ArtNr='M|artikel^nummer'
ArtSuch='M|artikel^such'
ArtBez='M|artikel^name'
?FArtNr='M|artikel^bstnr'            ? M|artikel^gruppe = 1 
?AbasPRID='M|projekt^id'             ? F|sysinfo(18)^projekt & F|defined(M|projekt)
?ProjNr='M|projekt^nummer'           ? F|sysinfo(18)^projekt & F|defined(M|projekt)
?ProjSuch='M|projekt^such'           ? F|sysinfo(18)^projekt & F|defined(M|projekt)
?ProjBez='M|projekt^name'            ? F|sysinfo(18)^projekt & F|defined(M|projekt)
..
.load 1 group  "4:1"  'M|vorgang^id'
.continue EPOSAUS          ? _G|mehr
!NEXTPOS
.load 1 line
.continue POSANF           ? _G|mehr
.continue NEXTPOS          ? 1|pnum <> M|pos ; M|artikel <> 1|artex
..
?EKAnfNr='M|vorgang^nummer'    ? 1|kotyp = G|anko
?AbasEAID='M|vorgang^id'       ? 1|kotyp = G|anko
?EKRAufNr='M|vorgang^nummer'   ? 1|kotyp = G|rako
?AbasEAID='M|vorgang^id'       ? 1|kotyp = G|rako
?EKBestNr='M|vorgang^nummer'   ? 1|kotyp = G|abko
?AbasEBID='M|vorgang^id'       ? 1|kotyp = G|abko
.continue RAHMEN ? F|empty(1|orig) & _F|empty(1|zrahmen) & 1|kotyp = G|abko
.continue POSEND ? F|empty(1|orig)
..
.. Anfragenummer und Rahmenauftragsnummer
?EKAnfNr='1|okopf^nummer'                 ? 1|okopf^ktyp = G|anko
?AbasEAID='1|okopf^id'                    ? 1|okopf^ktyp = G|anko
?EKRAufNr='1|okopf^nummer'                 ? 1|okopf^ktyp = G|rako
?AbasEOID='1|okopf^id'                    ? 1|okopf^ktyp = G|rako
?EKAnfNr='1|orig^okopf^nummer'            ? 1|okopf^ktyp = G|abko & 1|orig^okopf^ktyp =G|anko
?AbasEAID='1|orig^okopf^id'               ? 1|okopf^ktyp = G|abko & 1|orig^okopf^ktyp = G|anko
?EKRAufNr='1|orig^okopf^nummer'            ? 1|okopf^ktyp = G|abko & 1|orig^okopf^ktyp =G|rako
?AbasEOID='1|orig^okopf^id'               ? 1|okopf^ktyp = G|abko & 1|orig^okopf^ktyp = G|rako
?EKAnfNr='1|orig^orig^okopf^nummer'       ? 1|okopf^ktyp = G|liko & 1|orig^orig^okopf^ktyp = G|anko
?AbasEAID='1|orig^orig^okopf^id'          ? 1|okopf^ktyp = G|liko & 1|orig^orig^okopf^ktyp = G|anko
?EKRAufNr='1|orig^orig^okopf^nummer'       ? 1|okopf^ktyp = G|liko & 1|orig^orig^okopf^ktyp = G|rako
?AbasEOID='1|orig^orig^okopf^id'          ? 1|okopf^ktyp = G|liko & 1|orig^orig^okopf^ktyp = G|rako
?EKAnfNr='1|orig^orig^orig^okopf^nummer'  ? 1|okopf^ktyp = G|reko & 1|orig^orig^orig^okopf^ktyp = G|anko
?AbasEAID='1|orig^orig^orig^okopf^id'     ? 1|okopf^ktyp = G|reko & 1|orig^orig^orig^okopf^ktyp = G|anko
?EKRAufNr='1|orig^orig^orig^okopf^nummer'  ? 1|okopf^ktyp = G|reko & 1|orig^orig^orig^okopf^ktyp = G|rako
?AbasEOID='1|orig^orig^orig^okopf^id'     ? 1|okopf^ktyp = G|reko & 1|orig^orig^orig^okopf^ktyp = G|rako
.. Bestellungsnummer
?EKBestNr='1|okopf^nummer'           ? 1|okopf^ktyp = G|abko
?AbasEBID='1|okopf^id'               ? 1|okopf^ktyp = G|abko
?EKBestNr='1|orig^okopf^nummer'      ? 1|okopf^ktyp = G|liko
?AbasEBID='1|orig^okopf^id'          ? 1|okopf^ktyp = G|liko
?EKBestNr='1|orig^orig^okopf^nummer' ? 1|okopf^ktyp = G|reko
?AbasEBID='1|orig^orig^okopf^id'     ? 1|okopf^ktyp = G|reko
.continue POSEND
..
!RAHMEN: Rahmen Åber zrahmenpos statt Åber orig
?EKRAufNr='1|zrahmenpos^kopf^nummer'
?AbasEOID='1|zrahmenpos^kopf^id'
..
!POSEND
POS-END
..
!EPOSAUS
.continue POSANF
..
!ENDE
.system 'F|expr("crlf+ < " + U|xt + " >" + U|xxmldata)' background
