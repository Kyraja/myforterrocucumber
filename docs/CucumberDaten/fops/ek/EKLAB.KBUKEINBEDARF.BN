..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.KBUKEINBEDARF.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Alle Rahmenpositionen ohne Abruf erhalten eine
..                  Keinbedarfmedlung
.. Functionality  : All blanket order rows without forcast get a no-demand
..                  forecast
...Includes       :
..  include     ek/EKLAB.TBUKEINBEDARF.BN
..  include     ek/EKLAB.BSTART.BV
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.. nothing to do
.continue END     ?  M|ozeilen = 0
..
.type bool xkbzeileaktMERK     ? _F|defined(U|xkbzeileaktMERK)
.type bool xblabvorhanden      ? _F|defined(U|xblabvorhanden)
.type text xtselLAB            ? _F|defined(U|xtselLAB)
.type integer xiaktzeile       ? _F|defined(U|xiaktzeile)
..
.. suppress update for each row
.formula U|xkbzeileaktMERK = M|kbzeileakt
.formula M|kbzeileakt = G|false
..
..
.select screen header
!NEXT
.select screen line
.continue SUCCESS ? _G|mehr
.continue NEXT    ?  M|tbstop
.continue NEXT    ?  M|ttyp <> M|ktyprahmenpos
.continue NEXT    ? _M|tbmark & _M|kbmark
.continue NEXT    ? _M|tbgltstatus     
.continue NEXT    ? _M|tbstatusabrufbaremenge       
.formula U|xblabvorhanden = G|false
..
.. query if any forecast for supplier exists
.formula U|xblabvorhanden = false
.formula U|xtselLAB = "$,,;ktyp=(3);gruppe=1!1;@gruppe=1;ablagef=no;@ablageart=(1)"
.formula U|xtselLAB = U|xtselLAB + ";lief="     + M|tlief^id
.formula U|xtselLAB = U|xtselLAB + ";vorgart=" + M|kvorart^id
.load 6 purchasing 'U|xtselLAB'
.continue ENDLAB  ? _G|mehr
.continue POS
..
!NEXTLAB
.load 6 purchasing
.continue ENDLAB  ? _G|mehr
..
!POS
.. check one forecast for rows with product
.. NOTE: check without zrahmenpos, to avoid sending "no requirement" for blanket 
..       oders with multiple entries for same product - if any of the rows does 
..       have a forecasts
.formula U|xtselLAB = "$,,;kotyp=(3);@gruppe=22;ablagef=no;@ablageart=(1)"
.formula U|xtselLAB = U|xtselLAB + ";id="    + 6|id
.formula U|xtselLAB = U|xtselLAB + ";artex=" + M|tartikel^id
.formula U|xtselLAB = U|xtselLAB + ";lief="  + M|tlief^id
.formula U|xtselLAB = U|xtselLAB + ";@zeilen=ja"
.load 2 purchasing 'U|xtselLAB'
.continue NEXTLAB ? _G|mehr
.continue NEXTLAB ?  2|selzeile = 0
.load 2 line  '2|selzeile'
.continue NEXTLAB ? _G|mehr
.formula U|xblabvorhanden = G|true
..
!ENDLAB
.load 2   ?  F|defined(2|id)
..
.continue NEXT   ?  U|xblabvorhanden
..
!ANLEGEN
.formula U|xiaktzeile = M|aktzeile
.input "EKLAB.TBUKEINBEDARF.BN"
.select screen line 'U|xiaktzeile'
.continue NEXT
..
..
!SUCCESS
.load 6   ?  F|defined(6|id)
..
.input "EKLAB.BSTART.BV"
.formula M|kbzeileakt = U|xkbzeileaktMERK
..*****************************************************************************
!END
.continue
