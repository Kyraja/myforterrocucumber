id;such;name;key;variable;data
..
.continue UPDP4 ? U|xbmehr
..
?~;'U|xtkey';'U|xtname';'U|xtkey';createVdaLab;1  ?  M|kbkbvdalab
?~;'U|xtkey';'U|xtname';'U|xtkey';createVdaLab;0  ? _M|kbkbvdalab
.continue NEXT4
..
!UPDP4
?'id';~;~;~;~;1 ?  M|kbkbvdalab
?'id';~;~;~;~;0 ? _M|kbkbvdalab
.continue NEXT4
..
!NEXT4
.output
..
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR  ? _G|mehr
