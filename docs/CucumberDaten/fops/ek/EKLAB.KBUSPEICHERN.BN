..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.KBUSPEICHERN.BN
.. Autor          : cl
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : entsprechende Parameter aus den Einstellungen werden in die
..                  EDI-Konfiguration-Datenbank gespeichert
.. Functionality  : Stores the parameters into the edi configuration database
...Includes       :
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.type text   xtname   ? _F|defined(U|xtname)
.type text   xtkey    ? _F|defined(U|xtkey)
.type text   xtselect ? _F|defined(U|xtselect)
.type text   xtmpfile ? _F|defined(U|xtmpfile)
.type text   xtout    ? _F|defined(U|xtout)
.type text   xterr    ? _F|defined(U|xterr)
.type bool   xbmehr   ? _F|defined(U|xbmehr)
..
.file -tempname U|xtmpfile
.file -tempname U|xtout
.file -tempname U|xterr
..
.formula U|xtname = "InfosysEklab"
.formula U|xtkey  = "eklab"
..
..  Abbildungsmodell EKLAB
.formula U|xtselect = "$,,key=" + 'U|xtkey' + ";variable=id;name=" + 'U|xtname' + ";@gruppe=9"
.select ediconfiguration 'U|xtselect'
.copy U|xbmehr = G|TRUE  ?  G|mehr
.copy U|xbmehr = G|FALSE ? _G|mehr
..
.output new 'U|xtmpfile'
.input DATEI.F
#!database=92:9
?#!action=modify  ?  U|xbmehr
?#!action=new     ? _U|xbmehr
#!charset=eks
#!dontchange=~
id;such;name;key;variable;data
..
.continue UPDP1 ?  U|xbmehr
..
~;'U|xtkey';'U|xtname';'U|xtkey';id;'M|kconfigentry^id'
.continue NEXT
..
!UPDP1
'H|id';~;~;~;~;'M|kconfigentry^id'
.continue NEXT
..
!NEXT
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR  ? _G|mehr
..
..
..  Artikel fr Kein-Bedarf-Meldungen lesen
