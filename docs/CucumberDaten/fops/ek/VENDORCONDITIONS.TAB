.assign M|tzbed      = H|lief3^zbed
.protection brueck 'M|aktzeile' ? G|avtkommd = G|kaktname12
..
.input "ek/VENDORCONDITIONS.PREIS"
.input "ek/VENDORCONDITIONS.PREISOPT"
..
.formula M|binpreisopt = G|FALSE
.formula M|binpreisopt = G|TRUE ? M|tpreisopt = M|iconoptz
..
!LIEF4: Vendor Number 4
.continue LIEF5 ? F|empty(H|lief4)
.make screen line +O
.assign M|tlief      = H|lief4
.formula M|tgueltbis = H|eglt4
.formula M|tefrist   = H|efrist4
