.. Functionality  :
..
.. Program flow   :
...Includes       :
.. include ek/VENDORCONDITIONS.PREIS
.. include ek/VENDORCONDITIONS.PREISOPT
..*****************************************************************************
.set trans -
.type text xcommand        ? _F|defined(U|xcommand)
.type text xsel            ? _F|defined(U|xsel)
..
.formula M|kpreisoptz = ""
..
.continue LIEF ? M|lgruppe = F|sysinfo(10)^intlgruppe
.. 
!EXTERN
.reserve
.formula U|xsel ="$,,art=" + kart^id + ";lgruppe=" + M|lgruppe^id +  ";@gruppe=3;@ablageart=(Active)"
.select modificationlock nowait warehousedata 'U|xsel'
.continue END ? _G|mehr
..
!LIEF: Vendor Number 1
.continue LIEF2 ? F|empty(H|lief)
.make screen line +O
.assign M|tlief      = H|lief
.formula M|tgueltbis = H|eglt
.formula M|tefrist   = H|efrist
.formula M|tbstnr    = H|bstnr
.formula M|anfrmenge = M|mge
.assign M|tlbed      = H|lief^lbed
.assign M|tzbed      = H|lief^zbed
.protection brueck 'M|aktzeile' ? G|avtkommd = G|kaktname12
.. 
.input "ek/VENDORCONDITIONS.PREIS"
.input "ek/VENDORCONDITIONS.PREISOPT"
..
.formula M|binpreisopt = G|FALSE
.formula M|binpreisopt = G|TRUE ? M|tpreisopt = M|iconoptz
..
!LIEF2: Vendor Number 2
.continue LIEF3 ? F|empty(H|lief2)
.make screen line +O
