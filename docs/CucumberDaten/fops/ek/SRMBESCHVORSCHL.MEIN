..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SRMBESCHVORSCHL.MEIN
.. Autor/Author   : dr
.. Verantwortlich : cl
.. Kontrolle      : fwester
.. Funktion       : I-File zum Setzen individueller Zeitr„ume
..                  Beginnend bei 1 dem aeltesten bis 8 dem juengsten.
..
.. Function       : Customize your periods.
..                  Starting with 1 for the oldest to 8 the youngest.
..*****************************************************************************
.set trans -
..
.formula M|zraum1 = "< 15"
.formula M|bis1 = "-15"
.formula M|von1 = ""
.formula M|zraum2 = "14 - 8"
.formula M|bis2 = "-8"
.formula M|von2 = "-14"
.formula M|zraum3 = "7 - 4"
.formula M|bis3 = "-4"
.formula M|von3 = "-7"
.formula M|zraum4 = "3 - 1"
.formula M|bis4 = "-1"
.formula M|von4 = "-3"
..
.formula M|zraum5 = "0 - 3"
.formula M|bis5 = "+3"
.formula M|von5 = "."
.formula M|zraum6 = "4 - 7"
.formula M|bis6 = "+7"
.formula M|von6 = "+4"
.formula M|zraum7 = "8 - 14"
.formula M|bis7 = "+14"
.formula M|von7 = "+8"
.formula M|zraum8 = "15 - 30"
.formula M|bis8 = "+30"
.formula M|von8 = "+15"
..*****************************************************************************
!END
.continue
