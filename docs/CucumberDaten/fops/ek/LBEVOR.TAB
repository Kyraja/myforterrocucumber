..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LBEVOR.TAB
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem, Liste der Bestellvorschl„ge
.. Ablauf         :Tabellenzeigfop
..*****************************************************************************
.set trans -
.type A79 xbsart   ? _F|defined(U|xbsart)
..
.formula U|xbsart = "(ExternalProcurement)"
.continue START ? H|bsart = U|xbsart & F|empty(H|kopf) & F|empty(H|status) & H|artikel^gruppe <> 1
.continue START ? H|bsart = U|xbsart & F|empty(H|kopf) & F|empty(H|status) & H|einplan
.continue
..
!START
.continue TOL  ? M|tol <> 0
.continue KRIT ? M|krit = G|TRUE
.continue BILD
..
!KRIT: kritisch
.continue BILD ? _F|equals(H|krit, "(Uncritical)")
.continue
..
!TOL: kritisch und Toleranz
.continue BILD ? _F|equals(H|krit, "(Uncritical)") & ((H|fterm - H|tterm) > M|tol)
.continue
..
!BILD
.continue END ? _F|empty(M|kbasisartikel) & 'M|kbasisartikel^id' <> 'H|art^basisartikel^id'
.make screen line +O
.formula M|tid = H|id
.copy M|angefragt  = H|angefragt
.copy M|anfragen   = H|anfragen
.assign M|basisartikel = H|art^basisartikel
.assign M|art      = H|art
.formula M|dispo   = H|dispo
.formula M|dispoa  = H|dispoa
.formula M|bstnr   = H|bstnr
.formula M|verw    = H|verw
.formula M|verwerbtxt = H|verwerbtxt
.assign M|projekt  = H|projekt
.formula M|vorgang = H|id
.assign M|lgruppe  = H|lgruppe
.assign M|lief     = H|lief
.formula M|mge     = H|mge
.copy M|ehe       = H|he
.formula M|preis       = H|preis
.copy M|pland     = H|pland
.copy M|tpe       = H|pe
.formula M|tsterm      = H|tsterm
.formula M|tterm       = H|tterm
.formula M|tfterm      = H|fterm
.formula M|twterm      = H|twterm
.formula M|fix         = H|fix
.assign M|tkrit        = F|value(H|krit, "AS305")
.formula M|fahnez      = G|icokrit   ? F|equals(H|krit, "(ProcessIsCritical)")
.formula M|fahnez      = G|icovkrit  ? F|equals(H|krit, "(PathIsCritical)")
.formula M|fahnez      = G|icoukrit  ? F|equals(H|krit, "(Uncritical)")
.assign M|kstelle   = H|kstelle
.formula M|bshinw      = H|bshinw
.assign M|platz     = H|platz
.copy M|tbetreuer = H|betreuer
.copy M|icoattdispo = H|icoattdispo
..
!END
.continue
