..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.KBUDISPO.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Disposition starten, bzw Dipo-Protokoll zeigen
.. Functionality  : run dispo to get up to date state of purchase order proposals
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.. event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue DISPO   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbudispo"
.continue DISPO   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbuauto"
.continue PROT    ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbudispoprot"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!DISPO
..
.. start dispo using an edp script
.type text   xtsystem            ? _F|defined(U|xtsystem)
.type text   xtdispoedp          ? _F|defined(U|xtdispoedp)
.type text   xtdispoedpout       ? _F|defined(U|xtdispoedpout)
.type text   xtdispoedperr       ? _F|defined(U|xtdispoedperr)
..
.file -tempname U|xtdispoedp
.file -tempname U|xtdispoedpout
.file -tempname U|xtdispoedperr
..
.output new 'U|xtdispoedp'
.input "DATEI.F"
.. --- --- --- --- --- --- --- --- --- --- --- --- --- --- ---

#!action=do
#!typedcmd=8

param
;

.. --- --- --- --- --- --- --- --- --- --- --- --- --- --- ---
.output
..
.formula U|xtsystem = "edpimport.sh -p " + 'G|einmalpw' + " -c EKS -I " + 'U|xtdispoedp' + " >> " + 'U|xtdispoedpout' + " 2>> " + 'U|xtdispoedperr'
.system 'U|xtsystem'  background
.continue ERROR   ? _G|mehr
..
.input "EKLAB.BSTART.BV"
.continue END
..
..*****************************************************************************
..
!PROT
.type ID87:9 xcallparam
.assign U|xcallparam = "52900"
.input "st/CALLPARAM.EXEC"
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR
.error Bei der Disposition ist ein Fehler aufgetreten.
.editing -readonly 'U|xtdispoedperr'
.end 1
