..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.KBUMARK.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Markiert Zeilen
.. Functionality  : mark rows
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.type bool   xbmark
..
.. event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue MARK    ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbumarkall"
.continue MARK    ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbumarknone"
.continue AUTO    ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbuauto"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!MARK
.formula U|xbmark = true     ?  G|evtvar = "kbumarkall"
.formula U|xbmark = true     ?  G|evtvar = "kbuauto"
.formula U|xbmark = false    ?  G|evtvar = "kbumarknone"
..
.select screen header
!NEXT
.select screen line
.continue END     ? _G|mehr
.formula M|tbmark = U|xbmark
.continue NEXT
..*****************************************************************************
!END
.continue
