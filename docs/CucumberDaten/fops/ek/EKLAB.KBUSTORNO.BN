..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.KBUSTORNO.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Stornieren alle alten Lieferabrufe
.. Functionality  : Cancels all old forecasts
...Includes       :
..  include     ek/EKLAB.BSTART.BV
..  include     ek/EKLAB.TBUSTORNO.BN
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.. nothing to do
.continue END     ?  M|ozeilen = 0
..
.type bool   xkbzeileaktMERK     ? _F|defined(U|xkbzeileaktMERK)
.type bool   xbloekeinbedarf     ? _F|defined(U|xbloekeinbedarf)
..
..
.. event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue KEINBED ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbuloekeinbedarf"
.continue STORNO  ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbustorno"
.continue STORNO  ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbuauto"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!KEINBED
.. special button to only delete no-demand forecasts
.formula U|xbloekeinbedarf = true
..
..
!STORNO
..
.. suppress update for each row
.formula U|xkbzeileaktMERK = M|kbzeileakt
.formula M|kbzeileakt = false
..
.. reduce re-reading of table
.type integer    xiaktzeile          ? _F|defined(U|xiaktzeile)
..
..
.. use efop that cancels a single forecast for each row
.. that contains a forecast
..
.select screen header
!NEXT
.select screen line
.continue SUCCESS ? _G|mehr
.continue NEXT    ?  M|tbstop
.continue NEXT    ?  M|ttyp <> M|ktyplieferabruf  &  M|ttyp <> M|ktypkeinbedarf
.continue NEXT    ?  F|empty(M|tlab)
.continue NEXT    ?  M|tlab^ablagef
.continue NEXT    ? _M|tbmark & _M|kbmark
.continue NEXT    ?  U|xbloekeinbedarf  &  M|tmge <> 0.0
.continue NEXT    ? _M|tbgltstatus
.continue NEXT    ? _M|tbstatusabrufbaremenge
.formula U|xiaktzeile = M|aktzeile
.input "EKLAB.TBUSTORNO.BN"
.select screen line 'U|xiaktzeile'
.continue NEXT
..
..
!SUCCESS
.input "EKLAB.BSTART.BV"
.formula M|kbzeileakt = U|xkbzeileaktMERK
..*****************************************************************************
!END
.continue
