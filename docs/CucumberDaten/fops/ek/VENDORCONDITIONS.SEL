.set trans -
..
.input "is/TABLEEREN"
.continue ERROR    ? F|empty(M|kart)
.formula M|mge = 1 ? F|empty(M|mge)
.assign P|maskkontextfop = "notkbsid" ?  F|empty(M|kbsid)
.assign P|maskkontextfop = "kbsid"    ? _F|empty(M|kbsid)
.assign P|maskkontextfop = "notkbsid" ?  F|empty(M|hinweis)
.formula M|select = "$,,id==" + 'M|kart^id'
..
.continue END
..
!ERROR
.error Bitte Artikel eintragen.
.end 1
..
..*****************************************************************************
!END
.continue
