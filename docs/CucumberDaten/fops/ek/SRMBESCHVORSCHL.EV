..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SRMBESCHVORSCHL.EV
.. Autor          : dr
.. Verantwortlich : cl
.. Kontrolle      : tiwe 
.. Funktion       : Behandelt einfache Feldereignisse.
..
.. Functionality  : Handles simple field events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue SUPPLY  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "lief"
.continue CLRHEAD ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kprojekt"
.continue CLRHEAD ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "lgruppe"
.continue PUORDER ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "bevor"
.continue SUBCONT ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "lfvor"
.continue RELOCAT ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "umlvor"
..------------------------------- Table ---------------------------------------
.continue END
..
!PUORDER: Purchase order suggestion
.copy M|lfvor  = G|FALSE
.copy M|umlvor = G|FALSE
.continue DEFAULT
..
!SUBCONT: Subcontracting suggestion
.copy M|bevor  = G|FALSE
.copy M|umlvor = G|FALSE
.continue DEFAULT
..
!RELOCAT: Relocation suggestion
.copy M|bevor = G|FALSE
.copy M|lfvor = G|FALSE
..
!DEFAULT
.continue SUPPLY  ? M|umlvor
.continue CLRHEAD ? M|bevor ; M|lfvor
.copy M|bevor = G|TRUE
.continue CLRHEAD
..
!SUPPLY
.continue CLRHEAD ? F|empty(M|lief)
.continue CLRHEAD ? F|empty(M|lief^konsi) ; _M|umlvor
..
.. Set consignment warehouse group of supplier
.copy M|lgruppe = M|lief^konsi^lgruppe
..
!CLRHEAD: Clear header output items
.input 'M|bkopf' ? _F|empty(M|bkopf)
..*****************************************************************************
!END
.continue
