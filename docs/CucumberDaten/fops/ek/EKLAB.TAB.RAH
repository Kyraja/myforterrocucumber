..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.TAB.RAH
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Ausgabe/Neue Zeile der Rahmenauftragspositionen
.. Functionality  : Output/new row of blanket order rows
..*****************************************************************************
..<META M|='ek/EKLAB'>
..<META H|='P4:2'>
.set trans -
..
.type bool   xblabvorhanden      ? _F|defined(U|xblabvorhanden)
.type text   xtselLAB            ? _F|defined(U|xtselLAB)
..
..
.make screen line +O
.colour -foreground 'T|xabasblack' -background 'M|colboitem' 'M|aktzeile'
.formula M|ttyp = M|ktyprahmenpos
.formula M|tbaktiv = G|true
..
.formula M|tbv = ""
.formula M|tlab = ""
.formula M|tls = ""
.formula M|tprahmen = H|kopf^id
.formula M|tprahmenpos = H|id
.assign M|basisartikel = H|artex^basisartikel
.formula M|tartikel = H|artex^id
.formula M|tartname = H|artex^sucherw
.formula M|tlief = H|kopf^lief^id
.formula M|tfzahl = H|fzahl
.formula M|tpackanw = H|packanw
.formula M|tmge = H|mge
.copy M|the = H|he
.formula M|tpreis = H|preis
.formula M|tbeterm = H|kopf^vom
.formula M|tliterm = H|tterm
.formula M|trterm = H|rterm
.formula M|tplatz = ""
.formula M|tfix = H|fix
.formula M|tverwendung = ""
.formula M|tedi = ""
.formula M|tedihinweis = ""
.formula M|tediuebdat = ""
.formula M|tstatusz = ""
..
.formula M|tzgltvon = H|zgltvon
.formula M|tzgltbis = H|zgltbis
..
.formula M|tzgltstatus = ""
.formula M|tzgltstatus = "icon:stop"  ? _F|empty(H|zgltvon) & G|datum<H|zgltvon
.formula M|tzgltstatus = "icon:stop"  ? _F|empty(H|zgltbis) & G|datum>H|zgltbis
.formula M|tbgltstatus = F|empty(M|tzgltstatus)
.formula M|tzgltstatus = "" ? ( _F|empty(H|zgltvon) ; _F|empty(H|zgltbis) ) & M|tbgltstatus
..
.. .formula M|kmaxmengestatus
.formula M|tmaxrahmenmenge = H|maxabrufmge
.formula M|tabrufbaremenge = H|fzahlabrufoffen
.assign M|tsumbestvor = ""
.formula M|tbstatusabrufbaremenge = G|true ?  H|fzahlabrufoffen>0.0 ; H|maxabrufmge = 0.0
.formula M|tzstatusabrufbaremenge = M|kstatusnoglt ? _M|tbstatusabrufbaremenge
.. 
..  possible actions
.formula M|tbustorno     = ""
.formula M|tbuvorschlag  = "icon:screen_view"
.formula M|tbukonvert    = ""
.formula M|tbukeinbedarf = "icon:screen_new"
.formula M|tbusenden     = ""
..
.protection tbustorno 'M|aktzeile'
.protection tbukonvert 'M|aktzeile'
.protection tbusenden 'M|aktzeile'
..
..*****************************************************************************
!END
.continue
