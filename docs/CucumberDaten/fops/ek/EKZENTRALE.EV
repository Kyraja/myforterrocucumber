..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKZENTRALE.EV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..*****************************************************************************
..
.set trans -
.type integer    xiline      ? _F|defined(U|xiline)
.type integer    xitype      ? _F|defined(U|xitype)
.type text   xtprev      ? _F|defined(U|xtprev)
.type integer    xitmp       ? _F|defined(U|xitmp)
.type text   xtcom       ? _F|defined(U|xtcom)
.type realx  xramount    ? _F|defined(U|xramount)
.type realx  xrkurs      ? _F|defined(U|xrkurs)
.type ID94:1 xiwbu       ? _F|defined(U|xiwbu)
.type ID94:1 xland       ? _F|defined(U|xland)
.type ID94:1 xauswaehr   ? _F|defined(U|xauswaehr)
.type RP7.6  xrate       ? _F|defined(U|xrate)
.type IP1    xrundung    ? _F|defined(U|xrundung)
.type realx  xiwbuamount ? _F|defined(U|xiwbuamount)
.type realx  xiberechnen ? _F|defined(U|xiberechnen)
.type integer    xttranstyp  ? _F|defined(U|xttranstyp)
.type ARTR51000   xliefern    ? _F|defined(U|xliefern)
.type ARTR51000   xberechnen  ? _F|defined(U|xberechnen)
.type id4    xmerk       ? _F|defined(U|xmerk)
.type id4    x2merk      ? _F|defined(U|x2merk)
.type integer    xistufe     ? _F|defined(U|xistufe)
.type text   xselect     ? _F|defined(U|xselect)
..
.continue BESTELL ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bestellvorschl"
.continue SCHED     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "icoattdispo"
.continue START
..
!SCHED
.continue END   ? F|empty(M|icoattdispo)
.command -parallel 'F|formatstr("<(Infosystem)>{1}<(Call)> ? artikel={2}|lgruppe={3}|bstart=", "10430", M|tpart^id, M|lgruppe^id)'
.continue END
..
!BESTELL
.command -parallel "<(Purchasing)><(View)>,(PurchaseOrderSuggestions)"
.continue END
..
!START
.input "DATEI.F"
..
.assign U|xmerk = ""
.assign U|x2merk = ""
..
.formula U|xrundung    = M|auswaehr^nkst
.copy U|xauswaehr = M|auswaehr
..
.continue BSTART    ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.. Plankarte ”ffnen
.continue PLAN    ? G|evtvar = "tplan"
.continue DETAIL  ? G|evtvar = "tdetail"
.continue POST    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tpost"
.continue P2OST   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tpost2"
.. freigeben
.continue T2RELEASE ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "trelease2"
.continue TRRELEASE ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "trelease"
.continue END
..
!BSTART
.input "is/TABLEEREN"
.type ID4  xcheck
.assign U|xcheck = "$,,;@numsuch="  + M|docf + "!" + M|doct + ";@lesen=" + 'G|FALSE'
.continue ERROR02 ? _G|mehr
.continue END
..
!PLAN: Planning Board / Infosystem Plankarte ”ffnen
.continue END ? F|empty(M|tpart)
.continue END ? M|tpart^gruppe <> 1
.command -parallel 'F|formatstr("<(Infosystem)>10044<(Call)>?kart={1}|klgruppe={2}|bstart=1", M|tpart^id, M|lgruppe^id)'
.continue END
..
!DETAIL: Vorgangszeilen / Transaction Detail
.continue END     ? _F|empty(M|tpart)
.continue ODETAIL ? _M|tdo
.continue FDETAIL ?  M|tdo
..
!FDETAIL: Fold Detail
.formula M|tdetail  = M|detail1
.copy M|tdo      = G|FALSE
..
.select screen line
..
!NDETAIL
.continue EVTZEILE ? _G|mehr
.continue EVTZEILE ? M|aktzeile = 0
.continue EVTZEILE ? F|empty(M|tpart)
..
.make screen line -O
.continue NDETAIL
..
!EVTZEILE
.select screen line 'G|evtzeile'   ? G|evtvar = "topen" ; G|evtvar = "trelease" ; G|evtvar = "trelease2"
.continue FOLD                     ? G|evtvar = "topen" ; G|evtvar = "trelease" ; G|evtvar = "trelease2"
.continue END
..
!ODETAIL: Open Detail
.select add M|ttrans
.formula M|tdetail  = M|detail2
.copy M|tdo      = G|TRUE
..
!ARTIKEL: Artikel / Dienstleistungen und ein paar Zusatzpositionen PS2:1.4.5
.select line
.continue E4      ? _G|mehr
.continue ARTIKEL ? _M|mitalternativpos & H|alternativpos
.continue ARTIKEL ? H|art^gruppe = 2 ; H|art^gruppe = 3
.continue ARTIKEL ? H|typ = 16 ; H|typ = 19 ; H|typ = 51 ; H|typ = 8 ; H|typ = 9 ; H|typ = 10
.continue ARTIKEL ? _F|empty(M|kprojekt) & (M|kprojekt^id <> H|projekt^id)
..
.add H|kopf
.formula U|xistufe = M|stufe        ? _F|empty(M|tdetail)
.make screen line +O
.formula M|stufe =  U|xistufe + 1   ? _F|empty(M|tdetail)
..
.assign M|ttrans = D|id
.formula M|ttyp4 = M|storno     ? M|ttrans^typ = 4 & (F|equals(D|lsart, "(PackingSlipReversal)") ; F|equals(D|lsart, "(CancelationReturnPackingSlip)"))
.formula M|ttyp4 = M|storniert  ? M|ttrans^typ = 4 & (F|equals(D|lsart, "(PackingSlipCanceled)") ; F|equals(D|lsart, "(CanceledReturnPackingSlip)"))
.copy M|tlsart   = D|lsart      ? D|typ = 4
.formula M|ttyp5 = M|storno     ? M|ttrans^typ = 5 & (F|equals(D|vorganga, "(CancelationCreditNoteCommercial)") ; F|equals(D|vorganga, "(InvoiceReversal)"))
.formula M|ttyp5 = M|storniert  ? M|ttrans^typ = 5 & (F|equals(D|vorganga, "(CanceledCreditNoteCommercial)") ; F|equals(D|vorganga, "(InvoiceCanceled)"))
.copy M|tvorganga = D|vorganga  ? D|typ = 5
.assign M|stornopartnervorg = D|stornopartnervorg
.assign P|maskkontextfop = ""
.assign P|maskkontextfop = "Lieferschein"  ? D|typ = G|LIKO
.assign P|maskkontextfop = "Ausschreibung" ? D|typ = G|ANKO
.assign M|tausschr  = D|ausschr            ? D|typ = G|ANKO
.assign U|xrkurs    = D|kurs
.copy U|xiwbu       = D|iwbu
.copy U|xland       = D|land
.formula M|tzeich   = D|zeich
.formula U|xrate         = F|fxrate(U|xauswaehr,D|budat,D|iwbu)
.add
.copy M|icoattdispo   = H|icoattdispo 
.copy M|tfold         = G|TRUE
.copy M|alternativpos = H|alternativpos 
.assign M|tpart       = H|art
.assign M|tbasisartikel = H|art^basisartikel
.formula M|tterm      = H|wtterm
.formula M|tplan         = ""
.formula M|tplan         = M|plan       ?  H|art^gruppe = 1
.protection brerelease 'M|aktzeile'        ? _F|empty(M|tpart)
.copy M|lgruppe     = H|lgruppe
.formula M|status        = H|status
.assign M|projekt    = H|projekt
.copy M|platz       = H|platz
.formula M|tqty          = H|mge
.assign M|the         = H|he
.copy M|bruttore    = H|kobrutto
.formula U|xliefern   = (H|limge - H|fzahl - H|lifrg) ?  H|kotyp = G|RAKO
.formula U|xliefern   = (H|limge - H|lifrg)           ?  H|kotyp = G|ABKO
.formula M|tliefern   = U|xliefern
.formula M|fzahlabgerufen = H|fzahlabgerufen 
.assign U|xramount    = H|preis
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = F|round(U|xrate*U|xiwbuamount,U|xrundung) ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
.formula M|tuprice    = U|xramount
.assign U|xramount    = H|npwert
.formula U|xramount   = H|fktaplanpos^anzpwert ? H|kotyp = G|ABKO & F|equals(H|kategorie,"(Downpayment)")
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = F|round(U|xrate*U|xiwbuamount,U|xrundung) ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
.formula M|teprice       = U|xramount
.formula U|xberechnen    = 0
.continue AUSGABE                              ?  H|kotyp <> G|ABKO
.formula U|xberechnen = (H|remge - H|refrg) 
.continue AUSGABE                              ?  F|empty(H|kopf^fktaplan)
.continue AUSGABE                              ? _F|equals(H|kategorie,"(Downpayment)")
.formula U|xberechnen = H|fktaplanpos^anzpwert ?  F|empty(H|fktaplanpos^sumfakturiert) &  F|empty(H|fktaplanpos^sumgebucht)
.formula U|xberechnen = ""                     ?  F|empty(H|fktaplanpos^sumfakturiert) & _F|empty(H|fktaplanpos^sumgebucht)
.formula U|xberechnen = H|remge - H|refrg      ? _F|empty(H|fktaplanpos^sumfakturiert)
.formula U|xberechnen = ""                     ?  H|ablagef
..
.formula U|xiberechnen = U|xberechnen / U|xrkurs
.formula U|xberechnen = U|xiberechnen ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.formula U|xberechnen = U|xberechnen  ? U|xauswaehr = U|xland
.formula U|xberechnen = F|round(U|xrate*U|xiberechnen,U|xrundung) ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
..
!AUSGABE
.formula M|tberechnen = U|xberechnen
.copy M|tauswaehr     = U|xauswaehr
.copy M|tpland        = H|pland
.assign M|tnpwert     = H|npwert
..
.continue ARTIKEL ? H|art^gruppe = 2 ; H|art^gruppe = 3
.continue ARTIKEL ? (H|typ = 16 ; H|typ = 19 ; H|typ = 8 ; H|typ = 9)
.continue ARTIKEL ? H|kotyp <> 4
.continue ARTIKEL ? H|mge >= 0
.continue ARTIKEL ? H|art^gruppe = 4 ; H|art^gruppe = 5
.continue ARTIKEL ? H|ablagef
..
.formula M|select = "$,,"
.formula M|select = M|select + ";artikel=" + H|art^id
.formula M|select = M|select + ";platz="   + H|platz^id
.formula M|select = M|select + ";@ordnung=artikel,platz"
.formula M|select = M|select + ";@ablageart=(Active)"
.load 0 group "40:3"  'M|select'
..
.continue NOSQUANTITY ? _G|mehr
.continue NOSQUANTITY ?  (0|bestand + H|mge) < 0
.continue ARTIKEL
..
!NOSQUANTITY: hole lmenge war nicht erfolgreich!
.formula M|tshort = M|short
.continue ARTIKEL
..
!E4
.formula M|tdetail  = M|detail1            ? G|evtzeile = M|aktzeile
.copy M|tdo      = G|FALSE              ? G|evtzeile = M|aktzeile
.continue END
..
!TRRELEASE: Release transaction
.continue END ? _F|empty(M|tpart)
.continue END ?  M|ttrans^typ = 5
.continue END ?  M|ttrans^typ = 4 & F|empty(M|trelease)
.continue END ?  M|ttrans^ablagef
.continue END ?  M|ttrans^uebertr
..
.formula U|xtcom = "<(Purchasing)>"
.formula U|xtcom = U|xtcom + M|ttrans^id + "<(Release)>"  ? M|ttrans^typ = 1
.formula U|xtcom = U|xtcom + M|ttrans^id + "<(Release)>"  ? M|ttrans^typ = 2
.formula U|xtcom = U|xtcom + M|ttrans^id + "<(Delivery)>" ? M|ttrans^typ = 3 & _M|brerelease
.formula U|xtcom = U|xtcom + M|ttrans^id + "<(Invoice)>"  ? M|ttrans^typ = 3 &  M|brerelease
.formula U|xtcom = U|xtcom + M|ttrans^id + "<(Invoice)>"  ? M|ttrans^typ = 4
.command -wait 'U|xtcom'
..
!T2RELEASE
.formula M|tpost    = ""
.load 4 purchasing 'M|ttrans^id'
.copy M|tpost       = M|show      ? _4|ablagef
.formula M|trelease = ""          ?  4|ablagef
.formula M|trelease = ""          ?  4|typ = 4 & 4|aeob
.formula M|ttyp2    = M|typ2b     ?  4|typ = ANKO & 4|ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4)
.formula M|ttyp2a   = M|typ2b     ?  4|typ = RAKO & 4|ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4)
.formula M|ttyp3    = M|typ2b     ?  4|ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp4)
.formula M|ttyp4    = M|typ2b     ?  4|ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp3)
.load 4
.copy M|brerelease = G|FALSE ?  M|ttyp3 = M|typ2b
.protection brerelease 'M|aktzeile'  ?  M|ttyp3 = M|typ2b
.continue FOLD
..
!POST: Post transaction
.continue END      ? _F|empty(M|tpart)
.continue END      ?  M|tpost = ""
.continue OEFFNEN  ? _M|ttrans^uebertr
.continue WARNUNG
..
!OEFFNEN: Vorgang ”ffnen
.command -wait 'F|formatstr("<(Purchasing)>{1}<(View)>", M|ttrans^id)'
.continue P2OST
..
!WARNUNG
.command -wait 'F|formatstr("<(Purchasing)>{1}<(Edit)>?ueb=yes", M|ttrans^id)'
..
!P2OST
.formula M|tpost    = ""
.copy M|tpost    = M|show    ? _M|ttrans^ablagef
.copy M|tpost    = M|post    ?  M|ttrans^uebertr
.copy M|trelease = M|release ? _M|ttrans^uebertr & M|ttrans^typ = 4
.copy M|ttyp2    = M|typ2b   ?  M|ttrans^typ = ANKO & M|ttrans^ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp5)
.copy M|ttyp2a   = M|typ2b   ?  M|ttrans^typ = RAKO & M|ttrans^ablagef & F|empty(M|ttyp3) & F|empty(M|ttyp4) & F|empty(M|ttyp5)
.copy M|ttyp3    = M|typ2b   ?  M|ttrans^ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp4) & F|empty(M|ttyp5)
.copy M|ttyp4    = M|typ2b   ?  M|ttrans^ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp3) & F|empty(M|ttyp5)
.copy M|ttyp5    = M|typ2b   ?  M|ttrans^ablagef & F|empty(M|ttyp2) & F|empty(M|ttyp2a) & F|empty(M|ttyp3) & F|empty(M|ttyp4)
.continue END
..
!FOLD: Fold the trans
.continue FDETAIL                         ? M|tdo
.. Icon setzen
.formula U|xselect = "$,,;okopf^typa=;@gruppe=2;okopf="+M|ttrans^id+";kopf^typa=;kopf^nummer=;orig<>`;@ordnung=kopf;@ablageart=(Both)"
.load 5 purchasing 'U|xselect'
.formula M|topen  = M|iopen              ? G|mehr & F|empty(M|tpart)
.formula M|topen = ""                    ? _G|mehr
.load 5
.copy M|tfold  = G|TRUE
.formula U|xitype = M|ttrans^typ
..
.select screen line
.continue RELEASE ? _G|mehr
..
!L1
.continue RELEASE                          ? U|xitype >= M|ttrans^typ
..
.make screen line -O
.continue L1
..
!RELEASE
.select screen line 'G|evtzeile'  ? G|evtvar = "trelease" ; G|evtvar = "trelease2"
.continue OPEN                    ? G|evtvar = "trelease" ; G|evtvar = "trelease2"
.continue END
..
!OPEN: Open folder/trans
.input "ek/EKZENTRALE.AUFZU"
.continue END   
..
!WEITER
.load 2 line continue
.continue LINEEND ? _G|mehr
..
!ZEILE
.formula U|xtprev = ""
.formula U|xitmp = M|aktzeile
..
.load 2 line
.continue LINEEND ? _G|mehr
.formula M|grliste = "4:2"
.formula M|select = "$,,orig="+ 2|id
.formula M|select = M|select+";@ablageart=(Both)"
.load 1 group  'M|grliste' 'M|select'
.continue WEITER ? _G|mehr
.continue WEITER ?  F|empty(1|kopf)
.continue WEITER ? U|xmerk = '1|kopf^id' & U|x2merk = '1|okopf^id'
.continue KOPF
..
!LADE
.load 1 continue
.continue END    ? _G|mehr
.continue LADE   ?  F|empty(1|kopf)
..
!KOPF
.copy U|xmerk = 1|kopf
.copy U|x2merk = 1|okopf
.select add 1|kopf
.input 'M|bkopf'
.continue WEITER
..
!LINEEND
.formula M|topen = M|iopen              ? U|xitmp = M|aktzeile & F|empty(M|tpart) & M|ttrans^typ <> 5
.copy M|tfold = G|TRUE               ? U|xitmp = M|aktzeile
.continue LADE
..*****************************************************************************
!END
.continue
..
!ERROR02: Wrong date!
.error Falsches Datum!
.cursor docf 0
.end 1
