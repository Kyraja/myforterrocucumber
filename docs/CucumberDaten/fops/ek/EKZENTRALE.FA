..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKZENTRALE.FA
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..
..*****************************************************************************
..
.set trans -
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kuli"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ektyp"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ablageart"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "reku"
.continue CURRCY    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "auswaehr"
.continue RELO      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "relocation"
.continue SUBCO     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "subcontract"
.continue BELEGVON  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "docf"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "doct"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "doct"
.continue DATUM     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "datef"
.continue DATET     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "datet"
.continue BUCHOFF   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kuebertr"
.continue BUCHNOFF  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "knuebertr"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vorgart"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ivorgart"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kebeleg"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "betreuer"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kzeich"
.continue CRITDOC   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kkritisch"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ktterm"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kprojekt"
.continue LEEREN    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "lsart"
.continue TABLEEREN
..
!CRITDOC: Critical documents clicked
.continue TABLEEREN ? _M|kkritisch
.continue TABLEEREN ? _F|empty(M|ktterm)
.assign M|ktterm = G|datum
.continue TABLEEREN
..
!CURRCY: Set default currency
.input "is/EVT.FIELD.OUTCURR"
.continue TABLEEREN
..
!BELEGVON
.formula M|doct = M|docf     ? _F|empty(M|docf)
.continue TABLEEREN
..
!DATUM
.formula M|datet = M|datef   ? _F|empty(M|datef)
.continue TABLEEREN
..
!DATET: Datum bis
.continue ERROR1              ? 'M|datet:8' < 'M|datef:8' & _F|empty(M|datet)
.continue TABLEEREN
..
!RELO
.copy M|subcontract = G|FALSE ? M|relocation
.continue TABLEEREN
..
!SUBCO
.copy M|relocation = G|FALSE  ? M|subcontract
.continue TABLEEREN
..
!BUCHOFF
.copy M|kuebertr = G|TRUE   ?  M|kuebertr
.copy M|kuebertr = G|FALSE  ? _M|kuebertr
.continue TABLEEREN
..
!BUCHNOFF
.copy M|knuebertr = G|TRUE   ?  M|knuebertr
.copy M|knuebertr = G|FALSE  ? _M|knuebertr
.continue TABLEEREN
..
!TABLEEREN
.assign P|maskkontextfop = ""      
.assign P|maskkontextfop = "Lieferschein"   ? F|equals(M|ektyp, "(PackingSlip)")
.assign P|maskkontextfop = "Ausschreibung"  ? F|equals(M|ektyp, "(Request)")
..
!LEEREN
.formula M|tot = 0
.formula M|tot2 = 0
.formula M|tot3 = 0
.formula M|tot4 = 0
.formula M|tot5 = 0
..
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END
.continue
.. 
!ERROR1
.error Bis-Datum ist kleiner als Von-Datum.
.formula M|datet = ""
.end 1
