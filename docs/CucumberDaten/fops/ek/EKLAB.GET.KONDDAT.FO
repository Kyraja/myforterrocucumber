..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.GET.KONDDAT.FO
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Konditionsdatum zur Position ermitteln
.. Functionality  : 
..*****************************************************************************
.set trans -
..
..
.. parameter field
.type P4:2 xconddatitem ? _F|defined(U|xconddatitem)
..
.. internal fields
.type P4:1 xconddatheader ? _F|defined(U|xconddatheader)
..
.. return field
.type date xconddat ? _F|defined(U|xconddat)
..
.. set default return value
.formula U|xconddat = G|datum
..
..
.. no parameter -> nothing to evaluate
.continue END ? F|empty(U|xconddatitem)
..
.formula U|xconddatheader = U|xconddatitem^kopf^id
..
.. (ev)konddat, (ev)vom, (ev)budat, Tagesdatum
..
.copy U|xconddat = U|xconddatheader^budat ? _F|empty(U|xconddatheader^budat)
.copy U|xconddat = U|xconddatheader^vom ? _F|empty(U|xconddatheader^vom)
.copy U|xconddat = U|xconddatitem^konddat ? _F|empty(U|xconddatitem^konddat)
..
..*****************************************************************************
!END
.continue
