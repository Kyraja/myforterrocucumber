..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EKLAB.KBUKONVERT.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Konvertiert alle Bestellvorschl„ge in Lieferabrufe
.. Functionality  : Converts all purchase order suggestions into forecasts
...Includes       :
..  include     ek/EKLAB.BSTART.BV
..  include     ek/EKLAB.TBUKONVERT.BN
..*****************************************************************************
..<META M|='ek/EKLAB'>
.set trans -
..
.. nothing to do
.continue END     ?  M|ozeilen = 0
..
.type bool   xkbzeileaktMERK     ? _F|defined(U|xkbzeileaktMERK)
.type P4:2   item ? _F|defined(U|item)
..
.. suppress update for each row
.formula U|xkbzeileaktMERK = M|kbzeileakt
.formula M|kbzeileakt = G|false
..
.. reduce re-reading of table
.type integer    xiaktzeile          ? _F|defined(U|xiaktzeile)
..
..
.. use efop that converts a single purchase order suggestion
..
.select screen header
!NEXT
.select screen line
.continue SUCCESS ? _G|mehr
.continue NEXT    ?  M|tbstop
.continue NEXT    ?  M|ttyp <> M|ktypvorschlag
.continue NEXT    ?  F|empty(M|tbv)
.assign U|item = M|tbv
.continue NEXT    ?  F|empty(U|item)
.continue NEXT    ?  M|tbv^ablagef
.continue NEXT    ? _M|tbmark & _M|kbmark
.continue NEXT    ? _M|tbgltstatus      
.continue NEXT    ? _M|tbstatusabrufbaremenge      
.formula U|xiaktzeile = M|aktzeile
.input "EKLAB.TBUKONVERT.BN"
.select screen line 'U|xiaktzeile'
.continue NEXT
..
..
!SUCCESS
.input "EKLAB.BSTART.BV"
.formula M|kbzeileakt = U|xkbzeileaktMERK
..*****************************************************************************
!END
.continue
