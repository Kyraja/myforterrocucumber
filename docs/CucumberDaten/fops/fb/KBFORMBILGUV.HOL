..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KBFORMBILGUV.HOL
..  Datum          : 05.01.2010
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Ersetzt is/HOL.LISTE fuer die Infosysteme
..                   fb/KBFORM, fb/BILANZ, fb/GUV, fb/GUVNACH, fb/BILANZNACH etc.
..  Functionality  : Replaces is/HOL.LISTE for the infosystems
..                   fb/KBFORM, fb/BILANZ, fb/GUV, fb/GUVNACH, fb/BILANZNACH etc.
..*****************************************************************************
..
.type integer  rownumber
.type integer  xrowlevel
.type real xrzanteil
.type real xranteil
.type bool xbclosed
..
..*****************************************************************************
..
.set trans -
..
.continue END ?  G|evtartengl = "NO_EVENT"
.continue END ? _F|defined(M|kbfvon)
.continue END ?  F|empty(M|kbfvon)
..
.formula M|datafile   = M|tmpdir + ".DATA"
.input "DATEI.F"
.output new 'M|datafile'
..
..*****************************************************************************
!RHEADER: Execute report header
..*****************************************************************************
.input 'M|bkopf'  ? _F|empty(M|bkopf)
..
.load 0 add M|kbfvon
.continue LOOPFORM      ?  M|kbfvon^gruppe = 2 ; M|kbfvon^gruppe = 4 ; M|kbfvon^gruppe = 5
.continue ARANGE        ?  M|kbfvon^gruppe = 1 ; M|kbfvon^gruppe = 3 ; M|kbfvon^gruppe = 9
.continue END
..
..*****************************************************************************
!LOOPFORM:
..*****************************************************************************
.continue RFOOTER ? 0|gruppe <> 2 & 0|gruppe <> 4 & 0|gruppe <> 5
.load 0 line
.continue RFOOTER ? _G|mehr
.continue LOOPFORM ? 0|stufe > 1
..
.formula U|xbclosed = G|false
.formula U|xbclosed = G|true  ? 0|closed
..
.continue ARANGE ? _F|empty(0|kbereich)
..
..*****************************************************************************
!ACCOUNT: Account row
..*****************************************************************************
.load 1 add 0|konto
.continue LOOPFORM ? _G|mehr
.continue RTABLE
..
..*****************************************************************************
!ARANGE: Account range row
..*****************************************************************************
.type text xtselect ? _F|defined(U|xtselect)
.formula U|xtselect = "$,@zeilen=ja"
..
.continue RANGE ? 0|gruppe = 1 ; 0|gruppe = 3 ; 0|gruppe = 9
..
..*****************************************************************************
!FORM: Buffer 0 contains an account range form
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";@gruppe=" + F|tostring(F|eval(0|kbereich^gruppe + 16))
.formula U|xtselect = U|xtselect + ";id=" + '0|kbereich^id'
.continue FETCH
..
..*****************************************************************************
!RANGE: Buffer 0 contains an account range
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";@gruppe=" + F|tostring(F|eval(0|gruppe + 16))
.formula U|xtselect = U|xtselect + ";id=" + '0|id'
.continue FETCH
..
..*****************************************************************************
!FETCH: Fetch account range structure
..*****************************************************************************
.load 1 accrange 'U|xtselect'
.. ===========================================================================
.. hier wird ein BUG umschifft! Bei einer leeren Tabelle
.. und Zugriff auf die Huelsengruppe wird der Datensatz nicht
.. geladen. mehr = false.
..
.continue RTABLE ? G|mehr
..
.load 1 add 0|id       ? _G|mehr & (0|gruppe = 1 ; 0|gruppe = 3 ; 0|gruppe = 9)
.load 1 add 0|kbereich ? _G|mehr & (0|gruppe = 2 ; 0|gruppe = 4 ; 0|gruppe = 5)
.. ===========================================================================
.continue LOOPFORM ? _G|mehr
.continue RTABLE
..
..*****************************************************************************
!RTABLE: Call report table FOP
..*****************************************************************************
.input 'M|tab'   ? _F|empty(M|tab)
.continue LOOPFORM
..
..*****************************************************************************
!RFOOTER: Execute report footer
..*****************************************************************************
.input 'M|bfuss' ? _F|empty(M|bfuss)
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.output terminal
.continue
