..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KUMJOURNAL.JKENN
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Ermittlung der Jounralkennzeichen im Infosystem fb/KUMJOURNAL
..  Functionality  : Common event FOP of the Infosystem fb/KUMJOURNAL
..*****************************************************************************
..
.set trans -
..
.type integer xijkn ? _F|defined(U|xijkn)
.type text xtjk ? _F|defined(U|xtjk)
.type text xtjn ? _F|defined(U|xtjn)
..
..*****************************************************************************
..
.continue INIT ? _F|defined(U|xjk0)
.continue END  ? _F|defined(U|xtkenn)
.continue END  ? +'U|xtkenn' = 0
..
.formula U|xijkn = -1
.formula U|xtjk  = ""
.formula U|xtjn  = ""
..
..*****************************************************************************
!GET: Get the journal
..*****************************************************************************
.formula U|xijkn = U|xijkn + 1
.continue END ? _F|defined(U|xjk.U|xijkn)
.formula U|xtjk = U|xjk.U|xijkn ? U|xtkenn = U|xjk.U|xijkn
.formula U|xtjn = U|xjn.U|xijkn ? U|xtkenn = U|xjk.U|xijkn
.continue END          ? U|xtkenn = U|xjk.U|xijkn
.continue GET
..
..*****************************************************************************
!INIT
..*****************************************************************************
.select company "$,@gruppe=7;gruppe=7"
.continue END ? _G|mehr
..
.type text xjk0 xjk1 xjk2 xjk3 xjk4
.type text xjk5 xjk6 xjk7 xjk8 xjk9
.type text xjk10 xjk11 xjk12 xjk13 xjk14
..
.type text xjn0 xjn1 xjn2 xjn3 xjn4
.type text xjn5 xjn6 xjn7 xjn8 xjn9
.type text xjn10 xjn11 xjn12 xjn13 xjn14
..
.formula U|xjk0 = H|jdikenn
.formula U|xjn0 = H|jdiname
..
.formula U|xjk1 = H|jekkenn
.formula U|xjn1 = H|jekname
..
.formula U|xjk2 = H|jvkkenn
.formula U|xjn2 = H|jvkname
..
.formula U|xjk3 = H|jkokenn
.formula U|xjn3 = H|jkoname
..
.formula U|xjk4 = H|jstkenn
.formula U|xjn4 = H|jstname
..
.formula U|xjk5 = H|jilkenn
.formula U|xjn5 = H|jilname
..
.formula U|xjk6 = H|jkzu
.formula U|xjn6 = H|jnzu
..
.formula U|xjk7 = H|jkafa
.formula U|xjn7 = H|jnafa
..
.formula U|xjk8 = H|jkahkab
.formula U|xjn8 = H|jnahkab
..
.formula U|xjk9 = H|jkafaab
.formula U|xjn9 = H|jnafaab
..
.formula U|xjk10 = H|jkahkum
.formula U|xjn10 = H|jnahkum
..
.formula U|xjk11 = H|jkafaum
.formula U|xjn11 = H|jnafaum
..
.formula U|xjk12 = H|jkzusch
.formula U|xjn12 = H|jnzusch
..
.formula U|xjk13 = H|jkteilw
.formula U|xjn13 = H|jnteilw
..
.formula U|xjk14 = H|jcakenn
.formula U|xjn14 = H|jcaname
..
.formula U|xijkn = 14
..
..*****************************************************************************
!ROWLOOP
..*****************************************************************************
.select line
.continue END ? _G|mehr
..
.formula U|xijkn = U|xijkn + 1
..
.type text xjk.xijkn xjn.xijkn
.formula U|xjk.U|xijkn = H|jkenn
.formula U|xjn.U|xijkn = H|jname
..
.continue ROWLOOP
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
