..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.IS.COMMON.INIT0
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Allgemeine Initialisierungen
.. Functionality  : Common initializations
.. include fb/CASHMGMT.CONFIG
..*****************************************************************************
..
.set trans -
..
.input "is/ABASFARBEN.DEF"
.input "fb/CASHMGMT.CONFIG"
..
.type text xt                  ? _F|defined(U|xt)
.type integer  xi              ? _F|defined(U|xi)
.type text xtout               ? _F|defined(U|xtout)
.. Start date
.type GD       xdstartdate     ? _F|defined(U|xdstartdate)
.type AS225    xiperiodtype    ? _F|defined(U|xiperiodtype)
.type P125:3   xpperiodpattern ? _F|defined(U|xpperiodpattern)
.type integer  xitufactor      ? _F|defined(U|xitufactor)
.type VID99    xpdocument      ? _F|defined(U|xpdocument)
.type PS94:1   xpoutcurr       ? _F|defined(U|xpoutcurr)
.type PS94:1   xppostcurr      ? _F|defined(U|xppostcurr)
.type PS81:4   xpsetofbooks    ? _F|defined(U|xpsetofbooks)
.type AS304    xeintercompany  ? _F|defined(U|xeintercompany)
.type integer  ximaxperiod     ? _F|defined(U|ximaxperiod)
.type AZS20300 xttype          ? _F|defined(U|xttype)
.type AS7 xepurchsales         ? _F|defined(U|xepurchsales)
.type AZS20302 xcategory       ? _F|defined(U|xcategory)
.type B1       xbintercompany  ? _F|defined(U|xbintercompany)
.type integer  xiperiod        ? _F|defined(U|xiperiod)
.type RU       xrvalue         ? _F|defined(U|xrvalue)
.type text     xtselect        ? _F|defined(U|xtselect)
.type IP3 xschemapos   ? _F|defined(U|xschemapos)
.type IP2 xitype       ? _F|defined(U|xitype)
.type B1 xbrowsum      ? _F|defined(U|xbrowsum)
.type B1 xbcatpossible ? _F|defined(U|xbcatpossible)
.type B1 xbicpossible  ? _F|defined(U|xbicpossible)
.type text xtcolor     ? _F|defined(U|xtcolor)
.type text xtcondition ? _F|defined(U|xtcondition)
.type text xtdummy     ? _F|defined(U|xtdummy)
.type integer xitreelevel  ? _F|defined(U|xitreelevel)
.type R   xrrowsum     ? _F|defined(U|xrrowsum)
..
.copy U|xpoutcurr  = F|condexpr(F|empty(M|auswaehr), G|inland, M|auswaehr)
.copy U|xppostcurr = F|condexpr(F|empty(M|buwaehr), G|inland, M|buwaehr)
.copy U|xpsetofbooks = F|condexpr(F|empty(M|bukreis), G|bukreis, M|bukreis)
.copy U|xeintercompany = M|intercompany ? F|defined(M|intercompany)
.copy U|xpszenario = M|planszenario
.copy U|xppayconfig = M|zvkonfig
.copy U|xpdocument = M|beleg ? F|defined(M|beleg)
.formula   U|xrplannedobcash = M|planzmab ? F|defined(M|planzmab)
.copy U|xbevalcategories = M|kategorieauswert ? F|defined(M|kategorieauswert)
.copy U|xbshowall  = M|zeigealle
.formula U|xtout = 'M|daten'
..
.copy U|xpperiodpattern = M|kzyklus
.copy U|xitufactor   = M|zefaktor
.copy U|xdstartdate  = M|stichtag ? _F|empty(M|stichtag)
.copy U|xiperiodtype = M|zeiteinheit
.copy U|xpliqkber = U|xppayconfig^lqkbereich
.copy U|xparexcluded = U|xpszenario^verdkbereich
.copy U|xpustvaform = U|xpszenario^ustvaakt
.copy U|xpzahllastpos = U|xpszenario^ustpossteuer
.copy U|xpzahllastposzeile = U|xpszenario^ustpossteuerzn
.copy U|xustvazeitraum = U|xpszenario^ustvazeitraum
.formula   U|ximaxperiod = M|maxper
.formula U|xi = 0
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xi = U|xi + 1
.continue END ? U|xi > M|maxper
.type GD U|xpstart.U|xi ? _F|defined(U|xpstart.U|xi)
.type GD U|xpend.U|xi ? _F|defined(U|xpend.U|xi)
.copy U|xpstart.U|xi = M|perstart.U|xi
.copy U|xpend.U|xi = M|perend.U|xi
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
