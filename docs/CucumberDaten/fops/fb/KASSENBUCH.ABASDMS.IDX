..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KASSENBUCH.ABASDMS.IDX
.. Autor          : kop
.. Verantwortlich : teamreport
.. Kontrolle      : lei
.. Funktion       : Erzeugt Indexdatei fÅr abas-DMS
.. Functionality  : Creates index file for abas-DMS
..*****************************************************************************
.. include KASSENBUCH.ABASDMS.IDX.KOPF
..*****************************************************************************
.set trans -
..
.type text xt                  ? _F|defined(U|xt)
.type VID99 xid                ? _F|defined(U|xid)
.type integer U|xzeilennummer  ? _F|defined(U|xzeilennummer)
.type GD2  xtoday              ? _F|defined(U|xtoday)
..
.input "dms/FIND.CONTEXT"
..
.formula U|xtoday = "."
.file -tempname U|xt
.select screen header
..
.output new 'U|xt' -encoding "UTF-8"
.input "DATEI.F"
..
..common and header variables
.input "STD.ABASDMS.IDX"
..
Waehrung='U|xid^waehr'
.input "KASSENBUCH.ABASDMS.IDX.KOPF"
..line variables
.continue NOLINE ? F|empty(U|xzeilennummer)
.continue FROMDB ? M|id <> xid
.select screen line 'U|xzeilennummer'
.continue FROMDB ? _G|mehr
BelDat='M|beldat(L="0")'
.continue NOTDND       ? _F|defined(M|dndbetreff)
.continue NOTDND       ?  F|empty(M|dndbetreff)
Betreff='M|dndbetreff'
.continue ENDBETREFF
!NOTDND
?Betreff='M|butext'    ? _F|empty(M|butext)
!ENDBETREFF
POS-ANF
?KtoNr='M|gegenkto'                  ? M|gegenkto^dnr = 5
?KtoBez='M|gegenkto^name'            ? M|gegenkto^dnr = 5
KStKTr='M|kstelle'
KSTBez='M|kstelle^name'
?PosBet='M|beinn'                    ?  M|beinn <> 0
?PosBet='M|bausg'                    ?  M|bausg <> 0
POS-END
.continue ENDE
..
!FROMDB
.select cashbook 'U|xid'
.continue ENDE ? _G|mehr
.select line 'U|xzeilennummer'
.continue ENDE ? _G|mehr
..
.continue FROMDB ? _G|mehr
BelDat='H|beldat(L="0")'
.continue NOBETREFF    ? _F|defined(H|betreff)
?Betreff='H|betreff'   ? _F|empty(H|betreff)
!NOBETREFF
?Betreff='H|butext'    ? _F|empty(H|butext)
POS-ANF
?KtoNr='H|gegenkto'                  ? H|gegenkto^dnr = 5
?KtoBez='H|gegenkto^name'            ? H|gegenkto^dnr = 5
KStKTr='H|kstelle'
KSTBez='H|kstelle^name'
?PosBet='H|beinn'                    ?  H|beinn <> 0
?PosBet='H|bausg'                    ?  H|bausg <> 0
POS-END
.continue ENDE
..
!NOLINE
BelDat='U|xtoday(L="0")'
..
!ENDE
..
.system 'F|expr("crlf+ < " + U|xt + " >" + U|xxmldata)' background

