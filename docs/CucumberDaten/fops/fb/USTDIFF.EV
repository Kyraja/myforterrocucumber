..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : USTDIFF.EV
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Allgemeines EFOP des Infosystems fb/USTDIFF
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.continue START  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue PERIOD ? G|evtvar = "von"
.continue PERIOD ? G|evtvar = "bis"
.continue PERIOD ? G|evtvar = "anfm"
.continue PERIOD ? G|evtvar = "endm"
.continue PERIOD ? G|evtvar = "anfj"
.continue PERIOD ? G|evtvar = "endj"
.continue POS    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ustvapos"
.continue END
..
..*****************************************************************************
!POS
..*****************************************************************************
.copy M|posev   = M|ustvapos^ev
.copy M|postyp  = M|ustvapos^postyp
.load 1 'G|hdatname58' 'F|formatstr("$,ktoustpos=={1};@gruppe=15", M|ustvapos)'
.continue POSTRUE ? G|mehr
.formula M|strgl = ""
.formula M|stkonto = ""
.formula M|stsatz = ""
.continue END
..
..*****************************************************************************
!POSTRUE
..*****************************************************************************
..
.formula M|strgl = 1|kopf
.copy M|stkonto = 1|est ? 'M|posev(L="0")' = "(69)"
.copy M|stkonto = 1|vst ? 'M|posev(L="0")' = "(86)"
.copy M|stsatz   = 1|psatz
.continue END
..
..*****************************************************************************
!PERIOD
..*****************************************************************************
.input "fb/IS.SETPERIOD"
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.type text xtvar
.formula U|xtvar = "ustvapos"
.continue ERR02    ? F|empty(M|.U|xtvar)
.formula U|xtvar = "buwaehr"
.continue ERR02    ? F|empty(M|.U|xtvar)
.formula U|xtvar = "bukreis"
.continue ERR02    ? F|empty(M|.U|xtvar)
..
.formula M|datnr  = 6
.formula M|grp    = 1
..
.formula M|select = "$,iwbu=" + M|buwaehr^id
.formula M|select = M|select + ";gjahr=" + 'M|anfj'                      ? M|anfj = M|endj
.formula M|select = M|select + ";monat=" + 'M|anfm' + "!" + 'M|endm'     ? M|anfj = M|endj
.formula M|select = M|select + ";budat=" +  M|von:8 + "!" + M|bis:8
.formula M|select = M|select + ";inbukreis" + 'M|bukreis^bknr' + "=true"
.formula M|select = M|select + ";@gruppe=0;gruppe=0"
..
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!ERR02
..*****************************************************************************
.error Bitte eintragen.
.cursor 'U|xtvar'
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
