..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABSCHL.TAB
.. Autor          : gk
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Tabellenfllfunktion fr Infosystem ABSCHL
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.continue ABSCHLUSS ? H|aktzeile = 0
.continue PROTOKOLL ? H|aktzeile > 0
..*****************************************************************************
.. Ausgabe einer Abschlusszeile
..*****************************************************************************
!ABSCHLUSS
.make screen line +O
.copy M|tbaumstufe  = 1
.assign M|tabschluss = 1|id
.copy M|ttermin = 1|erfass
.copy M|tgjakt = 1|gjakt
.formula M|topfehltxt = 1|ergcodetxt
.formula M|tbearb      = 1|zeich
.formula M|tbaumtext = 'M|tabschluss' + " " +  'M|tbez' ? _F|empty(M|tbez)
.formula M|tbaumtext = 'M|tabschluss' + " " +  'M|tgjakt' ? F|empty(M|tbez)
.continue ENDE
..*****************************************************************************
.. Ausgabe einer Protokollzeile
..*****************************************************************************
!PROTOKOLL
.make screen line +O
.formula   M|tbaumstufe  = 2
.copy M|tabschluss  = H|gjas
.copy M|ttermin     = H|erfass
.copy M|tmodul      = H|opmodul
.formula   M|toptxt      = H|optxt
.copy M|topmodus    = H|opmodus
.copy M|tgjakt      = H|opgj
.formula   M|tgmon       = H|opmon
.copy M|topfehltyp  = H|opfehltyp
.formula   M|tbearb      = H|zeich
.translate -language 'G|bsprache' -number 'H|opfehlnr' -dictionary cc -variable M|topfehltxt ? _F|empty(H|opfehlnr)
.copy M|topfehlpic  = H|opfehlpic
.copy M|tbaumiconz  = M|topfehlpic
.formula M|tbaumtext = 'M|tmodul' + " " + 'M|tgjakt' + " " + 'M|tgmon' + " " +  'M|toptxt'
!ENDE
.continue
