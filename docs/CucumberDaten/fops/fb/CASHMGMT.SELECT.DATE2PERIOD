..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.DATE2PERIOD
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Datum in Periode einordnen
.. Functionality  : Map date to period
..*****************************************************************************
..
.set trans -
..
.type integer xxi       ? _F|defined(U|xxi)
.type integer xiperiod  ? _F|defined(U|xiperiod)
..
.formula U|xxi = 0
.formula U|xiperiod = -1
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END  ? U|xiperiod >= 0
.formula U|xxi = U|xxi + 1
.continue END  ? U|xxi > U|ximaxperiod
.formula U|xiperiod = U|xxi ? U|xddate >= U|xpstart.U|xxi & (U|xddate <= U|xpend.U|xxi ; F|empty(U|xpend.U|xxi))
.continue END  ? U|xiperiod >= 0
.continue LOOP ? U|xxi > 1
.formula U|xiperiod = 0 ? U|xddate < U|xdstartdate
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

