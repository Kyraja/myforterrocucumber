..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : KOSAL.SE
.. Author         : ankn
.. Verantwortlich : cl
.. Functionality  : Screen entry FOP of the Infosystem fb/KOSAL
..*****************************************************************************
..
.set trans -
..
.select year 'G|gjahr'
.select year 'G|gjahr' 'G|amonat' 'G|gmonat'
..
.copy M|anfj    = G|gjahr
.copy M|endj    = G|gjahr
.formula   M|anfmon  = G|amonat
.formula   M|endmon  = G|gmonat
.copy M|anfdat  = G|adatum
.copy M|enddat  = G|edatum
..
.copy M|buwaehr = G|inland
.copy M|bukreis = G|bukreis
..
.formula   M|buart     = "(70)"
.copy M|buartalle = G|TRUE
.protection buart
..
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
