..!interpreter declaration english translate
..*****************************************************************************
..
..  FOP-Name       : LBUUMS.EV
..  Datum          : 19.03.03
..  Version        :
..  Autor          : hc
..  Verantwortlich : cl
..  Kontrolle      : mh
..
..  Funktion       : LBUUMS algemeine Event-FOP
..  Ablauf         :
..
..*****************************************************************************
.set trans -
..
.continue BELEG   ? (G|evtartengl ="BUTTON_AFTER")& (G|evtvar ="bbeleg")
..
.make screen line --
..
.continue DATEI   ? G|evtvar = "vdn" ; G|evtvar = "vgr" ; G|evtvar = "vtab"
.continue BEVON   ? (G|evtartengl ="FIELD_EXIT")   & (G|evtvar ="bevon")
.continue BEBIS   ? (G|evtartengl ="FIELD_EXIT")   & (G|evtvar ="bebis")
.continue DATUM   ? G|evtvar ="von"
.continue DATUM   ? G|evtvar ="bis"
.continue DATUM   ? G|evtvar ="anfm"
.continue DATUM   ? G|evtvar ="endm"
.continue DATUM   ? G|evtvar ="anfj"
.continue DATUM   ? G|evtvar ="endj"
.continue START   ? (G|evtartengl ="BUTTON_BEFORE") & (G|evtvar ="bstart")
.continue SEL     ? (G|evtartengl ="BUTTON_AFTER")& (G|evtvar ="bsel")
.continue
..
..*****************************************************************************
!DATEI: Datei w„hlen
..*****************************************************************************
.input "is/DBCHOOSER"
..
.. set group (2^vgr)
.formula M|grp = 2 ? M|vgr = 1
.formula M|grp = 8 ? M|vgr = 3
..
.make screen line --
.formula M|bevon  =""
.formula M|bebis  =""
.formula M|select ="!"
.formula M|umsatz     = 0.0
.formula M|sollsum    = 0.0
.formula M|habensum   = 0.0
.formula M|bewegsaldo = 0.0
.continue END
..
..*****************************************************************************
!BEVON: Bereich von
..*****************************************************************************
.continue END             ? (M|bevon ="")
.formula M|bese   = G|false
.formula M|bebis  = M|bevon
..
..*****************************************************************************
!BEBIS: Bereich bis
..*****************************************************************************
.continue END             ? (M|bebis ="")
.formula M|bese   = G|false
.formula M|select = M|bevon +"!"+ M|bebis
.make screen line --
.formula M|umsatz     = 0.0
.formula M|sollsum    = 0.0
.formula M|habensum   = 0.0
.formula M|bewegsaldo = 0.0
.continue END
..
..*****************************************************************************
!DATUM
..*****************************************************************************
.make screen line --
.formula M|umsatz     = 0.0
.formula M|sollsum    = 0.0
.formula M|habensum   = 0.0
.formula M|bewegsaldo = 0.0
.input "fb/IS.SETPERIOD"
.continue END
..
..*****************************************************************************
!START: Start-Button
..*****************************************************************************
.continue FEHL0   ?_(M|bis >= M|von)
.formula M|bese   = G|false
.formula M|umsatz = 0.00
.input "is/DBCHOOSER"
.input "is/RANGECHECK"
..
..*****************************************************************************
!HOLEN
..*****************************************************************************
.formula M|select ="!"       ? (M|select ="")
.make screen line --
.formula M|umsatz     = 0.0
.formula M|sollsum    = 0.0
.formula M|habensum   = 0.0
.formula M|bewegsaldo = 0.0
..
.continue ACCRANGE ? M|vdn = 68
..
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!ACCRANGE: Account range
..*****************************************************************************
.type text xxlbuffer
.. load account range into buffer 0
.formula U|xxlbuffer = "0"
.formula M|select  = "$,@gruppe=19;@numsuch=" + 'M|bevon' + "!" + 'M|bebis'
..
.. account ranges
.formula M|grp     = F|power(2, 19)
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!SEL: Selektionsleiste-Button
..*****************************************************************************
.formula M|bevon    =""
.formula M|bebis    =""
.formula G|evtfeldneu ="%"
.input "is/AUSWAHL"
.formula M|bese     =_(M|select ="!")
.make screen line --
.formula M|umsatz     = 0.0
.formula M|sollsum    = 0.0
.formula M|habensum   = 0.0
.formula M|bewegsaldo = 0.0
.continue END

..*****************************************************************************
!BELEG: Beleg zeigen
..*****************************************************************************
.command -parallel 'M|belverw^id' ? _F|empty(M|belverw)
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
..
..*****************************************************************************
!FEHL0: Fehler
..*****************************************************************************
.error Datumsuntergrenze gr”áer als Datumsobergrenze
.cursor von
.end 1
