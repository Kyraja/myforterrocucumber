..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TRANSACTIONFIGURES.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type integer xi          ? _F|defined(U|xi)
.type text    xgrliste.xi ? _F|defined(U|xgrliste.xi)
.type text    xgrliste1   ? _F|defined(U|xgrliste1)
.type text    xgrliste2   ? _F|defined(U|xgrliste2)
.type text    xgrliste3   ? _F|defined(U|xgrliste3)
.type text    xgrliste4   ? _F|defined(U|xgrliste4)
.type text    xgrliste5   ? _F|defined(U|xgrliste5)
.type text    xgrliste6   ? _F|defined(U|xgrliste6)
.type text    xgrliste7   ? _F|defined(U|xgrliste7)
.type text    xgrliste8   ? _F|defined(U|xgrliste8)
.type text    xgrliste9   ? _F|defined(U|xgrliste9)
.type text    xgrliste10  ? _F|defined(U|xgrliste10)
.type text    xgrliste11  ? _F|defined(U|xgrliste11)
.type text    xgrliste12  ? _F|defined(U|xgrliste12)
..
.continue BSTART  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kunde"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "lief"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "ma"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "anlage"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "umsatz"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "koart"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bezug"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bab"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "umlage"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "artikel"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "beh"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "konto"
..
!BUGROUP
.formula M|bugruppe = M|bugruppe + 1 ? 'G|evtfeldneu' = 'G|TRUE'
.formula M|bugruppe = M|bugruppe - 1 ? 'G|evtfeldneu' = 'G|FALSE'
.continue UNDOBUT ? M|bugruppe = 0
.continue CLRTAB
..
!UNDOBUT: Not possible
.assign G|evtfeldneu = 'G|TRUE'
.formula M|bugruppe = 1
.continue END
..
!BSTART
.formula M|select = "$,,id=!"
.formula M|select = M|select + ";gjahr>=" + M|gjahr     ? _F|empty(M|gjahr)
.formula M|select = M|select + ";bukreis=" + M|kbukreis ? _F|empty(M|kbukreis)
.formula M|select = M|select + ";@ablageart=lebendig"
.formula U|xgrliste.xi = ""
.continue KUNDE 
..
!KUNDE: Vater 0:1
.formula U|xi = 1
.formula U|xgrliste.xi = "0:3"
.continue LOOP ? M|kunde
.continue LIEFERANT
..
!LIEFERANT: Vater: 1:1
.formula U|xi = 2
.formula U|xgrliste.xi = "1:3"
.continue LOOP ? M|lief
.continue MITARBEITER
..
!MITARBEITER: Vater 11:1
.formula U|xi = 3
.formula U|xgrliste.xi = "11:3"
.continue LOOP ? M|ma
.continue ANLAG
..
!ANLAG: Vater 27:1,5
.formula U|xi = 4
.formula U|xgrliste.xi = "27:3"
.continue LOOP  ? M|anlage
.continue UMSATZ
..
!UMSATZ: Vater 54:1
.formula U|xi = 5
.formula U|xgrliste.xi = "54:3"
.continue LOOP  ? M|umsatz
.continue KOART
..
!KOART: Vater 60:1,4
.formula U|xi = 6
.formula U|xgrliste.xi = "60:3"
.continue LOOP  ? M|koart
.continue BEZUG
..
!BEZUG: Vater 61:1
.formula U|xi = 7
.formula U|xgrliste.xi = "61:3"
.continue LOOP  ? M|bezug
.continue BAB
..
!BAB: Vater 63:1
.formula U|xi = 8
.formula U|xgrliste.xi = "63:3"
.continue LOOP  ? M|bab
.continue UMLAGE
..
!UMLAGE: Vater 67:1,2,6,7 
.formula U|xi = 9
.formula U|xgrliste.xi = "67:3"
.continue LOOP  ? M|umlage
..
!ARTIKEL: Vater 2:1
.formula U|xi = 10
.formula U|xgrliste.xi = "2:8"
.continue LOOP  ? M|artikel
.continue BEHAELTER
..
!BEHAELTER: Vater 158:1
.formula U|xi = 11
.formula U|xgrliste.xi = "158:3"
.continue LOOP ? M|beh
.continue KONTO 
..
!KONTO: Vater 5:1,2
.formula U|xi = 12
.formula U|xgrliste.xi = "5:3"
.continue LOOP
..
!LOOP
.load 1 group 'U|xgrliste.xi' 'M|select'
.continue END            ? _G|mehr & U|xi = 12
.continue SELECTMORE     ? _G|mehr
.input 'M|tab' ? _F|empty(M|tab)
..
!WEITER
.load 1 continue
.continue END            ? _G|mehr & U|xi = 12
.continue SELECTMORE     ? _G|mehr
.input 'M|tab'           ? _F|empty(M|tab)
.continue WEITER
..
!SELECTMORE
.formula U|xi = U|xi + 1 ? _G|mehr
.formula U|xgrliste.xi = ""
..
.continue LIEFERANT   ? U|xi = 2  &  M|lief
.continue SELECTMORE  ? U|xi = 2  & _M|lief
.continue MITARBEITER ? U|xi = 3  &  M|ma
.continue SELECTMORE  ? U|xi = 3  & _M|ma
.continue ANLAG       ? U|xi = 4  &  M|anlage
.continue SELECTMORE  ? U|xi = 4  & _M|anlage
.continue UMSATZ      ? U|xi = 5  &  M|umsatz
.continue SELECTMORE  ? U|xi = 5  & _M|umsatz
.continue KOART       ? U|xi = 6  &  M|koart
.continue SELECTMORE  ? U|xi = 6  & _M|koart
.continue BEZUG       ? U|xi = 7  &  M|bezug
.continue SELECTMORE  ? U|xi = 7  & _M|bezug
.continue BAB         ? U|xi = 8  &  M|bab
.continue SELECTMORE  ? U|xi = 8  & _M|bab
.continue UMLAGE      ? U|xi = 9  &  M|umlage
.continue SELECTMORE  ? U|xi = 9  & _M|umlage
.continue ARTIKEL     ? U|xi = 10 &  M|artikel
.continue SELECTMORE  ? U|xi = 10 & _M|artikel
.continue BEHAELTER   ? U|xi = 11 &  M|beh
.continue SELECTMORE  ? U|xi = 11 & _M|beh
.continue KONTO       ? U|xi = 12 &  M|konto
.continue END         ? U|xi = 12 & _M|konto
.continue END
..
!CLRTAB
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END
.continue
