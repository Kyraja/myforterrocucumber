.set trans -
..
.make screen line +O
.formula M|tgjahr = 1|gjahr
.formula M|vkz = 1|id
.formula M|tobjdbez = 1|objdbez
.assign M|tdart = 1|dart
.assign M|bukreis = 1|bukreis
.assign M|waehr = 1|waehr    ? F|defined(1|waehr)
.assign M|vkzv = 1|kosn      ? F|defined(1|kosn)
.formula M|kosuch = 1|kosuch  ? F|defined(1|kosuch)
.assign M|vbukreis = M|vkzv^selbukreis  ? _F|empty(M|vkzv)
.assign M|vwaehr = M|vkzv^mwaehr        ? _F|empty(M|vkzv)
.formula M|tvobjgrbez = M|vkzv^objgrbez ? _F|empty(M|vkzv)
..
..*****************************************************************************
!END
.continue
