..!interpreter english translate noabbrev
..*****************************************************************************
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : insert schema row
..*****************************************************************************
..
.set trans -
..
.make screen line +O
.copy M|tschemapos  = U|xschemapos
.copy M|tekvk       = U|xepurchsales
.copy M|tposition   = U|xttype
.copy M|tdatentyp   = U|xitype
.copy M|tsummierbar = U|xbrowsum
.copy M|tdetail = (M|tdatentyp = 1)
.copy M|tkatmoeglich= U|xbcatpossible
.copy M|ticmoeglich = U|xbicpossible
.formula M|tfarbe   = U|xtcolor
.formula M|tbaumstufe = U|xitreelevel
.formula M|tbaumstat  = "(Plus)" ? M|tkatmoeglich & M|kategorieauswert
.copy M|tkategorie = U|xcategory
.formula M|ticenum = F|condexpr(M|icgetrennt, F|condexpr(U|xbintercompany, "(OnlyIntercompanyProcesses)", "(NoIntercompanyProcesses)"), "")
.copy M|tic        = U|xbintercompany
.formula M|tallekategorien = (M|tbaumstufe = 0)
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
