..!interpreter english translate
..**************************************************************
..
..  Verantwortlich : hc
..  Kontrolle      : 
..
..               UNTERPROGRAMM VOM KOPRUEF
.end .  ?  txname / "*KOPRUEF.PR2"
..**************************************************************
..
.output terminal
Bitte warten
...
.output new 'a'

                            GuV-Konten, die in KOTAB als GuV nicht vorhanden:
        ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ      ohne E/V-Eintrag
        ³                   E    mit E Eintrag
        ³                   V    mit V Eintrag
        ³
        ³                   Konten, die in KOTAB als GuV eingetragen:
        ³       ÚÄÄÄÄÄÄÄÄÄÄ      kein GuV-Konto
        ³       ³           E V  Eintrag E/V stimmt nicht mit KOTAB
        ³       ³           V E
        v       v           E    Eintrag E/V fehlt
                            V

.set trans -
.length 1
..
.select company "$,gruppe=7;@gruppe=7"
.formula xko1  =  verb
.formula xko2  =  ford
.formula xsko1 =  sverb
.formula xsko2 =  sford
.select
.output new 'a1'
..
!A
.select account
.continue AE       ? _mehr
.continue A        ? _bu  &  xko1 <> num  &  xko2 <> num  &  xsko1 <> num  &  xsko2 <> num
.formula xn=num
?'    xn' 'ev '  ?  gv
.continue A
..
!AE
.output new 'a2'
..
!B
.select from 'kotab' xkenn # xart # xber # xinf # xrest ^
.continue BE ? _mehr
.continue B ? xkenn<>"gv" ; xber="" ; xart="s" ; _xinf/"(1234)"
.....
!U1
.formula xtber = xber << ","
.continue B    ?  xtber = ""
.formula xber  = xber >> ","
.select account 'xtber'
.continue U1   ? _mehr
.continue GH1  ? _bu  &  xko1 <> num  &  xko2 <> num  &  xsko1 <> num  &  xsko2 <> num
..
!G
.formula xn=num
?'    xn' 'xart '     ? ev=xart;ev=""
?'    xn' 'ev ''xart' ? ev<>xart&ev<>""
?'    xn' 'ev '       ? ev<>xart&ev<>""
?'    xn'             ? ev=""
!GH1
.select account
.continue U1   ? _mehr
.continue GH1  ? _bu  &  xko1 <> num  &  xko2 <> num  &  xsko1 <> num  &  xsko2 <> num
.continue G
..
!BE
.occupy WERF.WEG
.output new WERF.WEG
.set background +
.formula sy="sort  -o "+a1+" "+a1
.system 'sy'
.formula sy="sort  -o "+a2+" "+a2
.system 'sy'
.formula sy="comm -3 "+a1+" "+a2+">>"+a
.system 'sy'
.formula sy="tabsweg "+a
.system 'sy'
.set background -
.occupy
..
.formula sy="rm "+a1+" "+a2
.system 'sy'
..
.continue
