..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KUMJOURNAL.TAB
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Tabellen-Zeig-FOP des Infosystems fb/KUMJOURNAL
..  Functionality  : Table FOP of the Infosystem fb/KUMJOURNAL
..
.. include fb/KUMJOURNAL.JKENN
..*****************************************************************************
..
.set trans -
..
.copy M|tbuwaehr = M|buwaehr
..
.continue CALYEAR ? M|kaljahr
..
.copy M|tadatum  = F|fystartdate(M|tgjahr, M|tgmonat)
.copy M|tedatum  = F|fyenddate(M|tgjahr, M|tgmonat)
.formula   M|tmonat   = F|month(M|tadatum)
.continue COLOR
..
..*****************************************************************************
!CALYEAR
..*****************************************************************************
.formula   M|tmonat   = M|tgmonat
.formula   M|tadatum  = F|expr(F|tostring(M|tjahr) + (("0" + F|tostring(M|tmonat)) >> 2) + "01")
.copy M|tgjahr   = F|getfy(M|tadatum)
.formula   M|tgmonat  = F|getfm(M|tadatum)
.formula   M|tmonat   = F|month(M|tadatum)
.formula   M|tedatum  = F|fyenddate(M|tgjahr, M|tgmonat)
.continue COLOR
..
..*****************************************************************************
!COLOR
..*****************************************************************************
.continue SUM ? M|tmonsum = 1
.colour -background -1 -1 -1 'M|aktzeile'
.continue END
..
..*****************************************************************************
!SUM
..*****************************************************************************
.colour -background 'U|xabassubtotal' 'M|aktzeile'
.formula U|ximod = U|ximod + 1
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
