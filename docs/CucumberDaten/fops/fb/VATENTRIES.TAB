..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VATENTRIES.TAB
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Tabellen-FOP des Infosystems fb/VATENTRIES
.. Functionality  : Table FOP of the Infosystem fb/VATENTRIES
..*****************************************************************************
..
.set trans -
..
.make screen line +O
.assign M|tkonto   = H|konto
.end 1 ? _G|mehr
.formula   M|tsoll    = H|betrag ?  H|soll
.formula   M|thaben   = H|betrag ? _H|soll
.. if not grouping by currency constantly use current currency
.formula   M|tsoll    = F|fxamount(M|auswaehr, M|tsoll , G|datum, H|iwbu) ? M|buwaehrgrp = 0
.formula   M|thaben   = F|fxamount(M|auswaehr, M|thaben, G|datum, H|iwbu) ? M|buwaehrgrp = 0
.formula   M|soll     = M|soll  + F|fxamount(M|auswaehr, M|tsoll , G|datum, H|iwbu)
.formula   M|haben    = M|haben + F|fxamount(M|auswaehr, M|thaben, G|datum, H|iwbu)
.formula   M|tsaldo   = M|tsoll - M|thaben
.copy M|tustart  = H|ustart
.copy M|tsteuer  = H|steuer
.copy M|tstrgl   = H|strgl
.copy M|tustva   = H|ustva
.copy M|tbuwaehr = F|condexpr(M|buwaehrgrp = 0, M|auswaehr, H|iwbu)
.continue SUM ? M|summen
.assign M|tbuzeile = H|id
.copy M|tbudat   = H|budat
.copy M|tbuchung = M|tbuzeile^buchung
.formula   M|tanzahl  = 1
.continue END
..*****************************************************************************
!SUM
..*****************************************************************************
'M|tkonto^nummer'#'M|tsoll'#'M|thaben'#'M|tsaldo'#'M|tustart(L="0")'#'M|tsteuer^id'#'M|tstrgl^id'#'M|tustva^id'#'M|tbuwaehr^id'
.make screen line -O
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
