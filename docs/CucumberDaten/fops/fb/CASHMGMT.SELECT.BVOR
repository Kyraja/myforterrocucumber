..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.BVOR
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Selektion und Ausgabe von Bestellvorschlaegen im Rahmen der Liquiditaetsplanung
.. Functionality  :
.. include fb/CASHMGMT.SELECT.PSUGG.COMMON
.. include fb/CASHMGMT.SELECT.VARS.RESET
..*****************************************************************************
..
.set trans -
..
.input "fb/CASHMGMT.SELECT.VARS.RESET"
..
.continue END ? _F|empty(U|xpdocument) & U|xpdocument^dnr<>4
..
.formula   U|xepurchsales = "(Purchasing)"
..
.formula   U|xtselect = "$,@gruppe=2;gruppe=2;bveinplan=1;bsart=(ExternalProcurement);mge<>0;rerelev=1"
.formula   U|xtselect = U|xtselect + ";id=" + U|xpdocument^id ? _F|empty(U|xpdocument)
..
.load 0 nolock purchasing 'U|xtselect'
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END  ? _G|mehr
.input "fb/CASHMGMT.SELECT.PSUGG.COMMON"
.continue NEXT
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.load 0 continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.load 0
.continue

