..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.AFTER.INSERT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : L”schen von Zeilen mit Nullwerten und Setzen des Flags "tblatt"
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.continue END ? M|tzeilen = 0
..
.type integer xxiendrow
.type integer xxilevel xxilevel2
.type integer xxirow
.type bool xxdelete
..
.formula U|xxirow   = M|tzeilen
.formula U|xxilevel = -1
..
.continue L1 ? G|evtzeile < 1
..
.formula U|xxiendrow = G|evtzeile
.select screen line 'G|evtzeile'
.formula U|xxilevel = M|tbaumstufe
!N1
.select screen line
.continue N2 ? _G|mehr
.continue N2 ?  M|tbaumstufe <= U|xxilevel
.continue N1
..
!N2
.formula U|xxirow   = F|condexpr(M|aktzeile > 1, M|aktzeile - 1, M|tzeilen)
.formula U|xxilevel = -1
.continue L1
..
.. delete a row if it is null and has no children
!L1
.continue END ? U|xxirow < 1 ; U|xxirow < U|xxiendrow
.select screen line 'U|xxirow'
.formula U|xxilevel2 = M|tbaumstufe
.formula M|tblatt = (U|xxilevel2 >= U|xxilevel ; U|xxirow = M|tzeilen)
.continue END ? U|xxirow = U|xxiendrow
.copy U|xxdelete = F|condexpr(M|tnull & M|tblatt, F|condexpr(F|empty(M|kber), M|nonull ; M|knonull, M|nonull ; M|kbnonull), G|FALSE)
.make screen line -O ? U|xxdelete
.formula U|xxilevel = U|xxilevel2 ? _U|xxdelete
.formula U|xxirow = U|xxirow - 1
.continue L1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
