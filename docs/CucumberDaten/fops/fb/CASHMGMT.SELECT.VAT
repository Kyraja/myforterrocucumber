..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.VAT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Selektion und Ausgabe der Zahllast mittels UStVa-Formular
.. Functionality  :
.. include fb/CASHMGMT.SELECT.DATE2PERIOD
.. include fb/CASHMGMT.SELECT.VARS.RESET
..*****************************************************************************
..
.set trans -
..
.input "fb/CASHMGMT.SELECT.VARS.RESET"
..
.continue END ? _F|empty(U|xpdocument)
..
.continue END ? F|empty(U|xpustvaform) ; F|empty(U|xpzahllastpos)
.load 7 add U|xpustvaform
.continue END ? _G|mehr
..
.type integer xi ? _F|defined(U|xi)
..
.formula U|xi = 0
..*****************************************************************************
!LGV
..*****************************************************************************
.formula U|xi = U|xi + 1
.continue EGV ? U|xi > U|ximaxtaxperiod
.copy U|xddate = U|xdvatterm.U|xi
.input "fb/CASHMGMT.SELECT.DATE2PERIOD"
.. xiperiod != -1 if the due date is between start and end date of the period xi
.. xiperiod == 0 means overdue -> these are not relevant here because we suppose taxes are being paid when due
.continue LGV ? U|xiperiod < 1
.formula U|xrvalue = F|taxamount(M|planszenario, U|xdvatstart.U|xi, U|xdvatend.U|xi)
..
.continue LGV ? U|xrvalue = 0
.. Typ # EK/VK # Periode # Betrag # Beleg-ID # Beleg-DNR # Beleg-Gruppe # Konto-ID # Konto-DNR # Konto-Gruppe # Termin # Belegdatum # ZBedingung # Skontosatz # Skonto #
(PostedAmountOfVATPayable) # 0 #  #  # 'U|xiperiod' # 'U|xrvalue' # '7|id' # '7|dnr' # '7|gruppe' #  #  #  # 'U|xddate:8' # 'U|xddate:8' # # # #
.continue LGV
..*****************************************************************************
!EGV
..*****************************************************************************
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.load 7
.continue

