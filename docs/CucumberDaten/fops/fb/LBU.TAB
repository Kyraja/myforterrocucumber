..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : LBU.TAB
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..*****************************************************************************
.set trans -
.make screen line +O
.copy M|bunum   = 1|buchung
.copy M|bereich = 1|konto
.copy M|kstelle = 1|kstelle
.copy M|tursache = 1|ursache
.copy M|tprojekt = 1|projekt
.copy M|kstelle = 1|kvert   ? F|empty(M|kstelle)
.copy M|tkoart  = 1|koart
.copy M|anlage  = 1|anlage
.copy M|budat   = 1|budat
.copy M|beldat  = 1|beldat
.copy M|steuer  = 1|steuer ?  1|gruppe = 0
.copy M|tstrgl  = 1|strgl  ?  1|gruppe = 0
.copy M|ewbu    = 1|ewbu ?  1|gruppe = 0
.copy M|ewbu    = 1|iwbu ?  1|gruppe = 1
.formula   M|tbeleg  = 1|beleg
.formula   M|ewbetr  = 1|ewbetr ? 1|gruppe = 0
.formula   M|ewbetr  = 1|betrag ? 1|gruppe = 1
.formula   M|soll    = 1|sbetr
.formula   M|haben   = 1|hbetr
.formula   M|text    = F|condexpr(F|empty(1|ptext), 1|text, 1|ptext)
..
.formula   U|xtgegen   = 1|gegen
.formula   U|xtgegla   = 1|gegen
.formula   U|xtgegla = U|xtgegen
.set trans +
.formula   U|xtgegen =(U|xtgegen<<",")+"+div." ? +U|xtgegen > 13
.set trans -
.formula   M|gegen   = U|xtgegen
.formula   M|gegla   = U|xtgegla
..
.formula   M|sollsum  = M|sollsum  + M|soll
.formula   M|habensum = M|habensum + M|haben
.formula   M|bewegsaldo = M|sollsum - M|habensum
..
.colour -background 'F|condexpr(F|expr(U|ximodulo // 2) = 1, U|xabasgrouplight, U|xabasgroupdark)' 'M|aktzeile'
..
.continue END ? 1|gruppe = 1
.copy M|tustva  = 1|ustva
.copy M|tvkekre = 1|ursacheref
.formula   M|tebeleg = 1|ebeleg
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

