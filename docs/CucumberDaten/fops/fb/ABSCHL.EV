..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABSCHL.EV
.. Autor          : gk
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Eventfunktionen zum Infosystem ABSCHL
.. Functionality  :
..*****************************************************************************
..
..*****************************************************************************
..
..*****************************************************************************
..
.set trans -
..
.continue SHOWROW ? G|evtartengl = "ROW_CHANGED"
.continue START   ? G|evtvar = "bstart" & G|evtartengl = "BUTTON_AFTER"
.continue FAVONNUM   ? G|evtvar = "vonnum"  & G|evtartengl = "FIELD_EXIT"
.continue FAVONDAT   ? G|evtvar = "vondat"  & G|evtartengl = "FIELD_EXIT"
.continue SELGEAENDERT   ? G|evtvar = "bisnum"  & G|evtartengl = "FIELD_EXIT"
.continue SELGEAENDERT   ? G|evtvar = "bisdat"  & G|evtartengl = "FIELD_EXIT"
.continue SELGEAENDERT   ? G|evtvar = "bearbsel"  & G|evtartengl = "FIELD_EXIT"
.continue INITMASK ? G|evtartengl = "SCREEN_ENTER"
.continue ENDE
..
..*****************************************************************************
!INITMASK: Vorbelegung der Selektions-Maske: Jahresanfangsdatum und Tagesdatum
..*****************************************************************************
.select year 'G|gjahr'
.formula M|vondat = G|adatum
.formula M|bisdat = G|datum
.continue ENDE
..
..*****************************************************************************
!FAVONNUM: Num: Bis-Feld-Setzen
..*****************************************************************************
.formula M|bisnum = M|vonnum ? F|empty(M|bisnum)
.continue SELGEAENDERT
..*****************************************************************************
!FAVONDAT: Datum: Bis-Feld-Setzen
..*****************************************************************************
.formula M|bisdat = M|vondat ? F|empty(M|bisdat)
.continue SELGEAENDERT
..*****************************************************************************
!SELGEAENDERT - Tabelle und Detailfelder leeren
..*****************************************************************************
.make screen line --
.continue CLEARDETAIL
..
..*****************************************************************************
.. Laden der Berichtsdaten
..*****************************************************************************
!START
..*****************************************************************************
.formula M|select = "$,@gruppe=2"
.formula M|select = M|select + ";gjas^nummer=" + 'M|vonnum'   + "!" + 'M|bisnum'   ? _F|empty(M|vonnum) ; _F|empty(M|bisnum)
.formula M|select = M|select + ";erfass="      + 'M|vondat:8' + "!" + 'M|bisdat:8' ? _F|empty(M|vondat) ; _F|empty(M|bisdat)
.formula M|select = M|select + ";zeich="       + 'M|bearbsel'                      ? _F|empty(M|bearbsel)
.formula M|select = M|select + ";@ablageart=(3)"
..
.. Protokollsatz laden
..
.select fiscalyearmanagement 'M|select'
!HASNEXT
.continue ENDE ? _G|mehr
..
.. Abschlussatz dazu laden
..
.load 1 add H|gjas
.continue NEXT ? _T|mehr
..
.. Abschlussatz ausgaben
..
.input 'M|tab' ? _F|empty(M|tab)
..
.. Zeilen lesen
..
.select line
!HOLEROW
.continue NEXT ? _G|mehr
..
.. Zeile bearbeiten
..
.input 'M|tab' ? _F|empty(M|tab)
.select line
.continue HOLEROW
..
.. N„chsten Satz lesen
..
!NEXT: Get next record
.select continue
.continue HASNEXT
..
..*****************************************************************************
.. Ausgeben einer Tabellenzeile in die Detailansicht
..*****************************************************************************
..*****************************************************************************
!SHOWROW:
..*****************************************************************************
.continue ENDE ? M|aktzeile < 1
.copy M|baumstufe = M|tbaumstufe
.copy M|abschluss = M|tabschluss
.copy M|termin = M|ttermin
.copy M|gjakt = M|tgjakt
.copy M|modul = M|tmodul
.copy M|gmon = M|tgmon
.copy M|optxt = M|toptxt
.copy M|opmodus = M|topmodus
.copy M|opfehltyp = M|topfehltyp
.copy M|bearb = M|tbearb
.copy M|opfehltxt = M|topfehltxt
.copy M|opfehlpic = M|topfehlpic
.continue ENDE
..*****************************************************************************
.. Leeren Detailansicht
..*****************************************************************************
..*****************************************************************************
!CLEARDETAIL:
..*****************************************************************************
.assign M|baumstufe = ""
.assign M|abschluss = ""
.assign M|termin = ""
.assign M|gjakt = ""
.assign M|modul = ""
.assign M|gmon = ""
.assign M|optxt = ""
.assign M|opmodus = ""
.assign M|opfehltyp = ""
.assign M|bearb = ""
.assign M|opfehltxt = ""
.assign M|opfehlpic = ""
.continue ENDE
..
..
!ENDE
.end
.continue
