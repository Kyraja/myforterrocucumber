..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LIQPLANDETAILS.DATE2PERIOD
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Datum in Periode einordnen
.. Functionality  : Map date to period
..*****************************************************************************
..
.set trans -
..
.type integer  xxi     ? _F|defined(U|xxi)
.type bool xbfound ? _F|defined(U|xbfound)
..
.copy U|xbfound = G|FALSE
.formula   U|xxi = 0
..*****************************************************************************
!LOOP
..*****************************************************************************
.copy U|xbfound  = G|TRUE ? (M|tterm >= M|perstart.U|xxi ; F|empty(M|perstart.U|xxi)) & (M|tterm <= M|perend.U|xxi ; F|empty(M|perend.U|xxi))
.formula   M|tperiode = U|xxi  ? U|xbfound
.continue END ? U|xbfound
.formula U|xxi = U|xxi + 1
.continue END ? U|xxi > M|maxper
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

