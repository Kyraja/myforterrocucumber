..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : KASBEL.EV
..  Datum          : 11.04.2006
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Allgemeines EFOP des Infosystems fb/KASBEL
..
..  Program flow  :
... Includes      :
..*****************************************************************************
.set trans -
.type DVM2 xtmpfile  ? _F|defined(U|xtmpfile)
..
.file -tempname U|xtmpfile
..
.output new 'U|xtmpfile'
.input "DATEI.F"
.output
..
.continue START  ? G|evtvar = "bstart" & G|evtartengl = "BUTTON_BEFORE"
.continue KBUCH  ? G|evtvar = "tkbuch" & G|evtartengl = "FIELD_EXIT"
.continue LEEREN ? G|evtvar = "beleg"  & G|evtartengl = "FIELD_EXIT"
.continue END
..
!KBUCH: Kassenbuch
.continue END ? +M|tkbuch = 0
.copy M|waehr   = M|tkbuch^waehr
.copy M|kasskto = M|tkbuch^kasskto
..
!LEEREN: Kopffelder und Tabelle leeren
.formula M|texta = ""
.formula M|textb = ""
.formula M|textc = ""
.formula M|textd = ""
.formula M|texte = ""
.input "is/TABLEEREN"
.continue END
..
!START
.continue ERR01 ? +M|beleg  = 0
.continue ERR02 ? +M|tkbuch = 0
.make screen line --
.type text xtsignat
.set trans +
.text   U|xtsignat 'P|spr' Firmenstempel/Unterschrift
.set trans -
.formula M|signat = U|xtsignat
.formula M|sum    = 0
.formula M|sumaus = 0
.formula M|sumein = 0
.formula M|sumst  = 0
.formula M|select = "$,id=" + 'M|tkbuch^id'
.formula M|select = M|select + ";@zeilen=ja"
.formula M|select = M|select + ";beleg==" + 'M|beleg'
.formula M|select = M|select + ";@ordnung=zn"
.input "is/HOL.LISTE"
.continue END
..
!ERR01
.error Kein Beleg angegeben.
.end 1
..
!ERR02
.error Kein Kassenbuch angegeben.
.end 1
..
..*****************************************************************************
!END
.continue
