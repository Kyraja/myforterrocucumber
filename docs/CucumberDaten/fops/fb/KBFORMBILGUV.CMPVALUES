..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.CMPVALUES
.. Datum          : 20.03.2007
.. Version        : 1
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       :
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..   Argument     meaning
..   ---------------------------------------------------------
..   xp...        ...
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..
..*****************************************************************************
..
.set trans -
..
.. index of account range
.type integer xicmpkb   ? _F|defined(U|xicmpkb)
.. name of the variable with the value
.type text xtcmpvar ? _F|defined(U|xtcmpvar)
..
.formula U|xicmpkb = 0
..*****************************************************************************
!CMPKB: Loop over account ranges for comparison
..*****************************************************************************
.formula U|xicmpkb = U|xicmpkb + 1
.continue END   ? U|xicmpkb > M|maxcmpkb
.continue CMPKB ? F|empty(M|cmpkb.U|xicmpkb)
..
.select add M|cmpkb.U|xicmpkb
..
.formula U|xizraum = 0
..*****************************************************************************
!CMPLOOP: Loop over periods to get values for account ranges
..*****************************************************************************
.formula U|xizraum = U|xizraum + 1
.continue CMPKB   ? U|xizraum > M|maxperiod
.continue CMPNEXT ? F|empty(M|adatum.U|xizraum)
..
.select year 'M|jahr.U|xizraum' 'M|amon.U|xizraum' 'M|emon.U|xizraum'
..
.continue NOTDEF ? _F|defined(M|bukreis.U|xizraum)
.continue NOTDEF ?  F|empty(M|bukreis.U|xizraum)
..
.set setofbooks 'M|bukreis.U|xizraum^bknr'
.continue BKRSET
..
..*****************************************************************************
!NOTDEF
..*****************************************************************************
.set setofbooks 'M|bukreis^bknr'
..
..*****************************************************************************
!BKRSET
..*****************************************************************************
.formula U|xtcmpvar = "cmp" + 'U|xicmpkb' + "p" + 'U|xizraum'
..
.formula M|.U|xtcmpvar = 0.00
.formula H|reregeln2 = "(9)" ? 'M|reregeln(L="0")' = "(9)"
.formula M|.U|xtcmpvar = F|fxamount(M|auswaehr, H|kbesaldo, G|edatum, M|buwaehr)
..
..*****************************************************************************
!CMPNEXT: next period
..*****************************************************************************
.continue CMPLOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
