..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LIQPLANDETAILS.SCRCTX
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : FOP zum Setzen des Maskenkontexts (P-Puffer)
.. Functionality  : FOP for screen context configuration (P buffer)
..*****************************************************************************
..
.set trans -
..
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = P|maskkontextfop + " WITH_POS"      ? F|empty(M|position)
.formula P|maskkontextfop = P|maskkontextfop + " WITH_PS"       ? F|empty(M|ekvk)
.formula P|maskkontextfop = P|maskkontextfop + " WITH_OVERDUE"  ? F|empty(M|position) ; M|positions = "(OutstandingItems)"
.formula P|maskkontextfop = P|maskkontextfop + " WITH_OBLIGO"   ? F|empty(M|position) ; M|positions = "(OutstandingDeliveries)" ; M|positions = "(OutstandingInvoices)"
.formula P|maskkontextfop = P|maskkontextfop + " WITH_DOC_HEAD" ? F|empty(M|position) ; (M|positions = "(OutstandingItems)" ; M|positions = "(OutstandingDeliveries)" ; M|positions = "(PurchaseOrderSuggestions)" ; M|positions = "(SubcontractingSuggestions)" ; M|positions = "(AmountOfVATPayableFromOutstandingItems)" ; M|positions = "(OutstandingInvoices)")
.formula P|maskkontextfop = P|maskkontextfop + " WITH_DESCR"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

