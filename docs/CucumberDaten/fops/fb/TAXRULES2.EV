..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TAXRULES2.EV
.. Author         : ankn
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Common event FOP of the Infosystem fb/TAXRULES2
..*****************************************************************************
..
.set trans -
..
.type text xpvon xpbis
..
.continue TAXSET          ? (G|evtartengl = "FIELD_EXIT"  )  & (G|evtvar = "vrgstrglvon") ; (G|evtvar = "vrgstrglbis")
.continue TAXSETCHANGED   ? (G|evtartengl = "FIELD_EXIT"  )  & (G|evtvar = "vrgstrgl")
.continue CHANGED         ? (G|evtartengl = "FIELD_EXIT"  )  & (G|evtvar = "datum")
.continue START           ? (G|evtartengl = "BUTTON_BEFORE") & (G|evtvar = "bstart")
..
..*****************************************************************************
!CHANGED: 
..*****************************************************************************
.make screen line --
.continue END
..
..*****************************************************************************
!TAXSET: 
..*****************************************************************************
.make screen line --
.formula M|vrgstrgl    = ""
.copy M|vrgstrglbis = M|vrgstrglvon ? (G|evtvar = "vrgstrglvon") & F|empty(M|vrgstrglbis)
.continue END
..
..*****************************************************************************
!TAXSETCHANGED: 
..*****************************************************************************
.make screen line --
.formula M|vrgstrglvon = ""
.formula M|vrgstrglbis = ""
.continue END
..
..*****************************************************************************
!START: Infosystem start
..*****************************************************************************
.make screen line --
.formula U|xpvon = "vrgstrglvon"
.formula U|xpbis = "vrgstrglbis"
.input "is/RANGECHECK"
..
.formula M|select = "$,"
.formula M|select = M|select + ";vrgstrgl^" + U|xxtfield + "=" + M|vrgstrglvon + "!" + M|vrgstrglbis
.formula M|select = M|select + ";vrgstrgl=" + M|vrgstrgl^id ? _F|empty(M|vrgstrgl)
.formula M|select = M|select + ";@gruppe=16"
.select 'G|hdatname58' 'M|select'
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.make screen line +O
.input 'M|tab'
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
