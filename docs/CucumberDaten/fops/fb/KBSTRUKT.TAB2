..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBSTRUKT.TAB2
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Name und Stufe setzen
.. Functionality  :
..
.. include fb/KBSTRUKT.TAB.LEVEL
..*****************************************************************************
.set trans -
..
.load 5 add M|tkoobj
.continue C ? G|mehr
.load 5 add M|tkoobjber
.continue C ? G|mehr
.load 5 add M|tkonto
.continue C ? G|mehr
.load 5 add M|tkbereich
.continue C ? G|mehr
.load 5 add M|tformular
.continue C ? G|mehr
.continue END
..
!C
.assign M|tformular  = M|kbobj^id
.assign    M|tobjekt    = 5|id
.formula   M|tbaumtext  = '5|grbez' + " " + '5|nummer' + " (" + 'M|tkname' + ")"
.copy M|tfausart   = 5|fausart  ? F|defined(5|fausart)
.copy M|treregeln  = 5|reregeln ? F|defined(5|reregeln)
.input "fb/KBSTRUKT.TAB.LEVEL"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
