..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.GEN.READ.WRITE
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : FOPs zum Lesen und Schreiben einer Zeile generieren
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.continue ERR01 ? _F|defined(U|rowidvar)
.continue ERR02 ? _F|defined(U|rowlevelvar)
..
.input "DATEI.F"
.output new 'F|expr(F|tostring(M|tmpdir) + ".WRITE.LINE")'
.println ..!interpreter german noabbrev
.println .setze verweis +
.println .setze spracheinstellungen "0"
.println -lfsuppress 'G|apostroph''F|expr(U|rowidvar)''G|apostroph'#
.println -lfsuppress 'G|apostroph''F|expr(U|rowlevelvar)''G|apostroph'#
.load 0 add M|isref
..
!L
.load 0 line
.continue EL ? _G|mehr
.continue L  ? _0|vkt
.continue L  ?  0|vitbezf/("BU*")
.continue L  ?  0|vitbezf/("CH*")
.continue L  ?  0|vttyp = 0 ; 0|vttyp = 2
.continue L  ?  0|inalias
.continue L  ?  ("M|" + F|substr(0|vname, 3)) = U|rowidvar
.continue L  ?  ("M|" + F|substr(0|vname, 3)) = U|rowlevelvar
.println -lfsuppress 'G|apostroph'M|'F|substr(0|vname, 3)''G|apostroph'#
.continue L
..
!EL
.println
.println .setze verweis -
.println .setze spracheinstellungen "T"
.output terminal
..
.output new 'F|expr(F|tostring(M|tmpdir) + ".READ.LINE")'
.println ..!interpreter german noabbrev
.println .setze verweis +
.println .setze spracheinstellungen "0"
.println -lfsuppress .HOLE VON 'G|apostroph'M|tmpdatname'G|apostroph'
.println -lfsuppress 'F|expr(U|rowidvar)' #
.println -lfsuppress 'F|expr(U|rowlevelvar)' #
.load 0 add M|isref
..
!L2
.load 0 line
.continue EL2 ? _G|mehr
.continue L2  ? _0|vkt
.continue L2  ?  0|vitbezf/("BU*")
.continue L2  ?  0|vitbezf/("CH*")
.continue L2  ?  0|vttyp = 0 ; 0|vttyp = 2
.continue L2  ?  0|inalias
.continue L2  ?  ("M|" + F|substr(0|vname, 3)) = U|rowidvar
.continue L2  ?  ("M|" + F|substr(0|vname, 3)) = U|rowlevelvar
.println -lfsuppress M|'F|substr(0|vname, 3)' #
.continue L2
..
!EL2
.println
.println .kopieren U|reachedeof = _G|mehr
.println .setze verweis -
.println .setze spracheinstellungen "T"
.output terminal
..
.continue
