..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.OBCASH
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Selektion und Ausgabe des Kontensaldos des Liquiditaetskontenbereichs
.. Functionality  : Select and output cash opening balance (from configured account range)
.. include fb/CASHMGMT.SELECT.WRITE
.. include fb/CASHMGMT.SELECT.VARS.RESET
..*****************************************************************************
..
.set trans -
..
.input "fb/CASHMGMT.SELECT.VARS.RESET"
..
.continue END ? _F|empty(U|xpdocument)
..
.copy U|xddate  = U|xpstart1
.formula   U|xttype  = "(LiquidAssetsOpeningBalance)"
.formula   U|xepurchsales = ""
.continue PLANNED ? F|empty(U|xpliqkber) & U|xrplannedobcash <> 0
.continue PLANNED ? U|xrplannedobcash <> 0 & U|xdstartdate > G|datum
.continue END ? F|empty(U|xpliqkber)
.select period 'U|xddate' 'U|xddate'
.set setofbooks 'U|xpsetofbooks^bknr'
.set currency 'U|xppostcurr'
.set outcurr 'G|inland'
.load 1 add U|xpliqkber
.continue END ? _G|mehr
.copy U|xrvalue = 1|kbesaldo
.copy U|xrvalue = F|fxamount(U|xpoutcurr,U|xrvalue,U|xddate,G|inland)
.continue OUT
..*****************************************************************************
!PLANNED
..*****************************************************************************
.copy U|xrvalue = U|xrplannedobcash
.continue OUT
..*****************************************************************************
!OUT
..*****************************************************************************
.input "fb/CASHMGMT.SELECT.WRITE"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.load 1
.continue

