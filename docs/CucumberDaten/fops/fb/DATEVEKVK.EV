..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVEKVK.EV
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Allgemeines Event-FOP des Infosystems fb/DATEVEKVK
.. Functionality  :
..*****************************************************************************
..
.. include fb/DATEVFBBW.EV
.. include fb/DATEVEKVK.TAB
.. include fb/DATEVEKVK.SET.DIFFS
.. include fb/DATEVEKVK.ST.VERTEIL
..
..*****************************************************************************
..
.set trans -
..
.input "fb/DATEVFBBW.EV"
..
.. Sonst geht die n„chste Zuweisung nicht.
.formula M|.G|evtvar = M|.G|evtvar ? G|evtartengl = "FIELD_VALIDATION"
..
.make screen line --
.formula M|prunddiff  = 0
.formula M|nrunddiff  = 0
.formula M|psteuerabw = 0
.formula M|nsteuerabw = 0
..
.continue START ? G|evtvar = "bstart"
.continue END
..
..*****************************************************************************
!START: Select data
..*****************************************************************************
.continue ERR01 ? _M|expeinkauf & _M|expverkauf
.input "fb/DATEVEKVK.TAB"
.input "fb/DATEVEKVK.ST.VERTEIL"
.input "fb/DATEVEKVK.SET.DIFFS"
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Weder Verkauf noch Einkauf ausgew„hlt.
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
