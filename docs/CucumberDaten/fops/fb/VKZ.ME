..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.ME
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Screen enter FOP of the Infosystem fb/VKZ
..
.. include fb/VKZ.SCRCTX
.. include fb/VKZ.VJ
..
..*****************************************************************************
..
.set trans -
.. Initializations (only for Dashboard, please dont't change)
.copy M|sortdash = G|FALSE
..
.. Initializations 
.select year 'G|gjahr'
.formula M|jahr1   = G|gjahr
.formula M|von1    = G|amonat
.formula M|bis1    = G|gmonat
.formula M|select  = "!"
.formula M|nonull  = G|TRUE
..
.copy M|stdverdku = F|SYSINFO(7)^verdku
.copy M|stdverdli = F|SYSINFO(7)^verdli
.copy M|stdverdma = F|SYSINFO(7)^verdma
.copy M|stdverdku = F|SYSINFO(7)^ford ? F|empty(M|stdverdku)
.copy M|stdverdli = F|SYSINFO(7)^verb ? F|empty(M|stdverdli)
.copy M|stdverdma = F|SYSINFO(7)^verb ? F|empty(M|stdverdma)
..
.copy M|bmitplanumsatz = G|FALSE
.copy M|mitvorjahr= G|FALSE
.copy M|bukreis   = G|bukreis
.copy M|buwaehr   = G|inland
.copy M|auswaehr  = G|inland
.copy M|kunden    = G|TRUE
.formula   M|maxperiod = F|condexpr(M|mitvorjahr, 2, 1)
.input "fb/VKZ.VJ" ? M|mitvorjahr
.copy M|buumzabdat = F|fystartdate(F|sysinfo(12)^fibuumzabgj, F|sysinfo(12)^fibuumzabgm)
.input "fb/VKZ.SCRCTX"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

