..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : AUSZUG.BFUSS
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Berichtfuss des Infosystems fb/AUSZUG
..  Functionality  : Report footer of the Infosystem fb/AUSZUG
..
.. include fb/AUSZUG.OHLC
..
..*****************************************************************************
..
.set trans -
..
.continue NODIFF ? _F|empty(M|konzern)
.formula M|differenz  = F|condexpr(U|xbbackward, M|anfsaldo  - U|xrkosaldo, M|endsaldo  - U|xrkosaldo)
.formula M|differenz2 = F|condexpr(U|xbbackward, M|anfsaldo2 - U|xrkosaldo2, M|endsaldo2 - U|xrkosaldo2)
..
..*****************************************************************************
!NODIFF
..*****************************************************************************
.formula M|sumsoll   = U|xrsumsoll
.formula M|sumhaben  = U|xrsumhaben
.formula M|bewegsal  = M|sumsoll - M|sumhaben
.formula M|sumsoll2  = U|xrsumsoll2
.formula M|sumhaben2 = U|xrsumhaben2
.formula M|bewegsal2  = M|sumsoll2 - M|sumhaben2
..
.continue END ? _U|xbohlc
..
.input "fb/AUSZUG.OHLC"
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
