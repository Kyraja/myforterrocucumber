..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.COMPARE1
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Vergleichswerte zu konstanter Periode berechnen
..*****************************************************************************
..
.set trans -
..
.. index of account range
.type integer xicmpkb       ? _F|defined(U|xicmpkb)
.. name of the variable with the value
.type text xtcmpvar     ? _F|defined(U|xtcmpvar)
.. name of the variable with the value
.type text xtcmpprozvar ? _F|defined(U|xtcmpprozvar)
.type real xrcmpval     ? _F|defined(U|xrcmpval)
.type integer  xiper        ? _F|defined(U|xiper)
..
.formula U|xicmpkb = 0
..*****************************************************************************
!CMPKB: Loop over account ranges for comparison
..*****************************************************************************
.formula U|xicmpkb = U|xicmpkb + 1
.continue END ? U|xicmpkb > M|maxcmpkb
..
.formula U|xizraum  = 0
..*****************************************************************************
!CMPLOOP
..*****************************************************************************
.formula U|xizraum  = U|xizraum + 1
.continue CMPKB    ? U|xizraum > M|maxperiod
..
.. get period index for balance comparison
.formula U|xiper    = M|verglper ?  M|verglper  > 0 & M|verglper <= M|maxperiod
.formula U|xiper    = 1          ? (M|verglper  < 1 ; M|verglper > M|maxperiod)
..
.formula U|xtcmpprozvar = "proz" + 'U|xicmpkb' + "p" + 'U|xizraum'
.formula U|xtcmpvar     = "cmp"  + 'U|xicmpkb' + "p" + 'U|xiper'
..
..*****************************************************************************
!CMP: comparison based (on a single period) and a single account range value
..*****************************************************************************
.continue CMPKB    ?  F|empty(M|cmpkb.U|xicmpkb)
..
.formula M|.U|xtcmpprozvar = 0
..
.formula U|xrcmpval = M|.U|xtcmpvar
.continue CMPLOOP  ? U|xrcmpval = 0
..
.formula M|.U|xtcmpprozvar = (M|betrag.U|xizraum / U|xrcmpval) * 100
.formula M|.U|xtcmpprozvar = M|.U|xtcmpprozvar * -1 ? U|xbnegate
..
.continue CMPLOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

