..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : AUSZUG.BKOPF
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Berichtskopf des Infosystems fb/AUSZUG
..*****************************************************************************
..
.set trans -
..
.type real xrbubetr
.type real xrbubetr2
.type real xrkosaldo xrkosaldo2
.type real xrsumsoll xrsumhaben
.type real xrsumsoll2 xrsumhaben2
.type integer  ximod
.type integer  xilmon
.type GJ   xlyear
.type integer  xifactor
.type bool xbbalreset
.type bool xbgv
.type bool xbohlc
..
..*****************************************************************************
..
.. OHLC computation and chart generation only possible if start and end year are the same (only 15 fields available)
.copy U|xbohlc      = M|ajahr = M|ejahr
.copy U|xbgv        = F|condexpr(F|defined(M|konto^gv), M|konto^gv, G|TRUE)
.formula   U|xrkosaldo   = F|condexpr(U|xbbackward, M|endsaldo, M|anfsaldo)
.formula   U|xrkosaldo2  = F|condexpr(U|xbbackward, M|endsaldo2, M|anfsaldo2)
..
.copy U|xilmon = M|amonat ? 'M|richtung(L="0")' = "(0)"
.copy U|xlyear = M|ajahr  ? 'M|richtung(L="0")' = "(0)"
.copy U|xilmon = M|emonat ? 'M|richtung(L="0")' = "(1)"
.copy U|xlyear = M|ejahr  ? 'M|richtung(L="0")' = "(1)"
..
.continue END ? _G|grafik
..
.input "is/ABASFARBEN.DEF"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
