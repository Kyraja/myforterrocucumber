..!interpreter english translate
..*****************************************************************************
..
..  Name      : BILKON.OBEN
..  Datum     : 16.07.96
..  Vers.     : 7.1
..  Autor     : Andrzej Klusek
..
..  Verantwortlich : hc
..  Kontrolle      : mh
..
..
..  Funktion  : BILKON.OBEN wird aus BILANZ/KONACH aufgerufen
..
..  Ablauf    : Obenpuffer definieren
..
..  Input     : -
..  Output    : -
..
..*****************************************************************************
..                           SUBROUTINE
..                           ----------
..
.end .        ?  txname / "*BILKON.OBEN"
..*****************************************************************************
.set trans -
.type date xdanf xdend
.type text  xt11t xt12t xt13t xt14t xt15t xt21t xt22t xt23t xt24t xt25t
.type text  xt1m:5 xt2m:5 xt3m:5 xt4m:5 xt5m:5 xt99trenn
..
..  EKS ist f걊 den Zeitraum 1.1.1982 31.12.2081 ausgelegt
.continue VA1  ? _ximax  >= 1
.formula xt1m     =  xam1 + "-" + xem1
.continue VA1  ? _ximax  >= 2
.formula xt2m     =  xam2 + "-" + xem2
.continue VA1  ? _ximax  >= 3
.formula xt3m     =  xam3 + "-" + xem3
.continue VA1  ? _ximax  >= 4
.formula xt4m     =  xam4 + "-" + xem4
.continue VA1  ? _ximax  >= 5
.formula xt5m     =  xam5 + "-" + xem5
..
!VA1
.formula xam   = xam1
.formula xem   = xem1
.formula xjahr = xjahr1
.input VKZHOLJAHR
.formula xdanf   = adatum
.formula xdend   = edatum
..
.output 'geraet'
.input BLANKOB.F
.set thoussep 'tsdtrenn'
..
..  LGP_Var. xt99trenn --> Trenner -> BILKON.RECH
.set decpoint 'dezpunkt'
.formula xt99trenn = ","
.page 1
.set trans +
.continue VB20  ?  xwastun = 2
.continue VB30  ?  xwastun = 3
.continue VB40  ?  xwastun = 4
..
.up
?'mandant          '                                        Bilanz - 'xtips                   ' '   datum'        Blatt' sei'  ?  _xnachweis  &  xl <> "gv"
?'txname           '                                        ======                              '    zeit'                     ?  _xnachweis  &  xl <> "gv"
?'mandant          '                             Gewinn und Verlust Rechnung - 'xtips         ' '   datum'        Blatt' sei'  ?  _xnachweis  &  xl =  "gv"
?'txname           '                             ===========================                    '    zeit'                     ?  _xnachweis  &  xl =  "gv"
?'mandant          '                                    Kontennachweis - 'xtips               ' '   datum'        Blatt' sei'  ?  xnachweis
?'txname           '                                    ==============                          '    zeit'                     ?  xnachweis
?Aktiva                                                  zum 'xdend   '     ?  xl = "ba"
?Passiva                                                 zum 'xdend   '     ?  xl = "bp"
?GuV                                               '   xdanf' - 'xdend   '  ?  xl = "gv"
                                                  aus Buchungen in W꼑rung: 'xxbuwaehr '
                                                  Ausgabew꼑rung          : 'auswaehr '

?                                                                                     Gesch꼎tsjahr             Gesch꼎tsjahr  ?  xl <> "gv"
?                                                                                     Gesch꼎tsjahr      %      Gesch꼎tsjahr  ?  xl =  "gv"
                                                                           ' x'     '  xjahr1'' x'            '  xjahr2'' x'
컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴
..K_____________o_______________n______________t___________o 123456789012345678 123456789012345678 100.00 123456789012345678
.continue VB50
..
!VB20: Obenpuffer - 2. Form der Ausgabe
.up
?'mandant          '                                        Bilanz - 'xtips                   ' '   datum'        Blatt' sei'  ?  _xnachweis  &  xl <> "gv"
?'txname           '                                        ======                              '    zeit'                     ?  _xnachweis  &  xl <> "gv"
?'mandant          '                             Gewinn und Verlust Rechnung - 'xtips         ' '   datum'        Blatt' sei'  ?  _xnachweis  &  xl =  "gv"
?'txname           '                             ===========================                    '    zeit'                     ?  _xnachweis  &  xl =  "gv"
?'mandant          '                                    Kontennachweis - 'xtips               ' '   datum'        Blatt' sei'  ?  xnachweis
?'txname           '                                    ==============                          '    zeit'                     ?  xnachweis
?Aktiva                                            '   xdanf' - 'xdend   '  ?  xl = "ba"
?Passiva                                           '   xdanf' - 'xdend   '  ?  xl = "bp"
?GuV                                               '   xdanf' - 'xdend   '  ?  xl = "gv"
                                                  aus Buchungen in W꼑rung: 'xxbuwaehr '
                                                  Ausgabew꼑rung          : 'auswaehr '

                                 _________________im Zeitraum_________________ ________________Jahreszahlen_________________
                                    Eingabejahr     Vorjahr         Abweichung    Eingabejahr     Vorjahr         Abweichung
                                         '   x'       '  x'       '  x'      %          '  x'       '  x'       '  x'      %
컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴
..K_o__________n______t________o 12345678901234 12345678901 12345678901  -1000 12345678901234 12345678901 12345678901  -1000
.continue VB50
..
!VB30: Obenpuffer - 3. Form der Ausgabe
.formula xt11t = "Gesch꼎tsjahr"     ?  ximax >= 1
.formula xt21t = xjahr1              ?  ximax >= 1
.formula xt21t = xt1m + " " + xt21t  ?  ximax >= 1
..
.formula xt12t = "Gesch꼎tsjahr"     ?  ximax >= 2
.formula xt22t = xjahr2              ?  ximax >= 2
.formula xt22t = xt2m + " " + xt22t  ?  ximax >= 2
..
.formula xt13t = "Gesch꼎tsjahr"     ?  ximax >= 3
.formula xt23t = xjahr3              ?  ximax >= 3
.formula xt23t = xt3m + " " + xt23t  ?  ximax >= 3
..
.formula xt14t = "Gesch꼎tsjahr"     ?  ximax >= 4
.formula xt24t = xjahr4              ?  ximax >= 4
.formula xt24t = xt4m + " " + xt24t  ?  ximax >= 4
..
.formula xt15t = "Gesch꼎tsjahr"     ?  ximax >= 5
.formula xt25t = xjahr5              ?  ximax >= 5
.formula xt25t = xt5m + " " + xt25t  ?  ximax >= 5
..
.up
?'mandant          '                                        Bilanz - 'xtips                   ' '   datum'        Blatt' sei'  ?  _xnachweis  &  xl <> "gv"
?'txname           '                                        ======                              '    zeit'                     ?  _xnachweis  &  xl <> "gv"
?'mandant          '                             Gewinn und Verlust Rechnung - 'xtips         ' '   datum'        Blatt' sei'  ?  _xnachweis  &  xl =  "gv"
?'txname           '                             ===========================                    '    zeit'                     ?  _xnachweis  &  xl =  "gv"
?'mandant          '                                    Kontennachweis - 'xtips               ' '   datum'        Blatt' sei'  ?  xnachweis
?'txname           '                                    ==============                          '    zeit'                     ?  xnachweis
?Aktiva                                            '   xdanf' - 'xdend   '  ?  xl = "ba"
?Passiva                                           '   xdanf' - 'xdend   '  ?  xl = "bp"
?GuV                                               '   xdanf' - 'xdend   '  ?  xl = "gv"
                                                  aus Buchungen in W꼑rung: 'xxbuwaehr '
                                                  Ausgabew꼑rung          : 'auswaehr '

                                                  '       xt11t' '       xt12t' '       xt13t' '       xt14t' '       xt15t'
                                                  '       xt21t' '       xt22t' '       xt23t' '       xt24t' '       xt25t'
컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴
..K_o__________n______t_________________________o 12345678901234 12345678901234 12345678901234 12345678901234 12345678901234
.continue VB50
..
!VB40: Obenpuffer - 4. Form der Ausgabe
.up
?'mandant          '                                        Bilanz                              '   datum'        Blatt' sei'  ?  _xnachweis  &  xl <> "gv"
?'txname           '                                        ======                              '    zeit'                     ?  _xnachweis  &  xl <> "gv"
?'mandant          '                             Gewinn und Verlust Rechnung                    '   datum'        Blatt' sei'  ?  _xnachweis  &  xl =  "gv"
