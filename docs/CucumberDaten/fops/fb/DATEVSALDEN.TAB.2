..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVSALDEN.TAB.2
.. Autor          : rowa
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Soll- und Habenbuchungen fÅr Salden in Maske einfÅgen
.. Functionality  :
..*****************************************************************************
..
.type text xtgrliste ? _F|defined(U|xtgrliste)
.type text xtgrp     ? _F|defined(U|xtgrp)
.type AN35 xednr     ? _F|defined(U|xednr)
.type bool xbsverd    ? _F|defined(U|xbsverd)
.type bool xbhbkb    ? _F|defined(U|xbhbkb)
.type ID5   xpac ? _F|defined(U|xpac)
.type P68:1 xpar ? _F|defined(U|xpar)
.type bool xxbendresult ? _F|defined(U|xxbendresult)
..
..*****************************************************************************
..
.set trans -
..
.formula U|xbsverd = G|FALSE
.formula U|xbhbkb = G|FALSE
.formula M|select    = "!" ? F|empty(M|select)
.formula U|xtgrliste = 'U|xednr' + ":" + 'U|xtgrp'
.select group 'U|xtgrliste' 'M|select'
.continue END ? _G|mehr
..
..*****************************************************************************
!L
..*****************************************************************************
.continue BUDEF ? F|defined(H|bu)
.continue SOLL
..
..*****************************************************************************
!BUDEF
..*****************************************************************************
.continue SOLL ? H|bu
.continue N    ? H|dnr <> 5
.formula U|xbsverd = (H|id = M|ford ; H|id = M|verb ; H|id = M|sford ; H|id = M|sverb)
.continue SOLL  ? U|xbsverd & M|sverd
.continue N     ? U|xbsverd & _M|sverd
.continue N     ? F|empty(M|hbkb)
.copy U|xpac = H|id
.copy U|xpar = M|hbkb
.input "fb/IS.AC.IN.AR"
.formula U|xbsverd = U|xbresult
.continue SOLL ? U|xbsverd & M|sverd
.continue SOLL ? M|verd
.continue N
..
..*****************************************************************************
!SOLL
..*****************************************************************************
.continue HABEN ? F|empty(H|ssum)
..
.make screen line +O
.assign M|tgrpobjekt     = H|id
.end 1 ? _G|mehr
.formula   M|tbruttoumsatz  = H|ssum * -1
.formula   M|twaehr         = G|auswaehr
.formula   M|tbasiswaehrbetr= M|tbruttoumsatz
.copy M|tbasiswaehr    = M|twaehr
.formula   M|tkurs          = 1.0
.assign M|terpgegenkonto = H|id
.end 1 ? _G|mehr
.copy M|tkonto         = M|sumktoexp
.copy M|tkontop        = G|FALSE
.copy M|tdatum = M|datbis
.input "fb/DATEVFBBW.ZEILE"
.formula   M|tbuschluessel  = "40" ? H|ssum > 0 &  M|tgegenauto
.formula   M|tbuschluessel  = "20" ? H|ssum < 0 & _M|tgegenauto
.formula   M|tbuschluessel  = "80" ? H|ssum < 0 &  M|tgegenauto
.continue HABEN
..
..*****************************************************************************
!HABEN
..*****************************************************************************
.continue N ? F|empty(H|hsum)
..
.make screen line +O
.assign M|tgrpobjekt     = H|id
.end 1 ? _G|mehr
.formula   M|tbruttoumsatz  = H|hsum
.formula   M|twaehr         = G|auswaehr
.formula   M|tbasiswaehrbetr= M|tbruttoumsatz
.copy M|tbasiswaehr    = M|twaehr
.formula   M|tkurs          = 1.0
.assign M|terpgegenkonto = H|id
.end 1 ? _G|mehr
.copy M|tkonto         = M|sumktoexp
.copy M|tdatum = M|datbis
.input "fb/DATEVFBBW.ZEILE"
.formula   M|tbuschluessel  = "40" ? H|hsum > 0 &  M|tgegenauto
.formula   M|tbuschluessel  = "20" ? H|hsum < 0 & _M|tgegenauto
.formula   M|tbuschluessel  = "80" ? H|hsum < 0 &  M|tgegenauto
.continue N
..
..*****************************************************************************
!N
..*****************************************************************************
.select continue
.continue END ? _G|mehr
.continue L   ? H|dnr<>5
..continue VERDCHECK ? M|verd = G|false
.continue L
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
