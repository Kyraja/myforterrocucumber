..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TAXRULES.EV
.. Author         : ankn
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Common event FOP of the Infosystem fb/TAXRULES
..
.. include fb/TAXRULES.SET.NODE.STATE
..*****************************************************************************
..
..!meta M|=fb/TAXRULES
..
.set trans -
..
.type text xpvon xpbis
..
.continue TAXSET          ? (G|evtartengl = "FIELD_EXIT"  )  & (G|evtvar = "strglvon") ; (G|evtvar = "strglbis")
.continue TAXSETCHANGED   ? (G|evtartengl = "FIELD_EXIT"  )  & (G|evtvar = "strgl")
.continue CHANGED         ? (G|evtartengl = "FIELD_EXIT"  )  & (G|evtvar = "datum")
.continue START           ? (G|evtartengl = "BUTTON_BEFORE") & (G|evtvar = "bstart")
.continue OPENALL         ? (G|evtartengl = "BUTTON_AFTER")  & (G|evtvar = "baufklappen")
.continue OPENALL         ? (G|evtartengl = "BUTTON_BEFORE") & (G|evtvar = "baufklappen")
.continue CLOSEALL        ? (G|evtartengl = "BUTTON_AFTER")  & (G|evtvar = "bzuklappen")
.continue CLOSEALL        ? (G|evtartengl = "BUTTON_BEFORE") & (G|evtvar = "bzuklappen")
..
..*****************************************************************************
!CHANGED: 
..*****************************************************************************
.make screen line --
.continue END
..
..*****************************************************************************
!TAXSET: 
..*****************************************************************************
.make screen line --
.formula M|strgl    = ""
.copy M|strglbis = M|strglvon ? (G|evtvar = "strglvon") & F|empty(M|strglbis)
.continue END
..
..*****************************************************************************
!TAXSETCHANGED: 
..*****************************************************************************
.make screen line --
.formula M|strglvon = ""
.formula M|strglbis = ""
.continue END
..
..*****************************************************************************
!OPENALL
..*****************************************************************************
.continue END ? G|evtartengl = "BUTTON_BEFORE"
.select screen header
!OL
.select screen line
.continue END ? _G|mehr
.continue OL  ? M|tbaumstufe > 0 ; M|tbaumstat <> "+"
.formula M|tbaumstat = "-"
.input 'M|openknot'
.continue OL
..
..*****************************************************************************
!CLOSEALL
..*****************************************************************************
.continue END ? G|evtartengl = "BUTTON_BEFORE"
.select screen header
!CL
.select screen line
!REMOVED
.continue END ? _G|mehr
.input "fb/TAXRULES.SET.NODE.STATE" ? M|tbaumstufe = 0
.continue CL ? M|tbaumstufe = 0
.make screen line -O
.continue REMOVED
..
..*****************************************************************************
!START: Infosystem start
..*****************************************************************************
.make screen line --
.formula U|xpvon = "strglvon"
.formula U|xpbis = "strglbis"
.input "is/RANGECHECK"
..
.formula M|select = "$,"
.formula M|select = M|select + ";strgl^" + U|xxtfield + "=" + M|strglvon + "!" + M|strglbis
.formula M|select = M|select + ";strgl=" + M|strgl^id ? _F|empty(M|strgl)
.formula M|select = M|select + ";@gruppe=16"
.formula M|select = M|select + F|formatstr(";strgl^sts=={1}", M|selsts^id)               ? _F|empty(M|selsts)
.formula M|select = M|select + F|formatstr(";strgl^ev=={1}", F|tostring(M|selev, "AS7")) ? _F|empty(M|selev)
.formula M|select = M|select + F|formatstr(";strgl^stlaart=={1}", F|tostring(M|selstlaart, "AS8")) ? _F|empty(M|selstlaart)
.select 'G|hdatname58' 'M|select'
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.make screen line +O
.input 'M|tab'
.continue NEXT
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
