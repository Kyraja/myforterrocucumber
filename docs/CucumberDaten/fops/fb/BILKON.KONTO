..!interpreter english translate
..*****************************************************************************
..
..  Name      : BILKON.KONTO
..  Datum     : 16.07.96
..  Vers.     : 7.1
..  Autor     : Andrzej Klusek
..
..  Verantwortlich : hc
..  Kontrolle      : mh
..
..
..  Funktion  : BILKON.KONTO wird aus BILKON.HOL aufgerufen
..
..  Ablauf    : alle Konten fÅr eine Zeile aus KOTAB holen und ausgeben
..
..  Input     : xber - Kontenbereich
..              xb - Kopie des Kontenbereichs
..  Output    : -
..
..*****************************************************************************
..                           SUBROUTINE
..                           ----------
..
.end .        ?  txname / "*BILKON.KONTO"
..*****************************************************************************
.set trans -
.continue VA100  ?  xb = "-b !"
..
.type text xtber
..
!VA10: Kontenbereich abarbeiten
.formula xtber = xber << ","
.continue VA100  ?  xtber = ""
.formula xber  = xber >> ","
..
.select account 'xtber'
.continue VA10   ? _mehr
.reserve
.formula xii = 1
..
!VA20: Im Kontenbereich ein Konto vorhanden. ZeitrÑume abarbeiten
..     Loop: Konten ausgeben - keine Summe wird gebildet
..
..  xwastun = 4 -> Ist-Plan-Vergleich -> xips == 0 Std_Belegung
..                 xips == 1 -> Ist-Zahlen, wenn 1.+3.+5. Lauf (xii==1/3/5)
..                 xips == 2 -> Planzahlen, wenn 2.+4.    Lauf (xii==2/4)
.formula xips  = 1  ?  xwastun = 4  &  (xii = 1  ;  xii = 3  ;  xii = 5)
.formula xips  = 2  ?  xwastun = 4  &  (xii = 2  ;  xii = 4)
.formula xjahr = xjahr.xii
.formula xam   = xam.xii
.formula xem   = xem.xii
.input VKZHOLJAHR
.select
..
.continue VA80   ? (xdv = "b"  ;  xdv = "")  &  num <> xko1  &  num <> xko2  &  num <> xsko1  &  num <> xsko2  & _bu
..
.input 'xt2fkt'
.formula xrgk.xii = xriezw
..
..  nÑchster Zeitraum
.formula xii = xii + 1
.continue VA20   ?  xii <= ximax
..
.formula xips  = 0  ?  xwastun = 4
..
..  Ausgabe
.formula xtskip = "VA80"
.continue VF100  ?  xwastun = 1
.continue VF200  ?  xwastun = 2
.continue VF300  ?  xwastun = 3
.continue VF400  ?  xwastun = 4
..
!VA80: nÑchstes Konto
.select account
.continue VA10   ? _mehr
..
..  nÑchstes Konto aus dem Kontenbereich, wieder alle ZeitrÑume abarbeiten
.reserve
.formula xii = 1
.continue VA20
..
!VA100: Kontenbereich einer Zeile aus KOTAB abgearbeitet
.continue
..
!VF100
?'   num' 'name                                             ' '           xrgk1'                        '           xrgk2'  ?  xbsldnull ; (xrgk1 <> 0) ; (xrgk2 <> 0)
.continue 'xtskip'
..
!VF200
.formula xr11 = xrgk1
.formula xr12 = xrgk2
.formula xr21 = xrgk3
.formula xr22 = xrgk4
.input 'xt3fkt'
?'   num' 'name                 ' '       xrgk1' '  xrgk2:0' '  xr1dz:0''  xx1' '       xrgk3' '  xrgk4:0' '  xr2dz:0''  xx2'  ? _(xinf = "d") & (xbsldnull ; (xrgk1 <> 0) ; (xrgk2 <> 0) ; (xrgk3 <> 0) ; (xrgk4 <> 0))
?'   num' 'name              ' '       xrgk1' '  xrgk2:0' '  xr1dz:0''  xx1' '       xrgk3' '  xrgk4:0' '  xr2dz:0''  xx2'     ?  (xinf = "d") & (xbsldnull ; (xrgk1 <> 0) ; (xrgk2 <> 0) ; (xrgk3 <> 0) ; (xrgk4 <> 0))
.continue 'xtskip'
..
!VF300
.formula xt1aus = xrgk1
?'   num' 'name                                  ' '      xt1aus' ? _(xinf = "d") & xii = 2 & (xbsldnull ; xrgk1 <> 0)
?'   num' 'name                               ' '      xt1aus'    ?  (xinf = "d") & xii = 2 & (xbsldnull ; xrgk1 <> 0)
.continue E300        ?  ximax < 2
.formula xt2aus = xrgk2
?'   num' 'name                                  ' '      xt1aus' '      xt2aus' ? _(xinf = "d") & xii = 3 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0)
?'   num' 'name                               ' '      xt1aus' '      xt2aus'    ?  (xinf = "d") & xii = 3 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0)
.continue E300        ?  ximax < 3
.formula xt3aus = xrgk3
?'   num' 'name                                  ' '      xt1aus' '      xt2aus' '      xt3aus' ? _(xinf = "d") & xii = 4 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0 ; xrgk3 <> 0)
?'   num' 'name                               ' '      xt1aus' '      xt2aus' '      xt3aus'    ?  (xinf = "d") & xii = 4 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0 ; xrgk3 <> 0)
.continue E300        ?  ximax < 4
.formula xt4aus = xrgk4
?'   num' 'name                                  ' '      xt1aus' '      xt2aus' '      xt3aus' '      xt4aus' ? _(xinf = "d") & xii = 5 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0 ; xrgk3 <> 0 ; xrgk4 <> 0)
?'   num' 'name                               ' '      xt1aus' '      xt2aus' '      xt3aus' '      xt4aus'    ?  (xinf = "d") & xii = 5 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0 ; xrgk3 <> 0 ; xrgk4 <> 0)
.continue E300        ?  ximax < 5
.formula xt5aus = xrgk5
?'   num' 'name                                  ' '      xt1aus' '      xt2aus' '      xt3aus' '      xt4aus' '      xt5aus' ? _(xinf = "d") & xii = 6 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0 ; xrgk3 <> 0 ; xrgk4 <> 0 ; xrgk5 <> 0)
?'   num' 'name                               ' '      xt1aus' '      xt2aus' '      xt3aus' '      xt4aus' '      xt5aus'    ?  (xinf = "d") & xii = 6 & (xbsldnull ; xrgk1 <> 0 ; xrgk2 <> 0 ; xrgk3 <> 0 ; xrgk4 <> 0 ; xrgk5 <> 0)
!E300
.continue 'xtskip'
..
!VF400
.formula xr11 = xrgk1
.formula xr12 = xrgk2
.formula xr21 = xrgk3
.formula xr22 = xrgk4
.input 'xt3fkt'
?'   num' 'name                      ' '       xrgk1' '       xrgk2'' xx1' '       xrgk3' '       xrgk4'' xx2' '       xrgk5'  ? _(xinf = "d") & (xbsldnull ; (xrgk1 <> 0) ; (xrgk2 <> 0) ; (xrgk3 <> 0) ; (xrgk4 <> 0))
?'   num' 'name                   ' '       xrgk1' '       xrgk2'' xx1' '       xrgk3' '       xrgk4'' xx2' '       xrgk5'     ?  (xinf = "d") & (xbsldnull ; (xrgk1 <> 0) ; (xrgk2 <> 0) ; (xrgk3 <> 0) ; (xrgk4 <> 0))
.continue 'xtskip'
