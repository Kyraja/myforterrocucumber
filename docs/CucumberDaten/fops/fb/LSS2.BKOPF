..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LSS2.BKOPF
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Berichtskopf des Infosystems fb/LSS2
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.type integer  xstufe
..
.formula U|xstufe = M|stufenvon
..*****************************************************************************
!DLOOP: Define level variables (sums and grouping criteria)
..*****************************************************************************
.type text xtvorkonto.xstufe xtlvorkonto.xstufe
.type real xranfsolsum.xstufe
.type real xranfhabensum.xstufe
.type real xrvkzssum.xstufe
.type real xrvkzhsum.xstufe
.type real xrgssum.xstufe
.type real xrghsum.xstufe
.type real xrendsolsum.xstufe
.type real xrendhabensum.xstufe
.type real xrendsolsum2.xstufe
.type real xrendhabensum2.xstufe
..
.formula U|xstufe = U|xstufe + 1
.continue DLOOP ? U|xstufe <= M|stufenbis
..
.load 0 add F|SYSINFO(7)
..
.input "is/ABASFARBEN.DEF"
..
.set setofbooks 'M|bukreis^bknr'
.set currency      'M|buwaehr^such'
.set outcurr      'M|auswaehr^such'
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
