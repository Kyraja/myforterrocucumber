..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LBU.SELENTRIES
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
..*****************************************************************************
.set trans -
..
.type text xtselect ? _F|defined(U|xtselect)
..
.formula U|xtselect = "$,"
.formula U|xtselect = U|xtselect + ";@gruppe=1;gruppe=1"                 ? _M|buartalle & M|buartn = 83
.formula U|xtselect = U|xtselect + ";@gruppe=0;gruppe=0"                 ? _M|buartalle & M|buartn = 70
.formula U|xtselect = U|xtselect + ";beleg= " + 'M|beleg'                ? _F|empty(M|beleg)
.. 107;zu konsolidieren;k;(107);ToBeConsolidated;
.. 110;nicht zu konsolidieren;n;(110);NotToBeConsolidated;
.formula U|xtselect = U|xtselect + ";konsol=true"                        ?  M|konsoln = 107
.formula U|xtselect = U|xtselect + ";konsol=false"                       ?  M|konsoln = 110
.formula U|xtselect = U|xtselect + ";ustva=" + 'M|ustva^id'              ? _F|empty(M|ustva)
.formula U|xtselect = U|xtselect + ";projekt=" + 'U|xprojekt'            ? _F|empty(U|xprojekt)
.formula U|xtselect = U|xtselect + ";kstelle=" + 'U|xkst'                ? _F|empty(U|xkst) & U|xkst^gruppe<>8
.formula U|xtselect = U|xtselect + ";koart=" + 'M|koart^id'              ? _F|empty(M|koart)
.formula U|xtselect = U|xtselect + ";kvert=" + 'U|xkst'                  ? _F|empty(U|xkst) & U|xkst^gruppe=8
.formula U|xtselect = U|xtselect + ";budat=" + 'M|von:8' + "!" + 'M|bis:8' ? _F|empty(M|von) ; _F|empty(M|bis)
.formula U|xtselect = U|xtselect + ";sortgjgm=" + F|fysortdat(M|anfj, M|anfm) + "!" + F|fysortdat(M|endj, M|endm)
.formula U|xtselect = U|xtselect + ";bukreis=" + 'M|bukreis^id'          ? _F|empty(M|bukreis)
.formula U|xtselect = U|xtselect + ";iwbu=" + 'M|buwaehr^id'             ? _F|empty(M|buwaehr)
.formula U|xtselect = U|xtselect + ";@zeilen=(1)"
.formula U|xtselect = U|xtselect + ";ursache=" + 'M|ursache(L="0")'      ? _F|empty(M|ursache)
.formula U|xtselect = U|xtselect + ";@ordnung=0:sortgjgm." + 'M|richtung(L=":")' + ",0:budat." + 'M|richtung(L=":")'
..
.continue S1 ? H|dnr = 27
.continue S2 ? (H|dnr = 5 & H|gruppe = 1) ; H|dnr = 0 ; H|dnr = 1 ; H|dnr = 11
.continue S3 ? H|dnr = 5 & (H|gruppe = 2 ; H|gruppe = 4)
.continue S4 ? H|dnr = 60
.continue S5 ? H|dnr = 86 & H|gruppe = 1
.continue C
..*****************************************************************************
!S1
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";anlage=" + 'H|id'
.continue C
..*****************************************************************************
!S2
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";0:kvextrakt=1"     ? _F|empty(U|xkst) ;  M|ktokvertaufl
.formula U|xtselect = U|xtselect + ";0:kvnextrakt=1"    ?  F|empty(U|xkst) & _M|ktokvertaufl
.formula U|xtselect = U|xtselect + ";konto=" + 'H|id'
.continue C
..*****************************************************************************
!S3
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";0:kvextrakt=1"
.formula U|xtselect = U|xtselect + ";kstelle=" + 'H|id'
.continue C
..*****************************************************************************
!S4
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";0:kvextrakt=1"
.formula U|xtselect = U|xtselect + ";koart=" + 'H|id' ? F|empty(M|koart)
.continue C
..*****************************************************************************
!S5
..*****************************************************************************
.formula U|xtselect = U|xtselect + ";0:projekt=" + 'H|id'
.continue C
..*****************************************************************************
!C
..*****************************************************************************
.load 1 entryjournal 'U|xtselect'
.formula U|ximodulo = U|ximodulo - 1 ? _G|mehr
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END    ? _G|mehr
.continue NEXT   ? _F|empty(M|konzern^mdkenn) & F|trim(1|mandkenn) <> M|konzern^mdkenn
.continue INSERT ?  U|ximaxjkenn = 0 ; F|empty(M|jkenn)
.formula U|xijkenn = 0
..*****************************************************************************
!JK
..*****************************************************************************
.formula U|xijkenn = U|xijkenn + 1
.continue NEXT   ? U|xijkenn > U|ximaxjkenn
.continue INSERT ? 1|kenn = U|xtjkenn.U|xijkenn
.continue JK
..
..*****************************************************************************
!INSERT
..*****************************************************************************
.input "fb/LBU.TAB"
.continue NEXT
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.load 1 continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.load 1
.continue
