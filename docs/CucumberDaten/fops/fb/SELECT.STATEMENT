..!interpreter english declaration noabbrev 
..*****************************************************************************
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Function       : provides ".select statement" functionality
..*****************************************************************************
.set trans -
.. parameters from outside
..*****************************************************************************
.. entry types (empty: all)
.type AS67 xentrytype ? _F|defined(U|xentrytype)
.. order direction
.type AS50 xdirection ? _F|defined(U|xdirection)
..*****************************************************************************
.. return value
.type bool xbresult   ? _F|defined(U|xbresult)
..*****************************************************************************
..
.. reset G|mehr
.assign U|xbresult = "invalidvalue"
.continue END  ? _F|defined(H|id)
.continue END  ?  F|empty(H|id)
.continue NEXT ?  H|dnr=131
.continue END  ? _F|isvalue(F|tostring(H|id), "VP6")
..
.type text xxselect   ? _F|defined(U|xxselect)
..
.. default direction is ascending order
.formula U|xdirection = "(Forwards)" ? F|empty(U|xdirection)
..
.formula U|xxselect = F|formatstr("$,@zeilen=(1);1:bukreis={1};0:iwbu={2};0:sortgjgm={3}!{4};budat={5}!{6}", G|bukreis^id, G|waehrung^id, F|fysortdat(G|ajahr, G|amonat), F|fysortdat(G|ejahr, G|emonat), G|adatum, G|edatum)
.formula U|xxselect = U|xxselect + F|formatstr(";{1}={2}", F|condexpr(H|dnr=5, F|condexpr(H|gruppe=1, "konto", "kstelle"), F|condexpr(H|dnr=60, "koart", "konto")), H|id)
.formula U|xxselect = U|xxselect + F|condexpr(H|dnr = 5 & (H|gruppe=2 ; H|gruppe=4), ";0:kvextrakt=1", ";0:kvnextrakt=1")
.formula U|xxselect = U|xxselect + F|condexpr(U|xentrytype = "(FinancialEntry)", ";@gruppe=0;gruppe=0", ";@gruppe=1;gruppe=1") ? _F|empty(U|xentrytype) & (H|dnr = 5 & (H|gruppe=2 ; H|gruppe=4))
.formula U|xxselect = U|xxselect + ";@gruppe=0;gruppe=0" ? H|dnr<>5 ; H|gruppe<>2 ; H|gruppe<>4
.formula U|xxselect = U|xxselect + F|formatstr(";@ordnung=sortgjgm.{1},budat.{1},bunummer.{1},buzn.{1}", U|xdirection)
.select 'G|hdatname131' 'U|xxselect'
.continue END
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.copy U|xbresult = G|mehr
.continue
