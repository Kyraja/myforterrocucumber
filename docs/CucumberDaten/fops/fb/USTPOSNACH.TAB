..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : USTPOSNACH.TAB
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Tabellen-FOP der Infosysteme fb/USTPOSKONACH und fb/USTPOSBUNACH
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.select line 'H|selzeile'
.continue END ? _G|mehr
.continue END ? _F|equals(F|condexpr(M|kontowaehr2, H|kow2, H|iwbu), M|waehr)
.formula U|xrbetrag = F|condexpr(M|kontowaehr2, H|w2betr, H|betrag)
.copy U|xbdata = G|TRUE
.input "fb/USTPOSNACH.KOSUM" ? M|sumkonto
.continue SUM ? _M|mitbuchungen
..
.make screen line +O
.assign M|tbuchung  = H|id
.formula   M|tbuzeile  = H|zn
.copy M|tbudat    = H|budat
.formula   M|tbeleg    = H|beleg
.formula   M|tbeldat   = H|beldat
.copy M|tkonto    = H|konto
.copy M|tkosteuer = M|tkonto^sts
.copy M|tkolaart  = M|tkonto^laart
.copy M|tkoev     = M|tkonto^ev
.copy M|tkokart   = M|tkonto^kart
.formula   M|tssum     = U|xrbetrag ?  H|soll
.formula   M|thsum     = U|xrbetrag ? _H|soll
.formula   M|tsaldo    = M|tssum - M|thsum
.copy M|tposition = H|ustva
.formula M|tmeldungsnr = M|posnum^meldungsnr 
.continue SUM
..
!SUM
.formula M|ssum   = M|ssum  + U|xrbetrag ?  H|soll
.formula M|hsum   = M|hsum  + U|xrbetrag ? _H|soll
.formula M|saldo  = M|ssum  - M|hsum
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
