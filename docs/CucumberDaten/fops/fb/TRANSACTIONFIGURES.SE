..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TRANSACTIONFIGURES.SE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type text  xselect   ? _F|defined(U|xselect)
.type text  xgroup    ? _F|defined(U|xgroup)
..
.copy M|kunde   = G|TRUE
.copy M|lief    = G|TRUE
.copy M|ma      = G|TRUE
.copy M|anlage  = G|TRUE
.copy M|umsatz  = G|TRUE
.copy M|koart   = G|TRUE
.copy M|bezug   = G|TRUE
.copy M|bab     = G|TRUE
.copy M|umlage  = G|TRUE
.copy M|artikel = G|TRUE
.copy M|beh     = G|TRUE
.copy M|konto   = G|TRUE
..
.assign M|bugruppe = 12
..
.. Buchungskreis setzen
.formula U|xgroup = "81:4"
.formula U|xselect = "$,,bkzuord=(SetOfBooks1)"
.load 2 group 'xgroup' 'U|xselect'
.continue END ? _G|mehr
.assign M|kbukreis = 2|id
..
..*****************************************************************************
!END
.continue
