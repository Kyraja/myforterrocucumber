..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.INSERT.ROW
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Einfgen einer Zeile
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.type bool rowinserted ? _F|defined(U|rowinserted)
.type bool reachedeof  ? _F|defined(U|reachedeof)
.type integer  xrowlevel   ? _F|defined(U|xrowlevel)
.type integer ximonat      ? _F|defined(U|ximonat) 
..
.make screen line +O
.input 'F|expr(F|tostring(M|tmpdir) + ".READ.LINE")'
.continue NODASH ? _F|defined(M|dashboard)
.. Im Dashboard sollen die Nachbuchungsmonate in einer Spalte summiert auf den letzten Monat des Gesch„ftsjahres erscheinen
.. In der Variablen anzahlmonategj stehen die Anzahl der Monate
.. Da die Summen in der Variable betrag1 stehen, findet man den letzten Monat in M|anzahlmonategj + 1
.continue NODASH ? _M|dashboard  
.formula U|ximonat = M|anzahlmonategj + 1
.formula M|betrag.ximonat = M|betrag.ximonat + M|betrag14 + M|betrag15 + M|betrag16
!NODASH
.continue DEL ? U|reachedeof
.continue DEL ? U|xrowlevel > U|xiklapp
.formula M|tbaumstufe = U|xrowlevel
.formula M|tbaumstat  = "+" ? _M|tclosed
.formula M|tbaumstat  = ""  ?  M|tclosed
.input "fb/KBFORMBILGUV.COMPARE" ? _M|novkz
.continue N2 ? _F|empty(M|knum)
.formula M|kname = M|kber^nameaspr
.set trans +
.formula M|knamedashist = M|kname + " Ist"      ? F|defined(M|knamedashist)
.formula M|knamedashsoll = M|kname + " Plan"    ? F|defined(M|knamedashsoll)
.set trans -
.continue NE
!N2
.continue N3 ? _F|empty(M|tkoobjber) & _F|empty(M|tkoobj)
.formula M|kname = M|knum^nameaspr
.copy M|tkontoname = M|knum
.continue NE
!N3
.formula M|kname = M|tkoobj^nameaspr
.assign M|tkontoname = M|tkoobj
.continue ERR01 ? _G|mehr
.continue NE
!NE
.copy U|rowinserted = G|TRUE
.continue END
..
..*****************************************************************************
!DEL
..*****************************************************************************
.make screen line -O
.copy U|rowinserted = G|FALSE
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Unerwarteter Fehler. Fehler beim Zuweisen von 'F|typeof(M|tkoobj)' zu 'F|typeof(M|tkontoname)'!
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
