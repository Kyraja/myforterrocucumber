..!interpreter english translate noabbrev
..*****************************************************************************
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : common event FOP of the Infosystem fb/ZM
.. include fb/ZM.SET.PERIOD
.. include fb/ZM.LOAD
..*****************************************************************************
..
..!meta M|=fb/ZM
..
.set trans -
..
.input "is/TABLEEREN" ? G|evtartengl = "FIELD_EXIT" ; G|evtartengl = "BUTTON_AFTER"
..
.continue SETPER    ? G|evtartengl = "FIELD_EXIT" & (G|evtvar = "intervall" ; G|evtvar = "periode" ; G|evtvar = "jahr")
.continue CHKINT    ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "intervall"
.continue CHKPER    ? G|evtartengl = "FIELD_VALIDATION" & (G|evtvar = "periode" ; G|evtvar = "jahr")
.continue CHKROWDEL ? G|evtartengl = "ROW_DELETION_BEFORE"
.continue START     ? G|evtvar = "bstart" & G|evtartengl = "BUTTON_AFTER"
.continue END
..
..*****************************************************************************
!CHKROWDEL
..*****************************************************************************
.end 1 ? F|empty(M|zmdat)
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.input "fb/ZM.LOAD"
.continue END
..
..*****************************************************************************
!SETPER
..*****************************************************************************
.input "fb/ZM.SET.PERIOD"
.continue END
..
..*****************************************************************************
!CHKPER
..*****************************************************************************
.type AS60 xintervall
.copy U|xintervall = M|intervall
.end 1 ? F|empty(M|.G|evtvar)
.end 1 ? U|xintervall = "(Monthly)" & M|periode > 12 & G|evtvar = "periode"
.end 1 ? U|xintervall = "(Quarterly)" & M|periode > 4 & G|evtvar = "periode"
.continue END
..
..*****************************************************************************
!CHKINT
..*****************************************************************************
.type AS60 xintervall
.copy U|xintervall = M|intervall
.continue ERR01 ? U|xintervall <> "(Monthly)" & U|xintervall <> "(Quarterly)" & U|xintervall <> "(Annually)"
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Nur monatlich, quartalsweise und j„hrlich zugelassen.
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
