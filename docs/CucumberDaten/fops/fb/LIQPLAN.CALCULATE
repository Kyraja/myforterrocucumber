..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LIQPLAN.CALCULATE
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Werte berechnen
.. Functionality  : Calculate some values
.. include fb/LIQPLAN.ROW.FIND
.. include fb/LIQPLAN.ALL.ROW.SUMS
..*****************************************************************************
..
.set trans -
..
.type integer xxi ? _F|defined(U|xxi)
.type integer xiinterestsdiv
.type R   xrcreditlineavail
..
..*****************************************************************************
!CALC
..*****************************************************************************
.formula U|xiinterestsdiv = 360 ? 'U|xiperiodtype' = "(Day)"
.formula U|xiinterestsdiv =  50 ? 'U|xiperiodtype' = "(Week)"
.formula U|xiinterestsdiv =  12 ? 'U|xiperiodtype' = "(Month)"
.formula U|xiinterestsdiv =   4 ? 'U|xiperiodtype' = "(Quarter)"
.formula U|xiinterestsdiv =   1 ? 'U|xiperiodtype' = "(Year)"
.end 1 ? U|xiinterestsdiv = 0
..
.formula U|xiperiod = 1
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xxi = U|xiperiod - 1
.continue CRHEAD ? U|xiperiod > M|maxper
..
.type real xrOBCASH.xiperiod xrOBLINE.xiperiod xrOBCASHTOTAL.xiperiod
.type real xrOIsales.xiperiod xrOINVsales.xiperiod xrODELsales.xiperiod
.type real xrOTRPAY.xiperiod xrPAYINTOTAL.xiperiod xrOIpurch.xiperiod
.type real xrOINVpurch.xiperiod xrODELpurch.xiperiod xrPORDSUG.xiperiod xrSUBCONTRSUG.xiperiod
.type real xrOTRPAYOUT.xiperiod xrPAYOUTTOTAL.xiperiod xrCASHBAL1y.xiperiod
.type real xrPOSTEDTAXPAY.xiperiod xrOPENITEMSTAXPAY.xiperiod xrAVGINTP.xiperiod
.type real xrINTP.xiperiod xrAVGINTU.xiperiod xrINTU.xiperiod
.type real xrOTRDEBITS.xiperiod xrCASHBAL2y.xiperiod xrCBCASH.xiperiod
.type real xrCBLINE.xiperiod xrCBCASHTOTAL.xiperiod xrLINEUSE.xiperiod
.type real xrLINEUSEPER.xiperiod xrLINEDELTA.xiperiod
..
.select screen header
..*****************************************************************************
!RLOOP1
..*****************************************************************************
.select screen line
.continue COMPUTE ? _G|mehr
.. carry over to next period
.formula M|twert.U|xiperiod       = M|twert.U|xiperiod + U|xrCBCASH.U|xxi   ? M|tpositions = "(LiquidAssetsOpeningBalance)" & U|xiperiod > 1
..
.formula U|xrOBCASH.U|xiperiod    = M|twert.U|xiperiod ? M|tpositions = "(LiquidAssetsOpeningBalance)"
.formula U|xrOBLINE.U|xiperiod    = M|twert.U|xiperiod ? M|tpositions = "(CreditLineOpeningBalance)"
.formula U|xrCBLINE.U|xiperiod    = M|twert.U|xiperiod ? M|tpositions = "(CreditLineClosingBalance)"
.formula U|xrOIsales.U|xiperiod   = U|xrOIsales.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OutstandingItems)" & M|tekvks = "(Sales)"
.formula U|xrOINVsales.U|xiperiod = U|xrOINVsales.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OutstandingInvoices)" & M|tekvks = "(Sales)"
.formula U|xrODELsales.U|xiperiod = U|xrODELsales.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OutstandingDeliveries)" & M|tekvks = "(Sales)"
.formula U|xrOTRPAY.U|xiperiod    = U|xrOTRPAY.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OtherIncomingPayments)" & M|tekvks = "(Sales)"
.formula U|xrOIpurch.U|xiperiod   = U|xrOIpurch.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OutstandingItems)" & M|tekvks = "(Purchasing)"
.formula U|xrOINVpurch.U|xiperiod = U|xrOINVpurch.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OutstandingInvoices)" & M|tekvks = "(Purchasing)"
.formula U|xrODELpurch.U|xiperiod = U|xrODELpurch.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OutstandingDeliveries)" & M|tekvks = "(Purchasing)"
.formula U|xrPORDSUG.U|xiperiod   = U|xrPORDSUG.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(PurchaseOrderSuggestions)"
.formula U|xrSUBCONTRSUG.U|xiperiod = U|xrSUBCONTRSUG.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(SubcontractingSuggestions)"
.formula U|xrOTRPAYOUT.U|xiperiod = U|xrOTRPAYOUT.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(OtherOutgoingPayments)"
.formula U|xrPOSTEDTAXPAY.U|xiperiod = U|xrPOSTEDTAXPAY.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(PostedAmountOfVATPayable)"
.formula U|xrOPENITEMSTAXPAY.U|xiperiod = U|xrOPENITEMSTAXPAY.U|xiperiod + M|twert.U|xiperiod ? M|tpositions = "(AmountOfVATPayableFromOutstandingItems)"
.formula U|xrAVGINTP.U|xiperiod   = M|twert.U|xiperiod ? M|tpositions = "(PercentCommitmentFee)"
.formula U|xrAVGINTU.U|xiperiod   = M|twert.U|xiperiod ? M|tpositions = "(PercentInterestOnAvailment)"
.continue RLOOP1
..
..*****************************************************************************
!COMPUTE: Compute some values
..*****************************************************************************
.formula U|xrOBCASHTOTAL.U|xiperiod = U|xrOBCASH.U|xiperiod + U|xrOBLINE.U|xiperiod
.formula U|xrPAYINTOTAL.U|xiperiod  = U|xrOIsales.U|xiperiod + U|xrOINVsales.U|xiperiod + U|xrODELsales.U|xiperiod + U|xrOTRPAY.U|xiperiod
.formula U|xrPAYOUTTOTAL.U|xiperiod = U|xrOIpurch.U|xiperiod + U|xrOINVpurch.U|xiperiod + U|xrODELpurch.U|xiperiod + U|xrPORDSUG.U|xiperiod + U|xrSUBCONTRSUG.U|xiperiod + U|xrOTRPAYOUT.U|xiperiod
.formula U|xrCASHBAL1y.U|xiperiod   = U|xrPAYINTOTAL.U|xiperiod - U|xrPAYOUTTOTAL.U|xiperiod
.formula U|xrINTP.U|xiperiod        = (U|xrCBLINE.U|xxi - U|xrLINEUSE.U|xxi) * U|xrAVGINTP.U|xxi / 100 / U|xiinterestsdiv * U|xitufactor ? U|xxi > 0
.formula U|xrINTU.U|xiperiod        = U|xrLINEUSE.U|xxi * U|xrAVGINTU.U|xxi                   / 100 / U|xiinterestsdiv * U|xitufactor ? U|xxi > 0
.formula U|xrOTRDEBITS.U|xiperiod   = U|xrPOSTEDTAXPAY.U|xiperiod + U|xrOPENITEMSTAXPAY.U|xiperiod + U|xrINTP.U|xiperiod + U|xrINTU.U|xiperiod
.formula U|xrCASHBAL2y.U|xiperiod   = U|xrCASHBAL1y.U|xiperiod - U|xrOTRDEBITS.U|xiperiod
.formula U|xrCBCASH.U|xiperiod      = U|xrOBCASH.U|xiperiod + U|xrCASHBAL2y.U|xiperiod
.formula U|xrCBCASHTOTAL.U|xiperiod = U|xrCBCASH.U|xiperiod + U|xrCBLINE.U|xiperiod
.formula U|xrLINEUSE.U|xiperiod     = F|max(F|min(U|xrCBCASH.U|xiperiod*-1,U|xrCBLINE.U|xiperiod),0)
.formula U|xrLINEUSEPER.U|xiperiod  = U|xrLINEUSE.U|xiperiod / U|xrCBLINE.U|xiperiod * 100 ? U|xrCBLINE.U|xiperiod <> 0
.formula U|xrLINEDELTA.U|xiperiod   = U|xrCBLINE.U|xiperiod - U|xrOBLINE.U|xiperiod
..
.formula U|xepurchsales = ""
.copy    U|xbintercompany = G|false
.formula U|xcategory = ""
..
.formula U|xttype = "(CashHoldingsOpeningBalance)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrOBCASHTOTAL.U|xiperiod
.formula U|xttype = "(TotalIncomingPayments)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrPAYINTOTAL.U|xiperiod
.formula U|xttype = "(TotalOutgoingPayments)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrPAYOUTTOTAL.U|xiperiod
.formula   U|xttype = "(LiquidAssetsBalanceI)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrCASHBAL1y.U|xiperiod
.formula   U|xttype = "(CommitmentFee)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrINTP.U|xiperiod
.formula   U|xttype = "(InterestOnAvailment)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrINTU.U|xiperiod
.formula   U|xttype = "(TotalOfAdditionalDebits)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrOTRDEBITS.U|xiperiod
.formula   U|xttype = "(LiquidAssetsBalanceII)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrCASHBAL2y.U|xiperiod
.formula   U|xttype = "(LiquidAssetsClosingBalance)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrCBCASH.U|xiperiod
.formula   U|xttype = "(CreditLineClosingBalance)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrCBLINE.U|xiperiod
.formula   U|xttype = "(CashHoldingsClosingBalance)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrCBCASHTOTAL.U|xiperiod
.formula   U|xttype = "(AvailmentCreditLineAbsolute)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrLINEUSE.U|xiperiod
.formula   U|xttype = "(AvailmentCreditLine)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrLINEUSEPER.U|xiperiod
.formula   U|xttype = "(CreditCapacityChange)"
.input "fb/LIQPLAN.ROW.FIND"
.formula M|twert.U|xiperiod = U|xrLINEDELTA.U|xiperiod
.continue NEXTPER
..
..*****************************************************************************
!NEXTPER
..*****************************************************************************
.formula M|klnutzabs = M|klnutzabs + U|xrLINEUSE.U|xiperiod
.formula U|xrcreditlineavail = U|xrcreditlineavail  + U|xrCBLINE.U|xiperiod
..
.formula U|xiperiod = U|xiperiod + 1
.continue LOOP
..
..*****************************************************************************
!CRHEAD
..*****************************************************************************
.formula M|klnutzrel = F|condexpr(U|xrcreditlineavail<>0, M|klnutzabs / U|xrcreditlineavail * 100, 0)
.formula M|klnutzabs = M|klnutzabs / M|maxper
.continue ROWSUMS
..
..*****************************************************************************
!ROWSUMS
..*****************************************************************************
.input "fb/LIQPLAN.ALL.ROW.SUMS"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

