..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.CHECK.ACCOUNT.EXCLUDED
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Prueft ob das im Puffer 1 geladene Verdichtungskonto ausgeschlossen ist
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.type bool xbok ? _F|defined(U|xbok)
.copy U|xbok = G|TRUE
.continue END ?  U|xbshowall
.continue END ? _F|defined(1|id)
.continue END ?  F|empty(U|xparexcluded)
.load 2 add 1|verd ? 1|dnr=0 ; 1|dnr=1 ; 1|dnr=11
.load 2 add 1|id   ? 1|dnr=5 & 1|gruppe=1
.continue END ? _F|defined(2|id)
.load 3 accrange 'F|formatstr("$,@gruppe={1};@zeilen=(1);id={2};konto={3}", F|expr(U|xparexcluded^gruppe+16), U|xparexcluded^id, 2|id)'
.copy U|xbok = G|FALSE ? G|mehr
.load 2
.load 3
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

