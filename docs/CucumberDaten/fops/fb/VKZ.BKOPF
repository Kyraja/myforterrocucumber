..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.BKOPF
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Report header of the Infosystem fb/VKZ
..*****************************************************************************
..
.set trans -
..
.type P6 xbuchung
.type P97:1 xplstaat
.type ID5:1 xplverd
.type integer ximonth
..
.input "is/ABASFARBEN.DEF" ? G|grafik
..
.set setofbooks 'M|bukreis^bknr'
.set currency      'M|buwaehr^such'
.set outcurr      'M|auswaehr^such'
..
.type integer xperiod ? _F|defined(U|xperiod)
.formula U|xperiod = 1
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? U|xperiod > M|maxperiod
.type real xranfsolsum.xperiod
.type real xranfhabensum.xperiod
.type real xrvkzssum.xperiod
.type real xrvkzhsum.xperiod
.type real xrgssum.xperiod
.type real xrghsum.xperiod
.type real xrendsolsum.xperiod
.type real xrendhabensum.xperiod
.type real xrumsatz.xperiod
.type real xrbuumsatz.xperiod
.formula U|xperiod = U|xperiod + 1
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
