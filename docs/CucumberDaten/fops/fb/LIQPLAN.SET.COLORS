..!interpreter english translate noabbrev
..*****************************************************************************
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : set row colors
..*****************************************************************************
..
.set trans -
..
.input "is/ABASFARBEN.DEF"
..
.select screen header
.select screen line 'G|evtzeile' ? G|evtzeile > 0
.select screen line              ? G|evtzeile = 0
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.colour -background 'F|condexpr(M|tbaumstufe=0, F|condexpr(M|tbaumstat<>"-", F|condexpr(F|empty(M|tfarbe), "-1 -1 -1", M|tfarbe), U|xabasstructuretop), U|xabasstructuresub)' 'M|aktzeile'
.select screen line
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
