..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.VALUES.LOOP
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Schleife ber die Perioden
..*****************************************************************************
..
.set trans -
..
.formula U|xizraum = 0
..*****************************************************************************
!LOOP: Loop over defined periods
..*****************************************************************************
.formula U|xizraum = U|xizraum + 1
.continue END       ? U|xizraum > M|maxperiod
..
.formula U|xrbetrag.U|xizraum  = 0.00
.formula U|xrbetragp.U|xizraum = 0.00
.formula U|xrasaldo.U|xizraum  = 0.00
.formula U|xresaldo.U|xizraum  = 0.00
.formula U|xrssum.U|xizraum    = 0.00
.formula U|xrhsum.U|xizraum    = 0.00
..
.continue NEXT      ?  F|empty(M|adatum.U|xizraum)
..
.continue SETPERIOD ?  U|xizraum = 1
.type integer xilzraum ? _F|defined(U|xilzraum)
.formula U|xilzraum = U|xizraum - 1
.continue SAMEPER   ?  M|jahr.U|xizraum = M|jahr.U|xilzraum & M|amon.U|xizraum = M|amon.U|xilzraum & M|emon.U|xizraum = M|emon.U|xilzraum
..
..*****************************************************************************
!SETPERIOD
..*****************************************************************************
.select year 'M|jahr.U|xizraum' 'M|amon.U|xizraum' 'M|emon.U|xizraum'
..
..*****************************************************************************
!SAMEPER: If the the same period
..*****************************************************************************
.continue NOTDEF ? _F|defined(M|bukreis.U|xizraum)
.continue NOTDEF ?  F|empty(M|bukreis.U|xizraum)
..
.set setofbooks 'M|bukreis.U|xizraum^bknr' ? G|bukreis^bknr <> M|bukreis.U|xizraum^bknr
.continue BKRSET
..
..*****************************************************************************
!NOTDEF
..*****************************************************************************
.set setofbooks 'M|bukreis^bknr'         ? G|bukreis^bknr <> M|bukreis^bknr
..
..*****************************************************************************
!BKRSET
..*****************************************************************************
.input "fb/KBFORMBILGUV.VALUES"
.continue NEXT ? M|auswaehr^id = M|buwaehr^id
.formula U|xrbetrag.U|xizraum  = F|fxamount(M|auswaehr, U|xrbetrag.U|xizraum , G|edatum, M|buwaehr) ? U|xrbetrag.U|xizraum  <> 0
.formula U|xrbetragp.U|xizraum = F|fxamount(M|auswaehr, U|xrbetragp.U|xizraum, G|edatum, M|buwaehr) ? U|xrbetragp.U|xizraum <> 0 & U|xbmitplan
.formula U|xrasaldo.U|xizraum  = F|fxamount(M|auswaehr, U|xrasaldo.U|xizraum , G|edatum, M|buwaehr) ? U|xrasaldo.U|xizraum  <> 0 & U|xbsalden
.formula U|xresaldo.U|xizraum  = F|fxamount(M|auswaehr, U|xresaldo.U|xizraum , G|edatum, M|buwaehr) ? U|xresaldo.U|xizraum  <> 0 & U|xbsalden
.formula U|xrssum.U|xizraum    = F|fxamount(M|auswaehr, U|xrssum.U|xizraum   , G|edatum, M|buwaehr) ? U|xrssum.U|xizraum    <> 0 & U|xbshsum
.formula U|xrhsum.U|xizraum    = F|fxamount(M|auswaehr, U|xrhsum.U|xizraum   , G|edatum, M|buwaehr) ? U|xrhsum.U|xizraum    <> 0 & U|xbshsum
.continue NEXT
..
..*****************************************************************************
!NEXT: Increase period array counter
..*****************************************************************************
.formula U|xbhasvalues       = U|xbhasvalues  ; U|xrbetrag.U|xizraum  <> 0.00
.formula U|xbhasvaluesp      = U|xbhasvaluesp ; U|xrbetragp.U|xizraum <> 0.00
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
