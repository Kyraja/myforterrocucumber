..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVSALDEN.TAB
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Lesen der EKVK-Positionen in der korrekten Reihenfolge
..                  und Verdichtung
.. Functionality  :
..
..*****************************************************************************
..
.type text xtgrp ? _F|defined(U|xtgrp)
.type AN35 xednr ? _F|defined(U|xednr)
..
..*****************************************************************************
..
.set trans -
..
.select year 'M|gjahr' 'M|anfm' 'M|endm'
.set setofbooks 'M|bukreis^id'
.set outcurr 'M|expwaehr^such'
.set currency 'M|buwaehr^such'
.input "is/RANGECHECK"
.formula M|select = M|bevon + "!" + M|bebis
.continue S1
..
..*****************************************************************************
!S1: Sachkonten
..*****************************************************************************
.continue S2 ? _M|sachkonten
.formula U|xednr = 5
.formula U|xtgrp = "1"
.input "fb/DATEVSALDEN.TAB.2"
.continue S2
..
..*****************************************************************************
!S2: Kunden
..*****************************************************************************
.continue S3 ? _M|kunden
.formula U|xednr = 0
.formula U|xtgrp = "1"
.input "fb/DATEVSALDEN.TAB.2"
.continue S3
..
..*****************************************************************************
!S3: Lieferanten
..*****************************************************************************
.continue S4 ? _M|lieferanten
.formula U|xednr = 1
.formula U|xtgrp = "1"
.input "fb/DATEVSALDEN.TAB.2"
.continue S4
..
..*****************************************************************************
!S4: Mitarbeiter
..*****************************************************************************
.continue END ? _M|mitarbeiter
.formula U|xednr = 11
.formula U|xtgrp = "1"
.input "fb/DATEVSALDEN.TAB.2"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
