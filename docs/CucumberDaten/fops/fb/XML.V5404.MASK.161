..
.type integer xianmon
.type integer xiendmon
.type integer xiindex
.formula U|xiindex  = 0
.formula U|xianmon  = F|month(M|kaladat)
.formula U|xiendmon = F|month(M|kaledat)
.continue MONTH ? 'M|zeitraum(L="0")' = "(109)"
.continue QUART ? 'M|zeitraum(L="0")' = "(113)"
.continue HEND
..
..*****************************************************************************
!MONTH
..*****************************************************************************
.formula U|xiindex = U|xiindex + 1
.continue HEND ? U|xiindex > 12
<Field name="mon'U|xiindex'" abasType="IP1" value=""><![CDATA['F|condexpr(U|xianmon <= U|xiindex & U|xiendmon >= U|xiindex, "1", "0")']]></Field>
.continue MONTH
..
..*****************************************************************************
!QUART
..*****************************************************************************
.formula U|xiindex = U|xiindex + 1
.continue HEND ? U|xiindex > 4
<Field name="quart'U|xiindex'" abasType="IP1" value=""><![CDATA['F|condexpr(M|ganmon <= U|xiindex & M|gendmon >= U|xiindex, "1", "0")']]></Field>
.continue QUART
