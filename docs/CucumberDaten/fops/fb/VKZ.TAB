..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.TAB
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Table FOP of the Infosystem fb/VKZ
..
.. include fb/VKZ.SUM
.. include fb/VKZ.TAB2
..
..*****************************************************************************
..
.set trans -
..
.copy U|xpverd  =H|verd
.copy U|xpverd  =M|stdverdku ? F|empty(U|xpverd) & H|dnr=0
.copy U|xpverd  =M|stdverdli ? F|empty(U|xpverd) & H|dnr=1
.copy U|xpverd  =M|stdverdma ? F|empty(U|xpverd) & H|dnr=11
..
.continue CHKGRP1 ? M|grpnachstaat
.continue CHKGRP2 ? M|grpnachverd
.continue INSERT
..
..*****************************************************************************
!CHKGRP1
..*****************************************************************************
.copy U|xplstaat = H|staat ? F|empty(U|xplstaat)
.input "fb/VKZ.SUM" ? U|xplstaat^id<>H|staat^id
.continue INSERT        ? U|xplstaat^id =H|staat^id
.copy U|xplstaat = H|staat
.continue INSERT
..
..*****************************************************************************
!CHKGRP2
..*****************************************************************************
.copy U|xplverd = U|xpverd ? F|empty(U|xplverd)
.input "fb/VKZ.SUM" ? U|xplverd<>U|xpverd
.continue INSERT        ? U|xplverd =U|xpverd
.copy U|xplverd = U|xpverd
.continue INSERT
..
..*****************************************************************************
!INSERT
..*****************************************************************************
.make screen line +O
.formula   M|tkonto       = H|id
.copy M|tauswaehr    = M|auswaehr
.copy M|tstaat       = H|staat
.copy M|tverd        = U|xpverd
.formula   M|tbezeichnung = F|condexpr(F|empty(H|nameaspr), H|namebspr, H|nameaspr)
..
.formula U|xperiod = 1
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue C1 ? U|xperiod > M|maxperiod
.select year 'M|jahr.U|xperiod' 'M|von.U|xperiod' 'M|bis.U|xperiod'
.input "fb/VKZ.TAB2"
.formula U|xperiod = U|xperiod + 1
.continue LOOP
..
!C1
.make screen line -O ? M|keineeinzel
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

