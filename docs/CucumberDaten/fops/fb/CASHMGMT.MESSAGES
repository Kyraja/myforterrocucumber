..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.MESSAGES
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Fehlerbehandlung
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.type text xmsg       ? _F|defined(U|xmsg)
.type integer  xmsgno     ? _F|defined(U|xmsgno)
.type bool xerrmsg    ? _F|defined(U|xerrmsg)
.. Im Fehlerfall nicht mit .ende 1 beenden
.type bool xerrcont   ? _F|defined(U|xerrcont)
.type integer  xmsgpcnt   ? _F|defined(U|xmsgpcnt)
.type text xmsgparam1 ? _F|defined(U|xmsgparam1)
.type text xmsgparam2 ? _F|defined(U|xmsgparam2)
.type text xmsgparam3 ? _F|defined(U|xmsgparam3)
.type text xmsgparam4 ? _F|defined(U|xmsgparam4)
..
.continue END ? U|xmsgno = 0
..
.formula U|xmsg = 'U|msg.U|xmsgno'
.continue OUT ? U|xmsgpcnt = 0
.formula U|xmsg = F|formatstr(U|xmsg, U|xmsgparam1)                                           ? U|xmsgpcnt = 1
.formula U|xmsg = F|formatstr(U|xmsg, U|xmsgparam1, U|xmsgparam2)                             ? U|xmsgpcnt = 2
.formula U|xmsg = F|formatstr(U|xmsg, U|xmsgparam1, U|xmsgparam2, U|xmsgparam3)               ? U|xmsgpcnt = 3
.formula U|xmsg = F|formatstr(U|xmsg, U|xmsgparam1, U|xmsgparam2, U|xmsgparam3, U|xmsgparam4) ? U|xmsgpcnt = 4
.continue OUT
..
..*****************************************************************************
!OUT
..*****************************************************************************
.continue E1 ? U|xerrmsg
.continue W
!W
.box 'U|msg0'
'U|xmsg'
.continue END
..
!E1
.error 'U|xmsg'
.end 1 ? _U|xerrcont
..
..*****************************************************************************
!END
..*****************************************************************************
.copy U|xerrmsg   = G|TRUE
.copy U|xerrcont  = G|FALSE
.formula   U|xmsgno    = 0
.formula   U|xmsgpcnt  = 0
.continue

