..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.VJ
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Sets the values for the previous period (index 2).
..                  The following period has index 1.
..*****************************************************************************
..
.set trans -
..
.copy M|jahr2   = F|prevfy(M|jahr1)
.copy M|von2    = M|von1
.copy M|bis2    = M|bis1
.copy M|adatum2 = F|fystartdate(M|jahr2, M|von2)
.copy M|edatum2 = F|fyenddate(M|jahr2, M|bis2)
.formula   M|von2    = F|getfm(M|adatum2)
.formula   M|bis2    = F|getfm(M|edatum2, F|fycmp(G|abgjahr, M|jahr2) = 0)
.copy M|maxperiod = 2
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
