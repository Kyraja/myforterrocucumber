..!interpreter english translate noabbrev
..*****************************************************************************
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Insert cash plan row
.. include fb/LIQPLAN.ROW.INSERT
..*****************************************************************************
..
.set trans -
..
..*****************************************************************************
!FINDROW: Find already existing row
..*****************************************************************************
.. we have to implement special treatment for "(EmptyEntry)" because the selection assumes (EmptyEntry) means "I do not care"
.formula U|xtselect = F|formatstr("$,tpositions=={1};tekvk=={2};tbaumstufe=={3}", U|xttype, F|condexpr(F|empty(U|xepurchsales), "`", U|xepurchsales), U|xitreelevel)
.formula U|xtselect = U|xtselect + ";tic==1" ?  U|xbintercompany
.formula U|xtselect = U|xtselect + ";tic==0" ? _U|xbintercompany
.. we have to implement special treatment for "(EmptyEntry)" because the selection assumes (EmptyEntry) means "I do not care"
.formula U|xtselect = U|xtselect + ";tkategorie==" + F|condexpr(F|empty(U|xcategory), "`", U|xcategory)
.select screen line 'U|xtselect'
.continue FINDPOS ? _G|mehr
.continue END
..
..*****************************************************************************
!FINDPOS: Find insert position for new row
..*****************************************************************************
.. we have to implement special treatment for "(EmptyEntry)" because the selection assumes (EmptyEntry) means "I do not care"
.formula U|xtselect = F|formatstr("$,tpositions=={1};tekvk=={2}", U|xttype, F|condexpr(F|empty(U|xepurchsales), "`", U|xepurchsales))
.select screen line 'U|xtselect'
.copy U|xschemapos = M|tschemapos
.select screen line 'F|formatstr("$,tschemapos<={1};tbaumstufe<={2};@ordnung=zn.r;@maxtreffer=1", U|xschemapos, U|xitreelevel)' ? G|evtzeile = 0
.select screen line 'F|formatstr("$,tschemapos<={1};tbaumstufe<={2};tic=={3};@ordnung=zn.r;@maxtreffer=1", U|xschemapos, U|xitreelevel, U|xbintercompany)' ? G|evtzeile > 0
.copy U|xschemapos   = M|tschemapos 
.copy U|xepurchsales = M|tekvk
.copy U|xttype       = M|tposition
.copy U|xitype       = M|tdatentyp
.copy U|xbrowsum     = M|tsummierbar
.copy U|xbcatpossible= M|tkatmoeglich
.copy U|xbicpossible = M|ticmoeglich
.formula U|xtcolor   = M|tfarbe
.input "fb/LIQPLAN.ROW.INSERT"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
