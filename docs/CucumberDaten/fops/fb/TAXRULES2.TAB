..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TAXRULES2.TAB
.. Author         : ankn
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Table FOP of the Infosystem fb/TAXRULES2
..*****************************************************************************
..
.set trans -
..
.type text U|xtselect2 ? _F|defined(xtselect2)
..
.copy M|tvrgstrgl = H|vrgstrgl
.formula M|tstrgl = H|strgl^id
.copy M|tustart   = H|strgl^ustart
.copy M|tsts      = H|strgl^sts
.copy M|tlaart    = H|strgl^stlaart
.copy M|tzmart    = H|strgl^zmart
.copy M|tev       = H|strgl^ev
..
.load 2 'G|hdatname58' 'F|formatstr("$,kopf=={1};@gruppe=15", H|strgl^id)'
..
..*****************************************************************************
!LOOP1
..*****************************************************************************
.continue SELECT2 ? _G|mehr
.copy M|tktoustpos = 2|ktoustpos ? (2|gvon < M|datum) & (M|datum < 2|gbis)
.load 2 continue
.continue SELECT2 ? _G|mehr
.continue LOOP1
..
..*****************************************************************************
!SELECT2
..*****************************************************************************
.formula M|tktostrgl = H|kopf^id
.formula U|xtselect2 = "$,"
.formula U|xtselect2 = U|xtselect2 + ";vrgstrgl=" + M|tvrgstrgl^id
.load 1 processtaxrule 'U|xtselect2'
.continue NODESTAT ? _G|mehr
.copy    M|tvorhanden = G|true ? _F|empty(1|vrgstrgl)
..
..*****************************************************************************
!NODESTAT
..*****************************************************************************
.load 0 account 'F|formatstr("$,ktostrgl={1};@maxtreffer=1", M|tktostrgl^id)'
.formula M|tbaumstat  = "-"    ? _G|mehr
.formula M|tbaumstat  = "+"    ?  G|mehr
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
