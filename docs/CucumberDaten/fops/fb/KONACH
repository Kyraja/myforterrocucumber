.set trans +
..                           SUBROUTINE
..                           ----------
.input "ARB"
..
..  Gesellschaftsform holen
..  neu: aus FIRMA BETR -> xtgesf
..  alt: aus MAND.INI   -> gform
.input FIRMA.BETR
.type integer gform
.input MAND.INI
..
.type text xko1:8 xko2:8 xsko1:8 xsko2:8
.select company "$,gruppe=7;@gruppe=7"
.formula xko1  =  verb
.formula xko2  =  ford
.formula xsko1 =  sverb
.formula xsko2 =  sford
.select
..*****************************************************************************
..  xybmit = true  -> mit EXCEL
..  xybmit = false -> ohne EXCEL
.type bool xybmit
.type integer  xwastun xips xii xih1 xih2
.type text xtips xdatei:1 xtger:15 xwahl:1 xytlgp xtskip:8 xtfkt:15 xtexcel:15
.type text xl:3 xlg:3 xlg1:3 xlg2:3
.formula xdatei  = "S"
.formula xtfkt   = xarb + "BILKON.HOL"
.formula xtexcel = xarb + "BILKON.EXCEL"
.formula xtkotab = xarb + "KOTAB"
..
.. Die Varialble xnachweis wird in den beiden Programmen BILANZ und KONACH
.. verwendet, um zu einscheiden, ob die Verkehrszahlen
..    - detailiert (fÅr Kontennachweis fb/KONACH, xnachweis=ja)
..    - gesammelt  (fÅr Bilanz fb/BILANZ, xnachweis=nein)
.. ausgegeben werden sollen.
.type bool xnachweis
.formula xnachweis = TRUE
.. Die Variable xbsldnull wird in KONACH verwendet um zu entscheiden, ob
.. Konten mit Null-Saldo ausgegeben werden sollen, oder nicht.
.formula xbsldnull = false
.. *** WAEHRUNG ***
.input WAEHRUNG.INI
.formula x = auswaehr
.. *** WAEHRUNG - Ende ***
..
!G1
.input DRUCKER1
.formula xtger = geraet
.formula xtger = "Bildschirm"  ?  geraet = ""
..
!M0
.output terminal
.input BILD.F
.up
.set thoussep
.set decpoint
..
                                 Kontennachweis

.menu AuswÑhlen
Alle Konten                                      >>  .formula xwahl = "A"
Bilanzkonten                                     >>  .formula xwahl = "B"
Aktivseite - Bilanzkonten                        >>  .formula xwahl = "C"
Passivseite - Bilanzkonten                       >>  .formula xwahl = "D"
GuV-Konten                                       >>  .formula xwahl = "E"
Wechsel des Ausgabemediums: 'xtger             ' >>  .continue G1
BuchungswÑhrung, z.Zt. 'xxbuwaehr '              >>  .continue WAEHR
AusgabewÑhrung,  z.Zt. 'auswaehr '               >>  .continue AWAEHR
Ausgabe der Konten mit Null-Saldo: 'xbsldnull  ' >>  .continue SLDNULL
Beenden                                          >>  .continue BEENDEN
..
.continue BEENDEN  ?  F|empty(G|menue)
.input BILKON.ABFR
.continue M0       ?  xwastun = 99
..
.input BILKON.OBEN
.continue GV       ?  xwahl = "E"
..
.. Initialisierung der Variablen fÅr Gesellschaftsform
.formula xlg = ""
.formula xlg1 = ""
.formula xlg2 = ""
..
.continue BP       ?  xwahl = "D"
..
..  Aktiva
.formula xl  = "ba"
.formula xlg = "bap"  ?  gform = 1  ;  xtgesf = "P"
.formula xlg = "bak"  ?  gform = 2  ;  xtgesf = "K"
.input 'xtfkt'
.output terminal ...    ?  geraet = ""  &  xwahl = "C"
.page
.input 'xtexcel'   ?  xwahl = "C"  &  xybmit
.continue M0       ?  xwahl = "C"
..
!BP: Passiva
.formula xl  = "bp"
.formula xlg = "bpp"  ?  gform = 1  ;  xtgesf = "P"
.formula xlg = "bpk"  ?  gform = 2  ;  xtgesf = "K"
.input 'xtfkt'
.output terminal ...    ?  geraet = ""  &  (xwahl = "D"  ;  xwahl = "B")
.page
.input 'xtexcel'   ? (xwahl = "D"  ;  xwahl = "B") &  xybmit
.continue M0       ?  xwahl = "D"  ;  xwahl = "B"
..
!GV: GuV
.formula xl  = "gv"
.formula xlg = "gv"
.input 'xtfkt'
.output terminal ...    ?  geraet = ""
.page
.input 'xtexcel'   ?  xybmit
.continue M0
..
..
.. *** WAEHRUNG ***
!WAEHR: BuchungswÑhrung bestimmen
.input VBUWAEHRUNG
.continue M0
..
!AWAEHR: AusgabewÑhrung fÅr Endsaldo bestimmen
.input AUSWAEHRUNG
.formula x = auswaehr
.continue M0
.. *** WAEHRUNG - Ende ***
..
!SLDNULL
.formula xbsldnull = _xbsldnull
.continue M0
..
!BEENDEN
.end .
