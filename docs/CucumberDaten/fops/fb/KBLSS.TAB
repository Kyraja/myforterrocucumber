..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : KBLSS.TAB
..  Datum          : 17.10.2005
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Tabellen-FOP des Infosystems KBLSS
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  :
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
.type bool xbbebu                          ? _F|defined(U|xbbebu)
.type text xtsel                           ? _F|defined(U|xtsel)
..
..*****************************************************************************
..
.set trans -
..
.formula U|xbbebu = H|ssum <> 0.00 ; H|hsum <> 0.00
..
.continue ARANGE ? H|dnr = 68
..
..*****************************************************************************
!ACCOUNT: Account
..*****************************************************************************
.continue END ? M|nonull & (H|esaldo = 0.00 & H|asaldo = 0.00 & _U|xbbebu)
.make screen line +O
.assign M|tkonto = H|id
.assign M|tobjekt = H|id
.formula M|tstufe    = U|xistufe
.formula M|tasaldo   = H|asaldo
.formula M|tesaldo   = H|esaldo
.formula M|tvkzsoll  = H|ssum
.formula M|tvkzhaben = H|hsum
.formula M|tverd     = _H|bu    ? F|defined(H|bu)
.formula M|tbebu     = U|xbbebu
.colour -background 'U|xabasgrouplight'  'M|aktzeile'
.continue END ? _M|inklkredit
.assign M|tbuwaehr = M|buwaehr^id
.. Kreditlinie wird geholt, Anzeige nur im Dashboard
.formula U|xtsel = "$,,nummer=;such=;bkonto="+'M|tkonto^id'+";"
.load 1 group "66:9" 'U|xtsel'
.continue END ? _G|mehr
..nur die erste Kreditlinie wird pro Konto ausgewertet
!NXTLINE
.load 1 line
.continue END ? _G|mehr
.continue NXTLINE ? G|datum > 1|bisdat
.continue NXTLINE ? G|datum < 1|vondat
.continue NXTLINE ? _F|equals(M|buwaehr,1|twaehr)
..hier gltige Kreditlinienzeile
.formula M|kreditbetr = 1|kreditbetr
.continue END
..
..*****************************************************************************
!ARANGE: Account range
..*****************************************************************************
.continue END ? M|nonull & (H|kbesaldo = 0.00 & H|kbasaldo = 0.00 & _U|xbbebu)
.make screen line +O
.assign M|tkbereich = H|id
.assign M|tobjekt = H|id
.formula M|tstufe    = U|xistufe
.formula M|tasaldo   = H|kbasaldo
.formula M|tesaldo   = H|kbesaldo
..
.. Debit (A90)
.formula H|reregeln2 = "(6)"
.formula M|tvkzsoll  = H|kbesaldo
..
.. Credit (A90)
.formula H|reregeln2 = "(7)"
.formula M|tvkzhaben = H|kbesaldo
..
.formula M|tverd     = G|true
.formula M|tbebu     = U|xbbebu
.colour -background 'U|xabasgroupdark'  'M|aktzeile'
.continue END
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue

