..!interpreter english translate noabbrev
.continue OUT
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.WRITE
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       :
.. Functionality  :
.. include fb/CASHMGMT.SELECT.DATE2PERIOD
..*****************************************************************************
..
.. Puffer 0 muss den Bewegungsdatensatz (Offener Posten, EK/VK-Position) und Puffer 1 den Stammdatensatz enthalten (Konto)
..
.set trans -
..
..*****************************************************************************
!OUT
..*****************************************************************************
.input "fb/CASHMGMT.SELECT.DATE2PERIOD"
.. relevant?
.continue ? U|xiperiod = -1
.continue ? U|xrvalue  = 0
.formula   U|xrvalue = -U|xrvalue ? U|xepurchsales = "(Purchasing)"
..                          Typ #       Intercompany #     Kategorie #            EK/VK #      Periode #      Betrag #
.println -lfsuppress 'U|xttype' # 'U|xbintercompany' # 'U|xcategory' # 'U|xepurchsales' # 'U|xiperiod' # 'U|xrvalue' #
..                # Beleg-ID # Beleg-DNR # Beleg-Gruppe #
.println -lfsuppress '0|id' # '0|dnr' # '0|gruppe' # ?  F|defined(0|id)
.println -lfsuppress  # # # ? _F|defined(0|id)
..                 Konto-ID # Konto-DNR # Konto-Gruppe #
.println -lfsuppress '1|id' # '1|dnr' # '1|gruppe' # ?  F|defined(1|id)
.println -lfsuppress  # # # ? _F|defined(1|id)
..             Termin #      Belegdatum #    ZBedingung #  Skontosatz    #        Skonto  #
.println 'U|xddate:8' # 'U|xddocdate:8' # 'U|xpzbed^id' # 'U|xrdiscrate' # 'U|xrdiscount' #
.continue

