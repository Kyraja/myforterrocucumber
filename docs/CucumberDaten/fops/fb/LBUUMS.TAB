..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : LBUUMS.TAB
..  Autor          : hc
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Infosystem, Liste Buchungen, Tabellenzeigfop
..*****************************************************************************
..
.type ID6  xabu    ? _F|defined(U|xabu)
.type VPK0 xpkonto ? _F|defined(U|xpkonto)
.type text xtsel   ? _F|defined(U|xtsel)
..
..*****************************************************************************
.set trans -
.continue ARANGE  ? M|datnr = 68
.continue HOL0
..
..*****************************************************************************
!ARANGE
..*****************************************************************************
.load 0 line
.continue END     ? _G|mehr
.continue ARANGE  ?  F|empty(0|konto)
.select add 0|konto
.continue HOL0
..
..*****************************************************************************
!HOL0
..*****************************************************************************
.assign U|xpkonto = H|id
.formula U|xabu  = "(0,0,0)"
.formula U|xtsel = "$,konto=" + H|id
.formula U|xtsel = U|xtsel + ";iwbu=" + M|buwaehr^id
.formula U|xtsel = U|xtsel + ";@zeilen=(1);@gruppe=0;gruppe=0"
.formula U|xtsel = U|xtsel + ";gjahr=" + 'M|anfj' + "!" + 'M|endj'
.formula U|xtsel = U|xtsel + ";budat=" + 'M|von'  + "!" + 'M|bis'
.formula U|xtsel = U|xtsel + ";inbukreis" + 'M|bukreis^bknr' + "=true"
.formula U|xtsel = U|xtsel + ";monat=" + 'M|anfm' + "!"                ? M|anfj = M|endj
.formula U|xtsel = U|xtsel + 'M|endm'                                  ? M|endm > 12 & M|anfj = M|endj
.formula U|xtsel = U|xtsel + ";@ordnung=nummer." + 'M|richtung(L=":")'
..
..*****************************************************************************
!HOL1:
..*****************************************************************************
.load 1 acctrnsact 'U|xtsel' ? _F|empty(U|xtsel)
.load 1 continue            ?  F|empty(U|xtsel)
.formula U|xtsel = ""
.continue NEXT0 ? _G|mehr
.continue HOL1  ?  U|xabu = 1|id
.continue HOL1  ? _1|konsol & 'M|konsol(L="0")' = "(107)"
.continue HOL1  ?  1|konsol & 'M|konsol(L="0")' = "(110)"
.formula U|xabu = 1|id
..
..*****************************************************************************
!BUZ
..*****************************************************************************
.load 1 line
.continue HOL1 ? _G|mehr
.continue BUZ  ?  1|konto^dnr <> 5
.continue BUZ  ? _1|konto^umsatz
..
.make screen line +O
.formula   M|tbaumstufe = 0|stufe ? M|datnr = 68
.assign M|bereich = U|xpkonto^id
.copy M|konto   = 1|konto
.formula   M|soll    = 1|betrag ?  1|soll
.formula   M|haben   = 1|betrag ? _1|soll
.copy M|budat   = 1|budat
.formula   M|beleg   = 1|beleg
.assign M|belverw = 1|vkekre^id
.copy M|beldat  = 1|beldat
.formula   M|bunum   = 1|id
.formula   M|text    = 1|text
.copy M|steuer  = 1|steuer ?  H|gruppe = 0
.copy M|tstrgl  = 1|strgl  ? H|gruppe = 0
..
.formula M|habensum = M|habensum +  M|haben
.formula M|sollsum  = M|sollsum  +  M|soll
.formula M|bewegsaldo = M|sollsum - M|habensum
.formula M|umsatz   = M|umsatz   + (M|soll  - M|haben) ? (U|xpkonto^dnr = 1) ; (U|xpkonto^dnr = 11)
.formula M|umsatz   = M|umsatz   + (M|haben - M|soll)  ? (U|xpkonto^dnr = 0)
.continue BUZ
..
..*****************************************************************************
!NEXT0:
..*****************************************************************************
.continue ARANGE     ? M|datnr = 68
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
