..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : fb/KBFPRUEF.SET.ERRORCOUNT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Setzt die Fehlerdaten in der Tabelle
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.type integer xifehler
..
!S1
.formula U|xifehler = 1
..
!L0
.continue S2 ? U|xifehler > 8
.formula M|fzaehl.U|xifehler = 0
.formula U|xifehler = U|xifehler + 1
.continue L0
..
!S2
.select screen header
..
!L1
.select screen line
.continue END ? _G|mehr
.formula M|tfehleranz = 0
.formula M|tfehler = ""
.formula U|xifehler = 1
!L2
.continue L1 ?  U|xifehler > 8
.continue N2 ? _M|tfehler.U|xifehler
.formula M|fzaehl.U|xifehler = M|fzaehl.U|xifehler + 1
.formula M|tfehleranz = M|tfehleranz + 1
.formula M|tfehler = F|condexpr(F|empty(M|tfehler), F|tostring(U|xifehler), M|tfehler + ", " + F|tostring(U|xifehler))
!N2
.formula U|xifehler = U|xifehler + 1
.continue L2
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
