..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KASBEA.EV
..  Autor          : uo
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Kassenbuch Einnahmen-/Ausgaben allgemeines Event-FOP
..*****************************************************************************
..
.type text xtselect
..
..*****************************************************************************
.set trans -
.input "is/TABLEEREN"
..
.. handle header events
.continue START   ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue PERIOD  ? G|evtvar = "anfj"
.continue PERIOD  ? G|evtvar = "endj"
.continue PERIOD  ? G|evtvar = "anfm"
.continue PERIOD  ? G|evtvar = "endm"
.continue PERIOD  ? G|evtvar = "von"
.continue PERIOD  ? G|evtvar = "bis"
.continue ERR01   ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "waehr" & +M|waehr = 0
.continue END
..
..*****************************************************************************
!PERIOD: period changed
..*****************************************************************************
.input "fb/IS.SETPERIOD"
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!START: Starts the selection
..*****************************************************************************
..
.continue ERR02 ? +M|kasskto = 0
..
.formula U|xtselect  = "$,gruppe=1;@gruppe=1"
.formula U|xtselect  = U|xtselect + ";waehr=" + 'M|waehr^id'
.formula U|xtselect  = U|xtselect + ";kasskto=" + M|kasskto^id
.formula U|xtselect  = U|xtselect + ";gj=" + 'M|anfj'  + "!" + 'M|endj'
.formula U|xtselect  = U|xtselect + ";@gruppe=1;@ordnung=waehr,kasskto,gj,gm,nim,isgebucht"
..
.formula M|select  = U|xtselect
.formula M|grp     = 2
..
.type integer xicount
.formula U|xicount = 0
..
.input "is/HOL.LISTE"
..
.continue WARN01 ? U|xicount = 0
..
.continue END
..*****************************************************************************
!HOLKD
..*****************************************************************************
.input "is/TABLEEREN"
.formula M|kasskto =""
.formula M|kasskto = M|casher^kasskto  ?  _M|casher = ""
..
.formula M|waehr = ""
.formula M|waehr = M|casher^waehr        ?  _M|casher = ""
..
.formula M|select = M|casher
..
..*****************************************************************************
!WARN01: No casher objects found
..*****************************************************************************
.note Kein passendes Kassenbuch gefunden.
.end 0
..
..*****************************************************************************
!ERR01: No currency given
..*****************************************************************************
.error Bitte eine Waehrung angeben.
.cursor waehr
.end 1
..
..*****************************************************************************
!ERR02: No account given
..*****************************************************************************
.error Bitte ein Kassenkonto angeben.
.cursor kasskto
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
