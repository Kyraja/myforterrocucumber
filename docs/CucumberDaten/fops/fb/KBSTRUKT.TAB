..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KBSTRUKT.TAB
..  Datum          : 06.06.2005
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Tabellenzeig-FOP des Infosystems fb/KBSTRUKT
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  :
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
.type bool xbisform ? _F|defined(U|xbisform)
..
..
..*****************************************************************************
..
.set trans -
..
.continue ACCOUNT ? H|dnr = 5 ; H|dnr = 0 ; H|dnr = 1 ; H|dnr = 11
.continue AR      ? H|dnr = 68
.continue END
..
..*****************************************************************************
!ACCOUNT
..*****************************************************************************
.make screen line +O
.formula  M|tbaumstufe = U|xistufe
.assign M|tkonto    = H|id
.copy M|tkbereich = U|xpaccr
.input "fb/KBSTRUKT.TAB2"
.continue END
..
..*****************************************************************************
!AR
..*****************************************************************************
.make screen line +O
.assign M|tkbereich  = H|id
.formula   M|tbaumstufe = U|xistufe
.type integer xihilf ? _F|defined(U|xihilf)
.formula   U|xihilf = M|tbaumstufe + 1
.type P68:1.3.9 xpaccr.xihilf ? _F|defined(U|xpaccr.U|xihilf)
.copy U|xpaccr.U|xihilf = M|tkbereich
.formula   M|tclosed       = U|xbclosed
.input "fb/KBSTRUKT.TAB2"
.continue END ? M|tclosed
..
.load 8 accrange 'F|expr("$,@zeilen=ja;@gruppe=" + F|tostring(F|eval(H|gruppe + 16)) + ";id=" + F|tostring(H|id))'
.continue END ? _G|mehr
..
..*****************************************************************************
!ARLOOP
..*****************************************************************************
.load 8 line
.continue END  ? _G|mehr
.make screen line +O
.formula   M|tbaumstufe = U|xistufe + 8|stufe
.copy M|tkbereich  = 8|kbereich
.copy M|tkonto     = 8|konto
.copy M|tkoobjber  = 8|koobjber
.copy M|tkoobj     = 8|koobj
.copy M|tclosed    = 8|closed
.input "fb/KBSTRUKT.TAB2"
.continue C1 ? F|empty(M|tkbereich)
.type integer xihilf ? _F|defined(U|xihilf)
.formula   U|xihilf = M|tbaumstufe + 1
.type P68:1.3.9 xpaccr.xihilf ? _F|defined(U|xpaccr.U|xihilf)
.copy U|xpaccr.U|xihilf = M|tkbereich
!C1
.copy M|tkbereich = U|xpaccr.tbaumstufe ? F|defined(U|xpaccr.tbaumstufe) & F|empty(M|tkbereich)
.continue ARLOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
