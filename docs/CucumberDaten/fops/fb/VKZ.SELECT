..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.SELECT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Selects the customers, suppliers and employees
..
.. include fb/VKZ.OUT
..
..*****************************************************************************
..
.set trans -
..
.type ID5:1 xpverd
.type text xtempname
.file -tempname U|xtempname
..
.input "DATEI.F"
..
.output new 'U|xtempname'

.continue ACRGE ? _F|empty(M|pkber)
..
.formula M|select0  = F|formatstr("$,@numsuch={1}!{2};gruppe={3};@gruppe={3}", M|bervon, M|berbis, 1) ? _M|selectcheck0
.formula M|select1  = F|formatstr("$,@numsuch={1}!{2};gruppe={3};@gruppe={3}", M|bervon, M|berbis, 1) ? _M|selectcheck1
.formula M|select11 = F|formatstr("$,@numsuch={1}!{2};gruppe={3};@gruppe={3}", M|bervon, M|berbis, 1) ? _M|selectcheck11
..*****************************************************************************
!CUST
..*****************************************************************************
.continue SUPPL ? _M|kunden
.select customer 'M|select0'
..*****************************************************************************
!L1
..*****************************************************************************
.continue SUPPL ? _G|mehr
.input "fb/VKZ.OUT"
.select continue
.continue L1
..
..*****************************************************************************
!SUPPL
..*****************************************************************************
.continue EMPLO ? _M|lieferanten
.select supplier 'M|select1'
..*****************************************************************************
!L2
..*****************************************************************************
.continue EMPLO ? _G|mehr
.input "fb/VKZ.OUT"
.select continue
.continue L2
..
..*****************************************************************************
!EMPLO
..*****************************************************************************
.continue SORT ? _M|mitarbeiter
.select employee 'M|select11'
..*****************************************************************************
!L3
..*****************************************************************************
.continue SORT ? _G|mehr
.input "fb/VKZ.OUT"
.select continue
.continue L3
..
..*****************************************************************************
!ACRGE: Use account range
..*****************************************************************************
.load 1 accrange 'F|formatstr("$,id={1};@gruppe={2};@zeilen={3}", M|pkber^id, M|pkber^gruppe+16, G|TRUE)'
.continue FOOTER ? _G|mehr
..*****************************************************************************
!L4
..*****************************************************************************
.load 1 line
.continue SORT ? _G|mehr
.continue L4 ? F|empty(1|konto)
.select add 1|konto
.input "fb/VKZ.OUT"
.continue L4
..
..*****************************************************************************
!SORT
..*****************************************************************************
.output terminal
.continue SORT1 ? M|grpnachstaat
.continue SORT2 ? M|grpnachverd
.continue HEADER
!SORT1: sort by country
.system 'F|formatstr("sort -k4,4 -k5,5 -k2,2n -k3,3 -t# -o {1} {1}", F|tostring(U|xtempname))' background
.end 1 ? _G|mehr
.continue HEADER
!SORT2: sort by consolidation account
.system 'F|formatstr("sort -k6,6n -k7,7 -k2,2n -k3,3 -t# -o {1} {1}", F|tostring(U|xtempname))' background
.end 1 ? _G|mehr
.continue HEADER
..*****************************************************************************
!HEADER
..*****************************************************************************
.select
.type text xtdummy
.type VP0  xpaccount
.input 'M|bkopf'
..*****************************************************************************
!LOOP
..*****************************************************************************
.select from 'U|xtempname' U|xpaccount # U|xtdummy^
.continue FOOTER ? _G|mehr
.select add U|xpaccount
.input 'M|tab'
.continue LOOP
..*****************************************************************************
!FOOTER
..*****************************************************************************
.input 'M|bfuss'
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
