..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VATENTRIES.SCRCTX
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Set visibility flags
..*****************************************************************************
..
.set trans -
..
.copy M|summen = G|FALSE
.copy M|summen = G|TRUE ? M|kontogrp > 0 ; M|ustvagrp > 0 ; M|steuergrp > 0 ; M|ustartgrp > 0 ; M|buwaehrgrp > 0
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = P|maskkontextfop + " WITH_ENTRIES"         ? _M|summen
.formula P|maskkontextfop = P|maskkontextfop + " WITH_ACCOUNTS"        ? _M|summen ; M|kontogrp  > 0 ; _F|empty(M|konto)
.formula P|maskkontextfop = P|maskkontextfop + " WITH_VAT_ITEMS"       ? _M|summen ; M|ustvagrp  > 0 ; _F|empty(M|ustva)
.formula P|maskkontextfop = P|maskkontextfop + " WITH_VAT_ENTRY_TYPES" ? _M|summen ; M|ustartgrp > 0 ; _F|empty(M|ustart)
.formula P|maskkontextfop = P|maskkontextfop + " WITH_TAXCODES"        ? _M|summen ; M|steuergrp > 0 ; _F|empty(M|steuer)
.formula P|maskkontextfop = P|maskkontextfop + " WITH_ENTRY_COUNT"     ?  M|summen
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

