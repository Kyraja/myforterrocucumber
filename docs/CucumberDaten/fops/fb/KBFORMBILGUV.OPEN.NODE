..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.OPEN.NODE
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : FOP zum Oeffnen eines Baumknotens
.. Functionality  : FOP for opening a tree node
..*****************************************************************************
..
.set trans -
..
.type integer xrowlevel
.type integer xiklapp
..
.formula U|xiklapp = M|tbaumstufe + 1
..
.formula M|tmpdatname = M|datafile + ".TMP"
.input "DATEI.F"
..
.type text xxtsys
.formula U|xxtsys = "look " + M|trowid + "- " + M|datafile + " | egrep " + G|dblquote + "^" + M|trowid + "-[0-9]{9}#" + G|dblquote + " > " + M|tmpdatname
.system 'U|xxtsys' background
.continue END ? _G|mehr
..
..*****************************************************************************
!L
..*****************************************************************************
.input "fb/KBFORMBILGUV.INSERT.ROW"
.continue EL ? U|reachedeof
.continue L
..
..*****************************************************************************
!EL
..*****************************************************************************
.input "fb/KBFORMBILGUV.AFTER.INSERT"
.input "fb/KBFORMBILGUV.SET.COLORS"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

