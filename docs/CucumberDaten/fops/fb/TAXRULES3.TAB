..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TAXRULES3.TAB
.. Author         : rowa
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Table FOP of the Infosystem fb/TAXRULES3
..*****************************************************************************
..
.set trans -
..
!TAB
..*****************************************************************************
.formula M|tkonto = H|id
.copy M|tvrgstrgl  = 3|vrgstrgl
.copy M|tstrgl     = 3|strgl
.copy M|tsts       = M|tstrgl^sts
.copy M|tev        = M|tstrgl^ev
.copy M|tstlaart   = M|tstrgl^stlaart
.copy M|tstzmart   = 3|zmart
.copy M|tustart    = 3|strgl^ustart
.copy M|tktoustpos = 4|ktoustpos ? (4|gvon < M|datum) & (M|datum < 4|gbis)
.continue LOAD4 ? F|empty(M|ktoustpos)
.continue END
..
..*****************************************************************************
!LOAD4:
..*****************************************************************************
.load 4 continue
.continue LOOP1 ? _G|mehr
..
..*****************************************************************************
!LOOP1
..*****************************************************************************
.load 3 continue
.continue END ? _G|mehr
.load 4 'G|hdatname58' 'F|formatstr("$,kopf=={1};@gruppe=15", 3|strgl^id)'
.continue END ? _G|mehr
.make screen line +O
.continue TAB
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
