..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFPRUEF.SET.COLORS
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Setzen der Farben im Infosystem fb/KBFPRUEF
.. Functionality  : Set in colors in the Infosystem fb/KBFPRUEF
..*****************************************************************************
..
.set trans -
..
.continue END ? G|edp ; G|batchmode
..
.input "is/ABASFARBEN.DEF"
..
.type text xterrcolor
.formula U|xterrcolor = U|xabasmidred

.select screen header
.colour -background 'F|condexpr(M|fzaehl1 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl1
.colour -background 'F|condexpr(M|fzaehl2 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl2
.colour -background 'F|condexpr(M|fzaehl3 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl3
.colour -background 'F|condexpr(M|fzaehl4 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl4
.colour -background 'F|condexpr(M|fzaehl5 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl5
.colour -background 'F|condexpr(M|fzaehl6 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl6
.colour -background 'F|condexpr(M|fzaehl7 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl7
.colour -background 'F|condexpr(M|fzaehl8 > 0, U|xterrcolor, "-1 -1 -1")' fzaehl8
..
!L
.select screen line
.continue END ? _G|mehr
.colour -background 'F|condexpr(M|tfehleranz > 0, U|xterrcolor, "-1 -1 -1")' tobjekt 'M|aktzeile'
.colour -background 'F|condexpr(M|tfehleranz > 0, U|xterrcolor, "-1 -1 -1")' tfehler 'M|aktzeile'
.continue L
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
