..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.BLBU.BV
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Infosystem fb/LBU aufrufen
.. Functionality  : Call Infosystem fb/LBU
..*****************************************************************************
..
.set trans -
..
.. the following is not possible
.continue ERR0 ? _F|empty(M|tkoobjber) & F|empty(M|tkoobj)
.continue ERR0 ?  M|knum^dnr = 60 & M|knum^gruppe=2
..
.type text xtsys     ? _F|defined(U|xtsys)
.type integer  xizraum   ? _F|defined(U|xizraum)
..
.assign U|xizraum = F|regreplaceall(F|expr(G|evtvar), "^[^0-9]+", "")
.continue END ? _G|mehr
..
.continue END ? F|empty(M|jahr.U|xizraum) ; F|empty(M|amon.U|xizraum) ; F|empty(M|emon.U|xizraum)
..
.formula U|xtsys = 'G|kkomname38' + " LBU ? "    ? 'M|reregeln(L="0")' <> "(9)"
.formula U|xtsys = 'G|kkomname38' + " LBUUMS ? " ? 'M|reregeln(L="0")'  = "(9)"
.formula U|xtsys = U|xtsys + "von="     + 'M|adatum.U|xizraum'        + "|"
.formula U|xtsys = U|xtsys + "anfm="    + 'M|amon.U|xizraum'          + "|"
.formula U|xtsys = U|xtsys + "anfj="    + 'M|jahr.U|xizraum'          + "|"
.formula U|xtsys = U|xtsys + "bis="     + 'M|edatum.U|xizraum'        + "|"
.formula U|xtsys = U|xtsys + "endm="    + 'M|emon.U|xizraum'          + "|"
.formula U|xtsys = U|xtsys + "endj="    + 'M|jahr.U|xizraum'          + "|"
..
.formula U|xtsys = U|xtsys + "buwaehr=" + 'M|buwaehr^id'            + "|"
..
.continue NOTDEF ? _F|defined(M|bukreis.U|xizraum)
.continue NOTDEF ?  F|empty(M|bukreis.U|xizraum)
..
.formula U|xtsys = U|xtsys + "bukreis=" + 'M|bukreis.U|xizraum^id'    + "|"
.continue BKRSET
..
..*****************************************************************************
!NOTDEF
..*****************************************************************************
.formula U|xtsys = U|xtsys + "bukreis=" + 'M|bukreis^id'            + "|"
.continue BKRSET
..
..*****************************************************************************
!BKRSET
..*****************************************************************************
.formula U|xtsys = U|xtsys + "richtung=(0)"                         + "|"
..
.continue OKLBU  ? F|empty(M|kber)
..
.formula U|xtsys = U|xtsys + "vdn="     + 'M|kber^dnr'              + "|"
.formula U|xtsys = U|xtsys + "vgr="     + 'M|kber^gruppe'           + "|"
.formula U|xtsys = U|xtsys + "bevon="   + 'M|kber^nummer'           + "|"
.formula U|xtsys = U|xtsys + "bebis="   + 'M|kber^nummer'           + "|"
..
.continue OKLSYS
..
..*****************************************************************************
!OKLBU: Account in row
..*****************************************************************************
.formula U|xtsys = U|xtsys + "vdn="     + 'M|knum^dnr'              + "|"
.formula U|xtsys = U|xtsys + "vgr="     + 'M|knum^gruppe'           + "|"
.formula U|xtsys = U|xtsys + "bevon="   + 'M|knum^nummer'           + "|"
.formula U|xtsys = U|xtsys + "bebis="   + 'M|knum^nummer'           + "|"
.formula U|xtsys = U|xtsys + "kst="     + 'M|tkoobj^id'             + "|" ? _F|empty(M|tkoobj)
..
..*****************************************************************************
!OKLSYS: Execute infosystem command
..*****************************************************************************
.formula U|xtsys = U|xtsys + "bstart=1"
.command -parallel 'U|xtsys'
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
..
..*****************************************************************************
!ERR0: It is not possible to show the postings
..*****************************************************************************
.error Kein Buchungsnachweis m”glich.
.end 1
