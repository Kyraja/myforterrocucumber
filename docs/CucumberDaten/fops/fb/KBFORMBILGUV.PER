..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KBFORMBILGUV.PER
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Setzen der Zeitraeume in den Infosystemen
..                   fb/KBFORM, fb/BILANZ, fb/GUV, fb/GUVNACH, fb/BILANZNACH etc.
..  Functionality  : Sets the periods in the infosystems
..                   fb/KBFORM, fb/BILANZ, fb/GUV, fb/GUVNACH, fb/BILANZNACH etc.
..*****************************************************************************
..
.type text xtsel   ? _F|defined(U|xtsel)
.type integer  xirow   ? _F|defined(U|xirow)
.type integer  xizraum ? _F|defined(U|xizraum)
..
..*****************************************************************************
..
.set trans -
..
.formula U|xizraum = 1
..
.select company 'F|expr("$,@gruppe=12;gruppe=12;@zeilen=ja;gjahr=" + G|gjahr)'
.continue RESET ? _G|mehr ; H|selzeile < 1
..
.formula U|xirow = H|selzeile
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue RESET ? U|xirow < 1 ; U|xizraum > M|maxperiod
.select line 'U|xirow'
.select period 'H|gjanf' 'H|gjend'
.select year 'G|ajahr' 'G|amonat' 'G|gmonat' ? G|gmonat >= G|amonat
..
.formula M|jahr.U|xizraum   = G|ajahr
.formula M|amon.U|xizraum   = G|amonat
.formula M|emon.U|xizraum   = G|emonat
.formula M|adatum.U|xizraum = G|adatum
.formula M|edatum.U|xizraum = G|edatum
..
.formula U|xirow   = U|xirow - 1
.formula U|xizraum = U|xizraum + 1
.continue LOOP
..
..*****************************************************************************
!RESET: Reset periods not set
..*****************************************************************************
.continue END  ? U|xizraum > M|maxperiod
.formula M|jahr.U|xizraum   = ""
.formula M|amon.U|xizraum   = 0
.formula M|emon.U|xizraum   = 0
.formula M|adatum.U|xizraum = ""
.formula M|edatum.U|xizraum = ""
..
.formula U|xizraum = U|xizraum + 1
.continue RESET
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
