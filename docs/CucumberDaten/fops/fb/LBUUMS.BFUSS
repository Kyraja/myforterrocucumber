..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : LBUUMS.BFUSS
..  Datum          : 19.03.03
..  Autor          : utuerk
..  Verantwortlich : cl
..  Kontrolle      : mh
..
..  Funktion       : Infosystem, Liste Buchungen, Berichtsfuss
..
..*****************************************************************************
..
.set trans -
..
.continue END ? G|batchmode ; G|edp
..
.type VID0 xtbalt
.type integer  ximod
..
.input "is/ABASFARBEN.DEF"
..
.select screen header
..*****************************************************************************
!FARBE0: Hintergrundfarbe aendern
..*****************************************************************************
.select screen line
.continue END ? _G|mehr
.formula U|ximod = U|ximod + 1 ? U|xtbalt <> M|bereich^id
.colour -background 'F|condexpr(F|expr(U|ximod//2)=0, U|xabasgroupdark, U|xabasgrouplight)' 'M|aktzeile'
.formula U|xtbalt = M|bereich^id
.continue FARBE0
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
