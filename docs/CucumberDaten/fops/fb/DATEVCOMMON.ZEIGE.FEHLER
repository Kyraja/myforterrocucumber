..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVCOMMON.ZEIGE.FEHLER
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Ausgabe der vorhandenen Fehler
.. Functionality  :
..*****************************************************************************
..
.type text xtkat xtre xtmark
.type text xtsplit xtdelim
.type integer  xi
.type bool xbueber
..
..*****************************************************************************
..
.set trans -
..
.formula U|xtdelim = ";"
.continue START
..
..*****************************************************************************
!HEADL: Print headline
..*****************************************************************************
.output terminal
.input "DATEI.F"
..
.set trans +
Kategorie     Zeile          Objekt               Meldung
.set trans -
'F|string("=", 100)'
.formula U|xbueber = G|TRUE
.continue 'U|xtmark'
..
..*****************************************************************************
!START
..*****************************************************************************
.select screen header
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.select screen line
.continue END ? _G|mehr
.formula U|xtre = 'M|tgrpobjekt^dbez' + " " + 'M|tgrpobjekt^nummer'
..
!A1
.continue E1 ? F|empty(M|tdatfehler)
.formula U|xtmark = "B1"
.continue HEADL ? _U|xbueber
!B1
.set trans +
.formula U|xtkat   = "DATENFEHLER"
.set trans -
.formula U|xtsplit = M|tdatfehler
.input SPLITSTR
.formula U|xi = 1
!L1
.continue E1 ? U|xi > U|xispmax
'U|xtkat    ' 'M|aktzeile  ' 'U|xtre            ' 'U|xasplit.U|xi'
.formula U|xi = U|xi + 1
.continue L1
..
!E1
.continue A2
..
!A2
.continue E2 ? F|empty(M|texpfehler)
.formula U|xtmark = "B2"
.continue HEADL ? _U|xbueber
!B2
.set trans +
.formula U|xtkat   = "EXPORTFEHLER"
.set trans -
.formula U|xtsplit = M|texpfehler
.input SPLITSTR
.formula U|xi = 1
!L2
.continue E2 ? U|xi > U|xispmax
'U|xtkat    ' 'M|aktzeile  ' 'U|xtre            ' 'U|xasplit.U|xi'
.formula U|xi = U|xi + 1
.continue L2
..
!E2
.continue A3
..
!A3
.continue E3 ? F|empty(M|thinweise)
.formula U|xtmark = "B3"
.continue HEADL ? _U|xbueber
!B3
.set trans +
.formula U|xtkat   = "HINWEIS"
.set trans -
.formula U|xtsplit = M|thinweise
.input SPLITSTR
.formula U|xi = 1
!L3
.continue E3 ? U|xi > U|xispmax
'U|xtkat    ' 'M|aktzeile  ' 'U|xtre            ' 'U|xasplit.U|xi'
.formula U|xi = U|xi + 1
.continue L3
..
!E3
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
