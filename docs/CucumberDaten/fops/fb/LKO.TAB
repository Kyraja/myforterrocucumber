..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : LKO.TAB
..  Datum          : 23.03.2004
..  Version        : 2
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Tabellenzeig-FOP des Infosystems "LKO"
... Includes       :
..
..*****************************************************************************
.type A7 xeev      ? _F|defined(U|xeev)
.type A8 xelaart   ? _F|defined(U|xelaart)
..*****************************************************************************
.set trans -
.continue ACCRANGE  ? M|vdn = 68 & M|vgr = 1
.continue ARFORM    ? M|vdn = 68 & M|vgr = 2
.continue ACCOUNT   ? M|vdn = 5
.continue END
..
..*****************************************************************************
!ACCRANGE: Account range
..*****************************************************************************
.load 0 line
.continue END      ? _G|mehr
.continue ACCRANGE ? '0|konto' = ""
.select account '0|konto'
.continue ACCRANGE ? _G|mehr
.continue ACCOUNT
..
..*****************************************************************************
!ARFORM: Account range form
..*****************************************************************************
.load 0 line
.continue END     ? _G|mehr
.continue ARFORM  ? _('0|kbereich^gruppe' = "1")
.load 1 accrange 'F|expr("$,@gruppe=17;num68=" + F|tostring(0|kbereich))'
.continue ARFORM  ? _G|mehr
!ARFORM2
.load 1 line
.continue ARFORM  ? _G|mehr
.continue ARFORM2 ? '1|konto' = ""
.select account '1|konto^id'
.continue ARFORM2 ? _G|mehr
.continue ACCOUNT
..
..*****************************************************************************
!ACCOUNT: Account
..*****************************************************************************´
.type bool xbvalid ? _F|defined(U|xbvalid)
..
.formula U|xbvalid = G|true
.formula U|xbvalid = (U|xbvalid & (((H|bu) & (M|buchkto=G|true)) ; ((_H|bu) & (M|verdkto=G|true))))
.formula U|xbvalid = (U|xbvalid & (((H|gv) & (M|guvkto=G|true)) ; ((_H|gv) & (M|bilanzkto=G|true))))
.formula U|xbvalid = (U|xbvalid & (((H|umsatz) & (M|umsatzrel=G|true)) ; ((_H|umsatz) & (M|numsatzrel=G|true))))
.formula U|xbvalid = (U|xbvalid & (((H|oprel) & (M|oprel=G|true)) ; ((_H|oprel) & (M|noprel=G|true))))
.formula U|xbvalid = (U|xbvalid & (((H|kost) & (M|kost=G|true)) ; ((_H|kost) & (M|keinkost=G|true))))
.formula U|xbvalid = (U|xbvalid & (((H|hkost) & (M|hkost=G|true)) ; ((_H|hkost) & (M|keinhkost=G|true))))
.formula U|xbvalid = (U|xbvalid & (((H|kstelle = 'M|kstelle') & (M|kstelle <> "")) ; (M|kstelle = "")))
.formula U|xbvalid = (U|xbvalid & (((H|sts = M|steuer) & ('M|steuer' <> "")) ; ('M|steuer' = "") ; (('H|steuer' = "") & (M|steuer = "0"))))
.formula U|xelaart = H|strgl^id^stlaart
.formula U|xbvalid = (U|xbvalid & ((('U|xelaart' = 'M|laart') & ('M|laart' <> "")) ; ('M|laart' = "")))
.formula U|xeev    = H|eva
.formula U|xbvalid = (U|xbvalid & ((('U|xeev' = 'M|ekvk') & ('M|ekvk' <> "")) ; ('M|ekvk' = "")))
.formula U|xbvalid = (U|xbvalid & (((H|karta = M|kart) & ('M|kart' <> "")) ; ('M|kart' = "")))
.formula U|xbvalid = (U|xbvalid & (F|condexpr(F|empty(H|nameaspr), H|namebspr, H|nameaspr) / 'M|bez')) ? _F|empty(M|bez)
.formula U|xbvalid = (U|xbvalid & F|condexpr(F|empty(M|ustva), G|TRUE, M|ustva^id = H|strgl^zstrgl^ktoustpos^id))
.formula U|xbvalid = (U|xbvalid & (((H|ktostrgl^id = M|ktostrgl^id) & (_F|empty(M|ktostrgl))) ; (F|empty(M|ktostrgl))))
.continue OUTPUT ?  U|xbvalid
.continue FETCH  ? _U|xbvalid
..
..*****************************************************************************
!FETCH: Fetch next account depending on file
..*****************************************************************************
.continue ACCRANGE ? M|vdn = 68 & M|vgr = 1
.continue ARFORM2  ? M|vdn = 68 & M|vgr = 2
.continue          ? M|vdn = 5
..
..*****************************************************************************
!OUTPUT: get output channel
..*****************************************************************************
.make screen line +O ? G|mehr
.formula M|tnum     = H|id
.formula M|tbuchkto = H|bu
.formula M|tguvkto  = H|gv
.formula M|tumsatz  = H|umsatz
.copy M|tekvkkto = H|eva
.copy M|tsteuer  = H|sts
.copy M|tlaart   = H|strgl^id^stlaart
.copy M|tkart    = H|karta
.formula M|tsaldo         = H|saldo
.copy M|tktostrgl= H|ktostrgl
.copy M|tustva   = H|strgl^zstrgl^ktoustpos
.copy M|tvrgktotsch = H|vrgktotsch
.continue ACCRANGE ? M|vdn = 68 & M|vgr = 1
.continue ARFORM2  ? M|vdn = 68 & M|vgr = 2
.continue END
..
..*****************************************************************************
!END: end
..*****************************************************************************
.continue
