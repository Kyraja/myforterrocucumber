..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : LSS.ME
..  Datum          : 14.12.2009
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Infosystem, Summen und Saldenliste, Maskeneintritt
..*****************************************************************************
.set trans -
..
.formula M|vdn     = 5
.formula M|vgr     = 1
.input "is/DBCHOOSER"
.select year 'G|gjahr'
.formula M|jahr    = G|gjahr
.formula M|von     = G|amonat
.formula M|bis     = G|emonat
.formula M|adatum1 = G|adatum
.formula M|edatum1 = G|edatum
.formula M|nonull  = G|TRUE
.formula M|verd    = G|FALSE
.copy M|buwaehr  = G|inland
.copy M|auswaehr = G|inland
.copy M|spra = P|spra
.formula M|stat       = G|TRUE
.copy M|bukreis  = G|bukreis
.formula M|sverd      = G|TRUE
.formula M|openknot   = "fb/LSS.OPEN.NODE"
.formula M|afteropen  = "fb/LSS.NODE.OPENED"
.formula M|closeknot  = "is/CLOSE.EVENTNODE"
.formula M|afterclose = "fb/LSS.NODE.CLOSED"
.copy M|ford  = F|sysinfo(7)^ford
.copy M|verb  = F|sysinfo(7)^verb
.copy M|sford = F|sysinfo(7)^sford
.copy M|sverb = F|sysinfo(7)^sverb
.copy M|hbkb = F|sysinfo(7)^hbkb
.input "fb/LSS.VJ" ? M|mitvorjahr
.. UTF-8
.. Zuweisung nur in LSS (nicht in LSS3, da dort csvexpencoding nicht definiert)
.assign M|csvexpencoding = "(65)" ? F|defined(M|csvexpencoding)

.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
