.. Kontrolle      : mh
.. Functionality  : Report footer of the Infosystem fb/ZM
..*****************************************************************************
..
.set trans -
..
.select screen header
..*****************************************************************************
!LOOP
..*****************************************************************************
.select screen line
.continue END ? _G|mehr
.formula M|sumwaren = M|sumwaren + M|tbetrag ? 'M|tzmart(L=":")'="(Goods)"
.formula M|sumdienstleist = M|sumdienstleist + M|tbetrag ? 'M|tzmart(L=":")'="(Service)"
.formula M|sumdreieck = M|sumdreieck + M|tbetrag ? 'M|tzmart(L=":")'="(TriangularTrade)"
.formula M|gesamtsumme = M|sumwaren + M|sumdienstleist + M|sumdreieck
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
