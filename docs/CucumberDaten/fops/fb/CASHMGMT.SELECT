..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Selektion
.. Functionality  :
.. include fb/CASHMGMT.SELECT.INIT
.. include fb/CASHMGMT.SELECT.OBCASH
.. include fb/CASHMGMT.SELECT.OI
.. include fb/CASHMGMT.SELECT.PURCH
.. include fb/CASHMGMT.SELECT.SALES
.. include fb/CASHMGMT.SELECT.BVOR
.. include fb/CASHMGMT.SELECT.LFVOR
.. include fb/CASHMGMT.SELECT.VAT
.. include fb/CASHMGMT.SELECT.PPAY
.. include fb/CASHMGMT.SELECT.CREDIT
.. include fb/CASHMGMT.SELECT.FINISH
..*****************************************************************************
..
.set trans -
..
.input "fb/CASHMGMT.SELECT.INIT"
..
.. cash opening balance
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg14)'
.input "fb/CASHMGMT.SELECT.OBCASH" ? U|xbselobcash
..
.. outstanding items
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg15)'
.input "fb/CASHMGMT.SELECT.OI"  ? U|xbseloi
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg16)'
.input "fb/CASHMGMT.SELECT.PURCH" ? U|xpszenario^inklusivobl & (U|xbsellioek ; U|xbselreoek)
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg18)'
.input "fb/CASHMGMT.SELECT.SALES" ? U|xpszenario^inklusivobl & (U|xbselliovk ; U|xbselreovk)
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg20)'  ? U|xpszenario^inklusivbv & U|xbselbvor
.input "fb/CASHMGMT.SELECT.BVOR" ? U|xpszenario^inklusivbv & U|xbselbvor
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg21)'  ? U|xpszenario^inklusivlfv & U|xbsellfvor
.input "fb/CASHMGMT.SELECT.LFVOR" ? U|xpszenario^inklusivlfv & U|xbsellfvor
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg22)'
.input "fb/CASHMGMT.SELECT.VAT"  ? U|xbselvat
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg23)'
.input "fb/CASHMGMT.SELECT.PPAY" ? U|xbselppay
..
.note -immediately 'F|formatstr("{1} : {2}.", U|msg13, U|msg24)'
.input "fb/CASHMGMT.SELECT.CREDIT" ? U|xbselcredit
..
.input "fb/CASHMGMT.SELECT.FINISH"
..
.. finished
.note -immediately 'F|formatstr("{1}.", U|msg25)'
..
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

