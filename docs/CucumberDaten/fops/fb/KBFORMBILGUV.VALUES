..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.VALUES
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Setzen der Werte fÅr eine Periode
..*****************************************************************************
..
.set trans -
..
.continue M1      ? _F|defined(1|koobj)
.continue COSTOBJ ? _F|empty(1|koobj)
.continue CORANGE ? _F|empty(1|koobjber)
..
!M1
.formula U|xrssum.U|xizraum = H|ssum ? U|xbshsum
.formula U|xrhsum.U|xizraum = H|hsum ? U|xbshsum
.formula H|reregeln2      = "(9)"  ? 'M|reregeln(L="0")' = "(9)"
.continue ACCOUNT ? H|dnr <> 68
..
..*****************************************************************************
!ARANGE: Set account range balance
..*****************************************************************************
.formula U|xrbetrag.U|xizraum  = H|kbesaldo
.formula U|xrbetragp.U|xizraum = H|kbpesaldo ? U|xbmitplan
.formula U|xrasaldo.U|xizraum  = H|asaldo    ? U|xbsalden
.formula U|xresaldo.U|xizraum  = H|esaldo    ? U|xbsalden
.continue FACTOR
..
..*****************************************************************************
!ACCOUNT: Insert row values for account
..*****************************************************************************
.. U|xereregeln = ""
.formula U|xrbetrag.U|xizraum  = 0.0               ? (U|xereregeln = 0)
.formula U|xrbetragp.U|xizraum = 0.0               ? (U|xereregeln = 0) & U|xbmitplan
.. (U|xereregeln = 1) ; (U|xereregeln = "Summe")
.formula U|xrbetrag.U|xizraum  = H|esaldo          ?  (U|xereregeln = 1) ; (U|xereregeln = 8)
.formula U|xrbetragp.U|xizraum = H|pesaldo         ? ((U|xereregeln = 1) ; (U|xereregeln = 8)) & U|xbmitplan
.. (U|xereregeln = "Endsaldo Soll")
.formula U|xrbetrag.U|xizraum  = H|esoll           ? (U|xereregeln = 2)
.formula U|xrbetragp.U|xizraum = H|pesoll          ? (U|xereregeln = 2) & U|xbmitplan
.. (U|xereregeln = "Endsaldo Haben")
.formula U|xrbetrag.U|xizraum  = H|ehaben          ? (U|xereregeln = 3)
.formula U|xrbetragp.U|xizraum = H|pehaben         ? (U|xereregeln = 3) & U|xbmitplan
.. (U|xereregeln = "Soll")
.formula U|xrbetrag.U|xizraum  = H|ssum            ? (U|xereregeln = 6)
.formula U|xrbetragp.U|xizraum = H|pssum           ? (U|xereregeln = 6) & U|xbmitplan
.. (U|xereregeln = "Haben")
.formula U|xrbetrag.U|xizraum  = H|hsum            ? (U|xereregeln = 7)
.formula U|xrbetragp.U|xizraum = H|phsum           ? (U|xereregeln = 7) & U|xbmitplan
.. (U|xereregeln = "Soll-Haben")
.formula U|xrbetrag.U|xizraum  = H|ssum - H|hsum   ? (U|xereregeln = 5)
.formula U|xrbetragp.U|xizraum = H|pssum - H|phsum ? (U|xereregeln = 5) & U|xbmitplan
.. (U|xereregeln = "Anfangssaldo")
.formula U|xrbetrag.U|xizraum  = H|asaldo          ? (U|xereregeln = 4)
.formula U|xrbetragp.U|xizraum = H|pasaldo         ? (U|xereregeln = 4) & U|xbmitplan
.. (U|xereregeln = "Umsatz")
.formula U|xrbetrag.U|xizraum  = H|kbesaldo        ? (U|xereregeln = 9)
.formula U|xrbetragp.U|xizraum = H|kbpesaldo       ? (U|xereregeln = 9) & U|xbmitplan
..
.formula U|xrasaldo.U|xizraum  = H|asaldo          ? U|xbsalden
.formula U|xresaldo.U|xizraum  = H|esaldo          ? U|xbsalden
..
.continue FACTOR
..
..*****************************************************************************
!CORANGE: Loop over cost object range
..*****************************************************************************
.load 4 add 1|koobjber
..
..*****************************************************************************
!CORLOOP: Next row
..*****************************************************************************
.load 4 line
.continue FACTOR ? _G|mehr
..
..*****************************************************************************
!COSTOBJ: Single cost object
..*****************************************************************************
.continue M2 ? U|xiklapp = 1
.load 5 add 1|konto
.continue COVALUES
!M2
.load 5 add F|condexpr(H|dnr=60, H|id, 2|id)
..
..*****************************************************************************
!COVALUES: Get values from cost type editor
..*****************************************************************************
.copy 5|selbukreis = G|bukreis
.copy 5|waehr   = M|buwaehr
.formula   5|anjahr  = G|ajahr
.formula   5|endjahr = G|ejahr
.formula   5|anmon   = G|amonat
.formula   5|endmon  = G|emonat
.assign 5|koobj   = F|condexpr(F|defined(4|koobj), 4|koobj, 1|koobj)
.. fbwert==TRUE liefert auch Werte aus 14 und 15, wird fÅr die Fibu benîtigt
.copy 5|fbwert  = G|TRUE
.formula   U|xrbetrag.U|xizraum  = U|xrbetrag.U|xizraum  + 5|kikum
.formula   U|xrbetragp.U|xizraum = U|xrbetragp.U|xizraum + 5|kpfixkum + 5|kppropkum ?  U|xbmitplan
.continue FACTOR  ? _F|defined(4|id)
.continue CORLOOP ?  F|defined(4|id)
..
..*****************************************************************************
!FACTOR
..*****************************************************************************
.. Nur multiplizieren, wenn der Anteil nicht 0.00 ist. Das ist der Spezialfall "davon".
.formula   U|xrbetrag.U|xizraum  = U|xrbetrag.U|xizraum  * U|xrzanteil ? U|xrzanteil <> 0.00
.formula   U|xrbetragp.U|xizraum = U|xrbetragp.U|xizraum * U|xrzanteil ? U|xrzanteil <> 0.00 & U|xbmitplan
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.load 4
.load 5
.continue
