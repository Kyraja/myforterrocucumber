..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : USTPOSNACH.KOSUM
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Ausgabe der Summenzeile fÅr ein Konto
.. Functionality  :
..*****************************************************************************
..
.set trans -
..
.continue END   ?  F|empty(U|xpaccount) & H|selzeile=0
.continue KOSUM ? _F|defined(H|konto)
.formula U|xbnextacc = _F|empty(U|xpaccount) & (U|xpaccount^id <> H|konto^id)
.continue SUM ? _U|xbnextacc
..
!KOSUM: Account sum
.make screen line +O
.formula   M|tsumme    = 1
.copy M|tkonto    = U|xpaccount
.copy M|tkosteuer = M|tkonto^sts
.copy M|tkolaart  = M|tkonto^laart
.copy M|tkoev     = M|tkonto^ev
.copy M|tkokart   = M|tkonto^kart
.formula M|tssum  = U|xrssum1
.formula M|thsum  = U|xrhsum1
.formula M|tsaldo = M|tssum - M|thsum
.formula U|xrssum1 = 0
.formula U|xrhsum1 = 0
.continue SUM
..
!SUM
.continue END ? _F|defined(H|konto)
.formula U|xrssum1= U|xrssum1 + U|xrbetrag ?  H|soll
.formula U|xrhsum1= U|xrhsum1 + U|xrbetrag ? _H|soll
.copy U|xpaccount = H|konto
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
