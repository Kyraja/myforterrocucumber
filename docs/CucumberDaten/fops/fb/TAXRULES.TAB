..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TAXRULES.TAB
.. Author         : ankn
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Table FOP of the Infosystem fb/TAXRULES
..
.. include fb/TAXRULES.SET.NODE.STATE
..*****************************************************************************
..
..!meta M|=fb/TAXRULES
..!meta H|=P58:16
..
.set trans -
..*****************************************************************************
!DISPLAY
..*****************************************************************************
.copy M|tstrgl       = H|strgl
.copy M|tsts         = M|tstrgl^sts
.copy M|tev          = M|tstrgl^ev
.copy M|tstlaart     = M|tstrgl^stlaart
.copy M|tstzmart     = M|tstrgl^zmart
.copy M|tustart      = H|strgl^ustart
.formula M|tktostrgl = H|kopf^id
.copy M|tvrgstrgl    = H|vrgstrgl
..
.load 2 'G|hdatname58' 'F|formatstr("$,kopf=={1};@gruppe=15", H|strgl^id)'
.continue LOOP2 ? _G|mehr
.continue LOOP1
..
..*****************************************************************************
!LOOP1
..*****************************************************************************
..!meta 2|=P58:15
.copy M|tktoustpos = 2|ktoustpos ? (2|gvon < M|datum) & (M|datum < 2|gbis)
.load 2 continue
.continue LOOP2 ? _G|mehr
.continue LOOP1
..
..*****************************************************************************
!LOOP2
..*****************************************************************************
.input "fb/TAXRULES.SET.NODE.STATE"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
