..!interpreter english translate
..*****************************************************************************
..
..  Name      : BILKON.RECH
..  Datum     : 16.07.96
..  Vers.     : 7.1
..  Autor     : Andrzej Klusek
..
..  Verantwortlich : hc
..  Kontrolle      : mh
..
..
..  Funktion  : BILKON.RECH wird aus BILKON.HOL/BILKON.KONTO aufgerufen
..
..  Ablauf    : Differenz und % ausrechenen
..
..  Input     : xr11  - Summe Zeitraum1 (Real)
..            : xr12  - Summe Zeitraum2 (Real)
..            : xr21  - Summe Zeitraum3 (Real)
..            : xr22  - Summe Zeitraum4 (Real)
..  Output    : xr1dz - Differenz Zeitraum1 - Zeitraum2 (Real)
..            : xr2dz - Differenz Zeitraum3 - Zeitraum4 (Real)
..            : xx1   - Prozent der Žnderung Zeitraum1 Zeitraum2 (Text)
..            : xx2   - Prozent der Žnderung Zeitraum3 Zeitraum4 (Text)
..
..*****************************************************************************
..                           SUBROUTINE
..                           ----------
..
.end .                  ?  txname / "*BILKON.RECH"
..*****************************************************************************
.set trans -
.type real xrh1
..  Zeitraum_Zahlen
..  Differenz: Jahr - Vorjahr oder Ist-Zahlen - Plan-Zahlen
.formula xx1   = ""
.formula xx2   = ""
.formula xr1dz = xr11 - xr12
..
..  xr1dz == 0 -> Jahr == Vorjahr, nur wenn xr11 != 0.0
..  sonst xr1dz = " "
.formula xx1   = "0"    ?  xr1dz = 0.0  &  _xr11 = 0.0
.continue VG10       ?  xr1dz = 0.0
..
..  Ist alt == 0 und neu != 0  -> Ergebnis = ~ (unendlich)
.formula xx1   = "~"    ?  xr12 = 0.0  &  xr11 > 0.0
.formula xx1   = "-~"   ?  xr12 = 0.0  &  xr11 < 0.0
.continue VG10       ?  xx1 = "-~"   ;  xx1 = "~"
..
..  % Ausrechnen -> (DELTA / ABS WERT(JJ-1)) * 100%
..  xr12 -> Absolutwert
.formula xr12  =-xr12   ?  xr12 < 0.0
.formula xrh1  = (xr1dz / xr12) * 100
..
..  NK abschneiden, sollten NK augegeben werden
..                  muá das Abschneiden in Funktion realisiert werden,
..                  wo die Anzhal der Stellen kundenunabh„ngig ist.
..                  Diese Fkt. muá I_File sein.
..  alle NK nach dem Deztrenner abschneiden, xt99trenn --> BILKON.OBEN
.formula xx1   =  xrh1:0
.formula xx1   =  xx1 << xt99trenn
..
!VG10: Jahreszahlen
.formula xr2dz = xr21 - xr22
..
.formula xx2   = "0"    ?  xr2dz = 0.0  &  _xr21 = 0.0
.continue VG20       ?  xr2dz = 0.0
..
.formula xx2   = "~"    ?  xr22 = 0.0  &  xr21 > 0.0
.formula xx2   = "-~"   ?  xr22 = 0.0  &  xr21 < 0.0
.continue VG20       ?  xx2 = "-~"   ;  xx2 = "~"
..
.formula xr22  =-xr22   ?  xr22 < 0.0
.formula xrh1  = (xr2dz / xr22) * 100
..
.formula xx2   =  xrh1:0
.formula xx2   =  xx2 << xt99trenn
..
!VG20
.continue
