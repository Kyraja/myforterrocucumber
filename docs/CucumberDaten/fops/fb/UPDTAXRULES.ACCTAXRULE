..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : UPDTAXRULES.ACCTAXRULE
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Report header of the Infosystem fb/UPDTAXRULES
..*****************************************************************************
..!meta M|=fb/UPDTAXRULES
..
.set trans -
..
.load 0 'G|hdatname58' 'F|formatstr("$,id=={1};@gruppe=26", M|konto^ktostrgl^id)'
.continue FILTER ? _G|mehr
.type bool first ? _F|defined(U|first)
.type P54:1 ustpos ? _F|defined(U|ustpos)
.type P58:1 sts    ? _F|defined(U|sts)
.copy U|ustpos = M|tustpos
.copy U|sts = M|tsts
.copy U|first = G|true
.load 0 line 'F|formatstr("$,strgl^zmart=={1};strgl^ev=={2};strgl^stlaart=={3};strgl^sts=={4}", F|value(M|zmart, "AU234"), F|value(M|tev, "AU7"), F|value(M|tlaart, "AU8"), M|tsts^id)'
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue FILTER ? _G|mehr
.load 1 'G|hdatname58' 'F|formatstr("$,id=={1};@gruppe=25", 0|strgl^id)'
.continue NEXT  ? _G|mehr
.load 1 line 'F|formatstr("$,1:sts=={1};1:ktoustpos=={2}", U|sts^id, U|ustpos^id)'
..*****************************************************************************
!LOOP2
..*****************************************************************************
.continue NEXT  ? _G|mehr
.continue NEXT2 ? _F|empty(U|steuerper)   & _F|equals(U|steuerper, 1|budatstper^gperr)
.continue NEXT2 ? _F|empty(U|steuerper2)  & _F|equals(U|steuerper2, 1|stdatstper^gperr)
.continue NEXT  ? _F|empty(M|selvrgstrgl) & _F|equals(M|selvrgstrgl, 0|vrgstrgl)
.continue NEXT  ? _F|empty(M|selstrgl)    & _F|equals(M|selstrgl, 0|strgl)
.make screen line +O ? _U|first
.load 1
.copy M|tvrgstrgl = 0|vrgstrgl
.copy M|tstrgl    = 0|strgl
.copy U|first   = G|false
.continue NEXT ? _M|testmode
.formula M|tvrgstrgl = ""
.formula M|tstrgl = ""
.continue NEXT
..
..*****************************************************************************
!NEXT2
..*****************************************************************************
.load 1 line continue
.continue LOOP2
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.load 0 line continue
.continue LOOP
..
..*****************************************************************************
!FILTER
..*****************************************************************************
.continue REMOVE ? _F|empty(M|selvrgstrgl) & _F|equals(M|selvrgstrgl, M|tvrgstrgl)
.continue REMOVE ? _F|empty(M|selstrgl)    & _F|equals(M|selstrgl, M|tstrgl)
.continue END
..
..*****************************************************************************
!REMOVE
..*****************************************************************************
.make screen line -O
.continue END
.. 
..*****************************************************************************
!END
..*****************************************************************************
.continue
