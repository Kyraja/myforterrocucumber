..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BUJDRUCK.EV
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Event-FOP des Infosystems fb/BUJDRUCK
.. Functionality  : Event FOP of the Infosystem fb/BUJDRUCK
..*****************************************************************************
..
..
..*****************************************************************************
..
.set trans -
..
.continue SELECT   ? G|evtartengl = "SCREEN_ENTER"
.continue SELECT   ? G|evtvar = "select" ; G|evtvar = "selrohl"
.continue BUDRUCK  ? G|evtvar = "budruck"
.continue BSELECT  ? G|evtvar = "bauswahl"
.continue QUERY    ? G|evtvar = "query"
.continue QSHOW    ? G|evtvar = "bqueryanzeig"
.continue END
..
..*****************************************************************************
!QUERY
..*****************************************************************************
.formula M|query = "" ? M|query = "!"
.formula M|query = F|regreplaceall(M|query, "^[$%,]+", "")
.continue
..
..*****************************************************************************
!SELECT
..*****************************************************************************
.formula M|query = ""
.formula M|selrohl = F|regreplaceall(M|selrohl, "^[$%,]+", "")
.formula M|selrohl = "6:0" ? F|empty(M|selrohl)
.formula M|query   = M|select
.continue QUERY
..
..*****************************************************************************
!BUDRUCK
..*****************************************************************************
.formula M|selrohl = F|regreplaceall(M|selrohl, "^[$%,]+", "")
.formula M|selrohl = "6:0" ? F|empty(M|selrohl)
.continue QUERY
..
..*****************************************************************************
!BSELECT
..*****************************************************************************
.select 'G|hdatname6' "%!,,@.gruppe=0;@.datei=6;@.lesen=nein"
.formula M|query   = G|selkrit
.formula M|selrohl = G|selrohl
.formula M|selrohl = F|regreplaceall(M|selrohl, "[%,]", "")
.formula M|selrohl = "6:0" ? F|empty(M|selrohl)
.continue QUERY
..
..*****************************************************************************
!QSHOW
..*****************************************************************************
.continue END ? F|empty(M|query)
.set separator
.box Abfrage
'M|query'
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
