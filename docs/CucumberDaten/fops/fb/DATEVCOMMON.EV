..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVCOMMON.EV
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Allgemeines Event-FOP von DATEV-Export Infosystemen
.. Functionality  :
..*****************************************************************************
..
.. include fb/DATEVCOMMON.LADE.CONFIG
..
..*****************************************************************************
..
.set trans -
..
.. workaround
.occupy 'M|datevsem'
..
.continue NEMPTY  ? G|evtvar = "expwaehr"          & G|evtartengl = "FIELD_VALIDATION"
.continue NEMPTY  ? G|evtvar = "abrechnungsnummer" & G|evtartengl = "FIELD_VALIDATION"
.continue NEMPTY  ? G|evtvar = "bukreis"           & G|evtartengl = "FIELD_VALIDATION"
.continue NEMPTY  ? G|evtvar = "buwaehr"           & G|evtartengl = "FIELD_VALIDATION"
.continue FEHLER  ? G|evtvar = "bzeigefehler"
.continue CONFIG  ? G|evtvar = "datevkonfig"       & G|evtartengl = "FIELD_EXIT"
.continue END
..
..*****************************************************************************
!NEMPTY: Leerwert nicht erlaubt
..*****************************************************************************
.continue END ? _F|empty(M|.G|evtvar)
.error Leerwert nicht zul„ssig.
.end 1
..
..*****************************************************************************
!FEHLER
..*****************************************************************************
.input "fb/DATEVCOMMON.ZEIGE.FEHLER"
.end 0
..
..*****************************************************************************
!CONFIG
..*****************************************************************************
.make screen line --
.input "fb/DATEVCOMMON.LADE.KONFIG"
.end 0
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
