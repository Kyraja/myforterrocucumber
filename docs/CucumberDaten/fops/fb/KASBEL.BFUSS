..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : KASBEL.BFUSS
..  Datum          : 11.04.2006
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Berichtsfuss des Infosystems fb/KASBEL
..
..  Program flow  :
... Includes      :
..*****************************************************************************
.set trans -
..
.type text  xtsys     ? _F|defined(U|xtsys)
.type text  xterr     ? _F|defined(U|xterr)
.type RP3.2 x1        ? _F|defined(U|x1)
.type text  xgl       ? _F|defined(U|xgl)
..
.formula M|sum = M|sumein - M|sumaus
..
.. Zuordnungen setzen
.formula M|texta = ""
.formula M|textb = ""
.formula M|textc = ""
.formula M|textd = ""
.formula M|texte = ""
..
.file -tempname U|xterr
..
!SORT: sortieren: unique und rckw„rts ausgeben
.system 'F|expr("sort -u -r " + xtmpfile + " -n -o " + xtmpfile + " 2>"  + U|xterr)' background
.continue ERROR1 ? _G|mehr
..
!AREAD
.formula U|xgl = "A"
..
!FROM
.select from 'U|xtmpfile' U|x1
.continue END  ? _G|mehr
.continue END  ? U|x1 = 0,00
.formula M|texta = "A = " + 'U|x1' +"%" ? U|xgl = "A"
.formula M|textb = "B = " + 'U|x1' +"%" ? U|xgl = "B"
.formula M|textc = "C = " + 'U|x1' +"%" ? U|xgl = "C"
.formula M|textd = "D = " + 'U|x1' +"%" ? U|xgl = "D"
.formula M|texte = "E = " + 'U|x1' +"%" ? U|xgl = "E"
..
.select screen header
!LSELLINE
.select screen line
.continue BREAD ? _G|mehr & U|xgl = "A"
.continue CREAD ? _G|mehr & U|xgl = "B"
.continue DREAD ? _G|mehr & U|xgl = "C"
.continue EREAD ? _G|mehr & U|xgl = "D"
.continue END   ? _G|mehr
.continue LSELLINE ? _F|empty(M|gl) ; M|psatz = 0
.formula M|gl = U|xgl  ? M|psatz = U|x1
.continue LSELLINE
!BREAD
.formula U|xgl = "B"
.continue FROM
..
!CREAD
.formula U|xgl = "C"
.continue FROM
..
!DREAD
.formula U|xgl = "D"
.continue FROM
..
!EREAD
.formula U|xgl = "E"
.continue FROM
..
!ERROR1
.error Sortierung gescheitert!
.end 1
..
..*****************************************************************************
!END
.continue
