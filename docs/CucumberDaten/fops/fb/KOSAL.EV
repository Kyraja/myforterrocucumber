..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : KOSAL.EV
.. Author         : ankn
.. Verantwortlich : cl
.. Functionality  : Common event FOP of the Infosystem fb/KOSAL
..*****************************************************************************
..
..
.set trans -
..
..!meta M|=fb/KOSAL
..
.make screen line --
.continue START  ? G|evtartengl = "BUTTON_BEFORE" &  G|evtvar = "bstart"
.continue PERIOD  ? G|evtvar = "anfj"   & G|evtartengl = "FIELD_EXIT"
.continue PERIOD  ? G|evtvar = "endj"   & G|evtartengl = "FIELD_EXIT"
.continue PERIOD  ? G|evtvar = "anfmon" & G|evtartengl = "FIELD_EXIT"
.continue PERIOD  ? G|evtvar = "endmon" & G|evtartengl = "FIELD_EXIT"
.continue PERIOD  ? G|evtvar = "anfdat"   & G|evtartengl = "FIELD_EXIT"
.continue PERIOD  ? G|evtvar = "enddat"   & G|evtartengl = "FIELD_EXIT"
.continue BUART  ? (G|evtartengl ="FIELD_EXIT")   & (G|evtvar ="buart" ; G|evtvar = "buartalle")
..
..*****************************************************************************
!BUART: statistical and financial entries selected ?
..*****************************************************************************
..
.. M|buart == 70 -> financial
.. M|buart == 83 -> statistical
.. M|buartalle == true -> all
..
.protection        buart    ?  M|buartalle
.protection -reset buart    ? _M|buartalle
..
.continue END
..
..*****************************************************************************
!PERIOD: Set period
..*****************************************************************************
.type text xxtemon xxtsmon xxtsyear xxteyear xxtfromd xxttod
.formula U|xxtsmon = "anfmon"
.formula U|xxtemon = "endmon"
.formula U|xxtsyear= "anfj"
.formula U|xxteyear= "endj"
.formula U|xxtfromd= "anfdat"
.formula U|xxttod  = "enddat"
.input "fb/IS.SETPERIOD"
.make screen line --
.continue END
..
..*****************************************************************************
!START: Infosystem start
..*****************************************************************************
.input "is/TABLEEREN"
.continue ERR01 ? F|empty(M|konto)
.set setofbooks 'M|bukreis^bknr'
..
..*****************************************************************************
!ACCOUNT: Account selected
..*****************************************************************************
.type VP6 xaccount
.type GJ xsyear xeyear
.type integer xsmonth xemonth
.select add M|konto
.set currency 'M|buwaehr'
.set outcurr 'M|buwaehr'
.copy U|xaccount = M|konto
.copy U|xsyear = M|anfj
.copy U|xeyear = M|endj
.formula U|xsmonth = M|anfmon
.formula U|xemonth = M|endmon
.input "fb/ACCOUNT.FIGURES"
.formula M|anfsaldo = U|xobalance
.formula M|endsaldo = U|xcbalance
.formula M|sumsoll  = U|xdebit
.formula M|sumhaben = U|xcredit
..
.type integer  xaccounttype ? _F|defined(U|xaccounttype)
..
.formula U|xaccounttype = 0
.formula U|xaccounttype = 1 ? M|konto^dnr = 5 & (M|konto^gruppe = 2 ; M|konto^gruppe = 4)
.formula U|xaccounttype = 2 ? M|konto^dnr = 60
..
.formula M|select = "$,"
.formula M|select = M|select + ";kvnextrakt=1"
.formula M|select = M|select + ";iwbu=" + 'M|buwaehr^id' ? _F|empty(M|buwaehr)
.formula M|select = M|select + ";bukreis=" + M|bukreis^id ? _F|empty(M|bukreis)
.formula M|select = M|select + ";sortgjgm=" + F|fysortdat(M|anfj, M|anfmon) + "!" + F|fysortdat(M|endj, M|endmon)
.formula M|select = M|select + ";konto=" + M|konto^id     ? U|xaccounttype = 0
.formula M|select = M|select + ";kstelle=" + M|konto^id   ? U|xaccounttype = 1
.formula M|select = M|select + ";koart="   + M|konto^id   ? U|xaccounttype = 2
.formula M|select = M|select + ";ursache=" + 'M|ursache(L="0")'                ? _F|empty(M|ursache)
.formula M|select = M|select + ";@zeilen=(1)"
.formula M|select = M|select + ";@gruppe=1;gruppe=1"        ? _M|buartalle & 'M|buart(L=":")' = "(StatisticalEntry)"
.formula M|select = M|select + ";@gruppe=0;gruppe=0"        ? _M|buartalle & 'M|buart(L=":")' = "(FinancialEntry)"
..
.type text xttmp xtdat xterr
.file -tempname U|xttmp
.file -tempname U|xtdat
.file -tempname U|xterr
.input "DATEI.F"
.output new 'U|xttmp'
..
.select entryjournal 'M|select'
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue ELOOP ? _G|mehr
.println 'H|ursache(L="0")' # 'H|sbetr' # 'H|hbetr'
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue LOOP
..*****************************************************************************
!ELOOP
..*****************************************************************************
.output terminal
.continue END  ? _F|fileexists(U|xttmp) ; _F|filesize(U|xttmp) > 0
.system 'F|expr("group_by.sh -n 3  -k 1 -s 2 -s 3 " + U|xttmp + " 1>" + U|xtdat + " 2>" + U|xterr)' background
.continue ERR02 ? _G|mehr
.continue ERR02 ?  F|filesize(U|xterr) > 0
.continue RFILE
..
..*****************************************************************************
!RFILE
..*****************************************************************************
.type bool xbmehr
..*****************************************************************************
!RLOOP
..*****************************************************************************
.make screen line +O
.select from 'U|xtdat' M|tursache # M|tsoll # M|thaben
.copy U|xbmehr = G|mehr
.make screen line -O ? _U|xbmehr
.input 'M|tab'
.continue RLOOP ? U|xbmehr
.continue END
..
.set trans +
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Kein Konto bzw. Kst/Ktr angegeben.
.end 1
..
..*****************************************************************************
!ERR02: GROUPBY error
..*****************************************************************************
.error Fehler beim Systemaufruf.
.input -text 'U|xterr' ? F|filesize(U|xterr) > 0
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
