..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : UPDTAXRULES.EV
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Common event FOP of the Infosystem fb/UPDTAXRULES
..*****************************************************************************
..
..!meta M|=fb/UPDTAXRULES
..
.set trans -
..
.make screen line -- ? G|evtartengl = "FIELD_EXIT"
.continue START ? G|evtvar = "bstart" & G|evtartengl = "BUTTON_AFTER"
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.continue ERR01 ? _F|fileexists(M|logfilename)
.type text xtwrkfile
.file -tempname U|xtwrkfile
.system 'F|formatstr("cp {1} {2}", M|logfilename, U|xtwrkfile)' background
.set separator ~
.type bool xbfiltered xbfileend
.type text xtlastobj
.type text xt1 xt2 xt3 xt4
.type integer  xirow xilastrow xifilerow
.type bool xbaccount xbnewscreenline xbnewobject xbnewobjectline
.type text konto ustzuoid num54 such54 ablagen steuerper steuerper2
.formula U|xilastrow = -1 
.input 'M|bkopf' ? _F|empty(M|bkopf)
..*****************************************************************************
!LOOP
..*****************************************************************************
.select from 'U|xtwrkfile' U|xt1;U|xt2;U|xt3;U|xt4^
.copy U|xbfileend = _G|mehr
.continue POSTPRO ? U|xbfileend & M|ozeilen > 0
.formula  U|xifilerow = U|xifilerow + 1 
.continue LEND    ? U|xbfileend
.continue LOOP    ? (U|xt1 << 1) = "#"
.formula U|ustzuoid = U|xt1
.assign U|xirow = U|xt2
.copy U|xbnewobject = U|xt1 <> U|xtlastobj
.copy U|xbnewobjectline = U|xirow > U|xilastrow
.copy U|xbnewscreenline = ((U|xirow > 1 & U|xirow > U|xilastrow) ; U|xbnewobject)
.copy U|xilastrow = U|xirow
.copy U|xtlastobj = U|xt1
.continue POSTPRO ? U|xbnewscreenline & M|ozeilen > 0
.continue INSERT
..
..*****************************************************************************
!POSTPRO
..*****************************************************************************
..*****************************************************************************
!FILTER
..*****************************************************************************
.continue REMOVE ? _F|empty(M|tablagen)
.continue REMOVE ? _F|empty(M|selsteuerper) & _F|equals(M|selsteuerper, M|steuerper) & _F|equals(M|selsteuerper, M|steuerper2) 
.continue REMOVE ? _F|empty(M|selkonto)     & _F|equals(M|selkonto, M|konto)
.continue REMOVE ? _F|empty(M|selustpos)    & _F|equals(M|selustpos, M|tustpos)
.continue REMOVE ? _F|empty(M|selsts)       & _F|equals(M|selsts, M|tsts)
.continue REMOVE ? _F|empty(M|selev)        & _F|equals(M|selev, M|tev)
.continue REMOVE ? _F|empty(M|selzmart)     & _F|equals(M|selzmart, M|zmart)
.continue REMOVE ? _F|empty(M|sellaart)     & _F|equals(M|sellaart, M|tlaart)
.input "fb/UPDTAXRULES.ACCTAXRULE"
.continue NOTEST ? _M|testmode
.formula M|konto = ""
.formula M|tustpos = ""
.formula M|tsts = ""
.formula M|gvorg = ""
.formula M|tvrgstrgl = ""
.formula M|tstrgl = ""
..
..*****************************************************************************
!NOTEST
..*****************************************************************************
.continue LEND   ? U|xbfileend
.continue INSERT
..
..*****************************************************************************
!REMOVE
..*****************************************************************************
.make screen line -O
.continue LEND ? U|xbfileend
.continue INSERT
..
..*****************************************************************************
!INSERT
..*****************************************************************************
.make screen line +O ? U|xbnewscreenline
.formula U|xt3 = U|xt3 << -2
.continue ROW ? U|xirow > 0
.assign  U|.U|xt3 = U|xt4 ? F|defined(U|.U|xt3)
.continue LOOP
..
..*****************************************************************************
!ROW
..*****************************************************************************
.continue ROW2 ? _U|xbnewobjectline
.assign  M|tid = U|ustzuoid
.assign  M|tablagen = U|ablagen
.assign  M|tnum54 = U|num54
.assign  M|tsuch54 = U|such54
.assign  M|konto  = U|konto
.assign  M|steuerper = U|steuerper
.assign  M|steuerper2 = U|steuerper2
.continue ROW2
..
..*****************************************************************************
!ROW2
..*****************************************************************************
.formula M|tzeile = U|xirow
.assign  M|.U|xt3 = U|xt4 ? F|defined(M|.U|xt3)
.continue LOOP
..*****************************************************************************
!LEND
..*****************************************************************************
.set separator ;
.input 'M|bfuss' ? _F|empty(M|bfuss)
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error 'F|formatstr("Die Logdatei {1} ist nicht vorhanden", M|logfilename)'
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
