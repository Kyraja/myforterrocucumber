..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : GUARANTEE.ABASDMS.IDX
.. Autor          : saac
.. Verantwortlich : teamreport
.. Kontrolle      : cl
.. Funktion       : Erzeugt Indexdatei fÅr abas-DMS
.. Functionality  : Creates index file for abas-DMS
..*****************************************************************************
..
.set trans -
..
.type text    xt           ? _F|defined(U|xt)
.type text    xselstring   ? _F|defined(U|xselstring)
.type P88:11 xdmsbelegart  ? _F|defined(U|xdmsbelegart)
.type VID99 xid            ? _F|defined(U|xid)
.type bool xhaspos         ? _F|defined(U|xhaspos)
.type VP5  xkuli            ? _F|defined(U|xkuli)
..
.input "dms/FIND.CONTEXT"
..
.file -tempname U|xt
.select screen header
..
.output new 'U|xt' -encoding "UTF-8"
.input "DATEI.F"
..
..Allgemeine- und Kopfvariablen
.input "STD.ABASDMS.IDX"
..
FBelNr='U|xid^buergnum'
Info='U|xid^namebspr'
..
.. find customer or supplier in head
..
.assign U|xkuli=""
.assign U|xkuli=U|xid^kunde    ? U|xid^dnr = 105 & U|xid^gruppe = 1
.assign U|xkuli=U|xid^lief     ? U|xid^dnr = 105 & U|xid^gruppe = 2
.continue NOKULI               ? F|empty(U|xkuli)
.input "st/KULI.ABASDMS.IDX"
..
!NOKULI
Waehrung='U|xid^waehr'
BruBet='U|xid^betrag'
NetBet='U|xid^betrag'
BelDat='U|xid^zaterm(L="0")'
Betreff='U|xid^buergnum'
..
.continue HEADEND                 ? F|empty(U|xid^evvorgang)
.continue PURCHASE                ? U|xid^evvorgang^dnr = 4
?VKAngNr='U|xid^evvorgang^nummer'   ? U|xid^evvorgang^ktyp = G|anko
?AbasVAID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|anko
..
?VKAufNr='U|xid^evvorgang^nummer'   ? U|xid^evvorgang^ktyp = G|abko
?AbasVBID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|abko
..
?VKLiefNr='U|xid^evvorgang^nummer'  ? U|xid^evvorgang^ktyp = G|liko
?AbasVLID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|liko
..
?VKRechNr='U|xid^evvorgang^nummer'  ? U|xid^evvorgang^ktyp = G|reko
?AbasVRID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|reko
.continue HEADEND
..
!PURCHASE
?EKAnfNr='U|xid^evvorgang^nummer'   ? U|xid^evvorgang^ktyp = G|anko
?AbasEAID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|anko
..
?EKBestNr='U|xid^evvorgang^nummer'  ? U|xid^evvorgang^ktyp = G|abko
?AbasEBID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|abko
..
?EKLiefNr='U|xid^evvorgang^nummer'  ? U|xid^evvorgang^ktyp = G|liko
?AbasELID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|liko
..
?EKRechNr='U|xid^evvorgang^nummer'  ? U|xid^evvorgang^ktyp = G|reko
?AbasERID='U|xid^evvorgang^id'      ? U|xid^evvorgang^ktyp = G|reko
..
!HEADEND
..
POS-ANF
abasaid='U|xid'
?KStKTr='U|xid^kstelle'                  ? _ F|empty(U|xid^kstelle)
?KSTBez='U|xid^kstelle^name'             ? _ F|empty(U|xid^kstelle)
.. 
?AbasPRID='U|xid^projekt^id'             ? F|sysinfo(18)^projekt & F|defined(U|xid^projekt)
?ProjNr='U|xid^projekt^nummer'           ? F|sysinfo(18)^projekt & F|defined(U|xid^projekt)
?ProjSuch='U|xid^projekt^such'           ? F|sysinfo(18)^projekt & F|defined(U|xid^projekt)
?ProjBez='U|xid^projekt^name'            ? F|sysinfo(18)^projekt & F|defined(U|xid^projekt)
POS-END
..
!END
.system 'F|expr("crlf+ < " + U|xt + " >" + U|xxmldata)' background
.continue

