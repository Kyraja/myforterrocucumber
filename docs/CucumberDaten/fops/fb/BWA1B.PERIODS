..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BWA1B.PERIODS
.. Datum          : 27.03.2007
.. Version        : 1
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Periodenvorbelegung im Infosystem fb/BWA1B
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..   Argument     meaning
..   ---------------------------------------------------------
..   xp...        ...
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..
..*****************************************************************************
..
.set trans -
..
.type integer xizraum
.type integer xismonth
.type integer xiemonth
.type GJ  xyear
..
.continue VORJAHR ? G|evtvar = "vorjahr"
.continue CYEAR   ? G|evtvar = "baktjahr"
.continue LYEAR   ? G|evtvar = "bvorjahr"
.continue PERIOD1 ? G|evtvar = "bbzraum1"
.continue END
..
..*****************************************************************************
!VORJAHR
..*****************************************************************************
.continue CYEAR ? _M|vorjahr
.continue LYEAR ?  M|vorjahr
..*****************************************************************************
!CYEAR
..*****************************************************************************
.select year 'G|gjahr'
.continue NODASH ? _F|defined(M|dashboard)
.continue NODASH ? _M|dashboard
.formula M|anzahlmonategj = G|emonat
!NODASH
.continue SETPER
..
..*****************************************************************************
!LYEAR
..*****************************************************************************
.select company "$,@gruppe=12;gruppe=12"
.continue END ? _G|mehr
..
..*****************************************************************************
!LYL
..*****************************************************************************
.select line
.continue END   ? _G|mehr
.continue LYL   ?  H|gjahr <> G|gjahr
.continue ERR02 ?  H|aktzeile = 1
.select line 'F|expr(H|aktzeile - 1)'
..Anzahl der Gesch„ftsmonate aus dem Termindatensatz merken
.continue NODASH2 ? _F|defined(M|dashboard)
.continue NODASH2 ? _M|dashboard
.formula M|anzahlmonategj = H|anzgmon
!NODASH2
.select year 'H|gjahr'
.continue SETPER
..
..*****************************************************************************
!PERIOD1
..*****************************************************************************
.continue ERR01 ? F|empty(M|jahr1) ; F|empty(M|amon1) ; F|empty(M|emon1)
.select year 'M|jahr1' 'M|amon1' 'M|emon1'
.continue SETPER
..
..*****************************************************************************
!SETPER
..*****************************************************************************
.formula U|xismonth = G|amonat
.formula U|xiemonth = G|emonat
.formula U|xyear    = G|ajahr
..
.formula U|xizraum  = 1
..
.formula M|amon.U|xizraum = G|amonat
.formula M|emon.U|xizraum = G|emonat
.formula M|jahr.U|xizraum = U|xyear
.formula M|adatum.U|xizraum = G|adatum
.formula M|edatum.U|xizraum = G|edatum
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xizraum  = U|xizraum + 1
.continue LEND ? U|xizraum > M|maxperiod
.formula M|amon.U|xizraum = U|xismonth
.formula M|emon.U|xizraum = U|xismonth
.formula M|jahr.U|xizraum = U|xyear
.select year 'U|xyear' 'U|xismonth'
.formula M|adatum.U|xizraum = G|adatum
.formula M|edatum.U|xizraum = G|edatum
.formula U|xismonth = U|xismonth + 1
.formula U|xizraum  = U|xizraum + 1 ? U|xismonth > U|xiemonth
.continue LEND ? U|xismonth > U|xiemonth
.continue LOOP
..
..*****************************************************************************
!LEND
..*****************************************************************************
.continue END ? U|xizraum > M|maxperiod
.formula M|amon.U|xizraum = 0
.formula M|emon.U|xizraum = 0
.formula M|jahr.U|xizraum = ""
.formula M|adatum.U|xizraum = ""
.formula M|edatum.U|xizraum = ""
.formula U|xizraum  = U|xizraum + 1
.continue LEND
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Kein Korrekter Zeitraum 1 definiert.
.end 1
..
..*****************************************************************************
!ERR02
..*****************************************************************************
.error Kein Vorjahr gefunden.
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
