..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.COMPARE
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Vergleichswerte berechnen
..*****************************************************************************
..
.set trans -
..
.type text xtcmpfop ? _F|defined(U|xtcmpfop)
.type bool xbnegate ? _F|defined(U|xbnegate)
..
.formula U|xbnegate = G|false
.formula U|xbnegate = M|negabw ? F|defined(M|negabw)
..
.formula U|xtcmpfop = "fb/KBFORMBILGUV.COMPARE" + 'M|verglart' ? M|verglart > 0
.input 'U|xtcmpfop'                   ? M|verglart > 0
.input "fb/KBFORMBILGUV.COMPARE.PA" ? M|mitplan
..
.continue END ? F|empty(M|kber)
..
.type integer xicmpkb ? _F|defined(U|xicmpkb)
.formula U|xicmpkb = 0
..*****************************************************************************
!CMPL: Loop over account ranges for comparison and check if one is found in this row
..*****************************************************************************
.formula U|xicmpkb = U|xicmpkb + 1
.continue END  ? U|xicmpkb > M|maxcmpkb
.formula M|tcmpkb = 0
.formula M|tcmpkb = U|xicmpkb ? _F|empty(M|cmpkb.U|xicmpkb) & 'M|cmpkb.U|xicmpkb^id' = M|kber^id
.continue CMPL ? M|tcmpkb = 0
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
