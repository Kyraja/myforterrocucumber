..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CCGUV.COLORS
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Corridor Controlling GuV Maskeneintritts-FOP
.. Functionality  : Setzt die Farben der darzustellenden Linien in den Charts
.. Program flow   :
...Includes       :
..*****************************************************************************
.set trans -
.type text xtfh1 xtfh2 xtfh3 ? _F|defined(U|xtfh1)
.type text xtfh4 xtfh5 xtfh6 ? _F|defined(U|xtfh4)
.type bool abasColorCheck    ? _F|defined(U|abasColorCheck)
..*****************************************************************************
..
.copy U|abasColorCheck = G|false
..
.continue INITMASK ? G|evtartengl = "SCREEN_ENTER"
.continue SETCOLOR
..
..*****************************************************************************
!INITMASK: Initial colors
..*****************************************************************************
.input "is/ABASFARBEN.DEF"
.. xabasgreen
.formula M|fbcr  = U|xabasgreen << " "
.formula M|fbcg  = U|xabasgreen >> " " << " "
.formula M|fbcb  = U|xabasgreen >> " " >> " "
..
.. xabasgold
.formula M|fpcr  = U|xabasgold << " "
.formula M|fpcg  = U|xabasgold >> " " << " "
.formula M|fpcb  = U|xabasgold >> " " >> " "
..
.. xabasdarkblue
.formula M|fber  = U|xabasdarkblue << " "
.formula M|fbeg  = U|xabasdarkblue >> " " << " "
.formula M|fbeb  = U|xabasdarkblue >> " " >> " "
..
.. xabasred
.formula M|fwcr  = U|xabasred << " "
.formula M|fwcg  = U|xabasred >> " " << " "
.formula M|fwcb  = U|xabasred >> " " >> " "
..
.. xabasblack
.formula M|fistr = U|xabasblack << " "
.formula M|fistg = U|xabasblack >> " " << " "
.formula M|fistb = U|xabasblack >> " " >> " "
..
.. xabasabasgreen
.formula M|fbasr = U|xabasabasgreen << " "
.formula M|fbasg = U|xabasabasgreen >> " " << " "
.formula M|fbasb = U|xabasabasgreen >> " " >> " "
..
..*****************************************************************************
!SETCOLOR: Set RGB colors
..*****************************************************************************
.type integer  xival    ? _F|defined(U|xival)
..
.formula U|xival         = 0
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fbc?")
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fbc?")
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fpc?")
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fbe?")
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fwc?")
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fbas?")
.assign U|xival = M|.G|evtvar ? (G|evtvar / "fist?")
..
.continue ERROR1 ? (U|xival < 0 ; U|xival > 255)
..
.formula U|xtfh1 = 'M|fbcr' + " " + 'M|fbcg' + " " + 'M|fbcb'
.formula U|xtfh2 = 'M|fpcr' + " " + 'M|fpcg' + " " + 'M|fpcb'
.formula U|xtfh3 = 'M|fber' + " " + 'M|fbeg' + " " + 'M|fbeb'
.formula U|xtfh4 = 'M|fwcr' + " " + 'M|fwcg' + " " + 'M|fwcb'
.formula U|xtfh5 = 'M|fbasr' + " " + 'M|fbasg' + " " + 'M|fbasb'
.formula U|xtfh6 = 'M|fistr' + " " + 'M|fistg' + " " + 'M|fistb'
..
.. Farben auf der Maske zeigen:
.colour -background 'U|xtfh1' fbc  0
.colour -background 'U|xtfh2' fpc  0
.colour -background 'U|xtfh3' fbe  0
.colour -background 'U|xtfh4' fwc  0
.colour -background 'U|xtfh5' fbas 0
.colour -background 'U|xtfh6' fist 0
..*****************************************************************************
!END
..*****************************************************************************
.continue
..*****************************************************************************
!ERROR1: Only values between decimal 0 and 255 allowed
..*****************************************************************************
.error -line 0 -field 'G|evtvar' -message Es sind nur Werte zwischen 0 und 255 erlaubt
.end 1
