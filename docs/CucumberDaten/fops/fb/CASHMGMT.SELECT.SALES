..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.SALES
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Selektion und Ausgabe von Verkaufsvorgaengen im Rahmen der Liquiditaetsplanung
.. Functionality  :
.. include fb/CASHMGMT.SELECT.PS.COMMON
.. include fb/CASHMGMT.CHECK.ACCOUNT.EXCLUDED
.. include fb/CASHMGMT.SELECT.VARS.RESET
..*****************************************************************************
..
.set trans -
..
.input "fb/CASHMGMT.SELECT.VARS.RESET"
..
.continue END ? _F|empty(U|xpdocument) & U|xpdocument^dnr<>3
..
.type bool xbredataktdat ? _F|defined(U|xbredataktdat)
..
.formula   U|xepurchsales = "(Sales)"
.copy U|xbredataktdat = U|xpszenario^vkredataktdat
..
.formula   U|xtselect = F|formatstr("$,@gruppe=22.23.24.28.29;@ablageart=(1);vsperre={1};zasperre={1}", F|condexpr(U|xbshowall, "", G|false))
.formula   U|xtselect = U|xtselect + ";id=" + 'U|xpdocument^id' ? _F|empty(U|xpdocument) & U|xpdocument^gruppe = 1
.load 0 nolock sales 'U|xtselect'
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END  ? _G|mehr
.continue NEXT ?  0|typ=G|LIKO & _0|fakt
.copy U|xbintercompany = 0|inkkreis
.continue NEXT ?  U|xeintercompany = "(OnlyIntercompanyProcesses)" & _U|xbintercompany
.continue NEXT ?  U|xeintercompany = "(NoIntercompanyProcesses)"   &  U|xbintercompany
.load 1
.continue OK ? F|empty(0|kunde2) ; 0|kunde2^gruppe <> 1
.load 1 add 0|kunde2
.input "fb/CASHMGMT.CHECK.ACCOUNT.EXCLUDED"
.continue NEXT ? _U|xbok
..
..*****************************************************************************
!OK
..*****************************************************************************
.. Karenztage ermitteln (aus Konfiguration, Kunde bzw. Lieferant)
.formula   U|xikarenztage = F|condexpr(U|xpszenario^kuignorieren, U|xpszenario^vklsrektage, F|condexpr(1|lqparamaktiv, 1|lsrektage, U|xpszenario^vklsrektage))
..
.input "fb/CASHMGMT.SELECT.PS.COMMON"
.continue NEXT
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.load 0 continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.load 0
.continue

