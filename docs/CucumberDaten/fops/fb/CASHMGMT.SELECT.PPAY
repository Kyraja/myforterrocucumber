..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.SELECT.PPAY
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Geplante Einzelzahlungen selektieren
.. Functionality  :
.. include fb/CASHMGMT.SELECT.WRITE
.. include fb/CASHMGMT.DUEDATE.WRKDAY
.. include fb/CASHMGMT.SELECT.VARS.RESET
..*****************************************************************************
..
.set trans -
..
.input "fb/CASHMGMT.SELECT.VARS.RESET"
..
.continue END ? _F|empty(U|xpdocument) & U|xpdocument^dnr<>141
..
.type GD xdmaxduedate ? _F|defined(U|xdmaxduedate)
..
.copy U|xdmaxduedate = U|xpend.U|ximaxperiod + 999
..
.formula   U|xtselect = F|formatstr("$,@gruppe=1;gruppe=1;termin={1}!{2}", F|value(U|xdstartdate, "GD8"), F|value(U|xdmaxduedate, "GD8"))
.formula   U|xtselect = U|xtselect + ";id=" + 'U|xpdocument^id' ? _F|empty(U|xpdocument)
.load 0 scheduledpayment 'U|xtselect'
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.copy U|xddate  = 0|termin
.formula   U|xepurchsales  = F|condexpr(F|value(0|zaeinaus, "AS192") = "(IncomingPayment)", "(Sales)", "(Purchasing)")
.input "fb/CASHMGMT.DUEDATE.WRKDAY" ? F|condexpr(U|xepurchsales = "(Purchasing)", U|xpszenario^plauszahlakal, U|xpszenario^pleinzahlakal)
.formula   U|xttype  = F|condexpr(F|value(0|zaeinaus, "AS192") = "(IncomingPayment)", "(OtherIncomingPayments)", "(OtherOutgoingPayments)")
.formula   U|xrvalue = F|fxamount(U|xpoutcurr,0|betrag,0|termin,0|iwbu)
.copy      U|xcategory = 0|lqkategorie ? U|xbevalcategories
.input "fb/CASHMGMT.SELECT.WRITE"
.load 0 continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.load 0
.continue

