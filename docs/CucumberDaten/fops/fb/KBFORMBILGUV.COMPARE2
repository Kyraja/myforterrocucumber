..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBFORMBILGUV.COMPARE2
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Vergleichswerte Periode p/Periode p+1 berechnen
..*****************************************************************************
..
.set trans -
..
.. index of period
.type integer  xizraum2 ? _F|defined(U|xizraum2)
.type integer  xicmp    ? _F|defined(U|xicmp)
.type real xrp1     ? _F|defined(U|xrp1)
.type real xrp2     ? _F|defined(U|xrp2)
.type real xrdz     ? _F|defined(U|xrdz)
..
.formula U|xicmp = 0
..*****************************************************************************
!CMPLOOP:
..*****************************************************************************
.formula U|xicmp    = U|xicmp + 1
.continue END      ? U|xicmp > (M|maxperiod / 2)
.formula U|xizraum  = (U|xicmp - 1) * 2 + 1
.formula U|xizraum2 = U|xizraum + 1
..
.formula U|xrp1   = M|betrag.U|xizraum
.formula U|xrp2   = M|betrag.U|xizraum2
.formula U|xrdz   = U|xrp1 - U|xrp2
..
.formula M|proz1p.U|xicmp = 100
..
.formula M|proz1p.U|xicmp = 0 ? U|xrdz = 0.00
.continue CMPLOOP            ? U|xrdz = 0.00
..
.formula M|proz1p.U|xicmp   = (U|xrdz / U|xrp2) * 100 ? U|xrp2 <> 0
.formula M|proz1p.U|xicmp   = M|proz1p.U|xicmp * -1   ? U|xbnegate
..
.continue CMPLOOP ? _F|defined(M|absabw1p.U|xicmp)
..
.formula M|absabw1p.U|xicmp = U|xrp1 - U|xrp2
.formula M|absabw1p.U|xicmp = M|absabw1p.U|xicmp * -1 ? U|xbnegate
..
.continue CMPLOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

