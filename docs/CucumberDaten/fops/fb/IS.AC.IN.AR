..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : IS.AC.IN.AR
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Prfung ob das Konto U|xpac (Typ VP6) in der Struktur des
..                  Kontenbereichs U|xpar auftaucht (Ergebnis ist in U|xbresult
..                  hinterlegt).
.. Functionality  : Checks if the structure of the account range U|xpar contains
..                  the account U|xpac (the result is stored in the boolean variable
..                  T|xbresult)
..*****************************************************************************
..
.type P68:1.3 xpar     ? _F|defined(U|xpar)
.type VP6     xpac     ? _F|defined(U|xpac)
.type bool    xbresult ? _F|defined(U|xbresult)
..
..*****************************************************************************
.set trans -
..
.formula U|xbresult = G|FALSE
..
.continue END ? F|empty(U|xpar)
.continue END ? F|empty(U|xpac)
..
.load 9 accrange 'F|expr("$,@gruppe=" + F|tostring(F|eval(U|xpar^gruppe + 16)) + ";@zeilen=(1);id=" + F|tostring(U|xpar^id) + ";1:konto=" + F|tostring(U|xpac^id))'
.continue END ? _G|mehr
.formula U|xbresult = 9|selzeile > 0
.load 9
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
