..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : AUSZUG2.BKOPF
..  Datum          : 29.11.2010
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Berichtskopf des Infosystems fb/AUSZUG2
..  Functionality  : Report header of the Infosystem fb/AUSZUG2
..*****************************************************************************
..
.type integer  xifactor
.type integer  xirowcount
.type bool xbcost xbsoll
.type real xrbubetr xrkosaldo
.type ID6  xplastentry
..
..*****************************************************************************
..
.set trans -
..
.input "is/ABASFARBEN.DEF"
..
.formula M|sumsoll  = 0
.formula M|sumhaben = 0
..
.formula U|xrkosaldo = F|condexpr(U|xbbackward, M|endsaldo, M|anfsaldo)
..
.formula U|xbcost = (M|konto^dnr = 5 & M|konto^gruppe <> 1)
.formula U|xifactor = -1
.formula U|xifactor =  1 ? M|konto^dnr = 0
.formula U|xifactor =  1 ? M|konto^dnr = 1
.formula U|xifactor =  1 ? M|konto^dnr = 11
.formula U|xifactor =  1 ? M|konto^dnr = 5 & (M|konto^gruppe = 2 ; M|konto^gruppe = 4 ; M|konto^gruppe = 8)
.continue END ? _F|defined(M|konto^ev)
.formula U|xifactor =  1 ? M|konto^dnr = 5 & M|konto^gruppe = 1 & (M|konto^ev = "E" ; M|konto^ev = "")
.formula U|xifactor =  1 ? M|konto^dnr = 5 & M|konto^gruppe = 1 &  M|konto^ev = "V"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
