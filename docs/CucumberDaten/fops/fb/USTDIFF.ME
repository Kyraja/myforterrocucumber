.. Funktion       : Maskeneintritts-FOP des Infosystems fb/USTDIFF
.. Functionality  :
..*****************************************************************************
..
.set trans -
.continue PL ? G|evtvar = "strgl"
..
.copy M|buwaehr = G|inland
.copy M|bukreis = G|bukreis
.select year 'G|gjahr'
.copy M|anfj  = G|ajahr
.copy M|endj  = G|gjahr
.copy M|von   = G|adatum
.copy M|bis   = G|datum
.formula   M|anfm  = G|amonat
.formula   M|endm  = G|gmonat
..
.formula M|mindiff  = 0.01
..
.. aus der Standard-Kontierung die Steuerregel holen
.load 0 'G|hdatname12' "$,@gruppe=7;gruppe=7"
.continue END ? _G|mehr
.copy  M|strgl = 0|erlo^strgl
.load 0
..
.type text  xtstkenn
.. aus der Standard-Kontierung den Nullsteuerschlssel holen
.load 0 company "$,@gruppe=7;gruppe=7"
.continue END ? _G|mehr
.copy M|stsnull = 0|stsnull
..
..*****************************************************************************
!PL: get current period
..*****************************************************************************
..
.load 0
..Werte aus Steuerregel im Kopf holen
.load 0 'G|hdatname58' 'F|formatstr("$,kopf=={1};@gruppe=15", M|strgl^id)'
.continue END ? _G|mehr
..

..*****************************************************************************
!PRINT
..*****************************************************************************
..
.. hier eingreifen, fr Feldaustritt Steuerregel
.continue FP  ? G|datum > 0|gbis ; 0|gvon > G|datum 
..
.copy   M|stsatz   = 0|psatz
.copy M|ustvapos = 0|ktoustpos
.copy M|posev   = M|ustvapos^ev
.copy M|postyp  = M|ustvapos^postyp
.formula   M|posname = M|ustvapos^name
.copy M|stkonto = 0|est ? 'M|posev(L="0")' = "(69)"
.copy M|stkonto = 0|vst ? 'M|posev(L="0")' = "(86)"
.load 0
..
..
.continue END
..
..*****************************************************************************
!FP: find period
..*****************************************************************************
.load 0 continue
.continue END ? _G|mehr
.continue PRINT
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
