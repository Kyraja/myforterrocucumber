..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUSZUG.SELECT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Selektieren der Buchungszeilen zu einem Konto
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type integer  xaccounttype ? _F|defined(U|xaccounttype)
.type DVM2 xtabfop      ? _F|defined(U|xtabfop)
..
.formula U|xaccounttype = 0
.formula U|xaccounttype = 1 ? H|dnr = 5 & (H|gruppe = 2 ; H|gruppe = 4)
.formula U|xaccounttype = 2 ? H|dnr = 60
..
.formula M|select = "$,"
.formula M|select = M|select + ";bukreis="  + M|bukreis^id
.formula M|select = M|select + ";konto="    + H|id         ? U|xaccounttype = 0
.formula M|select = M|select + ";kstelle="  + H|id         ? U|xaccounttype = 1
.formula M|select = M|select + ";koart="    + H|id         ? U|xaccounttype = 2
.formula M|select = M|select + ";iwbu="     + M|waehr^id
.formula M|select = M|select + ";sortgjgm=" + F|fysortdat(M|ajahr, M|amonat) + "!" + F|fysortdat(M|ejahr, M|emonat)
.formula M|select = M|select + ";0:kvnextrakt=1"            ? U|xaccounttype = 0 & _M|ktokvertaufl
.formula M|select = M|select + ";0:kvextrakt=1"             ? U|xaccounttype = 0 & M|ktokvertaufl
.formula M|select = M|select + ";@gruppe=1;gruppe=1"        ? _M|buartalle & 'M|buart(L="0")' = "(83)"
.formula M|select = M|select + ";@gruppe=0;gruppe=0"        ? _M|buartalle & 'M|buart(L="0")' = "(70)"
.formula M|select = M|select + ";@ordnung=sortgjgm,budat,bunummer,buzn" ? _F|empty(U|xtabfop)
.formula M|select = M|select + ";@richtung=" + 'M|richtung(L="0")'
.formula M|select = M|select + ";@zeilen=(1)"
..
.set reference +
..
.select entryjournal 'M|select'
..*****************************************************************************
!LOOP
..*****************************************************************************
.continue END ? _G|mehr
.continue NEXT   ? _F|empty(M|konzern^mdkenn) & F|trim(H|mandkenn) <> M|konzern^mdkenn
.continue O2 ? F|empty(U|xtabfop)
.input 'U|xtabfop' ? (_(M|konto^dnr = 60) ; (M|konto^dnr = 60 & _F|empty(H|kstelle)))
.continue NEXT
..*****************************************************************************
!O2
..*****************************************************************************
'H|id' # 'H|sortgjgm' # 'H|budat:8' # 'H|bunummer' # 'H|buzn' #
..*****************************************************************************
!NEXT
..*****************************************************************************
.select continue
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.set reference -
.continue
