..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVFBBW.ZEILE
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Allgemeine FunktionalitÑt zu Buchungszeilen (vor allem PrÅfung der Daten)
.. Functionality  :
..*****************************************************************************
..
..
..*****************************************************************************
..
.set trans -
..
.copy M|tkontop = M|terpkonto^dnr<>5      ? _F|empty(M|terpkonto)
.copy M|tgegenp = M|terpgegenkonto^dnr<>5 ? _F|empty(M|terpgegenkonto)
..
.continue K1 ? _F|empty(M|tkonto)
.formula   M|tkonto        = F|condexpr(M|terpkonto^dnr = 5, F|condexpr(M|numsachkto, M|terpkonto^nummer, M|terpkonto^dvkto), F|condexpr(M|numperskto, M|terpkonto^nummer, M|terpkonto^dvkto))
!K1
.continue K2 ? _F|empty(M|tgegenkto)
.formula   M|tgegenkto     = F|condexpr(M|terpgegenkonto^dnr = 5, F|condexpr(M|numsachkto, M|terpgegenkonto^nummer, M|terpgegenkonto^dvkto), F|condexpr(M|numperskto, M|terpgegenkonto^nummer, M|terpgegenkonto^dvkto))
!K2
.formula   M|tgegenauto    = M|terpgegenkonto^dvktoauto ? _F|empty(M|terpgegenkonto)
..
.. Pruefungen
..
.formula M|tdatstatusz = G|icowarn ? M|trunddiff  <> 0
.formula M|tdatstatusz = G|icowarn ? M|tsteuerabw <> 0
..
.set trans +
.formula M|thinweise   = M|thinweise + ";" ? _F|empty(M|thinweise) & M|trunddiff <> 0
.formula M|thinweise   = M|thinweise + "Rundungsdifferenz vorhanden" ? M|trunddiff  <> 0
.formula M|thinweise   = M|thinweise + ";" ? _F|empty(M|thinweise) & M|tsteuerabw <> 0
.formula M|thinweise   = M|thinweise + "Steuerabweichung vorhanden"  ? M|tsteuerabw <> 0
.set trans -
..
!CHK01
.continue CHK02 ? _F|empty(M|tkonto)
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Kein Konto gefunden."
.set trans -
.continue CHK02
..
!CHK02
.continue CHK03 ? _F|empty(M|tgegenkto)
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Kein Gegenkonto gefunden."
.set trans -
.continue CHK03
..
!CHK03
.continue CHK04 ?  M|terpkonto^dnr = 5
.continue CHK04 ? +M|tkonto <= M|ktonrlgraufz2
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Kontonummer zu lang."
.set trans -
.continue CHK04
..
!CHK04
.continue CHK05 ?  M|terpkonto^dnr <> 5
.continue CHK05 ? +M|tkonto <= M|ktonrlgraufz
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Kontonummer zu lang."
.set trans -
.continue CHK05
..
!CHK05
.continue CHK06 ?  M|terpgegenkonto^dnr = 5
.continue CHK06 ? +M|tgegenkto <= M|ktonrlgraufz2
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Gegenkontonummer zu lang."
.set trans -
.continue CHK06
..
!CHK06
.continue CHK07 ?  M|terpgegenkonto^dnr <> 5
.continue CHK07 ? +M|tgegenkto <= M|ktonrlgraufz
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Gegenkontonummer zu lang."
.set trans -
.continue CHK07
..
.. HINWEISE ZU KONTONUMMERNLéNGEN AUS DEM DATEV SELF-LEITFADEN (KNE)
.. =================================================================
.. Gespeicherte SachkontonummernlÑnge
.. LÑnge der in den Stammdaten gespeicherten Sachkontonummern (zulÑssig: 4-8).
..
.. Aufgezeichnete SachkontonummernlÑnge
.. LÑnge der in den Daten aufgezeichneten Sachkontonummern (zulÑssig: 4-8).
..
.. Bitte beachten Sie, dass die aufgezeichnete SachkontonummernlÑnge nicht kleiner sein darf
.. als die beim Mandanten gespeicherte SachkontonummernlÑnge.
..
.. Die SachkontonummernlÑnge ist abhÑngig von der eingestellten LÑnge in den Mandanten-
.. programmdaten (Stammdaten). Folgende Mîglichkeiten bestehen:
..   - 4-stellige Sach- / 5-stellige Personenkonten (SachkontonummernlÑnge = 4)
..   - 5-stellige Sach- / 6-stellige Personenkonten (SachkontonummernlÑnge = 5)
..   - 6-stellige Sach- / 7-stellige Personenkonten (SachkontonummernlÑnge = 6)
..   - 7-stellige Sach- / 8-stellige Personenkonten (SachkontonummernlÑnge = 7)
..   - 8-stellige Sach- / 9-stellige Personenkonten (SachkontonummernlÑnge = 8)
.. Diese SachkontonummernlÑnge ist im Versionssatz nach dem Vorlauf entsprechend individuell
.. zu hinterlegen (siehe Fach 3, Kapitel 5.3.2). Wenn die KontonummernlÑnge in DATEV- und
.. Fremdprogramm unterschiedlich ist, dann kînnen keine Daten ausgetauscht werden.
..
.. FÅr einen Mandanten muss in allen Programmen, sowohl in DATEV- als auch in
.. Fremdprogrammen, fÅr ein Wirtschaftsjahr die neue KontonummernlÑnge festgelegt werden.
.. Die neue KontonummernlÑnge muss zu dem Zeitpunkt eingestellt sein, zu dem Daten
.. ausgetauscht werden sollen.
.. Der Umstieg auf lÑngere Kontonummern ist sowohl wÑhrend eines Wirtschaftsjahres als auch
.. beim Jahreswechsel mîglich. Eine Verkleinerung der KontenlÑnge ist nicht mehr mîglich.
.. Personenkonten werden genauso behandelt wie Sachkonten, sind aber automatisch eine Stelle
.. lÑnger als Sachkonten.
.. Die weiteren Ziffern werden am Ende der Kontonummer angefÅgt. Aus dem Konto 3000 wird
.. also 3000 0, 3000 00, 3000 000 oder 3000 0000.
.. Buchungen, die vor der Umstellung auf dem Konto 3000 gebucht waren, sind jetzt
.. automatisch auf dem Konto 3000 0 usw.
..
.continue CHK07
..
!CHK07
.continue CHK08 ? M|tdatum <= M|datbis
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Buchungsdatum > " + 'M|datbis'
.set trans -
.continue CHK08
..
!CHK08
.continue CHK09 ? _F|empty(M|twaehr^iso3a)
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "ISO-Code fÅr die WÑhrung " + 'M|twaehr' + " nicht gepflegt."
.set trans -
.continue CHK09
..
!CHK09
.continue CHK09A ? M|kneformat
.continue CHK09B
!CHK09A
.continue CHK10  ? F|abs(M|tbasiswaehrbetr) <= 9999999999.99
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Betrag in BasiswÑhrung zu gro·."
.set trans -
.continue CHK10
..
!CHK09B
.continue CHK10  ? F|abs(M|tbasiswaehrbetr) <=   99999999.99
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Betrag in BasiswÑhrung zu gro·."
.set trans -
.continue CHK10
..
!CHK10
.continue CHKEND ? _M|kneformat
.continue CHKEND ?  F|abs(M|tbruttoumsatz) <= 9999999999.99
.formula M|tdatstatusz = G|icoerror
.formula M|tdatfehler = M|tdatfehler + ";" ? _F|empty(M|tdatfehler)
.set trans +
.formula M|tdatfehler = M|tdatfehler + "Bruttoumsatz zu gro·."
.set trans -
.continue CHKEND
..
!CHKEND
.formula M|tdatstatusz = G|icook ? F|empty(M|tdatstatusz)
.formula M|texport     = G|TRUE  ? M|tdatstatusz = G|icook ; M|tdatstatusz = G|icowarn
.continue END
..
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
