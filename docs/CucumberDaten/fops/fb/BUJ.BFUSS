.set trans -
..
.. variables defined in fb/BUJ.TAB. If there are no rows in the result set
.. these variables are not defined yet
.type real xrhsum      ? _F|defined(U|xrhsum)
.type real xrssum      ? _F|defined(U|xrssum)
.type real xrssumpfix  ? _F|defined(U|xrssumpfix)
.type real xrhsumpfix  ? _F|defined(U|xrhsumpfix)
.type real xrssumpprop ? _F|defined(U|xrssumpprop)
.type real xrhsumpprop ? _F|defined(U|xrhsumpprop)
.type text xtbalt xtfstd xtfh1 xtfh2   ?_F|defined(U|xtbalt)
.type integer xi xisum                     ?_F|defined(U|xi)
..*****************************************************************************
..
.formula M|sollsum  = U|xrssum
.formula M|habensum = U|xrhsum
..
.continue END ? M|istyp = 0
..
.formula M|ssumpfix  = U|xrssumpfix
.formula M|hsumpfix  = U|xrhsumpfix
.formula M|ssumpprop = U|xrssumpprop
.formula M|hsumpprop = U|xrhsumpprop
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

