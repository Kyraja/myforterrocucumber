.formula xmp = xmp + xmr               ?   xkenn / "*p*"
.formula xmk = xmk + xmr               ?   xkenn / "*k*"
.formula xjl = xjl + xjr               ?   xkenn / "*l*"
.formula xjp = xjp + xjr               ?   xkenn / "*p*"
.formula xjk = xjk + xjr               ?   xkenn / "*k*"
