.continue PKALFE4                   ?  _(xnam / (dblquote + "*" + dblquote)) & (+xnam > 0)
.continue PKAZHOL                   ?  _((xart = "V") ; (xart = "E") ; (xtwat = "E"))
.budget 'xkber'
.formula xmr = hsum - ssum             ?   xart / "*V*"
.formula xmr = ssum - hsum             ?   xart / "*E*"
