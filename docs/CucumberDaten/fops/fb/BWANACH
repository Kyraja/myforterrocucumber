..
.. ---------------------------------------------------------------------------------------------------------------------------------
.. Berechnung der %-Werte im Kontennachweis zum Vergleich mit dem Vorjahr
.. ---------------------------------------------------------------------------------------------------------------------------------
..
!BERPRW
..
..     Formel  ((neu - alt) / Abs alt) * 100 = Ergebnis [%]
..     Differenz
..
.formula xt1    = ""
.formula xt2    = ""
.formula xdiff1 = xrzw1 - xrzw2
..
..  Ist alt == 0 und neu != 0  -> Ergebnis = ~ (unendlich)
.formula xt1 = "~"                     ?  xrzw2 = 0.0  &  xrzw1 > 0.0
.formula xt1 = "-~"                    ?  xrzw2 = 0.0  &  xrzw1 < 0.0
.continue BPRWJA                    ?  xt1 = "~"  ;  xt1 = "-~"
..
..  leere Ausgabe, wenn xrzw1 == 0 && xrzw2 == 0
.formula xt1   = " "                   ?  xrzw1 = 0.0  &  xrzw2 = 0.0
.continue BPRWJA                    ?  xt1 = " "
..
..  Absolutwerte
.formula xrzw2  =-xrzw2                ?  xrzw2 < 0.0
..
..  % ausrechnen
.formula xrzw1 = (xdiff1 / xrzw2) * 100
.formula xt1   = xrzw1
..
!BPRWJA: Jahreswerte
..
.formula xdiff2 = xrzw3 - xrzw4
..
.formula xt2 = "~"                     ?  xrzw4 = 0.0  &  xrzw3 > 0.0
.formula xt2 = "-~"                    ?  xrzw4 = 0.0  &  xrzw3 < 0.0
.continue 'xtretm'                  ?  xt2 = "~"  ;  xt2 = "-~"
..
.formula xt2   = " "                   ?  xrzw3 = 0.0  &  xrzw4 = 0.0
.continue 'xtretm'                  ?  xt2 = " "
..
.formula xrzw4  =-xrzw4                ?  xrzw4 < 0.0
..
.formula xrzw3 = (xdiff2 / xrzw4) * 100
.formula xt2   = xrzw3
..
.formula xt2   = " "                   ?  xdiff2 = 0.0  &  xrzw4 = 0.0
.continue 'xtretm'
