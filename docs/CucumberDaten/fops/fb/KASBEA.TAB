..!interpreter declaration english translate
..*****************************************************************************
..
..  FOP-Name       : KASBEV.TAB
..  Datum          : 31.1.2005
..  Version        : 1
..  Autor          : uo
..  Verantwortlich : cl
..  Kontrolle      : mh
..
..  Funktion       : Kassenbuchzeilen holen und Einnahmen-/Ausgabentabelle fÅllen
..  Ablauf         :
..
..*****************************************************************************
..
.type real xrkbanf   ? _F|defined(U|xrkbanf)
.type real xrcdiff   ? _F|defined(U|xrcdiff)
..
..*****************************************************************************
.set trans -
.continue END ? H|gj = M|anfj & H|gm < M|anfm
.continue END ? H|gj = M|endj & H|gm > M|endm
..
.formula U|xicount   = U|xicount + 1
..
.formula U|xrkbanf   = H|anfbest
..
.formula M|anfbest = H|anfbest ? U|xicount = 1
..
..*****************************************************************************
!NEXTROW: Fetches the next row
..*****************************************************************************
.select line
.continue END     ? _G|mehr ; +'H|budat' > 0 & H|budat > M|bis
.continue NEXTROW ? +'H|budat' > 0 & H|budat < M|von
..
.formula U|xrcdiff   = 0.00
.formula U|xrcdiff   = U|xrkbanf - U|xrlastend            ? U|xrkbanf <> U|xrlastend & U|xicount > 1 & H|aktzeile = 1
.formula U|xrdiff    = U|xrdiff  + U|xrcdiff
..
.make screen line +O
..
.assign M|tkbuch    = H|id
.formula   M|tbeleg    = H|beleg
.formula   M|tbutext   = H|butext
.formula   M|tbeldat   = H|beldat
.formula   M|tbudat    = H|budat
.formula   M|tbeinn    = H|beinn
.formula   M|tbausg    = H|bausg
.formula   M|tbestand  = H|bestand
.formula   M|tsh       = "S"         ?  H|bausg  >= 0  & H|beinn = 0
.formula   M|tsh       = "H"         ?  H|beinn  > 0   & H|bausg = 0
.formula   M|tgegenkto = H|gegenkto
.assign M|tkstelle  = H|kstelle
.formula   M|tstbetr   = H|stbetr
.formula   M|tnet      = H|nhbetr    ?  H|nhbetr > 0   & H|nsbetr = 0
.formula   M|tnet      = H|nsbetr    ?  H|nsbetr > 0   & H|nhbetr = 0
..
.formula   M|tstatusz  = G|icook     ? U|xrcdiff  = 0.00
.formula   M|tstatusz  = G|icowarn   ? U|xrcdiff <> 0.00
..
.formula U|xrlastend = H|bestand
.formula U|xrsumein  = U|xrsumein + H|beinn
.formula U|xrsumaus  = U|xrsumaus + H|bausg
..
.chart -VALUE 'H|bestand'
..
.continue NEXTROW
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
