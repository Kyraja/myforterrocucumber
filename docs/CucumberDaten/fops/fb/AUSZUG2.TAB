..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : AUSZUG2.TAB
..  Datum          : 29.11.2010
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Tabellenzeig-FOP des Infosystems fb/AUSZUG2
..  Functionality  : Table FOP of the Infosystem fb/AUSZUG2.
..*****************************************************************************
..
.set trans -
..
.continue END ?  U|xplastentry = 1|buchung^id
..
.formula U|xirowcount = U|xirowcount + 1
..
.load 5 add 1|buchung^id
..*****************************************************************************
!LOOP
..*****************************************************************************
.load 5 line
.continue END ? _G|mehr
.make screen line +O
.formula   M|tbuzeile = 5|zn
.copy M|tstrgl = 5|strgl ? 5|gruppe = 0
.assign M|tbuchung = 5|id
.copy M|tprojekt = 5|projekt
.copy M|tbudat   = 5|budat
.formula   M|tbeleg   = 5|beleg
.formula   M|tebeleg  = 5|ebeleg ? F|defined(5|ebeleg)
.copy M|tbeldat  = 5|beldat
.formula   M|tbumonat = 5|monat
.formula   M|tkenn    = 5|kenn
.copy M|tkonto   = 5|konto
.assign M|tkst     = F|condexpr(U|xbcost & 5|zn=1|zn, M|konto, 5|kstelle)
.copy M|tbubetr  = 5|betrag
.assign M|tbush    = F|condexpr(5|soll, "(83)", "(72)")
.formula   M|tbutext  = F|condexpr(F|empty(5|ptext), 5|text, 5|ptext)
.assign M|tsts     = F|condexpr(F|defined(5|steuer), 5|steuer^id, "")
.assign M|tustva   = F|condexpr(F|defined(5|ustva), 5|ustva^id, "")
.formula   M|tkvnum   = 5|kvnum     ?  5|gruppe = 0
.copy M|thaben   = M|tbubetr  ? _5|soll
.copy M|tsoll    = M|tbubetr  ?  5|soll
.formula   M|tzntyp   = F|condexpr(U|xbcost, F|condexpr(M|tkst^id=M|konto^id, 1, 0), F|condexpr(M|tkonto^id=M|konto^id, 1, 0))
.colour -background 'F|condexpr(F|expr(U|xirowcount//2)=0, U|xabasgroupdark, U|xabasgrouplight)' 'M|aktzeile'
.continue SUM
..
..*****************************************************************************
!SUM
..*****************************************************************************
.continue NEXT ? M|tzntyp = 0
..
.formula M|sumsoll   = M|sumsoll  + M|tsoll
.formula M|sumhaben  = M|sumhaben + M|thaben
..
.formula U|xrbubetr  = (M|tsoll - M|thaben) * U|xifactor
..
.formula U|xrkosaldo = U|xrkosaldo + U|xrbubetr  ? _U|xbbackward
.formula U|xrkosaldo = U|xrkosaldo - U|xrbubetr  ?  U|xbbackward
..
..*****************************************************************************
!NEXT
..*****************************************************************************
.formula M|tsumsoll  = M|sumsoll
.formula M|tsumhaben = M|sumhaben
.formula M|tsaldo    = U|xrkosaldo
.continue LOOP
..
..*****************************************************************************
!END
..*****************************************************************************
.copy U|xplastentry = 1|buchung^id
.continue
