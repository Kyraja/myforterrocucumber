..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.SUM
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Insert sums into the Infosystem fb/VKZ
..*****************************************************************************
..
.set trans -
..
.continue RESET ? F|empty(U|xplstaat) & M|grpnachstaat
.continue RESET ? F|empty(U|xplverd)  & M|grpnachverd
..
.make screen line +O
.colour -background 'U|xabassubtotal' 'M|aktzeile' ? _M|keineeinzel & G|grafik
.copy M|tstaat = U|xplstaat
.copy M|tverd  = U|xplverd
.set trans +
.formula M|tbezeichnung = "Summe " + M|tstaat^rnamebspr ? M|grpnachstaat
.formula M|tbezeichnung = "Summe " + M|tverd^namebspr + " (" + M|tverd^nummer + ")"  ? M|grpnachverd
.set trans -
.formula M|tsumflag = 1
.formula U|xperiod = 1
..*****************************************************************************
!LOOP1
..*****************************************************************************
.continue RESET ? U|xperiod > M|maxperiod
.formula M|tasoll.U|xperiod     = U|xranfsolsum.U|xperiod
.formula M|tahaben.U|xperiod    = U|xranfhabensum.U|xperiod
.formula M|tvkzsoll.U|xperiod   = U|xrvkzssum.U|xperiod
.formula M|tvkzhaben.U|xperiod  = U|xrvkzhsum.U|xperiod
.formula M|tgssum.U|xperiod     = U|xrgssum.U|xperiod
.formula M|tghsum.U|xperiod     = U|xrghsum.U|xperiod
.formula M|tesoll.U|xperiod     = U|xrendsolsum.U|xperiod
.formula M|tehaben.U|xperiod    = U|xrendhabensum.U|xperiod
.formula M|tumsatz.U|xperiod    = U|xrumsatz.U|xperiod
.formula M|tbuumsatz.U|xperiod  = U|xrbuumsatz.U|xperiod
.formula U|xperiod = U|xperiod + 1
.continue LOOP1
..
..*****************************************************************************
!RESET
..*****************************************************************************
.formula U|xperiod = 1
..*****************************************************************************
!LOOP2
..*****************************************************************************
.continue END ? U|xperiod > M|maxperiod
.formula U|xranfsolsum.U|xperiod   = 0
.formula U|xranfhabensum.U|xperiod = 0
.formula U|xrvkzssum.U|xperiod     = 0
.formula U|xrvkzhsum.U|xperiod     = 0
.formula U|xrgssum.U|xperiod       = 0
.formula U|xrghsum.U|xperiod       = 0
.formula U|xrendsolsum.U|xperiod   = 0
.formula U|xrendhabensum.U|xperiod = 0
.formula U|xrumsatz.U|xperiod      = 0
.formula U|xrbuumsatz.U|xperiod    = 0
.formula U|xperiod = U|xperiod + 1
.continue LOOP2
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

