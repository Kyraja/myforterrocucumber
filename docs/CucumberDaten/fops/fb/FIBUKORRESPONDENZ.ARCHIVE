.set trans -
..
.. Declarations
.type VID99 xid          ? _F|defined(U|xid)
.type text  xbeldat      ? _F|defined(U|xbeldat)
.type VP16  xpartner     ? _F|defined(U|xpartner)
..
.continue MAHNUNG   ? M|dnr = 104 & M|gruppe = 1
.continue BUCHUNG   ? M|dnr = 6
.continue BUCHUNG   ? M|dnr = 110
.continue END
!MAHNUNG
