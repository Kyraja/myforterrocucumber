..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LIQPLANDETAILS.SET.NAME
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Setzt die Bezeichnung fuer die Belegart in der Tabelle
.. Functionality  : Sets the document type name
..*****************************************************************************
..
.set trans -
..
.continue PURCH ? M|tbeleg^dnr = 4
.continue SALES ? M|tbeleg^dnr = 3
..
.formula M|tbelegtyp = M|tbeleg^grbez
.continue END
..
..*****************************************************************************
!PURCH
..*****************************************************************************
.formula M|tbelegtyp = F|value(M|tbeleg^kopf^typ, "A4") + " (" ? _F|empty(M|tbeleg^kopf)
.formula M|tbelegtyp = M|tbelegtyp + F|value(M|tbeleg^typ, "A4")
.continue CLOSE
..
..*****************************************************************************
!SALES
..*****************************************************************************
.formula M|tbelegtyp = F|value(M|tbeleg^kopf^typ, "A5") + " (" ? _F|empty(M|tbeleg^kopf)
.formula M|tbelegtyp = M|tbelegtyp + F|value(M|tbeleg^typ, "A5")
..
..*****************************************************************************
!CLOSE
..*****************************************************************************
.formula M|tbelegtyp = M|tbelegtyp + ")" ? _F|empty(M|tbeleg^kopf)
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

