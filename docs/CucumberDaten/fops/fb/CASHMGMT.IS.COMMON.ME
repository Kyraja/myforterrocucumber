..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CASHMGMT.IS.COMMON.ME
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Maskeneintritts-FOP
.. Functionality  : Screen enter FOP
.. include fb/CASHMGMT.IS.COMMON.INIT
..*****************************************************************************
..
.set trans -
..
.select pmasterfiles "$,@gruppe=1;gruppe=1"
.continue C1 ? _G|mehr
.assign M|zvkonfig = H|id ? F|defined(M|zvkonfig)
.copy M|planszenario = H|lqplanszenario
!C1
.copy M|stichtag    = G|datum
.copy M|auswaehr    = G|inland
.copy M|buwaehr     = G|inland ? F|defined(M|buwaehr)
.copy M|bukreis     = G|bukreis ? F|defined(M|bukreis)
.formula   M|zeiteinheit = "(Week)"
.formula   M|zefaktor = 1
.file -screen -tempname M|daten -suffix "liq/XXX"
.. create directory structure for data file
.system 'F|formatstr("mkdir -p $(dirname {1})", M|daten)' background
.input "fb/CASHMGMT.IS.COMMON.INIT"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

