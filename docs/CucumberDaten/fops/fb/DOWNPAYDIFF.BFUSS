..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : DOWNPAYDIFF.BFUSS
..  Autor          : cl
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       :
..
..*****************************************************************************
.set trans -
.type integer  xtzeile       ? _F|defined(U|xtzeile)
..
.continue ERROR1     ?  M|tzeilen = 0
..
!HEADER: Zeilen ohne Erfassungsbetrag loeschen
.select screen header
.formula U|xtzeile = M|tzeilen
..
!SELLINE
.select screen line 'U|xtzeile'
.continue WEITER ? _G|mehr
.make screen line -O ? F|empty(M|erfbetr) & F|empty(M|preis)
.formula U|xtzeile = U|xtzeile - 1
.continue END    ? U|xtzeile = 0
.continue SELLINE
..
.. *****************************************************************************
!END
.continue
..
!ERROR1
.note Kein(e) Treffer vorhanden!
.assign M|treffer = G|FALSE
.continue

