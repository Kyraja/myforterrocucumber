..!interpreter english translate
..*****************************************************************************
..
..  Name      : BILKON.WERT
..  Datum     : 16.07.96
..  Vers.     : 7.1
..  Autor     : Andrzej Klusek
..
..  Verantwortlich : hc
..  Kontrolle      : mh
..
..
..  Funktion  : BILKON.WERT wird aus BILKON.HOL/BILKON.KONTO aufgerufen
..
..  Ablauf    : Mit .budget oder .hol konto wurden schon die VKZahlen geholt
..              DB_Var. in LGP_Var. speichern
..
..  Input     : -
..  Output    : xriazw xrazw xriezw xrezw
..
..*****************************************************************************
..                           SUBROUTINE
..                           ----------
..
.end .                  ?  txname / "*BILKON.WERT"
..*****************************************************************************
.set trans -
.continue VB70             ?  xk = "gv"
..
..  Bilanz
.continue VB50             ?  xips = 2
..
..  Ist Zahlen
..  Endsaldo im Zeitraum
.formula xriezw = esaldo      ?  xart = "es"
.formula xriezw = nesaldo     ?  xart = "ns"
.formula xriezw = esoll       ?  xart = "so"
.formula xriezw = ehaben      ?  xart = "ha"
.formula xrezw  = xriezw
..
..  Anfsaldo im Zeitraum
.formula xriazw = asaldo      ?  xart = "es"
.formula xriazw =-asaldo      ?  xart = "ns"
.formula xriazw = asaldo      ?  xart = "so"  &  asaldo >  0.0
.formula xriazw = 0.0         ?  xart = "so"  &  asaldo <= 0.0
.formula xriazw =-asaldo      ?  xart = "ha"  &  asaldo <  0.0
.formula xriazw = 0.0         ?  xart = "ha"  &  asaldo >= 0.0
.formula xrazw  = xriazw
.continue VB80
..
!VB50: Plan Zahlen
.formula xriezw = pesaldo     ?  xart = "es"
.formula xriezw =-pesaldo     ?  xart = "ns"
.formula xriezw = pesaldo     ?  xart = "so"  &  pesaldo >  0.0
.formula xriezw = 0.0         ?  xart = "so"  &  pesaldo <= 0.0
.formula xriezw =-pesaldo     ?  xart = "ha"  &  pesaldo <  0.0
.formula xriezw = 0.0         ?  xart = "ha"  &  pesaldo >= 0.0
.formula xrezw  = xriezw
..
.formula xriazw = pasaldo     ?  xart = "es"
.formula xriazw =-pasaldo     ?  xart = "ns"
.formula xriazw = pasaldo     ?  xart = "so"  &  pasaldo >  0.0
.formula xriazw =  0.0        ?  xart = "so"  &  pasaldo <= 0.0
.formula xriazw =-pasaldo     ?  xart = "ha"  &  pasaldo <  0.0
.formula xriazw =  0.0        ?  xart = "ha"  &  pasaldo >= 0.0
.formula xrazw  = xriazw
.continue VB80
..
!VB70: GuV
.formula xriezw =-ssum  + hsum   ?  xart = "V"  &  xips = 1
.formula xriezw = ssum  - hsum   ?  xart = "E"  &  xips = 1
.formula xriezw =-pssum + phsum  ?  xart = "V"  &  xips = 2
.formula xriezw = pssum - phsum  ?  xart = "E"  &  xips = 2
.formula xrezw  = xriezw
..
..  Žndert sich in der folge Zeile (xnam == "") die Art (V->E or E->V),
..  wird xriezw als inverse Zahl gemerkt.
.formula xriezw =-xriezw      ?  xa <> xart  &  xart <> ""
..
!VB80: Bilanz + GuV gemeinsam
.continue VB85             ? _(xwastun = 2  ;  xwastun = 4)
..
..  Ausgabe mit GesamtVKZ - Zeitraumwerte ermitteln
..  Sonderbehandlung fr Bilanzkonten im 1. und 2. Zeitraum (SKS Bsp.)
..  Es werden nur Werte aus dem Bereich Anfangsmonat - Endemonat ermittelt
.continue VB85             ?  xk = "gv"  ;  xii > 2
.formula xriezw = xriezw - xriazw
..fo xriezw = ssum - hsum ? xart = "so" ; xart = "ha"
.formula xrezw  = xriezw
..
!VB85
.continue
