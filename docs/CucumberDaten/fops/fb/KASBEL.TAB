..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : KASBEL.TAB
..  Datum          : 11.04.2006
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Tabellen-FOP des Infosystems fb/KASBEL
..
..  Program flow  :
... Includes      :
..*****************************************************************************
.set trans -
.type text xtsel     ? _F|defined(U|xtsel)
..
.select line 'H|selzeile'
..
.make screen line +O
.formula M|tbeleg  = H|beleg
.formula M|tbutext = H|butext
.formula M|tbeldat = H|beldat
.formula M|tbeinn  = H|beinn
.formula M|tbausg  = H|bausg
.formula M|sts     = H|sts
.assign M|strgl    = H|strgl
.formula M|budat   = H|budat
.formula U|xtsel = "$,,kopf^id="+H|sts^id+";gvon<="+'H|budat:8'+";gbis>="+'H|budat:8'+";@gruppe=11"
.load 1 taxcode 'U|xtsel'
.continue ERROR1 ? _G|mehr
.formula M|psatz      = 1|psatz
.load 1
..
.output addedto 'U|xtmpfile'
'M|psatz'
.output
..
.formula M|tstbetr = 0
.formula M|tstbetr = + H|stbetr ? H|beinn > 0 & H|bausg = 0
.formula M|tstbetr = - H|stbetr ? H|bausg > 0 & H|beinn = 0
.formula M|tstbetr = + H|stbetr ? H|beinn < 0 & H|bausg = 0
.formula M|tstbetr = - H|stbetr ? H|bausg < 0 & H|beinn = 0
..
.formula M|sumst   = M|sumst  + M|tstbetr
.formula M|sumein  = M|sumein + M|tbeinn
.formula M|sumaus  = M|sumaus + M|tbausg
..
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR1
.error Keinen Steuersatz gefunden.
.end 1
