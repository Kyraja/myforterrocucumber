..!interpreter english translate noabbrev
..*****************************************************************************
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : common event FOP of the Infosystem fb/RECONCILEECSALESLIST
..*****************************************************************************
..
..!meta M|=fb/RECONCILEECSALESLIST
..
.set trans -
..
.input "is/TABLEEREN" ? G|evtartengl = "FIELD_EXIT" ; G|evtartengl = "BUTTON_AFTER"
..
.continue START     ? G|evtvar = "bstart" & G|evtartengl = "BUTTON_AFTER"
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.formula M|select = "$,@gruppe=0;@zeilen=(1);gruppe=0;0:typ==1;0:laart==(EUCountry);0:ev<>(Purchasing);0:kart<>(TaxAccount)"
.formula M|select = M|select + F|formatstr(";0:zmart=={1}", F|value(M|selzmart, "AS234")) ? _F|empty(M|selzmart)
.formula M|select = M|select + F|formatstr(";0:ustva=={1}", M|selustva^id) ? _F|empty(M|selustva)
.formula M|select = M|select + F|formatstr(";0:budat={1}!{2};1:bukreis=={3}", M|adatum, M|edatum, M|bukreis^id)
.formula M|select = M|select + ";@ordnung=nummer"
.input "is/HOL.LISTE"
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
