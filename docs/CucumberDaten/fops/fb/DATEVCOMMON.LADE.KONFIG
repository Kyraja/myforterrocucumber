..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEVCOMMON.LADE.KONFIG
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Laden der DATEV-Konfiguration
.. Functionality  :
..*****************************************************************************
..
..
..*****************************************************************************
.set trans -
.copy M|kneformat      = M|datevkonfig^kneformat
.copy M|expkostobj     = M|datevkonfig^expkostobj
.copy M|beratnum       = M|datevkonfig^beratnum
.copy M|beratname      = M|datevkonfig^beratname
.copy M|beratkrzl      = M|datevkonfig^beratkrzl
.copy M|mandnummer     = M|datevkonfig^mandnummer
.copy M|beratpw        = M|datevkonfig^beratpw
.copy M|expverz        = M|datevkonfig^expverz
.copy M|numperskto     = M|datevkonfig^numperskto
.copy M|numsachkto     = M|datevkonfig^numsachkto
.copy M|ktonrlgraufz   = M|datevkonfig^ktonrlgraufz
.copy M|ktonrlgrgesp   = M|datevkonfig^ktonrlgrgesp
.copy M|gerundkurs     = M|datevkonfig^gerundkurs
.copy M|sumktoexp      = M|datevkonfig^sumktoexp
.formula   M|ktonrlgraufz2  = 0
.formula   M|ktonrlgrgesp2  = 0
.continue END ? F|empty(M|datevkonfig)
..
.formula   M|ktonrlgraufz   = 4 ? _M|kneformat
.formula   M|ktonrlgrgesp   = 4 ? _M|kneformat
..
.formula   M|ktonrlgraufz2  = M|ktonrlgraufz + 1
.formula   M|ktonrlgrgesp2  = M|ktonrlgrgesp + 1
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
