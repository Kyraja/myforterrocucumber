..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : LBU.BKOPF
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Infosystem, Liste Buchungen, Berichtskopf
..  Functionality  : Report header of the Infosystem LBU
..*****************************************************************************
..
.type integer  ximodulo
.type text xtgegen
.type text xtgegla
.type bool xbwrn01
.type ID5  xkst
.type ID86 xprojekt
..
..*****************************************************************************
..
.set trans -
..
.copy U|xkst = M|kst
.formula M|sollsum    = 0
.formula M|habensum   = 0
.formula M|bewegsaldo = 0
.formula M|esaldo     = 0
..
.input "is/ABASFARBEN.DEF"
..
.type integer xijkenn
.type text xtajkenn
.formula U|xtajkenn = M|jkenn
!JK
.continue EJK ? F|empty(F|trim(U|xtajkenn))
.formula U|xijkenn         = U|xijkenn + 1
.type text xtjkenn.xijkenn
.formula U|xtjkenn.U|xijkenn = U|xtajkenn << ","
.formula U|xtjkenn.U|xijkenn = U|xtjkenn.U|xijkenn << " "
.formula U|xtajkenn        = U|xtajkenn >> ","
.continue JK
!EJK
.type integer ximaxjkenn
.formula U|ximaxjkenn = U|xijkenn
.continue END
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
