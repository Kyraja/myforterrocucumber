..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.OUT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Outputs matching records (accounts) to a file
..
.. include fb/VKZ.FILTER
..
..*****************************************************************************
..
.set trans -
..
.input "fb/VKZ.FILTER"
.continue END ? U|xbfiltered
.copy U|xpverd  =H|verd
.copy U|xpverd  =M|stdverdku ? F|empty(U|xpverd) & H|dnr=0
.copy U|xpverd  =M|stdverdli ? F|empty(U|xpverd) & H|dnr=1
.copy U|xpverd  =M|stdverdma ? F|empty(U|xpverd) & H|dnr=11
'H|id' # 'H|dnr' # 'H|nummerb' # 'H|staat^rnamebspr' # 'H|staat^id' # 'U|xpverd^nummerb' # 'U|xpverd'
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
