..!interpreter english translate noabbrev
..*****************************************************************************
.. Author         : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : 
..*****************************************************************************
..
..!meta M|=fb/ZM
..
.set trans -
..
.copy    M|twaehr = M|auswaehr
.copy    M|tdreieck = 'M|tzmart(L=":")' = "(TriangularTrade)"
.formula M|tbetrvk = F|trunc(M|tbetrag)
.formula M|tiso2 = 'F|substr(M|tustidges, 1, 2)'
.formula M|tustid = 'F|substr(M|tustidges, 3)'
.load 0 'G|hdatname97' 'F|formatstr("$,,@gruppe=1;@maxtreffer=1;egkenn=={1}", M|tiso2)'
.assign M|tstaat = 0|id ? G|mehr
.continue END ? _F|empty(M|tstaat)
.load 0 'G|hdatname97' 'F|formatstr("$,,@gruppe=1;@maxtreffer=1;iso2=={1}", M|tiso2)'
.assign M|tstaat = 0|id ? G|mehr
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
