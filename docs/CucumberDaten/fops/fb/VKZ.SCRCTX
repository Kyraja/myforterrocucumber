..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKZ.SCRCTX
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : Set visibility flags
..*****************************************************************************
..
.set trans -
..
.type bool xbshowall            ? _F|defined(U|xbshowall)
.type bool xbwithaccounts       ? _F|defined(U|xbwithaccounts)
.type bool xbwithcountries      ? _F|defined(U|xbwithcountries)
.type bool xbwithconsol         ? _F|defined(U|xbwithconsol)
.type bool xbwithturnovers      ? _F|defined(U|xbwithturnovers)
.type bool xbwithpoturnovers    ? _F|defined(U|xbwithpoturnovers)
.type bool xbwithtotaltrfigures ? _F|defined(U|xbwithtotaltrfigures)
.type bool xbwithplan           ? _F|defined(U|xbwithplan)
..
.copy U|xbshowall            =  G|FALSE
..
.continue ALL ? U|xbshowall
..
.copy U|xbwithaccounts       = _M|keineeinzel ; U|xbshowall
.copy U|xbwithcountries      =  (M|grpnachstaat ; _M|keineeinzel) & _M|grpnachverd
.copy U|xbwithconsol         =  M|grpnachverd ; _M|keineeinzel ; U|xbshowall
.copy U|xbwithturnovers      =  M|mitumsatz   ; U|xbshowall
.copy U|xbwithpoturnovers    =  (M|mitbuumsatz & _F|empty(M|buumzabdat)) ; U|xbshowall
.copy U|xbwithtotaltrfigures =  M|mitgvkz ; U|xbshowall
.copy U|xbwithplan           =  M|bmitplanumsatz
.continue SET
..
!ALL
.copy U|xbwithaccounts       = G|TRUE ? U|xbshowall
.copy U|xbwithcountries      = G|TRUE ? U|xbshowall
.copy U|xbwithconsol         = G|TRUE ? U|xbshowall
.copy U|xbwithturnovers      = G|TRUE ? U|xbshowall
.copy U|xbwithpoturnovers    = G|TRUE ? U|xbshowall
.copy U|xbwithtotaltrfigures = G|TRUE ? U|xbshowall
.continue SET
..
!SET
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = P|maskkontextfop + " WITH_ACCOUNTS"          ? U|xbwithaccounts
.formula P|maskkontextfop = P|maskkontextfop + " WITH_COUNTRIES"         ? U|xbwithcountries
.formula P|maskkontextfop = P|maskkontextfop + " WITH_CONSOL"            ? U|xbwithconsol
.formula P|maskkontextfop = P|maskkontextfop + " WITH_TURNOVERS"         ? U|xbwithturnovers
.formula P|maskkontextfop = P|maskkontextfop + " WITH_PO_TURNOVERS"      ? U|xbwithpoturnovers
.formula P|maskkontextfop = P|maskkontextfop + " WITH_TOTAL_TR_FIGURES"  ? U|xbwithtotaltrfigures
.formula P|maskkontextfop = P|maskkontextfop + " WITH_PLAN"              ? U|xbwithplan
..
.protection -hidden        -column tkonto       ? _U|xbwithaccounts
.protection -hidden -reset -column tkonto       ?  U|xbwithaccounts
.. .protection -hidden        -column tbezeichnung ? _U|xbwithaccounts
.protection -hidden -reset -column tbezeichnung ?  U|xbwithaccounts
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
