..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : KBFORMBILGUV.BKOPF
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : mh
..  Funktion       : Berichtskopf der Infosysteme
..                   fb/KBFORM, fb/BILANZ, fb/BILANZNACH, fb/GUV, fb/GUVNACH etc.
..  Functionality  : Report header of the infosystems
..                   fb/KBFORM, fb/BILANZ, fb/BILANZNACH, fb/GUV, fb/GUVNACH etc.
..*****************************************************************************
..
.type integer  xirownumber
..
.. tree level of previous row
.type ID68 xpgruppe1
.type AN90 xereregeln
.. Actual values available ?
.type bool xbhasvalues
.. Planning values available ?
.type bool xbhasvaluesp
.type integer  xizstufe
..
.. Flags, welche Zahlen im konkreten IS benoetigt werden
.type bool xbmitplan
.type bool xbsalden
.type bool xbshsum
..
..*****************************************************************************
..
.set trans -
..
.formula U|xpgruppe1 = F|condexpr(G|evtzeile = 0, "(0,0,0)", M|tgruppe1)
.formula U|xbmitplan = F|condexpr(F|defined(M|mitplan), M|mitplan, G|false)
.formula U|xbsalden  = F|condexpr(F|defined(M|salden), M|salden, G|false)
.formula U|xbshsum   = F|condexpr(F|defined(M|shsum), M|shsum, G|false)
..
.. Definition der Arrays fuer Zahlen
.formula U|xizraum = 0
!LOOP
.formula U|xizraum = U|xizraum + 1
.continue END       ? U|xizraum > M|maxperiod
.type real xrbetrag.xizraum
.type real xrbetragp.xizraum
.type real xrasaldo.xizraum
.type real xresaldo.xizraum
.type real xrssum.xizraum
.type real xrhsum.xizraum
.continue LOOP
..
..*****************************************************************************
!END: End
..*****************************************************************************
.continue
