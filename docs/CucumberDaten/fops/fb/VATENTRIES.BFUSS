..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VATENTRIES.BFUSS
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Berichtsfuss des Infosystems fb/VATENTRIES
.. Functionality  : Report footer of the Infosystem fb/VATENTRIES
..*****************************************************************************
..
.set trans -
..
.formula M|saldo = M|soll - M|haben
..
.continue END ? _M|summen
..
.output terminal
.make screen line --
.continue END ? _F|filenotempty(U|xtmp)
.type text xstdout xstderr xsys
.type bool xbmehr
.file -tempname U|xstdout
.file -tempname U|xstderr
.formula U|xsys = "group_by.sh -n 9 "
.type integer xi ? _F|defined(U|xi)
.formula U|xi = 0
!L1
.formula U|xi = U|xi + 1
.continue L2 ? U|xi > 5
.type text xk.xi
.formula U|xk.U|xi = "-k 1" ? M|kontogrp   = U|xi
.formula U|xk.U|xi = "-k 5" ? M|ustartgrp  = U|xi
.formula U|xk.U|xi = "-k 6" ? M|steuergrp  = U|xi
.formula U|xk.U|xi = "-k 8" ? M|ustvagrp   = U|xi
.formula U|xk.U|xi = "-k 9" ? M|buwaehrgrp = U|xi
.formula U|xsys = U|xsys + " " + U|xk.U|xi ? _F|empty(U|xk.U|xi)
.continue L1
!L2
.formula U|xsys = U|xsys + " -o 1 " ? M|kontogrp  = 0 & _F|empty(M|konto)
.formula U|xsys = U|xsys + " -o 5 " ? M|ustartgrp = 0 & _F|empty(M|ustart)
.formula U|xsys = U|xsys + " -o 6 " ? M|steuergrp = 0 & _F|empty(M|steuer)
.formula U|xsys = U|xsys + " -k 7 "
.formula U|xsys = U|xsys + " -o 8 " ? M|ustvagrp = 0  & _F|empty(M|ustva)
.formula U|xsys = U|xsys + " -o 9 " ? M|buwaehrgrp = 0  & _F|empty(M|buwaehr)
.formula U|xsys = U|xsys + " -s 2 -s 3 -s 4 "
.formula U|xsys = U|xsys + " -c "
.formula U|xsys = U|xsys + " " + U|xtmp + " 1> " + U|xstdout + " 2> " + U|xstderr
.system 'U|xsys' background
.copy U|xbmehr = G|mehr
.input -text 'U|xstderr' ? _U|xbmehr
.end 1 ? _U|xbmehr
.continue LOOP
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.make screen line +O
.select from 'U|xstdout' M|tkonto # M|tsoll # M|thaben # M|tsaldo # M|tustart # M|tsteuer # M|tstrgl # M|tustva # M|tbuwaehr # M|tanzahl^
.continue LOOP  ? G|mehr
.make screen line -O
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue

