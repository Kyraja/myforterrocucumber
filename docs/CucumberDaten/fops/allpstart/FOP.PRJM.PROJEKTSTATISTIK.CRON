.formula H|ystdistvksatz = 0                            ? H|ystdist =  0
.formula H|ystdistvksatz = H|yvkreeigenleist / H|ystdist      ?  F|empty(0|yteilprojektzu) & H|ystdist <> 0
.formula H|ystdistvksatz = H|ytpeigenleist   / H|ystdist      ? _F|empty(0|yteilprojektzu) & H|ystdist <> 0
.formula H|ystdzielvksatz = 0
