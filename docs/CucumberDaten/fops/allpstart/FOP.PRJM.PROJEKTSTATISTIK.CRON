.formula H|yekbestwert = H|yekbestwert + F|fxamount(G|inland,U|xrrewert,,1|pland,G|true)    ? _1|art^umlage &  1|pland <> G|inland
.formula H|yekbestwert = H|yekbestwert + U|xrrewert                                         ? _1|art^umlage &  1|pland =  G|inland
.continue EL033 ? _((1|art^gruppe = 1) ; (_('1|artex^kategorie(L=":")' = "(Downpayment)")))
.continue EL034 ? _(1|mge = 0)
.continue EL035 ? _(1|pwert = 0)
.formula U|xrliwert = 1|limge                           ? _1|kobrutto
.formula U|xrliwert = 1|limge / (1 + (1|stsatz / 100))  ?  1|kobrutto
.formula U|xrrewert = 1|remge                           ? _1|kobrutto
.formula U|xrrewert = 1|remge / (1 + (1|stsatz / 100))  ?  1|kobrutto
