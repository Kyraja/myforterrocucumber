.formula U|xtsel = "$,,kstelle==" + 0|yktr^id + ";konto==" + 5|yprjmmatumbkto^id + ";budat=!" + 'H|ybezugsdatum' + ";@filingmode=(Active)"
.load 9 group "131:1" 'U|xtsel'
