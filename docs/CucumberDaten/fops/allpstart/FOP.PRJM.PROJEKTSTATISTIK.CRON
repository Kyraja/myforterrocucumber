.continue EL042 ? _((_(1|typ = G|SUPOS)) & (_(1|typ = G|ZSPOS)) & (_(1|typ = G|ESPOS)) & (_(1|typ = G|STPOS)) & (_(1|typ = G|SIPOS)) & (_(1|typ = G|TRPOS)))
.formula U|xrrewert    = 1|pwert                        ? _1|kopf^brutto
