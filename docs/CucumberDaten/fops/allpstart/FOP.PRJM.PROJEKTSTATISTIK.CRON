.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@zeilen=ja"
.load 9 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL047 ? _(G|mehr)
.formula U|ximonat = F|month(U|xdedatum)
.load 9 line '9|selzeile'
.formula H|ystdzielvksatz = 9|yvsf.ximonat                                                       ?  9|yvland = G|inland ;  F|empty(9|yvland)
.formula H|ystdzielvksatz = F|fxamount(G|inland,9|yvsf.F|month(U|xdedatum),G|datum,9|yvland)     ? _9|yvland = G|inland & _F|empty(9|yvland)
!EL047
