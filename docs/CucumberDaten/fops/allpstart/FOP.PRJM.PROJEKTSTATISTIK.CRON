!EL002
.set trans +
FEHLER: Projektstatistik fÅr Projekt '0|nummer' kann nicht bearbeitet werden.
.set trans -
!FI002
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.formula U|xdzeitpunk = G|zeitpunkt
.formula U|xversionn  = G|versionneu
.formula U|xdvon    = "<M-1M"
.formula U|xdadatum = U|xdvon
.formula U|xdbis    = ">M"
.formula U|xdedatum = U|xdbis
.type text xtprojekt    ? _F|defined(U|xtprojekt)
.continue EL048 ? _(_(F|empty(U|xtprojekt)))
.load 0 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL049 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL049
.continue FI048
!EL048
.select lock add F|sysinfo(10)^ykonfigprjm
.continue EL050 ? _(G|mehr)
.assign U|xdlastrun = H|ypmllaufprojstat
.set trans +
'G|txname       '       Projektstatistik

Projektstatistik fÅr Zeitraum 'U|xdadatum' - 'U|xdedatum'

letzter Lauf: 'U|xdlastrun'
Start: 'G|zeitpunkt'
.set trans -

