..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJM.KST.ARRAY
..==  Pfad              : allpstart
..==  Funktion          : Unterprogramm zum Erzeugen eines Array fÅr die selektierten
..==                      Kostenstellen eines Infosystems
..==
..==  Erstellungsdatum  : 15.03.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..========================================================================
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtstack           ? _F|defined(U|xtstack)
.type text    xtindex           ? _F|defined(U|xtindex)
.type text    xtmp              ? _F|defined(U|xtmp)
.type text    xykoobjekt        ? _F|defined(U|xykoobjekt)
.type integer xivar             ? _F|defined(U|xivar)
.type integer   xprocsp ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Verdichtungskostenstelle_aufloesen -----
.formula U|xtsel = "$,,verd==" + 0|id + ";@ablageart=(1)"
.load 0 group "5:2" 'U|xtsel
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL001 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = 0|id
.input 'U|xypmrepruefkstprog'
.continue EL002 ? _(U|xyberlaubt)
.formula U|xtindex = "CC" + (0|id<<",")<<-1
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = 0|id
!EL002
.continue FI001
!EL001
.formula U|xtindex = "CC" + (0|id<<",")<<-1
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = 0|id
!FI001
.continue EL003 ? _(_(0|bu))
.formula U|xtstack = U|xtstack + 0|id + "###"
!EL003
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xtstack)))
.formula U|xtmp = U|xtstack<<"###"
.formula U|xtstack = U|xtstack>>"###"
.load 0 group "5:2" 'U|xtmp'
.continue EL004 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL004
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.copy U|xypmrepruefkst = G|FALSE    ? _F|sysinfo(18)^allppro
.formula U|xivar = 1
.continue EL005 ? _(_(M|yballekst))
!LOOP003: ==============================
.continue ELOP003 ? _(F|defined(M|ykst.xivar))
.continue EL006 ? _(_(F|empty(M|ykst.xivar)))
.continue EL007 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = M|ykst.xivar^id
.input 'U|xypmrepruefkstprog'
.continue EL008 ? _(U|xyberlaubt)
.formula U|xtindex = "CC" + (M|ykst.xivar^id<<",")<<-1
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = M|ykst.xivar^id
!EL008
.continue FI007
!EL007
.formula U|xtindex = "CC" + (M|ykst.xivar^id<<",")<<-1
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = M|ykst.xivar^id
!FI007
.continue EL009 ? _(_(M|ykst.xivar^bu))
.load 0 add M|ykst.xivar
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL009
!EL006
.formula U|xivar = U|xivar + 1
.continue LOOP003
!ELOP003: ==============================
.continue FI005
!EL005
.select group "5:2" "$,,"
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL010 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = H|id
.input 'U|xypmrepruefkstprog'
.continue EL011 ? _(U|xyberlaubt)
.formula U|xtindex = "CC" + (H|id<<",")<<-1
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = H|id
!EL011
.continue FI010
!EL010
.formula U|xtindex = "CC" + (H|id<<",")<<-1
.type text xtkst.xtindex        ? _F|defined(U|xtkst.xtindex)
.formula U|xtkst.xtindex = H|id
!FI010
.select continue
.continue LOOP004
!ELOP004: ==============================
!FI005
.type text xtkstleer    ? M|yballekst
.formula U|xtindex = ""
.input 'F|foppath("IFOP.IS.PRJM.KST.ARRAY")'    ? F|fileexists(F|foppath("IFOP.IS.PRJM.KST.ARRAY"))
.continue
