..!interpreter english declaration noabbrev
..
.set trans -
..*****************************************************************************
.. Name           : allprjm/FOP.PRJM.0.EV
.. Datum/Date     : 31.08.2011
.. Version        :
.. Autor/Author   : ts
.. Copyright      : (c) 1990 - 2014 alltrotec GmbH
.. Beschreibung   : 
..                  
...Includes       :
..*****************************************************************************
..
.input "allpstart/PRJM.KONFIG.INI"
..
.type text xtcmd xtsel
..
.continue LEISTKAT      ? G|evtvar = "yprjmbuleistkat"
.continue END
..
!LEISTKAT:
.continue END   ?  G|evtkommd = G|kaktname14
.continue END   ?  F|empty(M|prg)
..
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ybleistkat)
.continue END                                   ? _5|ybleistkat
..
..Projektleistungskatalog zur Preisgruppe suchen
.formula U|xtsel = "$,,yprg==KD" + M|prg + ";@ablageart=(1)
.select group 'U|xydbgrprojleistkat' 'U|xtsel'
.continue LKPFLEG       ?  G|mehr
..
.set TRANS +
..
.box -BUTTON yes:no -TITLE kein Leistungskatalog gefunden
Es wird ein neuer Leistungskatalog angelegt.
..
.set TRANS -
..
.continue END   ? _G|box = G|boxyes
..
.formula xtcmd = "make " + G|hdatname.xydbprojleistkat + " GROUP" + 'U|xygrprojleistkat'
.'U|xtcmd'
.formula H|such = "KD" + M|prg
.formula H|yprg = "KD" + M|prg
.formula H|name = M|name
.rewrite
..
!LKPFLEG:
.formula U|xtcmd = G|kkomname38 + " PRJMLEISTKAT "
.formula U|xtcmd = U|xtcmd + "? yprojleistkat=" + H|id
.formula U|xtcmd = U|xtcmd + "|ybmaskezu=1"
.formula U|xtcmd = U|xtcmd + "|bstart="
.command -WAIT 'U|xtcmd'
..
.continue END
..
..
!END:
.continue
