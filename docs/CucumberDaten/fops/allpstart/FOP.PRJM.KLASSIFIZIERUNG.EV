..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.PRJM.KLASSIFIZIERUNG.EV
..==
..==  Pfad              : allpstart
..==
..==  Funktion          : Events an der Maske Klassifizierung
..==
..==
..==  Erstellungsdatum  : 29.11.2010
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
..====================================================
.type text    xtsel xtsys xtfarbe
.type integer xifarbe
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Feldpruefung_Farbe -----
.continue EL001 ? _((M|.evtvar < 0) ; (M|.evtvar > 255))
.set TRANS +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set TRANS -
.error
.end 1
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe_setzen -----
.formula U|xtfarbe = 'M|yfarber' + " " + 'M|yfarbeg' + " " + 'M|yfarbeb'
.formula U|xtfarbe = "-1 -1 -1"                ? U|xtfarbe = "0 0 0"
.formula M|yfarbergb = U|xtfarbe        ? F|modifiable(M|yfarbergb)
.colour -BACKGROUND 'U|xtfarbe' ysfarbe
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldpruef")
.continue BRK003 ? _(G|evtvar = "yfarber")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "yfarbeg")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "yfarbeb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK005
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK002
.continue BRK006 ? _(G|evtart = "feldaus")
.continue BRK007 ? _(G|evtvar = "yfarber")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "yfarbeg")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "yfarbeb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK009
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK006
!ESAC001: =====   ENDCASE   =====
.continue
