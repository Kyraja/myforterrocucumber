..!interpreter english declaration noabbrev
.. at 2017-03-21, 15:16
.set trans -
..========================================================================
..==  Name              : CHECK.PROJECT
..==  Pfad              : allpstart
..==  Funktion          : PrÅfung amn Feldaustritt Projekt
..==  Erstellungsdatum  : 09.02.2017
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==
..==  Funktion          : Unterprogramm
..==                        - Programm am Feldaustritt eine Projektes oder öbergabe des Projekts in xpproject
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type P86:1   xpproject     ? _F|defined(U|xpproject)
.type text    xykoobjekt    ? _F|defined(U|xykoobjekt)
.type bool    xyberlaubt    ? _F|defined(U|xyberlaubt)
.type bool    xybnobox      ? _F|defined(U|xybnobox)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- boxAndReset -----
.set trans +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set trans -
.assign U|xpproject = ""
.assign M|.G|evtvar = ""  ? G|evtartengl="FIELD_EXIT"
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.assign U|xpproject = M|.G|evtvar^id    ? F|empty(U|xpproject) & G|evtartengl="FIELD_EXIT"
.continue EL001 ? _((_(F|empty(U|xpproject))) & (_(U|xpproject^bebuchbar)))
.set trans +
.box Hinweis
Es darf nur ein bebuchbares Projekt eingetragen werden.
.set trans -
.assign U|xpproject = ""
.assign M|.G|evtvar = ""  ? G|evtartengl="FIELD_EXIT"
!EL001
.copy U|xyberlaubt = G|true
.continue EL002 ? _((F|sysinfo(18)^allppro) & (_(F|empty(U|xpproject))))
.input PRJM.KONFIG.INI  ? _F|defined(U|xypmrepruefkst)
.continue EL003 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = U|xpproject^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.continue EL004 ? _(_(U|xyberlaubt))
.continue EL005 ? _((_(F|empty(U|xpproject^yteilprojektzu))) & (U|xpproject^ybfreifuerhpl))
.assign U|xyberlaubt = U|xpproject^yteilprojektzu^yprojleit^id = G|passw^passmitarb^id
!EL005
.continue EL006 ? _(_(U|xyberlaubt))
.continue EL007 ? _(_(U|xybnobox))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL007
.continue
!EL006
!EL004
!EL003
.continue EL008 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = U|xpproject^yktr^id
.input 'U|xypmrepruefktrprog'
.continue EL009 ? _(_(U|xyberlaubt))
.continue EL010 ? _((_(F|empty(U|xpproject^yteilprojektzu))) & (U|xpproject^ybfreifuerhpl))
.assign U|xyberlaubt = U|xpproject^yteilprojektzu^yprojleit^id = G|passw^passmitarb^id
!EL010
.continue EL011 ? _(_(U|xyberlaubt))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue
!EL011
!EL009
!EL008
.continue EL012 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL013 ? _(_(U|xyberlaubt))
.continue EL014 ? _((_(F|empty(U|xpproject^yteilprojektzu))) & (U|xpproject^ybfreifuerhpl))
.assign U|xyberlaubt = U|xpproject^yteilprojektzu^yprojleit^id = G|passw^passmitarb^id
!EL014
.continue EL015 ? _(_(U|xyberlaubt))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue
!EL015
!EL013
!EL012
!EL002
.continue
