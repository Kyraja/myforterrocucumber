.formula U|xterrtext = U|xterrtext + G|trennerchar + "Status"                   ?  F|empty(M|ystatus)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Verantwortlicher"         ?  F|empty(M|yverantw)         & _M|yprojekt^yprojekttyp^yprojvorlage
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Bearbeiter, Kostenstelle oder Projektteam"                                            ?  U|xi1 = 0 & _M|ystatusk = "08" & M|yreftypk = "01"
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Es darf nur eines der Felder Bearbeiter, Kostenstelle oder Projektteam gefÅllt sein." ?  U|xi1 > 1
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Auftragsposition"         ?  F|empty(M|yvorpos)          &  M|yprojekt^yprojekttyp^ypfvkpos & _M|ybmeilenstein & M|yistblatt
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Gewerk"                   ?  F|empty(M|yklassifizierung) &  M|yprojekt^yprojekttyp^ypfgewerk
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Leistungsart"             ?  F|empty(M|yleiart)          &  M|yprojekt^yprojekttyp^ypfleiart
.formula U|xterrtext = U|xterrtext + G|trennerchar + "verkaufte Leistung"       ?  F|empty(M|yvkartikel)       &  M|yprojekt^yprojekttyp^ypfvkartikel
.formula U|xterrtext = U|xterrtext + G|trennerchar + "EinschrÑnkungsdatum"      ?  F|empty(M|yeinschraenkdatum) & (_F|empty(M|yeinschraenkartk) & _M|yeinschraenkartk = U|xasap & _M|yeinschraenkartk = U|xalap)
.set TRANS -
.continue EL132 ? _(_(F|empty(U|xterrtext)))
.set TRANS +
