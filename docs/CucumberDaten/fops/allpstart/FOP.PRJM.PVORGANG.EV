.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtcmd xtsel xtsys xttmpdat xtid xtlock xtext xtftext xtifopref xtextid xysel
.type text    xtpvorgang xtaufgabe xtprot xtedpdat xtedperr xtedpout xtedpmsg xtverw xtkstelle xtfarbe xterrtext xtvar
.type text    xytaufrufernr xytzeitstempel xtindex xttitel xttext1 xttext2
.type text    xt1 xt2 xt3
.type integer xiatanz xifortschritt xianz xipvsollstd xipvplanstd
.type integer xi1
.type real    xrzugstd xrkalkstd
.type realx   xx1
.type GD      xdatum xdadatum xdedatum
.type GD      xdstart xdende
.type bool    xbok xbdone xbmehr xbignid xyballschutz xbhinweis xbrewrite
.type TAZ7    xeinh
.type P137    xpkal
.type VP28    xpdispobezobj
.type P86:1   xpprojekt
.type P86:1   xpproject
.type P149:2  xpgehoertzu
.type AZK28059 xsnet xsnlt xfnet xfnlt xmso xmfo xasap xalap
.formula U|xsnet = "SNET"
.formula U|xsnlt = "SNLT"
.formula U|xfnet = "FNET"
.formula U|xfnlt = "FNLT"
.formula U|xmso  = "MSO"
.formula U|xmfo  = "MFO"
.formula U|xasap = "ASAP"
.formula U|xalap = "ALAP"
.formula U|xtlock = "rmtmp/X.PVORGANG." + 'M|nummer' + ".TMP"
.formula U|xtifopref = "IFOP.PRJM.PO.REFERENZ"
.type integer   xprocsp      ? _F|defined(U|xprocsp)
..====================================================
.formula U|xprocsp = 0
.set demand -
.continue EPROCDEF
!PROC001: ----- Feldschutz -----
.continue EL001 ? _(G|evtkommd = G|kaktname12)
.protection yiststart 0
.protection yistend   0
.protection yreftyp   0 ? _M|yistblatt ; _F|empty(M|yreftypk)
.continue FI001
!EL001
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ypmleistwertaend)
.continue EL002 ? _(_(M|ybstdvert))
.continue EL003 ? _(_(M|ypvzugstd = 0))
.protection ypersonal 0 ? _F|empty(M|yprojteam) ; _F|empty(M|ykstelle)
.protection yprojteam 0
.protection ykstelle  0
.continue FI003
!EL003
.protection -reset ypersonal 0
.protection -reset yprojteam 0
.protection -reset ykstelle  0
!FI003
!EL002
.continue EL004 ? _(M|yistblatt)
.protection ybvogabeistmax    0
.protection yvorgabebudgetstd 0
.continue EL005 ? _((F|empty(M|yreftypk)) & (F|empty(M|yrefid)))
.continue EL006 ? _(M|ybmeilenstein)
.protection ypvsollstd     0
.protection ypvplanstd     0
.protection ypviststd      0
.protection ypvfaktstd     0
.protection ypvforecaststd 0
.protection ypvvokastd     0
.protection ydauer         0
.protection yedatum        0
.continue FI006
!EL006
.protection -RESET ypvsollstd     0
.protection -RESET ypvplanstd     0
.protection -RESET ypviststd      0
.protection -RESET ypvfaktstd     0
.protection -RESET ypvforecaststd 0
.protection -RESET ypvvokastd     0
.protection -RESET ydauer         0
.protection -RESET yedatum        0
!FI006
.continue FI005
!EL005
.continue BRK001 ? _(M|yreftypk = "01")
.protection yqualigrad     0
.protection yzusatzinfo    0
.protection ypviststd      0
.protection ypvfaktstd     0
.protection yfortschritt   0
.protection ytechfort      0
.protection yiststart      0
.protection yistend        0
.protection ybmeilenstein  0
.continue ESAC001
!BRK001
.continue BRK002 ? _(M|yreftypk = "05")
.protection ypviststd      0
.protection yfortschritt   0
.protection ytechfort      0
.protection yiststart      0
.protection yistend        0
.continue ESAC001
!BRK002
.continue BRK003 ? _(M|yreftypk = "06")
.protection ypviststd      0
.protection yfortschritt   0
.protection ytechfort      0
.protection yiststart      0
.protection yistend        0
.continue ESAC001
!BRK003
!ESAC001: =====   ENDCASE   =====
!FI005
.continue FI004
!EL004
.protection yadatum        0
.protection yedatum        0
.protection ydauer         0
.protection ybmeilenstein  0
.protection ypvsollstd     0
.protection ypvplanstd     0
.protection ypviststd      0
.protection ypvfaktstd     0
.protection ypvforecaststd 0
.protection ypvvokastd     0
.protection yfortschritt   0
.protection yreftyp        0
.protection yreferenz      0
!FI004
.protection such           0    ?  M|yprojekt^yprojekttyp^ybgleichessw
.protection yreftyp        0
.continue EL007 ? _(_(5|ypmleistwertaend))
.protection yfertstellgrad 0
.protection yleistwert     0
.protection yleistwertplan 0
.protection yleistwertfc   0
.protection yleistwertist  0
!EL007
.protection        ysimrefdatfix 0  ?  M|yreftypk = "01" & 5|ybprojsim
.protection -RESET ysimrefdatfix 0  ? _M|yreftypk = "01" & 5|ybprojsim
.protection        yskalkpos   0    ? _F|empty(M|yleilistid) ; _M|yistblatt
.protection -RESET yskalkpos   0    ?  F|empty(M|yleilistid) &  M|yistblatt
.protection        ykoko       0    ? _F|empty(M|yleilistid) ; _M|yistblatt
.protection -RESET ykoko       0    ?  F|empty(M|yleilistid) &  M|yistblatt
.protection        ysleistlist 0    ? _F|empty(M|yskalkpos)  ; _M|yistblatt
.protection -RESET ysleistlist 0    ?  F|empty(M|yskalkpos)  &  M|yistblatt
.continue EL008 ? _((_(F|empty(5|ypmerllmaendfakt))) & (F|sysinfo(18)^allppro))
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"
.copy U|xbok = F|defined(F|map(U|xypermissions, '5|ypmerllmaendfakt^id'))
.continue EL009 ? _(_(U|xbok))
.protection ylsrelev  'M|aktzeile'
!EL009
!EL008
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- Feldpruefung_Farbe -----
.continue EL010 ? _((M|.evtvar < 0) ; (M|.evtvar > 255))
.set TRANS +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set TRANS -
.error
.end 1
!EL010
.continue 'xprocst.xprocsp'
!PROC003: ----- Farbe_setzen -----
.formula U|xtfarbe = 'M|yppfarber'     + " " + 'M|yppfarbeg'     + " " + 'M|yppfarbeb'      ? G|evtvar<<8  = "yppfarbe"
.formula U|xtfarbe = 'M|yppfortfarber' + " " + 'M|yppfortfarbeg' + " " + 'M|yppfortfarbeb'  ? G|evtvar<<12 = "yppfortfarbe"
.formula U|xtfarbe = "-1 -1 -1"                                                             ? U|xtfarbe = "0 0 0"
.colour -BACKGROUND 'U|xtfarbe' ysppfarbe                                                   ? G|evtvar<<8  = "yppfarbe"
.colour -BACKGROUND 'U|xtfarbe' ysppfortfarbe                                               ? G|evtvar<<12 = "yppfortfarbe"
.continue 'xprocst.xprocsp'
!PROC004: ----- CheckConstraint -----
.formula U|xterrtext = ""
.set trans +
.formula U|xterrtext = F|formatstr("Der Vorgang darf nicht vor dem {1} beginnen.", M|yeinschraenkdatum)     ? M|yeinschraenkartk = U|xsnet &  M|yadatum < M|yeinschraenkdatum
.formula U|xterrtext = F|formatstr("Der Vorgang darf nicht nach dem {1} beginnen.", M|yeinschraenkdatum)    ? M|yeinschraenkartk = U|xsnlt &  M|yadatum > M|yeinschraenkdatum
.formula U|xterrtext = F|formatstr("Der Vorgang darf nicht vor dem {1} enden.", M|yeinschraenkdatum)        ? M|yeinschraenkartk = U|xfnet &  M|yedatum < M|yeinschraenkdatum
.formula U|xterrtext = F|formatstr("Der Vorgang darf nicht nach dem {1} enden.", M|yeinschraenkdatum)       ? M|yeinschraenkartk = U|xfnlt &  M|yedatum > M|yeinschraenkdatum
.formula U|xterrtext = F|formatstr("Der Vorgang beginnt nicht am {1}.", M|yeinschraenkdatum)                ? M|yeinschraenkartk = U|xmso  & _M|yadatum = M|yeinschraenkdatum
.formula U|xterrtext = F|formatstr("Der Vorgang endet nicht am {1}.", M|yeinschraenkdatum)                  ? M|yeinschraenkartk = U|xmfo  & _M|yedatum = M|yeinschraenkdatum
.set trans -
.continue EL011 ? _(_(F|empty(U|xterrtext)))
.set trans +
.box Fehler
PrÅfung auf EinschrÑnkung:
'U|xterrtext'
.set trans -
.error (0)
.end 1
!EL011
.continue 'xprocst.xprocsp'
!PROC005: ----- PflichtfelderFarbe -----
.continue EL012 ? _(_(G|evtkommd = G|kaktname12))
.colour -BACKGROUND "-1 -1 -1" yverantw          0
.colour -BACKGROUND "-1 -1 -1" yvorvp            0
.colour -BACKGROUND "-1 -1 -1" yklassifizierung  0
.colour -BACKGROUND "-1 -1 -1" yleiart           0
.colour -BACKGROUND "-1 -1 -1" yeinschraenkdatum 0
.colour -BACKGROUND 'U|xyfarbepflichtf' such              0
.colour -BACKGROUND 'U|xyfarbepflichtf' yverantw          0     ? _M|yprojekt^yprojekttyp^yprojvorlage
.colour -BACKGROUND 'U|xyfarbepflichtf' yadatum           0
.colour -BACKGROUND 'U|xyfarbepflichtf' yedatum           0
.colour -BACKGROUND 'U|xyfarbepflichtf' yprojekt          0
.colour -BACKGROUND 'U|xyfarbepflichtf' yvorvp            0     ?  M|yprojekt^yprojekttyp^ypfvkpos & _M|ybmeilenstein & M|yistblatt
.colour -BACKGROUND 'U|xyfarbepflichtf' yklassifizierung  0     ?  M|yprojekt^yprojekttyp^ypfgewerk
.colour -BACKGROUND 'U|xyfarbepflichtf' yleiart           0     ?  M|yprojekt^yprojekttyp^ypfleiart
.colour -BACKGROUND 'U|xyfarbepflichtf' yeinschraenkdatum 0     ? _F|empty(M|yeinschraenkartk) & _M|yeinschraenkartk = U|xasap & _M|yeinschraenkartk = U|xalap
!EL012
.continue 'xprocst.xprocsp'
!PROC006: ----- ReftypBeschaffung -----
.continue EL013 ? _(G|evtkommd = G|kaktname12)
.select add M|id
.continue EL014 ? _(G|mehr)
.continue EL015 ? _(_(H|yreftypk  = "04"))
.select lock add M|id
.continue EL016 ? _(G|mehr)
.assign  H|yreftypk  = "04"
.rewrite
!EL016
!EL015
.continue FI014
!EL014
.set TRANS +
.box Fehler
Fehler beim Bearbeiten des Vorgangs!
.set TRANS -
!FI014
!EL013
.command -PARALLEL 'F|expr("(Infosystem) PRJMBESCHAFFUNG ? ypvorgang=" + M|id + "|ybmaskezu=1|bstart=")'
.continue 'xprocst.xprocsp'
!PROC007: ----- Referenz_anlegen_zuweisen -----
.continue EL017 ? _(G|evtkommd = G|kaktname12)
.continue EL018 ? _(((M|yprojekt^ystatusk = "AKT") ; (M|yprojekt^ystatusk = "")) & (_(M|yprojekt^yablage)))
.continue EL019 ? _(M|yistblatt)
.continue EL020 ? _(_(M|ybmeilenstein))
.continue EL021 ? _((F|empty(M|yadatum)) ; (F|empty(M|yedatum)))
.set TRANS +
.box Hinweis
Bitte geben Sie zuerst Start- und Endedatum
und den Zeitraum an!
.set TRANS -
.continue FI021
!EL021
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue EL022 ? _(_(F|empty(M|yrefid)))
.load 0 object 'M|yrefid'
.continue EL023 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projektvorgang 'M|nummer'/'M|such' existiert bereits
eine Referenz: 'M|yreftyp' 'M|yreferenz^nummer'.
.set TRANS -
.error
.end 1
!EL023
!EL022
.continue EL024 ? _(F|sysinfo(18)^allpstd)
.formula U|xtsel = "$,,ytpvorgang==" + M|id + ";@ablageart=(Active);@zeilen=(1)"
.select group 'U|xydbgrsubmeldung' 'U|xtsel'
.continue EL025 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projektvorgang 'M|nummer'/'M|such' existiert bereits eine
Submeldung (Nummer 'H|nummer').
.set TRANS -
.error
.end 1
!EL025
!EL024
.continue EL026 ? _(F|fileexists(U|xtlock))
.select from 'U|xtlock' U|xtext^
.set TRANS +
.box Achtung
Zum Projektvorgang 'M|nummer'/'M|such'
wird bereits eine Referenz angelegt.

'U|xtext'
.set TRANS -
.error
.end 1
.continue FI026
!EL026
.select lock add M|id
.continue EL027 ? _(G|mehr)
.formula M|yreftypk = "01"      ?  F|empty(M|yreftypk)
.copy    U|xbok     = G|true
.continue EL028 ? _(M|yreftypk = "01")
.formula U|xtpvorgang = M|id
.input "allpstart/FOP.PRJM.UP.PV.FREIGABE.AA"
.copy    U|xbok = U|xybrelok
!EL028
.continue EL029 ? _(U|xbok)
.output NEW 'U|xtlock'
Bearbeiter 'G|bzeichen' am 'G|datum' um 'G|zeit'
.out NEW WERF.WEG
.select -
.file -TEMPNAME U|xtftext
.output NEW 'U|xtftext'
.input DATEI.F
.input -TEXT 'M|yftext'         ? _F|empty(M|yftext)
.output NEW WER.WEG
.action +
.continue BRK004 ? _(G|evtvar = "yburefneu")
.formula U|xtextid = G|versionneu
.continue BRK005 ? _(M|yreftypk = "01")
.formula U|xtcmd = "<(ProjectSuitePlanning)><(New)>,(WorkTask)"
.formula U|xtcmd = U|xtcmd + " ?ypvorgang="   + 'M|id'
.formula U|xtcmd = U|xtcmd + " |ybmaskezu=1"
.command -WAIT 'U|xtcmd'
.continue ESAC003
!BRK005
.continue BRK006 ? _(M|yreftypk = "02")
.copy U|xbmehr = G|true
.continue EL030 ? _(U|xbmehr)
.formula U|xtcmd = "<(Workorder)> <(New)>,(WorkOrderSuggestions)
.formula U|xtcmd = U|xtcmd + " ? [insert]=1"
.formula U|xtcmd = U|xtcmd + " |1:yprjmpvorgang=" + M|id
.formula U|xtcmd = U|xtcmd + " |[pos]=1:artex"
.command -WAIT 'U|xtcmd'
!EL030
.continue ESAC003
!BRK006
.continue BRK007 ? _(M|yreftypk = "03")
.formula U|xtcmd = "<(Transaction)><(New)>,(Task)"
.formula U|xtcmd = U|xtcmd + " ?such="      + 'M|such'
.formula U|xtcmd = U|xtcmd + " |name="      + 'M|name'
.formula U|xtcmd = U|xtcmd + " |ausloeser=" + 'M|id'
.formula U|xtcmd = U|xtcmd + " |start="     + 'M|yadatum'
.formula U|xtcmd = U|xtcmd + " |end="       + 'M|yedatum'
.command -WAIT 'U|xtcmd'
.formula U|xtsel = "$,,ausloeser==" + M|id
.load 0 transaction 'U|xtsel'
.continue EL031 ? _(G|mehr)
.select lock object 'M|id'
.formula H|yrefid    = 0|id
.formula H|yreftyp   = M|yreftyp
.formula H|yiststart = 0|start
.formula H|yistend   = 0|end
.rewrite
!EL031
.continue ESAC003
!BRK007
.continue BRK008 ? _(M|yreftypk = "04")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC006
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK008
.continue BRK009 ? _(M|yreftypk = "05")
.formula U|xtcmd = "<(Transaction)><(New)>,(Project)"
.formula U|xtcmd = U|xtcmd + "?yextid="  + U|xtextid
.formula U|xtcmd = U|xtcmd + "|yadatum=" + M|yadatum:8
.formula U|xtcmd = U|xtcmd + "|yedatum=" + M|yedatum:8
.formula U|xtcmd = U|xtcmd + "|ybmaskezu=1"
.command -WAIT 'U|xtcmd'
.load 9 group "86:1" 'F|expr("$,,yextid==" + U|xtextid + ";@filingmode=(Active)")'
.continue EL032 ? _(G|mehr)
.select lock add M|id
.continue EL033 ? _(G|mehr)
.formula H|yrefid    = 9|id
.assign  H|yreftypk  = "05"
.formula H|yiststart = 9|yadatum
.formula H|yistend   = 9|yedatum
.rewrite
.continue FI033
!EL033
.set TRANS +
.box Fehler
Fehler beim Bearbeiten des Vorgangs!
.set TRANS -
!FI033
!EL032
.continue ESAC003
!BRK009
.continue BRK010 ? _(M|yreftypk = "06")
.formula U|xtcmd = "<(Transaction)><(New)>,(Project)"
.formula U|xtcmd = U|xtcmd + "?yextid="  + U|xtextid
.formula U|xtcmd = U|xtcmd + "|yteilprojektzu=" + M|yprojekt^id
.formula U|xtcmd = U|xtcmd + "|yadatum=" + M|yadatum:8
.formula U|xtcmd = U|xtcmd + "|yedatum=" + M|yedatum:8
.formula U|xtcmd = U|xtcmd + "|ybmaskezu=1"
.command -WAIT 'U|xtcmd'
.load 9 group "86:1" 'F|expr("$,,yextid==" + U|xtextid + ";@filingmode=(Active)")'
.continue EL034 ? _(G|mehr)
.select lock add M|id
.continue EL035 ? _(G|mehr)
.formula H|yrefid    = 9|id
.assign  H|yreftypk  = "06"
.formula H|yiststart = 9|yadatum
.formula H|yistend   = 9|yedatum
.rewrite
.continue FI035
!EL035
.set TRANS +
.box Fehler
Fehler beim Bearbeiten des Vorgangs!
.set TRANS -
!FI035
!EL034
.continue ESAC003
!BRK010
.continue BRK011 ? _(M|yreftypk = "07")
.continue EL036 ? _(F|sysinfo(18)^allpstd)
.continue EL037 ? _(F|empty(M|yrefid))
.set trans +
.box Hinweis
Das Anlegen einer Referenz bei Auswahl
von "'M|yreftyp'" ist nicht mîglich.

Bitte eine Referenz Åber den
Button "Referenz zuweisen" zuweisen.
.set trans -
!EL037
.continue FI036
!EL036
.copy M|yreftypk = F|oldvalue(M|yreftypk)
!FI036
.continue ESAC003
!BRK011
.continue BRK012 ? _(M|yreftypk = "99")
.set TRANS +
.box Hinweis
Das Anlegen einer Referenz bei Auswahl
von "'M|yreftyp'" ist nicht mîglich.

Bitte eine Referenz Åber den
Button "Referenz zuweisen" zuweisen.
.set TRANS -
.continue ESAC003
!BRK012
!ESAC003: =====   ENDCASE   =====
.continue ESAC002
!BRK004
.continue BRK013 ? _(G|evtvar = "yburefzuweis")
.continue BRK014 ? _(M|yreftypk = "01")
.set TRANS +
.box Hinweis
Das Zuweisen einer Arbeitsaufgabe ist nicht mîglich.
.set TRANS -
.continue ESAC004
!BRK014
.continue BRK015 ? _(M|yreftypk = "02")
.continue EL038 ? _(F|cmdpermitted(4,12))
.copy    U|xbmehr = G|true
.formula U|xtverw = "XXXXXX"
.continue EL039 ? _(5|yverwfvzuwk = "RF")
.set TRANS +
.menu(0,0,0)Verwendung vorbelegen
Verwendung nicht vorbelegen             >>.formula U|xtverw = ""
Projektnummer                           >>.formula U|xtverw = M|yprojekt^nummer
Projektnummer_Projektvorgangsnummer     >>.formula U|xtverw = M|yprojekt^nummer + "_" + M|nummer
Projektsuchwort                         >>.formula U|xtverw = M|yprojekt^such
Projektsuchwort_Projektvorgangsnummer   >>.formula U|xtverw = M|yprojekt^such   + "_" + M|nummer
?Verwendung der Auftragsposition        >>.formula U|xtverw = M|yvorvp^verw                     ? _F|empty(M|yvorvp)
.set TRANS -
.copy U|xbmehr = G|false    ? G|menue = 0
!EL039
.continue EL040 ? _(U|xbmehr)
.formula U|xtsel = "%,,art=;tename=;tsterm=;tterm=;limge=;mge=;ofmge=;platz=;ba=;betreuer=;verw=;dispo=;fix=(Yes);projekt==" + M|yprojekt^id + ";.yprjmpvorgang==`"
.formula U|xtsel = U|xtsel + ";.@group=5;@filingmode=(Active);@autostart=(Yes)"
.select nolock group "P4:5" 'U|xtsel'
.continue EL041 ? _(G|mehr)
.continue EL042 ? _((F|empty(H|yprjmpvorgang)) ; (_(H|yprjmpvorgang^id = M|id)))
.file -TEMPNAME U|xtedpdat
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedpmsg
.file -TEMPNAME U|xtedperr
.input DATEI.F
.output new 'U|xtedpdat'
#!database=4
#!group=5
#!action=UPDATE
#!EDP_LANGCODE='G|bsprache'
#!dontchange=XXXXXX

id;
'H|id';
.formula U|xtsys = "edpimport.sh -o UPDATEMODE=STRICT -o LOCKBEHAVIOR=NOWAIT" + " -p " + G|einmalpw
.formula U|xtsys = U|xtsys + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'U|xtsys' BACKGROUND
.continue EL043 ? _(G|mehr)
.formula U|xtsys = "rm -f " + U|xtlock
.system 'U|xtsys' BACKGROUND
.output new 'U|xtedpdat'
.formula U|xtverw = M|yprojekt^nummer                       ? 5|yverwfvzuwk = "PRNR"
.formula U|xtverw = M|yprojekt^nummer + "_" + M|nummer      ? 5|yverwfvzuwk = "PRNPVN"
.formula U|xtverw = M|yprojekt^such                         ? 5|yverwfvzuwk = "PRSUCH"
.formula U|xtverw = M|yprojekt^such   + "_" + M|nummer      ? 5|yverwfvzuwk = "PRSPVN"
.formula U|xtverw = M|yvorvp^verw                           ? 5|yverwfvzuwk = "VAUPOS"
.formula U|xtkstelle = "XXXXXX"
.formula U|xtkstelle = M|yprojekt^yktr^id                   ? 5|ykoobjfvzuw & _F|empty(M|yprojekt^yktr)
#!database=4
#!group=5
#!action=UPDATE
#!EDP_LANGCODE='G|bsprache'
#!edp_dialogmode=1
#!dontchange=XXXXXX

id;\
