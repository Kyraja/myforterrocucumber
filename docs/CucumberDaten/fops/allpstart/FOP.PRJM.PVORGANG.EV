!PROC009: ----- KalenderBezugsobjekt -----
.assign U|xpdispobezobj = ""
.assign U|xpkal         = ""
.copy U|xpkal = F|getwcal(M|id, "", M|yedatum)
.copy U|xpkal = F|getwcal(M|yprojekt, "", M|yedatum)            ? U|xpkal^stdkal
.copy U|xpkal = F|getwcal(M|ystandort, "", M|yedatum)           ? U|xpkal^stdkal & _F|empty(M|ystandort)
.copy U|xpkal = F|getwcal(M|yprojekt^ystandort, "", M|yedatum)  ? U|xpkal^stdkal & _F|empty(M|yprojekt^ystandort)
.copy U|xpdispobezobj = U|xpkal^dispobezobj
.continue 'xprocst.xprocsp'
!PROC010: ----- Fortschritt_berechnen -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ystdbudgetab1)
.formula M|yfortschritt   = M|ypviststd / M|ypvplanstd     * 100        ? _M|ypvplanstd     = 0
.formula M|yabwfortplan   = M|yfortschritt - 100
.formula M|yfortistbudget = M|ypviststd / M|ypvsollstd     * 100        ? _M|ypvsollstd     = 0
.formula M|yabwfortbudget = M|yfortistbudget - 100
.continue EL081 ? _((_(G|evtvar = "ytechfort")) & (_(M|yreftypk = "02")))
.formula M|ytechfort      = M|ypviststd / M|ypvforecaststd * 100        ?  M|ypvforecaststd >  0 & M|ypviststd >  0
.formula M|ytechfort      = 0                                           ?  M|ypvforecaststd <= 0 ; M|ypviststd <= 0
.formula M|ytechfort      = 100                                         ?  M|ytechfort      >  100
!EL081
.formula M|yabwphysplan   = M|yfortschritt - M|ytechfort
.input "allpstart/FOP.PRJM.UP.ICONS"
.colour -FOREGROUND "0 0 0" yabwfortplan   0
.colour -FOREGROUND "0 0 0" yabwfortbudget 0
.colour -FOREGROUND "0 0 0" yabwphysplan   0
.continue 'xprocst.xprocsp'
!PROC011: ----- Pruefung_ob_neues_Projekt_eigetragen_werden_darf -----
.file -TEMPNAME U|xtprot
.output NEW 'U|xtprot'
.input DATEI.F
'G|kommandochar'box Hinweis
.set TRANS +
Das Projekt darf nicht geÑndert werden:

.set TRANS -
.copy U|xbok   = G|true
.assign U|xbmehr = G|false
.formula U|xtsel = "$,,ypvorgang==" + M|id + ";@ablageart=(Active)"
.load 0 group 'U|xydbgraufgabe' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xtsel = "$,,yaufgabe==" + 0|id + ";@ablageart=(Active)"
.load 1 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL082 ? _((_(F|empty(1|ytransaktion))) ; (_(F|empty(1|yabrechnung))))
.set TRANS +
Leistungsmeldung '      1|nummer' '1|such         ' '1|name                            '
?ist bereits gebucht                            ? _F|empty(1|ytransaktion)
?ist in Abrechnung '1|yabrechnung' enthalten    ? _F|empty(1|yabrechnung)

.set TRANS -
.copy U|xbok = G|false
!EL082
.load 1 continue
.continue LOOP004
!ELOP004: ==============================
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
.continue EL083 ? _(_(U|xbok))
.input 'U|xtprot'
.formula G|evtfeldneu = H|yprojekt^id   ? G|evtart = "feldfuell"
.continue                               ? G|evtart = "feldfuell"
.formula M|yprojekt   = H|yprojekt^id   ? G|evtart = "maskpruef"
.error
.end 1
!EL083
.continue 'xprocst.xprocsp'
