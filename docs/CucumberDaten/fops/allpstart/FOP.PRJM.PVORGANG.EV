.set TRANS -
.formula U|xtvar     = "yeinschraenkdatum"      ?  F|empty(M|yeinschraenkdatum) & (_F|empty(M|yeinschraenkartk) & _M|yeinschraenkartk = U|xasap & _M|yeinschraenkartk = U|xalap)
.formula U|xtvar     = "yvkartikel"             ?  F|empty(M|yvkartikel)       &  M|yprojekt^yprojekttyp^ypfvkartikel
.formula U|xtvar     = "yleiart"                ?  F|empty(M|yleiart)          &  M|yprojekt^yprojekttyp^ypfleiart
.formula U|xtvar     = "yklassifizierung"       ?  F|empty(M|yklassifizierung) &  M|yprojekt^yprojekttyp^ypfgewerk
.formula U|xtvar     = "yvorvp"                 ?  F|empty(M|yvorpos)          &  M|yprojekt^yprojekttyp^ypfvkpos & _M|ybmeilenstein & M|yistblatt
