..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJM5080LISTE.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 28.02.2011
..==  Autor             : Sebastian Strobel, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtcmd xtsel xykoobjekt xtprojekt xtfarbe1 xtfarbe2
.type integer xifarbe
.type bool    xyberlaubt xbmehr
.type real    xrpvsollstd xrpvplanstd xrpviststd
.type real    xrsumpvsollstd xrsumpvplanstd xrsumpviststd xrsumpvforecaststd
.type integer xyred xygreen xyblue xyhue
.type realx   xysat xyval
.type bool    xybrgb2hsv xybhsv2rgb
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Continue -----
.input 'F|foppath("IFOP.IS.PRJM5080LISTE.EV")'  ? F|fileexists(F|foppath("IFOP.IS.PRJM5080LISTE.EV"))
.continue
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.input "allpstart/IS.PRJM.ICON"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.input 'U|xtupprjmsel'
.make screen line --O
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "buttonvor")
.continue BRK004 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "buttonnach")
.continue BRK006 ? _(G|evtvar = "bstart")
.continue EL001 ? _(F|empty(U|xyfarbeprojekt))
.formula U|xyred   =  U|xyfarbeprojekt<<" "
.formula U|xygreen = (U|xyfarbeprojekt>>" ")<<" "
.formula U|xyblue  =  U|xyfarbeprojekt>$" "
.copy U|xybrgb2hsv = G|TRUE
.copy U|xybhsv2rgb = G|FALSE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xyval = U|xyval - (U|xyval * 0.1)
.copy U|xybrgb2hsv = G|FALSE
.copy U|xybhsv2rgb = G|TRUE
.input "allpstart/FOP.ALL.UP.RGBHSV"
.formula U|xtfarbe1 =  U|xyfarbeprojekt
.formula U|xtfarbe2 = 'U|xyred' + " " + 'U|xygreen' + " " + 'U|xyblue'
!EL001
.input "allpstart/PRJM.FARBEN.DEF"
.input 'U|xtupprjmsel'
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "yticonkritvorgang")
.continue EL002 ? _(_(F|empty(M|ytprojekt)))
.formula U|xtcmd = "(Infosystem) PRJMUEBER ? yprojekt=" + M|ytprojekt^id + "|ybdetail=(Yes)|bstart=1"
.command -PARALLEL 'U|xtcmd'
!EL002
.continue ESAC003
!BRK007
!ESAC003: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK005
!ESAC001: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
