..!interpreter english declaration noabbrev
.. at 2017-03-15, 13:48
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.UP.PVORGANG.ABSCHLUSS
..==  Pfad              : allpstart
..==  Funktion          : Unterprogramm zum Abschluss eines Projektvorgangs
..==                      erwartet xtpvorgang - abzuschlie·ender Projektvorgang
..==  Erstellungsdatum  : 19.01.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==
..==  Besonderheiten    :
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
..====================================================
.type text xtsel         ? _F|defined(U|xtsel)
.type text xttmpdat      ? _F|defined(U|xttmpdat)
.type bool xbabschluss   ? _F|defined(U|xbabschluss)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Projektvorgang_abschliessen -----
.formula U|xtaufgabe  = ""
.formula U|xtpvorgang = 8|id
.input "allpstart/FOP.PRJM.UP.AUFABPRUEF"
.continue EL001 ? _(U|xbaufab)
.select lock nowait object '8|id'
.continue EL002 ? _(G|mehr)
.continue EL003 ? _(G|gesperrt)
.formula H|yablage = G|true
.formula H|yabldat = G|datum
.continue EL004 ? _((H|yreftypk = "01") & (_(F|empty(H|yrefid))))
.assign H|ystatus = H|yrefid^ystatus ? F|defined(H|ystatus)
.continue FI004
!EL004
.assign H|ystatusk = "07" ? F|defined(H|ystatusk)
!FI004
.rewrite
.formula U|xtsel = "$,,ypvorgang==" + U|xtpvorgang + ";@ablageart=(1)"
.load 9 group 'U|xydbgraufgabe' 'U|xtsel'
.continue EL005 ? _(G|mehr)
.formula U|xtsel = "$,,yaufgabe==" + 9|id + ";@ablageart=(1)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.select lock nowait object '9|id'
.continue EL006 ? _(G|gesperrt)
.formula H|yarchiv = G|true
.rewrite
.select -
.continue FI006
!EL006
.output ADDEDTO 'U|xttmpdat'
.set TRANS +
Leistungsmeldung '9|nummer' konnte nicht abgeschlossen werden. Datensatz ist belegt.
.set TRANS -
.formula U|xbabschluss = false
!FI006
.load 9 continue
.continue LOOP001
!ELOP001: ==============================
!EL005
.continue FI003
!EL003
.output ADDEDTO 'U|xttmpdat'
.set TRANS +
Projektvorgang '8|nummer' konnte nicht abgeschlossen werden. Datensatz ist belegt.
.set TRANS -
.formula U|xbabschluss = false
!FI003
.continue FI002
!EL002
.output ADDEDTO 'U|xttmpdat'
.set TRANS +
Projektvorgang '8|nummer' konnte nicht geîffnet werden.
.set TRANS -
.formula U|xbabschluss = false
!FI002
.continue FI001
!EL001
.output ADDEDTO 'U|xttmpdat'
.set TRANS +
Die Aufgabe zu Projektvorgang '8|nummer' ist noch nicht abgeschlossen.
.set TRANS -
.formula U|xbabschluss = G|false
!FI001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL007 ? _(F|defined(U|xtpvorgang))
.continue EL008 ? _(_(F|empty(U|xtpvorgang)))
.select lock nowait group 'U|xydbgrpvorgang' 'U|xtpvorgang'
.continue EL009 ? _(G|mehr)
.continue EL010 ? _(G|gesperrt)
.file -TEMPNAME U|xttmpdat
.output NEW 'U|xttmpdat'
.input DATEI.F
.formula U|xbabschluss = G|true
.formula U|xtsel = "$,,ygehoertzu==" + U|xtpvorgang
.load 8 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL011 ? _(_(8|yablage))
.continue EL012 ? _(8|yistblatt)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI012
!EL012
.output ADDEDTO 'U|xttmpdat'
.set TRANS +
Sammelvorgang '8|nummer' zu Projektvorgang 'H|nummer' ist noch nicht abgeschlossen.
.set TRANS -
.formula U|xbabschluss = false
!FI012
!EL011
.load 8 continue
.continue LOOP002
!ELOP002: ==============================
.continue EL013 ? _(U|xbabschluss)
.load 8 group 'U|xydbgrpvorgang' 'U|xtpvorgang
.continue EL014 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL014
!EL013
.continue EL015 ? _(U|xbabschluss)
.input "allpstart/FOP.PRJM.UP.SVORGANG.AKT"
.continue FI015
!EL015
.output TERMINAL
.input BILD.F
.set TRANS +

Der Projektvorgang konnte auf Grund folgender Fehler nicht abgeschlossen werden:

.input 'U|xttmpdat'
.set TRANS -
!FI015
.continue FI010
!EL010
.set TRANS +
.box Fehler
Der Projektvorgang 'H|nummer' wird gerade bearbeitet.
Abschluss des Vorgangs ist nicht mîglich.

'G|sperrtext                                                                    '
.set TRANS -
!FI010
.continue FI009
!EL009
.set TRANS +
.box Hinweis
Fehler beim Laden des Projektvorgangs 'U|xtpvorgang'.
.set TRANS -
!FI009
!EL008
.continue
!EL007
