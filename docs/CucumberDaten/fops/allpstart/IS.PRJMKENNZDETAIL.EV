..!interpreter english declaration noabbrev
.. at 2016-09-05, 15:07
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMKENNZDETAIL.EV
..==  Pfad              : allpstart
..==  Funktion          : Event FOP an IS PRJMKENNZDETAIL
..==  Erstellungsdatum  : 28.08.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xttip
.type text    xtvarwertvoka xtvarwertfc xtvarwertist xtvarwertzus1 xtvarwertzus2 xtvardatum
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.formula P|maskkontextfop = ", SEL , CHART , TAB ,"
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "ykennzahl")
.continue EL001 ? _(_(F|empty(M|ykennzahl)))
.formula M|grliste = "154:1"
.formula M|select  = "!"
.formula M|yvarwertvoka = "yvokawert"
.formula M|yvarwertfc   = "yfcwert"
.formula M|yvarwertist  = "ywert"
.formula M|yvarwertzus1 = "ywertzus1"
.formula M|yvarwertzus2 = "ywertzus2"
.formula M|yvardatum    = "ydatum"
.formula M|ychvalvoka   = F|vardescr(M|ychvalvoka, G|bsprache)
.formula M|ychvalfc     = F|vardescr(M|ychvalfc, G|bsprache)
.formula M|ychvalist    = F|vardescr(M|ychvalist, G|bsprache)
.formula M|ychvalzus1   = F|vardescr(M|ychvalzus1, G|bsprache)
.formula M|ychvalzus2   = F|vardescr(M|ychvalzus2, G|bsprache)
!EL001
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "yprojekt")
.input 'U|xtupprjmsel'
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "yvondatum")
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "ybisdatum")
.continue ESAC002
!BRK006
.continue BRK007 ? _(G|evtvar = "select")
.assign  M|ykennzahl = ""
.continue ESAC002
!BRK007
.continue BRK008 ? _(G|evtvar = "ybnosel")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, ", SEL ,", ",")   ?  M|ybnosel
.formula P|maskkontextfop = P|maskkontextfop + " SEL ,"                         ? _M|ybnosel
.continue ESAC002
!BRK008
!ESAC002: =====   ENDCASE   =====
.continue EL002 ? _(_(G|evtvar = "ybnosel"))
.make screen line --O
.formula M|ywertvoka = 0
.formula M|ywertfc   = 0
.formula M|ywertist  = 0
.formula M|ywertzus1 = 0
.formula M|ywertzus2 = 0
!EL002
.continue ESAC001
!BRK002
.continue BRK009 ? _(G|evtart = "buttonvor")
.continue BRK010 ? _(G|evtvar = "bstart")
.continue EL003 ? _((F|empty(M|ykennzahl)) & ((F|empty(M|select)) ; (M|select = "!")))
.set TRANS +
.box Hinweis
Bitte eine Kennzahl angeben.
.set TRANS -
.error
.end 1
.continue FI003
!EL003
.make screen line --O
!FI003
.continue ESAC003
!BRK010
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK009
.continue BRK011 ? _(G|evtart = "buttonnach")
.continue BRK012 ? _(G|evtvar = "bstart")
.formula U|xtvarwertvoka = M|yvarwertvoka
.formula U|xtvarwertfc   = M|yvarwertfc
.formula U|xtvarwertist  = M|yvarwertist
.formula U|xtvarwertzus1 = M|yvarwertzus1
.formula U|xtvarwertzus2 = M|yvarwertzus2
.formula U|xtvardatum    = M|yvardatum
.formula M|ywertvoka = 0
.formula M|ywertfc   = 0
.formula M|ywertist  = 0
.formula M|ywertzus1 = 0
.formula M|ywertzus2 = 0
.continue EL004 ? _((F|empty(M|select)) ; (M|select = "!"))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ykennzahl==" + M|ykennzahl^id
.formula U|xtsel = U|xtsel + ";yprojekt=="  + M|yprojekt^id         ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";ydatum>="    + M|yvondatum:8         ? _F|empty(M|yvondatum)
.formula U|xtsel = U|xtsel + ";ydatum<="    + M|ybisdatum:8         ? _F|empty(M|ybisdatum)
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@ordnung=ydatum"
.continue FI004
!EL004
.formula U|xtsel = M|select
!FI004
.select group 'M|grliste' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.make screen line +O
.formula M|ytwertvoka = H|.xtvarwertvoka    ? _F|empty(U|xtvarwertvoka) & F|defined(H|.xtvarwertvoka)
.formula M|ytwertfc   = H|.xtvarwertfc      ? _F|empty(U|xtvarwertvoka) & F|defined(H|.xtvarwertfc)
.formula M|ytwertist  = H|.xtvarwertist     ? _F|empty(U|xtvarwertist)  & F|defined(H|.xtvarwertist)
.formula M|ytwertzus1 = H|.xtvarwertzus1    ? _F|empty(U|xtvarwertzus1) & F|defined(H|.xtvarwertzus1)
.formula M|ytwertzus2 = H|.xtvarwertzus2    ? _F|empty(U|xtvarwertzus2) & F|defined(H|.xtvarwertzus2)
.formula M|ytdatum    = H|.xtvardatum       ? _F|empty(U|xtvardatum)    & F|defined(H|.xtvardatum)
.formula M|ytmonat    = F|month(M|ytdatum)
.formula M|ytjahr     ='F|year(M|ytdatum)'
.formula M|ywertvoka = M|ywertvoka + H|.xtvarwertvoka   ? _F|empty(U|xtvarwertvoka) & F|defined(H|.xtvarwertvoka)
.formula M|ywertfc   = M|ywertfc   + H|.xtvarwertfc     ? _F|empty(U|xtvarwertvoka) & F|defined(H|.xtvarwertfc)
.formula M|ywertist  = M|ywertist  + H|.xtvarwertist    ? _F|empty(U|xtvarwertist)  & F|defined(H|.xtvarwertist)
.formula M|ywertzus1 = M|ywertzus1 + H|.xtvarwertzus1   ? _F|empty(U|xtvarwertzus1) & F|defined(H|.xtvarwertzus1)
.formula M|ywertzus2 = M|ywertzus2 + H|.xtvarwertzus2   ? _F|empty(U|xtvarwertzus2) & F|defined(H|.xtvarwertzus2)
.select continue
.continue LOOP001
!ELOP001: ==============================
.chart -INIT
.chart -PARAM -CHARTTYPE LINES
.formula U|xtsel = M|ychtitel           ? _F|empty(M|ychtitel)
.formula U|xtsel = M|ykennzahl^namebspr ?  F|empty(M|ychtitel)
.chart -PARAM -TITLECHART 'U|xtsel'
.set trans +
.chart -PARAM -TITLEY "Wert"
.set trans -
.formula U|xttip = ""
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xttip = U|xttip + ";" + F|tostring(M|ytmonat) + "/" + F|tostring(M|ytjahr)   ? _F|empty(U|xttip)
.formula U|xttip =                 F|tostring(M|ytmonat) + "/" + F|tostring(M|ytjahr)   ?  F|empty(U|xttip)
.select screen line
.continue LOOP002
!ELOP002: ==============================
.chart -PARAM -MARKERX 'U|xttip'
.chart -PARAM -ANGLEX 45
.chart -PARAM -DECIMALSY 2
.chart -PARAM -3D NO
.continue EL005 ? _(_(F|empty(U|xtvarwertvoka)))
.chart -STARTVALUES 'M|ychvalvoka'
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xttip = F|tostring(M|ytwertvoka)
.chart -VALUE 'M|ytwertvoka' -TIP 'U|xttip'
.select screen line
.continue LOOP003
!ELOP003: ==============================
!EL005
.continue EL006 ? _(_(F|empty(U|xtvarwertfc)))
.chart -STARTVALUES 'M|ychvalfc'
.select screen header
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xttip = F|tostring(M|ytwertfc)
.chart -VALUE 'M|ytwertfc'   -TIP 'U|xttip'
.select screen line
.continue LOOP004
!ELOP004: ==============================
!EL006
.continue EL007 ? _(_(F|empty(U|xtvarwertist)))
.chart -STARTVALUES 'M|ychvalist'
.select screen header
.select screen line
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xttip = F|tostring(M|ytwertist)
.chart -VALUE 'M|ytwertist'  -TIP 'U|xttip'
.select screen line
.continue LOOP005
!ELOP005: ==============================
!EL007
.continue EL008 ? _(_(F|empty(U|xtvarwertzus1)))
.chart -STARTVALUES 'M|ychvalzus1'
.select screen header
.select screen line
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula U|xttip = F|tostring(M|ytwertzus1)
.chart -VALUE 'M|ytwertzus1' -TIP 'U|xttip'
.select screen line
.continue LOOP006
!ELOP006: ==============================
!EL008
.continue EL009 ? _(_(F|empty(U|xtvarwertzus2)))
.chart -STARTVALUES 'M|ychvalzus2'
.select screen header
.select screen line
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.formula U|xttip = F|tostring(M|ytwertzus2)
.chart -VALUE 'M|ytwertzus2' -TIP 'U|xttip'
.select screen line
.continue LOOP007
!ELOP007: ==============================
!EL009
.chart -SHOW ychart 0
.cursor ychart 0
.continue ESAC004
!BRK012
.continue BRK013 ? _(G|evtvar = "ybuberechnen")
.continue ESAC004
!BRK013
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK011
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMKENNZDETAIL.EV")'        ? F|fileexists(F|foppath("IFOP.IS.PRJMKENNZDETAIL.EV"))
.continue
