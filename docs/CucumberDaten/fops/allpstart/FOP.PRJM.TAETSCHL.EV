.type text    xtcmd xtsel xtsys
.type integer   xprocsp      ? _F|defined(U|xprocsp)
..====================================================
.formula U|xprocsp = 0
.set demand -
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskpruef")
.continue EL001 ? _((_(F|empty(M|ykstelle))) & ((M|ystammkst) ; (_(M|ygkzeiterl))))
.set trans +
.box Fehler
Ist eine Kostenstelle im Feld "Immer auf Kostenstelle" eingetragen,
muss "Gemeinkostenzeitmeldung erlaubt" gesetzt sein,
"Immer Stammkostenstelle" darf nicht gesetzt sein.
.set trans -
.error
.end 1
!EL001
.continue ESAC001
!BRK001
!ESAC001: =====   ENDCASE   =====
.continue
