..!interpreter english declaration noabbrev
.. at 2017-02-28, 16:23
.set trans -
..========================================================================
..==  Name              : S.919.PRJM.EV
..==  Pfad              : allpstart
..==  Funktion          : EFOP an Ausschreibung fÅr projektbezogenen Einkauf
..==  Erstellungsdatum  : 22.11.2016
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==
..==  Besonderheiten    :
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsel xttext xttmpfile xysel xtid
.type text    xtanfrposgrp xtprojekt xtprojekt xtartikel xtlief xtverw xtpvorgang xtarbpaket xtbedarfstraeg xtbem xtekposid xtprojek
.type real    xrbudgetwert xrfcwert
.type integer xizeile xianfrposgrp xi1
.type bool    xbmehr xybnoprsel
.type GD      xdsolldatanf xdsolldatang xdsolldatbest xdsolldatlief
.type P86:1   xpprojekt
.type P149:2  xppvorgang
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- VerwendungVorbelegen -----
.continue EL001 ? _((F|modifiable(M|verw)) & (_(F|empty(M|artikel))))
.copy U|xpprojekt  = M|projekt
.copy U|xppvorgang = M|yprjmppvorgang
.input "allpstart/FOP.PRJM.UP.VERW"
.formula M|verw = U|xtverw    ? _F|empty(U|xtverw)
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.protection M|yprjmprojekt  0       ? _F|empty(M|yprjmprojekt)  & G|evtkommd = G|kaktname13
.protection M|yprjmpvorgang 0       ? _F|empty(M|yprjmpvorgang) & G|evtkommd = G|kaktname13
.copy U|xbmehr = G|true
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL002 ? _((_(F|empty(M|tevpos))) ; (_(F|empty(M|vorgang))))
.add M|vorgang  ? _F|empty(M|vorgang)
.add M|tevpos   ? _F|empty(M|tevpos)
.continue EL003 ? _(G|mehr)
.copy M|yprjmparbpaket     = D|yprjmparbpaket
.copy M|yprjmppvorgang     = D|yprjmppvorgang
.copy M|yprjmpbedarfstraeg = D|yprjmpbedarfstraeg
.copy M|yprjmpbudgetwert   = D|yprjmpbudgetwert
.copy M|yprjmpfcwert       = D|yprjmpfcwert
.copy M|yprjmpsolldatanf   = D|yprjmpsolldatanf
.copy M|yprjmpsolldatang   = D|yprjmpsolldatang
.copy M|yprjmpsolldatbest  = D|yprjmpsolldatbest
.copy M|yprjmpsolldatlief  = D|yprjmpsolldatlief
.copy M|yprjmpbem          = D|yprjmpbem
.copy M|yprjmpekposid      = D|yprjmpekposid
.copy M|yprjmpprojek       = D|yprjmpprojek
!EL003
!EL002
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL004 ? _((_(G|evttaste = G|kaktname16)) & (_(G|evtkommd = G|kaktname12)))
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL005 ? _(_(F|empty(M|anfrposgrp)))
.assign  U|xi1 = M|anfrposgrp
.continue EL006 ? _(G|mehr)
.formula U|xianfrposgrp = U|xi1     ?  U|xianfrposgrp < U|xi1
!EL006
.continue EL007 ? _(F|defined(U|xtanfrposgrp.M|anfrposgrp))
.formula U|xizeile = M|aktzeile
.formula U|xtsel = "$,,zn<>" + 'M|aktzeile'
.formula U|xtsel = U|xtsel + ";anfrposgrp==" + M|anfrposgrp
.formula U|xtsel = U|xtsel + ";artikel=="    + M|artikel^id
.formula U|xtsel = U|xtsel + ";tlief=="      + M|tlief^id
.formula U|xtsel = U|xtsel + ";projekt=="    + M|projekt^id
.select screen line 'U|xtsel'
.continue EL008 ? _(G|mehr)
.set trans +
.formula U|xtsel = "Achtung!"
.formula U|xttext = F|formatstr("Die Gruppennummer {1} ist in Zeile {2} und {3} vergeben.", M|anfrposgrp, U|xtanfrposgrp.M|anfrposgrp, M|aktzeile)
.box -button yes:no -title 'U|xtsel'
'U|xttext'
Trotzdem weiter?
.set trans -
.error  ? _G|box = G|boxyes
.end 1  ? _G|box = G|boxyes
!EL008
.select screen line 'U|xizeile'
.continue FI007
!EL007
.type integer U|xtanfrposgrp.M|anfrposgrp
.formula U|xtanfrposgrp.M|anfrposgrp  = M|aktzeile
!FI007
!EL005
.select screen line
.continue LOOP002
!ELOP002: ==============================
.file -screen -tempname U|xttmpfile
.output new 'U|xttmpfile'
.input DATEI.F
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL009 ? _(F|empty(M|vorgang))
.continue EL010 ? _((F|modifiable(M|anfrposgrp)) & (F|empty(M|anfrposgrp)))
.formula U|xianfrposgrp = U|xianfrposgrp + 1
.formula M|anfrposgrp   = U|xianfrposgrp
!EL010
'M|aktzeile';'M|anfrposgrp';'M|projekt^id';'M|artikel^id';'M|tlief^id';'M|verw';'M|yprjmppvorgang^id';'M|yprjmparbpaket^id';'M|yprjmpbedarfstraeg^id';'M|yprjmpbem';'M|yprjmpbudgetwert';'M|yprjmpfcwert';'M|yprjmpsolldatanf:8';'M|yprjmpsolldatang:8';'M|yprjmpsolldatbest:8';'M|yprjmpsolldatlief:8';'M|yprjmpekposid';'M|yprjmpprojek';
!EL009
.select screen line
.continue LOOP003
!ELOP003: ==============================
.formula M|yprjmtmpfile = U|xttmpfile
!EL004
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "maskende")
.continue EL011 ? _((_(G|evttaste = G|kaktname16)) & (_(G|evtkommd = G|kaktname12)))
.continue EL012 ? _(_(F|empty(M|yprjmtmpfile)))
.file -open U|xi1 'M|yprjmtmpfile'
.file -read U|xi1 U|xizeile;U|xtanfrposgrp;U|xtprojekt;U|xtartikel;U|xtlief;U|xtverw;U|xtpvorgang;U|xtarbpaket;U|xtbedarfstraeg;U|xtbem;U|xrbudgetwert;U|xrfcwert;U|xdsolldatanf;U|xdsolldatang;U|xdsolldatbest;U|xdsolldatlief;U|xtekposid;U|xtprojek;
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL013 ? _(_(F|empty(U|xtprojekt)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt=="      + U|xtprojekt
.formula U|xtsel = U|xtsel + ";kotyp==(Request)"
.formula U|xtsel = U|xtsel + ";art=="          + U|xtartikel
.formula U|xtsel = U|xtsel + ";lief=="         + U|xtlief
.formula U|xtsel = U|xtsel + ";kopf^ausschr==" + M|id
.formula U|xtsel = U|xtsel + ";anfrposgrp=="   + U|xtanfrposgrp
.load 0 nolock group "4:2" 'U|xtsel'
.continue EL014 ? _(G|mehr)
.select lock add 0|id
.continue EL015 ? _(G|mehr)
.formula H|yprjmppvorgang     = U|xtpvorgang
.formula H|yprjmparbpaket     = U|xtarbpaket
.formula H|yprjmpbedarfstraeg = U|xtbedarfstraeg
.formula H|yprjmpbem          = U|xtbem
.formula H|yprjmpbudgetwert   = U|xrbudgetwert
.formula H|yprjmpfcwert       = U|xrfcwert
.formula H|yprjmpsolldatanf   = U|xdsolldatanf
.formula H|yprjmpsolldatang   = U|xdsolldatang
.formula H|yprjmpsolldatbest  = U|xdsolldatbest
.formula H|yprjmpsolldatlief  = U|xdsolldatlief
.formula H|yprjmpekposid      = U|xtekposid
.formula H|yprjmpprojek       = U|xtprojek
.rewrite
!EL015
!EL014
!EL013
.file -read U|xi1 U|xizeile;U|xtanfrposgrp;U|xtprojekt;U|xtartikel;U|xtlief;U|xtverw;U|xtpvorgang;U|xtarbpaket;U|xtbedarfstraeg;U|xtbem;U|xrbudgetwert;U|xrfcwert;U|xdsolldatanf;U|xdsolldatang;U|xdsolldatbest;U|xdsolldatlief;U|xtekposid;U|xtprojek;
.continue LOOP004
!ELOP004: ==============================
!EL012
!EL011
.continue ESAC001
!BRK003
.continue BRK004 ? _(G|evtart = "buttonnach")
.continue BRK005 ? _(G|evtvar = "tkopieren")
.continue ESAC002
!BRK005
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK004
.continue BRK006 ? _(G|evtart = "feldfuell")
.continue BRK007 ? _(G|evtvar = "yprjmprojekt")
.input "allpstart/FOP.PRJM.UP.CHECK.PROJECT"
.continue
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "yprjmpvorgang")
.continue EL016 ? _((F|modifiable(M|yprjmprojekt)) ; (_(F|empty(M|yprjmprojekt))))
.copy    U|xybnoprsel = G|true
.formula U|xysel = ""
.formula U|xysel = U|xysel + ";.yprojekt=="  + M|yprjmprojekt^id    ? _F|empty(M|yprjmprojekt)
.formula U|xysel = U|xysel + ";yreftyp==(_04)"
.formula U|xysel = U|xysel + ";yablage=="
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue EL017 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = M|yprjmpvorgang^id)))
.load 0 group 'U|xydbgrpvorgang' 'G|evtfeldneu'
.continue EL018 ? _(G|mehr)
.continue EL019 ? _(0|yablage)
.set trans +
.box Fehler
'F|formatstr("Der Projektvorgang hat bereits den Status {1}.", 0|ystatus)'
.set trans -
.error (0)
.end 1
!EL019
.continue EL020 ? _((_(F|empty(0|yreftypk))) & (_(0|yreftypk = "04")))
.set trans +
.box
'0|nummer': hat bereits die Referenz '0|yreftyp' eingetragen.
.set trans -
.error (0)
.end 1
!EL020
.continue EL021 ? _(_(F|empty(M|yprjmprojekt)))
.formula U|xtsel = 0|yprojekt^id
.input "allpstart/FOP.PRJM.UP.CHECK.PROJECT"    ? _0|yprojekt^id = M|yprjmprojekt^id
!EL021
!EL018
!EL017
.continue FI016
!EL016
.set trans +
.box Fehler
Das Projekt darf nicht geÑndert werden.
.set trans -
.formula G|evtfeldneu = M|yprjmpvorgang^id
!FI016
.continue
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "projekt")
.input "allpstart/FOP.PRJM.UP.CHECK.PROJECT"
.continue
.continue ESAC003
!BRK009
.continue BRK010 ? _(G|evtvar = "yprjmppvorgang")
.continue EL022 ? _(F|modifiable(M|projekt))
.copy    U|xybnoprsel = G|true
.formula U|xysel = ""
.formula U|xysel = U|xysel + ";.yprojekt=="  + M|projekt^id         ? _F|empty(M|projekt)
.formula U|xysel = U|xysel + ";.yarbpaket==" + M|yprjmparbpaket^id  ? _F|empty(M|yprjmparbpaket)
.formula U|xysel = U|xysel + ";yreftyp==(_04)"
.formula U|xysel = U|xysel + ";yablage=="
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue EL023 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = M|yprjmppvorgang^id)))
.load 0 group 'U|xydbgrpvorgang' 'G|evtfeldneu'
.continue EL024 ? _(G|mehr)
.continue EL025 ? _(0|yablage)
.set trans +
.box Fehler
'F|formatstr("Der Projektvorgang hat bereits den Status {1}.", 0|ystatus)'
.set trans -
.error (0)
.end 1
!EL025
.continue EL026 ? _((_(F|empty(0|yreftypk))) & (_(0|yreftypk = "04")))
.set trans +
.box
'0|nummer': hat bereits die Referenz '0|yreftyp' eingetragen.
.set trans -
.error (0)
.end 1
!EL026
.continue EL027 ? _(_(F|empty(M|projekt)))
.formula U|xtsel = 0|yprojekt^id
.input "allpstart/FOP.PRJM.UP.CHECK.PROJECT"    ? _0|yprojekt^id = M|projekt^id
!EL027
!EL024
!EL023
.continue FI022
!EL022
.set trans +
.box Fehler
Das Projekt darf nicht geÑndert werden.
.set trans -
.formula G|evtfeldneu = M|yprjmppvorgang^id
!FI022
.continue
.continue ESAC003
!BRK010
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK006
.continue BRK011 ? _(G|evtart = "feldaus")
.continue BRK012 ? _(G|evtvarori = "yprjmprojekt")
.assign  M|yprjmpvorgang  = ""
.formula M|name = M|yprjmprojekt^namebspr
.continue
.continue ESAC004
!BRK012
.continue BRK013 ? _(G|evtvarori = "projekt")
.assign M|yprjmppvorgang = ""
.continue
.continue ESAC004
!BRK013
.continue BRK014 ? _(G|evtvarori = "yprjmppvorgang")
.continue EL028 ? _(_(F|empty(M|yprjmppvorgang)))
.copy    M|projekt      = M|yprjmppvorgang^yprojekt ? F|modifiable(M|projekt)
.formula M|yprjmpprojek = 'G|versionneu'            ? F|empty(M|yprjmpprojek)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL028
.continue
.continue ESAC004
!BRK014
.continue BRK015 ? _(G|evtvarori = "artikel")
.copy M|projekt        = M|yprjmprojekt     ?  F|modifiable(M|projekt) & _F|empty(M|yprjmprojekt)
.copy M|yprjmppvorgang = M|yprjmpvorgang    ? _F|empty(M|yprjmpvorgang) & M|projekt^id = M|yprjmpvorgang^yprojekt^id
.continue ESAC004
!BRK015
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK011
.continue BRK016 ? _(G|evtart = "zeileeinnach")
.copy M|projekt       = M|yprjmprojekt      ? F|modifiable(M|projekt)
.copy M|yprjmpvorgang = M|yprjmppvorgang    ? F|modifiable(M|projekt)
.continue ESAC001
!BRK016
!ESAC001: =====   ENDCASE   =====
.continue
