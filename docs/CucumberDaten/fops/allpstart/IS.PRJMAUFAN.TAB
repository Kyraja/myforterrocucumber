..!interpreter english declaration noabbrev
.. at 2015-12-22, 17:47
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMAUFAN.TAB
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 06.04.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2013 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Schutz -----
.protection ybfrei    'M|aktzeile'
.protection ytsollstd 'M|aktzeile'
.protection ytplanstd 'M|aktzeile'
.protection ytpersonal'M|aktzeile'
.protection yvorvp    'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC002: ----- ZFarbe -----
.continue EL001 ? _(((F|empty(M|yaufgabe)) & (F|empty(M|ypvorgang^yrefid))) & (((M|ypvorgang^yprojekt^ystatusk = "AKT") ; (M|ypvorgang^yprojekt^ystatusk = "")) & (_(M|ypvorgang^yprojekt^yablage))))
.continue EL002 ? _((_(F|empty(M|ytpersonal))) ; (_(F|empty(M|ytkstelle))) ; (_(F|empty(M|ytprojteam))))
.continue EL003 ? _(F|empty(M|yvorvp))
.colour -BACKGROUND 'xtfarbe4' yvorvp 'M|aktzeile'  ?  M|ypvorgang^yprojekt^yprojekttyp^ypfvkpos
.colour -BACKGROUND 'xtfarbe0' yvorvp 'M|aktzeile'  ? _M|ypvorgang^yprojekt^yprojekttyp^ypfvkpos
.formula M|ybfrei = G|TRUE                          ? _M|ypvorgang^yprojekt^yprojekttyp^ypfvkpos
.continue FI003
!EL003
.colour -BACKGROUND 'xtfarbe0' yvorvp 'M|aktzeile'
.formula M|ybfrei = G|TRUE
!FI003
!EL002
.colour -BACKGROUND 'xtfarbe0' 'M|aktzeile'
.continue FI001
!EL001
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.colour -BACKGROUND 'xtfarbe0' yvorvp 'M|aktzeile'
.colour -BACKGROUND 'xtfarbe2' 'M|aktzeile'
!FI001
.continue 'xprocst.xprocsp'
!PROC003: ----- MacheZeile -----
.make screen line +O
.assign  M|ypvorgang    = 0|id
.formula M|ytpvname     = 0|namebspr
.copy    M|ytprojekt    = 0|yprojekt
.copy    M|ytpvstatus   = 0|ystatus
.copy    M|ytgehoertzu  = 0|ygehoertzu
.formula M|ytispartname = M|ytgehoertzu^namebspr
.assign  M|ytkunde      = 0|yprojekt^ykunde
.formula M|ytkdname     = M|ytkunde^namebspr
.assign  M|yadatum      = 0|yadatum
.copy    M|yedatum      = 0|yedatum
.copy    M|ydauer       = 0|ydauer
.copy    M|ytpersonal   = 0|ypersonal
.copy    M|ytkstelle    = 0|ykstelle
.copy    M|ytprojteam   = 0|yprojteam
.copy    M|ytverantw    = 0|yverantw
.assign  M|yvorvp       = 0|yvorpos
.assign  M|yvorpos      = 0|yvorpos
.assign  M|yvornum      = 0|yvornum
.formula M|ytsollstd    = 0|ypvsollstd
.formula M|ytplanstd    = 0|ypvplanstd
.continue 'xprocst.xprocsp'
!PROC004: ----- PV_laden -----
.load 0 group 'U|xydbgrpvorgang' 'M|select'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL004 ? _(0|yprojekt^ystatusk = "AKT")
.continue EL005 ? _(M|ybselect)
.continue EL006 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = 0|yprojekt^yverantwkst^id
.input 'U|xypmrepruefktrprog'
!EL006
.continue EL007 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = 0|yprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
!EL007
.continue EL008 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL008
!EL005
.continue EL009 ? _((_(M|ybselect)) ; (U|xyberlaubt) ; ((_(U|xypmrepruefktr)) & (_(U|xypmrepruefind))))
.continue EL010 ? _(F|empty(0|yrefid))
.formula U|xtsel = "$,,ypvorgang==" + 0|id
.load 1 group 'U|xydbgraufgabe' 'U|xtsel'
.continue EL011 ? _(G|mehr)
.continue EL012 ? _(M|ybmitauf)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC003
!RET002
.formula xprocsp = xprocsp - 1
.assign M|yaufgabe  = 1|id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
!EL012
.continue FI011
!EL011
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC003
!RET004
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
!FI011
.continue FI010
!EL010
.continue EL013 ? _(M|ybmitauf)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC003
!RET006
.formula xprocsp = xprocsp - 1
.assign M|yaufgabe  = 0|yrefid
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
!EL013
!FI010
!EL009
!EL004
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.file -TEMPNAME U|xtftext
.formula U|xtfarbe0 = "-1 -1 -1"
.formula U|xtfarbe1 = "221 238 255"
.formula U|xtfarbe2 = "199 211 211"
.formula U|xtfarbe3 = "144 238 144"
.formula U|xtfarbe4 = "238 144 144"
.continue EL014 ? _(_(M|ybselect))
.continue EL015 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = M|yprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
!EL015
.continue EL016 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL016
.continue EL017 ? _((U|xyberlaubt) ; ((_(U|xypmrepruefktr)) & (_(U|xypmrepruefind))))
.formula M|select = "$,,"
.formula M|select = M|select + ";yprojekt="             +  H|id
.formula M|select = M|select + ";ygehoertzu="           +  M|ygehoertzu^id                      ? _F|empty(M|ygehoertzu)
.formula M|select = M|select + ";ystatus="              +  M|ypvstatus^id                       ? _F|empty(M|ypvstatus) &  M|ybpvstatus
.formula M|select = M|select + ";ystatus^katego<="      +  M|ypvstatus^katego                   ? _F|empty(M|ypvstatus) & _M|ybpvstatus
.formula M|select = M|select + ";ypersonal="            +  M|ypersonal^id                       ? _F|empty(M|ypersonal)
.formula M|select = M|select + ";ykstelle="             +  M|ykkstelle^id                       ? _F|empty(M|ykkstelle)
.formula M|select = M|select + ";yprojteam="            +  M|ykprojteam^id                      ? _F|empty(M|ykprojteam)
.formula M|select = M|select + ";yadatum="              +  M|yvondatum:8 + "!" + M|ybisdatum:8  ? _F|empty(M|yvondatum) ; _F|empty(M|ybisdatum)
.formula M|select = M|select + ";yverantw="             +  M|yverantw^id                        ? _F|empty(M|yverantw)
.formula M|select = M|select + ";yistblatt=1"
.formula M|select = M|select + ";yablage=0"
.formula M|select = M|select + ";ybmeilenstein=0;
.formula M|select = M|select + ";@ablageart=(1)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC004
!RET008
.formula xprocsp = xprocsp - 1
!EL017
.continue FI014
!EL014
.formula U|xtsel = M|select + ";@lesen=nein"
.assign U|xppvorgang = U|xtsel
.continue EL018 ? _(_(G|mehr))
.set TRANS +
.box
Selektionskriterien nicht korrekt
'M|select'
.set TRANS -
.error
.end 1
!EL018
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC004
!RET009
.formula xprocsp = xprocsp - 1
!FI014
.input 'F|foppath("IFOP.IS.PRJMAUFAN.TAB")'     ? F|fileexists(F|foppath("IFOP.IS.PRJMAUFAN.TAB"))
.continue
