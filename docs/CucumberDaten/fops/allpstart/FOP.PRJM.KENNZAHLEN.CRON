..!interpreter english declaration noabbrev
.set trans -
..========================================================================
..==  Name              : FOP.PRJM.KENNZAHLEN.CRON
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 27.07.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtcmd xtsel xykzindex xtkennzahl xtupgkzcron
.type real    xrliwert xrrewert
.type integer ximonat
.type GD      xdadatum xdedatum xdstichtag
.type GD19    xdzeitpunk xdvon xdbis
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Projekte_laden -----
.formula U|xykzindex = ""
.formula U|xykzindex = F|nextelem(U|xykennzahl, U|xykzindex)
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xykzindex)))
.formula U|xtprojekt  = 0|id
.formula U|xtkennzahl = U|xykennzahl.xykzindex
.input 'U|xykzfopist.xykzindex'     ? _F|empty(U|xykzfopist.xykzindex)  & F|fileexists(F|foppath(U|xykzfopist.xykzindex))
.input 'U|xykzfopvoka.xykzindex'    ? _F|empty(U|xykzfopvoka.xykzindex) & F|fileexists(F|foppath(U|xykzfopvoka.xykzindex))
.input 'U|xykzfopfc.xykzindex'      ? _F|empty(U|xykzfopfc.xykzindex)   & F|fileexists(F|foppath(U|xykzfopfc.xykzindex))
.input 'U|xykzfopzus1.xykzindex'    ? _F|empty(U|xykzfopzus1.xykzindex) & F|fileexists(F|foppath(U|xykzfopzus1.xykzindex))
.input 'U|xykzfopzus2.xykzindex'    ? _F|empty(U|xykzfopzus2.xykzindex) & F|fileexists(F|foppath(U|xykzfopzus2.xykzindex))
.formula U|xykzindex = F|nextelem(U|xykennzahl, U|xykzindex)
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula U|xdzeitpunk = G|zeitpunkt
.formula U|xdvon    = "<M-1M"
.formula U|xdadatum = U|xdvon
.formula U|xdbis    = ">M"
.formula U|xdedatum = U|xdbis
.formula U|xdstichtag = U|xdbis
.type text xtprojekt    ? _F|defined(U|xtprojekt)
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.formula U|xtupgkzcron = 5|ypmupgkzcron
.formula U|xtupgkzcron = ""             ? _F|fileexists(F|foppath(5|ypmupgkzcron))
.select group 'U|xydbgrkennzahlen' "$,,yincronjob==1;@filingmode=(Active)"
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xykzindex = H|nummer
.type text xykennzahl.xykzindex
.type text xykzfopist.xykzindex
.type text xykzfopvoka.xykzindex
.type text xykzfopfc.xykzindex
.type text xykzfopzus1.xykzindex
.type text xykzfopzus2.xykzindex
.formula U|xykennzahl.xykzindex  = H|id
.formula U|xykzfopist.xykzindex  = H|yberechfop
.formula U|xykzfopvoka.xykzindex = H|yvokafop
.formula U|xykzfopfc.xykzindex   = H|yfcfop
.formula U|xykzfopzus1.xykzindex = H|yfopzus1
.formula U|xykzfopzus2.xykzindex = H|yfopzus2
.select continue
.continue LOOP002
!ELOP002: ==============================
.continue EL001 ? _(_(F|empty(U|xtprojekt)))
.load 0 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL002 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.input 'U|xtupgkzcron'  ? _F|empty(U|xtupgkzcron)
!EL002
.continue FI001
!EL001
.select lock add F|sysinfo(10)^ykonfigprjm
.continue EL003 ? _(G|mehr)
.set trans +
'G|txname                   '   Kennzahlen

Kennzahlen fÅr Zeitraum 'U|xdadatum' - 'U|xdedatum'

Start: 'G|zeitpunkt'
.set trans -

.load 0 group 'U|xydbgrprojekt' 'F|expr("$,,yablage==0;@filingmode=(Active)")'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
.formula U|xtsel = "$,,yablage==" + 'G|TRUE' + ";yabldat=" + 'U|xdadatum' + "!" + 'U|xdedatum' + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrprojekt' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtprojekt = ""
.input 'U|xtupgkzcron'  ? _F|empty(U|xtupgkzcron)
.select lock add F|sysinfo(10)^ykonfigprjm
.continue EL004 ? _(G|mehr)

.set trans +
Ende : 'G|zeitpunkt'
.set trans -
.continue FI004
!EL004
.set trans +
FEHLER: ProjectSuite Konfiguration kann nicht geîffnet werden.
        Eintrag letzter Statistiklauf ist nicht mîglich
.set trans -
!FI004
.continue FI003
!EL003
.set trans +
FEHLER: ProjectSuite Konfiguration kann nicht geîffnet werden.
PROGRAMMABBRUCH
.set trans -
.continue
!FI003
!FI001
.continue
