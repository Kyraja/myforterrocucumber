..!interpreter english noabbrev
..*****************************************************************************
.. Name           : allpstart/FOP.PRJM.UP.LM.TRANSAKTION
.. Date           : 30.04.2013
.. Version        :
.. Author         : alltrotec/ts
.. Copyright      : (c) 1990 - 2015 alltrotec GmbH
.. Functionality  : creates the file for transaction
..
.. Buffer         : 5 - ProjectSuite Configuration
..                  9 - ActivityReport
..
.. Variables      : U|xttransdat - file for transaction data
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   : 
...Includes       :
..*****************************************************************************
..
.set trans -
..
.type text xttyp             ? _F|defined(U|xttyp)
.type text xytname           ? _F|defined(U|xytname)
.type text xytpname          ? _F|defined(U|xytpname)
.type text xytpr             ? _F|defined(U|xytpr)
.type text xytpt             ? _F|defined(U|xytpt)
.type text xytwp             ? _F|defined(U|xytwp)
.type text xyetype           ? _F|defined(U|xyetype)
..
..*****************************************************************************
..
..!meta 5|=P146:1
..!meta 9|=P147:1
..
..if xttyp is empty, "ypmkbuchtrans" transaction entry from configuration in activity report
.formula U|xttyp = ""
..
.continue               ?  9|yarbzeit = 0
.continue               ? _9|ypersperstypk = "EM" ; 9|yperskstelle^id = 9|ypraaktr^id
..
..Transaction Type A
..
.formula U|xttyp = "A"
.output new 'U|xttransdat'
.input DATEI.F
..
.formula U|xytpname = '9|ypersonal^namebspr'<<";"
.formula U|xytname  = "LV " + U|xytpname + ", " + '9|ytaetschl^namebspr'<<";" + ", " + '9|yadatum'
.formula U|xytpr    = ""
.formula U|xytpr    = 9|yprojekt^nummer                 ? _F|empty(9|yprojekt)
.formula U|xytpt    = ""
.formula U|xytpt    = 9|ypvorgang^nummer                ? _F|empty(9|ypvorgang)
.formula U|xytwp    = ""
.formula U|xytwp    = 9|ypvorgang^yarbpaket^nummer      ? _F|empty(9|ypvorgang^yarbpaket)
..
.formula U|xyetype  = "S"
.formula U|xyetype  = "F"                               ?  9|ypersleiart^ybfibuslv
..
..K# name       # date               # payable cost center     # servicetype            # Typ # quantity     # cost Object         # Pos-BuText   # project   # projecttask # entry type #
1 # 'U|xytname' # '9|yadatum(L="0")' # '9|yperskstelle^nummer' # '9|ypersleiart^nummer' # fix # '9|yarbzeit' # '9|ypraaktr^nummer' # 'U|xytpname' # 'U|xytpr' # 'U|xytpt' # 'U|xyetype' #
..
.output NEW WERF.WEG
..
.continue
