..
.set trans -
..
..!meta 5|=P146:1
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"           ? _F|defined(5|ybstdfortbudicon)
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_FORTBUD"                     ?  5|ybstdfortbudicon  & _F|regmatch(P|maskkontextfop, ".*ICON_FORTBUD.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_FORTBUD", "")       ? _5|ybstdfortbudicon 
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_FORTPLAN"                    ?  5|ybstdfortplanicon & _F|regmatch(P|maskkontextfop, ".*ICON_FORTPLAN.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_FORTPLAN", "")      ? _5|ybstdfortplanicon
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_TECHFORT"                    ?  5|ybstdtechforticon & _F|regmatch(P|maskkontextfop, ".*ICON_TECHFORT.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_TECHFORT", "")      ? _5|ybstdtechforticon
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_ABWBUD"                      ?  5|ybstdbudgetabicon & _F|regmatch(P|maskkontextfop, ".*ICON_ABWBUD.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_ABWBUD", "")        ? _5|ybstdbudgetabicon
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_ABWPLAN"                     ?  5|ybstdplanabicon   & _F|regmatch(P|maskkontextfop, ".*ICON_ABWPLAN.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_ABWPLAN", "")       ? _5|ybstdplanabicon
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_ABWPHYS"                     ?  5|ybstdphysabicon   & _F|regmatch(P|maskkontextfop, ".*ICON_ABWPHYS.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_ABWPHYS", "")       ? _5|ybstdphysabicon
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_ABWTERM"                     ?  5|ybstdterminabicon & _F|regmatch(P|maskkontextfop, ".*ICON_ABWTERM.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_ABWTERM", "")       ? _5|ybstdterminabicon
..
.formula P|maskkontextfop = P|maskkontextfop + " " + "ICON_KRITVOR"                     ?  5|ybstdkritvoricon  & _F|regmatch(P|maskkontextfop, ".*ICON_KRITVOR.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ICON_KRITVOR", "")       ? _5|ybstdkritvoricon
..
.continue
