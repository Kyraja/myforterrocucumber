..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMCLABGLEICH.EV
..==  Pfad              : allpstart
..==  Funktion          : Abgleich der Impoerirten Checklisten der externen
..==                      Leistungserfassung mit den Checklisten der Aufgabe
..==  Erstellungsdatum  : 04.06.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/CL.KONFIG.INI"
..====================================================
.type text    xtsys xtsel
.type bool    xbneu xbmehr
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "buttonvor")
.continue BRK002 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC002
!BRK002
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK001
.continue BRK003 ? _(G|evtart = "buttonnach")
.continue BRK004 ? _(G|evtvar = "bstart")
.continue EL001 ? _(_(F|empty(M|ytmpverw)))
.formula U|xtsel = "$,,ytmpverw==" + M|ytmpverw
.load 0 group 'U|xydbgrclcheckl' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.make screen line +O
.assign M|ycheckliste = 0|id
.assign M|yclid       = 0|id
.assign M|yclnum      = 0|nummer
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.continue EL002 ? _(M|tzeilen > 0)
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL003 ? _(_(M|yerledigt))
.load 0 object 'M|ycheckliste^id'
.continue EL004 ? _(G|mehr)
.select lock nowait object '0|id'
.continue EL005 ? _(G|gesperrt)
.select lock nowait object '0|yobjektid'
.continue EL006 ? _(G|mehr)
.continue EL007 ? _(G|gesperrt)
.continue EL008 ? _((H|dnr    = U|xydbclcheckl) & (H|gruppe = U|xygrclcheckl))
.load 0 line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.select header
.select line
.assign U|xbmehr = G|mehr
.assign U|xbneu  = G|TRUE
!LOOP004: ==============================
.continue ELOP004 ? _(U|xbmehr)
.continue EL009 ? _(H|ytbeschr = 0|ytbeschr)
.assign H|ytablage = 0|ytablage
.assign U|xbmehr = G|FALSE
.assign U|xbneu  = G|FALSE
.continue FI009
!EL009
.select line
.assign U|xbmehr = G|mehr
!FI009
.continue LOOP004
!ELOP004: ==============================
.continue EL010 ? _(U|xbneu)
.select line 'H|tzeilen'
.make line +
.assign H|ytbeschr    = 0|ytbeschr
.assign H|ytverweisid = 0|ytverweisid
.assign H|ytdokument  = 0|ytdokument^id
.assign H|ytablage    = 0|ytablage
.assign H|ytresvp = 0|ytresvp^id
.assign H|ytrest  = 0|ytrest
.assign H|ytresr  = 0|ytresr
.assign H|ytresi  = 0|ytresi
.assign H|ytresb  = 0|ytresb
.assign H|ytresd  = 0|ytresd
.assign H|ytresz  = 0|ytresz
.assign H|ytresgp = 0|ytresgp
!EL010
.load 0 line
.continue LOOP003
!ELOP003: ==============================
.rewrite
.assign M|yerledigt = G|TRUE
.continue FI008
!EL008
.set TRANS +
.formula M|ytext = "Fehler: Checkliste " + 'M|ycheckliste' + ":" + "Objekt " + '0|yobjektid' + " ist keine Checkliste."
.set TRANS -
!FI008
.continue FI007
!EL007
.set TRANS +
.formula M|ytext = "Fehler: Checkliste " + 'M|ycheckliste' + ":" + "kann Checkliste zur Aufgabe " + '0|yobjektid' + " nicht bearbeiten (Sperre)."
.set TRANS -
!FI007
.continue FI006
!EL006
.set TRANS +
.formula M|ytext = "Fehler: Checkliste " + 'M|ycheckliste' + ":" + "kann Checkliste zur Aufgabe " + '0|yobjektid' + " nicht laden."
.set TRANS -
!FI006
.continue FI005
!EL005
.set TRANS +
.formula M|ytext = "Fehler: Checkliste " + 'M|ycheckliste' + " kann nicht bearbeitet werden (Sperre)."
.set TRANS -
!FI005
.continue FI004
!EL004
.set TRANS +
.formula M|ytext = "Fehler: Checkliste " + 'M|ycheckliste' + " kann nicht geladen werden."
.set TRANS -
!FI004
!EL003
.select lock nowait object '0|id'
.continue EL011 ? _(G|gesperrt)
.delete
.continue FI011
!EL011
.set TRANS +
.formula M|ytext = "Fehler: Checkliste " + 'M|ycheckliste' + " konnte nicht gel”scht werden."
.set TRANS -
!FI011
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue FI002
!EL002
.set TRANS +
.box Fehler
Keine Checklisten mit tempor„rem Verweis gefunden.
.set TRANS -
!FI002
.continue FI001
!EL001
.set TRANS +
.box Fehler
Kein Tempor„rer Verweis eingetragen.
.set TRANS -
!FI001
.continue ESAC003
!BRK004
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "ytmpverw")
.make screen line --O
.continue ESAC004
!BRK006
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK005
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMCLABGLEICH.EV")'     ? F|fileexists(F|foppath("IFOP.IS.PRJMCLABGLEICH.EV"))
.continue
