!EL025
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.copy U|xbaufparam = M|ybaufparam       ? F|defined(M|ybaufparam)
.continue BRK001 ? _(G|evtart = "maskein")
.copy   M|yballekst         = G|true    ? F|defined(M|yballekst)
.copy   M|ybproffen         = G|true    ? F|defined(M|ybproffen)
.protection yvondatum 0                 ? F|defined(M|yvondatum)
.protection ybisdatum 0                 ? F|defined(M|ybisdatum)
.assign M|yprojstatus       = "(AKT)"   ? F|defined(M|yprojstatus)
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskende")
.end .          ? M|ybmaskezu
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "feldaus")
.continue BRK004 ? _(G|evtvar = "ybaufparam")
.continue EL030 ? _(M|ybaufparam)
.protection -RESET yvondatum      0
.protection -RESET ybisdatum      0
.continue FI030
!EL030
.protection        yvondatum      0     ? _M|ybprabgeschlossen
.protection -RESET yvondatum      0     ?  M|ybprabgeschlossen
.protection        ybisdatum      0     ? _M|ybprabgeschlossen
.protection -RESET ybisdatum      0     ?  M|ybprabgeschlossen
!FI030
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "ymonat")
.continue EL031 ? _((M|ymonat < 1) ; (M|ymonat > 12))
.set TRANS +
.box Hinweis
Es sind nur Werte zwischen 1 und 12 erlaubt.
.set TRANS -
.formula M|ymonat =  F|month(G|datum)
!EL031
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "yjahr")
.formula M|yjahr  = 'F|year(G|datum)'    ?  F|empty(M|yjahr)
.continue ESAC002
!BRK006
.continue BRK007 ? _(G|evtvar = "yvondatum")
.formula U|xdbis     = ">" + 'F|year(M|yvondatum)' + "Y" + 'F|month(M|yvondatum)' + "M"
.formula M|ybisdatum = U|xdbis
.continue ESAC002
!BRK007
.continue BRK008 ? _(G|evtvar = "ybisdatum")
.continue EL032 ? _(M|ybisdatum < M|yvondatum)
