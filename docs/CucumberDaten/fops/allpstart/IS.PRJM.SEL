..!interpreter english declaration noabbrev
.. at 2017-06-26, 15:48
.set TRANS -
..========================================================================
..==  Name              : IS.PRJM.SEL
..==  Pfad              : allpstart
..==  Funktion          : Belegung der Kopffelder in den Projektmanagement IS, Cursorsteuerung
..==  Erstellungsdatum  : 24.02.2011
..==  Autor             : Sebastian Strobel, Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"      ? _F|defined(U|xydbprojekt)
.input "allpstart/FOP.PRJM.UP.DEF"      ? _F|defined(U|xtupprjmsel)
..====================================================
.type text    xytmp         ? _F|defined(U|xytmp)
.type text    xtcmd         ? _F|defined(U|xtcmd)
.type text    xykoobjekt    ? _F|defined(U|xykoobjekt)
.type text    xytselindex   ? _F|defined(U|xytselindex)
.type text    xytselindtp   ? _F|defined(U|xytselindtp)
.type text    xytselindnum  ? _F|defined(U|xytselindnum)
.type integer xivar         ? _F|defined(U|xivar)
.type integer xytpstufe     ? _F|defined(U|xytpstufe)
.type integer xyiselindex   ? _F|defined(U|xyiselindex)
.type GD19    xdvon         ? _F|defined(U|xdvon)
.type GD19    xdbis         ? _F|defined(U|xdbis)
.type GD      xddat         ? _F|defined(U|xddat)
.type bool    xbleer        ? _F|defined(U|xbleer)
.type bool    xbprok        ? _F|defined(U|xbprok)
.type bool    xyberlaubt    ? _F|defined(U|xyberlaubt)
.type bool    xbaufparam    ? _F|defined(U|xbaufparam)
.type bool    xbselhist     ? _F|defined(U|xbselhist)
.type bool    xbseltp       ? _F|defined(U|xbseltp)
.type bool    xbselhp       ? _F|defined(U|xbselhp)
.type bool    xybnobox      ? _F|defined(U|xybnobox)
.type bool    xybselkst     ? _F|defined(U|xybselkst)
.type P86:1   xpproject     ? _F|defined(U|xpproject)
.type symtab  xstselproj    ? _F|defined(U|xstselproj)
.type symtab  xstselpnum    ? _F|defined(U|xstselpnum)
.type symtab  xstseltp      ? _F|defined(U|xstseltp)
.type symtab  xsttptp       ? _F|defined(U|xsttptp)
.type symtab  xsttpindex    ? _F|defined(U|xsttpindex)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set  demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Zeitraum_vorbelegen -----
.continue EL001 ? _(F|defined(M|yvondatum))
.formula U|xdvon     = "<Y"
.formula M|yvondatum = U|xdvon
!EL001
.continue EL002 ? _(F|defined(M|ybisdatum))
.formula U|xdbis     = ">M"
.formula M|ybisdatum = U|xdbis
!EL002
.continue 'xprocst.xprocsp'
!PROC002: ----- Kostenstellen_leeren -----
.formula U|xivar = 1
!LOOP001: ==============================
.continue ELOP001 ? _(F|defined(M|ykst.xivar))
.formula M|ykst.xivar     = ""
.formula U|xivar = U|xivar + 1
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC003: ----- Rechtepruefung -----
.copy U|xyberlaubt = G|true
.continue EL003 ? _((U|xypmrepruefind) ; (_(U|xbselhp)))
.assign U|xpproject = H|id
.input "allpstart/CHECK.PROJECT"
.continue EL004 ? _(_(U|xyberlaubt))
.error
.end 1
!EL004
!EL003
.continue 'xprocst.xprocsp'
!PROC004: ----- Teilprojekte -----
.assign U|xsttptp = ""
.formula U|xytpstufe = U|xytpstufe + 1
.type symtab F|row(U|xstseltp, U|xytpstufe)     ? _F|defined(F|row(U|xstseltp, U|xytpstufe))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yteilprojektzu==" + H|id
.formula U|xtsel = U|xtsel + ";bebuchbar==(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group "86:1" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC003
!RET001
.formula xprocsp = xprocsp - 1
.formula U|xytmp = F|tostring(U|xytpstufe) + F|tolower(H|such) + H|id
.type P86:1  F|map(U|xsttptp, U|xytmp)     ? _F|defined(F|map(U|xsttptp, U|xytmp))
.assign F|map(U|xsttptp, U|xytmp)  = H|id
.select continue
.continue LOOP002
!ELOP002: ==============================
.formula F|row(U|xstseltp, U|xytpstufe) = U|xsttptp
.formula U|xytselindtp = ""
.formula U|xytselindtp = F|nextelem(F|map(U|xsttptp, ""), U|xytselindtp, G|true)
!LOOP003: ==============================
.continue ELOP003 ? _(_(F|empty(U|xytselindtp)))
.select add F|map(U|xsttptp, U|xytselindtp)
.input 'M|tab'
.type text F|row(U|xsttpindex, U|xytpstufe)     ? _F|defined(F|row(U|xsttpindex, U|xytpstufe))
.formula F|row(U|xsttpindex, U|xytpstufe) = U|xytselindtp
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC004
!RET002
.formula xprocsp = xprocsp - 1
.formula U|xytselindtp = F|row(U|xsttpindex, U|xytpstufe)
.formula U|xsttptp = F|row(U|xstseltp, U|xytpstufe)
.formula U|xytselindtp = F|nextelem(F|map(U|xsttptp, ""), U|xytselindtp, G|true)
.continue LOOP003
!ELOP003: ==============================
.formula U|xytpstufe = U|xytpstufe - 1
.continue 'xprocst.xprocsp'
!PROC005: ----- Projekt -----
.copy U|xbprok = G|true
.continue EL005 ? _(_(F|defined(M|yprojstatus)))
.continue EL006 ? _(F|defined(M|ybproffen))
.copy U|xbprok = G|false
.copy U|xbprok = G|true     ? M|ybproffen         & (_H|yablage & _H|ystatusk = "FTAB")
.copy U|xbprok = G|true     ? M|ybproffen         & (_H|yablage &  H|ystatusk = "FTAB" & H|yprojekttyp^ybftaboffen)
!EL006
.continue EL007 ? _(F|defined(M|ybprabgeschlossen))
.copy U|xbprok = G|true     ? M|ybprabgeschlossen & ( H|yablage           & (H|yabldat    >= M|yvondatum ; F|empty(M|yvondatum)) & (H|yabldat    <= M|ybisdatum ; F|empty(M|ybisdatum)))
.copy U|xbprok = G|true     ? M|ybprabgeschlossen & ( H|ystatusk = "FTAB" & (H|yftabdatum >= M|yvondatum ; F|empty(M|yvondatum)) & (H|yftabdatum <= M|ybisdatum ; F|empty(M|ybisdatum)) & _H|yprojekttyp^ybftaboffen)
!EL007
.continue FI005
!EL005
.continue EL008 ? _(F|empty(M|yprojstatus))
.continue EL009 ? _(F|defined(M|ybproffen))
.copy U|xbprok = G|false
.copy U|xbprok = G|true     ? M|ybproffen         & (_H|yablage & _H|ystatusk = "FTAB")
.copy U|xbprok = G|true     ? M|ybproffen         & (_H|yablage &  H|ystatusk = "FTAB" & H|yprojekttyp^ybftaboffen)
!EL009
.continue EL010 ? _(F|defined(M|ybprabgeschlossen))
.copy U|xbprok = G|true     ? M|ybprabgeschlossen & ( H|yablage           & (H|yabldat    >= M|yvondatum ; F|empty(M|yvondatum)) & (H|yabldat    <= M|ybisdatum ; F|empty(M|ybisdatum)))
.copy U|xbprok = G|true     ? M|ybprabgeschlossen & ( H|ystatusk = "FTAB" & (H|yftabdatum >= M|yvondatum ; F|empty(M|yvondatum)) & (H|yftabdatum <= M|ybisdatum ; F|empty(M|ybisdatum)) & _H|yprojekttyp^ybftaboffen)
!EL010
!EL008
!FI005
.continue EL011 ? _(U|xbprok)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
.continue EL012 ? _(U|xyberlaubt)
.continue EL013 ? _(U|xbseltp)
.formula U|xyiselindex = U|xyiselindex + 1
.formula U|xytselindex = ("0000000" + 'U|xyiselindex')>>8
.formula U|xytselindnum = H|nummer
.type P86:1 F|map(U|xstselproj, U|xytselindex)    ? _F|defined(F|map(U|xstselproj, U|xytselindex))
.type P86:1 F|map(U|xstselpnum, U|xytselindnum)   ? _F|defined(F|map(U|xstselpnum, U|xytselindnum))
.assign F|map(U|xstselproj, U|xytselindex)  = H|id
.assign F|map(U|xstselpnum, U|xytselindnum) = H|id
.continue FI013
!EL013
.input 'M|tab'          ? _F|empty(M|tab)
!FI013
!EL012
!EL011
.continue 'xprocst.xprocsp'
!PROC006: ----- Start_Button -----
.copy U|xybnobox = G|true
.assign U|xstselproj = ""
.assign U|xstselpnum = ""
.formula U|xyiselindex = 0
.copy U|xbseltp = M|ybteilprojekte  ? F|defined(M|ybteilprojekte)
.copy U|xbselhp = G|true
.continue EL014 ? _(true)
.copy U|xybselkst = G|false
.continue EL015 ? _(F|empty(M|yprojekt))
.copy U|xybselkst = G|true  ?  U|xypmrepruefkst & _G|passw^yprjmallekoobj
.continue EL016 ? _(F|defined(M|yballekst))
.copy U|xybselkst = G|true  ? _M|yballekst
!EL016
!EL015
.continue EL017 ? _(U|xybselkst)
.input 'U|xtupkstarray'
.formula U|xyiselindex = 0
.formula U|xtindex    = ""
.formula U|xtindex    = F|nextelem(U|xtkst, xtindex)
!LOOP004: ==============================
.continue ELOP004 ? _(_(F|empty(U|xtindex)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yverantwkst=="  + U|xtkst.xtindex        ? _F|empty(U|xtkst.xtindex)
.formula U|xtsel = U|xtsel + ";yverantwkst==`" + U|xtkst.xtindex        ?  F|empty(U|xtkst.xtindex)
.formula U|xtsel = U|xtsel + ";yprojleit=="    + M|yprojleit^id         ?  F|defined(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojverantw==" + M|yprojverantw^id      ?  F|defined(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekttyp=="  + M|yprojekttyp^id       ?  F|defined(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";ykunde=="       + M|ykunde^id            ?  F|defined(M|ykunde)
.formula U|xtsel = U|xtsel + ";ykunde2=="      + M|ykunde2^id           ?  F|defined(M|ykunde2)
.formula U|xtsel = U|xtsel + ";ystatus=="      + M|yprojstatus^id       ?  F|defined(M|yprojstatus)
.continue EL018 ? _(F|defined(M|yprojstatus))
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen & F|empty(M|yprojstatus)
.continue FI018
!EL018
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen
!FI018
.formula U|xtsel = U|xtsel + ";bebuchbar==(Yes)"
.formula U|xtsel = U|xtsel + ";@order=such"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group "86:1" 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC005
!RET004
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP005
!ELOP005: ==============================
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
.continue LOOP004
!ELOP004: ==============================
.continue FI017
!EL017
.formula U|xtsel = M|yprojekt^id    ? _F|empty(M|yprojekt)
.continue EL019 ? _(F|empty(M|yprojekt))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojleit=="    + M|yprojleit^id         ?  F|defined(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojverantw==" + M|yprojverantw^id      ?  F|defined(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekttyp=="  + M|yprojekttyp^id       ?  F|defined(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";ykunde=="       + M|ykunde^id            ?  F|defined(M|ykunde)
.formula U|xtsel = U|xtsel + ";ykunde2=="      + M|ykunde2^id           ?  F|defined(M|ykunde2)
.formula U|xtsel = U|xtsel + ";ystatus=="      + M|yprojstatus^id       ?  F|defined(M|yprojstatus)
.continue EL020 ? _(F|defined(M|yprojstatus))
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen & F|empty(M|yprojstatus)
.continue FI020
!EL020
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen
!FI020
.formula U|xtsel = U|xtsel + ";bebuchbar==(Yes)"
.formula U|xtsel = U|xtsel + ";@order=such"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
!EL019
.select group "86:1" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC005
!RET005
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP006
!ELOP006: ==============================
!FI017
.continue FI014
!EL014
.continue EL021 ? _((F|empty(M|yprojekt)) & (((U|xypmrepruefkst) & (_(G|passw^yprjmallekoobj))) ; (_(M|yballekst))))
.input 'U|xtupkstarray'
.formula U|xyiselindex = 0
.formula U|xtindex    = ""
.formula U|xtindex    = F|nextelem(U|xtkst, xtindex)
!LOOP007: ==============================
.continue ELOP007 ? _(_(F|empty(U|xtindex)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yverantwkst=="  + U|xtkst.xtindex        ? _F|empty(U|xtkst.xtindex)
.formula U|xtsel = U|xtsel + ";yverantwkst==`" + U|xtkst.xtindex        ?  F|empty(U|xtkst.xtindex)
.formula U|xtsel = U|xtsel + ";yprojleit=="    + M|yprojleit^id         ?  F|defined(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojverantw==" + M|yprojverantw^id      ?  F|defined(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekttyp=="  + M|yprojekttyp^id       ?  F|defined(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";ykunde=="       + M|ykunde^id            ?  F|defined(M|ykunde)
.formula U|xtsel = U|xtsel + ";ykunde2=="      + M|ykunde2^id           ?  F|defined(M|ykunde2)
.formula U|xtsel = U|xtsel + ";ystatus=="      + M|yprojstatus^id       ?  F|defined(M|yprojstatus)
.continue EL022 ? _(F|defined(M|yprojstatus))
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen & F|empty(M|yprojstatus)
.continue FI022
!EL022
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen
!FI022
.formula U|xtsel = U|xtsel + ";bebuchbar==(Yes)"
.formula U|xtsel = U|xtsel + ";@order=such"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group "86:1" 'U|xtsel'
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC005
!RET006
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP008
!ELOP008: ==============================
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
.continue LOOP007
!ELOP007: ==============================
.continue FI021
!EL021
.formula U|xtsel = M|yprojekt^id    ? _F|empty(M|yprojekt)
.continue EL023 ? _(F|empty(M|yprojekt))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojleit=="    + M|yprojleit^id         ?  F|defined(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojverantw==" + M|yprojverantw^id      ?  F|defined(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekttyp=="  + M|yprojekttyp^id       ?  F|defined(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";ykunde=="       + M|ykunde^id            ?  F|defined(M|ykunde)
.formula U|xtsel = U|xtsel + ";ykunde2=="      + M|ykunde2^id           ?  F|defined(M|ykunde2)
.formula U|xtsel = U|xtsel + ";ystatus=="      + M|yprojstatus^id       ?  F|defined(M|yprojstatus)
.continue EL024 ? _(F|defined(M|yprojstatus))
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen & F|empty(M|yprojstatus)
.continue FI024
!EL024
.formula U|xtsel = U|xtsel + ";yablage==(No)"   ? _M|ybprabgeschlossen
!FI024
.formula U|xtsel = U|xtsel + ";bebuchbar==(Yes)"
.formula U|xtsel = U|xtsel + ";@order=such"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
!EL023
.select group "86:1" 'U|xtsel'
!LOOP009: ==============================
.continue ELOP009 ? _(G|mehr)
