.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC005
!RET007
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP009
!ELOP009: ==============================
!FI021
!FI014
.continue EL025 ? _(U|xbseltp)
.copy U|xbselhp = G|false
.formula U|xytselindex = ""
.formula U|xytselindex = F|nextelem(F|map(U|xstselproj, ""), U|xytselindex, G|true)
!LOOP010: ==============================
.continue ELOP010 ? _(_(F|empty(U|xytselindex)))
.continue EL026 ? _(_(F|empty(F|map(U|xstselproj, U|xytselindex))))
.select add F|map(U|xstselproj, U|xytselindex)
.continue EL027 ? _(G|mehr)
.copy U|xbprok = G|true
.continue EL028 ? _(_(F|empty(H|yteilprojektzu)))
.formula U|xytselindnum = H|yteilprojektzu^nummer
.copy    U|xbprok       = G|false           ? F|defined(F|map(U|xstselpnum, U|xytselindnum))
!EL028
.continue EL029 ? _(U|xbprok)
.input 'M|tab'          ? _F|empty(M|tab)
.assign  U|xstseltp = ""
.formula U|xytpstufe = 0
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
