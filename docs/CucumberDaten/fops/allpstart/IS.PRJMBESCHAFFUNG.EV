.output new WERF.WEG
.set trans +
.formula U|xterrtext = "Fehler beim Anlegen des "
.formula U|xterrtext = U|xterrtext + "Bestellvorschlags:"       ? M|ytartbdeckungk = "BV"
.formula U|xterrtext = U|xterrtext + "Umlagerungsvorschlags:"   ? M|ytartbdeckungk = "UV"
.set trans -
.select -
.formula U|xtsys = "xmlimport.sh -p " + G|einmalpw + " -r REF -o UPDATEMODE=STRICT -I " + U|xtedpdat + " -H " + U|xtedpmsg + " 1>" + U|xtedpout + " 2>" + U|xtedperr
.input "allpstart/FOP.ALL.EDP.CHECK"
.continue EL022 ? _((F|empty(M|ytekpos)) & (F|fileexists(U|xtedpout)))
.select from
.select from 'U|xtedpout' U|xtsel^
.assign M|ytekpos = U|xtsel
.continue FI022
!EL022
.continue EL023 ? _(M|ytekpos^id = "(0,0,0)")
.assign M|ytekpos = ""
.protection -exception ytbuzeile 'M|aktzeile'
.protection -exception buaktion  'M|aktzeile'
.protection -exception buinfosys 'M|aktzeile'
.protection -exception budruck   'M|aktzeile'
.protection -line 'M|aktzeile'
.continue FI023
!EL023
.add M|ytekpos
.continue EL024 ? _(_(G|mehr))
.assign M|ytekpos = ""
.protection -exception ytbuzeile 'M|aktzeile'
.protection -exception buaktion  'M|aktzeile'
.protection -exception buinfosys 'M|aktzeile'
.protection -exception budruck   'M|aktzeile'
.protection -line 'M|aktzeile'
!EL024
!FI023
!FI022
.copy    M|ytbspeichern = G|FALSE
.formula M|ytbustorno   = ""
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
.continue EL025 ? _(_(F|empty(M|ytekpos)))
.continue EL026 ? _((_(G|evtart = "maskpruef")) & (_(G|evtart = "maskabbr")))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC008
!RET003
