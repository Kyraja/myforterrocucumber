!PROC010: ----- IS_PRJMEK -----
.continue EL027 ? _(G|evtzeile = 0)
.formula U|xtcmd = G|kkomname38 + " PRJMEKANPOS ? ybmaskezu=1"      ?  G|evtvar = "ybuanfrage"      ; G|evtvar = "ytbuanfrage"
.formula U|xtcmd = G|kkomname38 + " PRJMEKBEPOS ? ybmaskezu=1"      ?  G|evtvar = "ybubestellung"   ; G|evtvar = "ytbubestellung"
.formula U|xtcmd = G|kkomname38 + " PRJMEKLSPOS ? ybmaskezu=1"      ?  G|evtvar = "ybulieferschein" ; G|evtvar = "ytbulieferschein"
.formula U|xtcmd = G|kkomname38 + " PRJMEKREPOS ? ybmaskezu=1"      ?  G|evtvar = "yburechnung"     ; G|evtvar = "ytburechnung"
.formula U|xtcmd = U|xtcmd + "|yprojek="  +  U|xtprojek     ? _F|empty(U|xtprojek)   & _U|xtprojek = "xxxxx"
.formula U|xtcmd = U|xtcmd + "|bstart="
.command -wait 'U|xtcmd'
.continue FI027
!EL027
.select screen line 'G|evtzeile'
.continue EL028 ? _((G|evtvar = "ytbubestellung") & (M|ytekpos^kotyp = G|ABKO))
.'F|expr("command -PARALLEL "+ M|ytekpos^id)'
.continue FI028
!EL028
.formula U|xianz = 0
.continue EL029 ? _((_(F|empty(M|ytekpos))) & (G|evtvar = "ytbulieferschein"))
.formula U|xtsel = "$,,orig==" + M|ytekpos^id
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|LIKO' + ")"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 9 group "4:2" 'U|xtsel'
.continue EL030 ? _(G|mehr)
.formula U|xianz = 1
.formula U|xtid  = 9|id
.load 9 continue
.formula U|xianz = U|xianz + 1  ? G|mehr
!EL030
!EL029
.continue EL031 ? _((_(F|empty(M|ytekpos))) & (G|evtvar = "ytburechnung"))
.formula U|xianz = 0
.formula U|xtsel = "$,,orig==" + M|ytekpos^id
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|REKO' + ")"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 9 group "4:2" 'U|xtsel'
.continue EL032 ? _(G|mehr)
.formula U|xianz = 1
.formula U|xtid  = 9|id
.load 9 continue
