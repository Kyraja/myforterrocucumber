..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtftext xtid xtparam xykoobjekt xtpvorgang xtlief xtartbdeckungk xtprojekt
.type text    xtedpdat xtedpout xtedperr xtedpmsg xterrtext xttmpdat xtekposid xtmge xtpwert xteinh xtverw
.type text    xtvar xtkenner xtprojek xtteil xysel xtindex xtmenue
.type real    xrmge
.type P86:1   xpprojekt    ? _F|defined(U|xpprojekt)
.type P149:2  xppvorgang   ? _F|defined(U|xppvorgang)
.type integer xianz xizeile xyvdn xyvgr ximenue
.type bool    xyberlaubt xbmenue xbmehr xbok xbneu xbyes xbstart xbprotect xybnoprsel xbausschreibung
.type symtab  xstbvs
.type AS48    xfilingmode
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- VerwendungVorbelegen -----
.continue EL001 ? _(_(F|empty(M|ytteil)))
.copy U|xpprojekt  = M|ytprojekt
.copy U|xppvorgang = M|ytpvorgang
.input "allpstart/FOP.PRJM.UP.VERW"
.formula M|ytprjmverw = U|xtverw    ? _F|empty(U|xtverw)
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- CheckUnit -----
.continue EL002 ? _(_(F|empty(M|ytteil)))
.add M|ytteil
.continue BRK001 ? _(D|gruppe = 2)
.copy M|yteinh = M|ytteil^le
.continue ESAC001
!BRK001
.continue BRK002 ? _(D|gruppe = 4)
.continue EL003 ? _((M|yteinh <> D|le) & (M|yteinh <> D|vhe) & (M|yteinh <> D|ehe) & (M|yteinh <> D|vpe) & (M|yteinh <> D|epe))
.set trans +
.box
Einheit 'M|yteinh' ist nicht im Artikel 'M|ytteil^such' definiert!
.set trans -
.error
.end 1
!EL003
.continue ESAC001
!BRK002
.continue EL004 ? _((M|yteinh <> D|le) & (M|yteinh <> D|vhe) & (M|yteinh <> D|ehe) & (M|yteinh <> D|vpe) & (M|yteinh <> D|epe) & (M|yteinh <> D|ve) & (M|yteinh <> D|ge))
.set trans +
.box
Einheit 'M|yteinh' ist nicht im Artikel 'M|ytteil^such' definiert!
.set trans -
.error
.end 1
!EL004
!ESAC001: =====   ENDCASE   =====
!EL002
.continue 'xprocst.xprocsp'
!PROC003: ----- TabelleLaden -----
.file -tempname U|xtftext
.input DATEI.F
.copy   U|xbstart     = G|true
.assign U|xfilingmode = "(Both)"    ?  M|ybposabgelegt
.assign U|xfilingmode = "(Active)"  ? _M|ybposabgelegt
.input "allpstart/PRJM.KONFIG.INI"
.make screen line --O
.input 'U|xtupprjmsel'  ?  F|empty(M|ypvorgang)
.input 'M|tab'          ? _F|empty(M|ypvorgang)
.continue 'xprocst.xprocsp'
!PROC004: ----- Feldschutz_Kopf -----
.protection        yarbpaket   0        ?  F|empty(M|yprojekt)
.protection -RESET yarbpaket   0        ? _F|empty(M|yprojekt)
.continue 'xprocst.xprocsp'
!PROC005: ----- Zeile_einfuegen -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ypmekartbdeckungk)
.formula U|xizeile = G|evtzeile - 1
.select screen line 'G|evtzeile'    ? _G|evtart = "zeileeinnach"
.select screen line 'U|xizeile'     ?  G|evtart = "zeileeinnach" & U|xizeile > 0
.formula U|xtpvorgang     = ""
.formula U|xtprojekt      = ""
.continue EL005 ? _((M|aktzeile = 0) ; ((M|aktzeile = 1) & (G|evtart = "zeileeinnach")))
.formula U|xtpvorgang     = M|ypvorgang^id      ? _F|empty(M|ypvorgang) & _M|ypvorgang^yablage & (M|ypvorgang^yreftypk = "04" ; F|empty(M|ypvorgang^yreftypk))
.formula U|xtartbdeckungk = 5|ypmekartbdeckungk
.continue FI005
!EL005
.formula U|xtpvorgang     = M|ytpvorgang^id     ?  F|empty(M|ypvorgang) & _M|ytpvorgang^yablage & (M|ytpvorgang^yreftypk = "04" ; F|empty(M|ytpvorgang^yreftypk))
.formula U|xtpvorgang     = M|ypvorgang^id      ? _F|empty(M|ypvorgang) & _M|ypvorgang^yablage  & (M|ypvorgang^yreftypk  = "04" ; F|empty(M|ypvorgang^yreftypk))
.formula U|xtartbdeckungk = M|ytartbdeckungk
!FI005
.formula U|xianz = 0
.formula U|xianz = U|xianz + 1  ? 5|ypmekbpvb
.formula U|xianz = U|xianz + 1  ? 5|ypmekbbv
.formula U|xianz = U|xianz + 1  ? 5|ypmekbuv
.make screen line +O                ? _G|evtart = "zeileeinnach"
.select screen line 'G|evtzeile'    ?  G|evtart = "zeileeinnach"
.formula M|ytbuzeile     = "icon:plus"
.formula M|ytbustorno    = "icon:minus"
.assign M|ytpvorgang     = U|xtpvorgang
.copy   M|ytprojekt      = M|ytpvorgang^yprojekt
.copy   M|ytprojekt      = M|yprojekt               ? F|empty(M|ytpvorgang) & F|empty(M|ytprojekt)
.assign M|ytartbdeckungk = U|xtartbdeckungk
.copy   M|ytartbdeckungk = 5|ypmekartbdeckungk      ? F|empty(M|ytartbdeckungk)
.protection ytbanfrage     'M|aktzeile'
.protection ytartbdeckungk 'M|aktzeile' ? U|xianz = 0
.continue 'xprocst.xprocsp'
!PROC006: ----- Zeile_loeschen -----
.continue EL006 ? _(_(F|empty(M|ytekpos)))
.error
.end 1
.formula U|xtsel = "$,,yprjmpekposid==" + M|ytekpos^id + ";@filingmode=(3)"
.select group "4:2" 'U|xtsel'
.continue EL007 ? _(G|mehr)
.set trans +
.box Fehler
Es gibt bereits nachfolgende VorgÑnge zu dieser Beschaffung.
Zeile kann nicht gelîscht werden.
.set trans -
.error
.end 1
!EL007
!EL006
.make screen line -     ? _G|evtart = "zeileloevor"
.continue 'xprocst.xprocsp'
!PROC007: ----- Protection -----
.copy U|xbprotect = G|FALSE
.copy U|xbprotect = G|true  ? _F|empty(M|ytpvorgang) & (M|ytpvorgang^ablagef ; M|ytpvorgang^yablage)
.copy U|xbprotect = G|true  ? _F|empty(M|ytprojekt)  & (M|ytprojekt^ablagef  ; M|ytprojekt^yablage)
.continue EL008 ? _(U|xbprotect)
.protection -LINE 'M|aktzeile'
.continue FI008
!EL008
.continue EL009 ? _((F|empty(M|ytekpos)) ; (_(F|empty(M|ytekpos^kopf))))
.protection ytpvorgang    'M|aktzeile'
.protection ytprojekt     'M|aktzeile'
.protection ytarbpaket    'M|aktzeile'  ? F|empty(M|ytekpos)
.protection ytbez         'M|aktzeile'  ? F|empty(M|ytekpos)
.protection ytteil        'M|aktzeile'
.protection ytlief        'M|aktzeile'
.protection ytftext       'M|aktzeile'  ? F|empty(M|ytekpos)
.protection ytmge         'M|aktzeile'
.protection yteinh        'M|aktzeile'
.protection ytplandatlief 'M|aktzeile'
.continue FI009
!EL009
.continue EL010 ? _(M|ytteil^gruppe = 4)
.protection yteinh 'M|aktzeile'    ? 'M|ytteil^zptyp(L="0")' = "(12)"
!EL010
.protection yteinh 'M|aktzeile'             ? F|empty(M|ytteil^le)
!FI009
.continue EL011 ? _(M|ytekpos^ablagef)
.protection ytbspeichern     'M|aktzeile'
.protection ytbez            'M|aktzeile'
.protection ytftext          'M|aktzeile'
.protection ytarbpaket       'M|aktzeile'
.protection ytbem            'M|aktzeile'
.protection ytprjmverw       'M|aktzeile'
.protection ytbedarfstraeger 'M|aktzeile'
.protection ytbudgetwert     'M|aktzeile'
.protection ytfcwert         'M|aktzeile'
.protection ytplandatanf     'M|aktzeile'
.protection ytplandatang     'M|aktzeile'
.protection ytplandatbest    'M|aktzeile'
!EL011
.protection ytartbdeckung 'M|aktzeile'
!FI008
.continue 'xprocst.xprocsp'
!PROC008: ----- WerteAktualisieren -----
.load 9 add M|ytekpos
.continue EL012 ? _(G|mehr)
.formula M|ytprojek         = 9|yprjmpprojek
.formula M|ytmge            = 9|mge
.formula M|ytmge            = 9|pwert   ? 9|mge = 0
.assign  M|yteinh           = 9|he
.copy    M|ytlief           = 9|lief
.formula M|yttterm          = 9|tterm
.formula M|ytfterm          = 9|fterm
.formula M|ytbstwert        = 9|nwert   ? 9|kotyp = G|ABKO
.formula M|ytbstwert        = 9|pwert   ? F|empty(9|kopf)
.formula M|ytprjmverw       = 9|verw
.continue EL013 ? _(9|kotyp = G|ANKO)
.formula M|ytbstwert = 0
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprjmpekposid==" + M|ytekpos^id
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|ABKO' + ")"
.formula U|xtsel = U|xtsel + ";@filingmode=(3)"
.load 9 group "4:2" 'U|xtsel'
.formula M|ytbubestellung = "icon:information"  ? G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|ytmge            = 9|mge
.assign  M|yteinh           = 9|he
.formula M|yttterm          = 9|tterm
.formula M|ytfterm          = 9|fterm
.formula M|ytbstwert = M|ytbstwert + 9|nwert                                            ? 9|pland =  G|inland
.formula M|ytbstwert = M|ytbstwert + F|fxamount(G|inland,9|nwert,,9|pland,G|true)       ? 9|pland <> G|inland
.load 9 continue
.continue LOOP001
!ELOP001: ==============================
.load 9
!EL013
!EL012
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC007
!RET001
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC009: ----- Speichern -----
.input is/ABASFARBEN.DEF
.copy U|xbmenue = G|true      ? G|evtart <> "maskpruef" & G|evtart <> "maskaus" & G|evtvar <> "ybuspeichern"
.select screen header
.select screen line
.copy U|xbmehr = G|mehr
!LOOP002: ==============================
.continue ELOP002 ? _(U|xbmehr)
.continue EL014 ? _(M|ytbspeichern)
.continue EL015 ? _(U|xbmenue)
!REPT001: ==============================
.set trans +
.menu (0,0,3) Achtung
Es wurden noch nicht alle VorgÑnge gespeichert!

speichern
ohne speichern fortfahren
.set trans -
.error
.continue REPT001 ? _((G|menue = 3) ; (G|menue = 4))
.copy U|xbmenue = G|FALSE
.copy U|xbmehr  = G|FALSE     ? G|menue = 4
!EL015
.continue EL016 ? _(U|xbmehr)
.continue EL017 ? _(((F|empty(M|ytprojekt)) & (F|empty(M|ytpvorgang))) ; (F|empty(M|ytteil)) ; ((F|empty(M|ytekpos)) & (F|empty(M|ytmge))) ; ((F|empty(M|ytekpos^kopf)) & (F|empty(M|ytartbdeckungk))) ; ((M|ytartbdeckungk ="UV") & (F|empty(M|ytteil^umllg))))
.set trans +
.box Fehler
?Projektvorgang in Zeile 'M|aktzeile' ist nicht gefÅllt.                    ? F|empty(M|ytpvorgang) & F|empty(M|ytprojekt)
?Art der Bedarfsdeckung in Zeile 'M|aktzeile' ist nicht gefÅllt.            ? F|empty(M|ytartbdeckungk)
?Artikel in Zeile 'M|aktzeile' ist nicht gefÅllt.                           ? F|empty(M|ytteil)
?Menge/Wert in Zeile 'M|aktzeile' ist nicht gefÅllt.                        ? F|empty(M|ytmge)
?Umlagerungslagergruppe im Artikel in Zeile 'M|aktzeile' ist nicht gefÅllt. ? F|empty(M|ytteil^umllg) & _F|empty(M|ytteil) & M|ytartbdeckungk ="UV"

Zeile kann nicht gespeichert werden.
.set trans -
.continue FI017
!EL017
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.continue EL018 ? _((F|empty(M|ytekpos)) ; (_(M|ytekpos^ablagef)))
.file -tempname U|xtedpdat
.file -tempname U|xtedpout
.file -tempname U|xtedperr
.file -tempname U|xtedpmsg
.output new 'U|xtedpdat' -ENCODING UTF-8
.input DATEI.F
<?xml version="1.0" encoding="UTF-8"?>
<?edp updatemode strict?>
<?edp langcode 'G|bsprache'?>
<ABASData reftype="ref">
  <RecordSet>
?    <Record database="4" group="7" action="NEW">                                   ?  F|empty(M|ytekpos) &  M|ytartbdeckungk = "BV"
?    <Record database="4" group="8" action="NEW">                                   ?  F|empty(M|ytekpos) &  M|ytartbdeckungk = "UV"
?    <Record database="4"           action="UPDATE"  id="'M|ytekpos^id'">           ? _F|empty(M|ytekpos) & _F|empty(M|ytartbdeckung)
?    <Record database="4"           action="UPDATE"  id="'M|ytekpos^kopf^id'">      ? _F|empty(M|ytekpos) &  F|empty(M|ytartbdeckung)
?     <Row rowOp="+">>                                              ?  F|empty(M|ytekpos)
?     <Row number="'M|ytekpos^id'">                                 ? _F|empty(M|ytekpos)
?      <Field name="artex">'M|ytteil^id'</Field>                    ?  F|empty(M|ytekpos)
?      <Field name="lief">'M|ytlief^id'</Field>                     ? _M|ytlief^id = M|ytekpos^lief^id & _F|protected(M|ytlief, M|aktzeile)
?      <Field name="mge">'M|ytmge'</Field>                          ? 'M|ytteil^zptyp(L=":")' = "(SOPOItemPOS)" ; _M|ytteil^gruppe = 4
?      <Field name="he">'M|yteinh(L=":")'</Field>                   ?('M|ytteil^zptyp(L=":")' = "(SOPOItemPOS)" ; _M|ytteil^gruppe = 4) & _F|empty(M|yteinh)
?      <Field name="pwert">'M|ytmge'</Field>                        ?_'M|ytteil^zptyp(L=":")' = "(SOPOItemPOS)" &  M|ytteil^gruppe = 4
      <Field name="ptext"><![CDATA['M|ytbez']]></Field>
      <Field name="yprjmppvorgang">'M|ytpvorgang^id'</Field>
      <Field name="projekt">'M|ytprojekt^id'</Field>
      <Field name="yprjmparbpaket">'M|ytarbpaket^id'</Field>
      <Field name="yprjmpbedarfstraeg">'M|ytbedarfstraeger^id'</Field>
      <Field name="yprjmpbem"><![CDATA['M|ytbem']]></Field>
      <Field name="verw"><![CDATA['M|ytprjmverw']]></Field>
      <Field name="yprjmpbudgetwert">'M|ytbudgetwert'</Field>
      <Field name="yprjmpfcwert">'M|ytfcwert'</Field>
      <Field name="yprjmpsolldatanf">'M|ytplandatanf:8'</Field>
      <Field name="yprjmpsolldatang">'M|ytplandatang:8'</Field>
      <Field name="yprjmpsolldatbest">'M|ytplandatbest:8'</Field>
      <Field name="yprjmpsolldatlief">'M|ytplandatlief:8'</Field>
?      <Field name="yprjmpprojek">'G|versionneu'</Field>            ?  F|empty(M|ytekpos)
.continue EL019 ? _((_(G|evtart = "maskabbr")) & (_(F|empty(M|ytekpos))))
.continue EL020 ? _(_(F|empty(M|ytftext)))
.copy U|xbmehr = G|FALSE
.select from
.select from 'M|ytftext' U|xtsel^
!LOOP003: ==============================
