!EL032
.continue EL033 ? _(U|xianz < 2)
.formula U|xianz = 0
.formula U|xtsel = "$,,orig==" + M|ytekpos^id
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|LIKO' + ")"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
