..!interpreter english declaration noabbrev
..*****************************************************************************
.. Name           : allprjm/FOP.PRJM.UP.AUFABPRUEF
.. Datum/Date     : 19.01.2010
.. Version        :
.. Autor/Author   : ts / alltrotec GmbH
.. Copyright      :
.. Beschreibung   : PrÅft ob die Arbeitsaufgabe in xtaufgabe odr fÅr den Projektvorgang
..                  in xtpvorgang abgeschlossen ist.
..                  U|xbaufab = G|TRUE wenn abgeschlossen oder keine Arbeitsaufgabe um PVorgang vorhanden
..                  U|xbaufab = G|FALSE wenn nicht abgeschlossen
..
...Includes       :
..*****************************************************************************
..
.set TRANS -
..
.type text xtsel         ? _F|defined(U|xtsel)
.type bool xbaufab       ? _F|defined(U|xbaufab)
..
..*****************************************************************************
..
.continue PVORGANG        ? _F|defined(U|xtaufgabe)
.continue PVORGANG        ?  U|xtaufgabe = ""
..
.load 9 group 'U|xydbgraufgabe' 'U|xtaufgabe'
.continue ENDE    ? _G|mehr
.continue STATUS
..
..
!PVORGANG:
.continue ENDE            ? _F|defined(U|xtpvorgang)
.continue ENDE            ?  U|xtpvorgang = ""
..
.assign U|xbaufab = G|true
.formula U|xtsel = "$,,ypvorgang==" + U|xtpvorgang
.load 9 group 'U|xydbgraufgabe' 'U|xtsel'
.continue ENDE    ? _G|mehr
..
..
!STATUS:
.assign U|xbaufab = G|FALSE
.assign U|xbaufab = G|TRUE    ? 9|ystatusk = "07" ; 9|ystatusk = "08
.load 9
..
!ENDE:
.continue
