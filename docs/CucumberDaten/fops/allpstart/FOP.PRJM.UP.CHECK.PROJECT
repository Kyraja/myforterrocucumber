..====================================================
.type text    xtsel         ? _F|defined(U|xtsel)
.type text    xttitel       ? _F|defined(U|xttitel)
.type text    xttext1       ? _F|defined(U|xttext1)
.type text    xttext2       ? _F|defined(U|xttext2)
.type bool    xbmehr        ? _F|defined(U|xbmehr)
.type bool    xbprueffab    ? _F|defined(U|xbprueffab)
.type bool    xbpruefkab    ? _F|defined(U|xbpruefkab)
.type P86:1   xpproject     ? _F|defined(U|xpproject)
.type integer   xprocsp     ? _F|defined(xprocsp)
..====================================================
.set demand -
.continue EPROCDEF
!PROC001: ----- ProjektFF -----
.continue EL001 ? _(((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|regmatch(G|evtfeldneu, "\*.*"))) & (_(F|regmatch(G|evtfeldneu, "\$.*"))) & (_(F|regmatch(G|evtfeldneu, "\%.*")))) ; (G|evtvar =  "kstelle") ; (G|evtvar =  "yprjmppvorgang"))
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue EL002 ? _((G|evtvar <> "yprjmppvorgang") & (G|evtvar <> "yprjmpvorgang") & (G|evtvar <> "kstelle"))
.formula U|xtsel = "$,,;@numsuch=" + G|evtfeldneu + ";@filingmode=(Active)"
.formula U|xtsel = G|evtfeldneu
.formula G|evtfeldneu = "?"     ? G|evtfeldneu = "!"
.continue EL003 ? _((F|regmatch(G|evtfeldneu, "\?")) ; (F|regmatch(G|evtfeldneu, "!,.*")) ; (F|regmatch(G|evtfeldneu, "\d.*")) ; (F|regmatch(G|evtfeldneu, "[a-zA-Z].*")))
.formula U|xtsel = "$,,;@numsuch=" + G|evtfeldneu + ";@filingmode=(Active)"
!EL003
!EL002
.formula U|xtid  = ""
.formula U|xtsel = "$,,.yktr=="    + M|kstelle^id + ";@filingmode=(Active)"     ?  G|evtvar =  "kstelle"
.select group "86:1" 'U|xtsel'
.continue EL004 ? _(G|mehr)
.formula U|xtid = H|id
.select continue
.continue EL005 ? _(G|mehr)
.formula U|xtsel = "%,,"
.formula U|xtsel = U|xtsel + ";ykunde=="      + M|kunde^id              ? F|defined(M|kunde)
.formula U|xtsel = U|xtsel + ";yverantwkst==" + M|yprjmverantwkst^id    ? F|defined(M|yprjmverantwkst)
.formula U|xtsel = U|xtsel + ";yadatum=="
.formula U|xtsel = U|xtsel + ";yedatum=="
.formula U|xtsel = U|xtsel + ";ystatus=="
.formula U|xtsel = U|xtsel + ";.yablage==0"
.formula U|xtsel = U|xtsel + ";@numsuch="     + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@autostart=(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group "86:1" 'U|xtsel'
.formula G|evtfeldneu = ""      ? _G|mehr
.formula U|xtid = M|.evtvar^id  ? _G|mehr & G|evtvar <> "kstelle"
.formula U|xtid = ""            ? _G|mehr & G|evtvar <> "kstelle" & F|empty(M|.evtvar)
.formula U|xtid = H|id          ?  G|mehr
!EL005
.continue EL006 ? _((G|evtfeldneu <> M|.evtvar^id) & (_(F|empty(U|xtid))))
.select group "86:1" 'U|xtid'
.continue EL007 ? _(G|mehr)
.continue EL008 ? _(H|yablage)
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xttext1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", H|such, G|dblquote, H|ystatus)
.formula U|xttext2 = "Eintrag nicht mîglich."
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.continue EL009 ? _(G|evtvar = "kstelle")
.assign M|kstelle = ""      ?  F|modifiable(M|kstelle)
.assign M|projekt = ""      ?  F|modifiable(M|projekt)
!EL009
.error
.end 1
.continue FI008
!EL008
.assign U|xpproject = H|id
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabprueffv)    ? G|evtmaske = 40
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabprueffv)    ? G|evtmaske = 40
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekbv)  ? G|evtmaske = 41
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekbv)  ? G|evtmaske = 41
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekuv)  ? G|evtmaske = 482
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekuv)  ? G|evtmaske = 482
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefeklv)  ? G|evtmaske = 801
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefeklv)  ? G|evtmaske = 801
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekan)  ? G|evtmaske = 43
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekan)  ? G|evtmaske = 43
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekbe)  ? G|evtmaske = 42
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekbe)  ? G|evtmaske = 42
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekls)  ? G|evtmaske = 45
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekls)  ? G|evtmaske = 45
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekre)  ? G|evtmaske = 46
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekre)  ? G|evtmaske = 46
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkan)  ? G|evtmaske = 31
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkan)  ? G|evtmaske = 31
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkau)  ? G|evtmaske = 32
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkau)  ? G|evtmaske = 32
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkls)  ? G|evtmaske = 35
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkls)  ? G|evtmaske = 35
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkre)  ? G|evtmaske = 36
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkre)  ? G|evtmaske = 36
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkch)  ? G|evtmaske = 819
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkch)  ? G|evtmaske = 819
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefsvan)  ? G|evtmaske = 855
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefsvan)  ? G|evtmaske = 855
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefsvau)  ? G|evtmaske = 856
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefsvau)  ? G|evtmaske = 856
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefsvkv)  ? G|evtmaske = 884
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefsvkv)  ? G|evtmaske = 884
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefsvra)  ? G|evtmaske = 878
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefsvra)  ? G|evtmaske = 878
.continue EL010 ? _(((H|ystatusk = "FTAB") & (U|xbprueffab)) ; (((H|ystatusk = "ABS") ; (H|ystatusk = "08") ; (H|yablage)) & (U|xbpruefkab)))
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xttext1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", H|such, G|dblquote, H|ystatus)
.formula U|xttext2 = "Eintrag nicht mîglich."
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.continue EL011 ? _(G|evtvar = "kstelle")
.assign M|kstelle = ""      ?  F|modifiable(M|kstelle)
.assign M|projekt = ""      ?  F|modifiable(M|projekt)
!EL011
.error
.end 1
.continue FI010
!EL010
.assign  M|projekt = H|id       ?  G|evtvar =  "kstelle" ; G|evtvar =  "yprjmppvorgang"
.formula G|evtfeldneu = U|xtid  ?  G|evtvar <> "kstelle" & G|evtvar <> "yprjmppvorgang"
.continue EL012 ? _((_(G|evtzeile = 0)) & (F|defined(M|yprjmproj)))
.continue EL013 ? _(_(F|empty(M|yprjmproj)))
.select screen header
.select screen line
.copy U|xbmehr = G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(U|xbmehr)
.continue EL014 ? _(M|projekt^id <> U|xtid)
.set trans +
.box -BUTTON yes:no -TITLE Hinweis
In den Positionen sind verschiedene Projekte eingetragen.
Soll der Projektverweis im Kopf entfernt werden?
.set trans -
.assign M|yprjmproj = ""        ? G|box = G|boxyes
.copy U|xbmehr = G|FALSE
.continue FI014
!EL014
.select screen line
.copy U|xbmehr = G|mehr
!FI014
.continue LOOP001
!ELOP001: ==============================
!EL013
!EL012
!FI010
!FI008
!EL007
!EL006
.continue FI004
!EL004
.continue EL015 ? _(G|evtvar <> "kstelle")
.continue EL016 ? _(G|evtfeldneu = "!")
.set trans +
.box Hinweis
Kein Projekt gefunden.
.set trans -
.formula G|evtfeldneu = ""
.continue FI016
!EL016
.set trans +
.box Hinweis
'G|evtfeldneu': nicht gefunden
.set trans -
.error
.end 1
!FI016
!EL015
!FI004
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "feldfuell")
.continue BRK002 ? _(G|evtvar = "yprjmproj")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK002
.continue BRK003 ? _(G|evtvar = "yprjnr")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "projekt")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "yprjmpvorgang")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK005
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK001
