..!interpreter english declaration noabbrev
.. at 2016-09-05, 10:54
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMSTDAUSWERTUNG.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 01.04.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtsys xtcmd xykoobjekt xtindex xtidkst xtindexkst xtindextsl xtpersonal xtperssuch xtdatei
.type text    xt1 xt2 xt3 xt4
.type integer xivar ximonat xijahr xizeile
.type integer xi1 xi2
.type real    xrarbzeit xrsumstunden xrsumtaetschl xr1
.type GD      xdat
.type bool    xyberlaubt xbleer xbmehr xbtaetschl
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Summenzeile -----
.input "allpstart/PRJM.FARBEN.DEF"  ? _F|defined(U|xtfarbes)
.formula U|xrsumstunden = 0
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xrsumstunden = U|xrsumstunden + M|ytstunden  ? _F|empty(M|ytpersonal)
.select screen line
.continue LOOP001
!ELOP001: ==============================
.select screen head
.make screen line
.formula M|ytstunden = U|xrsumstunden
.colour -BACKGROUND 'U|xtfarbes' 1
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.colour -BACKGROUND 'U|xtfarbes'  'M|aktzeile'  ?  F|empty(M|yttaetschl)
.colour -BACKGROUND 'U|xtfarbes2' 'M|aktzeile'  ? _F|empty(M|yttaetschl) & F|empty(M|ytpersonal)
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- TaetigkeitsschlÅssel_leeren -----
.formula U|xivar = 1
!LOOP003: ==============================
.continue ELOP003 ? _(F|defined(M|ytaetschl.xivar))
.formula M|ytaetschl.xivar     = ""
.formula M|ytaetschlname.xivar = ""  ? F|defined(M|ytaetschlname.xivar)
.formula U|xivar = U|xivar + 1
.continue LOOP003
!ELOP003: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.protection -RESET yvondatum 0
.protection -RESET ybisdatum 0
.assign M|yballetaetschl = G|TRUE
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "buttonvor")
.continue BRK003 ? _(G|evtvar = "bstart")
.continue EL001 ? _((F|empty(M|yvondatum)) & (F|empty(M|ybisdatum)))
.set TRANS +
.box Hinweis
Bitte zuerst einen Zeitraum wÑhlen.
.set TRANS -
.error
.end 1
.continue FI001
!EL001
.make screen line --
!FI001
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK002
.continue BRK004 ? _(G|evtart = "buttonnach")
.continue BRK005 ? _(G|evtvar = "bstart")
.input "allpstart/PRJM.FARBEN.DEF"
.file -TEMPNAME U|xtdatei
.input DATEI.F
.continue EL002 ? _(_(M|yballetaetschl))
.formula U|xivar = 1
!LOOP004: ==============================
.continue ELOP004 ? _(F|defined(M|ykst.xivar))
.continue EL003 ? _(_(F|empty(M|ytaetschl.xivar)))
.formula U|xtindex = 'U|xivar'
.type text xttaetschl.xtindex   ? _F|defined(U|xttaetschl.xtindex)
.formula U|xttaetschl.xtindex = M|ytaetschl.xivar^id
!EL003
.formula U|xivar = U|xivar + 1
.continue LOOP004
!ELOP004: ==============================
.continue FI002
!EL002
.formula U|xivar = 1
.select group 'U|xydbgrtaetschl' "$,,@ablageart=lebendig"
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xtindex = 'U|xivar'
.type text xttaetschl.xtindex   ? _F|defined(U|xttaetschl.xtindex)
.formula U|xttaetschl.xtindex = H|id
.formula U|xivar = U|xivar + 1
.select continue
.continue LOOP005
!ELOP005: ==============================
!FI002
.type text xttaetschlleer       ? M|yballetaetschl
.formula U|xtindex = ""
.input 'U|xtupkstarray'
.formula U|xtindextsl = ""
.formula U|xtindextsl = F|nextelem(U|xttaetschl, xtindextsl)
!LOOP006: ==============================
.continue ELOP006 ? _(_(F|empty(U|xtindextsl)))
.output NEW 'U|xtdatei'
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yadatum=" + M|yvondatum:8 + "!" + M|ybisdatum:8
.formula U|xtsel = U|xtsel + ";ypersonal=="  + M|ypersonal^id           ? _F|empty(M|ypersonal)
.formula U|xtsel = U|xtsel + ";ytaetschl=="  + U|xttaetschl.xtindextsl  ? _F|empty(U|xttaetschl.xtindextsl)
.formula U|xtsel = U|xtsel + ";ytaetschl==`"                            ?  F|empty(U|xttaetschl.xtindextsl)
.formula U|xtsel = U|xtsel + ";yaufgabe==`"                             ?  M|ybgkostlm
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@order=yadatum"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.formula U|xyberlaubt = G|TRUE
.formula U|xtindexkst = "leer"
.formula U|xtindexkst = "CC" + (H|ykstelle^id<<",")<<-1     ? _F|empty(H|ykstelle^nummer)
.continue EL004 ? _(F|defined(U|xtkst.xtindexkst))
.continue EL005 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = H|ykstelle^id
.input 'U|xypmrepruefkstprog'
!EL005
.continue EL006 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = H|ykstelle^id
.input 'U|xypmrepruefktrprog'
!EL006
.continue EL007 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL007
?'H|ypersonal^id' # 'H|ypersonal^such' # 'U|xtindexkst' # 'U|xtkst.xtindexkst' # 'F|year(H|yadatum)' # 'F|month(H|yadatum)' # 'H|yarbzeit' #    ? U|xyberlaubt
.continue FI004
!EL004
.formula U|xyberlaubt = G|FALSE
!FI004
.formula U|xyberlaubt = G|TRUE
.select continue
.continue LOOP007
!ELOP007: ==============================
.formula U|xtsys = "sort -t# +1d -2 +2 -3 +4n -5 +5n -6 -o " + U|xtdatei + " " + U|xtdatei
.system 'U|xtsys' BACKGROUND
.continue EL008 ? _(F|filenotempty(U|xtdatei))
.formula U|xizeile       = M|aktzeile
.formula U|ximonat       = 0
.formula U|xijahr        = 0
.formula U|xrarbzeit     = 0
.formula U|xtpersonal    = ""
.formula U|xtidkst       = ""
.formula U|xrarbzeit     = 0
.formula U|xrsumtaetschl = 0
.select from 'U|xtdatei' U|xt1 # U|xt2 # U|xt3 # U|xt4 # U|xi1 # U|xi2 # U|xr1 #
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.continue EL009 ? _(F|empty(U|xtpersonal))
.formula U|xtpersonal = U|xt1
.formula U|xijahr     = U|xi1
.formula U|ximonat    = U|xi2
.formula U|xtindexkst = U|xt3
.formula U|xtidkst    = U|xt4
!EL009
.continue EL010 ? _((U|xtpersonal <> U|xt1) ; (U|xijahr     <> U|xi1) ; (U|ximonat    <> U|xi2) ; (U|xtidkst    <> U|xt4))
.continue EL011 ? _(U|xrarbzeit <> 0)
.make screen line +O
.formula M|ytjahr         = 'U|xijahr'
.formula M|ytmonat        = U|ximonat
.formula M|yttaetschl     = U|xttaetschl.xtindextsl
.formula M|yttaetschlname = M|yttaetschl^namebspr
.formula M|ytpersonal     = U|xtpersonal
.formula M|ytpersname     = M|ytpersonal^namebspr
.formula M|ytkstelle      = U|xtidkst
.formula M|ytkstname      = M|ytkstelle^namebspr
.formula M|ytstunden      = U|xrarbzeit
!EL011
.formula U|xtpersonal = U|xt1
.formula U|xijahr     = U|xi1
.formula U|ximonat    = U|xi2
.formula U|xtindexkst = U|xt3
.formula U|xtidkst    = U|xt4
.formula U|xrarbzeit  = U|xr1
.copy    U|xbtaetschl    = G|TRUE
.continue FI010
!EL010
.formula U|xrarbzeit     = U|xrarbzeit     + U|xr1
!FI010
.formula U|xrsumtaetschl = U|xrsumtaetschl + U|xr1
.select from 'U|xtdatei' U|xt1 # U|xt2 # U|xt3 # U|xt4 # U|xi1 # U|xi2 # U|xr1 #
.continue LOOP008
!ELOP008: ==============================
.continue EL012 ? _(U|xrarbzeit <> 0)
.make screen line +O
.formula M|ytjahr         = 'U|xijahr'
.formula M|ytmonat        = U|ximonat
.formula M|yttaetschl     = U|xttaetschl.xtindextsl
.formula M|yttaetschlname = M|yttaetschl^namebspr
.formula M|ytpersonal     = U|xtpersonal
.formula M|ytpersname     = M|ytpersonal^namebspr
.formula M|ytkstelle      = U|xtidkst
.formula M|ytkstname      = M|ytkstelle^namebspr
.formula M|ytstunden      = U|xrarbzeit
.copy    U|xbtaetschl    = G|TRUE
!EL012
!EL008
.continue EL013 ? _(U|xbtaetschl)
.select screen line 'U|xizeile'
.make screen line +O
.formula M|yttaetschl     = U|xttaetschl.xtindextsl
.formula M|yttaetschlname = M|yttaetschl^namebspr
.formula M|ytstunden      = U|xrsumtaetschl
.select screen line 'M|tzeilen'
.copy    U|xbtaetschl    = G|FALSE
!EL013
.formula U|xtindextsl = F|nextelem(U|xttaetschl, xtindextsl)
.continue LOOP006
!ELOP006: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "ytbudetail")
.formula U|xtcmd = G|kkomname38 + " PRJMLM  "
.formula U|xtcmd = U|xtcmd +"?ypersonal="    +  M|ytpersonal^id
.formula U|xtcmd = U|xtcmd +"|ytaetschl="    +  M|yttaetschl^id
.formula U|xtcmd = U|xtcmd +"|yprojstatus="
.formula U|xtcmd = U|xtcmd +"|ykst1="        +  M|ytkstelle^id
.formula U|xtcmd = U|xtcmd +"|ybaufparam=(Yes)"
.formula U|xtcmd = U|xtcmd +"|ybprabgeschlossen=(Yes)"
.formula U|xtcmd = U|xtcmd +"|yvondatum="
.formula U|xtcmd = U|xtcmd +"|ybisdatum="
.formula U|xtcmd = U|xtcmd +"|bstart="
.formula U|xdat = 'M|ytjahr' + ("0" + 'M|ytmonat')>>2 + "01"
.formula U|xtcmd = U|xtcmd +"|ystdvondatum=" + U|xdat:8
.formula U|xdat  = U|xdat +31
.formula U|xdat  = 'U|xdat:8'<<6 + "01"
.formula U|xdat  = U|xdat - 1
.formula U|xtcmd = U|xtcmd +"|ystdbisdatum=" + U|xdat:8
.formula U|xtcmd = U|xtcmd +"|ybaufparam=(Yes)"
.formula U|xtcmd = U|xtcmd +"|bstart="
.command -PARALLEL 'U|xtcmd'
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK004
.continue BRK007 ? _(G|evtart = "feldaus")
.input 'U|xtupprjmsel'
.continue BRK008 ? _(G|evtvar = "yballetaetschl")
.continue EL014 ? _(M|yballetaetschl)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
!EL014
.continue ESAC004
!BRK008
.continue EL015 ? _(G|evtvar<<9 = "ytaetschl")
.formula U|xivar = G|evtvar<<-9
.formula M|ytaetschlname.xivar = M|.evtvar^namebspr
.formula U|xivar = U|xivar + 1                                  ? _F|empty(M|.evtvar)
.formula U|xtcmd = "cursor ytaetschl" + 'U|xivar' + " 0"        ?  F|defined(M|ytaetschl.xivar)
.formula U|xtcmd = "cursor ypersonal 0"                         ? _F|defined(M|ytaetschl.xivar)
.'U|xtcmd'
.formula U|xbleer = G|TRUE
.formula U|xivar  = 1
!LOOP009: ==============================
.continue ELOP009 ? _((F|defined(M|ytaetschl.xivar)) & (U|xbleer))
.formula U|xbleer = G|FALSE     ? _F|empty(M|ytaetschl.xivar)
.formula U|xivar = U|xivar + 1
.continue LOOP009
!ELOP009: ==============================
.formula M|yballetaetschl = U|xbleer
!EL015
!ESAC004: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMSTDAUSWERTUNG.EV")'  ? F|fileexists(F|foppath("IFOP.IS.PRJMSTDAUSWERTUNG.EV"))
.continue
