..!interpreter english declaration noabbrev
.set trans -
..========================================================================
..==  Name              : FOP.KLASSIFIZIERUNG.EV
..==  Pfad              : allpstart
..==  Funktion          : EFOP an Auswertedimension
..==  Erstellungsdatum  : 15.12.2011
..==  Autor             : Andreas Otto, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text  xtsys xtsel
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtmaske = F|sysinfo(10)^ykonfigprjm^yvtobjklassifik^vmnr1)
.continue BRK002 ? _(G|evtart = "maskein")
.continue EL001 ? _(_(G|evtkommd = G|kaktname10))
.protection yklbkkontexts 0
!EL001
.continue ESAC002
!BRK002
.continue BRK003 ? _(G|evtart = "buttonvor")
.continue EL002 ? _((G|evtkommd = G|kaktname14) ; (G|evtkommd = G|kaktname13))
.continue FI002
!EL002
.error
.end 1
!FI002
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtart = "buttonnach")
.formula U|xtsel = "%,,nummer=;such=;name=;yklbezugsklasse=" + 'M|yklbezugsklasse' + ";@gruppe=" + 'U|xygrbkskontext' + ";@autostart=(1)"
.load 0 group 'U|xydbgrbkskontext' 'U|xtsel'
.continue EL003 ? _(G|mehr)
.formula M|yklbkkontext = 0|id
!EL003
.load 0
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "yklbezugsklasse")
.continue EL004 ? _(_(F|empty(M|yklbkkontexts)))
.set TRANS +
.box Hinweis
énderung der Zuordung - Bezugsklassenspezifischer Kontext wird gelîscht!
.set TRANS -
.formula M|yklbkkontexts = ""
!EL004
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue ESAC002
!BRK005
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK001
.continue BRK007 ? _(G|evtmaske = 1)
.continue BRK008 ? _(G|evtart = "buttonvor")
.continue EL005 ? _((F|sysinfo(10)^ykonfigprjm^yvtbkskontext     = "") ; (F|sysinfo(10)^ykonfigprjm^yvtobjklassifik   = "") ; (F|sysinfo(10)^ykonfigprjm^yvtobjklzuordnung = ""))
.box HINWEIS

Funktion nicht korrekt konfiguriert -
informieren Sie den Systemverwalter!
!EL005
.continue ESAC004
!BRK008
.continue BRK009 ? _(G|evtart = "buttonnach")
.continue BRK010 ? _(G|evtvar = "ybusub")
.formula xtsys = "(Infosystem) PRJMOBJKLASS ? ybezugsobjekt="+'m|dnr'+"  "+'m|nummer'+" | ybkkontext=SUBGEWERK | ynaklassfeld=ysubgewerk | bstart="
.command -PARALLEL 'xtsys'
.continue ESAC005
!BRK010
.continue BRK011 ? _(G|evtvar = "ybulief")
.formula xtsys = "(Infosystem) PRJMOBJKLASS ? ybezugsobjekt="+'m|dnr'+"  "+'m|nummer'+" | ybkkontext=LIEFMAT | ynaklassfeld=yliefmat | bstart="
.command -PARALLEL 'xtsys'
.continue ESAC005
!BRK011
.continue BRK012 ? _(G|evtvar = "ybuinvest")
.formula xtsys = "(Infosystem) PRJMOBJKLASS ? ybezugsobjekt="+'m|dnr'+"  "+'m|nummer'+" | ybkkontext=INVESTGWG | ynaklassfeld=yinvest | bstart="
.command -PARALLEL 'xtsys'
.continue ESAC005
!BRK012
.continue BRK013 ? _(G|evtvar = "ybuallg")
.formula xtsys = "(Infosystem) PRJMOBJKLASS ? ybezugsobjekt="+'m|dnr'+"  "+'m|nummer'+" | ybkkontext=SONSTIGE | ynaklassfeld=yallg | bstart="
.command -PARALLEL 'xtsys'
.continue ESAC005
!BRK013
!ESAC005: =====   ENDCASE   =====
.continue ESAC004
!BRK009
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.continue
