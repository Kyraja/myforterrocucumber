..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.PRJM.UP.PV.FREIGABE.AA
..==
..==  Pfad              : allpstart
..==
..==  Funktion          : Unterprogramm zur Prfung ob der Projektvorgang zur Arbeitsaufgabe freigegeben werden kann
..==                      Verwendeter Puffer: 9 - fr PV
..==                                          8 - Aufz„hlung 28048
..==                                          5 - PS Konfig
..==
..==
..==  Erstellungsdatum  : 17.06.2013
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Copyright         : (c) 1990 - 2013 alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
..====================================================
.type text    xtpvorgang        ? _F|defined(U|xtpvorgang)
.type text    xyindex           ? _F|defined(U|xyindex)
.type text    xypvfrei          ? _F|defined(U|xypvfrei)
.type bool    xybrelok          ? _F|defined(U|xybrelok)
.type integer xprocsp           ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.copy U|xybrelok = G|TRUE
.continue EL001 ? _((_(F|empty(U|xtpvorgang))) & (_(U|xtpvorgang = "(0,0,0)")))
.load 9 group "P149:2" 'U|xtpvorgang'
.continue EL002 ? _(G|mehr)
.continue EL003 ? _((9|tzeilen > 0) & (_(F|empty(9|ypvfreistat))))
.load 8 group "P107:1" "28048"
.continue EL004 ? _(G|mehr)
.load 8 line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xyindex = 8|aekbez
.type integer xyidline.xyindex      ? _F|defined(U|xyidline.xyindex)
.formula U|xyidline.xyindex = 8|aktzeile
.load 8 line
.continue LOOP001
!ELOP001: ==============================
.formula U|xypvfrei = 9|ypvfreistatk
.load 9 line
!LOOP002: ==============================
.continue ELOP002 ? _((G|mehr) & (U|xybrelok))
.continue EL005 ? _(_(F|empty(9|yvorgaenger)))
.formula U|xyindex = 9|yvorgaenger^ystatusk
.continue EL006 ? _(U|xyidline.xyindex < U|xyidline.xypvfrei)
.set TRANS +
.box Fehler
Die Freigabe des Projektvorgangs '9|nummer' ist erst erlaubt,
wenn alle Vorg„nger den Status "'9|ypvfreistat'" haben.

Der Projektvorgang '9|yvorg„nger' hat den Status "'9|yvorgaenger^ystatus'".
.set TRANS -
.copy U|xybrelok = G|FALSE
!EL006
!EL005
.load 9 line
.continue LOOP002
!ELOP002: ==============================
!EL004
!EL003
.continue EL007 ? _(_(F|empty(9|ypvfreiifop)))
.input 'F|foppath(9|ypvfreiifop)'   ? F|fileexists(F|foppath(9|ypvfreiifop))
!EL007
!EL002
!EL001
