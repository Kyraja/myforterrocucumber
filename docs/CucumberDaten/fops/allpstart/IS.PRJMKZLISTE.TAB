..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : IS.PRJMKZLISTE.TAB
..==
..==  Pfad              : allpstart
..==
..==  Funktion          : Tabellen-EFOP an IS PRJMKZLISTE
..==
..==
..==  Erstellungsdatum  : 28.01.2013
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Copyright         : (c) 1990 - 2013 alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==  Aenderungshistorie:
..==
..========================================================================
..====================================================
.type text    xtsys xtsel
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.make screen line +O
.formula M|ytprojekt    = H|id
.formula M|ytprojname   = H|namebspr
.copy    M|ytverantwkst = H|yverantwkst
.copy    M|ytprojleit   = H|yprojleit
.formula M|ytplname     = H|yprojleit^namebspr
.formula U|xifarbe = 0
.formula U|xivar   = 1
!LOOP001: ==============================
.continue ELOP001 ? _(F|defined(M|yprojkennzahl.xivar))
.continue EL001 ? _(_(F|empty(M|yprojkennzahl.xivar)))
.formula U|xifarbe = 0  ? U|xifarbe > 1
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ykennzahl==" + M|yprojkennzahl.xivar^id
.formula U|xtsel = U|xtsel + ";yprojekt=="  + H|id
.formula U|xtsel = U|xtsel + ";ydatum="     +'M|ybezugsdatum:8'<<6 + "01!" + 'M|ybezugsdatum:8'
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@ordnung=ydatum.rueckwaerts"
.load 0 group 'M|grliste' 'U|xtsel'
.continue EL002 ? _(G|mehr)
.formula M|ytprojkzist.xivar  = 0|ywert
.formula M|ytprojkzvoka.xivar = 0|yvokawert
.formula M|ytprojkzfc.xivar   = 0|yfcwert
.formula M|ytprojkz1zus.xivar = 0|ywertzus1
.formula M|ytprojkz2zus.xivar = 0|ywertzus2
!EL002
.formula U|xtfarbe = U|xabasbgtable1    ? U|xifarbe = 0
.formula U|xtfarbe = U|xabasbgtable4    ? U|xifarbe > 0
.continue EL003 ? _(F|defined(M|yprojkennzahl.xivar^yfarber))
.continue EL004 ? _((_(M|yprojkennzahl.xivar^yfarber = 0)) ; (_(M|yprojkennzahl.xivar^yfarbeg = 0)) ; (_(M|yprojkennzahl.xivar^yfarbeb = 0)))
.formula U|xtfarbe = ""
.formula U|xtfarbe = U|xtfarbe + F|tostring(M|yprojkennzahl.xivar^yfarber)  ? M|yprojkennzahl.xivar^yfarber <= 255
.formula U|xtfarbe = U|xtfarbe + "255"                                      ? M|yprojkennzahl.xivar^yfarber >  255
.formula U|xtfarbe = U|xtfarbe + " "
.formula U|xtfarbe = U|xtfarbe + F|tostring(M|yprojkennzahl.xivar^yfarbeg)  ? M|yprojkennzahl.xivar^yfarbeg <= 255
.formula U|xtfarbe = U|xtfarbe + "255"                                      ? M|yprojkennzahl.xivar^yfarbeg >  255
.formula U|xtfarbe = U|xtfarbe + " "
.formula U|xtfarbe = U|xtfarbe + F|tostring(M|yprojkennzahl.xivar^yfarbeb)  ? M|yprojkennzahl.xivar^yfarbeb <= 255
.formula U|xtfarbe = U|xtfarbe + "255"                                      ? M|yprojkennzahl.xivar^yfarbeb >  255
!EL004
!EL003
.'F|expr("colour -BACKGROUND " + U|xtfarbe + " ytprojkzist"  + F|tostring(U|xivar) + " " + F|tostring(M|aktzeile))'
.'F|expr("colour -BACKGROUND " + U|xtfarbe + " ytprojkzvoka" + F|tostring(U|xivar) + " " + F|tostring(M|aktzeile))'
.'F|expr("colour -BACKGROUND " + U|xtfarbe + " ytprojkzfc"   + F|tostring(U|xivar) + " " + F|tostring(M|aktzeile))'
.'F|expr("colour -BACKGROUND " + U|xtfarbe + " ytprojkz1zus" + F|tostring(U|xivar) + " " + F|tostring(M|aktzeile))'
.'F|expr("colour -BACKGROUND " + U|xtfarbe + " ytprojkz2zus" + F|tostring(U|xivar) + " " + F|tostring(M|aktzeile))'
.formula U|xifarbe = U|xifarbe + 1
!EL001
.formula U|xivar = U|xivar + 1
.continue LOOP001
!ELOP001: ==============================
