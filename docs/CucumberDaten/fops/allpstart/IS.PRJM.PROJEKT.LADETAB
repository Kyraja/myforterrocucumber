.formula xprocsp = xprocsp - 1
!EL052
!EL051
.select screen line 'M|tzeilen'
!EL046
.continue 'xprocst.xprocsp'
!PROC006: ----- Farben -----
.select screen header
.select screen line
!LOOP009: ==============================
.continue ELOP009 ? _(G|mehr)
.colour -BACKGROUND 'U|xtfarbe0' ystatus 'M|aktzeile'
.colour -BACKGROUND 'M|yfarbe'           'M|aktzeile'
.continue EL053 ? _(F|defined(M|ybuaufzu))
.formula M|ybuaufzu  = ""
.formula M|ybuaufzu  = "icon:plus_black"       ? M|tbaumstat = "+"
.formula M|ybuaufzu  = "icon:minus_black"      ? M|tbaumstat = "-"
!EL053
.continue EL054 ? _(F|defined(M|ystufe))
.formula M|ystufe = "----------" << (M|tbaumstufe) + 'M|tbaumstufe'
!EL054
.select screen line
.continue LOOP009
!ELOP009: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.file -TEMPNAME U|xttemp
.copy U|xstunden = U|xypmstunden
.continue BRK001 ? _(G|evtvar = "ybuaufzu")
.continue EL055 ? _(M|ybsort)
.set TRANS +
.box Hinweis
Die Tabelle wurde sortiert.
Auf- und zuklappen ist nicht mehr m”glich.

Bitte das Projekt neu laden.
.set TRANS -
.continue FI055
!EL055
.continue BRK002 ? _(M|tbaumstat = "+")
.formula M|tbaumstat = "-"
.formula U|xistufe = M|tbaumstufe
.load 8 add M|yobjekt
.continue EL056 ? _(((M|yobjekt^dnr    = U|xydbprojekt) & (M|yobjekt^gruppe = U|xygrprojekt)) ; ((M|yobjekt^dnr    = U|xydbprojstat) & (M|yobjekt^gruppe = U|xygrprojstat)))
.copy M|ytb1      = G|FALSE
.copy U|xbprojekt = G|TRUE
.select add M|yobjekt
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC005
!RET008
.formula xprocsp = xprocsp - 1
.select screen line 'G|evtzeile'
.copy M|ytb1      = G|TRUE
!EL056
.continue EL057 ? _(((M|yobjekt^dnr    = U|xydbpvorgang) & (M|yobjekt^gruppe = U|xygrpvorgang)) ; ((M|yobjekt^dnr    = U|xydbpvstat) & (M|yobjekt^gruppe = U|xygrpvstat)))
.formula U|xizeile    =  M|aktzeile
.formula M|ytb1       =  G|FALSE
.formula U|xbpvorgang =  G|TRUE
.formula U|xbblatt    =  M|yobjekt^yistblatt
.select add M|yobjekt^yprojekt
.continue EL058 ? _(U|xbselhist)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="     +  M|yobjekt^yprojekt^id
.formula U|xtsel = U|xtsel + ";ybezugsdatum==" + 'M|ystichtag:8'
.formula U|xtsel = U|xtsel + ";ybprojektversion=(No)"
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 0 group 'U|xydbgrpvstat' 'U|xtsel'    ?  U|xbselhist
!EL058
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC003
!RET009
.formula xprocsp = xprocsp - 1
.select screen line 'G|evtzeile'
.formula M|ytb1       = G|TRUE
!EL057
.continue EL059 ? _(((M|yobjekt^dnr    = U|xydbaufgabe) & (M|yobjekt^gruppe = U|xygraufgabe)) ; ((M|yobjekt^dnr    = 4) & (M|yobjekt^gruppe = 5)))
.formula M|ytb1      = G|FALSE
.formula U|xbaufgabe = G|TRUE
.select add M|yobjekt^yprojekt
.load 1 object 'M|yobjekt^id'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET010" 
.continue PROC002
!RET010
.formula xprocsp = xprocsp - 1
.select screen line 'G|evtzeile'
.formula M|ytb1       = G|TRUE
!EL059
.continue ESAC002
!BRK002
.continue BRK003 ? _(M|tbaumstat = "-")
.formula M|tbaumstat = "+"
.formula U|xizeile = G|evtzeile
.select screen line 'U|xizeile'
.continue EL060 ? _(G|mehr)
.formula U|xistufe = M|tbaumstufe
.select screen line
.continue EL061 ? _(G|mehr)
!LOOP010: ==============================
.continue ELOP010 ? _(M|tbaumstufe > U|xistufe)
.make screen line -O
.continue LOOP010
!ELOP010: ==============================
!EL061
.select screen line 'U|xizeile
.continue FI060
!EL060
.error(1111)
.end 1
!FI060
.copy U|xbnocl = G|TRUE
.continue ESAC002
!BRK003
.continue
!ESAC002: =====   ENDCASE   =====
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET011" 
