.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.formula U|xiaktzeile = M|aktzeile
.select screen line 'U|xiaazeile'
.formula M|tbaumstat = "+"      ? U|xbmehr &  _M|tbaumstat = "-" & _U|xistufe = 0
.continue EL034 ? _(((U|xbmehr) & (F|defined(M|ybuebersicht))) ; (F|defined(M|ybstrpruef)))
.formula M|yberist       = M|yberist       + U|xriststd
.formula M|yberfakt      = M|yberfakt      + U|xrfaktstd
.formula M|ystdabger     = M|ystdabger     + U|xrabgerstd       ? F|defined(M|ystdabger)
