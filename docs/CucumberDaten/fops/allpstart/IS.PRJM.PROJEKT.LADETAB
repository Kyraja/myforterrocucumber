.type text    xttemp            ? _F|defined(U|xttemp)
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type real    xrposoll xrpoplan xrtasksoll xrtaskplan
.type real    xrposoffen xrpopoffen
.type real    xrpoist   xriststd xrpozus xrzusstd xrabgerstd  xrpoabger xrabgerber
.type real    xrpofakt  xrfaktstd
.type real    xrprsollges xrprsollber xrprplanges xrprplanber
.type real    xrpvsollges xrpvsollber xrpvplanges xrpvplanber
.type real    xraasollges xraasollber xraaplanges xraaplanber
.type real    xristges xristber xrfaktges xrfaktber xrzusges
.type text    xtystatus
.type integer xiphzeile xipbzeile xiaazeile
.type integer xizeile           ? _F|defined(U|xizeile)
.type integer ximerkzeile       ? _F|defined(U|ximerkzeile)
.type integer xiaktzeile        ? _F|defined(U|xiaktzeile)
.type integer xistufe           ? _F|defined(U|xistufe)
.type integer xi1               ? _F|defined(U|xi1)
.type bool    xbprojekt         ? _F|defined(U|xbprojekt)
.type bool    xbpvorgang        ? _F|defined(U|xbpvorgang)
.type bool    xbaufgabe         ? _F|defined(U|xbaufgabe)
.type bool    xbblatt           ? _F|defined(U|xbblatt)
.type bool    xbabschluss       ? _F|defined(U|xbabschluss)
.type bool    xbmehr            ? _F|defined(U|xbmehr)
.type bool    xbok              ? _F|defined(U|xbok)
.type bool    xbdnoetail        ? _F|defined(U|xbdnoetail)
.type bool    xbselhist         ? _F|defined(U|xbselhist)
.type bool    xbnocl            ? _F|defined(U|xbnocl)
.type TAZ7    xeinh xstunden
.type integer   xprocsp ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Submeldungen -----
.formula U|xriststd   = 0
.formula U|xrfaktstd  = 0
.formula U|xrabgerstd = 0
.formula U|xrzusstd   = 0
.formula U|xiaazeile  = M|aktzeile
.copy U|xbmehr = G|FALSE
.load 2 group 'U|xydbgrsubmeldung' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.load 2 line '2|selzeile'
.copy U|xbok = G|mehr
.continue EL001 ? _((U|xbok) & (F|defined(M|ystdvondatum)))
.copy U|xbok = G|FALSE  ? 2|ytdatum < M|ystdvondatum & _F|empty(M|ystdvondatum)
.copy U|xbok = G|FALSE  ? 2|ytdatum > M|ystdbisdatum & _F|empty(M|ystdbisdatum)
!EL001
.continue EL002 ? _((U|xbselhist) & (F|defined(M|ystichtag)))
.copy U|xbok = G|FALSE  ? 2|ytdatum > M|ystichtag    & _F|empty(M|ystichtag)
!EL002
.continue EL003 ? _((U|xbok) & (((M|ybmitar) & (_(G|evtvar = "ybuaufzu")) & (_(G|evtvar = "ybualleazu"))) ; (G|evtvar = "ybualleauf") ; ((U|xbpvorgang & _F|empty(2|ytpvorgang)) ; (U|xbprojekt  &  F|empty(2|ytpvorgang)))))
.make screen line +O
.formula M|yfarbe   = U|xyfarbelnachweis
.formula M|yebene   = 2|grbez
.formula M|yobjekt  = 2|id
.formula M|ynummer  = M|yobjekt^nummer ? F|defined(M|ynummer)
.formula M|ysuch    = M|yobjekt^such   ? F|defined(M|ysuch)
.formula M|ystatus  = U|xttxtre        ? F|empty(M|ystatus) & _F|empty(2|ytsmrenum)
.formula M|ystatus  = U|xttxtls        ? F|empty(M|ystatus) & _F|empty(2|ytsmlsnum)
.formula M|ystatus  = U|xttxtabrechn   ? F|empty(M|ystatus) & _F|empty(2|ytsmabrechnung)
.formula M|yname    = 2|namebspr
.formula M|yadatum  = 2|ytdatum
.formula M|yedatum  = 2|ytdatum
.continue EL004 ? _((F|defined(M|yistar)) ; (F|defined(M|yfaktar)) ; (F|defined(M|ystdabger)))
.assign U|xeinh = '2|yeinh(L="0")'
.continue EL005 ? _(G|mehr)
.continue EL006 ? _(_(F|empty(U|xeinh)))
.formula M|yistar    = 2|ymge * F|unitconvfactor(U|xstunden,U|xeinh)     ? F|defined(M|yistar)
.formula M|yfaktar   = 2|ymge * F|unitconvfactor(U|xstunden,U|xeinh)     ? F|defined(M|yfaktar)
.formula M|ystdabger = 2|ymge * F|unitconvfactor(U|xstunden,U|xeinh)     ? F|defined(M|ystdabger) & (_F|empty(2|ytsmlsnum) ; _F|empty(2|ytsmrenum))
!EL006
!EL005
!EL004
.assign M|yabrechnung = 2|ytsmabrechnung        ? F|defined(M|yabrechnung)
.assign M|yls         = 2|ytsmlsposid           ? F|defined(M|yls)
.assign M|ylsnum      = 2|ytsmlsnum             ? F|defined(M|ylsnum)
.assign M|yre         = 2|ytsmreposid           ? F|defined(M|yre)
.assign M|yrenum      = 2|ytsmrenum             ? F|defined(M|yrenum)
.assign M|yvkartikel  = 2|yteil^id              ? F|defined(M|yvkartikel)
.assign M|yprojsuch   = 2|yprojekt^such         ? F|defined(M|yprojsuch) & F|defined(2|yprojekt)
.formula M|yiststart    = 2|ytdatum                     ? F|defined(M|yiststart)
.formula M|yistend      = 2|ytdatum                     ? F|defined(M|yistend)
.formula M|ytprojleit   = 2|yprojekt^yprojleit^id       ? F|defined(M|ytprojleit)
.continue EL007 ? _(_(F|empty(2|ytbeschreib)))
.output NEW 'U|xttemp'
'2|ytbeschreib                                                                                                                     '
.output NEW WERF.WEG
.formula M|yftext = U|xttemp
!EL007
.formula M|ytb1 = G|TRUE
.formula M|tbaumstufe = U|xistufe + 1
!EL003
.continue EL008 ? _(U|xbok)
.assign U|xeinh = '2|yeinh(L="0")'
.continue EL009 ? _(G|mehr)
.continue EL010 ? _(_(F|empty(U|xeinh)))
.formula U|xriststd   = U|xriststd   + (2|ymge * F|unitconvfactor(U|xstunden,U|xeinh))
.formula U|xrfaktstd  = U|xrfaktstd  + (2|ymge * F|unitconvfactor(U|xstunden,U|xeinh))
.formula U|xrabgerstd = U|xrabgerstd + (2|ymge * F|unitconvfactor(U|xstunden,U|xeinh))  ? _F|empty(2|ytsmlsnum) ; _F|empty(2|ytsmrenum)
!EL010
!EL009
.copy    U|xbmehr     = G|TRUE
!EL008
.load 2 continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Lade_LM_und_RM_zu_Referenz -----
.formula U|xbmehr = G|FALSE
.continue EL011 ? _((1|dnr    = U|xydbaufgabe) & (1|gruppe = U|xygraufgabe))
.formula U|xriststd   = 0
.formula U|xrfaktstd  = 0
.formula U|xrabgerstd = 0
.formula U|xrzusstd   = 0
.formula U|xrtasksoll = U|xrtasksoll + 1|ysollstd
.formula U|xrtaskplan = U|xrtaskplan + 1|yplanstd
.formula U|xiaazeile  = M|aktzeile
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yaufgabe=" + 1|id
.continue EL012 ? _(F|defined(M|ystdvondatum))
.formula U|xtsel = U|xtsel + ";yadatum>=" +'M|ystdvondatum:8'   ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";yadatum<=" +'M|ystdbisdatum:8'   ? _F|empty(M|ystdbisdatum)
!EL012
.continue EL013 ? _((U|xbselhist) & (F|defined(M|ystichtag)))
.formula U|xtsel = U|xtsel + ";yadatum<=" +'M|ystichtag:8'      ? _F|empty(M|ystichtag)
!EL013
.formula U|xtsel = U|xtsel + ";@ablageart=(1)"
.load 2 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL014 ? _(((M|ybmitar) & (_(G|evtvar = "ybuaufzu")) & (_(G|evtvar = "ybualleazu"))) ; (G|evtvar = "ybualleauf") ; (U|xbaufgabe))
.make screen line +O
.formula M|yfarbe      = U|xyfarbelnachweis
.formula M|yebene      = 2|grbez
.formula M|yobjekt     = 2|id
.formula M|ynummer     = M|yobjekt^nummer   ? F|defined(M|ynummer)
.formula M|ysuch       = M|yobjekt^such     ? F|defined(M|ysuch)
.formula M|ystatus     = U|xttxtre          ? F|empty(M|ystatus) & _F|empty(2|yrenum)
.formula M|ystatus     = U|xttxtls          ? F|empty(M|ystatus) & _F|empty(2|ylsnum)
.formula M|ystatus     = U|xttxtabrechn     ? F|empty(M|ystatus) & _F|empty(2|yabrechnung)
.formula M|ystatus     = U|xttxterledigt    ? F|empty(M|ystatus) & 2|yarchiv
.formula M|yname       = 2|namebspr
.copy    M|ytkunde     = 2|ykunde
.formula M|ytkuname    = 2|ykunde^namebspr
.formula M|yadatum     = 2|yadatum
.formula M|yedatum     = 2|yedatum
.formula M|yistar      = 2|yarbzeit         ? F|defined(M|yistar)
.formula M|yfaktar     = 2|yfaktzeit        ? F|defined(M|yfaktar)
.formula M|yberist     = 2|yarbzeit         ? F|defined(M|yberist)
.formula M|yberfakt    = 2|yfaktzeit        ? F|defined(M|yberfakt)
.formula M|ystdabger   = 2|yfaktzeit        ? F|defined(M|ystdabger) & (_F|empty(2|ylsnum) ; _F|empty(2|yrenum))
.formula M|yzusatzalle = 2|yarbzeit         ? F|defined(M|yzusatzalle) & 2|ynachtrag
.copy    M|ybz         = 2|ypersonal
.assign M|yabrechnung  = 2|yabrechnung      ? F|defined(M|yabrechnung)
.assign M|yls          = 2|ylsposid         ? F|defined(M|yls)
.assign M|ylsnum       = 2|ylsnum           ? F|defined(M|ylsnum)
.assign M|yre          = 2|yreposid         ? F|defined(M|yre)
.assign M|yrenum       = 2|yrenum           ? F|defined(M|yrenum)
.copy    M|ykstelle    = 2|ykstelle         ? F|defined(M|ykstelle)
.copy    M|ytaetschl   = 2|ytaetschl        ? F|defined(M|ytaetschl)
.copy    M|yarchiv     = 2|yarchiv          ? F|defined(M|yarchiv)
.copy    M|yvkartikel  = 2|yvkartikel       ? F|defined(M|yvkartikel)
.copy    M|ymaschvkart = 2|ymaschvkart      ? F|defined(M|ymaschvkart)
.formula M|ymaschzeit  = 2|ymaschzeit       ? F|defined(M|ymaschzeit)
.copy    M|ynachtrag   = 2|ynachtrag        ? F|defined(M|ynachtrag)
.formula M|yprojsuch   = 2|yprojekt^such    ? F|defined(M|yprojsuch) & F|defined(2|yprojekt)
.formula M|yiststart   = 2|yadatum              ? F|defined(M|yiststart)
.formula M|yistend     = 2|yedatum              ? F|defined(M|yistend)
.copy    M|ytprojleit  = 2|yprojekt^yprojleit   ? F|defined(M|ytprojleit)
.copy    M|yverantw    = 2|yverantw             ? F|defined(M|yverantw)
.continue EL015 ? _(_(F|empty(2|ybeschint)))
.select from '2|ybeschint'
.formula M|ybeschint = 2|ybeschint
!EL015
.continue EL016 ? _(_(F|empty(2|ybeschext)))
.select from '2|ybeschext'
.formula M|ybeschext = 2|ybeschext
.formula M|yftext    = 2|ybeschext
!EL016
.formula M|ytb1 = G|TRUE
.formula M|tbaumstufe = U|xistufe + 1
!EL014
.copy    U|xbmehr     = G|TRUE
.formula U|xriststd   = U|xriststd   + 2|yarbzeit
.formula U|xrfaktstd  = U|xrfaktstd  + 2|yfaktzeit
.formula U|xrabgerstd = U|xrabgerstd + 2|yfaktzeit      ? _F|empty(2|ylsnum) ; _F|empty(2|yrenum)
.formula U|xrzusstd   = U|xrzusstd   + 2|yarbzeit       ? 2|ynachtrag
.load 2 continue
.continue LOOP002
!ELOP002: ==============================
.formula U|xiaktzeile = M|aktzeile
.select screen line 'U|xiaazeile'
.formula M|tbaumstat = "+"      ? U|xbmehr &  _M|tbaumstat = "-"
.continue EL017 ? _(((U|xbmehr) & (F|defined(M|ybuebersicht))) ; (F|defined(M|ybstrpruef)))
.formula M|yberist       = U|xriststd
.formula M|yberfakt      = U|xrfaktstd
.formula M|ystdabger     = U|xrabgerstd     ? F|defined(M|ystdabger)
.formula M|yzusatzalle   = U|xrzusstd       ? F|defined(M|yzusatzalle)
.formula M|ybersolloffen = M|ysolltask - M|yberfakt
.formula M|yberplanoffen = M|yplantask - M|yberist
!EL017
.continue EL018 ? _(((M|ybmitar) & (_(G|evtvar = "ybualleazu"))) ; (U|xbaufgabe) ; (G|evtvar = "ybualleauf"))
.formula U|xistufe    = U|xistufe - 1
!EL018
.select screen line 'U|xiaktzeile'
.formula U|xrpoist   = U|xrpoist   + U|xriststd
.formula U|xrpofakt  = U|xrpofakt  + U|xrfaktstd
.formula U|xrpozus   = U|xrpozus   + U|xrzusstd
.formula U|xrpoabger = U|xrpoabger + U|xrabgerstd
!EL011
.continue EL019 ? _((1|dnr    = 4) & (1|gruppe = 5))
.continue EL020 ? _(_(F|empty(1|ba)))
.formula U|xtsel = "$,,nummer=" + 1|ba^nummer + "000!" + 1|ba^nummer + "999;@gruppe=2;@ablageart=(1)"
.load 2 workorder 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL021 ? _(((M|ybmitar) & (_(G|evtvar = "ybuaufzu")) & (_(G|evtvar = "ybualleazu"))) ; (G|evtvar = "ybualleauf") ; (U|xbaufgabe))
.make screen line +O
.formula M|yfarbe     = U|xyfarbelnachweis
.formula M|yebene     = 2|grbez
.formula M|yobjekt    = 2|id
.formula M|ynummer    = M|yobjekt^nummer        ? F|defined(M|ynummer)
.formula M|ysuch      = M|yobjekt^such          ? F|defined(M|ysuch)
.formula M|yname      = 2|bem
.formula M|yadatum    = 2|vom
.formula M|yistar     = 2|bzeit                 ? F|defined(M|yistar)
.formula M|ytb1 = TRUE
.formula U|xistufe    = U|xistufe + 1
.formula M|tbaumstufe = U|xistufe
.formula U|xistufe    = U|xistufe - 1
!EL021
.assign U|xbmehr = G|TRUE       ? G|mehr
.load 2 workorder
.continue LOOP003
!ELOP003: ==============================
.formula U|xtsel = "$,,nummer==" + 1|ba^nummer + ";@gruppe=2;@ablageart=(1)"
.load 2 workorder 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL022 ? _(((M|ybmitar) & (_(G|evtvar = "ybuaufzu")) & (_(G|evtvar = "ybualleazu"))) ; (G|evtvar = "ybualleauf") ; (U|xbaufgabe))
