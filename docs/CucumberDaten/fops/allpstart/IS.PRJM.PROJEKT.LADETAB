.formula U|xrfaktber   = U|xrfaktber   + U|xrpofakt
.formula U|xrabgerber  = U|xrabgerber  + U|xrpoabger
.continue EL037 ? _((M|yknoten <> 0) & (M|yistblatt))
.formula U|xrposoll   = M|ysollpo
.formula U|xrpoplan   = M|yplanpo
