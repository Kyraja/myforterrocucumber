.load 2 workorder
.continue LOOP004
!ELOP004: ==============================
.formula M|tbaumstat = "+"      ? U|xbmehr &  _M|tbaumstat = "-"
!EL020
!EL019
.continue 'xprocst.xprocsp'
!PROC003: ----- Lade_untergeordnete_Projektvorgaenge -----
.continue EL023 ? _(U|xizeile <= M|tzeilen)
.select screen line 'U|xizeile'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xipbzeile = M|aktzeile
.continue EL024 ? _(M|ytb1)
.select screen line
.formula U|xizeile = M|aktzeile
.continue FI024
!EL024
.continue EL025 ? _(M|yistblatt)
.continue EL026 ? _(_(F|defined(M|ybverwaltung)))
.formula U|xistufe = M|tbaumstufe
.formula U|xrpoist    = 0
.formula U|xrpofakt   = 0
.formula U|xrpoabger  = 0
.formula U|xrpozus    = 0
.formula U|xrtasksoll = 0
.formula U|xrtaskplan = 0
.formula U|xtystatus  = ""
.load 9 add M|yobjekt
.continue EL027 ? _(_(F|empty(9|yrefid)))
.load 1 object '9|yrefid'
.continue EL028 ? _(G|mehr)
.formula M|tbaumstat = "+"               ? _G|evtvar = "tbaumaufzu"
.continue EL029 ? _(((M|ybmitauf) & (_(G|evtvar = "ybuaufzu")) & (_(G|evtvar = "ybualleazu"))) ; ((U|xbpvorgang) & (U|xbblatt)) ; (G|evtvar = "ybualleauf"))
.make screen line +O
.formula M|yfarbe     = U|xyfarbeaufgabe
.formula M|yebene     = 1|grbez
.formula M|yobjekt    = 1|id
.formula M|ynummer    = M|yobjekt^nummer ? F|defined(M|ynummer)
.formula M|ysuch      = M|yobjekt^such   ? F|defined(M|ysuch)
.continue EL030 ? _((1|dnr    = U|xydbaufgabe) & (1|gruppe = U|xygraufgabe))
.formula M|ystatus    = 1|ystatus           ? F|defined(1|ystatus)
.formula U|xtystatus  = M|ystatus
.formula M|yname      = 1|namebspr
.copy    M|ytkunde    = 1|ykunde            ? F|defined(1|ykunde)
.formula M|ytkuname   = 1|ykunde^namebspr   ? F|defined(1|ykunde)
.formula M|yadatum    = 1|yadatum           ? 1|dnr = U|xydbaufgabe & 1|gruppe = U|xygraufgabe
.formula M|yedatum    = 1|yedatum
.copy    M|ybz        = 1|ypersonal
.formula M|ysollalle  = 1|ysollstd              ? F|defined(M|ysollalle)
.formula M|yplanalle  = 1|yplanstd              ? F|defined(M|yplanalle)
.formula M|ysolltask  = 1|ysollstd              ? F|defined(M|ysolltask)
.formula M|yplantask  = 1|yplanstd              ? F|defined(M|yplantask)
.formula M|yistar     = 1|yiststd               ? F|defined(M|yistar)
.formula M|yfaktar    = 1|yfaktstd              ? F|defined(M|yfaktar)
.formula M|ysolloffen = M|ysolltask - M|yfaktar ? F|defined(M|ysolloffen)
.formula M|yplanoffen = M|yplantask - M|yistar  ? F|defined(M|yplanoffen)
.formula M|yforecaststd = 1|yforecaststd        ? F|defined(M|yforecaststd)
.formula M|ybucheckliste = 0|yclclvorhanden     ? F|defined(M|ybucheckliste)
.copy    M|ytaetschl     = 1|ytaetschl          ? F|defined(M|ytaetschl)
.copy    M|yprojteam     = 1|yprojteam          ? F|defined(M|yprojteam)
.copy    M|ykstelle      = 1|ykstelle           ? F|defined(M|ykstelle)
.copy    M|yvkartikel    = 1|yvkartikel         ? F|defined(M|yvkartikel)
.copy    M|ymaschvkart   = 1|ymaschvkart        ? F|defined(M|ymaschvkart)
.formula M|yprojsuch     = 1|yprojekt^such      ? F|defined(M|yprojsuch)
.formula M|yiststart   = 1|ytatsterm            ? F|defined(M|yiststart)
.formula M|ydauer      = 1|ydauer               ? F|defined(M|ydauer)
.copy    M|ytprojleit  = 1|yprojekt^yprojleit   ? F|defined(M|ytprojleit)
.copy    M|yverantw    = 1|yverantw             ? F|defined(M|yverantw)
.continue EL031 ? _(_(F|empty(1|yftext)))
.select from '1|yftext'
.formula M|yftext = 1|yftext
!EL031
!EL030
.continue EL032 ? _((1|dnr    = 4) & (1|gruppe = 5))
