.formula M|ysuch      = M|yobjekt^such          ? F|defined(M|ysuch)
.formula M|yname      = 2|bem
.formula M|yadatum    = 2|vom
.formula M|yistar     = 2|bzeit                 ? F|defined(M|yistar)
.formula M|ytb1 = G|TRUE
.formula U|xistufe    = U|xistufe + 1
.formula M|tbaumstufe = U|xistufe
.formula U|xistufe    = U|xistufe - 1
!EL022
