.set trans -
..========================================================================
..==  Name              : FOP.MASK.TRANSACTION
..==  Pfad              : allpstart
..==  Funktion          : Maskenereignisse Transaktion
..==  Erstellungsdatum  : 03.08.07
..==  Autor             : alltrotec GmbH/CP
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==
..==  Besonderheiten    : Es sind AbarbeitungsprioritÑten von 0-99 erlaubt!
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
.input DATEI.F
..====================================================
.type integer   xzdb xi01
.type text      xt01 xid xhlp xsys xtpost xedp xout xerr
.type bool      xb01 xbok xbprio
.type GD2       xd01
.type GD14      xd02
..====================================================
.type integer   xprocsp         ? _F|defined(U|xprocsp)
.set demand -
.continue EPROCDEF
!PROC001: ----- post -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ytransempfid)
.formula U|xd01 = "."
.output addedto 'U|xtpost'
.set trans +

Ende    'G|zeitpunkt'
?Alle Transaktionen wurden verbucht.            ?  U|xb01
?Transaktionen mÅssen nachbearbeitet werden!    ? _U|xb01
.set trans -
**********************************************
.output new WERF.WEG
.continue EL001 ? _(_(F|empty(5|ytransempfid)))
.make message
.set trans +
.formula H|betreff = "Nachtlauf: Transaktionen"
.set trans -
.formula H|ftext   = U|xtpost
.formula H|termin  = "."
.formula H|terzeit = "."
.make line
.formula H|empfex  = 5|ytransempfid
.rewrite
.system 'F|formatstr("rm -f {1}", U|xtpost)' background
.continue FI001
!EL001
.set trans +
Post kann nicht versendet werden, da in der ProjectSuite keine EmpfÑnger eingetragen ist.
.set trans -
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- maskeaktualisieren -----
.continue EL002 ? _((_(G|batchmode)) & (_(G|evtart = "noevent")))
.select screen header
.copy    M|ystrstatusk = 0|ytrstatusk
.formula M|yspriotr    = 0|ypriotr
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|yprioz        = M|ytrdaten^yprio
.assign  M|ystattextk    = M|ytrdaten^ystatusk
.assign  M|yssbuchung    = M|ytrdaten^ysbuchung
.assign  M|ysfbuchung    = M|ytrdaten^yfbuchung
.assign  M|yssbuchstorno = M|ytrdaten^ysbuchstorno
.assign  M|ysfbuchstorno = M|ytrdaten^yfbuchstorno
.continue BRK001 ? _(M|ystattextk = "ANG")
.formula M|ystatusz = "icon:ball_blue"
.continue ESAC001
!BRK001
.continue BRK002 ? _(M|ystattextk = "BIE")
.formula M|ystatusz = "icon:ball_red"
.continue ESAC001
!BRK002
.continue BRK003 ? _(M|ystattextk = "BIG")
.formula M|ystatusz = "icon:ball_yellow"
.continue ESAC001
!BRK003
.continue BRK004 ? _(M|ystattextk = "BUE")
.formula M|ystatusz = "icon:ok"
.continue ESAC001
!BRK004
!ESAC001: =====   ENDCASE   =====
.select screen line
.continue LOOP001
!ELOP001: ==============================
!EL002
.continue 'xprocst.xprocsp'
!PROC003: ----- trafofop -----
.load 9 add F|sysinfo(10)^ykonfigprjm
.continue EL003 ? _((F|defined(9|ybutypk1)) & (F|defined(9|ytrafofop1)))
.load 0 line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL004 ? _((_(F|empty(0|ytrdaten^ybutypk))) & ((0|ytrdaten^ystatusk = "ANG") ; (0|ytrdaten^ystatusk = "BIE")) & (0|ytrdaten^yprio = 0|ypriotr))
.copy U|xb01 = G|false
.formula U|xi01 = 1
!LOOP003: ==============================
.continue ELOP003 ? _((F|defined(9|ybutypk.xi01)) & (_(U|xb01)))
.continue EL005 ? _(('0|ytrdaten^ybutypk' = '9|ybutypk.U|xi01') & (_(F|empty(9|ytrafofop.U|xi01))))
.input '9|ytrafofopk.xi01'
.copy U|xb01 = G|true
!EL005
.formula U|xi01 = U|xi01 + 1
.continue LOOP003
!ELOP003: ==============================
.continue EL006 ? _(_(U|xb01))
.continue EL007 ? _(_(G|evtart = "noevent"))
.set trans +
.box Hinweis
FÅr den Transaktionsdatensatz '0|ytrdaten' ist das
buchungstypspezifische Transformationsprogramm in
den Betriebsdaten nicht hinterlegt -
Keine weitere Verarbeitung mîglich!
.set trans -
.cursor ytrdaten '0|aktzeile'
.error (0)
.end 2
.continue FI007
!EL007
.select lock add 0|ytrdaten
.set trans +
.formula H|yfehler = "Fehlerprotokoll beachten!"
.set trans -
.formula U|xsys      = "test -f LEERKOPF"
.system 'U|xsys' BACKGROUND
.continue EL008 ? _(_(G|mehr))
.formula U|xsys = "touch LEERKOPF"
.system 'U|xsys' BACKGROUND
!EL008
.formula yftext = "LEERKOPF"
.output ADDEDTO 'yftext'
.set trans +
FÅr diesen Transaktionsdatensatz ist das buchungstypspezifische Transformationsprogramm
in den Betriebsdaten nicht hinterlegt - Keine weitere Verarbeitung mîglich!
.set trans -
.output NEW WERF.WEG
.formula H|ystatusk = "ANG"
.rewrite
.select --
!FI007
!EL006
!EL004
.load 0 line
.continue LOOP002
!ELOP002: ==============================
!EL003
.load 0 header
.continue 'xprocst.xprocsp'
!PROC004: ----- check -----
.load 0 header
.load 0 line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL009 ? _((F|empty(0|ytrdaten^ysbuchung)) & (F|empty(0|ytrdaten^yfbuchung)) & (0|ytrdaten^yprio = 0|ypriotr) & (_(0|ytrdaten^ybabl)))
.load 1 add 0|ytrdaten
.input "allpstart/UP.CHECK.TRANSACTION"
!EL009
.load 0 line
.continue LOOP004
!ELOP004: ==============================
.load 0 header
.copy U|xbok = G|true
.select lock add 0|id
.select lock line
!LOOP005: ==============================
.continue ELOP005 ? _((G|mehr) & (U|xbok))
.continue EL010 ? _((F|empty(H|ytrdaten^ysbuchung)) & (F|empty(H|ytrdaten^yfbuchung)) & (H|ytrdaten^yprio = 0|ypriotr) & (_(H|ytrdaten^ybabl)))
.copy U|xbok = false    ? _H|ytrdaten^ystatusk = "BIG"
!EL010
.select lock line
.continue LOOP005
!ELOP005: ==============================
.select lock header
.formula H|ytrstatusk = "BIG"   ?  U|xbok
.formula H|ytrstatusk = "BIE"   ? _U|xbok
.rewrite
.select --
