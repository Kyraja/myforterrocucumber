!LOOP015: ==============================
.continue ELOP015 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET018" 
.continue PROC005
!RET018
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP015
!ELOP015: ==============================
.copy U|xb01 = G|TRUE
.formula U|xsys = "$,,ytrtypk==FF;ysubeg==" + 'U|xd02'
.load 0 group 'U|xydbgrtrans' 'U|xsys'
!LOOP016: ==============================
.continue ELOP016 ? _((G|mehr) & (U|xb01))
.copy U|xb01 = G|false      ? _0|ytrstatusk = "BUE"
.load 0 continue
.continue LOOP016
!ELOP016: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET019" 
.continue PROC001
!RET019
.formula xprocsp = xprocsp - 1
.continue ESAC003
