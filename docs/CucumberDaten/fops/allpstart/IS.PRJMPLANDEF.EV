..!interpreter english declaration noabbrev
.. at 2017-06-27, 09:18
.set trans -
..========================================================================
..==  Name              : IS.PRJMPLANDEF.EV
..==  Pfad              : allpstart
..==  Funktion          : Anlage eines Projektplanes / Arbeitsaufgaben
..==  Erstellungsdatum  : 27.04.2009
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtedpdat xtedpout xtedperr xtedpmsg xtpvorgang xtaufgabe xtifop xtindex
.type text    xtaucmd xtauaend xtpvcmd xtpvaend xtftext xtext xtkatartk xtvkartikel xtmaschvkart xtprojleistkatid xt1
.type text    xtid xtbetreuer xtstatus xtverantw xtpersonal xtprojteam xtkstelle xtleiart xttppos xtkalkpos xtklass xtxml xtvkpos
.type text    xykoobjekt xysel xydbgr xytaufrufernr xytzeitstempel xtsperrstempel xttitel xttext1 xttext2
.type real    xrplan xrsoll xrpreis xrsumpvvpos xrdiffpvvpos xrvkartpreis xrmvkartpreis xrvorwert
.type real    xraktiststd xriststd xrwertiststd xraktfcstd xrfcpvplanstd xrwertfcpvplanstd xr1
.type realx   xxmge
.type integer xistatus xianz xyvdn xyvgr xiaktzeile xizeile xifarbe xi1
.type GD      xdadatum xdedatum xdkonddat xdadataufg xdedataufg
.type bool    xbmehr xbpvok xbaaok xbaktiv xbsetz xyberlaubt xbdiff xbok xbhinweis xb1 xb2 xbrlsrelev
.type P0      xpkunde
.type P2      xpart
.type P3:2    xpaupos
.type TAZ1    xpape
.type TAZ7    xeinh xstunden
.type T34     xtname
.type symtab  xystclosingvars
.type P86:1   xpprojekt xpproject
.type P149:3  xpaufgabe
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Farben -----
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- SperreFreigeben -----
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL001 ? _(M|ytsperre)
.continue EL002 ? _(_(F|empty(M|ypvorgang)))
.select lock add M|ypvorgang
.continue EL003 ? _(G|mehr)
.copy H|ysperre = G|false
.rewrite
.continue FI003
!EL003
.set TRANS +
.box Hinweis
Der Projektvorgang 'M|ypvorgang^nummer'/'M|ypvorgang^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI003
!EL002
.continue EL004 ? _(_(F|empty(M|yaufgabe)))
.select lock add M|yaufgabe
.continue EL005 ? _(G|mehr)
.copy H|ysperre = G|false
.rewrite
.continue FI005
!EL005
.set TRANS +
.box Hinweis
Die Arbeitsaufgabe 'M|yaufgabe^nummer'/'M|yaufgabe^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set TRANS -
!FI005
!EL004
!EL001
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC003: ----- Tabelle_Leeren -----
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.formula M|ywertsollstd = 0
.formula M|ywertplanstd = 0
.formula M|ywertauftrag = 0
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.make screen line --O
.continue 'xprocst.xprocsp'
!PROC004: ----- Wert_ermitteln -----
.continue EL006 ? _(F|sysinfo(18)^allpstd)
.input "is/PREISAUSKUNFT"       ? _F|defined(U|xpaartikel)
.assign  U|xpprojekt        = M|yprojekt^id
.assign  U|xpkunde          = M|yprojekt^ykunde^id
.assign  U|xpaupos          = M|yvorvp^id
.assign  U|xdkonddat        = M|yadatum
.formula U|xtprojleistkatid = ""
.formula U|xtprojleistkatid = M|yprojleistkat^id        ? _F|empty(M|yprojleistkat)
.continue EL007 ? _(_(G|evtvar = "ymaschvkart"))
.formula U|xpaartikel = M|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.input 'U|xtupartpreis'
.formula M|yvkartpreis = U|xyhpreis
!EL007
.continue EL008 ? _(_(G|evtvar = "yvkartikel"))
.formula U|xpaartikel = M|ymaschvkart^id
.formula U|xtkatartk  = "ML"
.input 'U|xtupartpreis'
.formula M|ymvkartpreis = U|xyhpreis
!EL008
!EL006
.continue 'xprocst.xprocsp'
!PROC005: ----- Preise_neu_ermitteln -----
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC004
!RET003
.formula xprocsp = xprocsp - 1
.select screen line
.continue LOOP003
!ELOP003: ==============================
.continue 'xprocst.xprocsp'
!PROC006: ----- Wert_Soll_Plan_Ist -----
.input "is/PREISAUSKUNFT"               ? _F|defined(U|xpaartikel)
.assign  U|xpprojekt        = M|yprojekt^id
.assign  U|xpkunde          = M|yprojekt^ykunde^id
.formula U|xtprojleistkatid = ""
.formula U|xtprojleistkatid = M|yprojleistkat^id        ? _F|empty(M|yprojleistkat)
.formula M|ytwertsollstd     = 0
.formula M|ytwertplanstd     = 0
.formula M|ytwertiststd      = 0
.formula M|yfcpvplanstd      = 0
.formula M|ytwertfcpvplanstd = 0
.formula M|ytwertauftrag     = 0
.formula U|xraktiststd       = 0
.formula U|xraktfcstd        = 0
.continue EL009 ? _(F|defined(H|id))
.load 1 group 'U|xydbgrlnachweis' 'F|expr("$,,ypvorgang==" + H|id + ";@filingmode=(Active)")'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula M|ytwertiststd  = M|ytwertiststd + (1|yarbzeit  * 1|ylmpreis) + (1|ymaschzeit  * 1|ymzpreis)
.formula U|xraktiststd   = U|xraktiststd  +  1|yarbzeit     ? '1|yadatum:8'<<6 = 'G|datum:8'<<6
.load 1 continue
.continue LOOP004
!ELOP004: ==============================
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ypmsubistberech)
.continue EL010 ? _(5|ypmsubistberech)
.load 1 group 'U|xydbgrsubmeldung' 'F|expr("$,,ytpvorgang==" + H|id + ";@rows=(Yes);@filingmode=(Active)")'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.load 1 line '1|selzeile'
.formula M|ytwertiststd  = M|ytwertiststd + 1|ytsmwert
.formula U|xraktiststd   = U|xraktiststd  + 1|ytsmwert  ? '1|ytdatum:8'<<6 = 'G|datum:8'<<6
.assign U|xeinh = '1|yeinh(L=":")'
.continue EL011 ? _(G|mehr)
.continue EL012 ? _((_(F|empty(U|xeinh))) & (_(F|empty(5|ypmeinhstunden))))
.formula U|xraktiststd = U|xraktiststd + (1|ymge * F|unitconvfactor(U|xeinh,5|ypmeinhstunden))  ? '1|ytdatum:8'<<6 = 'G|datum:8'<<6
!EL012
!EL011
.load 1 continue
.continue LOOP005
!ELOP005: ==============================
!EL010
.formula U|xtsel = "$,,ypvorgang==" + H|id + ";ydatum>=" + 'G|datum:8'<<6 + "01" + ";ybsim==0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group "P154:2" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.assign  U|xpaupos          = H|yvorvp^id
.assign  U|xdkonddat        = 1|ydatum
.continue EL013 ? _(F|sysinfo(18)^allpstd)
.formula U|xpaartikel = H|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.input 'U|xtupartpreis'
.formula U|xrvkartpreis = U|xyhpreis
.formula U|xpaartikel = H|ymaschvkart^id
.formula U|xtkatartk  = "ML"
.input 'U|xtupartpreis'
.formula U|xrmvkartpreis = U|xyhpreis
!EL013
.continue EL014 ? _('1|ydatum:8'<<6 = 'G|datum:8'<<6)
.continue EL015 ? _(U|xraktfcstd + 1|ywert > U|xraktiststd)
.formula U|xr1 = 1|ywert                                    ? U|xraktfcstd >= U|xraktiststd
.formula U|xr1 = U|xraktfcstd + 1|ywert  - U|xraktiststd    ? U|xraktfcstd <  U|xraktiststd
.formula M|yfcpvplanstd      = M|yfcpvplanstd + U|xr1
.formula M|ytwertfcpvplanstd = M|ytwertfcpvplanstd + (U|xr1 * U|xrvkartpreis)                               ?  F|empty(M|ymaschvkart)
.formula M|ytwertfcpvplanstd = M|ytwertfcpvplanstd + (U|xr1 * U|xrvkartpreis) + (U|xr1 * U|xrmvkartpreis)   ? _F|empty(M|ymaschvkart)
!EL015
.formula U|xraktfcstd        = U|xraktfcstd  +  1|ywert
.continue FI014
!EL014
.formula M|yfcpvplanstd      = M|yfcpvplanstd + 1|ywert
.formula M|ytwertfcpvplanstd = M|ytwertfcpvplanstd + (1|ywert * U|xrvkartpreis)                                 ?  F|empty(M|ymaschvkart)
.formula M|ytwertfcpvplanstd = M|ytwertfcpvplanstd + (1|ywert * U|xrvkartpreis) + (1|ywert * U|xrmvkartpreis)   ? _F|empty(M|ymaschvkart)
!FI014
.load 1 continue
.continue LOOP006
!ELOP006: ==============================
!EL009
.formula M|ytwertsollstd     = (M|ysoll        * M|yvkartpreis)                                         ?  F|empty(M|ymaschvkart)
.formula M|ytwertsollstd     = (M|ysoll        * M|yvkartpreis) + (M|ysoll        * M|ymvkartpreis)     ? _F|empty(M|ymaschvkart)
.assign  U|xpaupos          = M|yvorvp^id
.assign  U|xdkonddat        = ""
.formula U|xrvkartpreis     = 0
.formula U|xrmvkartpreis    = 0
.continue EL016 ? _(F|sysinfo(18)^allpstd)
.formula U|xpaartikel = M|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.input 'U|xtupartpreis'
.formula U|xrvkartpreis = U|xyhpreis
.formula U|xpaartikel = M|ymaschvkart^id
.formula U|xtkatartk  = "ML"
.input 'U|xtupartpreis'
.formula U|xrmvkartpreis = U|xyhpreis
!EL016
.formula M|ytwertplanstd     = M|ytwertiststd + M|ytwertfcpvplanstd + ((M|yplan - M|yiststd - M|yfcpvplanstd) * U|xrvkartpreis)                                                                 ?  F|empty(M|ymaschvkart)
.formula M|ytwertplanstd     = M|ytwertiststd + M|ytwertfcpvplanstd + ((M|yplan - M|yiststd - M|yfcpvplanstd) * U|xrvkartpreis) + ((M|yplan - M|yiststd - M|yfcpvplanstd) * U|xrmvkartpreis)    ? _F|empty(M|ymaschvkart)
.continue 'xprocst.xprocsp'
!PROC007: ----- Wert_AU_Soll_Plan_Ist_neu -----
.load 5 add F|sysinfo(10)^ykonfigprjm   ? _F|defined(5|ypmccverwenden)
.input "is/PREISAUSKUNFT"               ? _F|defined(U|xpaartikel)
.select screen header
.formula U|xtvkpos      = ""
.formula M|ywertsollstd = 0
.formula M|ywertplanstd = 0
.formula M|ywertiststd  = 0
.formula M|ywertauftrag = 0
.formula U|xraktiststd  = 0
.formula U|xraktfcstd   = 0
.select screen line
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.formula M|ywertsollstd = M|ywertsollstd + M|ytwertsollstd
.formula M|ywertplanstd = M|ywertplanstd + M|ytwertplanstd
.formula M|ywertiststd  = M|ywertiststd  + M|ytwertiststd
.formula U|xtid         = (M|yvorvp^id<<",")<<-1
.formula M|ywertauftrag = M|ywertauftrag + M|yvorwert           ?  F|empty(M|yvorvp) ; _F|regmatch(U|xtvkpos,F|expr(".*" + U|xtid + ".*"))
.formula U|xtvkpos      = U|xtvkpos + "," + U|xtid              ? _F|empty(M|yvorvp)
.continue EL017 ? _(_(F|empty(M|ypvorgang)))
.formula U|xt1 = M|ypvorgang^nummer
.type text xtpvmerk.xt1     ? _F|defined(U|xtpvmerk.xt1)
!EL017
.select screen line
.continue LOOP007
!ELOP007: ==============================
.assign  U|xpprojekt        = M|yprojekt^id
.assign  U|xpkunde          = M|yprojekt^ykunde^id
.formula U|xtprojleistkatid = ""
.formula U|xtprojleistkatid = M|yprojleistkat^id        ? _F|empty(M|yprojleistkat)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt==" + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";yistblatt==1"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.formula U|xt1 = H|nummer
.continue EL018 ? _((_(F|defined(U|xtpvmerk.xt1))) & ((G|true) ; (_(F|regmatch(U|xtpvorgang,F|expr(".*" + H|nummer + ".*"))))))
.formula U|xriststd     = 0
.formula U|xrwertiststd = 0
.load 1 group 'U|xydbgrlnachweis' 'F|expr("$,,ypvorgang==" + H|id + ";@filingmode=(Active)")'
!LOOP009: ==============================
.continue ELOP009 ? _(G|mehr)
.formula U|xriststd     = U|xriststd     +  1|yarbzeit
.formula U|xraktiststd  = U|xraktiststd  +  1|yarbzeit     ? '1|yadatum:8'<<6 = 'G|datum:8'<<6
.formula U|xrwertiststd = U|xrwertiststd + (1|yarbzeit  * 1|ylmpreis) + (1|ymaschzeit  * 1|ymzpreis)
.formula M|ywertiststd  = M|ywertiststd  + (1|yarbzeit  * 1|ylmpreis) + (1|ymaschzeit  * 1|ymzpreis)
.load 1 continue
.continue LOOP009
!ELOP009: ==============================
.continue EL019 ? _(5|ypmsubistberech)
.load 1 group 'U|xydbgrsubmeldung' 'F|expr("$,,ytpvorgang==" + H|id + ";@rows=(Yes);@filingmode=(Active)")'
!LOOP010: ==============================
.continue ELOP010 ? _(G|mehr)
.load 1 line '1|selzeile'
.formula U|xrwertiststd = U|xrwertiststd + 1|ytsmwert
.formula M|ywertiststd  = M|ywertiststd  + 1|ytsmwert
.assign U|xeinh = '1|yeinh(L=":")'
.continue EL020 ? _(G|mehr)
.continue EL021 ? _((_(F|empty(U|xeinh))) & (_(F|empty(5|ypmeinhstunden))))
.formula U|xriststd    = U|xriststd    + (1|ymge * F|unitconvfactor(U|xeinh,5|ypmeinhstunden))
.formula U|xraktiststd = U|xraktiststd + (1|ymge * F|unitconvfactor(U|xeinh,5|ypmeinhstunden))  ? '1|ytdatum:8'<<6 = 'G|datum:8'<<6
!EL021
!EL020
.load 1 continue
.continue LOOP010
!ELOP010: ==============================
!EL019
.formula U|xraktfcstd        = 0
.formula U|xrfcpvplanstd     = 0
.formula U|xrwertfcpvplanstd = 0
.formula U|xtsel = "$,,ypvorgang==" + H|id + ";ydatum>=" + 'G|datum:8'<<6 + "01" + ";ybsim==0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group "P154:2" 'U|xtsel'
!LOOP011: ==============================
.continue ELOP011 ? _(G|mehr)
.assign  U|xpaupos          = H|yvorvp^id
.assign  U|xdkonddat        = 1|ydatum
.formula U|xrvkartpreis     = 0
.formula U|xrmvkartpreis    = 0
.continue EL022 ? _(F|sysinfo(18)^allpstd)
.formula U|xpaartikel = H|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.input 'U|xtupartpreis'
.formula U|xrvkartpreis = U|xyhpreis
.formula U|xpaartikel = H|ymaschvkart^id
.formula U|xtkatartk  = "ML"
.input 'U|xtupartpreis'
.formula U|xrmvkartpreis = U|xyhpreis
!EL022
.continue EL023 ? _('1|ydatum:8'<<6 = 'G|datum:8'<<6)
.continue EL024 ? _(U|xraktfcstd + 1|ywert > U|xraktiststd)
.formula U|xr1 = 1|ywert                                    ? U|xraktfcstd >= U|xraktiststd
.formula U|xr1 = U|xraktfcstd + 1|ywert  - U|xraktiststd    ? U|xraktfcstd <  U|xraktiststd
.formula U|xrfcpvplanstd     = U|xrfcpvplanstd + U|xr1
.formula U|xrwertfcpvplanstd = U|xrwertfcpvplanstd + (U|xr1 * U|xrvkartpreis)                               ?  F|empty(H|ymaschvkart)
.formula U|xrwertfcpvplanstd = U|xrwertfcpvplanstd + (U|xr1 * U|xrvkartpreis) + (U|xr1 * U|xrmvkartpreis)   ? _F|empty(H|ymaschvkart)
!EL024
.formula U|xraktfcstd        = U|xraktfcstd  +  1|ywert
.continue FI023
!EL023
.formula U|xrfcpvplanstd     = U|xrfcpvplanstd + 1|ywert
.formula U|xrwertfcpvplanstd = U|xrwertfcpvplanstd + (1|ywert * U|xrvkartpreis)                                 ?  F|empty(H|ymaschvkart)
.formula U|xrwertfcpvplanstd = U|xrwertfcpvplanstd + (1|ywert * U|xrvkartpreis) + (1|ywert * U|xrmvkartpreis)   ? _F|empty(H|ymaschvkart)
!FI023
.load 1 continue
.continue LOOP011
!ELOP011: ==============================
.assign  U|xpaupos          = H|yvorpos
.assign  U|xdkonddat        = H|yadatum
.formula U|xrvkartpreis     = 0
.formula U|xrmvkartpreis    = 0
.continue EL025 ? _(F|sysinfo(18)^allpstd)
.formula U|xpaartikel = H|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.input 'U|xtupartpreis'
.formula U|xrvkartpreis = U|xyhpreis
.formula U|xpaartikel = H|ymaschvkart^id
.formula U|xtkatartk  = "ML"
.input 'U|xtupartpreis'
.formula U|xrmvkartpreis = U|xyhpreis
!EL025
.formula U|xtid  = (H|yvorpos<<",")<<-1
.continue EL026 ? _((_(F|regmatch(U|xtvkpos,F|expr(".*" + U|xtid + ".*")))) & (_(F|empty(H|yvorpos))))
.formula U|xrvorwert = 0
.load 1 group "P3:2" 'H|yvorpos'
.continue EL027 ? _(G|mehr)
.formula U|xrvorwert = 1|pwert                                                  ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk <> "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk <> "KOMP")) & 1|pland =  G|inland
.formula U|xrvorwert = F|fxamount(G|inland,1|pwert,,1|pland,G|true)             ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk <> "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk <> "KOMP")) & 1|pland <> G|inland
.formula U|xrvorwert = 1|yprjmpeigenleist                                       ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk =  "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk =  "KOMP")) & 1|pland =  G|inland
.formula U|xrvorwert = F|fxamount(G|inland,1|yprjmpeigenleist,,1|pland,G|true)  ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk =  "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk =  "KOMP")) & 1|pland <> G|inland
.formula U|xrvorwert = 1|pwert                                                  ?  _5|ypmccverwenden                                   & _5|ypmpcverwenden                                    & 1|pland =  G|inland
.formula U|xrvorwert = F|fxamount(G|inland,D|pwert,,D|pland,G|true)             ?  _5|ypmccverwenden                                   & _5|ypmpcverwenden                                    & 1|pland <> G|inland
!EL027
.formula M|ywertauftrag = M|ywertauftrag + U|xrvorwert
.formula U|xtvkpos      = U|xtvkpos + "," + U|xtid
!EL026
.formula M|ywertsollstd = M|ywertsollstd + (H|ypvsollstd * U|xrvkartpreis)                                      ?  F|empty(H|ymaschvkart)
.formula M|ywertsollstd = M|ywertsollstd + (H|ypvsollstd * U|xrvkartpreis) + (H|ypvsollstd * U|xrmvkartpreis)   ? _F|empty(H|ymaschvkart)
.assign  U|xpaupos          = H|yvorpos
.assign  U|xdkonddat        = ""
.formula U|xrvkartpreis     = 0
.formula U|xrmvkartpreis    = 0
.continue EL028 ? _(F|sysinfo(18)^allpstd)
.formula U|xpaartikel = H|yvkartikel^id
.formula U|xtkatartk  = "PQ"
.input 'U|xtupartpreis'
.formula U|xrvkartpreis = U|xyhpreis
.formula U|xpaartikel = H|ymaschvkart^id
.formula U|xtkatartk  = "ML"
.input 'U|xtupartpreis'
.formula U|xrmvkartpreis = U|xyhpreis
!EL028
.formula M|ywertplanstd = M|ywertplanstd + (U|xrwertiststd + U|xrwertfcpvplanstd + ((H|ypvplanstd - H|ypviststd - U|xrfcpvplanstd) * U|xrvkartpreis))                                                                       ?  F|empty(H|ymaschvkart)
.formula M|ywertplanstd = M|ywertplanstd + (U|xrwertiststd + U|xrwertfcpvplanstd + ((H|ypvplanstd - H|ypviststd - U|xrfcpvplanstd) * U|xrvkartpreis) + ((H|ypvplanstd - H|ypviststd - U|xrfcpvplanstd) * U|xrmvkartpreis))  ? _F|empty(H|ymaschvkart)
