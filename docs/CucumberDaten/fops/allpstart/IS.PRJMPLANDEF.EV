.formula U|xiaktzeile = M|aktzeile
.formula U|xtid        = M|yvorvp^id
.formula M|ysumpvvpos  = 0
.formula M|ydiffpvvpos = 0
.formula U|xrsumpvvpos = 0
.continue EL038 ? _(_(F|empty(M|yvorvp)))
.formula U|xtsel = "$,,yvorvp==" + M|yvorvp^id
.select screen line 'U|xtsel'
!LOOP012: ==============================
.continue ELOP012 ? _(G|mehr)
.continue EL039 ? _(_(F|empty(M|ypvorgang)))
.formula U|xtindex = "PV" + (M|ypvorgang^id<<",")<<-1
.type text xtxypv.xtindex        ? _F|defined(U|xtxypv.xtindex)
!EL039
.formula U|xrsumpvvpos = U|xrsumpvvpos + M|ysoll    ? _G|evtart = "feldfuell" ; _M|aktzeile = U|xiaktzeile
.select screen line
.continue LOOP012
!ELOP012: ==============================
.select screen line 'U|xiaktzeile'
.formula U|xtsel = "$,,yvorpos==" + M|yvorvp^id + ";yistblatt=1;@filingmode=(Active)"
.load 9 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP013: ==============================
.continue ELOP013 ? _(G|mehr)
.formula U|xtindex = "PV" + (9|id<<",")<<-1
.formula U|xrsumpvvpos  = U|xrsumpvvpos + 9|ypvsollstd    ? _F|defined(U|xtxypv.xtindex)
.load 9 continue
.continue LOOP013
!ELOP013: ==============================
.formula M|ysumpvvpos  = U|xrsumpvvpos
.continue EL040 ? _(_(F|empty(U|xstunden)))
.copy U|xbdiff = G|true
.load 9 add M|yvorvp
.continue EL041 ? _(G|mehr)
.formula U|xxmge = 9|mge * 9|lehe
.assign U|xeinh = '9|art^le(L="0")'
.continue EL042 ? _(G|mehr)
.formula M|ydiffpvvpos = (U|xxmge * F|unitconvfactor(U|xeinh,U|xstunden)) - M|ysumpvvpos
.continue FI042
!EL042
.assign U|xeinh = '9|he(L=":")'
.continue EL043 ? _(G|mehr)
.formula M|ydiffpvvpos = (9|mge * F|unitconvfactor(U|xeinh,U|xstunden)) - M|ysumpvvpos
.continue FI043
!EL043
.copy U|xbdiff = G|false
!FI043
!FI042
.continue FI041
!EL041
.copy U|xbdiff = G|false
!FI041
!EL040
!EL038
.continue 'xprocst.xprocsp'
