.formula M|ytpwert   = D|yeigenleist            ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk =  "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk =  "KOMP"))
.formula M|ytpwert   = D|ypwert                 ?  _5|ypmccverwenden                                   & _5|ypmpcverwenden
