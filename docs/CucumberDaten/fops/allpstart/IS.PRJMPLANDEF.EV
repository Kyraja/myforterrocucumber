.continue EL063 ? _(F|empty(M|yvorgang))
.continue EL064 ? _(F|empty(M|yvorgang^betreuer))
.assign M|ykverantw = G|passw^passmitarb^id
.continue FI064
!EL064
.formula U|xtsel = "$,,yma==" + M|yvorgang^betreuer^id
.load 9 group 'U|xydbgrpersonal' 'U|xtsel'
.continue EL065 ? _(G|mehr)
.assign M|ykverantw  = 9|id
!EL065
!FI064
!EL063
.assign M|ykverantw = G|passw^passmitarb^id    ? F|empty(M|ykverantw)
!EL062
.continue 'xprocst.xprocsp'
!PROC014: ----- Pruefung_anlegen -----
.continue EL066 ? _((M|ybpvanlegen) ; (M|ybaaanlegen) ; (M|ybspeichern) ; (U|xbsetz))
.copy U|xbpvok = G|true
.copy U|xbaaok = G|true
.copy U|xpproject = M|yprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"   ? _F|defined(F|rec(U|xystclosingvars, ypmtabpruefpv))
.continue EL067 ? _((_(M|yprojekt^ystatusk = "AKT")) ; ((M|yprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefpv))) ; (((M|yprojekt^ystatusk = "ABS") ; (M|yprojekt^ystatusk = "08") ; (M|yprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefpv))))
.continue EL068 ? _(_(U|xbsetz))
.continue EL069 ? _(M|ybaaanlegen)
.set trans +
.formula U|xttitel = "Fehler"
.formula U|xttext1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", M|yprojekt^such, G|dblquote, M|yprojekt^ystatus)
.formula U|xttext2 = "Nur zu aktiven Projekten dÅrfen Arbeitsaufgaben erfasst oder geÑndert werden."
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.error
.assign M|ybaaanlegen = G|false         ?   G|evtvar = "ybaaanlegen"
.assign M|ybspeichern = G|false         ?   G|evtvar = "ybspeichern"
.end 1
!EL069
!EL068
.copy U|xbaaok      = G|false
!EL067
.continue EL070 ? _((F|empty(M|ypersonal)) & (F|empty(M|ykstelle)) & (F|empty(M|yprojteam)))
.continue EL071 ? _(_(U|xbsetz))
.continue EL072 ? _(M|ybaaanlegen)
.set TRANS +
.box Hinweis
Zur Arbeitsaufgabe muss der Bearbeiter, die Kostenstelle oder ein Projektteam eingetragen sein.
.set TRANS -
.error
.cursor ypersonal 'M|aktzeile'          ? _(G|evtvar = "ybpvanlegen" & _G|evtvar = "ybaaanlegen")
.assign M|ybaaanlegen = G|false         ?   G|evtvar = "ybaaanlegen"
.assign M|ybspeichern = G|false         ?   G|evtvar = "ybspeichern"
.end 1
!EL072
!EL071
.copy U|xbaaok      = G|false
.continue FI070
!EL070
.formula U|xi1 = 0
.formula U|xi1 = U|xi1 + 1      ? _F|empty(M|ypersonal)
.formula U|xi1 = U|xi1 + 1      ? _F|empty(M|ykstelle)
.formula U|xi1 = U|xi1 + 1      ? _F|empty(M|yprojteam)
.continue EL073 ? _(U|xi1 > 1)
.continue EL074 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
Es darf nur eines der Felder Bearbeiter, Kostenstelle oder Projektteam gefÅllt sein.
.set TRANS -
.error
.cursor ypersonal 'M|aktzeile'          ? _(G|evtvar = "ybpvanlegen" & _G|evtvar = "ybaaanlegen")
.assign M|ybaaanlegen = G|false         ?   G|evtvar = "ybaaanlegen"
.assign M|ybspeichern = G|false         ?   G|evtvar = "ybspeichern"
.end 1
!EL074
!EL073
!FI070
.continue EL075 ? _(F|empty(M|yverantw))
.continue EL076 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
Zur Anlage eines Projektvorgangs muss der Verantwortliche bekannt sein.
Bitte den Verantwortlichen eintragen.
.set TRANS -
.error
.cursor yverantw 'M|aktzeile'           ? _(G|evtvar = "ybpvanlegen" & _G|evtvar = "ybaaanlegen")
.assign M|ybpvanlegen = G|false         ?   G|evtvar = "ybpvanlegen"
.assign M|ybaaanlegen = G|false         ?   G|evtvar = "ybaaanlegen"
.assign M|ybspeichern = G|false         ?   G|evtvar = "ybspeichern"
.end 1
!EL076
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL075
.continue EL077 ? _(('M|yadatum' = "") ; ('M|yedatum' = ""))
.continue EL078 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
Start- und Enddatum mÅssen gefÅllt sein.
Bitte eintragen.
.set TRANS -
.error
.cursor yadatum 'M|aktzeile'    ? F|empty(M|yadatum) & (_G|evtvar = "ybpvanlegen" & _G|evtvar = "ybaaanlegen")
.cursor yedatum 'M|aktzeile'    ? F|empty(M|yedatum) & (_G|evtvar = "ybpvanlegen" & _G|evtvar = "ybaaanlegen")
.assign M|ybpvanlegen = G|false         ?   G|evtvar = "ybpvanlegen"
.assign M|ybaaanlegen = G|false         ?   G|evtvar = "ybaaanlegen"
.assign M|ybspeichern = G|false         ?   G|evtvar = "ybspeichern"
.end 1
!EL078
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL077
.continue EL079 ? _(M|yedatum < M|yadatum)
.continue EL080 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
'M|yadatum' - 'M|yedatum' ist kein gÅltiger Zeitraum.
.set TRANS -
.error
.cursor yadatum 'M|aktzeile'
.assign M|ybpvanlegen = G|false         ?  G|evtvar = "ybpvanlegen"
.assign M|ybaaanlegen = G|false         ?  G|evtvar = "ybaaanlegen"
.assign M|ybspeichern = G|false         ?  G|evtvar = "ybspeichern"
.end 1
!EL080
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL079
.continue EL081 ? _((M|yprojekt^yprojekttyp^ypfvkpos) & (F|empty(M|yvorvp)))
.continue EL082 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
FÅr den Projekttyp "'M|yprojekt^yprojekttyp^namebspr'" ist die Auftragsposition ein Pflichtfeld.
.set TRANS -
.error
.copy M|ybpvanlegen = G|false   ?  G|evtvar = "ybpvanlegen"
.copy M|ybaaanlegen = G|false   ?  G|evtvar = "ybaaanlegen"
.copy M|ybspeichern = G|false   ?  G|evtvar = "ybspeichern"
.end 1
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL082
!EL081
.continue EL083 ? _((M|yprojekt^yprojekttyp^ypfgewerk) & (F|empty(M|yklassifizierung)))
.continue EL084 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
FÅr den Projekttyp "'M|yprojekt^yprojekttyp^namebspr'" ist das Gewerk ein Pflichtfeld.
.set TRANS -
.error
.copy M|ybpvanlegen = G|false   ?  G|evtvar = "ybpvanlegen"
.copy M|ybaaanlegen = G|false   ?  G|evtvar = "ybaaanlegen"
.copy M|ybspeichern = G|false   ?  G|evtvar = "ybspeichern"
.end 1
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL084
!EL083
.continue EL085 ? _((M|yprojekt^yprojekttyp^ypfvkartikel) & (F|empty(M|yvkartikel)))
.continue EL086 ? _(_(U|xbsetz))
.set TRANS +
.box Fehler
FÅr den Projekttyp "'M|yprojekt^yprojekttyp^namebspr'" ist die verkaufte Leistung ein Pflichtfeld.
.set TRANS -
.error
.copy M|ybpvanlegen = G|false   ?  G|evtvar = "ybpvanlegen"
.copy M|ybaaanlegen = G|false   ?  G|evtvar = "ybaaanlegen"
.copy M|ybspeichern = G|false   ?  G|evtvar = "ybspeichern"
.end 1
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL086
!EL085
.continue EL087 ? _((5|ybleistkat) & (((_(F|empty(M|yprojekt^yprojleistkatid))) & (_(M|yprojekt^yprojleistkatid = "(0,0,0)"))) ; (M|yprojekt^yprojekttyp^yprkaterf)))
.continue EL088 ? _(_(U|xbsetz))
.continue EL089 ? _((_(F|empty(M|yvkartikel))) ; (_(F|empty(M|yvkartikel))))
.continue EL090 ? _((_(F|empty(M|yprojekt^yprojleistkatid))) & (_(M|yprojekt^yprojleistkatid = "(0,0,0)")))
.continue EL091 ? _(_(F|empty(M|yvkartikel)))
.formula U|xtsel = "$,.id=" + M|yprojekt^yprojleistkatid
.formula U|xtsel = U|xtsel + ";yteil=" + M|yvkartikel^id
.formula U|xtsel = U|xtsel + ";yprjmprkatartk==PQ"
.formula U|xtsel = U|xtsel + ";@zeilen=(1)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group 'U|xydbgrprojleistkat' 'U|xtsel'
.continue EL092 ? _(_(G|mehr))
.set TRANS +
.box Fehler
Die Leistung 'M|yvkartikel^such' ist nicht im Leistungskatalog enthalten.
Leistung vor dem Speichern in Leistungskatalog aufnehmen oder aus Vorgang entfernen.
.set TRANS -
.error
.copy M|ybpvanlegen = G|false   ?  G|evtvar = "ybpvanlegen"
.copy M|ybaaanlegen = G|false   ?  G|evtvar = "ybaaanlegen"
.copy M|ybspeichern = G|false   ?  G|evtvar = "ybspeichern"
.end 1
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL092
!EL091
.continue EL093 ? _(_(F|empty(M|ymaschvkart)))
.formula U|xtsel = "$,.id=" + M|yprojekt^yprojleistkatid
.formula U|xtsel = U|xtsel + ";yteil=" + M|ymaschvkart^id
.formula U|xtsel = U|xtsel + ";yprjmprkatartk==ML"
.formula U|xtsel = U|xtsel + ";@zeilen=(1)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 1 group 'U|xydbgrprojleistkat' 'U|xtsel'
.continue EL094 ? _(_(G|mehr))
.set TRANS +
.box Fehler
Die Leistung 'M|ymaschvkart^such' ist nicht im Leistungskatalog enthalten.
Leistung vor dem Speichern in Leistungskatalog aufnehmen oder aus Vorgang entfernen.
.set TRANS -
.error
.copy M|ybpvanlegen = G|false   ?  G|evtvar = "ybpvanlegen"
.copy M|ybaaanlegen = G|false   ?  G|evtvar = "ybaaanlegen"
.copy M|ybspeichern = G|false   ?  G|evtvar = "ybspeichern"
.end 1
.copy U|xbpvok      = G|false
.copy U|xbaaok      = G|false
!EL094
!EL093
.continue FI090
!EL090
.set TRANS +
.box Fehler
FÅr den Projekttyp 'M|yprojekt^yprojekttyp^namebspr' ist der Leistungskatalog Pflicht,
es wurde jedoch noch kein Leistungskatalog angelegt.
.set TRANS -
.error
.copy M|ybpvanlegen = G|false   ?  G|evtvar = "ybpvanlegen"
.copy M|ybaaanlegen = G|false   ?  G|evtvar = "ybaaanlegen"
.copy M|ybspeichern = G|false   ?  G|evtvar = "ybspeichern"
.end 1
!FI090
!EL089
!EL088
!EL087
!EL066
.continue 'xprocst.xprocsp'
!PROC015: ----- checkPVAAanlegen -----
.copy M|ybaaanlegen = G|false           ? _M|yanlagevorbelk = "PVAA" & F|empty(M|yaufgabe)
.protection ybpvanlegen 'M|aktzeile'    ? _F|empty(M|ypvorgang)
.protection ybaaanlegen 'M|aktzeile'    ? _F|empty(M|yaufgabe)
.copy U|xbsetz = G|true
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET012" 
.continue PROC014
!RET012
.formula xprocsp = xprocsp - 1
.copy U|xb1 = M|ybpvanlegen
.copy U|xb2 = M|ybaaanlegen
.copy   M|ybpvanlegen = U|xbpvok
.copy   M|ybpvanlegen = G|true          ? _F|empty(M|ypvorgang)
.copy   M|ybaaanlegen = U|xbaaok        ?  M|yanlagevorbelk = "PVAA"
.copy   M|ybaaanlegen = G|true          ? _F|empty(M|yaufgabe)
.assign M|ystatusk    = "01"            ? (M|ybaaanlegen &  M|ybpvanlegen) & F|empty(M|ystatusk)
.assign M|ystatusk    = ""              ? _M|ybaaanlegen & _M|ybpvanlegen
.protection        ystatus 'M|aktzeile' ? _M|ybaaanlegen & _M|ybpvanlegen
.protection -RESET ystatus 'M|aktzeile' ?  M|ybaaanlegen ;  M|ybpvanlegen
.copy   M|ybspeichern = G|true          ?  _(U|xb1 = M|ybpvanlegen) ; _(U|xb2 = M|ybaaanlegen)
.continue 'xprocst.xprocsp'
!PROC016: ----- neue_Zeile -----
.copy U|xpproject = M|yprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"   ? _F|defined(F|rec(U|xystclosingvars, ypmtabpruefpv))
.continue EL095 ? _(((M|yprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefpv))) ; (((M|yprojekt^ystatusk = "ABS") ; (M|yprojekt^ystatusk = "08") ; (M|yprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefpv))))
.continue FI095
!EL095
.formula U|xtstatus     = M|ystatus
.formula U|xtverantw    = M|yverantw^id
.formula U|xtpersonal   = M|ypersonal^id
.formula U|xtkstelle    = M|ykstelle^id
.formula U|xtprojteam   = M|yprojteam^id
.formula U|xtleiart     = M|yleiart^id
.formula U|xtname       = M|yname
.formula U|xtid         = M|yvorvp^id
.formula U|xttppos      = M|ytppos^id
.formula U|xtkalkpos    = M|ykalkpos^id
.formula U|xrsumpvvpos  = M|ysumpvvpos
.formula U|xrdiffpvvpos = M|ydiffpvvpos
.formula U|xtklass      = M|yklassifizierung
.formula U|xtvkartikel  = M|yvkartikel^id
.formula U|xtmaschvkart = M|ymaschvkart^id
.formula U|xrpreis      = M|yvkartpreis
.formula U|xifarbe    = M|ytfarbe
.assign U|xdadatum   = M|yadatum
.assign U|xdedatum   = M|yedatum
.assign U|xdadataufg = M|yadatum
.assign U|xdedataufg = M|yedatum
.assign U|xdadatum   = M|yprojekt^yadatum         ?  F|empty(M|yadatum)
.assign U|xdedatum   = M|yprojekt^yedatum         ?  F|empty(M|yedatum)
.make screen line +O
.continue EL096 ? _(G|evtvar = "ybuprojteam")
.copy   M|ypersonal    = 8|ypersonal
.copy   M|yleiart      = 8|ypersonal^yprjmleiart
.assign M|yadatum      = U|xdadataufg
.assign M|yedatum      = U|xdedataufg
.copy   M|ybausprojtem = G|true
!EL096
.continue EL097 ? _(_(M|ybausprojtem))
.formula M|ypersonal        = U|xtpersonal
.formula M|ykstelle         = U|xtkstelle
.formula M|ykstelle         = M|ykkstelle               ?  F|empty(M|ykstelle)
.formula M|yprojteam        = U|xtprojteam
.formula M|yleiart          = U|xtleiart
.formula M|ysoll            = U|xrsoll
.formula M|yplan            = U|xrplan
.assign  M|yadatum          = U|xdadatum
.assign  M|yedatum          = U|xdedatum
!EL097
.formula M|yverantw         = U|xtverantw
.formula M|yname            = U|xtname
.formula M|yvorvp           = U|xtid
.formula M|yvornum          = M|yvorvp^kopf^nummer
.continue EL098 ? _(_(F|empty(M|yvorvp)))
.add M|yvorvp
.formula M|ypnum      = D|pnum
.copy    M|yvorart    = D|art
.formula M|yvortename = M|yvorart^namebspr
.formula M|yvormge    = D|mge
.formula M|yvorwert   = D|pwert                                                 ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk <> "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk <> "KOMP")) & D|pland =  G|inland
.formula M|yvorwert   = F|fxamount(G|inland,D|pwert,,D|pland,G|true)            ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk <> "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk <> "KOMP")) & D|pland <> G|inland
.formula M|yvorwert   = D|yprjmpeigenleist                                      ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk =  "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk =  "KOMP")) & D|pland =  G|inland
.formula M|yvorwert   = F|fxamount(G|inland,D|yprjmpeigenleist,,D|pland,G|true) ? ((5|ypmccverwenden & 5|ypmccvglwipaufwrtk =  "KOMP") ; (5|ypmpcverwenden & 5|ypmpcvglwipaufwrtk =  "KOMP")) & D|pland <> G|inland
.formula M|yvorwert   = D|pwert                                                 ?  _5|ypmccverwenden                                  & _5|ypmpcverwenden                                   & D|pland =  G|inland
.formula M|yvorwert   = F|fxamount(G|inland,D|pwert,,D|pland,G|true)            ?  _5|ypmccverwenden                                  & _5|ypmpcverwenden                                   & D|pland <> G|inland
.copy    M|yvorhe     = D|he
.formula M|yptext     = D|ptext
!EL098
.formula M|ytppos           = U|xttppos
.formula M|ykalkpos         = U|xtkalkpos
.formula M|ysumpvvpos       = U|xrsumpvvpos
.formula M|ydiffpvvpos      = U|xrdiffpvvpos
.formula M|yklassifizierung = U|xtklass
.formula M|yvkartikel       = U|xtvkartikel
.formula M|ymaschvkart      = U|xtmaschvkart
.formula M|yvkartpreis      = U|xrpreis
.formula M|ytfarbe          = U|xifarbe
.assign  M|yabteilung       = M|ypersonal^abtlg ? _F|empty(M|ypersonal)
.copy    M|ybnichtuebbuch   = 5|ybmaxsoll
.copy    M|ylsrelev         = M|yprojekt^yprojekttyp^ylsrelev
.copy    M|yvorbelleiort    = M|yprojekt^yvorbelleiort
.formula M|ybuzeile      = "icon:plus"
.formula M|ytbustorno    = "icon:minus"
.formula M|ytbuabschluss = "icon:replace"
.formula M|ybuprojteam   = "icon:arrow_blue_down_plus"  ? _F|empty(M|yprojteam)
.continue EL099 ? _((F|empty(M|ypersonal)) & (_(M|ybausprojtem)))
.copy   M|ypersonal = M|ykpersonal
.copy   M|yleiart   = M|ykpersonal^yprjmleiart
.assign M|yprojteam = ""                ? _F|empty(M|ykpersonal)
!EL099
.continue EL100 ? _((F|empty(M|yprojteam)) & (_(M|ybausprojtem)))
.assign M|ypersonal = ""                ? _F|empty(M|ykprojteam)
.copy   M|yprojteam = M|ykprojteam
!EL100
.copy   M|yverantw  = M|ykverantw       ?  F|empty(M|yverantw)
.copy   M|ytsperre  = G|true
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET013" 
.continue PROC015
!RET013
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET014" 
.continue PROC009
!RET014
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET015" 
.continue PROC010
!RET015
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET016" 
.continue PROC011
!RET016
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET017" 
