!PROC017: ----- Projektplan_anlegen -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ypmerllmaendfakt)
.formula U|xytaufrufernr = G|aufrufernr
.input "allpstart/GET.CALLERNO"
.formula U|xtsperrstempel = U|xytzeitstempel
.copy U|xbmehr = G|false
.copy U|xbpvok = G|false
.copy U|xbaaok = G|false
.select screen header
.select screen line
!LOOP016: ==============================
.continue ELOP016 ? _(G|mehr)
.continue EL101 ? _(M|ybspeichern)
.copy U|xbmehr = G|true
.copy U|xbpvok = G|true       ?  M|ybpvanlegen
.copy U|xbaaok = G|true       ?  M|ybaaanlegen
.assign U|xdadatum = M|yadatum  ?  M|yadatum < U|xdadatum ; F|empty(U|xdadatum)
.assign U|xdedatum = M|yedatum  ?  M|yedatum > U|xdedatum ; F|empty(U|xdedatum)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET018" 
.continue PROC014
!RET018
.formula xprocsp = xprocsp - 1
!EL101
.select screen line
.continue LOOP016
!ELOP016: ==============================
.continue EL102 ? _((U|xbmehr) & (U|xdadatum < G|datum))
.set trans +
.formula U|xtsel = "Hinweis"
.box -button yes:no -title 'U|xtsel'
Achtung, Termine liegen in der Vergangenheit!
Soll der Projektplan dennoch gespeichert werden?
.set trans -
.error
.end 1          ? _G|box = G|boxyes
!EL102
.continue EL103 ? _(U|xbmehr)
.copy U|xbrlsrelev = G|true
