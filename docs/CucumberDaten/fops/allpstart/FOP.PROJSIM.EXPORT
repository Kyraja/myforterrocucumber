..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : allpstart/FOP.PROJSIM.EXPORT
.. Date           : 20.08.2013
.. Version        : 1.0
.. Author         : ts
.. Copyright      : (c) 1990 - 2017 alltrotec GmbH
.. Functionality  : Export der ben”tigten Daten fr die Projektsimulation
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
..
.set trans -
..
..
..Projekt und Pfad mssen definiert sein
.continue       ? _F|defined(U|xtprsimpath)
.continue       ?  F|empty(U|xtprsimpath)
.continue       ? _F|defined(U|xtsimkenner)
.continue       ?  F|empty(U|xtsimkenner)
..
.type text xtedpoptions         ? _F|defined(U|xtedpoptions)
.type text xtprsimfile          ? _F|defined(U|xtprsimfile)
.type text xtfields             ? _F|defined(U|xtfields)
.type text selkrit              ? _F|defined(U|selkrit)
..
.input DATEI.F
..
.formula U|xtedpoptions = "-j SORT -t# -z';'"
..
..customers
.formula U|xtprsimfile = U|xtprsimpath + "Daten/KDSTAMM." + U|xtsimkenner
.formula U|xtfields    = "-f id,nummer,such,name"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 0:1.2 " + U|xtedpoptions + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..projects
.formula U|xtprsimfile = U|xtprsimpath + "Daten/PROJEKT." + U|xtsimkenner
.formula U|selkrit     = "-k 'yablage==0;ystatusk<>VOR;ystatusk<>GSP;ystatusk<>FTAB;ystatusk<>ABS;ystatusk<>08;@filingmode=(Active)'"
.formula U|xtfields    = "-f id,nummer,such,name,ykunde^id,yfortschritt,yprojleit^id,yprio,ystatusk,ystandort^id,ystdvertmindzeit"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 86:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..project tasks
.formula U|xtprsimfile = U|xtprsimpath + "Daten/PROJEKTVORGANG." + U|xtsimkenner
.formula U|selkrit     = "-k 'yablage==0;ystatusk<>04;ystatusk<>05;ystatusk<>07;ystatusk<>08;@filingmode=(Active)'"
.formula U|xtfields    = "-f id,nummer,such,name,yprojekt^id,ypersonal^id,yprojteam^id,yadatum,yedatum,ypvplanstd,yfortschritt,ystatusk,yrefid,yreftypk,yiststart,yistend,ysimrefdatfix,yistblatt,ygehoertzu^id,ybstdvert,ystdvertfunktk,ystandort^id,ystdvertmindzeit,yprio,ykstelle^id"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 149:2 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
...project tasks table
.formula U|xtprsimfile = U|xtprsimpath + "Daten/PROJEKTVERKN." + U|xtsimkenner
.formula U|selkrit     = "-k 'yablage==0;ystatusk<>04;ystatusk<>05;ystatusk<>07;ystatusk<>08;@filingmode=(Active)' -Z"
.formula U|xtfields    = "-f id,yvorgaenger^id,ybindungsartk,ypufferzeit,ypzeitgrank,yvgloperatork"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 149:2 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..work tasks
.formula U|xtprsimfile = U|xtprsimpath + "Daten/ARBEITSAUFGABE." + U|xtsimkenner
.formula U|selkrit     = "-k 'ystatusk<>04;ystatusk<>05;ystatusk<>07;ystatusk<>08;@filingmode=(Active)'"
.formula U|xtfields    = "-f id,nummer,such,name,ypvorgang^id,ypersonal^id,yprojteam^id,yadatum,ytatsterm,yedatum,yplanstd,ystatusk,ykstelle^id"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 149:3 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..AssignmentTimes
.formula U|xtprsimfile = U|xtprsimpath + "Daten/KAPAAUSWERT." + U|xtsimkenner
.formula U|selkrit     = "-k 'ybsim==0;@filingmode=(Active)'"
.formula U|xtfields    = "-f id,nummer,such,name,yprojekt^id,ypvorgang^id,yaufgabe^id,ypersonal^id,yprojteam^id,ydatum,ywert"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 154:2 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..staff
.formula U|xtprsimfile = U|xtprsimpath + "Daten/PERSONAL." + U|xtsimkenner
.formula U|selkrit     = "-k 'yprjminaktiv==0;yprjmpplanrelev==1;@filingmode=(Active)'"
.formula U|xtfields    = "-f id,nummer,such,name,yprjmkapazitaet,splan^id,kstelle^id,yprjmstandort^id"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 11:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..projectteam
.formula U|xtprsimfile = U|xtprsimpath + "Daten/PROJEKTTEAM." + U|xtsimkenner
.formula U|selkrit     = "-k 'yinaktiv==0;@filingmode=(Active)' -Z"
.formula U|xtfields    = "-f id,nummer,such,name,ypersonal^id,yzeitanteil"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 150:2 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..cost center
.formula U|xtprsimfile = U|xtprsimpath + "Daten/KOSTENSTELLE." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)'"
.formula U|xtfields    = "-f id,yprjmsplan^id,yprjmstandort^id"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 5:2 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..attribute assignment
.formula U|xtprsimfile = U|xtprsimpath + "Daten/EIGENSCHAFTSZUORDNUNG." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)'"
.formula U|xtfields    = "-f id,ypersonal^id,ykstelle^id,yvon,ybis,ysplan^id,ystandort^id"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 142:4 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..      ..WorkOrderSuggestion
..      .formula U|xtprsimfile = U|xtprsimpath + "Daten/FERTIGUNGSVORSCHLAG." + U|xtsimkenner
..      .formula U|selkrit     = "-k 'yprjmpvorgang<>\`;@filingmode=(Active)'"
..      .formula U|xtfields    = "-f id,tsterm,tterm,tfterm"
..      .system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 4:5 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..shift schedule
.formula U|xtprsimfile = U|xtprsimpath + "Daten/SCHICHTPLAN." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)' -Z"
.formula U|xtfields    = "-f id,nummer,such,name,schicht,tplan1^id,tplan2^id,tplan3^id,tplan4^id,tplan5^id,tplan6^id,tplan7^id"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 12:21 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..daily schedule
.formula U|xtprsimfile = U|xtprsimpath + "Daten/TAGESPLAN." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)'"
.formula U|xtfields    = "-f id,ranfzeit,rendzeit,sollzeit"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 12:20 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..daily schedule table
.formula U|xtprsimfile = U|xtprsimpath + "Daten/PAUSENPLAN." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)' -Z"
.formula U|xtfields    = "-f id,anfzeit,endzeit"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 12:20 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..calendar
.formula U|xtprsimfile = U|xtprsimpath + "Daten/KALENDER." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)'"
.formula U|xtfields    = "-f id,dispobezobj^id,uebkal^id,stdkal,gltvon,gltbis"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 137:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..weekdays
.formula U|xtprsimfile = U|xtprsimpath + "Daten/WOCHENTAGE." + U|xtsimkenner
.formula U|selkrit     = "-k '@filingmode=(Active)'"
.formula U|xtfields    = "-f id,arbtag1,arbtag2,arbtag3,arbtag4,arbtag5,arbtag6,arbtag7"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 137:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..working days
.formula U|xtprsimfile = U|xtprsimpath + "Daten/ARBEITSTAGE." + U|xtsimkenner
.formula U|selkrit     = "-k 'tarbtag==1;@filingmode=(Active)' -Z"
.formula U|xtfields    = "-f id,anf,end,per"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 137:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..holidays
.formula U|xtprsimfile = U|xtprsimpath + "Daten/FEIERTAGE." + U|xtsimkenner
.formula U|selkrit     = "-k 'tuebarbt==0;@filingmode=(Active)' -Z"
.formula U|xtfields    = "-f id,anf,end,per"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 137:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..Absence
.formula U|xtprsimfile = U|xtprsimpath + "Daten/ABWESENHEIT." + U|xtsimkenner
.formula U|selkrit     = "-k 'yfreigabek==GEN;yrfreigabek<>GEN;@filingmode=(Active)'"
.formula U|xtfields    = "-f id,ypersonal^id,yagenauk,yadatum,yazeit,yegenauk,yedatum,yezeit,ydauerd,ydauerh"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 148:3 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
..projectsuite configuration
.formula U|xtprsimfile = U|xtprsimpath + "Daten/KONFIGURATION." + U|xtsimkenner
.formula U|selkrit     = "-k 'nummer==0k'"
.formula U|xtfields    = "-f ynormkap,ystdvertmindzeit"
.system 'F|expr("edpexport.sh -p " + G|einmalpw + " -l 146:1 " + U|xtedpoptions + " " + U|selkrit + " " + U|xtfields + " >" + U|xtprsimfile)' BACKGROUND
..
.continue
