..!interpreter english declaration noabbrev
.. at 2016-08-22, 10:56
.set trans -
..========================================================================
..==  Name              : S.ENTRY.PRJM.EV
..==  Pfad              : allpstart
..==  Funktion          : EFOP an Finanz- und statistischer Buchung
..==                      Events an ProjectSuite Feldern
..==
..==  Erstellungsdatum  : 20.03.2014
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbgrwipkonfighist)
..====================================================
.type text    xtsel         ? _F|defined(U|xtsel)
.type text    xtid          ? _F|defined(U|xtid)
.type text    xtkonto       ? _F|defined(U|xtkonto)
.type text    xtid          ? _F|defined(U|xtid)
.type integer ximon         ? _F|defined(U|ximon)
.type real    xrbetrag      ? _F|defined(U|xrbetrag)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Leistungsart -----
.formula M|yprjmmge      = 0
.assign  M|yprjmkoreeinh = ""
.assign  M|konto         = ""
.continue EL001 ? _(_(F|empty(M|yprjmleiart)))
.continue EL002 ? _(F|empty(M|yprjmkstelle))
.set trans +
.box Hinweis
Bitte zuerst eine leistende Kostenstelle eintragen.
.set trans -
.assign M|yprjmleiart = ""
.continue FI002
!EL002
.copy M|yprjmkoreeinh = M|yprjmleiart^ykore
!FI002
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL003 ? _(G|evtkommd = G|kaktname13)
.protection yprjmkstelle 0
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.protection yprjmleiart   'M|aktzeile'
.protection yprjmvfv      'M|aktzeile'
.protection yprjmmge      'M|aktzeile'
.protection yprjmkoreeinh 'M|aktzeile'
.select screen line
.continue LOOP001
!ELOP001: ==============================
!EL003
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "buttonnach")
.continue BRK003 ? _(G|evtvar = "yprjmbuabs")
.continue EL004 ? _(G|evtkommd=G|kaktname14)
.continue EL005 ? _(F|empty(M|yprjmkstelle))
.set trans +
.box Hinweis
Bitte erst das Feld leistende Kostenstelle ausfllen.
.set trans -
.cursor yprjmkstelle 0
.continue FI005
!EL005
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL006 ? _((F|empty(M|yprjmleiart)) ; (F|empty(M|yprjmvfv)) ; (M|yprjmmge = 0))
.set trans +
.box Hinweis
Bitte fllen Sie folgende Felder aus
?       Leistungsart                    ?  F|empty(M|yprjmleiart)
?       Typ                             ?  F|empty(M|yprjmvfv)
?       Menge                           ?  M|yprjmmge = 0
.set trans -
.cursor yprjmmge    'M|aktzeile'        ?  M|yprjmmge = 0
.cursor yprjmvfv    'M|aktzeile'        ?  F|empty(M|yprjmvfv)
.cursor yprjmleiart 'M|aktzeile'        ?  F|empty(M|yprjmleiart)
.error (0)
.end 1
!EL006
.select screen line
.continue LOOP002
!ELOP002: ==============================
.select screen line 'M|tzeilen'
.formula U|xtkonto = M|yprjmleiart^yekoartf^id  ?  M|yprjmvfvk = "FI" ; M|yprjmvfvk = "VO"
.formula U|xtkonto = M|yprjmleiart^yekoartv^id  ?  M|yprjmvfvk = "VA"
.make screen line +O
.formula M|konto   = U|xtkonto
.copy    M|kstelle = M|yprjmkstelle
.protection yprjmleiart   'M|aktzeile'
.protection yprjmvfv      'M|aktzeile'
.protection yprjmmge      'M|aktzeile'
.protection yprjmkoreeinh 'M|aktzeile'
!FI005
.continue FI004
!EL004
.set trans +
.box Hinweis
Die Funktion steht nur bei "neu" zur Verfgung!
.set trans -
.cursor yprjmkstelle 0
!FI004
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK004 ? _(G|evtart = "feldfuell")
.continue BRK005 ? _(G|evtvar = "yprjmpvorgang")
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "yprjmarbpaket")
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK004
.continue BRK007 ? _(G|evtart = "feldaus")
.continue BRK008 ? _(G|evtvar = "projekt")
.continue EL007 ? _(F|empty(M|projekt))
.formula M|yprjmpvorgang = ""
.formula M|yprjmarbpaket = ""
.continue FI007
!EL007
.formula M|yprjmpvorgang = ""   ? _M|yprjmpvorgang^yprojekt^id = M|projekt^id
.formula M|yprjmarbpaket = ""   ? _M|yprjmarbpaket^yprojekt^id = M|projekt^id
!FI007
.protection -RESET yprjmarbpaket 'M|aktzeile'   ? F|empty(M|yprjmpvorgang)
.continue ESAC004
!BRK008
.continue BRK009 ? _(G|evtvar = "yprjmpvorgang")
.continue EL008 ? _(F|empty(M|yprjmpvorgang))
.protection -RESET yprjmarbpaket 'M|aktzeile'
.continue FI008
!EL008
.continue EL009 ? _(_(F|empty(M|yprjmpvorgang^yarbpaket)))
.copy M|yprjmarbpaket = M|yprjmpvorgang^yarbpaket
.protection yprjmarbpaket 'M|aktzeile'
!EL009
.copy M|projekt = M|yprjmpvorgang^yprojekt  ? F|modifiable(M|projekt)
!FI008
.continue ESAC004
!BRK009
.continue BRK010 ? _(G|evtvar = "yprjmarbpaket")
.copy M|projekt = M|yprjmarbpaket^yprojekt  ? F|modifiable(M|projekt) & _F|empty(M|yprjmarbpaket)
.continue ESAC004
!BRK010
.continue BRK011 ? _(G|evtvar = "yprjmmge")
.continue EL010 ? _((F|empty(M|yprjmleiart)) ; (F|empty(M|yprjmvfvk)))
.set trans +
.box Hinweis
Zuerst muss die Leistungsart und/oder Kennung fix/var/voll eingetragen werden.
.set trans -
.formula M|yprjmmge = 0
.continue FI010
!EL010
.continue EL011 ? _(F|empty(M|budat))
.set trans +
.box Hinweis
Bitte Buchungsdatum eintragen
.set trans -
.cursor budat 0
.continue FI011
!EL011
.continue EL012 ? _(((F|empty(M|yprjmleiart^ykoartf)) & ((M|yprjmvfvk = "VO") ; (M|yprjmvfvk = "FI"))) ; ((F|empty(M|yprjmleiart^ykoartv)) & (M|yprjmvfvk = "VA")) ; ((F|empty(M|yprjmleiart^ykoartv)) & (F|empty(M|yprjmleiart^ykoartv))))
.set trans +
.box Hinweis
Dieser Leistungsart ist noch kein statistisches Konto zugeordnet.
.set trans -
.continue FI012
!EL012
.assign M|konto = M|yprjmleiart^ykoartf^id  ?  M|yprjmvfvk = "VO" ; M|yprjmvfvk = "FI"
.assign M|konto = M|yprjmleiart^ykoartv^id  ?  M|yprjmvfvk = "VA"
.formula U|ximon = F|getfm(M|budat)
.load 0
.formula U|xtsel = "$,,ybkore=(Yes);ybstd=(No);ygjahr=" + 'M|gjahr' + ";ykstelle==" + M|yprjmkstelle^id + ";yleiart=" + M|yprjmleiart^id
.load 0 group "150:4" 'U|xtsel'
.continue EL013 ? _(_(G|mehr))
.formula xtsel = "$,,ybkore=(Yes);ybstd=(Yes);ygjahr=" + 'M|gjahr' + ";yleiart==" + M|yprjmleiart^id
.load 0 group "150:4" 'U|xtsel'
.continue EL014 ? _(G|mehr)
.cursor kstelle
.protection -RESET kstelle 'G|evtzeile'
!EL014
!EL013
.continue EL015 ? _(F|defined(0|id))
.load 0 line '0|selzeile'
.formula U|xrbetrag = 0|yvsf.U|ximon + 0|yvsv.U|ximon   ?  M|yprjmvfvk = "VO"
.formula U|xrbetrag = 0|yvsf.U|ximon                    ?  M|yprjmvfvk = "FI"
.formula U|xrbetrag = 0|yvsv.U|ximon                    ?  M|yprjmvfvk = "VA"
.formula U|xrbetrag = U|xrbetrag * M|yprjmmge
.formula M|betrag  = U|xrbetrag         ?  M|yprjmmge > 0
.formula M|hbetrag = U|xrbetrag * (-1)  ?  M|yprjmmge < 0
!EL015
.continue EL016 ? _((M|betrag  = 0) & (M|hbetrag = 0))
.set trans +
.box Hinweis
Es existiert kein Verrechnungssatz fr dieses Ger„t im
Bezugszeitraum oder der Verrechnungssatz ist kleiner
oder gleich 0,00 EUR.
.set trans -
!EL016
!FI012
!FI011
!FI010
.select screen line 'G|evtzeile'
.continue ESAC004
!BRK011
.continue BRK012 ? _(G|evtvar = "yprjmleiart")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK012
.continue BRK013 ? _(G|evtvar = "yprjmvfv")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK013
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.continue
