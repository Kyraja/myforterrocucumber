.protection ygehoertzu
.protection ykunde
.protection yprojleit
.protection yprojekttyp
.protection yvondatum
.protection ybisdatum
.protection ypersonal
.protection ykkstelle
.protection ykprojteam
.protection yverantw
.continue 'xprocst.xprocsp'
!PROC004: ----- Selektion_Schutz_aufheben -----
.protection -RESET yprojekt
