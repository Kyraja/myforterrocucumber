..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : DB.GR.NAME
..==  Pfad              : allpstart
..==  Funktion          : ermittelt den Name der Datenbank/-gruppe
..==  Erstellungsdatum  : 25.02.11
..==  Autor             : alltrotec GmbH/CP
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
.input DATEI.F
..====================================================
.type integer   xprocsp      ? _F|defined(xprocsp)
.type integer   xxi01 xxi02 xxi03
.type text      xtsys xthlp
..====================================================
.set demand -
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue EL001 ? _(_(G|evtkommd = G|kaktname10))
.load 0 group "12:26" 'F|expr("$,,typ==(Original);vdn==" + F|tostring(M|yerldb) + ";vgr==" + F|tostring(M|yerlgruppe) + ";@filingmode=(Active)")'
.continue EL002 ? _(mehr)
.formula M|ydbname = 0|vdntxt + ": " + 0|vgrtxtbspr
.continue FI002
!EL002
.set trans +
.formula M|ydbname = "Datenbank-Nummer/-Gruppe nicht definiert"
.set trans -
!FI002
!EL001
.continue
