..!interpreter english declaration noabbrev 
..*****************************************************************************
.. Name           : allpstart/IS.PRJM.BUSELECT.BA
.. Date           : 04.11.2016
.. Version        : 
.. Author         : ts
.. Copyright      : (c) 1990 - 2016 alltrotec GmbH
.. Functionality  : FÅllen von M|select und Merken der Selektion am Button ybuselect 
..                  - in xtsel kînnen zusÑtzliche Selektionskriterien Åbergeben werden,
..                    die bei einer neuen Selektion mit eingebaut werden
..                  - in xysel wird der Selektionsstring zusammengebaut
..                  - die Selektion wird nach M|select geschrieben
..                  - Die Selektionsfelder werden M|yselkritfelder geschrieben
..*****************************************************************************
..<VAR>
.type text xtsel    ? _F|defined(U|xtsel)
.type text xysel    ? _F|defined(U|xysel)
.type text xthint   ? _F|defined(U|xthint)
..</VAR>
..
.continue           ? _G|evtvar = "ybuselect"
..<META M|='P65:1' >
.continue ERROR2    ?  F|empty(M|grliste)
..
..new selection?
.continue NEWSEL    ?  F|empty(M|select) ; M|select = "!"
..
..existing selection
.select group 'M|grliste' 'M|select'
.formula U|xysel = "%," + (G|selrohl<<-1)   ? _F|empty(G|selrohl)
.formula U|xysel = "%,,"                    ?  F|empty(G|selrohl)
.formula U|xysel = U|xysel + M|yselkritfelder + ";@read=(No)"
.continue SELECT

!NEWSEL:
.formula U|xysel = "%,,nummer=;such=;sucherw~`;"    ?  F|empty(U|xtsel)
.formula U|xysel = U|xtsel                          ? _F|empty(U|xtsel)
.formula U|xysel = U|xysel +";@read=(No)"
.continue SELECT
..
..
!SELECT:
.select group 'M|grliste' 'U|xysel'
.continue SAVE     ? _F|empty(G|selrohl)
..leere Selektion
.formula M|select = "!"
.continue END
..
!SAVE:
.formula M|select         = "$" + (G|selrohl<<-1) + G|selkrit
.formula M|yselkritfelder = G|selkritfelder
.copy    M|ybselect = G|true
..
.formula U|xthint = (M|select>$",")<<"@"    ? M|select<>"$"
.continue HINT
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
.set trans +
..
!HINT: Show hint in status bar
.note Auswahl: 'U|xthint'
.continue END
..
!ERROR1: No record found!
.error Kein Datensatz gefunden!
.end 1
..
!ERROR2: No DB specified!
.error Keine Datenbank angegeben!
.end 1
..
.set trans -