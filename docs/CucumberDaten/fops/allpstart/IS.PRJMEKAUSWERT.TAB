.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EL001 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = H|yktr^id
.input 'U|xypmrepruefktrprog'
!EL001
.continue EL002 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL002
.continue EL003 ? _((U|xyberlaubt) ; ((_(U|xypmrepruefktr)) & (_(U|xypmrepruefind))))
.continue EL004 ? _((M|ybekbe) ; (M|ybekls) ; (M|ybekre))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt=="        + H|id
.formula U|xtsel = U|xtsel + ";kotyp==(PurchaseOrder)"          ?   M|ybekbe & _M|ybekls & _M|ybekre
.formula U|xtsel = U|xtsel + ";kotyp==(PackingSlip)"            ?  _M|ybekbe &  M|ybekls & _M|ybekre
.formula U|xtsel = U|xtsel + ";kotyp==(Invoice)"                ?  _M|ybekbe & _M|ybekls &  M|ybekre
.formula U|xtsel = U|xtsel + ";kopf^budat="      + M|yvonbudat:8 + "!" + M|ybisbudat:8  ? _F|empty(M|yvonbudat) ; _F|empty(M|ybisbudat)
.formula U|xtsel = U|xtsel + ";yprjmparbpaket==" + M|yarbpaket^id                       ? _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";alternativpos==(No)"
.formula U|xtsel = U|xtsel + ";@filingmode=" + 'M|yablageartk(L=":")'
.load 0 group "4:2" 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xtindex = 0|konto^nummer
.continue EL005 ? _((_(U|xbwipsel)) ; ((M|ybwiprelev) & (_(F|defined(U|xtsonstkost.xtindex))) & (_(F|defined(U|xtnrelkost.xtindex))) & (0|konto^gv)) ; ((M|ybsonstkost) & (F|defined(U|xtsonstkost.xtindex))) ; ((M|ybnichtwiprel) & ((F|defined(U|xtnrelkost.xtindex)) ; (_(0|konto^gv)))))
.continue EL006 ? _(((0|kotyp = G|ABKO) & (M|ybekbe)) ; ((0|kotyp = G|LIKO) & (M|ybekls)) ; ((0|kotyp = G|REKO) & (M|ybekre)))
.continue EL007 ? _((0|typ <> G|PRPOS) & (0|typ <> G|SUPOS) & (0|typ <> G|ZSPOS) & (0|typ <> G|ESPOS) & (0|typ <> G|STPOS) & (0|typ <> G|SIPOS) & (0|typ <> G|TRPOS))
'0|kotyp' # '0|id' # 'H|id' # 'H|such' # 'H|yverantwkst^nummer' # '0|yprjmparbpaket^id' # '0|yprjmparbpaket^such' # '0|yprjmppvorgang^yklassifizierung^id' # '0|yprjmppvorgang^yklassifizierung^such' # '0|yprjmppvorgang^id' #
!EL007
!EL006
!EL005
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
!EL004
.continue EL008 ? _(M|ybmatbu)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yvonprojekt=="  + H|id
.formula U|xtsel = U|xtsel + ";ytransaktion=`"          ? M|yablageartk = "(1)"
.formula U|xtsel = U|xtsel + ";ytransaktion<>`"         ? M|yablageartk = "(2)"
.formula U|xtsel = U|xtsel + ";ybudat="        +'M|yvonbudat' + "!" + 'M|ybisbudat'     ? _F|empty(M|yvonbudat) ; _F|empty(M|ybisbudat)
.formula U|xtsel = U|xtsel + ";@ablage=(1)"
.load 0 group 'U|xydbgrmatumbu' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
70 # '0|id' # 'H|id' # 'H|such' # 'H|yverantwkst^nummer' # '0|yvonarbpaket^id' # '0|yvonarbpaket^such' # '0|yvonpvorgang^yklassifizierung^id' # '0|yvonpvorgang^yklassifizierung^such' # '0|yvonpvorgang^id' #
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ynachprojekt=="  + H|id
.formula U|xtsel = U|xtsel + ";ytransaktion=`"          ? M|yablageartk = "(1)"
.formula U|xtsel = U|xtsel + ";ytransaktion<>`"         ? M|yablageartk = "(2)"
.formula U|xtsel = U|xtsel + ";ybudat="         +'M|yvonbudat' + "!" + 'M|ybisbudat'    ? _F|empty(M|yvonbudat) ; _F|empty(M|ybisbudat)
.formula U|xtsel = U|xtsel + ";@ablage=(1)"
.load 0 group 'U|xydbgrmatumbu' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
70 # '0|id' # 'H|id' # 'H|such' # 'H|yverantwkst^nummer' # '0|ynacharbpaket^id' # '0|ynacharbpaket^such' # '0|ynachpvorgang^yklassifizierung^id' # '0|ynachpvorgang^yklassifizierung^such' # '0|ynachpvorgang^id' #
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
!EL008
.continue EL009 ? _(F|sysinfo(18)^allpstd)
.continue EL010 ? _(M|ybvanf)
.continue EL011 ? _(F|empty(H|yteilprojektzu))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yteilprojekt=="  + H|id  ? _F|empty(H|yteilprojektzu)
.formula U|xtsel = U|xtsel + ";yhauptprojekt==" + H|id  ?  F|empty(H|yteilprojektzu)
.formula U|xtsel = U|xtsel + ";ytransaktion=`"          ?  M|yablageartk = "(1)"
.formula U|xtsel = U|xtsel + ";ytransaktion<>`"         ?  M|yablageartk = "(2)"
.formula U|xtsel = U|xtsel + ";ydatum="         +'M|yvonbudat' + "!" + 'M|ybisbudat'    ? _F|empty(M|yvonbudat) ; _F|empty(M|ybisbudat)
.formula U|xtsel = U|xtsel + ";@ablage=(1)"
.load 0 group 'U|xydbgrtpverrechanf' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
80 # '0|id' # 'H|id' # 'H|such' # 'H|yverantwkst^nummer' # '0|yarbpaket^id' # '0|yarbpaket^such' # '0|ypvorgang^yklassifizierung^id' # '0|ypvorgang^yklassifizierung^such' # '0|ypvorgang^id' #
.load 0 continue
.continue LOOP004
!ELOP004: ==============================
!EL011
!EL010
!EL009
!EL003
.input 'F|foppath("IFOP.IS.PRJMEKAUSWERT.TAB")'     ? F|fileexists(F|foppath("IFOP.IS.PRJMEKAUSWERT.TAB"))
.continue
