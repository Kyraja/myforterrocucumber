..!interpreter english declaration noabbrev
.. at 2017-03-07, 12:00
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.UP.YVERANTW.EV
..==  Pfad              : allpstart
..==  Funktion          : PrÅfung und MenÅ Feld Verantwortlicher im Projektmanagement
..==  Erstellungsdatum  : 10.06.2009
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
..====================================================
.type text    xtsel        ? _F|defined(U|xtsel)
.type integer xidb         ? _F|defined(U|xidb)
.type VP88    xpverantw    ? _F|defined(U|xpverantw)
.type bool    xbok         ? _F|defined(U|xbok)
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Selektion -----
.formula U|xtsel = "%,,nummer=;such=;name=;@.datei=" + 'U|xidb'
.formula U|xtsel = U|xtsel + ";@.gruppe=1.2.6.7"        ? U|xidb = 0
.formula U|xtsel = U|xtsel + ";@.gruppe=1.2"            ? U|xidb = 1
.formula U|xtsel = U|xtsel + ";@.gruppe=1"              ? U|xidb = 11
.assign U|xpverantw = U|xtsel
.continue EL001 ? _(G|mehr)
.formula G|evtfeldneu = U|xpverantw^id
.continue FI001
!EL001
.formula G|evtfeldneu = ""
.formula G|evtfeldneu = M|yverantw^id        ? F|defined(M|yverantw)
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- Auswahl_anzeigen -----
.continue EL002 ? _(((G|evtfeldneu = "0") ; (G|evtfeldneu / "0 *")) ; ((G|evtfeldneu = "1") ; (G|evtfeldneu / "1 *")) ; ((G|evtfeldneu = "11") ; (G|evtfeldneu / "11 *")))
.formula U|xtsel = G|evtfeldneu<<1
.assign U|xidb = 'U|xtsel'
.assign U|xidb =  11        ? _G|evtfeldneu<<1 = "0" ; _G|evtfeldneu<<1 = "1"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI002
!EL002
.set TRANS +
.menu(0,0) Verantwortlicher
Mitarbeiter                         >>.formula U|xidb = 11
Kunde/Kundensachbearbeiter          >>.formula U|xidb = 0
Lieferant/Lieferantensachbearbeiter >>.formula U|xidb = 1
.set TRANS -
.continue EL003 ? _(G|menue = 0)
.formula G|evtfeldneu = ""
.formula G|evtfeldneu = M|yverantw^id        ? F|defined(M|yverantw)
.continue FI003
!EL003
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!FI003
!FI002
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "feldfuell")
.continue EL004 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|regmatch(G|evtfeldneu, "\*.*"))) & (_(F|regmatch(G|evtfeldneu, "\$.*"))) & (_(F|regmatch(G|evtfeldneu, "\%.*"))))
.formula G|evtfeldneu = "?"     ? G|evtfeldneu = "!"
.continue EL005 ? _((G|evtfeldneu = "?") ; (G|evtfeldneu = "!"))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.continue FI005
!EL005
.assign U|xpverantw = G|evtfeldneu
.continue EL006 ? _(G|mehr)
.continue EL007 ? _((U|xpverantw^dnr = 0) ; (U|xpverantw^dnr = 1) ; (U|xpverantw^dnr = 11))
.assign G|evtfeldneu = U|xpverantw^id
.continue FI007
!EL007
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
!FI007
.continue FI006
!EL006
.copy U|xbok = G|false
.continue EL008 ? _(_(G|evtfeldneu / "* *"))
.formula U|xtsel = "$,,@numsuch=" + G|evtfeldneu
.select group "11:1" 'U|xtsel'
.continue EL009 ? _(G|mehr)
.formula U|xtsel = H|id
.select continue
.continue EL010 ? _(G|mehr)
.formula U|xtsel = "%,,@numsuch=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@autostart=ja;@.datei=11;@.gruppe=1"
.assign U|xpverantw = U|xtsel
.copy   U|xbok = G|mehr
.formula G|evtfeldneu = U|xpverantw^id       ? U|xbok
.continue FI010
!EL010
.formula G|evtfeldneu = U|xtsel
.copy    U|xbok       = G|true
!FI010
!EL009
!EL008
.continue EL011 ? _(_(U|xbok))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
!EL011
!FI006
!FI005
!EL004
.continue
.continue ESAC001
!BRK001
.continue
!ESAC001: =====   ENDCASE   =====
