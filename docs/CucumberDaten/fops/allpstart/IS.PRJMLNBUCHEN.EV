.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text  xtsel xtsys xtcmd xtedpdat xtedpout xtedpmsg xtedperr xtfarbe0 xtfarbe1 xtfarbe2 xtfarbe3
.type text  xykoobjekt
.type bool  xbdurchbuch xyberlaubt xbmehr
.type GD19  xdbis
.type integer   xprocsp ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- KST_Projekt -----
.continue EL001 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = H|yprojekt^yverantwkst
.input 'U|xypmrepruefkstprog'
.continue EL002 ? _(U|xyberlaubt)
.formula U|xbmehr = G|true
.continue FI002
!EL002
.formula U|xbmehr = G|false
!FI002
.continue FI001
!EL001
.formula U|xbmehr = G|true
!FI001
.continue EL003 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = H|yprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
!EL003
.continue EL004 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL004
.continue EL005 ? _((U|xypmrepruefind) ; (U|xypmrepruefktr))
.formular U|xbmehr = G|TRUE
!EL005
.continue 'xprocst.xprocsp'
!PROC002: ----- KST_Aufgabe -----
.continue EL006 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = H|yaufgabe^yktr
.input 'U|xypmrepruefkstprog'
.continue EL007 ? _(U|xyberlaubt)
.formula U|xbmehr = G|true
.continue FI007
!EL007
.formula U|xbmehr = G|false
!FI007
.continue FI006
!EL006
.formula U|xbmehr = G|true
!FI006
.continue EL008 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = H|yaufgabe^yktr^id
.input 'U|xypmrepruefktrprog'
!EL008
.continue EL009 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL009
.continue EL010 ? _((U|xypmrepruefind) ; (U|xypmrepruefktr))
.formular U|xbmehr = G|TRUE
!EL010
.continue 'xprocst.xprocsp'
!PROC003: ----- KST_Taetigkeitsschluessel -----
.continue EL011 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = H|ykstelle^id
.input 'U|xypmrepruefkstprog'
.continue EL012 ? _(U|xyberlaubt)
.formula U|xbmehr = G|true
.continue FI012
!EL012
.formula U|xbmehr = G|false
!FI012
.continue FI011
!EL011
.formula U|xbmehr = G|true
!FI011
.continue EL013 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = H|ykstelle^id
.input 'U|xypmrepruefktrprog'
!EL013
.continue EL014 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
!EL014
.continue EL015 ? _((U|xypmrepruefind) ; (U|xypmrepruefktr))
.formular U|xbmehr = G|TRUE
!EL015
.continue 'xprocst.xprocsp'
!PROC004: ----- Leistungsmeldungen_laden -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt="                 + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";yprojekt^yprojleit="       + M|yprojleit^id              ? _F|empty(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojekt^yprojverantw=="   + M|yprojverantw^id           ? _F|empty(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekt^yprojekttyp="     + M|yprojekttyp^id            ? _F|empty(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";yprojekt^ystatus="         + M|yprojstatus^id            ? _F|empty(M|yprojstatus)
.formula U|xtsel = U|xtsel + ";ykunde=="                  + M|ykunde^id
.formula U|xtsel = U|xtsel + ";ykunde2=="                 + M|ykunde2^id
.formula U|xtsel = U|xtsel + ";yaufgabe="                 + M|yaufgabe^id
.formula U|xtsel = U|xtsel + ";yadatum="                  +'M|ystdvondatum'+"!"
.formula U|xtsel = U|xtsel + ";yedatum=!"                 +'M|ystdbisdatum'
.formula U|xtsel = U|xtsel + ";ypersonal=="               + M|ypersonal^id
.formula U|xtsel = U|xtsel + ";yverantw=="                + M|yverantw^id
.formula U|xtsel = U|xtsel + ";ytransaktion=`"
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@ordnung=yadatum"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL016 ? _(G|mehr)
!REPT001: ==============================
.continue EL017 ? _(_(F|empty(H|yprojekt)))
.continue EL018 ? _(((H|yprojekt^yablage) & (_(M|ybproffen)) & (M|ybprabgeschlossen) & ((H|yprojekt^yabldat >= M|yvondatum) ; (F|empty(M|yvondatum))) & ((H|yprojekt^yabldat <= M|ybisdatum) ; (F|empty(M|ybisdatum)))) ; ((((H|yprojekt^yablage) & ((H|yprojekt^yabldat >= M|yvondatum) ; (F|empty(M|yvondatum))) & ((H|yprojekt^yabldat <= M|ybisdatum) ; (F|empty(M|ybisdatum)))) ; (_(H|yprojekt^yablage))) & (M|ybproffen) & (M|ybprabgeschlossen)) ; ((_(H|yprojekt^yablage)) & (M|ybproffen) & (_(M|ybprabgeschlossen))))
.continue EL019 ? _(M|yballekst)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI019
!EL019
.continue EL020 ? _(H|yprojekt^yverantwkst^id = U|xtkst.xtindex)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue FI020
!EL020
.formula U|xbmehr = G|FALSE
!FI020
!FI019
.continue FI018
!EL018
.fo U|xbmehr = G|FALSE
!FI018
!EL017
.continue EL021 ? _((F|empty(H|yprojekt)) & (_(F|empty(H|yaufgabe))))
.continue EL022 ? _(M|yballekst)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.continue FI022
!EL022
.continue EL023 ? _(H|yaufgabe^yktr^id = U|xtkst.xtindex)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
.continue FI023
!EL023
.formula U|xbmehr = G|FALSE
!FI023
!FI022
!EL021
.continue EL024 ? _((F|empty(H|yprojekt)) & (F|empty(H|yaufgabe)))
.continue EL025 ? _(M|yballekst)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC003
!RET005
.formula xprocsp = xprocsp - 1
.continue FI025
!EL025
.continue EL026 ? _(H|ykstelle^id = U|xtkst.xtindex)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC003
!RET006
.formula xprocsp = xprocsp - 1
.continue FI026
!EL026
.formula U|xbmehr = G|FALSE
!FI026
!FI025
!EL024
.continue EL027 ? _(U|xbmehr)
.make screen line +O
.copy   M|ytprojekt    = H|yprojekt
.copy   M|ytkunde      = H|ykunde
.copy   M|ytaufgabe    = H|yaufgabe
.assign M|ytlnnum      = H|id
.assign M|ytlnname     = H|namebspr
.copy   M|ytpersonal   = H|ypersonal
.copy   M|ytverantw    = H|yverantw
.copy   M|ytadatum     = H|yadatum
.copy   M|ytazeit      = H|yazeit
.copy   M|ytezeit      = H|yezeit
.copy   M|ytedatum     = H|yedatum
.assign M|ytarbzeit    = H|yarbzeit
.assign M|ytfaktzeit   = H|yfaktzeit
.copy   M|ytlsrelev    = H|ylsrelev
.copy   M|ytleiort     = H|yleiort
.copy   M|ytransaktion = H|ytransaktion
.continue EL028 ? _((F|empty(M|ytransaktion)) & (_((F|empty(M|ytadatum)) ; (F|empty(M|ytedatum)) ; ((M|ytarbzeit  = 0) & (M|ytfaktzeit = 0)))))
.copy M|ybbuchen = G|TRUE
.continue FI028
!EL028
.protection ybbuchen 'M|aktzeile'
!FI028
.colour -BACKGROUND 'U|xtfarbe0' 'M|aktzeile'
!EL027
.select continue
.continue REPT001 ? _(_(G|mehr))
.continue FI016
!EL016
.set TRANS +
.box Hinweis
Mit den eingegebenen Suchkriterien wurden keine Leistungsmeldungen gefunden.
.set TRANS -
.error
.end 1
!FI016
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula U|xbdurchbuch = G|FALSE
.formula U|xtfarbe0 = "-1 -1 -1"
.formula U|xtfarbe1 = "150 255 100"
.formula U|xtfarbe2 = "255 150 70"
.formula U|xtfarbe3 = "255 240 100"
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.formula U|xdvon        = "<M+1M-1Y"
.formula M|ystdvondatum = U|xdvon
.formula U|xdbis        = ">M"
.formula M|ystdbisdatum = U|xdbis
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldfuell")
.continue BRK003 ? _(G|evtvar = "yverantw")
.input 'U|xtupyverantw'
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK004 ? _(G|evtart = "feldaus")
.continue BRK005 ? _(G|evtvar = "ystdvondatum")
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "ystdbisdatum")
.continue EL029 ? _(M|ystdbisdatum < M|ystdvondatum)
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
!EL029
.cursor yvkauftrag 0      ? F|defined(M|yvkauftrag)
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "yaufgabe")
.copy    M|yprojekt  = M|yaufgabe^yprojekt
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "ybbuchen")
.continue EL030 ? _(U|xybistkost)
.continue EL031 ? _((_(F|empty(M|ytlnnum^ytransaktion))) & (M|ybbuchen))
.set TRANS +
.box Hinweis
Es existiert bereits eine Transaktion zu dieser Leistungsmeldung. Buchen nicht mehr m”glich.
.set TRANS -
!EL031
!EL030
.continue ESAC003
!BRK008
.input 'U|xtupprjmsel'
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK004
.continue BRK009 ? _(G|evtart = "buttonvor")
.continue BRK010 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC004
!BRK010
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK009
.continue BRK011 ? _(G|evtart = "buttonnach")
.continue BRK012 ? _(G|evtvar = "bstart")
.continue EL032 ? _(M|yballekst)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC004
!RET007
.formula xprocsp = xprocsp - 1
.continue FI032
!EL032
.input 'U|xtupkstarray'
.formula U|xtindex = ""
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xtindex)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC004
!RET008
.formula xprocsp = xprocsp - 1
.formula U|xtindex = F|nextelem(U|xtkst, xtindex)
.continue LOOP001
!ELOP001: ==============================
!FI032
.continue ESAC005
!BRK012
.continue BRK013 ? _(G|evtvar = "ybubuchen")
.continue EL033 ? _(U|xybistkost)
.continue EL034 ? _(U|xbdurchbuch)
.set TRANS +
.box -BUTTON yes:no -TITLE Achtung!
Sollen alle markierten Leistungsmeldungen gebucht werden?
.set TRANS -
.end 1         ? G|box = G|boxno
!EL034
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL035 ? _(M|ybbuchen)
.continue EL036 ? _(F|empty(M|ytlnnum^ytransaktion))
.load 9 object 'M|ytlnnum^id'
.input 'U|xtupbuchen'
.formula M|ytransaktion = M|ytlnnum^ytransaktion
.continue EL037 ? _(F|empty(M|ytransaktion))
.colour -BACKGROUND 'xtfarbe2' 'M|aktzeile'
.continue FI037
!EL037
.continue EL038 ? _(U|xbdurchbuch)
.file -TEMPNAME U|xtedpdat
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedpmsg
.file -TEMPNAME U|xtedperr
.output NEW 'U|xtedpdat'
.input DATEI.F
#!ACTION=VIEW
#!DATABASE='U|xydbtrans'
#!GROUP='U|xygrtrans'
#!EDP_LANGCODE='G|bsprache'

id;ybustapel;
'M|ytransaktion^id';;
.output NEW WERF.WEG
.formula U|xtsys = "edpimport.sh -c EKS -p " + G|einmalpw + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'xtsys' BACKGROUND
.continue EL039 ? _(M|ytransaktion^ybabl)
.colour -BACKGROUND 'xtfarbe1' 'M|aktzeile'
.continue FI039
!EL039
.colour -BACKGROUND 'xtfarbe3' 'M|aktzeile'
!FI039
.continue FI038
!EL038
.colour -BACKGROUND 'xtfarbe1' 'M|aktzeile'
!FI038
!FI037
!EL036
!EL035
.protection ybbuchen 'M|aktzeile'
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue FI033
!EL033
.set TRANS +
.box Fehler
Die stundenbasierte Leistungsverrechnung ist nicht aktiviert.
.set TRANS -
.error
.end 1
!FI033
.continue ESAC005
!BRK013
.continue BRK014 ? _(G|evtvar = "yballe")
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL040 ? _((F|empty(M|ytransaktion)) & (_((F|empty(M|ytadatum)) ; (F|empty(M|ytedatum)) ; ((M|ytarbzeit  = 0) & (M|ytfaktzeit = 0)))))
.formula M|ybbuchen = G|TRUE
.protection -RESET ybbuchen 'M|aktzeile'
.continue FI040
!EL040
.formula M|ybbuchen = G|FALSE
.protection ybbuchen 'M|aktzeile'
!FI040
.select screen line
.continue LOOP003
!ELOP003: ==============================
.continue ESAC005
!BRK014
.continue BRK015 ? _(G|evtvar = "ybkeine")
.select screen header
.select screen line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula M|ybbuchen = G|FALSE
.select screen line
.continue LOOP004
!ELOP004: ==============================
.continue ESAC005
!BRK015
!ESAC005: =====   ENDCASE   =====
.continue ESAC001
!BRK011
