..========================================================================
.input DATEI.F
..====================================================
.type integer   xprocsp     ? _F|defined(U|xprocsp)
.type bool      xybgltkenn  ? _F|defined(U|xybgltkenn)
.type text      xt01        ? _F|defined(U|xt01)
.type text      xytjkenn    ? _F|defined(U|xytjkenn)
..====================================================
.set demand -
.continue EPROCDEF
!PROC001: ----- tabelle -----
.load 2 line 'F|expr("$,,jkenn==" + U|xytjkenn)'
.copy U|xybgltkenn = G|mehr
.continue EL001 ? _((G|evtart = "feldaus") & (_(U|xybgltkenn)))
.set trans +
.box Fehler
Das gewÑhlte Kennzeichen ist nicht hinterlegt
oder fÅr Anlagenbuchhaltung reserviert!
.set trans -
.formula M|.G|evtvar = ""
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL002 ? _((F|empty(U|xytjkenn)) & (_(F|empty(G|evtvar))))
.formula U|xytjkenn = M|.G|evtvar
!EL002
.continue EL003 ? _(_(F|empty(U|xytjkenn)))
.copy U|xybgltkenn = G|true
.load 2 company "$,,@gruppe=7"
.continue BRK001 ? _(G|evtmaske = 715)
.continue EL004 ? _(_(U|xytjkenn = 2|jdikenn))
.continue EL005 ? _(_(U|xytjkenn = 2|jekkenn))
.continue EL006 ? _(_(U|xytjkenn = 2|jvkkenn))
.continue EL007 ? _(_(U|xytjkenn = 2|jstkenn))
.continue EL008 ? _(_(U|xytjkenn = 2|jilkenn))
.continue EL009 ? _(_(U|xytjkenn = 2|jcakenn))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!EL009
!EL008
!EL007
!EL006
!EL005
!EL004
.continue ESAC001
!BRK001
.continue EL010 ? _((_(U|xytjkenn = 2|jdikenn)) & (_(U|xytjkenn = 2|jekkenn)) & (_(U|xytjkenn = 2|jvkkenn)) & (_(U|xytjkenn = 2|jstkenn)) & (_(U|xytjkenn = 2|jilkenn)) & (_(U|xytjkenn = 2|jcakenn)) & (_(U|xytjkenn = 2|jkzu)) & (_(U|xytjkenn = 2|jkafa)) & (_(U|xytjkenn = 2|jkahkab)) & (_(U|xytjkenn = 2|jkafaab)) & (_(U|xytjkenn = 2|jkahkum)) & (_(U|xytjkenn = 2|jkafaum)) & (_(U|xytjkenn = 2|jkzusch)) & (_(U|xytjkenn = 2|jkteilw)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL010
!ESAC001: =====   ENDCASE   =====
!EL003
.continue
