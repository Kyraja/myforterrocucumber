..!interpreter english noabbrev         
..*****************************************************************************
.. FOP-Name    : FOP.PRJM.UP.VERW
.. Date        : 18.11.2014
.. Author      : Thomas Saalborn, alltrotec GmbH
.. Copyright   : (c) 1990 - 2014 alltrotec GmbH
.. Function    : Verwendung laut Konfiguration fllen
..*****************************************************************************
.set trans -
..
.type text     xtverw       ? _F|defined(U|xtverw)
.type text     xtPRNR       ? _F|defined(U|xtPRNR)
.type text     xtPRNPVN     ? _F|defined(U|xtPRNPVN)
.type text     xtPRSUCH     ? _F|defined(U|xtPRSUCH)
.type text     xtPRSPVN     ? _F|defined(U|xtPRSPVN)
.type text     xtVAUPOS     ? _F|defined(U|xtVAUPOS)
.type P86:1    xpprojekt    ? _F|defined(U|xpprojekt)
.type P149:2   xppvorgang   ? _F|defined(U|xppvorgang)
.type AZK28057 xyazkverw    ? _F|defined(U|xyazkverw)
..
.formula U|xtPRNR   = "PRNR"
.formula U|xtPRNPVN = "PRNPVN"
.formula U|xtPRSUCH = "PRSUCH"
.formula U|xtPRSPVN = "PRSPVN"
.formula U|xtVAUPOS = "VAUPOS"
..
..!meta 5|=P146:1
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|yverwbvuv)
..
..mit Standardwert fllen wenn leer, sonst nehen was bergeben wird (z.B. aus FOP.40.PRJM.EV - Fertigung))
.assign  U|xyazkverw = 5|yverwbvuvk         ?  F|empty(U|xyazkverw)
.formula U|xtverw    = ""
..
..Projekt oder Projektorgang muss gefllt sein
.continue END   ? F|empty(U|xpprojekt) & F|empty(U|xppvorgang)
..
..wenn Projekt leer,dann aus Projektvorgang
.copy U|xpprojekt = U|xppvorgang^yprojekt   ? F|empty(U|xpprojekt)
..
..Wenn EDP und in Konfig Nachfragen eingestellt ist, dann abbrechen
.continue END   ?  U|xyazkverw = "RF" & G|edp
..
..
.continue VERW  ? _U|xyazkverw = "RF"
..
..Men mit Auswahl
.set trans +
..
.menu (0,0,0) Verwendung vorbelegen
Verwendung nicht vorbelegen             >>.formula U|xtverw = ""
?Projektnummer                           >>.formula U|xyazkverw = U|xtPRNR    ? _F|empty(U|xpprojekt)
?Projektnummer_Projektvorgangsnummer     >>.formula U|xyazkverw = U|xtPRNPVN  ? _F|empty(U|xpprojekt) & _F|empty(U|xppvorgang)
?Projektsuchwort                         >>.formula U|xyazkverw = U|xtPRSUCH  ? _F|empty(U|xpprojekt)
?Projektsuchwort_Projektvorgangsnummer   >>.formula U|xyazkverw = U|xtPRSPVN  ? _F|empty(U|xpprojekt) & _F|empty(U|xppvorgang)
?Verwendung der Auftragsposition         >>.formula U|xyazkverw = U|xtVAUPOS  ? _F|empty(U|xppvorgang^yvorpos)
..
.set trans -
..
!VERW:
.continue VAUPOS    ? U|xyazkverw = "VAUPOS"
.formula U|xtverw = U|xpprojekt^nummer                               ? U|xyazkverw = "PRNR"
.formula U|xtverw = U|xpprojekt^nummer + "_" + U|xppvorgang^nummer   ? U|xyazkverw = "PRNPVN"
.formula U|xtverw = U|xpprojekt^such                                 ? U|xyazkverw = "PRSUCH"
.formula U|xtverw = U|xpprojekt^such   + "_" + U|xppvorgang^nummer   ? U|xyazkverw = "PRSPVN"
.continue END
..
!VAUPOS:VK AUftragsposition (nur in FV)
.continue END       ?  F|empty(U|xppvorgang^yvorpos)
.load 9 group "P3:2" 'U|xppvorgang^yvorpos'
.continue END       ? _G|mehr
.formula U|xtverw = 9|verw
.load 9
.continue END
..
!END:
.continue
