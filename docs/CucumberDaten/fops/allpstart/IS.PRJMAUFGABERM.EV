!PROC015: ----- Tabelle_aktualisieren -----
.formula U|xrarbzeit   = 0
.formula U|xrfaktzeit  = 0
.formula U|xrmaschzeit = 0
.formula U|xiaazeile   = 0
.formula U|xtsel = ""
.formula U|xtsel = "$,,yadatum=="  + U|xdadatum:8   ?  M|ybtagessicht
.formula U|xtsel = "$,,yaufgabe==" + U|xtaufgabe    ? _M|ybtagessicht & _F|empty(U|xtaufgabe)
.continue EL082 ? _(_(F|empty(U|xtsel)))
.select screen line 'U|xtsel'
