.protection yuebernachtwaehr  'M|aktzeile'
.protection ybabrechfrei      'M|aktzeile'
.protection yabrechfreibz     'M|aktzeile'
.continue ESAC001
!BRK001
.continue EL027 ? _((F|empty(M|yadatum)) & (F|empty(M|yedatum)))
.protection yaaname   'M|aktzeile'
.protection yname     'M|aktzeile'
.protection ykstelle  'M|aktzeile'
