..!interpreter english declaration noabbrev
.. at 2017-03-20, 17:15
.set trans -
..========================================================================
..==  Name              : IS.PRJMAUFGABERM.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 20.01.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/CL.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtdatei xtftext xtaaftext xtzfarbe xtfehler
.type text    xtfarbesumme xtaafarbe xyfarbetzeit xtlmfarbe1 xtlmfarbe2 xtsumfarbe1 xtsumfarbe2
.type text    xtkdnum xtkdmerk  xtkdsuch xtprojnum xtprojsuch xtid xtsumme
.type text    xtleistmeld xtkstelle xtprojekt xtpvorgang xtaufgabe xttaetschl xtkunde xtkunde2 xtindex xytpuffer
.type text    xtwtag1 xtwtag2 xtwtag3 xtwtag4 xtwtag5 xtwtag6 xtwtag7
.type real    xrarbzeit xrfaktzeit xrmaschzeit xrplan xrsoll xrrest xrtechfort
.type real    xrsz1 xrsz2 xrsz3 xrsz4 xrsz5 xrsz6 xrsz7
.type GD      xdadatum xdedatum xdatum
.type GW4     xw1 xwsumme
.type time    xzeit
.type integer xiaazeile xilmzeile xiaktzeile xistufe xitag
.type bool    xbok xbmehr xbgemein xbsave xbtzeit xbistzeit
.type VP26    xpkalbezugsobj xpzuordkbo xpaktkbo
.type P39:2   xplgruppe      xpzuordlg  xpaktlg
.type P149:3  xpaufgabe
.set TRANS +
.formula U|xtwtag1 = "Mo"
.formula U|xtwtag2 = "Di"
.formula U|xtwtag3 = "Mi"
.formula U|xtwtag4 = "Do"
.formula U|xtwtag5 = "Fr"
.formula U|xtwtag6 = "Sa"
.formula U|xtwtag7 = "So"
.set TRANS -
.translate -language 'G|bsprache' -text 'U|xtwtag1' -variable U|xtwtag1
.translate -language 'G|bsprache' -text 'U|xtwtag2' -variable U|xtwtag2
.translate -language 'G|bsprache' -text 'U|xtwtag3' -variable U|xtwtag3
.translate -language 'G|bsprache' -text 'U|xtwtag4' -variable U|xtwtag4
.translate -language 'G|bsprache' -text 'U|xtwtag5' -variable U|xtwtag5
.translate -language 'G|bsprache' -text 'U|xtwtag6' -variable U|xtwtag6
.translate -language 'G|bsprache' -text 'U|xtwtag7' -variable U|xtwtag7
.type integer xyred xygreen xyblue xyhue
.type realx   xysat xyval
.type bool    xybrgb2hsv xybhsv2rgb
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Summe_Stunden -----
.formula M|ysummetag   = 0
.formula M|ysummewoche = 0
.formula M|ysummemonat = 0
.continue EL001 ? _(_(F|empty(M|yselpersonal)))
.formula U|xwsumme  =   M|ysummedatum
.formula U|xdadatum = ('M|ysummedatum:8'<<6) + "01"
.formula U|xdedatum =   U|xdadatum + 31
.formula U|xdedatum = ('U|xdedatum:8')<<6 + "01"
.formula U|xdedatum =   U|xdedatum - 1
.formula U|xdadatum =   U|xdadatum - 7
.formula U|xdedatum =   U|xdedatum + 7
.formula U|xtsel = "$,,ypersonal==" + M|yselpersonal^id + ";yadatum=" + U|xdadatum:8 + "!" + U|xdedatum:8 + ";ytaetschl^yabwesend==0;@filingmode=(Active)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xw1         = H|yadatum
.formula M|ysummetag   = M|ysummetag   + H|yarbzeit     ?   H|yadatum =   M|ysummedatum
.formula M|ysummewoche = M|ysummewoche + H|yarbzeit     ?  'U|xw1'    =  'U|xwsumme'
.formula M|ysummemonat = M|ysummemonat + H|yarbzeit     ? ('H|yadatum:8')<<6 = ('M|ysummedatum:8')<<6
.select continue
.continue LOOP001
!ELOP001: ==============================
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Summe_SollStunden -----
.formula M|ysollstdtag   = 0
.formula M|ysollstdwoche = 0
.formula M|ysollstdmonat = 0
.continue EL002 ? _(_(F|empty(M|yselpersonal)))
.load 9 add M|yselpersonal
.input "java:de.alltrotec.ps.control.StaffWorkDays@ALLPS"
.formula U|xtindex = F|nextelem(U|xbwd, xtindex)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xtindex)))
.continue EL003 ? _(U|xbwd.xtindex)
.formula U|xdatum        = U|xtindex
.formula U|xitag         = U|xdatum//7
.formula U|xw1           = U|xdatum
.formula M|ysollstdtag   = M|ysollstdtag   + U|xrtt.xtindex ?  U|xdatum = M|ysummedatum
.formula M|ysollstdwoche = M|ysollstdwoche + U|xrtt.xtindex ? 'U|xw1'    =  'U|xwsumme'
.formula M|ysollstdmonat = M|ysollstdmonat + U|xrtt.xtindex ?  F|month(U|xdatum) = F|month(M|ysummedatum)
!EL003
.formula U|xtindex = F|nextelem(U|xbwd, xtindex)
.continue LOOP002
!ELOP002: ==============================
!EL002
.continue 'xprocst.xprocsp'
!PROC003: ----- Selektion_Schutz -----
.assign M|yselpersonal = ""
.assign M|yselverantw  = ""
.assign M|yselkunde    = ""
.assign M|yselkunde2   = ""
.assign M|yselprojekt  = ""
.assign M|yseltaetschl = ""
.assign M|ysellnadatum = ""
.assign M|ysellnedatum = ""
.assign M|yselaaadatum = ""
.assign M|yselaaedatum = ""
.continue 'xprocst.xprocsp'
!PROC004: ----- SelDefault -----
.formula U|xtsel = U|xtsel + ";ykunde="    + M|yselkunde^id         ? _F|empty(M|yselkunde)
.formula U|xtsel = U|xtsel + ";ykunde2="   + M|yselkunde2^id        ? _F|empty(M|yselkunde2)
.formula U|xtsel = U|xtsel + ";yprojekt="  + M|yselprojekt^id       ? _F|empty(M|yselprojekt)
.formula U|xtsel = U|xtsel + ";yverantw="  + M|yselverantw^id       ? _F|empty(M|yselverantw)
.formula U|xtsel = U|xtsel + ";ystatusk==" + M|yselstatusk^id       ?  M|yselbstatus
.formula U|xtsel = U|xtsel + ";ystatus^katego<=" + M|yselstatusk    ? _M|yselbstatus
.formula U|xtsel = U|xtsel + ";ytaetschl=" + M|yseltaetschl^id      ? _F|empty(M|yseltaetschl)
.formula U|xtsel = U|xtsel + ";yadatum<="  + M|yselaaedatum:8       ? _F|empty(M|yselaaedatum)
.formula U|xtsel = U|xtsel + ";yedatum>="  + M|yselaaadatum:8       ? _F|empty(M|yselaaadatum)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.continue 'xprocst.xprocsp'
!PROC005: ----- Pruefung_Aufgabe -----
.copy   U|xbok     = G|false
.assign U|xtfehler = ""
.continue EL004 ? _(F|empty(M|yaufgabe))
.set TRANS +
.formula U|xtfehler = "Es ist keine Aufgabe eingetragen."
.set TRANS -
.continue FI004
!EL004
.add M|yaufgabe
.continue EL005 ? _(G|mehr)
.continue EL006 ? _((D|ystatusk = "") ; (D|ystatusk = "01") ; (D|ystatusk = "02") ; (D|ystatusk = "03"))
.continue EL007 ? _(((D|yprojekt^ystatusk = "AKT") ; (D|yprojekt^ystatusk = "")) & (_(D|yprojekt^yablage)))
.copy U|xbok = G|true
.continue FI007
!EL007
.set TRANS +
.formula U|xtfehler = "Das Projekt hat den Status " + G|dblquote + 'D|yprojekt^ystatus' + G|dblquote + "."
.set TRANS -
!FI007
.continue FI006
!EL006
.set TRANS +
.formula U|xtfehler = "Die Aufgabe hat den Status " + G|dblquote + 'D|ystatus' + G|dblquote + "."
.set TRANS -
!FI006
.add
.continue FI005
!EL005
.set TRANS +
.formula U|xtfehler = "Die Aufgabe kann nicht geladen werden."
.set TRANS -
!FI005
!FI004
.continue 'xprocst.xprocsp'
!PROC006: ----- Schutz_Alles -----
.protection yaaname      'M|aktzeile'
.protection yname        'M|aktzeile'
.protection yadatum      'M|aktzeile'
.protection yedatum      'M|aktzeile'
.protection yazeit       'M|aktzeile'
.protection yezeit       'M|aktzeile'
.protection ystatus      'M|aktzeile'   ?  F|empty(M|yaufgabe) ; _F|empty(M|yleistmeld^yabrechnung) ; _F|empty(M|yleistmeld^ylsnum) ; _F|empty(M|yleistmeld^yrenum) ; M|yarchiv ; M|tbaumstufe > 1
.protection yrestzeit    'M|aktzeile'
.protection ytechfort    'M|aktzeile'
.protection yaaedatum    'M|aktzeile'
.protection yleiort      'M|aktzeile'
.protection yarbzeit     'M|aktzeile'
.protection yfaktzeit    'M|aktzeile'   ?  F|empty(M|yleistmeld) ; _F|empty(M|yleistmeld^yabrechnung) ; _F|empty(M|yleistmeld^ylsnum) ; _F|empty(M|yleistmeld^yrenum) ; M|yarchiv
.protection ylsrelev     'M|aktzeile'   ?  F|empty(M|yleistmeld) ; _F|empty(M|yleistmeld^yabrechnung) ; _F|empty(M|yleistmeld^ylsnum) ; _F|empty(M|yleistmeld^yrenum) ; M|yarchiv
.protection yarchiv      'M|aktzeile'   ?  F|empty(M|yleistmeld) ; _F|empty(M|yleistmeld^yabrechnung) ; _F|empty(M|yleistmeld^ylsnum) ; _F|empty(M|yleistmeld^yrenum) ; M|yarchiv ; M|ylsrelev
.protection ybustst      'M|aktzeile'
.protection yeingeplant  'M|aktzeile'
.protection ybutzeit     'M|aktzeile'   ?  M|tbaumstufe = 3
.protection yaufgabe     'M|aktzeile'
.protection ytaetschl    'M|aktzeile'
.protection ykstelle     'M|aktzeile'
.protection ykunde       'M|aktzeile'
.protection ykunde2      'M|aktzeile'
.protection ynachtrag    'M|aktzeile'
.protection ynachtragbeh 'M|aktzeile'
.protection ynachtragbem 'M|aktzeile'
.protection ybueberstunden 'M|aktzeile'
.continue EL008 ? _((M|tbaumstufe = 2) & (M|yleistmeld^ozeilen > 0))
.formula M|ybutzeit  = "icon:information"
!EL008
.continue EL009 ? _(U|xybistkost)
.continue EL010 ? _(M|tbaumstufe = 1)
.protection ybbuchen 'M|aktzeile'
.continue FI010
!EL010
.continue EL011 ? _((F|empty(M|yleistmeld^ytransaktion)) & (_(M|ybbuchen)))
.continue EL012 ? _((F|empty(M|yadatum)) ; (F|empty(M|yedatum)) ; (F|empty(M|ypersonal)))
.protection ybbuchen 'M|aktzeile'
.continue FI012
!EL012
.protection -RESET ybbuchen 'M|aktzeile'
!FI012
.continue FI011
!EL011
.cop M|ybbuchen = G|true
.protection ybbuchen 'M|aktzeile'       ? _F|empty(M|yleistmeld^ytransaktion)
!FI011
!FI010
.continue FI009
!EL009
.protection ybbuchen    'M|aktzeile'
!FI009
.continue EL013 ? _(_(F|defined(U|xbiserllmaendfakt)))
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(ypmerllmaendfakt)
.type bool xbiserllmaendfakt
.copy U|xbiserllmaendfakt = G|true
.continue EL014 ? _((_(F|empty(5|ypmerllmaendfakt))) & (F|sysinfo(18)^allppro))
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"
.copy U|xbiserllmaendfakt  = F|defined(F|map(U|xypermissions, '5|ypmerllmaendfakt^id'))
!EL014
!EL013
.continue EL015 ? _(_(U|xbiserllmaendfakt))
.protection ylsrelev  'M|aktzeile'
.protection yfaktzeit 'M|aktzeile'
!EL015
.continue 'xprocst.xprocsp'
!PROC007: ----- Schutz -----
.continue EL016 ? _(U|xybistkost)
.continue EL017 ? _(M|tbaumstufe = 1)
.protection ybbuchen 'M|aktzeile'
.continue FI017
!EL017
.continue EL018 ? _((F|empty(M|yleistmeld^ytransaktion)) & (_(M|ybbuchen)))
.continue EL019 ? _((F|empty(M|yadatum)) ; (F|empty(M|yedatum)) ; (F|empty(M|ypersonal)))
.protection ybbuchen 'M|aktzeile'
.continue FI019
!EL019
.protection -RESET ybbuchen 'M|aktzeile'
!FI019
.continue FI018
!EL018
.formula M|ybbuchen = G|true
.protection ybbuchen 'M|aktzeile'   ? _F|empty(M|yleistmeld^ytransaktion)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC006
!RET001
.formula xprocsp = xprocsp - 1
!FI018
!FI017
.continue FI016
!EL016
.protection ybbuchen 'M|aktzeile'
!FI016
.continue EL020 ? _(_(M|ybbuchen))
.copy U|xbok = G|true
.continue EL021 ? _(M|tbaumstufe = 3)
.copy U|xbok = G|false  ? _F|empty(M|yleistmeld^ylsposid)
.copy U|xbok = G|false  ? _F|empty(M|yleistmeld^yreposid)
.copy U|xbok = G|false  ? _F|empty(M|yleistmeld^yabrechnung)
.copy U|xbok = G|false  ? _F|empty(M|yleistmeld^ystornolm)
.copy U|xbok = G|false  ? _F|empty(M|yleistmeld^ysstornodurch)
.copy U|xbok = G|false  ?  M|yarchiv
.continue FI021
!EL021
.copy U|xbok = G|false  ? _F|empty(M|ylsposvp)
.copy U|xbok = G|false  ? _F|empty(M|yreposvp)
.copy U|xbok = G|false  ? _F|empty(M|yabrechnung)
.copy U|xbok = G|false  ? _F|empty(M|ystornolm)
.copy U|xbok = G|false  ? _F|empty(M|ysstornodurch)
.copy U|xbok = G|false  ?  M|yarchiv
!FI021
.continue EL022 ? _(_(F|empty(M|yleistmeld)))
.continue EL023 ? _(F|empty(M|yselpersonal))
.copy U|xbok = G|false  ? _G|passw^passmitarb^id = M|yleistmeld^ypersonal^id
.continue FI023
!EL023
.copy U|xbok = G|false  ? _M|yselpersonal^id = M|yleistmeld^ypersonal^id
!FI023
!EL022
.continue EL024 ? _(U|xbok)
.continue EL025 ? _((_(F|empty(M|yaufgabe))) ; (F|empty(M|ytaetschl)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC005
!RET002
.formula xprocsp = xprocsp - 1
.continue FI025
!EL025
.copy U|xbok = G|true
!FI025
.continue EL026 ? _((U|xbok) ; ((F|empty(M|yaufgabe)) & ((M|tbaumstufe = 2) ; (M|tbaumstufe = 3))))
.continue BRK001 ? _(M|tbaumstufe = 1)
