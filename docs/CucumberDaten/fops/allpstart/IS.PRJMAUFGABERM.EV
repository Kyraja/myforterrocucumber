.copy U|xbok = G|true
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" +  M|ypersonal^id
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'F|month(M|yadatum)'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|yadatum)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@zeilen=(0)"
.load 9 group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL029 ? _(G|mehr)
.continue EL030 ? _(_(9|ybgesabschluss))
.continue EL031 ? _(F|sysinfo(10)^ykonfigprjm^yartstdfreigabek = "KST")
