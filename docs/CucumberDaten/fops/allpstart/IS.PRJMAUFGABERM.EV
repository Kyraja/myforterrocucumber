.formula M|ytechfort    = M|yaufgabe^yiststd / M|yaufgabe^yforecaststd * 100    ?  M|yaufgabe^yforecaststd >  0 & M|yaufgabe^yiststd >  0
.formula M|ytechfort    = 0                                                     ?  M|yaufgabe^yforecaststd <= 0 ; M|yaufgabe^yiststd <= 0
.formula M|ytechfort    = 100                                                   ?  M|ytechfort      > 100
.formula M|ytechfort    = 99                                                    ?  M|ytechfort      = 100 & M|yaufgabe^yiststd < M|yaufgabe^yforecaststd
.formula M|yadatum      = 0|yadatum
.formula M|yedatum      = 0|yedatum
.formula M|yaaedatum    = 0|yedatum
