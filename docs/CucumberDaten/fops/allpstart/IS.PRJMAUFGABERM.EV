.continue EL093 ? _(G|mehr)
.input DATEI.F
.file -TEMPNAME U|xtftext
.output NEW 'U|xtftext'
.input -TEXT 'H|ybeschint'        ? G|evtvar = "ybuftint" & _F|empty(H|ybeschint)
.input -TEXT 'H|ybeschext'        ? G|evtvar = "ybuftext" & _F|empty(H|ybeschext)
.output NEW WERF.WEG
.continue EL094 ? _((F|empty(H|ylsposid)) & (F|empty(H|yreposid)))
.editing 'U|xtftext'
.continue EL095 ? _(G|evtvar = "ybuftint")
.formula H|ybeschint   = U|xtftext
.formula H|ybeschint   = ""             ? _F|filenotempty(U|xtftext)
.rewrite
.continue EL096 ? _(F|filenotempty(U|xtftext))
.file -SCREEN -TEMPNAME M|ydvtxintern                                                   ? M|ydvtxintern = ""
.output NEW 'M|ydvtxintern'
.input DATEI.F
.input -TEXT 'U|xtftext'
.formula M|ybeschint = M|ydvtxintern
.copy    M|ybtextint = G|true
.formula M|ybuftint  = "icon:ok"
.continue FI096
!EL096
