.continue EL084 ? _(G|mehr)
.copy    M|ystatusk     = D|ystatusk
.formula M|yplanstd     = D|yplanstd
.formula M|ysollstd     = D|ysollstd
.formula M|yiststd      = D|yiststd
.formula M|yforecaststd = D|yforecaststd
.formula M|yrestzeit    = D|yforecaststd - D|yiststd
.formula M|ytechfort    = D|yiststd / D|yforecaststd * 100  ? _D|yforecaststd = 0
.formula M|ytechfort    = 100                               ?  M|ytechfort      > 100
.formula M|ytechfort    = 99                                ?  M|ytechfort      = 100 & D|yiststd < D|yforecaststd
.formula M|yaaedatum    = D|yedatum
.continue EL085 ? _(M|tbaumstufe = 1)
.formula U|xiaazeile   = M|aktzeile         ? _M|ybtagessicht
.formula M|yedatum     = D|yedatum
.formula M|yarbzeit    = D|yiststd
.formula M|yfaktzeit   = D|yfaktstd
.copy    M|yeingeplant = G|true             ?  D|ystatusk <> ""   &  D|ystatusk <> "01"
.continue FI085
!EL085
.continue EL086 ? _((M|ybtagessicht) & (U|xdadatum = M|yadatum) & (M|tbaumstufe = 2))
