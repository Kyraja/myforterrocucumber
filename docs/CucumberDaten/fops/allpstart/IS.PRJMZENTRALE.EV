.load 1 group "4:2" 'U|xtsel'
!LOOP016: ==============================
.continue ELOP016 ? _(G|mehr)
.formula M|yprojzabsekbvpos = M|yprojzabsekbvpos + 1    ? F|empty(1|kopf) & F|value(1|bsart, "AS79") = "(ExternalProcurement)"
.formula M|yprojzabsekuvpos = M|yprojzabsekuvpos + 1    ? F|empty(1|kopf) & F|value(1|bsart, "AS79") = "(Relocation)"
.formula M|yprojzabseklvpos = M|yprojzabseklvpos + 1    ? F|empty(1|kopf) & F|value(1|bsart, "AS79") = "(Subcontracting)"
.formula M|yprojzabsekanpos = M|yprojzabsekanpos + 1    ? 1|kotyp = G|ANKO &  F|empty(1|status)
.formula M|yprojzabsekbepos = M|yprojzabsekbepos + 1    ? 1|kotyp = G|ABKO & (F|empty(1|status) ; (_1|lirelev & 1|remge > 0))
.formula M|yprojzabseklspos = M|yprojzabseklspos + 1    ? 1|kotyp = G|LIKO
.formula M|yprojzabsekrepos = M|yprojzabsekrepos + 1    ? 1|kotyp = G|REKO
.load 1 continue
.continue LOOP016
