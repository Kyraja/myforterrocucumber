.formula U|xtsel = U|xtsel + ";.kotyp==(RepairOrder)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@autostart=(Yes)"
.select group "3:2" 'U|xtsel'
.command -PARALLEL 'F|expr("<(Sales)>" + H|id + "<(View)>")'  ? G|mehr
!EL077
.continue ESAC004
!BRK045
.continue EL078 ? _((_(F|empty(M|yprojzsuch))) & (G|evtvar<<5 = "ybukz"))
.load 5 add F|sysinfo(10)^ykonfigprjm   ? _F|defined(5|ypmupgkzprojzent)
.continue EL079 ? _(F|defined(5|ypmupgkzprojzent))
.input 'F|foppath(5|ypmupgkzprojzent)'  ? _F|empty(5|ypmupgkzprojzent) & F|fileexists(F|foppath(5|ypmupgkzprojzent))
!EL079
!EL078
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK006
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMZENTRALE.EV")'           ? F|fileexists(F|foppath("IFOP.IS.PRJMZENTRALE.EV"))
.continue
