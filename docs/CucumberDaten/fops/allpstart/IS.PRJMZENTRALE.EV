.formula M|yprojzabsvkanpos = M|yprojzabsvkanpos + 1    ? 1|kotyp = G|ANKO &  F|empty(1|status)
.formula M|yprojzabsvkaupos = M|yprojzabsvkaupos + 1    ? 1|kotyp = G|ABKO & (F|empty(1|status) ; (_1|lirelev & 1|remge > 0))
.formula M|yprojzabsvklspos = M|yprojzabsvklspos + 1    ? 1|kotyp = G|LIKO
.formula M|yprojzabsvkrepos = M|yprojzabsvkrepos + 1    ? 1|kotyp = G|REKO
.formula M|yprojzabssvanpos = M|yprojzabssvanpos + 1    ? 1|kotyp = G|SNKO & F|empty(1|status)
.formula M|yprojzabssvaupos = M|yprojzabssvaupos + 1    ? 1|kotyp = G|SBKO & (F|empty(1|status) ; (_1|lirelev & 1|remge > 0))
