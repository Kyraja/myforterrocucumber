.continue 'xprocst.xprocsp'
!PROC003: ----- Daten_Projektabschluss -----
.assign U|xpprojekt = 9|id
.assign U|xpproject = 9|id
.copy    M|yprojzabsstatusk = 9|ystatusk
.copy    M|yprojzftabdatum  = 9|yftabdatum
.copy    M|yprojzkabdatum   = 9|yabldat
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.load 9 add U|xpproject
.copy U|xbtdat = G|TRUE         ?  F|rec(U|xystclosingvars, ypmtabdatum) & 9|ystatusk <> "FTAB" & 9|ystatusk <> "ABS" & 9|ystatusk <> "08"
.copy U|xbtdat = G|FALSE        ? _F|rec(U|xystclosingvars, ypmtabdatum) ; 9|ystatusk =  "FTAB" ; 9|ystatusk =  "ABS" ; 9|ystatusk =  "08"
.copy U|xbkdat = G|TRUE         ?  F|rec(U|xystclosingvars, ypmkabdatum) &                        9|ystatusk <> "ABS" & 9|ystatusk <> "08"
.copy U|xbkdat = G|FALSE        ? _F|rec(U|xystclosingvars, ypmkabdatum) ;                        9|ystatusk =  "ABS" ; 9|ystatusk =  "08"
.copy U|xbtab = G|TRUE
.copy U|xbkab = G|TRUE
.continue EL012 ? _(F|sysinfo(18)^allppro)
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"     ? _F|defined(U|xypermissions)
.copy U|xbtab = F|defined(F|map(U|xypermissions, 'F|rec(U|xystclosingvars, ypmtaberlabschluss)^id'))
.copy U|xbkab = F|defined(F|map(U|xypermissions, 'F|rec(U|xystclosingvars, ypmkaberlabschluss)^id'))
!EL012
.protection -RESET yprojzftabdatum 0    ?  U|xbtab &  U|xbtdat
.protection        yprojzftabdatum 0    ? _U|xbtab ; _U|xbtdat
.protection -RESET yprojzkabdatum  0    ?  U|xbkab &  U|xbkdat
.protection        yprojzkabdatum  0    ? _U|xbkab ; _U|xbkdat
.copy    U|xbnurpruef  = G|TRUE
.copy    U|xbkeinhinw  = G|TRUE
.assign  U|xyprojstatk = "ABS"
.formula U|xtprojekt   = M|yprojzsuch^id
.assign  U|xdabdat     = M|yprojzkabdatum
.input 'U|xtupprojab'
.load 9 add U|xpprojekt
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC004: ----- Markierte_Zeile -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ystdbudgetabicont1)
.copy U|xpproject = M|ytprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.copy U|xbtab = G|TRUE
.copy U|xbkab = G|TRUE
.continue EL013 ? _(F|sysinfo(18)^allppro)
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"     ? _F|defined(U|xypermissions)
.copy U|xbtab = F|defined(F|map(U|xypermissions, 'F|rec(U|xystclosingvars, ypmtaberlabschluss)^id'))
.copy U|xbkab = F|defined(F|map(U|xypermissions, 'F|rec(U|xystclosingvars, ypmkaberlabschluss)^id'))
!EL013
.load 9 add M|ytprojekt             ? _G|evtzeile = 0
.load 9 add M|yprojzsuch            ?  G|evtzeile = 0
.formula M|yprojzsuch       = 9|id
.formula M|yprojzname       = 9|namebspr
.copy    M|yprojzleit       = 9|yprojleit
.formula M|yprojzleitname   = 9|yprojleit^namebspr
.copy    M|yprojzkunde      = 9|ykunde
.formula M|yprojzkundename  = 9|ykunde^name
.copy    M|yprojzpverant    = 9|yprojverantw
.formula M|yprojzpvname     = 9|yprojverantw^namebspr
.copy    M|yprojzteilp      = 9|yteilprojektzu
.formula M|yprojzteilpname  = 9|yteilprojektzu^namebspr
.copy    M|yprojzpteam      = 9|yprojteam
.formula M|yprojzpteamname  = 9|yprojteam^namebspr
.copy    M|yprojzvkst       = 9|yverantwkst
.copy    M|yprojzbukoobj    = 9|yktr
.copy    M|ydokumente       = 9|ydokumente
.copy    M|ydoku            = 9|doku
.copy    M|ydokumentbaurl   = 9|dokumentbaurl
.copy    M|ybelartproj      = 9|belartproj
.formula M|yprojzprg        = 9|yprg
.assign  M|yprojzleistkat   = 9|yprojleistkatid
.assign  M|yprojzprgtypk    = 9|yprgtyp
.copy    M|yprojzabsstatusk = 9|ystatusk
.copy    M|yprojzftabdatum  = 9|yftabdatum
.copy    M|yprojzkabdatum   = 9|yabldat
.select group 'U|xydbgrlnachweis' 'F|expr("$,,yprojekt==" + 9|id + ";ynachtrag==1;@filingmode=(1)")'
.copy    M|yprojzbnachlm  = G|mehr
.continue EL014 ? _(F|sysinfo(18)^allpstd)
.select group 'U|xydbgrtpverrechanf' 'F|expr("$,,yhauptprojekt==" + 9|id + ";ytransaktion==`;@filingmode=(1)")'
.copy    M|yprojzbotpva   = G|mehr
.continue EL015 ? _(_(M|yprojzbotpva))
.select group 'U|xydbgrtpverrechanf' 'F|expr("$,,yteilprojekt==" + 9|id + ";ytransaktion==`;@filingmode=(1)")'
.copy    M|yprojzbotpva   = G|mehr
!EL015
!EL014
.formula M|yprojziconnachlm = "icon:bulb_on"    ?  M|yprojzbnachlm
.formula M|yprojziconnachlm = "icon:bulb_off"   ? _M|yprojzbnachlm
.formula M|yprojziconotpva  = "icon:bulb_on"    ?  M|yprojzbotpva
