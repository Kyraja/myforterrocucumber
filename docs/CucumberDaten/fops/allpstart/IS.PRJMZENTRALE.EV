.load 1 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula M|yprojzabsopv       = M|yprojzabsopv       + 1
.formula M|yprojzabsosonstref = M|yprojzabsosonstref + 1    ? 1|yreftypk = "99"
.load 1 continue
.continue LOOP001
!ELOP001: ==============================
.formula U|xtsel = "$,,"
