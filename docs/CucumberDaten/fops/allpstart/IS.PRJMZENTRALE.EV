.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/TRANS.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtcmd xtupkorepruef xykoobjekt xtprojekt xtmarke
.type text    xtmp xtvkstmerk xtfarbe xtdateiprojekte
.type integer xivar xizeile ximonat xianz xyvdn xyvgr
.type real    xrpvsollstd xrpvplanstd xrpviststd xrpvforecaststd xystdistvksatz
.type GD19    xdvon xdbis
.type GD      xddat xdabdat xdftdat
.type bool    xbmehr xbok xbnurpruef xbkeinhinw xbkab xbtab xbkdat xbtdat
.type P86:1   xpprojekt xpproject
.type AZK28044 xyprojstatk
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- LM_abrechnungsrelevant -----
.copy U|xbmehr = G|TRUE
.continue EL001 ? _(_(F|empty(1|ypvorgang^yvorpos)))
.load 2 group "P3:2" '1|ypvorgang^yvorpos'
.continue EL002 ? _(G|mehr)
.copy U|xbmehr = G|FALSE        ?  2|yprjmpnabrechrelev
.load 2
!EL002
!EL001
.continue EL003 ? _(F|sysinfo(18)^allpstd)
.continue EL004 ? _((_(F|empty(1|ypvorgang^ytppos))) & (((_(U|xbmehr)) ; (_(F|empty(9|yteilprojektzu)))) ; (F|empty(1|ypvorgang^yvorpos))))
.load 2 group 'U|xydbgrtpposition' '1|ypvorgang^ytppos'
.continue EL005 ? _(G|mehr)
.copy U|xbmehr = G|FALSE        ?  2|ynabrechrelev
.copy U|xbmehr = G|TRUE         ? _2|ynabrechrelev
.load 2
!EL005
!EL004
!EL003
.continue 'xprocst.xprocsp'
!PROC002: ----- AnzahlOffeneVorgaenge -----
