.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/LART.KONFIG.INI"
..====================================================
.type text    xtsys xtcmd xtsel xtedpdat xtedpout xtedperr xtedpmsg xtvar xtmavar xtext
.type integer xi01
.type bool    xbft
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Fehlermenue -----
!REPT001: ==============================
.set trans +
.menu
-                 -
Bei der Wiederherstellung des Personaldatensatzes sind Fehler aufgetreten.
Der Historiendatensatz kann nicht gelîscht werden.
Bitte wenden Sie sich an Ihren Systemverwalter

EDP Befehl: 'U|xtsys'

EDP Datei:        'U|xtedpdat'  >>.edit "'U|xtedpdat'"
?EDP Hinweisdatei: 'U|xtedpmsg'  >>.edit "'U|xtedpmsg'" ?  F|fileexists(U|xtedpmsg)
?EDP Fehlerdatei:  'U|xtedperr'  >>.edit "'U|xtedperr'" ?  F|fileexists(U|xtedperr)
?EDP Ausgabedatei: 'U|xtedpout'  >>.edit "'U|xtedpout'" ?  F|fileexists(U|xtedpout)
.set trans -
.continue REPT001 ? _(G|menue = 0)
.error
.end 1
.continue 'xprocst.xprocsp'
!PROC002: ----- PersHist_loeschen -----
.continue EL001 ? _(M|ablagef)
.set trans +
.box Hinweis
Historiendatensatz wurde bereits gelîscht.
.set trans -
.error
.end 1
.continue FI001
!EL001
.continue EL002 ? _(M|yhistzeitstempel > G|zeitpunkt)
.continue EL003 ? _(G|evtkommd <> G|kaktname10)
.select lock add M|id
.continue EL004 ? _(_(G|mehr))
.set trans +
.box Hinweis
Historiendatensatz kann nicht bearbeitet werden.
Lîschen derzeit nicht mîglich.
.set trans -
.error
.end 1
.continue FI004
!EL004
.continue EL005 ? _(H|ablagef)
.set trans +
.box Hinweis
Historiendatensatz wurde bereits gelîscht.
.set trans -
.error
.end 1
!EL005
!FI004
!EL003
.select lock add M|yhistpersonal
.continue EL006 ? _(_(G|mehr))
.set trans +
.box Hinweis
Der Personaldatensatz zur Historie kann nicht bearbeitet werden.
Lîschen derzeit nicht mîglich.
.set trans -
.error
.end 1
.continue FI006
!EL006
.file -tempname U|xtedpdat
.file -tempname U|xtedpout
.file -tempname U|xtedpmsg
.file -tempname U|xtedperr
.input DATEI.F
.input "is/XMLSUBSTVAR"
.set separator
.set substitution 'U|xfullsubs'
.tablerecord unformatted
.output new 'U|xtedpdat' -encoding "UTF-8"
.input DATEI.F
.select add M|id
<'G|fragechar'xml version="1.0" encoding="UTF-8"'G|fragechar'>
<'G|fragechar'edp lang d'G|fragechar'>
<'G|fragechar'edp updatemode strict'G|fragechar'>
<'G|fragechar'edp fopmode 0'G|fragechar'>
<ABASData reftype="ref">
  <RecordSet>
    <Record database="11" group="1" action="UPDATE" id="'M|yhistpersonal^id'">
       <Field name="such">'M|such'</Field>
.load 9 add G|varmaske.evtmaske
.load 9 line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xtvar   = 9|vname<<-2    ?  F|empty(9|vnname)
.formula U|xtvar   = 9|vnname<<-2   ? _F|empty(9|vnname)
.formula U|xtmavar = U|xtvar
.formula U|xtmavar = "ftext"    ? U|xtvar = "yftext"
.formula U|xtmavar = "ftext2"   ? U|xtvar = "yftext2"
.formula U|xtmavar = "kstelle"  ? U|xtvar = "ykstelle"
