.formula U|xtmavar = "str"      ? U|xtvar = "ystr"
.formula U|xtmavar = "lakenn"   ? U|xtvar = "ylakenn"
.formula U|xtmavar = "plz"      ? U|xtvar = "yplz"
.formula U|xtmavar = "nort"     ? U|xtvar = "ynort"
.formula U|xtmavar = "region"   ? U|xtvar = "yregion"
.formula U|xtmavar = "bstaat"   ? U|xtvar = "ystaat"
.formula U|xtmavar = "tele"     ? U|xtvar = "ytele"
.formula U|xtmavar = "mtele"    ? U|xtvar = "ymtele"
.formula U|xtmavar = "fax"      ? U|xtvar = "yfax"
.formula U|xtmavar = "email"    ? U|xtvar = "yemail"
.formula U|xtmavar = "urlt"     ? U|xtvar = "yurlt"
.formula U|xtmavar = "abtlg"    ? U|xtvar = "yabteilung"
.formula U|xtmavar = "as"       ? U|xtvar = "yas"
.formula U|xtmavar = "kontakt"  ? U|xtvar = "ykontakt"
.formula U|xtmavar = "splan"    ? U|xtvar = "ysplan"
.formula U|xtmavar = "url"      ? U|xtvar = "yurlaub"
.formula U|xtmavar = "eintr"    ? U|xtvar = "yeintr"
.formula U|xtmavar = "austr"    ? U|xtvar = "yaustr"
.continue EL007 ? _((_(9|vkt)) & (_(9|vskip)) & (_(9|vitf<<2 = "BU")) & (_(U|xtvar<<5 = "yhist")) & (_(U|xtvar = "ykstname")) & (_(U|xtvar = "yspname")))
.continue EL008 ? _(U|xtvar<<1 = "y")
.continue EL009 ? _(F|defined(M|.U|xtmavar))
.continue EL010 ? _(9|vitf<<2 = "TN")
.continue EL011 ? _(_(F|empty(M|.U|xtvar)))
.copy U|xbft = G|false
.select from 'H|.U|xtvar' U|xtext^
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL012 ? _(U|xbft)
'U|xtext'
.continue FI012
!EL012
.copy U|xbft = G|true
        <Field name="'U|xtmavar'" abasType="'9|vitf'">'U|xtext'
!FI012
.select from 'H|.U|xtvar' U|xtext^
.continue LOOP002
!ELOP002: ==============================
?       </Field>        ? U|xbft
!EL011
.continue FI010
!EL010
?       <Field name="'U|xtmavar'">'H|.U|xtvar'</Field>      ? 9|vitf<<1 <> "P" & 9|vitf<<2 <> "VP" & 9|vitf<<2 <> "AZ"
?       <Field name="'U|xtmavar'">'H|.U|xtvar^id'</Field>   ? 9|vitf<<1 =  "P" ; 9|vitf<<2 =  "VP" ; 9|vitf<<2 =  "AZ"
!FI010
!EL009
.continue FI008
!EL008
.continue EL013 ? _(U|xtvar<<4="name")
       <Field name="'U|xtvar'">'H|.U|xtmavar'</Field>
!EL013
!FI008
!EL007
.load 9 line
.continue LOOP001
!ELOP001: ==============================
    </Record>
  </RecordSet>
</ABASData>
.output new WERF.WEG
.formula U|xtsys = "xmlimport.sh"
.formula U|xtsys =  U|xtsys + " -p " + G|einmalpw
.formula U|xtsys =  U|xtsys + " -o UPDATEMODE=STRICT"
.formula U|xtsys =  U|xtsys + " -r REF -T"
.formula U|xtsys =  U|xtsys + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'U|xtsys' BACKGROUND
.continue EL014 ? _(G|mehr)
.continue EL015 ? _(F|filenotempty(U|xtedperr))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI015
!EL015
