..!interpreter english declaration noabbrev
.set trans -
..========================================================================
..==  Name              : FOP.PRJM.UP.SELCHECK.FF
..==  Pfad              : allpstart
..==  Funktion          : Selektion am FeldfÅll Ereignis
..==  Erstellungsdatum  : 17.10.2014
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsel         ? _F|defined(U|xtsel)
.type text    xysel         ? _F|defined(U|xysel)
.type text    xydbgr        ? _F|defined(U|xydbgr)
.type text    xyprojvar     ? _F|defined(U|xyprojvar)
.type text    xyid          ? _F|defined(U|xyid)
.type text    xytext        ? _F|defined(U|xytext)
.type bool    xybnoprsel    ? _F|defined(U|xybnoprsel)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EL001 ? _(F|empty(U|xydbgr))
.formula U|xydbgr = F|typeof(M|.evtvar)
!EL001
.continue EL002 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|regmatch(G|evtfeldneu, "\*.*"))) & (_(F|regmatch(G|evtfeldneu, "\$.*"))) & (_(F|regmatch(G|evtfeldneu, "\%.*"))))
.formula G|evtfeldneu = "?"     ? G|evtfeldneu = "!"
.continue EL003 ? _((F|regmatch(G|evtfeldneu, "\?")) ; (F|regmatch(G|evtfeldneu, "!,.*")) ; (F|regmatch(G|evtfeldneu, "\d.*")) ; ((F|regmatch(G|evtfeldneu, "[a-zA-Z].*")) & (_(F|regmatch(G|evtfeldneu, "^[a-zA-Z].*[:space:].*"))) & (_(F|regmatch(G|evtfeldneu, "^[a-zA-Z].*[;].*"))) & (_(F|regmatch(G|evtfeldneu, "^[a-zA-Z].*[,]")))))
.formula U|xtsel = "$,,"
.continue EL004 ? _((_(U|xybnoprsel)) & ((F|defined(M|projekt)) ; (F|defined(M|yprojekt)) ; (F|defined(M|ytprojekt))) & (F|defined(M|.evtvar^yprojekt)))
.formula U|xyprojvar = "projekt"    ? F|defined(M|projekt)
.formula U|xyprojvar = "yprojekt"   ? F|defined(M|yprojekt)
.formula U|xyprojvar = "ytprojekt"  ? F|defined(M|ytprojekt)
!EL004
.formula U|xtsel = U|xtsel + ".yprojekt==" + M|.xyprojvar^id    ? _F|empty(U|xyprojvar)
.formula U|xtsel = U|xtsel + U|xysel                            ? _F|empty(U|xysel)
.formula U|xtsel = U|xtsel + ";@noswd="    + G|evtfeldneu
.select group 'U|xydbgr' 'U|xtsel'
.continue EL005 ? _(G|mehr)
.formula U|xyid = H|id
.select continue
.continue EL006 ? _(G|mehr)
.formula U|xtsel = "%,,"
.formula U|xtsel = U|xtsel + ".yprojekt==" + M|.xyprojvar^id    ? _F|empty(U|xyprojvar)
.formula U|xtsel = U|xtsel + U|xysel                            ? _F|empty(U|xysel)
.formula U|xtsel = U|xtsel + ";@noswd="    + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@autostart=(Yes);@dynprotection=(Yes);@gprotection=(Yes);@bprotection =(Yes)"
.select group 'U|xydbgr' 'U|xtsel'
.formula G|evtfeldneu = M|.evtvar^id    ? _G|mehr
.formula G|evtfeldneu = H|id            ?  G|mehr
.continue FI006
!EL006
.formula G|evtfeldneu = U|xyid
!FI006
.continue FI005
!EL005
.continue EL007 ? _((G|evtfeldneu = "!") ; (G|evtfeldneu = "?"))
.set trans +
.formula U|xytext = "keine passenden Daten gefunden"
.set trans -
.continue EL008 ? _((_(U|xybnoprsel)) & ((F|defined(M|projekt)) ; (F|defined(M|yprojekt)) ; (F|defined(M|ytprojekt))) & (F|defined(M|.evtvar^yprojekt)))
.set trans +
.formula U|xytext = F|formatstr("Kein Datensatz zum Projekt {1} gefunden", F|trim('M|yprojekt'))    ? F|defined(M|yprojekt)
.formula U|xytext = F|formatstr("Kein Datensatz zum Projekt {1} gefunden", F|trim('M|projekt'))     ? F|defined(M|projekt)
.box Hinweis
'U|xytext'
.set trans -
.continue FI008
!EL008
.set trans +
.box Hinweis
'U|xytext'
.set trans -
!FI008
.formula G|evtfeldneu = ""
.continue FI007
!EL007
.formula U|xytext = F|formatstr("{1}: nicht gefunden", G|evtfeldneu)
.continue EL009 ? _((_(U|xybnoprsel)) & ((F|defined(M|projekt)) ; (F|defined(M|yprojekt)) ; (F|defined(M|ytprojekt))) & (F|defined(M|.evtvar^yprojekt)))
.formula U|xtsel = "$,,;@noswd=" + G|evtfeldneu
.select group 'U|xydbgr' 'U|xtsel'
.continue EL010 ? _(G|mehr)
.set trans +
.formula U|xytext = F|formatstr("{1}: passt nicht zum Projekt {2}", G|evtfeldneu, F|trim('M|yprojekt')) ? F|defined(M|yprojekt)
.formula U|xytext = F|formatstr("{1}: passt nicht zum Projekt {2}", G|evtfeldneu, F|trim('M|projekt'))  ? F|defined(M|projekt)
.set trans -
.box Hinweis
'U|xytext'
.set trans -
.continue FI010
!EL010
.set trans +
.box Hinweis
'U|xytext'
.set trans -
!FI010
.continue FI009
!EL009
.set trans +
.box Hinweis
'U|xytext'
.set trans -
!FI009
.error
.end 1
!FI007
!FI005
!EL003
!EL002
