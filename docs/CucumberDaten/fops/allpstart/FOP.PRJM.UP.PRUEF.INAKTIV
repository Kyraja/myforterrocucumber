..!interpreter english declaration noabbrev
..*****************************************************************************
.. Name           : allprjm/FOP.PRJM.UP.PRUEF.INAKTIV
.. Datum/Date     : 14.10.2011
.. Version        :
.. Autor/Author   : ts / alltrotec GmbH
.. Copyright      :
.. Beschreibung   : prÅft ob der Datensatz der aktuelen Variablen inaktiv / relevant fÅr Projektplanung ist
..                  
.. énderungen     : 25.04.2012,ts - bei Projektteam prÅfen ob nur projektbezogene Teams zulÑssig
..                  03.03.2017,ts - öberfÅhrung von Personal zu Mitarbeiter
...Includes       :
..*****************************************************************************
.set trans -
..
.type bool xybinaktiv   ? _F|defined(U|xybinaktiv)
..
.continue               ?  F|empty(G|evtvar) ; G|evtvar = "*"
.continue               ?  F|empty(M|.evtvar)
..
.copy U|xybinaktiv = M|.evtvar^yprjminaktiv     ? F|defined(M|.evtvar^yprjminaktiv)
.copy U|xybinaktiv = M|.evtvar^yinaktiv         ? F|defined(M|.evtvar^yinaktiv)
.continue FEINAKTIV     ?  U|xybinaktiv
..
.continue CHKPERS       ? _F|defined(M|.evtvar^yprojekt) ; _F|defined(M|yprojekt) ; _F|sysinfo(10)^ykonfigprjm^ypmpteamzuord
.continue FEPTEAM       ?  M|.evtvar^yprojekt^id <> M|yprojekt^id
..
!CHKPERS:
.continue               ? _F|defined(M|.evtvar^yprjmpplanrelev)
.continue FEPPREL       ? _M|.evtvar^yprjmpplanrelev
..
.continue
..
..
!FEINAKTIV:
.set TRANS +
..
.box Fehler
'F|trim(F|tostring(M|.evtvar))' ist inaktiv.
..
.set TRANS -
..
.copy M|.evtvar = F|oldvalue(M|.evtvar)
..
.error
.end 1
..
!FEPPREL:
.set TRANS +
..
.box Fehler
'F|trim(F|tostring(M|.evtvar))' ist nicht relevant fÅr die Projektplanung.
..
.set TRANS -
..
.copy M|.evtvar = F|oldvalue(M|.evtvar)
..
.error
.end 1
..
!FEPTEAM:
.set TRANS +
..
.box Fehler
Es sind nur Teams mit Projektbezug erlaubt.
'F|trim(F|tostring(M|.evtvar))' passt nicht zum Projekt 'M|yprojekt'.
..
.set TRANS -
..
.copy M|.evtvar = F|oldvalue(M|.evtvar)
..
.error
.end 1
