..!interpreter english declaration noabbrev
.. at 2016-12-23, 13:27
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMAPANLAGE.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 03.01.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtftext
.type bool    xbok xbmehr
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Zeile -----
.make screen line +O
.assign  M|yarbpaket   = H|id
.copy    M|yapvorlage  = H|yausapvorlage
.assign  M|yname       = H|namebspr
.formula M|yapsollwert = H|yapsollwert
.formula M|yapsollstd  = H|yapsollstd
.continue EL001 ? _(_(F|empty(H|yftext)))
.select from 'H|yftext'
.formula M|yftext = H|yftext
!EL001
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC002: ----- AP_schreiben -----
.assign  H|name          = M|yname
.copy    H|yprojekt      = M|yzielprojekt       ? _F|empty(M|yzielprojekt)
.copy    H|yausapvorlage = M|yapvorlage
.formula H|yapsollwert   = M|yapsollwert
.formula H|yapsollstd    = M|yapsollstd
.select from 'M|yftext'         ? _F|empty(M|yftext)
.formula H|yftext = 'M|yftext'  ? _F|empty(M|yftext)
.formula H|yftext = ""          ?  F|empty(M|yftext)
.rewrite
.continue 'xprocst.xprocsp'
!PROC003: ----- Speichern -----
.select screen line "$,,ybanlegen==1"
.continue EL002 ? _(G|mehr)
.continue EL003 ? _(_(F|empty(M|yzielprojekt)))
.input "is/ABASFARBEN.DEF"  ? _F|defined(U|xabaslightgreen)
.file -tempname U|xtftext
.input DATEI.F
.copy U|xbmehr = G|false
.copy U|xbok   = G|true
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL004 ? _(M|ybanlegen)
.copy U|xbmehr = G|true
.continue EL005 ? _(F|empty(M|yarbpaket))
.formula U|xtcmd = "make " + G|hdatname.xydbarbpaket + " GROUP" + 'U|xygrarbpaket'
.'U|xtcmd'
.formula H|such = M|yapvorlage^such
.formula H|such = M|yzielprojekt^such       ?  F|empty(H|such) & _F|empty(M|yzielprojekt)
.formula H|name = M|yapvorlage^namebspr
.formula H|name = M|yzielprojekt^namebspr   ?  F|empty(H|name) & _F|empty(M|yzielprojekt)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.colour -background 'U|xabaslightgreen' 'M|aktzeile'
.assign M|yarbpaket = H|id
.copy M|ybanlegen = G|false
.continue FI005
!EL005
.select lock add M|yarbpaket
.continue EL006 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.colour -background 'U|xabaslightgreen' 'M|aktzeile'
.copy M|ybanlegen = G|false
.continue FI006
!EL006
.copy U|xbok = G|false
!FI006
!FI005
!EL004
.select screen line
.continue LOOP001
!ELOP001: ==============================
.continue EL007 ? _(_(U|xbmehr))
.set TRANS +
.box Hinweis
Es wurden keine Zeilen zur Anlage von Arbeitspaketen markiert.
.set TRANS -
.continue FI007
!EL007
.continue EL008 ? _(_(U|xbok))
.set TRANS +
.box Hinweis
Es konnten nicht alle Arbeitspakete gespeichert werden.
.set TRANS -
!EL008
!FI007
.continue FI003
!EL003
.set TRANS +
.box Hinweis
Bitte erst ein Ziel-Projekt angeben.
.set TRANS -
.error
.end 1
!FI003
!EL002
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskpruef")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskende")
.end .          ? M|ybmaskezu
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "buttonvor")
.continue BRK004 ? _(G|evtvar = "bstart")
.continue EL009 ? _(F|empty(M|yzielprojekt))
.set TRANS +
.box Hinweis
Bitte erst ein Ziel-Projekt angeben.
.set TRANS -
.error
.end 1
.continue FI009
!EL009
.make screen line --O
!FI009
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "buttonnach")
.continue BRK006 ? _(G|evtvar = "bstart")
.file -TEMPNAME U|xtftext
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt==" + M|yzielprojekt^id          ? _F|empty(M|yzielprojekt)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrarbpaket' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP002
!ELOP002: ==============================
.continue EL010 ? _(_(F|empty(M|yquellprojekt)))
.formula U|xtsel = "%,,"
.formula U|xtsel = U|xtsel + ";yprojekt==" + M|yquellprojekt^id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrarbpaket' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
.select continue
.continue LOOP003
!ELOP003: ==============================
!EL010
.continue EL011 ? _(M|ybladevorlagen)
.formula U|xtsel = "$,,"
.select group 'U|xydbgrapvorlage' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="      + M|yzielprojekt^id     ? _F|empty(M|yzielprojekt)
.formula U|xtsel = U|xtsel + ";yausapvorlage==" + H|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrarbpaket' 'U|xtsel'
.continue EL012 ? _(_(G|mehr))
.make screen line +O
.assign M|yapvorlage = H|id
.assign M|yname      = H|namebspr
!EL012
.select continue
.continue LOOP004
!ELOP004: ==============================
!EL011
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ybuanlegen")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC003
!RET006
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "ybuneuezeile")
.make screen line +
.copy M|ybanlegen = G|true
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "yftext")
.copy M|ybanlegen = G|true
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue ESAC003
!BRK009
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK005
.continue BRK010 ? _(G|evtart = "feldaus")
.continue BRK011 ? _(G|evtvar = "yzielprojekt")
.continue EL013 ? _(_(F|empty(M|yzielprojekt)))
.assign M|yquellprojekt = ""
.protection        yquellprojekt 0
.continue FI013
!EL013
.protection -reset yquellprojekt 0
!FI013
.continue ESAC004
!BRK011
.continue BRK012 ? _(G|evtvar = "ybladevorlagen")
.assign M|yquellprojekt = ""
.continue ESAC004
!BRK012
.continue BRK013 ? _(G|evtvar = "yquellprojekt")
.assign M|ybladevorlagen = ""
.continue ESAC004
!BRK013
.continue BRK014 ? _(G|evtvar = "yquelllv")
.assign M|ybladevorlagen = ""
.continue ESAC004
!BRK014
.continue BRK015 ? _(G|evtvar = "ybanlegen")
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue ESAC004
!BRK015
.continue BRK016 ? _(G|evtvar = "yname")
.copy M|ybanlegen = G|true
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue ESAC004
!BRK016
.continue BRK017 ? _(G|evtvar = "yapsollwert")
.copy M|ybanlegen = G|true
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue ESAC004
!BRK017
.continue BRK018 ? _(G|evtvar = "yapsollstd")
.copy M|ybanlegen = G|true
.colour -background "-1 -1 -1" 'M|aktzeile'
.continue ESAC004
!BRK018
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK010
.continue BRK019 ? _(G|evtart = "zeileeinnach")
.copy M|ybanlegen = G|true
.continue ESAC001
!BRK019
.continue BRK020 ? _(G|evtart = "zeileloevor")
.continue EL014 ? _(_(F|empty(M|yarbpaket)))
.error
.end 1
!EL014
.continue ESAC001
!BRK020
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMAPANLAGE.EV")'       ? F|fileexists(F|foppath("IFOP.IS.PRJMAPANLAGE.EV"))
.continue
