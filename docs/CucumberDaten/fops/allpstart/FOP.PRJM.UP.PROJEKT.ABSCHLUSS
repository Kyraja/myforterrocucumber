.formula H|ydatkfmab   = G|datum        ?  U|xyprojstatk = "ABS" ;  U|xyprojstatk = "08"
.formula H|ybearbkfmab = G|bzeichen     ?  U|xyprojstatk = "ABS" ;  U|xyprojstatk = "08"
.formula H|ystatusk    = U|xyprojstatk
.rewrite
.load 0 add 0|id
.continue EL063 ? _((0|ystatusk = "ABS") ; (0|ystatusk = "08") ; ((0|ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabwipliste))) ; ((0|ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabwipnull))))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="  + 0|id
.formula U|xtsel = U|xtsel + ";ystichtag>=" + '0|yabldat:8'     ? 0|ystatusk = "ABS" ; 0|ystatusk = "08"
.formula U|xtsel = U|xtsel + ";ystichtag>=" + '0|yftabdatum:8'  ? 0|ystatusk = "FTAB"
.formula U|xtsel = U|xtsel + ";ybabgeschlossen=0"
.load 9 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP022: ==============================
.continue ELOP022 ? _(G|mehr)
.select lock add 9|id
.delete                     ? G|mehr
.load 9 continue
.continue LOOP022
!ELOP022: ==============================
!EL063
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="     +  0|id
.formula U|xtsel = U|xtsel + ";ybezugsdatum>=" + '0|yabldat:8'      ? 0|ystatusk = "ABS" ; 0|ystatusk = "08"
.formula U|xtsel = U|xtsel + ";ybezugsdatum>=" + '0|yftabdatum:8'   ? 0|ystatusk = "FTAB"
.load 9 group "151:1" 'U|xtsel'
!LOOP023: ==============================
.continue ELOP023 ? _(G|mehr)
.select lock add 9|id
.continue EL064 ? _(G|mehr)
.copy H|ystatusk = 0|ystatusk
.rewrite
!EL064
.load 9 continue
.continue LOOP023
!ELOP023: ==============================
.continue EL065 ? _(F|sysinfo(18)^allppro)
.continue EL066 ? _(((U|xyprojstatk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabnachkalk))) ; (((U|xyprojstatk = "ABS") ; (U|xyprojstatk = "08")) & (F|rec(U|xystclosingvars, ypmkabnachkalk))))
.copy U|xbtobuffer = G|false
.continue EL067 ? _(F|defined(M|id))
.copy U|xbtobuffer = G|true     ? M|id = 0|id & G|evtart = "maskpruef"
!EL067
.select -
.input "allpstart/FOP.PRJM.SAVE.BUFFER"
.input "java:de.alltrotec.ps.control.ProjectFinalCosting@ALLPS" writeToScreenBuffer=true                    ?  U|xbtobuffer
.input "java:de.alltrotec.ps.control.ProjectFinalCosting@ALLPS" project='0|id' writeToScreenBuffer=false    ? _U|xbtobuffer
.select -
.input "allpstart/FOP.PRJM.LOAD.BUFFER"
!EL066
!EL065
.select add 0|id
.continue EL068 ? _(_(U|xbkeinhinw))
.set TRANS +
.box Hinweis
Status "'H|ystatus'" im Projekt 'H|such' wurde gesetzt.
.set TRANS -
!EL068
.continue FI062
!EL062
.copy U|xbok   = G|false
.set TRANS +
.box Fehler
Das Projekt '0|such' kann nicht bearbeitet werden.
.set TRANS -
!FI062
!EL061
.continue FI058
!EL058
.continue EL069 ? _(_(U|xbkeinhinw))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC004
!RET007
.formula xprocsp = xprocsp - 1
!EL069
!FI058
.continue FI055
!EL055
.copy U|xbmehr = G|false
.copy U|xbok   = G|false
.set TRANS +
.box Fehler
Das Projekt '0|such' kann nicht bearbeitet werden.

'G|sperrtext                                                                  '
