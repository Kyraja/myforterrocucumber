!EL014
.continue EL015 ? _(U|xbok)
.continue EL016 ? _((0|yablage) & ((U|xyprojstatk = "ABS") ; (U|xyprojstatk = "08")))
.continue EL017 ? _(_(U|xbkeinhinw))
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xttext1 = F|formatstr("Das Projekt {1} ist bereits abgeschlossen.", 0|such)
.set trans -
.box 'U|xttitel'
'U|xttext1'
!EL017
.continue FI016
!EL016
