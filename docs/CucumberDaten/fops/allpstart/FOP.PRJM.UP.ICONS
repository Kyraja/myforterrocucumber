..!interpreter english noabbrev         
..*****************************************************************************
.. FOP-Name    : FOP.PRJM.UP.ICONS
.. Date        : 11.11.2014
.. Author      : Thomas Saalborn, alltrotec GmbH
.. Copyright   : (c) 1990 - 2014 alltrotec GmbH
.. Function    : Fllen der Icons fr Stundenverbrauch und Abweichungen
..*****************************************************************************
..
.set trans -
..
.type text    xytpuffer     ? _F|defined(U|xytpuffer)
.type integer xyiicon       ? _F|defined(U|xyiicon)
.type integer xyikrit       ? _F|defined(U|xyikrit)
.type real    xyrwert       ? _F|defined(U|xyrwert)
..
..wenn vom Hauptprogramm der Puffer nicht bergeben wird, dann je nach Event entscheiden
.formula U|xytpuffer = "M"  ?  F|empty(U|xytpuffer) &  G|evtart = "feldaus"
.formula U|xytpuffer = "H"  ?  F|empty(U|xytpuffer) & _G|evtart = "feldaus"
.continue                   ?  F|empty(U|xytpuffer)
..
..!meta 5|=P146:1
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ybstdfortbudkrit)
..
.formula U|xyrwert = 0
.formula U|xyikrit = 0
..
..
.. Stundenverbrauch Ist zu Budget
.formula U|xyrwert = F|eval(U|xytpuffer + "|yfortistbudget")
.formula U|xyiicon = 0
.formula U|xyiicon = 1   ? U|xyrwert >  5|ystdfortbud1
.formula U|xyiicon = 2   ? U|xyrwert >  5|ystdfortbud2
.formula U|xyiicon = 3   ? U|xyrwert >  5|ystdfortbud3
.formula U|xyiicon = 4   ? U|xyrwert >  5|ystdfortbud4
.formula U|xyiicon = 5   ? U|xyrwert >  5|ystdfortbud5
..
.'F|expr("formula " + U|xytpuffer + "|yiconfortbudget    = 5|ystdfortbudicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdfortbudkrit
..
..
.. Stundenverbrauch Ist zu Plan
.formula U|xyrwert = F|eval(U|xytpuffer + "|yfortschritt")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdfortplan1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdfortplan2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdfortplan3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdfortplan4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdfortplan5
..
.'F|expr("formula " + U|xytpuffer + "|yiconfortplan      = 5|ystdfortplanicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdfortplankrit
..
..
..Physischer Fortschritt
.formula U|xyrwert = F|eval(U|xytpuffer + "|ytechfort")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdtechfort1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdtechfort2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdtechfort3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdtechfort4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdtechfort5
..
.'F|expr("formula " + U|xytpuffer + "|yicontechfort      = 5|ystdtechforticont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdtechfortkrit
..
..
.. Budgetabweichung
.formula U|xyrwert = F|eval(U|xytpuffer + "|yabwfortbudget")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdbudgetab1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdbudgetab2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdbudgetab3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdbudgetab4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdbudgetab5
..
.'F|expr("formula " + U|xytpuffer + "|yiconabwfortbudget = 5|ystdbudgetabicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdbudgetabkrit
..
..
.. Planabweichung
.formula U|xyrwert = F|eval(U|xytpuffer + "|yabwfortplan")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdplanab1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdplanab2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdplanab3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdplanab4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdplanab5
..
.'F|expr("formula " + U|xytpuffer + "|yiconabwfortplan   = 5|ystdplanabicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdplanabkrit
..
..
..Abweichung physischer Fortschritt zu Plan (aus Differenz Stundenverbrauch Plan - physischer Fortschritt)
..  .formula U|xyrwert = F|eval(U|xytpuffer + "|yfortschritt") - F|eval(U|xytpuffer + "|ytechfort")
.formula U|xyrwert = F|eval(U|xytpuffer + "|yabwphysplan")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdphysab1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdphysab2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdphysab3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdphysab4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdphysab5
..
.'F|expr("formula " + U|xytpuffer + "|yiconabwphysplan   = 5|ystdphysabicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdphysabkrit
..
..
.. Abweichung Datum letzte Rckmeldung zu Plan
.formula U|xyrwert = F|eval(U|xytpuffer + "|yabwterminist")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdterminab1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdterminab2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdterminab3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdterminab4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdterminab5
..
.'F|expr("formula " + U|xytpuffer + "|yiconabwterminist  = 5|ystdterminabicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdterminabkrit
..
..
.. Abweichung Datum Referenz zu Plan
.formula U|xyrwert = F|eval(U|xytpuffer + "|yabwterminplan")
.formula U|xyiicon = 0
.formula U|xyiicon = 1  ? U|xyrwert >  5|ystdterminab1
.formula U|xyiicon = 2  ? U|xyrwert >  5|ystdterminab2
.formula U|xyiicon = 3  ? U|xyrwert >  5|ystdterminab3
.formula U|xyiicon = 4  ? U|xyrwert >  5|ystdterminab4
.formula U|xyiicon = 5  ? U|xyrwert >  5|ystdterminab5
..
.'F|expr("formula " + U|xytpuffer + "|yiconabwterminplan  = 5|ystdterminabicont.xyiicon")'
.formula U|xyikrit = U|xyiicon    ? U|xyiicon > U|xyikrit & 5|ybstdterminabkrit
..
..
..kritischter Projektvorgang
.'F|expr("formula " + U|xytpuffer + "|yiconkritvorgang = 5|ystdkritvoricont.xyikrit")'
..
.continue
