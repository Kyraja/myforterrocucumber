..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.ZUSCHLAGSATZ.EV
..==  Pfad              : allpstart
..==  Funktion          : EFOP an Zuschlagsatz
..==  Erstellungsdatum  : 24.10.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd
.type integer xprocsp           ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL001 ? _(G|evtkommd = G|kaktname10)
.continue EL002 ? _(F|sysinfo(18)^allppro)
.formula U|xtsel = "$,,ygkzseigen==" + M|id + ";@ablageart=(1);@maxtreffer=1"
.select group 'U|xydbgrkokomponente' 'U|xtsel'
.continue EL003 ? _(G|mehr)
.set TRANS +
.box Fehler
Der Zuschlagssatz 'M|such' wird noch in Kostenkomponenten verwendet.
Lîschen des Zuschlagssatzes ist nicht mîglich.
.set TRANS -
.error
.end 1
!EL003
.formula U|xtsel = "$,,ygkzsfremd==" + M|id + ";@ablageart=(1);@maxtreffer=1"
.select group 'U|xydbgrkokomponente' 'U|xtsel'
.continue EL004 ? _(G|mehr)
.set TRANS +
.box Fehler
Der Zuschlagsssatz 'M|such' wird noch in Kostenkomponenten verwendet.
Lîschen des Zuschlagssatzes ist nicht mîglich.
.set TRANS -
.error
.end 1
!EL004
.formula U|xtsel = "$,,ygkzssonst==" + M|id + ";@ablageart=(1);@maxtreffer=1"
.select group 'U|xydbgrkokomponente' 'U|xtsel'
.continue EL005 ? _(G|mehr)
.set TRANS +
.box Fehler
Der Zuschlagssatz 'M|such' wird noch in Kostenkomponenten verwendet.
Lîschen des Zuschlagssatzes ist nicht mîglich.
.set TRANS -
.error
.end 1
!EL005
.formula U|xtsel = "$,,ygkzsfert==" + M|id + ";@ablageart=(1);@maxtreffer=1"
.select group 'U|xydbgrkokomponente' 'U|xtsel'
.continue EL006 ? _(G|mehr)
.set TRANS +
.box Fehler
Der Zuschlagssatz 'M|such' wird noch in Kostenkomponenten verwendet.
Lîschen des Zuschlagssatzes ist nicht mîglich.
.set TRANS -
.error
.end 1
!EL006
!EL002
.continue FI001
!EL001
.continue EL007 ? _(G|evtkommd = G|kaktname14)
.assign M|yaufwkonto = ""
!EL007
!FI001
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "yaufwkonto")
.continue EL008 ? _(_(F|empty(M|yaufwkonto)))
.select group 'U|xydbgrzuschlagsatz' 'F|expr("$,,id<>" + M|id + ";yaufwkonto==" + M|yaufwkonto^id + ";@ablageart=(1)")'
.continue EL009 ? _(G|mehr)
.set TRANS +
.box Hinweis
Das Aufwandskonto 'M|yaufwkonto' darf hier nicht eingetragen werden, da es bereits im Zuschlagssatz 'H|such' eingetragen ist.
.set TRANS -
.assign M|yaufwkonto = ""
!EL009
!EL008
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "yzuschlagsbasis")
.continue EL010 ? _(_(F|empty(M|yzuschlagsbasis)))
.select add M|yzuschlagsbasis
.continue EL011 ? _(G|mehr)
.select line
!LOOP001: ==============================
.continue ELOP001 ? _((G|mehr) & (_(F|empty(M|yzuschlagsbasis))))
.continue EL012 ? _(_(H|koart^gruppe = 1))
.set TRANS +
.box Hinweis
Es sind nur einstufige Rechenregeln erlaubt.
.set TRANS -
.assign M|yzuschlagsbasis = ""
!EL012
.select line
.continue LOOP001
!ELOP001: ==============================
!EL011
!EL010
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
