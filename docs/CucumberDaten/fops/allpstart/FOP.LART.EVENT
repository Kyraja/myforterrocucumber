!PROC001: ----- CheckAccount -----
.continue EL001 ? _(_(F|empty(M|.G|evtvar)))
.load 0 add M|.G|evtvar
.continue EL002 ? _((_(M|ybfibuslv)) & ((_(0|stat = "K")) ; (_(0|bu)) ; (_(0|gv))))
.set trans +
.box Hinweis
Es sind nur statistische Konten mit der Eigenschaft "Kostenrechnung" zulÑssig.
.set trans -
.assign M|.G|evtvar = ""
!EL002
.continue EL003 ? _((M|ybfibuslv) & ((_(F|empty(0|stat))) ; (_(0|bu)) ; (_(0|gv))))
.set trans +
.box Hinweis
Es sind nur GuV-Konten mit der Eigenschaft "Statistischen Konto" = [leer] erlaubt.
.set trans -
.assign M|.G|evtvar = ""
!EL003
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- CheckAllAccounts -----
.continue EL004 ? _(_(M|ybfibuslv))
.continue EL005 ? _(((_(F|empty(M|ykoartf))) & ((_(M|ykoartf^stat = "K")) ; (_(M|ykoartf^bu)) ; (_(M|ykoartf^gv)))) ; ((_(F|empty(M|yekoartf))) & ((_(M|yekoartf^stat = "K")) ; (_(M|yekoartf^bu)) ; (_(M|yekoartf^gv)))) ; ((_(F|empty(M|ykoartf))) & ((_(M|ykoartv^stat = "K")) ; (_(M|ykoartv^bu)) ; (_(M|ykoartv^gv)))) ; ((_(F|empty(M|yekoartv))) & ((_(M|yekoartv^stat = "K")) ; (_(M|yekoartv^bu)) ; (_(M|yekoartv^gv)))))
.set trans +
.box Hinweis
Bei dieser Einstellung dÅrfen nur statisitsche Konten mit der Eigenschaft "Kostenrechnung" eingetragen sein.
.set trans -
.copy M|ybfibuslv = G|true
!EL005
.continue FI004
!EL004
.continue EL006 ? _(((_(F|empty(M|ykoartf))) & ((_(F|empty(M|ykoartf^stat))) ; (_(M|ykoartf^bu)) ; (_(M|ykoartf^gv)))) ; ((_(F|empty(M|yekoartf))) & ((_(F|empty(M|yekoartf^stat))) ; (_(M|yekoartf^bu)) ; (_(M|yekoartf^gv)))) ; ((_(F|empty(M|ykoartf))) & ((_(F|empty(M|ykoartv^stat))) ; (_(M|ykoartv^bu)) ; (_(M|ykoartv^gv)))) ; ((_(F|empty(M|yekoartv))) & ((_(F|empty(M|yekoartv^stat))) ; (_(M|yekoartv^bu)) ; (_(M|yekoartv^gv)))))
.set trans +
.box Hinweis
Bei dieser Einstellung dÅrfen nur Fibu-Konten als Verrechnungskonten eingetragen sein.
.set trans -
.copy M|ybfibuslv = G|false
!EL006
!FI004
.continue 'xprocst.xprocsp'
