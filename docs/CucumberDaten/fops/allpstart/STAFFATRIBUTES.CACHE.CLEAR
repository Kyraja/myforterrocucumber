..!interpreter english declaration noabbrev
.. at 2016-11-04, 10:13
.set trans -
..========================================================================
..==  Name              : STAFFATRIBUTES.CACHE.CLEAR
..==  Pfad              : allpstart
..==  Funktion          : Maskenprogramm um den Cache der Kalenderauskunft zu leeren
..==  Erstellungsdatum  : 03.02.2015
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
..====================================================
.type bool    xbmehr        ? _F|defined(U|xbmehr)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue EL001 ? _((G|evtkommd = G|kaktname10) ; (G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.continue BRK001 ? _(G|evtmaske = 889)
.continue EL002 ? _((M|dispobezobj^dnr    = 150) & (M|dispobezobj^gruppe = 1))
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPS -c 'M|dispobezobj^id'
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPZE -c 'M|dispobezobj^id'   ? F|sysinfo(10)^ykonfigprjm^ypzebpze
.continue FI002
!EL002
.continue EL003 ? _((M|dispobezobj^dnr = 86) ; (M|dispobezobj^dnr = 97) ; (M|dispobezobj^dnr = 149) ; (M|stdkal))
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPS -a
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPZE -a  ? F|sysinfo(10)^ykonfigprjm^ypzebpze
!EL003
!FI002
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtmaske = 72)
.continue EL004 ? _((_(M|yprjmsplan    = F|oldvalue(M|yprjmsplan))) ; (_(M|yprjmstandort = F|oldvalue(M|yprjmstandort))) ; (G|evtkommd = G|kaktname10))
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPS -a
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPZE -a  ? F|sysinfo(10)^ykonfigprjm^ypzebpze
!EL004
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtmaske = 93)
.continue EL005 ? _((_(M|sollzeit = F|oldvalue(M|sollzeit))) ; (G|evtkommd = G|kaktname10))
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPS -a
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPZE -a  ? F|sysinfo(10)^ykonfigprjm^ypzebpze
!EL005
.continue ESAC001
!BRK003
.continue BRK004 ? _(G|evtmaske = 94)
.select screen header
.select screen line
.copy U|xbmehr = G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(U|xbmehr)
.continue EL006 ? _((_(M|tplan1 = F|oldvalue(M|tplan1))) ; (_(M|tplan2 = F|oldvalue(M|tplan2))) ; (_(M|tplan3 = F|oldvalue(M|tplan3))) ; (_(M|tplan4 = F|oldvalue(M|tplan4))) ; (_(M|tplan5 = F|oldvalue(M|tplan5))) ; (_(M|tplan6 = F|oldvalue(M|tplan6))) ; (_(M|tplan7 = F|oldvalue(M|tplan7))) ; (G|evtkommd = G|kaktname10))
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPS -a
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPZE -a  ? F|sysinfo(10)^ykonfigprjm^ypzebpze
.copy U|xbmehr = G|FALSE
.continue FI006
!EL006
.select screen line
.copy U|xbmehr = G|mehr
!FI006
.continue LOOP001
!ELOP001: ==============================
.continue ESAC001
!BRK004
!ESAC001: =====   ENDCASE   =====
!EL001
.continue
