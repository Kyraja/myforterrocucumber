!BRK001
.continue BRK002 ? _(0|yverdktrtpk = "02")
.formula U|xtverd = M|yverantwkst^yprjmzugvktr^id
.continue ESAC001
!BRK002
!REPT001: ==============================
.set trans +
.menu(0,0,0)Kostentr„geranlage
Welcher Verdichtungskostentr„ger soll im neu angelegten Verdichtungskostentr„ger hinterlegt werden?

Zugeh”riger Verdichtungskostentr„ger aus der verantwortlichen Kostenstelle.     >>.formula U|xtverd = M|yverantwkst^yprjmzugvktr^id
Verdichtungskostentr„ger aus Hauptprojekt.                                      >>.formula U|xtverd = M|yteilprojektzu^yktr^verd^id
.set trans -
.continue REPT001 ? _((G|menue = 3) ; (G|menue = 4))
!ESAC001: =====   ENDCASE   =====
!FI010
.continue 'xprocst.xprocsp'
!PROC005: ----- EDP_ausfuehren -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ybatchuser)
.assign G|neuespassw = 5|ybatchuser     ? _F|empty(5|ybatchuser) & 5|ybatchuser^fremdok
.formula U|xtsys = "edpimport.sh -c EKS -o UPDATEMODE=STRICT -T -r REF -p " + G|einmalpw + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.input "allpstart/FOP.ALL.EDP.CHECK"
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL011 ? _(((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14)) & (F|empty(M|yktr)) & (_(M|yprojekttyp^yprojvorlage)))
.file -tempname U|xtedpdat
