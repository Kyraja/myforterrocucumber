!PROC004: ----- Verdichtungsktr_zu_bebuchbarem_Ktr -----
.continue EL010 ? _((F|empty(M|yteilprojektzu)) ; (F|empty(M|yteilprojektzu^yktr)))
.formula U|xtverd = M|yverantwkst^yprjmzugvktr^id
.continue FI010
!EL010
.continue BRK001 ? _(0|yverdktrtpk = "01")
