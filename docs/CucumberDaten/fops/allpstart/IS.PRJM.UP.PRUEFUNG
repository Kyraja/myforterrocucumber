.colour -BACKGROUND 'U|xtfarbe0' yebene       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ystatus      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yname        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yfortschritt 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ytkunde      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yverantw     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ybz          'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yadatum      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yedatum      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yiststart    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yistend      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ydauer       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yreftyp      'M|aktzeile'
.formula U|xtdbgr = U|xydbgrprojekt     ?  M|ykenn = "0"
.formula U|xtdbgr = U|xydbgrpvorgang    ?  M|ykenn = "1"
.formula U|xtdbgr = U|xydbgraufgabe     ?  M|ykenn = "4"
.formula U|xtdbgr = U|xydbgrlnachweis   ?  M|ykenn = "5"
.continue FI001
!EL001
.colour -BACKGROUND 'U|xtfarbe0' tbaumstufe   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yname        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yebene       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ystatus      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yname        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yfortschritt 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ytkunde      'M|aktzeile'
