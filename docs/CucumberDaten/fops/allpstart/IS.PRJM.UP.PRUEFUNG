!EL016
.continue EL017 ? _(F|defined(M|ybstrpruef))
.continue EL018 ? _(((F|empty(M|yreferenz)) & ((_(F|empty(M|yreftyp))) ; (_(F|empty(M|yiststart))) ; (_(F|empty(M|yistend)))) & (_(M|yreftypk = "04"))) ; ((F|empty(M|yreftyp)) & ((_(F|empty(M|yreferenz))) ; (_(F|empty(M|yiststart))) ; (_(F|empty(M|yistend))))) ; ((F|empty(M|yiststart)) & ((_(F|empty(M|yreferenz))) ; (_(F|empty(M|yreftyp))) ; (_(F|empty(M|yistend))))) ; ((F|empty(M|yistend)) & ((_(F|empty(M|yreferenz))) ; (_(F|empty(M|yreftyp))) ; (_(F|empty(M|yiststart))))))
.formula xfleer = ""
.formula xfwert = ""
.set TRANS +
.formula U|xfleer  = G|dblquote + "Referenz" + G|dblquote                       ?  F|empty(M|yreferenz)
.formula U|xfleer  = U|xfleer + " " + G|dblquote + "Referenz-Typ" + G|dblquote  ?  F|empty(M|yreftyp)
.formula U|xfleer  = U|xfleer + " " + G|dblquote + "Ist-Start" + G|dblquote     ?  F|empty(M|yiststart)
.formula U|xfleer  = U|xfleer + " " + G|dblquote + "Ist-Ende" + G|dblquote      ?  F|empty(M|yistend)
.formula U|xfwert  = G|dblquote + "Referenz" + G|dblquote                       ? _F|empty(M|yreferenz)
.formula U|xfwert  = U|xfwert + " "  + G|dblquote + "Referenz-Typ" + G|dblquote ? _F|empty(M|yreftyp)
.formula U|xfwert  = U|xfwert + " "  + G|dblquote + "Ist-Start" + G|dblquote    ? _F|empty(M|yiststart)
.formula U|xfwert  = U|xfwert + " "  + G|dblquote + "Ist-Ende" + G|dblquote     ? _F|empty(M|yistend)
.formula M|yfehler = M|yfehler + ";"                                            ? _F|empty(M|yfehler)
.formula M|yfehler = M|yfehler + "Feld "+ U|xfleer + " muss gefllt sein wenn Feld " + U|xfwert + " mit Wert belegt wurde."
.set TRANS -
.colour -BACKGROUND 255 0 0 yreferenz 'M|aktzeile'                              ?  F|empty(M|yreferenz)
.colour -BACKGROUND 255 0 0 yreftyp   'M|aktzeile'                              ?  F|empty(M|yreftyp)
.colour -BACKGROUND 255 0 0 yiststart 'M|aktzeile'                              ?  F|empty(M|yiststart)
.colour -BACKGROUND 255 0 0 yistend  'M|aktzeile'                               ?  F|empty(M|yistend)
.formula U|xizerror = U|xizerror + 1                                            ?  F|empty(M|yreferenz)
.formula U|xizerror = U|xizerror + 1                                            ?  F|empty(M|yreftyp)
.formula U|xizerror = U|xizerror + 1                                            ?  F|empty(M|yiststart)
.formula U|xizerror = U|xizerror + 1                                            ?  F|empty(M|yistend)
!EL018
.continue EL019 ? _((M|ysollph <> M|ybersollph) & (_(M|yistblatt)))
