..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : IS.PRJM.UP.PRUEFUNG
..==  Pfad              : allpstart
..==  Funktion          : Unterprogramm zurPrfung der Projektwerte
..==  Erstellungsdatum  :
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2015 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text   xtdbgr             ? _F|defined(U|xtdbgr)
.type integer xprocsp           ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Verantworlicher_fehlt -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Feld " + G|dblquote + "Verantwortlicher" + G|dblquote + " muss gefllt sein. Bitte nachholen."
.set TRANS -
.colour -BACKGROUND 255 0 0 yverantw 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC002: ----- adatum_fehlt -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Start Datum nicht erfasst. Bitte nachtragen."
.set TRANS -
.colour -BACKGROUND 255 0 0 yadatum 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC003: ----- edatum_fehlt -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Ende Datum nicht erfasst. Bitte nachtragen."
.set TRANS -
.colour -BACKGROUND 255 0 0 yedatum 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC004: ----- adtum>edatum -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Start Datum muss kleiner als Ende Datum sein. Bitte „ndern."
.set TRANS -
.colour -BACKGROUND 255 0 0 yadatum 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC005: ----- Zeitraum<0 -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Feld " + G|dblquote + "Zeitraum" + G|dblquote + " muss Wert gr”áer 0 haben. Bitte „ndern."
.set TRANS -
.colour -BACKGROUND 255 0 0 ydauer 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC006: ----- Zeitraum_falsch -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Wert im Feld " + G|dblquote + "Zeitraum" + G|dblquote + " entspricht nicht der Differenz aus Start und Ende Datum. Bitte Termine bzw. Zeitraum „ndern."
.set TRANS -
.colour -BACKGROUND 255 0 0 ydauer 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC007: ----- fakturierbare_Zeit_falsch -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Fakturierbare Zeit ist im Vorgang nicht korrekt eingetragen."
.set TRANS -
.colour -BACKGROUND 255 0 0 yname 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!PROC008: ----- ist_Zeit_falsch -----
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
.set TRANS +
.formula M|yfehler = M|yfehler + "Ist Zeit ist im Vorgang nicht korrekt eingetragen."
.set TRANS -
.colour -BACKGROUND 255 0 0 yname 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula M|yzerror = 0
.formula M|yfehler = ""
.continue EL001 ? _((F|defined(M|ybprojektversion)) ; (F|defined(M|ybimportexport)))
.colour -BACKGROUND 'U|xtfarbe0' tbaumstufe   'M|aktzeile'
