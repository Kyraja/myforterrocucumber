.colour -BACKGROUND 'U|xtfarbe0' yreferenz    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yreftyp      'M|aktzeile'
.formula U|xtdbgr  = 'M|yobjekt^dnr' + ":" + 'M|yobjekt^gruppe'
!FI001
.continue BRK001 ? _(U|xtdbgr = U|xydbgrprojekt)
.continue EL002 ? _(M|tbaumstufe = 0)
