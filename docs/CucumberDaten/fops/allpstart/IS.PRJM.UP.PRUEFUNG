.set TRANS -
.colour -BACKGROUND 255 0 0 ybz 'M|aktzeile'
.formula U|xizerror = U|xizerror + 1
!EL008
.continue FI007
!EL007
.continue EL009 ? _(F|empty(M|ytprojleit))
.formula M|yfehler = M|yfehler + ";"            ? _F|empty(M|yfehler)
