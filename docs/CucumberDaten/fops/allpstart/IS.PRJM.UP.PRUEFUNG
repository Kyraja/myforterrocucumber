.set TRANS +
.formula M|yfehler = M|yfehler + "Sammelvorgang " + G|dblquote + M|yobjekt^ygehoertzu^nummer + " / " + M|yobjekt^ygehoertzu^namebspr + G|dblquote + " ist nicht als Sammelvorgang gekennzeichnet."
.set TRANS -
