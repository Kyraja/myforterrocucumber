..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtcmd xtsys xtsel xtftext xtdatei xtid xtprojekt xtprojsuch xtverantwkst xtapid xtapsuch xtpvid xtgewerkid xtgewerksuch
.type text    xtsumme xtsumap xtsumgewerk xtsumekbe xtsumekls xtsumekre xtsummatumbu xtsumtpva
.type text    xykoobjekt xtindex xtsap xtsgew
.type integer xityp xidatei xi1
.type real    xrnwert   xrpwert   xrostwert   xroffliwert   xroffrewert   xrgesnwert xrgespwert xrgesostwert xrgesoffliwert xrgesoffrewert
.type real    xrapnwert xrappwert xrapostwert xrapoffliwert xrapoffrewert xrsapnwert xrsappwert xrsapostwert xrsapoffliwert xrsapoffrewert
.type real    xrgnwert  xrgpwert  xrgostwert  xrgoffliwert  xrgoffrewert  xrsgnwert  xrsgpwert  xrsgostwert  xrsgoffliwert  xrsgoffrewert
.type realx   xxkurs        ? _F|defined(U|xxkurs)
.type GD19    xdbis
.type bool    xyberlaubt xbmehr xbok xbwipsel
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Summenzeile -----
.continue EL001 ? _(M|aktzeile > 0)
.formula U|xtsap  = U|xtsumap + " "     + M|ytarbpaket^such
.formula U|xtsgew = U|xtsumgewerk + " " + M|ytklassifizierung^such
.continue EL002 ? _((M|ybsummearbpaket) & (M|ytarbpaket^id <> U|xtapid) & ((_(F|empty(U|xtapid))) ; (_(F|empty(M|ytarbpaket)))))
.formula U|xi1 = M|yttyp
.make screen line +O
.formula M|yttyp       = U|xi1
.formula M|ytnwert     = U|xrapnwert
.formula M|ytpwert     = U|xrappwert
.formula M|ytostwert   = U|xrapostwert
.formula M|ytoffliwert = U|xrapoffliwert
.formula M|ytoffrewert = U|xrapoffrewert
.formula M|ytptext     = U|xtsap
.colour -background "144 238 144"            'M|aktzeile'
.colour -foreground "112 206 112" ytofflimge 'M|aktzeile'
.colour -foreground "112 206 112" ytoffremge 'M|aktzeile'
.formula U|xrapnwert     = 0
.formula U|xrappwert     = 0
.formula U|xrapostwert   = 0
.formula U|xrapoffliwert = 0
.formula U|xrapoffrewert = 0
!EL002
.continue EL003 ? _((M|ybsummegewerk) & (M|ytklassifizierung^id <> U|xtgewerkid) & ((_(F|empty(U|xtgewerkid))) ; (_(F|empty(M|ytklassifizierung)))))
.formula U|xi1 = M|yttyp
.make screen line +O
.formula M|yttyp       = U|xi1
.formula M|ytnwert     = U|xrgnwert
.formula M|ytpwert     = U|xrgpwert
.formula M|ytostwert   = U|xrgostwert
.formula M|ytoffliwert = U|xrgoffliwert
.formula M|ytoffrewert = U|xrgoffrewert
.formula M|ytptext     = U|xtsgew
.colour -background "144 238 144"            'M|aktzeile'
.colour -foreground "112 206 112" ytofflimge 'M|aktzeile'
.colour -foreground "112 206 112" ytoffremge 'M|aktzeile'
.formula U|xrgnwert     = 0
.formula U|xrgpwert     = 0
.formula U|xrgostwert   = 0
.formula U|xrgoffliwert = 0
.formula U|xrgoffrewert = 0
!EL003
.continue EL004 ? _(M|yttyp <> U|xityp)
.continue EL005 ? _(M|ybsummearbpaket)
.formula U|xi1 = M|yttyp
.make screen line +O
.formula M|yttyp       = U|xi1
.formula M|ytnwert     = U|xrsapnwert
.formula M|ytpwert     = U|xrsappwert
.formula M|ytostwert   = U|xrsapostwert
.formula M|ytoffliwert = U|xrsapoffliwert
.formula M|ytoffrewert = U|xrsapoffrewert
.formula M|ytptext     = U|xtsumap
.colour -background "144 238 144"            'M|aktzeile'
.colour -foreground "112 206 112" ytofflimge 'M|aktzeile'
.colour -foreground "112 206 112" ytoffremge 'M|aktzeile'
.formula U|xrsapnwert     = 0
.formula U|xrsappwert     = 0
.formula U|xrsapostwert   = 0
.formula U|xrsapoffliwert = 0
.formula U|xrsapoffrewert = 0
!EL005
.continue EL006 ? _(M|ybsummegewerk)
.formula U|xi1 = M|yttyp
.make screen line +O
.formula M|yttyp       = U|xi1
.formula M|ytnwert     = U|xrsgnwert
.formula M|ytpwert     = U|xrsgpwert
.formula M|ytostwert   = U|xrsgostwert
.formula M|ytoffliwert = U|xrsgoffliwert
.formula M|ytoffrewert = U|xrsgoffrewert
.formula M|ytptext     = U|xtsumgewerk
.colour -background "144 238 144"            'M|aktzeile'
.colour -foreground "112 206 112" ytofflimge 'M|aktzeile'
.colour -foreground "112 206 112" ytoffremge 'M|aktzeile'
.formula U|xrsgnwert     = 0
.formula U|xrsgpwert     = 0
.formula U|xrsgostwert   = 0
.formula U|xrsgoffliwert = 0
.formula U|xrsgoffrewert = 0
!EL006
.formula U|xi1 = M|yttyp
.make screen line +O
.formula M|yttyp       = U|xi1
.formula M|ytnwert     = U|xrnwert
.formula M|ytpwert     = U|xrpwert
.formula M|ytostwert   = U|xrostwert
.formula M|ytoffliwert = U|xroffliwert
.formula M|ytoffrewert = U|xroffrewert
.formula M|ytptext     = U|xtsumekbe        ? M|yttyp = 3
.formula M|ytptext     = U|xtsumekls        ? M|yttyp = 4
.formula M|ytptext     = U|xtsumekre        ? M|yttyp = 5
.formula M|ytptext     = U|xtsummatumbu     ? M|yttyp = 70
.formula M|ytptext     = U|xtsumtpva        ? M|yttyp = 80
.colour -background "144 238 144"            'M|aktzeile'
.colour -foreground "112 206 112" ytofflimge 'M|aktzeile'
.colour -foreground "112 206 112" ytoffremge 'M|aktzeile'
.formula U|xrnwert     = 0
.formula U|xrpwert     = 0
.formula U|xrostwert   = 0
.formula U|xroffliwert = 0
.formula U|xroffrewert = 0
!EL004
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.copy   M|ybekbe        = G|TRUE
.copy   M|ybekls        = G|TRUE
.copy   M|ybekre        = G|TRUE
.copy   M|ybmatbu       = G|TRUE
.copy   M|ybvanf        = G|TRUE
.copy   M|ybwiprelev    = G|TRUE
.copy   M|ybsonstkost   = G|TRUE
.copy   M|ybnichtwiprel = G|TRUE
.assign M|yablageartk   = "(3)"
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldfuell")
.continue BRK003 ? _(G|evtvar = "yarbpaket")
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK004 ? _(G|evtart = "feldaus")
.continue BRK005 ? _(G|evtvar = "yvonbudat")
.continue EL007 ? _(_(F|empty(M|yvonbudat)))
.formula U|xdbis     = ">" + 'F|year(M|yvonbudat)' + "Y" + 'F|month(M|yvonbudat)' + "M"
.formula M|ybisbudat = U|xdbis
!EL007
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "ybisbudat")
.continue EL008 ? _((M|ybisbudat < M|yvonbudat) & (_(F|empty(M|ybisbudat))))
.formula U|xdbis     = ">" + 'F|year(M|yvonbudat)' + "Y" + 'F|month(M|yvonbudat)' + "M"
.formula M|ybisbudat = U|xdbis
!EL008
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.input 'U|xtupprjmsel'
.continue ESAC001
!BRK004
.continue BRK007 ? _(G|evtart = "buttonvor")
.continue BRK008 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC004
!BRK008
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK007
.continue BRK009 ? _(G|evtart = "buttonnach")
.continue BRK010 ? _(G|evtvar = "bstart")
.continue EL009 ? _((M|ybwiprelev) ; (M|ybsonstkost) ; (M|ybnichtwiprel))
.text U|xtsumme      'G|bsprache' Summe
.text U|xtsumekbe    'G|bsprache' Summe EK Bestellungen
.text U|xtsumekls    'G|bsprache' Summe EK Lieferscheine
.text U|xtsumekre    'G|bsprache' Summe EK Rechnungen
.text U|xtsummatumbu 'G|bsprache' Summe Materialumbuchungen
.text U|xtsumtpva    'G|bsprache' Summe Verrechnungsanforderungen
.text U|xtsumap      'G|bsprache' Summe Arbeitspaket
.text U|xtsumgewerk  'G|bsprache' Summe Gewerk
.copy U|xbwipsel = G|FALSE
.continue EL010 ? _((_(M|ybwiprelev)) ; (_(M|ybsonstkost)) ; (_(M|ybnichtwiprel)))
.continue EL011 ? _(F|empty(M|ywipkonfighist))
.load 5 add F|sysinfo(10)^ykonfigprjm
.continue EL012 ? _(_(F|empty(5|ypmsonstkost)))
.load 8 add 5|ypmsonstkost
.continue EL013 ? _(G|mehr)
.load 8 line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL014 ? _((_(F|empty(8|konto))) & (8|konto^dnr    = 5) & (8|konto^gruppe = 1))
.formula U|xtindex = 8|konto^nummer
.type text xtsonstkost.xtindex          ? _F|defined(U|xtsonstkost.xtindex)
.formula U|xtsonstkost.xtindex = 8|konto^id
!EL014
.load 8 line
.continue LOOP001
!ELOP001: ==============================
!EL013
!EL012
.continue EL015 ? _(_(F|empty(5|ypmnrelkost)))
.load 8 add 5|ypmnrelkost
.continue EL016 ? _(G|mehr)
.load 8 line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL017 ? _((_(F|empty(8|konto))) & (8|konto^dnr    = 5) & (8|konto^gruppe = 1))
.formula U|xtindex = 8|konto^nummer
.type text xtnrelkost.xtindex           ? _F|defined(U|xtnrelkost.xtindex)
.formula U|xtnrelkost.xtindex = 8|konto^id
!EL017
.load 8 line
.continue LOOP002
!ELOP002: ==============================
!EL016
!EL015
.continue FI011
!EL011
.load 5 add M|ywipkonfighist
.continue EL018 ? _(_(F|empty(5|yktosonstkost)))
.load 8 add 5|yktosonstkost
.continue EL019 ? _(G|mehr)
.load 8 line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL020 ? _((_(F|empty(8|konto))) & (8|konto^dnr    = 5) & (8|konto^gruppe = 1))
.formula U|xtindex = 8|konto^nummer
.type text xtsonstkost.xtindex          ? _F|defined(U|xtsonstkost.xtindex)
.formula U|xtsonstkost.xtindex = 8|konto^id
!EL020
.load 8 line
.continue LOOP003
!ELOP003: ==============================
!EL019
!EL018
.continue EL021 ? _(_(F|empty(5|yktonrelkost)))
.load 8 add 5|yktonrelkost
.continue EL022 ? _(G|mehr)
.load 8 line
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL023 ? _((_(F|empty(8|konto))) & (8|konto^dnr    = 5) & (8|konto^gruppe = 1))
.formula U|xtindex = 8|konto^nummer
.type text xtnrelkost.xtindex           ? _F|defined(U|xtnrelkost.xtindex)
.formula U|xtnrelkost.xtindex = 8|konto^id
!EL023
.load 8 line
.continue LOOP004
!ELOP004: ==============================
!EL022
!EL021
!FI011
.copy U|xbwipsel = G|TRUE
!EL010
.file -TEMPNAME U|xtdatei
.input DATEI.F
.output NEW 'U|xtdatei'
.input 'U|xtupprjmsel'
.output NEW WERF.WEG
.formula U|xtsys = "sort -t#"
.formula U|xtsys = U|xtsys + " -k1,1n"
.formula U|xtsys = U|xtsys + " -k7,7"       ?  M|ybsummearbpaket
.formula U|xtsys = U|xtsys + " -k9,9"       ?  M|ybsummegewerk
.formula U|xtsys = U|xtsys + " -k3,3"
.formula U|xtsys = U|xtsys + " -o " + U|xtdatei + " " + U|xtdatei
.system 'U|xtsys' BACKGROUND
.continue EL024 ? _(F|filenotempty(U|xtdatei))
.input is/ABASFARBEN.DEF
.file -OPEN U|xidatei 'U|xtdatei'
.file -READ U|xidatei xityp # xtid # xtprojekt # xtprojsuch # xtverantwkst # xtapid # xtapsuch # xtgewerkid # xtgewerksuch # xtpvid #
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.select object 'U|xtid'
.continue EL025 ? _(G|mehr)
.continue EL026 ? _(H|dnr = 4)
.copy U|xbok = G|TRUE
.make screen line +O
.formula M|ytbuaktion  = "icon:view"
.formula M|ytobjekt    = H|id
.formula M|yttyp       = U|xityp
.formula M|ytprojekt   = U|xtprojekt
.copy    M|ytlief      = H|lief
.formula M|ytliefname  = M|ytlief^namebspr
.formula M|ytnummer    = H|kopf^nummer
.formula M|ytvom       = H|kovom
.formula M|ytbudat     = H|kopf^budat
.copy    M|ytartex     = H|artex
.formula M|ytptext     = H|ptext
.formula M|ytmge       = H|mge
.copy    M|yteinh      = H|he                           ? _F|empty(H|he)
.formula M|ytepreis    = H|preis
.copy    M|ytkonto     = H|konto
.assign  M|ytarbpaket        = U|xtapid
.assign  M|ytklassifizierung = U|xtgewerkid
.assign  M|ytpvorgang        = U|xtpvid
.formula U|xxkurs = 1                               ?  H|pland = G|inland
.formula U|xxkurs = F|fxrate(G|inland, , H|pland)   ? _H|pland = G|inland & _H|kopf^kursfix
.formula U|xxkurs = H|kopf^ewkurs                   ? _H|pland = G|inland &  H|kopf^kursfix
.formula M|ytpwert      = H|pwert * U|xxkurs
.formula M|ytnwert      = H|nwert * U|xxkurs
.formula M|ytostwert    = H|pwert             * U|xxkurs                ? _H|kobrutto
.formula M|ytostwert    =(H|pwert - H|stwert) * U|xxkurs                ?  H|kobrutto
.formula M|ytoffremge   = H|remge
.continue EL027 ? _(H|kotyp = G|ABKO)
.formula U|xtsel = "$,,orig==" + H|id + ";kotyp==(" + 'G|LIKO' + ");@ablageart=(3)"
.load 9 group "4:2" 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.formula M|ytoffremge   = M|ytoffremge + 9|remge    ? _9|kopf^uebertr
.load 9 continue
.continue LOOP006
!ELOP006: ==============================
!EL027
.formula M|ytofflimge   = H|limge
.continue EL028 ? _(H|mge = 0)
.formula M|ytofflimge  = M|ytofflimge * U|xxkurs
.formula M|ytoffremge  = M|ytoffremge * U|xxkurs
.continue EL029 ? _(H|pwert = 0)
.formula M|ytoffliwert = M|ytofflimge
.formula M|ytoffrewert = M|ytoffremge
.continue FI029
!EL029
.formula M|ytoffliwert = H|nwert / H|pwert * M|ytofflimge
.formula M|ytoffrewert = H|nwert / H|pwert * M|ytoffremge
!FI029
.continue FI028
!EL028
.formula M|ytoffliwert = H|nwert / H|mge * M|ytofflimge * U|xxkurs
.formula M|ytoffrewert = H|nwert / H|mge * M|ytoffremge * U|xxkurs
!FI028
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
!EL026
.continue EL030 ? _((H|dnr    = U|xydbmatumbu) & (H|gruppe = U|xygrmatumbu))
.copy U|xbok = G|TRUE
.make screen line +O
.formula M|ytbuaktion  = "icon:view"
.formula M|yttyp       = U|xityp
.formula M|ytobjekt    = H|id
.formula M|ytprojekt   = U|xtprojekt
.formula M|ytnummer    = H|nummer
.formula M|ytvom       = H|erfass
.formula M|ytbudat     = H|ybudat
.formula M|ytptext     = H|ybutext
.formula M|ytnwert     = H|ybetrag * (-1)               ? H|yvonprojekt^id  = M|ytprojekt^id
.formula M|ytnwert     = H|ybetrag                      ? H|ynachprojekt^id = M|ytprojekt^id
.formula M|ytpwert     = M|ytnwert
.formula M|ytostwert   = M|ytnwert
.assign  M|ytarbpaket        = U|xtapid
.assign  M|ytklassifizierung = U|xtgewerkid
.assign  M|ytpvorgang        = U|xtpvid
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
!EL030
.continue EL031 ? _((H|dnr    = U|xydbtpverrechanf) & (H|gruppe = U|xygrtpverrechanf))
.copy U|xbok = G|TRUE
.make screen line +O
.formula M|ytbuaktion  = "icon:view"
.formula M|yttyp       = U|xityp
.formula M|ytobjekt    = H|id
.formula M|ytprojekt   = U|xtprojekt
.formula M|ytnummer    = H|nummer
.formula M|ytvom       = H|erfass
.formula M|ytbudat     = H|ydatum
.formula M|ytptext     = H|name
.formula M|ytnwert     = H|ybetrag
.formula M|ytpwert     = H|ybetrag
.formula M|ytostwert   = H|ybetrag
.assign  M|ytarbpaket        = U|xtapid
.assign  M|ytklassifizierung = U|xtgewerkid
.assign  M|ytpvorgang        = U|xtpvid
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
!EL031
!EL025
.continue EL032 ? _(U|xbok)
.formula U|xrapnwert      = U|xrapnwert      + M|ytnwert
.formula U|xrappwert      = U|xrappwert      + M|ytpwert
.formula U|xrapostwert    = U|xrapostwert    + M|ytostwert
.formula U|xrapoffliwert  = U|xrapoffliwert  + M|ytoffliwert
.formula U|xrapoffrewert  = U|xrapoffrewert  + M|ytoffrewert
.formula U|xrsapnwert     = U|xrsapnwert     + M|ytnwert
.formula U|xrsappwert     = U|xrsappwert     + M|ytpwert
.formula U|xrsapostwert   = U|xrsapostwert   + M|ytostwert
.formula U|xrsapoffliwert = U|xrsapoffliwert + M|ytoffliwert
.formula U|xrsapoffrewert = U|xrsapoffrewert + M|ytoffrewert
.formula U|xrgnwert       = U|xrgnwert       + M|ytnwert
.formula U|xrgpwert       = U|xrgpwert       + M|ytpwert
.formula U|xrgostwert     = U|xrgostwert     + M|ytostwert
.formula U|xrgoffliwert   = U|xrgoffliwert   + M|ytoffliwert
.formula U|xrgoffrewert   = U|xrgoffrewert   + M|ytoffrewert
.formula U|xrsgnwert      = U|xrsgnwert      + M|ytnwert
.formula U|xrsgpwert      = U|xrsgpwert      + M|ytpwert
.formula U|xrsgostwert    = U|xrsgostwert    + M|ytostwert
.formula U|xrsgoffliwert  = U|xrsgoffliwert  + M|ytoffliwert
.formula U|xrsgoffrewert  = U|xrsgoffrewert  + M|ytoffrewert
.formula U|xrnwert        = U|xrnwert        + M|ytnwert
.formula U|xrpwert        = U|xrpwert        + M|ytpwert
.formula U|xrostwert      = U|xrostwert      + M|ytostwert
.formula U|xroffliwert    = U|xroffliwert    + M|ytoffliwert
.formula U|xroffrewert    = U|xroffrewert    + M|ytoffrewert
.formula U|xrgesnwert     = U|xrgesnwert     + M|ytnwert
.formula U|xrgespwert     = U|xrgespwert     + M|ytpwert
.formula U|xrgesostwert   = U|xrgesostwert   + M|ytostwert
.formula U|xrgesoffliwert = U|xrgesoffliwert + M|ytoffliwert
.formula U|xrgesoffrewert = U|xrgesoffrewert + M|ytoffrewert
!EL032
.copy U|xbok = G|FALSE
.file -READ U|xidatei xityp # xtid # xtprojekt # xtprojsuch # xtverantwkst # xtapid # xtapsuch # xtgewerkid # xtgewerksuch # xtpvid #
.continue LOOP005
!ELOP005: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue EL033 ? _(M|aktzeile > 0)
.make screen line +O
.formula M|ytnwert     = U|xrgesnwert
.formula M|ytpwert     = U|xrgespwert
.formula M|ytostwert   = U|xrgesostwert
.formula M|ytoffliwert = U|xrgesoffliwert
.formula M|ytoffrewert = U|xrgesoffrewert
.translate -LANGUAGE 'G|bsprache' -TEXT "Gesamtsumme" -VARIABLE M|ytptext
.formula M|ytptext  = "Gesamtsumme"                     ? F|empty(M|ytptext)
