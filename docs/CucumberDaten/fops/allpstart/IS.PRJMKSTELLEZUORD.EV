..!interpreter english declaration noabbrev
.. at 2017-03-06, 13:03
.set trans -
..========================================================================
..==  Name              : IS.PRJMKSTELLEZUORD.EV
..==  Pfad              : allpstart
..==  Funktion          : Maskenprogramm an der Eigenschaftszuordnung
..==  Erstellungsdatum  : 2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtbox xtpersind xtkzind
.type bool    xbmehr
.type integer xizeile xi1
.type GD      xdvon xdbis
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Speichern -----
.input "is/ABASFARBEN.DEF"
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ypmkstzukueberschn)
.continue EL001 ? _(5|ypmkstzukueberschn)
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL002 ? _(M|ytmark)
.continue EL003 ? _((_(F|empty(M|ytpersonal))) & (_(F|empty(M|ytkstelle))))
.formula U|xtpersind = M|ytpersonal^nummer
.formula U|xtkzind   = M|ytkstzuord^nummer
.continue EL004 ? _(_(F|empty(M|ytkstzuord)))
.type text    xtkstzu.xtkzind
.type GD      xdvon.xtkzind xdbis.xtkzind
.type integer xikzeile.xtkzind
.formula U|xtkstzu.xtkzind  = M|ytkstzuord^nummer
.formula U|xdvon.xtkzind    = M|ytvon
.formula U|xdbis.xtkzind    = M|ytbis
.formula U|xikzeile.xtkzind = M|aktzeile
!EL004
!EL003
!EL002
.select screen line
.continue LOOP001
!ELOP001: ==============================
!EL001
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL005 ? _(M|ytmark)
.continue EL006 ? _((F|empty(M|ytpersonal)) ; (F|empty(M|ytvon)))
.set TRANS +
.box
Bitte Personal und Zugeordnet ab in Zeile 'M|aktzeile' fÅllen!
.set TRANS -
.cursor ytpersonal 'M|aktzeile' ?  F|empty(M|ytpersonal)
.cursor ytvon      'M|aktzeile' ?  F|empty(M|ytvon)
.error
.formula G|evtfeldneu = M|.evtvar        ?  G|evtart = "feldfuell"
.end 1
.continue FI006
!EL006
.continue EL007 ? _(5|ypmkstzukueberschn)
.formula M|select = "$,,"
.formula M|select = M|select + ";ypersonal==" +  M|ytpersonal^id
.formula M|select = M|select + ";@ablageart=(1)"
.formula M|select = M|select + ";@ordnung=yvon"
.load 9 group 'U|xydbgrkstellezuord' 'M|select'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xtkzind = 9|nummer
.assign U|xdvon = 9|yvon
.assign U|xdvon = U|xdvon.xtkzind       ? F|defined(U|xdvon.xtkzind)
.assign U|xdbis = 9|ybis
.assign U|xdbis = U|xdbis.xtkzind       ? F|defined(U|xdbis.xtkzind)
.continue EL008 ? _((M|ytkstzuord^id <> 9|id) & ((M|ytvon <= U|xdbis) ; (F|empty(U|xdbis)) ; (F|empty(M|ytvon))) & ((M|ytbis >= U|xdvon) ; (F|empty(U|xdvon)) ; (F|empty(M|ytbis))))
.set TRANS +
.box Fehler
öberschneidung des GÅltigkeitszeitraums in Zeile 'M|aktzeile' mit Kostenstellenzuordnung
?'9|nummer': 'U|xdvon' bis 'U|xdbis' in Zeile 'U|xikzeile.xtkzind'      ?  F|defined(U|xikzeile.xtkzind)
?'9|nummer': 'U|xdvon' bis 'U|xdbis'                                    ? _F|defined(U|xikzeile.xtkzind)
.set TRANS -
.cursor ytvon      'M|aktzeile'
.error
.formula G|evtfeldneu = M|.evtvar        ?  G|evtart = "feldfuell"
.end 1
!EL008
.load 9 continue
.continue LOOP003
!ELOP003: ==============================
!EL007
.continue EL009 ? _(F|empty(M|ytkstzuord))
.formula U|xtcmd = "make " + G|hdatname.xydbkstellezuord + " group" + 'U|xygrkstellezuord'
.'U|xtcmd'
.formula H|such = M|ytpersonal^such
.continue FI009
!EL009
.select lock add M|ytkstzuord
.continue EL010 ? _(_(G|mehr))
.set TRANS +
.box
Die Kostenstellenzuordnung in Zeile 'M|aktzeile' konnte nicht bearbeitet werden.
.set TRANS -
.cursor ytpersonal 'M|aktzeile'
.error
.formula G|evtfeldneu = M|.evtvar        ?  G|evtart = "feldfuell"
.end 1
!EL010
!FI009
.copy   H|ypersonal   = M|ytpersonal
.copy   H|ykstelle    = M|ytkstelle
.assign H|yvon        = M|ytvon
.assign H|ybis        = M|ytbis
.copy   H|yvollleiart = M|yvollleiart
.copy   H|ywipleiart  = M|ywipleiart
.copy   H|ygkleiart   = M|ygkleiart
.copy   H|ysplan      = M|ysplan
.copy   H|ystandort   = M|ystandort
.rewrite
.copy   M|ytmark      = G|false
.assign M|ytkstzuord  = H|id ?  F|empty(M|ytkstzuord)
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPS -c 'M|ytpersonal^id'
.input java:de.alltrotec.ps.tools.StaffAttributeCacheControl@ALLPZE -c 'M|ytpersonal^id'    ? F|sysinfo(10)^ykonfigprjm^ypzebpze
.continue EL011 ? _(5|ypmkstzukueberschn)
.formula U|xtpersind = M|ytpersonal^nummer
.formula U|xtkzind   = M|ytkstzuord^nummer
.continue EL012 ? _(_(F|defined(U|xtkstzu.xtkzind)))
.type text    xtkstzu.xtkzind
.type GD      xdvon.xtkzind xdbis.xtkzind
.type integer xikzeile.xtkzind
.formula U|xtkstzu.xtkzind  = M|ytkstzuord^nummer
.formula U|xdvon.xtkzind    = M|ytvon
.formula U|xdbis.xtkzind    = M|ytbis
.formula U|xikzeile.xtkzind = M|aktzeile
!EL012
!EL011
!FI006
!EL005
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Nachfrage_ob_speichern -----
.continue EL013 ? _(M|tzeilen > 0)
.select screen header
.select screen line "$,,ytmark==(Yes)"
.copy U|xbmehr = G|mehr
!LOOP004: ==============================
.continue ELOP004 ? _(U|xbmehr)
.continue EL014 ? _(M|ytmark)
.formula U|xtbox = "yes:no:cancel"    ? _G|evtart = "maskabbr"
.formula U|xtbox = "yes:no"           ?  G|evtart = "maskabbr"
.set trans +
.formula U|xtsel = "Achtung"
.box -button 'U|xtbox' -title 'U|xtsel'
Es wurden nicht alle Zeilen gespeichert.

Jetzt speichern?
.set trans -
.continue BRK001 ? _(G|box = G|boxyes)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|box = G|boxcancel)
.formula G|evtfeldneu = M|.evtvar       ? G|evtart = "feldfuell"
.error                                  ? G|evtart = "maskpruef"
.end 1                                  ? G|evtart = "maskpruef"
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
.make screen line --O   ? G|evtart = "feldfuell" & _G|box = G|boxcancel
.copy U|xbmehr = G|false
.continue FI014
!EL014
.select screen line
.copy U|xbmehr = G|mehr
!FI014
.continue LOOP004
!ELOP004: ==============================
!EL013
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK003 ? _(G|evtart = "maskein")
.formula M|yvon = (G|datum:8)<<4 + "0101"
.formula M|ybis = (G|datum:8)<<4 + "1231"
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtart = "maskpruef")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtart = "maskabbr")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtart = "maskende")
.end 1  ? M|ybmaskezu
.continue ESAC002
!BRK006
.continue BRK007 ? _(G|evtart = "buttonvor")
.make screen line --O
.continue ESAC002
!BRK007
.continue BRK008 ? _(G|evtart = "buttonvor")
.continue BRK009 ? _(G|evtvar = "bstart")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK009
!ESAC003: =====   ENDCASE   =====
.continue ESAC002
!BRK008
.continue BRK010 ? _(G|evtart = "buttonnach")
.continue BRK011 ? _(G|evtvar = "bstart")
.formula M|select = "$,,"
.formula M|select = M|select + ";ypersonal==" +  M|ypersonal^id          ? _F|empty(M|ypersonal)
.formula M|select = M|select + ";ykstelle=="  +  M|ykstelle^id           ? _F|empty(M|ykstelle)
.formula M|select = M|select + ";@ablageart=(1)"
.formula M|select = M|select + ";@ordnung=yvon"
.select group 'U|xydbgrkstellezuord' 'M|select'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL015 ? _(((F|empty(H|yvon)) ; (F|empty(M|ybis)) ; (H|yvon <= M|ybis)) & ((F|empty(H|ybis)) ; (F|empty(M|yvon)) ; (H|ybis >= M|yvon)))
.make screen line +O
.assign  M|ytkstzuord  = H|id
.copy    M|ytpersonal  = H|ypersonal
.formula M|ytpersname  = H|ypersonal^namebspr
.copy    M|ytkstelle   = H|ykstelle
.formula M|ytkstname   = H|ykstelle^namebspr
.formula M|ytvon       = H|yvon
.formula M|ytbis       = H|ybis
.copy    M|yvollleiart = H|yvollleiart
.copy    M|ywipleiart  = H|ywipleiart
.copy    M|ygkleiart   = H|ygkleiart
.copy    M|ysplan      = H|ysplan
.copy    M|ystandort   = H|ystandort
!EL015
.select continue
.continue LOOP005
!ELOP005: ==============================
.continue ESAC004
!BRK011
.continue BRK012 ? _(G|evtvar = "ybuspeichern")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK012
.continue BRK013 ? _(G|evtvar = "ybustammma")
.continue EL016 ? _((F|empty(M|ykstelle)) ; (_(F|empty(M|ypersonal))))
.set TRANS +
.box Hinweis
Diese Funktion ist nur nutzbar wenn ausschlie·lich eine Kostenstelle selektiert wurde.
.set TRANS -
.continue FI016
!EL016
.formula U|xtsel = "$,,kstelle==" + M|ykstelle^id + ";@filingmode=(Active)"
.select group 'U|xydbgrpersonal' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.make screen line +O
.assign  M|ytpersonal = H|id
.formula M|ytpersname = H|namebspr
.assign  M|ytkstelle  = H|kstelle^id
.formula M|ytkstname  = H|kstelle^namebspr
.copy    M|ywipleiart = H|yprjmwipleiart
.copy    M|ygkleiart  = H|yprjmgkleiart
.protection -line 'M|aktzeile'
.select continue
.continue LOOP006
!ELOP006: ==============================
!FI016
.continue ESAC004
!BRK013
.continue BRK014 ? _(G|evtvar = "ybumarkall")
.select screen header
.select screen line
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.copy M|ytmark = G|true
.select screen line
.continue LOOP007
!ELOP007: ==============================
.continue ESAC004
!BRK014
.continue BRK015 ? _(G|evtvar = "ybudemarkall")
.select screen header
.select screen line
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.copy M|ytmark = G|false
.select screen line
.continue LOOP008
!ELOP008: ==============================
.continue ESAC004
!BRK015
!ESAC004: =====   ENDCASE   =====
.continue ESAC002
!BRK010
.continue BRK016 ? _(G|evtart = "feldfuell")
.continue EL017 ? _(M|aktzeile = 0)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
!EL017
.continue ESAC002
!BRK016
.continue BRK017 ? _(G|evtart = "feldaus")
.continue BRK018 ? _(G|evtvar = "ypersonal")
.assign M|yperskstelle   = M|ypersonal^kstelle^id
.copy   M|ypersleiart    = M|ypersonal^yprjmleiart
.copy   M|yperswipleiart = M|ypersonal^yprjmwipleiart
.copy   M|ypersgkleiart  = M|ypersonal^yprjmgkleiart
.continue ESAC005
!BRK018
.continue BRK019 ? _(G|evtvar = "yvon")
.assign M|ybis = ""     ? M|yvon > M|ybis
.continue ESAC005
!BRK019
.continue BRK020 ? _(G|evtvar = "ybis")
.assign M|yvon = ""     ? M|yvon > M|ybis
.continue ESAC005
!BRK020
.continue BRK021 ? _(G|evtvar = "ytvon")
.assign M|ytbis = ""    ? M|ytvon > M|ytbis
.continue ESAC005
!BRK021
.continue BRK022 ? _(G|evtvar = "ytbis")
.assign M|ytvon = ""    ? M|ytvon > M|ytbis
.continue ESAC005
!BRK022
.continue BRK023 ? _(G|evtvar = "ytpersonal")
.formula M|ytpersname = M|ytpersonal^namebspr
.continue ESAC005
!BRK023
.continue BRK024 ? _(G|evtvar = "ytkstelle")
.formula M|ytkstname  = M|ytkstelle^namebspr
.continue ESAC005
!BRK024
!ESAC005: =====   ENDCASE   =====
.continue EL018 ? _(M|aktzeile > 0)
.copy M|ytmark = G|true     ? _G|evtvar = "ytmark"
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
!EL018
.continue ESAC002
!BRK017
.continue BRK025 ? _(G|evtart = "zeileeinnach")
.copy    M|ytpersonal = M|ypersonal
.formula M|ytpersname = M|ypersonal^namebspr
.copy    M|ytkstelle  = M|ykstelle
.formula M|ytkstname  = M|ykstelle^namebspr
.copy M|yvollleiart = M|ytkstelle^yprjmvollleiart
.copy M|ywipleiart  = M|ytkstelle^yprjmwipleiart
.copy M|ygkleiart   = M|ytkstelle^yprjmgkleiart
.copy M|ytmark  = G|true      ? _F|empty(M|ytpersonal) ; _F|empty(M|ytkstelle)
.continue ESAC002
!BRK025
!ESAC002: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMKSTELLEZUORD.EV")'   ? F|fileexists(F|foppath("IFOP.IS.PRJMKSTELLEZUORD.EV"))
.continue
