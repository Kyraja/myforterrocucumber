..!interpreter english declaration noabbrev
.. at 2016-08-08, 16:14
.set TRANS -
..========================================================================
..==  Name              :  IS.PRJMKALK.KALK
..==  Pfad              :  allpstart
..==  Funktion          : -Projektkalkulaktion
..==  Erstellungsdatum  : 12.06.09
..==  Autor             : Andreas Otto, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2015 alltrotec GmbH
..========================================================================
.input DATEI.F
.input "allpstart/LART.KONFIG.INI"
.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbgrprojekt)
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type integer xprocsp       ? _F|defined(U|xprocsp)
.type text    xtzeilenstack xtzeilenart xtleiartid xtladerkalkdat
.type text    xtmax xtmin
.type realx   xrrotfaktor xrgelbfaktor xrblaufaktor
.type realx   xrvokafaktor xrmikafaktor xrnakafaktor
.type text    xtvokaergfarbe xtmikaergfarbe xtnakaergfarbe
.type integer xirot xiblau xigelb xivokagelb xivokablau xivokarot ximikagelb ximikablau ximikarot xinakagelb xinakablau xinakarot
.type integer xiholzeile ximonat xiknotenstufe xiblattstufe
.type realx   xrverrechnsatz xrvkpreis xrfvmge xrwert xxkurs
.type realx   xrdazumikakosten
.type realx   xrvokastunden xrvokabudget xrvokaplan xrvokakosten
.type realx   xrmikastunden xrmikabudget xrmikakosten
.type realx   xrnakastunden xrnakabudget xrnakakosten
.type text    xtfarbe xtrot xtgelb xtblau xtvokafarbe xtmikafarbe xtnakafarbe
.type GD      xstartdatum
.type bool    xbmehr        ? _F|defined(U|xbmehr)
.type VP99    xpreferenz
.type text    xtprojleistkatid  ? _F|defined(U|xtprojleistkatid)
.type RPN7.2  xpapreis          ? _F|defined(U|xpapreis)
.type GD      xdkonddat         ? _F|defined(U|xdkonddat)
.type P3:2    xpaupos           ? _F|defined(U|xpaupos)
.type P0      xpkunde           ? _F|defined(U|xpkunde)
.type TAZ7    xeinh             ? _F|defined(U|xeinh)
.type GJ      xgj               ? _F|defined(U|xgj)
.'F|expr("type P" + U|xydbgrprojekt + " xpprojekt")
.type text    xtsys     ? _F|defined(U|xtsys)
.continue EL001 ? _(_(F|defined(U|xbneuladen)))
.type bool xbneuladen
.copy U|xbneuladen = G|FALSE
!EL001
.formula U|xtzeilenart   = ""
.formula U|xtzeilenstack = ""
..====================================================
.set demand -
.continue EPROCDEF
!PROC001: ----- Farbe -----
.continue EL002 ? _(U|xirot < U|xigelb)
.continue EL003 ? _(U|xirot < U|xiblau)
.formula U|xtmin = "rot"
.continue FI003
!EL003
.formula U|xtmin = "blau"
!FI003
.continue FI002
!EL002
.continue EL004 ? _(U|xigelb < U|xiblau)
.formula U|xtmin = "gelb"
.continue FI004
!EL004
.formula U|xtmin = "blau"
!FI004
!FI002
.continue BRK001 ? _(xtmin = "rot")
.formula U|xrrotfaktor =1
.formula U|xrblaufaktor = U|xirot / xiblau
.formula U|xrgelbfaktor = U|xirot / xigelb
.continue ESAC001
!BRK001
.continue BRK002 ? _(xtmin = "gelb")
.formula U|xrgelbfaktor = 1
.formula U|xrrotfaktor  = U|xigelb / xirot
.formula U|xrblaufaktor = U|xigelb / xiblau
.continue ESAC001
!BRK002
.formula U|xrblaufaktor = 1
.formula U|xrrotfaktor  = U|xiblau / xirot
.formula U|xigelbfaktor = U|xiblau / xigelb
!ESAC001: =====   ENDCASE   =====
.formula U|xrvokafaktor = 100
.formula U|xrmikafaktor = 50
.formula U|xrnakafaktor = 100
.formula U|xivokarot   = U|xirot  + U|xrvokafaktor * U|xrrotfaktor
.formula U|xivokagelb  = U|xigelb + U|xrvokafaktor * U|xrgelbfaktor
.formula U|xivokablau  = U|xiblau + U|xrvokafaktor * U|xrblaufaktor
.formula U|ximikarot   = U|xirot  + U|xrmikafaktor * U|xrrotfaktor
.formula U|ximikagelb  = U|xigelb + U|xrmikafaktor * U|xrgelbfaktor
.formula U|ximikablau  = U|xiblau + U|xrmikafaktor * U|xrblaufaktor
.formula U|xinakarot   = U|xirot  + U|xrnakafaktor * U|xrrotfaktor
.formula U|xinakagelb  = U|xigelb + U|xrnakafaktor * U|xrgelbfaktor
.formula U|xinakablau  = U|xiblau + U|xrnakafaktor * U|xrblaufaktor
.formula U|xtvokafarbe = 'U|xivokarot' + " " + 'U|xivokagelb' + " " + 'U|xivokablau'
.formula U|xtmikafarbe = 'U|ximikarot' + " " + 'U|ximikagelb' + " " + 'U|ximikablau'
.formula U|xtnakafarbe = 'U|xinakarot' + " " + 'U|xinakagelb' + " " + 'U|xinakablau'
.colour -BACKGROUND 'U|xtvokafarbe' yvokastunden  'M|aktzeile'
.colour -BACKGROUND 'U|xtvokafarbe' yvokabudget   'M|aktzeile'
.colour -BACKGROUND 'U|xtvokafarbe' yvokaplan     'M|aktzeile'
.colour -BACKGROUND 'U|xtvokafarbe' yvokakosten   'M|aktzeile'
.colour -BACKGROUND 'U|xtmikafarbe' ymikastunden  'M|aktzeile'
.colour -BACKGROUND 'U|xtmikafarbe' ymikabudget   'M|aktzeile'
.colour -BACKGROUND 'U|xtmikafarbe' ymikakosten   'M|aktzeile'
.colour -BACKGROUND 'U|xtnakafarbe' ynakastunden  'M|aktzeile'
.colour -BACKGROUND 'U|xtnakafarbe' ynakabudget   'M|aktzeile'
.colour -BACKGROUND 'U|xtnakafarbe' ynakakosten   'M|aktzeile'
.colour -BACKGROUND 'U|xtvokafarbe' yvokaerg      'M|aktzeile'
.colour -BACKGROUND 'U|xtmikafarbe' ymikaerg      'M|aktzeile'
.colour -BACKGROUND 'U|xtnakafarbe' ynakaerg      'M|aktzeile'
.formula U|xtvokaergfarbe = "-1 -1 -1"
.formula U|xtmikaergfarbe = "-1 -1 -1"
.formula U|xtnakaergfarbe = "-1 -1 -1"
.formula U|xtnakaergfarbe = "10 100 0"      ? M|ynakaerg > M|yvokaerg
.formula U|xtnakaergfarbe = "0 0 0"         ? M|ynakaerg = M|yvokaerg
.formula U|xtnakaergfarbe = "255 255 100"   ? M|ynakaerg < M|yvokaerg
.formula U|xtnakaergfarbe = "255 50 50"     ? M|ynakaerg < 0
.formula U|xtmikaergfarbe = "10 100 0"      ? M|ymikaerg > M|yvokaerg
.formula U|xtmikaergfarbe = "0 0 0"         ? M|ymikaerg = M|yvokaerg
.formula U|xtmikaergfarbe = "255 255 100"   ? M|ymikaerg < M|yvokaerg
.formula U|xtmikaergfarbe = "255 50 50"     ? M|ymikaerg < 0
.colour -FOREGROUND 'U|xtmikaergfarbe' -BACKGROUND 'U|xtmikafarbe' ymikaerg 'M|aktzeile'
.colour -FOREGROUND 'U|xtnakaergfarbe' -BACKGROUND 'U|xtnakafarbe' ynakaerg 'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC002: ----- Stammfarbe -----
.colour -BACKGROUND 'U|xtfarbe' 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' tbaumstufe 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' yebene     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' yobjekt    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' ystatus    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' yname      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' yreftyp    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe' yreftypi   'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC003: ----- Rueckkehr -----
.formula U|xiholzeile = U|xtzeilenstack<<"#"
.select screen line 'U|xiholzeile'
.formula U|xtzeilenstack=xtzeilenstack>>"#"
.continue 'xprocst.xprocsp'
!PROC004: ----- Knoten_aktualisieren -----
.formula U|xiblattstufe = M|tbaumstufe
.type integer xiblattzeile.xiblattstufe     ? _F|defined(U|xiblattzeile.xiblattstufe)
.formula U|xiblattzeile.xiblattstufe = M|aktzeile
.formula U|xrvokastunden = M|yvokastunden
.formula U|xrvokabudget  = M|yvokabudget
.formula U|xrvokakosten  = M|yvokakosten
.formula U|xrvokaplan    = M|yvokaplan
.formula U|xrmikakosten  = M|ymikakosten
.formula U|xrmikastunden = M|ymikastunden
.formula U|xrmikabudget  = M|ymikabudget
.formula U|xrnakastunden = M|ynakastunden
.formula U|xrnakabudget  = M|ynakabudget
.formula U|xrnakakosten  = M|ynakakosten
.formula U|xiholzeile = U|xtzeilenstack<<"#"
.select screen line 'U|xiholzeile'
.formula U|xiknotenstufe = M|tbaumstufe
.continue BRK003 ? _(U|xtzeilenart = "Leistungsnachweis")
.continue EL005 ? _((M|yobjekt^dnr    = U|xydbaufgabe) & (M|yobjekt^gruppe = U|xygraufgabe))
.formula M|ymikakosten  = M|ymikakosten  + U|xrmikakosten
.formula M|ynakakosten  = M|ynakakosten  + U|xrnakakosten
.formula M|ynakastunden = M|ynakastunden + U|xrnakastunden
!EL005
.continue ESAC002
!BRK003
.continue BRK004 ? _(U|xtzeilenart = "Arbeitsaufgabe")
.continue EL006 ? _((M|yobjekt^dnr    = U|xydbpvorgang) & (M|yobjekt^gruppe = U|xygrpvorgang))
.formula M|ymikakosten  = M|ymikakosten  + U|xrmikakosten
.formula M|ynakakosten  = M|ynakakosten  + U|xrnakakosten
.formula M|ynakastunden = M|ynakastunden + U|xrnakastunden
!EL006
.continue ESAC002
!BRK004
.continue BRK005 ? _(U|xtzeilenart = "Projektvorgang")
.continue EL007 ? _((M|yobjekt^dnr    = U|xydbprojekt) & (M|yobjekt^gruppe = U|xygrprojekt))
.formula M|yvokaplan    = M|yvokaplan    + U|xrvokaplan
.formula M|yvokakosten  = M|yvokakosten  + U|xrvokakosten
.formula M|yvokabudget  = M|yvokabudget  + U|xrvokabudget
.formula M|yvokastunden = M|yvokastunden + U|xrvokastunden
.formula M|ymikakosten  = M|ymikakosten  + U|xrmikakosten
.formula M|ymikastunden = M|ymikastunden + U|xrmikastunden
.formula M|ymikabudget  = M|ymikabudget  + U|xrmikabudget
.formula M|ynakastunden = M|ynakastunden + U|xrnakastunden
.formula M|ynakabudget  = M|ynakabudget  + U|xrnakabudget
.formula M|ynakakosten  = M|ynakakosten  + U|xrnakakosten
.continue FI007
!EL007
.continue EL008 ? _((M|yobjekt^dnr    = U|xydbpvorgang) & (M|yobjekt^gruppe = U|xygrpvorgang))
.continue EL009 ? _(_(M|yobjekt^yistblatt))
.formula M|yvokabudget  = M|yvokabudget  + U|xrvokabudget
.formula M|yvokakosten  = M|yvokakosten  + U|xrvokakosten
.formula M|yvokastunden = M|yvokastunden + U|xrvokastunden
.formula M|yvokaplan    = M|yvokaplan    + U|xrvokaplan
.formula M|ymikastunden = M|ymikastunden + U|xrmikastunden
.formula M|ymikabudget  = M|ymikabudget  + U|xrmikabudget
.formula M|ynakastunden = M|ynakastunden + U|xrnakastunden
.formula M|ynakabudget  = M|ynakabudget  + U|xrnakabudget
.formula M|ynakakosten  = M|ynakakosten  + U|xrnakakosten
!EL009
.formula M|ymikakosten = M|ymikakosten + U|xrmikakosten
!EL008
!FI007
.continue ESAC002
!BRK005
.continue BRK006 ? _(U|xtzeilenart = "Projekt")
.continue ESAC002
!BRK006
!ESAC002: =====   ENDCASE   =====
.select screen line 'U|xiblattzeile.xiblattstufe'
.continue 'xprocst.xprocsp'
!PROC005: ----- Knoten_merken -----
.formula U|xiknotenstufe = M|tbaumstufe
.type integer xiknotenzeile.xiknotenstufe   ? _F|defined(U|xiknotenzeile.xiknotenstufe)
.formula U|xiknotenzeile.xiknotenstufe = M|aktzeile
.continue 'xprocst.xprocsp'
!PROC006: ----- Verrechnungssatz -----
.formula U|xrverrechnsatz = 0
.continue EL010 ? _((_(U|xtleiartid = "(0,0,0)")) & (_(F|empty(U|xtleiartid))))
.formula U|ximonat = F|month(U|xstartdatum)
.copy    U|xgj     = F|getfy(U|xstartdatum)
.formula U|ximonat = 1                      ? F|empty(U|xgj) & U|xstartdatum < G|datum
.copy    U|xgj     = F|firstfy()            ? F|empty(U|xgj) & U|xstartdatum < G|datum
.formula U|ximonat = 12                     ? F|empty(U|xgj) & U|xstartdatum > G|datum
.copy    U|xgj     = F|lastfy()             ? F|empty(U|xgj) & U|xstartdatum > G|datum
.continue EL011 ? _(_(F|empty(M|yobjekt^yprojekt^yverantwkst)))
.formula U|xtsel = "$,,ykstelle==" + M|yobjekt^yprojekt^yverantwkst^id + ";yleiart==" + U|xtleiartid + ";ygjahr=" + 'U|xgj' + ";ybstd=0;@filingmode=(Active);@zeilen=(1)"
.load 0 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL012 ? _(G|mehr)
.load 0 line '0|selzeile'
.formula U|xrverrechnsatz = 0|yvsf.ximonat                                              ?  0|yvland = G|inland ;  F|empty(0|yvland)
.formula U|xrverrechnsatz = F|fxamount(G|inland,0|yvsf.ximonat,M|ystichdatum,0|yvland)  ? _0|yvland = G|inland & _F|empty(0|yvland)
.continue FI012
!EL012
.formula U|xtsel = "$,,yleiart==" + U|xtleiartid + ";ygjahr=" + 'U|xgj' + ";ybstd=1;@filingmode=(Active);@zeilen=(1)"
.load 0 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL013 ? _(G|mehr)
.load 0 line '0|selzeile'
.formula U|xrverrechnsatz = 0|yvsf.ximonat                                                ?  0|yvland = G|inland ;  F|empty(0|yvland)
.formula U|xrverrechnsatz = F|fxamount(G|inland,0|yvsf.ximonat,M|ystichdatum,0|yvland)    ? _0|yvland = G|inland & _F|empty(0|yvland)
!EL013
!FI012
.load 0
.continue FI011
!EL011
.formula U|xtsel = "$,,yleiart==" + U|xtleiartid + ";ygjahr=" + 'U|xgj' + ";ybstd=1;@filingmode=(Active);@zeilen=(1)"
.load 0 group 'U|xydbgrversatz' 'U|xtsel'
.continue EL014 ? _(G|mehr)
.load 0 line '0|selzeile'
.formula U|xrverrechnsatz = 0|yvsf.ximonat                                                ?  0|yvland = G|inland ;  F|empty(0|yvland)
.formula U|xrverrechnsatz = F|fxamount(G|inland,0|yvsf.ximonat,M|ystichdatum,0|yvland)    ? _0|yvland = G|inland & _F|empty(0|yvland)
!EL014
!FI011
!EL010
.continue 'xprocst.xprocsp'
!PROC007: ----- Leistungsnachweis -----
.formula U|xtzeilenart = "Leistungsnachweis"
.formula U|xiholzeile = U|xtzeilenstack<<"#"
.formula M|yaotext = M|yaotext + "#bergeordnet:" + 'U|xiholzeile'
.formula M|yaotext = 'U|xtzeilenstack'
.continue EL015 ? _((M|yobjekt^dnr    = U|xydblnachweis) & (M|yobjekt^gruppe = U|xygrlnachweis))
.formula U|xstartdatum = M|yobjekt^yadatum
.formula U|xtleiartid = M|yobjekt^yleiart^id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC006
!RET001
.formula xprocsp = xprocsp - 1
.formula M|ymikakosten = M|yistar * xrverrechnsatz
!EL015
.continue EL016 ? _((M|yobjekt^dnr    = U|xydblnachweis) & (M|yobjekt^gruppe = U|xygrlnachweis))
.formula M|ynakastunden = M|yobjekt^yfaktzeit
.formula U|xstartdatum = M|yobjekt^yadatum
.formula U|xtleiartid = M|yobjekt^yleiart^id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC006
!RET002
.formula xprocsp = xprocsp - 1
.formula M|ynakakosten = M|yistar * xrverrechnsatz
!EL016
.copy    M|yberechnet = G|true
.formula U|xirot  = 100
.formula U|xigelb = 190
.formula U|xiblau = 190
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC008: ----- Arbeitsaufgabe -----
.formula U|xiholzeile = U|xtzeilenstack<<"#"
.formula U|xtzeilenstack = 'M|aktzeile' + "#" + U|xtzeilenstack
.formula M|yaotext = M|yaotext + "#bergeordnet:" + 'U|xiholzeile'
.formula M|yaotext = 'U|xtzeilenstack'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC005
!RET004
.formula xprocsp = xprocsp - 1
.select screen line
.copy U|xbmehr = G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(U|xbmehr)
.continue EL017 ? _(M|tbaumstufe > U|xiknotenstufe)
.continue EL018 ? _(_M|yberechnet)
.continue EL019 ? _((M|yobjekt^dnr=xydblnachweis) & (M|yobjekt^gruppe=xygrlnachweis))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC007
!RET005
.formula xprocsp = xprocsp - 1
.formula U|xtzeilenart = "Leistungsnachweis"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC004
!RET006
.formula xprocsp = xprocsp - 1
!EL019
!EL018
.select screen line
.copy U|xbmehr = G|mehr
.continue FI017
!EL017
.copy U|xbmehr = G|false
!FI017
.continue LOOP001
!ELOP001: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC003
!RET007
.formula xprocsp = xprocsp - 1
.copy M|yberechnet = G|true
.formula U|xirot  = 75
.formula U|xigelb = 190
.formula U|xiblau = 190
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC001
!RET008
.formula xprocsp = xprocsp - 1
.formula U|xiknotenstufe = M|tbaumstufe
.continue 'xprocst.xprocsp'
!PROC009: ----- Projektvorgang -----
.assign U|xpreferenz = M|yobjekt^yrefid
.formula U|xtzeilenart = "Projektvorgang"
.formula U|xiholzeile  = U|xtzeilenstack<<"#"
.formula U|xtzeilenstack = 'M|aktzeile' + "#" + U|xtzeilenstack
.formula M|yaotext = M|yaotext + "#bergeordnet:" + 'U|xiholzeile'
.formula M|yaotext = 'U|xtzeilenstack'
.continue EL020 ? _((_(F|empty(U|xpreferenz))) & (U|xpreferenz^dnr    = 86) & (U|xpreferenz^gruppe = 1))
.output NEW 'U|xtedpout'
.input DATEI.F
.set SEPARATOR
#!DATABASE=2
#!GROUP=1
#!ACTION=update
#!EDP_LANGCODE='G|bsprache'
#!DONTCHANGE=xxxxxx
id;>kalkul;<
'U|xpreferenz^id';;
.output new WERF.WEG
.formula U|xtsys = "edpinfosys.sh -p " + G|einmalpw
.formula U|xtsys = U|xtsys + " -n PRJMKALK"
.formula U|xtsys = U|xtsys + " -s yprojekt,bstart"
.formula U|xtsys = U|xtsys + " -w " + G|dblquote + U|xpreferenz^id + ";;" + G|dblquote
.formula U|xtsys = U|xtsys + " -f yvokastunden,yvokabudget,yvokaplan,yvokakosten,yvokaerg,ymikastunden,ymikabudget,ymikakosten,ymikaerg,ynakastunden,ynakabudget,ynakakosten,ynakaerg"
.formula U|xtsys = U|xtsys + " -H " + U|xtedpmsg + " >" + U|xtedpout + " 2>" + U|xtedperr
.input "allpstart/FOP.ALL.EDP.CHECK"
.continue EL021 ? _(G|mehr)
.continue EL022 ? _(F|filenotempty(U|xtedpout))
.select from
.select from 'U|xtedpout' M|yvokastunden;M|yvokabudget;M|yvokaplan;M|yvokakosten;M|yvokaerg;M|ymikastunden;M|ymikabudget;M|ymikakosten;M|ymikaerg;M|ynakastunden;M|ynakabudget;M|ynakakosten;M|ynakaerg;
.continue FI022
!EL022
.output TERMINAL
Fehler beim Vorkalkulieren von 'U|xpreferenz^id' aufgetreten.
.formula U|xrvkpreis = 0.0
!FI022
.continue FI021
!EL021
.output TERMINAL
Fehler beim Vorkalkulieren von 'U|xpreferenz^id' aufgetreten.
.formula U|xrvkpreis = 0.0
!FI021
.continue FI020
!EL020
.continue EL023 ? _((_(F|empty(U|xpreferenz))) & (U|xpreferenz^dnr    = 2) & (U|xpreferenz^gruppe = 1))
.formula U|xrfvmge = U|xpreferenz^mge
