.type text    xtsys xtsel xtcmd xtindex xtkzind
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskpruef")
.continue EL001 ? _(_(G|evtkommd = G|kaktname10))
.continue EL002 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xtindex = M|ytkennzahl^nummer
.continue EL003 ? _(_(F|empty(M|ytkennzahl)))
.continue EL004 ? _(_(F|defined(U|xtkennzahl.xtindex)))
.type text    xtkennzahl.xtindex xtberechmonwert.xtindex
.type integer xikzzeile.xtindex
.formula U|xtkennzahl.xtindex      = M|ytkennzahl
.formula U|xtberechmonwert.xtindex = M|ytberechmonwertk
.formula U|xikzzeile.xtindex       = M|aktzeile
.continue FI004
!EL004
.set TRANS +
.box Fehler
Die  Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' ist mehrfach im Auswertungsschema enthalten.
.set TRANS -
.error
.end 1
!FI004
!EL003
.select screen line
.continue LOOP001
!ELOP001: ==============================
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL005 ? _(_(F|empty(M|ytkennzahl)))
.continue EL006 ? _((M|ytkennzahl^ykztypk     = "AKZ") ; (M|ytkennzahl^ykztypvokak = "AKZ") ; (M|ytkennzahl^ykztypfck   = "AKZ"))
.select add M|ytkennzahl
.continue EL007 ? _(G|mehr)
.select line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL008 ? _(_(F|empty(H|ytkennzahl)))
.formula U|xtkzind = H|ytkennzahl^nummer
.continue EL009 ? _(TRUE)
.continue EL010 ? _((H|ytkennzahl^ykztypk     = "AKZ") ; (H|ytkennzahl^ykztypvokak = "AKZ") ; (H|ytkennzahl^ykztypfck   = "AKZ"))
.continue EL011 ? _(_(F|defined(U|xikzzeile.xtkzind)))
.set TRANS +
.box Fehler
Die in der aggregierten Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' enthalten Kennzahlen mÅssen
im Auswertungsschema komplett vor der aggregierten Kennzahl enthalten sein.

Die Kennzahl 'F|trim(F|tostring(H|ytkennzahl))' ist nicht im Auswertungsschema enthalten.
.set TRANS -
.error
.end 1
.continue FI011
!EL011
.continue EL012 ? _((M|ytberechmonwertk = "KMW") & (U|xikzzeile.xtkzind > M|aktzeile))
.set TRANS +
.box Fehler
Die in der aggregierten Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' enthalten Kennzahlen mÅssen
im Auswertungsschema komplett vor der aggregierten Kennzahl enthalten sein.

Die Kennzahl 'F|trim(F|tostring(H|ytkennzahl))' ist nicht vor der aggregierten Kennzahl enthalten.
.set TRANS -
.error
.end 1
.continue FI012
!EL012
.continue EL013 ? _((_(M|ytberechmonwertk = "KMW")) & (U|xtberechmonwert.xtkzind = "KMW"))
.set TRANS +
.box Fehler
Die in der aggregierten Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' enthalten Kennzahlen dÅrfen nicht
die Eigenschaft "Keine Monatswerte" haben, da die aggregierte Kennzahl Monatswerte anzeigt.
.set TRANS -
.error
.end 1
!EL013
!FI012
!FI011
!EL010
.continue FI009
!EL009
.continue EL014 ? _((M|ytberechmonwertk = "KMW") & (_(F|defined(U|xikzzeile.xtkzind))))
.set TRANS +
.box Fehler
Die in der aggregierten Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' enthalten Kennzahlen mÅssen
im Auswertungsschema komplett vor der aggregierten Kennzahl enthalten sein.

Die Kennzahl 'F|trim(F|tostring(H|ytkennzahl))' ist nicht im Auswertungsschema enthalten.
.set TRANS -
.error
.end 1
.continue FI014
!EL014
.continue EL015 ? _((M|ytberechmonwertk = "KMW") & (U|xikzzeile.xtkzind > M|aktzeile))
.set TRANS +
.box Fehler
Die in der aggregierten Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' enthalten Kennzahlen mÅssen
im Auswertungsschema komplett vor der aggregierten Kennzahl enthalten sein.

Die Kennzahl 'F|trim(F|tostring(H|ytkennzahl))' ist nicht vor der aggregierten Kennzahl enthalten.
.set TRANS -
.error
.end 1
.continue FI015
!EL015
.continue EL016 ? _((_(M|ytberechmonwertk = "KMW")) & (U|xtberechmonwert.xtkzind = "KMW"))
.set TRANS +
.box Fehler
Die in der aggregierten Kennzahl 'F|trim(F|tostring(M|ytkennzahl))' enthalten Kennzahlen dÅrfen nicht
die Eigenschaft "Keine Monatswerte" haben, da die aggregierte Kennzahl Monatswerte anzeigt.
.set TRANS -
.error
.end 1
!EL016
!FI015
!FI014
!FI009
!EL008
.select line
.continue LOOP003
!ELOP003: ==============================
!EL007
!EL006
!EL005
.select screen line
.continue LOOP002
!ELOP002: ==============================
!EL002
!EL001
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue BRK003 ? _(G|evtvar = "ytkennzahl")
.formula M|ytkzname = M|ytkennzahl^namebspr
.continue ESAC002
!BRK003
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
.continue
