..!interpreter english declaration noabbrev
.set TRANS -
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type real    xrpvsollstd       ? _F|defined(U|xrpvsollstd)
.type real    xrpvplanstd       ? _F|defined(U|xrpvplanstd)
.type real    xrpviststd        ? _F|defined(U|xrpviststd)
.type real    xrpvforecaststd   ? _F|defined(U|xrpvforecaststd)
.type real    xrfortschritt     ? _F|defined(U|xrfortschritt)
.type real    xrfortistbudget   ? _F|defined(U|xrfortistbudget)
.type real    xrfortman         ? _F|defined(U|xrfortman)
.type real    xrtechfort        ? _F|defined(U|xrtechfort)
.type real    xrtechfortman     ? _F|defined(U|xrtechfortman)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
.continue EL001 ? _((_(F|empty(U|xtprojekt))) & (_(U|xtprojekt = "(0,0,0)")))
.formula U|xrpvsollstd     = 0
.formula U|xrpvplanstd     = 0
.formula U|xrpviststd      = 0
.formula U|xrpvforecaststd = 0
.formula U|xrfortschritt   = 0
.formula U|xrfortistbudget = 0
.formula U|xrfortman       = 0
.formula U|xrtechfort      = 0
.formula U|xrtechfortman   = 0
.formula U|xtsel = "$,,yprojekt==" + U|xtprojekt + ";ygehoertzu=`;@filingmode=(Active)"
.load 8 group "P149:2" 'xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xrpvsollstd     = U|xrpvsollstd     + 8|ypvsollstd
.formula U|xrpvplanstd     = U|xrpvplanstd     + 8|ypvplanstd
.formula U|xrpviststd      = U|xrpviststd      + 8|ypviststd
.formula U|xrpvforecaststd = U|xrpvforecaststd + 8|ypvforecaststd
.load 8 continue
.continue LOOP001
!ELOP001: ==============================
.formula U|xrfortschritt   = U|xrpviststd / U|xrpvplanstd     * 100     ? _U|xrpvplanstd     = 0
.formula U|xrfortschritt   = 100                                        ?  U|xrfortschritt   > 100
.formula U|xrfortschritt   = 99                                         ?  U|xrfortschritt   = 100 & U|xrpviststd < U|xrpvplanstd
.formula U|xrfortistbudget = U|xrpviststd / U|xrpvsollstd     * 100     ? _U|xrpvsollstd     = 0
.formula U|xrfortistbudget = 100                                        ?  U|xrfortistbudget > 100
.formula U|xrfortistbudget = 99                                         ?  U|xrfortistbudget = 100 & U|xrpviststd < U|xrpvsollstd
.formula U|xrtechfort      = U|xrpviststd / U|xrpvforecaststd * 100     ? _U|xrpvforecaststd = 0
.formula U|xrtechfort      = 100                                        ?  U|xrtechfort      > 100
.formula U|xrtechfort      = 99                                         ?  U|xrtechfort      = 100 & U|xrpviststd < U|xrpvforecaststd
!EL001
