..!interpreter english declaration noabbrev
.set trans -
..========================================================================
..==  Name              : FOP.PRJM.UP.PROJEKT.ANLAGE
..==  Pfad              : allpstart
..==  Funktion          : Unterprogrammm zur Projektanlage
..==  Erstellungsdatum  : 27.04.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xtcmd             ? _F|defined(U|xtcmd)
.type text    xtmenue           ? _F|defined(U|xtmenue)
.type text    xtextid           ? _F|defined(U|xtextid)
.type text    xyprojekttyp      ? _F|defined(U|xyprojekttyp)
.type integer xianz             ? _F|defined(U|xianz)
.type bool    xbvtproj          ? _F|defined(U|xbvtproj)
.type ID87:9  xcallparam        ? _F|defined(U|xcallparam)
.set demand -
..====================================================
.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbgrprojekttyp)
.formula U|xtextid = ""
.file -TEMPNAME U|xtmenue
.output new 'U|xtmenue'
.input DATEI.F
'G|kommandochar''G|kommandochar''G|markechar'interpreter english
'G|markechar'MENU
.set trans +
.formula U|xtsel "bitte Projekttyp w„hlen"
.set trans -
'G|kommandochar'menu(0,0,0)'U|xtsel'
.formula U|xianz  = 0
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";id==" + U|xyprojekttyp   ? _F|empty(U|xyprojekttyp)
.continue EL001 ? _(G|evtkommd = G|kaktname2)
.load 0 'G|hdatname65' 'M|nummer'
.formula U|xtsel = U|xtsel + ";id="        + M|yprojekt^yprojekttyp^ytpprojtyp^id       ?  _F|empty(M|yprojekt^yprojekttyp^ytpprojtyp)
.formula U|xtsel = U|xtsel + ";ykontext==" + 0|id
.continue FI001
!EL001
.formula U|xtsel = U|xtsel + ";ykontext==" + G|varmaske.evtmaske
!FI001
.formula U|xtsel = U|xtsel + ";yvertproj=" + 'U|xbvtproj'
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(Yes)"
.load 0 group 'U|xydbgrprojekttyp' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.load 0 line '0|selzeile'
.continue EL002 ? _(_(F|empty(0|yaufparam)))
.continue EL003 ? _(((_(0|yaufparam^aufrtab)) & (G|evtzeile = 0)) ; ((0|yaufparam^aufrtab) & (G|evtzeile > 0)))
.formula U|xianz = U|xianz + 1
.assign U|xcallparam = 0|yaufparam^id
'0|namebspr' >>.assign U|xcallparam = "'0|yaufparam^id'"
!EL003
!EL002
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.load 0
'G|kommandochar''G|kommandochar'
'G|kommandochar'error
'G|kommandochar'end 1   'G|fragechar' G|menue = 0 & _G|evtart = "maskende"
.continue EL004 ? _(U|xianz = 0)
.set TRANS +
.box Fehler
?Es konnte kein Projekttyp fr die Anlage von Projekten aus dieser Maske gefunden werden.               ? _U|xbvtproj
?Es konnte kein Projekttyp fr die Anlage von Vertriebsprojekten aus dieser Maske gefunden werden.      ?  U|xbvtproj
.set TRANS -
.error
.end 1  ? _G|evtart = "maskende"
.continue FI004
!EL004
.continue EL005 ? _(U|xianz > 1)
.input 'U|xtmenue'
!EL005
.continue EL006 ? _((U|xianz = 1) ; (_(G|menue = 0)))
.continue EL007 ? _((U|xcallparam^zielobj^dnr = 12) & (U|xcallparam^zielobj^vdn = U|xydbprojekt) & ((TRUE) ; (U|xcallparam^zielobj^vgr = U|xygrprojekt)))
.continue EL008 ? _(('U|xcallparam^zielmodus(L=":")' = "(Edit)") ; ('U|xcallparam^zielmodus(L=":")' = "(New)"))
.formula U|xtextid = 'G|versionneu' + G|PID
.input "st/CALLPARAM.EXEC"
.continue FI008
!EL008
.set TRANS +
.box Fehler
Es sind nur Aufrufparameter mit Zielaktion <neu> erlaubt.
.set TRANS -
.assign M|.evtvar = ""
!FI008
.continue FI007
!EL007
.set TRANS +
.box Fehler
Es sind nur Aufrufparameter mit Ziel auf Projekte erlaubt.
.set TRANS -
.error
.end 1  ? _G|evtart = "maskende"
!FI007
!EL006
!FI004
.continue
