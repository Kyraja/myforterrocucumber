..!interpreter english declaration noabbrev
.. at 2016-07-12, 11:00
.set TRANS -
..========================================================================
..==  Name              : IS.PRJM.EKVKPOS.TAB
..==  Pfad              : allpstart
..==  Funktion          : Tabellen FOP
..==  Erstellungsdatum  : 21.04.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsel         ? _F|defined(U|xtsel)
.type text    xtablage      ? _F|defined(U|xtablage)
.type bool    xbok          ? _F|defined(U|xbok)
.type realx   xxkurs        ? _F|defined(U|xxkurs)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt==" + H|id
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|ANKO' + ")"               ?  F|defined(M|yprjmekanpos) ; F|defined(M|yprjmvkanpos)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|ABKO' + ")"               ?  F|defined(M|yprjmekbepos) ; F|defined(M|yprjmvkaupos)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|LIKO' + ")"               ?  F|defined(M|yprjmeklspos) ; F|defined(M|yprjmvklspos)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|REKO' + ")"               ?  F|defined(M|yprjmekrepos) ; F|defined(M|yprjmvkrepos)
.formula U|xtsel = U|xtsel + ";kovom=" + M|ybeldatvon:8 + "!" + M|ybeldatbis:8  ? _F|empty(M|ybeldatvon) ; _F|empty(M|ybeldatbis)
.continue EL001 ? _((F|defined(M|yprjmekanpos)) ; (F|defined(M|yprjmekbepos)) ; (F|defined(M|yprjmeklspos)) ; (F|defined(M|yprjmekrepos)))
.formula U|xtsel = U|xtsel + ";lief=="              + M|ylief^id        ? _F|empty(M|ylief)
.formula U|xtsel = U|xtsel + ";yprjmppvorgang=="    + M|ypvorgang^id    ? _F|empty(M|ypvorgang)
.formula U|xtsel = U|xtsel + ";yprjmparbpaket=="    + M|yarbpaket^id    ? _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";yprjmpekposid=="     + M|ybevor^id       ? _F|empty(M|ybevor)
.formula U|xtsel = U|xtsel + ";yprjmpekposid=="     + M|yumvor^id       ? _F|empty(M|yumvor)
!EL001
.continue EL002 ? _((F|defined(M|ybudatvon)) & (F|defined(M|ybudatbis)))
.formula U|xtsel = U|xtsel + ";kopf^budat="         + M|ybudatvon:8 + "!" + M|ybudatbis:8   ? _F|empty(M|ybudatvon) ; _F|empty(M|ybudatbis)
!EL002
.continue EL003 ? _(F|defined(M|ybnullrechpos))
.formula U|xtsel = U|xtsel + ";yprjmpnullrechnung==1"                   ?  M|ybnullrechpos
!EL003
.continue EL004 ? _(F|defined(M|yprojek))
.formula U|xtsel = U|xtsel + ";yprjmpprojek=="      + M|yprojek         ? _F|empty(M|yprojek)
!EL004
.continue EL005 ? _((F|defined(M|yprjmeklspos)) ; (F|defined(M|yprjmvklspos)))
.formula U|xtablage = ";@ablage=(1)"    ? (M|ybposoffen ;  M|ybposgebucht) & _M|ybposabgelegt
.formula U|xtablage = ";@ablage=(2)"    ? _M|ybposoffen & _M|ybposgebucht  &  M|ybposabgelegt
.formula U|xtablage = ";@ablage=(3)"    ? (M|ybposoffen &  M|ybposabgelegt) ; (M|ybposgebucht &  M|ybposabgelegt)
.formula U|xtsel = U|xtsel + ";kopf^uebertr==1" ? _M|ybposgebucht & _M|ybposabgelegt
.formula U|xtsel = U|xtsel + ";kopf^uebertr==0" ?  M|ybposgebucht & _M|ybposoffen
.formula U|xtsel = U|xtsel + U|xtablage
.continue                                       ? _M|ybposoffen & _M|ybposabgelegt & _M|ybposgebucht
.continue FI005
!EL005
.continue EL006 ? _((F|defined(M|yprjmekrepos)) ; (F|defined(M|yprjmvkrepos)))
.formula U|xtsel = U|xtsel + ";@ablage=(1)" ?  M|ybposoffen & _M|ybposabgelegt
.formula U|xtsel = U|xtsel + ";@ablage=(2)" ? _M|ybposoffen &  M|ybposabgelegt
.formula U|xtsel = U|xtsel + ";@ablage=(3)" ?  M|ybposoffen &  M|ybposabgelegt
.continue FI006
!EL006
.formula U|xtsel = U|xtsel + ";@ablage=(1)" ?  M|ybposoffen & _M|ybposabgelegt
.formula U|xtsel = U|xtsel + ";@ablage=(3)" ?                  M|ybposabgelegt
!FI006
.continue                                   ? _M|ybposoffen & _M|ybposabgelegt
!FI005
.load 0 group 'M|grliste' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy U|xbok = G|TRUE
.continue EL007 ? _((F|defined(M|yprjmeklspos)) ; (F|defined(M|yprjmvklspos)))
.copy U|xbok = G|false  ? _M|ybposgebucht & _0|ablagef & _0|kopf^uebertr
.continue FI007
!EL007
.continue EL008 ? _((_(F|defined(M|yprjmekrepos))) & (_(F|defined(M|yprjmvkrepos))))
.copy U|xbok = G|false  ? _M|ybposoffen    &  F|empty(0|status)
.continue EL009 ? _((F|defined(M|yprjmekbepos)) ; (F|defined(M|yprjmvkaupos)))
.copy U|xbok = G|false  ? _M|ybposabgelegt & _F|empty(0|status) & 0|lirelev
.continue EL010 ? _(0|rerelev)
.continue EL011 ? _(0|artex^gruppe = 4)
.continue EL012 ? _('0|artex^kategorie(L=":")' = "(Downpayment)")
.continue EL013 ? _(0|remge = 0)
.formula U|xtsel = "$,,orig==" + 0|id + ";kotyp==(Invoice);@filingmode=(Both)"
.load 9 group 'M|grliste' 'U|xtsel'
.copy U|xbok = G|false  ?  G|mehr & _M|ybposabgelegt
.copy U|xbok = G|false  ? _G|mehr & _M|ybposoffen
.continue FI013
!EL013
.copy U|xbok = G|false  ? _M|ybposoffen
!FI013
.continue FI012
!EL012
.copy U|xbok = G|false  ? _M|ybposabgelegt & _0|lirelev & 0|remge <= 0
!FI012
.continue FI011
!EL011
.copy U|xbok = G|false  ? _M|ybposabgelegt & _0|lirelev & 0|remge <= 0
!FI011
.continue FI010
!EL010
.copy U|xbok = G|false  ? _M|ybposabgelegt
!FI010
.continue FI009
!EL009
.copy U|xbok = G|false  ? _M|ybposabgelegt & _F|empty(0|status)
!FI009
!EL008
!FI007
.continue EL014 ? _(0|typ = G|ZUPOS)
.copy U|xbok = G|false  ? '0|artex^zptyp(L="0")' = "(27)"
.copy U|xbok = G|false  ? '0|artex^zptyp(L="0")' = "(28)"
!EL014
.continue EL015 ? _((U|xbok) & (0|typ <> G|SUPOS) & (0|typ <> G|ZSPOS) & (0|typ <> G|ESPOS) & (0|typ <> G|STPOS) & (0|typ <> G|SIPOS) & (0|typ <> G|TRPOS))
.make screen line +O
.formula M|ytbuaktion   = "icon:view"
.copy    M|ytverantwkst = H|yverantwkst
.assign  M|ytprojekt    = H|id
.copy    M|ytarbpaket   = 0|yprjmparbpaket          ?  F|defined(M|ytarbpaket)
.formula M|ytekvkpos    = 0|id
.formula M|ytliefname   = 0|kopf^lief^namebspr      ?  F|defined(M|ytliefname)
.formula M|ytkopf       = 0|kopf^id
.formula M|ytpnum       = 0|pnum
.copy    M|ytalternativpos = 0|alternativpos        ? F|defined(M|ytalternativpos)
.formula M|ytalternativgrp = 0|alternativgrp        ? F|defined(M|ytalternativgrp)
.formula M|ytvom        = 0|kovom
.copy    M|ytartex      = 0|artex
.formula M|yttename     = 0|artex^namebspr
.formula M|ytptext      = 0|ptext
.formula M|ytmge        = 0|mge
.copy    M|yteinh       = 0|he                      ? _F|empty(0|he)
.formula M|ytepreis     = 0|preis
.copy    M|ytbrutto     = 0|kobrutto
.formula M|ytstatus     = 0|status
.formula M|ytvom        = 0|kovom                   ?  F|defined(M|ytvom)
.formula M|ytbudat      = 0|kopf^budat              ?  F|defined(M|ytbudat)
.copy    M|ytorig       = 0|orig                    ?  F|defined(M|ytorig)
.copy    M|ytokopf      = 0|okopf                   ?  F|defined(M|ytokopf)
.copy    M|ytbablage      =  0|ablagef              ?  F|defined(M|ytbablage)
.copy    M|ytbgebucht     = _0|kopf^uebertr         ?  F|defined(M|ytbgebucht)
.copy    M|ytnullrechnung =  0|yprjmpnullrechnung   ?  F|defined(M|ytnullrechnung)
.copy    M|ytbudgetrech   =  0|kopf^yprjmbudgetrech ?  F|defined(M|ytbudgetrech)
.formula U|xxkurs = 1                               ?  0|pland = G|inland
.formula U|xxkurs = F|fxrate(G|inland, , 0|pland)   ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xxkurs = 0|kopf^ewkurs                   ? _0|pland = G|inland &  0|kopf^kursfix
.formula M|ytpwert      = 0|pwert * U|xxkurs
.formula M|ytnwert      = 0|nwert * U|xxkurs
.formula M|ytostwert    = 0|pwert             * U|xxkurs                ? _0|kobrutto
.formula M|ytostwert    =(0|pwert - 0|stwert) * U|xxkurs                ?  0|kobrutto
.continue EL016 ? _(F|defined(M|yteigenleist))
.formula M|yteigenleist    = 0|yprjmpeigenleist * U|xxkurs
.formula M|ytfremdleist    = 0|yprjmpfremdleist * U|xxkurs
.formula M|ytsonstkost     = 0|yprjmpsonstkost  * U|xxkurs
.formula M|ytfertleist     = 0|yprjmpfertleist  * U|xxkurs
.formula M|ytosteigenleist = 0|yprjmpeigenleist                           * U|xxkurs    ? _0|kobrutto
.formula M|ytosteigenleist =(0|yprjmpeigenleist / (1 + (0|stsatz / 100))) * U|xxkurs    ?  0|kobrutto
.formula M|ytostfremdleist = 0|yprjmpfremdleist                           * U|xxkurs    ? _0|kobrutto
.formula M|ytostfremdleist =(0|yprjmpfremdleist / (1 + (0|stsatz / 100))) * U|xxkurs    ?  0|kobrutto
.formula M|ytostsonstkost  = 0|yprjmpsonstkost                            * U|xxkurs    ? _0|kobrutto
.formula M|ytostsonstkost  =(0|yprjmpsonstkost  / (1 + (0|stsatz / 100))) * U|xxkurs    ?  0|kobrutto
.formula M|ytostfertleist  = 0|yprjmpfertleist                            * U|xxkurs    ? _0|kobrutto
.formula M|ytostfertleist  =(0|yprjmpfertleist  / (1 + (0|stsatz / 100))) * U|xxkurs    ?  0|kobrutto
!EL016
.continue EL017 ? _((F|defined(M|ytpftext)) & (_(F|empty(0|pftext))))
.select from '0|pftext'
.formula M|ytpftext = 0|pftext
!EL017
.continue EL018 ? _(F|defined(M|ytpvorgang))
.continue EL019 ? _(_(F|empty(0|yprjmppvorgang)))
.copy M|ytpvorgang  = 0|yprjmppvorgang
.continue EL020 ? _(F|defined(M|ytabrechtypk))
.continue EL021 ? _(_(F|empty(M|ytpvorgang^yvorpos)))
.load 9 group "3:2" 'M|ytpvorgang^yvorpos'
.copy M|ytabrechtypk = 9|yprjmpabrechtypk           ?  G|mehr
!EL021
.copy M|ytabrechtypk = M|ytprojekt^yabrechtypk      ? F|empty(M|ytabrechtypk)
!EL020
!EL019
!EL018
.continue EL022 ? _(F|defined(M|ytausloes))
.assign M|ytausloes = 0|yprjmpekposid       ? _F|empty(0|yprjmpekposid)
!EL022
.continue EL023 ? _(F|defined(M|ytbepos))
.formula U|xtsel = "$,,orig==" + 0|id + ";@ablageart=(Both)"
.load 9 group "4:2" 'U|xtsel'
.assign M|ytbepos = 9|id        ? G|mehr
!EL023
.continue EL024 ? _(F|defined(M|ytoffremge))
.formula M|ytoffremge   = 0|remge
.continue EL025 ? _((F|defined(M|yprjmekbepos)) ; (F|defined(M|yprjmvkaupos)))
.formula U|xtsel = "$,,orig==" + 0|id + ";kotyp==(PackingSlip);@filingmode=(Both)"
.load 9 group 'M|grliste' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula M|ytoffremge   = M|ytoffremge + 9|remge    ? _9|kopf^uebertr
.load 9 continue
.continue LOOP002
!ELOP002: ==============================
!EL025
!EL024
.continue EL026 ? _((F|defined(M|ytofflimge)) & (F|defined(M|ytoffremge)))
.formula M|ytofflimge   = 0|limge
.continue EL027 ? _(0|mge = 0)
.formula M|ytofflimge  = M|ytofflimge * U|xxkurs
.formula M|ytoffremge  = M|ytoffremge * U|xxkurs
.continue EL028 ? _(0|pwert = 0)
.formula M|ytoffliwert = M|ytofflimge
.formula M|ytoffwert   = M|ytoffremge
.continue FI028
!EL028
.formula M|ytoffliwert = 0|nwert / 0|pwert * M|ytofflimge
.formula M|ytoffwert   = 0|nwert / 0|pwert * M|ytoffremge
!FI028
.continue FI027
!EL027
.formula M|ytoffliwert = 0|nwert / 0|mge * M|ytofflimge * U|xxkurs
.formula M|ytoffwert   = 0|nwert / 0|mge * M|ytoffremge * U|xxkurs
!FI027
!EL026
.continue EL029 ? _((F|defined(M|ytreowert)) & (F|defined(M|ytliowert)))
.formula M|ytreowert = M|ytoffwert          ?  M|ytoffwert   > 0
.formula M|ytliowert = M|ytoffliwert        ?  M|ytoffliwert > 0
!EL029
!EL015
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.input 'F|foppath("IFOP.IS.PRJM.EKVKPOS.TAB")'  ? F|fileexists(F|foppath("IFOP.IS.PRJM.EKVKPOS.TAB"))
.continue
