..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : allpstart/FOP.PS.SEL.KEYFIGURES
.. Date           : 05.06.2013
.. Version        :
.. Author         : alltrotec/ts
.. Copyright      : (c) 1990 - 2014 alltrotec GmbH
.. Functionality  : writes the value for the passed in xtkeyfigure code into the variable xtvar
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
.set trans -
..
.type text    xtsel             ? _F|defined(U|xtsel)
.type text    xxtsel            ? _F|defined(U|xxtsel)
.type text    xtkeyfigure       ? _F|defined(U|xtkeyfigure)
.type text    xtproject         ? _F|defined(U|xtproject)
.type text    xtvar             ? _F|defined(U|xtvar)
.type real    xrvalue           ? _F|defined(U|xrvalue)
.type GD      xddate            ? _F|defined(U|xddate)
..
.continue               ? F|empty(U|xtkeyfigure)
..
.formula U|xrvalue = 0
.formula M|.xtvar  = 0  ? _F|empty(U|xtvar) & F|defined(M|.xtvar)
..
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt==" + U|xtproject + ";ykennzahl==" + U|xtkeyfigure
.formula U|xtsel = U|xtsel + ";ydatum="    + U|xddate:8                                       ? _F|empty(U|xddate)
.formula U|xtsel = U|xtsel + ";ydatum<="   + G|datum:8                                        ?  F|empty(U|xddate)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@order=ydatum.(Backwards);@maxhit=1"
.load 9 group "154:1" 'U|xtsel'
.continue                       ? _G|mehr
..
.formula M|.xtvar  = 9|ywert    ? _F|empty(U|xtvar) & F|defined(M|.xtvar)
.formula U|xrvalue = 9|ywert
..
.continue
