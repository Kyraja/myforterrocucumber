..!interpreter english declaration noabbrev
.. at 2017-06-20, 10:14
.set trans -
.continue   ? M|ybnofop
..========================================================================
..==  Name              : FOP.PRJM.PROJEKT.EV
..==  Pfad              : allpstart
..==  Funktion          : Funktionen am Projekt
..==  Erstellungsdatum  :
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtdatei xtext xtedpdat xtedpout xtedperr xtedpmsg xtfarbe
.type text    xtprojekt xtpvorgang xykoobjekt xtindex xtnummer xttaetschl xtid xterrtext xtvar
.type text    xttitel xttext1 xttext2
.type integer xifortschritt xianz xiindex xisvkrit xi1
.type real    xrfortschritt xrpvsollstd xrpvplanstd xrpviststd xrbetrag
.type GD      xdabdat xdftdat xdatum xdstart xdende
.type bool    xbnurpruef xbok xbmehr xyballschutz xybmeldung
.type bool    xbfehler          ? _F|defined(U|xbfehler)
.type bool    xbova             ? _F|defined(U|xbova)
.type P86:1   xpproject
.type P146:10 xptaetschl
.type AZK28044 xyprojstatk
.type AZK28032 xyprgtyp
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Pruefung_Datum -----
.continue EL001 ? _((_(F|empty(M|yftabdatum))) & (M|.evtvar < M|yftabdatum))
.set TRANS +
.box Fehler
Das Startdatum darf nicht hinter den fachtechnischen Abschluss verschoben werden.
.set TRANS -
.assign M|.evtvar = F|oldvalue(M|.evtvar)
.error
.end 1
!EL001
.continue EL002 ? _((_(F|empty(M|yabldat))) & (M|.evtvar < M|yabldat))
.set TRANS +
.box Fehler
Das Startdatum darf nicht hinter den kaufmÑnnischen Abschluss verschoben werden.
.set TRANS -
.assign M|.evtvar = F|oldvalue(M|.evtvar)
.error
.end 1
!EL002
.continue EL003 ? _((G|evtkommd = G|kaktname13) & (G|evtvar = "yadatum") & (_(F|empty(F|oldvalue(M|.evtvar)))))
.formula U|xdatum = F|oldvalue(M|.evtvar)
.formula U|xdatum = ('U|xdatum:8')<<6 + "01"
.formula U|xdatum = U|xdatum + 31
.formula U|xdatum = ('U|xdatum:8')<<6 + "01"
.formula U|xdatum = U|xdatum - 1
.formula U|xtsel = "$,,yprojekt==" + M|id + ";ystichtag==" + 'U|xdatum'
.formula U|xtsel = U|xtsel + ";ybabgeschlossen=1"
.formula U|xtsel = U|xtsel + ";yauposid==`"
.formula U|xtsel = U|xtsel + ";ytpposid==`"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrwipstat' 'U|xtsel'
.continue EL004 ? _(G|mehr)
.set TRANS +
.box Fehler
Der WiP-Statistiksatz zu bisheriger Startperiode ist bereits abgeschlossen.
?énderung des Startdatums nicht zulÑssig.   ? G|evtvar = "yadatum"
?énderung des Enddatums nicht zulÑssig.     ? G|evtvar = "yedatum"
.set TRANS -
.assign M|.evtvar = F|oldvalue(M|.evtvar)
.error
.end 1
!EL004
!EL003
.continue 'xprocst.xprocsp'
!PROC002: ----- PflichtfelderFarbe -----
.continue EL005 ? _(_(G|evtkommd = G|kaktname12))
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ybleistkat)
.colour -background 'U|xyfarbepflichtf' such        0
.colour -background 'U|xyfarbepflichtf' yprojekttyp 0
.continue EL006 ? _(M|bebuchbar)
.colour -background 'U|xyfarbepflichtf' yadatum     0
.colour -background 'U|xyfarbepflichtf' yedatum     0
.colour -background "-1 -1 -1"          ykunde      0   ? _M|yprojekttyp^ypfkunde
.colour -background 'U|xyfarbepflichtf' ykunde      0   ?  M|yprojekttyp^ypfkunde
.colour -background 'U|xyfarbepflichtf' ystatus     0
.colour -background 'U|xyfarbepflichtf' ytaetschl   0
.colour -background "-1 -1 -1"          yprojleit   0   ?  M|yprojekttyp^yprojvorlage
.colour -background 'U|xyfarbepflichtf' yprojleit   0   ? _M|yprojekttyp^yprojvorlage
.colour -background "-1 -1 -1"          yabrechtyp  0   ? _M|yprojekttyp^ypfabrechtyp
.colour -background 'U|xyfarbepflichtf' yabrechtyp  0   ?  M|yprojekttyp^ypfabrechtyp
.colour -background "-1 -1 -1"          yverantwkst 0   ?  M|yprojekttyp^yprojvorlage ; _F|sysinfo(18)^stbu
.colour -background 'U|xyfarbepflichtf' yverantwkst 0   ? _M|yprojekttyp^yprojvorlage &  F|sysinfo(18)^stbu
.colour -background "-1 -1 -1"          yprgtyp     0   ? _M|yprojekttyp^yprkaterf    ; _5|ybleistkat
.colour -background 'U|xyfarbepflichtf' yprgtyp     0   ?  M|yprojekttyp^yprkaterf    &  5|ybleistkat
.continue EL007 ? _(F|regmatch(P|maskkontextfop, ".*VERD.*"))
.formula P|maskkontextfop = F|regreplace('P|maskkontextfop', " VERD", " ")
.formula P|maskkontextfop = F|regreplace('P|maskkontextfop', "VERD ", " ")
.formula P|maskkontextfop = F|regreplace('P|maskkontextfop', "VERD", " ")
!EL007
.add M|yprojekttyp
.continue EL008 ? _(G|mehr)
.protection        ystatus 0                            ?  D|yprojvorlage
.protection -RESET ystatus 0                            ? _D|yprojvorlage
.colour -background "-1 -1 -1"          yktr  0
.colour -background "-1 -1 -1"          yvktr 0
.protection        yktr  0                              ? _D|ykoobjanlagek = "02" & _D|ykoobjanlagek = "05" & _F|empty(D|ykoobjanlagek)
.protection -RESET yktr  0                              ?  D|ykoobjanlagek = "02" ;  D|ykoobjanlagek = "05" ;  F|empty(D|ykoobjanlagek)
.colour -background 'U|xyfarbepflichtf' yktr  0         ?  D|ykoobjanlagek = "02" ;  D|ykoobjanlagek = "05"
!EL008
.continue FI006
!EL006
.colour -background "-1 -1 -1" yadatum     0
.colour -background "-1 -1 -1" yedatum     0
.colour -background "-1 -1 -1" ykunde      0
.colour -background "-1 -1 -1" ystatus     0
.colour -background "-1 -1 -1" ytaetschl   0
.colour -background "-1 -1 -1" yprojleit   0
.colour -background "-1 -1 -1" yabrechtyp  0
.colour -background "-1 -1 -1" yverantwkst 0
.colour -background "-1 -1 -1" yprgtyp     0
.formula P|maskkontextfop = P|maskkontextfop + " VERD " ? _F|regmatch(P|maskkontextfop, ".*VERD.*")
.formula U|xtindex = F|nextelem(M|name, "")
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xtindex)))
.protection -exception 'F|varname(M|name.U|xtindex)' 0
.formula U|xtindex = F|nextelem(M|name, U|xtindex)
.continue LOOP001
!ELOP001: ==============================
.protection -exception mwaehr           0
.protection -exception selbukreis       0
.protection -exception anmon            0
.protection -exception endmon           0
.protection -exception agjahr           0
.protection -exception egjahr           0
.protection -exception kumerrechnen     0
.protection -exception doku             0
.protection -exception belartproj       0
.protection -exception barcode          0
.protection -exception barcodezu        0
.protection -exception dndbetreff       0
.protection -exception dateiarchivieren 0
.protection -exception dragdropzu       0
.protection -exception dokumentbaurl    0
.protection -exception buinfosys 0
.protection -exception buaktion  0
.protection -exception budruck   0
.protection -exception such      0
.protection -exception name      0
.protection -exception verd      0
.protection -exception yprojekttyp 0
.protection -exception yftext    0
.protection -exception ybmaskezu 0
.protection -all
!FI006
!EL005
.continue 'xprocst.xprocsp'
!PROC003: ----- Feldpruefung_Farbe -----
.continue EL009 ? _((M|.evtvar < 0) ; (M|.evtvar > 255))
.set TRANS +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set TRANS -
.error
.end 1
!EL009
.continue 'xprocst.xprocsp'
!PROC004: ----- Farbe_setzen -----
.formula U|xtfarbe = 'M|yppfarber'     + " " + 'M|yppfarbeg'     + " " + 'M|yppfarbeb'      ? G|evtvar<<8  = "yppfarbe"
.formula U|xtfarbe = 'M|yppfortfarber' + " " + 'M|yppfortfarbeg' + " " + 'M|yppfortfarbeb'  ? G|evtvar<<12 = "yppfortfarbe"
.formula U|xtfarbe = "-1 -1 -1"                                                             ? U|xtfarbe = "0 0 0"
.colour -background 'U|xtfarbe' ysppfarbe                                                   ? G|evtvar<<8  = "yppfarbe"
.colour -background 'U|xtfarbe' ysppfortfarbe                                               ? G|evtvar<<12 = "yppfortfarbe"
.continue 'xprocst.xprocsp'
!PROC005: ----- Status_Vorlage_pruefen -----
.formula U|xtsel = "$,,yprojekt==" + M|id + ";@filingmode=(Active);@maxtreffer=1"
.load 0 group 'U|xydbgraufgabe' 'U|xtsel'
.continue EL010 ? _(G|mehr)
.set TRANS +
.box Hinweis
Zum Projekt existieren bereits Arbeitsaufgaben.
Status 'M|ystatus' ist nicht mehr erlaubt.
.set TRANS -
.error
.end 1
!EL010
.formula U|xtsel = "$,,yprojekt==" + M|id + ";@filingmode=(Active);@maxtreffer=1"
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL011 ? _(G|mehr)
.set TRANS +
.box Hinweis:
Zum Projekt existieren bereits Leistungsmeldungen.
Status 'M|ystatus' ist nicht mehr erlaubt.
.set TRANS -
.error
.end 1
!EL011
.formula U|xtsel = "$,,yprojekt==" + M|id + ";yvorpos<>`;@filingmode=(Active);@maxtreffer=1"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL012 ? _(G|mehr)
.set TRANS +
.box Achtung
In den ProjektvorgÑngen existieren noch
Verweise auf Auftragspositionen.

Diese sollten bei Vorlagen entfernt werden.
.set TRANS -
!EL012
.continue 'xprocst.xprocsp'
!PROC006: ----- Projekt_abschliessen -----
.continue EL013 ? _(_(F|empty(M|id)))
.copy U|xdftdat     = M|yftabdatum
.copy U|xdabdat     = M|yabldat
.copy U|xyprojstatk = M|ystatusk
.copy    U|xbnurpruef = G|TRUE
.copy    U|xbnurpruef = G|FALSE ? G|evtart = "maskende" ; G|evtart = "maskpruef"
.formula U|xtprojekt  = M|id
.input 'U|xtupprojab'
.continue EL014 ? _((U|xyprojstatk = "ABS") ; (U|xyprojstatk = "08"))
.continue EL015 ? _(U|xbok)
.continue EL016 ? _(_(G|evtart = "maskpruef"))
.set TRANS +
.box -BUTTON yes:no -TITLE Achtung
Beim Speichern wird das Projekt abgeschlossen!

Fortfahren?
.set TRANS -
.continue EL017 ? _(G|box = G|boxyes)
.assign U|xpproject = M|id
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.protection -EXCEPTION yabldat 0    ?  F|rec(U|xystclosingvars, ypmkabdatum)
.protection -RESET     yabldat 0    ?  F|rec(U|xystclosingvars, ypmkabdatum)
.protection            yabldat 0    ? _F|rec(U|xystclosingvars, ypmkabdatum)
.copy    M|ystatusk    = M|ystatusk
.copy    M|yablage     = G|TRUE
.copy    M|yabldat     = G|datum
.copy    M|ydatkfmab   = G|datum
.formula M|ybearbkfmab = G|bzeichen
.continue FI017
!EL017
.error
.end 1
!FI017
!EL016
.continue FI015
!EL015
.error
.end 1
!FI015
!EL014
.continue EL018 ? _(U|xyprojstatk = "FTAB")
.continue EL019 ? _(U|xbok)
.continue EL020 ? _(_(G|evtart = "maskpruef"))
.continue EL021 ? _(_(F|oldvalue(M|ystatusk) = M|ystatusk))
.assign U|xpproject = M|id
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.protection -EXCEPTION yftabdatum 0 ?  F|rec(U|xystclosingvars, ypmkabdatum)
.protection -RESET     yftabdatum 0 ?  F|rec(U|xystclosingvars, ypmtabdatum)
.protection            yftabdatum 0 ? _F|rec(U|xystclosingvars, ypmtabdatum)
.copy    M|ystatusk   = M|ystatusk
.copy    M|yablage    = G|FALSE
.assign  M|yabldat    = ""
.copy    M|yftabdatum = G|datum
.copy    M|ydatftab   = G|datum
.formula M|ybearbftab = G|bzeichen
.continue FI021
!EL021
.copy M|yftabdatum = F|oldvalue(M|yftabdatum)
.copy M|ydatftab   = F|oldvalue(M|ydatftab)
.copy M|ybearbftab = F|oldvalue(M|ybearbftab)
!FI021
!EL020
.continue FI019
!EL019
.error
.end 1
!FI019
!EL018
!EL013
.continue 'xprocst.xprocsp'
!PROC007: ----- Teilprojekt_Suchwort -----
.continue EL022 ? _(_(F|empty(M|yteilprojektzu)))
.protection -RESET ytpwert       0
.protection -RESET ytpoffwert    0
.protection -RESET ytpeigenleist 0
.protection -RESET ytpfremdleist 0
.protection -RESET ytpsonstkost  0
.protection -RESET ytpfertleist  0
.continue EL023 ? _((M|yprojekttyp^ybgensw) & ((G|evtkommd = G|kaktname14) ; (_((M|such>>4)/"*.*"))))
.assign  U|xi1 = 0
.formula U|xtsel = "$,,yteilprojektzu==" + M|yteilprojektzu^id + ";@filingmode=(Active)"
.select group "86:1" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL024 ? _((H|such/"*.*") & (H|id <> M|id))
.formula U|xtindex =  H|such>$"."
.assign  U|xi1     = 'U|xtindex'
.continue EL025 ? _(G|mehr)
.formula U|xiindex = U|xi1       ? U|xi1 > U|xiindex
!EL025
!EL024
.select continue
.continue LOOP002
!ELOP002: ==============================
.formula U|xiindex =  U|xiindex + 1
.formula U|xtindex = 'U|xiindex'
.formula U|xtindex = "0" + U|xtindex     ? U|xiindex < 10
.formula M|such = M|yteilprojektzu^such + "." + U|xtindex
!EL023
.continue FI022
!EL022
.protection ytpwert       0     ?  F|empty(M|yteilprojektzu)
.protection ytpoffwert    0     ?  F|empty(M|yteilprojektzu)
.protection ytpeigenleist 0     ?  F|empty(M|yteilprojektzu)
.protection ytpfremdleist 0     ?  F|empty(M|yteilprojektzu)
.protection ytpsonstkost  0     ?  F|empty(M|yteilprojektzu)
.protection ytpfertleist  0     ?  F|empty(M|yteilprojektzu)
.protection ybfreifuerhpl 0     ?  F|empty(M|yteilprojektzu)
!FI022
.continue 'xprocst.xprocsp'
!PROC008: ----- WiP_Darstellung -----
.continue EL026 ? _(G|evtkommd <> G|kaktname14)
.continue EL027 ? _((M|ywipdarst     <> F|oldvalue(M|ywipdarst)) ; (M|yermabgerstdk <> F|oldvalue(M|yermabgerstdk)))
.formula U|xtsel = "$,,yprojekt==" + M|id + ";ybabgeschlossen=0"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
.continue EL028 ? _(G|mehr)
.set TRANS +
.box -BUTTON yes:no
Die énderung der Darstellung des WiP fÅhrt zur Lîschung aller nicht abgeschlossenen WiP-Statistik-DatensÑtze zu diesem Projekt.
Wollen Sie wirklich eine énderung der WiP-Darstellung vornehmen?
.set TRANS -
.continue EL029 ? _(G|box = G|boxyes)
.formula U|xtsel = "$,,yprojekt==" + M|id + ";ybabgeschlossen=0"
.load 0 group 'U|xydbgrwipstat' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.select lock object '0|id'
.continue EL030 ? _(G|mehr)
.delete
.continue FI030
!EL030
.set TRANS +
.box Fehler
Es konnten nicht alle offenen WiP-Statistik-DatensÑtze zu diesem Projekt gelîscht werden.
énderung der WiP Darstellung ist nicht mîglich.
.set TRANS -
.assign M|ywipdarst = F|oldvalue(M|ywipdarst)
.load 0
!FI030
.load 0 continue
.continue LOOP003
!ELOP003: ==============================
.continue FI029
!EL029
.assign M|ywipdarst     = F|oldvalue(M|ywipdarst)
.assign M|yermabgerstdk = F|oldvalue(M|yermabgerstdk)
!FI029
!EL028
!EL027
!EL026
.formula M|ywipaenddarst = G|datum      ? M|ywipdarst <> F|oldvalue(M|ywipdarst)
.continue 'xprocst.xprocsp'
!PROC009: ----- UpdateAbweichung -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ybstdfortbudkrit)
.assign  U|xdstart  = ""
.assign  U|xdende   = ""
.formula U|xisvkrit = 1
.continue EL031 ? _(_(F|empty(M|id)))
.formula U|xtsel = "$,,yprojekt==" + M|id + ";ygehoertzu=`;@filingmode=(Active)"
.load 9 group "P149:2" 'xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.copy    U|xdstart = 9|yadatum  ? (U|xdstart > 9|yadatum & _F|empty(9|yadatum)) ; F|empty(U|xdstart)
.copy    U|xdende  = 9|yedatum  ? (U|xdende  < 9|yedatum & _F|empty(9|yedatum)) ; F|empty(U|xdende)
.formula U|xisvkrit = 1     ? U|xisvkrit < 1 & 9|yiconkritvorgang   = 5|ystdkritvoricont1
.formula U|xisvkrit = 2     ? U|xisvkrit < 2 & 9|yiconkritvorgang   = 5|ystdkritvoricont2
.formula U|xisvkrit = 3     ? U|xisvkrit < 3 & 9|yiconkritvorgang   = 5|ystdkritvoricont3
.formula U|xisvkrit = 4     ? U|xisvkrit < 4 & 9|yiconkritvorgang   = 5|ystdkritvoricont4
.formula U|xisvkrit = 5     ? U|xisvkrit < 5 & 9|yiconkritvorgang   = 5|ystdkritvoricont5
.load 9 continue
.continue LOOP004
!ELOP004: ==============================
!EL031
.continue EL032 ? _(_(F|empty(M|yedatum)))
.formula U|xdende = M|yedatum       ?  F|empty(U|xdende)
.formula M|yabwterminist  = F|numworkdays("", "", M|ydatumletztelm, M|yedatum) * (-1)   ? M|yedatum >= M|ydatumletztelm & _F|empty(M|yedatum) & _F|empty(M|ydatumletztelm)
.formula M|yabwterminist  = F|numworkdays("", "", M|yedatum, M|ydatumletztelm)          ? M|yedatum  < M|ydatumletztelm & _F|empty(M|yedatum) & _F|empty(M|ydatumletztelm)
.formula M|yabwterminist  = 0                                                           ?                                  F|empty(M|ydatumletztelm)
.formula M|yabwterminplan = F|numworkdays("", "", U|xdende, M|yedatum)         * (-1)   ? M|yedatum >= U|xdende         & _F|empty(M|yedatum) & _F|empty(U|xdende)
.formula M|yabwterminplan = F|numworkdays("", "", M|yedatum, U|xdende)                  ? M|yedatum  < U|xdende         & _F|empty(M|yedatum) & _F|empty(U|xdende)
.formula M|yabwterminplan = 0                                                           ?                                  F|empty(U|xdende)
.colour -foreground "0 0 0" yabwterminist  0
.colour -foreground "0 0 0" yabwterminplan 0
!EL032
.input "allpstart/FOP.PRJM.UP.ICONS"
.formula M|yiconkritvorgang   = 5|ystdkritvoricont.xisvkrit
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.assign U|xpproject = M|id
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL033 ? _(_(F|empty(M|yverantwkst)))
.assign U|xpproject = M|id
.input "allpstart/CHECK.PROJECT"
.continue EL034 ? _(_(U|xyberlaubt))
.error
.end 1
!EL034
!EL033
.continue EL035 ? _(G|evtkommd = G|kaktname10)
.select group 'U|xydbgrpvorgang' 'F|expr("$,,yprojekt==" + M|id + ";@filingmode=(Active)")'
.continue EL036 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projekt 'M|nummer'/'M|such' existieren ProjektvorgÑnge.
Das Projekt darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL036
.select group "3:1" 'F|expr("$,,yprjmproj==" + M|id + ";@filingmode=(Active)")'
.continue EL037 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projekt 'M|nummer'/'M|such' existieren offene VK VorgÑnge.
Das Projekt darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL037
.select group "3:2" 'F|expr("$,,projekt==" + M|id + ";@filingmode=(Active)")'
.continue EL038 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projekt 'M|nummer'/'M|such' existieren offene VK Positionen.
Das Projekt darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
.select group "4:1" 'F|expr("$,,yprjmproj==" + M|id + ";@filingmode=(Active)")'
!EL038
.continue EL039 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projekt 'M|nummer'/'M|such' existieren offene EK VorgÑnge.
Das Projekt darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL039
.select group "4:2" 'F|expr("$,,projekt==" + M|id + ";@filingmode=(Active)")'
.continue EL040 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projekt 'M|nummer'/'M|such' existieren offene EK Positionen.
Das Projekt darf nicht gelîscht werden!
.set TRANS -
