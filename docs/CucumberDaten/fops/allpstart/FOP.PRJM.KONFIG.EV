.type text    xtsel xtsys xtsich xtfarbe xtmailaml xtmailvz xtmailanh xtvar xterrtext
.type text    xttransdat xtpvorgang xttitel xtfile xtred xtgreen xtblue xtconffile
.type integer xifarbe ximonat xifile
.type integer xired xigreen xiblue
.type GD      xd1 xdwipvorper xdendwipstat xbudat
.type GD19    xd19
.type text    xttext        ? _F|defined(U|xttext)
.type text    xtini         ? _F|defined(U|xtini)
.type text    xttmp         ? _F|defined(U|xttmp)
.type text    xtmeldung     ? _F|defined(U|xtmeldung)
.type bool    xbini         ? _F|defined(U|xbini)
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Meldung_Neustart_erforderlich -----
.set trans +
.box Hinweis
Die énderung erfordert einen Neustart des Planers.
.set trans -
.continue 'xprocst.xprocsp'
!PROC002: ----- Protokoll_senden -----
.continue EL001 ? _(((F|empty(M|yprotdatpp)) & (G|evtvar = "ybuprotpp")) ; ((F|empty(M|yprotdatrp)) & (G|evtvar = "ybuprotrp")) ; ((F|empty(M|yprotdatpp)) & (G|evtvar = "ybuprotpe")))
.set trans +
.box Fehler
Es ist keine Protokolldatei angegeben.
.set trans -
.error
.end 1
.continue FI001
!EL001
.formula U|xtmailvz = M|yprotdatpp          ? G|evtvar = "ybuprotpp"
.formula U|xtmailvz = M|yprotdatrp          ? G|evtvar = "ybuprotrp"
.formula U|xtmailvz = M|yprotdatpp          ? G|evtvar = "ybuprotpe"
.formula U|xtmailvz = "win/" + U|xtmailvz<$"/"
.formula U|xtmailanh = "projektplaner.log." + G|sekundenz + ".tgz"
.continue EL002 ? _(F|fileexists(U|xtmailvz))
.formula U|xtsys  ="gtar cvzf " + U|xtmailanh + " " + U|xtmailvz
.system 'U|xtsys' BACKGROUND
.continue EL003 ? _(G|mehr)
.formula U|xtsys = "mv " + U|xtmailanh + " win/tmp/"
.system 'U|xtsys' BACKGROUND
.continue EL004 ? _(G|mehr)
.formula U|xtmailanh = G|clwindir + "/tmp/" + U|xtmailanh
.formula U|xtmailaml = "tmp/X.MAIL." + G|aufrufernr + ".AMF"
.file -tempname U|xttmp
.output new 'U|xttmp'
.input DATEI.F
[ABASMAIL]

   Value:
     0 = textbody (default)
     1 = htmlbody
HTMLBODY=0

   Only for Outlook
     0 = Email will be opened with Outlook (default)
     1 = Email will be send with Outlook (no preview!)
SEND=0

   Priority for Outlook:
     1 = priority high
     3 = priority normal (default)
     5 = priority low

   Werte fuer andere Mailclients:
     1 to 5  (3 = default)
PRIORITY=3

?SUBJECT=Protokoll Projektplaner        ? G|evtvar = "ybuprotpp"
?SUBJECT=Protokoll Ressourcenplaner     ? G|evtvar = "ybuprotrp"
?SUBJECT=Protokoll Personalplaner       ? G|evtvar = "ybuprotpe"

  BODY=

   You may change the name and adress from the sender
  FROMADRESS=
  FROMNAME=

   You could use an smtp server with send authentification
  USERNAME=mailuser
  USERPASS=mailuser_passwd

TO1=support@alltrotec.de


ATTACHMENT1='U|xtmailanh'

.out NEW WERF.WEG
.formula U|xtsys = "cp " + U|xttmp + " win/" + U|xtmailaml
.system 'U|xtsys' BACKGROUND
.formula U|xtsys = "pc.exec " + G|dblquote + "mail2mapi " + U|xtmailaml + G|dblquote
.'U|xtsys'
.continue FI004
!EL004
.set trans +
.box Fehler
Archivdatei 'U|xtmailanh' konnte nicht nach 'G|clwindir' verschoben werden.
.set trans -
.error
.end 1
!FI004
.continue FI003
!EL003
.set trans +
.box Fehler
Fehler beim Erstellen des Archives aus 'U|xtmailvz'.
.set trans -
.error
.end 1
!FI003
.continue FI002
!EL002
.set trans +
.box Fehler
Verzeichnis 'U|xtmailvz' ist nicht vorhanden.
.set trans -
.error
.end 1
!FI002
!FI001
.continue 'xprocst.xprocsp'
!PROC003: ----- Feldpruefung_Farbe -----
.assign U|xifarbe = G|evtfeldneu
.continue EL005 ? _(G|mehr)
.continue EL006 ? _((U|xifarbe < 0) ; (U|xifarbe > 255))
.set trans +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set trans -
.error
.end 1
!EL006
.continue FI005
!EL005
.set trans +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set trans -
.error
.end 1
!FI005
.continue 'xprocst.xprocsp'
!PROC004: ----- Variable_kaufm_Abschluss -----
.formula U|xtvar = "ypmk" + G|evtvar<<-4
.continue EL007 ? _(M|.evtvar)
.assign M|.xtvar = G|TRUE
.'F|expr("protection " + U|xtvar + " 0")'
.continue FI007
!EL007
.'F|expr("protection -RESET " + U|xtvar + " 0")'
!FI007
.continue 'xprocst.xprocsp'
!PROC005: ----- INI_Datei_kopieren -----
.continue EL008 ? _(F|fileexists(U|xtini))
.system 'F|expr("diff -q " + U|xttmp + " " + U|xtini)' BACKGROUND
.assign U|xbini = _G|mehr
.continue EL009 ? _(U|xbini)
.formula U|xtsich = U|xtini + "." + G|sekundenz
.formula U|xtsys = "mv " + U|xtini + " " + U|xtsich
.system 'U|xtsys' BACKGROUND
!EL009
!EL008
.continue EL010 ? _(U|xbini)
.formula U|xtsys = "cp " + U|xttmp + " " + U|xtini
.system 'U|xtsys' BACKGROUND
.continue EL011 ? _(G|mehr)
.formula U|xtsys = "chmod 440 " + U|xtini
.system 'U|xtsys' BACKGROUND
.set trans +
.formula U|xtmeldung = U|xtmeldung + ";" + U|xttext + " neue INI Datei " + G|dblquote + 'U|xtini' + G|dblquote + " erzeugt."
.set trans -
.system 'F|expr("trans.sh -l 22 " + U|xtini)' BACKGROUND
.continue FI011
!EL011
.set trans +
.box Achtung
Fehler beim Erstellen der INI Datei.
Bitte prÅfen.
.formula U|xtmeldung = U|xtmeldung + ";" + U|xttext + " Fehler beim Erstellen der INI Datei."
.set trans -
!FI011
!EL010
.continue 'xprocst.xprocsp'
!PROC006: ----- JournalkennzeichenPruefen -----
.continue EL012 ? _(_(F|empty(M|.evtvar)))
.continue EL013 ? _(_(F|sysinfo(7)^jdikenn = M|.evtvar))
.load 9 group "12:7" 'F|expr("$,,jkenn==" + M|.evtvar + ";@rows=(Yes);@filingmode=(Active)")'
.continue EL014 ? _(_(G|mehr))
.set trans +
.box Fehler
Das Journalkennzeichen muss in der Standardkontierung definiert sein.
.set trans -
.error (0)
.end 1
!EL014
!EL013
!EL012
.continue 'xprocst.xprocsp'
!PROC007: ----- FarbeMaske -----
.colour -background "-1 -1 -1" 'U|xtfarbe'                                                  ? U|xired = 0 & U|xigreen = 0 & U|xiblue = 0
.colour -background 'F|formatstr("{1} {2} {3}", U|xired, U|xigreen, U|xiblue)' 'U|xtfarbe'  ? U|xired > 0 ; U|xigreen > 0 ; U|xiblue > 0
.continue 'xprocst.xprocsp'
!PROC008: ----- Farbe_Projekt -----
.formula U|xtfarbe = 'M|yfrprojekt' + " " + 'M|yfgprojekt' + " " + 'M|yfbprojekt'
.formula U|xtfarbe = "-1 -1 -1"                ? U|xtfarbe = "0 0 0"
.colour -BACKGROUND 'U|xtfarbe' yfprojekt
.continue 'xprocst.xprocsp'
