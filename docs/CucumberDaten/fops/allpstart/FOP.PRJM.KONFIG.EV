.set trans +
.box Hinweis
Das aktuelle Farbschema wurde gespeichert.
Datei: 'U|xtfile'
.set trans -
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "ybufschemaloadind")
.formula U|xtfile = "allpstart/IND.CONFIG.COLORS.DEF"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET056" 
.continue PROC042
!RET056
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK011
.continue BRK012 ? _(G|evtvar = "ybufschemaloadstd")
.formula U|xtfile = "allpstart/PRJM.CONFIG.COLORS.DEF"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET057" 
.continue PROC042
!RET057
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK012
.continue BRK013 ? _(G|evtvar = "ybumessagebusconf")
.file -tempname U|xtconffile
.continue EL100 ? _(F|fileexists("allpstart/allamb/messagebus.conf"))
.system 'F|formatstr("cp -pfv {1} {2}", "allpstart/allamb/messagebus.conf", U|xtconffile)' background
.continue FI100
!EL100
.continue EL101 ? _(F|fileexists("allpstart/allamb/messagebus.conf.default"))
.system 'F|formatstr("cp -pfv {1} {2}", "allpstart/allamb/messagebus.conf.default", U|xtconffile)' background
!EL101
!FI100
.edit 'U|xtconffile'
.system 'F|formatstr("diff -q {1} {2}", "allpstart/allamb/messagebus.conf", U|xtconffile)' background
.continue EL102 ? _(_(G|status = 0))
.system 'F|formatstr("cp -pfv {2} {1}", "allpstart/allamb/messagebus.conf", U|xtconffile)' background
!EL102
.continue ESAC003
!BRK013
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
