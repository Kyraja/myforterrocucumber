.set trans +
.formula U|xterrtext = "Vor dem Speichern bitte folgende Pflichtfelder fÅllen:;" + U|xterrtext
.set trans -
.formula U|xtvar     = "ypmabzabgerechn"    ?  F|empty(M|ypmabzabgerechn)
.formula U|xtvar     = "ypmermwipleiart"    ?  F|empty(M|ypmermwipleiart)
