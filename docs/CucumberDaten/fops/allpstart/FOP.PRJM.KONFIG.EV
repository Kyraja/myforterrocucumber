.formula U|ximonat = 6  ? F|month(M|ypmwipperab) >  6
.formula U|ximonat = 9  ? F|month(M|ypmwipperab) >  9
.assign  U|xd19    = ">" + 'F|year(M|ypmwipperab)' + "Y" + 'U|ximonat' + "M" ? _U|ximonat = 12
.assign  U|xd19    = ">" + 'F|year(M|ypmwipperab)' + "Y-1Y"                  ?  U|ximonat = 12
.formula U|xd1     = U|xd19
.continue ESAC002
!BRK004
