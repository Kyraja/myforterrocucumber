.formula U|xtvar     = "ypmccvglwipaufwrt"  ?  F|empty(M|ypmccvglwipaufwrt)
.formula U|xtvar     = "ypmpcvglwipaufwrt"  ?  F|empty(M|ypmpcvglwipaufwrt)
.box Fehler
'U|xterrtext                                                            '
.cursor 'U|xtvar' 0
.error
.end 1
