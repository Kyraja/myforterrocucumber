..!interpreter english noabbrev
..*****************************************************************************
.. Name           : allpstart/FOP.PRJM.CRONJOBS
.. Datum/Date     : 14.11.2012
.. Version        :
.. Autor/Author   : allts
.. Copyright      : (c) 1990 - 2014 alltrotec GmbH
.. Beschreibung/
.. Description    : AudfÅhren der Cronjobs fÅr die Statistiken
..
...Includes       :
..*****************************************************************************
..
.set trans -
..
.type text xtprojekt            ? _F|defined(U|xtprojekt)
.type text xtmerkprojekt        ? _F|defined(U|xtmerkprojekt)
..
.formula U|xtmerkprojekt = U|xtprojekt
..
..*****************************************************************************
..
..Projektstatistik
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allpstart/FOP.PRJM.PROJEKTSTATISTIK.CRON"       ?  F|fileexists("allpstart/FOP.PRJM.PROJEKTSTATISTIK.CRON")
..
..Projektvorgangstatistik
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allpstart/FOP.PRJM.PVORGANGSTATISTIK.CRON"      ?  F|fileexists("allpstart/FOP.PRJM.PVORGANGSTATISTIK.CRON")
..
..Einkauf/Verkaufstatistik
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allpstart/FOP.VKSTATISTIK.CRON"                 ?  F|fileexists("allpstart/FOP.VKSTATISTIK.CRON")
..
..Teilprojektpositionen
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allpstd/FOP.PRJM.TPPOSSTATISTIK.CRON"           ?  F|fileexists("allpstd/FOP.PRJM.TPPOSSTATISTIK.CRON")
..
..Nachtragsstatistik
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allppro/FOP.PRJM.NACHTRAGSSTATISTIK.CRON"       ?  F|fileexists("allppro/FOP.PRJM.NACHTRAGSSTATISTIK.CRON")
..
..Kennzahlen berechnen (zum Schluss, da teilweise Werte aus den Statistiken kommen)
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allpstart/FOP.PRJM.KENNZAHLEN.CRON"             ?  F|fileexists("allpstart/FOP.PRJM.KENNZAHLEN.CRON")
..
..Stundenzettel (nur wenn Projekt leer, da Stundenzettel nicht projektbezogen sind)
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
.input "allpstart/FOP.PRJM.STUNDENZETTEL.CRON"          ?  F|fileexists("allpstart/FOP.PRJM.STUNDENZETTEL.CRON") & F|empty(U|xtmerkprojekt)
..
.formula U|xtprojekt = ""
.formula U|xtprojekt = U|xtmerkprojekt                  ? _F|empty(U|xtmerkprojekt)
..
.continue