!PROC004: ----- Variable_kaufm_Abschluss -----
.formula U|xtvar = "ypmk" + G|evtvar<<-4
.continue EL004 ? _(M|.evtvar)
.copy M|.xtvar = G|true
.'F|expr("protection " + U|xtvar + " 0")'
.continue FI004
!EL004
.'F|expr("protection -reset " + U|xtvar + " 0")'
!FI004
.continue 'xprocst.xprocsp'
!PROC005: ----- CheckForSumProj -----
.formula U|xtsel = "$,,id<>" + M|id + ";ybptverd==(Yes);@filingmode=(Active)"
.load 0 group "146:9" 'U|xtsel'
.continue EL005 ? _(_(G|mehr))
.set trans +
.box Fehler
Es existiert noch kein Projekttyp "Projekttyp fÅr Verdichtungsprojekt".
.set trans -
.error (0)
.end 1                              ? G|evtart = "maskpruef"
.copy M|ybverdprojekt = G|false     ? G|evtvar = "ybverdprojekt"
!EL005
.continue 'xprocst.xprocsp'
!PROC006: ----- CheckNK -----
.continue EL006 ? _(_(F|empty(M|.G|evtvar)))
.continue EL007 ? _(_('M|.G|evtvar^zieldn(L=":")' = "(Account)"))
.set trans +
.box Fehler
Es sind nur Nummernkreise fÅr die Datenbank Konto erlaubt.
.set trans -
.assign M|.G|evtvar = ""
!EL007
!EL006
.continue 'xprocst.xprocsp'
!PROC007: ----- Sichtbarkeit -----
.formula P|maskkontextfop = P|maskkontextfop + " " + "FOP_PTAB"                 ?  M|ypmptabschluss & _F|regmatch(P|maskkontextfop, ".*FOP_PTAB.*")
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "FOP_PTAB", "")   ? _M|ypmptabschluss &  F|regmatch(P|maskkontextfop, ".*FOP_PTAB.*")
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
