.type text    xtsys xtsel xtindex
.type text    xtext xterrtext xtvar
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Fehler_Kontext -----
.set trans +
.box Fehler
Aufrufparameter passt nicht zum Aufrufkontext.
.set trans -
.assign M|.evtvar = ""
.continue 'xprocst.xprocsp'
!PROC002: ----- PflichtfelderFarbe -----
.continue EL001 ? _((_(G|edp)) & (_(G|evtkommd = G|kaktname12)))
.colour -background 'U|xyfarbepflichtf' such        0
.colour -background "-1 -1 -1"          ybkonumkreis  0     ? _M|ykoobjanlagek = "03" & _M|ykoobjanlagek = "04" & _M|ykoobjanlagek = "06"
.colour -background "-1 -1 -1"          yvkonumkreis  0     ?                                                     _M|ykoobjanlagek = "06"
.colour -background 'U|xyfarbepflichtf' ybkonumkreis  0     ?  M|ykoobjanlagek = "03" ;  M|ykoobjanlagek = "04" ;  M|ykoobjanlagek = "06"
.colour -background 'U|xyfarbepflichtf' yvkonumkreis  0     ?                                                      M|ykoobjanlagek = "06"
!EL001
.continue 'xprocst.xprocsp'
!PROC003: ----- Schutz -----
.continue EL002 ? _(M|ybptverd)
.protection -exception buinfosys 0
.protection -exception buaktion  0
.protection -exception budruck   0
.protection -exception such      0
.protection -exception name      0
.protection -exception ybptverd  0
.formula U|xtindex = F|nextelem(M|name, "")
!LOOP001: ==============================
.continue ELOP001 ? _(_(F|empty(U|xtindex)))
.protection -exception 'F|varname(M|name.U|xtindex)' 0
.formula U|xtindex = F|nextelem(M|name, U|xtindex)
.continue LOOP001
!ELOP001: ==============================
.protection -all
.continue FI002
!EL002
.protection -reset -all
.protection        yverdktrtp    0  ?                           _M|ykoobjanlagek = "04" & _M|ykoobjanlagek = "06"
.protection        ybkonumkreis  0  ? _M|ykoobjanlagek = "03" & _M|ykoobjanlagek = "04" & _M|ykoobjanlagek = "06"
.protection        yvkonumkreis  0  ?                                                     _M|ykoobjanlagek = "06"
.protection        ybautomktrabs 0  ?                                                     _M|ykoobjanlagek = "06"
.protection -reset yverdktrtp    0  ?                            M|ykoobjanlagek = "04" ;  M|ykoobjanlagek = "06"
.protection -reset ybkonumkreis  0  ?  M|ykoobjanlagek = "03" ;  M|ykoobjanlagek = "04" ;  M|ykoobjanlagek = "06"
.protection -reset yvkonumkreis  0  ?                                                      M|ykoobjanlagek = "06"
.protection -reset ybautomktrabs 0  ?                                                      M|ykoobjanlagek = "06"

.protection        yverdteilprojekt 0   ? _M|ybverdprojekt
