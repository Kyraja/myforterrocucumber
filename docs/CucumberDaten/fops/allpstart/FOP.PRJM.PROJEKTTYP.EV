.set trans -
.formula U|xtvar     = "ybkonumkreis"   ? F|empty(M|ybkonumkreis) & (M|ykoobjanlagek = "03" ;  M|ykoobjanlagek = "04" ;  M|ykoobjanlagek = "06")
