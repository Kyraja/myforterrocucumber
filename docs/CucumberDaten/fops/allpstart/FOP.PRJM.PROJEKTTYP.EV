.formula U|xterrtext = U|xterrtext + G|trennerchar + F|vardescr(M|yvkonumkreis, G|bsprache) ? F|empty(M|yvkonumkreis) &  M|ykoobjanlagek = "06"
.continue EL011 ? _(_(F|empty(U|xterrtext)))
.set trans +
