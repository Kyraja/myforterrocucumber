.assign  U|xrlmgenauigkeit = 'F|sysinfo(10)^ykonfigprjm^ypmlmgenaugkk'  ?  F|empty(M|yprojekt)
.assign  U|xrlmgenauigkeit = 'M|yprojekt^ylmgenauigkeitk'               ? _F|empty(M|yprojekt)
.'F|expr("formula " + U|xtpuffer + "|yfaktzeit =  F|mround(U|xrbilltime, U|xrlmgenauigkeit,1)")'    ?  U|xrlmgenauigkeit <> 0
.'F|expr("formula " + U|xtpuffer + "|yfaktzeit =  U|xrbilltime")'                                   ?  U|xrlmgenauigkeit =  0
.continue FI050
!EL050
.'F|expr("formula " + U|xtpuffer + "|yfaktzeit = 0")'
!FI050
.continue EL051 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.continue EL052 ? _((_(G|evtart = "zeileloenach")) ; (G|evtzeile < M|tzeilen))
.select screen line 'G|evtzeile'
.continue FI052
!EL052
