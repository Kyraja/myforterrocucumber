.type bool    xbignid           ? _F|defined(U|xbignid)
.type bool    xblnstorno        ? _F|defined(U|xblnstorno)
.type bool    xbschutz          ? _F|defined(U|xbschutz)
.type bool    xblsrelev         ? _F|defined(U|xblsrelev)
.type bool    xbtlsrelev        ? _F|defined(U|xbtlsrelev)
.type bool    xybstorno         ? _F|defined(U|xybstorno)
.type P3:2    xpaupos           ? _F|defined(U|xpaupos)
.type bool    xbkat             ? _F|defined(U|xbkat)
.type bool    xbpreis           ? _F|defined(U|xbpreis)
.type bool    xbsave            ? _F|defined(U|xbsave)
.type bool    xbtzeit           ? _F|defined(U|xbtzeit)
.type text    xysel             ? _F|defined(U|xysel)
.type P86:1   xpproject         ? _F|defined(U|xpproject)
.type P86:1   xpprojekt         ? _F|defined(U|xpprojekt)
.type P149:3  xpaufgabe         ? _F|defined(U|xpaufgabe)
.type integer   xprocsp ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Schutz_Kopf -----
.continue EL001 ? _((F|empty(M|ytransaktion)) & (F|empty(M|ysstornodurch)))
.copy U|xbschutz = G|FALSE
.select screen header
.select screen line
.copy U|xbmehr = G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(xbmehr)
.continue EL002 ? _((F|empty(M|ytazeit)) & (F|empty(M|ytezeit)) & (M|ytarbzeit  = 0) & (M|ytfaktzeit = 0))
.select screen line
.copy U|xbmehr = G|mehr
.continue FI002
!EL002
.copy U|xbschutz = G|TRUE
.copy U|xbmehr   = G|FALSE
!FI002
.continue LOOP001
!ELOP001: ==============================
.continue EL003 ? _(U|xbschutz)
.protection yadatum
.protection yedatum
.protection yazeit
.protection yezeit
.continue FI003
!EL003
.protection -RESET yadatum
.protection -RESET yedatum
.protection -RESET yazeit
.protection -RESET yezeit
!FI003
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Schutz -----
.continue EL004 ? _((F|empty(M|ytransaktion)) & (F|empty(M|ysstornodurch)))
.protection        ytaetschl 'M|aktzeile'       ? _F|empty(M|yaufgabe)
.protection -RESET ytaetschl 'M|aktzeile'       ?  F|empty(M|yaufgabe) & F|empty(M|ystornolm)
.protection        ykunde    'M|aktzeile'       ? _F|empty(M|yaufgabe)
.protection -RESET ykunde    'M|aktzeile'       ?  F|empty(M|yaufgabe) & F|empty(M|ystornolm)
.protection        ykunde2   'M|aktzeile'       ? _F|empty(M|yaufgabe)
.protection -RESET ykunde2   'M|aktzeile'       ?  F|empty(M|yaufgabe) & F|empty(M|ystornolm)
.protection        ykstelle  'M|aktzeile'       ? _F|empty(M|yaufgabe)
.protection -RESET ykstelle  'M|aktzeile'       ?  F|empty(M|yaufgabe) & F|empty(M|ystornolm)
.protection -RESET yarchiv   'M|aktzeile'       ?                        F|empty(M|ystornolm)
.protection -RESET ylsrelev  'M|aktzeile'       ?                        F|empty(M|ystornolm)
.protection        ynachtrag    'M|aktzeile'    ?  M|ynachtragbeh
.protection -RESET ynachtrag    'M|aktzeile'    ? _M|ynachtragbeh
.continue EL005 ? _(_(G|evtkommd = G|kaktname2))
.protection        such      0          ?  M|yprojekt^yprojekttyp^ybgleichessw
.protection -RESET such      0          ? _M|yprojekt^yprojekttyp^ybgleichessw
!EL005
.continue EL006 ? _(G|evtkommd = G|kaktname13)
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"           ? _F|defined(5|ypmerllmaendfakt)
.copy U|xbok = G|TRUE
.continue EL007 ? _((_(F|empty(5|ypmerllmaendfakt))) & (F|sysinfo(18)^allppro))
.copy U|xbok = G|FALSE
.continue EL008 ? _(_(F|protected(M|ylsrelev, M|aktzeile)))
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"
.copy U|xbok = F|defined(F|map(U|xypermissions, '5|ypmerllmaendfakt^id'))
!EL008
.continue EL009 ? _(_(U|xbok))
.protection ylsrelev  'M|aktzeile'
.protection yfaktzeit 'M|aktzeile'
!EL009
!EL007
!EL006
!EL004
.continue 'xprocst.xprocsp'
!PROC003: ----- CheckDelete -----
.continue EL010 ? _(F|defined(M|ytransaktion))
.continue EL011 ? _(_(F|empty(M|ytransaktion)))
.set TRANS +
.box Achtung
Die Leistungsmeldung ist bereits gebucht
und darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL011
!EL010
.continue EL012 ? _(_(F|empty(M|yabrechnung)))
.set TRANS +
.box Achtung
Die Leistungsmeldung ist bereits
in der Abrechnung 'M|yabrechnung'eingetragen
und darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL012
.continue EL013 ? _(_(F|empty(M|ymzabrechnung)))
.set TRANS +
.box Achtung
Die Leistungsmeldung ist bereits
in der Abrechnung 'M|ymzabrechnung'eingetragen
und darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL013
.continue EL014 ? _((_(F|empty(M|ylsposid))) ; (_(F|empty(M|yreposid))))
.set TRANS +
.box Achtung
Die Leistungsmeldung ist bereits
?im Lieferschein 'M|ylsnum' eingetragen         ? _F|empty(M|ylsnum)
?in der Rechnung 'M|yrenum' eingetragen         ? _F|empty(M|yrenum)
und darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL014
.continue EL015 ? _((_(F|empty(M|ymzlsposid))) ; (_(F|empty(M|ymzreposid))))
.set TRANS +
.box Achtung
Die Leistungsmeldung ist bereits
?im Lieferschein 'M|ymzlsnum' eingetragen       ? _F|empty(M|ymzlsnum)
?in der Rechnung 'M|ymzrenum' eingetragen       ? _F|empty(M|ymzrenum)
und darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL015
.select group 'U|xydbgrlnachweis' 'F|expr("$,,ystornolm==" + M|id + ";@filingmode=(Active)")'
.continue EL016 ? _(G|mehr)
.set TRANS +
.box Achtung
Die Leistungsmeldung wurde durch 'H|ystornolm' storniert
und darf nicht gelîscht werden!
.set TRANS -
.error
.end 1
!EL016
.continue 'xprocst.xprocsp'
!PROC004: ----- PflichtfelderFarbe -----
.continue EL017 ? _(_(G|evtkommd = G|kaktname12))
.colour -BACKGROUND 'U|xyfarbepflichtf' such      0
.colour -BACKGROUND 'U|xyfarbepflichtf' yadatum   0
.colour -BACKGROUND 'U|xyfarbepflichtf' yedatum   0
.colour -BACKGROUND 'U|xyfarbepflichtf' ypersonal 0
.colour -BACKGROUND "-1 -1 -1"          yaufgabe  0
.colour -BACKGROUND 'U|xyfarbepflichtf' yaufgabe  0     ?  F|empty(M|ytaetschl) ; _M|ytaetschl^ygkzeiterl
.colour -BACKGROUND "-1 -1 -1"          ytaetschl 0
.colour -BACKGROUND 'U|xyfarbepflichtf' ytaetschl 0     ?  F|empty(M|yaufgabe)
.colour -BACKGROUND "-1 -1 -1"          ykstelle  0     ? _F|empty(M|yaufgabe) ; _F|sysinfo(18)^stbu
.colour -BACKGROUND 'U|xyfarbepflichtf' ykstelle  0     ?  F|empty(M|yaufgabe) &  F|sysinfo(18)^stbu
!EL017
.continue 'xprocst.xprocsp'
!PROC005: ----- Restzeit_vorbelegen -----
.continue EL018 ? _((_(F|empty(M|yaufgabe))) & (_(G|evtkommd = G|kaktname2)))
.formula M|yrestzeit = M|yaufgabe^yplanstd - M|yaufgabe^yiststd - M|yarbzeit                            ?  G|evtkommd = G|kaktname2
.formula M|yrestzeit = M|yaufgabe^yplanstd - M|yaufgabe^yiststd - M|yarbzeit + F|oldvalue(M|yarbzeit)   ? _G|evtkommd = G|kaktname2

.formula M|yrestzeit = 0        ? M|yrestzeit < 0
!EL018
.continue 'xprocst.xprocsp'
!PROC006: ----- Pruefung_Planzeit -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|yupuebbuch)
.input '5|yupuebbuch'                       ? _F|empty(5|yupuebbuch) & F|fileexists(F|foppath(5|yupuebbuch))
.continue 'xprocst.xprocsp'
!PROC007: ----- Pruefung_LM_Aendern -----
.continue EL019 ? _(M|ablagef)
.set TRANS +
.box Fehler
Die Leistungsmeldung befindet sich bereits in der Ablage.
.set TRANS -
.error
.end 1
.continue FI019
!EL019
.continue EL020 ? _(_(G|evtkommd = G|kaktname12))
.set TRANS +
.box Fehler
Der Vorgang ist nur im <zeigen> mîglich.
.set TRANS -
.error
.end 1
.continue FI020
!EL020
.input "allpstart/CHECK.RECORD.LOCK"
.select lock add M|id
.continue EL021 ? _(_(G|mehr))
.set TRANS +
.box Fehler
Die Leistungsmeldung kann nicht zur Bearbeitung geladen werden.
.set TRANS -
.error
.end 1
.continue FI021
!EL021
.select -
!FI021
!FI020
!FI019
.continue 'xprocst.xprocsp'
!PROC008: ----- Berechnung_Dauer_Tabelle -----
.continue EL022 ? _((_(F|empty(M|ytadatum))) & (_(F|empty(M|ytedatum))) & (_(F|empty(M|ytazeit))) & (_(F|empty(M|ytezeit))))
.formula M|ytarbzeit  = ((M|ytedatum - M|ytadatum) * U|xraztag) + ((M|ytezeit - M|ytazeit) / 60)
.formula M|ytarbzeit  = 0       ? M|ytarbzeit < 0
.formula M|ytarbzeit  = 99.99   ? M|ytarbzeit > 99.99
.formula M|ytfaktzeit = 0
.continue FI022
!EL022
.formula M|ytarbzeit  = 0
!FI022
.continue EL023 ? _(M|ylsrelev)
.assign  U|xrlmgenauigkeit = 'F|sysinfo(10)^ykonfigprjm^ypmlmgenaugkk'  ?  F|empty(M|yprojekt)
.assign  U|xrlmgenauigkeit = 'M|yprojekt^ylmgenauigkeitk'               ? _F|empty(M|yprojekt)
.formula M|ytfaktzeit       = F|mround(M|ytarbzeit,U|xrlmgenauigkeit,1) ?  U|xrlmgenauigkeit <> 0
.formula M|ytfaktzeit       = M|ytarbzeit                               ?  U|xrlmgenauigkeit =  0
!EL023
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC005
!RET001
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC009: ----- Stundenzettel_pruefen -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|yartstdfreigabek)
.continue EL024 ? _((_(F|empty(5|yartstdfreigabek))) & (_(F|empty(M|yadatum))) & (_(F|empty(M|ypersonal))))
.copy U|xbmehr = G|TRUE
.continue EL025 ? _(F|year(M|yadatum) > 1980)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" +  M|ypersonal^id
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'F|month(M|yadatum)'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'F|year(M|yadatum)'
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(No)"
.load 0 group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL026 ? _(G|mehr)
.continue EL027 ? _(_(0|ybgesabschluss))
.continue EL028 ? _(5|yartstdfreigabek = "KST")
.formula U|xtkstelle = ""
.continue EL029 ? _(F|empty(M|yaufgabe))
.formula U|xtkstelle = M|ykstelle^id
.formula U|xtkstelle = M|ypersonal^ykstelle^id  ? F|empty(M|ykstelle)
.continue FI029
!EL029
.formula U|xtkstelle = M|yaufgabe^yverantwkst^id                ?  F|empty(M|yaufgabe^yprojekt)
.formula U|xtkstelle = M|yaufgabe^yprojekt^yverantwkst^id       ? _F|empty(M|yaufgabe^yprojekt)
!FI029
!EL028
.load 0 line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL030 ? _(((5|yartstdfreigabek = "PROJ") & (0|yprojekt^id = M|yaufgabe^yprojekt^id) & (0|ybfreigabe)) ; ((5|yartstdfreigabek = "KST") & (0|ykstelle^id = U|xtkstelle) & (0|ybfreigabe)))
.set TRANS +
.box Hinweis
?Der Stundenzettel fÅr das Projekt '0|yprojekt^such' im Monat '0|ymonat'/'0|yjahr' wurde bereits freigegeben.       ? 5|yartstdfreigabek = "PROJ"
?Der Stundenzettel fÅr die Kostenstelle '0|ykstelle^such' im Monat '0|ymonat'/'0|yjahr' wurde bereits freigegeben.  ? 5|yartstdfreigabek = "KST"
Weitere Leistungsmeldungen dÅrfen fÅr diesen Zeitraum nicht mehr erfasst werden.
.set TRANS -
.continue EL031 ? _(G|evtart = "maskein")
.protection -EXCEPTION buinfosys   0
.protection -EXCEPTION buaktion    0
.protection -EXCEPTION budruck     0
.protection -EXCEPTION ylsrelev    0
.protection -EXCEPTION yvkartikel  0
.protection -EXCEPTION ymaschvkart 0
.protection -ALL
.continue FI031
!EL031
.copy U|xbmehr = G|FALSE
.continue EL032 ? _(_(G|evtart = "maskaus"))
.formula M|.evtvar = F|oldvalue(M|.evtvar)  ? G|evtart = "feldaus"
.error
.end 1
!EL032
!FI031
!EL030
.load 0 line
.continue LOOP002
!ELOP002: ==============================
.continue FI027
!EL027
.set TRANS +
.box Hinweis
Der Stundenzettel fÅr den Monat '0|ymonat'/'0|yjahr' wurde bereits freigegeben.
Weitere Leistungsmeldungen dÅrfen fÅr diesen Zeitraum nicht mehr erfasst werden.
.set TRANS -
.continue EL033 ? _(G|evtart = "maskein")
.protection -EXCEPTION buinfosys   0
.protection -EXCEPTION buaktion    0
.protection -EXCEPTION budruck     0
.protection -EXCEPTION ylsrelev    0
.protection -EXCEPTION yvkartikel  0
.protection -EXCEPTION ymaschvkart 0
.protection -ALL
.continue FI033
!EL033
.copy U|xbmehr = G|FALSE
.continue EL034 ? _(_(G|evtart = "maskaus"))
.formula M|.evtvar = F|oldvalue(M|.evtvar)  ? G|evtart = "feldaus"
.error
.end 1
!EL034
!FI033
!FI027
!EL026
!EL025
!EL024
.continue 'xprocst.xprocsp'
!PROC010: ----- WIPAbschlussPruefen -----
.continue EL035 ? _(_(F|empty(M|yprojekt)))
.formula U|xybudat = (M|yadatum:8)<<6 + "01"
.formula U|xybudat =  U|xybudat + 31
.formula U|xybudat = (U|xybudat:8)<<6 + "01"
.formula U|xybudat =  U|xybudat - 1
.formula U|xtsel = "$,,yprojekt==" + M|yprojekt^id + ";ystichtag==" + U|xybudat:8 + ";ybabgeschlossen==(Yes);@filingmode=(Active)"
.load 8 group 'U|xydbgrwipstat' 'U|xtsel'
.continue EL036 ? _(G|mehr)
.set trans +
.formula U|xtsel = F|formatstr("WiP fÅr das Projekt {1} ist bereits abgeschlossen.", M|yprojekt^such)
.box Fehler
'U|xtsel'
Weitere Leistungsmeldungen dÅrfen fÅr diesen Zeitraum nicht mehr erfasst werden.
.set trans -
.continue EL037 ? _(G|evtart = "maskein")
.protection -EXCEPTION buinfosys   0
.protection -EXCEPTION buaktion    0
.protection -EXCEPTION budruck     0
.protection -EXCEPTION ylsrelev    0
.protection -EXCEPTION yvkartikel  0
.protection -EXCEPTION ymaschvkart 0
.protection -ALL
.continue FI037
!EL037
.copy U|xbmehr = G|FALSE
.continue EL038 ? _(_(G|evtart = "maskaus"))
.formula M|.evtvar = F|oldvalue(M|.evtvar)  ? G|evtart = "feldaus"
.error
.end 1
!EL038
!FI037
!EL036
!EL035
.continue 'xprocst.xprocsp'
!PROC011: ----- Datum_FP -----
.continue EL039 ? _(_(F|empty(M|.evtvar)))
.copy U|xdatum = M|.evtvar
