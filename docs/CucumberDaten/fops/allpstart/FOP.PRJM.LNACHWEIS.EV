.continue 'xprocst.xprocsp'
!PROC013: ----- StartEnd -----
.assign  M|ytstart = 'M|ytadatum' + " " + 'M|ytazeit'
.assign  M|ytend   = 'M|ytadatum' + " " + 'M|ytezeit'
.continue 'xprocst.xprocsp'
!PROC014: ----- BerechnungFakturierbar -----
.continue EL053 ? _(M|ylsrelev)
.continue EL054 ? _(U|xbtzeit)
.assign  U|xrlmgenauigkeit = 'F|sysinfo(10)^ykonfigprjm^ypmlmgenaugkk'  ?  F|empty(M|yleistmeld^yprojekt)
.assign  U|xrlmgenauigkeit = 'M|yprojekt^ylmgenauigkeitk'               ? _F|empty(M|yleistmeld^yprojekt)
.continue FI054
!EL054
.assign  U|xrlmgenauigkeit = 'F|sysinfo(10)^ykonfigprjm^ypmlmgenaugkk'  ?  F|empty(M|yprojekt)
.assign  U|xrlmgenauigkeit = 'M|yprojekt^ylmgenauigkeitk'               ? _F|empty(M|yprojekt)
!FI054
.formula M|yfaktzeit       =  F|mround(M|yarbzeit,U|xrlmgenauigkeit,1)  ?  U|xrlmgenauigkeit <> 0
.formula M|yfaktzeit       =  M|yarbzeit                                ?  U|xrlmgenauigkeit =  0
.continue FI053
!EL053
.formula M|yfaktzeit = 0
!FI053
.continue 'xprocst.xprocsp'
!PROC015: ----- Berechnung_Dauer -----
.continue EL055 ? _((_(F|empty(M|yadatum))) & (_(F|empty(M|yedatum))) & (_(F|empty(M|yazeit))) & (_(F|empty(M|yezeit))))
.formula M|yarbzeit  = ((M|yedatum - M|yadatum) * U|xraztag) + ((M|yezeit - M|yazeit) / 60)
.formula M|yarbzeit  = 0       ? M|yarbzeit < 0
.formula M|yarbzeit  = 99.99   ? M|yarbzeit > 99.99
.continue FI055
!EL055
.formula M|yarbzeit  = 0
!FI055
.continue EL056 ? _((M|yaufgabe^ybnichtuebbuch) & (_(F|empty(M|yaufgabe))))
