!PROC018: ----- Kostenrechnungsdaten_PRAA -----
.continue EL089 ? _(G|evtkommd = G|kaktname12)
.continue EL090 ? _(F|empty(H|yprojekt))
.continue EL091 ? _(F|empty(H|yaufgabe))
.continue EL092 ? _(F|empty(H|ytaetschl^ykstelle))
.copy   H|ykstelle        = H|yperskstelle  ?  F|empty(H|ykstelle) ; G|evtvar = "ybukorefeldneu" ; G|evtvar = "ybukorefeldneuedp"
.assign H|ypraaverantwkst = ""
.copy   H|ypraaktr        = H|yperskstelle  ?  H|ytaetschl^ystammkst ; F|empty(H|ypraaktr)
.continue FI092
!EL092
.copy   H|ykstelle        = H|ytaetschl^ykstelle    ?  F|empty(H|ykstelle) ; G|evtvar = "ytaetschl" ; G|evtvar = "ybukorefeldneu" ; G|evtvar = "ybukorefeldneuedp"
.assign H|ypraaverantwkst = ""
.copy   H|ypraaktr        = H|ytaetschl^ykstelle
!FI092
.continue FI091
!EL091
.copy H|ypraaverantwkst = H|yaufgabe^yverantwkst
.copy H|ypraaktr        = H|yaufgabe^yktr
.copy H|ykstelle        = H|yaufgabe^yverantwkst
!FI091
.continue FI090
!EL090
.copy H|ypraaverantwkst = H|yprojekt^yverantwkst
.copy H|ypraaktr        = H|yprojekt^yktr
.copy H|ykstelle        = H|yprojekt^yverantwkst
!FI090
.copy H|yleiart = H|ypersleiart ? _F|empty(H|ypersleiart)
.continue FI089
