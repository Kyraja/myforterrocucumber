!PROC012: ----- Kopfdaten -----
.continue EL041 ? _((G|evtkommd = G|kaktname13) ; (G|evtkommd = G|kaktname14))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
!EL041
.formula U|xtpuffer = "M"
.formula U|xtpuffer = "H"       ? G|evtkommd = G|kaktname2
.assign  U|xdfirst = ""
.assign  U|xdlast  = ""
.assign  U|xzfirst = ""
.assign  U|xzlast  = ""
.formula U|xrworktime = 0
.formula U|xrbilltime = 0
.continue EL042 ? _(F|eval(F|expr(U|xtpuffer + "|tzeilen")) > 0)
.copy U|xbok = G|FALSE
.select screen header   ? G|evtkommd <> G|kaktname2
.select        header   ? G|evtkommd =  G|kaktname2
.select screen line     ? G|evtkommd <> G|kaktname2
.select        line     ? G|evtkommd =  G|kaktname2
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.'F|expr("formula U|xdtadatum   = " + U|xtpuffer + "|ytadatum")'
.'F|expr("formula U|xdtedatum   = " + U|xtpuffer + "|ytedatum")'
.'F|expr("formula U|xztazeit    = " + U|xtpuffer + "|ytazeit")'
.'F|expr("formula U|xztezeit    = " + U|xtpuffer + "|ytezeit")'
.'F|expr("formula U|xrtarbzeit  = " + U|xtpuffer + "|ytarbzeit")'
.'F|expr("formula U|xrtfaktzeit = " + U|xtpuffer + "|ytfaktzeit")'
.'F|expr("copy    U|xbtlsrelev  = " + U|xtpuffer + "|ytlsrelev")'
.'F|expr("copy    U|xblsrelev   = " + U|xtpuffer + "|ylsrelev")'
.copy U|xbok = G|TRUE  ? U|xrtarbzeit <> 0 ; U|xrtfaktzeit <> 0 ; _F|empty(U|xztazeit) ; _F|empty(U|xztezeit)
.formula U|xrworktime = U|xrworktime + U|xrtarbzeit
.continue EL043 ? _((_(U|xblsrelev)) ; (U|xbtlsrelev))
.formula U|xrbilltime = U|xrbilltime + U|xrtfaktzeit
.continue EL044 ? _(((U|xztazeit < U|xzfirst) & (_(F|empty(U|xztazeit))) & (U|xdtadatum <= U|xdfirst)) ; (F|empty(U|xzfirst)))
.formula U|xzfirst = U|xztazeit
!EL044
.continue EL045 ? _((((U|xztezeit > U|xzlast) & (_(F|empty(U|xztezeit))) & (_(U|xdtedatum < U|xdlast))) ; (U|xdtedatum > U|xdlast)) ; (F|empty(U|xzlast)))
.formula U|xzlast  = U|xztezeit
!EL045
.continue EL046 ? _(((U|xdtadatum < U|xdfirst) & (_(F|empty(U|xdtadatum)))) ; (F|empty(U|xdfirst)))
.formula U|xdfirst = U|xdtadatum
!EL046
.continue EL047 ? _(((U|xdtedatum  > U|xdlast) & (_(F|empty(U|xdtedatum)))) ; (F|empty(U|xdlast)))
.formula U|xdlast  = U|xdtedatum
!EL047
!EL043
.select screen line     ? G|evtkommd <> G|kaktname2
.select        line     ? G|evtkommd =  G|kaktname2
.continue LOOP003
!ELOP003: ==============================
.continue EL048 ? _(U|xbok)
.'F|expr("formula " + U|xtpuffer + "|yadatum   = U|xdfirst")'           ? _F|empty(U|xdfirst)
.'F|expr("formula " + U|xtpuffer + "|yedatum   = U|xdlast")'            ? _F|empty(U|xdlast)
.'F|expr("formula " + U|xtpuffer + "|yazeit    = U|xzfirst")'           ? _F|empty(U|xzfirst)
.'F|expr("formula " + U|xtpuffer + "|yezeit    = U|xzlast")'            ? _F|empty(U|xzlast)
.'F|expr("formula " + U|xtpuffer + "|yarbzeit  = U|xrworktime")'        ?  U|xrworktime < 100
.'F|expr("formula " + U|xtpuffer + "|yarbzeit  = 99.99")'               ? _U|xrworktime < 100
.'F|expr("formula " + U|xtpuffer + "|yfaktzeit = U|xrbilltime")'        ?  U|xrbilltime < 100
.'F|expr("formula " + U|xtpuffer + "|yfaktzeit = 99.99")'               ? _U|xrbilltime < 100
.continue FI048
!EL048
.'F|expr("formula U|xrworktime = " + U|xtpuffer + "|yarbzeit")'
.'F|expr("formula U|xrbilltime = " + U|xtpuffer + "|yarbzeit")'
