.formula U|xrvsatzwert = 8|yvsf.ximonat                                         ?  8|yvland = G|inland ;  F|empty(8|yvland)
.formula U|xrvsatzwert = F|fxamount(G|inland,8|yvsf.ximonat,U|xt001,8|yvland)   ? _8|yvland = G|inland & _F|empty(8|yvland)
.continue FI058
!EL058
