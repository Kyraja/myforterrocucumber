..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.ZUORDZEIT.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 04.05.2009
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2014 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text  xtsys xtsel xtpvorgang
.type real  xrwert
.type bool  xbmehr
.set demand -
..====================================================
.continue ? M|ybnofop
.continue EL001 ? _((_(G|evtkommd = G|kaktname12)) & (_(G|evttaste = G|kaktname16)))
.continue EL002 ? _(_(F|empty(M|yaufgabe)))
.copy    U|xbmehr = G|FALSE
.formula U|xrwert = 0
.select lock add M|yaufgabe
.continue EL003 ? _(G|mehr)
.formula U|xtsel = "$,,yaufgabe==" + H|id
.formula U|xtsel = U|xtsel + ";ydatum="     +'H|yadatum:8' + "!" + 'H|yedatum:8'
.formula U|xtsel = U|xtsel + ";ybsim==0;@ablageart=(Active)"
.load 0 group "P154:2" 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xrwert = U|xrwert + 0|ywert
.copy    U|xbmehr = G|TRUE
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.formula H|yzugstd = U|xrwert
.continue EL004 ? _(((H|ystatusk = "") ; (H|ystatusk = "01")) & (_(G|evtkommd = G|kaktname10)))
.formula H|ystatusk = "02"
!EL004
.rewrite
!EL003
!EL002
.continue EL005 ? _(_(F|empty(M|ypvorgang)))
.copy    U|xbmehr = G|FALSE
.formula U|xrwert = 0
.select lock add M|ypvorgang
.continue EL006 ? _(G|mehr)
.formula U|xtsel = "$,,ypvorgang==" + H|id
.formula U|xtsel = U|xtsel + ";ydatum="     +'H|yadatum:8' + "!" + 'H|yedatum:8'
.formula U|xtsel = U|xtsel + ";ybsim==0;@ablageart=(Active)"
.load 0 group "P154:2" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xrwert = U|xrwert + 0|ywert
.copy    U|xbmehr = G|TRUE
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.formula H|ypvzugstd = U|xrwert
.continue EL007 ? _(((H|ystatusk = "") ; (H|ystatusk = "01")) & (_(G|evtkommd = G|kaktname10)))
.formula H|ystatusk = "02"
!EL007
.rewrite
!EL006
.select -
.formula U|xtpvorgang = M|ypvorgang^id
.input 'U|xtupgsvorgangakt'
!EL005
!EL001
.continue
