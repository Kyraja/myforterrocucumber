.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- tabelle -----
.make screen line +O
.colour -BACKGROUND -1 -1 -1 'M|aktzeile'
.formula M|ytransnum    = '0|id'
.formula M|ytranssuch   = '0|id'
.formula M|ytransname   = '0|name'
