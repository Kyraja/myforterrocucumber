..====================================================
.continue EPROCDEF
!PROC001: ----- Schutz -----
.continue EL001 ? _(_(M|yprjmperstypk = "EM"))
.protection -reset yprjmlief
.continue FI001
!EL001
.protection yprjmlief
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- PflichtfelderFarbe -----
.continue EL002 ? _(_(G|evtkommd = G|kaktname12))
.colour -BACKGROUND 'U|xyfarbepflichtf' such         0
.colour -BACKGROUND 'U|xyfarbepflichtf' yprjmperstyp 0
.colour -BACKGROUND 'U|xyfarbepflichtf' yprjmlief    0  ?  M|yprjmperstypk = "FP" ;  M|yprjmperstypk = "VU" ;  M|yprjmperstypk = "SUB"
.colour -BACKGROUND "-1 -1 -1"          yprjmlief    0  ? _M|yprjmperstypk = "FP" & _M|yprjmperstypk = "VU" & _M|yprjmperstypk = "SUB"
.colour -BACKGROUND 'U|xyfarbepflichtf' kstelle      0  ?  F|sysinfo(18)^stbu
!EL002
.continue 'xprocst.xprocsp'
!PROC003: ----- Dopplungspruefung -----
.continue EL003 ? _((M|yprjmperstypk <> "EM") & (_(F|empty(M|yprjmlief))) & (_(F|empty(M|namebspr))))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprjmlief==" + M|yprjmlief^id
.formula U|xtsel = U|xtsel + ";name=="      + M|namebspr
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group "11:1" 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xtext = U|xtext + ";" + 0|nummerb + " - " + 0|suchb  ?  0|id <> M|id
.formula U|xianz = U|xianz + 1                                  ?  0|id <> M|id
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.continue EL004 ? _(U|xianz  > 0)
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xttmp   = F|formatstr("Es existiert bereits ein Mitarbeiter mit Namen {1} zum Lieferanten {2}.", M|namebspr, M|yprjmlief)
.set trans -
.box -button ok:cancel -title 'U|xttitel'
'U|xttmp'
'U|xtext                                                                '
.set trans -
.assign M|.evtvar = ""  ? _G|box = G|boxyes & G|evtart <> "maskpruef"
.error                  ? _G|box = G|boxyes
.end 1                  ? _G|box = G|boxyes
!EL004
!EL003
.continue 'xprocst.xprocsp'
!PROC004: ----- Summe_Anteile -----
.formula M|yprjmsumgewant = M|yprjmgewerkant1 + M|yprjmgewerkant2 + M|yprjmgewerkant3 + M|yprjmgewerkant4 + M|yprjmgewerkant5
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
