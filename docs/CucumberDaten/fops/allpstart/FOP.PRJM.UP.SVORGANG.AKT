.continue EPROCDEF
!PROC001: ----- UpdateStundenverbrauch -----
.formula H|yfortschritt   = H|ypviststd / H|ypvplanstd     * 100    ? _H|ypvplanstd     = 0
.formula H|yabwfortplan   = H|yfortschritt - 100
.formula H|yfortistbudget = H|ypviststd / H|ypvsollstd     * 100    ? _H|ypvsollstd     = 0
.formula H|yabwfortbudget = H|yfortistbudget - 100
.continue EL001 ? _((H|ypvforecaststd = 0) ; (U|xianz = 0))
.formula H|ytechfort      = H|ypviststd / H|ypvforecaststd * 100    ?  H|ypvforecaststd >  0 & H|ypviststd >  0
.formula H|ytechfort      = 0                                       ?  H|ypvforecaststd <= 0 ; H|ypviststd <= 0
.formula H|ytechfort      = 100                                     ?  H|ytechfort      >  100
!EL001
.continue EL002 ? _((_(H|ypvforecaststd = 0)) & (U|xianz > 0))
.formula U|xrtechfort = 0
.formula U|xi1        = 1
!LOOP001: ==============================
.continue ELOP001 ? _(U|xi1 <= U|xianz)
.continue EL003 ? _(U|xrforecast.xi1 > 0)
.formula U|xrtechfort = U|xrtechfort + (U|xrtechfort.xi1 * U|xrforecast.xi1 / H|ypvforecaststd)
!EL003
.formula U|xi1 = U|xi1 + 1
.continue LOOP001
!ELOP001: ==============================
.formula H|ytechfort      = 0               ? U|xrtechfort <  0
.formula H|ytechfort      = U|xrtechfort    ? U|xrtechfort >= 0
.formula H|ytechfort      = 100             ? H|ytechfort  >  100
!EL002
.formula H|yabwphysplan   = H|yfortschritt - H|ytechfort
.continue 'xprocst.xprocsp'
!PROC002: ----- UpdateAbweichung -----
.input "allpstart/FOP.PRJM.UP.ICONS"
.continue 'xprocst.xprocsp'
