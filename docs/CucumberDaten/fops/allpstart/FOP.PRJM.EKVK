..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text     xtsys xtsel xtcmd xtnummer xtsuch xtvorpos xtaupos xtaunum xtabrechnung xtftext xtdatei xtmeldtext xtmenue xt1 xt2
.type text     xtname xtvtext xtindex xtextid xcallname xttyp xtid xtzid xykoobjekt xtaufgabe xtvar xtverw xttitel xysel
.type text     xtedpdat xtedpout xtedperr xtedpmsg xterrtext xtxxxxx
.type real     xrwert xrbudget
.type R6.3     xrfaktzeit xrmge
.type integer  xianz xi1 xi2 ximenu xisort xyvdn xyvgr
.type bool     xbmehr xbok xbnurleer xbmenue xbloeprjm xbvtproj xyberlaubt xblm xbmz xbmm xbsm xbmmeinh xbwert xbprueffab xbpruefkab xbre
.type bool     xybmeldung xbnullrechnung xbbudget xbposlm xbposmz xbposmm xbpossm xberrtext xbhinweis xybnoprsel
.type TAZ1     xmmeinh
.type TAZ7     xeinh
.type ID87:9   xcallparam
.type P86:1    xpprojekt
.type P86:1    xpproject
.type P149:2   xppvorgang
.type VP13     xsource
.type GD19     xd19
.type GD       xdadatum xdedatum xdterm
.type integer   xprocsp         ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue   ? _F|sysinfo(18)^allpstd & M|dnr = 3
.continue EPROCDEF
!PROC001: ----- WertanteileAusOrigBerechnen -----
.continue EL001 ? _((F|defined(M|yprjmpeigenleist)) & (F|sysinfo(18)^allpstd))
.continue EL002 ? _((_(F|empty(M|orig))) & ((G|evtmaske = 35) ; (G|evtmaske = 36)))
.add M|orig
.continue EL003 ? _(G|mehr)
.continue EL004 ? _(_(D|pwert = 0))
.formula M|yprjmpfremdleist = M|pwert / D|pwert * D|yprjmpfremdleist
.formula M|yprjmpsonstkost  = M|pwert / D|pwert * D|yprjmpsonstkost
.formula M|yprjmpfertleist  = M|pwert / D|pwert * D|yprjmpfertleist
.continue FI004
!EL004
.formula M|yprjmpfremdleist = 0
.formula M|yprjmpsonstkost  = 0
.formula M|yprjmpfertleist  = 0
!FI004
!EL003
!EL002
.formula M|yprjmpeigenleist = M|pwert - M|yprjmpfremdleist - M|yprjmpsonstkost - M|yprjmpfertleist  ? _M|typ = G|STPOS & _M|typ = G|SIPOS
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- abgerechneteLeistungenSuchen -----
.formula U|xtvorpos = M|id
.copy    U|xbre     = G|false
.continue EL005 ? _(G|evtmaske = 36)
.continue EL006 ? _(_(G|evtkommd = G|kaktname5))
.copy    U|xbre     = G|true
.add M|orig
.copy U|xbmehr = G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(U|xbmehr)
.continue EL007 ? _(D|kotyp = G|LIKO)
.formula U|xtvorpos = D|id
.copy U|xbmehr = G|false
.copy    U|xbre     = G|false
.continue FI007
!EL007
.add D|orig
.copy U|xbmehr = G|mehr
!FI007
.continue LOOP001
!ELOP001: ==============================
!EL006
!EL005
.formula U|xtsel = "$,,ylsposid==" + U|xtvorpos         ? _U|xbre
.formula U|xtsel = "$,,yreposid==" + U|xtvorpos         ?  U|xbre
.formula U|xtsel = U|xtsel + ";yprjmid==`;@filingmode=(Active)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.copy U|xblm = G|true         ? G|mehr
.continue EL008 ? _((_(U|xblm)) & (_(F|empty(M|yprjmpid))) & (G|evtart <> "maskein"))
.formula U|xtsel = "$,,yprjmid==" + M|yprjmpid
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL009 ? _((_(G|evtkommd = G|kaktname13)) ; ((M|kotyp = G|LIKO) & (F|empty(0|ylsposid))) ; ((M|kotyp = G|REKO) & (F|empty(0|yreposid))))
.copy U|xblm = G|true
!EL009
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
!EL008
.formula U|xtsel = "$,,ymzlsposid==" + U|xtvorpos           ? _U|xbre
.formula U|xtsel = "$,,ymzreposid==" + U|xtvorpos           ?  U|xbre
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.copy U|xbmz = G|true         ? G|mehr
.formula U|xtsel = "$,,ytmmlsposid==" + U|xtvorpos          ? _U|xbre
.formula U|xtsel = "$,,ytmmreposid==" + U|xtvorpos          ?  U|xbre
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(Yes)"
.select group 'U|xydbgrmatmeldung' 'U|xtsel'
.copy U|xbmm = G|true         ? G|mehr
.formula U|xtsel = "$,,ytsmlsposid==" + U|xtvorpos          ? _U|xbre
.formula U|xtsel = "$,,ytsmreposid==" + U|xtvorpos          ?  U|xbre
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@rows=(Yes)"
.select group 'U|xydbgrsubmeldung' 'U|xtsel'
.copy U|xbsm = G|true         ? G|mehr
.continue 'xprocst.xprocsp'
!PROC003: ----- Icon_abrechenbare_Leistungen -----
.continue EL010 ? _((F|sysinfo(18)^allpstd) & ((G|evtmaske = 35) ; (G|evtmaske = 36)))
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL011 ? _(_(F|empty(M|projekt)))
.copy U|xbok = G|false
.copy U|xblm = G|false
.copy U|xbmz = G|false
.copy U|xbmm = G|false
.copy U|xbsm = G|false
.continue EL012 ? _(_(F|empty(M|orig)))
.formula U|xtaupos = ""
.formula U|xtaunum = ""
.add M|orig
.copy U|xbmehr = G|mehr
!LOOP004: ==============================
.continue ELOP004 ? _(U|xbmehr)
.continue EL013 ? _((D|kotyp = G|ABKO) ; (D|kotyp = G|SBKO))
.formula U|xtaupos = D|id
.formula U|xtaunum = D|kopf^nummer
.copy    U|xbmehr  = G|false
.continue FI013
!EL013
.add D|orig
.copy U|xbmehr = G|mehr
!FI013
.continue LOOP004
!ELOP004: ==============================
.continue EL014 ? _(_(F|empty(U|xtaupos)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yvorpos==" + U|xtaupos
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgraufgabe' 'U|xtsel'
.copy U|xbmehr = G|mehr
!LOOP005: ==============================
.continue ELOP005 ? _(U|xbmehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yaufgabe==" + 0|id
.formula U|xtsel = U|xtsel + ";ylsrelev==1"
.formula U|xtsel = U|xtsel + ";yadatum<="  + M|yprjmlzraumbis:8
.formula U|xtsel = U|xtsel + ";yedatum>="  + M|yprjmlzraumvon:8
.formula U|xtsel = U|xtsel + ";ylsposid==`;yreposid==`
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL015 ? _(G|mehr)
.copy U|xbok   = G|true
.copy U|xbmehr = G|false
.continue FI015
!EL015
.load 0 continue
.copy U|xbmehr = G|mehr
!FI015
.continue LOOP005
!ELOP005: ==============================
.continue EL016 ? _((_(U|xbok)) & (M|artex^yprjmprkatartk = "ML"))
.add M|orig
.copy U|xbmehr = G|mehr
!LOOP006: ==============================
.continue ELOP006 ? _(U|xbmehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yvornum=="    + U|xtaunum
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgraufgabe' 'U|xtsel'
.copy U|xbmehr = G|mehr
!LOOP007: ==============================
.continue ELOP007 ? _(U|xbmehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yaufgabe==" + 0|id
.formula U|xtsel = U|xtsel + ";ylsrelev==1"
.formula U|xtsel = U|xtsel + ";yadatum<="  + M|yprjmlzraumbis:8
.formula U|xtsel = U|xtsel + ";yedatum>="  + M|yprjmlzraumvon:8
.formula U|xtsel = U|xtsel + ";ymaschvkart=" + M|artex^id
.formula U|xtsel = U|xtsel + ";ymzlsposid==`;ymzreposid==`
.formula U|xtsel = U|xtsel + ";ymaschzeit<>0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL017 ? _(G|mehr)
.copy U|xbok   = G|true
.copy U|xbmehr = G|false
.continue FI017
!EL017
.load 0 continue
.copy U|xbmehr = G|mehr
!FI017
.continue LOOP007
!ELOP007: ==============================
.continue LOOP006
!ELOP006: ==============================
!EL016
.continue EL018 ? _(_(U|xbok))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yvorpos==" + U|xtaupos
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
.copy U|xbmehr = G|mehr
!LOOP008: ==============================
.continue ELOP008 ? _(U|xbmehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ytpvorgang==" + 0|id
.formula U|xtsel = U|xtsel + ";ytdatum="     + M|yprjmlzraumvon:8 + "!" + M|yprjmlzraumbis:8
.formula U|xtsel = U|xtsel + ";ytsmlsposid==`;ytsmreposid==`
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrsubmeldung' 'U|xtsel'
.continue EL019 ? _(G|mehr)
.copy U|xbok   = G|true
.copy U|xbmehr = G|false
.continue FI019
!EL019
.load 0 continue
.copy U|xbmehr = G|mehr
!FI019
.continue LOOP008
!ELOP008: ==============================
!EL018
!EL014
!EL012
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.formula M|yprjmpbuabrechnung = "icon:icecube"          ? _U|xbok & _U|xblm & _U|xbmz & _U|xbmm & _U|xbsm
.formula M|yprjmpbuabrechnung = "icon:cube_green"       ?  U|xbok & _U|xblm & _U|xbmz & _U|xbmm & _U|xbsm
.formula M|yprjmpbuabrechnung = "icon:package"          ? _U|xbok & (U|xblm ;  U|xbmz ;  U|xbmm ;  U|xbsm)
.formula M|yprjmpbuabrechnung = "icon:cube_yellow"      ?  U|xbok & (U|xblm ;  U|xbmz ;  U|xbmm ;  U|xbsm)
!EL011
.select screen line
.continue LOOP003
!ELOP003: ==============================
!EL010
.continue 'xprocst.xprocsp'
!PROC004: ----- Projekt_Kopf -----
.continue EL020 ? _((_(F|empty(M|yprjmproj))) & (_(M|yprjmproj^bebuchbar)))
.set trans +
.box Hinweis
Es darf nur ein bebuchbares Projekt eingetragen werden.
.set trans -
.assign M|yprjmproj = ""
!EL020
.copy M|yprjmverantwkst = M|yprjmproj^yverantwkst   ? _F|empty(M|yprjmproj^yverantwkst)
.continue EL021 ? _((_(F|empty(M|yprjmproj))) & (_(F|empty(M|yprjmproj^yprg))) & (M|dnr = 3))
.assign M|prg              = M|yprjmproj^yprg
.assign M|yprjmprgtyp      = M|yprjmproj^yprgtyp
.assign M|yprjmsprleistkat = M|yprjmproj^yprojleistkatid
.protection        prg              0   ? _F|empty(M|yprjmproj)
.protection        yprjmprgtyp      0   ? _F|empty(M|yprjmproj)
.protection        yprjmsprleistkat 0   ? _F|empty(M|yprjmproj)
.protection -RESET prg              0   ?  F|empty(M|yprjmproj)
.protection -RESET yprjmprgtyp      0   ?  F|empty(M|yprjmproj)
.protection -RESET yprjmsprleistkat 0   ?  F|empty(M|yprjmproj)
!EL021
.continue EL022 ? _((_(F|empty(M|yprjmproj))) & (_(F|empty(M|yprjmproj^ykunde^id))) & (F|defined(M|kunde)))
.continue EL023 ? _(_(M|kunde^id = M|yprjmproj^ykunde^id))
.set trans +
.formula U|xterrtext = F|formatstr("Der Kunde im Projekt {1} passt nicht zum Kunden im Vorgang {2}.", M|yprjmproj^ykunde, M|kunde)
.box Hinweis
'U|xterrtext'
.set trans -
!EL023
!EL022
.select screen header
.select screen line
!LOOP009: ==============================
.continue ELOP009 ? _(G|mehr)
.continue EL024 ? _((F|empty(M|projekt)) & ((M|typ = G|ARPOS) ; (M|typ = G|ZUPOS) ; (M|typ = G|PRPOS)))
.copy M|projekt = M|yprjmproj           ? F|modifiable(M|projekt)
.copy M|kstelle = M|yprjmproj^yktr      ? F|modifiable(M|kstelle) & _F|empty(M|yprjmproj^yktr)
!EL024
.select screen line
.continue LOOP009
!ELOP009: ==============================
.select screen header
.continue 'xprocst.xprocsp'
!PROC005: ----- CheckProjectStatus -----
.assign U|xpproject = 9|id
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekan)  ? G|evtmaske = 43
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekan)  ? G|evtmaske = 43
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekbe)  ? G|evtmaske = 42
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekbe)  ? G|evtmaske = 42
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekls)  ? G|evtmaske = 45
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekls)  ? G|evtmaske = 45
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefekre)  ? G|evtmaske = 46
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefekre)  ? G|evtmaske = 46
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkan)  ? G|evtmaske = 31
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkan)  ? G|evtmaske = 31
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkau)  ? G|evtmaske = 32
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkau)  ? G|evtmaske = 32
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkls)  ? G|evtmaske = 35
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkls)  ? G|evtmaske = 35
.copy U|xbprueffab = F|rec(U|xystclosingvars, ypmtabpruefvkre)  ? G|evtmaske = 36
.copy U|xbpruefkab = F|rec(U|xystclosingvars, ypmkabpruefvkre)  ? G|evtmaske = 36
.load 9 add U|xpproject
.continue EL025 ? _(((9|ystatusk = "FTAB") & (U|xbprueffab)) ; (((9|ystatusk = "ABS") ; (9|ystatusk = "08") ; (9|yablage)) & (U|xbpruefkab)))
.set TRANS +
.formula U|xt1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", 9|such, G|dblquote, 9|ystatus)
.formula U|xt2 = F|formatstr("{1} nicht mehr mîglich.", G|evtkommd)        ? _G|evtvarori = "beleg"
.formula U|xt2 = F|formatstr("{1} nicht mehr mîglich.", "Beleg anfÅgen")   ?  G|evtvarori = "beleg"

.box Hinweis
'U|xt1'
'U|xt2'
.set TRANS -
.error
.end 1
!EL025
.continue 'xprocst.xprocsp'
!PROC006: ----- VerwendungVorbelegen -----
.continue EL026 ? _((F|modifiable(M|verw)) & (_(F|empty(M|artex))))
.copy U|xpprojekt  = M|projekt
.copy U|xppvorgang = M|yprjmppvorgang
.input "allpstart/FOP.PRJM.UP.VERW"
.formula M|verw = U|xtverw    ? _F|empty(U|xtverw)
!EL026
.continue 'xprocst.xprocsp'
!PROC007: ----- Projekt_Position -----
.continue EL027 ? _((_(F|empty(M|projekt))) & (_(M|projekt^bebuchbar)))
.set trans +
.box Hinweis
Es darf nur ein bebuchbares Projekt eingetragen werden.
.set trans -
.assign M|projekt = ""
!EL027
.continue EL028 ? _((_(F|empty(M|projekt))) & (_(F|empty(M|projekt^ykunde^id))) & (F|defined(M|kunde)))
.continue EL029 ? _(_(M|kunde^id = M|projekt^ykunde^id))
.set trans +
.formula U|xterrtext = F|formatstr("Der Kunde im Projekt {1} passt nicht zum Kunden im Vorgang {2}.", M|projekt^ykunde, M|kunde)
.box Hinweis
'U|xterrtext'
.set trans -
!EL029
!EL028
.copy M|kstelle = M|projekt^yktr        ? F|modifiable(M|kstelle) & _F|empty(M|projekt^yktr)
.continue 'xprocst.xprocsp'
!PROC008: ----- LM_nach_Kunden_suchen -----
.formula U|xtsel = "$,,ykunde==" + M|kunde2^id
.load 1 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP010: ==============================
.continue ELOP010 ? _(G|mehr)
.continue EL030 ? _((_(F|empty(1|yabrechnung))) & ((1|yprjmid = "") ; (1|yprjmid = M|yprjmpid)))
.formula U|xt1 = "*" + 1|yabrechnung + "  *"
.continue EL031 ? _(_(U|xtabrechnung/U|xt1))
.formula U|xtabrechnung = U|xtabrechnung + 1|yabrechnung + "  "
.formula U|xianz = U|xianz + 1
.type text xtabrnum.xianz        ? _F|defined(U|xtabrnum.xianz)
.formula U|xtabrnum.xianz = 1|yabrechnung
!EL031
!EL030
.load 1 continue
.continue LOOP010
!ELOP010: ==============================
.continue 'xprocst.xprocsp'
!PROC009: ----- Fehler_Eintrag_Vorgang_inLM -----
.output ADDEDTO 'U|xterrtext'
.copy U|xberrtext = G|true
.set TRANS +
In der Meldung '0|nummer' ist bereits ein Vorgang eingetragen.
.set TRANS -
.continue 'xprocst.xprocsp'
!PROC010: ----- VorgangsNr_in_LM_eintragen -----
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP011: ==============================
.continue ELOP011 ? _(G|mehr)
.copy U|xbposlm = G|true
.continue BRK001 ? _(G|evtmaske = 35)
.continue EL032 ? _((F|empty(0|ylsnum)) ; (0|ylsnum = U|xtnummer))
.continue EL033 ? _((_(0|ylsposid = M|id)) ; (_(F|empty(0|yprjmid))))
.select lock add 0|id
.continue EL034 ? _(G|mehr)
.continue EL035 ? _(F|empty(0|ylsposid))
.formula H|yauposid = U|xtaupos
.formula H|yaunum   = U|xtaunum
.formula H|ylsposid = M|id
.formula H|ylsnum   = U|xtnummer
.formula H|yprjmid  = ""
.continue FI035
!EL035
.formula H|yauposid = ""
.formula H|yaunum   = ""
.formula H|ylsposid = ""
.formula H|ylsnum   = ""
.formula H|yprjmid  = ""
!FI035
.rewrite
.continue FI034
!EL034
.set TRANS +
.box Fehler
Die Lieferscheinposition konnte nicht in die Leistungsmeldung '0|nummer' eingetragen werden.
Die Leistungsmeldung wurde nicht gefunden oder wird gerade bearbeitet.

Bitte den Lieferschein erneut speichern.
.set TRANS -
!FI034
!EL033
.continue FI032
!EL032
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC009
!RET002
.formula xprocsp = xprocsp - 1
!FI032
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtmaske = 36)
.continue EL036 ? _((F|empty(0|yrenum)) ; (0|yrenum = U|xtnummer))
.continue EL037 ? _((_(0|yreposid = M|id)) ; (_(F|empty(0|yprjmid))))
.select lock add 0|id
.continue EL038 ? _(G|mehr)
.continue EL039 ? _(F|empty(0|yreposid))
.formula H|yauposid = U|xtaupos
.formula H|yaunum   = U|xtaunum
.formula H|yreposid = M|id
.formula H|yrenum   = U|xtnummer
.formula H|yprjmid  = ""
.continue FI039
!EL039
.formula H|yauposid = ""
.formula H|yaunum   = ""
.formula H|yreposid = ""
.formula H|yrenum   = ""
.formula H|yprjmid  = ""
!FI039
.rewrite
.continue FI038
!EL038
.set TRANS +
.box Fehler
Die Rechnungsposition konnte nicht in die Leistungsmeldung '0|nummer' eingetragen werden.
Die Leistungsmeldung wurde nicht gefunden oder wird gerade bearbeitet.

Bitte die Rechnung erneut speichern.
.set TRANS -
!FI038
!EL037
.continue FI036
