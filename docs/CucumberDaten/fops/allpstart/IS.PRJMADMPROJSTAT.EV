.copy    M|ytstdplan         = H|ystdplan
.copy    M|ytstdges          = H|ystdges
.copy    M|ytbudverbr        = H|ybudverbr
.copy    M|ytbudges          = H|ybudges
.copy    M|ytvkbezre         = H|yvkbezre
.copy    M|ytvkop            = H|yvkop
.copy    M|ytvkanzre         = H|yvkanzre
.copy    M|ytvkreges         = H|yvkreges
.copy    M|ytvkliges         = H|yvkliges
.copy    M|ytvkunbezre       = H|yvkunbezre
.copy    M|ytvkorewert       = H|yvkorewert
.copy    M|ytvkoliwert       = H|yvkoliwert
.copy    M|ytaufwert         = H|yaufwert
.copy    M|ytvkabgauf        = H|yvkabgauf
.copy    M|ytvkoffauf        = H|yvkoffauf
.copy    M|ytvkanzauf        = H|yvkanzauf
.formula U|xdatum =   U|xdatum + 32
.formula U|xdatum = ('U|xdatum:8')<<6 + "01"
.formula U|xdatum =   U|xdatum - 1
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
.select continue
.continue LOOP001
