.copy    M|ytekbestwert      = H|yekbestwert
.copy    M|ytekkalk          = H|yekkalk
.copy    M|ytstdistvksatz    = H|ystdistvksatz
.copy    M|ytstdzielvksatz   = H|ystdzielvksatz
