.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd
.type GD      xdatum
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- FA_yvondatum -----
.continue EL001 ? _(_(F|empty(M|yvondatum)))
.formula M|yvondatum  = M|yprojekt^yadatum      ? _F|empty(M|yprojekt) & M|yvondatum < M|yprojekt^yadatum
.formula U|xdatum     = ('M|yvondatum:8')<<6 + "01"
.formula U|xdatum     = U|xdatum + 31
.formula U|xdatum     = ('U|xdatum:8')<<6 + "01"
.formula M|yvondatum  =  U|xdatum - 1
.formula M|ybisdatum  = M|yvondatum             ? M|ybisdatum < M|yvondatum & _F|empty(M|ybisdatum)
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- FA_ybisdatum -----
.continue EL002 ? _(_(F|empty(M|ybisdatum)))
.formula M|ybisdatum  = M|yprojekt^yabldat      ? _F|empty(M|yprojekt) & _F|empty(M|yprojekt^yabldat) & M|ybisdatum > M|yprojekt^yabldat
.formula M|ybisdatum  = G|datum                 ?                                                       M|ybisdatum > G|datum
.formula U|xdatum     = ('M|ybisdatum:8')<<6 + "01"
.formula U|xdatum     = U|xdatum + 31
.formula U|xdatum     = ('U|xdatum:8')<<6 + "01"
.formula M|ybisdatum  =  U|xdatum - 1
.formula M|yvondatum  = M|ybisdatum             ? M|yvondatum > M|ybisdatum & _F|empty(M|yvondatum)
!EL002
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "buttonnach")
.continue BRK002 ? _(G|evtvar = "bstart")
.continue EL003 ? _(_(F|empty(M|yprojekt)))
.make screen line --O
.assign  U|xdatum = M|yvondatum
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="    + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";ybezugsdatum=" + 'M|yvondatum:8' + "!" + 'M|ybisdatum'   ? _F|empty(M|yvondatum) ; _F|empty(M|ybisdatum)
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@ordnung=ybezugsdatum"
.select group 'M|grliste' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.assign U|xdatum = H|ybezugsdatum   ? F|empty(U|xdatum)
.continue EL004 ? _(_(U|xdatum = H|ybezugsdatum))
!REPT001: ==============================
.make screen line +O
.copy    M|ytbezugsdatum     = U|xdatum
.copy    M|ytprojekt         = M|yprojekt
.formula M|ytprojname        = M|ytprojekt^namebspr
.formula U|xtsel = "$,,"
