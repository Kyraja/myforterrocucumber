.formula U|xtsel = U|xtsel + ";ybezugsdatum>=" + 'U|xdatum'
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@ordnung=ybezugsdatum"
.load 9 group 'M|grliste' 'U|xtsel'
.continue EL005 ? _(G|mehr)
.copy    M|ytbspeichern      = G|TRUE
.copy    M|ytstatusk         = 9|ystatusk
