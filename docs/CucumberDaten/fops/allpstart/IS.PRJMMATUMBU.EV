..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/TRANS.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtcmd xtname xtsuch xtkenn xykoobjekt xyprojekt xbuchtyp xtpr xtpt xtwp xterr1 xterr2
.type text    xttransini xttransdat xttransprot xttransleer xtedpout xtedperr xttitel
.type integer ximonat xijahr
.type GD      xdatum xybudat xbudat
.type bool    xyberlaubt
.type GD19    xdbis
.type bool    xyberlaubt xbok xbtpok xybstorno
.type P86:1   xpproject
.type integer xprocsp           ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Rechtepruefung -----
.add M|.G|evtvar
.continue EL001 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = D|yprojekt^yverantwkst^id       ? F|defined(D|yprojekt)
.formula U|xykoobjekt = D|yverantwkst^id                ? M|dnr = U|xydbprojekt  & M|gruppe = U|xygrprojekt
.formula U|xykoobjekt = D|id                            ? M|dnr = 5              & M|gruppe = 2
.formula U|xykoobjekt = H|yverantwkst^id                ? M|dnr = 5              & M|gruppe = 4
.input 'U|xypmrepruefkstprog'
.continue EL002 ? _(_(U|xyberlaubt))
.set trans +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set trans -
.formula M|.evtvar = ""
.continue
!EL002
!EL001
.continue EL003 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = D|yprojekt^yverantwkst^id       ? F|defined(D|yprojekt)
.formula U|xykoobjekt = D|yverantwkst^id                ? D|dnr = U|xydbprojekt  & D|gruppe = U|xygrprojekt
.formula U|xykoobjekt = D|id                            ? D|dnr = 5              & D|gruppe = 4
.input 'U|xypmrepruefktrprog'
.continue EL004 ? _(_(U|xyberlaubt))
.set trans +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set trans -
.formula M|.evtvar  = ""
.continue
!EL004
!EL003
.continue EL005 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL006 ? _(_(U|xyberlaubt))
.set trans +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set trans -
.formula M|.evtvar = ""
.continue
!EL006
!EL005
.continue 'xprocst.xprocsp'
!PROC002: ----- Kostenobjekt -----
.continue EL007 ? _(M|.evtvar^gruppe = 4)
.continue EL008 ? _(_(F|empty(M|.evtvar)))
.formula U|xtsel = "$,,yktr==" + M|.evtvar^id + ";@ablageart=(1)"
.select group 'U|xydbgrprojekt' 'U|xtsel'
.continue EL009 ? _(G|mehr)
.reserve
.select continue
.continue EL010 ? _(G|mehr)
.formula U|xtsel = "%,,nummer=;such=;namebspr=;ystatus=;.yktr==" + M|.evtvar^id + ";@ablageart=(1)"
.select group 'U|xydbgrprojekt' 'U|xtsel'
.continue FI010
!EL010
.select
!FI010
.continue EL011 ? _(G|mehr)
.assign U|xpproject = H|id
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL012 ? _(((H|ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefmatbu))) ; (((H|ystatusk = "ABS") ; (H|ystatusk = "08") ; (H|yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefmatbu))))
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xterr1  = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", H|such, G|dblquote, H|ystatus)
.formula U|xterr2  = "Materialumbuchungen dÅrfen nicht mehr erstellt werden."

.box 'U|xttitel'
'U|xterr1'
'U|xterr2'
.set trans -
.continue EL013 ? _(G|evtzeile = 0)
.assign  M|yvonprojekt    = ""  ? G|evtvar = "yvonkoobjekt"
.formula M|yvonprojname   = ""  ? G|evtvar = "yvonkoobjekt"
.assign  M|ynachprojekt   = ""  ? G|evtvar = "ynachkoobjekt"
.formula M|ynachprojname  = ""  ? G|evtvar = "ynachkoobjekt"
.assign  M|yvonkoobjekt   = ""  ? G|evtvar = "yvonkoobjekt"
.formula M|yvonkoobjname  = ""  ? G|evtvar = "yvonkoobjekt"
.assign  M|ynachkoobjekt  = ""  ? G|evtvar = "ynachkoobjekt"
.formula M|ynachkoobjname = ""  ? G|evtvar = "ynachkoobjekt"
.continue FI013
!EL013
.assign  M|ytvonprojekt    = ""  ? G|evtvar = "ytvonkoobjekt"
.formula M|ytvonprojname   = ""  ? G|evtvar = "ytvonkoobjekt"
.assign  M|ytnachprojekt   = ""  ? G|evtvar = "ytnachkoobjekt"
.formula M|ytnachprojname  = ""  ? G|evtvar = "ytnachkoobjekt"
.assign  M|ytvonkoobjekt   = ""  ? G|evtvar = "ytvonkoobjekt"
.formula M|ytvonkoobjname  = ""  ? G|evtvar = "ytvonkoobjekt"
.assign  M|ytnachkoobjekt  = ""  ? G|evtvar = "ytnachkoobjekt"
.formula M|ytnachkoobjname = ""  ? G|evtvar = "ytnachkoobjekt"
!FI013
.continue FI012
!EL012
.continue EL014 ? _(G|evtzeile = 0)
.assign  M|yvonprojekt   = H|id         ? G|evtvar = "yvonkoobjekt"
.formula M|yvonprojname  = H|namebspr   ? G|evtvar = "yvonkoobjekt"
.assign  M|ynachprojekt  = H|id         ? G|evtvar = "ynachkoobjekt"
.formula M|ynachprojname = H|namebspr   ? G|evtvar = "ynachkoobjekt"
.continue FI014
!EL014
.assign  M|ytvonprojekt   = H|id        ? G|evtvar = "ytvonkoobjekt"
.formula M|ytvonprojname  = H|namebspr  ? G|evtvar = "ytvonkoobjekt"
.assign  M|ytnachprojekt  = H|id        ? G|evtvar = "ytnachkoobjekt"
.formula M|ytnachprojname = H|namebspr  ? G|evtvar = "ytnachkoobjekt"
!FI014
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
!FI012
!EL011
.continue FI009
!EL009
