Zum KostentrÑger 'M|.evtvar^such' konnte kein Projekt gefunden werden.
.set trans -
.continue EL015 ? _(G|evtzeile = 0)
.assign  M|yvonprojekt   = ""   ? G|evtvar = "yvonkoobjekt"
.formula M|yvonprojname  = ""   ? G|evtvar = "yvonkoobjekt"
.assign  M|ynachprojekt  = ""   ? G|evtvar = "ynachkoobjekt"
.formula M|ynachprojname = ""   ? G|evtvar = "ynachkoobjekt"
.assign  M|yvonkoobjekt   = ""  ? G|evtvar = "yvonkoobjekt"
