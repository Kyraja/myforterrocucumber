.assign  M|ytvonkoobjekt   = ""  ? G|evtvar = "ytvonkoobjekt"
.formula M|ytvonkoobjname  = ""  ? G|evtvar = "ytvonkoobjekt"
.assign  M|ytnachkoobjekt  = ""  ? G|evtvar = "ytnachkoobjekt"
.formula M|ytnachkoobjname = ""  ? G|evtvar = "ytnachkoobjekt"
!FI015
!FI009
!EL008
.continue FI007
!EL007
.continue EL016 ? _(G|evtzeile = 0)
.assign  M|yvonprojekt   = ""   ? G|evtvar = "yvonkoobjekt"
.formula M|yvonprojname  = ""   ? G|evtvar = "yvonkoobjekt"
.assign  M|ynachprojekt  = ""   ? G|evtvar = "ynachkoobjekt"
.formula M|ynachprojname = ""   ? G|evtvar = "ynachkoobjekt"
.continue FI016
!EL016
.assign  M|ytvonprojekt   = ""  ? G|evtvar = "ytvonkoobjekt"
