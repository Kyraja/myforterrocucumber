!PROC003: ----- Schutz_Zeile -----
.protection ytvonkoobjekt  'M|aktzeile'
.protection ytnachkoobjekt 'M|aktzeile'
.protection ytvonprojekt   'M|aktzeile'
.protection ytvonpvorgang  'M|aktzeile'
.protection ytnachprojekt  'M|aktzeile'
.protection ytnachpvorgang 'M|aktzeile'
.protection ytbetrag       'M|aktzeile'
.protection ytwaehrung     'M|aktzeile'
.protection ytbudat        'M|aktzeile'
.protection ytbutext       'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC004: ----- Buchungsdatum -----
.continue EL018 ? _(_(F|empty(M|ytbudat)))
.copy    U|xbudat   = M|ytbudat
.formula U|xbuchtyp = "S"
.input "allpstart/PRUEF.BUDAT"
.continue EL019 ? _(_(U|xbbuchbar))
.set trans +
.box Hinweis
Das Datum 'U|xbudat' liegt in einer abgeschlossenen Periode.
.set trans -
.formula M|ytbudat = M|ytmatumbu^ybudat
.error
.end 1
!EL019
!EL018
.continue 'xprocst.xprocsp'
!PROC005: ----- Speichern -----
.continue EL020 ? _(((F|cmdpermitted(U|xydbtrans, 12)) & (F|cmdpermitted(U|xydbtrans, 13)) & (F|cmdpermitted(U|xydbtrans, 14)) & (F|cmdpermitted(U|xydbtransdat, 12)) & (F|cmdpermitted(U|xydbtransdat, 13)) & (F|cmdpermitted(U|xydbtransdat, 14))) ; ((_(F|empty(F|sysinfo(10)^ykonfigprjm^ybatchuser))) & (F|sysinfo(10)^ykonfigprjm^ybatchuser^fremdok)))
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL021 ? _(((F|empty(M|ytvonkoobjekt)) & (F|empty(M|ytvonprojekt))) ; ((F|empty(M|ytnachkoobjekt)) & (F|empty(M|ytnachprojekt))) ; (F|empty(M|ytbudat)) ; (F|empty(M|ytbetrag)) ; (F|empty(M|ytwaehrung)))
.set trans +
.box Hinweis
Bitte zuerst alle Pflichtfelder fÅllen!
.set trans -
.cursor ytvonkoobjekt  'M|aktzeile'     ? F|empty(M|ytvonkoobjekt)
.cursor ytnachkoobjekt 'M|aktzeile'     ? F|empty(M|ytnachkoobjekt)
.cursor ytbudat        'M|aktzeile'     ? F|empty(M|ytbudat)
.cursor ytbetrag       'M|aktzeile'     ? F|empty(M|ytbetrag)
.cursor ytwaehrung     'M|aktzeile'     ? F|empty(M|ytwaehrung)
.error (0)
.end 1
!EL021
.continue EL022 ? _((F|empty(M|ytvonkoobjekt)) & (5|yprjmentlmatumbkto^kost) & (F|empty(5|yprjmentlmatumbkto^kstelle)))
.set trans +
.formula U|xterr1 = F|formatstr("Das Konto {1} muss eine Kostenstelle eingetragen haben oder", 5|yprjmentlmatumbkto)
.formula U|xterr2 = "es darf nicht die Eigenschaft Kostenrechnungszwang haben wenn kein Kostenobjekt angegeben ist."
.set trans -
.box Fehler
'U|xterr1'
'U|xterr2'
.error (0)
.end 1
!EL022
.continue EL023 ? _((F|empty(M|ytnachkoobjekt)) & (5|yprjmmatumbkto^kost) & (F|empty(5|yprjmmatumbkto^kstelle)))
.set trans +
.formula U|xterr1 = F|formatstr("Das Konto {1} muss eine Kostenstelle eingetragen haben oder", 5|yprjmmatumbkto)
.formula U|xterr2 = "es darf nicht die Eigenschaft Kostenrechnungszwang haben wenn kein Kostenobjekt angegeben ist."
.set trans -
.box Fehler
'U|xterr1'
'U|xterr2'
.error (0)
.end 1
!EL023
.select screen line
.continue LOOP001
!ELOP001: ==============================
.input "is/ABASFARBEN.DEF"
.set trans +
.formula U|xtsel = "Achtung"
.set trans -
.formula U|xtsel = "box -button yes:no -title " + U|xtsel           ? _G|evtart = "maskpruef"
.formula U|xtsel = "box -button yes:no:cancel -title " + U|xtsel    ?  G|evtart = "maskpruef"
.set trans +
.'U|xtsel'
Sollen alle Materialumbuchungen gespeichert und gebucht werden?
.set trans -
.error (0)      ? G|box = G|boxcancel
.end 1          ? G|box = G|boxcancel
.continue EL024 ? _(G|box = G|boxyes)
.continue EL025 ? _(_(G|mehr))
.set trans +
.box Fehler
Die Kostenrechnungskonfiguration konnte nicht ermittelt werden.
.set trans -
.continue
!EL025
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL026 ? _(F|empty(M|ytmatumbu))
.make ProjectSuiteReports GROUP4
.formula H|such = M|ytnachprojekt^such  ? _F|empty(M|ytnachprojekt)
.formula H|such = M|ytnachkoobjekt^such ?  F|empty(M|ytnachprojekt)
.rewrite
.assign M|ytmatumbu = H|id
!EL026
.select lock add M|ytmatumbu
.continue EL027 ? _(G|mehr)
.continue EL028 ? _(G|gesperrt)
.continue EL029 ? _(F|empty(H|ytransaktion))
.formula H|name          = M|ytbutext
.copy    H|yvonprojekt   = M|ytvonprojekt
.copy    H|yvonpvorgang  = M|ytvonpvorgang
.copy    H|yvonkoobjekt  = M|ytvonkoobjekt
.copy    H|ynachprojekt  = M|ytnachprojekt
.copy    H|ynachpvorgang = M|ytnachpvorgang
.copy    H|ynachkoobjekt = M|ytnachkoobjekt
.formula H|ybudat        = M|ytbudat
.formula H|ybutext       = M|ytbutext
.formula H|ybetrag       = M|ytbetrag
.copy    H|ywaehrung     = M|ytwaehrung
.copy    H|yleistmeld    = M|ytleistmeld
.copy    H|yaufgabe      = M|ytaufgabe
.copy    H|ykategorie    = M|ytkategorie
.copy    H|ybemerkung    = M|ytbemerkung
.rewrite
.select lock add M|ytmatumbu
.load 9 add M|ytmatumbu
.continue EL030 ? _(G|mehr)
.continue EL031 ? _((_(5|ykostlmkeinebuch)) ; (F|empty(9|yleistmeld)))
.formula U|xttransini  = F|foppath("TRANSACTION.PRJMMATUMBU.INI")
.formula U|xttransdat  = "rmtmp/X.PRJMMATUMBU." + G|sekundenz + "." + G|pid + ".DAT.TMP"
.formula U|xttransprot = "rmtmp/X.PRJMMATUMBU." + G|sekundenz + "." + G|pid + ".PROT.TMP"
.formula U|xttransleer = "rmtmp/X.PRJMMATUMBU." + G|sekundenz + "." + G|pid + ".LEER.TMP"
.output new 'U|xttransdat'
.input DATEI.F
.formula U|xtsuch = "UM" + '9|ybudat:8'<<-2
.formula U|xtname = 5|yprjmmatumbtext + " " + 'G|datum' + " " + G|bzeichen + " " + 9|ybutext
.formula U|xtkenn = "ST"
.formula U|xtkenn = "ST"                ?  F|empty(5|yprjmmatumbjkz)
.formula U|xtkenn = 5|yprjmmatumbjkz    ? _F|empty(5|yprjmmatumbjkz)
.formula U|xtpr   = ""
.formula U|xtpr   = 9|ynachprojekt^nummer   ? _F|empty(9|ynachprojekt)
.formula U|xtpt   = ""
.formula U|xtpt   = 9|ynachpvorgang^nummer  ? _F|empty(9|ynachpvorgang)
.formula U|xtwp   = ""
.formula U|xtwp   = 9|ynacharbpaket^nummer  ? _F|empty(9|ynacharbpaket)
1;'5|yprjmmatumbkto^nummer';'9|ybetrag';;'9|ynachkoobjekt^nummer';'9|ywaehrung';'9|ybudat:8';'U|xtkenn';'U|xtname';'U|xtsuch';'U|xtpr';'U|xtpt';'U|xtwp';
.formula U|xtpr   = ""
.formula U|xtpr   = 9|yvonprojekt^nummer    ? _F|empty(9|yvonprojekt)
.formula U|xtpt   = ""
.formula U|xtpt   = 9|yvonpvorgang^nummer   ? _F|empty(9|yvonpvorgang)
.formula U|xtwp   = ""
.formula U|xtwp   = 9|yvonarbpaket^nummer   ? _F|empty(9|yvonarbpaket)
1;'5|yprjmentlmatumbkto^nummer';;'9|ybetrag';'9|yvonkoobjekt^nummer';'9|ywaehrung';'9|ybudat:8';'U|xtkenn';'U|xtname';'U|xtsuch';'U|xtpr';'U|xtpt';'U|xtwp';
.output new WERF.WEG
.formula U|xtcmd = "TRANSACTION.NEW"
.formula U|xtcmd = U|xtcmd + " " + U|xttransini
.formula U|xtcmd = U|xtcmd + " " + U|xttransdat
.formula U|xtcmd = U|xtcmd + " " + U|xttransprot
.formula U|xtcmd = U|xtcmd + " " + U|xttransleer
.formula U|xtcmd = U|xtcmd + " " + H|id
.formula U|xtcmd = U|xtcmd + " " + H|nummer
.select -
.add F|sysinfo(10)^ykonfigprjm
.continue EL032 ? _(G|mehr)
.assign G|neuespassw = D|ybatchuser     ? _F|empty(D|ybatchuser) & D|ybatchuser^fremdok
!EL032
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedperr
.formula U|xtsys = "EKSPASSWORT=" + G|einmalpw + " export EKSPASSWORT ;batchlg.sh " + G|dblquote + U|xtcmd + G|dblquote + " >" + U|xtedpout + " 2>" + U|xtedperr
.system 'U|xtsys' BACKGROUND
.continue EL033 ? _(G|mehr)
.continue EL034 ? _(F|filenotempty(U|xtedperr))
.set trans +
.box Fehler
Die Materialumbuchung in Zeile 'M|aktzeile' konnte nicht gebucht werden.
.set trans -
.edi 'U|xtedperr'
!EL034
.continue FI033
!EL033
.set trans +
.box Fehler
Die Materialumbuchung in Zeile 'M|aktzeile' konnte nicht gebucht werden.
.set trans -
!FI033
.continue FI031
!EL031
.select lock add 9|id
.copy H|ytransaktion = 5|ypmkbuchtrans
.rewrite
.select -
!FI031
.load 9 add M|ytmatumbu
.continue EL035 ? _(G|mehr)
.continue EL036 ? _(_(F|empty(9|ytransaktion)))
.formula M|ytransaktion = 9|ytransaktion
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC003
!RET002
