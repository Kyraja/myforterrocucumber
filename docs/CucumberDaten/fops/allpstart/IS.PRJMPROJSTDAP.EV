..!interpreter english declaration noabbrev
.. at 2016-09-05, 10:48
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMPROJSTDAP.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 28.02.2011
..==  Autor             : Sebastian Strobel, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtcmd xtsel xykoobjekt xtid
.type text    xtprojekt xtpindex xtfarbe
.type text    xtapmerk xtpemerk
.type integer xivar xipindex xizeile
.type real    xrprarb xrprfakt xraparb xrapfakt xrpearb xrpefakt
.type GD19    xdvon xdbis
.type GD      xddat
.type bool    xyberlaubt xbmehr
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.continue EL001 ? _(F|defined(M|ystdvondatum))
.formula U|xdvon        = "<M+1M-1Y"
.formula M|ystdvondatum = U|xdvon
!EL001
.continue EL002 ? _(F|defined(M|ystdbisdatum))
.formula U|xdbis        = ">M"
.formula m|ystdbisdatum = U|xdbis
!EL002
.protection yarbpaket 0 ? F|empty(M|yprojekt)
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldfuell")
.continue BRK003 ? _(G|evtvar = "yarbpaket")
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "ypvorgang")
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "yprojekt")
.input 'U|xtupprjmsel'
.continue EL003 ? _(M|yprojekt<>"")
.protection -reset yarbpaket 0
.continue FI003
!EL003
.protection yarbpaket 0
!FI003
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ypvorgang")
.copy    M|yprojekt  = M|ypvorgang^yprojekt     ? _F|empty(M|ypvorgang)
.input 'U|xtupprjmsel'
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "yprojleit")
.input 'U|xtupprjmsel'
.continue EL004 ? _(M|yprojekt="")
.protection yarbpaket 0
.continue FI004
!EL004
.cursor yarbpaket 0
!FI004
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "yballekst")
.input 'U|xtupprjmsel'
.formula M|yarbpaket = ""   ?  F|empty(M|yprojekt)
.continue EL005 ? _(M|yprojekt="")
.protection yarbpaket 0
.continue FI005
!EL005
.cursor yarbpaket 0
!FI005
.continue ESAC003
!BRK009
.continue BRK010 ? _(G|evtvar = "ystdvondatum")
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "ystdbisdatum")
.continue EL006 ? _(M|ystdbisdatum < M|ystdvondatum)
.formula U|xdbis     = ">" + 'F|year(M|ystdvondatum)' + "Y" + 'F|month(M|ystdvondatum)' + "M"
.formula M|ystdbisdatum = U|xdbis
!EL006
.cursor yvkauftrag 0      ? F|defined(M|yvkauftrag)
.continue ESAC003
!BRK011
.input 'U|xtupprjmsel'
!ESAC003: =====   ENDCASE   =====
.make screen line --O
.continue ESAC001
!BRK005
.continue BRK012 ? _(G|evtart = "buttonvor")
.continue BRK013 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC004
!BRK013
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK012
.continue BRK014 ? _(G|evtart = "buttonnach")
.continue BRK015 ? _(G|evtvar = "bstart")
.input 'U|xtupprjmsel'
.continue ESAC005
!BRK015
.continue BRK016 ? _(G|evtvar = "ylm")
.formula U|xtcmd = G|kkomname38 + " PRJMLM "
.formula U|xtcmd = U|xtcmd + "?ystdvondatum="     + M|ystdvondatum:8
.formula U|xtcmd = U|xtcmd + "|ystdbisdatum="     + M|ystdbisdatum:8
.formula U|xtcmd = U|xtcmd + "|yprojekt="         + M|ytprojekt^id          ? _F|empty(m|ytprojekt)
.formula U|xtcmd = U|xtcmd + "|yarbpaket="        + M|ytarbpaket^id         ? _F|empty(m|ytarbpaket)
.formula U|xtcmd = U|xtcmd + "|ypersonal="        + M|ytpersonal^id         ? _F|empty(m|ytpersonal)
.formula U|xtcmd = U|xtcmd + "|bstart="
.command -PARALLEL 'U|xtcmd'
.continue ESAC005
!BRK016
!ESAC005: =====   ENDCASE   =====
.continue ESAC001
!BRK014
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMPROJSTDAP.EV")'      ? F|fileexists(F|foppath("IFOP.IS.PRJMPROJSTDAP.EV"))
.continue
