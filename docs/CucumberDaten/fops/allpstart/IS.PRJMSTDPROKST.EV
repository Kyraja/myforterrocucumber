..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xttemp xtid xtkst xt1 xtftext1 xtftext2 xtnumkst
.type text    xtfarbe0 xtfarbe1 xtfarbe2 xtfarbe3 xtfarbe4 xtfarbe5
.type text    xtfarbewe0 xtfarbewe1 xtfarbewe2 xtfarbewe3 xtfarbewe4 xtfarbewe5 xtfarbepwe0 xtfarbepwe1 xtfarbepwe2 xtfarbepwe3 xtfarbepwe4 xtfarbepwe5
.type real    xrarbzeit xrfaktzeit xrsz1 xrsz2 xrsz3 xrsz4 xrsz5 xrsz6 xrsz7
.type integer xitag xi1
.type GD      xdatum xd1 xdadatum xdedatum
.type bool    xbabwesend xbmehr xbabsences
.type P5:2    xtindexkst xtidkst
.type text    xtstackkst
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Wochentage -----
.continue EL001 ? _((M|yvondatum < M|ybisdatum) ; (F|empty(M|ybisdatum)))
.continue EL002 ? _(M|ybisdatum - M|yvondatum > 31)
.set TRANS +
.box Hinweis
Es ist maximal ein Zeitraum von 31 Tagen erlaubt.
.set TRANS -
.formula M|yvondatum = M|ybisdatum - 30      ? G|evtvar = "ybisdatum"
.formula M|ybisdatum = M|yvondatum + 30      ? G|evtvar = "yvondatum"
!EL002
!EL001
.formula U|xdatum = M|yvondatum
.formula U|xitag  = 1
!LOOP001: ==============================
.continue ELOP001 ? _(U|xdatum < M|ybisdatum)
.formula U|xdatum         = M|yvondatum + U|xitag - 1
.formula M|ytagtext.xitag = U|xdatum//1<<2
.formula U|xitag = U|xitag + 1
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Hinweis_nach_DVMR2 -----
.input DATEI.F
.formula U|xtftext1 = "rmtmp/XTFTEXT1" + 'G|versionneu' + ".TMP"
.formula U|xtftext2 = "rmtmp/XTFTEXT2" + 'G|versionneu' + ".TMP"
.output NEW 'U|xtftext1'
.input -TEXT 'M|yftext1'
.output NEW 'U|xtftext2'
.input -TEXT 'M|yftext2'
.formula M|ydvftext1 = U|xtftext1
.formula M|ydvftext2 = U|xtftext2
.continue 'xprocst.xprocsp'
!PROC003: ----- Hinweise_laden -----
.continue EL003 ? _((_(F|empty(M|ypersonal))) & (_(F|empty(M|yvondatum))))
.formula U|xtsel = "$,,ymonat==" + 'F|month(M|yvondatum)' + ";yjahr==" + 'F|year(M|yvondatum)' + ";ypersonal==" + M|ypersonal^id
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL004 ? _(G|mehr)
.file -TEMPNAME U|xtftext1
.file -TEMPNAME U|xtftext2
.input DATEI.F
.output NEW 'U|xtftext1'
.input -TEXT '9|yhinweisges1'         ? _F|empty(9|yhinweisges1)
.output NEW 'U|xtftext2'
.input -TEXT '9|yhinweisges2'         ? _F|empty(9|yhinweisges2)
.continue EL005 ? _((F|empty(9|yhinweisges1)) ; (F|empty(9|yhinweisges2)))
.load 9 line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL006 ? _((F|empty(9|yhinweisges1)) & (_(F|empty(9|ythinweis1))))
.continue EL007 ? _(_(F|empty(9|ykstelle)))
.output ADDEDTO 'U|xtftext1'
<b>Kostenstelle '9|ykstelle'</b>
!EL007
.continue EL008 ? _(_(F|empty(9|yprojekt)))
.output ADDEDTO 'U|xtftext1'
<b>Projekt '9|yprojekt'</b>
!EL008
'9|ythinweis1                                                                                                              '
.output NEW "WERF.WEG"
!EL006
.continue EL009 ? _((F|empty(9|yhinweisges2)) & (_(F|empty(9|ythinweis2))))
.continue EL010 ? _(_(F|empty(9|ykstelle)))
.output ADDEDTO 'U|xtftext2'
<b>Kostenstelle '9|ykstelle'</b>
!EL010
.continue EL011 ? _(_(F|empty(9|yprojekt)))
.output ADDEDTO 'U|xtftext2'
<b>Projekt '9|yprojekt'</b>
!EL011
?'9|ythinweis2                                                                                                              '
.output NEW "WERF.WEG"
!EL009
.load 9 line
.continue LOOP002
!ELOP002: ==============================
!EL005
.formula M|yftext1 = U|xtftext1
.formula M|yftext2 = U|xtftext2
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue FI004
!EL004
.formula M|yftext1 = ""
.formula M|yftext2 = ""
!FI004
.continue FI003
!EL003
.formula M|yftext1 = ""
.formula M|yftext2 = ""
!FI003
.continue 'xprocst.xprocsp'
!PROC004: ----- Farben_zuruecksetzen -----
.colour -BACKGROUND "-1 -1 -1" ykstelle  'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" yobjekt   'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" yobjname  'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" yzsumme   'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag1     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag2     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag3     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag4     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag5     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag6     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag7     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag8     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag9     'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag10    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag11    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag12    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag13    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag14    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag15    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag16    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag17    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag18    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag19    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag20    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag21    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag22    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag23    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag24    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag25    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag26    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag27    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag28    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag29    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag30    'M|aktzeile'
.colour -BACKGROUND "-1 -1 -1" ytag31    'M|aktzeile'
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.formula M|yfirma    = F|sysinfo(10)^ans<<";"
.formula U|xdatum    = ('G|datum:8')<<6 + "01"
.formula M|ybisdatum = U|xdatum - 1
.formula M|yvondatum = ('M|ybisdatum:8')<<6 + "01"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "buttonvor")
.continue BRK003 ? _(G|evtvar = "budruck")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "bstart")
.continue EL012 ? _((_(F|empty(M|ypersonal))) & (_(F|empty(M|yvondatum))) & (_(F|empty(M|ybisdatum))))
.make screen line --O
.continue FI012
!EL012
.set TRANS +
.box Hinweis
Bitte zuerst Personal und Zeitraum angeben.
.set TRANS -
.error
.end 1
!FI012
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "buttonnach")
.continue BRK006 ? _(G|evtvar = "bstart")
.formula U|xtfarbe0 = "240 240 240"
.formula U|xtfarbe1 = "221 238 255"
.formula U|xtfarbe2 = "245 250 255"
.formula U|xtfarbe3 = "50 255 50"
.formula U|xtfarbe4 = "150 255 150"
.formula U|xtfarbe5 = "220 255 220"
.formula U|xtfarbewe0  = U|xtfarbe0
.formula U|xtfarbepwe0 = U|xtfarbe0
.formula U|xtfarbewe1  = "200 214 229"
.formula U|xtfarbepwe1 = "177 190 204"
.formula U|xtfarbewe2  = "216 225 230"
.formula U|xtfarbepwe2 = "192 200 204"
.formula U|xtfarbewe3  = " 40 230  40"
.formula U|xtfarbepwe3 = " 30 204  30"
.formula U|xtfarbewe4  = "150 230 150"
.formula U|xtfarbepwe4 = "140 204 140"
.formula U|xtfarbewe5  = "200 230 200"
.formula U|xtfarbepwe5 = "190 204 190"
.input allpstart/IS.PRJM.KST.ARRAY  ? _F|empty(M|ykst1)
.load 9 add M|ypersonal
.continue EL013 ? _(G|mehr)
.copy U|xbabsences = G|true
.copy U|xdadatum   = M|yvondatum
.copy U|xdedatum   = M|ybisdatum
.input "java:de.alltrotec.ps.control.StaffWorkDays@ALLPS"
.formula U|xitag = 1
!LOOP003: ==============================
.continue ELOP003 ? _(U|xdatum < M|ybisdatum)
.type real xrsummeab.xitag      ? _F|defined(U|xrsummeab.xitag)
.type real xrsummean.xitag      ? _F|defined(U|xrsummean.xitag)
.formula U|xdatum = M|yvondatum + U|xitag - 1
.formula U|xt1    = U|xdatum:8
.type integer xitag.U|xt1      ? _F|defined(U|xitag.U|xt1)
.formula U|xitag.U|xt1 = U|xitag
.formula U|xitag = U|xitag + 1
.continue LOOP003
!ELOP003: ==============================
.file -TEMPNAME U|xttemp
.output NEW 'U|xttemp'
.input DATEI.F
.formula U|xtsel = "$,,ypersonal==" + M|ypersonal^id + ";yadatum=" + M|yvondatum:8 + "!" + M|ybisdatum:8 + ";@filingmode=(Active)"
.select group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL014 ? _((H|ytaetschl^yabwesend) & (_(F|empty(H|ytaetschl))))
1 # 'H|ytaetschl^id' # 'H|ytaetschl^namebspr' # 'H|yadatum:8' # 'H|yarbzeit' # 'H|yfaktzeit' #
.continue FI014
!EL014
?0 # 'H|yprojekt^yverantwkst^id' # 'H|yprojekt^yverantwkst^nummer' # 'H|yadatum:8' # 'H|yarbzeit' # 'H|yfaktzeit' #     ? _F|empty(H|yprojekt)
?0 # 'H|yaufgabe^ykstelle^id' # 'H|yaufgabe^ykstelle^nummer' # 'H|yadatum:8' # 'H|yarbzeit' # 'H|yfaktzeit' #           ?  F|empty(H|yprojekt) & _F|empty(H|yaufgabe)
?0 # 'H|ykstelle^id' # 'H|ykstelle^nummer' # 'H|yadatum:8' # 'H|yarbzeit' # 'H|yfaktzeit' #                             ?  F|empty(H|yprojekt) &  F|empty(H|yaufgabe)
!FI014
.select continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsys = "sort -t# +0 -1 +2 -3 +1 -2 -o " + U|xttemp + " " + U|xttemp
.system 'U|xtsys' BACKGROUND
.select from 'U|xttemp' U|xbabwesend # U|xtid # U|xtkst # U|xdatum # U|xrarbzeit # U|xrfaktzeit #
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.continue EL015 ? _((F|empty(M|ykst1)) ; ((_(F|empty(M|ykst1))) & (_(F|empty(U|xtid)))))
.assign  U|xtidkst  = U|xtid
.formula U|xtnumkst = "CC" + (U|xtidkst^id<<",")<<-1
.continue EL016 ? _((F|empty(M|ykst1)) ; (F|defined(U|xtkst.xtnumkst)))
.formula U|xt1 = M|yobjekt^id   ? M|aktzeile > 0
.continue EL017 ? _(U|xt1 <> U|xtid)
.make screen line +O
.assign  M|ykstelle = U|xtid
.assign  M|yobjekt  = U|xtid
.formula M|yobjname = M|yobjekt^namebspr
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC004
!RET004
.formula xprocsp = xprocsp - 1
.formula U|xitag = 1
!LOOP006: ==============================
.continue ELOP006 ? _(F|defined(M|ytag.xitag))
.formula U|xd1 = M|yvondatum + U|xitag - 1
.formula U|xt1 = U|xd1:8
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbepwe1' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'    ?  U|xbabwesend & (U|xd1//7 = 6 ;  U|xd1//7 = 7)
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbepwe2' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'    ? _U|xbabwesend & (U|xd1//7 = 6 ;  U|xd1//7 = 7)
.'U|xtcmd'
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbe0' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'       ? _F|defined(U|xitag.xt1)
.'U|xtcmd'
.formula U|xitag = U|xitag + 1
.continue LOOP006
!ELOP006: ==============================
.colour -BACKGROUND 'U|xtfarbe1' 'M|aktzeile'   ?  U|xbabwesend
.colour -BACKGROUND 'U|xtfarbe2' 'M|aktzeile'   ? _U|xbabwesend
!EL017
.formula U|xt1    = U|xdatum:8
.formula U|xitag  = U|xitag.xt1
.formula M|ytag.xitag = M|ytag.xitag + U|xrarbzeit
.formula M|yzsumme    = M|yzsumme    + U|xrarbzeit
.formula U|xrsummeab.xitag = U|xrsummeab.xitag + U|xrarbzeit     ?  U|xbabwesend
.formula U|xrsummean.xitag = U|xrsummean.xitag + U|xrarbzeit     ? _U|xbabwesend
!EL016
!EL015
.select from 'U|xttemp' U|xbabwesend # U|xtid # U|xtkst # U|xdatum # U|xrarbzeit # U|xrfaktzeit #
.continue LOOP005
!ELOP005: ==============================
.continue EL018 ? _(F|empty(M|ykst1))
.make screen line +O
.set trans +
.formula M|yobjname = "Sollzeit"
.set trans -
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC004
!RET005
.formula xprocsp = xprocsp - 1
.colour -BACKGROUND 'U|xtfarbe4' 'M|aktzeile'
.formula U|xitag = 1
!LOOP007: ==============================
.continue ELOP007 ? _(F|defined(M|ytag.xitag))
.formula U|xd1 = M|yvondatum + U|xitag - 1
.formula U|xt1 = U|xd1:8
.continue EL019 ? _(F|defined(U|xitag.xt1))
.formula M|ytag.xitag = U|xrtt.U|xt1                ? U|xbwd.xt1
.formula M|yzsumme    = M|yzsumme + M|ytag.xitag
!EL019
.type real xrs.xitag     ? _F|defined(U|xrs.xitag)
.formula U|xrs.xitag = M|ytag.xitag
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbepwe4' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'    ?  U|xd1//7 = 6 ;  U|xd1//7 = 7
.'U|xtcmd'
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbe0' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'       ? _F|defined(U|xitag.xt1)
.'U|xtcmd'
.formula U|xitag = U|xitag + 1
.continue LOOP007
!ELOP007: ==============================
.make screen line +O
.set trans +
.formula M|yobjname = "öberstunden"
.set trans -
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC004
!RET006
.formula xprocsp = xprocsp - 1
.formula U|xitag = 1
!LOOP008: ==============================
.continue ELOP008 ? _(F|defined(M|ytag.xitag))
.formula U|xd1 = M|yvondatum + U|xitag - 1
.formula U|xt1 = U|xd1:8
.formula M|ytag.xitag = U|xrsummean.xitag - U|xrs.xitag                         ?  F|defined(U|xrsummean.xitag)
.formula M|yzsumme    = M|yzsumme + M|ytag.xitag                                ?  F|defined(U|xrsummean.xitag)
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbepwe4' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'    ?  U|xd1//7 = 6 ;  U|xd1//7 = 7
.'U|xtcmd'
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbe0' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'       ? _F|defined(U|xitag.xt1)
.'U|xtcmd'
.formula U|xitag = U|xitag + 1
.continue LOOP008
!ELOP008: ==============================
.colour -BACKGROUND 'U|xtfarbe4' 'M|aktzeile'
!EL018
.make screen line +O
.set trans +
.formula M|yobjname = "Summe anwesend"
.set trans -
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC004
!RET007
.formula xprocsp = xprocsp - 1
.formula U|xitag = 1
!LOOP009: ==============================
.continue ELOP009 ? _(F|defined(M|ytag.xitag))
.formula M|ytag.xitag = U|xrsummean.xitag                ?  F|defined(U|xrsummean.xitag)
.formula M|yzsumme    = M|yzsumme + U|xrsummean.xitag    ?  F|defined(U|xrsummean.xitag)
.formula U|xd1 = M|yvondatum + U|xitag - 1
.formula U|xt1 = U|xd1:8
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbepwe3' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'    ?  U|xd1//7 = 6 ;  U|xd1//7 = 7
.'U|xtcmd'
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbe0' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'       ? _F|defined(U|xitag.xt1)
.'U|xtcmd'
.formula U|xitag = U|xitag + 1
.continue LOOP009
!ELOP009: ==============================
.colour -BACKGROUND 'U|xtfarbe3' 'M|aktzeile'
.continue EL020 ? _(F|empty(M|ykst1))
.make screen line +O
.set trans +
.formula M|yobjname = "Summe abwesend"
.set trans -
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC004
!RET008
.formula xprocsp = xprocsp - 1
.formula U|xitag = 1
!LOOP010: ==============================
.continue ELOP010 ? _(F|defined(M|ytag.xitag))
.formula M|ytag.xitag = U|xrsummeab.xitag                ?  F|defined(U|xrsummeab.xitag)
.formula M|yzsumme    = M|yzsumme + U|xrsummeab.xitag    ?  F|defined(U|xrsummeab.xitag)
.formula U|xd1 = M|yvondatum + U|xitag - 1
.formula U|xt1 = U|xd1:8
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbepwe3' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'   ?  U|xd1//7 = 6 ;  U|xd1//7 = 7
.'U|xtcmd'                                                                                              ?  U|xd1//7 = 6 ;  U|xd1//7 = 7
.formula U|xtcmd = ".."
.formula U|xtcmd = "colour -BACKGROUND " + 'U|xtfarbe0' + " ytag" + 'U|xitag' + " " + 'M|aktzeile'      ? _F|defined(U|xitag.xt1)
.'U|xtcmd'                                                                                              ? _F|defined(U|xitag.xt1)
.formula U|xitag = U|xitag + 1
