.colour -BACKGROUND 'U|xtfarbe3' 'M|aktzeile'
!EL020
!EL013
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ybuhinwspeich")
.continue EL021 ? _(G|FALSE)
.continue EL022 ? _((_(F|empty(M|ypersonal))) & (_(F|empty(M|yvondatum))))
