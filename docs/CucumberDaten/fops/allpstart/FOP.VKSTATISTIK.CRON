.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtdatei xtid xtmerkid xtpos xtdbgr
.type integer xidatei ximonat xijahr
.type realx   xxmge xxlehe xxpehe  xxkorrmge xxkorrbudget
.type GD      xdbezugsdatum xdbeginnmonat xdvormonat xdatum xdsela xdsele xderfass
.type GD19    xdzeitpunkt xdpmllaufvkstat xd19 xdlastrun
.type ZAE1    xversionn
.type A7      xekvk
.type bool    xbok xbmehr
.type TAZ1    xle xpe xhe
.type text    xtprojekt         ? _F|defined(U|xtprojekt)
.type integer   xprocsp         ? _F|defined(U|xprocsp)
.set DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- LS_Korrektur -----
.formula U|xxkorrmge = 0
.formula U|xdsela = 'U|xijahr' + ("0" + 'U|ximonat')>>2 + "01"
.formula U|xdsele =  U|xdsela + 31
.formula U|xdsele = 'U|xdsele:8'<<6 + "01"
.formula U|xdsele =  U|xdsele - 1
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|LIKO' + ");orig==" + U|xtmerkid
.formula U|xtsel = U|xtsel + ";kovom<="       + 'U|xdsele:8'    ? _F|sysinfo(18)^bewlei
.formula U|xtsel = U|xtsel + ";kopf^leidat<=" + 'U|xdsele:8'    ?  F|sysinfo(18)^bewlei
.formula U|xtsel = U|xtsel + ";kopf^erfass>"  + 'U|xdsele:8'
.formula U|xtsel = U|xtsel + ";kopf^uebertr=0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 0 group 'U|xtdbgr' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xxkorrmge = U|xxkorrmge + (0|mge * 0|lehe)
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.copy U|xbok = G|TRUE
.formula U|xtsel = "$,,yaupos==" + U|xtmerkid + ";ybezugsdatum=" + 'U|xdsele' + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrvkstat' 'U|xtsel'
.continue EL001 ? _(G|mehr)
.select lock group 'U|xydbgrvkstat' '9|id'
.continue EL002 ? _(_(G|mehr))
.set trans +
FEHLER: Statistiksatz '9|numer' zu Position '0|id' kann nicht bearbeitet werden.
        Die Position wird Åbersprungen.
.set trans -
.copy U|xbok = G|FALSE
.continue FI002
!EL002
.formula H|ykorrlimge = U|xxkorrmge             ? H|ylehe =  0
.formula H|ykorrlimge = U|xxkorrmge / H|ylehe   ? H|ylehe <> 0
.rewrite
!FI002
!EL001
.formula U|xtmerkid = U|xtid
.formula U|ximonat  = F|month(U|xdatum)
.formula U|xijahr   = F|year(U|xdatum)
.continue 'xprocst.xprocsp'
!PROC002: ----- RE_Korrektur -----
.formula U|xdsela = 'U|xijahr' + ("0" + 'U|ximonat')>>2 + "01"
.formula U|xdsele =  U|xdsela + 31
.formula U|xdsele = 'U|xdsele:8'<<6 + "01"
.formula U|xdsele =  U|xdsele - 1
!REPT001: ==============================
.formula U|xxkorrmge    = 0
.formula U|xxkorrbudget = 0
.formula U|xtsel = "$,,yaupos==" + U|xtmerkid + ";ybezugsdatum=" + 'U|xdsele' + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrvkstat' 'U|xtsel'
.continue EL003 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";orig==" + U|xtmerkid
.formula U|xtsel = U|xtsel + ";kopf^uebertr=0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 0 group 'U|xtdbgr' 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL004 ? _(0|kotyp = G|REKO)
.formula U|xderfass = 0|kopf^erfass
.continue EL005 ? _((0|kopf^budat <= U|xdsele) & (U|xderfass > U|xdsele))
.formula U|xxkorrmge = U|xxkorrmge + (0|mge * 0|lehe)
.continue EL006 ? _(0|dnr = 3)
.continue EL007 ? _((9|yprjmpermabgerstdk = "D") ; ((F|empty(9|yprjmpermabgerstdk)) & ((9|yprojekt^yermabgerstdk = "D") ; ((F|empty(9|yprojekt^yermabgerstdk)) & (F|sysinfo(10)^ykonfigprjm^ypmermabgerstdk = "D")))))
.formula U|xxkorrbudget = 0|nwert
.formula U|xxkorrbudget = 0|nwert - 0|stwert                                    ? 0|kopf^brutto
.formula U|xxkorrbudget = F|fxamount(G|inland,U|xxkorrbudget,,0|pland,G|TRUE)   ? 0|pland <> G|inland
!EL007
!EL006
!EL005
.continue FI004
!EL004
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|REKO' + ");orig==" + 0|id
.formula U|xtsel = U|xtsel + ";kopf^budat<="  + 'U|xdsele:8'
.formula U|xtsel = U|xtsel + ";kopf^erfass>"  + 'U|xdsele:8'
.formula U|xtsel = U|xtsel + ";kopf^uebertr=0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 1 group 'U|xtdbgr' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula U|xxkorrmge = U|xxkorrmge + (1|mge * 1|lehe)
.load 1 continue
.continue LOOP003
!ELOP003: ==============================
!FI004
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.copy U|xbok = G|TRUE
.select lock group 'U|xydbgrvkstat' '9|id'
.continue EL008 ? _(_(G|mehr))
.set trans +
FEHLER: Statistiksatz '9|numer' zu Position '0|id' kann nicht bearbeitet werden.
        Die Position wird Åbersprungen.
.set trans -
.copy U|xbok = G|FALSE
.continue FI008
!EL008
.formula H|ykorrremge  = U|xxkorrmge            ? H|ylehe =  0
.formula H|ykorrremge  = U|xxkorrmge / H|ylehe  ? H|ylehe <> 0
.formula H|ykorrbudget = U|xxkorrbudget
.rewrite
!FI008
!EL003
.formula U|xdsele =  U|xdsele + 32
.formula U|xdsele = 'U|xdsele:8'<<6 + "01"
.formula U|xdsele =  U|xdsele - 1
.continue REPT001 ? _(U|xdsele >= U|xdbezugsdatum)
.formula U|xtmerkid = U|xtid
.formula U|ximonat  = F|month(U|xdatum)
.formula U|xijahr   = F|year(U|xdatum)
.continue 'xprocst.xprocsp'
!PROC003: ----- Statistik_Datensatz -----
.copy U|xbok = G|TRUE
.formula U|xtsel = "$,,yaupos==" + 0|id + ";ybezugsdatum=" + U|xdbezugsdatum:8 + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrvkstat' 'U|xtsel'
.continue EL009 ? _(G|mehr)
.select lock add 9|id
.continue EL010 ? _(_(G|mehr))
.set trans +
FEHLER: Statistiksatz '9|numer' zu Position '0|id' kann nicht bearbeitet werden.
        Die Position wird Åbersprungen.
.set trans -
.copy U|xbok = G|FALSE
!EL010
.continue FI009
!EL009
.formula U|xtcmd "make " + G|hdatname.xydbvkstat + " group" + 'U|xygrvkstat'
.'U|xtcmd'
!FI009
.continue EL011 ? _(U|xbok)
.formula H|such         = "S" + U|xdbezugsdatum:8
.formula H|name         = "Auftrag: "    + 0|kopf + ", Position: " + 0|pnum + ", Datum: " + 'G|DATUM'   ? 'U|xekvk(L=":")' = "(Sales)"
.formula H|name         = "Bestellung: " + 0|kopf + ", Position: " + 0|pnum + ", Datum: " + 'G|DATUM'   ? 'U|xekvk(L=":")' = "(Purchasing)"
.formula H|ybezugsdatum = U|xdbezugsdatum
.formula H|yekvk        = U|xekvk
.formula H|ykuli       = 0|kunde^id                 ? F|defined(0|kunde)
.formula H|ykuli       = 0|lief^id                  ? F|defined(0|lief)
.formula H|yauftrag    = 0|kopf^id
.formula H|yaupos      = 0|id
.copy    H|ykstelle    = 0|kstelle
.copy    H|ykonto      = 0|konto
.copy    H|yprojekt    = 0|projekt
.copy    H|yabrechtypk = 0|yprjmpabrechtypk         ? F|defined(0|yprjmpabrechtypk)
.formula H|yevpnum        = 0|pnum
.copy    H|yalternativpos = 0|alternativpos
.formula H|yalternativgrp = 0|alternativgrp
.formula H|yevptext       = 0|ptext
.formula H|yevkovom       = 0|kovom
.formula H|yevtyp         ='0|typ(L="0")'
.formula H|ymge           = 0|mge
.formula H|ypreis         = 0|preis
.formula H|yproz          = 0|proz
.formula H|ypwert         = 0|pwert
.formula H|yeigenanteil   = 0|yprjmpeigenleist      ? F|defined(0|yprjmpeigenleist)
.formula H|yfremdanteil   = 0|yprjmpfremdleist      ? F|defined(0|yprjmpfremdleist)
.formula H|ysonstkost     = 0|yprjmpsonstkost       ? F|defined(0|yprjmpsonstkost)
.formula H|yfertleist     = 0|yprjmpfertleist       ? F|defined(0|yprjmpfertleist)
.formula H|ynwert         = 0|nwert
.formula H|ynpwert        = 0|npwert
.formula H|ystsatz        = 0|stsatz
.formula H|ystwert        = 0|stwert
.formula H|ybudgetwert    = 0|yprjmpbudgetwert
.copy    H|ypland         = 0|pland
.formula H|yewkurs        = 0|kopf^ewkurs
.copy    H|ykursfix       = 0|kopf^kursfix
.copy    H|ybrutto        = 0|kobrutto
.copy    H|yhe            = 0|he
.copy    H|ype            = 0|pe
.formula H|ylehe          = 0|lehe
.formula H|ypehe          = 0|pehe
.copy    H|yartex         = 0|artex
.formula H|yartname       = 0|tename
.assign  H|yzptyp         = 0|artex^zptyp           ?  F|defined(0|artex^zptyp)
.assign  H|yablagen       = 0|ablagen
.copy    H|yprjmparbpaket     = 0|yprjmparbpaket        ? F|defined(0|yprjmparbpaket)
.copy    H|yprjmppvorgang     = 0|yprjmppvorgang        ? F|defined(0|yprjmppvorgang)
.formula H|yprjmpbabger       = 0|yprjmpbabger          ? F|defined(0|yprjmpbabger)
.copy    H|yprjmpnabrechrelev = 0|yprjmpnabrechrelev    ? F|defined(0|yprjmpnabrechrelev)
.copy    H|yprjmpnullrechnung = 0|yprjmpnullrechnung    ? F|defined(0|yprjmpnullrechnung)
.copy    H|yprjmpermabgerstdk = 0|yprjmpermabgerstdk    ? F|defined(0|yprjmpermabgerstdk)
.copy    H|yprjmpbedarfstraeg = 0|yprjmpbedarfstraeg    ? F|defined(0|yprjmpbedarfstraeg)
.formula H|yprjmpfcwert       = 0|yprjmpfcwert          ? F|defined(0|yprjmpfcwert)
.formula H|yprjmpsolldatanf   = 0|yprjmpsolldatanf      ? F|defined(0|yprjmpsolldatanf)
.formula H|yprjmpsolldatang   = 0|yprjmpsolldatang      ? F|defined(0|yprjmpsolldatang)
.formula H|yprjmpsolldatbest  = 0|yprjmpsolldatbest     ? F|defined(0|yprjmpsolldatbest)
.formula H|yprjmpsolldatlief  = 0|yprjmpsolldatlief     ? F|defined(0|yprjmpsolldatlief)
.formula H|yprjmpbem          = 0|yprjmpbem             ? F|defined(0|yprjmpbem)
.formula H|yprjmpekposid      = 0|yprjmpekposid         ? F|defined(0|yprjmpekposid)
.formula H|yprjmpekbeposid    = 0|yprjmpekbeposid       ? F|defined(0|yprjmpekbeposid)
.formula H|yprjmpprojek       = 0|yprjmpprojek          ? F|defined(0|yprjmpprojek)
.formula H|ylimge       = 0|limge
.formula H|yremge       = 0|remge
.formula U|xtsel = "$,,orig==" + 0|id + ";kotyp==(PackingSlip);@ablageart=(Both)"
.load 8 group 'U|xtdbgr' 'U|xtsel'
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.formula H|yremge   = H|yremge + 8|remge    ? _8|kopf^uebertr
.load 8 continue
.continue LOOP004
!ELOP004: ==============================
.formula H|yoffenwert = 0
.continue EL012 ? _(0|mge = 0)
.continue EL013 ? _(0|pwert = 0)
.formula H|yoffenwert = H|yremge
.continue FI013
!EL013
.formula H|yoffenwert = 0|nwert / 0|pwert * H|yremge
!FI013
.continue FI012
!EL012
.formula H|yoffenwert = 0|nwert / 0|mge * H|yremge
!FI012
.rewrite
!EL011
.continue 'xprocst.xprocsp'
