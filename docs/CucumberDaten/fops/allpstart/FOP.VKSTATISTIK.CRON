.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt==" +  U|xtprojekt                        ? _F|empty(U|xtprojekt)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|REKO' + ");orig<>`;versionn>=" + 'U|xdbeginnmonat:8'
.formula U|xtsel = U|xtsel + ";kopf^budat<"  + 'U|xdbeginnmonat:8'
.formula U|xtsel = U|xtsel + ";kopf^uebertr=0"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
