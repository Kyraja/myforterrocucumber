!LOOP009: ==============================
.continue ELOP009 ? _(U|xbmehr)
.continue EL020 ? _(D|kotyp = G|ABKO)
.formula U|xdatum = 0|kopf^budat        ? _F|sysinfo(18)^bewlei
.formula U|xdatum = 0|kopf^leidat       ?  F|sysinfo(18)^bewlei
'D|id' # '0|id' # 'U|xdatum:8' #
