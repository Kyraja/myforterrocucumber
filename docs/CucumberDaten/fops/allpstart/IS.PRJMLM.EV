.type real    xrsumstdtats xrsumstdfakt xrsummzeit
.type P86:1   xpproject
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Selektion_Schutz -----
.assign  M|yprojekt     = ""
.assign  M|ykunde       = ""
.assign  M|yprojleit    = ""
.assign  M|ypersonal    = ""
.assign  M|yprojverantw = ""
.assign  M|yarbpaket    = ""
.assign  M|ytaetschl    = ""
.assign  M|ystdvondatum = ""
.assign  M|ystdbisdatum = ""
