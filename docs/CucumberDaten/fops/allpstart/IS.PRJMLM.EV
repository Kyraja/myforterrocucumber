.formula M|yvkauftrag   = ""
.formula M|yvkaupos     = ""
.formula M|yposnum      = ""
.assign  M|yverrechanf  = ""
.continue 'xprocst.xprocsp'
!PROC002: ----- Rechtepruefung -----
.copy U|xyberlaubt = G|true
.assign U|xpproject = 7|id
.input "allpstart/CHECK.PROJECT"
.continue 'xprocst.xprocsp'
!PROC003: ----- SelDefault -----
.formula U|xtsel = U|xtsel + ";ykunde=="                  + M|ykunde^id                 ? _F|empty(M|ykunde)
.formula U|xtsel = U|xtsel + ";ykunde2=="                 + M|ykunde2^id                ? _F|empty(M|ykunde2)
.formula U|xtsel = U|xtsel + ";ypvorgang^yarbpaket="      + M|yarbpaket^id              ? _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";ytaetschl="                + M|ytaetschl^id              ? _F|empty(M|ytaetschl)
.formula U|xtsel = U|xtsel + ";yaufgabe="                 + M|yarbaufgabe^id            ? _F|empty(M|yarbaufgabe)
.formula U|xtsel = U|xtsel + ";yadatum<="                 + M|ystdbisdatum:8            ? _F|empty(M|ystdbisdatum)
.formula U|xtsel = U|xtsel + ";yedatum>="                 + M|ystdvondatum:8            ? _F|empty(M|ystdvondatum)
.formula U|xtsel = U|xtsel + ";yaufgabe^yvornum="         + M|yvkauftrag^nummer         ? _F|empty(M|yvkauftrag)
.formula U|xtsel = U|xtsel + ";yaufgabe^yvorpos="         + M|yvkaupos^id               ? _F|empty(M|yvkaupos)
.formula U|xtsel = U|xtsel + ";ypersonal=="               + M|ypersonal^id              ? _F|empty(M|ypersonal)
.formula U|xtsel = U|xtsel + ";ylsrelev=1"                                              ?  M|ybnurlsrelev
.formula U|xtsel = U|xtsel + ";yarchiv=0"                                               ? _M|ybmldarchiv
.formula U|xtsel = U|xtsel + ";ypersonal^yprjmperstyp=="   + M|yperstyp^id              ? _F|empty(M|yperstyp)
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.formula U|xtsel = U|xtsel + ";@order=yadatum"                                          ?  U|xbsortdat
.continue 'xprocst.xprocsp'
!PROC004: ----- Selektion -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt="                 + M|yprojekt^id               ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";yprojekt^yprojleit=="      + M|yprojleit^id              ? _F|empty(M|yprojleit)
.formula U|xtsel = U|xtsel + ";yprojekt^yprojverantw=="   + M|yprojverantw^id           ? _F|empty(M|yprojverantw)
.formula U|xtsel = U|xtsel + ";yprojekt^yprojekttyp=="    + M|yprojekttyp^id            ? _F|empty(M|yprojekttyp)
.formula U|xtsel = U|xtsel + ";yprojekt^ystatus=="        + M|yprojstatus^id            ? _F|empty(M|yprojstatus)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC003
!RET001
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC005: ----- Summenzeile -----
.formula U|xrsumstdfakt = 0
.formula U|xrsumstdtats = 0
.formula U|xrsummzeit   = 0
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xrsumstdfakt = U|xrsumstdfakt + M|ystdtats
.formula U|xrsumstdtats = U|xrsumstdtats + M|ystdfakt
.formula U|xrsummzeit   = U|xrsummzeit   + M|ymaschzeit
.select screen line
.continue LOOP001
!ELOP001: ==============================
.select screen head
.make screen line
.formula M|ystdtats   = U|xrsumstdfakt
.formula M|ystdfakt   = U|xrsumstdtats
.formula M|ymaschzeit = U|xrsummzeit
.colour -BACKGROUND 'U|xyfarbelnachweis' 1
.continue 'xprocst.xprocsp'
!PROC006: ----- Leistungsmeldungen_laden -----
