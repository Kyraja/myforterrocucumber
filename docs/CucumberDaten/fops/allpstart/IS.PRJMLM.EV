!PROC007: ----- Fehlermenue -----
!REPT001: ==============================
.set TRANS +
.menu
-                 -
Bei der Aktualisierung der Leistungsmeldung sind Fehler aufgetreten:

EDP Befehl: 'U|xtsys'

EDP Datei:        'U|xtedpdat'  >>.edit "'U|xtedpdat'"
?EDP Hinweisdatei: 'U|xtedpmsg'  >>.edit "'U|xtedpmsg'" ?  F|fileexists(U|xtedpmsg)
?EDP Fehlerdatei:  'U|xtedperr'  >>.edit "'U|xtedperr'" ?  F|fileexists(U|xtedperr)
?EDP Ausgabedatei: 'U|xtedpout'  >>.edit "'U|xtedpout'" ?  F|fileexists(U|xtedpout)
.set TRANS -
.continue REPT001 ? _(G|menue = 0)
.continue
.continue 'xprocst.xprocsp'
!PROC008: ----- Fehlerbehandlung -----
.continue EL043 ? _(F|fileexists(U|xtedpmsg))
.continue EL044 ? _(F|filenotempty(U|xtedpmsg))
.file -TEMPNAME U|xtbox
.input DATEI.F
.output NEW 'U|xtbox'
.assign U|xbmehr = G|false
.set SEPARATOR #
'G|kommandochar'box Hinweis
.file -OPEN U|xiedpmsg 'U|xtedpmsg'
.file -READ U|xiedpmsg xtext^
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL045 ? _(F|regmatch(U|xtext, ".*MSGBOX.*"))
.formula U|xtext = U|xtext>>"MSGBOX:"
'U|xtext                                                                        '
.assign U|xbmehr = G|true
!EL045
.file -READ U|xiedpmsg xtext^
.continue LOOP004
!ELOP004: ==============================
'G|kommandochar''G|kommandochar'
.output NEW WERF.WEG
.continue EL046 ? _(U|xbmehr)
.input 'U|xtbox'
.continue FI046
!EL046
Fehlermenue
