.assign U|xbok = G|true ? M|ybprabgeschlossen & ( D|ystatusk = "FTAB" & (D|yftabdatum >= M|yvondatum ; F|empty(M|yvondatum)) & (D|yftabdatum <= M|ybisdatum ; F|empty(M|ybisdatum)))
