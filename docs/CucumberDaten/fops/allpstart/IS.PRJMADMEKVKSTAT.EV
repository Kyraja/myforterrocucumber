.formula U|xtsel = U|xtsel + ";yekvk=="        + 'M|yekvk(L="0")'
.formula U|xtsel = U|xtsel + ";yauftrag=="     +  M|yvorgang^id
.formula U|xtsel = U|xtsel + ";yaupos=="       +  M|yvorpos^id
.formula U|xtsel = U|xtsel + ";@filingmode=(1);@ordnung=ybezugsdatum"
.load 9 group 'M|grliste' 'U|xtsel'
.continue EL007 ? _(G|mehr)
.copy    M|ytbspeichern      = G|TRUE
.copy    M|ytekvk            = 9|yekvk
