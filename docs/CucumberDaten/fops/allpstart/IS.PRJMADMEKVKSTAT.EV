.formula H|name         = "Auftrag: "    + M|yvorgang^nummer + ", Position: " + M|ytevpnum + ", Datum: " + 'G|DATUM'    ? 'M|ytekvk(L="0")' = "(86)"
.formula H|name         = "Bestellung: " + M|yvorgang^nummer + ", Position: " + M|ytevpnum + ", Datum: " + 'G|DATUM'    ? 'M|ytekvk(L="0")' = "(69)"
.copy    H|yprojekt     = M|ytprojekt
