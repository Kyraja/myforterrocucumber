.copy    M|ythe              = 9|yhe
.copy    M|ytfertleist       = 9|yfertleist
.copy    M|ytsonstkost       = 9|ysonstkost
.copy    M|ytfremdanteil     = 9|yfremdanteil
.copy    M|yteigenanteil     = 9|yeigenanteil
.copy    M|ytoffenwert       = 9|yoffenwert
.copy    M|ytbrutto          = 9|ybrutto
