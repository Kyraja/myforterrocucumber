..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtid
.type GD      xdatum
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- FA_yvondatum -----
.continue EL001 ? _(_(F|empty(M|yvorgang)))
.formula M|yvondatum  = M|yvorgang^vom      ? M|yvondatum < M|yvorgang^vom & _M|yvondatnpruef
.formula U|xdatum     = ('M|yvondatum:8')<<6 + "01"
.formula U|xdatum     = U|xdatum + 31
.formula U|xdatum     = ('U|xdatum:8')<<6 + "01"
.formula M|yvondatum  =  U|xdatum - 1
.formula M|ybisdatum  = M|yvondatum             ? M|ybisdatum < M|yvondatum & _F|empty(M|ybisdatum)
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- FA_ybisdatum -----
.continue EL002 ? _(_(F|empty(M|yprojekt)))
.formula M|ybisdatum  = M|yprojekt^yabldat      ? _F|empty(M|yprojekt) & _F|empty(M|yprojekt^yabldat) & M|ybisdatum > M|yprojekt^yabldat
.formula M|ybisdatum  = G|datum                 ?                                                       M|ybisdatum > G|datum
.formula U|xdatum     = ('M|ybisdatum:8')<<6 + "01"
.formula U|xdatum     = U|xdatum + 31
.formula U|xdatum     = ('U|xdatum:8')<<6 + "01"
.formula M|ybisdatum  =  U|xdatum - 1
.formula M|yvondatum  = M|ybisdatum             ? M|yvondatum > M|ybisdatum & _F|empty(M|yvondatum)
!EL002
.continue 'xprocst.xprocsp'
!PROC003: ----- Schreibschutz_Zeile -----
.continue EL003 ? _(_('M|yekvk(L="0")' = "(86)"))
.protection yteigenanteil     'M|aktzeile'
.protection ytfremdanteil     'M|aktzeile'
.protection ytsonstkost       'M|aktzeile'
.protection ytfertleist       'M|aktzeile'
.protection ytprjmpnullrechnu 'M|aktzeile'
!EL003
.continue EL004 ? _(_('M|yekvk(L="0")' = "(69)"))
.protection ytprjmppvorgang 'M|aktzeile'
.protection ytprjmparbpaket 'M|aktzeile'
!EL004
.continue 'xprocst.xprocsp'
!PROC004: ----- EK_VK -----
.continue BRK001 ? _('M|yekvk(L="0")' = "(86)")
.formula P|maskkontextfop = " VK "
.continue ESAC001
!BRK001
.continue BRK002 ? _('M|yekvk(L="0")' = "(69)")
.formula P|maskkontextfop = " EK "
.continue ESAC001
!BRK002
.formula P|maskkontextfop = ""
!ESAC001: =====   ENDCASE   =====
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK003 ? _(G|evtart = "maskein")
.assign M|yekvk = "(86)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC004
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtart = "buttonnach")
.continue BRK005 ? _(G|evtvar = "bstart")
.continue EL005 ? _((_(F|empty(M|yprojekt))) & (_(F|empty(M|yvorgang))) & (_(F|empty(M|yvorpos))))
.make screen line --O
.assign  U|xdatum = M|yvondatum
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="    + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";ybezugsdatum=" + 'M|yvondatum:8' + "!" + 'M|ybisdatum'   ? _F|empty(M|yvondatum) ; _F|empty(M|ybisdatum)
.formula U|xtsel = U|xtsel + ";yekvk=="       + 'M|yekvk(L="0")'                        ? _F|empty(M|yekvk)
.formula U|xtsel = U|xtsel + ";yauftrag=="    + M|yvorgang^id                           ? _F|empty(M|yvorgang)
.formula U|xtsel = U|xtsel + ";yaupos=="      + M|yvorpos^id                            ? _F|empty(M|yvorpos)
.formula U|xtsel = U|xtsel + ";@filingmode=(1);@ordnung=ybezugsdatum"
.select group 'M|grliste' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.assign U|xdatum = H|ybezugsdatum   ? F|empty(U|xdatum)
.continue EL006 ? _(_(U|xdatum >= H|ybezugsdatum))
!REPT001: ==============================
.make screen line +O
.copy    M|ytbezugsdatum     = U|xdatum
.copy    M|ytprojekt         = M|yprojekt
.formula M|ytprojname        = M|ytprojekt^namebspr
.formula U|xtsel = "$,,"
