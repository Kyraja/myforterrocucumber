.formula M|ytaupos           = 9|yaupos
.formula M|ytauftrag         = 9|yauftrag
.copy    M|ytabrechtyp       = 9|yabrechtyp
.copy    M|ytkuli            = 9|ykuli
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC003
!RET002
.formula xprocsp = xprocsp - 1
!EL007
.formula U|xdatum =   U|xdatum + 32
.formula U|xdatum = ('U|xdatum:8')<<6 + "01"
.formula U|xdatum =   U|xdatum - 1
.continue REPT001 ? _(U|xdatum = H|ybezugsdatum)
!EL006
.make screen line +O
