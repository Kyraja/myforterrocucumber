.type text    xtsys xtcmd xtsel xtftext xtpvorgang xtindex xtwoche
.type GD      xdadatum xdedatum xdawoche xdewoche xdatum xd1 xd2 xdabldat xdlm xderfass
.type GW4     xwoche xw1
