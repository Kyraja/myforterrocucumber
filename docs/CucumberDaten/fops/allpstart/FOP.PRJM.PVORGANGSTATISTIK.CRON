!PROC002: ----- PVs_laden_und_Statistikdatensatz_anlegen -----
.load 1 group 'U|xydbgrpvorgang' 'F|expr("$,,yprojekt==" + 0|id + ";@filingmode=(Active)")'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xtsel = "$,,ybezugsdatum==" + U|xdedatum:8 + ";ypvorgang==" + 1|id + ";ywochenbezogen==0;@filingmode=(Active)"
.select group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL003 ? _(_(G|mehr))
.formula U|xtcmd = "make " + G|hdatname.xydbpvstat + " GROUP" + 'U|xygrpvstat'
.'U|xtcmd'
.formula H|such         = 1|such
.formula H|name         = 1|name
.formula H|ypvorgang    = 1|id
.formula H|yprojekt     = 0|id
.formula H|ybezugsdatum = U|xdedatum
.rewrite
!EL003
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue EL004 ? _(0|ywochenbezogen)
.formula U|xtsel = "$,,ybezugsdatum==" + U|xdewoche:8 + ";ypvorgang==" + 1|id + ";ywochenbezogen==1;@filingmode=(Active)"
.select group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL005 ? _(_(G|mehr))
.formula U|xtcmd = "make " + G|hdatname.xydbpvstat + " GROUP" + 'U|xygrpvstat'
.'U|xtcmd'
.formula H|such           = 1|such
.formula H|name           = 1|name
.formula H|ypvorgang      = 1|id
.formula H|yprojekt       = 0|id
.formula H|ybezugsdatum   = U|xdewoche
.copy    H|ywochenbezogen = G|TRUE
.rewrite
!EL005
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL004
.load 1 continue
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC003: ----- Sammelvorgang_pruefen -----
.copy U|xbmehr = _F|empty(H|ygehoertzu)
!LOOP003: ==============================
.continue ELOP003 ? _(U|xbmehr)
.formula U|xtsel = "$,,ybezugsdatum==" + 'U|xd2' + ";ypvorgang==" + H|ygehoertzu^id + ";@filingmode=(Active)"
.load 1 group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL006 ? _(_(G|mehr))
.load 1 add H|ygehoertzu
.formula U|xtcmd = "make " + G|hdatname.xydbpvstat + " GROUP" + 'U|xygrpvstat'
.'U|xtcmd'
.formula H|such         = 1|such
.formula H|name         = 1|name
.formula H|ypvorgang    = 1|id
.formula H|yprojekt     = 1|yprojekt^id
.formula H|ybezugsdatum = U|xd2
.copy    H|ywochenbezogen = U|xbwochenbezogen
.rewrite
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.copy U|xbmehr = _F|empty(H|ygehoertzu)
.continue FI006
!EL006
.select add 1|ygehoertzu
.continue EL007 ? _(G|mehr)
.copy U|xbmehr = _F|empty(H|ygehoertzu)
.continue FI007
!EL007
.copy U|xbmehr = G|FALSE
!FI007
!FI006
.continue LOOP003
!ELOP003: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula U|xdzeitpunk = G|zeitpunkt
.formula U|xversionn  = G|versionneu
.formula U|xdvon    = "<M-1M"
.formula U|xdadatum = U|xdvon
.formula U|xdbis    = ">M"
.formula U|xdedatum = U|xdbis
.formula U|xdawoche = G|datum - G|datum//7 + 1
.formula U|xdewoche = U|xdawoche + 6
.formula U|xwoche   = U|xdewoche
.file -TEMPNAME U|xtftext
.type text xtprojekt    ? _F|defined(U|xtprojekt)
.continue EL008 ? _(_(F|empty(U|xtprojekt)))
.load 0 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue EL009 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC002
!RET004
.formula xprocsp = xprocsp - 1
!EL009
.continue FI008
!EL008
.select lock add F|sysinfo(10)^ykonfigprjm
.continue EL010 ? _(G|mehr)
.assign U|xdpmllaufpvstat = H|ypmllaufpvstat
.assign U|xdlastrun       = H|ypmllaufpvstat
.assign U|xvnllaufpvstat  = H|yvnllaufpvstat
.set trans +
