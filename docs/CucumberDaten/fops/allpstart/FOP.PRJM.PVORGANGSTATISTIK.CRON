.continue LOOP005
!ELOP005: ==============================
.copy U|xbwochenbezogen = G|FALSE
.formula U|xtpvorgang = ""
.assign  U|xdatum     = ""
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";versionn>=" + 'U|xvnllaufpvstat'
.formula U|xtsel = U|xtsel + ";yadatum<"  + 'G|datum:8'<<6 + "01"
.formula U|xtsel = U|xtsel + ";ypvorgang<>`"
.formula U|xtsel = U|xtsel + ";@ordnung=ypvorgang,yadatum;@ablageart=(3)"
.load 9 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.continue EL011 ? _(('9|yadatum:8'<<6 <> 'U|xdatum:8'<<6) ; (9|ypvorgang^id <> U|xtpvorgang))
.assign  U|xd1 = '9|yadatum:8'<<6  +"01"
!REPT001: ==============================
.formula U|xriststd       = 0
.formula U|xrfaktstd      = 0
.formula U|xrmaschstd     = 0
.formula U|xrkorriststd   = 0
.formula U|xrkorrfaktstd  = 0
.formula U|xrkorrmaschstd = 0
.assign  U|xd2 = U|xd1 + 31
.assign  U|xd2 ='U|xd2:8'<<6 + "01"
.assign  U|xd2 = U|xd2 - 1
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypvorgang==" + 9|ypvorgang^id
.formula U|xtsel = U|xtsel + ";yadatum<="   + U|xd2:8
.formula U|xtsel = U|xtsel + ""
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 8 group 'U|xydbgrlnachweis' 'U|xtsel'
!LOOP007: ==============================
.continue ELOP007 ? _(G|mehr)
.formula U|xderfass       = 8|erfass
.formula U|xriststd       = U|xriststd       + 8|yarbzeit
.formula U|xrfaktstd      = U|xrfaktstd      + 8|yfaktzeit
.formula U|xrmaschstd     = U|xrmaschstd     + 8|ymaschzeit
.formula U|xrkorriststd   = U|xrkorriststd   + 8|yarbzeit       ? U|xderfass > U|xd2
.formula U|xrkorrfaktstd  = U|xrkorrfaktstd  + 8|yfaktzeit      ? U|xderfass > U|xd2
.formula U|xrkorrmaschstd = U|xrkorrmaschstd + 8|ymaschzeit     ? U|xderfass > U|xd2
.load 8 continue
.continue LOOP007
!ELOP007: ==============================
.load 1 add 9|ypvorgang
.continue EL012 ? _(G|mehr)
.formula U|xtindex = "N" + 9|nummer + "D" + 'U|xd2:8'
.type text xtpvkorr.xtindex     ? _F|defined(U|xtpvkorr.xtindex)
.formula U|xtsel = "$,,ybezugsdatum==" + U|xd2:8 + ";ypvorgang==" + 9|ypvorgang^id + ";ywochenbezogen==0;@filingmode=(Active)"
.select group 'U|xydbgrpvstat' 'U|xtsel'
.continue EL013 ? _(_(G|mehr))
.formula U|xtcmd = "make " + G|hdatname.xydbpvstat + " GROUP" + 'U|xygrpvstat'
.'U|xtcmd'
.formula H|such         = 1|such
.formula H|name         = 1|name
.formula H|ypvorgang    = 1|id
.formula H|yprojekt     = 1|yprojekt^id
.formula H|ybezugsdatum = U|xd2
.rewrite
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC001
!RET007
.formula xprocsp = xprocsp - 1
.select lock add H|id
.continue EL014 ? _(G|mehr)
.formula H|ypvsollstd      = 0
.formula H|ypvplanstd      = 0
.formula H|ypviststd       = U|xriststd
.formula H|ypvfaktstd      = U|xrfaktstd
.formula H|ypvmaschstd     = U|xrmaschstd
.formula H|ykorrpviststd   = U|xrkorriststd
.formula H|ykorrpvfaktstd  = U|xrkorrfaktstd
.formula H|ykorrpvmaschstd = U|xrkorrmaschstd
