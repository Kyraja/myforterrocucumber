.assign  U|xd1 = 'U|xd1:8'<<6 + "01"
.continue REPT001 ? _(('U|xd1:8'<<6 = 'G|datum:8'<<6) ; (U|xd1 >= G|datum) ; ((9|yprojekt^yablage) & (9|yprojekt^yabldat < U|xdadatum)))
.formula U|xtpvorgang = 9|ypvorgang^id
.assign  U|xdatum     = 9|yadatum
!EL011
.load 9 continue
