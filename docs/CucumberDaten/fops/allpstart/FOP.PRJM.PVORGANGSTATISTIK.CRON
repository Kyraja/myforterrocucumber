.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtsel = "$,,yablage==1;yabldat=" + U|xdadatum:8 + "!" + U|xdedatum:8 + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrprojekt' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
