..
..Namen fÅllen
.formula U|xivar = 1
!SEKFNAME:
.continue SEEND         ? _F|defined(M|ykzvk.xivar)
.assign M|ykzgesvkname.xivar = M|ykzgesvk.xivar^namebspr<<";"
.assign M|ykzgesekname.xivar = M|ykzgesek.xivar^namebspr<<";"
.assign M|ykzgesprname.xivar = M|ykzgespr.xivar^namebspr<<";"
.assign M|ykzgestpname.xivar = M|ykzgestp.xivar^namebspr<<";"
.assign M|ykzgeselname.xivar = M|ykzgesel.xivar^namebspr<<";"
.assign M|ykzgesflname.xivar = M|ykzgesfl.xivar^namebspr<<";"
.assign M|ykzgesskname.xivar = M|ykzgessk.xivar^namebspr<<";"
.assign M|ykzgesfename.xivar = M|ykzgesfe.xivar^namebspr<<";"
..
.assign M|ykzvkname.xivar    = M|ykzvk.xivar^namebspr<<";"
.assign M|ykzekname.xivar    = M|ykzek.xivar^namebspr<<";"
.assign M|ykzprname.xivar    = M|ykzpr.xivar^namebspr<<";"
.assign M|ykztpname.xivar    = M|ykztp.xivar^namebspr<<";"
