..
!BSTART:
.formula U|xtmarke = ""
.continue KEYFIGTOT
.continue END
..
..***************************************************************
..
!UEBERNEHMEN:
.formula U|xtmarke = ""
.continue KEYFIGROW
.continue END
..
..***************************************************************
..
!PROJSTAT:
.formula U|xtmarke = ""
.continue PSTATZEILE    ?  M|aktzeile > 0
.continue KEYFIGTOT
.continue END
..
!PSTATZEILE:
.continue END           ? _M|yueb = "icon:media_play_green"
.continue KEYFIGROW
.continue END
..
..***************************************************************
..
!BUKENNZDET:Button Details
.continue BUKZDETEND    ?  F|empty(M|yprojzsuch)
.continue BUKZDETEND    ?  F|regmatch(G|evtvar, "^ybukzvk.*") & _F|sysinfo(18)^allpstd
.continue BUKZDETEND    ?  F|regmatch(G|evtvar, "^ybukzges.*")
..  .continue BUKZDETEND    ?  G|evtvar<<7 = "ybukzvk" & _F|sysinfo(18)^allpstd
..  .continue BUKZDETEND    ?  G|evtvar<<8 = "ybukzges"
..
.formula U|xivar = G|evtvar<<-7
.formula U|xtvar = "ykz" + (G|evtvar<<-5)<<2 + F|tostring(U|xivar)
..
.formula U|xtcmd = "(Infosystem) PRJMKENNZDETAIL ? ykennzahl=" + M|.xtvar^id
.formula U|xtcmd = U|xtcmd + "|yprojekt="     + M|yprojzsuch^id
.formula U|xtcmd = U|xtcmd + "|ychtitel="     + M|.xtvar^namebspr
.formula U|xtcmd = U|xtcmd + "|yvarwertvoka="
.formula U|xtcmd = U|xtcmd + "|yvarwertfc="
.formula U|xtcmd = U|xtcmd + "|yvarwertzus1="
.formula U|xtcmd = U|xtcmd + "|yvarwertzus2="
.formula U|xtcmd = U|xtcmd + "|ybnosel=1"
..
.formula U|xtcmd = U|xtcmd + "|bstart=1"
.command -parallel 'U|xtcmd'
..
!BUKZDETEND:
.continue END
..
..***************************************************************
..***************************************************************
..***************************************************************
..
!KEYFIGROW: ----- Kennzahlen_Zeile -----
.continue EKFRLOAD                                                          ?  F|empty(M|yprojzsuch)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "KZTP4", "")  ? _F|empty(M|yprojzsuch^yteilprojektzu)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "KZTP5", "")  ? _F|empty(M|yprojzsuch^yteilprojektzu)
.formula P|maskkontextfop = P|maskkontextfop + " KZTP4 "                    ?  F|empty(M|yprojzsuch^yteilprojektzu) & _F|regmatch(P|maskkontextfop, F|expr(".* KZTP4 .*"),G|true)
.formula P|maskkontextfop = P|maskkontextfop + " KZTP5 "                    ?  F|empty(M|yprojzsuch^yteilprojektzu) & _F|regmatch(P|maskkontextfop, F|expr(".* KZTP5 .*"),G|true)
..Hauptprojekt
.assign M|ykztp1  = "0PS200029"   ?  F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp2  = "0PS200030"   ?  F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp3  = "0PS200032"   ?  F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp4  = "0PS200033"   ?  F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp5  = "0PS200034"   ?  F|empty(M|yprojzsuch^yteilprojektzu)
..Teilprojekt
.assign M|ykztp1  = "0PS200035"   ? _F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp2  = "0PS200040"   ? _F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp3  = "0PS200045"   ? _F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp4  = ""            ? _F|empty(M|yprojzsuch^yteilprojektzu)
.assign M|ykztp5  = ""            ? _F|empty(M|yprojzsuch^yteilprojektzu)
..
.assign M|ykztpname1 = M|ykztp1^namebspr<<";"
.assign M|ykztpname2 = M|ykztp2^namebspr<<";"
.assign M|ykztpname3 = M|ykztp3^namebspr<<";"
.assign M|ykztpname4 = M|ykztp4^namebspr<<";"
.assign M|ykztpname5 = M|ykztp5^namebspr<<";"
..
.formula U|xtproject = M|yprojzsuch^id
.formula U|xivar     = 1
!KFRLOAD:
.continue EKFRLOAD      ? _F|defined(M|ykzvk.xivar)
..
.formula U|xtkeyfigure = M|ykzvk.xivar^id               ? _F|empty(M|ykzvk.xivar)
.formula U|xtvar       = "ykzvkwert" + 'U|xivar'        ? _F|empty(M|ykzvk.xivar)
.input allpstart/FOP.PS.SEL.KEYFIGURES                  ? _F|empty(M|ykzvk.xivar)
