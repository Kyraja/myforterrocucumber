.assign M|ykzgesvk2  = "0PS200014"
.assign M|ykzgesvk3  = "0PS200020"
.assign M|ykzgesvk4  = "0PS200025"
.assign M|ykzgesvk5  = "0PS200026"
.assign M|ykzgesvk6  = "0PS200004"
.assign M|ykzgesvk7  = "0PS200006"
