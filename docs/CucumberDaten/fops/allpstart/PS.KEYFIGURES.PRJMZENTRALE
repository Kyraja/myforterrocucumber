.type text    xtkeyfigure       ? _F|defined(U|xtkeyfigure)
.type text    xtproject         ? _F|defined(U|xtproject)
.type text    xtvar             ? _F|defined(U|xtvar)
.type text    xtmarke           ? _F|defined(U|xtmarke)
.type text    xtkennzahl        ? _F|defined(U|xtkennzahl)
.type text    xtcmd             ? _F|defined(U|xtcmd)
.type real    xrvalue           ? _F|defined(U|xrvalue)
.type integer xivar             ? _F|defined(U|xivar)
..
.continue PRJMKENNZLISTE  ?  G|evtart = "buttonnach" & G|evtvar    = "ybukzprjmzentrale"
.continue SCENTER         ?  G|evtart = "maskein"
.continue BSTART          ?  G|evtart = "buttonnach" & G|evtvar    = "bstart"
.continue UEBERNEHMEN     ?  G|evtart = "buttonnach" & G|evtvar    = "ybuprojakt"
.continue UEBERNEHMEN     ?  G|evtart = "buttonnach" & G|evtvar    = "yueb"
.continue PROJSTAT        ?  G|evtart = "buttonnach" & G|evtvar    = "yprojstat"
.continue BUKENNZDET      ?  G|evtart = "buttonnach" & F|regmatch(G|evtvar, "^ybukz.*")
.continue END
..
..
!SCENTER:Maskeneintritt
..Kennzahlen in Maske eintragen
..Kennzahlen Gesamt
.formula P|maskkontextfop = P|maskkontextfop + " KZGES "        ? _F|regmatch(P|maskkontextfop, F|expr(".* KZGES .*"),G|true)
..
.continue SEKZGESALL    ? _F|sysinfo(18)^allpstd
.formula P|maskkontextfop = P|maskkontextfop + " KZGESVK "      ? _F|regmatch(P|maskkontextfop, F|expr(".* KZGESVK .*"),G|true)
.formula P|maskkontextfop = P|maskkontextfop + " KZGESVK1 "     ? _F|regmatch(P|maskkontextfop, F|expr(".* KZGESVK1 .*"),G|true)
