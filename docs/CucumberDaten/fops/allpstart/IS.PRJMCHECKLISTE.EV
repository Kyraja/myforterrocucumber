..!interpreter english declaration noabbrev
.. at 2017-06-21, 09:05
.set trans -
..========================================================================
..==  Name              : IS.PRJMCHECKLISTE.EV
..==  Pfad              : allpstart
..==  Funktion          : Funktionen am Infosystem PRJMCHECKLISTE
..==  Erstellungsdatum  : 09.11.2009
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/CL.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtstatus xtmenue xttmp xtvorlage xttmpverw xtnummer
.type text    xtext xtedpdat xtedpmsg xtedpout xtedperr xtsuch xtname xttitel xttext
.type text    xtaufgabe xtpvorgang
.type integer xistufe xizeile xi1 xiaktzeile ximerkzeile
.type integer xyvdn xyvgr
.type bool    xbmehr xbsperre xbschreib xbok xbistzeit
.type integer   xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Chekliste_Zeilen -----
.load 0 line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.make screen line +O
.formula M|tbaumstufe = 1
.assign M|ysperre      = U|xbsperre
.assign M|ynummer      = 0|id
.assign M|ytbeschr     = 0|ytbeschr
.assign M|ytablage     = 0|ytablage           ?  F|defined(0|ytablage)
.assign M|ytverweis    = 0|ytverweisid
.assign M|ytdokument   = 0|ytdokument^id
.assign M|ytsdokdatei  = M|ytdokument^datei   ? _F|empty(M|ytdokument)
.assign M|ytresvp = 0|ytresvp^id
.assign M|ytrest  = 0|ytrest
.assign M|ytresr  = 0|ytresr
.assign M|ytresi  = 0|ytresi
.assign M|ytresb  = 0|ytresb
.assign M|ytresd  = 0|ytresd
.assign M|ytresz  = 0|ytresz
.assign M|ytresgp = 0|ytresgp
.formula M|yfarbe = U|xyfarbeclchecklz  ? _M|ybvorproj
.formula M|yfarbe = U|xyfarbeclvorlagez ?  M|ybvorproj
.continue EL001 ? _(_(F|empty(0|ytftext)))
.select from '0|ytftext'
.formula M|ytftext    = 0|ytftext
.formula M|ytftextdat = M|ytftext
!EL001
.continue EL002 ? _(M|ysperre)
.protection -exception ybubaumaufzu 'M|aktzeile'
.protection -line 'M|aktzeile'
.continue FI002
!EL002
.protection yname    'M|aktzeile'
.protection ytstatus 'M|aktzeile'
.protection ytma     'M|aktzeile'
!FI002
.load 0 line
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!PROC002: ----- Laden -----
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.make screen line +O           ? _G|evtart = "zeileeinnach"
.formula M|tbaumstufe = 0
.copy   M|ysperre      = 0|ysperre
.continue EL003 ? _(F|defined(0|ystatusk))
.copy   M|ysperre      = G|true                 ? 0|ystatusk = "ABS"
.copy   M|ytstatusk    = 0|ystatusk
.copy   M|ytablage     = G|true                 ? 0|ystatusk = "ABS"
!EL003
.assign M|ynummer      = 0|id
.assign M|yname        = 0|namebspr
.copy   M|ytquelle     = 0|yquelle              ? F|defined(0|yquelle)
.copy   M|ytquelle     = 0|yvtquelle            ? F|defined(0|yvtquelle)
.copy   M|ytvorlage    = 0|yvorlage             ? F|defined(0|yvorlage)
.assign M|ytobjekt     = 0|yobjektid            ? F|defined(0|yobjektid)
.copy   M|ytaktiv      = 0|yaktiv
.assign M|yterfass     = 0|erfass
.assign M|ytzeich      = 0|yzeich
.copy   M|ytma         = 0|yma
.formula M|ybubaumaufzu = "icon:folder_opened"           ?  0|ozeilen > 0
.formula M|ybubaumaufzu = "icon:folder_closed"           ?  0|ozeilen = 0
.formula M|ybusichern   = "icon:ball_green"
.formula M|yfarbe = U|xyfarbeclvorlagek  ? 0|gruppe = U|xygrclvorlage
.formula M|yfarbe = U|xyfarbeclchecklk   ? 0|gruppe = U|xygrclcheckl
.continue EL004 ? _(_(F|empty(0|yftext)))
.select from '0|yftext'
.formula M|ytftext    = 0|yftext
.formula M|ytftextdat = M|ytftext
!EL004
.continue EL005 ? _(M|ysperre)
.formula U|xbsperre = M|ysperre
.protection -exception ybubaumaufzu 'M|aktzeile'
.protection -line 'M|aktzeile'
.continue FI005
!EL005
.protection ytbeschr   'M|aktzeile'
.protection ytverweis  'M|aktzeile'
.protection ytdokument 'M|aktzeile'
.protection ytresvp 'M|aktzeile'
.protection ytrest  'M|aktzeile'
.protection ytresr  'M|aktzeile'
.protection ytresi  'M|aktzeile'
.protection ytresb  'M|aktzeile'
.protection ytresd  'M|aktzeile'
.protection ytresz  'M|aktzeile'
.protection ytresgp 'M|aktzeile'
.protection ytstatus 'M|aktzeile'   ? _F|defined(0|ystatus)
.select lock add 0|id
.continue EL006 ? _(G|mehr)
.copy    H|ysperre     = G|true
.formula H|ysperrzeich = G|bzeichen
.formula H|ysperrzp    = G|zeitpunkt
.rewrite
.select -
.copy M|ysperre  = G|false
.copy U|xbsperre = G|false
.continue FI006
!EL006
.protection -exception ybubaumaufzu 'M|aktzeile'
.protection -line 'M|aktzeile'
.copy M|ysperre  = G|true
.copy U|xbsperre = G|true
!FI006
!FI005
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.load 0 continue
.continue LOOP002
!ELOP002: ==============================
.continue 'xprocst.xprocsp'
!PROC003: ----- Zeile_geandert -----
.continue EL007 ? _(_(M|tbaumstufe = 0))
.continue EL008 ? _(M|aktzeile > 1)
.formula U|xizeile = M|aktzeile
!REPT001: ==============================
.formula U|xizeile = U|xizeile - 1
.select screen line 'U|xizeile'
.continue REPT001 ? _(M|tbaumstufe = 0)
!EL008
!EL007
.copy    M|ybaenderung = G|true
.formula M|yaendicon   = "icon:ball_red"
.copy    M|ybsichern   = G|true
.formula M|ybusichern  = "icon:ball_red"
.continue 'xprocst.xprocsp'
!PROC004: ----- Farbe -----
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.colour -background 'M|yfarbe' 'M|aktzeile'             ? _F|empty(M|yfarbe)
.colour -background "-1 -1 -1" 'M|aktzeile'             ?  F|empty(M|yfarbe)
.select screen line
.continue LOOP003
!ELOP003: ==============================
.continue 'xprocst.xprocsp'
!PROC005: ----- PSVorgangAktualisieren -----
.continue EL009 ? _(_(F|empty(M|ytobjekt)))
.load 0 add M|ytobjekt
.continue EL010 ? _(G|mehr)
.continue EL011 ? _(F|defined(0|yclclvorhanden))
.copy    U|xbmehr   = G|false
.formula U|xtstatus = "ABS"     ? _M|ybvorproj
.formula U|xtstatus = ""        ?  M|ybvorproj
.formula U|xtsel = "$,,yobjektid==" + M|ytobjekt^id
.formula U|xtsel = U|xtsel + ";id<>" + M|ynummer^id     ? G|evtart = "zeileloevor"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group "142:3" 'U|xtsel'                         ? _M|ybvorproj
.load 9 group "150:17" 'U|xtsel'                        ?  M|ybvorproj
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.copy    U|xbmehr   = G|true
.continue EL012 ? _(F|defined(9|ystatusk))
.formula U|xtstatus = ""        ? _9|ystatusk = "ABS" & 9|id <> M|ynummer^id
!EL012
.load 9 continue
.continue LOOP004
!ELOP004: ==============================
.formula U|xtstatus = ""    ? _M|ytstatusk = "ABS" & _G|evtart = "zeileloevor"
.continue EL013 ? _((((_(U|xbmehr )) & (_(0|yclclvorhanden = "icon:text_empty"))) ; ((U|xbmehr ) & ((F|empty(0|yclclvorhanden)) ; (0|yclclvorhanden = "icon:text_empty")))) ; ((U|xtstatus = "ABS") & (0|yclclvorhanden = "icon:preferences")) ; ((_(U|xtstatus = "ABS")) & (0|yclclvorhanden = "icon:preferences_disabled")))
.select lock nowait add 0|id
.continue EL014 ? _(G|mehr)
.continue EL015 ? _(G|gesperrt)
.formula H|yclclvorhanden = "icon:preferences"          ? _U|xtstatus = "ABS"
.formula H|yclclvorhanden = "icon:preferences_disabled" ?  U|xtstatus = "ABS"
.formula H|yclclvorhanden = "icon:text_empty"           ? _U|xbmehr
.rewrite
.select -
.continue EL016 ? _((0|dnr    = U|xydbaufgabe) & (0|gruppe = U|xygraufgabe))
.formula U|xbistzeit  = G|false
.formula U|xtaufgabe  = ""
.formula U|xtaufgabe  = 0|id
.formula U|xtpvorgang = ""
.input "allpstart/FOP.PRJM.UP.SVORGANG.AKT"
!EL016
.continue FI015
!EL015
.set trans +
.formula U|xttitel = "Fehler"

.formula U|xttext =
.formula U|xttext = F|formatstr("Das Projekt {1}", 0|such)          ? 0|dnr = U|xydbprojekt  & 0|gruppe = U|xygrprojekt
.formula U|xttext = F|formatstr("Der Projektvorgang {1}", 0|nummer) ? 0|dnr = U|xydbpvorgang & 0|gruppe = U|xygrpvorgang
.formula U|xttext = F|formatstr("Die Aufgabe {1}", 0|nummer)        ? 0|dnr = U|xydbaufgabe  & 0|gruppe = U|xygraufgabe

.formula U|xttext = U|xttext +" kann nicht bearbeitet werden."
.box 'U|xttitel'
'U|xttext'

'G|sperrtext                                                                   '

Die Žnderung kann nicht gespeichert werden.
.set trans -
.copy U|xbok = G|false
!FI015
.continue FI014
!EL014
.set trans +
.formula U|xttitel = "Fehler"

.formula U|xttext =
.formula U|xttext = F|formatstr("Das Projekt {1}", 0|such)          ? 0|dnr = U|xydbprojekt  & 0|gruppe = U|xygrprojekt
.formula U|xttext = F|formatstr("Der Projektvorgang {1}", 0|nummer) ? 0|dnr = U|xydbpvorgang & 0|gruppe = U|xygrpvorgang
.formula U|xttext = F|formatstr("Die Aufgabe {1}", 0|nummer)        ? 0|dnr = U|xydbaufgabe  & 0|gruppe = U|xygraufgabe

.formula U|xttext = U|xttext +" kann nicht bearbeitet werden."
.box 'U|xttitel'
'U|xttext'
Die Žnderung kann nicht gespeichert werden.
.set trans -
.copy U|xbok = G|false
!FI014
!EL013
!EL011
.load 0
!EL010
!EL009
.continue 'xprocst.xprocsp'
!PROC006: ----- Checkliste_anlegen -----
.continue EL017 ? _(G|evtart = "zeileeinnach")
.select screen line 'M|tzeilen'   ?  G|evtzeile = 0
.select screen line 'G|evtzeile'  ? _G|evtzeile = 0 & M|tzeilen > 0
.continue FI017
!EL017
.make screen line +O
!FI017
.copy    M|ytobjekt = M|yobjekt
.formula M|yname    = M|yobjekt^namebspr
.copy    M|ytma     = G|passw^mitarb
.copy    M|ytzeich  = G|bzeichen
.assign  M|yterfass = G|zeitpunkt
.copy    M|ysperre  = G|false
.formula M|tbaumstufe   = 0
.formula M|ybubaumaufzu = "icon:folder_closed"
.copy    M|ybaenderung = G|true
.formula M|yaendicon   = "icon:ball_red"
.copy    M|ybsichern   = G|true
.formula M|ybusichern  = "icon:ball_red"
.formula M|yfarbe = U|xyfarbeclchecklk          ? _M|ybvorproj
.formula M|yfarbe = U|xyfarbeclvorlagek         ?  M|ybvorproj
.colour -background 'M|yfarbe' 'M|aktzeile'     ? _F|empty(M|yfarbe)
.continue 'xprocst.xprocsp'
!PROC007: ----- ChecklisteAusVorlage -----
.copy U|xbmehr = G|false
.file -TEMPNAME U|xtmenue
.output NEW 'U|xtmenue'
.input DATEI.F
'G|kommandochar''G|kommandochar''G|markechar'interpreter english
'G|markechar'MENUE
.set trans +
'G|kommandochar'menu(0,0,0)Checkliste aus Vorlage erstellen
.set trans -
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + "yvtquelle==" + M|yquelle^id       ? _F|empty(M|yquelle)
.formula U|xtsel = U|xtsel + ";yaktiv=1"
.select group "150:17" 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xtsuch = F|regreplaceall(H|such, G|apostroph, " ")
.formula U|xtname = F|regreplaceall(H|namebspr, G|apostroph, " ")
?-                -                             ? _U|xbmehr
?Vorlagen                 >>.continue MENUE     ? _U|xbmehr
.copy U|xbmehr = G|true
'U|xtsuch     '  'U|xtname' >>.formula U|xtvorlage = "'H|id'"
.select continue
.continue LOOP005
!ELOP005: ==============================
.continue EL018 ? _(U|xbmehr)
'G|kommandochar''G|kommandochar'
'G|kommandochar'continue
.input 'U|xtmenue'
.error
.select screen line 'G|evtzeile'        ? G|menue = 0 & G|evtart = "zeileeinnach"
.make screen line -                     ? G|menue = 0 & G|evtart = "zeileeinnach"
.end 1                                  ? G|menue = 0
.formula U|xttmpverw = G|sekundenz + G|pid
.select screen line 'M|tzeilen'   ?  G|evtzeile = 0
.select screen line 'G|evtzeile'  ? _G|evtzeile = 0 & M|tzeilen > 0
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC006
!RET002
.formula xprocsp = xprocsp - 1
.continue EL019 ? _(_(F|empty(U|xtvorlage)))
.load 0 object 'U|xtvorlage'
.continue EL020 ? _(G|mehr)
.assign M|yname        = 0|namebspr
.assign M|ytvorlage    = 0|id
.assign M|ytobjekt     = M|yobjekt
.copy   M|ytaktiv      = 0|yaktiv
.copy   M|ytma         = 0|yma
.formula M|ybubaumaufzu = "icon:folder_opened"           ?  0|ozeilen > 0
.formula M|ybubaumaufzu = "icon:folder_closed"           ?  0|ozeilen = 0
.continue EL021 ? _(_(F|empty(0|yftext)))
.select from '0|yftext'
.formula M|ytftext    = 0|yftext
.formula M|ytftextdat = M|ytftext
!EL021
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue FI020
!EL020
.set trans +
.formula U|xttitel = "Fehler"
.box 'U|xttitel'
Die Vorlage konnte nicht gelesen werden.
.set trans -
.error
.end 1
!FI020
!EL019
.continue FI018
!EL018
.set trans +
.formula U|xttitel = "Hinweis"
.box 'U|xttitel'
Es sind keine Vorlagen angelegt.
.set trans -
.error
.end 1
!FI018
.continue 'xprocst.xprocsp'
!PROC008: ----- Sperre_entfernen -----
.select screen header
.select screen line
!LOOP006: ==============================
.continue ELOP006 ? _(G|mehr)
.continue EL022 ? _((_(M|ysperre)) & (M|tbaumstufe = 0))
.continue EL023 ? _(M|ynummer^ysperre)
.select lock add M|ynummer
.continue EL024 ? _(G|mehr)
.formula H|ysperre = G|false
.rewrite
.continue FI024
!EL024
.set trans +
.box Hinweis
Der Datensatz 'M|ynummer'/'M|ynummer^such' konnte nicht freigegeben werden.
Bitte Sperre manuell entfernen.
.set trans -
!FI024
!EL023
!EL022
.select screen line
.continue LOOP006
!ELOP006: ==============================
.continue 'xprocst.xprocsp'
!PROC009: ----- Speichern -----
.continue EL025 ? _((_(F|empty(M|ytobjekt))) ; (_(F|empty(M|ynummer))))
.copy U|xbok = G|true
.continue EL026 ? _(U|xbok)
.continue EL027 ? _(F|empty(M|ynummer))
.make ProjectSuiteMasterData GROUP17        ?  M|ybvorproj
.make ProjectSuiteTransactionData GROUP3    ? _M|ybvorproj
.copy    H|yvtquelle = M|yquelle            ?  F|defined(H|yvtquelle)
.formula H|such      = M|ytobjekt^such
.formula H|yobjektid = M|ytobjekt^id
.formula H|yzeich    = M|ytzeich
.assign  H|erfass    = M|yterfass
.rewrite
.assign M|ynummer = H|id
!EL027
.select lock add M|ynummer
.continue EL028 ? _(G|mehr)
.formula U|ximerkzeile = M|aktzeile
.assign H|name     = M|yname
.copy   H|yma      = M|ytma
.continue EL029 ? _(F|defined(H|ystatusk))
.copy   H|ystatusk  = M|ytstatusk
.assign H|ystatusk  = "(_01)"       ?  F|empty(H|ystatusk)
.copy   M|ytstatusk = H|ystatusk
!EL029
.continue EL030 ? _((_(G|evtart = "maskabbr")) & (_(F|empty(M|ytftext))))
.select from 'M|ytftext'
.formula H|yftext = M|ytftext
!EL030
.continue EL031 ? _(M|tbaumstat = "-")
.make line --
.select screen line
.copy U|xbmehr = G|mehr
!LOOP007: ==============================
.continue ELOP007 ? _(U|xbmehr)
.continue EL032 ? _(M|tbaumstufe = 0)
.copy U|xbmehr = G|false
.continue FI032
!EL032
.make line +
.assign H|ytbeschr    = M|ytbeschr
.assign H|ytverweisid = M|ytverweis^id
.copy   H|ytdokument  = M|ytdokument
.copy   H|ytablage    = M|ytablage      ?  F|defined(H|ytablage)
.assign H|ytresvp = M|ytresvp^id
.assign H|ytrest  = M|ytrest
.assign H|ytresr  = M|ytresr
.assign H|ytresi  = M|ytresi
.assign H|ytresb  = M|ytresb
.assign H|ytresd  = M|ytresd
.assign H|ytresz  = M|ytresz
.assign H|ytresgp = M|ytresgp
.continue EL033 ? _(_(G|evtart = "maskabbr"))
.continue EL034 ? _(_(F|empty(M|ytftext)))
.select from 'M|ytftext'
.formula H|ytftext = M|ytftext
!EL034
!EL033
.select screen line
.copy U|xbmehr = G|mehr
!FI032
.continue LOOP007
!ELOP007: ==============================
.continue FI031
!EL031
.select screen line
!FI031
.rewrite
.continue EL035 ? _(F|defined(H|yclclvorhanden))
.continue EL036 ? _(true)
.continue FI036
!EL036
.formula U|xtsel = "$,,yobjektid==" + H|id + ";@filingmode=(Active)"
.load 9 group "142:3" 'U|xtsel'                         ? _M|ybvorproj
.load 9 group "150:17" 'U|xtsel'                        ?  M|ybvorproj
!LOOP008: ==============================
.continue ELOP008 ? _(G|mehr)
.copy    U|xbmehr   = G|true
.continue EL037 ? _(F|defined(9|ystatusk))
.formula U|xtstatus = ""        ? _9|ystatusk = "ABS"
!EL037
.load 9 continue
.continue LOOP008
!ELOP008: ==============================
.formula U|xtstatus = ""    ? _M|ystatusk = "ABS"
.continue EL038 ? _(((_(U|xbmehr)) & (_(0|yclclvorhanden = "icon:text_empty"))) ; ((U|xbmehr) & ((F|empty(0|yclclvorhanden)) ; (0|yclclvorhanden = "icon:text_empty"))) ; ((U|xbmehr) & (U|xtstatus = "ABS") & (0|yclclvorhanden = "icon:preferences")) ; ((U|xbmehr) & (_(U|xtstatus = "ABS")) & (0|yclclvorhanden = "icon:preferences_disabled")))
.formula H|yclclvorhanden = "icon:preferences"          ? _U|xtstatus = "ABS"
.formula H|yclclvorhanden = "icon:preferences_disabled" ?  U|xtstatus = "ABS"
.formula H|yclclvorhanden = "icon:text_empty"           ? _U|xbmehr
.rewrite
.select -
.continue EL039 ? _((0|dnr    = U|xydbaufgabe) & (0|gruppe = U|xygraufgabe))
.formula U|xbistzeit  = G|false
.formula U|xtaufgabe  = ""
.formula U|xtaufgabe  = 0|id
.formula U|xtpvorgang = ""
.input "allpstart/FOP.PRJM.UP.SVORGANG.AKT"
!EL039
!EL038
!FI036
!EL035
.formula U|xiaktzeile = M|aktzeile
.select screen line 'U|ximerkzeile'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC005
!RET004
.formula xprocsp = xprocsp - 1
.continue EL040 ? _(G|evtvar = "ybuspeichern")
.formula M|ybusichern = "icon:ball_green"
.copy    M|ybsichern  = G|false
.continue EL041 ? _(M|ytstatusk = "ABS")
.protection -exception ybubaumaufzu 'M|aktzeile'
.protection -line 'M|aktzeile'
.continue EL042 ? _(_(M|ysperre))
.select lock add M|ynummer
.continue EL043 ? _(G|mehr)
.copy H|ysperre = G|false
.rewrite
.copy M|ysperre  = G|false
.copy U|xbsperre = G|false
.continue FI043
!EL043
.copy U|xbsperre = G|true
!FI043
!EL042
.select screen line
.copy U|xbmehr = G|mehr
!LOOP009: ==============================
.continue ELOP009 ? _(U|xbmehr)
.continue EL044 ? _(M|tbaumstufe = 0)
.copy U|xbmehr = G|false
.continue FI044
!EL044
.protection -exception ybubaumaufzu 'M|aktzeile'
.protection -line 'M|aktzeile'
.copy M|ysperre = U|xbsperre
.select screen line
.copy U|xbmehr = G|mehr
!FI044
.continue LOOP009
!ELOP009: ==============================
!EL041
!EL040
.select screen line 'U|xiaktzeile'
.continue FI028
!EL028
.copy U|xbschreib = G|false
.select screen line
!FI028
!EL026
!EL025
