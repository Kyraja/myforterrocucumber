..!interpreter english declaration noabbrev
.. at 2017-06-09, 10:55
.set trans -
..========================================================================
..==  Name              : GET.SUBPROJECTS
..==  Pfad              : allpstart
..==  Funktion          : Unterprogramm zur Ermittlung aller Terilprojekte zum Projekt
..==
..==                      erwrtet in xpproject (P86:1) das Hauptprojekt zu welchem die Teilprojete geladen werden sollen
..==                      in U|xstsubprojects (symtab) werden die Teilprojekte zurÅckgegeben
..==                      Das Programm nutz den Puffer 9
..==
..==  Erstellungsdatum  : 09.06.2017
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
..====================================================
.type P86:1   xpproject         ? _F|defined(U|xpproject)
.type text    xytindex          ? _F|defined(U|xytindex)
.type integer xyitpstufe        ? _F|defined(U|xyitpstufe)
.type symtab  xstsubprojects    ? _F|defined(U|xstsubprojects)
.type symtab  xysttpindex       ? _F|defined(U|xysttpindex)
.type symtab  xyst001           ? _F|defined(U|xyst001)
.type symtab  xyst002           ? _F|defined(U|xyst002)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Teilprojekte -----
.formula U|xyitpstufe = U|xyitpstufe + 1
.assign U|xyst001 = ""
.load 9 group "86:1" 'F|expr("$,,yteilprojektzu==" + 9|id + ";@filingmode=(Active)")'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.type P86:1 F|map(U|xyst001, '9|id')
.assign F|map(U|xyst001, '9|id')  = 9|id
.load 9 continue
.continue LOOP001
!ELOP001: ==============================
.formula U|xytindex = ""
.formula U|xytindex = F|nextelem(F|map(U|xyst001, ""), U|xytindex, G|true)
!LOOP002: ==============================
.continue ELOP002 ? _(_(F|empty(U|xytindex)))
.type P86:1 F|map(U|xstsubprojects, U|xytindex)
.copy F|map(U|xstsubprojects, U|xytindex)  = F|map(U|xyst001, U|xytindex)
.formula U|xytindex = F|nextelem(F|map(U|xyst001, ""), U|xytindex, G|true)
.continue LOOP002
!ELOP002: ==============================
.type symtab F|row(U|xyst002, U|xyitpstufe)     ? _F|defined(F|row(U|xyst002, U|xyitpstufe))
.formula F|row(U|xyst002, U|xyitpstufe) = U|xyst001
.formula U|xytindex = ""
.formula U|xytindex = F|nextelem(F|map(F|row(U|xyst002, U|xyitpstufe), ""), U|xytindex, G|true)
!LOOP003: ==============================
.continue ELOP003 ? _(_(F|empty(U|xytindex)))
.type text F|row(U|xysttpindex, U|xyitpstufe)     ? _F|defined(F|row(U|xysttpindex, U|xyitpstufe))
.formula F|row(U|xysttpindex, U|xyitpstufe) = U|xytindex
.load 9 add F|map(F|row(U|xyst002, U|xyitpstufe), U|xytindex)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.formula U|xytindex = F|row(U|xysttpindex, U|xyitpstufe)
.formula U|xytindex = F|nextelem(F|map(F|row(U|xyst002, U|xyitpstufe), ""), U|xytindex, G|true)
.continue LOOP003
!ELOP003: ==============================
.assign F|row(U|xyst002, U|xyitpstufe) = ""
.formula U|xyitpstufe = U|xyitpstufe - 1
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.assign U|xstsubprojects = ""
.continue EL001 ? _(_(F|empty(U|xpproject)))
.load 9 add U|xpproject
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL001
