!BRK002
.continue BRK003 ? _(G|evtart = "maskaus")
.continue EL014 ? _(_(G|evtkommd = G|kaktname12))
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL015 ? _(F|empty(M|yprjmpvorgang))
.formula xtsel = "$,,yrefid==" + M|id + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.formula M|yprjmpvorgang = 0|id
.continue EL016 ? _(M|mge = 0)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI016
!EL016
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
!FI016
