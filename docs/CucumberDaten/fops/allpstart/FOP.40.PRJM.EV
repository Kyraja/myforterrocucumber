!BRK003
.continue BRK004 ? _(G|evtart = "feldfuell")
.continue BRK005 ? _(G|evtvar = "yprjmpvorgang")
.formula U|xysel = ";yreftypk="
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue EL018 ? _(_(F|empty(M|projekt)))
.continue EL019 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = M|yprjmpvorgang^id)))
.select group 'U|xydbgrpvorgang' 'G|evtfeldneu'
.continue EL020 ? _(G|mehr)
.formula U|xtsel = H|yprojekt^id
.input "allpstart/FOP.PRJM.UP.CHECK.PROJECT"    ? _H|yprojekt^id = M|projekt^id
!EL020
!EL019
!EL018
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "projekt")
.input "allpstart/FOP.PRJM.UP.CHECK.PROJECT"
.continue ESAC003
!BRK006
!ESAC003: =====   ENDCASE   =====
.continue ESAC002
!BRK004
.continue BRK007 ? _(G|evtart = "feldaus")
.continue BRK008 ? _(G|evtvarori = "yprjmpvorgang")
.continue EL021 ? _(F|empty(M|yprjmpvorgang))
.continue EL022 ? _(_(F|empty(M|id)))
.load 0 group 'U|xydbgrpvorgang' 'F|expr("$,,yrefid==" + M|id + ";@filingmode=(Active)")'
.continue EL023 ? _(G|mehr)
.select lock add 0|id
.continue EL024 ? _(G|mehr)
.formula H|yrefid  = ""
.assign  H|yreftyp = ""
.rewrite
.continue FI024
!EL024
.set TRANS +
.box Fehler
Der Projektvorgang 'M|yprjmpvorgang' kann nicht bearbeitet werden.
Entfernen der Referenz ist nicht mîglich.
.set TRANS -
.assign M|yprjmpvorgang = 0|id
.copy   M|projekt       = 0|yprojekt    ? F|modifiable(M|projekt)
.error
.end 1
!FI024
!EL023
!EL022
.continue FI021
!EL021
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC003
!RET005
.formula xprocsp = xprocsp - 1
.continue EL025 ? _(_(F|empty(M|yprjmpvorgang^yrefid)))
.continue EL026 ? _(((M|yprjmpvorgang^yrefid <> M|id) & (_(F|empty(M|id)))) ; (F|empty(M|id)))
.set TRANS +
.box Fehler
Im Projektvorgang 'M|yprjmpvorgang' ist bereits eine Referenz eingetragen.
.set TRANS -
.assign M|yprjmpvorgang = ""
.assign M|projekt       = ""    ? F|modifiable(M|projekt)
.error
.end 1
!EL026
.continue FI025
!EL025
.continue EL027 ? _(_(F|empty(M|id)))
.load 0 group 'U|xydbgrpvorgang' 'F|expr("$,,id<>" + M|yprjmpvorgang^id + ";yrefid==" + M|id + ";@filingmode=(Active)")'
.continue EL028 ? _(G|mehr)
.set TRANS +
.box Fehler
Es existiert bereits ein Projektvorgang '0|nummer' mit Verweis auf diesen Fertigungsvorschlag.
Eintragen der Referenz ist nicht mîglich.
.set TRANS -
.assign M|yprjmpvorgang = ""
.assign M|projekt       = ""    ? F|modifiable(M|projekt)
.error
.end 1
.continue FI028
!EL028
.select lock add M|yprjmpvorgang
.continue EL029 ? _(G|mehr)
.formula H|yrefid   = M|id
.assign  H|yreftypk = "02"
.rewrite
.continue FI029
!EL029
.set TRANS +
.box Fehler
Der Projektvorgang 'M|yprjmpvorgang' kann nicht bearbeitet werden.
Eintragen der Referenz ist nicht mîglich.
.set TRANS -
.assign M|yprjmpvorgang = ""
.assign M|projekt       = ""    ? F|modifiable(M|projekt)
.error
