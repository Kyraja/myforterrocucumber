.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text     xtsel xysel xtid xtverw xtkstelle xtpvorgang xt1
.type P86:1    xpprojekt
.type P149:2   xppvorgang
.type AZK28054 xyazkverw
.type bool     xbmehr
.type GD       xdleer xdatum xdstart xdende
.type integer   xprocsp      ? _defined(xprocsp)
..====================================================
.formula xprocsp = 0
.set demand -
.continue EPROCDEF
!PROC001: ----- PV_loechen -----
.continue EL001 ? _(M|yprjmpvorgang^yrefid = M|id)
.select lock add M|yprjmpvorgang
.continue EL002 ? _(G|mehr)
.assign H|yrefid   = ""
.rewrite
.continue FI002
!EL002
.set TRANS +
.box Fehler
Der Projektvorgang konnte nicht geîffnet werden.
Der Fertigungsvorschlag konnte nicht aus dem Vorgang entfernt werden.

Bitte prÅfen Sie den Projektvorgang 'M|yprjmpvorgang^nummer'/'M|yprjmpvorgang^such'.
.set TRANS -
.error
.end 1
!FI002
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- PV_neu_aendern -----
.formula U|xdstart = M|tsterm
.formula U|xdende  = M|fterm
.formula U|xdende  = M|tterm    ? 'U|xdende' = "" ; M|tterm > M|fterm
.continue EL003 ? _((_(M|yprjmpvorgang^yiststart = U|xdstart)) ; (_(M|yprjmpvorgang^yistend   = U|xdende)))
.select lock add M|yprjmpvorgang
.continue EL004 ? _(G|mehr)
.copy    H|yiststart      = U|xdstart
.copy    H|yistend        = U|xdende
.formula H|yabwterminplan = F|numworkdays("", "", H|yistend, H|yedatum) * (-1)  ? H|yedatum >= H|yistend & _F|empty(H|yistend)
.formula H|yabwterminplan = F|numworkdays("", "", H|yedatum, H|yistend)         ? H|yedatum  < H|yistend & _F|empty(H|yistend)
.rewrite
.continue FI004
!EL004
.set TRANS +
.box Fehler

Der Projektvorgang konnte nicht geîffnet werden.
Aktualisierung der Termine ist fehlgeschlagen.

Bitte prÅfen Sie den Projektvorgang 'M|yprjmpvorgang^nummer'/'M|yprjmpvorgang^such'.
.set TRANS -
.error
.end 1
!FI004
!EL003
.continue EL005 ? _(_(M|yprjmpvorgang^yrefid = M|id))
.select lock add M|yprjmpvorgang
.continue EL006 ? _(G|mehr)
.assign H|yrefid   = M|id
.assign H|yreftypk = "02"
.rewrite
.continue FI006
!EL006
.set TRANS +
.box Fehler
Der Projektvorgang konnte nicht geîffnet werden.
Aktualisierung der Arbeitsaufgabe ist fehlgeschlagen.

Bitte prÅfen Sie den Projektvorgang 'M|yprjmpvorgang^nummer'/'M|yprjmpvorgang^such'.
.set TRANS -
.error
.end 1
!FI006
!EL005
.formula U|xtpvorgang = M|yprjmpvorgang^id
.input "allpstart/FOP.PRJM.UP.SVORGANG.AKT"
.continue 'xprocst.xprocsp'
!PROC003: ----- Vorbelegungen -----
.continue EL007 ? _((_(F|empty(M|yprjmpvorgang))) & (_(F|empty(M|artex))))
.formula U|xtverw    = ""
.formula U|xtkstelle = ""
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"   ? _F|defined(5|ykoobjfvzuw)
.continue EL008 ? _(((G|evtkommd = G|kaktname13) & (_(F|empty(5|yverwfvzuwk)))) ; ((G|evtkommd = G|kaktname14) & (_(F|empty(5|yverwfvneuk)))))
.copy U|xyazkverw = 5|yverwfvzuwk   ? G|evtkommd = G|kaktname13
.copy U|xyazkverw = 5|yverwfvneuk   ? G|evtkommd = G|kaktname14
.copy U|xpprojekt  = M|projekt
.copy U|xppvorgang = M|yprjmpvorgang
.input "allpstart/FOP.PRJM.UP.VERW"
!EL008
.continue EL009 ? _(((G|evtkommd = G|kaktname13) & (5|ykoobjfvzuw)) ; ((G|evtkommd = G|kaktname14) & (5|ykoobjfvneu)))
.formula U|xtkstelle = M|yprjmpvorgang^yprojekt^yktr^id     ? _F|empty(M|yprjmpvorgang^yprojekt^yktr)
!EL009
.assign  M|kstelle = U|xtkstelle    ?  F|modifiable(M|kstelle) & _F|empty(U|xtkstelle)
.formula M|verw    = U|xtverw       ?  F|modifiable(M|verw)    & _F|empty(U|xtverw)
!EL007
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue         ? _U|xybfertigung
.continue BRK001 ? _(G|evtmaske = 40)
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL010 ? _(_(G|evtkommd = G|kaktname12))
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL011 ? _(_(F|empty(M|yprjmpvorgang)))
.copy M|projekt  = M|yprjmpvorgang^yprojekt     ? F|modifiable(M|projekt)
.select lock nowait add M|yprjmpvorgang
.continue EL012 ? _(G|mehr)
.continue EL013 ? _(_(G|gesperrt))
.set TRANS +
.box Fehler
Der Projektvorgang 'H|nummer' wird bearbeitet.
Aktualisierung der Termine ist fehlgeschlagen.

'G|sperrtext                                                                   '

Das Speichern wird abgebrochen.
.set TRANS -
.error
.end 1
!EL013
.continue FI012
!EL012
.set TRANS +
.box Fehler
Der Projektvorgang 'M|yprjmpvorgang' konnte nicht geîffnet werden.
Aktualisierung der Termine ist fehlgeschlagen.

Das Speichern wird abgebrochen.
.set TRANS -
.error
.end 1
!FI012
!EL011
