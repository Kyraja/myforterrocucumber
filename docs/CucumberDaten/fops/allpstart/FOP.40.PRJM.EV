.continue ELOP004 ? _(G|mehr)
.formula U|xtsel = "$,,yrefid==" + 1|id + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrpvorgang' 'U|xtsel'
!LOOP005: ==============================
.continue ELOP005 ? _(G|mehr)
.formula U|xdstart = 1|tsterm
.formula U|xdende  = 1|fterm
.formula U|xdende  = 1|tterm   ? 'U|xdende' = ""
.continue EL030 ? _((_(0|yiststart = U|xdstart)) ; (_(0|yistend   = U|xdende)))
.select lock add 0|id
