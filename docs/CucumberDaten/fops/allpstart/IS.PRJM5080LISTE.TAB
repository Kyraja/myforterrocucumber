.continue EPROCDEF
!PROC001: ----- Zeile -----
.make screen line +O
.copy    M|yverantwkst  = D|yverantwkst
.assign  M|ytprojekt    = D|id
.copy    M|ytprojleit   = D|yprojleit
.formula M|ytiststd     = D|ypviststd
.formula M|ytsollstd    = D|ypvsollstd
.formula M|ytplanstd    = D|ypvplanstd
.copy M|ytfortschritt      = D|yfortschritt
.copy M|ytfortistbudget    = D|yfortistbudget
.copy M|yttechfort         = D|ytechfort
.copy M|ytfortman          = D|yfortman
.copy M|yttechfortman      = D|ytechfortman
.copy M|ytabwfortbudget    = D|yabwfortbudget
.copy M|ytabwfortplan      = D|yabwfortplan
.copy M|ytabwphysplan      = D|yabwphysplan
.copy M|ytabwterminist     = D|yabwterminist
.copy M|ytabwterminplan    = D|yabwterminplan
.copy M|yticonfortbudget   = D|yiconfortbudget
.copy M|yticonfortplan     = D|yiconfortplan
.copy M|yticontechfort     = D|yicontechfort
.copy M|yticonabwfortbud   = D|yiconabwfortbudget
.copy M|yticonabwfortplan  = D|yiconabwfortplan
.copy M|yticonabwphysplan  = D|yiconabwphysplan
.copy M|yticonabwterminist = D|yiconabwterminist
.copy M|yticonabwterminpl  = D|yiconabwterminplan
.copy M|yticonkritvorgang  = D|yiconkritvorgang
.colour -FOREGROUND "0 0 0" ytabwfortplan   'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwfortbudget 'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwphysplan   'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwterminist  'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwterminplan 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe.xifarbe' 'M|aktzeile'
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL001 ? _(F|empty(H|yteilprojektzu))
.continue EL002 ? _(U|xifarbe = 1)
.formula U|xifarbe = 2
.continue FI002
!EL002
.formula U|xifarbe = 1
!FI002
.add H|id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.copy U|xbmehr = G|FALSE
.formula U|xrsumpvsollstd     = H|ypvsollstd
.formula U|xrsumpvplanstd     = H|ypvplanstd
.formula U|xrsumpviststd      = H|ypviststd
.formula U|xrsumpvforecaststd = H|ypvforecaststd
.load 0 group 'U|xydbgrprojekt' 'F|expr("$,,yteilprojektzu==" + H|id + ";@filingmode=(Active)")'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.assign U|xyberlaubt = G|TRUE
.continue EL003 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = H|yverantwkst^id
.input 'U|xypmrepruefkstprog'
.continue EL004 ? _(_(U|xyberlaubt))
.continue EL005 ? _((_(F|empty(H|yteilprojektzu))) & (H|ybfreifuerhpl))
.assign U|xyberlaubt = H|yteilprojektzu^yprojleit^id = G|passw^passmitarb^id
!EL005
!EL004
!EL003
.continue EL006 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = H|yktr^id
.input 'U|xypmrepruefktrprog'
.continue EL007 ? _(_(U|xyberlaubt))
.continue EL008 ? _((_(F|empty(H|yteilprojektzu))) & (H|ybfreifuerhpl))
.assign U|xyberlaubt = H|yteilprojektzu^yprojleit^id = G|passw^passmitarb^id
!EL008
!EL007
!EL006
.continue EL009 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL010 ? _(_(U|xyberlaubt))
.continue EL011 ? _((_(F|empty(H|yteilprojektzu))) & (H|ybfreifuerhpl))
.assign U|xyberlaubt = H|yteilprojektzu^yprojleit^id = G|passw^passmitarb^id
!EL011
!EL010
!EL009
.continue EL012 ? _(U|xyberlaubt)
.copy U|xbmehr = G|TRUE
.add 0|id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.formula U|xrsumpviststd      = U|xrsumpviststd      + 0|ypviststd
.formula U|xrsumpvsollstd     = U|xrsumpvsollstd     + 0|ypvsollstd
.formula U|xrsumpvplanstd     = U|xrsumpvplanstd     + 0|ypvplanstd
.formula U|xrsumpvforecaststd = U|xrsumpvforecaststd + 0|ypvforecaststd
.colour -BACKGROUND 'U|xtfarbe.xifarbe' 'M|aktzeile'
!EL012
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.continue EL013 ? _(U|xbmehr)
.make screen line +O
.copy    M|yverantwkst     = H|yverantwkst
.formula M|ytprojekt       = H|id
.copy    M|ytprojleit      = H|yprojleit
.formula M|ytiststd        = U|xrsumpviststd
.formula M|ytsollstd       = U|xrsumpvsollstd
.formula M|ytplanstd       = U|xrsumpvplanstd
.colour -BACKGROUND 'U|xtfarbes' 'M|aktzeile'
.formula M|ytfortschritt   = U|xrsumpviststd / U|xrsumpvplanstd * 100       ? _U|xrsumpvplanstd = 0
.formula M|ytabwfortplan   = M|ytfortschritt - 100
.formula M|ytfortistbudget = U|xrsumpviststd / U|xrsumpvsollstd * 100       ? _U|xrsumpvsollstd = 0
.formula M|ytabwfortbudget = M|ytfortistbudget - 100
.formula M|yttechfort      = U|xrsumpviststd / U|xrsumpvforecaststd * 100   ? _U|xrsumpvforecaststd = 0
.formula M|yttechfort      = 100                                            ?  M|yttechfort         > 100
.colour -FOREGROUND "0 0 0" ytabwfortplan   'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwfortbudget 'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwphysplan   'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwterminist  'M|aktzeile'
.colour -FOREGROUND "0 0 0" ytabwterminplan 'M|aktzeile'
!EL013
!EL001
.input 'F|foppath("IFOP.IS.PRJM5080LISTE.TAB")'     ? F|fileexists(F|foppath("IFOP.IS.PRJM5080LISTE.TAB"))
.continue
