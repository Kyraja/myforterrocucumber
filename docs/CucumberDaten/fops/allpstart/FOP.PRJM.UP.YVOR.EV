..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.UP.YVOR.EV
..==  Pfad              : allpstart
..==  Funktion          : Unterprogramm zur Selektion der Vorgangsposition im Projektmanagement
..==  Erstellungsdatum  :
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2015 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"  ? _F|defined(U|xydbgrprojleistkat)
..====================================================
.type text    xtsel     ? _F|defined(U|xtsel)
.type text    xtvorpos  ? _F|defined(U|xtvorpos)
.type text    xt01      ? _F|defined(U|xt01)
.type text    xykotyp   ? _F|defined(U|xykotyp)
.type integer xidb      ? _F|defined(U|xidb)
.type VP8     xppos     ? _F|defined(U|xppos)
.type integer xprocsp   ? _defined(xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Fehler_nicht_zeigen -----
.set trans +
.box Fehler
Zuweisen eines Vorgangs ist nicht im <zeigen> mîglich!
.set trans -
.error
.end 1
.continue 'xprocst.xprocsp'
!PROC002: ----- Position_pruefen -----
.select add U|xppos
.continue EL001 ? _(G|mehr)
.continue EL002 ? _(H|alternativpos)
.set trans +
.box Fehler
Alternativpositionen sind nicht erlaubt.
.set trans -
.error (0)
.end 1                                  ? G|evtart = "feldfuell"
.formula G|evtfeldneu = M|yvorpos       ? F|defined(M|yvorpos)
.continue FI002
!EL002
.continue EL003 ? _((H|kotyp = G|ABKO) ; ((H|kotyp = G|CHKO) & (H|dnr   = 3)) ; ((H|kotyp = G|ANKO) & (H|dnr   = 3)) ; (H|kotyp = G|SNKO) ; (H|kotyp = G|SBKO) ; (H|kotyp = G|SRKO) ; (H|kotyp = G|KVKO))
.formula M|yvorpos    = H|id     ? F|defined(M|yvorpos)
.formula M|yvornum    = H|kopf
.formula M|yvorvp     = H|id     ? _G|evtart = "feldfuell"
.formula G|evtfeldneu = H|id     ?  G|evtart = "feldfuell"
.formula U|xtvorpos = H|id
.continue EL004 ? _(F|defined(M|yvkartikel))
.continue EL005 ? _((5|ybleistkat) & (F|defined(M|yprojekt)) & (H|art^yprjmprkatartk = "PQ"))
.continue EL006 ? _(_(F|empty(M|yprojekt^yprojleistkatid)))
.formula U|xtsel = "$,id=" + M|yprojekt^yprojleistkatid
.formula U|xtsel = U|xtsel + ";yteil==" + H|art^id
.formula U|xtsel = U|xtsel + ";yprjmprkatartk==PQ"
.formula U|xtsel = U|xtsel + ";@rows=(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrprojleistkat' 'U|xtsel'
.assign M|yvkartikel  = H|art^id    ?  G|mehr
!EL006
.continue FI005
!EL005
.assign M|yvkartikel  = H|art^id    ?  H|art^yprjmprkatartk = "PQ"
!FI005
!EL004
.continue EL007 ? _(F|defined(M|ymaschvkart))
.continue EL008 ? _((5|ybleistkat) & (F|defined(M|yprojekt)) & (H|art^yprjmprkatartk = "ML"))
.continue EL009 ? _(_(F|empty(M|yprojekt^yprojleistkatid)))
.formula U|xtsel = "$,id=" + M|yprojekt^yprojleistkatid
.formula U|xtsel = U|xtsel + ";yteil==" + H|art^id
.formula U|xtsel = U|xtsel + ";yprjmprkatartk==ML"
.formula U|xtsel = U|xtsel + ";@rows=(Yes)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrprojleistkat' 'U|xtsel'
.assign M|ymaschvkart = H|art^id    ?  G|mehr
!EL009
.continue FI008
!EL008
.assign M|ymaschvkart = H|art^id    ?  H|art^yprjmprkatartk = "ML"
!FI008
!EL007
.continue FI003
!EL003
.set TRANS +
.box Fehler
Es sind nur Auftrags-, Angebots-, Serviceangebots- Servicauftrags-, Reparaturauftrags- oder Kostenvoranschlagspositionen erlaubt.
.set TRANS -
.error (0)
.end 1                                  ? G|evtart = "feldfuell"
.formula G|evtfeldneu = M|yvorpos       ? F|defined(M|yvorpos)
!FI003
!FI002
!EL001
.continue 'xprocst.xprocsp'
!PROC003: ----- Selektion -----
.formula U|xidb    = 3
.formula U|xykotyp = "(3)"
.formula U|xt01    = ""
.formula U|xtsel   = "%,,kopf=;kovom=;pnum=;art=;tename=;ptext=;mge=;tterm=;status=;alternativpos=(No)"
.continue EL010 ? _(F|defined(M|ytprojekt))
.add M|ytprojekt                ?  F|empty(M|ytprojekt^yteilprojektzu) ; (_F|empty(M|ytprojekt^yvorgangid) & _M|ytprojekt^yvorgangid = "(0,0,0)")
.add M|ytprojekt^yteilprojektzu ? _F|empty(M|ytprojekt^yteilprojektzu) & ( F|empty(M|ytprojekt^yvorgangid) ;  M|ytprojekt^yvorgangid = "(0,0,0)")
.continue FI010
!EL010
.continue EL011 ? _(F|defined(M|yprojekt))
.add M|yprojekt                 ?  F|empty(M|yprojekt^yteilprojektzu) ; (_F|empty(M|yprojekt^yvorgangid) & _M|yprojekt^yvorgangid = "(0,0,0)")
.add M|yprojekt^yteilprojektzu  ? _F|empty(M|yprojekt^yteilprojektzu) & ( F|empty(M|yprojekt^yvorgangid) ;  M|yprojekt^yvorgangid = "(0,0,0)")
!EL011
!FI010
.continue EL012 ? _(F|defined(M|yteilprojekt))
.add M|yteilprojekt                 ?  F|empty(M|yteilprojekt^yteilprojektzu) ; (_F|empty(M|yteilprojekt^yvorgangid) & _M|yteilprojekt^yvorgangid = "(0,0,0)")
.add M|yteilprojekt^yteilprojektzu  ? _F|empty(M|yteilprojekt^yteilprojektzu) & ( F|empty(M|yteilprojekt^yvorgangid) ;  M|yteilprojekt^yvorgangid = "(0,0,0)")
!EL012
.continue EL013 ? _(F|defined(D|id))
.formula U|xt01 = D|id
.continue EL014 ? _((_(D|yvorgangid = "(0,0,0)")) & (_(F|empty(D|yvorgangid))))
.load 9 object 'D|yvorgangid'
.formula U|xykotyp = '9|typ(L=":")'     ?  G|mehr
!EL014
!EL013
.formula U|xtsel = U|xtsel + ";projekt="   + U|xt01
.formula U|xtsel = U|xtsel + ";typ=="
.formula U|xtsel = U|xtsel + ";kotyp="     + U|xykotyp
.formula U|xtsel = U|xtsel + ";@.gruppe=2;@.datei=" + 'U|xidb'
.formula U|xtsel = U|xtsel + ";@filingmode=(Active)"
.formula U|xtsel = U|xtsel + ";@order=id.(Backwards)"
.formula U|xtsel = U|xtsel + ";@autostart=(Yes)"
.assign  U|xppos = U|xtsel
.continue EL015 ? _(_(F|empty(U|xppos)))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue FI015
!EL015
.formula G|evtfeldneu = M|yvorvp^id     ?  G|evtart = "feldfuell"
!FI015
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"           ? _F|defined(5|ybleistkat)
.continue BRK001 ? _(G|evtart = "buttonvor")
.continue BRK002 ? _(G|evtvar = "ybupos")
.continue EL016 ? _((M|dnr    = U|xydbaufgabe) & (M|gruppe = U|xygraufgabe))
.continue EL017 ? _(_(F|empty(M|ypvorgang)))
.note -IMMEDIATELY Eintrag ist schreibgeschÅtzt
.error
.end 1
!EL017
!EL016
.continue EL018 ? _(G|evtkommd = G|kaktname12)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue FI018
!EL018
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
!FI018
.continue ESAC002
!BRK002
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK001
.continue BRK003 ? _(G|evtart = "feldfuell")
.continue BRK004 ? _(G|evtvar = "yvorvp")
.continue EL019 ? _(G|evtkommd = G|kaktname12)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue FI019
!EL019
.continue EL020 ? _((G|evtfeldneu = "!") ; (G|evtfeldneu = "?"))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC003
!RET005
.formula xprocsp = xprocsp - 1
.continue FI020
!EL020
.assign U|xppos = G|evtfeldneu
.continue EL021 ? _(G|mehr)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
.continue FI021
!EL021
.formula G|evtfeldneu = M|yvorpos        ?  F|defined(M|yvorpos)
.formula G|evtfeldneu = M|yvorvp^id      ? _F|defined(M|yvorpos)
!FI021
!FI020
!FI019
.continue ESAC003
!BRK004
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "yvorvp")
.continue EL022 ? _(G|evtkommd = G|kaktname12)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC001
!RET007
.formula xprocsp = xprocsp - 1
.continue FI022
!EL022
.continue EL023 ? _(F|empty(M|yvorvp))
.formula M|yvorpos = ""  ?  F|defined(M|yvorpos)
.formula M|yvornum = ""
.formula M|yvorvp  = ""
.continue FI023
!EL023
.formula M|yvorpos = M|yvorvp^id         ?  F|defined(M|yvorpos)
.formula M|yvornum = M|yvorvp^kopf
.formula M|yvorvp  = M|yvorvp^id
!FI023
!FI022
.continue ESAC004
!BRK006
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK005
!ESAC001: =====   ENDCASE   =====
.continue
