.continue EL026 ? _(_(F|empty(9|pftext)))
.select from '9|pftext'
.formula M|ytftext = 9|pftext
!EL026
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC001
!RET007
.formula xprocsp = xprocsp - 1
!EL025
.load 9 continue
.continue LOOP007
!ELOP007: ==============================
.input 'F|foppath("IFOP.IS.PRJMBESCHAFFUNG.TAB")'    ? F|fileexists(F|foppath("IFOP.IS.PRJMBESCHAFFUNG.TAB"))
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue EL027 ? _(_(F|empty(M|ypvorgang)))
.load 0 add M|ypvorgang
.select add 0|yprojekt
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC003
