.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Schreibschutz -----
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
.copy U|xbprotect = G|FALSE
.continue EL001 ? _(F|defined(0|id))
.copy U|xbprotect = G|TRUE  ? 0|yablage ; 0|ablagef
!EL001
.continue EL002 ? _((_(F|empty(M|ytpvorgang))) & ((M|ytpvorgang^ablagef) ; (M|ytpvorgang^yablage)))
.copy U|xbprotect = G|TRUE
!EL002
.copy U|xbprotect = G|TRUE  ? H|yablage ; H|ablagef
.continue EL003 ? _(U|xbprotect)
.protection -exception ytbuzeile 'M|aktzeile'
.protection -exception buaktion  'M|aktzeile'
.protection -exception buinfosys 'M|aktzeile'
.protection -exception budruck   'M|aktzeile'
.protection -line 'M|aktzeile'
.continue FI003
!EL003
.continue EL004 ? _((F|empty(M|ytekpos)) ; (_(F|empty(M|ytekpos^kopf))))
.protection ytpvorgang    'M|aktzeile'
.protection ytprojekt     'M|aktzeile'
.protection ytarbpaket    'M|aktzeile'  ? F|empty(M|ytekpos)
.protection ytbez         'M|aktzeile'  ? F|empty(M|ytekpos)
.protection ytteil        'M|aktzeile'
.protection ytlief        'M|aktzeile'
.protection ytftext       'M|aktzeile'  ? F|empty(M|ytekpos)
.protection ytmge         'M|aktzeile'
.protection yteinh        'M|aktzeile'
.protection ytplandatlief 'M|aktzeile'
.continue FI004
!EL004
.continue EL005 ? _(M|ytteil^gruppe = 4)
.protection yteinh 'M|aktzeile'    ? 'M|ytteil^zptyp(L="0")' = "(12)"
!EL005
.protection yteinh 'M|aktzeile'             ? F|empty(M|ytteil^le)
!FI004
.continue EL006 ? _(M|ytekpos^ablagef)
.protection ytbspeichern     'M|aktzeile'
.protection ytbez            'M|aktzeile'
.protection ytftext          'M|aktzeile'
.protection ytarbpaket       'M|aktzeile'
.protection ytbem            'M|aktzeile'
.protection ytprjmverw       'M|aktzeile'
.protection ytbedarfstraeger 'M|aktzeile'
.protection ytbudgetwert     'M|aktzeile'
.protection ytfcwert         'M|aktzeile'
.protection ytplandatanf     'M|aktzeile'
.protection ytplandatang     'M|aktzeile'
.protection ytplandatbest    'M|aktzeile'
!EL006
.protection ytartbdeckung 'M|aktzeile'
!FI003
.continue 'xprocst.xprocsp'
!PROC002: ----- ZeileBestellung -----
.formula M|ytbuzeile      = "icon:plus"
.formula M|ytbubestellung = "icon:information"
.copy    M|ytpvorgang = 8|yprjmppvorgang
.copy    M|ytarbpaket = 8|yprjmparbpaket
.assign  M|ytprojekt  = H|id
.assign  M|ytekpos    = 8|id
.formula M|ytprojek   = 8|yprjmpprojek
.formula M|ytbez            = 8|ptext
.copy    M|ytteil           = 8|artex
.copy    M|ytlief           = 8|lief
.formula M|ytbem            = 8|yprjmpbem
.formula M|ytprjmverw       = 8|verw
.formula M|ytmge            = 8|mge
.formula M|ytmge            = 8|pwert       ? 8|mge = 0
.assign  M|yteinh           = 8|he
.formula M|yttterm          = 8|tterm
.formula M|ytfterm          = 8|fterm
.copy    M|ytbedarfstraeger = 8|yprjmpbedarfstraeg
.formula M|ytbudgetwert     = 8|yprjmpbudgetwert
.formula M|ytfcwert         = 8|yprjmpfcwert
.formula M|ytplandatanf     = 8|yprjmpsolldatanf
.formula M|ytplandatang     = 8|yprjmpsolldatang
.formula M|ytplandatbest    = 8|yprjmpsolldatbest
.formula M|ytplandatlief    = 8|yprjmpsolldatlief
.formula M|ytbstwert = 8|nwert                                          ?  8|pland = G|inland
.formula M|ytbstwert = F|fxamount(G|inland,8|nwert,,8|pland,G|TRUE)     ? _8|pland = G|inland
.continue EL007 ? _(_(F|empty(8|pftext)))
.select from '8|pftext'
.formula M|ytftext = 8|pftext
!EL007
.continue EL008 ? _(F|empty(M|ytbulieferschein))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt=="        + H|id     ? _F|defined(0|id)
.formula U|xtsel = U|xtsel + ";yprjmppvorgang==" + 0|id     ?  F|defined(0|id)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|LIKO' + ")"
.formula U|xtsel = U|xtsel + ";orig=="           + 8|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 7 group "4:2" 'U|xtsel'
.formula M|ytbulieferschein = "icon:information"  ? G|mehr
.continue EL009 ? _((G|mehr) & (F|empty(M|ytburechnung)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt=="        + H|id     ? _F|defined(0|id)
.formula U|xtsel = U|xtsel + ";yprjmppvorgang==" + 0|id     ?  F|defined(0|id)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|REKO' + ")"
.formula U|xtsel = U|xtsel + ";orig=="           + 7|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 6 group "4:2" 'U|xtsel'
.formula M|ytburechnung = "icon:information"  ? G|mehr
!EL009
!EL008
.continue EL010 ? _(F|empty(M|ytburechnung))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt=="        + H|id     ? _F|defined(0|id)
.formula U|xtsel = U|xtsel + ";yprjmppvorgang==" + 0|id     ?  F|defined(0|id)
.formula U|xtsel = U|xtsel + ";kotyp==(" + 'G|REKO' + ")"
.formula U|xtsel = U|xtsel + ";orig=="           + 8|id
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 7 group "4:2" 'U|xtsel'
.formula M|ytburechnung = "icon:information"  ? G|mehr
!EL010
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC003: ----- Zeile_laden -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";projekt=="        + H|id         ? _F|defined(0|id)
.formula U|xtsel = U|xtsel + ";yprjmppvorgang==" + 0|id         ?  F|defined(0|id)
