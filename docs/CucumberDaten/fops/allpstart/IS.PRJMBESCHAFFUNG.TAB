.copy    M|yteinh           = 9|he
.formula M|yttterm          = 9|tterm
.formula M|ytfterm          = 9|fterm
.copy    M|ytbedarfstraeger = 9|yprjmpbedarfstraeg
.assign  M|ytekpos          = 9|id
