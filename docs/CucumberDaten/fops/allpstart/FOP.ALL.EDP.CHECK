..!interpreter english declaration noabbrev
.. at 2016-04-13, 09:42
.set TRANS -
..========================================================================
..==  Name              : FOP.ALL.EDP.CHECK
..==  Pfad              : allpstart
..==  Funktion          : EDP FehlerprÅfung
..==                      -Auswertung und Anzeigen der FOP Meldungen
..==  Erstellungsdatum  : 07.10.2011
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.type text    xtbox     ? _F|defined(U|xtbox)
.type text    xtext     ? _F|defined(U|xtext)
.type text    xterrtext ? _F|defined(U|xterrtext)
.type integer xiedpmsg  ? _F|defined(U|xiedpmsg)
.type bool    xbmehr    ? _F|defined(U|xbmehr)
.type bool    xbfehler  ? _F|defined(U|xbfehler)
.type bool    xbhinweis ? _F|defined(U|xbhinweis)
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Fehlermenue -----
.set trans +
.continue EL001 ? _(G|edp)
.output TERMINAL
EDP Befehl: 'U|xtsys'

EDP Datei:        'U|xtedpdat'

?EDP Hinweisdatei: 'U|xtedpmsg' ?  F|fileexists(U|xtedpmsg)
.input 'U|xtedpmsg'             ?  F|fileexists(U|xtedpmsg)

?EDP Fehlerdatei:  'U|xtedperr' ?  F|fileexists(U|xtedperr)
.input 'U|xtedperr'             ?  F|fileexists(U|xtedperr)

?EDP Ausgabedatei: 'U|xtedpout' ?  F|fileexists(U|xtedpout)
.input 'U|xtedpout'             ?  F|fileexists(U|xtedpout)

.continue FI001
!EL001
!REPT001: ==============================
.formula U|xterrtext = "Bei der AusfÅhrung des Befehls sind Fehler aufgetreten:"        ? F|empty(U|xterrtext)
.menu
-                 -
'U|xterrtext                                                                  '

EDP Befehl: 'U|xtsys'

EDP Datei:        'U|xtedpdat'  >>.edit "'U|xtedpdat'"
?EDP Hinweisdatei: 'U|xtedpmsg'  >>.edit "'U|xtedpmsg'" ?  F|fileexists(U|xtedpmsg)
?EDP Fehlerdatei:  'U|xtedperr'  >>.edit "'U|xtedperr'" ?  F|fileexists(U|xtedperr)
?EDP Ausgabedatei: 'U|xtedpout'  >>.edit "'U|xtedpout'" ?  F|fileexists(U|xtedpout)
.set TRANS -
.continue REPT001 ? _(G|menue = 0)
!FI001
.set trans -
.continue 'xprocst.xprocsp'
!PROC002: ----- Fehlerbehandlung -----
.continue EL002 ? _(P|loglevel > 0)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue FI002
!EL002
.continue EL003 ? _(F|fileexists(U|xtedpmsg))
.continue EL004 ? _(F|filenotempty(U|xtedpmsg))
.system 'F|expr("s3_conv 12 " + U|xtedpmsg)' background
.file -TEMPNAME U|xtbox
.input DATEI.F
.output new 'U|xtbox' -encoding ABAS-S3
.copy U|xbmehr = G|FALSE
.set SEPARATOR #
'G|kommandochar'box Hinweis
.file -OPEN U|xiedpmsg 'U|xtedpmsg'
.file -READ U|xiedpmsg xtext^
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL005 ? _(_(F|regmatch(U|xtext, ".*\[STATUS.*")))
.continue EL006 ? _(F|regmatch(U|xtext, ".*MSGBOX.*"))
.formula U|xtext = U|xtext>>"MSGBOX:"   ? F|regmatch(U|xtext, ".*MSGBOX:.*")
.formula U|xtext = U|xtext>>"MSGBOX]"   ? F|regmatch(U|xtext, ".*MSGBOX].*")
.formula U|xtext = F|trim(U|xtext)
.continue FI006
!EL006
.continue EL007 ? _(F|regmatch(U|xtext, ".*STATUS.*"))
.formula U|xtext = U|xtext>>"STATUS:"   ? F|regmatch(U|xtext, ".*STATUS:.*")
.formula U|xtext = U|xtext>>"STATUS]"   ? F|regmatch(U|xtext, ".*STATUS].*")
.formula U|xtext = F|trim(U|xtext)
!EL007
!FI006
'U|xtext                                                                                                                                    '
.copy U|xbmehr = G|TRUE
!EL005
.file -READ U|xiedpmsg xtext^
.continue LOOP001
!ELOP001: ==============================
.continue EL008 ? _((F|fileexists(U|xtedperr)) & (F|filenotempty(U|xtedperr)))
.set trans +
.formula U|xtext = "Fehlerdatei:"
.set trans +

'U|xtext' 'U|xtedperr'
!EL008
'G|kommandochar''G|kommandochar'
.output NEW WERF.WEG
.continue EL009 ? _(U|xbmehr)
.input 'U|xtbox'
.continue FI009
!EL009
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!FI009
.continue FI004
!EL004
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
!FI004
.continue FI003
!EL003
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
!FI003
!FI002
.continue 'xprocst.xprocsp'
!PROC003: ----- EDP_FehlerprÅfung -----
.continue EL010 ? _((_(G|mehr)) ; (F|empty(U|xtedpout)))
.copy U|xbfehler = G|TRUE
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
!EL010
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.system 'U|xtsys' BACKGROUND
.continue EL011 ? _(G|mehr)
.continue EL012 ? _(F|filenotempty(U|xtedperr))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC003
!RET006
.formula xprocsp = xprocsp - 1
.continue FI012
!EL012
.copy U|xbfehler = G|FALSE
!FI012
.continue FI011
!EL011
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC003
!RET007
.formula xprocsp = xprocsp - 1
!FI011
.continue EL013 ? _((U|xbhinweis) & (F|fileexists(U|xtedpmsg)))
.continue EL014 ? _(F|filenotempty(U|xtedpmsg))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC002
!RET008
.formula xprocsp = xprocsp - 1
!EL014
!EL013
.continue
