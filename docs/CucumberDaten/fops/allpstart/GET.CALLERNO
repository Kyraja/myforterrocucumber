..!interpreter english noabbrev
..*****************************************************************************
.. Name           : allpstart/GET.CALLERNO
.. Date           : 11.02.2015
.. Version        : 
.. Author         : ts
.. Copyright      : (c) 1990 - 2015 alltrotec GmbH
.. Functionality  : Zeitstempel des Aufrufers ermitteln
..*****************************************************************************
..
.type text xytaufrufernr                ? _F|defined(U|xytaufrufernr)
.type text xytzeitstempel               ? _F|defined(U|xytzeitstempel)
.type text xyttempfile1                 ? _F|defined(U|xyttempfile1)
.type text xyttempfile2                 ? _F|defined(U|xyttempfile2)
..
..*****************************************************************************
..
.set trans -
..
.file -tempname U|xyttempfile1
.file -tempname U|xyttempfile2
.formula U|xytzeitstempel = ""
..
..wenn leer dan aktuellen Aufrufer
.copy U|xytaufrufernr = G|aufrufernr    ? F|empty(U|xytaufrufernr)
..
..prfen ob der aufrufer noch angemeldet ist
.system 'F|expr("grep $" + G|apostroph + ".*\t.*\t.*\t.*\t" + U|xytaufrufernr + "\t" + G|apostroph + " pa.dat >" + U|xyttempfile1)' background
.continue                               ? _G|mehr
..
.system 'F|expr("awk " + G|apostroph + "BEGIN { FS=" + G|dblquote + "\t" + G|dblquote + " ; OFS=" + G|dblquote + ";" + G|dblquote + " } ; { print $10 }" + G|apostroph + " " + U|xyttempfile1 + " >" + U|xyttempfile2)' background
.continue                               ? _G|mehr
..
.select from
.select from 'U|xyttempfile2' U|xytzeitstempel^
..
..
.continue
