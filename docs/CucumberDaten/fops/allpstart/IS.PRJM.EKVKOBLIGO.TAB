..!interpreter english declaration noabbrev
.. at 2016-08-29, 11:36
.set TRANS -
..========================================================================
..==  Name              : IS.PRJM.EKVKOBLIGO.TAB
..==  Pfad              : allpstart
..==  Funktion          : Tabellen FOP
..==  Erstellungsdatum  : 04.04.2012
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2016 alltrotec GmbH
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsel         ? _F|defined(U|xtsel)
.type text    xtmerkaupos   ? _F|defined(U|xtmerkaupos)
.type realx   xxkurs        ? _F|defined(U|xxkurs)
.type integer xprocsp       ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yprojekt=="          + H|id
.formula U|xtsel = U|xtsel + ";ybezugsdatum<="      + M|ystichtag:8
.continue EL001 ? _(F|defined(M|yprjmekobligo))
.formula U|xtsel = U|xtsel + ";yekvk==(69)"
.formula U|xtsel = U|xtsel + ";ykuli=="             + M|ylief^id        ? _F|empty(M|ylief)
.formula U|xtsel = U|xtsel + ";yprjmppvorgang=="    + M|ypvorgang^id    ? _F|empty(M|ypvorgang)
.formula U|xtsel = U|xtsel + ";yprjmparbpaket=="    + M|yarbpaket^id    ? _F|empty(M|yarbpaket)
.formula U|xtsel = U|xtsel + ";yprjmpekposid=="     + M|ybevor^id       ? _F|empty(M|ybevor)
.formula U|xtsel = U|xtsel + ";yprjmpekposid=="     + M|yumvor^id       ? _F|empty(M|yumvor)
!EL001
.continue EL002 ? _(F|defined(M|yprjmvkobligo))
.formula U|xtsel = U|xtsel + ";yekvk==(86)"
.formula U|xtsel = U|xtsel + ";yevkovom="   + M|ybeldatvon:8 + "!" + M|ybeldatbis:8     ? _F|empty(M|ybeldatvon) ; _F|empty(M|ybeldatbis)
!EL002
.formula U|xtsel = U|xtsel + ";@filingmode=(Active);@order=yaupos,ybezugsdatum.(Backwards)"
.continue                                                       ? _M|ybposoffen & _M|ybposabgelegt
.load 0 group 'U|xydbgrvkstat' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy    U|xbok        = G|false
.formula U|xtmerkaupos = ""
.continue EL003 ? _(_(U|xtmerkaupos = 0|yaupos))
.formula U|xtmerkaupos       = 0|yaupos
.continue EL004 ? _((F|empty(0|yablagen)) & (0|ybezugsdatum = M|ystichtag))
.copy U|xbok = G|true   ? M|ybposoffen
.continue FI004
!EL004
.continue EL005 ? _((_(F|empty(0|yablagen))) & (M|ybposabgelegt))
.load 9 group "3:2" '0|yaupos'
.continue EL006 ? _(G|mehr)
.continue EL007 ? _(('9|kotyp(L=":")' = "(SalesOrder)") & (9|artikel^id = 0|yartex^id))
.copy U|xbok = G|true
!EL007
!EL006
!EL005
!FI004
.continue EL008 ? _((U|xbok) & (0|yevtypa <> G|SUPOS) & (0|yevtypa <> G|ZSPOS) & (0|yevtypa <> G|ESPOS) & (0|yevtypa <> G|STPOS) & (0|yevtypa <> G|SIPOS) & (0|yevtypa <> G|TRPOS) & ('0|yzptyp(L="0")' <> "(27)") & ('0|yzptyp(L="0")' <> "(28)"))
.make screen line +O
.assign  M|ytekvkstat   = 0|id
.formula M|ytbuaktion   = "icon:view"
.assign  M|ytekvkpos    = 0|yaupos
.copy    M|ytverantwkst = H|yverantwkst
.assign  M|ytprojekt    = H|id
.formula M|ytprojname   = H|namebspr
.copy    M|ytarbpaket   = 0|yprjmparbpaket              ?  F|defined(M|ytarbpaket)
.formula M|ytliefname   = 0|ykuli^namebspr              ?  F|defined(M|ytliefname)
.formula M|ytkopf       = 0|yauftrag
.formula M|ytvom        = 0|yevkovom
.formula M|ytfrzeich    = M|ytkopf^frzeich
.formula M|ytbetreff    = M|ytkopf^betreff
.copy    M|ytartex      = 0|yartex
.formula M|yttename     = 0|yartex^namebspr
.formula M|ytptext      = 0|yevptext
.formula M|ytmge        = 0|ymge
.copy    M|yteinh       = 0|yhe                           ? _F|empty(0|yhe)
.formula M|ytoffremge   = 0|yremge - 0|ykorrremge
.formula M|ytofflimge   = 0|ylimge - 0|ykorrlimge
.formula M|ytepreis     = 0|ypreis
.formula M|ytpnum       = 0|yevpnum
.copy    M|ytalternativpos = 0|yalternativpos           ? F|defined(M|ytalternativpos)
.formula M|ytalternativgrp = 0|yalternativgrp           ? F|defined(M|ytalternativgrp)
.copy    M|ytbrutto     = 0|ybrutto
.formula M|ytbudgetwert = 0|ybudgetwert                 ?  F|defined(M|ytbudgetwert)
.copy    M|ytpvorgang   = 0|yprjmppvorgang              ?  F|defined(M|ytpvorgang)
.formula U|xxkurs = 1                               ?  0|ypland = G|inland
.formula U|xxkurs = F|fxrate(G|inland, ,0|ypland)   ? _0|ypland = G|inland & _0|ykursfix
.formula U|xxkurs = 0|yewkurs                       ? _0|ypland = G|inland &  0|ykursfix
.formula M|ytpwert      = 0|ypwert * U|xxkurs
.formula M|ytnwert      = 0|ynwert * U|xxkurs
.formula M|ytostwert    = 0|ypwert              * U|xxkurs              ? _0|ybrutto
.formula M|ytostwert    =(0|ypwert - 0|ystwert) * U|xxkurs              ?  0|ybrutto
.continue EL009 ? _(F|defined(M|yteigenleist))
.formula M|yteigenleist    = 0|yeigenanteil * U|xxkurs
.formula M|ytfremdleist    = 0|yfremdanteil * U|xxkurs
.formula M|ytsonstkost     = 0|ysonstkost   * U|xxkurs
.formula M|ytfertleist     = 0|yfertleist   * U|xxkurs
.formula M|ytosteigenleist = 0|yeigenanteil                            * U|xxkurs   ? _0|ybrutto
.formula M|ytosteigenleist =(0|yeigenanteil / (1 + (0|ystsatz / 100))) * U|xxkurs   ?  0|ybrutto
.formula M|ytostfremdleist = 0|yfremdanteil                            * U|xxkurs   ? _0|ybrutto
.formula M|ytostfremdleist =(0|yfremdanteil / (1 + (0|ystsatz / 100))) * U|xxkurs   ?  0|ybrutto
.formula M|ytostsonstkost  = 0|ysonstkost                              * U|xxkurs   ? _0|ybrutto
.formula M|ytostsonstkost  =(0|ysonstkost   / (1 + (0|ystsatz / 100))) * U|xxkurs   ?  0|ybrutto
.formula M|ytostfertleist  = 0|yfertleist                              * U|xxkurs   ? _0|ybrutto
.formula M|ytostfertleist  =(0|yfertleist   / (1 + (0|ystsatz / 100))) * U|xxkurs   ?  0|ybrutto
!EL009
.continue EL010 ? _(F|defined(M|yfcwertbeachten))
.continue EL011 ? _((0|ypwert = 0) & (M|yfcwertbeachten))
.formula M|ytpwert      = 0|yprjmpfcwert
.formula M|ytnwert      = 0
.formula M|ytostwert    = 0
!EL011
!EL010
.continue EL012 ? _((F|defined(M|ytoffremge)) & (F|defined(M|ytofflimge)))
.continue EL013 ? _(0|ymge = 0)
.formula M|ytofflimge  = M|ytofflimge * U|xxkurs
.formula M|ytoffremge  = M|ytoffremge * U|xxkurs
.continue EL014 ? _(0|ypwert = 0)
.formula M|ytoffliwert = M|ytofflimge
.formula M|ytoffrewert = M|ytoffremge
.continue FI014
!EL014
.formula M|ytoffliwert = 0|ynwert / 0|ypwert * M|ytofflimge
.formula M|ytoffrewert = 0|ynwert / 0|ypwert * M|ytoffremge
!FI014
.continue FI013
!EL013
.formula M|ytoffliwert = 0|ynwert / 0|ymge * M|ytofflimge * U|xxkurs
.formula M|ytoffrewert = 0|ynwert / 0|ymge * M|ytoffremge * U|xxkurs
!FI013
!EL012
.continue EL015 ? _((F|defined(M|ytreowert)) & (F|defined(M|ytliowert)))
.formula M|ytreowert = M|ytoffrewert     ?  M|ytoffrewert > 0
.formula M|ytliowert = M|ytoffliwert     ?  M|ytoffliwert > 0
.continue EL016 ? _(F|defined(M|yfcwertbeachten))
.continue EL017 ? _((0|ypwert = 0) & (M|yfcwertbeachten))
.formula M|ytreowert = 0|yprjmpfcwert + M|ytoffrewert
!EL017
!EL016
!EL015
!EL008
!EL003
.load 0 continue
.continue LOOP001
!ELOP001: ==============================
.input 'F|foppath("IFOP.IS.PRJM.EKVKOBLIGO.TAB")'   ? F|fileexists(F|foppath("IFOP.IS.PRJM.EKVKOBLIGO.TAB"))
.continue
