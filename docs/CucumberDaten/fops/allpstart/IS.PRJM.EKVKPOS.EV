..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtcmd xtsel xtftext xykoobjekt xtid xysel
.type real    xrnwert xrmge xrofflimge xroffliwert xroffremge xroffwert xrliowert xrreowert
.type real    xrpwert   xreigenleist    xrfremdleist    xrsonstkost     xrfertleist
.type real    xrostwert xrosteigenleist xrostfremdleist xrostsonstkost  xrostfertleist
.type bool    xyberlaubt xbok xybnoprsel
.type GD      xdstichtag
.type GD19    xdbis
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set  DEMAND -
..====================================================
.continue EPROCDEF
!PROC001: ----- Summenzeile -----
.continue EL001 ? _(M|tzeilen > 0)
.input is/ABASFARBEN.DEF
.formula U|xrpwert         = 0
.formula U|xrnwert         = 0
.formula U|xrostwert       = 0
.formula U|xroffliwert     = 0
.formula U|xrreowert       = 0
.formula U|xrliowert       = 0
.formula U|xroffwert       = 0
.formula U|xreigenleist    = 0
.formula U|xrfremdleist    = 0
.formula U|xrsonstkost     = 0
.formula U|xrfertleist     = 0
.formula U|xrosteigenleist = 0
.formula U|xrostfremdleist = 0
.formula U|xrostsonstkost  = 0
.formula U|xrostfertleist  = 0
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.copy U|xbok =  G|TRUE              ? _F|defined(M|ytalternativpos)
.copy U|xbok = _M|ytalternativpos   ?  F|defined(M|ytalternativpos)
.continue EL002 ? _(U|xbok)
.formula U|xrpwert         = U|xrpwert         + M|ytpwert
.formula U|xrnwert         = U|xrnwert         + M|ytnwert
.formula U|xrostwert       = U|xrostwert       + M|ytostwert
.formula U|xroffliwert     = U|xroffliwert     + M|ytoffliwert      ?  F|defined(M|ytoffliwert)
.formula U|xrreowert       = U|xrreowert       + M|ytreowert        ?  F|defined(M|ytreowert)
.formula U|xrliowert       = U|xrliowert       + M|ytliowert        ?  F|defined(M|ytliowert)
.formula U|xroffwert       = U|xroffwert       + M|ytoffwert        ?  F|defined(M|ytoffwert)
.formula U|xreigenleist    = U|xreigenleist    + M|yteigenleist     ?  F|defined(M|yteigenleist)
.formula U|xrfremdleist    = U|xrfremdleist    + M|ytfremdleist     ?  F|defined(M|ytfremdleist)
.formula U|xrsonstkost     = U|xrsonstkost     + M|ytsonstkost      ?  F|defined(M|ytsonstkost)
.formula U|xrfertleist     = U|xrfertleist     + M|ytfertleist      ?  F|defined(M|ytfertleist)
.formula U|xrosteigenleist = U|xrosteigenleist + M|ytosteigenleist  ?  F|defined(M|ytosteigenleist)
.formula U|xrostfremdleist = U|xrostfremdleist + M|ytostfremdleist  ?  F|defined(M|ytostfremdleist)
.formula U|xrostsonstkost  = U|xrostsonstkost  + M|ytostsonstkost   ?  F|defined(M|ytostsonstkost)
.formula U|xrostfertleist  = U|xrostfertleist  + M|ytostfertleist   ?  F|defined(M|ytostfertleist)
!EL002
.select screen line
.continue LOOP001
!ELOP001: ==============================
.select screen header
.make screen line +
.formula M|ytpwert         = U|xrpwert
.formula M|ytnwert         = U|xrnwert              ?  F|defined(M|ytnwert)
.formula M|ytostwert       = U|xrostwert
.formula M|ytoffliwert     = U|xroffliwert          ?  F|defined(M|ytoffliwert)
.formula M|ytreowert       = U|xrreowert            ?  F|defined(M|ytreowert)
.formula M|ytliowert       = U|xrliowert            ?  F|defined(M|ytliowert)
.formula M|ytoffwert       = U|xroffwert            ?  F|defined(M|ytoffwert)
.formula M|yteigenleist    = U|xreigenleist         ?  F|defined(M|yteigenleist)
.formula M|ytfremdleist    = U|xrfremdleist         ?  F|defined(M|ytfremdleist)
.formula M|ytsonstkost     = U|xrsonstkost          ?  F|defined(M|ytsonstkost)
.formula M|ytfertleist     = U|xrfertleist          ?  F|defined(M|ytfertleist)
.formula M|ytosteigenleist = U|xrosteigenleist      ?  F|defined(M|ytosteigenleist)
.formula M|ytostfremdleist = U|xrostfremdleist      ?  F|defined(M|ytostfremdleist)
.formula M|ytostsonstkost  = U|xrostsonstkost       ?  F|defined(M|ytostsonstkost)
.formula M|ytostfertleist  = U|xrostfertleist       ?  F|defined(M|ytostfertleist)
.colour -background "144 238 144" 'M|aktzeile'
.colour -foreground "112 206 112" ytmge      'M|aktzeile'   ? F|defined(M|ytmge)
.colour -foreground "112 206 112" ytepreis   'M|aktzeile'   ? F|defined(M|ytepreis)
.colour -foreground "112 206 112" ytofflimge 'M|aktzeile'   ? F|defined(M|ytofflimge)
.colour -foreground "112 206 112" ytoffremge 'M|aktzeile'   ? F|defined(M|ytoffremge)
!EL001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.copy M|ybposoffen    = G|TRUE
.copy M|ybposgebucht  = G|TRUE  ? F|defined(M|ybposgebucht)
.copy M|ybposabgelegt = G|TRUE
.continue EL003 ? _(F|defined(M|yarbpaket))
.protection yarbpaket 0         ? F|empty(M|yprojekt)
!EL003
.continue EL004 ? _(F|defined(M|ystichtag))
.formula U|xdstichtag = ('G|datum:8')<<6     + "01"
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula M|ystichtag  =  U|xdstichtag - 1
!EL004
.input allpstart/FOP.PRJM.UP.LOADCONFIG ? _F|defined(5|ypmwipperiode)
.formula P|maskkontextfop = P|maskkontextfop + " " + "BUDGET"       ?  5|ypmwipbudget
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldfuell")
.continue BRK003 ? _(G|evtvar = "ypvorgang")
.copy    U|xybnoprsel = G|TRUE
.formula U|xysel = ""
.formula U|xysel = U|xysel + ";.yprojekt=="  + M|yprojekt^id    ? _F|empty(M|yprojekt)
.continue EL005 ? _(F|defined(M|yarbpaket))
.formula U|xysel = U|xysel + ";.yarbpaket==" + M|yarbpaket^id   ? _F|empty(M|yarbpaket)
!EL005
.formula U|xysel = U|xysel + ";yreftyp="
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "yarbpaket")
.input "allpstart/FOP.PRJM.UP.SELCHECK.FF"
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "yprojekt")
.input 'U|xtupprjmsel'
.continue EL006 ? _(_(F|empty(M|yprojekt)))
.protection -reset yarbpaket   0        ? F|defined(M|yarbpaket)
.protection -reset ybapdiffanz 0        ? F|defined(M|ybapdiffanz)
.continue FI006
!EL006
.protection yarbpaket   0       ? F|defined(M|yarbpaket)
.protection ybapdiffanz 0       ? F|defined(M|ybapdiffanz)
!FI006
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "yprojleit")
.input 'U|xtupprjmsel'
.continue EL007 ? _(F|empty(M|yprojekt))
.protection yarbpaket 0     ? F|defined(M|yarbpaket)
.continue FI007
!EL007
.cursor yarbpaket 0     ? F|defined(M|yarbpaket)
!FI007
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "yballekst")
.input 'U|xtupprjmsel'
.continue EL008 ? _((F|defined(M|yarbpaket)) & (F|empty(M|yprojekt)))
.formula M|yarbpaket = ""
!EL008
.continue EL009 ? _(F|empty(M|yprojekt))
.protection yarbpaket 0     ? F|defined(M|yarbpaket)
.continue FI009
!EL009
.cursor yarbpaket 0     ? F|defined(M|yarbpaket)
!FI009
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "ypvorgang")
.input 'U|xtupprjmsel'
.continue EL010 ? _(_(F|empty(M|ypvorgang)))
.continue EL011 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = M|ypvorgang^yprojekt^yverantwkst^id
.input 'U|xypmrepruefkstprog'
.continue EL012 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fr dieses Projekt.
.set TRANS -
.formula M|yprojekt  = ""
.formula M|ypvorgang = ""
.continue
!EL012
!EL011
.continue EL013 ? _(U|xypmrepruefktr)
.formula U|xykoobjekt = M|ypvorgang^yprojekt^yktr^id
.input 'U|xypmrepruefktrprog'
.continue EL014 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fr dieses Projekt.
.set TRANS -
.formula M|yprojekt  = ""
.formula M|ypvorgang = ""
.continue
!EL014
!EL013
.continue EL015 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL016 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fr dieses Projekt.
.set TRANS -
.formula M|yprojekt  = ""
.formula M|ypvorgang = ""
.continue
!EL016
!EL015
!EL010
.continue EL017 ? _(_(F|empty(M|ypvorgang)))
.copy    M|yballekst  = G|true
.assign  M|yarbpaket  = ""          ? F|defined(M|yarbpaket)
.copy    M|yprojekt   = M|ypvorgang^yprojekt
!EL017
.continue ESAC003
!BRK009
.continue BRK010 ? _(G|evtvar = "yarbpaket")
.continue EL018 ? _(_(F|empty(M|yarbpaket)))
.copy M|ybapdiffanz = G|FALSE   ? F|defined(M|ybapdiffanz)
!EL018
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "ybapdiffanz")
.continue EL019 ? _(M|ybapdiffanz)
.formula M|yarbpaket = ""               ? F|defined(M|yarbpaket)
.formula M|yapname   = ""               ? F|defined(M|yapname)
!EL019
.continue ESAC003
!BRK011
.continue BRK012 ? _(G|evtvar = "ypvbesch")
.formula M|ypvbname = M|ypvbesch^namebspr
.continue ESAC003
!BRK012
.continue BRK013 ? _(G|evtvar = "ybevor")
.formula M|ybvptext = M|ybevor^ptext
.continue ESAC003
!BRK013
.continue BRK014 ? _(G|evtvar = "yumvor")
.formula M|yumptext = M|yumvor^ptext
.continue ESAC003
!BRK014
.continue BRK015 ? _(G|evtvar = "yvonbudat")
.continue EL020 ? _(_(F|empty(M|yvonbudat)))
.formula U|xdbis     = ">" + 'F|year(M|yvondatum)' + "Y" + 'F|month(M|yvondatum)' + "M"
.formula M|ybisbudat = U|xdbis
!EL020
.continue ESAC003
!BRK015
.continue BRK016 ? _(G|evtvar = "ybisbudat")
.continue EL021 ? _((M|ybisbudat < M|yvonbudat) & (_(F|empty(M|ybisbudat))))
.formula U|xdbis     = ">" + 'F|year(M|yvondatum)' + "Y" + 'F|month(M|yvondatum)' + "M"
.formula M|ybisbudat = U|xdbis
!EL021
.continue ESAC003
!BRK016
.continue BRK017 ? _(G|evtvar = "ystichtag")
.formula U|xdstichtag = ('M|ystichtag:8')<<6 + "01"     ? _F|empty(M|ystichtag)
.formula U|xdstichtag = ('G|datum:8')<<6     + "01"     ?  F|empty(M|ystichtag)
.formula U|xdstichtag = U|xdstichtag + 31
.formula U|xdstichtag = ('U|xdstichtag:8')<<6 + "01"
.formula M|ystichtag  =  U|xdstichtag - 1
.continue ESAC003
!BRK017
.input 'U|xtupprjmsel'
!ESAC003: =====   ENDCASE   =====
.make screen line --O
.continue ESAC001
!BRK005
.continue BRK018 ? _(G|evtart = "buttonvor")
.continue BRK019 ? _(G|evtvar = "bstart")
.make screen line --O
.continue ESAC004
!BRK019
!ESAC004: =====   ENDCASE   =====
.continue ESAC001
!BRK018
.continue BRK020 ? _(G|evtart = "buttonnach")
.continue BRK021 ? _(G|evtvar = "bstart")
.file -TEMPNAME U|xtftext
.input DATEI.F
.input 'U|xtupprjmsel'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK021
!ESAC005: =====   ENDCASE   =====
.continue ESAC001
!BRK020
.continue BRK022 ? _(G|evtart = "zeilebewvor")
.continue EL022 ? _(M|tzeilen > 0)
.select screen line 1
.make screen line -
!EL022
.continue ESAC001
!BRK022
.continue BRK023 ? _(G|evtart = "zeilebewnach")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK023
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJM.EKVKPOS.EV")'   ? F|fileexists(F|foppath("IFOP.IS.PRJM.EKVKPOS.EV"))
.continue
