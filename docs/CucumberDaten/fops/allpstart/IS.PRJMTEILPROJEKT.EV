..!interpreter english declaration noabbrev
.. at 2017-06-16, 15:33
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMTEILPROJEKT.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 15.11.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xttitel xttext1 xttext2
.type P86:1   xpproject
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Tabelle_laden -----
.continue EL001 ? _((_(F|empty(M|yprojekt))) ; (_(F|empty(M|ykhpprojleit))) ; (_(F|empty(M|yktpprojleit))))
.load 5 add F|sysinfo(10)^ykonfigprjm
.make screen line --O
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yteilprojektzu=="           + M|yprojekt^id        ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";yteilprojektzu^yprojleit==" + M|ykhpprojleit^id    ? _F|empty(M|ykhpprojleit) &  F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";yprojleit=="                + M|yktpprojleit^id    ? _F|empty(M|yktpprojleit) &  F|empty(M|yprojekt)
.select group 'U|xydbgrprojekt' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL002 ? _(_(F|empty(H|yteilprojektzu)))
.make screen line +O
.assign  M|yteilprojekt = H|id
.formula M|ytpname      = H|namebspr
.copy    M|ytpprojleit  = H|yprojleit
.formula M|ytpplname    = M|ytpprojleit^namebspr
.assign  M|ytpstatus    = H|ystatus
.formula M|yttpvorwert  = H|ytpvorwert
.formula M|yttpwert     = H|ytpwert
.copy    M|ytpktrbuch   = H|yktr
.copy    M|ytpktrverd   = H|yktr^verd
.continue EL003 ? _((H|yablage) ; (H|ystatusk = "FTAB") ; (H|ystatusk = "ABS") ; (H|ystatusk = "08"))
.protection yttpvorwert 'M|aktzeile'
!EL003
!EL002
.select continue
.continue LOOP001
!ELOP001: ==============================
.continue FI001
!EL001
.set TRANS +
.box Hinweis
Bitte zuerst ein Projekt oder Projektleiter angeben.
.set TRANS -
.cursor yprojekt 0
.error
.end 1
!FI001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskende")
.end 1          ? M|ybmaskezu
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "buttonnach")
.continue BRK003 ? _(G|evtvar = "bstart")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar = "ybutpneu")
.continue EL004 ? _(_(F|empty(M|yprojekt)))
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL005 ? _(((M|yprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabprueftproj))) ; (((M|yprojekt^ystatusk = "ABS") ; (M|yprojekt^ystatusk = "08") ; (M|yprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabprueftproj))))
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xttext1 = F|formatstr("Das Projekt {1} hat den Status {2}{3}{2}.", M|yprojekt^such, G|dblquote, M|yprojekt^ystatus)
.formula U|xttext2 = "Es dÅrfen keine Teilprojekte mehr zu diesem Projekt erfasst werden!"
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.continue
.continue FI005
!EL005
.input 'U|xtupprojanlage'
.formula U|xtsel = "$,,yextid==" + U|xtextid + ";@filingmode=(Active)"
.load 0 group "86:1" 'U|xtsel'
.continue EL006 ? _(_(G|mehr))
.set TRANS +
.box Fehler
Das Projekt konnte nicht angelegt werden.
.set TRANS -
.error
.end 1
!EL006
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!FI005
!EL004
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK002
.continue BRK005 ? _(G|evtart = "feldaus")
.continue BRK006 ? _(G|evtvar = "yprojekt")
.input 'U|xtupprjmsel'
.make screen line --O
.continue EL007 ? _(_(F|empty(M|yprojekt)))
.copy    M|ykhpprojleit = M|yprojekt^yprojleit
.assign  M|yktpprojleit = ""
!EL007
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ykhpprojleit")
.input 'U|xtupprjmsel'
.make screen line --O
.assign  M|yprojekt = ""
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "yktpprojleit")
.input 'U|xtupprjmsel'
.make screen line --O
.assign  M|yprojekt = ""
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "yttpvorwert")
.continue EL008 ? _(_(F|empty(M|yteilprojekt)))
.select lock add M|yteilprojekt
.continue EL009 ? _(G|mehr)
.formula H|ytpvorwert = M|yttpvorwert
.rewrite
.continue FI009
!EL009
.set TRANS +
.box Fehler
Das Teilprojekt 'M|yteilprojekt^such' kann nicht bearbeitet werden.
Speichern des Wertes nicht mîglich.
.set TRANS -
!FI009
!EL008
.continue ESAC003
!BRK009
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK005
.continue BRK010 ? _(G|evtart = "zeileeinvor")
.error
.end 1
.continue ESAC001
!BRK010
.continue BRK011 ? _(G|evtart = "zeileloevor")
.error
.end 1
.continue ESAC001
!BRK011
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMTEILPROJEKT.EV")'    ? F|fileexists(F|foppath("IFOP.IS.PRJMTEILPROJEKT.EV"))
.continue
