..!interpreter english declaration noabbrev
.. at 2016-09-01, 14:02
.set TRANS -
..========================================================================
..==  Name              : IS.PRJMADMEKVKVORG.EV
..==  Pfad              : allpstart
..==  Funktion          : Korrektur EK / VK Vorg„nge
..==  Erstellungsdatum  : 28.06.2016
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
..====================================================
.type text    xtsys xtsel xtcmd xtid xtedpdat xtedpout xtedperr xtedpmsg
.type GD      xdatum
.type bool    xbhinweis
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Schreibschutz_Zeile -----
.continue EL001 ? _(_('M|yekvk(L="0")' = "(86)"))
.protection yteigenanteil     'M|aktzeile'
.protection ytfremdanteil     'M|aktzeile'
.protection ytsonstkost       'M|aktzeile'
.protection ytfertleist       'M|aktzeile'
.protection ytnullrechnung    'M|aktzeile'
.protection ytnabrechrelev    'M|aktzeile'
!EL001
.continue EL002 ? _(_('M|yekvk(L="0")' = "(69)"))
.protection ytprjmppvorgang 'M|aktzeile'
.protection ytprjmparbpaket 'M|aktzeile'
!EL002
.continue 'xprocst.xprocsp'
!PROC002: ----- EK_VK -----
.continue BRK001 ? _('M|yekvk(L="0")' = "(86)")
.formula P|maskkontextfop = " VK "
.continue ESAC001
!BRK001
.continue BRK002 ? _('M|yekvk(L="0")' = "(69)")
.formula P|maskkontextfop = " EK "
.continue ESAC001
!BRK002
.formula P|maskkontextfop = ""
!ESAC001: =====   ENDCASE   =====
.formula M|select = ""
.continue 'xprocst.xprocsp'
!PROC003: ----- Tabelle_laden -----
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL003 ? _((H|typ = G|ARPOS) ; (H|typ = G|ZUPOS) ; (H|typ = G|PRPOS))
.make screen line +O
.assign  M|ytvorpos          = H|id
.assign  M|ytvorgang         = H|kopf^id
.copy    M|ytprojekt         = H|projekt
.formula M|ytprojname        = M|ytprojekt^namebspr
.formula M|ytpnum            = H|pnum
.formula M|ytptext           = H|ptext
.copy    M|ytartex           = H|artex
.formula M|ytartname         = H|artex^namebspr
.copy    M|ytpwert           = H|pwert
.copy    M|ytpland           = H|pland
.continue EL004 ? _(H|dnr = 3)
.assign  M|ytkuli            = H|kunde^id
.formula M|ytklname          = M|ytkuli^sucherw
.copy    M|yteigenanteil     = H|yprjmpeigenleist
.copy    M|ytfremdanteil     = H|yprjmpfremdleist
.copy    M|ytsonstkost       = H|yprjmpsonstkost
.copy    M|ytfertleist       = H|yprjmpfertleist
.copy    M|ytnullrechnung    = H|yprjmpnullrechnung
.copy    M|ytnabrechrelev    = H|yprjmpnabrechrelev
!EL004
.continue EL005 ? _(H|dnr = 4)
.assign  M|ytkuli            = H|lief^id
.formula M|ytklname          = M|ytkuli^sucherw
.copy    M|ytprjmppvorgang   = H|yprjmppvorgang
.copy    M|ytprjmparbpaket   = H|yprjmparbpaket
!EL005
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.colour -BACKGROUND "-1 -1 -1" 'M|aktzeile'
!EL003
.select continue
.continue LOOP001
!ELOP001: ==============================
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK003 ? _(G|evtart = "maskein")
.assign M|yekvk = "(86)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtart = "buttonnach")
.continue BRK005 ? _(G|evtvar = "bstart")
.continue EL006 ? _(_(F|empty(M|yekvk)))
.continue EL007 ? _((M|select = "!") ; (F|empty(M|select)))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";kopf=="       + M|yvorgang^id    ? _F|empty(M|yvorgang)
.formula U|xtsel = U|xtsel + ";projekt==" + M|yprojekt^id    ? _F|empty(M|yprojekt)
.formula U|xtsel = U|xtsel + ";kunde=="      + M|ykuli^id       ? _F|empty(M|ykuli) & 'M|yekvk(L="0")' = "(86)"
.formula U|xtsel = U|xtsel + ";lief=="       + M|ykuli^id       ? _F|empty(M|ykuli) & 'M|yekvk(L="0")' = "(69)"
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.continue FI007
!EL007
.formula U|xtsel = M|select
!FI007
.make screen line --O
.select group "P3:2" 'U|xtsel'  ? 'M|yekvk(L="0")' = "(86)"
.select group "P4:2" 'U|xtsel'  ? 'M|yekvk(L="0")' = "(69)"
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC003
!RET003
.formula xprocsp = xprocsp - 1
.continue FI006
!EL006
.set TRANS +
.box Hinweis
Bitte zuerst Ein-/Verkauf w„hlen.
.set TRANS -
!FI006
.continue ESAC003
!BRK005
.continue BRK006 ? _(G|evtvar = "ybuspeichern")
.input "is/ABASFARBEN.DEF"
.copy U|xbhinweis = G|TRUE
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL008 ? _(M|ytbspeichern)
.continue EL009 ? _(_(F|empty(M|ytvorpos)))
.select lock add M|ytvorpos
.continue EL010 ? _(G|mehr)
.continue EL011 ? _(H|dnr = 3)
.formula H|yprjmpeigenleist   = M|yteigenanteil
.formula H|yprjmpfremdleist   = M|ytfremdanteil
.formula H|yprjmpsonstkost    = M|ytsonstkost
.formula H|yprjmpfertleist    = M|ytfertleist
.copy    H|yprjmpnullrechnung = M|ytnullrechnung
.copy    H|yprjmpnabrechrelev = M|ytnabrechrelev
!EL011
.continue EL012 ? _(H|dnr = 4)
.copy    H|yprjmppvorgang     = M|ytprjmppvorgang
.copy    H|yprjmparbpaket     = M|ytprjmparbpaket
!EL012
.rewrite
.select -
.continue EL013 ? _(_(M|ytvorpos^projekt^id = M|ytprojekt^id))
.file -TEMPNAME U|xtedpdat
.file -TEMPNAME U|xtedpout
.file -TEMPNAME U|xtedperr
.file -TEMPNAME U|xtedpmsg
.output new 'U|xtedpdat'
.input DATEI.F
#!database='M|ytvorpos^dnr'
#!action=update
#!EDP_LANGCODE='G|bsprache'

id\
zeilenop;projekt;

'M|ytvorpos^kopf^id'\
'M|ytvorpos^id';'M|ytprojekt^id';
.formula U|xtsys = "edpimport.sh -c EKS -o UPDATEMODE=STRICT -p " + G|einmalpw
.formula U|xtsys = U|xtsys + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.input "allpstart/FOP.ALL.EDP.CHECK"
.continue EL014 ? _(U|xbfehler)
.colour -BACKGROUND 'U|xabasred' 'M|aktzeile'
.continue FI014
!EL014
.copy    M|ytbspeichern     = G|FALSE
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
!FI014
.continue FI013
!EL013
.copy    M|ytbspeichern     = G|FALSE
.colour -BACKGROUND 'U|xabaslightgreen' 'M|aktzeile'
!FI013
.continue FI010
!EL010
.colour -BACKGROUND 'U|xabasred' 'M|aktzeile'
!FI010
.continue FI009
!EL009
.colour -BACKGROUND 'U|xabasred' 'M|aktzeile'
!FI009
!EL008
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ybuselect")
.assign  M|yprojekt  = ""
.assign  M|yvorgang  = ""
.formula M|ybetreff  = ""
.assign  M|ykuli     = ""
.formula M|yklname   = ""
.make screen line --O
.formula U|xtsel = "%,,kopf=;kotyp=;artex=;projekt=;konto=;kstelle="
.formula U|xtsel = U|xtsel + ";kunde="      ? 'M|yekvk(L="0")' = "(86)"
.formula U|xtsel = U|xtsel + ";lief="       ? 'M|yekvk(L="0")' = "(69)"
.formula U|xtsel = U|xtsel + ";@bereich=(1)"
.select group "P3:2" 'U|xtsel'              ? 'M|yekvk(L="0")' = "(86)"
.select group "P4:2" 'U|xtsel'              ? 'M|yekvk(L="0")' = "(69)"
.continue EL015 ? _((_(G|mehr)) ; (G|selkrit = ""))
.formula M|select = "!"
.continue FI015
!EL015
.formula M|select = "$" + (G|selrohl<<-1) + G|selkrit
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC003
!RET004
.formula xprocsp = xprocsp - 1
!FI015
.continue ESAC003
!BRK007
!ESAC003: =====   ENDCASE   =====
.continue ESAC002
!BRK004
.continue BRK008 ? _(G|evtart = "feldfuell")
.continue BRK009 ? _(G|evtvar = "yvorgang")
.continue EL016 ? _((_(F|empty(G|evtfeldneu))) & (_(G|evtfeldneu = "(0,0,0)")) & (_(F|regmatch(G|evtfeldneu, "\*.*"))) & (_(F|regmatch(G|evtfeldneu, "\$.*"))) & (_(F|regmatch(G|evtfeldneu, "\%.*"))))
.formula G|evtfeldneu = G|evtfeldneu>>" "   ? F|regmatch(G|evtfeldneu,".* .*")
.formula G|evtfeldneu = "?"                 ? G|evtfeldneu = "!"
.continue EL017 ? _((F|regmatch(G|evtfeldneu, "\?")) ; (F|regmatch(G|evtfeldneu, "!,.*")) ; (F|regmatch(G|evtfeldneu, "\d.*")) ; (F|regmatch(G|evtfeldneu, "[a-zA-Z].*")))
.continue EL018 ? _(_(F|empty(M|yprojekt)))
.formula U|xtsel = "$,,yprjmproj=="   + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";@noswd=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.load 1 group "P3:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(86)"; F|empty(M|yekvk)
.load 1 group "P4:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(69)"
.continue EL019 ? _(G|mehr)
.formula U|xtid = 1|id
.load 1 continue
.continue EL020 ? _(G|mehr)
.formula U|xtsel = "%,,yprjmproj=="   + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";typ="
.formula U|xtsel = U|xtsel + ";@noswd=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.formula U|xtsel = U|xtsel + ";@autostart=(Yes)"
.load 1 group "P3:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(86)"; F|empty(M|yekvk)
.load 1 group "P4:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(69)"
.formula G|evtfeldneu = M|.evtvar^id    ? _G|mehr
.formula G|evtfeldneu = 1|id            ?  G|mehr
.continue FI020
!EL020
.formula G|evtfeldneu = U|xtid
!FI020
.continue FI019
!EL019
.formula U|xtsel = "%,,yprjmproj==" + M|yprojekt^id
.formula U|xtsel = U|xtsel + ";typ="
.formula U|xtsel = U|xtsel + ";@noswd=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.formula U|xtsel = U|xtsel + ";@autostart=(Yes)"
.load 1 group "P3:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(86)"; F|empty(M|yekvk)
.load 1 group "P4:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(69)"
.formula G|evtfeldneu = M|.evtvar^id    ? _G|mehr
.formula G|evtfeldneu = 1|id            ?  G|mehr
!FI019
.continue FI018
!EL018
.formula U|xtsel = "%,,yprjmproj<>`"
.formula U|xtsel = U|xtsel + ";typ="
.formula U|xtsel = U|xtsel + ";@noswd=" + G|evtfeldneu
.formula U|xtsel = U|xtsel + ";@filingmode=(Both)"
.formula U|xtsel = U|xtsel + ";@autostart=(Yes)"
.load 1 group "P3:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(86)"; F|empty(M|yekvk)
.load 1 group "P4:1" 'U|xtsel'     ? 'M|yekvk(L="0")' = "(69)"
.formula G|evtfeldneu = M|.evtvar^id    ? _G|mehr
.formula G|evtfeldneu = 1|id            ?  G|mehr
!FI018
!EL017
!EL016
.continue ESAC004
!BRK009
!ESAC004: =====   ENDCASE   =====
.continue ESAC002
!BRK008
.continue BRK010 ? _(G|evtart = "feldaus")
.continue BRK011 ? _(G|evtvar = "yprojekt")
.assign  M|yvorgang  = ""                   ?  F|empty(M|yprojekt) ; M|yvorgang^yprjmproj^id <> M|yprojekt^id
.formula M|ybetreff  = M|yvorgang^betreff
.make screen line --O
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK011
.continue BRK012 ? _(G|evtvar = "yvorgang")
.assign  M|yekvk     = "(86)"               ? M|yvorgang^dnr = 3
.assign  M|yekvk     = "(69)"               ? M|yvorgang^dnr = 4
.copy    M|yprojekt  = M|yvorgang^yprjmproj ? _F|empty(M|yvorgang)
.formula M|ybetreff  = M|yvorgang^betreff
.make screen line --O
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK012
.continue BRK013 ? _(G|evtvar = "ykuli")
.assign  M|yekvk     = "(86)"               ? M|ykuli^dnr = 0
.assign  M|yekvk     = "(69)"               ? M|ykuli^dnr = 1
.assign  M|yprojekt  = ""
.assign  M|yvorgang  = ""
.formula M|ybetreff  = ""
.formula M|yklname   = M|ykuli^sucherw
.make screen line --O
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK013
.continue BRK014 ? _(G|evtvar = "yekvk")
.assign  M|yvorgang  = ""
.formula M|ybetreff  = ""
.assign  M|ykuli     = ""
.formula M|yklname   = ""
.make screen line --O
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC002
!RET008
.formula xprocsp = xprocsp - 1
.continue ESAC005
!BRK014
.continue BRK015 ? _(G|evtvar = "ytprojekt")
.formula M|ytprojname = M|ytprojekt^name
.continue ESAC005
!BRK015
.continue BRK016 ? _(G|evtvar = "yteigenanteil")
.formula M|ytfremdanteil = M|ytpwert - M|yteigenanteil - M|ytsonstkost - M|ytfertleist
.continue ESAC005
!BRK016
.continue BRK017 ? _(G|evtvar = "ytfremdanteil")
.formula M|yteigenanteil = M|ytpwert - M|ytfremdanteil - M|ytsonstkost - M|ytfertleist
.continue ESAC005
!BRK017
.continue BRK018 ? _(G|evtvar = "ytsonstkost")
.formula M|yteigenanteil = M|ytpwert - M|ytfremdanteil - M|ytsonstkost - M|ytfertleist
.continue ESAC005
!BRK018
.continue BRK019 ? _(G|evtvar = "ytfertleist")
.formula M|yteigenanteil = M|ytpwert - M|ytfremdanteil - M|ytsonstkost - M|ytfertleist
.continue ESAC005
!BRK019
.continue BRK020 ? _(G|evtvar = "ytpwert")
.formula M|yteigenanteil = M|ytpwert - M|ytfremdanteil - M|ytsonstkost - M|ytfertleist
.continue ESAC005
!BRK020
!ESAC005: =====   ENDCASE   =====
.continue EL021 ? _(G|evtzeile > 0)
.copy M|ytbspeichern = G|TRUE   ? _G|evtvar = "ytbspeichern"
!EL021
.continue ESAC002
!BRK010
!ESAC002: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMADMEKVKSTAT.EV")'    ? F|fileexists(F|foppath("IFOP.IS.PRJMADMEKVKSTAT.EV"))
.continue
