..==  Besonderheiten    :
..==
..==  Dieses FOP wird ber EasyCase bearbeitet und mit easy2lg generiert!
..==  Žnderungen auáerhalb von EasyCase werden nach der n„chsten Žnderung
..==  im EasyCase wieder berschrieben und drfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtsys xtcmd xinit xtext
.type text    xtnum xfleer xfwert xtprojekt
.type text    xttxterledigt xttxtabrechn xttxtls xttxtre
.type text    xtfarbe0 xtfarbefeab
.type text    xtupprojlad xtupprberech xtupzeileruef
.type integer xiaktzeile xierror xizerror ximerror
.type GD      xdatum
.type bool    xyberlaubt xbselhist
.type integer   xprocsp ? _F|defined(U|xprocsp)
.formula xprocsp = 0
.set demand -
..====================================================
.formula U|xtupprojlad   =  M|tab
.formula U|xtupzeileruef = "allpstart/IS.PRJM.UP.PRUEFUNG"
.formula U|xtupprberech  = "allpstart/FOP.PRJM.UP.PROJEKTBERECH"
.continue EPROCDEF
!PROC001: ----- TabLeeren -----
.make screen line --O
.continue 'xprocst.xprocsp'
!PROC002: ----- Farben -----
.colour -BACKGROUND 'U|xtfarbe0' tbaumstufe   'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yname        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yebene       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ystatus      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yname        'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yfortschritt 'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ytkunde      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ytprojleit    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yverantw     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ybz          'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yadatum      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yedatum      'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yiststart    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yistend     'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' ydauer       'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yreferenz    'M|aktzeile'
.colour -BACKGROUND 'U|xtfarbe0' yreftyp      'M|aktzeile'
.add M|yobjekt
.colour -BACKGROUND 'M|yfarbe'  'M|aktzeile'
.continue 'xprocst.xprocsp'
!PROC003: ----- Properties -----
.continue EL001 ? _(U|xiaktzeile = 0)
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xizerror = 0
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.input 'U|xtupzeileruef'
.formula U|ximerror = U|ximerror + U|xizerror
.select screen line
.continue LOOP001
!ELOP001: ==============================
.formula M|yerror = U|ximerror
.continue EL002 ? _(U|ximerror > 0)
.set TRANS +
.box Hinweis
Es wurden  'U|ximerror'  Fehler gefunden! Bitte bearbeiten.
.set TRANS -
!EL002
!EL001
.continue 'xprocst.xprocsp'
!PROC004: ----- Tabelle_laden -----
.continue EL003 ? _(F|empty(M|yprojekt))
.set TRANS +
.box Hinweis
Bitte zuerst ein Projekt angeben.
.set TRANS -
.continue FI003
!EL003
.input 'U|xtupprjmsel'
.formula U|xiaktzeile = 0
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC003
!RET002
.formula xprocsp = xprocsp - 1
!FI003
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.formula U|xtfarbefeab = "255 50 50"
.formula U|xtfarbe0     =  "-1 -1 -1"
.set TRANS +
.formula U|xttxterledigt = "Erledigt"
.formula U|xttxtabrechn  = "Abrechnung"
.formula U|xttxtls       = "Lieferschein"
.formula U|xttxtre       = "Rechnung"
.set TRANS -
.colour -STATUSTEXT -FOREGROUND -1 -1 -1 -BACKGROUND -1 -1 -1
.continue BRK001 ? _(G|evtart = "maskein")
.formula M|ybmitauf = G|TRUE
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskende")
.continue EL004 ? _((_(F|empty(M|yprojekt))) & (M|yerror > 0))
.set TRANS +
.box Hinweis
Projekt  'M|yprojekt', 'M|yprojekt^namebspr'   enth„lt noch 'M|yerror' Fehler.
                         Bitte Bearbeitung nicht vergessen.
.set TRANS -
!EL004
.continue
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "buttonvor")
.continue BRK004 ? _(G|evtvar = "bstart")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK004
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK003
.continue BRK005 ? _(G|evtart = "buttonnach")
.continue BRK006 ? _(G|evtvar = "bstart")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC004
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK006
.continue BRK007 ? _(G|evtvar = "ybuprberech")
.continue EL005 ? _(F|empty(M|yprojekt))
.set TRANS +
.box Fehler
Bitte zuerst ein Projekt angeben.
.set TRANS -
.continue FI005
!EL005
.formula U|xtprojekt = M|yprojekt^id
.input 'U|xtupprberech'
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC004
!RET006
.formula xprocsp = xprocsp - 1
!FI005
.continue ESAC003
!BRK007
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK005
.continue BRK008 ? _(G|evtart = "feldaus")
.continue BRK009 ? _(G|evtvar = "yprojekt")
.input 'U|xtupprjmsel'
.copy    M|ykunde  = M|yprojekt^ykunde
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC001
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC004
!BRK009
.continue BRK010 ? _(G|evtvar = "ybmitauf")
.continue EL006 ? _(M|tzeilen > 0)
.continue EL007 ? _(M|ybmitauf)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC001
!RET008
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC004
!RET009
.formula xprocsp = xprocsp - 1
.continue FI007
!EL007
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL008 ? _(M|yobjekt^gruppe = 4)
.make screen line -o
.continue FI008
!EL008
.select screen line
!FI008
.continue LOOP002
!ELOP002: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET010" 
.continue PROC003
!RET010
.formula xprocsp = xprocsp - 1
!FI007
!EL006
.continue ESAC004
!BRK010
.continue BRK011 ? _(G|evtvar = "ybmitar")
.continue EL009 ? _(M|tzeilen > 0)
.continue EL010 ? _(M|ybmitar)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET011" 
.continue PROC001
!RET011
.formula xprocsp = xprocsp - 1
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET012" 
.continue PROC004
!RET012
.formula xprocsp = xprocsp - 1
.continue FI010
!EL010
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL011 ? _(M|yobjekt^dnr = U|xydbaufgabe)
.continue EL012 ? _(M|yobjekt^gruppe = 5)
.make screen line -o
.continue FI012
!EL012
.select screen line
!FI012
.continue FI011
!EL011
.make screen line -o
!FI011
.continue LOOP003
!ELOP003: ==============================
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET013" 
.continue PROC003
!RET013
.formula xprocsp = xprocsp - 1
!FI010
!EL009
.continue ESAC004
!BRK011
!ESAC004: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK008
!ESAC001: =====   ENDCASE   =====
.input 'F|foppath("IFOP.IS.PRJMSTRPRUEF.EV")'       ? F|fileexists(F|foppath("IFOP.IS.PRJMSTRPRUEF.EV"))
.continue
