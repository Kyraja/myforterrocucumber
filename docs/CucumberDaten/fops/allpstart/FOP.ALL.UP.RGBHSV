..!interpreter english declaration noabbrev
..*****************************************************************************
.. Name           : all1/FOP.ALL.UP.RGBHSV
.. Datum/Date     : 31.01.2012
.. Version        : 1.0
.. Autor/Author   : alltrotec / ts
.. Copyright      :
.. Beschreibung/
.. Description    : Umrechnung von RGB nach HSV, Žnderung der HSV Werte und zurckrechnen in RGB
..                  Ein/ Ausgabegabe (je nach Schalter xybrgb oder xybhsv):
..                              xyred   - Rotanteil  Wert 0..255
..                              xygreen - Grnanteil Wert 0..255
..                              xyblue  - Blauanteil Wert 0..255
..
..                              xyhue   - Farbton   Wert 0..360
..                              xysat   - S„ttigung Wert 0..1
..                              xyval   - Helligeit Wert 0..1
..
..                              xybrgb2hsv - HSV nach RGB umrechnen
..                              xybhsv2rgb - RGB nach HSV umrechnen
..
...Includes       :
..*****************************************************************************
.set trans -
..
.type integer xyzh      ? _F|defined(U|xyzh)
.type realx   xyzmax    ? _F|defined(U|xyzmax)
.type realx   xyzmin    ? _F|defined(U|xyzmin)
.type realx   xyzred    ? _F|defined(U|xyzred)
.type realx   xyzgreen  ? _F|defined(U|xyzgreen)
.type realx   xyzblue   ? _F|defined(U|xyzblue)
.type realx   xyzp      ? _F|defined(U|xyzp)
.type realx   xyzq      ? _F|defined(U|xyzq)
.type realx   xyzf      ? _F|defined(U|xyzf)
.type realx   xyzt      ? _F|defined(U|xyzt)
..*****************************************************************************
.continue RGBHSV        ? U|xybrgb2hsv
.continue HSVRGB        ? U|xybhsv2rgb
.continue
..
!RGBHSV:Umrechnung RGB in HSV
..in Werte zwischen 0 und 1 umrechnen
.formula U|xyzred   = U|xyred   / 255
.formula U|xyzgreen = U|xygreen / 255
.formula U|xyzblue  = U|xyblue  / 255
..
..Maximum
.formula U|xyzmax = U|xyzred
.formula U|xyzmax = U|xyzgreen  ? U|xyzgreen > U|xyzmax
.formula U|xyzmax = U|xyzblue   ? U|xyzblue  > U|xyzmax
..
..Minimum
.formula U|xyzmin = U|xyzred
.formula U|xyzmin = U|xyzgreen  ? U|xyzgreen < U|xyzmin
.formula U|xyzmin = U|xyzblue   ? U|xyzblue < U|xyzmin
..
.formula U|xyhue = 0
.formula U|xysat = 0
.formula U|xyval = 0
..
.formula U|xyhue = (0 + ((U|xyzgreen - U|xyzblue)  / (U|xyzmax - U|xyzmin))) * 60       ? U|xyzmax = U|xyzred   & U|xyzmax <> U|xyzmin
.formula U|xyhue = (2 + ((U|xyzblue  - U|xyzred)   / (U|xyzmax - U|xyzmin))) * 60       ? U|xyzmax = U|xyzgreen & U|xyzmax <> U|xyzmin
.formula U|xyhue = (4 + ((U|xyzred   - U|xyzgreen) / (U|xyzmax - U|xyzmin))) * 60       ? U|xyzmax = U|xyzblue  & U|xyzmax <> U|xyzmin
.formula U|xyhue =  U|xyhue + 360                                                       ? U|xyhue   < 0
..
.formula U|xysat = (U|xyzmax - U|xyzmin) / U|xyzmax                                     ? U|xyzmax <> 0
..
.formula U|xyval =  U|xyzmax
..
.continue
..
!HSVRGB:Umrechnung HSV in RGB
.continue HSVUMR        ? U|xysat <> 0
..Wenn S„ttigung 0 dann alle Farben = Helligkeit
.formula U|xyred   = U|xyval * 255
.formula U|xygreen = U|xyval * 255
.formula U|xyblue  = U|xyval * 255
.continue
..
!HSVUMR:
.formula U|xyzh = F|trunc((U|xyhue / 60))
.formula U|xyzf = (U|xyhue / 60) - U|xyzh
..
.formula U|xyzp = U|xyval * (1 - U|xysat)
.formula U|xyzq = U|xyval * (1 - (U|xysat * U|xyzf))
.formula U|xyzt = U|xyval * (1 - U|xysat * (1 - U|xyzf))
..
.formula U|xyred   = U|xyval * 255      ? U|xyzh = 0 ; U|xyzh = 6
.formula U|xygreen = U|xyzt  * 255      ? U|xyzh = 0 ; U|xyzh = 6
.formula U|xyblue  = U|xyzp  * 255      ? U|xyzh = 0 ; U|xyzh = 6
..
.formula U|xyred   = U|xyzq  * 255      ? U|xyzh = 1
.formula U|xygreen = U|xyval * 255      ? U|xyzh = 1
.formula U|xyblue  = U|xyzp  * 255      ? U|xyzh = 1
..
.formula U|xyred   = U|xyzp  * 255      ? U|xyzh = 2
.formula U|xygreen = U|xyval * 255      ? U|xyzh = 2
.formula U|xyblue  = U|xyzt  * 255      ? U|xyzh = 2
..
.formula U|xyred   = U|xyzp  * 255      ? U|xyzh = 3
.formula U|xygreen = U|xyzq  * 255      ? U|xyzh = 3
.formula U|xyblue  = U|xyval * 255      ? U|xyzh = 3
..
.formula U|xyred   = U|xyzt  * 255      ? U|xyzh = 4
.formula U|xygreen = U|xyzp  * 255      ? U|xyzh = 4
.formula U|xyblue  = U|xyval * 255      ? U|xyzh = 4
..
.formula U|xyred   = U|xyval * 255      ? U|xyzh = 5
.formula U|xygreen = U|xyzp  * 255      ? U|xyzh = 5
.formula U|xyblue  = U|xyzq  * 255      ? U|xyzh = 5
..
.continue
