..!interpreter english declaration noabbrev
.. at 2017-08-16, 10:09
.set trans -
.continue   ? M|ybnofop
..========================================================================
..==  Name              : FOP.PRJM.AUFGABE.EV
..==  Pfad              : allpstart
..==  Funktion          : Ereignisse in der Arbeitsaufgabe
..==  Erstellungsdatum  : 08.01.2009
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Anbindung         : Maske Arbeitsaufgabe
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtid xt1 xtaufgabe xtpvorgang xtftext xterrtext xtvar
.type text    xytaufrufernr xytzeitstempel xtindex xttitel xttext1 xttext2
.type real    xrzugstd
.type integer xiatanz xi1
.type bool    xbmehr xbok xbistzeit xblnachweis xbzuordzeit xyballschutz
.type GD      xdleer xdatum xdstart xdende xdadatum xdedatum
.type P86:1   xpproject
.type P149:2  xppv
.type integer   xprocsp      ? _F|defined(U|xprocsp)
..====================================================
.formula U|xprocsp = 0
.set demand -
.continue EPROCDEF
!PROC001: ----- PflichtfelderFarbe -----
.continue EL001 ? _(_(G|evtkommd = G|kaktname12))
.colour -BACKGROUND 'U|xyfarbepflichtf' such        0
.colour -BACKGROUND 'U|xyfarbepflichtf' yverantw    0
.colour -BACKGROUND 'U|xyfarbepflichtf' ystatus     0
.colour -BACKGROUND 'U|xyfarbepflichtf' yadatum     0
.colour -BACKGROUND 'U|xyfarbepflichtf' yedatum     0
.colour -BACKGROUND 'U|xyfarbepflichtf' ykunde      0
.colour -BACKGROUND "-1 -1 -1"          yvorvp      0
.colour -BACKGROUND 'U|xyfarbepflichtf' yvorvp      0   ?  M|yprojekt^yprojekttyp^ypfvkpos
.colour -BACKGROUND "-1 -1 -1"          yverantwkst 0   ? _F|empty(M|ypvorgang) ; _F|sysinfo(18)^stbu
.colour -BACKGROUND 'U|xyfarbepflichtf' yverantwkst 0   ?  F|empty(M|ypvorgang) &  F|sysinfo(18)^stbu
.colour -BACKGROUND 'U|xyfarbepflichtf' yleiart     0   ?  M|yprojekt^yprojekttyp^ypfleiart
.colour -BACKGROUND 'U|xyfarbepflichtf' ypersonal   0   ?  F|empty(M|ypersonal) &  F|empty(M|yprojteam) &  F|empty(M|ykstelle)
.colour -BACKGROUND 'U|xyfarbepflichtf' yprojteam   0   ?  F|empty(M|ypersonal) &  F|empty(M|yprojteam) &  F|empty(M|ykstelle)
.colour -BACKGROUND 'U|xyfarbepflichtf' ykstelle    0   ?  F|empty(M|ypersonal) &  F|empty(M|yprojteam) &  F|empty(M|ykstelle)
.colour -BACKGROUND "-1 -1 -1"          ypersonal   0   ? _F|empty(M|ypersonal) ; _F|empty(M|yprojteam) ; _F|empty(M|ykstelle)
.colour -BACKGROUND "-1 -1 -1"          yprojteam   0   ? _F|empty(M|ypersonal) ; _F|empty(M|yprojteam) ; _F|empty(M|ykstelle)
.colour -BACKGROUND "-1 -1 -1"          ykstelle    0   ? _F|empty(M|ypersonal) ; _F|empty(M|yprojteam) ; _F|empty(M|ykstelle)
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- POPruef -----
.formula U|xtsel = "$,,ypvorgang==" + U|xppv^id + ";@ablageart=(Active)"
.select group 'U|xydbgraufgabe' 'U|xtsel'
.copy U|xbmehr = G|mehr
!LOOP001: ==============================
.continue ELOP001 ? _(U|xbmehr)
.continue EL002 ? _((M|id <> H|id) ; (G|evtkommd = G|kaktname14))
.set TRANS +
.box Achtung
Zum Projektvorgang 'U|xppv^nummer'/'U|xppv^such' existiert bereits eine
Arbeitsaufgabe (Nummer 'H|nummer').

Zu einem Projektvorgang darf nur eine Arbeitsaufgabe angelegt werden!
.set TRANS -
.continue EL003 ? _(G|evtart = "maskpruef")
.error
.cursor ypvorgang 0
.end 1
.continue FI003
!EL003
.formula G|evtfeldneu = M|ypvorgang^id
.copy    U|xbmehr     = G|FALSE
.error
.end 1
!FI003
.continue FI002
!EL002
.select continue
.copy U|xbmehr = G|mehr
!FI002
.continue LOOP001
!ELOP001: ==============================
.continue EL004 ? _(F|sysinfo(18)^allpstd)
.formula U|xtsel = "$,,ytpvorgang==" + U|xppv^id + ";@ablageart=(Active);@zeilen=(1)"
.select group 'U|xydbgrsubmeldung' 'U|xtsel'
.continue EL005 ? _(G|mehr)
.set TRANS +
.box Achtung
Zum Projektvorgang 'U|xppv^nummer'/'U|xppv^such' existiert bereits eine
Submeldung (Nummer 'H|nummer').
.set TRANS -
.continue EL006 ? _(G|evtart = "maskpruef")
.error
.cursor ypvorgang 0
.end 1
.continue FI006
!EL006
.formula G|evtfeldneu = M|ypvorgang^id
.copy    U|xbmehr     = G|FALSE
.error
.end 1
!FI006
!EL005
!EL004
.continue 'xprocst.xprocsp'
!PROC003: ----- PVorgangPruefen -----
.load 5 add F|sysinfo(10)^ykonfigprjm
.copy U|xpproject = M|yprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL007 ? _(((U|xppv^yprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefpv))) ; (((U|xppv^yprojekt^ystatusk = "ABS") ; (U|xppv^yprojekt^ystatusk = "08") ; (U|xppv^yprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefpv))))
.set TRANS +
.box Achtung
Das Projekt 'U|xppv^yprojekt^nummer' ist nicht aktiv.
Nur zu aktiven Projekten dÅrfen Arbeitsaufgaben erfasst oder geÑndert werden.
.set TRANS -
.formula G|evtfeldneu = M|ypvorgang^id
.error
.end 1
!EL007
.continue EL008 ? _(_(U|xppv^yistblatt))
.set TRANS +
.box Achtung
Der Projektvorgang 'U|xppv^nummer' ist ein Sammelvorgang.
Eine Arbeitsaufgabe darf nicht einem Sammelvorgang zugewiesen werden.
.set TRANS -
.formula G|evtfeldneu = M|ypvorgang^id
.error
.end 1
!EL008
.continue EL009 ? _(U|xppv^yprojekt^yablage)
.set trans +
.formula U|xttitel = "Achtung"
.formula U|xttext1 = F|formatstr("Das Projekt {1} ist bereits abgeschlossen.", U|xppv^yprojekt)
.formula U|xttext2 = "Es dÅrfen keine VorgÑnge mehr zu diesem Projekt erfasst werden!"
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.formula G|evtfeldneu = M|ypvorgang^id
.error
.end 1
!EL009
.continue EL010 ? _(_(F|empty(U|xppv^yrefid)))
.load 0 object 'U|xppv^yrefid'
.continue EL011 ? _(G|mehr)
.continue EL012 ? _(0|id <> M|id)
.set TRANS +
.box Achtung
Im Projektvorgang 'U|xppv' ist bereits eine Referenz hinterlegt:
'U|xppv^yreftyp' '0|nummer'
.set TRANS -
.formula G|evtfeldneu = M|ypvorgang^id
.error
.end 1
!EL012
!EL011
!EL010
.formula U|xtpvorgang = U|xppv^id
.input "allpstart/FOP.PRJM.UP.PV.FREIGABE.AA"
.error  ? _U|xybrelok
.end 1  ? _U|xybrelok
.continue 'xprocst.xprocsp'
!PROC004: ----- Schutz -----
.continue EL013 ? _(F|empty(M|ypvorgang))
.protection -RESET name
.protection -RESET ysollstd
.protection -RESET ykunde
.protection -RESET ykunde2
.protection -RESET yverantwkst
.protection -RESET yktr
.protection -RESET yleiart
.protection -RESET yvkartikel
.protection -RESET ymaschvkart
.protection -RESET ybupos
.protection -RESET yvorvp
.protection -RESET ypvorgang
.protection -RESET ybnichtuebbuch
.continue FI013
!EL013
.protection name
.protection ysollstd
.protection ykunde
.protection ykunde2
.protection yverantwkst
.protection yktr
.protection yleiart
.protection yvkartikel
.protection ymaschvkart
.protection ybupos
.protection yvorvp
.protection ypvorgang           ? _G|evtkommd = G|kaktname14
.protection ybnichtuebbuch
.continue EL014 ? _(_(M|ypvorgang^ybstdvert))
.continue EL015 ? _(_(M|yzugstd = 0))
.protection ypersonal 0 ? _F|empty(M|yprojteam) ; _F|empty(M|ykstelle)
.protection yprojteam 0
.protection ykstelle  0
.continue FI015
!EL015
.protection -reset ypersonal 0
.protection -reset yprojteam 0
.protection -reset ykstelle  0
!FI015
!EL014
!FI013
.continue EL016 ? _((F|empty(M|ystatusk)) ; (M|ystatusk  = "01"))
.protection -RESET ypvorgang    ?  G|evtkommd = G|kaktname14
.protection -RESET ykunde       ?  F|empty(M|ypvorgang)
.protection -RESET ykunde2      ?  F|empty(M|ypvorgang)
.continue FI016
!EL016
.protection ypvorgang
.protection ykunde
.protection ykunde2
!FI016
.protection        such 0       ?  M|yprojekt^yprojekttyp^ybgleichessw
.protection -RESET such 0       ? _M|yprojekt^yprojekttyp^ybgleichessw
.continue 'xprocst.xprocsp'
!PROC005: ----- Berechnung_Zuordnungszeit -----
.formula U|xrzugstd = 0
.formula U|xtsel = "$,,yaufgabe==" + M|id
.formula U|xtsel = U|xtsel + ";ydatum=" + 'M|yadatum:8' + "!" + 'M|yedatum:8' + ";ybsim==0"
.formula U|xtsel = U|xtsel + ";@ablageart=(Active)"
.select group "154:2" 'U|xtsel'
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xrzugstd = U|xrzugstd + H|ywert
.select continue
.continue LOOP002
!ELOP002: ==============================
.assign M|yzugstd = U|xrzugstd
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.continue EL017 ? _(G|evtkommd = G|kaktname14)
.make screen line --
.formula M|ystatusk  = "01"
.formula M|yiststd   =  0
.formula M|yfaktstd  =  0
.formula M|ymaschstd =  0
.formula M|yzugstd   =  0
.assign M|ymatlistid     = ""
.copy   M|ytaetschl      = 5|ystdtaetschl       ?  F|empty(M|ytaetschl) & _F|empty(U|xyprjmkonfig^ystdtaetschl)
.copy   M|ybnichtuebbuch = 5|ybmaxsoll
.formula M|ysperrzeich   = ""
.formula M|ysperrzp      = ""
.copy    M|ysperre       = G|false
.formula M|yclclvorhanden = "icon:text_empty"
.continue EL018 ? _(_(F|empty(M|ypvorgang)))
.formula M|yprojekt  = ""
.formula M|ypvorgang = ""
.formula M|ykunde    = ""
.formula M|ykunde2   = ""
!EL018
.assign M|yverantw = G|passw^passmitarb^id
.continue FI017
!EL017
.continue EL019 ? _(G|evtkommd = G|kaktname13)
.continue EL020 ? _(_(F|empty(M|ypvorgang)))
.select lock nowait add M|ypvorgang
.continue EL021 ? _(G|mehr)
.continue EL022 ? _(_(G|gesperrt))
.set TRANS +
.box
Der zur Arbeitsaufgabe gehîrende Projektvorgang 'M|ypvorgang'
wird gerade bearbeitet.

Die Arbeitsaufgabe darf nicht bearbeitet werden.

'G|sperrtext                                            '
.set TRANS -
.error
.end 1
!EL022
.continue FI021
!EL021
.set TRANS +
.box
Der zur Arbeitsaufgabe gehîrende Projektvorgang 'M|ypvorgang'
konnte nicht geîffnet werden.

Die Arbeitsaufgabe darf nicht bearbeitet werden.

'G|sperrtext                                            '
.set TRANS -
.error
.end 1
!FI021
!EL020
!EL019
.continue EL023 ? _(_(G|evtkommd = G|kaktname12))
.copy U|xpproject = M|yprojekt
.input "allpstart/FOP.PRJM.UP.PROJECTCLOSINGVARS"
.continue EL024 ? _(((M|yprojekt^ystatusk = "FTAB") & (F|rec(U|xystclosingvars, ypmtabpruefpv))) ; (((M|yprojekt^ystatusk = "ABS") ; (M|yprojekt^ystatusk = "08") ; (M|yprojekt^yablage)) & (F|rec(U|xystclosingvars, ypmkabpruefpv))))
.set trans +
.formula U|xttitel = "Achtung"
.formula U|xttext1 = F|formatstr("Das Projekt {1} ist bereits abgeschlossen.", M|yprojekt^such)             ?  F|empty(M|yprojekt^ystatusk)
.formula U|xttext1 = F|formatstr("Das Projekt hat den Status {2}{1}{2}.", M|yprojekt^ystatus, G|dblquote)   ? _F|empty(M|yprojekt^ystatusk)
.formula U|xttext2 = F|formatstr("<{1}> nicht mehr erlaubt!", 'G|evtkommd')
.set trans -
.box 'U|xttitel'
'U|xttext1'
'U|xttext2'
.error
.end 1         ? _G|wartung
.continue FI024
!EL024
.continue EL025 ? _((M|ystatusk = "07") ; (M|ystatusk = "08") ; (M|ypvorgang^yablage))
.copy U|xbok = G|TRUE
.continue EL026 ? _((_(F|empty(5|ypmerlrueckabpvaa))) & (F|sysinfo(18)^allppro))
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"
.copy U|xbok = F|defined(F|map(U|xypermissions, '5|ypmerlrueckabpvaa^id'))
!EL026
.continue EL027 ? _(U|xbok)
.protection -EXCEPTION buinfosys 0
.protection -EXCEPTION buaktion  0
.protection -EXCEPTION budruck   0
.protection -EXCEPTION yplanstd  0
.protection -EXCEPTION ystatus   0
.protection -ALL
.continue FI027
!EL027
.set TRANS +
.box Achtung
Die Arbeitsaufgabe hat bereits den Status "'M|ystatus'".
<'G|evtkommd'> nicht mehr erlaubt!
.set TRANS -
.error
.end 1         ? _G|wartung
!FI027
!EL025
!FI024
.input "allpstart/CHECK.RECORD.LOCK"
!EL023
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC004
!RET001
.formula xprocsp = xprocsp - 1
.continue EL028 ? _(_(G|evtkommd = G|kaktname10))
.assign M|yvorvp = M|yvorpos          ? _F|empty(M|yvorpos)
!EL028
!FI017
.continue EL029 ? _((_(F|empty(5|ypmerllmaendfakt))) & (F|sysinfo(18)^allppro) & (_(G|evtkommd = G|kaktname12)))
.copy U|xbok = G|FALSE
.continue EL030 ? _(_(F|protected(M|ylsrelev, M|aktzeile)))
.input "allppro/FOP.PRJM.UP.GETPERMISSIONS"
.copy U|xbok = F|defined(F|map(U|xypermissions, '5|ypmerllmaendfakt^id'))
!EL030
.continue EL031 ? _(_(U|xbok))
.protection ylsrelev  'M|aktzeile'
!EL031
!EL029
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL032 ? _(_(M|ybnocheck))
.continue EL033 ? _((_(G|evtkommd = G|kaktname10)) & (_(G|evtkommd = G|kaktname12)))
.formula U|xterrtext = ""
.formula U|xi1 = 0
.formula U|xi1 = U|xi1 + 1      ? _F|empty(M|ypersonal)
.formula U|xi1 = U|xi1 + 1      ? _F|empty(M|ykstelle)
.formula U|xi1 = U|xi1 + 1      ? _F|empty(M|yprojteam)
.set TRANS +
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Status"                                           ?  F|empty(M|ystatus)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Verantwortlicher"                                 ?  F|empty(M|yverantw)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Kunden oder Projektvorgang angeben"               ?  F|empty(M|ykunde)   & F|empty(M|ypvorgang)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Start gewÅnscht"                                  ?  F|empty(M|yadatum)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Ende"                                             ?  F|empty(M|yedatum)
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Auftragsposition"                                 ?  F|empty(M|yvorpos)  & M|yprojekt^yprojekttyp^ypfvkpos
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Bearbeiter, Kostenstelle oder Projektteam"       ?  U|xi1 = 0 & _M|ystatusk = "08"
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Es darf nur eines der Felder Bearbeiter, Kostenstelle oder Projektteam gefÅllt sein."   ?  U|xi1 > 1
.formula U|xterrtext = U|xterrtext + G|trennerchar + "verantwortliche Kostenstelle"                     ?  F|empty(M|yverantwkst) & F|empty(M|ypvorgang) &  F|sysinfo(18)^stbu
.formula U|xterrtext = U|xterrtext + G|trennerchar + "Leistungsart"                                     ?  F|empty(M|yleiart)     & M|yprojekt^yprojekttyp^ypfleiart
.set TRANS -
.continue EL034 ? _(_(F|empty(U|xterrtext)))
.set TRANS +
.formula U|xterrtext = "Vor dem Speichern bitte folgende Pflichtfelder fÅllen:;" + U|xterrtext
.set TRANS -
.formula U|xtvar     = "yleiart"        ?  F|empty(M|yleiart)     & M|yprojekt^yprojekttyp^ypfleiart
.formula U|xtvar     = "ystatus"        ?  F|empty(M|ystatus)
.formula U|xtvar     = "yverantw"       ?  F|empty(M|yverantw)
.formula U|xtvar     = "ykunde"         ?  F|empty(M|ykunde)      &  F|empty(M|ypvorgang)
.formula U|xtvar     = "yadatum"        ?  F|empty(M|yadatum)
.formula U|xtvar     = "yedatum"        ?  F|empty(M|yedatum)
.formula U|xtvar     = "ypersonal"      ?  F|empty(M|ypersonal)   & _M|ystatusk = "01" & _M|ystatusk = "08"
.formula U|xtvar     = "yvorvp"         ?  F|empty(M|yvorpos)     &  M|yprojekt^yprojekttyp^ypfvkpos
.formula U|xtvar     = "yverantwkst"    ?  F|empty(M|yverantwkst) &  F|empty(M|ypvorgang) &  F|sysinfo(18)^stbu
.box Fehler
'U|xterrtext                                                                                                        '
.cursor 'U|xtvar' 0
.error
.end 1
!EL034
!EL033
!EL032
.continue EL035 ? _(G|evtkommd = G|kaktname14)
.continue EL036 ? _(_(F|empty(M|ypvorgang)))
.assign U|xppv = M|ypvorgang^id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
!EL036
!EL035
.continue EL037 ? _((G|evtkommd = G|kaktname12) ; (G|evtkommd = G|kaktname10))
.continue EL038 ? _(G|evtkommd = G|kaktname10)
.continue EL039 ? _((F|empty(M|ystatusk)) ; (M|ystatusk = "01") ; (M|ystatusk = "02") ; (M|ystatusk = "03") ; (M|ystatusk = "05"))
.formula U|xtsel = "$,,yaufgabe==" + M|id
.select group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL040 ? _(G|mehr)
.set TRANS +
.box
Die Arbeitsaufgabe darf nicht mehr gelîscht werden
da bereits RÅckmeldungen existieren.
.set TRANS -
.error
.end 1
!EL040
.continue EL041 ? _(_(F|empty(M|ypvorgang)))
.load 0 group "142:3" 'F|expr("$,,yobjektid==" + M|id + ";@filingmode=(Active)")'
.continue EL042 ? _(G|mehr)
.select lock add 0|id
.continue EL043 ? _(_(G|mehr))
.set TRANS +
.box Fehler
Die Checkliste '0|nummer'/'0|such' kann nicht bearbeitet werden.
Lîschen der Arbeitsaufgabe ist nicht mîglich.
.set TRANS -
.error
.end 1
!EL043
!EL042
!EL041
.continue FI039
!EL039
.set TRANS +
.box
Die Arbeitsaufgabe darf nicht mehr gelîscht werden
da der Status bereits 'M|ystatus' ist.
.set TRANS -
.error
.end 1
!FI039
!EL038
.continue FI037
!EL037
.continue EL044 ? _(_(F|empty(M|ypvorgang)))
.formula U|xppv = M|ypvorgang^id
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC003
!RET004
.formula xprocsp = xprocsp - 1
!EL044
.continue EL045 ? _(_(F|empty(M|ypvorgang)))
.continue EL046 ? _((M|ypvorgang^yiststart <> M|yadatum) ; (M|ypvorgang^yistend   <> M|yedatum))
.select lock nowait add M|ypvorgang
.continue EL047 ? _(G|mehr)
.continue EL048 ? _(_(G|gesperrt))
.set TRANS +
.box Fehler
Der Projektvorgang wird bearbeitet.
Aktualisierung der Termine ist fehlgeschlagen.

'G|sperrtext                                                                   '

Das Speichern wird abgebrochen.
.set TRANS -
.error
.end 1
!EL048
.continue FI047
!EL047
.set TRANS +
.box Fehler
Der Projektvorgang konnte nicht geîffnet werden.
Aktualisierung der Termine ist fehlgeschlagen.

Das Speichern wird abgebrochen.
.set TRANS -
.error
.end 1
!FI047
!EL046
!EL045
!FI037
.continue
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "maskaus")
.continue EL049 ? _((_(G|evtkommd = G|kaktname10)) & (_(G|evtkommd = G|kaktname12)))
.continue EL050 ? _((M|ystatusk = "07") ; (M|ystatusk = "08"))
.continue EL051 ? _(_(M|yablage))
.copy   M|yablage = G|TRUE
.assign M|yabldat = G|datum
.rewrite screen
!EL051
.continue FI050
!EL050
.continue EL052 ? _(M|yablage)
.copy   M|yablage = G|FALSE
.assign M|yabldat = ""
.rewrite screen
!EL052
!FI050
.continue EL053 ? _((_(F|empty(M|ypvorgang))) & (_(M|ypvorgang^yrefid = M|id)))
