..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsys xtsel xtprojekt xtkennzahl xtfarbe
.type integer xivar xifarbe
.type bool    xbstart
.type GD      xdstichtag
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- SchreibschutzKennzWerte -----
.continue EL001 ? _(F|empty(M|yprojkennzahl.xivar))
.copy M|ybprojkzist.xivar  = G|FALSE
.'F|expr("protection ybprojkzist"  + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", I" + F|tostring(U|xivar)) + " ,"," ")
.copy M|ybprojkzvoka.xivar = G|FALSE
.'F|expr("protection ybprojkzvoka" + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", V" + F|tostring(U|xivar)) + " ,"," ")
.copy M|ybprojkzfc.xivar   = G|FALSE
.'F|expr("protection ybprojkzfc"   + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", F" + F|tostring(U|xivar)) + " ,"," ")
.copy M|ybprojkz1zus.xivar = G|FALSE
.'F|expr("protection ybprojkz1zus" + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", 1Z" + F|tostring(U|xivar)) + " ,"," ")
.copy M|ybprojkz2zus.xivar = G|FALSE
.'F|expr("protection ybprojkz2zus" + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", 2Z" + F|tostring(U|xivar)) + " ,"," ")
.continue FI001
!EL001
.copy M|ybprojkzist.xivar = G|TRUE                                                  ? _G|evtvar = "ybukzprjmzentrale"
.'F|expr("protection -RESET ybprojkzist"  + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = P|maskkontextfop + ", I" + F|tostring(U|xivar) + " ,"   ? _G|evtvar = "ybukzprjmzentrale" & _F|regmatch(P|maskkontextfop, F|expr(".* I" + F|tostring(U|xivar) + " .*"),G|TRUE)
.copy M|ybprojkzvoka.xivar = G|TRUE                                                 ? _G|evtvar = "ybukzprjmzentrale"
.'F|expr("protection -RESET ybprojkzvoka" + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = P|maskkontextfop + ", V" + F|tostring(U|xivar) + " ,"   ? _G|evtvar = "ybukzprjmzentrale" & _F|regmatch(P|maskkontextfop, F|expr(".* V" + F|tostring(U|xivar) + " .*"),G|TRUE)
.copy M|ybprojkzfc.xivar  = G|TRUE                                                  ? _G|evtvar = "ybukzprjmzentrale"
.'F|expr("protection -RESET ybprojkzfc"   + F|tostring(U|xivar) + " 0")'
.formula P|maskkontextfop = P|maskkontextfop + ", F" + F|tostring(U|xivar) + " ,"   ? _G|evtvar = "ybukzprjmzentrale" & _F|regmatch(P|maskkontextfop, F|expr(".* F" + F|tostring(U|xivar) + " .*"),G|TRUE)
.'F|expr("protection -RESET ybprojkz1zus"  + F|tostring(U|xivar) + " 0")'
.'F|expr("protection -RESET ybprojkz2zus" + F|tostring(U|xivar) + " 0")'
!FI001
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.input 'U|xtupprjmsel'
.assign  M|ybezugsdatum   = 'G|datum:8'<<6 + "01"
.assign  M|ybezugsdatum   =  M|ybezugsdatum + 31
.assign  M|ybezugsdatum   = 'M|ybezugsdatum:8'<<6 + "01"
.assign  M|ybezugsdatum   =  M|ybezugsdatum - 1
.formula P|maskkontextfop = ""
.formula U|xivar = 1
!LOOP001: ==============================
.continue ELOP001 ? _(F|defined(M|yprojkennzahl.xivar))
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.formula U|xivar = U|xivar + 1
.continue LOOP001
!ELOP001: ==============================
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "feldaus")
.continue EL002 ? _(G|evtvar<<13 = "yprojkennzahl")
.formula U|xivar = G|evtvar<<-13
.formula M|yprojkzname.xivar = M|.evtvar^namebspr
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
!EL002
.continue EL003 ? _(G|evtvar<<8 = "ybprojkz")
.continue BRK003 ? _(G|evtvar<<10 = "ybprojkzis")
.formula U|xivar = G|evtvar<<-11
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", I" + F|tostring(U|xivar)) + " ,"," ")   ? _M|.evtvar
.formula P|maskkontextfop = P|maskkontextfop + ", I" + F|tostring(U|xivar) + " ,"                               ?  M|.evtvar & _F|regmatch(P|maskkontextfop, F|expr(".* I" + F|tostring(U|xivar) + " .*"),G|TRUE)
.continue ESAC002
!BRK003
.continue BRK004 ? _(G|evtvar<<10 = "ybprojkzvo")
.formula U|xivar = G|evtvar<<-12
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", V" + F|tostring(U|xivar)) + " ,"," ")   ? _M|.evtvar
.formula P|maskkontextfop = P|maskkontextfop + ", V" + F|tostring(U|xivar) + " ,"                               ?  M|.evtvar & _F|regmatch(P|maskkontextfop, F|expr(".* V" + F|tostring(U|xivar) + " .*"),G|TRUE)
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar<<10 = "ybprojkzfc")
.formula U|xivar = G|evtvar<<-10
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", F" + F|tostring(U|xivar)) + " ,"," ")   ? _M|.evtvar
.formula P|maskkontextfop = P|maskkontextfop + ", F" + F|tostring(U|xivar) + " ,"                               ?  M|.evtvar & _F|regmatch(P|maskkontextfop, F|expr(".* F" + F|tostring(U|xivar) + " .*"),G|TRUE)
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar<<10 = "ybprojkz1z")
.formula U|xivar = G|evtvar<<-12
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", 1Z" + F|tostring(U|xivar)) + " ,"," ")  ? _M|.evtvar
.formula P|maskkontextfop = P|maskkontextfop + ", 1Z" + F|tostring(U|xivar) + " ,"                              ?  M|.evtvar & _F|regmatch(P|maskkontextfop, F|expr(".* 1Z" + F|tostring(U|xivar) + " .*"),G|TRUE)
.continue ESAC002
!BRK006
.continue BRK007 ? _(G|evtvar<<10 = "ybprojkz2z")
.formula U|xivar = G|evtvar<<-12
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", 2Z" + F|tostring(U|xivar)) + " ,"," ")  ? _M|.evtvar
.formula P|maskkontextfop = P|maskkontextfop + ", 2Z" + F|tostring(U|xivar) + " ,"                              ?  M|.evtvar & _F|regmatch(P|maskkontextfop, F|expr(".* 2Z" + F|tostring(U|xivar) + " .*"),G|TRUE)
.continue ESAC002
!BRK007
!ESAC002: =====   ENDCASE   =====
.continue FI003
!EL003
.input 'U|xtupprjmsel'
!FI003
.continue ESAC001
!BRK002
.continue BRK008 ? _(G|evtart = "buttonvor")
.continue EL004 ? _(F|empty(M|ybezugsdatum))
.set TRANS +
.box Hinweis
Bitte zuerst das Bezugsdatum fÅllen.
.set TRANS -
.cursor ybezugsdatum 0
.error
.end 1
.continue FI004
!EL004
.make screen line --O
!FI004
.continue ESAC001
!BRK008
.continue BRK009 ? _(G|evtart = "buttonnach")
.continue BRK010 ? _(G|evtvar = "bstart")
.input "is/ABASFARBEN.DEF"  ? _F|defined(U|xabasbgtable1)
.input 'U|xtupprjmsel'
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "ybukzaktualisieren")
.formula U|xdstichtag = M|ybezugsdatum
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL005 ? _(true)
.formula U|xtprojekt = M|ytprojekt^id
.input "allpstart/FOP.PRJM.KENNZAHLEN.CRON"
.continue FI005
!EL005
.formula U|xivar = 1
!LOOP003: ==============================
.continue ELOP003 ? _(F|defined(M|yprojkennzahl.xivar))
.continue EL006 ? _(_(F|empty(M|yprojkennzahl.xivar)))
.add M|yprojkennzahl.xivar
.continue EL007 ? _(G|mehr)
.formula U|xtprojekt  = M|ytprojekt^id
.formula U|xtkennzahl = D|id
.input 'D|yberechfop'   ? _F|empty(D|yberechfop) & F|fileexists(F|foppath(D|yberechfop))
.input 'D|yvokafop'     ? _F|empty(D|yvokafop)   & F|fileexists(F|foppath(D|yvokafop))
.input 'D|yfcfop'       ? _F|empty(D|yfcfop)     & F|fileexists(F|foppath(D|yfcfop))
.input 'D|yfopzus1'     ? _F|empty(D|yfopzus1)   & F|fileexists(F|foppath(D|yfopzus1))
.input 'D|yfopzus2'     ? _F|empty(D|yfopzus2)   & F|fileexists(F|foppath(D|yfopzus2))
!EL007
!EL006
.formula U|xivar = U|xivar + 1
.continue LOOP003
!ELOP003: ==============================
!FI005
.select screen line
.continue LOOP002
!ELOP002: ==============================
.make screen line --
.input "is/ABASFARBEN.DEF"  ? _F|defined(U|xabasbgtable1)
.copy U|xbstart = G|TRUE
.input 'U|xtupprjmsel'
.continue ESAC003
!BRK011
.continue BRK012 ? _(G|evtvar = "ybukzprjmzentrale")
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"
.input 'F|foppath(5|ypmupgkzprojzent)'      ? _F|empty(5|ypmupgkzprojzent) & F|fileexists(F|foppath(5|ypmupgkzprojzent))
.formula U|xivar = 1
!LOOP004: ==============================
.continue ELOP004 ? _(F|defined(M|yprojkennzahl.xivar))
.formula M|yprojkzname.xivar = M|yprojkennzahl.xivar^namebspr
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", I" + F|tostring(U|xivar)) + " ,"," ")   ? _M|ybprojkzist.xivar
.formula P|maskkontextfop = P|maskkontextfop + ", I" + F|tostring(U|xivar) + " ,"                               ?  M|ybprojkzist.xivar  & _F|regmatch(P|maskkontextfop, F|expr(".* I" + F|tostring(U|xivar) + " .*"),G|TRUE)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", V" + F|tostring(U|xivar)) + " ,"," ")   ? _M|ybprojkzvoka.xivar
.formula P|maskkontextfop = P|maskkontextfop + ", V" + F|tostring(U|xivar) + " ,"                               ?  M|ybprojkzvoka.xivar & _F|regmatch(P|maskkontextfop, F|expr(".* V" + F|tostring(U|xivar) + " .*"),G|TRUE)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", F" + F|tostring(U|xivar)) + " ,"," ")   ? _M|ybprojkzfc.xivar
.formula P|maskkontextfop = P|maskkontextfop + ", F" + F|tostring(U|xivar) + " ,"                               ?  M|ybprojkzfc.xivar   & _F|regmatch(P|maskkontextfop, F|expr(".* F" + F|tostring(U|xivar) + " .*"),G|TRUE)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", 1Z" + F|tostring(U|xivar)) + " ,"," ")  ? _M|ybprojkz1zus.xivar
.formula P|maskkontextfop = P|maskkontextfop + ", 1Z" + F|tostring(U|xivar) + " ,"                              ?  M|ybprojkz1zus.xivar & _F|regmatch(P|maskkontextfop, F|expr(".* 1Z" + F|tostring(U|xivar) + " .*"),G|TRUE)
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, F|expr(", 2Z" + F|tostring(U|xivar)) + " ,"," ")  ? _M|ybprojkz2zus.xivar
.formula P|maskkontextfop = P|maskkontextfop + ", 2Z" + F|tostring(U|xivar) + " ,"                              ?  M|ybprojkz2zus.xivar & _F|regmatch(P|maskkontextfop, F|expr(".* 2Z" + F|tostring(U|xivar) + " .*"),G|TRUE)
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.formula U|xivar = U|xivar + 1
.continue LOOP004
!ELOP004: ==============================
.continue ESAC003
!BRK012
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK009
!ESAC001: =====   ENDCASE   =====
