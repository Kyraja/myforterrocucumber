# rabbit-mq
# host (default: erp host name)
RMQ_HOST=${HOSTNAME}
# port, default 5672
RMQ_PORT=5672
# port of management plugin, default 15672
RMQ_MANAGEPORT=15672
# rabbitmq user, default: guest
#RMQ_USER=guest
# rabbitmq password, default: guest
#RMQ_PASS=guest
# virtual host
#RMQ_VHOST=${HOSTNAME}_${MNAME}
# icedaemon
#ICE_DATADIR=${MANDANTDIR}/allpstart/allamb/tmp/
ICE_SETUPQUEUE=handshake
