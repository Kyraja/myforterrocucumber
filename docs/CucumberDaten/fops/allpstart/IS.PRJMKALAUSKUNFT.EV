.copy M|ybsollherkunft = G|true
.copy M|ybabwzeit      = G|true     ? F|sysinfo(10)^ykonfigprjm^ypzebpze
.copy M|ybkapazeit     = G|true
.copy M|ybkapazitaet   = G|true
.copy M|ybzugstd       = G|true
.copy M|ybsplan        = G|true
.copy M|ybtplan        = G|true
.copy M|ybrefobj       = G|true
.copy M|ybpkalender    = G|true
.copy M|ybpstandort    = G|true
.copy M|ybprefobj      = G|true
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!PROC003: ----- KeineSpalten -----
.copy M|ybdatum        = G|false
.copy M|ybarbeitstag   = G|false
.copy M|ybatkalsplan   = G|false
.copy M|ybatsplan      = G|false
