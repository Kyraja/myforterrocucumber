.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybprojteam", "")     ?  F|regmatch(P|maskkontextfop, F|expr(".* ybprojteam .*"))     & _M|ybprojteam
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybstandort", "")     ?  F|regmatch(P|maskkontextfop, F|expr(".* ybstandort .*"))     & _M|ybstandort
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybkstelle", "")      ?  F|regmatch(P|maskkontextfop, F|expr(".* ybkstelle .*"))      & _M|ybkstelle
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybsollzeit", "")     ?  F|regmatch(P|maskkontextfop, F|expr(".* ybsollzeit .*"))     & _M|ybsollzeit
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybsollkalsplan", "") ?  F|regmatch(P|maskkontextfop, F|expr(".* ybsollkalsplan .*")) & _M|ybsollkalsplan
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybsollsplan", "")    ?  F|regmatch(P|maskkontextfop, F|expr(".* ybsollsplan .*"))    & _M|ybsollsplan
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybarbzeit", "")      ?  F|regmatch(P|maskkontextfop, F|expr(".* ybarbzeit .*"))      & _M|ybarbzeit
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybsollherkunft", "") ?  F|regmatch(P|maskkontextfop, F|expr(".* ybsollherkunft .*")) & _M|ybsollherkunft
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybabwzeit", "")      ?  F|regmatch(P|maskkontextfop, F|expr(".* ybabwzeit .*"))      & _M|ybabwzeit
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybkapazeit", "")     ?  F|regmatch(P|maskkontextfop, F|expr(".* ybkapazeit .*"))     & _M|ybkapazeit
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybkapazitaet", "")   ?  F|regmatch(P|maskkontextfop, F|expr(".* ybkapazitaet .*"))   & _M|ybkapazitaet
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybzugstd", "")       ?  F|regmatch(P|maskkontextfop, F|expr(".* ybzugstd .*"))       & _M|ybzugstd
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybsplan", "")        ?  F|regmatch(P|maskkontextfop, F|expr(".* ybsplan .*"))        & _M|ybsplan
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybtplan", "")        ?  F|regmatch(P|maskkontextfop, F|expr(".* ybtplan .*"))        & _M|ybtplan
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybrefobj", "")       ?  F|regmatch(P|maskkontextfop, F|expr(".* ybrefobj .*"))       & _M|ybrefobj
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybpkalender", "")    ?  F|regmatch(P|maskkontextfop, F|expr(".* ybpkalender .*"))    & _M|ybpkalender
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybpstandort", "")    ?  F|regmatch(P|maskkontextfop, F|expr(".* ybpstandort .*"))    & _M|ybpstandort
