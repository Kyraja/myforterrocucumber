!PROC002: ----- AlleSpalten -----
.copy M|ybdatum        = G|true
.copy M|ybarbeitstag   = G|true
.copy M|ybatkalsplan   = G|true
.copy M|ybatsplan      = G|true
.copy M|ybatkal        = G|true
.copy M|ybatabw        = G|true     ? F|sysinfo(10)^ykonfigprjm^ypzebpze
.copy M|ybkalender     = G|true
.copy M|ybpvorgang     = G|true
.copy M|ybpersonal     = G|true
.copy M|ybprojteam     = G|true
.copy M|ybstandort     = G|true
.copy M|ybkstelle      = G|true
.copy M|ybsollzeit     = G|true
.copy M|ybsollkalsplan = G|true
.copy M|ybsollsplan    = G|true
