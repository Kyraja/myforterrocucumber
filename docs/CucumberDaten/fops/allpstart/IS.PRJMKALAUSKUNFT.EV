.formula P|maskkontextfop = P|maskkontextfop + " ybstandort "       ? _F|regmatch(P|maskkontextfop, F|expr(".* ybstandort .*"))     &  M|ybstandort
.formula P|maskkontextfop = P|maskkontextfop + " ybkstelle "        ? _F|regmatch(P|maskkontextfop, F|expr(".* ybkstelle .*"))      &  M|ybkstelle
.formula P|maskkontextfop = P|maskkontextfop + " ybsollzeit "       ? _F|regmatch(P|maskkontextfop, F|expr(".* ybsollzeit .*"))     &  M|ybsollzeit
.formula P|maskkontextfop = P|maskkontextfop + " ybsollkalsplan "   ? _F|regmatch(P|maskkontextfop, F|expr(".* ybsollkalsplan .*")) &  M|ybsollkalsplan
.formula P|maskkontextfop = P|maskkontextfop + " ybsollsplan "      ? _F|regmatch(P|maskkontextfop, F|expr(".* ybsollsplan .*"))    &  M|ybsollsplan
.formula P|maskkontextfop = P|maskkontextfop + " ybarbzeit "        ? _F|regmatch(P|maskkontextfop, F|expr(".* ybarbzeit .*"))      &  M|ybarbzeit
.formula P|maskkontextfop = P|maskkontextfop + " ybsollherkunft "   ? _F|regmatch(P|maskkontextfop, F|expr(".* ybsollherkunft .*")) &  M|ybsollherkunft
.formula P|maskkontextfop = P|maskkontextfop + " ybabwzeit "        ? _F|regmatch(P|maskkontextfop, F|expr(".* ybabwzeit .*"))      &  M|ybabwzeit
.formula P|maskkontextfop = P|maskkontextfop + " ybkapazeit "       ? _F|regmatch(P|maskkontextfop, F|expr(".* ybkapazeit .*"))     &  M|ybkapazeit
.formula P|maskkontextfop = P|maskkontextfop + " ybkapazitaet "     ? _F|regmatch(P|maskkontextfop, F|expr(".* ybkapazitaet .*"))   &  M|ybkapazitaet
.formula P|maskkontextfop = P|maskkontextfop + " ybzugstd "         ? _F|regmatch(P|maskkontextfop, F|expr(".* ybzugstd .*"))       &  M|ybzugstd
.formula P|maskkontextfop = P|maskkontextfop + " ybsplan "          ? _F|regmatch(P|maskkontextfop, F|expr(".* ybsplan .*"))        &  M|ybsplan
.formula P|maskkontextfop = P|maskkontextfop + " ybtplan "          ? _F|regmatch(P|maskkontextfop, F|expr(".* ybtplan .*"))        &  M|ybtplan
.formula P|maskkontextfop = P|maskkontextfop + " ybrefobj "         ? _F|regmatch(P|maskkontextfop, F|expr(".* ybrefobj .*"))       &  M|ybrefobj
.formula P|maskkontextfop = P|maskkontextfop + " ybpkalender "      ? _F|regmatch(P|maskkontextfop, F|expr(".* ybpkalender .*"))    &  M|ybpkalender
.formula P|maskkontextfop = P|maskkontextfop + " ybpstandort "      ? _F|regmatch(P|maskkontextfop, F|expr(".* ybpstandort .*"))    &  M|ybpstandort
.formula P|maskkontextfop = P|maskkontextfop + " ybprefobj "        ? _F|regmatch(P|maskkontextfop, F|expr(".* ybprefobj .*"))      &  M|ybprefobj
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybdatum", "")        ?  F|regmatch(P|maskkontextfop, F|expr(".* ybdatum .*"))        & _M|ybdatum
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybarbeitstag", "")   ?  F|regmatch(P|maskkontextfop, F|expr(".* ybarbeitstag .*"))   & _M|ybarbeitstag
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybatkalsplan", "")   ?  F|regmatch(P|maskkontextfop, F|expr(".* ybatkalsplan .*"))   & _M|ybatkalsplan
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybatsplan", "")      ?  F|regmatch(P|maskkontextfop, F|expr(".* ybatsplan .*"))      & _M|ybatsplan
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybatkal", "")        ?  F|regmatch(P|maskkontextfop, F|expr(".* ybatkal .*"))        & _M|ybatkal
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybatabw", "")        ?  F|regmatch(P|maskkontextfop, F|expr(".* ybatabw .*"))        & _M|ybatabw
.formula P|maskkontextfop = F|regreplaceall(P|maskkontextfop, "ybkalender", "")     ?  F|regmatch(P|maskkontextfop, F|expr(".* ybkalender .*"))     & _M|ybkalender
