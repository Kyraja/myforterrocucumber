.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.formula M|yadatum   = 'G|datum:8'<<4 + "0101"
.formula M|yedatum   = 'G|datum:8'<<4 + "1231"
.copy    M|ybinklabw = G|TRUE
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskende")
.end .          ? M|ybmaskezu
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "feldaus")
.continue BRK004 ? _(G|evtvar = "yprojekt")
.continue EL001 ? _(_(F|empty(M|yprojekt)))
.input "allpstart/CHECK.PROJECT"
.formula M|yadatum   = M|yprojekt^yadatum
.formula M|yedatum   = M|yprojekt^yedatum
.copy    M|ystandort = M|yprojekt^ystandort
!EL001
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "ypvorgang")
.copy M|ypersonal = M|ypvorgang^ypersonal
.copy M|yprojteam = M|ypvorgang^yprojteam
.copy M|ykstelle  = M|ypvorgang^ykstelle
.copy M|ystandort = M|ypvorgang^ystandort
.copy M|yadatum   = M|ypvorgang^yadatum
.copy M|yedatum   = M|ypvorgang^yedatum
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "ykstelle")
.continue EL002 ? _(_(F|empty(M|ykstelle)))
.continue EL003 ? _(U|xypmrepruefkst)
.formula U|xykoobjekt = M|ykstelle^id
.input 'U|xypmrepruefkstprog'
.continue EL004 ? _(_(U|xyberlaubt))
.continue EL005 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set TRANS -
.formula M|yprojekt  = ""
.continue
!EL005
!EL004
!EL003
.continue EL006 ? _(U|xypmrepruefind)
.input 'U|xypmrepruefindprog'
.continue EL007 ? _(_(U|xyberlaubt))
.continue EL008 ? _(_(U|xyberlaubt))
.set TRANS +
.box Hinweis
Sie besitzen nicht die erforderliche Rechte fÅr dieses Projekt.
.set TRANS -
.formula M|yprojekt  = ""
.continue
!EL008
!EL007
!EL006
!EL002
.continue ESAC002
!BRK006
.continue EL009 ? _(G|evtvar<<2 = "yb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
!EL009
!ESAC002: =====   ENDCASE   =====
.make screen line --O
.continue ESAC001
!BRK003
.continue BRK007 ? _(G|evtart = "buttonvor")
.continue BRK008 ? _(G|evtvar = "bstart")
.continue EL010 ? _((F|empty(M|yadatum)) ; (F|empty(M|yedatum)))
.set TRANS +
.box Hinweis
Bitte einen Zeitbereich angeben!
.set TRANS -
.error
.end 1
!EL010
.continue ESAC003
!BRK008
!ESAC003: =====   ENDCASE   =====
.continue ESAC001
!BRK007
.continue BRK009 ? _(G|evtart = "buttonnach")
.continue BRK010 ? _(G|evtvar = "ybuallespalten")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
