.continue EPROCDEF
!PROC001: ----- maskkontextfop -----
.formula P|maskkontextfop = P|maskkontextfop + " ybdatum "          ? _F|regmatch(P|maskkontextfop, F|expr(".* ybdatum .*"))        &  M|ybdatum
.formula P|maskkontextfop = P|maskkontextfop + " ybarbeitstag "     ? _F|regmatch(P|maskkontextfop, F|expr(".* ybarbeitstag .*"))   &  M|ybarbeitstag
.formula P|maskkontextfop = P|maskkontextfop + " ybatkalsplan "     ? _F|regmatch(P|maskkontextfop, F|expr(".* ybatkalsplan .*"))   &  M|ybatkalsplan
.formula P|maskkontextfop = P|maskkontextfop + " ybatsplan "        ? _F|regmatch(P|maskkontextfop, F|expr(".* ybatsplan .*"))      &  M|ybatsplan
.formula P|maskkontextfop = P|maskkontextfop + " ybatkal "          ? _F|regmatch(P|maskkontextfop, F|expr(".* ybatkal .*"))        &  M|ybatkal
.formula P|maskkontextfop = P|maskkontextfop + " ybatabw "          ? _F|regmatch(P|maskkontextfop, F|expr(".* ybatabw .*"))        &  M|ybatabw
