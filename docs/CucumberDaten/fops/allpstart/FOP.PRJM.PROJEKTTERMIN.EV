..!interpreter english declaration noabbrev
.. at 2016-04-20, 16:50
.set TRANS -
..========================================================================
..==  Name              : FOP.PRJM.PROJEKTTERMIN.EV
..==  Pfad              : allpstart
..==  Funktion          : Events an der Maske Projekttermin
..==  Erstellungsdatum  : 19.08.2016
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2013 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
..====================================================
.type text    xtsel xtsys xtfarbe
.type integer xifarbe
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- Feldpruefung_Farbe -----
.continue EL001 ? _((M|.evtvar < 0) ; (M|.evtvar > 255))
.set TRANS +
.box Fehler
Es sind nur Zahlen zwischen 0 und 255 erlaubt.
.set TRANS -
.error
.end 1
!EL001
.continue 'xprocst.xprocsp'
!PROC002: ----- Farbe_setzen -----
.formula U|xtfarbe = 'M|yfarber' + " " + 'M|yfarbeg' + " " + 'M|yfarbeb'
.formula U|xtfarbe = "-1 -1 -1"                ? U|xtfarbe = "0 0 0"
.colour -BACKGROUND 'U|xtfarbe' ysfarbe
.continue 'xprocst.xprocsp'
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL002 ? _((M|ybmeilenstein) & (_(M|yvon = M|ybis)))
.set trans +
.box Hinweis
Bei Meilensteinen muss das Enddatum gleich dem Anfangsdatum sein.
.set trans -
.error (0)
.end 1
!EL002
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "feldpruef")
.continue BRK004 ? _(G|evtvar = "yfarber")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "yfarbeg")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK005
.continue BRK006 ? _(G|evtvar = "yfarbeb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
.continue ESAC002
!BRK006
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK003
.continue BRK007 ? _(G|evtart = "feldaus")
.continue BRK008 ? _(G|evtvar = "yfarber")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC002
!RET005
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK008
.continue BRK009 ? _(G|evtvar = "yfarbeg")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK009
.continue BRK010 ? _(G|evtvar = "yfarbeb")
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
.continue ESAC003
!BRK010
.continue BRK011 ? _(G|evtvar = "yvon")
.copy M|ybmeilenstein = G|false ? _M|yvon = M|ybis
.continue ESAC003
!BRK011
.continue BRK012 ? _(G|evtvar = "ybis")
.copy M|ybmeilenstein = G|false ? _M|yvon = M|ybis
.continue ESAC003
!BRK012
.continue BRK013 ? _(G|evtvar = "ybmeilenstein")
.copy M|ybis = M|yvon           ?  M|ybmeilenstein
.continue ESAC003
!BRK013
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK007
!ESAC001: =====   ENDCASE   =====
.continue
