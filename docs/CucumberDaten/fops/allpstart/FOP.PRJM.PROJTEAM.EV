..!interpreter english declaration noabbrev
.. at 2017-03-15, 08:58
.set trans -
..========================================================================
..==  Name              : FOP.PRJM.PROJTEAM.EV
..==  Pfad              : allpstart
..==  Funktion          :
..==  Erstellungsdatum  : 21.09.2010
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==  Copyright         : (c) 1990 - 2017 alltrotec GmbH
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..========================================================================
.input "allpstart/PRJM.KONFIG.INI"
.input "allpstart/FOP.PRJM.UP.DEF"
..====================================================
.type text    xtsel xtsys xtempf xttitel xterrtext
.type real    xrzeitanteil
.type integer xprocsp   ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue BRK001 ? _(G|evtart = "maskein")
.continue EL001 ? _(_(G|evtkommd = G|kaktname10))
.select screen header
.select screen line
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL002 ? _(_(F|empty(M|ypersonal)))
.formula M|ypersname  = M|ypersonal^namebspr
.copy    M|ysgkleiart = M|ypersonal^yprjmgkleiart
.copy    M|ysleiart   = M|ypersonal^yprjmleiart
!EL002
.select screen line
.continue LOOP001
!ELOP001: ==============================
!EL001
.continue
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtart = "maskpruef")
.continue EL003 ? _(M|tzeilen > 0)
.formula U|xrzeitanteil = 0
.select screen header
.select screen line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.formula U|xrzeitanteil = U|xrzeitanteil + M|yzeitanteil
.select screen line
.continue LOOP002
!ELOP002: ==============================
.continue EL004 ? _(U|xrzeitanteil <> 100)
.set trans +
.box Fehler
Die Summe "Zeitanteil" Åber alle Zeilen muss 100 ergeben.
.set trans -
.error
.end 1
!EL004
!EL003
.continue EL005 ? _((M|yinaktiv) & (M|yinaktiv <> F|oldvalue(M|yinaktiv)) & (G|evtkommd <> G|kaktname14))
.formula U|xtsel = "$,,yprojteam==" + M|id + ";yablage=0;@ablageart=(1)"
.select group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL006 ? _(G|mehr)
.set trans +
.box Fehler
Das Projektteam 'M|nummer'/'M|such' darf nicht auf "inaktiv" gesetzt werden, da es noch ProjektvorgÑngen zugeordnet ist.
.set trans -
.error
.end 1
!EL006
.formula U|xtsel = "$,,yprojteam==" + M|id + ";ystatusk<>07;ystatusk<>08;@ablageart=(1)"
.select group 'U|xydbgraufgabe' 'U|xtsel'
.continue EL007 ? _(G|mehr)
.set trans +
.box Fehler
Das Projektteam 'M|nummer'/'M|such' darf nicht auf "inaktiv" gesetzt werden, da es noch Arbeitsaufgaben zugeordnet ist.
.set trans -
.error
.end 1
!EL007
!EL005
.continue ESAC001
!BRK002
.continue BRK003 ? _(G|evtart = "buttonnach")
.continue BRK004 ? _(G|evtvar = "ykemail")
.select screen header
.select screen line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL008 ? _(F|empty(M|ypersonal^email))
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xtsel   = "Mitarbeiter" + ": " + M|ypersname
.set trans -
.atext -language 'G|bsprache' U|xterrtext 4220
.box -title 'U|xttitel'
'U|xtsel'
'U|xterrtext'
.continue FI008
!EL008
.formula U|xtempf = U|xtempf + ";"      ? _F|empty(U|xtempf)
.formula U|xtempf = U|xtempf + M|ypersonal^email
!FI008
.select screen line
.continue LOOP003
!ELOP003: ==============================
.formula U|xtsys = "mailto: " + U|xtempf
.browser 'U|xtsys'
.continue ESAC002
!BRK004
.continue BRK005 ? _(G|evtvar = "ytemail")
.continue EL009 ? _(F|empty(M|ypersonal^email))
.set trans +
.formula U|xttitel = "Hinweis"
.formula U|xtsel   = "Mitarbeiter" + ": " + M|ypersname
.set trans -
.atext -language 'G|bsprache' U|xterrtext 4220
.box -title 'U|xttitel'
'U|xtsel'
'U|xterrtext'
.continue FI009
!EL009
.formula U|xtsys = "mailto: " + M|ypersonal^email
.browser 'U|xtsys'
!FI009
.continue ESAC002
!BRK005
!ESAC002: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK003
.continue BRK006 ? _(G|evtart = "feldaus")
.continue BRK007 ? _(G|evtvar = "ypersonal")
.input 'U|xtuppruefinaktiv'
.formula M|ypersname  = M|ypersonal^namebspr
.copy    M|ysgkleiart = M|ypersonal^yprjmgkleiart
.copy    M|ysleiart   = M|ypersonal^yprjmleiart
.continue ESAC003
!BRK007
.continue BRK008 ? _(G|evtvar = "yprojekt")
.formula M|such = M|yprojekt^such   ? _F|empty(M|yprojekt)
.continue ESAC003
!BRK008
!ESAC003: =====   ENDCASE   =====
.continue
.continue ESAC001
!BRK006
!ESAC001: =====   ENDCASE   =====
.continue
