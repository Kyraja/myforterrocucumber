.formula U|xr01elwert = U|xr01elwert + 0|yvaeigenleist  ?  F|empty(0|ytransaktion)
.formula U|xr01flwert = U|xr01flwert + 0|yvafremdleist  ?  F|empty(0|ytransaktion)
.formula U|xr01skwert = U|xr01skwert + 0|yvasonstkost   ?  F|empty(0|ytransaktion)
.formula U|xr01fewert = U|xr01fewert + 0|yvafertleist   ?  F|empty(0|ytransaktion)
.formula U|xr02wert   = U|xr02wert   + 0|ybetrag        ? _F|empty(0|ytransaktion)
.formula U|xr02elwert = U|xr02elwert + 0|yvaeigenleist  ? _F|empty(0|ytransaktion)
.formula U|xr02flwert = U|xr02flwert + 0|yvafremdleist  ? _F|empty(0|ytransaktion)
.formula U|xr02skwert = U|xr02skwert + 0|yvasonstkost   ? _F|empty(0|ytransaktion)
.formula U|xr02fewert = U|xr02fewert + 0|yvafertleist   ? _F|empty(0|ytransaktion)
..
.load 0 continue
.continue SPRLSPACC     ?  G|mehr
..
