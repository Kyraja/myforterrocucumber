!REQUEST:
..*** key figures for requests **********************************************
..reset variables
.input 'U|xtupvar'
..
..
!PURCHASEORDER:
..*** key figures for PurchaseOrder *******************************************
..reset variables
.input 'U|xtupvar'
..
.formula U|xtsel = "$,,yprjmproj==" + 7|id + ";ktyp==(PurchaseOrder);@filingmode=(Both)"
.load 0 group "4:22" 'U|xtsel'
!POLOAD:
.continue POSALESSTAT   ? _G|mehr
.formula U|xianz  = U|xianz  + 1
.formula U|xioanz = U|xioanz + 1        ? _0|ablagef
.formula U|xiaanz = U|xiaanz + 1        ?  0|ablagef
..
.load 0 continue
.continue POLOAD
..
!POSALESSTAT:
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ybezugsdatum<=" + U|xdstatdat:8 + ";yekvk==(Purchasing);yalternativpos=(No);@filingmode=(Active)"
.load 0 group 'U|xydbgrvkstat' 'U|xtsel'
!POLOADSTAT:
.continue POKF          ? _G|mehr
..
.formula U|xt001   = ('0|ybezugsdatum:8')<<6 + "01"
.formula U|xtindex = 0|ykonto^nummer
..
.formula U|xr1 = 0|ynwert                                                       ? _0|ybrutto
.formula U|xr1 = 0|ynwert   - 0|ystwert                                         ?  0|ybrutto
.formula U|xr1 = F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)        ? _0|ypland = G|inland & _0|ykursfix
.formula U|xr1 = U|xr1 * 0|yewkurs                                              ? _0|ypland = G|inland &  0|ykursfix
..
.continue POOVAL                                                                ? _0|ybezugsdatum = U|xdstatdat
..
.formula U|xrwert   = U|xrwert   + U|xr1
..
.formula U|xr03wert = U|xr03wert + U|xr1                                        ?  F|empty(0|yablagen)
..
.copy U|xb1 = G|TRUE                                                            ? _F|defined(U|xtsonstkost.xtindex) & _F|defined(U|xtfertleist.xtindex) & _F|defined(U|xtnrelkost.xtindex)
.copy U|xb2 = G|TRUE                                                            ?  F|defined(U|xtsonstkost.xtindex) ;  F|defined(U|xtfertleist.xtindex) ;  F|defined(U|xtnrelkost.xtindex)
..
.formula U|xrflwert = U|xrflwert + U|xr1                                        ?  U|xb1
.formula U|xrskwert = U|xrskwert + U|xr1                                        ?  U|xb2
..
!POOVAL:
..offener Liefer und Rechnungswert
.continue POSTATLOADNEXT        ? 0|ylimge = 0 & 0|yremge = 0
.continue POSTATLOADNEXT        ? 0|ymge = 0
..
.type real xr01wert.xt001                                                       ? _F|defined(U|xr01wert.xt001)
.type real xr01flwert.xt001                                                     ? _F|defined(U|xr01flwert.xt001)
.type real xr01skwert.xt001                                                     ? _F|defined(U|xr01skwert.xt001)
.type real xr02wert.xt001                                                       ? _F|defined(U|xr02wert.xt001)
.type real xr02flwert.xt001                                                     ? _F|defined(U|xr02flwert.xt001)
.type real xr02skwert.xt001                                                     ? _F|defined(U|xr02skwert.xt001)
..
.continue POSTATZUPO            ?  '0|yevtyp(L="0")' = "(12)"
..
.formula U|xr01wert.xt001   = U|xr01wert.xt001   + 0|ylimge * (U|xr1 / 0|ymge)
.formula U|xr01flwert.xt001 = U|xr01flwert.xt001 + 0|ylimge * (U|xr1 / 0|ymge)  ? U|xb1
.formula U|xr01skwert.xt001 = U|xr01skwert.xt001 + 0|ylimge * (U|xr1 / 0|ymge)  ? U|xb2
.formula U|xr02wert.xt001   = U|xr02wert.xt001   + 0|yremge * (U|xr1 / 0|ymge)
.formula U|xr02flwert.xt001 = U|xr02flwert.xt001 + 0|yremge * (U|xr1 / 0|ymge)  ? U|xb1
.formula U|xr02skwert.xt001 = U|xr02skwert.xt001 + 0|yremge * (U|xr1 / 0|ymge)  ? U|xb2
.continue POSTATLOADNEXT
..
!POSTATZUPO:
.formula U|xr2 = 0|ylimge                                                       ?  0|ypland = G|inland
.formula U|xr2 = F|fxamount(G|inland,0|ylimge,U|xdstichtag,0|ypland,G|TRUE)     ? _0|ypland = G|inland & _0|ykursfix
.formula U|xr2 = 0|ylimge * 0|yewkurs                                           ? _0|ypland = G|inland &  0|ykursfix
.formula U|xr01wert.xt001   = U|xr01wert.xt001   + U|xr2
.formula U|xr01flwert.xt001 = U|xr01flwert.xt001 + U|xr2                        ?  U|xb1
.formula U|xr01skwert.xt001 = U|xr01skwert.xt001 + U|xr2                        ?  U|xb2
..
.formula U|xr2 = 0|yremge                                                       ?  0|ypland = G|inland
.formula U|xr2 = F|fxamount(G|inland,0|yremge,U|xdstichtag,0|ypland,G|TRUE)     ? _0|ypland = G|inland & _0|ykursfix
.formula U|xr2 = 0|yremge * 0|yewkurs                                           ? _0|ypland = G|inland &  0|ykursfix
.formula U|xr02wert.xt001   = U|xr02wert.xt001   + U|xr2
.formula U|xr02flwert.xt001 = U|xr02flwert.xt001 + U|xr2                        ?  U|xb1
.formula U|xr02skwert.xt001 = U|xr02skwert.xt001 + U|xr2                        ?  U|xb2
..
!POSTATLOADNEXT:
.load 0 continue
.continue POLOADSTAT
..
..
!POKF:
!PS0064: key figure 0PS200064 - PRJMPURCHASEORDERTOTALVALUE
.formula U|xtkennzahl = "0PS200064"
.formula U|xt001    = 'U|xdstichtag:8'
.formula U|xrkfwert =  U|xrwert
.copy    U|xbnull   =  U|xrwert= 0
.input 'U|xtupkeyfigure'
..
..
!PPACKINGSLIP:
..*** key figures for purchase packing slip ********************************************
..reset variables
.input 'U|xtupvar'
..
.formula U|xtsel = "$,,projekt==" + 7|id + ";kotyp==(PackingSlip);@filingmode=(Both)"
.load 0 group "4:2" 'U|xtsel'
!PPSLOAD:
.continue PPSKF         ? _G|mehr
.formula U|xtindex = 0|konto^nummer
..
.formula U|xt001  = ('0|kovom:8')<<6 + "01"
.type real xrwert.xt001                                         ? _F|defined(U|xrwert.xt001)
.type real xrflwert.xt001                                       ? _F|defined(U|xrflwert.xt001)
.type real xrskwert.xt001                                       ? _F|defined(U|xrskwert.xt001)
.type real xrniwert.xt001                                       ? _F|defined(U|xrniwert.xt001)
..
.formula U|xr1 = 0|nwert                                        ? _0|kobrutto
.formula U|xr1 = 0|nwert / (1 + (0|stsatz / 100))               ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrwert       = U|xrwert       + U|xx1
.formula U|xrwert.xt001 = U|xrwert.xt001 + U|xx1
..
.copy U|xb1 = G|TRUE                                            ? _F|defined(U|xtsonstkost.xtindex) & _F|defined(U|xtfertleist.xtindex) & _F|defined(U|xtnrelkost.xtindex)
.copy U|xb2 = G|TRUE                                            ?  F|defined(U|xtsonstkost.xtindex) ;  F|defined(U|xtfertleist.xtindex) ;  F|defined(U|xtnrelkost.xtindex)
..
.formula U|xrflwert       = U|xrflwert       + U|xr1            ?  U|xb1
.formula U|xrflwert.xt001 = U|xrflwert.xt001 + U|xr1            ?  U|xb1
.formula U|xrskwert       = U|xrskwert       + U|xr1            ?  U|xb2
.formula U|xrskwert.xt001 = U|xrskwert.xt001 + U|xr1            ?  U|xb2
..
..Purchase: Delivered, not invoiced
.formula U|xtsel = "$,,orig==" + 0|id + ";kotyp==(Invoice);@filingmode=(Both)"
.load 1 group "4:2" 'U|xtsel'
.continue PPSNEXT       ? G|mehr
.formula U|xr1 = 0|nwert                                        ? _0|kobrutto
.formula U|xr1 = 0|nwert / (1 + (0|stsatz / 100))               ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrniwert       = U|xrniwert       + U|xx1
.formula U|xrniwert.xt001 = U|xrniwert.xt001 + U|xx1
..
!PPSNEXT:
.load 0 continue
.continue PPSLOAD
..
..
!PPSKF:
!PS0073: key figure 0PS200073 - PRJMPURCHPACKINGSLIPVALUE
.formula U|xtkennzahl = "0PS200073"
..      .formula U|xtvar      = "xrwert"
..      .copy    U|xbmonwert  =  G|TRUE
.formula U|xt001    = 'U|xdstichtag:8'
.formula U|xrkfwert =  U|xrwert
.copy    U|xbnull   =  U|xrwert= 0
.input 'U|xtupkeyfigure'
..
..
!PINVOICE:
..*** key figures for purchase invoice *************************************************
..reset variables
.input 'U|xtupvar'
..
.formula U|xtsel = "$,,projekt==" + 7|id + ";kotyp==(Invoice);@filingmode=(Both)"
.load 0 group "4:2" 'U|xtsel'
!PINLOAD:
.continue PINDOWNPAYMENT        ? _G|mehr
..
.formula U|xtindex = 0|konto^nummer
.copy U|xb1 = G|TRUE                                            ? _F|defined(U|xtsonstkost.xtindex) & _F|defined(U|xtfertleist.xtindex) & _F|defined(U|xtnrelkost.xtindex)
.copy U|xb2 = G|TRUE                                            ?  F|defined(U|xtsonstkost.xtindex) ;  F|defined(U|xtfertleist.xtindex) ;  F|defined(U|xtnrelkost.xtindex)
..
.formula U|xt001  = ('0|kopf^budat:8')<<6 + "01"
.type real xrwert.xt001                                         ? _F|defined(U|xrwert.xt001)
.type real xrflwert.xt001                                       ? _F|defined(U|xrflwert.xt001)
.type real xrskwert.xt001                                       ? _F|defined(U|xrskwert.xt001)
.type real xr01wert.xt001                                       ? _F|defined(U|xr01wert.xt001)
..
.formula U|xr1 = 0|nwert                                        ? _0|kobrutto
.formula U|xr1 = 0|nwert / (1 + (0|stsatz / 100))               ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrwert       = U|xrwert       + U|xx1
.formula U|xrwert.xt001 = U|xrwert.xt001 + U|xx1
..
.formula U|xrflwert       = U|xrflwert       + U|xr1            ?  U|xb1
.formula U|xrflwert.xt001 = U|xrflwert.xt001 + U|xr1            ?  U|xb1
.formula U|xrskwert       = U|xrskwert       + U|xr1            ?  U|xb2
.formula U|xrskwert.xt001 = U|xrskwert.xt001 + U|xr1            ?  U|xb2
..
.continue PINNEXT               ? _0|typ = G|ZUPOS
.continue PINNEXT               ? _'0|art^kategorie(L=":")' = "(Downpayment)"
..Downpayment
.formula U|xr01wert       = U|xr01wert       + U|xx1
.formula U|xr01wert.xt001 = U|xr01wert.xt001 + U|xx1
..
!PINNEXT:
.load 0 continue
.continue PINLOAD
..
!PINDOWNPAYMENT:
..<META 0|='P4:24'>
..nur Anzahlungsrechnungen
.formula U|xtsel = "$,,yprjmproj==" + 7|id + ";typ==(Invoice);vorganga==(Downpayment);@filingmode=(Filed)"
.load 0 group "4:24" 'U|xtsel'
!PINDPL:
.continue PINKF         ? _G|mehr
..
.formula U|xt001  = ('0|budat:8')<<6 + "01"
.type real xr02wert.xt001                                       ? _F|defined(U|xr02wert.xt001)
..
.continue PINDPNEXT     ?  F|empty(0|ophist)
.continue PINDPOP       ?  0|ophist^ablagef
..
..<META 1|='P100:2'>
.formula U|xtsel = "$,,ophist==" + 0|ophist^id + ";opztyp==(Payment);@filingmode=(Both)"
.load 1 group "100:2" 'U|xtsel'
!PINOPPAYMENT:
.continue PINDPNEXT     ? _G|mehr
.formula U|xx1 = 0
.formula U|xx1 = 100 * 1|budm / 0|sumbruttoinl     ? _0|sumbruttoinl = 0
.formula U|xr02wert       = U|xr02wert       + (U|xx1 * 0|sumnettoinl / 100)
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + (U|xx1 * 0|sumnettoinl / 100)
.load 1 continue
.continue PINOPPAYMENT
..
!PINDPOP:
.formula U|xr02wert       = U|xr02wert       + 0|sumnetto                                       ?  0|land = G|inland
.formula U|xr02wert       = U|xr02wert       + F|fxamount(G|inland,0|sumnetto,,0|land,G|true)   ? _0|land = G|inland & _0|kursfix
.formula U|xr02wert       = U|xr02wert       + (0|sumnetto * 0|ewkurs)                          ? _0|land = G|inland &  0|kursfix
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + 0|sumnetto                                       ?  0|land = G|inland
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + F|fxamount(G|inland,0|sumnetto,,0|land,G|true)   ? _0|land = G|inland & _0|kursfix
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + (0|sumnetto * 0|ewkurs)                          ? _0|land = G|inland &  0|kursfix
..
!PINDPNEXT:
.load 0 continue
.continue PINDPL
..
