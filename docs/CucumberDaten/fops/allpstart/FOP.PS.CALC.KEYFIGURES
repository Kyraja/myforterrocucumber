..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : allpstart/FOP.PS.CALC.KEYFIGURES
.. Date           : 30.04.2013
.. Version        :
.. Author         : alltrotec/ts
.. Copyright      : (c) 1990 - 2017 alltrotec GmbH
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
.set trans -
..
.input "allpstart/FOP.PS.CALC.KEYFIGURES.VAR"
.. --> 'U|xtupvar'
..
..Accounts other costs of Config
.input "allpstart/FOP.PRJM.UP.LOADCONFIG"       ? _F|defined(5|ypmsonstkost)
!ACC1:
.continue ACC2          ?  F|empty(5|ypmnrelkost)
.load 8 add 5|ypmnrelkost
.continue ACC2          ? _G|mehr
!ACC1LINE:
.load 8 line
.continue ACC2          ? _G|mehr
.continue ACC1LINE      ?  F|empty(8|konto)
.continue ACC1LINE      ? _8|konto^dnr    = 5
.continue ACC1LINE      ? _8|konto^gruppe = 1
..only accounts
.formula U|xtindex = 8|konto^nummer
.type text xtnrelkost.xtindex           ? _F|defined(U|xtnrelkost.xtindex)
.formula U|xtnrelkost.xtindex = 8|konto^id
.continue ACC1LINE
..
!ACC2:
.continue ACC3          ?  F|empty(5|ypmsonstkost)
.load 8 add 5|ypmsonstkost
.continue ACC3          ? _G|mehr
!ACC2LINE:
.load 8 line
.continue ACC3          ? _G|mehr
.continue ACC2LINE      ?  F|empty(8|konto)
.continue ACC2LINE      ? _8|konto^dnr    = 5
.continue ACC2LINE      ? _8|konto^gruppe = 1
..only accounts
.formula U|xtindex = 8|konto^nummer
.type text xtsonstkost.xtindex          ? _F|defined(U|xtsonstkost.xtindex)
.formula U|xtsonstkost.xtindex = 8|konto^id
.continue ACC2LINE
..
!ACC3
.continue ENDACC        ?  F|empty(5|ypmfertleist)
.load 8 add 5|ypmfertleist
.continue ENDACC        ? _G|mehr
!ACC3LINE:
.load 8 line
.continue ENDACC        ? _G|mehr
.continue ACC3LINE      ?  F|empty(8|konto)
.continue ACC3LINE      ? _8|konto^dnr    = 5
.continue ACC3LINE      ? _8|konto^gruppe = 1
..only accounts
.formula U|xtindex = 8|konto^nummer
.type text xtfertleist.xtindex          ? _F|defined(U|xtfertleist.xtindex)
.formula U|xtfertleist.xtindex = 8|konto^id
.continue ACC3LINE
..
!ENDACC:
..
..Zeitbereich fˇÔøΩr abgeschlossene Projekte
.. Monatsanfang des Voronats setzen
.formula U|xdvon    = "<M-1M"
.formula U|xdadatum = U|xdvon
.. Monatsletzten des aktuellen Monats
.formula U|xdbis    = ">M"
.formula U|xdedatum = U|xdbis
..
.formula U|xdstatdat  = U|xdedatum
.formula U|xdstichtag = 'U|xdbis:8'<<6 + "01"
..
.continue PROJECT       ? _F|empty(U|xtprojekt)
..
..load Projects
..<META 7|='P86:1'>
.load 7 group 'U|xydbgrprojekt' "!"
!LOADPROJ:
.continue END           ? _G|mehr
.continue LOADNEXTPROJ  ?  7|yablage & (7|yabldat < U|xdadatum ; 7|yabldat > U|xdedatum)
..
.continue START
..
!PROJECT:
.load 7 group 'U|xydbgrprojekt' 'U|xtprojekt'
.continue END           ? _G|mehr
..
!START:
..
..*** key figures for quotations **********************************************
..reset variables
.input 'U|xtupvar'
..
!SALESORDER:
..*** key figures for sales order (SalesAndPurchaseStatistics) ****************
..reset variables
.input 'U|xtupvar'
..
.formula U|xtsel = "$,,yprjmproj==" + 7|id + ";ktyp==(SalesOrder);@filingmode=(Both)"
.load 0 group "3:22" 'U|xtsel'
!SOLOAD:
.continue SOSALESSTAT   ? _G|mehr
.formula U|xianz  = U|xianz  + 1
.formula U|xioanz = U|xioanz + 1        ? _0|ablagef
.formula U|xiaanz = U|xiaanz + 1        ?  0|ablagef
..
..  .formula U|xrwert = U|xrwert + 0|sumnetto                                       ?  0|waehr = G|inland
..  .formula U|xrwert = U|xrwert + F|fxamount(G|inland,0|sumnetto,,0|waehr,G|TRUE)  ? _0|waehr = G|inland & _0|kursfix
..  .formula U|xrwert = U|xrwert + (0|sumnetto * 0|ewkurs)                          ? _0|waehr = G|inland &  0|kursfix
..
.load 0 continue
.continue SOLOAD
..
!SOSALESSTAT:
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";ybezugsdatum==" + U|xdstatdat:8 + ";yekvk==(Sales);yalternativpos=(No);@filingmode=(Active)"
.load 0 group 'U|xydbgrvkstat' 'U|xtsel'
!SOLOADSTAT:
.continue SOKF          ? _G|mehr
..
.formula U|xr1      = 0|ynwert                                                                  ? _0|ybrutto
.formula U|xr1      = 0|ynwert   - 0|ystwert                                                    ?  0|ybrutto
.formula U|xrwert   = U|xrwert   + U|xr1                                                        ?  0|ypland = G|inland
.formula U|xrwert   = U|xrwert   + F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)      ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrwert   = U|xrwert   + (U|xr1 * 0|yewkurs)                                          ? _0|ypland = G|inland &  0|ykursfix
..
.formula U|xr1      = 0|yeigenanteil                                                            ? _0|ybrutto
.formula U|xr1      = 0|yeigenanteil / (1 + (0|ystsatz / 100))                                  ?  0|ybrutto
.formula U|xrelwert = U|xrelwert + U|xr1                                                        ?  0|ypland = G|inland
.formula U|xrelwert = U|xrelwert + F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)      ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrelwert = U|xrelwert + (U|xr1 * 0|yewkurs)                                          ? _0|ypland = G|inland &  0|ykursfix
..
.formula U|xr1      = 0|yfremdanteil                                                            ? _0|ybrutto
.formula U|xr1      = 0|yfremdanteil / (1 + (0|ystsatz / 100))                                  ?  0|ybrutto
.formula U|xrflwert = U|xrflwert + U|xr1                                                        ?  0|ypland = G|inland
.formula U|xrflwert = U|xrflwert + F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)      ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrflwert = U|xrflwert + (U|xr1 * 0|yewkurs)                                          ? _0|ypland = G|inland &  0|ykursfix
..
.formula U|xr1      = 0|ysonstkost                                                              ? _0|ybrutto
.formula U|xr1      = 0|ysonstkost / (1 + (0|ystsatz / 100))                                    ?  0|ybrutto
.formula U|xrskwert = U|xrskwert + U|xr1                                                        ?  0|ypland = G|inland
.formula U|xrskwert = U|xrskwert + F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)      ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrskwert = U|xrskwert + (U|xr1 * 0|yewkurs)                                          ? _0|ypland = G|inland &  0|ykursfix
..
.formula U|xr1      = 0|yfertleist                                                              ? _0|ybrutto
.formula U|xr1      = 0|yfertleist / (1 + (0|ystsatz / 100))                                    ?  0|ybrutto
.formula U|xrfewert = U|xrfewert + U|xr1                                                        ?  0|ypland = G|inland
.formula U|xrfewert = U|xrfewert + F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)      ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrfewert = U|xrfewert + (U|xr1 * 0|yewkurs)                                          ? _0|ypland = G|inland &  0|ykursfix
..
..budget value
.formula U|xr1      = 0|ybudgetwert
.formula U|xr01wert = U|xr01wert   + U|xr1                                                      ?  0|ypland = G|inland
.formula U|xr01wert = U|xr01wert   + F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)    ? _0|ypland = G|inland & _0|ykursfix
.formula U|xr01wert = U|xr01wert   + (U|xr1 * 0|yewkurs)                                        ? _0|ypland = G|inland &  0|ykursfix
..
..offener Liefer und Rechnungswert
.continue SOSTATLOADNEXT        ? 0|ylimge = 0 & 0|yremge = 0
.continue SOSTATLOADNEXT        ? 0|ymge = 0
.continue SOSTATZUPO            ?  '0|yevtyp(L="0")' = "(12)"
.formula U|xr1      = 0|ynwert                                                                  ? _0|ybrutto
.formula U|xr1      = 0|ynwert - 0|ystwert                                                      ?  0|ybrutto
.formula U|xr1      =  F|fxamount(G|inland,U|xr1,U|xdstichtag,0|ypland,G|TRUE)                  ? _0|ypland = G|inland & _0|ykursfix
.formula U|xr1      = (U|xr1 * 0|yewkurs)                                                       ? _0|ypland = G|inland &  0|ykursfix
..
.formula U|xrolwert = U|xrolwert + 0|ylimge * (U|xr1 / 0|ymge)
.formula U|xrorwert = U|xrorwert + 0|yremge * (U|xr1 / 0|ymge)
.continue SOSTATLOADNEXT
..
!SOSTATZUPO:
.formula U|xrolwert = U|xrolwert + 0|ylimge                                                     ?  0|ypland = G|inland
.formula U|xrolwert = U|xrolwert + F|fxamount(G|inland,0|ylimge,U|xdstichtag,0|ypland,G|TRUE)   ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrolwert = U|xrolwert + (0|ylimge * 0|yewkurs)                                       ? _0|ypland = G|inland &  0|ykursfix
.formula U|xrorwert = U|xrorwert + 0|yremge                                                     ?  0|ypland = G|inland
.formula U|xrorwert = U|xrorwert + F|fxamount(G|inland,0|yremge,U|xdstichtag,0|ypland,G|TRUE)   ? _0|ypland = G|inland & _0|ykursfix
.formula U|xrorwert = U|xrorwert + (0|yremge * 0|yewkurs)                                       ? _0|ypland = G|inland &  0|ykursfix
..
!SOSTATLOADNEXT:
.load 0 continue
.continue SOLOADSTAT
..
..
!SOKF:
!PS0004: key figure 0PS200004 - PRJMCOUNTSALESORDER
.formula U|xtkennzahl = "0PS200004"
.formula U|xt001      = 'U|xdstichtag:8'
.formula U|xrkfwert   =  U|xianz
.copy    U|xbnull     = U|xianz = 0
.input 'U|xtupkeyfigure'
..
!PS0006: key figure 0PS200006 - PRJMCOUNTFILEDSALESORDER
.formula U|xtkennzahl = "0PS200006"
.formula U|xt001      = 'U|xdstichtag:8'
.formula U|xrkfwert   =  U|xiaanz
.copy    U|xbnull     =  U|xiaanz = 0
.input 'U|xtupkeyfigure'
..
!PS0007: key figure 0PS200007 - PRJMSALESORDERVALUE
.formula U|xtkennzahl = "0PS200007"
.formula U|xt001      = 'U|xdstichtag:8'
.formula U|xrkfwert   =  U|xrwert
.copy    U|xbnull     =  U|xrwert = 0
.input 'U|xtupkeyfigure'
..
..
!PACKINGSLIP:
..*** key figures for packing slip ********************************************
..reset variables
.input 'U|xtupvar'
..
.formula U|xtsel = "$,,projekt==" + 7|id + ";kotyp==(PackingSlip);@filingmode=(Both)"
.load 0 group "3:2" 'U|xtsel'
!PSLOAD:
.continue PSKF          ? _G|mehr
..
.formula U|xt001  = ('0|kovom:8')<<6 + "01"
.type real xrwert.xt001                                         ? _F|defined(U|xrwert.xt001)
.type real xrelwert.xt001                                       ? _F|defined(U|xrelwert.xt001)
.type real xrflwert.xt001                                       ? _F|defined(U|xrflwert.xt001)
.type real xrskwert.xt001                                       ? _F|defined(U|xrskwert.xt001)
.type real xrfewert.xt001                                       ? _F|defined(U|xrfewert.xt001)
.type real xrniwert.xt001                                       ? _F|defined(U|xrniwert.xt001)
..
.formula U|xr1 = 0|nwert                                        ? _0|kobrutto
.formula U|xr1 = 0|nwert / (1 + (0|stsatz / 100))               ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrwert       = U|xrwert       + U|xx1
.formula U|xrwert.xt001 = U|xrwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpeigenleist                             ? _0|kobrutto
.formula U|xr1 = 0|yprjmpeigenleist / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrelwert       = U|xrelwert       + U|xx1
.formula U|xrelwert.xt001 = U|xrelwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpfremdleist                             ? _0|kobrutto
.formula U|xr1 = 0|yprjmpfremdleist / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrflwert       = U|xrflwert       + U|xx1
.formula U|xrflwert.xt001 = U|xrflwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpsonstkost                              ? _0|kobrutto
.formula U|xr1 = 0|yprjmpsonstkost  / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrskwert       = U|xrskwert       + U|xx1
.formula U|xrskwert.xt001 = U|xrskwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpfertleist                              ? _0|kobrutto
.formula U|xr1 = 0|yprjmpfertleist  / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrfewert       = U|xrfewert       + U|xx1
.formula U|xrfewert.xt001 = U|xrfewert.xt001 + U|xx1
..
..Sales: Delivered, not invoiced
.formula U|xtsel = "$,,orig==" + 0|id + ";kotyp==(Invoice);@filingmode=(Both)"
.load 1 group "3:2" 'U|xtsel'
.continue PSNEXT        ? G|mehr
.formula U|xr1 = 0|nwert                                        ? _0|kobrutto
.formula U|xr1 = 0|nwert / (1 + (0|stsatz / 100))               ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrniwert       = U|xrniwert       + U|xx1
.formula U|xrniwert.xt001 = U|xrniwert.xt001 + U|xx1
..
!PSNEXT:
.load 0 continue
.continue PSLOAD
..
..
!PSKF:
!PS0014: key figure 0PS200014 - PRJMPACKINGSLIPVALUE
.formula U|xtkennzahl = "0PS200014"
..      .formula U|xtvar      = "xrwert"
..      .copy    U|xbmonwert  =  G|TRUE
.formula U|xt001    = 'U|xdstichtag:8'
.formula U|xrkfwert =  U|xrwert
.copy    U|xbnull   =  U|xrwert= 0
.input 'U|xtupkeyfigure'
..
..
!INVOICE:
..*** key figures for invoice *************************************************
..reset variables
.input 'U|xtupvar'
..
.formula U|xtsel = "$,,projekt==" + 7|id + ";kotyp==(Invoice);@filingmode=(Both)"
.load 0 group "3:2" 'U|xtsel'
!INLOAD:
.continue INDOWNPAYMENT         ? _G|mehr
..
.formula U|xt001  = ('0|kopf^budat:8')<<6 + "01"
.type real xrwert.xt001                                         ? _F|defined(U|xrwert.xt001)
.type real xrelwert.xt001                                       ? _F|defined(U|xrelwert.xt001)
.type real xrflwert.xt001                                       ? _F|defined(U|xrflwert.xt001)
.type real xrskwert.xt001                                       ? _F|defined(U|xrskwert.xt001)
.type real xrfewert.xt001                                       ? _F|defined(U|xrfewert.xt001)
.type real xr01wert.xt001                                       ? _F|defined(U|xr01wert.xt001)
..
.formula U|xr1 = 0|nwert                                        ? _0|kobrutto
.formula U|xr1 = 0|nwert / (1 + (0|stsatz / 100))               ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrwert       = U|xrwert       + U|xx1
.formula U|xrwert.xt001 = U|xrwert.xt001 + U|xx1
..
.continue INNOZUPOS     ? _0|typ = G|ZUPOS
.continue INNOZUPOS     ? _'0|art^kategorie(L=":")' = "(Downpayment)"
..Downpayment
.formula U|xr01wert       = U|xr01wert       + U|xx1
.formula U|xr01wert.xt001 = U|xr01wert.xt001 + U|xx1
..
!INNOZUPOS
.formula U|xr1 = 0|yprjmpeigenleist                             ? _0|kobrutto
.formula U|xr1 = 0|yprjmpeigenleist / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrelwert       = U|xrelwert       + U|xx1
.formula U|xrelwert.xt001 = U|xrelwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpfremdleist                             ? _0|kobrutto
.formula U|xr1 = 0|yprjmpfremdleist / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrflwert       = U|xrflwert       + U|xx1
.formula U|xrflwert.xt001 = U|xrflwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpsonstkost                              ? _0|kobrutto
.formula U|xr1 = 0|yprjmpsonstkost  / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrskwert       = U|xrskwert       + U|xx1
.formula U|xrskwert.xt001 = U|xrskwert.xt001 + U|xx1
..
.formula U|xr1 = 0|yprjmpfertleist                              ? _0|kobrutto
.formula U|xr1 = 0|yprjmpfertleist  / (1 + (0|stsatz / 100))    ?  0|kobrutto
.formula U|xx1 = U|xr1                                          ?  0|pland = G|inland
.formula U|xx1 = F|fxamount(G|inland,U|xr1,,0|pland ,G|TRUE)    ? _0|pland = G|inland & _0|kopf^kursfix
.formula U|xx1 = (U|xr1 * 0|kopf^ewkurs)                        ? _0|pland = G|inland &  0|kopf^kursfix
.formula U|xrfewert       = U|xrfewert       + U|xx1
.formula U|xrfewert.xt001 = U|xrfewert.xt001 + U|xx1
..
..
!INNEXT:
.load 0 continue
.continue INLOAD
..
.continue MAINPROJECT   ? _F|sysinfo(18)^allpstd
..
!INDOWNPAYMENT:
..<META 0|='P3:24'>
..Nur Anzahlungsrechnungen
.formula U|xtsel = "$,,yprjmproj==" + 7|id + ";typ==(Invoice);vorganga==(Downpayment);@filingmode=(Filed)"
.load 0 group "3:24" 'U|xtsel'
!INDPL:
.continue INKF          ? _G|mehr
..
.formula U|xt001  = ('0|budat:8')<<6 + "01"
.type real xr02wert.xt001                                       ? _F|defined(U|xr02wert.xt001)
..
.continue INDPNEXT      ?  F|empty(0|ophist)
..Wennn alles gezahlt ist, dann = Nettosumme aus Rechnung, nicht der wirklich gezahlte Betrag dafÅr aber 100%
.continue INDPOP        ?  0|ophist^ablagef
..
..<META 1|='P100:2'>
.formula U|xtsel = "$,,ophist==" + 0|ophist^id + ";opztyp==(Payment);@filingmode=(Both)"
.load 1 group "100:2" 'U|xtsel'
!INOPPAYMENT:
.continue INDPNEXT      ? _G|mehr
..wenn nicht vollstÑndig gezahlt Steuer Åber VerhÑltnis zur Nettisumme rausrechnen
.formula U|xx1 = 0
.formula U|xx1 = 100 * 1|budm / 0|sumbruttoinl     ? _0|sumbruttoinl = 0
.formula U|xr02wert       = U|xr02wert       + (U|xx1 * 0|sumnettoinl / 100)
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + (U|xx1 * 0|sumnettoinl / 100)
..  .formula U|xr02wert.xt001 = U|xr02wert.xt001 + 1|budm
.load 1 continue
.continue INOPPAYMENT
..
!INDPOP:
.formula U|xr02wert       = U|xr02wert       + 0|sumnetto                                       ?  0|waehr = G|inland
.formula U|xr02wert       = U|xr02wert       + F|fxamount(G|inland,0|sumnetto,,0|waehr,G|true)  ? _0|waehr = G|inland & _0|kursfix
.formula U|xr02wert       = U|xr02wert       + (0|sumnetto * 0|ewkurs)                          ? _0|waehr = G|inland &  0|kursfix
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + 0|sumnetto                                       ?  0|waehr = G|inland
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + F|fxamount(G|inland,0|sumnetto,,0|waehr,G|true)  ? _0|waehr = G|inland & _0|kursfix
.formula U|xr02wert.xt001 = U|xr02wert.xt001 + (0|sumnetto * 0|ewkurs)                          ? _0|waehr = G|inland &  0|kursfix
..
!INDPNEXT:
.load 0 continue
.continue INDPL
..
!INKF:
