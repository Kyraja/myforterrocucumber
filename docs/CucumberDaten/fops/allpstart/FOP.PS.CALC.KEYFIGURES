!EIALPVSTAT:
..
.formula U|xtsel = "$,,yprojekt==" + 7|id + ";yadatum<=" + U|xdstatdat:8 + ";@filingmode=(Active)"
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue IAKF          ? _G|mehr
!IALACTREP:
..  .formula U|xr03wert   = U|xr03wert + 0|yarbzeit
.formula U|xr04wert   = U|xr04wert + 0|yarbzeit         ? 0|ypersonal^yprjmperstypk = "EM"
.formula U|xr05wert   = U|xr05wert + 0|yarbzeit         ? 0|ypersonal^yprjmperstypk = "FP"
.formula U|xr06wert   = U|xr06wert + 0|yfaktzeit
..
.continue IANOPS        ? F|empty(0|ylsposid) ; 0|ylsposid = "(0,0,0)"
.load 9 group "P3:2" '0|ylsposid'
.continue IANOPS        ? _G|mehr
.continue IANOPS        ?  9|kovom > U|xdstatdat
.copy U|xb1 = G|TRUE
!IANOPS:
.continue IANOINV       ? F|empty(0|yreposid) ; 0|yreposid = "(0,0,0)"
.load 9 group "P3:2" '0|yreposid'
.continue IANOINV       ? _G|mehr
.continue IANOINV       ?  9|kopf^budat > U|xdstatdat
.copy U|xb2 = G|TRUE
!IANOINV:
.formula U|xr07wert   = U|xr07wert + 0|yfaktzeit        ? _U|xb1 & _U|xb2
.formula U|xr08wert   = U|xr08wert + 0|yfaktzeit        ?  U|xb1
.formula U|xr09wert   = U|xr09wert + 0|yfaktzeit        ?  U|xb2
..
.copy U|xb1 = G|false
.copy U|xb2 = G|false
..
.load 0 continue
.continue IALACTREP     ?  G|mehr
..
