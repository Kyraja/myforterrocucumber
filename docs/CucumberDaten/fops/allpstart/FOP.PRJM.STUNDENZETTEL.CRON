!PROC003: ----- Stundenzettel_anlegen -----


Stundenzettel erstellen ('U|xdadatum' - 'U|xdedatum')
.file -TEMPNAME U|xttmpdat
.output NEW 'U|xttmpdat'
.input DATEI.F
.load 7 group 'U|xydbgrpersonal' "$,,@ablageart=(1)"
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.copy U|xbok = G|FALSE
.copy U|xbok = G|TRUE   ? _7|yprjminaktiv & 7|yprjmpplanrelev
.continue EL021 ? _(F|sysinfo(10)^ykonfigprjm^ypmbpershistorie)
.formula U|xdhistzeitstempel = 'U|xdedatum' + " 23:59"
.formula U|xtsel = "$,,yhistpersonal==" + 7|id + ";yhistzeitstempel>=" + 'U|xdadatum'
.formula U|xtsel = U|xtsel + ";@ordnung=yhistzeitstempel;@ablageart=(1);@zeilen=(0)"
.load 8 group 'U|xydbgrpershistorie' 'U|xtsel'
.continue EL022 ? _(G|mehr)
.copy U|xbok   = G|FALSE
.copy U|xbmehr = G|TRUE
!REPT001: ==============================
.copy U|xbok   = G|TRUE         ? _8|yprjminaktiv & 8|yprjmpplanrelev
.copy U|xbmehr = G|FALSE        ? _8|yprjminaktiv & 8|yprjmpplanrelev
.copy U|xbmehr = G|FALSE        ?  8|yhistzeitstempel > U|xdhistzeitstempel
.load 8 continue
.copy U|xbmehr = G|FALSE        ? _G|mehr
.continue REPT001 ? _(_(U|xbmehr))
!EL022
!EL021
.continue EL023 ? _(U|xbok)
.formula U|xtsel = "$,,"
