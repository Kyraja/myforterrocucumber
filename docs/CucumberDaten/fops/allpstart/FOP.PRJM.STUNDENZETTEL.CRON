.type text    xtsys xtcmd xtsel xttmpdat xtpersonal xtobjekt xtindex xt1 xt2
.type integer ximonat xianzat xitag xi1
.type real    xrsollstd xrsollwoche xrsolltag xrsollhalb xranzat xrsoll1 xrsoll2 xrsoll3 xrsoll4 xrsoll5 xrsoll6 xrsoll7 xr1
.type GD      xdadatum xdedatum xdatum xdseladat xdseledat xdkzu1 xdkzu2 xdpershist
.type GD19    xdhistzeitstempel
.type J4      xjjahr xj1
.type bool    xblz xbmehr xbkstzuord xbpershist xbok xbhtag1 xbhtag2 xbhtag3 xbhtag4 xbhtag5 xbhtag6 xbhtag7
.type VP26    xpkalbezugsobj xpzuordkbo xpaktkbo
.type P39:2   xplgruppe      xpzuordlg  xpaktlg
.type integer xprocsp      ? _F|defined(U|xprocsp)
.set demand -
