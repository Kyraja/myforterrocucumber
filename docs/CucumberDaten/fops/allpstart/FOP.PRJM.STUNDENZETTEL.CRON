.formula U|xtsel = U|xtsel + ";ykstelle==" + H|ykstelle^id              ? _F|empty(H|ykstelle)
.formula U|xtsel = U|xtsel + ";ykstelle==`"                             ?  F|empty(H|ykstelle)
.load 0 group 'U|xydbgrlnachweis' 'U|xtsel'
.continue EL008 ? _(_(G|mehr))
.formula U|xtsel = "$,,@ablageart=(1);@maxtreffer=1"
