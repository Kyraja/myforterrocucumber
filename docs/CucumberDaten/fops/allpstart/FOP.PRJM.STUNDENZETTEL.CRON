.continue EPROCDEF
!PROC001: ----- Stundenzettel -----
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" +  U|xtpersonal
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'U|ximonat'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'U|xjjahr'
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(0)"
.select group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL001 ? _(G|mehr)
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" +  U|xtpersonal
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'U|ximonat'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'U|xjjahr'
.formula U|xtsel = U|xtsel + ";yprojekt=="  +  U|xtobjekt       ? 5|yartstdfreigabek = "PROJ" & _F|empty(U|xtobjekt)
.formula U|xtsel = U|xtsel + ";yprojekt==`"                     ? 5|yartstdfreigabek = "PROJ" &  F|empty(U|xtobjekt)
.formula U|xtsel = U|xtsel + ";ykstelle=="  +  U|xtobjekt       ? 5|yartstdfreigabek = "KST"  & _F|empty(U|xtobjekt)
.formula U|xtsel = U|xtsel + ";ykstelle==`"                     ? 5|yartstdfreigabek = "KST"  &  F|empty(U|xtobjekt)
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(1)"
.select lock group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL002 ? _(_(G|mehr))
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";ypersonal==" +  U|xtpersonal
.formula U|xtsel = U|xtsel + ";ymonat=="    + 'U|ximonat'
.formula U|xtsel = U|xtsel + ";yjahr=="     + 'U|xjjahr'
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(0)"
.select lock group 'U|xydbgrstundenzettel' 'U|xtsel'
.continue EL003 ? _(G|mehr)
.make line +
.formula H|yprojekt   = U|xtobjekt       ? 5|yartstdfreigabek = "PROJ"
.formula H|ykstelle   = U|xtobjekt       ? 5|yartstdfreigabek = "KST"
.rewrite
Edit: 'H|nummer' ('H|ypersonal' - 'H|ymonat'/'H|yjahr' - 'H|yprojekt' 'H|ykstelle')
!EL003
.continue FI002
!EL002
.select line 'H|selzeile'
Nothing: 'H|nummer' ('H|ypersonal' - 'H|ymonat'/'H|yjahr' - 'H|yprojekt' 'H|ykstelle')
!FI002
.continue FI001
!EL001
.formula U|xtcmd = "make " + G|hdatname.xydbstundenzettel + " GROUP" + 'U|xygrstundenzettel'
.'U|xtcmd'
.formula H|ypersonal  = U|xtpersonal
.formula H|such       = H|ypersonal^such
.formula H|ypersname  = H|ypersonal^namebspr
.formula H|ymonat     = U|ximonat
.formula H|yjahr      = U|xjjahr
.make line +
.formula H|yprojekt   = U|xtobjekt       ? 5|yartstdfreigabek = "PROJ"
.formula H|ykstelle   = U|xtobjekt       ? 5|yartstdfreigabek = "KST"
.rewrite
.select line 'H|tzeilen'
?New: 'H|nummer' ('H|ypersonal' - 'H|ymonat'/'H|yjahr' - 'H|yprojekt' 'H|ykstelle')     ? H|aktzeile > 0
?New: 'H|nummer' ('H|ypersonal' - 'H|ymonat'/'H|yjahr' - 'U|xtobjekt')                  ? H|aktzeile = 0
!FI001
.continue 'xprocst.xprocsp'
!PROC002: ----- Stundenzettel_aufr„umen -----
vorhandene Stundenzettel bereinigen (Monat 'F|month(U|xdadatum)')
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";yberfabschluss=0;ybgesabschluss=0;ybgedruckt=0"
.formula U|xtsel = U|xtsel + ";yjahr=="  + 'F|year(U|xdadatum)'
.formula U|xtsel = U|xtsel + ";ymonat==" + 'F|month(U|xdadatum)'
.formula U|xtsel = U|xtsel + ";versionn<=" + 'G|versionneu'
.formula U|xtsel = U|xtsel + ";@ablageart=(1);@zeilen=(0)"
.select lock group 'U|xydbgrstundenzettel' 'U|xtsel'
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.formula U|xdseladat = 'H|yjahr' + ("0" + 'H|ymonat')>>2 + "01"
.formula U|xdseledat = U|xdseladat + 31
.formula U|xdseledat = ('U|xdseledat:8'<<6) + "01"
.formula U|xdseledat = U|xdseledat - 1
.select lock line
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
