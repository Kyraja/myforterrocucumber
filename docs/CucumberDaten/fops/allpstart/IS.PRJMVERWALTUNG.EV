.continue EL012 ? _(G|mehr)
.continue EL013 ? _(((D|dnr    = U|xydbprojekt) & (D|gruppe = U|xygrprojekt)) ; ((D|dnr    = U|xydbpvorgang) & (D|gruppe = U|xygrpvorgang)))
