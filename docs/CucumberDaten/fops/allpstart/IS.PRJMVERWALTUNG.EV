.copy   U|xbok      = G|false
.assign U|xdcpstart = ""
.select screen header
.select screen line
!LOOP012: ==============================
.continue ELOP012 ? _(G|mehr)
.continue EL044 ? _(M|ybkopie)
.copy U|xbok      = G|true
.formula U|xdcpstart = M|yadatum        ?  M|tbaumstufe = 1 & (F|empty(U|xdcpstart) ; U|xdcpstart > M|yadatum)
.continue EL045 ? _((_(F|empty(U|xdcpstart))) & (G|evtvar = "ybuteilbaumkopie"))
.formula U|xiatanz = M|ytbstart & U|xdcpstart
.formula U|xiatanz = U|xiatanz * (-1)            ?  U|xdcpstart > M|ytbstart
.formula U|xiktanz = M|ytbstart - U|xdcpstart
!EL045
!EL044
.select screen line
.continue LOOP012
!ELOP012: ==============================
.continue EL046 ? _(_(U|xbok))
.set trans +
.box Hinweis
Es ist kein Vorgang zum Kopieren markiert.
.set trans -
.error
.end 1
