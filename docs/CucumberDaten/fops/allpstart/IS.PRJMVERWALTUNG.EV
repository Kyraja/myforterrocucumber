!PROC008: ----- kopieren -----
.add M|yobjekt
.formula U|xdstart = M|yadatum +  U|xiktanz
.formula U|xdende  = U|xdstart & (D|ydauer- 1)
.formula U|xdende  = U|xdstart              ? D|ydauer = 0 ; U|xdstart > U|xdende
.output NEW 'U|xtedpout'
.output NEW 'U|xtedperr'
.output NEW 'U|xtedpdat'
.formula U|xtdauer = "XXXXXX"
.formula U|xtdauer = "0"                ?  D|ydauer = 0
.formula U|xtsoll  = "0"
.formula U|xtsoll  = D|ypvsollstd       ?  D|yistblatt &  M|ytbstdkopie
.formula U|xtsoll  = "XXXXXX"           ? _D|yistblatt ;  D|ybmeilenstein
.formula U|xtplan  = "0"
.formula U|xtplan  = D|ypvplanstd       ?  D|yistblatt &  M|ytbstdkopie
.formula U|xtplan  = "XXXXXX"           ? _D|yistblatt ;  D|ybmeilenstein
.formula U|xtpersonal = D|ypersonal^id          ?  M|ytbbearbkopie
.formula U|xtpersonal = ""                      ? _M|ytbbearbkopie
.formula U|xtprojteam = D|yprojteam^id          ?  M|ytbbearbkopie
.formula U|xtprojteam = ""                      ? _M|ytbbearbkopie
.formula U|xtkstelle  = D|ykstelle^id           ?  M|ytbbearbkopie
.formula U|xtkstelle  = ""                      ? _M|ytbbearbkopie
.formula U|xtverantw  = D|yverantw^id           ?  M|ytbverantwkopie
.formula U|xtverantw  = U|xtprojverantw         ? _M|ytbverantwkopie
.formula U|xtarbpaket = ""
.continue EL033 ? _((M|ytbapkopie) & (_(F|empty(D|yarbpaket))))
.add D|yarbpaket
.formula U|xtnummer = D|nummer
.formula U|xtsel = "$,,"
.formula U|xtsel = U|xtsel + ";such=="          + D|such
.formula U|xtsel = U|xtsel + ";yprojekt=="      + U|xtprojekt
.formula U|xtsel = U|xtsel + ";yausapvorlage==" + D|yausapvorlage^id    ? _F|empty(D|yausapvorlage)
.load 9 group 'U|xydbgrarbpaket' 'U|xtsel'
.continue EL034 ? _(G|mehr)
.type text xtap.xtnummer    ? _F|defined(U|xtap.xtnummer)
.formula U|xtap.xtnummer = 9|id
!EL034
.continue EL035 ? _(_(F|defined(U|xtap.xtnummer)))
.type text xtap.xtnummer
.formula U|xtap.xtnummer = "AP" + U|xtnummer
.continue EL036 ? _((_(F|empty(M|yobjekt^yarbpaket^yausapvorlage))) & ((U|xbneuvorproj) ; (U|xbvorproj)))
.add M|yobjekt^yarbpaket^yausapvorlage
.continue EL037 ? _(G|mehr)
