!PROC009: ----- Projekt_kopieren -----
.continue BRK001 ? _(G|evtvar = "ybukopie")
.continue ESAC001
!BRK001
.continue BRK002 ? _(G|evtvar = "ybuteilbaumkopie")
.continue EL043 ? _((F|empty(M|yzielprojekt)) ; (F|empty(M|ytbstart)))
.set trans +
.box Hinweis
Bitte zuerst das Zielprojekt und das neue Startdatum fÅr die Kopie des Teilbaumes angeben.
.set trans -
.curso yzielprojekt 0
.error
.end 1
