..====================================================
.type text  xtsel xtsys xtcmd xtedpdat xtedpout xtedperr xtedpmsg xtextid xykoobjekt xterrtext
.type text  xtispartof xtprojekt xtprojsuch xtorgproj xtobjekt xtknoten xtdauer xtsoll xtplan
.type text  xtarbpaket xtnummer xtpersonal xtprojteam xtkstelle xtverantw xtprojverantw
.type text  xttxtabgelegt xttxterledigt xttxtabrechn xttxtls xttxtre
.type text  xtcpkunde xt1 xtupprojlad xtfarbefeab xtfarbe0 xtclref
.type integer   xiaktzeile xizeile ximaxstufe xi1 xiatanz xiktanz xisort
.type GD    xdstart xdende xdatum xdcpstart
.type bool  xbmehr xbok xbbool xbnurpruef xbkeinmenue xyberlaubt xbvorproj xbneuvorproj
.type integer   xprocsp ? _F|defined(U|xprocsp)
.formula U|xprocsp = 0
.set demand -
..====================================================
.continue EPROCDEF
!PROC001: ----- TabLeeren -----
.assign M|yanzat    = 0
.assign M|yaufstart = ""
.assign M|ypstart   = ""
.make screen line --o
.continue 'xprocst.xprocsp'
!PROC002: ----- Pruef_Projekt -----
.continue EL001 ? _((F|empty(M|yprojekt)) ; (M|tzeilen  = 0))
.set trans +
.box Hinweis
Bitte zuerst ein Projekt angeben.
.set trans -
.error
.end 1
!EL001
.continue 'xprocst.xprocsp'
!PROC003: ----- ChecklistenKopieren -----
.continue EL002 ? _((M|ytbclkopie) & (_(U|xbneuvorproj)))
.copy U|xbmehr = G|false
.load 8 group 'U|xydbgrclvorlage' 'F|expr("$,,yobjektid==" + M|yobjekt^id + ";@filingmode=(Active)")'  ?  U|xbvorproj
.load 8 group 'U|xydbgrclcheckl' 'F|expr("$,,yobjektid==" + M|yobjekt^id + ";@filingmode=(Active)")'   ? _U|xbvorproj
!LOOP001: ==============================
.continue ELOP001 ? _(G|mehr)
.continue EL003 ? _(_(U|xbmehr))
.set separator
.set substitution "+LX,&,&amp;, ,<,&lt;, ,>,&gt;,"
.output NEW 'U|xtedpdat' -encoding "UTF-8"
.input DATEI.F
<'G|fragechar'xml version='G|dblquote'1.0'G|dblquote' encoding='G|dblquote'UTF-8'G|dblquote''G|fragechar'>
<?edp langcode 'G|bsprache'?>
<'G|fragechar'edp updatemode ERRABORT'G|fragechar'>
<ABASData reftype='G|dblquote'ref'G|dblquote'>
  <RecordSet>
.copy U|xbmehr = G|true
!EL003
.continue EL004 ? _(U|xbvorproj)
    <Record database="'U|xydbclcheckl'" group="'U|xygrclcheckl'" action="NEW" >
      <Field name="such">'8|such'</Field>
      <Field name="name">'8|namebspr'</Field>
      <Field name="yvorlage">'8|id'</Field>
      <Field name="yobjektid">'U|xtclref'</Field>
      <Field name="yma">'8|yma^id'</Field>
      <Field name="yzeich">'G|bzeichen'</Field>
.continue FI004
!EL004
    <Record database="'U|xydbclcheckl'" group="'U|xygrclcheckl'" action="COPY" id="'8|id'">
      <Field name="yobjektid">'U|xtclref'</Field>
      <Field name="ystatusk">01</Field>
      <Field name="yzeich">'G|bzeichen'</Field>
!FI004
.continue EL005 ? _(_(F|empty(8|yftext)))
.copy U|xbbool = G|false
.select from '8|yftext' xtext^
!LOOP002: ==============================
.continue ELOP002 ? _(G|mehr)
.continue EL006 ? _(U|xbbool)
'U|xtext'
.continue FI006
!EL006
.copy U|xbbool = G|true
<Field name="yftext" abasType="TN">'U|xtext'
!FI006
.select from '8|yftext' U|xtext^
.continue LOOP002
!ELOP002: ==============================
?        </Field>       ? U|xbbool
!EL005
.load 8 line
!LOOP003: ==============================
.continue ELOP003 ? _(G|mehr)
.continue EL007 ? _(U|xbvorproj)
      <Row rowOp="+">
        <Field name="ytbeschr">'8|ytbeschr'</Field>
        <Field name="ytverweisid">'8|ytverweisid'</Field>
        <Field name="ytdokument">'8|ytdokument^id'</Field>
        <Field name="ytresvp">'8|ytresvp^id'</Field>
        <Field name="ytrest">'8|ytrest'</Field>
        <Field name="ytresr">'8|ytresr(L="0")'</Field>
        <Field name="ytresi">'8|ytresi(L="0")'</Field>
        <Field name="ytresb">'8|ytresb(L="0")'</Field>
        <Field name="ytresd">'8|ytresd(L="0")'</Field>
        <Field name="ytresz">'8|ytresz(L="0")'</Field>
        <Field name="ytresgp">'8|ytresgp(L="0")'</Field>
.continue EL008 ? _(_(F|empty(8|ytftext)))
.copy U|xbbool = G|false
.select from '8|ytftext' xtext^
!LOOP004: ==============================
.continue ELOP004 ? _(G|mehr)
.continue EL009 ? _(U|xbbool)
'U|xtext'
.continue FI009
!EL009
.copy U|xbbool = G|true
<Field name="ytftext" abasType="TN">'U|xtext'
!FI009
.select from '8|ytftext' U|xtext^
.continue LOOP004
!ELOP004: ==============================
?        </Field>       ? U|xbbool
!EL008
      </Row>
.continue FI007
!EL007
      <Row number="'8|aktzeile'">
        <Field name="ytablage">0</Field>
      </Row>
!FI007
