!FI035
!EL033
.formula U|xtextid = "PV" + F|tostring(G|versionneu)
#!ACTION=COPY
#!DATABASE='U|xydbpvorgang'
#!GROUP='U|xygrpvorgang'
#!REPORT=REF
#!EDP_LANGCODE='G|bsprache'
#!DONTCHANGE=XXXXXX

id;yextid;yprojekt;yablage;ygehoertzu;yreftyp;yrefid;yiststart;yistend;yfortschritt;yadatum;yedatum;ypvsollstd;ypvplanstd;ydauer;yarbpaket;yvorpos;yvornum;ytppos;ykalkposid;ypersonal;yprojteam;ykstelle;yverantw;ybnocheck;yistblatt;\

zeilenop
'M|yobjekt^id';'U|xtextid';'U|xtprojekt';0;'U|xtispartof';;;;;0;'U|xdstart:8';'U|xdende:8';'U|xtsoll';'U|xtplan';'U|xtdauer';'U|xtarbpaket';;;;;'U|xtpersonal';'U|xtprojteam';'U|xtkstelle';'U|xtverantw';1;'M|yobjekt^yistblatt(L="0")';\

-*
.output NEW WERF.WEG
.formula U|xtsys = "edpimport.sh -c EKS -o UPDATEMODE=STRICT -T -p " + G|einmalpw
.formula U|xtsys = U|xtsys + " -H " + U|xtedpmsg + " -I " + U|xtedpdat + " >" + U|xtedpout + " 2>" + U|xtedperr
.formula U|xterrtext = "Fehler beim Kopieren des Projektvorgangs" +  M|yobjekt
.input "allpstart/FOP.ALL.EDP.CHECK"
.formula U|xtsel = "$,,yextid==" + U|xtextid + ";@filingmode=(Active)"
.load 9 group 'U|xydbgrpvorgang' 'U|xtsel'
.continue EL038 ? _(_(G|mehr))
.output TERMINAL
