.formula xprocsp = xprocsp - 1
.set trans +
.formula U|xtsel = "Achtung"
.box -button yes:no -title 'U|xtsel'
Sollen wirklich alle markierten Elemente kopiert werden?
.set trans -
.continue EL047 ? _(G|box = G|boxyes)
.input DATEI.F
.continue EL048 ? _(G|evtvar = "ybukopie")
.copy U|xbok = G|false
.select screen header
.select screen line
.copy U|xbmehr = G|mehr
!LOOP013: ==============================
.continue ELOP013 ? _(U|xbmehr)
.add M|yobjekt
.continue EL049 ? _(G|mehr)
.continue EL050 ? _((D|dnr    = U|xydbprojekt) & (D|gruppe = U|xygrprojekt))
.copy    U|xbvorproj = D|yprojekttyp^yprojvorlage
.formula U|xtorgproj = D|id
.continue EL051 ? _(F|empty(M|yneuobj))
.continue EL052 ? _(M|ybkopie)
.formula U|xtcpkunde = M|ycpkunde^id
.formula U|xtcpkunde = M|ytkunde^id              ?  F|empty(M|ycpkunde)
.formula U|xdcpstart = M|ycpstart
.formula U|xdcpstart = M|yadatum                 ?  F|empty(M|ycpstart)
.formula U|xiatanz = U|xdcpstart & M|yadatum
