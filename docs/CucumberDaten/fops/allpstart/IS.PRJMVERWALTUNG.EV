.continue FI038
!EL038
.assign  M|yneuobj = 9|id
.formula U|xtap.xtnummer = 9|yarbpaket^id   ? F|defined(U|xtap.xtnummer)
.formula U|xtclref = 9|id
.continue EL039 ? _((M|ytbftkopie) & (_(F|empty(M|yobjekt^yftext))) & (F|empty(M|yneuobj^yftext)))
.select lock add M|yneuobj
.continue EL040 ? _(G|mehr)
.select from 'M|yobjekt^yftext'
.formula H|yftext = M|yobjekt^yftext
.rewrite
.select -
