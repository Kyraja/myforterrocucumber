..!interpreter english declaration noabbrev
.set TRANS -
..========================================================================
..==
..==  Name              : FOP.PRJM.YPRJMBUKALENDER.BA
..==
..==  Pfad              : allpstart
..==
..==  Funktion          : Anlage bzw. Anzewige des Kalenders zu einem Objekt
..==
..==
..==  Erstellungsdatum  : 25.09.2013
..==
..==  Autor             : Thomas Saalborn, alltrotec GmbH
..==
..==  Copyright         : (c) 1990 - 2013 alltrotec GmbH
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Dieses FOP wird Åber EasyCase bearbeitet und mit easy2lg generiert!
..==  énderungen au·erhalb von EasyCase werden nach der nÑchsten énderung
..==  im EasyCase wieder Åberschrieben und dÅrfen daher NICHT mit "edi"
..==  realisiert werden!
..==
..==
..==
..========================================================================
..====================================================
.type text     xtsys xtsel xtcmd
.type integer xprocsp   ? _F|defined(U|xprocsp)
.set demand -
..====================================================
.continue EPROCDEF
!EPROCDEF: ----- end procedure definitions -----
.continue EL001 ? _(_(F|empty(M|id)))
.continue EL002 ? _(F|getwcal(M|id,"",G|datum)^stdkal)
.formula U|xtcmd = "<(Calendar)> <(New)>, (SchedulingCalendar) ? dispobezobj=" + M|id
.continue EL003 ? _((M|dnr    = 149) & (M|gruppe = 2))
.formula U|xtcmd = U|xtcmd + "|gltvon=" + F|getwcal(M|yprojekt,"",G|datum)^gltvon:8
.formula U|xtcmd = U|xtcmd + "|uebkal=" + F|getwcal(M|yprojekt,"",G|datum)^id
.continue FI003
!EL003
.formula U|xtcmd = U|xtcmd + "|uebkalbest="
!FI003
.command -PARALLEL 'F|expr(U|xtcmd)'
.continue FI002
!EL002
.command -PARALLEL 'F|getwcal(M|id,"",G|datum)^id'
!FI002
!EL001
