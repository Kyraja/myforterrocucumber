.fo xtcmd1 = xtcmd1 + "|param3=" * "+#X" + 'm|ymailan1'
.fo xttmp1 = "|param3=" * "+#X"
.fo xt1tmp = ""
..
.fo xtcmd1 = xtcmd1 + xttmp1 + xt1tmp
.fo xtcmd1 = xtcmd1 + "|[invisible]=1" * "+#X"
..
.fo xtcmd = "Infosystem BRIEFMANAGER?personvon=" + 'M|yreklvon^nummer'+ "|personbis=" + 'M|yreklvon^nummer' 
.fo xtcmd = xtcmd + "|bkunde=true|bsach=true"
.fo xtcmd = xtcmd + "|brief=" + xtnach
.fo xtcmd = xtcmd + "|betreff=Reklamation Nr." + 'M|nummer'
.fo xtcmd = xtcmd + "|bstart="
.fo xtcmd = xtcmd + "|budruck=" + xtcmd1 + "|[invisible]=1"
