..
.fo xtcmd1 = "drucker=" * "+#X" + "11018"
.fo xtcmd1 = xtcmd1 + "|layout=" * "+#X" + "12058"
.fo xtcmd1 = xtcmd1 + "|datname=" * "+#X" + "REKLAMATION" + M|nummer + ".pdf"
