.fo xtsys = xtsys + "|yreklamation=" + 'M|nummer'
.fo xtsys = xtsys + "|atext=" + 'xtnach'
..
.fo xtsys = xtsys + "|[insert]=1|1:art=" + 'M|yartikel^id' 
.fo xtsys = xtsys + "|1:mge=-" + 'M|yreklmge'                                   ? xtbeleg = "R"
.fo xtsys = xtsys + "|1:mge=" + 'M|yreklmge'                                    ? xtbeleg = "N"
.fo xtsys = xtsys + "|1:preis=" + 'M|ypreis'
.fo xtsys = xtsys + "|1:platz=WERK1"                                            ? xtbeleg = "R"
..
