!PROC002: ----- LADER -----
..
.fo xdlader  = xtnach
..
.fo xtpass   = "ebatch" ? 'E|MANDANT' = "EKS"  ; 'E|MANDANT' = "ERP"
.fo xtpass   = "dbatch" ? 'E|MANDANT' = "DEMO"
..
.fo xdstdout = xdlader + ".STDOUT.TMP"
.fo xdstderr = xdlader + ".STDERR.TMP"
..
.fo xtsys    = "EKSPASSWORT=" + xtpass + " export EKSPASSWORT ;"
.fo xtsys    = xtsys + " batchlg.sh LESELADER " + xdlader
.fo xtsys    = xtsys + " > " + xdstdout
.fo xtsys    = xtsys + " 2> " + xdstderr
..
.sys 'xtsys' hinter
..
.fo xtsys     = "test -s " + xdstderr
.sys 'xtsys' hinter
..
