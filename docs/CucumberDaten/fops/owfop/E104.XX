.WEITER EL064 ? _(M|yreklvon^spr =  "D")
.. IF064
.fo xtsys = xtsys + "|betreff=RÅcklieferschein zu Reklamation " + 'M|nummer'    ? xtbeleg = "R"
.fo xtsys = xtsys + "|betreff=Nachlieferung zu Reklamation " + 'M|nummer'       ? xtbeleg = "N"
..
.WEITER FI064
!EL064
.fo xtsys = xtsys + "|betreff=Delivery Note to Reclamation " + 'M|nummer'            ? xtbeleg = "R"
.fo xtsys = xtsys + "|betreff=Additional Delivery to Reclamation " + 'M|nummer'     ? xtbeleg = "N"
..
!FI064
..
