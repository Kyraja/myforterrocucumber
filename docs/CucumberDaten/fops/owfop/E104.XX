.WEITER EL047 ? _(evtkommd = "neu")
.. IF047
.fo M|yerfassdurch  = G|passw^mitarb^id
.fo M|yerfassam     = "."
..
!EL047
.. FI047
..
.fo M|yausls        = M|ybelid
..
.fo xtnach = "tmp/X" + pid + ".TMP"
..
.fo xtsys = "ls /usr1/pcdaten/Reklamation/" + 'M|nummer'+ "/* > " + xtnach
.sys 'xtsys' hinter
..
.fo xtsys = "test -s " + xtnach
.sys 'xtsys' hinter
..
..
.WEITER EL048 ? _(mehr)
.. IF048
.ein ABASFARBEN.DEF
..
.farbe -HINTERGRUND 'xabasgold' yreklordnerinh 0
..
!EL048
.. FI048
..
.WEITER ESAC001
!BRK001
.WEITER BRK002 ? _(evtart = "maskaus")
..
.WEITER EL049 ? _((M|yrekltyp = "Kunde") & (G|evtkommd = "neu"))
.. IF049
.. Mail senden
..
.WEITER EL050 ? _(('G|passw^namebspr' <> "") & ('G|passw^pemail' <> "") & ('M|ymailadr' <> ""))
.. IF050
.art text xthref xtfile xtsys 
..
.fo xtfile = "X." + 'T|versionn' + ".EKS"
..
.fo xtbody = "XBODY" + 'G|pid' + ".TMP"
.aus auf 'xtbody'
.ein DATEI.F
..
..
.WEITER EL051 ? _(M|ykuli^spr = "D")
.. IF051
Sehr geehrte Damen und Herren,

Wir haben Ihre Reklamation erhalten!
Unsere Reklamationsabteilung wird sich um eine rasche Bearbeitung bemÅhen!

Reklamationsnummer: 
    'M|nummer'

Artikel: 
    'M|yartikel^such' 

Bezeichnung:
    'M|yartikel^name'

Menge:        
    'M|ymge' StÅck

Fehlergruppe:
    'M|yfehlerentstanden'

Fehlerbeschreibung:
    'M|yfehlerbeschr                                    '


Mit freudlichen GrÅ·en
'G|passw^namebspr'

Meine Firma GbmH
..
.WEITER FI051
!EL051
Dear Madam and Sirs,

We have received your reclamation.
Our quality department is checking your issue asap!

Reclamationnumber:
    'M|nummer'

Product:  
    'M|yartikel^such' 

Descprition:
    'M|yartikel^name'

Qty:        
    'M|ymge' Pce

Errorcode:
    'M|yfehlerentstanden'

Errordescription:
    'M|yfehlerbeschr                                    '


Best regards
'G|passw^namebspr'

Meine Firma GmbH
..
!FI051
..
.aus auf "WERF.WEG"
..
.formel xtsys ="s3_conv 3 " + 'xtbody'
.sys 'xtsys' hinter
..
.formel xclientbody= 'T|cltempdir' + "/" + 'T|xtbody'
.pc.copy -PC 'T|xtbody' 'T|xclientbody'
.hinweis -SOFORT 'xclientbody'
..
.. MAIL aufbereiten 
.formel xamlname  = "XLOGOD" + 't|pid' + ".AML"
.formel xclientaml= 'T|cltempdir' + "/" + 'T|xamlname'
..
.aus auf 'xamlname'
.ein DATEI.F
[ABASMAIL]

NEWLINE=;
SEND=0
DEBUG=0
HTMLBODY=0

REPLYTO1='G|passw^pemail'

FROMADRESS='G|passw^pemail'

TO1='M|ymailadr'

?SUBJECT=Reklamation erfasst    ? M|ykuli^spr =  "D"
?SUBJECT=Reclamation received   ? M|ykuli^spr <> "D"

BODYFILE='T|cltempdir'\'xtbody'
..
..
.WEITER EL052 ? _('M|ymailan1' <> "")
.. IF052
ATTACHMENT1='M|ymailan1'
..
!EL052
.. FI052
..
..
.WEITER EL053 ? _('M|ymailan2' <> "")
.. IF053
ATTACHMENT2='M|ymailan2'
..
!EL053
.. FI053
..
.aus BILD
..
.formel xtsys ="s3_conv 3 " + 'T|xamlname'
.sys 'xtsys' hinter
..
... 'T|cltempdir' ist Client-PC standard Temp Ordner
.pc.copy -PC -BIN 'T|xamlname' 'T|xclientaml'
.pc.exec Mail2Outlook.exe 'T|xclientaml'
..
.formel xcmd="rm -f " + 'T|xamlname'
.sys 'xcmd' hinter
..
.fo xtsys = "sleep 1"
.sys 'xtsys' hinter
..
..
