..!interpreter german declaration
.. **********************************************************************************
.. Programm: ARTSTL.TAB
.. Funktion: Tabellenzeilen fÅllen
.. **********************************************************************************
!SPHLZ:
.hole zeile
.weiter SPEND   ? _mehr
.mache maske zeile +O
.formel M|tvpos     = H|vpos
.formel M|telem     = H|elem^id
.formel M|telemname = H|elem^name   
.formel M|telemte   = H|lge      ? H|elart <> 3
.formel M|telemtr   = H|breite   ? H|elart <> 3                      
..formel M|telemle   = H|elem^bme ? H|elart <> 3
.formel M|telemte   = H|te       ? H|elart =  3
.formel M|telemtr   = H|tr       ? H|elart =  3
.formel M|telemle   = H|elem^zr  ? H|elart =  3
.formel M|telemanz  = H|anzahl
.formel M|telemanzle= H|elem^le  ? H|elart <> 3
.weiter SPHLZ
..
!SPEND:
.weiter
