..!interpreter german declaration
.. ************************************************************************************
.. Programm: ARTSTL.EV
.. Funktion: Event-Handler
.. ************************************************************************************
...ein
.weiter SPME      ? T|evtart="maskein"
.weiter SPKART    ? G|evtvar = "kart"
.weiter SPBSTART  ? T|evtvar/"*bstart"
.weiter
..
!SPME:
.. .formel M|kartle = "StÅck" 
.zuweisen M|kartle = "(PCE)"     
.formel M|kartvland= T|inland        
.weiter
..
!SPKART: Artikel eingegeben oder gelîscht
.. .formel M|kartname  = M|kartikel^sucherw
.formel M|kartname  = M|kart^namebspr
.formel M|kartmind  = M|kart^mindest
.formel M|kartlosgr = M|kart^losgr
.formel M|kartbest  = M|kart^bestand
.formel M|kartle    = M|kart^le       ? M|kart <> ""
.. .formel M|kartle  = "StÅck"        ? M|kart =  ""
.zuweisen M|kartle  = "(PCE)"         ? M|kart =  ""
.formel M|kartvpr   = M|kart^vpr
.formel M|kartvland = M|kart^vland    ? M|kart <> ""
.formel M|kartvland = T|inland        ? M|kart =  "" 
.zuweisen M|kartbsart = M|kart^bsart
.formel M|kartdispoa= M|kart^dispoa  
.weiter
..
!SPBSTART:
.eingabe TABLEEREN
.formel M|select = M|kart^id
.weiter FKART   ? M|select = ""
.weiter
..
!FKART: Fehler in Artikeleingabe
.art text xtfehler     ? _defined(T|xtfehler)
.formel T|xtfehler = "Bitte geben Sie eine gÅltige Artikelnummer ein."
.fehler 'xtfehler'
.ende 1 
