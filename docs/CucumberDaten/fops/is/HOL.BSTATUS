..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : HOL.BSTATUS
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Auftragsstueckliste fuer die
..                  Auftragsposition, Beschaffung oder Reservierung in
..                  M|select einstufig holen.
..
..                  Kopfparameter: vorw  STL vorwaerts durchlaufen?
..                                 alle  alle Reservierungen verfolgen?
..                                 stop  STL nicht weiter aufloesen?
..
...Includes        :
.. include la/BVSTATUS.FA
..*****************************************************************************
.set trans -
..
.type bool xverkauf       ? _F|defined(U|xverkauf)
..
.input "is/TABLEEREN"
..
.continue ERROR1 ? F|empty(M|kart)
.continue ERROR1 ? F|empty(M|select)
..
.input "la/BVSTATUS.FA"
..
.. Auftragsposition?
.formula U|xverkauf = M|select / "*,3,*"
.select -
.select sales 'M|select' ?  U|xverkauf
.select purchasing 'M|select' ? _U|xverkauf
.continue ERROR2 ? _G|mehr
..
.formula M|stufe = 0
.input 'M|bkopf'       ? _F|empty(M|bkopf)
.continue HOL0             ?  H|typ = G|RESERV
.formula M|stufe = 1      ? _U|xverkauf
.select add eres          ?  M|vorw
.select add lres          ? _M|vorw
.continue ERROR3           ? _G|mehr
..
!HOL0
.input 'M|tab'         ? _F|empty(M|tab)
.continue HOL1             ? _F|defined(M|stop)
.continue REPFOOT          ?  M|stop
..
!HOL1
.select line              ?  M|vorw
.select add ppos          ? _M|vorw
.continue HOL0             ?  G|mehr
..
!REPFOOT
.input 'M|bfuss'       ? _F|empty(M|bfuss)
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Document missed!
.cursor kart 0
.error Bitte zuerst einen Vorgang auswÑhlen.
.end 1
..
!ERROR2: Loading document failed!
.error Der ausgewÑhlte Vorgang wurde inzwischen gelîscht. Bitte Auswahl wiederholen
.end 1
..
!ERROR3: Document has no partslist
.error Der ausgewÑhlte Vorgang hat keine StÅckliste.  ? M|ansbstatus
.error Die Position hat keine eigene Fertigungsliste. ? M|ansasl
.continue END
