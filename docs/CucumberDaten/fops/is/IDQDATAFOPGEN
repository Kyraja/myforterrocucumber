..!interpreter english translate noabbrev
.. ****************************************************************************
.. FOP-Name       : is/IDQDATAFOPGEN
.. Autor          : mg
.. Verantwortlich : TeamReport
.. Kontrolle      : mg
.. Funktion       : Dieses FOP ist der Ausgangspunkt fÅr das Erzeugen des
..                  XML-Datengenerator-FOPs eines Infosystems
.. ****************************************************************************
.set trans -
.type text xidqgenfop   ? _F|defined(U|xidqgenfop)
.type text xovrfile     ? _F|defined(U|xovrfile)
.type text xidqfile     ? _F|defined(U|xidqfile)
.type text xmainfile    ? _F|defined(U|xmainfile)
.type text xbefehl      ? _F|defined(U|xbefehl)
.type text xmysprdir    ? _F|defined(U|xmysprdir)
..
.formula U|xmainfile   = -('M|arb') + -('M|such')
.formula U|xovrfile    = 'U|xmainfile'+".OVR"
.formula U|xidqfile    = 'U|xmainfile'+".IDQ"
.assign U|xidqgenfop  = M|datagenfop ? F|defined(M|datagenfop)
.formula U|xidqgenfop  = "gen/isdatagen/fop.idq/" + 'M|arb' + "/" + 'M|such' ? F|empty(U|xidqgenfop)
..
.. -----------------------------------------------------------------------
.. Pruefen ob das FOP existiert und schreibbar ist
.. -----------------------------------------------------------------------
.formula U|xbefehl = "test -f " + 'U|xidqgenfop' + " && ! test -w " + 'U|xidqgenfop'
.system 'U|xbefehl' background
.continue ENDE ? G|mehr
..
.. -----------------------------------------------------------------------
.. IDQ Generatorfop ausfÅhren
.. -----------------------------------------------------------------------
.input "is/INFOSYS.IDQGEN"
.output new WERF.WEG
..
.. -----------------------------------------------------------------------
.. Generatorfop fÅr Textfop ausfÅhren
.. -----------------------------------------------------------------------
.input "is/INFOSYS.TEXTGEN"
.output new WERF.WEG
..
!ENDE
.continue
