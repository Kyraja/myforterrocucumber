..!interpreter english translate noabbrev
.. ****************************************************************************
.. FOP-Name       : INFOSYS.OVRGEN
.. Autor          : mg
.. Verantwortlich : mg
.. Kontrolle      : fwester
.. Funktion       : Dieses FOP generiert aus einem Infosystemobjekt
..                  OnlineView-Layoutdateien.
.. History:
..   Version 1: OnlineView-Layout erzeugen
..   Version 2: XML-UnterstÅtzung hinzugefÅgt (es kann eine OVR-Datei
..              generiert werden die spezielle Bandinformationen fÅr
..              "TabellenbÑnder" hat.
..
.. ****************************************************************************
..
.. Aufruf-Parameter fÅr diese Datei:
.. =================================
..
.. xovrgenfop: öbergabeparameter in dem Name und Verzeichnis des zu
..             generierenden FOPs angegeben ist.
.. xmainfile:  öbergabeparameter in dem der Name der spÑteren OVR-Datei
..             angegeben ist.
.. xkanalsuch: Suchwort des Kanals (ONLINEVIEW oder XMLPRINT) fuer den
..             das Layout erstellt werden soll.
.. ****************************************************************************
.set trans -
..
.input "DATEI.F"
..
..
.type text xisnum       ? _F|defined(U|xisnum)
.type text xtempname    ? _F|defined(U|xtempname)
.type text xfontname    ? _F|defined(U|xfontname)
.type text xpunkt       ? _F|defined(U|xpunkt)
.type text xtemp1       ? _F|defined(U|xtemp1)
.type text xtemp2       ? _F|defined(U|xtemp2)
.type text xinline      ? _F|defined(U|xinline)
.type text xtemp3       ? _F|defined(U|xtemp3)
.type text xausansicht  ? _F|defined(U|xausansicht)
.type text xauspdf      ? _F|defined(U|xauspdf)
.type text xfehlermeld  ? _F|defined(U|xfehlermeld)
.type text xlayouterr   ? _F|defined(U|xlayouterr)
.type text xtext        ? _F|defined(U|xtext)
.type integer  xrandlinks   ? _F|defined(U|xrandlinks)
.type integer  xrandoben    ? _F|defined(U|xrandoben)
.type integer  xrandrechts  ? _F|defined(U|xrandrechts)
.type integer  xrandunten   ? _F|defined(U|xrandunten)
.type integer  xrhochlinks  ? _F|defined(U|xrhochlinks)
.type integer  xrhochoben   ? _F|defined(U|xrhochoben)
.type integer  xrhochrechts ? _F|defined(U|xrhochrechts)
.type integer  xrhochunten  ? _F|defined(U|xrhochunten)
.type integer  xrquerlinks  ? _F|defined(U|xrquerlinks)
.type integer  xrqueroben   ? _F|defined(U|xrqueroben)
.type integer  xrquerrechts ? _F|defined(U|xrquerrechts)
.type integer  xrquerunten  ? _F|defined(U|xrquerunten)
.type integer  xbpage       ? _F|defined(U|xbpage)
.type integer  xhpage       ? _F|defined(U|xhpage)
.type integer  xbband       ? _F|defined(U|xbband)
.type integer  xhband       ? _F|defined(U|xhband)
.type integer  xxbandpos    ? _F|defined(U|xxbandpos)
.type integer  xybandpos    ? _F|defined(U|xybandpos)
.type integer  xbitem       ? _F|defined(U|xbitem)
.type integer  xhitem       ? _F|defined(U|xhitem)
.type integer  xxitempos    ? _F|defined(U|xxitempos)
.type integer  xyitempos    ? _F|defined(U|xyitempos)
.type integer  xitemspace   ? _F|defined(U|xitemspace)
.type real xxfontfaktor ? _F|defined(U|xxfontfaktor)
.type real xyfontfaktor ? _F|defined(U|xyfontfaktor)
.type integer  xfontsize    ? _F|defined(U|xfontsize)
.type integer  xxiteminit   ? _F|defined(U|xxiteminit)
.type integer  xyiteminit   ? _F|defined(U|xyiteminit)
.type integer  xstandard    ? _F|defined(U|xstandard)
.type integer  xzeichen     ? _F|defined(U|xzeichen)
.type integer  xtmp         ? _F|defined(U|xtmp)
.type integer  xyhoehe      ? _F|defined(U|xyhoehe)
.type integer  xrichtung    ? _F|defined(U|xrichtung)
.type integer  xquerformat  ? _F|defined(U|xquerformat)
.type integer  xbreite      ? _F|defined(U|xbreite)
.type bool xhochformat  ? _F|defined(U|xhochformat)
.type text xovprinter   ? _F|defined(U|xovprinter)
..
.formula U|xisnum = M|nummer ? U|xisnum = ""
.select infosystem 'U|xisnum'
.end 1 ? _G|mehr
..
.set trans +
.formula U|xfehlermeld = "Achtung! TabellenÅberschrift enthÑlt zu viele Zeichen! Tabelle passt nicht auf A4."
.formula U|xlayouterr  = "Achtung! Der Layout-Datensatz konnte nicht gelesen werden. Layout vom Kanal " + 'U|xkanalsuch' + " kann nicht generiert werden!"
.set trans -
..
.formula U|xauspdf     = "PDFOutput"
.formula U|xausansicht = "Preview"
..
..
.formula U|xpunkt ="."
..
..
.. Schaltet die Inline-Attributierung fÅr OnlineView ab Version 3.3 ein.
.. .fo xinline=",1,-1"
.formula U|xinline=""
..
..
.output new 'U|xovrgenfop'
..
..
'U|xpunkt''U|xpunkt'!interpreter english translate noabbrev
'U|xpunkt'input "XML"
'U|xpunkt'input "DATEI.F"
..
..
.. Name der Ausgabedatei bestimmen
.formula U|xtempname = "'" + "U|xoutfile" + "'"
'U|xpunkt''U|xpunkt'
'U|xpunkt'type text xoutfile ? _F|defined(U|xoutfile)
'U|xpunkt'type text xsyscom  ? _F|defined(U|xsyscom)
'U|xpunkt'formula U|xoutfile = "rmtmp/" + 'G|dblquote''U|xmainfile''G|dblquote' + ".OVR"
'U|xpunkt''U|xpunkt'
'U|xpunkt'output new 'U|xtempname'
..
..
..
.. ===========================================================================
.. FOP-Generator
.. ===========================================================================
!GENERATOR
..
..
.formula U|xrhochlinks  =50
.formula U|xrhochoben   =50
.formula U|xrhochrechts =50
.formula U|xrhochunten  =50
.formula U|xrquerlinks  =50
.formula U|xrqueroben   =50
.formula U|xrquerrechts =50
.formula U|xrquerunten  =50
..
.formula U|xrandlinks =U|xrhochlinks
.formula U|xrandoben  =U|xrhochoben
.formula U|xrandrechts=U|xrhochrechts
.formula U|xrandunten =U|xrhochunten
..
.formula U|xhochformat=G|true
..
..
.type text xholparam      ? _F|defined(U|xholparam)
.type text xeinheit       ? _F|defined(U|xeinheit)
.type text xbeinheit      ? _F|defined(U|xbeinheit)
.type text xausrichtung   ? _F|defined(U|xausrichtung)
.type bool xblayout       ? _F|defined(U|xblayout)
.type real xfaktor        ? _F|defined(U|xfaktor)
..
..
.. OnlineView ist hier der Referenzkanal aus dem dann
.. das XML-Layout generiert wird!
.formula U|xholparam = "$,,@gruppe=3;kontext=" + 'H|id' + ";kanal==" + 'U|xkanalsuch'
.load 9 printparameter 'U|xholparam'
.continue LAYOUTERROR ? _G|mehr
..
..
.formula U|xfaktor=10
.formula U|xeinheit=9|pformat^leinh
.formula U|xhochformat=G|true
.formula U|xhochformat=G|false ? (9|ausrichtn=81)
..
..
!DOGEN
.formula U|xbpage=9|pformat^breite * U|xfaktor
.formula U|xbpage=9|pformat^hoehe  * U|xfaktor  ? _U|xhochformat
.formula U|xhpage=9|pformat^hoehe  * U|xfaktor
.formula U|xhpage=9|pformat^breite * U|xfaktor  ? _U|xhochformat
.formula U|xfontname=9|fontname
.formula U|xfontsize=9|fontgr
.formula U|xfontname="Times" ? U|xfontname=""
.formula U|xfontsize=10      ? U|xfontsize=0
..
..
.formula U|xquerformat=0
.formula U|xquerformat=1  ? _U|xhochformat
.formula U|xstandard=0
.formula U|xxiteminit=U|xrandlinks
.formula U|xyiteminit=0
.formula U|xitemspace=10
.formula U|xrichtung=0
..
..
.. Jetzt die Korrekturwerte (xxfontfaktor,xyfontfaktor) fÅr den Font bestimmen
.formula U|xxfontfaktor = U|xfontsize*2
.formula U|xyfontfaktor = U|xfontsize*2
..ein FONTSEARCH
..
..
!SIZECALC
.. Variablen vorbelegen
.formula U|xbband=U|xbpage
.formula U|xxbandpos=0
.formula U|xybandpos=0
.formula U|xxitempos=U|xxiteminit
.formula U|xyitempos=U|xyiteminit
..
.formula U|xhband=50
.formula U|xbreite=0
.formula U|xzeichen=0
.formula U|xyhoehe=U|xyfontfaktor*2+10
..
..
.. ---------------------------------------------------------------------------
.. Die Bezeichnungen fÅr Datum, Bezeichner und Uhrzeit auslesen
.. ZusÑtzlich die FeldlÑange ermitteln.
.. ---------------------------------------------------------------------------
.type text xtdatum xtbezeichner xtuhrzeit ? _F|defined(U|xtdatum)
.type integer  xidatum xibezeichner xiuhrzeit ? _F|defined(U|xidatum)
..
.formula U|xtdatum      = 'G|datum'
.formula U|xidatum      = +'G|datum'
.formula U|xtbezeichner = 'G|panummer'
.formula U|xibezeichner = +'G|panummer'
.formula U|xtuhrzeit    = 'G|zeit'
.formula U|xiuhrzeit    = +'G|zeit'
..
..
.. ---------------------------------------------------------------------------
.. Mit der OVR-Datenausgabe beginnen
.. ---------------------------------------------------------------------------
!OVROUTPUT
?:# CS-OnlineView Report 2.0
?:doc,"Bericht1",3,'U|xbpage','U|xhpage',"","3","","","",0,0
?:begin
..
..
..
..
.. ---------------------------------------------------------------------------
.. Alle Items fÅr das 1. Band ausgeben (Seitenkopfinformationen)
.. ---------------------------------------------------------------------------
..
.type integer xspos ? _F|defined(U|xspos)
.select header
.formula U|xhband=200 + U|xrandoben
..
..
?:	band,"pageheader",4,'U|xxbandpos','U|xybandpos','U|xbband','U|xhband',"IDQ,'U|xmainfile'.IDQ,Pageheader",0,"",0,0,"","",0,0,0,""
?:	begin
..
.. Berechnung der Position vom linken Seitenrand aus
.formula U|xbreite   = U|xibezeichner*U|xxfontfaktor
.formula U|xxitempos = U|xxiteminit
..
.. --- Bearbeiter Kennzeichen ---
?:		item,"fldBezeichner",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"bzeich","'U|xfontname'",'U|xfontsize',1,90,0,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
..
.formula U|xzeichen  = +H|name
.formula U|xbreite   = U|xzeichen*33
.formula U|xxitempos = (U|xbband-U|xbreite)/2
..
.. --- Seitenueberschrift mit fester groesse! ---
.. Da die Ueberschrift fest die Groesse 16 hat wird auch das Feld auf hoehe 100 gesetzet
?:		item,"fldName",'U|xxitempos','U|xyitempos','U|xbreite',100,"name","'U|xfontname'",16,5,90,2,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
..
.. Berechnung der Position vom rechten Seitenrand aus
.formula U|xbreite   = 2*U|xxfontfaktor
.formula U|xxitempos = U|xbpage-U|xbreite-U|xitemspace-U|xrandrechts-50
.formula U|xspos     = U|xxitempos
..
.. --- Feld fÅr die Gesamtseitenanzahl ---
?:		item,"fldGesSeiten",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"","'U|xfontname'",'U|xfontsize',1,90,1,0,1,0,"",9,0,0,0,0,""'U|xinline'
..
..
.formula U|xbreite   = U|xxfontfaktor
.formula U|xxitempos = U|xspos-U|xbreite
.formula U|xspos     = U|xxitempos
..
.. --- Feld fÅr das Trennzeichen ---
?:		text,"txtTrenner",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"/","'U|xfontname'",'U|xfontsize',1,90,1,0,1,0,0,0,0'U|xinline'
..
..
.formula U|xbreite   = 2*U|xxfontfaktor
.formula U|xxitempos = U|xspos-U|xbreite
.formula U|xspos     = U|xxitempos
..
.. --- Feld fÅr die aktuelle Seitenzahl ---
?:		item,"fldSeite",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"page ()","'U|xfontname'",'U|xfontsize',1,90,1,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
..
.formula U|xbreite   = 5*U|xxfontfaktor
.formula U|xxitempos = U|xspos-U|xbreite
.formula U|xspos     = U|xxitempos
..
.. --- Text "Seite" ---
?:		item,"fldPagetext",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"txtpage","'U|xfontname'",'U|xfontsize',1,90,1,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
.formula U|xbreite   = U|xidatum*U|xxfontfaktor+10
.formula U|xxitempos = U|xspos-U|xbreite-50
..
.. --- Aktuelles Datum ausgeben ---
?:		item,"fldDatum",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"datum","'U|xfontname'",'U|xfontsize',1,90,1,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
..
.. Berechnung der Position vom linken Seitenrand aus
.formula U|xbreite   = ((+H|arb)+(+H|such)+3)*U|xxfontfaktor
.formula U|xyitempos = U|xyitempos+U|xyhoehe
.formula U|xxitempos = U|xxiteminit
..
.. --- Arbeitsbereich ausgeben ---
?:		item,"fldBereich",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"bereich","'U|xfontname'",'U|xfontsize',1,90,0,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
..
.. Berechnung der Position vom rechten Seitenrand aus
.formula U|xbreite   = U|xiuhrzeit*U|xxfontfaktor
.formula U|xxitempos = U|xspos-U|xbreite-50
..
.. --- Aktuelle Uhrzeit ausgeben ---
?:		item,"fldUhrzeit",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"uhrzeit","'U|xfontname'",'U|xfontsize',1,90,1,0,1,0,"",0,0,0,0,0,""'U|xinline'
..
..
?:	end
..
..
..
..
.. ---------------------------------------------------------------------------
.. Die vertikale Grî·e fÅr das Kopfband bestimmen (-> xhband)
.. ---------------------------------------------------------------------------
.formula U|xybandpos=U|xhband
..
.select header
!BHAUSGABE
.select line
.continue BHTEILENDE ? _G|mehr
.formula U|xtempname  = H|vname<<-2
.formula U|xhband = U|xhband+U|xyhoehe ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.continue BHAUSGABE
!BHTEILENDE
..
..
..
..
.. ---------------------------------------------------------------------------
.. PrÅfenob es Daten im Kopfteil gibt
.. ---------------------------------------------------------------------------
.select header
!HTEST
.select line
.continue HTESTENDE ? _G|mehr
.continue DOKOPF ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.continue HTEST
..
!HTESTENDE
.continue DOTABLE
..
..
!DOKOPF
..
.. ---------------------------------------------------------------------------
.. Alle Items fÅr das 2. Band ausgeben (Kopfteil der Maske)
.. ---------------------------------------------------------------------------
..
.formula U|xxitempos=U|xxiteminit
.formula U|xyitempos=U|xyiteminit
.. +100 damit ein wenig Abstand zwischen Daten und Tabelle ist
.formula U|xhband=U|xhband+100
..
..
?:	band,"maskhead",2,'U|xxbandpos','U|xybandpos','U|xbband','U|xhband',"IDQ,'U|xmainfile'.IDQ,Maskhead",0,"",0,0,"","",0,0,0,""
?:	begin
..
..
.select header
!KAUSGABE
.select line
.continue KTEILENDE ? _G|mehr
.formula U|xtempname = H|vname<<-2
.formula U|xtext     = H|extbezs
.formula U|xtext     = H|vbeds  ? U|xtext=""
.formula U|xzeichen  = +U|xtext
.formula U|xzeichen  = H|maxlength ? (H|maxlength <> 0)
.formula U|xbreite   = (U|xzeichen+1)*U|xxfontfaktor
?:		item,"fldtxt'U|xtempname'",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"txt'U|xtempname'","'U|xfontname'",'U|xfontsize',0,90,0,0,1,0,"",0,0,0,0,0,""'U|xinline'? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.formula U|xxitempos = U|xxitempos+U|xbreite+U|xitemspace ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.formula U|xzeichen  = vitle
.formula U|xzeichen  = maxlength ? (maxlength <> 0)
.formula U|xbreite   = U|xzeichen*U|xxfontfaktor
.formula U|xrichtung = 0
.formula U|xrichtung = 1 ? H|artausrc = "R"
?:		item,"fld'U|xtempname'",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"'U|xtempname'","'U|xfontname'",'U|xfontsize',0,90,'U|xrichtung',0,1,0,"",0,0,0,0,0,""'U|xinline'? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.formula U|xxitempos = U|xxiteminit ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.formula U|xyitempos = U|xyitempos+U|xyhoehe ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|inprint)
.continue KAUSGABE
!KTEILENDE
?:	end
..
..
..
!DOTABLE
..
.. ---------------------------------------------------------------------------
.. PrÅfenob es Daten im Tabellenteil gibt
.. ---------------------------------------------------------------------------
.select header
!TABTEST
.select line
.continue TABENDETEST ? _G|mehr
.continue DOTABKOPF ? (H|vkt & _(H|vitbezf/"BU*") & H|inprint)
.continue TABTEST
..
!TABENDETEST
.continue DOFUSS
..
..
!DOTABKOPF
..
.. ---------------------------------------------------------------------------
.. Alle Items fÅr das 3. Band ausgeben (Kopfteil der Tabelle)
.. ---------------------------------------------------------------------------
..
.formula U|xxitempos=U|xxiteminit
.formula U|xyitempos=U|xyiteminit
.formula U|xybandpos=U|xhband
..  +10 fÅr die folgende Linie die in diesem Band ausgegeben wird
.formula U|xhband=U|xybandpos+U|xyhoehe+15
..
..
?:	band,"tableheader",1,'U|xxbandpos','U|xybandpos','U|xbband','U|xhband',"IDQ,'U|xmainfile'.IDQ,Tablehead",0,"",0,0,"","",0,0,0,""
?:	begin
..
..
.select header
!TKAUSGABE
.select line
.continue TKTEILENDE ? _G|mehr
.formula U|xtempname = H|vname<<-2
.formula U|xtext     = H|extbezs
.formula U|xtext     = H|vbeds  ? U|xtext=""
.formula U|xzeichen  = H|vitle
.formula U|xzeichen  = +U|xtext ? +U|xtext > U|xzeichen
.formula U|xzeichen  = H|maxlength ? (H|maxlength <> 0)
.formula U|xbreite   = U|xzeichen*U|xxfontfaktor
.formula U|xrichtung = 0
.formula U|xrichtung = 1 ? H|artausrc = "R"
?:		item,"fld'U|xtempname'",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"txt'U|xtempname'","'U|xfontname'",'U|xfontsize',1,90,'U|xrichtung',0,1,0,"",0,0,0,0,0,""'U|xinline'? (H|vkt & _(H|vitbezf/"BU*") & H|inprint)
.formula U|xxitempos  = U|xxitempos+U|xbreite+U|xitemspace ? (H|vkt & _(H|vitbezf/"BU*") & H|inprint)
.continue TKAUSGABE
!TKTEILENDE
..fo xyhoehe=xyhoehe+3
.formula U|xbband=U|xbband-10
?:		line,"lin1",'U|xxiteminit','U|xyhoehe','U|xxitempos','U|xyhoehe',0,1,0,0,0
:	end
..fo xyhoehe=xyhoehe+5
.formula U|xbband=U|xbband+10
..
..
..
..
.. ---------------------------------------------------------------------------
.. Alle Items fÅr das 4. Band ausgeben (Tabellenteil)
.. ---------------------------------------------------------------------------
..
.formula U|xxitempos=U|xxiteminit
.formula U|xyitempos=U|xyiteminit
.formula U|xybandpos=U|xhband
.formula U|xhband=U|xybandpos+U|xyhoehe+1
..
..
?:	band,"tablebody",2,'U|xxbandpos','U|xybandpos','U|xbband','U|xhband',"IDQ,'U|xmainfile'.IDQ,Tablebody",0,"",0,0,"","",0,0,0,""
?:	begin
..
..
.select header
!TTAUSGABE
.select line
.continue TTTEILENDE ? _G|mehr
.formula U|xtempname = H|vname<<-2
.formula U|xtext     = H|extbezs
.formula U|xtext     = H|vbeds  ? U|xtext=""
.formula U|xzeichen  = H|vitle
.formula U|xzeichen  = +U|xtext ? +U|xtext > U|xzeichen
.formula U|xzeichen  = H|maxlength ? (H|maxlength <> 0)
.formula U|xbreite   = U|xzeichen*U|xxfontfaktor
.formula U|xrichtung = 0
.formula U|xrichtung = 1 ? H|artausrc = "R"
?:		item,"fld'U|xtempname'",'U|xxitempos','U|xyitempos','U|xbreite','U|xyhoehe',"'U|xtempname'","'U|xfontname'",'U|xfontsize',0,90,'U|xrichtung',0,1,0,"",0,0,0,0,0,""'U|xinline'? (H|vkt & _(H|vitbezf/"BU*") & H|inprint)
.formula U|xxitempos = U|xxitempos+U|xbreite+U|xitemspace ? (H|vkt & _(H|vitbezf/"BU*") & H|inprint)
.continue TTAUSGABE
!TTTEILENDE
?:	end
..
..
..
..
!DOFUSS
..
.. ---------------------------------------------------------------------------
.. Den Fu·teil der OVR-Datei ausgeben (5. Band)
.. ---------------------------------------------------------------------------
..
.formula U|xxitempos=U|xxiteminit
.formula U|xyitempos=U|xyiteminit
.formula U|xybandpos=U|xhband
.formula U|xhband=U|xybandpos+U|xyhoehe+1
..
..
?:	band,"footer",5,'U|xxbandpos','U|xybandpos','U|xbband','U|xhband',"",0,"",0,0,"","",0,0,0
?:	begin
..?:		line,"lin9",'xxbandpos',30,'xbband',30,8421376,1,1,0
..?:		text,"txt8",79,48,246,25,"ABAS Software","Arial",6,0,90,0,0,1,0,0,0,0
?:	end
..
..
..
..
.. ---------------------------------------------------------------------------
.. OnlineView-Drucker ausgeben.
.. ---------------------------------------------------------------------------
.reserve
.select infrastructure "$,,gruppe=1"
.continue DOPR
!DONEXTPR
.select infrastructure
!DOPR
.continue DOSTDPR ? _G|mehr
.continue DONEXTPR ? H|namesmb=""
.continue DONEXTPR ? H|namesys=""
.continue DOOVPR ? 'H|namesmb'='H|namesys'
.continue DONEXTPR
!DOOVPR
.. .box
.. 'H|namesys'
.formula U|xovprinter="PRN,"+'H|namesmb'
?:	printer,"'H|namesys'","'U|xovprinter',,,,0","LST3,,""0,0,'U|xbpage','U|xhpage'"",""'U|xrandlinks','U|xrandoben','U|xrandrechts','U|xrandunten'"",""'U|xrandlinks','U|xrandoben','U|xrandrechts','U|xrandunten'"",""0,0,'U|xbpage','U|xhpage'"",1,0,0,'U|xquerformat',1,8,66,""'U|xfontname'"",'U|xfontsize',0"
.continue DONEXTPR
..
..
!DOSTDPR
..
.. ---------------------------------------------------------------------------
.. Die vorkonfigurierten AusgabegerÑte ausgeben.
.. ---------------------------------------------------------------------------
..
?:	printer,'U|xausansicht',"WIN,preview","LST3,,""0,0,'U|xbpage','U|xhpage'"",""'U|xrandlinks','U|xrandoben','U|xrandrechts','U|xrandunten'"",""'U|xrandlinks','U|xrandoben','U|xrandrechts','U|xrandunten'"",""0,0,'U|xbpage','U|xhpage'"",1,0,0,'U|xquerformat',1,8,66,""'U|xfontname'"",'U|xfontsize',0"
?:	printer,'U|xauspdf',"PDF,'U|xmainfile'.pdf,0,,1","LST3,,""0,0,'U|xbpage','U|xhpage'"",""'U|xrandlinks','U|xrandoben','U|xrandrechts','U|xrandunten'"",""'U|xrandlinks','U|xrandoben','U|xrandrechts','U|xrandunten'"",""0,0,'U|xbpage','U|xhpage'"",1,0,0,'U|xquerformat',1,8,66,""'U|xfontname'"",'U|xfontsize',0"
?:end
..
..
..
..
.. ---------------------------------------------------------------------------
.. Zeichensatz von s3 nach ISO 8859-1 konvertieren.
.. Hier auf keinen Fall UTF8 erstellen, weil OnlineView damit nicht umgehen
.. kann und der XML-Umsetzer davon ausgeht das die OV-Layouts im ISO-Format
.. vorliegen!!
.. ---------------------------------------------------------------------------
..
.formula U|xtemp1 = "'" + "U|xoutfile" + "'"
'U|xpunkt'formula U|xsyscom = "s3_conv 11 " + 'U|xtemp1'
.formula U|xtemp2 = ".system '" + "U|xsyscom" + "'" + " background"
'U|xpunkt'formula U|xsyscom = "crlf+ " + 'U|xtemp1'
.formula U|xtemp3 = ".system '" + "U|xsyscom" + "'" + " background"
'U|xpunkt'output new "WERF.WEG"
'U|xtemp2'
'U|xtemp3'
..
..
.continue ENDE
..
..
.. ---------------------------------------------------------------------------
.. Fehlermeldungen
.. ---------------------------------------------------------------------------
!LAYOUTERROR
.error -message 'U|xlayouterr'
.end 1
..
..
.. ---------------------------------------------------------------------------
.. Ende
.. ---------------------------------------------------------------------------
!ENDE
.continue
