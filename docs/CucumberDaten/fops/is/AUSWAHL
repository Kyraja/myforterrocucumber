..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUSWAHL
.. Autor          : es
.. Verantwortlich : cl
.. Kontrolle      : fwester
.. Funktion       : Ermittelt aus dem Texteintrag im Feld "M|auswahl" einen
.. Selektionsstring und hinterlegt diesen in "M|select". Dieses kann spÑter
.. von der Datenbeschaffung ausgewertet werden; zum Beipiel: is/HOL.LISTE.
.. Ablauf         : FeldfÅll-EFOP fÅr das Feld "auswahl" in Infosystemen.
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xsel     ? _F|defined(U|xsel)
.type text xhint    ? _F|defined(U|xhint)
.type text xgrliste ? _F|defined(U|xgrliste)
..
.. Initializations
.formula U|xgrliste = M|grliste
.continue ERROR2 ? U|xgrliste = "127"
.formula G|evtfeldneu = F|trim(G|evtfeldneu)
.formula G|evtfeldneu = "%!" ? G|evtfeldneu = "%?" ; G|evtfeldneu = "%"
..
.. Control types of selection
.continue SELBAR  ? G|evtfeldneu/"%*"
.continue SINGLE  ? G|evtfeldneu/"*\?*"
..
.. Normal Selection, i.e. $,,;nummer=;@gruppe=1
.formula M|select = G|evtfeldneu
.formula M|select = "!" ? F|empty(G|evtfeldneu)
.formula U|xhint = M|select
.continue HINT
..
!SELBAR: Selection bar
.formula U|xsel = G|evtfeldneu
.formula U|xsel = U|xsel + ",," ? _(U|xsel/"*,*")
.formula U|xsel = U|xsel + ";@lesen=nein"
.select group 'U|xgrliste' 'U|xsel'
.formula M|select = "!"  ? F|empty(G|selrohl)
.formula M|select = "$" + (G|selrohl<<-1) + G|selkrit ? _F|empty(G|selrohl)
.formula U|xhint = (M|select>$",")<<"@" ? M|select<>"$"
..
.. DIAG 4711 caused by customer build selections never force standard DIAGs.
.formula M|select = M|select + ";@admfehl=ja"
.continue HINT
..
!SINGLE: Selection of one data object
.select group 'U|xgrliste' 'G|evtfeldneu'
.continue ERROR1 ? _G|mehr
.formula M|select = H|id
.formula U|xhint = H|nummer + " " + H|such
.continue HINT
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!HINT: Show hint in status bar
.note Auswahl: 'U|xhint'
.continue END
..
!ERROR1: No record found!
.error -message Kein Datensatz gefunden!
.end 1
..
!ERROR2: No DB specified!
.error -message Keine Datenbank angegeben!
.end 1
