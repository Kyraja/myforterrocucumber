..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TAB.MARK
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Aktiviert oder Deaktiviert die Tabellenzeilen. Dazu wird
..                  das schreibbare Feld "M|tmark" verwendet. Ist in "M|mark"
..                  keine Markierungsform festgelegt, wird aus der AZ250 ein
..                  Dialog zur Auswahl abgeleitet. Sonst wird wie festgelegt
..                  markiert.
.. Ablauf         : EFOP
..
.. Functionality  : Selects or deselects the table rows. Thereto it uses the
..                  modifiable field "M|tmark". If no All select type in field
..                  "M|mark" exists, there will be a dialog using enumeration
..                  250. Otherwise it will be marked as defined.
.. Program flow   : Efop
..*****************************************************************************
.set trans -
..
.continue DECLARE ? _F|empty(M|tzeilen)
.input "is/STATUS.EMPTY.TABLE"
.continue END
..
!DECLARE: Declarations
.type bool xbmark ? _F|defined(U|xbmark)
..
.. Initializations
.copy U|xbmark = G|TRUE
.set enumerationtype 250
.continue ERROR01 ? _G|mehr
.continue DIALOG  ? _F|defined(M|mark)
.continue DIALOG  ?  F|empty(M|mark)
.copy U|xbmark = F|equals(M|mark, "(SelectAll)")
.continue TABMARK
..
!DIALOG: Making menu
.menu 'G|enumdescr'
?'G|enumpostext1' ? F|defined(G|enumpostext1)
?'G|enumpostext2' ? F|defined(G|enumpostext2)
?'G|enumpostext3' ? F|defined(G|enumpostext3)
.continue END ? F|empty(G|menue) ; G|menue = 3
.copy U|xbmark = G|FALSE ? G|menue = 2
..
!TABMARK: Setting switch in all table lines
.select screen line 'F|formatstr("$,,tmark<>{1}", U|xbmark)'
!CHECK
.continue END ? _G|mehr
.formula M|tmark = U|xbmark ? F|modifiable(M|tmark) & _F|protected(M|tmark, M|aktzeile)
..
!NEXTROW
.select screen line
.continue CHECK
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Missing enum 250
.error -message Die Aufz„hlung 250 wurde nicht gefunden!
.end 1
