..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BN.BESTAND
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
..
.. Funktion       : Infosystem, Aufruf des Bestandsinfos fuer die
..                  Baugruppe artikel mit der richtigen Lagergruppe
.. Ablauf         :
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xkomm:100 xparams:100
..
.. Load product
.load 0 add M|artikel
.continue WEITER ? G|mehr
..
.. Load from details in current table row
.load 0 add M|art
.continue END ? _G|mehr
..
!WEITER
.continue END  ? 0|gruppe <> 1
.continue FROM ? _F|empty(M|vplatz) & F|empty(M|nplatz)
..
.. to this stock
.load 2 add M|nplatz
.continue END ? _G|mehr
.continue COMMAND
..
!FROM: From this stock
.load 2 add M|vplatz
.continue END ? _G|mehr
..
!COMMAND: Build command
.formula U|xparams = "artikel=" + 0|id + "|klgruppe=" + 2|lgruppe^id + "|klplatz=" + 2|id + "|bstart=|[pos]=0:artikel"
.formula U|xkomm   = "(Infosystem) BESTAND"
..
.. Use given window if exist
.command -window 'M|maskbestand' -new "'U|xkomm'" -id M|maskbestand 'U|xparams'
..*****************************************************************************
!END
.continue
