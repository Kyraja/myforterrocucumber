..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LDB.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt Zeilen- und Feldereignisse ausser Button-nach.
.. Functionality  : Handles row and field events except button after events.
..*****************************************************************************
.set trans -
..
..  ---------------------------------------------------------------------------
..  Kopfteil/header
..  ---------------------------------------------------------------------------
.continue SELECT  ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bselect"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "select"
.continue DATNAME ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "dn" ; G|evtvar = "datname"
.continue DATNAME ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "grliste"
.continue DATNAME ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "datnr"
.continue GROUPS  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "grausw"
..  ---------------------------------------------------------------------------
.continue END
..
!SELECT: Define database query using selection bar
.continue ERROR1 ? M|datnr = 127
.formula G|evtfeldneu = "%"
.input "is/AUSWAHL"
.continue CLRTAB
..
!GROUPS: Define databases
.assign M|select = "!"
.continue CLRTAB
..
!DATNAME: Name of database has changed
.continue NODB   ? M|datnr = 127
.continue ERROR2 ? M|datnr = 14 ; M|datnr = 52
.assign M|select = "!"
.copy M|erlaubt = F|cmdpermitted(F|tovalue('M|datnr',"I9"), 12)
.continue CLRTAB
..
!NODB: No database wanted
.copy M|erlaubt = G|FALSE
.continue CLRTAB
..
!CLRTAB: Clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: No database selected
.error -line 0 -field M|dn -message Bitte zuerst eine Datenbank bestimmen!
.end 1
..
!ERROR2: Database is not allowed
.error -line 0 -field M|dn -message Die Datenbank 'M|dn' ist nicht erlaubt!
.end 1
