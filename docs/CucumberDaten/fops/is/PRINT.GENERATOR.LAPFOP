..!interpreter english translate noabbrev
.continue DECL
..*****************************************************************************
.. FOP-Name       : PRINT.GENERATOR.LAPFOP
.. Autor          : lei
.. Verantwortlich : lei
.. Kontrolle      : mg
.. Funktion       :
..
..   P|aktslayout Das Startlayout
..   P|aktpfad    Der abstrakte Aufrufpfad
..   Aufruf erfolgt auf Ebene 0 mit .eingabe aus dem Druckdialog
..   in den hoeheren Ebene direkt ueber P|burekursion
..
.. Ablauf         :
..   Uebersetzt den lokalen Ablaufplan P|aktpfad:
..      Datengenerieren
..      Aufrufe naechster Ebene generieren
..      Renderaufrufe generieren
..
..    Verwendet Puffer 3 fuer den Aufrufparameter
..*****************************************************************************
.set trans -
..
!DECL
.continue START ? F|defined(U|xlappfad1)
.type text xlappfad1
.type text xkenn1
.type text xpar1
.type text xkopf1
.type text xval1
.type text xgenfop1
.type text xdatagenfop1 xkopftext xaktpfad
.type integer  xlapdesc1
.type integer  xzeile1
.type integer  xebene1
.type integer xin
.type ID87:9 xaufrufparam1
.type bool xistkopf1
.type text xfeldnamen
.type bool xersterap
.. Konstanten fuer Typen der rechten Seiten in den APs
.input "is/A150VARS.FOP"
..
!START
.assign U|xlappfad1 = U|xgenprefix + P|aktpfad + ".LAP"
.assign U|xgenfop1 = U|xgenprefix + P|aktpfad + ".LAPFOP"
.output new 'U|xgenfop1'
.input "DATEI.F"
.set separator
'U|xpunkt'.!interpreter english noabbrev
'U|xpunkt'type VID99 xaufrref ? _defined(U|xaufrref)
.file -open U|xlapdesc1 'U|xlappfad1'
.continue ERRLAP ? _G|mehr
.assign U|xzeile1 = 0
!LESLAP
.file -read U|xlapdesc1 U|xkenn1 # U|xpar1 # U|xkopf1 # U|xval1 ^
.continue ENDLAP ? _G|mehr
.assign U|xzeile1 = U|xzeile1 + 1
'U|xpunkt'. 'U|xlappfad1':'U|xzeile1' 'U|xkenn1' # 'U|xpar1' # 'U|xkopf1' # 'U|xval1'
.continue EKENN ? U|xkenn1 = "E"
.continue GKENN ? U|xkenn1 = "G"
.continue PKENN ? U|xkenn1 = "P"
.continue ERRKENN
..
!EKENN
.assign U|xebene1 = U|xpar1
.continue ERREBE ? _G|mehr
'U|xpunkt'assign U|xedpdatei = P|akttmp + "KAP." + 'G|dblquote''U|xebene1''G|dblquote'
'U|xpunkt'output addedto 'G|apostroph'U|xedpdatei'G|apostroph'
.assign U|xersterap = G|true
#!doublelinefeed=1

# Ebene: 'U|xebene1'
#    P|akttmp='G|apostroph'P|akttmp'G|apostroph'
#    P|aktslayout='G|apostroph'P|aktslayout'G|apostroph'
.. 'U|xpunkt'continue STRUKTUR ? _P|datagen
.continue LESLAP
..
!GKENN
.assign U|xdatagenfop1 = U|xpar1
'U|xpunkt'. Datengenerator: 'U|xdatagenfop1' Ausgabe auf: 'G|apostroph'P|aktdaten'G|apostroph'
'U|xpunkt'. Datengenerator: 'U|xdatagenfop1' Ausgabe auf: 'G|apostroph'P|daten'G|apostroph'
'U|xpunkt'assign U|xxmldata = P|aktdaten
.continue GE1 ? U|xebene1 = 1
'U|xpunkt'input 'G|dblquote''U|xdatagenfop1''G|dblquote'
.continue EGENFEHL ? _F|fileexists('U|xdatagenfop1')
!GE1
'U|xpunkt'.  Beschaffung Ebene 1 erfolgt im Channel eingabe 'G|dblquote''U|xdatagenfop1''G|dblquote'
.continue EGENFEHL ? _F|fileexists('U|xdatagenfop1')
.output addedto 'U|xgenfop1'
.continue LESLAP
..
!PKENN
.assign U|xaufrufparam1 = U|xpar1
.continue ERRAUF ? _G|mehr
.load 3 add U|xaufrufparam1
.continue ERRAUF ? _G|mehr
.assign U|xistkopf1 = (U|xkopf1 = "0")
.continue ERSTERAP ? _U|xersterap
.. 'U|xmarke'STRUKTUR
.. 'U|xpunkt'continue ? _P|STRUKTUR
'U|xpunkt'. set languagesettings  "0"
'U|xpunkt'set separator
'U|xpunkt'set reference "REF"
'U|xpunkt'output addedto 'G|apostroph'U|xedpdatei'G|apostroph'
# Erster Aufrufparameter
# Spracheinstellungen weitergeben

#!charset=EKS

#!edp_lang='G|apostroph'T|bsprache'G|apostroph'

#!assignprefix=1

#!lineseparator=\n

#!typedcmd=43

#!action=do

sprfoschutz
sprschutz
spr
tsdtrenn
dezpunkt
datform
jkw
sepform
timeform
weekform
aufznummer
verwmode
ablagekennz
sprfoschutz
sprschutz
allelayouts
druckid
dialayout
diadrucker

sprfoschutz=0
sprschutz=0
spr='G|apostroph'P|spr'G|apostroph'
.type text xfrage ? _F|defined(U|xfrage)
.assign U|xfrage = "?"
'U|xfrage'tsdtrenn='G|apostroph'P|tsdtrenn'G|apostroph' ? P|tsdtrenn<>" "
'U|xfrage'tsdtrenn=@@ ? P|tsdtrenn=" "
dezpunkt='G|apostroph'P|dezpunkt'G|apostroph'
datform='G|apostroph'P|datform'G|apostroph'
jkw='G|apostroph'P|jkw'G|apostroph'
sepform='G|apostroph'P|sepform'G|apostroph'
timeform='G|apostroph'P|timeform'G|apostroph'
weekform='G|apostroph'P|weekform'G|apostroph'
aufznummer='G|apostroph'P|aufznummer'G|apostroph'
verwmode='G|apostroph'P|verwmode'G|apostroph'
ablagekennz='G|apostroph'P|ablagekennz'G|apostroph'
sprfoschutz='G|apostroph'P|sprfoschutz'G|apostroph'
sprschutz='G|apostroph'P|sprschutz'G|apostroph'
allelayouts=0
druckid='G|apostroph'P|druckid'G|apostroph'
dialayout='G|apostroph'P|dialayout^id'G|apostroph'
diadrucker='G|apostroph'P|diadrucker^id'G|apostroph'

.assign U|xersterap = G|false
!ERSTERAP
.continue OBJAP ? 3|zielobj^dnr = 12
'U|xpunkt'assign U|xaufrref = "'3|zielobj^id'"
#!database=65:1

#!action=get
.continue APTAB
!OBJAP
#!database='3|zielobj^vdn':'3|zielobj^vgr'

#!action=view
..
!APTAB

# Aufrufparameter Anfang: 'U|xaufrufparam1' 'U|xkopf1'
.. Zaehler fuer die generierten Marken
.assign U|xin = U|xin + 1
.assign U|xkopftext="K" ? U|xistkopf1
.assign U|xkopftext="T" ? _U|xistkopf1
.assign U|xaktpfad =P|aktpfad + "." + U|xkopftext + "." + 3|nummer
# Aufrufe absetzen:
#    P|aktpfad='U|xaktpfad'
# 1. Aufrufparametertabelle auswerten
# Der erste Lauf erstellt die Ueberschrift
.load 3 header
.continue U1AUFZ ? _G|mehr
.. Feldname Anfang

id
!O1AUFZ
.load 3 line
.continue U1AUFZ ? _G|mehr
.. Feldname
'U|xpunkt'. 1. Zeile '3|aktzeile':'3|zielvar' = '3|aufrwtyp' '3|aufrwert'
'3|zielvar'
.continue O1AUFZ
..
!U1AUFZ
.. Feldname ende
>budruck2
aktnachfop
aktslayout
akttmp
aktpfad
aktdaten
daten
burekursion
<

# 2. Aufrufparametertabelle auswerten
.continue OKOPF ? U|xistkopf1
.continue OZEIL
..
!OKOPF
# Kopfteil Anfang

'U|xpunkt'select screen head
'U|xpunkt'assign U|xaktdaten = P|aktdaten + ".0." + 'dblquote''3|such''dblquote'
'U|xpunkt'assign U|xdaten = P|daten + ".0." + 'dblquote''3|such''dblquote'
..'U|xpunkt'output addedto 'G|apostroph'U|xaktdaten'G|apostroph'
..'U|xpunkt'output addedto 'G|apostroph'U|xedpdatei'G|apostroph'
.continue OLADE
..
!OZEIL
# Zeilenschleife Anfang

'U|xpunkt'select screen head
'U|xmarke'OZEI'U|xin'
'U|xpunkt'select screen line
'U|xpunkt'continue EZEI'U|xin' ? _G|mehr
'U|xpunkt'assign U|xaktdaten = P|aktdaten + "." + 'G|apostroph'M|aktzeile'G|apostroph' + "." + 'G|dblquote''3|such''G|dblquote'
'U|xpunkt'assign U|xdaten = P|daten + "." + 'G|apostroph'M|aktzeile'G|apostroph' + "." + 'G|dblquote''3|such''G|dblquote'
..'U|xpunkt'output new 'G|apostroph'U|xaktdaten'G|apostroph'
..'U|xpunkt'output addedto 'G|apostroph'U|xedpdatei'G|apostroph'
..
!OLADE
..
.. Behandlung des Aufruferobjektes
.continue OBEDINGUNG ? F|empty(3|aufrzieltyp) ; F|empty(3|aufrziel)
.. Behandlung der Bedingung
.continue OLEER ? 3|aufrziel = ""
.. Variable oder Konstante? '3|aufrzieltyp'
.continue OVAR ? 3|aufrzieltyp = U|xkopfvariable ; 3|aufrzieltyp = U|xtabellenvariable
.continue OPVA ? 3|aufrzieltyp = U|xdruckparameter
.continue OFOR ? 3|aufrzieltyp = U|xformel
.continue OKON ? 3|aufrzieltyp = U|xkonstant
.continue ERRDRU4
..
!OLEER
'U|xpunkt'assign U|xaufrref = "(0,0,0)"
.continue OEND
..
!OKON
'U|xpunkt'assign U|xaufrref = "'3|aufrziel'"
.continue OEND
..
!OVAR
'U|xpunkt'assign U|xaufrref = M|'3|aufrziel'
.continue OEND
..
!OPVA
'U|xpunkt'assign U|xaufrref = P|'3|aufrziel'
.continue OEND
..
!OFOR
'U|xpunkt'assign U|xaufrref = '3|aufrziel'
..###############
!OEND
# U|xaufrref: 'G|apostroph'U|xaufrref'G|apostroph'
'U|xpunkt'continue UBED'U|xin' ? F|empty(U|xaufrref)
'U|xpunkt'assign U|xaufrref = "(0,0,0)" ? U|xaufrref^dnr <> '3|zielobj^vdn' ; U|xaufrref^objgruppe <> '3|zielobj^vgr'
# U|xaufrref: 'G|apostroph'U|xaufrref'G|apostroph' 'G|apostroph'U|xaufrref^dnr'G|apostroph' 'G|apostroph'U|xaufrref^objgruppe'G|apostroph'
# U|xaufrref: 'G|apostroph'F|empty(U|xaufrref)'G|apostroph'
'U|xpunkt'continue UBED'U|xin' ? F|empty(U|xaufrref)
..
!OBEDINGUNG
.. Behandlung der Bedingung
.continue BLEER ? 3|aufrbed = ""
.. Variable oder Konstante? '3|aufrbedtyp'
.continue BVAR ? 3|aufrbedtyp = U|xkopfvariable ; 3|aufrbedtyp = U|xtabellenvariable
.continue BPVA ? 3|aufrbedtyp = U|xdruckparameter
.continue BFOR ? 3|aufrbedtyp = U|xformel
.continue BKON ? 3|aufrbedtyp = U|xkonstant
.continue ERRDRU4
..
!BLEER
'U|xpunkt'continue OBED'U|xin'
.continue BEND
..
!BKON
?'U|xpunkt'continue OBED'U|xin' ? '3|aufrbed' = "1"
?# Konstante <> 1 ? '3|aufrbed' <> "1"

.continue BEND
..
!BVAR
'U|xpunkt'continue OBED'U|xin' ? M|'3|aufrbed'
.continue BEND
..
!BPVA
'U|xpunkt'continue OBED'U|xin' ? P|'3|aufrbed'
.continue BEND
..
!BFOR
'U|xpunkt'continue OBED'U|xin' ? '3|aufrbed'
..
!BEND
# Bedingung: '3|aufrbedtyp' '3|aufrbed' kein Treffer 'G|apostroph'M|aktzeile'G|apostroph'

'U|xpunkt'continue UBED'U|xin'
'U|xmarke'OBED'U|xin'
# Behandle "aufrpflicht"
# Alle Zeilen durchsuchen

.load 3 header
.continue EAUPZEILE ? _G|mehr
'U|xpunkt'. Pflichtfeld? Anfang
!OAUPZEILE
.load 3 line
.continue EAUPZEILE ? _G|mehr
'U|xpunkt'. 2. Zeile '3|aktzeile': Plicht '3|aufrpflicht', '3|aufrwtyp', Wert: '3|aufrwert'
.continue OAUPZEILE ? _3|aufrpflicht
.. Variable oder Konstante? '3|aufrwtyp'
.continue ZPVAR ? 3|aufrwtyp = U|xkopfvariable ; 3|aufrwtyp = U|xtabellenvariable
.continue ZPPVA ? 3|aufrwtyp = U|xdruckparameter
.continue ZPFOR ? 3|aufrwtyp = U|xformel
.continue ZPKON ? 3|aufrwtyp = U|xkonstant
.continue ERRDRU5
..
!ZPVAR
'U|xpunkt'. Pflichtfeld M-Variable
'U|xpunkt'continue UBED'U|xin' ? F|empty(M|'3|aufrwert')
.continue ZPEND
..
!ZPPVA
'U|xpunkt'. Pflichtfeld P-Variable
'U|xpunkt'continue UBED'U|xin' ? F|empty(P|'3|aufrwert')
.continue ZPEND
..
!ZPFOR
'U|xpunkt'. Pflichtfeld Formel
'U|xpunkt'continue UBED'U|xin' ? F|empty('3|aufrwert')
.continue ZPEND
..
!ZPKON
'U|xpunkt'. Pflichtfeld Konstante
'U|xpunkt'continue UBED'U|xin' ? F|empty("'3|aufrwert'")
..
!ZPEND
.continue OAUPZEILE
..
!EAUPZEILE
# P|daten: 'G|apostroph'U|xdaten'G|apostroph'
# P|aktdaten: 'G|apostroph'U|xaktdaten'G|apostroph'
# Zeile: 'G|apostroph'M|aktzeile'G|apostroph' auswerten

.load 3 header
.continue EAUZEILE ? _G|mehr
'U|xpunkt'. Feldwert Anfang

id='G|apostroph'U|xaufrref'G|apostroph'
!OAUZEILE
.load 3 line
.continue EAUZEILE ?_G|mehr
'U|xpunkt'. 3. Zeile '3|aktzeile':'3|zielvar' = '3|aufrwtyp' '3|aufrwert'
.. Variable oder Konstante? '3|aufrwtyp'
.continue ZVAR ? 3|aufrwtyp = U|xkopfvariable ; 3|aufrwtyp = U|xtabellenvariable
.continue ZPVA ? 3|aufrwtyp = U|xdruckparameter
.continue ZFOR ? 3|aufrwtyp = U|xformel
.continue ZKON ? 3|aufrwtyp = U|xkonstant
.continue ERRDRU5
..
!ZVAR
'U|xpunkt'. Feldwert M-Variable
'U|xpunkt'. zielvar: '3|zielvar' = 'G|apostroph'M|'3|aufrwert''G|apostroph'
'U|xpunkt'assign U|xfeldwert = 'G|apostroph'M|'3|aufrwert''G|apostroph'
.continue ZEND
..
!ZPVA
'U|xpunkt'. Feldwert P-Variable
'U|xpunkt'. zielvar: '3|zielvar' = 'G|apostroph'P|'3|aufrwert''G|apostroph'
'U|xpunkt'assign U|xfeldwert = 'G|apostroph'P|'3|aufrwert''G|apostroph'
.continue ZEND
..
!ZFOR
'U|xpunkt'. Feldwert Formel
'U|xpunkt'. zielvar: '3|zielvar' = 'G|apostroph'F|expr('3|aufrwert')'G|apostroph'
'U|xpunkt'assign U|xfeldwert = 'G|apostroph'F|expr('3|aufrwert')'G|apostroph'
.continue ZEND
..
!ZKON
'U|xpunkt'. Feldwert Konstante
'U|xpunkt'. zielvar: '3|zielvar' = '3|aufrwert'
'U|xpunkt'assign U|xfeldwert = "'3|aufrwert'"
..
!ZEND
'U|xpunkt'. Feldwert
'3|zielvar'='G|apostroph'U|xfeldwert'G|apostroph'
.continue OAUZEILE
..
!EAUZEILE
'U|xpunkt'. Feldwert Ende
'U|xpunkt'. Druckpuffer setzen
>budruck2=
aktnachfop=is/PRINT.START.LAP
aktlayout='G|apostroph'P|aktslayout'G|apostroph'
akttmp='G|apostroph'P|akttmp'G|apostroph'
aktpfad='U|xaktpfad'
aktdaten='G|apostroph'U|xaktdaten'G|apostroph'
daten='G|apostroph'U|xdaten'G|apostroph'
burekursion=
<=

'U|xpunkt'. Bedingung Ende
'U|xmarke'UBED'U|xin'
.continue UKOPF ? U|xistkopf1
.continue UZEIL
!UKOPF
# Kopfteil Ende
.continue ULADE
!UZEIL
'U|xpunkt'continue OZEI'U|xin'
'U|xmarke'EZEI'U|xin'
# Zeilenschleife Ende
..
!ULADE
# Aufrufparameter Ende: 'U|xaufrufparam1' 'U|xkopf1'

.continue LESLAP
..
!ENDLAP
.file -close xlapdesc1
.. Ende Behandlung:
'U|xpunkt'. set languagesettings "T"
'U|xpunkt'set separator ;
'U|xpunkt'set reference "EXT"
'U|xpunkt'continue
'U|xpunkt'.
..*****************************************************************************
!END
.set separator ;
.continue
..*****************************************************************************
..
!ERRLAP
.error Lokaler Ablaufplan 'U|xlappfad1' kann nicht ge”ffnet werden.
.end 1
..
!ERRKENN
.error 'U|xlappfad1':'U|xzeile1' Kennzeichen 'U|xkenn1' unbekannt.
.end 1
..
!ERRAUF
.error 'U|xlappfad1':'U|xzeile1' Aufrufparameter 'U|xpar1' unbekannt.
.end 1
..
!ERRDRU4
!ERRDRU5
.error Falscher Wert in Typ
.end 1
..
!EGENFEHL
.set trans +
.output terminal
Datengenerator fuer 'P|aktslayout' ist nicht vorhanden: 'U|xdatagenfop1'
.error Datengenerator fuer 'P|aktslayout' ist nicht vorhanden: 'U|xdatagenfop1'
.end 1
