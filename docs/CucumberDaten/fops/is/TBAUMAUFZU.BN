..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name                    : TBAUMAUFZU.BN
.. Autor                       : fwester
.. Verantwortlich              : fwester
.. Kontrolle                   : cl
.. Funktion                    : Steuert die Behandlung des Button-nach-Ereignisses
..                               auf dem Standardtabellenfeld istbaumaufzu.
.. Ablauf                      : Button-nach-EFOP
..
.. Functionality               : Controls the button after event handling of the standard
..                               field istbaumaufzu.
.. Program flow                : After button efop
..*****************************************************************************
.set trans -
..
.. do not execute while not used as mentioned above
.continue END ? _F|defined(G|evtartengl)
.continue END ? G|evtartengl <> "BUTTON_AFTER" ; G|evtvar <> "tbaumaufzu"
..
.. declarations for some parameters which might be used in subroutines
.type integer  xrowsbefore
..
.continue CONTROL ? G|evtzeile = M|aktzeile
.select screen line 'G|evtzeile'
.continue FATAL ? _G|mehr
..
!CONTROL
.continue OPEN  ? M|tbaumstat = "+"
.continue CLOSE ? M|tbaumstat = "-"
.continue END
..
!OPEN: handle opening of the knot by calling of some subroutines
.formula U|xrowsbefore = M|tzeilen
.continue GETKNOT ? _F|defined(M|beforeopen)
.input 'M|beforeopen' ? _F|empty(M|beforeopen)
..
!GETKNOT
.formula M|tbaumstat = "-"
.continue DETAILS ? _F|defined(M|openknot)
.input 'M|openknot' ? _F|empty(M|openknot)
..
.continue DETAILS ? _F|defined(M|afteropen)
.input 'M|afteropen' ? _F|empty(M|afteropen)
.continue DETAILS
..
!CLOSE: handle closing of the knot by calling of some subroutines
.formula U|xrowsbefore = M|tzeilen
.continue NOKNOT ? _F|defined(M|beforeclose)
.input 'M|beforeclose' ? _F|empty(M|beforeclose)
..
!NOKNOT
.formula M|tbaumstat = "+"
.continue DETAILS ? _F|defined(M|closeknot)
.input 'M|closeknot' ? _F|empty(M|closeknot)
..
.continue DETAILS ? _F|defined(M|afterclose)
.input 'M|afterclose' ? _F|empty(M|afterclose)
..
!DETAILS: loading row details of clicked row in the mask header by a subroutine
.continue END ? _F|defined(M|rowdetails)
.input 'M|rowdetails' ? _F|empty(M|rowdetails)
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
