..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : HOL.BINDUNG
.. Autor          : fwester/tiwe
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Beschafft die Bindungen zum Materialbeweger, welcher durch das
.. Selektionsmuster in M|select oder die ID xmover eindeutig feststehen muss.
.. Ablauf         : Allgemeines Werkzeug zum Abfragen von Bindungen.
..
.. Functionality  : Gets the reservations which are bound to a mover which has
.. its unique definition through the selection pattern M|select or the ID xmover.
.. Program flow   : General tool to query for links.
..*****************************************************************************
.set trans -
..
.. Declarations
.type VID19 xmover ? _F|defined(U|xmover)
.type text xtsel ? _F|defined(U|xtsel)
..
.. Initializations
.continue MOVER ? _F|empty(U|xmover)
.assign U|xmover = M|select
.continue ERROR1 ? _G|mehr
.continue HBUFFER
..
!MOVER: Get mover of material
.continue ERROR2 ? _F|compatible("VID19", F|typeof(U|xmover))
..
!HBUFFER
.select object 'U|xmover'
.continue ERROR3 ? _G|mehr
..
!BOUNDTO: Get reservations which are bound to the mover
.reserve link
..
!HEADER: run report header FOP
.input 'M|bkopf' ? M|bkopf <> ""
..
!NEXT: load next reservation
.select link
.continue FOOTER ? G|bvkenn = ""
..
!TABROW : run table row FOP which normally inserts a row
.input 'M|tab' ? M|tab <> ""
.continue NEXT
..
!FOOTER: run report footer FOP
.input 'M|bfuss' ? M|bfuss <> ""
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -message Der Wert von M|select kann keinem Materialbeweger zugewiesen werden.
.end 1
..
!ERROR2
.error -message Der Wert von U|xmover ist keine ID eines Materialbewegers.
.end 1
..
!ERROR3
.error -message Der Materialbeweger mit der ID 'U|xmover^id' wurde nicht gefunden.
.end 1
