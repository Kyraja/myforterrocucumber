..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PDC.DURATION
.. Author         : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Function       : Ermittlung der Dauer von H|anfzeit/H|anfdat bis G|zeit/G|datum
..                  fÅr Auftragszeiten oder setzen von xbzeitfehler bei Fehlern
.. Functionality  : Calculate the duration H|anfzeit/H|anfdat to G|zeit/G|datum
..                  for order times or set xbzeitfehler in case of an error
..*****************************************************************************
.set trans -
.type text    xtanfzeit        ? _F|defined(U|xtanfzeit)
.type text    xtendzeit        ? _F|defined(U|xtendzeit)
.type text    xtmitternacht1   ? _F|defined(U|xtmitternacht1)
.type text    xtmitternacht2   ? _F|defined(U|xtmitternacht2)
.type GD19    xzanfzeit        ? _F|defined(U|xzanfzeit)
.type GD19    xzendzeit        ? _F|defined(U|xzendzeit)
.type GD19    xzmitternacht1   ? _F|defined(U|xzmitternacht1)
.type GD19    xzmitternacht2   ? _F|defined(U|xzmitternacht2)
.type GP3     xzdauer1         ? _F|defined(U|xzdauer1)
.type GP3     xzdauer2         ? _F|defined(U|xzdauer2)
.type text    xtdauer1         ? _F|defined(U|xtdauer1)
.type text    xtdauer2         ? _F|defined(U|xtdauer2)
.type text    xtdauertage1     ? _F|defined(U|xtdauertage1)
.type text    xtdauertage2     ? _F|defined(U|xtdauertage2)
.type text    xtdauerstunden1  ? _F|defined(U|xtdauerstunden1)
.type text    xtdauerstunden2  ? _F|defined(U|xtdauerstunden2)
.type text    xtdauerminuten1  ? _F|defined(U|xtdauerminuten1)
.type text    xtdauerminuten2  ? _F|defined(U|xtdauerminuten2)
.type integer xidauerminuten1  ? _F|defined(U|xidauerminuten1)
.type integer xidauerminuten2  ? _F|defined(U|xidauerminuten2)
.type integer xidauerstunden1  ? _F|defined(U|xidauerstunden1)
.type integer xidauerstunden2  ? _F|defined(U|xidauerstunden2)
.type R7.2    xrdauer1         ? _F|defined(U|xrdauer1)
.type R7.2    xrdauer2         ? _F|defined(U|xrdauer2)
.type R7.2    xrsumme          ? _F|defined(U|xrsumme)
.type bool    xbzeitfehler     ? _F|defined(U|xbzeitfehler)
.type GD2     xdvergleich      ? _F|defined(U|xdvergleich)
..
.copy U|xbzeitfehler = G|FALSE
..
.. 1. PrÅfung: Anfangsdatum und Enddatum
.continue OK ? H|anfdat = G|datum
..
.. 2. PrÅfung: Anfangsdatum und Enddatum unterschiedlich, nun Zeitdauern vor
.. und nach Mitternacht ermitteln
.formula U|xdvergleich = H|anfdat + 1
.continue ZEITDAU   ? U|xdvergleich = G|datum
.. hier liegen Anfangsdatum und aktuelles Datum mehr als einen Tag auseinander
.continue FEHL1
..
!ZEITDAU
.. 2.1.a) Zeitdauer anfzeit bis Mitternacht
.formula U|xtanfzeit  =  'H|anfdat' + " " + 'H|anfzeit'
.assign   U|xzanfzeit  =  U|xtanfzeit
.formula U|xtmitternacht1 =  'H|anfdat' + "  23:59"
.assign   U|xzmitternacht1 = U|xtmitternacht1
.formula U|xzdauer1        = U|xzmitternacht1 - U|xzanfzeit
.. 2.1.b) Zeitdauer Mitternacht bis endzeit
.formula U|xtendzeit = 'G|datum' + " " + 'G|zeit'
.assign U|xzendzeit  = U|xtendzeit
.formula U|xtmitternacht2  = 'G|datum' + "  00:01"
.assign  U|xzmitternacht2    =   U|xtmitternacht2
.formula U|xzdauer2     = U|xzendzeit - U|xzmitternacht2
.. in xzdauer1 und xzdauer2 liegen nun die Dauer im Format 0D10h47m05s vor
.. diese Variable wird nun in eine Text-Variable Åbergeben und auseinandergeschnitten
.. um eine Anzahl in Stunden und in Minuten zu ermitteln
.formula U|xtdauer1 = U|xzdauer1
.formula U|xtdauer2 = U|xzdauer2
.formula U|xtdauertage1 = U|xtdauer1 << 2
.formula U|xtdauertage2 = U|xtdauer2 << 2
.formula U|xtdauerstunden1 =U|xtdauer1 << -2
.formula U|xtdauerstunden2 = U|xtdauer2 <<  -2
.formula U|xtdauerstunden1  = U|xtdauerstunden1 <<  3
.formula U|xtdauerstunden1  = U|xtdauerstunden1 >> -1
.formula U|xtdauerstunden2  = U|xtdauerstunden2 <<  3
.formula U|xtdauerstunden2  = U|xtdauerstunden2 >> -1
.formula U|xtdauerminuten1 = U|xtdauer1 << -5
.formula U|xtdauerminuten2 = U|xtdauer2 << -5
.formula U|xtdauerminuten1 = U|xtdauerminuten1  << 3
.formula U|xtdauerminuten1 = U|xtdauerminuten1  >> -1
.formula U|xtdauerminuten2 = U|xtdauerminuten2  << 3
.formula U|xtdauerminuten2 = U|xtdauerminuten2  >> -1
..xidauerminuten enthÑlt aus der Textvariable den Minutenanteil
.assign U|xidauerminuten1 = U|xtdauerminuten1
.assign U|xidauerminuten2 = U|xtdauerminuten2
..xidauerstunden enthÑlt aus der Textvariable den Sundenanteil
.assign U|xidauerstunden1 = U|xtdauerstunden1
.assign U|xidauerstunden2 = U|xtdauerstunden2
.. xrdauer ist der Zeitaum im Format 8,5 h
.formula U|xrdauer1 = (U|xidauerminuten1 / 60) + U|xidauerstunden1
.formula U|xrdauer2 = (U|xidauerminuten2 / 60) + U|xidauerstunden2
.. Beide xrsumme: beide Zeitdauern vor und nach Mitternacht zusammenaddiert.
.formula U|xrsumme = U|xrdauer1 + U|xrdauer2
..
.continue FEHL2 ? U|xrsumme > 24
.. hier ist die Zeitdauer kleiner als 24 Stunden, deswegen kein Fehler
.copy U|xbzeitfehler = G|FALSE
.continue ENDE
..
!OK: Zeitmeldung OK
.copy U|xbzeitfehler = G|FALSE
.continue ENDE
..
!FEHL1: Anfangs- und Endtag unterscheiden sich um mehr als einen Tag
.copy U|xbzeitfehler = G|TRUE
.continue ENDE
..
!FEHL2: Anfangs und Endtag unterscheiden sich um einen Tag, Zeitdauer grî·er als 24 h
.copy U|xbzeitfehler = G|TRUE
.continue ? G|evtvar = "bumastill"
.continue ENDE
..
..*****************************************************************************
!ENDE
.continue
