..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : NORM.TELNR
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : xg
.. Funktion       : Normiert Telefonnummern. (1. Realisierungsstufe latein)
.. IN             : xtnormtyp   ->   Normierungsart (default = NUM)
..                                   LATINNUM = Lateinziffern
..                                   LATINLETTER = zusaetzlich Lateinbuchstaben
.. IN & OUT         xttelnr     ->   Telefonnummer per se (Muss)
..                  xbisnorm    ->   Erfolgsschalter (Muss)
.. Ablauf         : Kann als Unterprogramm verwendet werden.
..
.. Functionality  : Normalizes phone contacts.
.. IN             : xtnormtyp   ->   Typ of normalization (default = LATINNUM)
..                                   LATINNUM = latin numbers
..                                   LATINLETTER = plus latin characters
.. IN & OUT         xttelnr     ->   contact itsself (required)
..                  xbisnorm    ->   switch for result (required)
.. Program flow   : Usable as an subroutine.
..*****************************************************************************
.set trans -
..
.. Declarations
.type text XTNUM    ? _F|defined(U|XTNUM)
.type text XTLETTER ? _F|defined(U|XTLETTER)
..
.. Initializations
.formula U|XTNUM = "LATINNUM"
.formula U|XTLETTER = "LATINLETTER"
..
.. executable?
.continue END ? _F|defined(U|xbisnorm)
.continue END ? _F|defined(U|xttelnr)
..
!NORMTYP: switch off xbisnorm and check type of normalization
.copy U|xbisnorm = G|FALSE
.continue CHECK ? F|defined(U|xtnormtyp)
.continue START
..
!CHECK
.continue END ? U|xtnormtyp <> U|XTNUM & U|xtnormtyp <> U|XTLETTER
..
!START
.type text xtnormtyp  ? _F|defined(U|xtnormtyp)
.type text xttmptelnr ? _F|defined(U|xttmptelnr)
..
.copy U|xbisnorm = G|FALSE
.assign U|xtnormtyp = U|XTNUM ? U|xtnormtyp <> U|XTNUM & U|xtnormtyp <> U|XTLETTER
.assign U|xttmptelnr = ""
..
.. contact is normalized while empty
.continue NORMEND ? F|empty(U|xttelnr)
.continue NUM ? U|xtnormtyp = U|XTNUM
.continue LETTER ? U|xtnormtyp = U|XTLETTER
.continue NORMEND
..
!NUM: remove all except latin numbers
.formula U|xttmptelnr = F|regreplaceall(U|xttelnr, "[^0-9]", "")
.continue NORMEND
..
!LETTER: remove all except latin numbers and characters
.formula U|xttmptelnr = F|regreplaceall(U|xttelnr, "[^0-9a-zA-Z]", "")
..
!NORMEND: configure output parameters
.copy U|xbisnorm = G|TRUE
.formula U|xttelnr = U|xttmptelnr
..*****************************************************************************
!END
.continue
