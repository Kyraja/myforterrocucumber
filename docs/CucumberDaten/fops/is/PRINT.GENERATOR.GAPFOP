..!interpreter english translate noabbrev
.continue DECL
..*****************************************************************************
.. FOP-Name       : PRINT.GENERATOR.GAPFOP
.. Autor          : lei
.. Verantwortlich : lei
.. Kontrolle      : mg
.. Funktion       :
..   Generator fuer die Ablaufplanfops zu einem Layout
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   P|aktslayout   Das Startlayout
..
.. Ablauf         :
..
..    Generiert Ablaufplanfops aus globalem Plan                *.GAP -> *.GAPFOP.*
..    verwendet PRINT.GENERATOR.LAPFOP fuer die lokalen Plaene  *.LAP -> *.LAPFOP
..
.. Die generierten FOPs erwarten eine bestimmte Umgebung.
.. Gestartet wird der globale Plan aus dem Druckdialog
.. die lokalen Plaene ueber dezidierte Knoepfe
..
.. Die Umgebung im P Puffer:
..   aktslayout:    Das Startlayout
..   akttmp:        Das tmp Verzeichnis
..   aktpfad:       Der aktuelle abstrakte Aufrufpfad
..   aktdaten:      Der aktuelle konkrete Pfad der Datendateien
.. die Ebene des Ablaufplanes ist implizit in die Plaene kodiert
..*****************************************************************************
.set trans -
..
!DECL
.type text xpunkt       ? _F|defined(U|xpunkt)
.type text xmarke       ? _F|defined(U|xmarke)
.type text xfrage       ? _F|defined(U|xfrage)
.type text xgfile       ? _F|defined(U|xgfile)
.type text xkenn        ? _F|defined(U|xkenn)
.type text xval         ? _F|defined(U|xval)
.type text xgapgenfop0  ? _F|defined(U|xgapgenfop0)
.type text xgapgenfop1  ? _F|defined(U|xgapgenfop1)
.type text xgapgenfop2  ? _F|defined(U|xgapgenfop2)
.type text xsys         ? _F|defined(U|xsys)
.type text xsel         ? _F|defined(U|xsel)
.type text xgenprefix   ? _F|defined(U|xgenprefix)
.type integer xgdesc    ? _F|defined(U|xgdesc)
.type integer xebene    ? _F|defined(U|xebene)
..
.assign U|xpunkt = "."
.assign U|xmarke = "!"
.assign U|xfrage = "?"
.assign U|xgenprefix = "gen/print/plan/"
.. PRINT.GENERATOR.GAPFOP
.. aktslayout: 'P|aktslayout'
.continue FEHL1 ? F|empty(P|aktslayout)
.assign U|xgfile = U|xgenprefix + P|aktslayout + ".GAP"
.input "DATEI.F"
.assign U|xgapgenfop0 = U|xgenprefix + P|aktslayout + ".GAPFOP.0"
.output new 'U|xgapgenfop0'
'U|xpunkt'.!interpreter english noabbrev
'U|xpunkt'. Generierter FOP: 'U|xgapgenfop0'
'U|xpunkt'.
.assign U|xgapgenfop1 = U|xgenprefix + P|aktslayout + ".GAPFOP.1"
.output new 'U|xgapgenfop1'
'U|xpunkt'.!interpreter english noabbrev
'U|xpunkt'. Generierter FOP: 'U|xgapgenfop1'
'U|xpunkt'assign P|aktpfad = P|aktslayout
.. hier fehlt die Behandlung eines Zeilenlayouts!
'U|xpunkt'. hier fehlt die Behandlung eines Zeilenlayouts!
'U|xpunkt'. assign P|aktdaten = P|aktdaten + ".0"
'U|xpunkt'input "is/PRINT.START.LAP"
'U|xpunkt'.
.assign U|xgapgenfop2 = U|xgenprefix + P|aktslayout + ".GAPFOP.2"
.output new 'U|xgapgenfop2'
'U|xpunkt'.!interpreter english noabbrev
'U|xpunkt'. Generierter FOP: 'U|xgapgenfop2'
'U|xpunkt'.
.file -open U|xgdesc 'U|xgfile'
..
!OPLAN
.file -read U|xgdesc U|xkenn # U|xval ^
.continue EPLAN ? _G|mehr
.continue CKENN ? U|xkenn = "C"
.continue EKENN ? U|xkenn = "E"
.continue GKENN ? U|xkenn = "G"
.continue RKENN ? U|xkenn = "R"
.continue LKENN ? U|xkenn = "L"
.continue FEHL2
..
!CKENN
'U|xpunkt'. Kommentar: 'U|xkenn' # 'U|xval'
.continue ENDKENN
..
!EKENN
'U|xpunkt'. Ebene: 'U|xkenn' # 'U|xval'
.assign U|xebene = U|xval
.continue EFEHL ? _G|mehr
.continue ENDKENN
..
!GKENN
'U|xpunkt'. Generator: 'U|xkenn' # 'U|xval'
'U|xpunkt'assign U|xkapebene = 'U|xval'
'U|xpunkt'input "is/PRINT.RUN.LEVEL"
.output addedto 'U|xgapgenfop0'
'U|xpunkt'output new 'G|apostroph'F|expr(P|akttmp + "KAP.'U|xval'")'G|apostroph'
.output addedto 'U|xgapgenfop2'
.continue ENDKENN
..
!RKENN
'U|xpunkt'. Renderer: 'U|xkenn' # 'U|xval'
'U|xpunkt'assign U|xrender = "renderplan " + P|akttmp + "RAP.'U|xval'"
.output addedto 'U|xgapgenfop0'
'U|xpunkt'output new 'G|apostroph'F|expr(P|akttmp + "RAP.'U|xval'")'G|apostroph'
.output addedto 'U|xgapgenfop2'
.continue ENDKENN
..
!LKENN
'U|xpunkt'. Datei: 'U|xkenn' # 'U|xval'
.assign P|aktpfad = U|xval
.input "is/PRINT.GENERATOR.LAPFOP"
.output addedto 'U|xgapgenfop2'
..
!ENDKENN
.continue OPLAN
..
!EPLAN
.file -close U|xgdesc
..*****************************************************************************
!END
.output terminal
.continue
..*****************************************************************************
..
!FEHL1
.error Startlayout fehlt
.end 1
..
!FEHL2
.error Falsches Kennzeichen 'U|xkenn' in 'U|xgfile'
.end 1
..
!EFEHL
.error Ebene ungueltig: 'U|xval'
.end 1
