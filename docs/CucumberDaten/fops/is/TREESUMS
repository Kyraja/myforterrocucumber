..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : TREESUMS
..  Datum          : 06.05.2005
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : tiwe
..  Funktion       : FOP zur Summenbildung in Infosystemen mit Baumstruktur
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xtvariables  Liste der Tabellenvariablen durch "#" getrennt (ohne Leerzeichen)
..
..  Ablauf         : 1) Es wird die maximale Tiefe bestimmt (xxmaxlevel)
..                   2) Die Zeilen des Infosystems werden xxmaxlevel-mal von unten
..                      nach oben durchlaufen wobei fÅr jede Stufe die Summen auf die
..                      nÑchsthîhere gezogen werden.
..
..  Functionality  : FOP for summing up variable values in a tree structure
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xtvariables  List of table variables separated by "#" (without spaces)
..
..  Program flow  :
... Includes      :
..
.. include SPLITSTR
..
..*****************************************************************************
.type text xtsplit    ? _F|defined(U|xtsplit)
.type integer  xxirow     ? _F|defined(U|xxirow)
.type integer  xxillevel  ? _F|defined(U|xxillevel)
.type text xxtvar     ? _F|defined(U|xxtvar)
.type integer  xxislevel  ? _F|defined(U|xxislevel)
.type integer  xxmaxlevel ? _F|defined(U|xxmaxlevel)
..*****************************************************************************
..
.set trans -
.continue END ?  G|evtartengl = "NO_EVENT"
.continue END ?  M|tzeilen <= 1
.continue END ? _F|defined(M|tbaumstufe)
.continue END ? _F|defined(U|xtvariables)
.continue END ? +'U|xtvariables' = 0
..
.formula U|xtsplit = U|xtvariables
..
.input "SPLITSTR"
..
.type integer xxarindex  ? _F|defined(U|xxarindex)
.formula U|xxarindex  = 1
.formula U|xxmaxlevel = 0
.formula U|xxislevel  = -1
.select screen header
..*****************************************************************************
!INITSUMS
..*****************************************************************************
.continue SETMAXLEVEL ? U|xxarindex > U|xispmax
..
.type real xxrtsum.xxarindex ? _F|defined(U|xxrtsum.U|xxarindex)
.formula U|xxrtsum.U|xxarindex = 0.00
.formula U|xxarindex = U|xxarindex + 1
.continue INITSUMS
..
..*****************************************************************************
!SETMAXLEVEL: Set maximum level in tree model
..*****************************************************************************
.select screen line
.continue LEVLOOP ? _G|mehr
.formula U|xxmaxlevel = M|tbaumstufe ? M|tbaumstufe > U|xxmaxlevel
.continue SETMAXLEVEL
..
..*****************************************************************************
!LEVLOOP:
..*****************************************************************************
.formula U|xxislevel   = U|xxmaxlevel + 1 ? U|xxislevel = -1
.formula U|xxislevel   = U|xxislevel  - 1 ? U|xxislevel >= 0
..
.formula U|xxirow      = M|tzeilen + 1
..
.continue END     ? U|xxislevel < 0
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xxarindex   = 1
.formula U|xxirow      = U|xxirow - 1
.continue LEVLOOP ? U|xxirow = 0
.select screen line 'U|xxirow'
.continue LOOP    ? M|tbaumstufe < (U|xxislevel - 1) ; M|tbaumstufe > U|xxislevel
.continue SUMUP   ? M|tbaumstufe =  U|xxislevel
.continue SETSUMS ? M|tbaumstufe = (U|xxislevel - 1)
..
..*****************************************************************************
!SETSUMS:
..*****************************************************************************
.continue REINIT  ? U|xxarindex > U|xispmax
.formula U|xxtvar = U|xasplit.U|xxarindex
.assign M|.U|xxtvar = U|xxrtsum.U|xxarindex
.formula U|xxarindex = U|xxarindex + 1
.continue SETSUMS
..
..*****************************************************************************
!REINIT: Reinit sums
..*****************************************************************************
.formula U|xxarindex   = 1
..
..*****************************************************************************
!RILOOP
..*****************************************************************************
.continue LOOP    ? U|xxarindex > U|xispmax
.formula U|xxrtsum.U|xxarindex = 0.00
.formula U|xxarindex = U|xxarindex + 1
.continue RILOOP
..
..*****************************************************************************
!SUMUP
..*****************************************************************************
.continue LOOP    ? U|xxarindex > U|xispmax
.formula U|xxtvar = U|xasplit.U|xxarindex
.formula U|xxrtsum.U|xxarindex = U|xxrtsum.U|xxarindex + M|.U|xxtvar
.formula U|xxarindex = U|xxarindex + 1
.continue SUMUP
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
