..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LDB.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Eingabeparameter und formuliert Datenbankanfrage.
.. Functionality  : Validates input parameters and builds DB query.
..*****************************************************************************
.set trans -
..
.continue ERROR1  ?  M|datnr = 127
.continue ERROR2  ? _M|erlaubt
..
.. Do we have a @noswd query?
.copy M|numsuch = _F|regmatch(M|select, "^[%$].*")
..
.. Do we have an illegal query?
.type VP99 xanything
.assign U|xanything = F|formatstr("$,,@numsuch={1};@datenbank={2};@lesen=(No)", M|select, M|grliste) ?  M|numsuch
.assign U|xanything = F|formatstr("{1};@datenbank={2};@lesen=(No)", M|select, M|grliste)             ? _M|numsuch
.continue ERROR3  ? _G|mehr
.continue CLRTAB  ? _M|numsuch
.assign M|select = F|formatstr("$,,@numsuch={1}", M|select)
..
!CLRTAB: Clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: No database selected
.error -line 0 -field M|dn -message Bitte zuerst eine Datenbank bestimmen!
.end 1
..
!ERROR2: Database is not allowed
.error -line 0 -field M|dn -message Die Datenbank 'M|dn' ist nicht erlaubt!
.end 1
..
!ERROR3: Illegal query
.cursor select 0
.. ERP core gives error message
.error
.end 1
