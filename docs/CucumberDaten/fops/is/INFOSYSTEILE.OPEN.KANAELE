..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.OPEN.KANAELE
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet einen Ordner der Schluesselart M|kanaele. Dieser
.. hat keinen oder viele Ausgabekanaele. Jeder Ausgabekanal ist ein Ordner.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens a node with a key of the type M|kanaele. This node
.. has none or many output channels. Each output channel is a node.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Do we have any channel?
.formula M|select = "$,,;such88=!;@gruppe=6;@ablageart=(Active)"
.formula M|select = M|select + ";aktiv=" + 'G|TRUE' ? M|nuraktive
.load 9 printparameter 'M|select'
..
!CHECK
.continue END ? _G|mehr
.assign M|kdatenobjekt = 9|id
..
.. Are there any layouts in this channel?
.formula M|select = "$,,;kontext==" + M|wurzel^id
.formula M|select = M|select + ";kanal==" + M|kdatenobjekt^id
.formula M|select = M|select + ";aktiv=" + 'G|TRUE' ? M|nuraktive
.formula M|select = M|select + ";@gruppe=3.8;@ablageart=(Active)"
.load 8 printparameter 'M|select'
..
!CHECK2
.continue NEXT1  ? _G|mehr
.continue SHOW  ? M|generierte
.continue PRINT ? 8|gruppe = 3
..
.. Parameter layout
.continue SHOW  ? _8|gendgfop
.continue NEXT2
..
!PRINT: Print layout
.continue SHOW  ? _(8|genlayout & 8|gendgfop)
..
!NEXT2
.load 8 printparameter
.continue CHECK2
..
!SHOW
.formula M|kbaumtext = '9|grbez'
.assign M|kbauminfo = 9|sucherw
.assign M|kname = 9|sucherw
.copy M|kschluessel = M|kanal
.assign M|kbaumstat = "+"
.assign M|kpaket = ""
.copy M|kaktiv = 9|aktiv
.copy M|kgeneriert = G|FALSE
.copy M|kexist = G|TRUE
.input 'M|tab' ? _F|empty(M|tab)
..
!NEXT1: Load next channel
.load 9 printparameter
.continue CHECK
..*****************************************************************************
!END
.continue
