..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.OPEN.LAYOUT
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet einen Ordner der Schluesselart M|layout. Dieser hat
.. keine oder maximal zwei Dateien als Elemente: die Layout-Datei und das Daten-
.. generierprogramm.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens a node with the key of the type M|layout. This has
.. none or at most two files as children: the layout file and the data generator
.. program.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.continue DATAGEN ? F|empty(M|kdatenobjekt^layname)
.continue DATAGEN ? _M|generierte & M|kdatenobjekt^genlayout
.copy M|kgeneriert = M|kdatenobjekt^genlayout
.assign M|kname = "win/" + M|kdatenobjekt^layname
.assign M|kname = "gen/" + M|kdatenobjekt^layname ? M|kgeneriert
.copy M|kexist = F|fileexists(M|kname)
.assign M|kbaumtext = "Layout-Datei"
.assign M|kbauminfo = 'M|kdatenobjekt^grbez'
.assign M|kbaumstat = ""
.assign M|kpaket = ""
.copy M|kaktiv = M|kdatenobjekt^aktiv
.input 'M|tab' ? _F|empty(M|tab)
..
!DATAGEN: Data generator
.continue END ? F|empty(M|kdatenobjekt^datagenfop)
.continue END ? _M|generierte & M|kdatenobjekt^gendgfop
.assign M|kname = M|kdatenobjekt^datagenfop
.copy M|kexist = F|fileexists(M|kname)
.assign M|kbaumtext = "Datengenerierprogramm"
.assign M|kbauminfo = 'M|kdatenobjekt^grbez'
.assign M|kbaumstat = ""
.assign M|kpaket = ""
.copy M|kaktiv = M|kdatenobjekt^aktiv
.copy M|kgeneriert = M|kdatenobjekt^gendgfop
.input 'M|tab' ? _F|empty(M|tab)
..*****************************************************************************
!END
.continue
