..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSDIFF.EV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : 
.. Funktion       : Behandelt Feld- und Zeilenereignisse einfacherer Funktion.
.. Ablauf         : Zentales EFOP
..
.. Functionality  : Central handling of field and row events with simple functions.
.. Program flow   : Central efop of the infosystem INFOSYSDIFF
...Includes       :
.. include is/INFOSYSDIFF.TBUDIFF.BN
..*****************************************************************************
.set trans -
..
..----------------------- Control header events -------------------------------
.continue ENTER   ? G|evtartengl = "SCREEN_ENTER"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "kopf"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "tabelle"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "addierte"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "vermisste"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "verschiedene"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "gleiche"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "sprneutral"
.continue SOURCE  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "soll"
.continue TARGET  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ist"
.continue LEVELS  ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "anzstufen"
..----------------------- Control table events --------------------------------
.continue FORBID  ? G|evtartengl = "ROW_MOVED_BEFORE"
..=============================================================================
.continue END
..
!ENTER: Enter mask and set defaults
.copy M|kopf = G|TRUE
.copy M|tabelle = G|TRUE
.copy M|addierte = G|TRUE
.copy M|vermisste = G|TRUE
.copy M|verschiedene = G|TRUE
.copy M|gleiche = G|FALSE
.copy M|sprneutral = G|FALSE
.assign M|diffprogname = "is/INFOSYSDIFF.TBUDIFF.BN"
.assign M|doctypedef = "is/infosysdiff_varnames.dtd"
.assign M|varnamen = "is/infosysdiff_varnames.xml"
.continue END
..
!SOURCE: Set name of the source
.copy M|stdsoll = M|soll^lieferumfang
.continue CLRTAB
..
!TARGET: Set name of the target
.copy M|stdist = M|ist^lieferumfang
.continue CLRTAB
..
!LEVELS: Check for valid number of levels
.continue ERROR1 ? M|anzstufen < 1
.continue CLRTAB
..
!FORBID: action is not allowed
.error
.end 1
..
!CLRTAB: clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -line 0 -field M|anzstufen -message Es wurde eine falsche Stufenzahl angegeben! Erlaubt sind Werte ab 1.
.end 1
