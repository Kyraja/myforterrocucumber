..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.OPEN.WURZEL
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet die Wurzel M|wurzel. Die Wurzel ist ein Infosystem.
.. Es hat mindestens einen aber maximal drei Knoten als Kinder: seinen Datensatz
.. und die Ausgabekan„le sowie die Aufrufparameter des Infosystems.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens the root M|wurzel. The root is an infosystem. It has
.. at least one but at most three nodes as children: its record and its output
.. channels as wellas its callparameters.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Programs and includes
.assign M|kbaumtext = G|kdatname13
.assign M|kbauminfo = "Dateien und Programme"
.assign M|kname = "Dateien und Programme"
.copy M|kschluessel = M|dateinamen
.assign M|kbaumstat = "+"
.assign M|kpaket = ""
.copy M|kaktiv = G|TRUE
.copy M|kgeneriert = G|FALSE
.copy M|kexist = G|TRUE
.input 'M|tab' ? _F|empty(M|tab)
..
.. Has root any output?
.continue PARAMS ? F|tostring(M|wurzel^layoutorigin, "AS168") = "(NoOutput)"
..
.. Create a node for any output channel
.formula M|select = "$,,;such88=!;@gruppe=6;@ablageart=(Active)"
.formula M|select = M|select + ";aktiv=" + 'G|TRUE' ? M|nuraktive
.load 8 printparameter 'M|select'
.continue PARAMS ? _G|mehr
..
.assign M|kbaumtext = G|kdatname88
.assign M|kbauminfo = "Ausgabekan„le"
.assign M|kname = "Ausgabekan„le"
.copy M|kschluessel = M|kanaele
.assign M|kbaumstat = "-"
.assign M|kdatenobjekt = "$,,;typ==(1);@ablageart=(Active);vdn==" + '8|dnr' + ";vgr==" + '8|gruppe' + ";@datenbank=12:26"
.copy M|kpaket = 8|paket
.copy M|kaktiv = 8|aktiv
.copy M|kgeneriert = G|FALSE
.copy M|kexist = G|TRUE
..
!LAYOUT: Are there any layout records in this channel?
.formula M|select = "$,,;kontext==" + M|wurzel^id
.formula M|select = M|select + ";aktiv=" + 'G|TRUE' ? M|nuraktive
.formula M|select = M|select + ";@gruppe=3.8;@ablageart=(Active)"
.load 9 printparameter 'M|select'
.continue NEXT2 ? _G|mehr
..
!CHECK: Are there any generated components in this layout record?
.continue ISNODE ? M|generierte
.continue PRINT  ? 9|gruppe = 3
..
.. Parameter layout
.continue ISNODE ? _9|gendgfop
.continue NEXT1
..
!PRINT: Print layout
.continue ISNODE ? _(9|genlayout & 9|gendgfop)
..
!NEXT1: Next layout record
.load 9 printparameter
.continue NEXT2 ? _G|mehr
.continue CHECK
..
!NEXT2: Next channel
.load 8 printparameter
.continue PARAMS ? _G|mehr
.continue LAYOUT
..
!ISNODE
.assign M|kbaumstat = "+"
.input 'M|tab' ? _F|empty(M|tab)
..
!PARAMS: Create a node for any callparameters
.formula M|select = "$,,;@ablageart=(Active);@gruppe=12;zeilentyp==(MenuItem);kopf^aufrktxt==" + M|wurzel^id
.formula M|select = M|select + ";aktiv==" + 'G|TRUE' ? M|nuraktive
.load 9 dataexport 'M|select'
.continue FOUND ? G|mehr
.formula M|select = "$,,;@ablageart=(Active);@gruppe=12;zeilentyp==(MenuItem);tzielobj==" + M|wurzel^id
.formula M|select = M|select + ";aktiv==" + 'G|TRUE' ? M|nuraktive
.load 9 dataexport 'M|select'
.continue END ? _G|mehr
..
!FOUND
.assign M|kdatenobjekt = "$,,;typ==(1);@ablageart=(Active);vdn==" + '9|dnr' + ";vgr==" + '9|gruppe' + ";@datenbank=12:26"
.formula M|kbaumtext = G|kdatname87
.assign M|kbauminfo = M|kdatenobjekt^vgrtxt
.assign M|kname = 'M|kdatenobjekt^vgrtxt
.copy M|kschluessel = M|aufrufparams
.assign M|kbaumstat = "+"
.copy M|kpaket = 9|paket
.copy M|kaktiv = 9|aktiv
.copy M|kgeneriert = G|FALSE
.copy M|kexist = G|TRUE
.input 'M|tab' ? _F|empty(M|tab)
..*****************************************************************************
!END
.continue
