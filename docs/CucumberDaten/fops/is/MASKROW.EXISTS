..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MASKROW.EXISTS
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : cl
.. Funktion       : Stellt fest, ob die Tabelle mindestens eine Zeile hat, die
..                  in "U|xfldname" den Wert "U|xmustvalue" besitzt. Der
..                  Vergleich erfolgt auf Textebene, wobei getrimmt wird. Feldname
..                  und -wert sind anfangs leer. Darum wird mit dem erfolgreichen
..                  Laden der 1. Zeile immer "wahr" geliefert. Ist der gegebene
..                  Feldname nicht definiert, wird stets "falsch" geliefert.
..                  U|xlimitrow -> Bis zu der Zeile inkl. suchen. Default alle.
.. Ablauf         : Unterprogramm
.. Functionality  : Returns if at least one table row with a field named
..                  "U|xfldname" and a value "U|xmustvalue" exists. The values
..                  are compared as trimed strings. The fieldname and the value
..                  are empty by default. Returns "true", if one such row exists.
..                  If the given fieldname is not defined, it will return "false".
..                  U|xlimitrow -> search to this row inkl. Default all rows.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xfldname   ? _F|defined(U|xfldname)
.type text xmustvalue ? _F|defined(U|xmustvalue)
.type bool xexists    ? _F|defined(U|xexists)
.type integer  xrowbefore ? _F|defined(U|xrowbefore)
.type integer  xlimitrow  ? _F|defined(U|xlimitrow)
..
.. Initializations
.copy U|xexists = G|FALSE
.copy U|xrowbefore = M|aktzeile
..
.. No table
.continue END ? _F|defined(M|tzeilen)
.. Empty table
.continue END ? F|empty(M|tzeilen)
.. No fieldname
.continue ERROR01 ? F|empty(U|xfldname)
.. Not defined
.select screen line 'M|tzeilen'
.continue RESET ? _F|defined(M|.U|xfldname)
.copy U|xlimitrow = M|tzeilen ? F|empty(U|xlimitrow)
..
.. Query table
.select screen line 'F|formatstr("$,,zn=!{1};{2}=={3}", U|xlimitrow, F|trim(U|xfldname), F|trim(U|xmustvalue))'
.continue RESET ? _G|mehr
..
!EXISTS
.copy U|xexists = G|TRUE
..
!RESET: Reset start position
.select screen line 'U|xrowbefore'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Fieldname is missing!
.error -message Es wurde kein Feldname angegeben!
.end 1
