..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DATEI.WAEHLEN
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Auswahl einer Datei aus einer durch das Muster beschriebenen
.. Liste im gegebenen Verzeichnis.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Choosing a file from a list which is defined by
.. the given directory and the matching pattern.
.. Program flow   : Subroutine
..*****************************************************************************
..
.set trans -
.. Declarations
.type text  xxzeile      ? _F|defined(U|xxzeile)
.type DVM2  xxtmpmenutxt ? _F|defined(U|xxtmpmenutxt)
.type DVM2  xxtmpmenu    ? _F|defined(U|xxtmpmenu)
.type text  xxmuster     ? _F|defined(U|xxmuster)
.type GL128 xxverz       ? _F|defined(U|xxverz)
..
.. Initialize
.assign U|xxverz = "."   ? F|empty(U|xxverz)
.assign U|xxmuster = "*" ? F|empty(U|xxmuster)
..
.file -tempname U|xxtmpmenutxt
.file -tempname U|xxtmpmenu
..
.. Checkings
.continue ERROR1 ? _F|isdir(U|xxverz)
..
.. Get menu text
.system 'F|formatstr("(cd {1};ls -1 {2}) >{3}", U|xxverz, U|xxmuster, U|xxtmpmenutxt)' background
.continue HINT1 ? _G|mehr
..
!TMPFOP: Create a temporary EFOP which generates a menu over all files
.output new 'U|xxtmpmenu'
.input "DATEI.F"
'G|interpreter'
:menu(0,0) 'U|xxverz'
..
!NEXTTXT
.select from 'U|xxtmpmenutxt' U|xxzeile^
.continue MENU ? _G|mehr
'U|xxzeile' >>'U|xxzeile'
.continue NEXTTXT
..
!MENU: Execute the generated menu
.output terminal
.input 'U|xxtmpmenu'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -message 'U|xxverz' ist kein Verzeichnis!
.end 1
..
!HINT1
.box 'U|xxverz'
Es wurden keine Dateien entsprechend dem Muster 'U|xxmuster' gefunden!
.continue END
