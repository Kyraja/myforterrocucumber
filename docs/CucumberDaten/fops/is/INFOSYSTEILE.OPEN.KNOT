..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.OPEN.KNOT
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet Ordner in Abhaengigkeit zum Schluessel M|kschluessel.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens nodes depending on the given key M|kschluessel.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Initializations
.formula M|stufe = M|tbaumstufe + 1
..
.. First level
.continue ROOT    ? M|tschluessel = M|infosys
.continue OUTPUT  ? M|tschluessel = M|kanaele
.continue PARAMS  ? M|tschluessel = M|aufrufparams
..
.. Second level
.continue FILES   ? M|tschluessel = M|dateinamen
.continue CHANNEL ? M|tschluessel = M|kanal
.continue CALLER  ? M|tschluessel = M|aufrufer
.continue TARGET  ? M|tschluessel = M|zielobjekt
..
.. Third level
.continue LAYOUT  ? M|tschluessel = M|layout
.continue FATAL
..
!ROOT: Element are nodes for files and programs, print and callparameters
.assign M|kdatenobjekt = M|wurzel
.input 'M|openwurzel' ? _F|empty(M|openwurzel)
.continue END
..
!OUTPUT: Elements are nodes for output channels
.input 'M|openkanaele' ? _F|empty(M|openkanaele)
.continue END
..
!PARAMS: Elements are nodes for callparameters
.input 'M|openaufparam' ? _F|empty(M|openaufparam)
.continue END
..*****************************************************************************
!FILES: Elements are leafs for files
.assign M|kdatenobjekt = M|wurzel
.input 'M|opendateien' ? _F|empty(M|opendateien)
.continue END
..
!CHANNEL: Elements are nodes for layout records
.copy M|kdatenobjekt = M|tdatenobjekt
.input 'M|openkanal' ? _F|empty(M|openkanal)
.continue END
..*****************************************************************************
!LAYOUT: Elements are leafs for layout and data generator file
.copy M|kdatenobjekt = M|tdatenobjekt
.input 'M|openlayout' ? _F|empty(M|openlayout)
.continue END
..
!CALLER: Elements are leafs for callparameters with the root as caller
.input 'M|openaufrufer' ? _F|empty(M|openaufrufer)
.continue END
..
!TARGET: Elements are leafs for callparameters with the root as target
.input 'M|openzielobj' ? _F|empty(M|openzielobj)
.continue END
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
