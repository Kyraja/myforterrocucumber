..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : XMLGEN.COMMON.HVARS
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : mg
.. Funktion       : Generiert die allgemein ueberall verfuegbaren Variablen
..                  in die XML-Ausgabedatei beim Drucken. Wird in den
..                  XML-Generatoren eingezogen.
..                  Individuelle Erweiterungen sind in de, Programm
..                  XMLGEN.COMMON.HVARS.CUSTOM moeglich.
..                  Dort werden sind dann zwei FO-Arrays zu belegen:
..                  1) xhname: Variablenname
..                  2) xhvalue: Variablenwert
..                  Die Array-Indizes muessen bei 1 beginnen.
..*****************************************************************************
..
.set trans -
              <Field name="datasource" abasType="'F|typeof(U|xxmldata)'">'U|xxmldata'</Field>
              <Field name="mandant" abasType="'F|typeof(G|mandant)'">'G|mandant'</Field>
.continue INFOSYS ? F|defined(M|isref)
.continue VARTAB  ? F|defined(M|such)
.continue SYSTEM
!INFOSYS
.. Infosystem-Variables
              <Field name="name" abasType="'F|typeof(M|isref^nameaspr)'">'M|isref^nameaspr'</Field>
              <Field name="arb" abasType="'F|typeof(M|arb)'">'M|arb'</Field>
              <Field name="such65" abasType="'F|typeof(M|such65)'">'M|such65'</Field>
              <Field name="tzeilen" abasType="'F|typeof(M|tzeilen)'">'M|tzeilen'</Field>
.continue SYSTEM
!VARTAB
.. Vartab-Variables
              <Field name="arb" abasType="'F|typeof(P|layout^arb)'">'P|layout^arb'</Field>
              <Field name="such" abasType="'F|typeof(M|such)'">'M|such'</Field>
.continue SYSTEM
!SYSTEM
.. System-Variables
              <Field name="user" abasType="'F|typeof(G|bzeichen)'">'G|bzeichen'</Field>
              <Field name="date" abasType="'F|typeof(G|datum)'" value="'G|datum(L="0")'">'G|datum'</Field>
              <Field name="time" abasType="'F|typeof(G|zeit)'" value="'G|zeit(L="0")'">'G|zeit'</Field>
              <Field name="page" abasType="'F|typeof(U|xpagename)'">'U|xpagename'</Field>
              <Field name="zn" abasType="'F|typeof(U|xindex)'" value="'U|xindex(L="0")'">'U|xindex'</Field>
.. company name
              <Field name="builtin_company_name1" abasType="'F|typeof(F|sysinfo(10)^knam1)'">'F|sysinfo(10)^knam1'</Field>
.. layout name
              <Field name="builtin_layout_name" abasType="'F|typeof(P|layout^nameaspr)'">'P|layout^nameaspr'</Field>
..
..
.. Individual common XML fields
..
..
.file -test "XMLGEN.COMMON.HVARS.CUSTOM"
.continue ? _G|mehr
.input "XMLGEN.COMMON.HVARS.CUSTOM"
..
.type integer xihvarindex     ? _F|defined(U|xihvarindex)
.type bool xbwithrawvalue ? _F|defined(U|xbwithrawvalue)
.formula U|xihvarindex = 0
..*****************************************************************************
!LOOP
..*****************************************************************************
.formula U|xihvarindex = U|xihvarindex + 1
.continue ? _F|defined(U|xhname.U|xihvarindex)
.continue ? _F|defined(U|xhvalue.U|xihvarindex)
.. raw value only if the type is a date, number or boolean
.copy U|xbwithrawvalue = F|regmatch(F|typeof(U|xhvalue.U|xihvarindex), "G[DWZ].*|R.*|M.*|B.*|I.*|D")
?             <Field name="'U|xhname.U|xihvarindex'" abasType="'F|typeof(U|xhvalue.U|xihvarindex)'" value="'U|xhvalue.xihvarindex(L="0")'">'U|xhvalue.U|xihvarindex'</Field>  ? U|xbwithrawvalue
?             <Field name="'U|xhname.U|xihvarindex'" abasType="'F|typeof(U|xhvalue.U|xihvarindex)'">'U|xhvalue.U|xihvarindex'</Field>  ? _U|xbwithrawvalue
.continue LOOP
