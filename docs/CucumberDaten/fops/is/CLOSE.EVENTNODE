..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : CLOSE.EVENTNODE
.. Autor         : fwester
.. Verantwortlich: cl
.. Kontrolle     : tiwe
.. Funktion      : Schliesst einen im Puffer M geladenen offenen Knoten
..                 und platziert abschliessend auf die Ausgangszeile.
.. Ablauf        : Unterprogramm
..
.. Functionality : Closes an open node that is loaded in buffer M and
..                 finally loads the node from its beginning.
.. Program flow  : Subroutine
..*****************************************************************************
.set trans -
..
.. do not execute while not used as mentioned above
.continue END ? _F|defined(M|tbaumaufzu)
..
.. declarations
.type integer  xevtlevel ? _F|defined(U|xevtlevel)
.type integer  xstartrow ? _F|defined(U|xstartrow)
..
.formula U|xstartrow = M|aktzeile
.formula U|xstartrow = G|evtzeile    ? G|evtzeile <> 0
.select screen line 'U|xstartrow'
.continue FATAL ? _G|mehr
..
!SUCCESS: load successor row
.formula U|xevtlevel = M|tbaumstufe
.select screen line
.continue MARK ? _G|mehr
..
!DELROW: delete successor row until we reach the same level
.continue MARK ? M|tbaumstufe <= U|xevtlevel
.make screen line -O
.continue DELROW
..
!MARK: mark row from which we started
.select screen line 'U|xstartrow'
.continue FATAL ? _G|mehr
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
