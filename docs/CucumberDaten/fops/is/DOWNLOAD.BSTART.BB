..!interpreter english translate noabbrev
..*****************************************************************************
.. Author         : male
.. Verantwortlich : tma
.. Kontrolle      : fwester
.. Functionality  : Start FOP of the Infosystem is/DOWNLOAD
..*****************************************************************************
..!meta M|=is/DOWNLOAD
.set trans -
..
.input "is/DOWNLOAD.INIT"
..
.continue END     ?  F|empty(M|filename)
..
.type text outfile command infile tmpfile
..
.continue XCOPY   ?  F|regmatch(M|filename, "^rmtmp/Xcopy_[0-9]{12,25}[.]TMP$")
.continue FOPMODE
..
..*****************************************************************************
!XCOPY
..*****************************************************************************
.. file names generated by .pc.copy 
.continue ERR01 ?  F|isdir(M|filename)
.continue ERR01 ? _F|fileexists(M|filename)
.continue ERR02 ? _F|filereadable(M|filename)
.continue ERR04 ?  F|strindex(M|filename, "/..") > 0
.continue ERR04 ?  F|strindex(M|filename, "../") > 0
.formula U|infile = M|filename
.continue START
..
..*****************************************************************************
!FOPMODE
..*****************************************************************************
.continue ERR04 ? _F|isfopname(M|filename)
.continue ERR01 ?  F|isdir(M|filename)
.continue ERR01 ? _F|fileexists(M|filename)
.continue ERR02 ? _F|filereadable(M|filename)
.continue ERR04 ?  F|strindex(M|filename, "/..") > 0
.continue ERR04 ?  F|strindex(M|filename, "../") > 0
.continue ERR04 ? _F|cmdpermitted(13, 13) & _F|regmatch(M|filename, "^rmtmp/.+")
.formula U|infile = F|foppath(M|filename)
.formula U|infile = M|filename ? F|empty(U|infile)
.continue START
..
..*****************************************************************************
!START
..*****************************************************************************
.formula M|origfilesize = F|filesize(U|infile)
.file -screen -tempname U|outfile
.formula U|command = 'F|formatstr(F|expr("base64+ < " + G|apostroph + "{1}" + G|apostroph + " > " + G|apostroph + "{2}" + G|apostroph), U|infile, U|outfile)'          ? _M|gzip
.formula U|command = 'F|formatstr(F|expr("gzip -c "+ G|apostroph + "{1}" + G|apostroph + " | base64+ > " + G|apostroph + "{2}" + G|apostroph), U|infile, U|outfile)' ?  M|gzip
.system 'U|command' background
.continue ERR03 ? _G|mehr
.formula M|resultbase64 = 'U|outfile'
.formula M|encfilesize = F|filesize(U|outfile)
.. detect MIME type
.file -screen -tempname U|tmpfile
.formula U|command = 'F|formatstr(F|expr("file -L -i " + G|apostroph + "{1}" + G|apostroph + " | tr " + G|apostroph  + ";" + G|apostroph + " " + G|apostroph + " " + G|apostroph + " | awk " + G|apostroph + "{print $2}" + G|apostroph + " > " + G|apostroph + "{2}" + G|apostroph), U|infile, U|tmpfile)' 
.system 'U|command' background
.continue OCTSTREAM ? _G|mehr
.select from 'U|tmpfile' M|mimetype
.continue OCTSTREAM ? F|empty(M|mimetype)
.continue AMIME1
..
..*****************************************************************************
!OCTSTREAM
..*****************************************************************************
.formula M|mimetype = "application/octet-stream"
.continue AMIME1
..
..*****************************************************************************
!AMIME1
..*****************************************************************************
.continue AMIME2 ? F|empty(M|fileext)
.load 0 object 'F|formatstr("$,@datei=136;@gruppe=4;dateierw={1};@zeile=(1)", M|fileext)'
.continue AMIME2 ? _G|mehr
..!meta 0|=P136:4
.assign M|abasmimetype = 0|id
.load 0 line
.continue END ? _G|mehr
.formula M|defaultfileext = 0|dateierw
.continue END
..
..*****************************************************************************
!AMIME2
..*****************************************************************************
.continue END ? F|empty(M|mimetype)
.load 0 object 'F|formatstr("$,@datei=136;@gruppe=4;mimetyp={1}", M|mimetype)'
.continue END ? _G|mehr
..!meta 0|=P136:4
.assign M|abasmimetype = 0|id
.load 0 line
.continue END ? _G|mehr
.formula M|defaultfileext = 0|dateierw
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.set trans +
.formula M|exitstatus = 1
.formula M|errormsg = 'F|formatstr("Die Datei {1} existiert nicht.", M|filename)'
.continue ERROR
..
..*****************************************************************************
!ERR02
..*****************************************************************************
.set trans +
.formula M|exitstatus = 2
.formula M|errormsg = 'F|formatstr("Die Datei {1} ist nicht lesbar.", M|filename)'
.continue ERROR
..
..*****************************************************************************
!ERR03
..*****************************************************************************
.set trans +
.formula M|exitstatus = 3
.formula M|errormsg = "Fehler bei der Konvertierung."
.continue ERROR
..
..*****************************************************************************
!ERR04
..*****************************************************************************
.set trans +
.formula M|exitstatus = 4
.formula M|errormsg = "Zugriff verweigert."
.continue ERROR
..
..*****************************************************************************
!ERROR
..*****************************************************************************
.continue END ? M|exitstatus = 0 ; M|normalexit
.error -message 'M|errormsg'
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
