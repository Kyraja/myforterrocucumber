..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BROWSER.GET.URL
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : lei
.. Funktion       : Liest die Elemente der URl aus der Konfiguration aus.
.. Functionality  : Reads elements of URL using configuration file.
..*****************************************************************************
.set trans -
..
.continue DEFAULT ? F|empty(M|mapping)
..
.. Declarations
.type text xindex ? _F|defined(U|xindex)
..
.add M|mapping
.continue DEFAULT ? _G|mehr
.copy M|verwaz = D|verwaz
.copy M|searchengine = F|equals(M|verwaz, "(SearchEngine)")
.continue DEFAULT ? _M|searchengine
..
.. Clear input data
.assign M|urlscheme = ""
.assign M|urlhost = ""
.assign M|urlport = ""
.assign M|urlpath = ""
.assign M|url = ""
.assign M|urlencoded = ""
..
.. Read configuration
.assign U|xindex  = M|mapping^nummer
.input "is/FOP.SUCHCONFIG"
.assign M|urlscheme = U|xurlproto
.assign M|urlhost = U|xurlhost
.assign M|urlport = U|xurlport
.assign M|url     = U|xurl
.. URL: add one time password
.formula M|url    = M|url + F|formatstr("#otp={1}", F|urlencode('G|einmalpw'))
.continue END     ? _M|doqueryevt
..
.. Set lucene query using event
.formula M|evtfokusfeldwert = "*" ? F|empty(M|evtfokusfeldwert)
.formula M|evtfokusfeldwert = F|urlencode('M|evtfokusfeldwert')
.formula M|url = M|url + F|formatstr("&query={1}", M|evtfokusfeldwert)
..
.. Set maximum hit number
.continue GROUPS ? F|empty(M|maxtreffer)
.formula M|url = M|url + F|formatstr("&max={1}", M|maxtreffer)
.continue END
..
!DEFAULT
.formula M|urlscheme = "http"
.formula M|urlport = 80
.formula M|urlhost = "www.abas.de"
.formula M|urlpath = ""
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR05: Missing focus data!
.error -line 0 -field M|evtfokusvar -message Es fehlt die Angabe des Fokusfeldes!
..
!BREAK
.end 1
