..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : XMLVALIDATOR
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Validiert das in den Array-Parametern gegebene XML-Dokument
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : ja
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   arg1         Pfad zur XML-Dokument
..   arg2         Pfad zum DTD
..
.. Ablauf         : Button-nach-EFOP des Feldes "dovalid" in Maske 813
..
.. Functionality  : Validates the XML document given as an array argument
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : yes
..
..   Argument     meaning
..   ---------------------------------------------------------
..   arg1         Path to the XML document
..   arg2         Path to DTD
..
.. Program flow  : Button after EFOP of the item "dovalid" in mask 813
..*****************************************************************************
.set trans -
..
.continue USAGE ? G|argc <> 3
..
.. Declarations
.type text xcmmd xout xruntimeenv xprogram xlist xdtd
.type text xlistop xdtdop xvalid
.type DVM2 xerror
..
.. Initializations
.file -tempname U|xerror
.formula U|xout = ">>" + U|xerror + " 2>>" + U|xerror
.assign U|xruntimeenv = "s3java.sh"
.assign U|xprogram = "de.abas.utils.xml.XmlValidator"
.formula U|xlistop = "-f"
.formula U|xlist = G|arg1
.set trans +
.formula U|xvalid = F|formatstr("Das Dokument {1} ist valide!", U|xlist)
.set trans -
.formula U|xlistop = U|xlistop + " " + U|xlist
.formula U|xdtdop = "-e"
.formula U|xdtd = G|arg2
.formula U|xdtdop = U|xdtdop + " " + U|xdtd
..
.. Build command for validation
.. s3java.sh de.abas.utils.xml.XmlValidator -f myfile.xml  -e myfile.dtd
.formula U|xcmmd = U|xruntimeenv
.formula U|xcmmd = U|xcmmd + " " + U|xprogram
.formula U|xcmmd = U|xcmmd + " " + U|xlistop
.formula U|xcmmd = U|xcmmd + " " + U|xdtdop
.formula U|xcmmd = U|xcmmd + " " + U|xout
..
!EXECUTE: execute system command
.system 'U|xcmmd' background
.continue ERROR1 ? _G|mehr
..
.. report
.box
'U|xvalid'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!USAGE
.set trans +
.output terminal
<'G|kdatname13'>'G|txname' arg1 arg2<'G|kaktname12'>
arg1 = Pfad zum XML-Dokument
arg2 = Pfad zur Dokumententypbeschreibung DTD
.set trans -
.error -message Das FOP 'G|txname' wurde falsch verwendet!
.end 1
..
!ERROR1
.output terminal
.. Convert error message charset
.system 'F|expr("s3_conv 11 " + U|xerror)' background
..
'U|xerror'
=================
.input -text 'U|xerror'
.error -message Das Dokument 'U|xlist' ist nicht valide!
.end 1
