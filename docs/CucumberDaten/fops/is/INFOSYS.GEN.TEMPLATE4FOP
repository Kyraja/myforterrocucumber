..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INFOSYS.GEN.TEMPLATE4FOP
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Ersetzt die Platzhalter aus der Vorlage mit den Werten.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Replaces placeholder in the template with values.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xline xescape xprogvers xknam
.type text XXFILE XXDATE XXVERSION XXUSER XXYEAR XXCOMPANY XXPACKAGE
.type J4   xyear
..
.. Initializations of search patterns for place holders
.formula U|xescape = "%"
.formula U|XXFILE    = U|xescape + "FILE" + U|xescape
.formula U|XXDATE    = U|xescape + "DATE" + U|xescape
.formula U|XXVERSION = U|xescape + "VERSION" + U|xescape
.formula U|XXUSER    = U|xescape + "USER" + U|xescape
.formula U|XXYEAR    = U|xescape + "YEAR" + U|xescape
.formula U|XXCOMPANY = U|xescape + "COMPANY" + U|xescape
.formula U|XXPACKAGE = U|xescape + "PACKAGE" + U|xescape
..
.. Replace place holders in each line of the template and write in her in a temporary file
.. FILE DATE VERSION USER YEAR COMPANY PACKAGE
.file -tempname U|xtemplatefile
.input "DATEI.F"
.output new 'U|xtemplatefile'
..
!NEXT
.select from 'U|XFOPTEMPLATE' U|xline^
.continue END ? _G|mehr
.continue FILE    ? F|regmatch(U|xline, F|expr(".*" + U|XXFILE + ".*"))
!BACK1
.continue DATE    ? F|regmatch(U|xline, F|expr(".*" + U|XXDATE + ".*"))
!BACK2
.continue VERSION ? F|regmatch(U|xline, F|expr(".*" + U|XXVERSION + ".*"))
!BACK3
.continue USER    ? F|regmatch(U|xline, F|expr(".*" + U|XXUSER + ".*"))
!BACK4
.continue YEAR    ? F|regmatch(U|xline, F|expr(".*" + U|XXYEAR + ".*"))
!BACK5
.continue COMPANY ? F|regmatch(U|xline, F|expr(".*" + U|XXCOMPANY + ".*"))
!BACK6
.continue PACKAGE ? F|regmatch(U|xline, F|expr(".*" + U|XXPACKAGE + ".*"))
!BACK7
'U|xline'
.continue NEXT
..
!FILE
.formula U|xline = F|regreplaceall(U|xline, U|XXFILE, U|xbasename)
.continue BACK1
..
!DATE
.formula U|xline = F|regreplaceall(U|xline, U|XXDATE, F|tostring(G|datum))
.continue BACK2
..
!VERSION
.formula U|xprogvers = G|progvers >> " "
.formula U|xprogvers = U|xprogvers >> " "
.formula U|xprogvers = U|xprogvers << " "
.formula U|xline = F|regreplaceall(U|xline, U|XXVERSION, U|xprogvers)
.continue BACK3
..
!USER
.formula U|xline = F|regreplaceall(U|xline, U|XXUSER, G|bzeichen)
.continue BACK4
..
!YEAR
.assign U|xyear = G|datum
.formula U|xline = F|regreplaceall(U|xline, U|XXYEAR, F|tostring(U|xyear))
.continue BACK5
..
!COMPANY
.formula U|xknam = F|sysinfo(10)^knam1
.formula U|xline = F|regreplaceall(U|xline, U|XXCOMPANY, U|xknam)
.continue BACK6
..
!PACKAGE
.formula U|xline = F|regreplaceall(U|xline, U|XXPACKAGE, U|xworkspace)
.continue BACK7
..*****************************************************************************
!END
.output
.continue
