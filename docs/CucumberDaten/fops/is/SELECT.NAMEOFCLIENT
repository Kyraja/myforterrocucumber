..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SELECT.NAMEOFCLIENT
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : xclient - Liefert den selektierten Mandantennamen.
.. Functionality  : xclient - Returns the selected client name.
.. Program flow   : Defines and presents a menu with client names and returns
.. the selected client name or an empty string in the parameter named xclient.
..*****************************************************************************
.set trans -
..
.. ACHTUNG: Notloesung, bis es entweder eine AZ oder verwendbare Datenobjekte
.. fuer die Mandanten gibt.
..
.. GUI or ASCII interface neccessary
.continue END ? G|edp
..
.. Declarations
.type GL1  XPOINT      ? _F|defined(U|XPOINT)
.type text xtitle      ? _F|defined(U|xtitle)
.type text xline       ? _F|defined(U|xline)
.type text xclient     ? _F|defined(U|xclient)
.type integer  xdesk       ? _F|defined(U|xdesk)
.type DVM2 xstdout     ? _F|defined(U|xstdout)
.type DVM2 xtmpfile    ? _F|defined(U|xtmpfile)
.type text xcommand    ? _F|defined(U|xcommand)
.type bool xbackground ? _F|defined(U|xbackground)
..
.. Initializations
.file -tempname U|xtmpfile
.file -tempname U|xstdout
.assign U|xcommand = "envmake -X -q MANDANT"
.copy U|xbackground = G|TRUE
.assign U|XPOINT = "."
.assign U|xline = ""
.assign U|xclient = ""
.atext -language 'G|bsprache' U|xtitle 9190
..
.input "is/FO.SYSTEM"
.continue DEFMENU ? F|filenotempty(U|xstdout)
.continue END
..
!DEFMENU: Define a menu
.input "DATEI.F"
.output new 'U|xtmpfile'
'U|XPOINT'.!interpreter german translate noabbrev
'U|XPOINT'menu(0,0) 'G|APOSTROPH'U|xtitle'G|APOSTROPH'
.output terminal
..
.file -open U|xdesk 'U|xstdout'
.continue ERROR01 ? _G|mehr
..
!WHILE
.file -read U|xdesk U|xline^
.continue ENDMENU ? _G|mehr
.output addedto 'U|xtmpfile'
?'F|substr(U|xline, 1, F|typelength(F|typeof(G|mandant)))' >> 'F|substr(U|xline, 1, F|typelength(F|typeof(G|mandant)))'
.continue WHILE
..
!ENDMENU: Empty row is on purpose
?
'U|XPOINT'.
..
!EXECUTE
.input 'U|xtmpfile'
.continue END ? F|empty(G|menue)
.assign U|xclient = G|mentxt
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: File could not be opened
.error -message Die Datei 'U|xstdout' kann nicht zum Lesen ge”ffnet werden!
.end 1
