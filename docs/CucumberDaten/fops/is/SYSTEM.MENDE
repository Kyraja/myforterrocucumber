..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SYSTEM.MENDE
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Nacharbeiten bei Dateiausgaben erledigen.
.. Functionality  : Do some Reworking because of the file output.
..*****************************************************************************
.set trans -
..
.continue END ? F|empty(M|standardout) & F|empty(M|standarderr)
.continue END ? _M|rmstandardout & _M|rmstandarderr
..
.. Declarations
.type text xcommand
.type bool xbackground
.type DVM2 xstdout xstderr
..
!STDOUT: Handle standard output filename
.continue STDERR ? F|empty(M|standardout)
.continue END    ? _M|rmstandardout
.continue END    ? M|standardout = M|defnameout
.copy U|xcommand = "rm -f " + M|standardout
.copy U|xbackground = G|TRUE
.copy U|xstdout = M|defnameout
.copy U|xstderr = M|defnameerr
..
.input "is/FO.SYSTEM"
..
!STDERR: Handle standard error filename
.continue END ? F|empty(M|standarderr)
.continue END ? _M|rmstandarderr
.continue END ? M|standarderr = M|defnameerr
.copy U|xcommand = "rm -f " + M|standarderr
.copy U|xbackground = G|TRUE
.copy U|xstdout = M|defnameout
.copy U|xstderr = M|defnameerr
..
.input "is/FO.SYSTEM"
..*****************************************************************************
!END
.continue
