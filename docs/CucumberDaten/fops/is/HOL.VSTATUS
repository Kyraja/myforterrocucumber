..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : HOL.VSTATUS
.. Datum          : 21.05.03
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Verwendungen fÅr eine Beschaffung einstufig holen.
..                  Uebergang von der selektierten RES zur zugehoerigen ABPO/FV
.. Ablauf         : HOL-EFOP
..
.. Includes       :
.. include la/BVSTATUS.FA
..*********************************************************************************
.set trans -
..
.type bool xverkauf ? _F|defined(U|xverkauf)
..
.input "is/TABLEEREN"
..
.continue ERROR1     ?  F|empty(M|kart)
.continue ERROR1     ?  F|empty(M|select)
..
.input "la/BVSTATUS.FA"
.select purchasing 'M|select'
.continue ERROR2 ? _G|mehr
..
.formula M|stufe = 0
.input 'M|bkopf' ? _F|empty(M|bkopf)
.continue HOL0       ? H|typ <> G|RESERV
.formula M|stufe = 1
.select add H|vor
..
!HOL0:
.continue MTAB ? H|typ = G|FEVOR ; H|typ = G|ARPOS
.continue ERROR3
..
!MTAB: Tabellen-EFOP aufrufen
.input 'M|tab' ? _F|empty(M|tab)
..
.. Berichtsfuss-EFOP aufrufen
.input 'M|bfuss' ? _F|empty(M|bfuss)
..*********************************************************************************
!END
.continue
..*********************************************************************************
..
!ERROR1: Document missed!
.error -line 0 -field M|kart -message Bitte zuerst einen Vorgang auswÑhlen.
.end 1
..
!ERROR2: Loading document failed!
.error -message Der ausgewÑhlte Vorgang wurde inzwischen gelîscht. Bitte Auswahl wiederholen.
.end 1
..
!ERROR3: No status of use found!
.error -message Zu diesem Vorgang gibt es keinen Verwendungsstatus.
.end 1
