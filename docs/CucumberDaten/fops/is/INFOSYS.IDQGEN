..!interpreter english translate noabbrev
.. ****************************************************************************
.. FOP-Name       : INFOSYS.IDQGEN
.. Autor          : mg
.. Verantwortlich : mg
.. Kontrolle      : fwester
.. Funktion       : Dies ist ein Generator-FOP. Es erstellt ein FOP, das
..                  aus einem Infosystem heraus eine IDQ-Datei erstellt.
..
.. ****************************************************************************
..
.. Aufruf-Parameter fr diese Datei:
.. =================================
..
.. xidqgenfop: šbergabeparameter in dem Name und Verzeichnis des zu
..             generierenden FOPs angegeben ist.
.. xovrfile:   šbergabeparameter in dem der Name der sp„teren OVR-Datei
..             angegeben ist.
.. xidqfile:   šbergabeparameter in dem der Name der sp„teren IDQ-Datei
..             angegeben ist.
.. ****************************************************************************
.set trans -
..
.input "DATEI.F"
..
.type text xisnum     ? _F|defined(U|xisnum)
.type text xtc0       ? _F|defined(U|xtc0)
.type text xtc1       ? _F|defined(U|xtc1)
.type text xtc2       ? _F|defined(U|xtc2)
.type text xtc3       ? _F|defined(U|xtc3)
.type text xtmpname   ? _F|defined(U|xtmpname)
.type text xoutname   ? _F|defined(U|xoutname)
.type text xleer      ? _F|defined(U|xleer)
.type text xdata      ? _F|defined(U|xdata)
.type text xprn       ? _F|defined(U|xprn)
.type text xcopy      ? _F|defined(U|xcopy)
.type text xkommenta  ? _F|defined(U|xkommenta)
.type text xkommentb  ? _F|defined(U|xkommentb)
.type text xkommentc  ? _F|defined(U|xkommentc)
.type text xkomments  ? _F|defined(U|xkomments)
.type text xzeile     ? _F|defined(U|xzeile)
.type text xuebers    ? _F|defined(U|xuebers)
.type text xkopfteil  ? _F|defined(U|xkopfteil)
.type text xtabkopf   ? _F|defined(U|xtabkopf)
.type text xvarzeile  ? _F|defined(U|xvarzeile)
.type text xpunkt     ? _F|defined(U|xpunkt)
.type text xcomment   ? _F|defined(U|xcomment)
.type integer xzlaenge    ? _F|defined(U|xzlaenge)
.type integer xmaxzlaenge ? _F|defined(U|xmaxzlaenge)
..
.formula U|xleer = " "
.formula U|xpunkt = "."
.formula U|xcomment = U|xpunkt + U|xpunkt
.. Maximale Zeilenlaenge fuer die Ausgabe von Variablendefinitionen im Datenegenrator-FOP
.formula U|xmaxzlaenge = 2000
..
.continue ISINFOSYS ?_F|defined(M|kontext)
.continue ISINFOSYS ?_F|defined(M|kontext^num65)
.formula U|xisnum = M|kontext^num65
!ISINFOSYS
.formula U|xisnum = M|num65 ? F|defined(M|num65) & F|empty(U|xisnum)
.select infosystem 'U|xisnum'
.end 1 ? _G|mehr
..
.formula U|xkomments = "*******************************************************************************************"
.set trans +
.formula U|xkommenta = "Programm: " + ('U|xidqgenfop' >$ "/")
.formula U|xkommentb = "Funktion: Dies ist ein generiertes FOP mit dem IDQ-Datendateien erstellt werden."
.formula U|xkommentc = "Generiert am: " + 'G|datum' + "  " + "um: " + 'G|zeit' + "  " + "von: " + 'G|bzeichen'
.set trans -
..
..
.output new 'U|xidqgenfop'
..
..
'U|xcomment'!interpreter english noabbrev
'U|xcomment' 'U|xkomments'
'U|xcomment' 'U|xkommenta'
'U|xcomment' 'U|xkommentb'
'U|xcomment' 'U|xkommentc'
'U|xcomment' 'U|xkomments'
'U|xcomment'
'U|xpunkt'set trans -
'U|xpunkt'input "DATEI.F"
..
'U|xpunkt'set languagesetting "P"
..
..
.. ---------------------------------------------------------------------------
.. Name der Ausgabedatei (IDQ-Generatorfop) zusammenbauen
.. ---------------------------------------------------------------------------
'U|xpunkt'type text xoutfile  ? _F|defined(U|xoutfile)
'U|xpunkt'type text xmyovr    ? _F|defined(U|xmyovr)
'U|xpunkt'type text xmyidq    ? _F|defined(U|xmyidq)
'U|xpunkt'type text xzeile    ? _F|defined(U|xzeile)
'U|xpunkt'type text xtc1      ? _F|defined(U|xtc1)
'U|xpunkt'type text xtpage    ? _F|defined(U|xtpage)
'U|xpunkt'type text xtname    ? _F|defined(U|xtname)
'U|xpunkt'type text xmycopies ? _F|defined(U|xmycopies)
'U|xpunkt'type text xmyprname ? _F|defined(U|xmyprname)
.formula U|xtc0 = "'" + "U|xmyidq" + "'"
.formula U|xtc3 = "'" + "U|xmyovr" + "'"
.formula U|xdata= "'" + "U|xovrfile" + "'" + " ? F|defined(U|xovrfile)"
.formula U|xprn = "'" + "U|xmyprname" + "'"
.formula U|xcopy= "'" + "U|xmycopies" + "'"
'U|xpunkt'formula U|xmyovr = "'U|xovrfile'"
'U|xpunkt'formula U|xmyovr = 'U|xdata'
'U|xpunkt'formula U|xmyidq = -("USER" + 'G|apostroph'G|panummer'G|apostroph' + "'U|xidqfile'")
'U|xpunkt'formula U|xidqtempfile = 'G|apostroph'U|xmyidq'G|apostroph'
'U|xpunkt'formula U|xoutfile = "rmtmp/" + 'U|xtc0'
.formula U|xoutname = "'" + "xoutfile" + "'"
..
..
'U|xpunkt'output new 'U|xoutname'
..
..
.. ---------------------------------------------------------------------------
.. Dateiname der zugeh”rigen ovr-Datei
.. ---------------------------------------------------------------------------
'U|xcomment' ========================================================
'U|xcomment' Main definition for data-file
'U|xcomment' ========================================================
IDQ|'U|xtc3'|'U|xcopy'|'U|xprn'|
..
..
.. ---------------------------------------------------------------------------
.. Header fr den Datenbereich S (Pageheader) erstellen
.. ---------------------------------------------------------------------------
.select header
'U|xcomment' ========================================================
'U|xcomment' Variable identifier
'U|xcomment' ========================================================
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Static Data for Page-Header
'U|xcomment' --------------------------------------------------------
..
..
.. -text "value" should not be empty!
'U|xpunkt'text U|xtpage 'G|apostroph'P|spr'G|apostroph' Seite
'U|xpunkt'formula U|xtname = 'G|apostroph'M|isref^nameaspr'G|apostroph'
..
.formula U|xzeile="S|Pageheader|bzeich|name|datum|uhrzeit|bereich|txtpage|"
'U|xzeile'
..
.. ---------------------------------------------------------------------------
.. Anforderungstexte fuer Kopf und Tabelle einziehen
.. ---------------------------------------------------------------------------
'U|xpunkt'input 'G|apostroph'M|isref^transfop'G|apostroph'
..
..
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Static Data for Mask-Header
'U|xcomment' --------------------------------------------------------
..
..
.formula U|xzeile    = "K|Maskhead|"
!KMVAUSGABE
.select line
.continue KMVTEILENDE ? _G|mehr
.formula U|xtmpname  = F|substr(H|vname, 3,)
.formula U|xzeile    = 'U|xzeile' + "txt" + 'U|xtmpname' + "|" + 'U|xtmpname' + "|" ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|indaten)
..
.. xzeile darf nicht laenger als 3000 Zeichen werden!
.formula U|xzlaenge = +U|xzeile
.formula U|xzeile   = U|xzeile + "\" ? (U|xzlaenge > U|xmaxzlaenge)
?'U|xzeile' ? (U|xzlaenge > U|xmaxzlaenge)
.formula U|xzeile   = "" ? (U|xzlaenge > U|xmaxzlaenge)
.continue KMVAUSGABE
..
!KMVTEILENDE
?'U|xzeile' ? _F|empty(U|xzeile)
..
.. ---------------------------------------------------------------------------
.. Header fr den Datenbereich TK (Kopfteil der Tabelle) erstellen
.. ---------------------------------------------------------------------------
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Static Data for Table-Header
'U|xcomment' --------------------------------------------------------
..
.formula U|xzeile   = "TK|Tablehead|"
!TKVAUSGABE
.select line
.continue TKVTEILENDE ? _G|mehr
.formula U|xtmpname = F|substr(H|vname, 3,)
.formula U|xzeile   = 'U|xzeile' + "txt" + 'U|xtmpname' + "|" ? (H|vkt & _(H|vitbezf/"BU*") & H|indaten)
..
.. xzeile darf nicht laenger als 3000 Zeichen werden!
.formula U|xzlaenge = +U|xzeile
.formula U|xzeile   = U|xzeile + "\" ? (U|xzlaenge > U|xmaxzlaenge)
?'U|xzeile' ? (U|xzlaenge > U|xmaxzlaenge)
.formula U|xzeile   = "" ? (U|xzlaenge > U|xmaxzlaenge)
.continue TKVAUSGABE
..
!TKVTEILENDE
?'U|xzeile' ? _F|empty(U|xzeile)
..
..
.. ---------------------------------------------------------------------------
.. Header fr den Datenbereich TT (Tabellenteil der Tabelle) erstellen
.. ---------------------------------------------------------------------------
.select header
.formula U|xzeile = "TT|Tablebody|"
!TTAUSGABE
.select line
.continue TTTEILENDE ? _G|mehr
.formula U|xtmpname  = F|substr(H|vname, 3,)
.formula U|xzeile    = 'U|xzeile' + 'U|xtmpname' + "|" ? (H|vkt & _(H|vitbezf/"BU*") & H|indaten)
..
.. xzeile darf nicht laenger als 3000 Zeichen werden!
.formula U|xzlaenge = +U|xzeile
.formula U|xzeile   = U|xzeile + "\" ? (U|xzlaenge > U|xmaxzlaenge)
?'U|xzeile' ? (U|xzlaenge > U|xmaxzlaenge)
.formula U|xzeile   = "" ? (U|xzlaenge > U|xmaxzlaenge)
.continue TTAUSGABE
..
!TTTEILENDE
?'U|xzeile' ? _F|empty(U|xzeile)
..
..
.select header
..
..
'U|xcomment' ========================================================
'U|xcomment' ATTENTION!! Empty row!
.. ---------------------------------------------------------------------------
.. Leerzeile zwischen Kopf- und Datenteil in der IDQ-Datei
.. ---------------------------------------------------------------------------
'U|xleer'
'U|xcomment' ========================================================
'U|xcomment'
'U|xcomment'
'U|xcomment' ========================================================
'U|xcomment' Data-section
'U|xcomment' ========================================================
..
.. ---------------------------------------------------------------------------
.. Datenbereich S (Seitenkopf)
.. ---------------------------------------------------------------------------
.formula U|xzeile = "S|'G|bzeichen'|'U|xtname'|'G|datum'|'G|zeit'|"+ 'H|arb' + "/" + 'H|such' + "|'U|xtpage'|"
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Page-Header
'U|xcomment' --------------------------------------------------------
'U|xzeile'
..
..
.. ---------------------------------------------------------------------------
.. Datenbereich K (Kopfteil der Maske)
.. ---------------------------------------------------------------------------
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Mask-Header
'U|xcomment' --------------------------------------------------------
.formula U|xkopfteil = "K|"
!KMDAUSGABE
.select line
.continue KMDTEILENDE ? _G|mehr
.continue KMDZEILE ? _F|empty(H|extbezds)
.continue KMDZEILE ? _F|empty(H|vbedds)
.continue KMDAUSGABE
!KMDZEILE
.formula U|xtmpname  = F|substr(H|vname, 3,)
.formula U|xkopfteil = 'U|xkopfteil' + "'U|xt" + 'U|xtmpname' + "'|'M|" + 'U|xtmpname' + "'|" ? (_(H|vkt) & _(H|vitbezf/"BU*") & H|indaten)
..
.. xkopfteil darf nicht laenger als 3000 Zeichen werden!
.formula U|xzlaenge = +U|xkopfteil
.formula U|xkopfteil   = U|xkopfteil + "\" ? (U|xzlaenge > U|xmaxzlaenge)
?'U|xkopfteil' ? (U|xzlaenge > U|xmaxzlaenge)
.formula U|xkopfteil   = "" ? (U|xzlaenge > U|xmaxzlaenge)
.continue KMDAUSGABE
..
!KMDTEILENDE
?'U|xkopfteil' ? _F|empty(U|xkopfteil)
..
..
.. ---------------------------------------------------------------------------
.. Datenbereich TK (Kopfteil der Tabelle)
.. ---------------------------------------------------------------------------
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Table-Header
'U|xcomment' --------------------------------------------------------
.formula U|xtabkopf = "TK|"
!TKDAUSGABE
.select line
.continue TKDTEILENDE ? _G|mehr
.continue TKDZEILE ? _F|empty(H|extbezds)
.continue TKDZEILE ? _F|empty(H|vbedds)
.continue TKDAUSGABE
!TKDZEILE
.formula U|xtmpname = F|substr(H|vname, 3,)
.formula U|xtabkopf = 'U|xtabkopf' + "'U|xt" + 'U|xtmpname' + "'|" ? (H|vkt & _(H|vitbezf/"BU*") & H|indaten)
..
.. xtabkopf darf nicht laenger als 3000 Zeichen werden!
.formula U|xzlaenge = +U|xtabkopf
.formula U|xtabkopf   = U|xtabkopf + "\" ? (U|xzlaenge > U|xmaxzlaenge)
?'U|xtabkopf' ? (U|xzlaenge > U|xmaxzlaenge)
.formula U|xtabkopf   = "" ? (U|xzlaenge > U|xmaxzlaenge)
.continue TKDAUSGABE
..
!TKDTEILENDE
?'U|xtabkopf' ? _F|empty(U|xtabkopf)
..
..
.. ---------------------------------------------------------------------------
.. Datenbereich TT (Tabellenteil der Tabelle)
.. ---------------------------------------------------------------------------
.formula U|xzeile    = ".continue TTEILENDE ? _G|mehr"
..
'U|xcomment' --------------------------------------------------------
'U|xcomment'   Table-Data
'U|xcomment' --------------------------------------------------------
'U|xpunkt'select screen header
?!TTAUSGABE
'U|xpunkt'select screen line
'U|xzeile'
..
.select header
.formula U|xvarzeile = "TT|"
!TTDAUSGABE
.select line
.continue TTDTEILENDE ? _G|mehr
.formula U|xtmpname  = F|substr(H|vname, 3,)
.formula U|xvarzeile = 'U|xvarzeile' + "'M|" + 'U|xtmpname' + "'|" ? (H|vkt & _(H|vitbezf/"BU*") & H|indaten)
..
.. xvarzeile darf nicht laenger als 3000 Zeichen werden!
.formula U|xzlaenge = +U|xvarzeile
.formula U|xvarzeile   = U|xvarzeile + "\" ? (U|xzlaenge > U|xmaxzlaenge)
?'U|xvarzeile' ? (U|xzlaenge > U|xmaxzlaenge)
.formula U|xvarzeile   = "" ? (U|xzlaenge > U|xmaxzlaenge)
..
.continue TTDAUSGABE
!TTDTEILENDE
?'U|xvarzeile' ? _F|empty(U|xvarzeile)
..
'U|xpunkt'continue TTAUSGABE
?!TTEILENDE
'U|xpunkt'set languagesetting "T"
..
..
.. ---------------------------------------------------------------------------
.. Zeichensatz von s3 nach ISO 8859-1 konvertieren.
.. Hier auf keinen Fall UTF8 erstellen, weil OnlineView damit nicht umgehen
.. kann und der XML-Umsetzer davon ausgeht das die IDQ-Daten im ISO-Format
.. vorliegen!!
.. ---------------------------------------------------------------------------
'U|xcomment' ========================================================
'U|xcomment' In case of OnlineView translate and copy data-file
'U|xcomment' ========================================================
'U|xcomment' We have to flush the file
'U|xpunkt'output new "WERF.WEG"
.formula U|xzeile=".continue END ? F|defined(U|xoutkanal)"
'U|xzeile'
'U|xpunkt'formula U|xtc1 = "s3_conv 11 rmtmp/" + 'U|xtc0'
.formula U|xtc2 = "'U|"+"xtc1"+"'"
'U|xpunkt'system 'U|xtc2' background
..
..
.. ---------------------------------------------------------------------------
.. Die generierte IDQ-Datei vom tmp-Verzeichnis nach win/ovw verschieben.
.. ---------------------------------------------------------------------------
'U|xpunkt'output new "WERF.WEG"
'U|xpunkt'formula U|xtc1 = "mv -f rmtmp/" + 'U|xtc0' + " win/ovw/" + 'U|xtc0'
.formula U|xtc2 = "'U|" + "xtc1" + "'"
'U|xpunkt'system 'U|xtc2' background
..
..
.. ---------------------------------------------------------------------------
.. Ende
.. ---------------------------------------------------------------------------
?!END
.continue
..
