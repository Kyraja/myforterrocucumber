..!interpreter english translate noabbrev
.. ****************************************************************************
.. FOP-Name       : is/FONTSEARCH
.. Autor          : mg
.. Verantwortlich : TeamReport
.. Kontrolle      : mg
.. Funktion       : Fop mit dem die Array-Variablen xfont und xsize
..                  durchsucht werden. Wenn der entsprechende Font gefunden
..                  wurde werden die Variablen xxfontfaktor und xyfontfaktor
..                  auf den ermittelten Wert gesetzt.
..                  Konnte kein Font gefunden werden, dann wird ein
..                  Standard-Font benutzt.
.. ****************************************************************************
..
.set trans -
..
.type integer i
..
.formula U|i = 0
..
!SEARCH
.continue FOUND ? ((U|xfont.U|i = U|xfontname) & (U|xsize.U|i = U|xfontsize))
.formula U|i =U|i + 1
.continue SEARCH ? U|i < U|xmaxfont
..
.formula U|xfontname = "Arial"
.formula U|xfontsize = 7
.formula U|xxfontfaktor = 16
.formula U|xyfontfaktor = 18
.formula U|xstandard = 1
.continue END
..
!FOUND
.formula U|xxfontfaktor = 'U|xxfaktor.U|i'
.formula U|xyfontfaktor = 'U|xyfaktor.U|i'
..
!END
.continue
