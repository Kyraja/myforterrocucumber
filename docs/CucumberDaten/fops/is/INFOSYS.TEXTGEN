..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYS.TEXTGEN
.. Autor          : male
.. Verantwortlich : teamreport
.. Kontrolle      : fwester
.. Funktion       : Definiert Anforderungstexte aus dem Infosystem U|xisnum.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Defines request descriptions of the infosystem U|xisnum.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xisnum       ? _F|defined(U|xisnum)
.type text xpunkt       ? _F|defined(U|xpunkt)
.type text xtxt         ? _F|defined(U|xtxt)
.type text xkommenta    ? _F|defined(U|xkommenta)
.type text xkommentb    ? _F|defined(U|xkommentb)
.type text xkommentc    ? _F|defined(U|xkommentc)
.type text xtmpname     ? _F|defined(U|xtmpname)
.type text xuebers      ? _F|defined(U|xuebers)
.type bool xausgabebspr ? _F|defined(U|xausgabebspr)
..
.. Initializations
.formula U|xisnum = M|nummer ? F|empty(U|xisnum)
.load 1 infosystem 'U|xisnum'
.continue FATAL ? _G|mehr
.copy U|xausgabebspr = 1|ausgabebspr
..
.input "DATEI.F"
..
.formula U|xpunkt = "."
..
.set trans +
.formula U|xkommenta="Programm: "+('1|transfop' >$ "/")
.formula U|xkommentb="Funktion: Dies ist ein generiertes FOP mit dem Anforderungstexte definiert werden."
.formula U|xkommentc="Generiert am: "+'G|datum'+"  "+"um: "+'G|zeit'+"  "+"von: "+G|bzeichen
.set trans -
..
.continue ERROR1 ? F|empty(1|transfop)
.output new '1|transfop'
..
'U|xpunkt''U|xpunkt'!interpreter german noabbrev
'U|xpunkt'weiter ? F|defined(U|xisnum'U|xisnum')
'U|xpunkt'art text xisnum'U|xisnum'
'U|xpunkt''U|xpunkt' 'F|string("*", 80)'
'U|xpunkt''U|xpunkt' 'U|xkommenta'
'U|xpunkt''U|xpunkt' 'U|xkommentb'
'U|xpunkt''U|xpunkt' 'U|xkommentc'
'U|xpunkt''U|xpunkt' 'F|string("*", 80)'
'U|xpunkt''U|xpunkt'
'U|xpunkt'setz trans -
..
.load 1 line 'F|formatstr("$,,indaten={1}", G|TRUE)'
!CHECK
.continue END ? _G|mehr
.continue NEXTROW ? F|regmatch(1|vitbezf, "^BU.*")
.formula U|xtxt = ""
.formula U|xtmpname = F|substr(1|vname, 3,)
..
.. Vorhandenen Text besorgen oder leeren ignorieren
.continue BEZVOLL ? _F|empty(1|extbezds)
.continue BEDVOLL ? _F|empty(1|vbedds)
.continue NEXTROW
..
!BEZVOLL: Kurzbezeichnung ist nicht leer
.formula U|xtxt = 1|extbezds
.continue KOMTYP ? 1|vbezmsg <> 0
.formula U|xtxt = 1|extbez
.continue KOMTYP
..
!BEDVOLL: Bedeutung ist nicht leer
.formula U|xtxt = 1|vbedds
.continue KOMTYP ? 1|vbedmsg <> 0
.formula U|xtxt = 1|vbed
.continue KOMTYP
..
!NEXTROW
.load 1 line
.continue CHECK
..
!KOMTYP: Kommandoart bestimmen
.. Kein Kommando bei Leertext
.continue NEXTROW ? F|empty(U|xtxt)
..
.. Deklaration der Textvariablen schreiben
'U|xpunkt'art text xt'U|xtmpname'
..
.. .formel bei nicht korrespondensprachlicher Ausgabe
.continue FORMEL ? U|xausgabebspr
.. .formel bei einem Zeichen -> nie uebersetzen
.continue FORMEL ? F|length(U|xtxt) = 1
.. wenn der Text eine Zahl ist, kommt es seit dem Wegfall der msg-Nummern
.. bei .text aufgrund eine Plausibilitaetspruefung unter Flagge 82 zu
.. einer Diagnosemeldung bei der Auswertung.
.continue FORMEL ? F|regmatch(U|xtxt, "[0-9]+")
.formula U|xuebers = ('U|xtxt' * "+#X")
.continue TEXT
..
!FORMEL: Zuweisen per .formel-Kommando
'U|xpunkt'formel xt'U|xtmpname' = "'U|xtxt'"
.continue NEXTROW
..
!TEXT: Zuweisen per .uebersetzen-Kommando
'U|xpunkt'uebersetzen -variable xt'U|xtmpname' -sprache 'G|apostroph'P|spr'G|apostroph' -woerterbuch 4,7,5,3,8,0 -text 'G|dblquote''U|xuebers''G|dblquote'
.continue NEXTROW
..*******************************************************************************************
!END
.continue
..*******************************************************************************************
!FATAL
.error -number 1111
.end 1
..
!ERROR1: Missing FOP
.error -number 9710
.end 1
