..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TEXTENCODER.EV
.. Author         : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  : Central handling of different small events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue METHOD  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "decode"
.continue INPUT   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "textinput"
.continue DIALOG  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "textinputdialog"
..--------------------------------- Table  -------------------------------------
.. No table items
..==============================================================================
.continue END
..
!METHOD: Changing term
.assign M|textinput = ""
.assign M|textencoded = ""
.assign M|textdecoded = ""
.continue ENCODE ? _M|decode
.copy M|term4transform = M|term4defaultdecode
.copy M|term4retransform = M|term4defaultencode
.continue END
..
!ENCODE: Method is encode
.copy M|term4transform = M|term4defaultencode
.copy M|term4retransform = M|term4defaultdecode
.continue END
..
!DIALOG: User needs input dialog
.set cancel -
.read "Bitte umzuwandelnden Text eingeben:" M|textinput
.set cancel +
.continue END ? _G|mehr
..
!INPUT: User inputs text
.assign M|textencoded = ""
.. Encode original value
.assign M|textencoded = M|textinput * M|term4transform
.continue ERROR01 ? _G|mehr
.. Decode encoded value
.assign M|textdecoded = ""
.assign M|textdecoded = M|textencoded * M|term4retransform
.continue ERROR02 ? _G|mehr
..*****************************************************************************
!END
.continue
..
!ERROR01: Encode fails
.error -line 0 -field M|textencoded -message Die Umwandlung ist gescheitert!
.continue FAILS
..
!ERROR02: Decode fails
.error -line 0 -field M|textencoded -message Die Umwandlung ist gescheitert!
..
!FAILS: Show fail message
.end 1
