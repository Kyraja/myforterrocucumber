..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.EV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Behandelt funktional kleinere Feld- und Zeilenereignisse.
.. Ablauf         : Zentrales Ereignis-FOP
..
.. Functionality  : Handles field and row events whith smaller functions.
.. Program flow   : Central efop
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue REFERTO  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "wurzel"
.continue CLRTAB   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "anzstufen"
.continue CLRTAB   ? G|evtartengl = "FIELD_FILL" & G|evtvar = "nuraktive"
.continue CLRTAB   ? G|evtartengl = "FIELD_FILL" & G|evtvar = "generierte"
..--------------------------------- Table  -------------------------------------
.continue FORBID  ? G|evtartengl = "ROW_MOVED_BEFORE"
..==============================================================================
.continue END
..
!REFERTO: field exit of item "verweis"
.continue CLRTAB ? F|empty(M|wurzel)
.assign M|vartab = "$,,;typ==(1);@datenbank=12:26;@ablageart=(Active);vdn==" + 'M|wurzel^dnr' + ";vgr==" + 'M|wurzel^gruppe'
.continue CLRTAB
..
!FORBID: action is not allowed
.error
.end 1
..
!CLRTAB: clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
