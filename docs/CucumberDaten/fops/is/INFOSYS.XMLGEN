..!interpreter english translate noabbrev
.. ****************************************************************************
.. FOP-Name       : INFOSYS.XMLGEN
.. Autor          : mg
.. Verantwortlich : mg
.. Kontrolle      : fwester
.. Funktion       : Generatorfop fÅr die XML-Datendatei. Schreibt alle
..                  verfÅgbaren Daten des Infosystems in eine XML-Datei.
..
.. ****************************************************************************
..
.. Aufruf-Parameter fÅr diese Datei:
.. =================================
..
.. xxmldata: öbergabeparameter
..
.. ****************************************************************************
.set trans -
..
...ein XML
.input "DATEI.F"
..
..
.type text xtempname xzeile xvbedname xkommenta xkommentb xpagename
..
.set trans +
.formula U|xkommenta="Dies ist eine generierte XML-Datendatei"
.formula U|xkommentb="Generiert am: "+'G|datum'+"  "+"um: "+'G|zeit'+"  "+"Benutzer: "+'bzeich'+"  "+"Mandant: "+'G|mandant' ? 'G|loginname'=""
.formula U|xkommentb="Generiert am: "+'G|datum'+"  "+"um: "+'G|zeit'+"  "+"Benutzer: "+'G|loginname'+" ("+'bzeich'+")"+"  "+"Mandant: "+'G|mandant' ? 'G|loginname'<>""
.formula U|xpagename="Seite"
.set trans -
..
..
.output new 'U|xxmldata'
<?xml version="1.0" encoding="UTF-8"?>
<!--
'U|xkommenta'
'U|xkommentb'
-->
<ABASData abasversion="2003" source="Screen">
   <RecordSet caption="0">
      <Record caption="xmlData">
         <Head>
            <FieldSet name="Pageheader">
.formula U|xzeile = "              <Field name="+'G|dblquote' + "bzeich" + 'G|dblquote' +">"+'bzeich'+"</Field>"
'U|xzeile'
.formula U|xzeile = "              <Field name="+'G|dblquote' + "datum" + 'G|dblquote' +">"+'G|datum'+"</Field>"
'U|xzeile'
.formula U|xzeile = "              <Field name="+'G|dblquote' + "bereich" + 'G|dblquote' +">"+'arb'+"/"+'such'+"</Field>"
'U|xzeile'
.formula U|xzeile = "              <Field name="+'G|dblquote' + "uhrzeit" + 'G|dblquote' +">"+'G|zeit'+"</Field>"
'U|xzeile'
.formula U|xzeile = "              <Field name="+'G|dblquote' + "txtpage" + 'G|dblquote' +">"+'U|xpagename'+"</Field>"
'U|xzeile'
..
.select screen header
!MPAUSGABE
.select line
.continue MPTEILENDE ? _G|mehr
.continue MPAUSGABE ? (H|vkt ; H|vitbezf/"BU*")
.formula U|xtempname = H|vname<<-2
.formula U|xvbedname = H|extbezs
.formula U|xvbedname = H|vbeds  ? U|xvbedname=""
.formula U|xzeile = "              <Field name="+'G|dblquote' + 'U|xtempname' + 'G|dblquote' +"><![CDATA["+'M|.U|xtempname'+"]]></Field>"
'U|xzeile'
.formula U|xzeile = "              <Field name="+'G|dblquote' + "txt" + 'U|xtempname' + 'G|dblquote' +"><![CDATA["+'U|xvbedname'+"]]></Field>"
'U|xzeile'
.continue MPAUSGABE
!MPTEILENDE
            </FieldSet>
            <FieldSet name="Maskhead">
.select screen header
!MKAUSGABE
.select line
.continue MKTEILENDE ? _G|mehr
.continue MKAUSGABE ? (H|vkt ; H|vitbezf/"BU*")
.formula U|xtempname = H|vname<<-2
.formula U|xvbedname = H|extbezs
.formula U|xvbedname = H|vbeds  ? U|xvbedname=""
.formula U|xzeile = "              <Field name="+'G|dblquote' + 'U|xtempname' + 'G|dblquote' +"><![CDATA["+'M|.U|xtempname'+"]]></Field>"
'U|xzeile'
.formula U|xzeile = "              <Field name="+'G|dblquote' + "txt" + 'U|xtempname' + 'G|dblquote' +"><![CDATA["+'U|xvbedname'+"]]></Field>"
'U|xzeile'
.continue MKAUSGABE
!MKTEILENDE
            </FieldSet>
         </Head>
..
..
..
.. Kopfteil (Row Number=0) der Tabelle erstellen
.select screen header
.formula U|xzeile = "         <Row type="+'G|dblquote'+"Tablehead"+'G|dblquote'+" number="+'G|dblquote'+"0"+'G|dblquote'+">"
'U|xzeile'
..
.select line 0
!TKAUSGABE
.select line
.continue TKTEILENDE ? _G|mehr
.continue TKAUSGABE ? (_H|vkt ; H|vitbezf/"BU*")
.formula U|xtempname = H|vname<<-2
.formula U|xvbedname = H|extbezs
.formula U|xvbedname = H|vbeds  ? U|xvbedname=""
.formula U|xzeile = "           <Field name="+'G|dblquote' + "txt" + 'U|xtempname' + 'G|dblquote' +"><![CDATA["+'U|xvbedname'+"]]></Field>"
'U|xzeile'
.continue TKAUSGABE
!TKTEILENDE
         </Row>
..
..
.. Durch die Zeilen der Maske steppen
!MTABZEILE
.select screen line
.continue MTABENDE ? _G|mehr
..
.formula U|xzeile = "         <Row type="+'G|dblquote'+"Tablebody"+'G|dblquote'+" number="+'G|dblquote' + 'M|aktzeile' + 'G|dblquote' +">"
'U|xzeile'
..
.. .setz debug +
..
.select line 0
!TAUSGABE
.select line
.continue TTEILENDE ? _G|mehr
.continue TAUSGABE ? (_H|vkt ; H|vitbezf/"BU*")
.formula U|xtempname = H|vname<<-2
.formula U|xzeile = "           <Field name="+'G|dblquote' + 'U|xtempname' + 'G|dblquote' +"><![CDATA["+'M|.U|xtempname'+"]]></Field>"
'U|xzeile'
.continue TAUSGABE
!TTEILENDE
         </Row>
.continue MTABZEILE
!MTABENDE
      </Record>
   </RecordSet>
</ABASData>
..
.output terminal
.continue
