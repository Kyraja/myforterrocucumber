.formula U|xbuttonname24 = "buzbewpruef"
.formula U|xprogramvar24 = "zbewpruef"
.formula U|xtoken24      = "RMV"
..
!NEXT
.continue FOUND ? U|xbuttonname.U|xi = G|evtvar
.continue END ? U|xi = U|XMAX
.formula U|xi = U|xi + 1
.continue NEXT
..
!FOUND
.formula U|xprogramvar = U|xprogramvar.U|xi
.formula U|xevttoken   = U|xtoken.U|xi
..*****************************************************************************
!END
.continue
