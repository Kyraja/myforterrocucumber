..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYS.HTMLGEN
.. Autor          : male
.. Verantwortlich : teamreport
.. Kontrolle      : 
.. Funktion       : Generiert eine einfache HTML-Datei fÅr die Ausgabe
..                  eines Infosystems. Die Zeilen werden abwechselnd
..                  in verschiedenen Farben dargestellt abhÑngig vom Wert
..                  der Variablen "xtgrpvar", welche ein Tabellenvariable
..                  enthalten muss und fÅr die Feststellung eines Gruppen-
..                  wechsels genutzt wird.
..                  Verbesserung geplant:
..                      - Schreiben der Variablennamen in zwei Textvariablen
..                        um nicht fÅr jede Zeile die Vartab zu durchlaufen
..                      - Auslagerung der Farbdefinitionen
.. Ablauf         : * Generierung der IDQ-Datei um Åbersetzte Texte zu bekommen
..                    sofern Generator-FOP existiert. Ansonsten werden die Texte
..                    der Vartab entnommen.
..                  * Generierung der HTML-Datei anhÑngig von der Flagge
..                    "Druck"
..                  * Oeffnen der HTML-Datei mit dem Browser
..
.. Functionality  :
.. Program flow   :
..*****************************************************************************
.set trans -
.type text xxtfile   ? _F|defined(U|xxtfile)
.type text xxttmp    ? _F|defined(U|xxttmp)
.type text xxtguitmp ? _F|defined(U|xxtguitmp)
.type text xtdesc    ? _F|defined(U|xtdesc)
.type text xtsel     ? _F|defined(U|xtsel)
.type text xtvar     ? _F|defined(U|xtvar)
.type text xxtval    ? _F|defined(U|xxtval)
.type bool xbwtxtfop ? _F|defined(U|xbwtxtfop)
.type integer  xitxtfop  ? _F|defined(U|xitxtfop)
..
.. variable and current value for group changes
.type text xtgrpval ? _F|defined(U|xtgrpval)
..
.. flag if we have an odd or even group number (for colors in rows)
.type text xtnbsp   ? _F|defined(U|xtnbsp)
.type text xttxtvar ? _F|defined(U|xttxtvar)
.type text xthtmlf  ? _F|defined(U|xthtmlf)
..
.type integer  xigrp      ? _F|defined(U|xigrp)
.type text xxtart     ? _F|defined(U|xxtart)
.type bool xxbisref   ? _F|defined(U|xxbisref)
.type bool xxbisreal  ? _F|defined(U|xxbisreal)
.type text xxoid      ? _F|defined(U|xxoid)
.type text xxtref     ? _F|defined(U|xxtref)
.type text xxtid      ? _F|defined(U|xxtid)
..
.. array for sums
.type real xxxrs1  ? _F|defined(U|xxxrs1)
.type real xxxrs2  ? _F|defined(U|xxxrs2)
.type real xxxrs3  ? _F|defined(U|xxxrs3)
.type real xxxrs4  ? _F|defined(U|xxxrs4)
.type real xxxrs5  ? _F|defined(U|xxxrs5)
.type real xxxrs6  ? _F|defined(U|xxxrs6)
.type real xxxrs7  ? _F|defined(U|xxxrs7)
.type real xxxrs8  ? _F|defined(U|xxxrs8)
.type real xxxrs9  ? _F|defined(U|xxxrs9)
.type real xxxrs10 ? _F|defined(U|xxxrs10)
.type real xxxrs11 ? _F|defined(U|xxxrs11)
.type real xxxrs12 ? _F|defined(U|xxxrs12)
.type real xxxrs13 ? _F|defined(U|xxxrs13)
.type real xxxrs14 ? _F|defined(U|xxxrs14)
.type real xxxrs15 ? _F|defined(U|xxxrs15)
.type real xxxrs16 ? _F|defined(U|xxxrs16)
.type real xxxrs17 ? _F|defined(U|xxxrs17)
.type real xxxrs18 ? _F|defined(U|xxxrs18)
..
.. number of variables
.type integer  xxxrsc ? _F|defined(U|xxxrsc)
..*****************************************************************************
.copy U|xbwtxtfop = G|TRUE
.set languagesettings "P"
.formula U|xxxrsc = "18"
.formula P|datname = "" ? P|datname = P|aktdatname
..
.. Test if TEXT generator FOP exists. Then execute it.
.continue ERR02 ? F|empty(M|isref^transfop)
.input "is/INFOSYS.TEXTGEN" ? _F|fileexists(M|isref^transfop)
.file -test -open U|xitxtfop 'M|isref^transfop'
.continue ERR01 ? _G|mehr
.input 'M|isref^transfop'
.output terminal
..
.copy U|xxttmp     = "rmtmp"
.copy U|xxtguitmp  = "win/tmp"
.formula U|xxtfile    =  M|such65 + G|aufrufernr + ".HTML"
.copy U|xtnbsp     = "&nbsp;"
.copy U|xxtref     = "^"
.copy U|xxtid      = "id"
..
.type text xxtisname ? _F|defined(U|xxtisname)
.copy U|xxtisname = M|isref^nameaspr
.copy U|xxtisname = M|isref^sucherw  ? F|empty(U|xxtisname)
..
.formula U|xthtmlf = U|xxttmp + "/" + U|xxtfile
.output new 'U|xthtmlf'
.input "DATEI.F"
..*****************************************************************************
!HEAD
..*****************************************************************************
<html>
  <head>
   <meta http-equiv="Content-Type" content="text/html;charset=utf-8">
   <link rel="stylesheet" href="../browser/browser.css">
   <title>'U|xxtisname' ('G|datum')</title>
  </head>
  <body>
    <div class="header">
      <div class="logo"/>
      <div class="title">
            <p><h1>'U|xxtisname' ('G|datum')</h1></p>
      </div>
    </div>
.select screen header
..*****************************************************************************
!HE2: Table with printable header fields
..*****************************************************************************
.formula U|xtsel = "$,,num65=" + M|num65 + ";vkt=nein;inprint=ja;@zeilen=ja"
.load 9 infosystem 'U|xtsel'
.continue TH1 ? _G|mehr
.load 9 line 1
.continue TH1 ? _G|mehr
    <div class="main">
    <p>
      <table class="header">
..*****************************************************************************
!HE3
..*****************************************************************************
.continue HE5 ? _G|mehr
.continue HE4 ? _9|inprint ; 9|vkt
.continue HE4 ?  (9|vitbezf / "BU*") ; (9|vitbezf / "CH*")
.formula U|xtvar = '9|vname' << -2
.continue HE4 ? 'U|xxtval' <> "" & ((U|xxtart / "BU*") ; (U|xxtart / "CH*"))
.continue HE4 ? _F|defined(M|.U|xtvar)
.formula U|xttxtvar  = "xt" + U|xtvar
.formula U|xtdesc    = '.U|xttxtvar' ? U|xbwtxtfop
.formula U|xtdesc    = '9|extbezs' ? 'U|xtdesc' = ""
.formula U|xtdesc    = '9|vbeds'   ? 'U|xtdesc' = ""
.formula U|xxtval    = 'M|.U|xtvar'
.formula U|xxtart    = 9|vitbezf
.formula U|xxbisref  = 'U|xxtval' <> "" & ((U|xxtart / "V*") ; (U|xxtart / "L*") ; (U|xxtart / "P*"))
.formula U|xxbisreal = 'U|xxtval' <> "" & ((U|xxtart / "R*") ; (U|xxtart / "M*"))
.. get file number if reference
.formula U|xxoid    = 'M|.U|xtvar.U|xxtref.U|xxtid'  ? U|xxbisref
.formula U|xxtval   =  "<a href='eks:" + U|xxoid + "'>" + 'U|xxtval' + "</a>" ? U|xxbisref & G|mitlinks
.formula U|xxtval   =  U|xtnbsp            ? 'U|xxtval' = ""
      <tr class="header">
        <td class ="header">'U|xtdesc':</td>
        <td class ="header">'U|xxtval'</td>
      </tr>
..*****************************************************************************
!HE4: Next header field
..*****************************************************************************
.load 9 line continue
.continue HE3
..
..*****************************************************************************
!HE5: End of header fields
..*****************************************************************************
    </table>
    </p>
..
..*****************************************************************************
..*****************************************************************************
!TH1: Table header
..*****************************************************************************
    <p>
    <table class="table">
      <tr class="table">
..*****************************************************************************
!TH2: Table header
..*****************************************************************************
.load 9 infosystem 'M|isref^id'
.continue END ? _G|mehr
..*****************************************************************************
!TH3
..*****************************************************************************
.load 9 line
.continue TH4 ? _G|mehr
.continue TH3 ? _9|vkt
.continue TH3 ? _9|inprint
.continue TH3 ? (9|vitbezf / "BU*") ; (9|vitbezf / "CH*")
.formula U|xtvar = '9|vname' << -2
.formula U|xttxtvar = "xt" + U|xtvar
.formula U|xtdesc   = ""
.formula U|xtdesc   = '.U|xttxtvar' ? U|xbwtxtfop
.formula U|xtdesc   = '9|extbezs' ? 'U|xtdesc' = ""
.formula U|xtdesc   = '9|vbeds'   ? 'U|xtdesc' = ""
         <th  class="table">'U|xtdesc'</th>
.continue TH3
..
..*****************************************************************************
!TH4
..*****************************************************************************
      </tr>
..*****************************************************************************
!TABLEBODY
..*****************************************************************************
.formula U|xtsel = "$,,num65=" + M|num65 + ";" + "vkt=ja;inprint=ja;@zeilen=ja"
.load 9 infosystem 'U|xtsel'
.continue TB6 ? _G|mehr
.select screen header
..*****************************************************************************
!TB2
..*****************************************************************************
.load 9 line
.select screen line
.continue TB6 ? _G|mehr
.continue NOGRPVAR ? _F|defined(U|xtgrpvar)
.formula U|xigrp = U|xigrp + 1           ? 'U|xtgrpvar' <> "" & 'M|.U|xtgrpvar' <> U|xtgrpval
.. group change ?
.formula U|xtgrpval   = 'M|.U|xtgrpvar'    ? 'U|xtgrpvar' <> "" & 'M|.U|xtgrpvar' <> U|xtgrpval
.continue NROW
..
..*****************************************************************************
!NOGRPVAR: no grouping variables defined
..*****************************************************************************
.formula U|xigrp = U|xigrp + 1
..
..*****************************************************************************
!NROW
..*****************************************************************************
      <tr class="table">
..*****************************************************************************
!TB3
..*****************************************************************************
.continue TB6  ? _G|mehr
.formula U|xtvar = '9|vname' << -2
.continue TB4  ? _(9|vkt & 9|inprint)
.continue TB4  ?  (9|vitbezf / "BU*") ; (9|vitbezf / "CH*")

.continue TB4  ? _F|defined(M|.U|xtvar)
.formula U|xxtval   = ""
.formula U|xxtval   = 'M|.U|xtvar'
.formula U|xxtart   = 9|vitbezf
.formula U|xxbisref = 'U|xxtval' <> "" & ((U|xxtart / "V*") ; (U|xxtart / "L*") ; (U|xxtart / "P*"))
.formula U|xxbisreal= 'U|xxtval' <> "" & ((U|xxtart / "R*") ; (U|xxtart / "M*"))
.. get file number if reference
.formula U|xxoid    = 'M|.U|xtvar.U|xxtref.U|xxtid'  ? U|xxbisref
.formula U|xxtval   =  "<a href='eks:" + U|xxoid + "'>" + 'U|xxtval' + "</a>" ? U|xxbisref & G|mitlinks
.formula U|xxtval   =  U|xtnbsp    ? 'U|xxtval' =  ""
?          <td class ="table">                  ? _U|xxbisreal
?          <td class ="number">                 ? U|xxbisreal & F|strindex(U|xxtval,"-")=0
?          <td class="negative">                ? U|xxbisreal & F|strindex(U|xxtval,"-")>0
               'U|xxtval'</td>
..
..*****************************************************************************
!TB4
..*****************************************************************************
.load 9 line
.continue TB3 ? G|mehr
..
..*****************************************************************************
!TB5: Get next mask row
..*****************************************************************************
      </tr>
.continue TB2
..
..*****************************************************************************
!TB6: no more rows in mask
..*****************************************************************************
.load 9
    </table>
    </div>
    </p>
..
..*****************************************************************************
!FOOTER
..*****************************************************************************
  </body>
</html>
..
..*****************************************************************************
!OPEN
..*****************************************************************************
.output new werf.weg
.type text U|xxtdest ? _F|defined(U|xxtdest)
.formula U|xxtdest = U|xxtguitmp + "/" + U|xxtfile
.formula U|xxtdest = P|datname ? (_F|empty(P|datname) & F|strindex(P|datname, "temp.maske") = 0)
.system 'F|formatstr("mv -f {1}/{2} {3}", U|xxttmp, U|xxtfile, U|xxtdest)' background
.system 'F|formatstr("s3_conv 50 {1}", U|xxtdest)' background
.browser -file 'U|xxtdest' ? G|grafik
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERR01: File is missing!
.error -message 'M|isref^transfop' nicht vorhanden!
.end 1
..
!ERR02: No printing is not configured!
.error -message Keine Ausgabe mîglich - Infosystemkonfiguration steht auf "Keine Ausgabe".
.end 1
