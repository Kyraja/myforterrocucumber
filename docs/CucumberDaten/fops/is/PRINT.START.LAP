..!interpreter english translate noabbrev
.continue DECL
..*****************************************************************************
.. FOP-Name       : PRINT.START.LAP
.. Autor          : lei
.. Verantwortlich : lei
.. Kontrolle      : mg
.. Funktion       :
..
.. Gestartet per Knopf P|burekursion.
..
..  P|aktslayout: Das Startlayout
..  P|akttmp    : Das Temporaerverzeichnis
..  P|aktpfad   : Der abstrakte Pfad
..  P|aktdaten  : Der Datenpfad
..*****************************************************************************
.set trans -
!DECL
.type text xlapgenfop ? _F|defined(U|xlapgenfop)
.type text xgenprefix ? _F|defined(U|xgenprefix)
..
!START
.assign U|xgenprefix = "gen/print/plan/"
.. PRINT.START.LAP:
.. P|akttmp:'P|akttmp'
.. P|aktslayout:'P|aktslayout'
.. P|aktpfad:'P|aktpfad'
.. P|aktdaten:'P|aktdaten'
..
.. Deklarationen fuer LAPFOP
..
.. Konstanten fuer die APs
.input "is/A150VARS.FOP"
..
.. Die Bedingung
.type text xaktdaten ? _F|defined(U|xaktdaten)
.type text xdaten    ? _F|defined(U|xdaten)
.type text xedpdatei ? _F|defined(U|xedpdatei)
.type text xfeldwert ? _F|defined(U|xfeldwert)
.type text xxmldata  ? _F|defined(U|xxmldata)
..
.assign U|xlapgenfop = U|xgenprefix + P|aktpfad + ".LAPFOP"
.input 'U|xlapgenfop'
.. PRINT.START.LAP: ENDE
..*****************************************************************************
!END
.continue
