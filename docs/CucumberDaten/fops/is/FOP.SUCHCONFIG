..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FOP.SUCHCONFIG
.. Autor          : uko, fwester
.. Verantwortlich : uko
.. Kontrolle      : lei
.. Funktion       : Einlesen der Konfigurationsdatei eines Index
.. Functionality  : Reading the configuration file
..*****************************************************************************
.. Setted varibles:
..   xtmpurl  - URL to HTML page
..
..
..*****************************************************************************
.set trans -
..
.. Declarations
.type text    xindex    ? _F|defined(U|xindex)
.type PS92:1  xpsabb    ? _F|defined(U|xpsabb)
.type bool    xboolse   ? _F|defined(U|xboolse)
.type text    xbaseurl  ? _F|defined(U|xbaseurl)
.type text    xtmpurl   ? _F|defined(U|xtmpurl)
.type text    xurl      ? _F|defined(U|xurl)
.type GL      xurlproto ? _F|defined(U|xurlproto)
.type GL      xurlhost  ? _F|defined(U|xurlhost)
.type IP      xurlport  ? _F|defined(U|xurlport)
.type GL17    xlocale   ? _F|defined(U|xlocale)
..
.continue END ? F|empty(U|xindex)
..
.assign U|xpsabb = 'U|xindex'
..
.. Check given mapping model
.copy U|xboolse = F|value(U|xpsabb^verwaz, "AZS20130") = "(SearchEngine)"
.continue ERROR00 ? _U|xboolse
..
!KEYPROCTOCOL
.assign U|xurlproto = 'E|VTS_PROTOCOL'
..
!KEYHOST
.assign U|xurlhost = 'E|VTS_HOSTNAME'
..
!KEYPORT
.assign U|xurlport = 'E|VTS_PORT'
..
!BASEURL
.assign U|xbaseurl = 'E|VTS_BASEURL'
.continue KEYURL ? _F|empty(U|xbaseurl)
.assign U|xbaseurl = 'E|VTS_PROTOCOL' + "://" + 'E|VTS_HOSTNAME' + ":" + 'E|VTS_PORT'
..
!KEYURL
.assign U|xtmpurl = 'E|VTS_BASEURL' + "/ui/{1}/Search" + 'U|xpsabb^nummer' + ".html"
.assign U|xlocale = 'G|bspri'
.assign U|xurl    = F|formatstr(U|xtmpurl, U|xlocale)
..
!END
.continue
..*****************************************************************************
..
!ERROR00: No Search Engine Mapping Model!
.cursor mapping 0
.error Das Abbildungsmodell dient nicht der Volltextsuche!
.continue BREAK
..
..
!BREAK
.end 1
