..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABASURL.CREATE
.. Autor          : saac
.. Verantwortlich : teamreport
.. Kontrolle      : mg
.. Functionality  : creates an AbasURL (U|xabasurl) for a given id (U|xid)
..*****************************************************************************
.type url xabasurl             ? _F|defined(U|xabasurl)
.type VID99 xrecordid          ? _F|defined(U|xrecordid)
..
.set trans -
..
.continue END        ? F|empty(U|xrecordid)
..
.type text xencid   ? _F|defined(U|xencid)
.type text xencdde  ? _F|defined(U|xencdde)
.type text xencmand ? _F|defined(U|xencmand)
.type text xurl     ? _F|defined(U|xurl)
..
.assign U|xencid    = F|urlencode('U|xrecordid')
.assign U|xencdde   = F|urlencode('G|ddesrvname')
.assign U|xencmand  = F|urlencode('G|mandant') * "+LX/+/%20/"
..
.formula U|xurl = F|formatstr("{1}", "abasurl:")
.formula U|xurl = U|xurl + F|formatstr("{1}", U|xencid)
.formula U|xurl = U|xurl + F|formatstr("?DDE={1}", U|xencdde)
.formula U|xurl = U|xurl + F|formatstr("&Client={1}", U|xencmand)
..
.assign U|xabasurl = U|xurl
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
