..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.OPEN.AUFRUFPARAMS
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet einen Ordner der Schluesselart M|aufparams. Dieser
.. hat maximal zwei Ordner: einen fuer Aufrufparameter mit dem Infosystem als
.. Zielobjekt und einen fuer Aufrufparameter mit dem Infosystem als Aufrufer.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens a node with the key of the type M|aufparams. This
.. has at most two nodes as elements. One node for callparameters which call
.. the infosystem and one node for callparameters which are called by the
.. infosystem.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Do we have callparameters as caller?
.formula M|select = "$,,;@ablageart=(Active);@gruppe=12;zeilentyp==(MenuItem);kopf^aufrktxt==" + M|wurzel^id
.formula M|select = M|select + ";aktiv==" + 'G|TRUE' ? M|nuraktive
.load 9 dataexport 'M|select'
.continue TARGET ? _G|mehr
..
.assign M|kdatenobjekt = "$,,;typ==(1);@ablageart=(Active);@datenbank=12:26;vdn==" + '9|dnr' + ";vgr==" + '9|gruppe'
.assign M|kbaumtext = '9|grbez'
.assign M|kbauminfo = 9|sucherw
.assign M|kname = "Aufrufer"
.assign M|kbaumstat = "+"
.copy M|kschluessel = M|aufrufer
.assign M|kpaket = ""
.copy M|kaktiv = G|TRUE
.copy M|kgeneriert = G|FALSE
.input 'M|tab' ? _F|empty(M|tab)
..
!TARGET: Do we have callparameters as target?
.formula M|select = "$,,;@ablageart=(Active);@gruppe=12;zeilentyp==(MenuItem);tzielobj==" + M|wurzel^id
.formula M|select = M|select + ";aktiv==" + 'G|TRUE' ? M|nuraktive
.load 9 dataexport 'M|select'
.continue END ? _G|mehr
..
.assign M|kdatenobjekt = "$,,;typ==(1);@ablageart=(Active);@datenbank=12:26;vdn==" + '9|dnr' + ";vgr==" + '9|gruppe'
.assign M|kbaumtext = '9|grbez'
.assign M|kbauminfo = 9|sucherw
.assign M|kname = "Zielobjekt"
.assign M|kbaumstat = "+"
.assign M|kpaket = ""
.copy M|kschluessel = M|zielobjekt
.copy M|kaktiv = G|TRUE
.copy M|kgeneriert = G|FALSE
.input 'M|tab' ? _F|empty(M|tab)
..*****************************************************************************
!END
.continue
