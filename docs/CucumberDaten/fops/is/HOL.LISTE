..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : HOL.LISTE
.. Autor          : es
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Datenbeschaffer fÅr EINSTUFIGE Auswertungen. Er kann zum
..                  Laden von Tabellen in Infosystemen verwendet werden.
.. Ablauf         : Das Programm liest alle DatensÑtze aus Datei in "M|dn",
.. die eine zulÑssige Gruppe laut "M|grliste" und durch das Selektionsmuster in
.. "M|select" bestimmt sind. FÅr jeden Treffer wird das Tabellen-Programm in
.. "M|tab" aufgerufen. Vor der Datenbankanfrage wird das Berichtskopf-Programm in
.. "M|bkopf", danach das Berichtsfuss-Programm in "M|fuss" aufgerufen.
..
.. Puffer         : Die optionale Variable "xxlbuffer" kann einen Puffer mit
.. einer Nummer zwischen 0 und 9 enthalten, der dann statt des H-Puffers genutzt
.. wird. Ist diese Variable nicht definiert oder ungÑltig wird der H-Puffer
.. genutzt.
..*****************************************************************************
.set trans -
..
.continue ERROR1 ? M|dn = ""
..
.. Declarations
.type text xxtwrkbuff   ? _F|defined(U|xxtwrkbuff)
.type text xxtpipe      ? _F|defined(U|xxtpipe)
.type bool xbhbuff      ? _F|defined(U|xbhbuff)
..
.. Initializations
.formula U|xxtwrkbuff = "H"
.formula U|xxtpipe = "|"
.copy U|xbhbuff = G|TRUE
.continue HEADER ? _F|defined(U|xxlbuffer)
.continue HEADER ? _('U|xxlbuffer' / "(0-9)")
.copy U|xbhbuff = G|FALSE
.formula U|xxtwrkbuff   = 'U|xxlbuffer'
..
!HEADER: Read report header fop
.input 'M|bkopf' ? _F|empty(M|bkopf)
..
.continue LBUFFER ? _U|xbhbuff
.select group  'M|grliste' 'M|select'
.continue HASNEXT
..
!LBUFFER: Required buffer is one from 0-9
.load 'U|xxtwrkbuff' group 'M|grliste' 'M|select'
..
!HASNEXT
.continue FOOTER ? _G|mehr
..
!TABLE: Read table fop
.input 'M|tab' ? _F|empty(M|tab)
..
!NEXT: Get next record
.select continue ? U|xbhbuff
.load 'U|xxtwrkbuff' continue ? _U|xbhbuff
.continue HASNEXT
..
!FOOTER: Read report footer
.input 'M|bfuss' ? _F|empty(M|bfuss)
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Filename is missing
.error -message Keine Datenbank angegeben!
.end 1
