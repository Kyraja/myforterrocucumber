..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BROWSER.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : lei
.. Funktion       : Behandelt zentral einfache Ereignisse.
.. Functionality  : Central handling of small events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header ---------------------------------------
.continue SETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "seturlprog"
.continue GETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "geturlprog"
.continue GETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "mapping"
.continue SETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "urlscheme"
.continue SETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "urlhost"
.continue SETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "urlport"
.continue SETURL  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "urlpath"
.continue CLRELEM ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "url"
..--------------------------------- Table  -------------------------------------
..==============================================================================
.continue END
..
!GETURL: Get URL using configuration file
.continue CLRELEM ? F|empty(M|mapping)
.copy M|verwaz = M|mapping^verwaz
.copy M|searchengine = F|equals(M|verwaz, "(SearchEngine)")
.continue CLRELEM ? F|empty(M|geturlprog)
.input 'M|geturlprog'
..
!SETURL: Reset URL
.input 'M|seturlprog' ? _F|empty(M|seturlprog)
.continue END
..
!CLRELEM: Clear elements of URL
.assign M|verwaz = ""
.copy M|searchengine = G|FALSE
.assign M|urlscheme = ""
.assign M|urlport = 0
.assign M|urlhost = ""
.assign M|urlpath = ""
.assign M|urlencoded = ""
..*****************************************************************************
!END
.continue
