..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SYSTEM.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt zentral die Feldereignisse.
.. Functionality  : Central handling of field events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue MESSAGE ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "errornumber"
.continue NOTOUT  ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "nostdout"
.continue NOTERR  ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "nostderr"
.continue CONFOUT ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "configtmpout"
.continue CONFERR ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "configtmperr"
.continue STDOUT  ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "standardout"
.continue STDERR  ? G|evtartengl = "FIELD_EXIT"  & G|evtvar = "standarderr"
..--------------------------------- Table  -------------------------------------
..==============================================================================
.continue END
..
!STDOUT: Exit on filename for standard output
.continue NOOUT ? F|empty(M|standardout)
.copy M|nostdout = G|FALSE
.continue NOTOUT
..
!NOOUT: No filename set
.copy M|nostdout = G|TRUE
.continue NOTOUT
..
!STDERR: Exit on filename for standard error output
.continue NOERR ? F|empty(M|standarderr)
.copy M|nostderr = G|FALSE
.continue NOTERR
..
!NOERR: No filename set
.copy M|nostderr = G|TRUE
.continue NOTERR
..
!CONFOUT: Configuration of temporary filename was pushed
.continue TMPOUT ? M|configtmpout
.protection -reset rmstandardout 0
.assign M|standardout = ""
.continue END
..
!TMPOUT: Configure temporary filename
.copy M|rmstandardout = G|TRUE
.protection rmstandardout 0
.copy M|configtmpout = G|TRUE
.copy M|standardout = M|defnameout
.continue END
..
!CONFERR: Configuration of temporary error filename was pushed
.continue TMPERR ? M|configtmperr
.protection -reset rmstandarderr 0
.assign M|standarderr = ""
.continue END
..
!TMPERR: Configure temporary error filename
.copy M|rmstandarderr = G|TRUE
.protection rmstandarderr 0
.copy M|configtmperr = G|TRUE
.copy M|standarderr = M|defnameerr
.continue END
..
!NOTOUT: Standard file output option was pushed
.continue OUTOFF ? M|nostdout
..
!OUTON: Activate standard file output
.protection -reset standardout 0
.protection -reset rmstandardout 0
.protection -reset configtmpout 0
.continue OUTDEF
..
!OUTOFF: Deactivate standard file output
.protection standardout 0
.protection rmstandardout 0
.protection configtmpout 0
.assign M|standardout = ""
.copy M|rmstandardout = G|FALSE
.copy M|configtmpout = G|FALSE
.continue END
..
!NOTERR: Standard error file output option was pushed
.continue OUTERR ? M|nostderr
..
!ERRON: Activate standard error file output
.protection -reset standarderr 0
.protection -reset rmstandarderr 0
.protection -reset configtmperr 0
.continue ERRDEF
..
!OUTERR: Deactivate standard error file output
.protection standarderr 0
.protection rmstandarderr 0
.protection configtmperr 0
.assign M|standarderr = ""
.copy M|rmstandarderr = G|FALSE
.copy M|configtmperr = G|FALSE
.continue END
..
!MESSAGE: Show text to message number
.continue DEFTEXT ? F|empty(M|errornumber)
.translate -language 'G|bsprache' -number 'M|errornumber' -dictionary lg -variable M|errormessage -close
.continue END
..
!DEFTEXT: Default text
.copy M|errormessage = M|deferrormessage
.continue END
..
!OUTDEF: Restore defaults
.copy M|rmstandardout = G|TRUE
.continue TMPOUT ? F|empty(M|standardout)
.continue TMPOUT ? M|standardout = M|defnameout
.copy M|configtmpout = G|FALSE
.continue END
..
!ERRDEF: Restore defaults
.copy M|rmstandarderr = G|TRUE
.continue TMPOUT ? M|standarderr = M|defnameerr
.continue TMPERR ? F|empty(M|standarderr)
.copy M|configtmperr = G|FALSE
.continue END
..
..*****************************************************************************
!END
.continue
