..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : GET.ABSPATH.CLIENTDIR
.. Autor         : fwester
.. Verantwortlich: fwester
.. Kontrolle     : cl
.. Funktion      : Schreibt in die Maskenvariable clientdir den absoluten Pfad
..                 der Umgebungsvariablen MANDANTDIR. Leer ist gueltig. Es tritt
..                 auf, wenn die Umgebungsvariable leer oder der absolute Pfad
..                 nicht ermittelbar ist.
.. Ablauf        : Unterprogramm
.. Functionality : Gets absolute path of the environment parameter MANDANTDIR and
..                 writes it into mask parameter clientdir. If the environment
..                 parameter has no value or path could not be identified, the
..                 result is empty.
.. Program flow  : Subroutine.
..*****************************************************************************
.set trans -
..
.continue ERROR01 ? _F|defined(M|clientdir)
..
.. Declarations
.type DVM2 xpathfile ? _F|defined(U|xpathfile)
.type integer  xdesc     ? _F|defined(U|xdesc)
.type DV  xpath     ? _F|defined(U|xpath)
.type DV  xabspath  ? _F|defined(U|xabspath)
.type DV  xrempath  ? _F|defined(U|xrempath)
..
.. Initializations
.file -tempname U|xpathfile
.formula U|xpath = E|MANDANTDIR
..
.system 'F|formatstr("abspfad.sh {1} >{2}", E|MANDANTDIR, U|xpathfile)' background
.continue EMPTY ? _G|mehr
.file -test -open U|xdesc 'U|xpathfile'
.continue EMPTY ? _G|mehr
.file -read U|xdesc U|xpath U|xabspath U|xrempath
.continue EMPTY ? _G|mehr
.assign M|clientdir = U|xabspath
.continue ERROR02 ? _G|mehr
.continue END
..
!EMPTY
.assign M|clientdir = ""
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Unknown parameter clientdir!
.error -message Der Parameter "clientdir" ist nicht definiert.
.end 1
..
!ERROR02: Uncompatible parameter clientdir!
.error -message Der Parameter "clientdir" hat keinen kompatiblen Typ.
.end 1
