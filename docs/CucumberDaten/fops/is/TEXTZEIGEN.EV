..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TEXTZEIGEN.EV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Functionality  : Handles simple events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue BBEDIT  ? G|evtartengl = "BUTTON_BEFORE"     & G|evtvar = "editprogram"
.continue BAEDIT  ? G|evtartengl = "BUTTON_AFTER"      & G|evtvar = "editprogram"
..--------------------------------- Table  -------------------------------------
..==============================================================================
.continue END
..
!BBEDIT: Before click button to edit the program
.continue ERROR2 ? F|empty(M|kommando)
.continue END
..
!BAEDIT: After click button to edit the program
.command -parallel 'F|formatstr("<(Text)>{1}<(Edit)>", M|kommando)'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR2: No program mentioned
.error -line 0 -field M|kommando -message Bitte zuerst einen Programmnamen oder Kommandoparameter angeben!
.end 1
