..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INFOSYS.GUIMENU.NODES
.. Author         : male
.. Verantwortlich : fwester
.. Kontrolle      : teamcoreinfra
.. Functionality  : Generates infosystems node for gui menu.
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)          : yes
..
..   Argument        meaning
..   ---------------------------------------------------------
..   1 -> xtoutfile  name of result file
..*****************************************************************************
.set trans -
..
.type text xtoutfile
.type text xtline
.type integer  xislevel
.type integer  xilevel
.type text xtworkspace
.type BGL10 xtdfltindent
.type BGL30 xtindent
.type text xthelp
.type text xarb
.type GL1  xtcomma
..
.input "sy/STD.WORKSPACES"
..
.formula U|xtcomma = ","
.formula U|xtdfltindent = F|string(" ", 3)
.formula U|xislevel = 2
.formula U|xilevel = U|xislevel
.formula U|xtindent = F|string(U|xtdfltindent, U|xilevel)
..
.set separator `
.formula U|xtoutfile = G|arg1 ? G|argc > 1
.input "DATEI.F"
.output new 'U|xtoutfile' -encoding "ISO-8859-1" ? _F|empty(U|xtoutfile)
..
!RS: StEND root node
'F|formatstr("{1}TREENODE TEXT {2}Standardinfosysteme{2} HELP {2}25B{2};", U|xtindent, G|dblquote)'
.formula U|xilevel = U|xilevel + 1
..
!SELECT: Select standard infosystems
.select group "65:1" infosystem "$,nummer=10000!99999;maskorigin=(ManuallyMaintain);@ordnung=arb,nummer"
..
!LOOP
.continue WELINE ? _G|mehr
.continue WSLINE ? F|empty(U|xtworkspace)
.continue ISLINE ? U|xtworkspace = H|arb
..
!WELINE: Workspace node end
.continue RE ? F|empty(U|xtworkspace) & _G|mehr
.formula U|xilevel = U|xilevel - 1
.formula U|xtindent = F|string(U|xtdfltindent, U|xilevel)
'F|formatstr("{1}END # {2}", U|xtindent, U|xtworkspace)'

.continue RE ? _G|mehr
.continue WSLINE
..
!WSLINE: Workspace node start
.continue ISLINE ? U|xtworkspace = H|arb
.formula U|xarb = H|arb
.formula U|xtindent = F|string(U|xtdfltindent, U|xilevel)
.formula U|xtline = F|formatstr("{1}TREENODE TEXT {2}{3} ({4}){2}", U|xtindent, G|dblquote, U|xtws.U|xarb, H|arb)
.continue W2 ? _F|defined(U|xtwshkap.U|xarb)
.continue W2 ?  F|empty(U|xtwshkap.U|xarb)
.formula U|xtline = U|xtline + F|formatstr(" HELP {1}{2}{1}", G|dblquote, U|xtwshkap.U|xarb)
!W2
.formula U|xtline = U|xtline + ";"
'U|xtline'
.formula U|xilevel = U|xilevel + 1
.continue ISLINE
..
!ISLINE: Infosystem command line
.formula U|xtworkspace = H|arb
.formula U|xthelp = H|vhkap1
.formula U|xtindent = F|string(U|xtdfltindent, U|xilevel)
.formula U|xtline = F|formatstr("{1}ITEM TEXT {2}{3}{2} DATA {2}*(Infosystem) {4} {5}{2}", U|xtindent, G|dblquote, H|namebspr, H|such, H|arb)
.continue ISHELP ? F|strindex(U|xthelp, U|xtcomma) = 0
..
.. Get first help entry in CSV list
.formula U|xthelp = F|substr(U|xthelp, 1, F|strindex(U|xthelp, U|xtcomma) - 1)
..
!ISHELP: help entry for infosystem
.formula U|xtline = U|xtline + F|formatstr(" HELP {1}{2}{1};", G|dblquote, U|xthelp)
'U|xtline'
.select infosystem
.continue LOOP
..
!RE: End root node
.formula U|xilevel = U|xilevel - 1
.formula U|xtindent = F|string(U|xtdfltindent, U|xilevel)
'F|formatstr("{1}END # Standardinfosysteme", U|xtindent)'
.output terminal
..*****************************************************************************
!END
.continue
