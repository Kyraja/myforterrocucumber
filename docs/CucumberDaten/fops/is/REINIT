..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : REINIT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Initialisierung eines Infosystems
.. Ablauf         : Unterprogramm
.. Functionality  : Initializes an infosystem.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.continue END ? G|evtartengl = "NO_EVENT"
.continue END ? _F|defined(M|isref)
..
.reserve
.. init table
.make screen line --
..
.. Init all individual header fields
.select infosystem 'M|isref^id'
.continue HOL ? _G|mehr
..
..*****************************************************************************
!LOOP
..*****************************************************************************
.select line 'F|formatstr("$,,vkt={1};inalias={2};vvs=2", G|FALSE, G|FALSE)'
!CHECK
.continue HOL  ? _G|mehr
.continue NEXT ? H|vitbezf/"BU*"
.continue NEXT ? H|vitbezf/"CH*"
.continue NEXT ? H|vitbezf="DVS1"
.continue NEXT ? 'H|param(L="0")' = "(2)"
.continue NEXT ? 'H|param(L="0")' = "(3)"
.type text xxtvname ? _F|defined(U|xxtvname)
.formula U|xxtvname = F|substr(H|vname, 3,)
..
..*****************************************************************************
!CHKEXCL
..*****************************************************************************
.type integer xxiexclindex ? _F|defined(U|xxiexclindex)
.formula U|xxiexclindex = 0
..
..*****************************************************************************
!EXCLOOP
..*****************************************************************************
.formula U|xxiexclindex = U|xxiexclindex + 1
.continue INIT ? _F|defined(U|xxtinitexclude.U|xxiexclindex)
.continue NEXT ? U|xxtinitexclude.U|xxiexclindex = U|xxtvname
.continue EXCLOOP
..
..*****************************************************************************
!NEXT: Load next row
..*****************************************************************************
.select line
.continue CHECK
..
..*****************************************************************************
!INIT
..*****************************************************************************
.assign M|.U|xxtvname = ""
.continue NEXT
..
..*****************************************************************************
!HOL
..*****************************************************************************
.select
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
