..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FEIERTAGE
.. Autor          : bs
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Markiert alle Tage, die keine Arbeitstage sind
..                  Parameter: xdmin xdmax als Minimin & Maximum
..*****************************************************************************
..
.set trans -
.type date   xd01     ? _F|defined(U|xd01)
.type date   xd02     ? _F|defined(U|xd02)
.type date   xd03     ? _F|defined(U|xd03)
.type date   xd04     ? _F|defined(U|xd04)
.type date   xdleer   ? _F|defined(U|xdleer)
.type R6.6    xraz     ? _F|defined(U|xraz)
.type R6.6    xrez     ? _F|defined(U|xrez)
.type GD      xdmin    ? _F|defined(U|xdmin)
.type GD      xdmax    ? _F|defined(U|xdmax)
.type GD      xdms     ? _F|defined(U|xdms)
..
.. Wenn Anfangs-, Endtermin noch nicht eingetragen, sonst Endlosschleife
.continue A2 ?  (U|xdmin=U|xdleer) ; (U|xdmax=U|xdleer)
..
.formula U|xd01 = U|xdmin & -1
..
!A1
.continue A2 ?  U|xd01 = U|xdmax - 1 
.continue A2 ? _(U|xd01 <= U|xdmax)
..
.formula U|xd02 = U|xd01 + 1
.formula U|xd03 = U|xd01 & 1
.continue A4 ? _(U|xd02 <> U|xd03)
..
.formula U|xd04 = U|xd02
!A3
.continue A4 ? _(U|xd04 <> U|xd03)
..
.formula U|xraz = U|xd04 - U|xdms
.formula U|xrez = U|xraz + 1
.chart -STRIPEY 'U|xraz' 'U|xrez' -RGBCOLOR 225 225 225
.formula U|xd04 = U|xd04 + 1
.continue A3
..
!A4
.formula U|xd01 = U|xd03
.continue A1
..
!A2
.. ***************************************************
.continue
