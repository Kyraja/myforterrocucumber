..!interpreter english translate noabbrev
..*****************************************************************************
.. Name          : KOPFFARBENZURUECKSETZEN.FO
.. Autor         : mh
.. Verantwortlich: mh
.. Kontrolle     : fwester
.. Funktion      : Sezt die Farbe fuer alle Kopffelder auf -1-1-1
.. Ausnahmen     : Buttons, Tabellenaufzaehlungen und Aufzaehlungen
.. Ablauf        : Als Unterprogramm verwendbar
.. Function      : Clears color of all mask header fields of an infosystem.
.. Except        : Buttons, table enumerations und enumerations
.. Program flow  : Use as subroutine
..
.. inspired by is/KOPFLEEREN
..*****************************************************************************
.set trans -
..
.continue END ? F|empty(G|evtmaske)
..
..<META H|='P65'>
..
.. Declarations
.type text xtvarnam ? _F|defined(U|xtvarnam)
..
.. Load matching infosystem rows
.select infosystem 'F|formatstr("$,,;nummer=={1};@gruppe=1", G|evtmaske)'
.continue END ? _G|mehr
..
.select line "$,,vkt=0;inmask=1;vvs=1!2"
!CHECK
.continue END ? _G|mehr
.continue NEXTROW ? F|regmatch(H|vitbezf, "^BU[0-9]$")
.continue NEXTROW ? F|regmatch(H|vitbezf, "^BU[0-9][0-9]$")
.continue NEXTROW ? F|regmatch(H|vitbezf, "^TAZ[0-9]$")
.continue NEXTROW ? F|regmatch(H|vitbezf, "^TN$")
.continue NEXTROW ? F|regmatch(H|vitbezf, "^TN[0-9]$")
.continue NEXTROW ? F|regmatch(H|vitbezf, "^ARTF[0-9][0-9][0-9][0-9][0-9]$")
..
.. Get unqualified name of the item
.formula U|xtvarnam = F|substr(H|vname, 3)
.colour -background -1 -1 -1 -foreground -1 -1 -1 'U|xtvarnam'
..
!NEXTROW: Load next row
.select line
.continue END ? _G|mehr
.continue CHECK
..*****************************************************************************
!END
.continue
