..!interpreter englvar english noabbrev
..*****************************************************************************
.. Filename       : SELECT.ROWBYROW
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : cl
.. Function       : Row by row query in infosystems.
.. IN: (Must have)
.. grpList      - database to query
.. selCriteria  - query with option @rows=1
..
.. Program flow   : First this program calls report header. Then it querys DB
.. and iterates over the hits. For each hit the group header, table program and
.. group footer will be called. At the end of iteration the report footer will
.. be called. Header and selected row of the hits are loaded in buffer H.
..*****************************************************************************
.set trans -
..
.. Validations
.continue ERROR01 ? F|empty(M|grpList)
..
.. Read report header
.input 'M|reportHead' ? _F|empty(M|reportHead)
..
!QUERY: Query database
.select group 'M|grpList' 'M|selCriteria'
.continue FOOTER  ? _G|success
.continue ERROR02 ? _H|selRowByRow
.continue SELROW
..
!HASNEXT: Does query have one more hit?
.continue FOOTER  ? _G|success
..
!SELROW: Read matching row
.select line 'H|selectedRow'
.continue NEXT ? _G|success
..
.. Read group header
.input 'M|grpHead' ? _F|empty(M|grpHead)
..
.. Read table fop
.input 'M|tab' ? _F|empty(M|tab)
..
.. Read group footer
.input 'M|grpFoot' ? _F|empty(M|grpFoot)
..
!NEXT: Read next record
.select continue
.continue HASNEXT
..
!FOOTER: Read report footer
.input 'M|reportFoot' ? _F|empty(M|reportFoot)
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Database ist missing!
.error -message Keine Datenbank angegeben!
.end 1
..
!ERROR02: This is no row by row query!
.error -message Das ist keine Zeilenselektion!
.end 1
