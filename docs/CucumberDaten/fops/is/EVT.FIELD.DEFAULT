..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EVT.FIELD.DEFAULT
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Bearbeitet feldaus, feldfuell und feldpruef und setzt ggf. einen
..                  vom Aufrufer definierten, kompatiblen Feldwert, welcher
..                  sich in der FO-Variablen U|evtdefault zu befinden hat.
.. Functionality  : This FOP may be used during the field events "feldaus (field exit)"
..                  "feldfuell (field filled)" and/or "feldpruef (field check)" and
..                  sets a default value if one is defined in a compatible FO
..                  variable named U|evtdefault.
..*****************************************************************************
..
.set trans -
..
.continue 'F|toupper(G|evtart)'
..
..*****************************************************************************
!FELDAUS
..*****************************************************************************
.continue END ? _F|empty(M|.G|evtvar)
.continue S1A ?  F|defined(U|evtdefault)
.continue ERR01
..
!S1A
.continue ERR01 ? _F|compatible(F|typeof(M|.G|evtvar), F|typeof(U|evtdefault))
.copy M|.G|evtvar = U|evtdefault
.continue END
..
..*****************************************************************************
!FELDPRUEF
..*****************************************************************************
.continue FELDAUS
..
..*****************************************************************************
!FELDFUELL
..*****************************************************************************
.continue END ? _F|empty(G|evtfeldneu)
.continue S2A ?  F|defined(U|evtdefault)
.continue ERR01
..
!S2A
.continue ERR01 ? _F|compatible(F|typeof(M|.G|evtvar), F|typeof(U|evtdefault))
.formula G|evtfeldneu = 'U|evtdefault(L="0")'
..*****************************************************************************
!END
.continue
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error -line 'G|evtzeile' -field 'G|evtvar' -message Bitte eintragen.
.end 1
