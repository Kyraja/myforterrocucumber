..!interpreter english translate noabbrev
.continue START
..*****************************************************************************
.. FOP-Name       : PRINT.RUN.LEVEL
.. Autor          : lei
.. Verantwortlich : mg
.. Kontrolle      :
.. Funktion       :
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
.. Starte eine neuen Ebene im generierten Ablaufplan
..     Parameter:
..        T|xkapebene:  Die Ebene des konkreten Ablaufplan
..        P|akttmp:     Das Temporaerverzeichnis
..
..    verwendet die Variablen xerr xsys xout
..
..
..*****************************************************************************

.set trans -

!START
.assign T|xakt = P|akttmp + "KAP." + 'T|xkapebene'
.assign T|xout = T|xakt + ".OUT"
.assign T|xerr = T|xakt + ".ERR"
.assign T|xsys = T|xakt + ".RUN"
.output new 'T|xsys'
PATESTFLAGGEN="'E|PATESTFLAGGEN'" sed "s/tsdtrenn=@@/tsdtrenn= /" 'T|xakt' | edpimport.sh -P -H 'F|expr(T|xakt+".WRN")' > 'T|xout' 2> 'T|xerr'
.output terminal
.system 'F|expr("sh "+T|xsys)' password background
.continue ERR1 ? F|filenotempty(T|xerr)
.continue


!ERR1
.error Fehlermeldungen in: 'T|xerr'
'xsys'
.input -text 'T|xerr'
.error Datenbeschaffung auf Ebene 1 gescheitert
.end 1
