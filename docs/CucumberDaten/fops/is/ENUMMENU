..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : ENUMMENU
..  Datum          : 07.09.2006
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : fwester
..  Funktion       : Generierung eines MenÅs zu einer AufzÑhlung und Setzen eines
..                   Felds zu dieser AufzÑhlung in einer Maske.
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xtenumfield  Zielfeld (ohne "M|"!)
..    xienumcount  Anzahl definierter ArrayeintrÑge fÅr AufzÑhlungspositionen
..    xienumentry  INT-Array bei 1 beginnend bis xienumcount mit Nummern der im MenÅ gewÅnschten Positionen
..
..  Ablauf         :
..
..  Functionality  : Generates a menu for enumeration positions and sets the value
..                   chosen in a mask variable.
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xtenumfield  Destination enumeration field (without "M|"!)
..    xienumcount  Number of defined array entries for enumeration positions
..    xienumentry  INT Array from 1 to xienumcount with numbers of valid enumeration positions
..
..  Program flow  :
... Includes      :
..*****************************************************************************
.set trans -
.continue END   ? G|evtartengl = "NO_EVENT"
..
.. No Infosystem destination field defined
.continue ERR01 ? _F|defined(U|xtenumfield)
.continue ERR06 ? _F|defined(M|.U|xtenumfield)
..
.. no enum entry array size defined
.continue ERR02 ? _F|defined(U|xienumcount)
.continue ERR02 ? U|xienumcount < 1
..
.type text xxtenumtype    ? _F|defined(U|xxtenumtype)
..
.formula U|xxtenumtype = F|typeof(M|.U|xtenumfield)
..
.. no built-in enum type
.continue ERR03 ? _(U|xxtenumtype/("A*"))
..
.type integer  xxienumindex   ? _F|defined(U|xxienumindex)
.type integer  xxienumposi    ? _F|defined(U|xxienumposi)
.type text xxtmenu        ? _F|defined(U|xxtmenu)
..
..*****************************************************************************
!NL: Get enum number from type
..*****************************************************************************
.formula U|xxtenumtype = U|xxtenumtype << -1
.continue NL ? _(U|xxtenumtype/("(0-9)*"))
..
.set enumerationtype 'U|xxtenumtype'
.. Wenn "mehr" hier false ist, dann ist etwas anderes grundlegend
.. falsch, da die Nummer der AufzÑhlung ja aus der Art einer
.. Maskenvariablen stammt.
..
.. Array size exceeds enum array size
.continue ERR04 ? U|xienumcount > G|enumnumpos
..
.formula U|xxienumindex = 0
.formula U|xxtmenu      = ""
..
..*****************************************************************************
!MLOOP: Build menu entries
..*****************************************************************************
.formula U|xxienumindex = U|xxienumindex + 1
.continue MSHOW ? U|xxienumindex > U|xienumcount
.continue ERR05 ? _F|defined(U|xienumentry.U|xxienumindex)
.formula U|xxienumposi = U|xienumentry.U|xxienumindex
.continue ERR04 ? U|xxienumposi > G|enumnumpos
.formula U|xxtmenu = U|xxtmenu + 'G|enumpostext.U|xxienumposi' + " " + 'G|trennerchar'
.continue MLOOP
..
..*****************************************************************************
!MSHOW
..*****************************************************************************
.menu 'G|enumdescr'
'U|xxtmenu                    '
.continue END ? G|menue = 0
..
..*****************************************************************************
!SETVAL
..*****************************************************************************
.formula U|xxienumposi = U|xienumentry.G|menue
.assign M|.U|xtenumfield = "(" + 'G|enumposcode.U|xxienumposi' + ")"
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error -message Kein Zielfeld angegeben.
.end 1
..
..*****************************************************************************
!ERRO2
..*****************************************************************************
.error -message Keine Arraygrî·e angegeben.
.end 1
..
..*****************************************************************************
!ERR03
..*****************************************************************************
.error -message Das Zielfeld ist keine StandardaufzÑhlung.
.end 1
..
..*****************************************************************************
!ERR04
..*****************************************************************************
.error -message Maximaler AufzÑhlungsindex Åberschritten.
.end 1
..
..*****************************************************************************
!ERR05
..*****************************************************************************
.error -message Arraygrî·enangabe passt nicht zu den ArrayeintrÑgen.
.end 1
..
..*****************************************************************************
!ERR06
..*****************************************************************************
.error -message Das Zielfeld existiert nicht.
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
