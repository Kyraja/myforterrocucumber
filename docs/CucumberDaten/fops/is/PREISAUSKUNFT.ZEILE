..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PREISAUSKUNFT.ZEILE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       : Informationen zu Staffelpreis, Rahmenauftrag und Staffelrabatt
..                  typ aus Preisauskunft: AS211
.. Functionality  : allows table price informations for    
..                  three types of sources 
..                  ScalePrice/BlanketOrder/ScaledDiscount
.. include is/PREISAUSKUNFT.ZEILE2
..*****************************************************************************
.set trans -
.type VP99     xpaherkunft1  ? _F|defined(U|xpaherkunft1)
.type VP99     xpaherkunft2  ? _F|defined(U|xpaherkunft2)
.type VP99     xpaherkunft3  ? _F|defined(U|xpaherkunft3)
.type integer  xzn           ? _F|defined(U|xzn)
.type T150     xrabatt       ? _F|defined(U|xrabatt)
..
.input "is/PREISAUSKUNFT.ZEILE2" ? G|evtvar = "preisauskunft" ; M|hintergrund ; G|evtvar = "tpreisopt"
.continue END  ? H|tzeilen = 0
.formula U|xzn = 1
..
!FIRSTLINE: for information of "scale price" and "blanket order" only the first line is necessary
.select line 'U|xzn'
.continue END   ? _G|mehr
.assign U|xpaherkunft1 = ""
.assign U|xpaherkunft2 = ""
.assign U|xpaherkunft3 = ""
.formula U|xrabatt = ""
.. Staffelpreis
.assign U|xpaherkunft1 = H|herkunft^id   ? F|equals(H|typ, "(ScalePrice)")
.. Rahmenauftrag
.assign U|xpaherkunft2 = H|herkunft^id   ? F|equals(H|typ, "(BlanketOrder)") & _U|xpaignrahmen
..
!SCALE: more than one scaled discount possible
.. Staffelrabatt
.assign U|xpaherkunft3 = H|herkunft^id   ? F|equals(H|typ, "(ScaledDiscount)")
.formula U|xzn = U|xzn + 1 
.formula U|xrabatt = U|xrabatt + 'U|xpaherkunft3^id' + ";"  ? _F|empty(U|xrabatt) & _F|empty(U|xpaherkunft3)
.formula U|xrabatt = 'U|xpaherkunft3^id' + ";"              ?  F|empty(U|xrabatt) & _F|empty(U|xpaherkunft3)
.continue END ? U|xzn > H|tzeilen
..
!SELLINE
.select line 'U|xzn'
.continue END      ? _G|mehr
.continue SCALE
..
..*****************************************************************************
!END
.continue
