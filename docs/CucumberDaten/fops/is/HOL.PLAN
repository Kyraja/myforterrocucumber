..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : HOL.PLAN
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Holen der einstufigen Liste fuer die Plankarte
..                  Ist im Infosystemkopf die Variable M|foprefix
..                  gesetzt, so wird dieser Prefix vor die FOP-Namen
..                  in M|bkopf, M|bfuss und M|tab gesetzt.
..                  Auf diese Weise koennen die Holverfahren fuer
..                  die Wochen- und Einzelansicht der Plankarte ueber-
..                  sichtlich getrennt werden, z.B. mit M|foprefix="W":
..
..                  Einzelansicht          Wochenansicht
..                  la/PLAN.BKOPF          la/WPLAN.BKOPF
..                  la/PLAN.BFUSS          la/WPLAN.BFUSS
..                  la/PLAN.TAB            la/WPLAN.TAB
..
..                  Setzt Artikel (kart) und Lagergruppe (klgruppe) im
..                  Maskenkopf voraus. Im Berichtskopf (bkopf) ist der
..                  Artikel bereits im "H"-Puffer geladen und an die
..                  Lagergruppe angepasst.
..*****************************************************************************
.set trans -
.type text xbkopf xprefix xbfuss xtab x1 x2
..
.formula U|xprefix = ""
.formula U|xprefix = M|foprefix ? F|defined(M|foprefix)

.formula U|xbkopf = M|bkopf
.continue BFUSS              ? U|xbkopf="" ; U|xprefix = ""
.formula U|x1     = M|bkopf <<"/"
.formula U|x2     = M|bkopf >>"/"
.formula U|xbkopf = U|x1 + "/" + U|xprefix + U|x2 ? U|x2<>""
.formula U|xbkopf = U|xprefix + U|x1              ? U|x2= ""
!BFUSS
.formula U|xbfuss = M|bfuss
.continue TAB                ? U|xbfuss="" ; U|xprefix = ""
.formula U|x1     = M|bfuss <<"/"
.formula U|x2     = M|bfuss >>"/"
.formula U|xbfuss = U|x1 + "/" + U|xprefix + U|x2 ? U|x2<>""
.formula U|xbfuss = U|xprefix + U|x1              ? U|x2= ""
!TAB
.formula U|xtab   = M|tab
.continue ARTIKEL            ? U|xtab=""   ; U|xprefix = ""
.formula U|x1     = M|tab   <<"/"
.formula U|x2     = M|tab   >>"/"
.formula U|xtab   = U|x1 + "/" + U|xprefix + U|x2 ? U|x2<>""
.formula U|xtab   = U|xprefix + U|x1              ? U|x2= ""
..
!ARTIKEL
.. Artikel an die Lagergruppe anpassen
.select add M|kart
.formula H|lgruppean = M|klgruppe^id
.input 'U|xbkopf' ? U|xbkopf<>""
!HOL0
.select planchart
.continue END0 ? _G|mehr
.input 'U|xtab'   ? U|xtab<>""
.continue HOL0
!END0
.input 'U|xbfuss' ? U|xbfuss<>""
.continue
