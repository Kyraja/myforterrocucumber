..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.OPEN.KANAL
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet einen Ordner der Schluesselart M|kanal. Dieser
.. hat kein oder viele Drucklayouts. Jedes Drucklayout ist ein Ordner.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens a node with a key of the type M|kanal. This has
.. none or many print layouts. Each print layout ist a node.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Do we have any layouts for this channel?
.formula M|select = "$,,;kontext==" + M|wurzel^id
.formula M|select = M|select + ";kanal==" + M|kdatenobjekt^id
.formula M|select = M|select + ";aktiv=" + 'G|TRUE' ? M|nuraktive
.formula M|select = M|select + ";@gruppe=3.8;@ablageart=(Active)"
.load 9 printparameter 'M|select'
..
!CHECK
.continue END  ? _G|mehr
.continue ROW ? M|generierte
.continue PRINT1 ? 9|gruppe = 3
..
.. Parameter layout
.continue ROW ? _9|gendgfop
.continue NEXT
..
!PRINT1: Print layout
.continue ROW ? _(9|genlayout & 9|gendgfop)
.continue NEXT
..
!ROW
.assign M|kdatenobjekt = 9|id
.formula M|kbaumtext = '9|grbez'
.assign M|kbauminfo = 9|sucherw
.assign M|kname = 9|sucherw
.copy M|kschluessel = M|layout
.assign M|kbaumstat = ""
.copy M|kpaket = 9|paket
.copy M|kaktiv = 9|aktiv
.copy M|kgeneriert = G|FALSE
.copy M|kexist = G|TRUE
.continue PRINT2 ? 9|gruppe = 3
..
.. Parameter layout
.assign M|kbaumstat = "+" ? _F|empty(9|datagenfop)
.continue SHOW
..
!PRINT2: Print layout
.assign M|kbaumstat = "+" ? _(F|empty(9|layname) & F|empty(9|datagenfop))
..
!SHOW
.input 'M|tab' ? _F|empty(M|tab)
..
!NEXT
.load 9 printparameter
.continue CHECK
..*****************************************************************************
!END
.continue
