..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : INFOSYSTEILE.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Oeffnet den Verwendungsbaum bis zur Stufe M|anzstufen.
.. Ablauf         : Button-nach-EFOP des Feldes "bstart"
..
.. Functionality  : Opens where-used list to the level M|anzstufen.
.. Program flow   : Button after EFOP of the item "bstart"
..*****************************************************************************
.set trans -
..
.. Create a root node for the infosystem record:
.add M|wurzel
.continue END ? _G|mehr
.assign M|kbaumtext = 'D|grbez'
.assign M|kbauminfo = D|sucherw
.assign M|kname = D|sucherw
.copy M|kschluessel = M|infosys
.assign M|kbaumstat = "+"
.copy M|kpaket = D|paket
.copy M|kaktiv = G|TRUE
.copy M|kgeneriert = G|FALSE
.copy M|kexist = G|TRUE
.input 'M|tab' ? _F|empty(M|tab)
.add
..
.. Open all nodes in table to level M|anzstufen
.select screen header
..
!NEXTROW: Next mask row
.select screen line
.continue END ? _G|mehr
.continue NEXTROW ? M|tbaumstat <> "+"
.assign M|stufe = M|tbaumstufe + 1
.continue NEXTROW ? M|anzstufen < M|stufe
.assign M|tbaumstat = "-"
.copy M|tbaumiconz = M|kordnerauf
.formula M|kklappzeile = M|aktzeile
.input 'M|openknot' ? _F|empty(M|openknot)
.select screen line 'M|kklappzeile'
.continue NEXTROW
..*****************************************************************************
!END
.continue
