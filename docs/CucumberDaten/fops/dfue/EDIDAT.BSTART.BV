.set trans -
..
.continue NOSCHEMA ? F|empty(M|kschema)
.continue NOEDI    ? F|empty(M|kedinum) &  F|empty(M|kdateiname)
..
.formula M|select = "$,,nummer=" + 'M|kschema' + ";@gruppe=1"      ? _F|empty(M|kschema)
.formula M|select = "%,,nummer=;name="+ ";@gruppe=1;@autostart=ja" ?  F|empty(M|kschema)
..
!END
.continue
..
..
!NOSCHEMA
.error WÑhlen Sie bitte ein Schema aus.
.cursor kschema 0
.end 1
!NOEDI
.error WÑhlen Sie bitte eine EDI-Nachricht oder EDI-Schnittstelle aus.
.cursor kedinum 0
.end 1
