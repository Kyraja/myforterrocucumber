..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIEINR.GETSETTINGS.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Read all settings shown in info system EDIEINR
..
..  isabefop        B       EDI-EFOPs aktiviert?
..  isziempfverz    GL30    Empfangsverzeichnis
..  isibempfverz    B       Empfangsverzeichnis angelegt?
..  isibgaref       B       Referenzdatensatz angelegt?
..  isibgaflag      B       Flagfile angelegt?
..  isibedlref      B       Referenzdatensatz angelegt?
..  isibedlflag     B       Flagfile angelegt?
..  iszesendverz    GL30    Sendeverzeichnis
..  isebsendverz    B       Sendeverzeichnis angelegt?
..  iseblsefop      B       EFOPs aktiviert?
..  iseblszupos     B       Zusatzpositionen angelegt?
..  iseblsversart   B       Versandarten angelegt?
..  isebreefop      B       EFOPs aktiviert?
..  iskprotverz     GL30    Protokollverzeichnis
..  iskbprotverz    B       Protokollverzeichnis vorhanden
..  isedi           B       EDI
..  isautomotive    B       Automotive
..  ispdm           B       PDM/PLM
..  isbman          B       Beh„lterkonten
..
...Includes       :
..  include dfue/EDIEINR.CHECKEFOPS.FO
..  include dfue/EDIEINR.CHECKSUPITEMS.FO
..
...I-Files (must not be included)
..  dfue/DFUE.IMP.INI
..  dfue/DFUE.EXP.INI   
..*****************************************************************************
.set trans -
..
..<META M|='dfue/EDIEINR' > 
..
..
.. isabefop
.type text xfoptxt ? _F|defined(U|xfoptxt)
.type bool xfopactive  ? _F|defined(U|xfopactive)
.formula U|xfoptxt = "dfue/fop.txt.allg"
.input "dfue/EDIEINR.CHECKEFOPS.FO"
.copy M|abefop = U|xfopactive
..
.. isziempfverz
.type text U|xEmpfangsVerz ? _F|defined(U|xEmpfangsVerz)
.formula U|xEmpfangsVerz = ""
.input "dfue/DFUE.IMP.INI"
.formula M|ziempfverz = U|xEmpfangsVerz
..
.. isibempfverz :: test -d "dfue/empfangen" 
.system 'F|formatstr("test -d {1}{2}{1}", G|dblquote, U|xEmpfangsVerz)' background
.copy M|ibempfverz = G|mehr
..
.. isibgaref
.select edifact "R-VKGAV"
.copy M|ibgaref = G|mehr
.select -
..
.. isibgaflag :: test -f "dfue/empfangen/VKGAVOK"
.system 'F|formatstr("test -f {1}{2}/{3}{1}", G|dblquote, U|xEmpfangsVerz, "VKGAVOK")' background
.copy M|ibgaflag = G|mehr
..
.. isibedlref
.select edifact "R-VKEDL"
.copy M|ibedlref = G|mehr
.select -
..
.. isibedlflag :: test -f "dfue/empfangen/VKEDLOK"
.system 'F|formatstr("test -f {1}{2}/{3}{1}", G|dblquote, U|xEmpfangsVerz, "VKEDLOK")' background
.copy M|ibedlflag = G|mehr
..
.. iszesendverz    
.type text U|xSendeVerz ? _F|defined(U|xSendeVerz)
.formula U|xSendeVerz = ""
.input "dfue/DFUE.EXP.INI"
.formula M|zesendverz = U|xSendeVerz
..
.. isebsendverz
.system 'F|formatstr("test -d {1}{2}{1}", G|dblquote, U|xSendeVerz)' background
.copy M|ebsendverz = G|mehr
..
.. iseblsefop
.formula U|xfoptxt = "dfue/fop.txt.lsdfue"
.input "dfue/EDIEINR.CHECKEFOPS.FO"
.copy M|eblsefop = U|xfopactive
..
.. iseblszupos
.type bool xsupactive  ? _F|defined(U|xsupactive)
.input "dfue/EDIEINR.CHECKSUPITEMS.FO"
.copy M|eblszupos = U|xsupactive
..
.. iseblsversart
.select company "$,,;@gruppe=3;such=VA-01"
.copy M|eblsversart = G|mehr
.select -
..
.. isebreefop
.formula U|xfoptxt = "dfue/fop.txt.vkre"
.input "dfue/EDIEINR.CHECKEFOPS.FO"
.copy M|ebreefop = U|xfopactive
..
.. iskprotverz
.formula M|kprotverz = "batchlg.spooler"
..
.. iskbprotverz
.formula M|kbprotverz = F|fileexists(M|kprotverz)  &  F|isdir(M|kprotverz)
..
.. isedi
.copy M|edi = F|sysinfo(18)^edi
..
.. isautomotive
.copy M|automotive = F|sysinfo(18)^automotive
..    
.. ispdm
.copy M|pdm = F|sysinfo(18)^pdm
..
.. isbman
.copy M|bman = F|sysinfo(18)^bman
..
..*****************************************************************************
!END
.continue
