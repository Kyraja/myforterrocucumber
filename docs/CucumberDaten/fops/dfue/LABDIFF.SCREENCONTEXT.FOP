..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LABDIFF.SCREENCONTEXT.FOP
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : set P|maskkontextfop (english: ScreenContextFOP)
..*****************************************************************************
.set trans -
..
.. GET CURRENT SCREEN CONTEXT
.type bool bishistory ? _F|defined(U|bishistory)
.type bool biscompare ? _F|defined(U|biscompare)
.type bool bissingle  ? _F|defined(U|bissingle)
.type bool bisdefault ? _F|defined(U|bisdefault)
..
.formula U|bishistory = ( P|maskkontextfop/"*history*" )
.formula U|biscompare = ( P|maskkontextfop/"*difflist*" ) &  ( P|maskkontextfop/"*labfab*" ) & _( P|maskkontextfop/"*vab*" )
.formula U|bissingle  = ( P|maskkontextfop/"*difflist*" ) & _( P|maskkontextfop/"*labfab*" ) &  ( P|maskkontextfop/"*vab*" )
.. Default: difflist with vab as well as labfab fields
.formula U|bisdefault = ( P|maskkontextfop/"*difflist*" ) &  ( P|maskkontextfop/"*labfab*" ) &  ( P|maskkontextfop/"*vab*" )
..
..
.. GET EVENT WHICH CALLED THIS EFOP
.type bool  bhistorybutton? _F|defined(U|bhistorybutton)
.type bool  bdiffbutton   ? _F|defined(U|bdiffbutton)
.type bool  bscreenenter  ? _F|defined(U|bscreenenter)
.type bool  bfieldexit    ? _F|defined(U|bfieldexit)
..
.formula U|bhistorybutton = ( G|evtartengl/"BUTTON*" ) & ( G|evtvar="kbuhisau" )
.formula U|bdiffbutton    = ( G|evtartengl/"BUTTON*" ) & ( G|evtvar="kbudiffliste" ; G|evtvar="bstart" ; G|evtvar="tbudiffliste" )
.formula U|bscreenenter   = ( G|evtartengl="SCREEN_ENTER" )
.. Parameter fields are used for difflist AND history !
.formula U|bfieldexit     = ( G|evtartengl="FIELD_EXIT" )
..
..
.. MESSAGE OF PRIMARY EDI OBJECT
.type bool bforecast     ? _F|defined(U|bforecast)
.type bool bpickupsheet  ? _F|defined(U|bpickupsheet)
..
.formula U|bforecast    = ( M|klabedinachr^nummer="2101" ; M|klabedinachr^nummer="2102" )
.formula U|bpickupsheet = ( M|klabedinachr^nummer="2104" )
..
..
.. EVALUATE TO BET SET SCREEN CONTEXT
.type bool bsethistory ? _F|defined(U|bsethistory)
.type bool bsetcompare ? _F|defined(U|bsetcompare)
.type bool bsetsingle  ? _F|defined(U|bsetsingle)
.type bool bsetdefault ? _F|defined(U|bsetdefault)
..
.formula U|bsethistory =   U|bhistorybutton
.formula U|bsetcompare = ( U|bdiffbutton & U|bforecast    ) ; ( U|bfieldexit & _U|bishistory & U|bforecast )
.formula U|bsetsingle  = ( U|bdiffbutton & U|bpickupsheet ) ; ( U|bfieldexit & _U|bishistory & U|bpickupsheet )
.formula U|bsetdefault =   U|bscreenenter
..
..
..
.. .input "DATEI.F"
..
.. bishistory 'bishistory '  , bhistorybutton 'bhistorybutton '  , bsethistory 'bsethistory '
.. biscompare 'biscompare '  , bdiffbutton    'bdiffbutton    '  , bsetcompare 'bsetcompare '  , klabedinachr 'klabedinachr^nummer' 'klabedinachraz'
.. bissingle  'bissingle  '  , bscreenenter   'bscreenenter   '  , bsetsingle  'bsetsingle  '
.. bisdefault 'bisdefault '  , bfieldexit     'bfieldexit     '  , bsetdefault 'bsetdefault '
..
..
..
.. SET NEW SCREEN CONTEXT
.. ----------- ----- -------------------------- --------------------------------
.continue HISTORY  ? U|bsethistory & _U|bishistory
.continue COMPARE  ? U|bsetcompare & _U|biscompare
.continue SINGLE   ? U|bsetsingle  & _U|bissingle
.continue DEFAULT  ? U|bsetdefault & _U|bisdefault
.. ----------- ----- -------------------------- --------------------------------
.continue END
..
..
!HISTORY
.formula P|maskkontextfop = "FOP_history"
.. Switch to recently enabled register
.cursor klabdiffstart 0
.continue END
..
..
!COMPARE
.. Show table for difflist and registers for comparission of 2 most recent forecasts
.formula P|maskkontextfop = "FOP_difflist FOP_labfab"
.. Switch to recently enabled register
.cursor klab2nummer 0
.continue END
..
..
!SINGLE
.. Show table for difflist and registers for current pick-up sheet
.formula P|maskkontextfop = "FOP_difflist FOP_vab"
.. Switch to recently enabled register
.cursor klab2nummer 0
.continue END
..
..
!DEFAULT
.. Show table all difflist fields and registers until message (type) has been chosen
.formula P|maskkontextfop = "FOP_difflist FOP_labfab FOP_vab"
.. Switch to recently enabled register
.cursor krahmen 0
.continue END
..
..
..*****************************************************************************
!END
.continue
