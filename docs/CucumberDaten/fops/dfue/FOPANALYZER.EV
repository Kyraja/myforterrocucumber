..!interpreter english translate noabbrev
..<META M|='dfue/FOPANALYZER' > 
..*****************************************************************************
.. Name           : FOPANALYZER.EV
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Functionality  : Events for infosystem FOPANALYZER
...Includes       :
..   include  dfue/FOPANALYZER.FOPS.FOLABWEG
..   include  dfue/FOPANALYZER.FOPS.FOORDERSWEG
..   include  dfue/FOPANALYZER.FOPS.VORB1
..   include  dfue/FOPANALYZER.FOPS.VORB2 
..*****************************************************************************
.set trans -
..
.. event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kstdverz"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kindivverz"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar / "fop*"
.continue VORB0   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbvorbelegungabruf"
.continue VORB3   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbvorbelegungorder"
.continue VORB1   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbvorbelegung1"
.continue VORB2   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbvorbelegung2"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "karb"
.. ----------- ---------- ---------- -------------------------------------------
.continue SHOWSTD ?  G|evtartengl = "BUTTON_AFTER" &  G|evtvar = "tbustdbearbeiten"
.continue SHOWIND ?  G|evtartengl = "BUTTON_AFTER" &  G|evtvar = "tbuindbearbeiten"
.continue COPY    ?  G|evtartengl = "BUTTON_AFTER" &  G|evtvar = "kbukopieren"
.continue MARK    ?  G|evtartengl = "BUTTON_AFTER" &  G|evtvar = "kbualle"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!SHOWSTD
.command -parallel 'F|formatstr("<(Text)>{1}<(Edit)>", M|tstdprogramm)' ? M|tbstandard
.. .editing -readonly 'M|tstdprogramm' ? M|tbstandard
.continue END
..
!SHOWIND
.command -parallel 'F|formatstr("<(Text)>{1}<(Edit)>", M|tindprogramm)' ? M|tbindividuell
.. .editing 'M|tindprogramm' ? M|tbindividuell
.continue END
.. 
!MARK
.select screen header
!NMARK
.select screen line
.continue END ? _G|mehr
.copy M|tmark = G|true
.continue NMARK
.. 
!COPY
.type text foprogramm
.select screen header
!NCOPY
.select screen line
.continue END ? _G|mehr
.continue NCOPY ? _M|tmark
.continue NCOPY ? _M|tbstandard ; M|tbindividuell 
.system 'F|formatstr("cp {1} {2}", M|tstdprogramm, M|tindprogramm)' background
.formula U|foprogramm = M|tprogramm
.input 'M|tab'
.continue NCOPY
.. 
!VORB0
.input "FOPANALYZER.FOPS.FOLABWEG"
.continue INIT
..
!VORB1
.input "FOPANALYZER.FOPS.VORB1"
.continue INIT
.. 
!VORB2
.input "FOPANALYZER.FOPS.VORB2"
.continue INIT
..
!VORB3
.input "FOPANALYZER.FOPS.FOORDERSWEG"
.continue INIT
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
