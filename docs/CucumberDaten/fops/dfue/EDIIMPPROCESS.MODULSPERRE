..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIIMPPROCESS.MODULSPERRE
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : EDI-Modul-Sperre - Testen, Setzen und Loeschen
.. Functionality  : EDI module lock - test, set, remove
..*****************************************************************************
.set trans -
..
.type bool xprocreturn   ? _F|defined(U|xprocreturn)
.type integer  xaktion       ? _F|defined(U|xaktion)
.type text xmmvvl        ? _F|defined(U|xmmvvl)
.type text xlockname     ? _F|defined(U|xlockname)
..
.. Default return value
.copy U|xprocreturn = G|false
..
.. Set lock name
.formula U|xlockname = "EDI.LOCK." + 'U|xmmvvl' 
..
..  Action
.. ----------- ---------- ----------
.continue SETZEN  ?  U|xaktion= 1
.continue LOESCH  ?  U|xaktion= 2
.. ----------- ---------- ----------
.continue END
..
..
!SETZEN
.occupy 'U|xlockname'
.continue LOCKED  ? _G|gesperrt
.copy U|xprocreturn = G|true
.continue END
..
!LOESCH
.occupy
.copy U|xprocreturn = G|true
.continue END
..
..*****************************************************************************
!END
.continue
.. 
.. 
!LOCKED
.error Die EDI-Verarbeitung ist gesperrt.
.end 1
