..!interpreter english translate noabbrev
..!meta M|=dfue/EDLGES
..*****************************************************************************
.. Name           : EDLGES.EV
.. Autor          : mh/ok
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : General eventhandling for Onfosystem EDLGES
..*****************************************************************************
.set trans -
..
..
.. Event evaluation
.. ----------- ----- Header events ---------------------------------------------
.continue KUNDE   ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kkunde"
.continue KUNDE2  ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kkunde2"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kedl"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kwerk"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kablstelle"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kartikel"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kdvom"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kdbis"
.continue TABINIT ?  T|evtartengl = "FIELD_EXIT"     &  T|evtvar = "kmitpack"
.. ----------- ----- Header buttons --------------------------------------------
.continue BUGA    ?  T|evtartengl = "BUTTON_AFTER"   &  T|evtvar ="buga"
.. ----------- ----- Table events ----------------------------------------------
.continue FORBID  ?  T|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!KUNDE
.continue TABINIT ?  F|empty(M|kkunde)
.assign M|kkunde2 = M|kkunde^firma^id
.formula M|kwerk = M|kkunde^werk
.formula M|kablstelle = M|kkunde^ablstelle
.continue TABINIT
..
!KUNDE2
.continue TABINIT ?  F|empty(M|kkunde2)
.continue TABINIT ?  M|kkunde^firma^id = M|kkunde^id
.formula M|kkunde = ""
.formula M|kwerk = ""
.formula M|kablstelle = ""
.continue TABINIT
..
!BUGA
.command -parallel 'F|formatstr("(Infosystem) EDIGA ? kganum={1} | bstart=", M|tganr)'
.continue END
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
