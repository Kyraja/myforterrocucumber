..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.ORDERS.PRICEUNIT
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Find price unit from edimessage
..*****************************************************************************
.set trans -
..
.continue END ? _U|xbpreisausedi
..
.type text    xtunitzeile ? _F|defined(U|xtunitzeile)
.type integer xstatus     ? _F|defined(U|xstatus)
.type integer xfcode      ? _F|defined(U|xfcode)
..
.input DATEI.F
.output addedto 'U|xtfehler'
..
!UNIT
.select screen line
.select screen line 'U|xaktzeile' ? U|xbsingle
.continue END    ? _G|mehr
.continue UNIT  ?  F|empty(M|edipe)
..
.type text U|xeinhmge ? _F|defined(xeinhmge)
.type text U|xposphe  ? _F|defined(U|xposphe)
.formula U|xeinhmge = M|edipe
.formula U|xposphe = U|xeinhmge
.formula U|xtunitzeile = M|aktzeile
.input "EDI.UNITS"
..
.. Einheit nicht gefunden => Fehler ausgegeben
.continue EUNIT ? F|empty(U|etaz)
..
.formula M|peinheit = U|etaz
.colour -background -1 -1 -1 peinheit 'M|aktzeile'
.continue UNIT ? _U|xbsingle
..
..*****************************************************************************
!END
.formula U|xstatus = 4 ? _F|empty(U|xfcode)
..
.. release buffers
.load 1 ? F|defined(1|id)
.continue
..
!EUNIT
..
'U|xaptext1'
..
.formula U|xfcode  = U|xapfcode
.colour -background 'U|xabasyellow' peinheit 'M|aktzeile'
..
.continue UNIT ? _U|xbsingle
