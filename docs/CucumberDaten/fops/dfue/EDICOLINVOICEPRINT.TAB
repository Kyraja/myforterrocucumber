..!interpreter english translate noabbrev
..!meta M|=dfue/EDICOLINVOICEPRINT
..*****************************************************************************
.. Name           : EDICOLINVOICEPRINT.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : Fills fields in info system from rows in edi message
..                  Rows for VDA and EDIFACT have different records / record types
..*****************************************************************************
.set trans -
..
.type bool vda ? _F|defined(U|vda)
.type bool edifact ? _F|defined(U|edifact)
.type bool odette ? _F|defined(U|odette)
.. 
.type text xt1 ? _F|defined(U|xt1)
.type text xt2 ? _F|defined(U|xt2)
.type text xt3 ? _F|defined(U|xt3)
..
.type text xGutschrift ? _F|defined(U|xGutschrift)
.type text xRechnung   ? _F|defined(U|xRechnung)
.set trans +
.formula U|xGutschrift = "Gutschrift"
.formula U|xRechnung = "Rechnung"
.set trans -
.. 
..!meta H|=P53
.continue SA400V ? H|text1 = "400" &  U|vda
.continue SA500V ? H|text1 = "500" &  U|vda
.continue SA600V ? H|text1 = "600" &  U|vda
.continue SA100E ? H|text1 = "100" & (U|edifact;U|odette)
.continue SA101E ? H|text1 = "101" & (U|edifact;U|odette)
.continue SA102E ? H|text1 = "102" & (U|edifact;U|odette)
.continue SA103E ? H|text1 = "103" & (U|edifact;U|odette)
.continue SA104E ? H|text1 = "104" & (U|edifact;U|odette)
.continue SA105E ? H|text1 = "105" & (U|edifact;U|odette)
.continue SA300E ? H|text1 = "300" & (U|edifact;U|odette)
.continue SA400E ? H|text1 = "400" & (U|edifact;U|odette)
.continue END
..
..
!SA400V: VDA-Vorsatz 811
.make screen line +O
.formula M|tlieferschein = H|text4
.continue END
..
..
!SA500V
.formula M|kersterechnung = h|text3 ? F|empty(M|kersterechnung)
.formula M|kletzterechnung = h|text3
.formula M|kwaehrung  = h|text7 ? F|empty(M|kwaehrung)
.formula M|kland = H|text7 ? F|empty(M|kland)
.continue END
..
..
!SA600V
.formula M|kzaehler400 = h|text3
.formula M|kzaehler500 = h|text4
.formula M|kzaehler525 = h|text5
.formula M|kzaehler550 = h|text6
.formula M|kzaehler600 = h|text7
.formula M|kzaehleralle = M|kzaehler400 + M|kzaehler500 + M|kzaehler525 +  M|kzaehler550 + M|kzaehler600
..
.formula M|krewert = h|text8
.formula M|kentgelt1 = h|text9
.formula M|kumst1    = h|text10
.formula M|kumsatz1  = h|text11
.formula M|kentgelt2 = h|text12
.formula M|kumst2    = h|text13
.formula M|kumsatz2  = h|text14
.continue END
..
..
!SA100E
.make screen line +O
.formula M|trechnung = H|text3
.formula M|ttypnachricht = H|text4
.formula M|tbelegart = H|text6
.formula M|tbelegartbez = U|xRechnung   ? 'M|tbelegart'="380"
.formula M|tbelegartbez = U|xGutschrift ? 'M|tbelegart'="381"
.formula M|tauftrag = text11
.formula M|tauftragsdatum = H|text12
.formula M|tlieferschein = H|text13
.formula M|tlieferscheindatum = H|text14
.continue END
..
..
!SA101E
.formula M|trechnungsdatum = H|text3
.formula M|tvalutatage = H|text10
.formula M|tvalutadatum = H|text11
.formula M|tland = H|text12
.formula M|kland = H|text12 ? _F|empty(H|text12)
.continue END
..
..
!SA102E
.. Daten stehen im Kopf
.continue END
..
..
!SA103E
.. Daten stehen im Kopf
.continue END
..
..
!SA104E
.. Daten stehen im Kopf
.continue END
..
..
!SA105E
.formula M|kkugln = H|text3
.continue END
..
..
!SA300E
.continue SA300EX ? F|empty(M|tstsatz)
.formula U|xt1 = M|trechnung
.formula U|xt2 = M|trechnungsdatum
.formula U|xt3 = M|tland
.make screen line +
.formula M|trechnung = U|xt1
.assign  M|trechnungsdatum = U|xt2
.formula M|tland = U|xt3
!SA300EX
.formula M|trebetragnetto = H|text3
.formula M|trebetragbrutto = H|text4
.formula M|tstsatz = H|text5
.formula M|tstbetrag = H|text6
.continue END
..
..
!SA400E
.make screen line +O
.formula M|trechnungsenbetrag = H|text3
.formula M|tnettobetragstsatz = H|text4
.formula M|tmwstbetragstsatz = H|text5
.formula M|tsteuersatz = H|text6
.continue END
..
..*****************************************************************************
!END
.continue

