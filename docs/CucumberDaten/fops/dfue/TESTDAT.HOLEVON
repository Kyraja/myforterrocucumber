..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TESTDAT.HOLEVON
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Das FOP importiert aus einem "Skript" mit Import-
..                  Beschreibungen fÅr eine Datenbank Gruppe in das
..                  Infosystem. Dieses Skript sieht dem spÑterem
..                  EDP-Skript schon sehr Ñhnlich.
..                  Beim Lesen des Skripts in das Infosystem werden
..                  weitere Informationen aus der Variablentabelle ermittelt:
..                  u.a. Feldbeschreibung und Feldart
.. Functionality  : This efop imports one "script" with import description
..                  for one database group into the infosystem. The "script"
..                  resembles the final edp script very closely.
..                  While reading the script into the infosystem additional
..                  data is read from the variable table:
..                  e.g. field description and field type
..*****************************************************************************
.set trans -
..
.type text   xtlader     ? _F|defined(U|xtlader)
.type text   xtzeile     ? _F|defined(U|xtzeile)
.type text   xtfeld      ? _F|defined(U|xtfeld)
.type text   xtvname     ? _F|defined(U|xtvname)
.type text   xtrest      ? _F|defined(U|xtrest)
.type integer    xi          ? _F|defined(U|xi)
.type integer    xilen       ? _F|defined(U|xilen)
..
.type text   xtname1     ? _F|defined(U|xtname1)
.type text   xtname2     ? _F|defined(U|xtname2)
.type text   xtname3     ? _F|defined(U|xtname3)
.type text   xtname4     ? _F|defined(U|xtname4)
.type text   xtname5     ? _F|defined(U|xtname5)
.type text   xtname6     ? _F|defined(U|xtname6)
.type text   xtname7     ? _F|defined(U|xtname7)
.type text   xtname8     ? _F|defined(U|xtname8)
.type text   xtname9     ? _F|defined(U|xtname9)
.type text   xtname10    ? _F|defined(U|xtname10)
.type text   xtname11    ? _F|defined(U|xtname11)
.type text   xtname12    ? _F|defined(U|xtname12)
.type text   xtname13    ? _F|defined(U|xtname13)
.type text   xtname14    ? _F|defined(U|xtname14)
.type text   xtname15    ? _F|defined(U|xtname15)
.type text   xtname16    ? _F|defined(U|xtname16)
..
.type text   xtbem1     ? _F|defined(U|xtbem1)
.type text   xtbem2     ? _F|defined(U|xtbem2)
.type text   xtbem3     ? _F|defined(U|xtbem3)
.type text   xtbem4     ? _F|defined(U|xtbem4)
.type text   xtbem5     ? _F|defined(U|xtbem5)
.type text   xtbem6     ? _F|defined(U|xtbem6)
.type text   xtbem7     ? _F|defined(U|xtbem7)
.type text   xtbem8     ? _F|defined(U|xtbem8)
.type text   xtbem9     ? _F|defined(U|xtbem9)
.type text   xtbem10    ? _F|defined(U|xtbem10)
.type text   xtbem11    ? _F|defined(U|xtbem11)
.type text   xtbem12    ? _F|defined(U|xtbem12)
.type text   xtbem13    ? _F|defined(U|xtbem13)
.type text   xtbem14    ? _F|defined(U|xtbem14)
.type text   xtbem15    ? _F|defined(U|xtbem15)
.type text   xtbem16    ? _F|defined(U|xtbem16)
..
.type text   xtart1     ? _F|defined(U|xtart1)
.type text   xtart2     ? _F|defined(U|xtart2)
.type text   xtart3     ? _F|defined(U|xtart3)
.type text   xtart4     ? _F|defined(U|xtart4)
.type text   xtart5     ? _F|defined(U|xtart5)
.type text   xtart6     ? _F|defined(U|xtart6)
.type text   xtart7     ? _F|defined(U|xtart7)
.type text   xtart8     ? _F|defined(U|xtart8)
.type text   xtart9     ? _F|defined(U|xtart9)
.type text   xtart10    ? _F|defined(U|xtart10)
.type text   xtart11    ? _F|defined(U|xtart11)
.type text   xtart12    ? _F|defined(U|xtart12)
.type text   xtart13    ? _F|defined(U|xtart13)
.type text   xtart14    ? _F|defined(U|xtart14)
.type text   xtart15    ? _F|defined(U|xtart15)
.type text   xtart16    ? _F|defined(U|xtart16)
..
.type text   xtselvt    ? _F|defined(U|xtselvt)
.type text   xt1        ? _F|defined(U|xt1)
..
.. remember "first field" that is a tablefield
.type text   xttabellenfeld  ? _F|defined(U|xttabellenfeld)
.formula U|xttabellenfeld = ""
..
.continue END  ?  F|empty(U|xtlader)
.continue END  ?  F|isdir(U|xtlader)
.continue END  ? _F|fileexists(U|xtlader)
.continue END  ? _F|filereadable(U|xtlader)
..
.. first row: field names
!FIRST
.select from 'U|xtlader' xtzeile^
.continue EROW  ? _G|mehr
.continue FIRST ?  U|xtzeile<<1 = "#" ; F|empty(U|xtzeile)
.formula U|xtselvt = "$,,;@gruppe=26;vdn=" + ( U|xtdbgruppe<<":" ) + ";vgr=" + ( U|xtdbgruppe>>":" )
.load 1 company 'U|xtselvt'
.continue ENAME ? _G|mehr
.make screen line +O
.formula M|tdbgruppe = U|xtdbgruppe
.formula U|xi = 0
!NNAME
.formula U|xtfeld = U|xtzeile<<"#"
.formula U|xtvname = ""
.formula U|xilen  = 0 - +U|xtfeld - 1
.formula U|xtrest = U|xtzeile<<U|xilen
.formula U|xtzeile = 'U|xtrest'
.formula U|xi = U|xi + 1
.formula M|tname.xi =  U|xtfeld
.formula M|twert.xi = U|xtfeld
.formula M|tbem.xi  = ""
.. try to find description in vartab
.load 1 header
!NVTROW
.load 1 line
.continue EVTROW  ? _G|mehr
.formula U|xt1 = 1|vname<<-2
.formula U|xtvname = 1|vbeds         ?  U|xt1 = U|xtfeld
.formula M|tbem.xi = 1|vbeds         ?  U|xt1 = U|xtfeld
.formula M|tart.xi = 1|vitf          ?  U|xt1 = U|xtfeld
.formula M|ttabellenfeld = U|xtfeld  ?  U|xt1 = U|xtfeld  &  1|vkt  &  F|empty(M|ttabellenfeld)
.continue NVTROW  ?  F|empty(U|xtvname)
!EVTROW
.. remember name+description for actual data rows
.formula U|xttabellenfeld = M|ttabellenfeld
.formula U|xtname.xi = U|xtfeld
.formula U|xtbem.xi  = U|xtvname
.formula U|xtart.xi  = M|tart.xi
.continue ENAME   ?  U|xi > 15
.continue NNAME   ? _F|empty(U|xtzeile)
!ENAME
..
.. lock row with field names
.protection twert1  'M|aktzeile'
.protection twert2  'M|aktzeile'
.protection twert3  'M|aktzeile'
.protection twert4  'M|aktzeile'
.protection twert5  'M|aktzeile'
.protection twert6  'M|aktzeile'
.protection twert7  'M|aktzeile'
.protection twert8  'M|aktzeile'
.protection twert9  'M|aktzeile'
.protection twert10 'M|aktzeile'
.protection twert11 'M|aktzeile'
.protection twert12 'M|aktzeile'
.protection twert13 'M|aktzeile'
.protection twert14 'M|aktzeile'
.protection twert15 'M|aktzeile'
.protection twert16 'M|aktzeile'
..
..
!NROW
.select from 'U|xtlader' xtzeile^
.continue EROW  ? _G|mehr
.continue NROW  ?  U|xtzeile<<1 = "#" ; F|empty(U|xtzeile)
.make screen line +O
.formula M|tdbgruppe = U|xtdbgruppe
.formula U|xi = 0
!NFIELD
.formula U|xtfeld = U|xtzeile<<"#"
.. careful with dontchange placeholder
.formula U|xilen  = 0 - +U|xtfeld - 1
.formula U|xtrest = U|xtzeile<<U|xilen
.formula U|xtfeld = ""   ? U|xtfeld = "~"
.formula U|xtzeile = 'U|xtrest'
.formula U|xi = U|xi + 1
.formula M|twert.xi = U|xtfeld
.formula M|tname.xi = U|xtname.xi
.formula M|tbem.xi  = U|xtbem.xi
.formula M|tart.xi  = U|xtart.xi
.formula M|ttabellenfeld = U|xttabellenfeld
.continue EFIELD  ?  U|xi > 15
.continue NFIELD  ? _F|empty(U|xtzeile)
!EFIELD
.continue NROW
..
!EROW
..
.make screen line +O
.protection -line 'M|aktzeile'
..
..*****************************************************************************
!END
.continue
