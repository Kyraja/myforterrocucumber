..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.SELECT
.. Author         : ok/mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
...Includes       :
..  include dfue/PRICAT.INIT
..  include dfue/PRICAT.AUSWAHL.FE
..*****************************************************************************
.set trans -
..
.. Start new price list
.input "PRICAT.INIT"
..
.. Missing required argument
.continue NOCUST ? F|empty(M|kunde)
..
.. Validation on M|auswahl triggers efop is/AUSWAHL. which fills M|select
.continue NOQUERY ? F|empty(M|auswahl) & F|empty(M|kpgrnr)
..
..
.. Object selection or not?
.. ----------- ---------- ---------- -------------------------------------------
.continue ORDER    ? _F|empty(M|select)  &  M|auswahl/"%*"
.continue SCREEN   ? _F|empty(M|auswahl) ; _F|empty(M|kpgrnr)
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!SCREEN
.. Validate parts parameter (again) 
.input "PRICAT.AUSWAHL.FE"
.. 
.. Query with parts and product group
.formula M|select = F|formatstr("$,,;@gruppe=1;@ordnung=wgruppe;@numsuch={1};wgruppe={2}", M|auswahl, M|kpgrnr)
.formula M|select = M|select + ";packmit=(No)" ? _M|mitpack
.continue END
..
!ORDER
.formula M|select = M|select + ";@ordnung=wgruppe"
.continue END
..
..*****************************************************************************
!END
.end
..
..
!NOCUST
.error Geben Sie einen Kunden ein!
.end 1
..
!NOQUERY
.error W„hlen Sie die Artikel aus!
.end 1
