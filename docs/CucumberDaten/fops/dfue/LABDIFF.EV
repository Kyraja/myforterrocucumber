..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LABDIFF.ME
.. Autor          : mh/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Allgemeine Events fÅr Infosystem LABDIFF
.. Functionality  : Common events infosystem LABDIFF
..*****************************************************************************
.set trans -
..
.. .art text   xtsel
.type ID87:9 xcallparam
..
.. event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue LSHIS   ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbuhisls"
.continue PRHIS   ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbuhispr"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "klabdiffstart"
.. ----------- ----- -------------------------- --------------------------------
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbdiffkomplett"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbdiffeingang"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbdiffabterm"
.. ----------- ----- Kennzahlen --------------- --------------------------------
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennkurz"
.continue KBOOLM  ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennmonate"
.continue KBOOL   ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennwochen"
.continue KBOOL   ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkenntage"
.continue KBOOL   ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennaktuell"
.continue KBOOLE  ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennerster"
.continue KBOOLL  ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennletzter"
.continue KBBZRM  ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennbzmonat"
.continue KBBZR   ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennbzwoche"
.continue KBBZR   ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkennbztag"
.. ----------- ----- Tabellenteil Abrufhistorie --------------------------------
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "klabhisvon"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "klabhisbis"
.continue ABDIFF  ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbudiffliste"
.. ----------- ----- Tabellenteil -- -------------------------------------------
.continue FORBID  ? G|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!BOOL
.protection -reset klabdiffstart 0  ?  _M|kbdiffkomplett & _M|kbdiffeingang & _M|kbdiffabterm
.formula M|klabdiffstart = "-5"  ? (_M|kbdiffkomplett ; _M|kbdiffeingang ; _M|kbdiffabterm ) &  F|empty(M|klabdiffstart)
.protection  klabdiffstart 0        ?   M|kbdiffkomplett ;  M|kbdiffeingang ;  M|kbdiffabterm
.formula M|klabdiffstart = ""    ? ( M|kbdiffkomplett ;  M|kbdiffeingang ;  M|kbdiffabterm ) & _F|empty(M|klabdiffstart)
.. bool kbdiffkomplett toggled
.copy M|kbdiffeingang  = G|false  ?  G|evtvar = "kbdiffkomplett"  &  M|kbdiffkomplett
.copy M|kbdiffabterm   = G|false  ?  G|evtvar = "kbdiffkomplett"  &  M|kbdiffkomplett
.. bool kbdiffeingang toggled
.copy M|kbdiffkomplett = G|false  ?  G|evtvar = "kbdiffeingang"  &  M|kbdiffeingang
.copy M|kbdiffabterm   = G|false  ?  G|evtvar = "kbdiffeingang"  &  M|kbdiffeingang
.. bool kbdiffabterm toggled
.copy M|kbdiffkomplett = G|false  ?  G|evtvar = "kbdiffabterm"  &  M|kbdiffabterm
.copy M|kbdiffeingang  = G|false  ?  G|evtvar = "kbdiffabterm"  &  M|kbdiffabterm
.continue TABINIT
..
!LSHIS
.assign U|xcallparam = "52614"
.input "st/CALLPARAM.EXEC"
.continue END
..
!PRHIS
.assign U|xcallparam = "52424"
.input "st/CALLPARAM.EXEC"
.continue END
..
!KBOOLM: only one true allowed, default=monate
.copy M|kbkennwochen = _M|kbkennmonate
.copy M|kbkenntage = G|false
.copy M|kbkennaktuell = G|false
.continue TABINIT
..
!KBOOL: only one true allowed
.type bool xb
.formula xb = M|.EVTVAR
.copy M|kbkennmonate = G|true   ? _U|xb
.copy M|kbkennmonate = G|false  ?  U|xb
.copy M|kbkennwochen = G|false  ?  G|evtvar <> "kbkennwochen"
.copy M|kbkenntage   = G|false  ?  G|evtvar <> "kbkenntage"
.copy M|kbkennaktuell= G|false  ?  G|evtvar <> "kbkennaktuell"
.continue TABINIT
..
!KBOOLE
.copy M|kbkennletzter = _M|kbkennerster
.continue TABINIT
..
!KBOOLL
.copy M|kbkennerster = _M|kbkennletzter
.continue TABINIT
..
!KBBZRM: only one true allowed, default=monate
.copy M|kbkennbzwoche = _M|kbkennbzmonat
.copy M|kbkennbztag = G|false
.continue TABINIT
..
!KBBZR
.type bool xb
.formula xb = M|.EVTVAR
.copy M|kbkennbzmonat = G|true   ? _U|xb
.copy M|kbkennbzmonat = G|false  ?  U|xb
.copy M|kbkennbzwoche = G|false  ?  G|evtvar <> "kbkennbzwoche"
.copy M|kbkennbztag   = G|false  ?  G|evtvar <> "kbkennbztag"
.continue TABINIT
..
!ABDIFF
.copy M|klab = M|tedinr
.input "dfue/LABDIFF.KLAB.FA"
.input "dfue/LABDIFF.BSTART.BV"
.input "dfue/LABDIFF.BSTART.BN"
.continue END
..
!INIT: a key field was changed, refresh fields/table
.input "dfue/LABDIFF.LEEREN"
.input "dfue/LABDIFF.BK"
.continue END
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue

