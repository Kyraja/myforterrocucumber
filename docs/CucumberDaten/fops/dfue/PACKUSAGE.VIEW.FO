..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PACKUSAGE.VIEW.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : 
..*****************************************************************************
.set trans -
..
..<META M|='dfue/PACKUSAGE'>
..
..
.. One of these has to be set
.. ----------- ---------- ---------- -------------------------------------------
.continue INSTR    ? M|kbpackanweisungen
.continue ANW2MAT  ? M|kbpackmittel & M|kbanwzupackmit
.continue PACKMAT  ? M|kbpackmittel
.. ----------- ---------- ---------- -------------------------------------------
.continue VIEW
..
..
!ANW2MAT
.. unlock queries
.protection -reset kbartikel 0
.protection -reset kbkuart 0
.protection -reset kbvplan 0
.. block queries
.protection kbpackanw 0
.protection kbfertigungsliste 0
.protection kbkonto 0
.copy M|kbpackanw = G|false
.copy M|kbfertigungsliste = G|false
.copy M|kbkonto = G|false
.continue VIEW
..
!INSTR
.. unlock entry fields
.protection -reset kpackanw 0
.. block entry fields
.. .protection kpackmit 0
.protection kbanwzupackmit 0
.. unlock queries
.protection -reset kbartikel 0
.protection -reset kbkuart 0
.protection -reset kbvplan 0
.protection -reset kbfertigungsliste 0
.. block queries
.protection kbpackanw 0
.protection kbkonto 0
.copy M|kbpackanw = G|false
.copy M|kbkonto = G|false
.continue VIEW
..
!PACKMAT
.. unlock entry fields
.. .protection -reset kpackmit 0
.protection -reset kbanwzupackmit 0
.. block entry fields
.. .protection kpackanw 0
.. unlock queries
.protection -reset kbpackanw 0
.protection -reset kbfertigungsliste 0
.protection -reset kbkonto 0
.. block queries
.protection kbartikel 0
.protection kbkuart 0
.protection kbvplan 0
.copy M|kbartikel = G|false
.copy M|kbkuart = G|false
.copy M|kbvplan = G|false
.continue VIEW
..
..
!VIEW
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = P|maskkontextfop + " instructionusage"  ?  M|kbpackanweisungen ; M|kbanwzupackmit
.formula P|maskkontextfop = P|maskkontextfop + " materialusage"     ?  M|kbpackmittel & _M|kbanwzupackmit
.formula P|maskkontextfop = P|maskkontextfop + " process"           ?  M|processview
.formula P|maskkontextfop = P|maskkontextfop + " product"           ?  M|productview
.formula P|maskkontextfop = P|maskkontextfop + " packmat"           ?  M|packmatview
.formula P|maskkontextfop = P|maskkontextfop + " instruction"       ?  M|packinstructview
.formula P|maskkontextfop = P|maskkontextfop + " smallunit"         ?  M|smallunitview
..
..*****************************************************************************
!END
.continue 
