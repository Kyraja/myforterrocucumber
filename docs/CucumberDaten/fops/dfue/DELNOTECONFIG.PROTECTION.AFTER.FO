..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : DELNOTECONFIG.PROTECTION.AFTER.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : toggle write protection on critical fields
..*****************************************************************************
..<META M|='dfue/DELNOTECONFIG'>
.set trans -
..
.. Unlock allowed fields
.. ----------- ---------- ---------- -------------------------------------------
.continue EDIT   ?  M|kbkonfigurieren
.continue ACTI   ?  M|kbaktivieren 
.continue ACTI   ?  M|kbdeaktivieren
.continue ACTI   ?  M|kbanlegen
.continue ACTI   ?  M|kbloeschen
.. ----------- ---------- ---------- -------------------------------------------
.continue CONFIG
..
.. 
!CONFIG
.continue END ? M|tzeilen=0
.protection -reset kbkonfigurieren 0
.protection -reset kbaktivieren 0
.protection -reset kbdeaktivieren 0
.protection -reset kbloeschen 0
.protection -reset kbanlegen 0
.continue END
.. 
.. 
!ACTI
.continue END ? M|tzeilen=0
.protection -reset kbkonfigurieren 0
.protection -reset kbaktivieren 0
.protection -reset kbdeaktivieren 0
.protection -reset kbloeschen 0
.protection -reset kbanlegen 0
.protection -reset kbuupgrade 0
.continue END
.. 
.. 
!EDIT
.continue END ? M|tzeilen=0
.protection -reset kbkonfigurieren 0
.protection -reset kbaktivieren 0
.protection -reset kbdeaktivieren 0
.protection -reset kbloeschen 0
.protection -reset kbanlegen 0
.protection -reset kbuupgrade 0
.protection -reset kprotokoll 0
.protection -reset kzuoschema 0
.protection -reset kieabmodell 0
.protection -reset ksortpack 0
.protection -reset ksortpackausw 0
.protection -reset kpackmitnum 0
.protection -reset kpackohnenum 0
.protection -reset kpackte 0
.protection -reset kpackzuartikel 0
.protection -reset kpackzupmz 0
.protection -reset knoexpdeckel 0
.protection -reset knoexphfz 0
.continue END
..
..*****************************************************************************
!END
.continue
