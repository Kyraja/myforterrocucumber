..!interpreter english translate noabbrev
..<META M|='dfue/FOPANALYZER' > 
..*****************************************************************************
.. Name           : FOPANALYZER.START.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Functionality  : start button after event, evalutes fo-programms in table
..*****************************************************************************
.set trans -
..
.type text foprogramm
.type integer xi 
..
.formula U|xi = 0
!NEXT
.formula U|xi = U|xi + 1
.continue END ? U|xi > 20
.continue NEXT ? F|empty(M|fop.xi) 
.formula U|foprogramm = M|fop.xi
.input "FOPANALYZER.TAB"
.continue NEXT
.. 
..*****************************************************************************
!END
.continue
