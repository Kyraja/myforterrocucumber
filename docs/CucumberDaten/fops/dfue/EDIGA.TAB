..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIGA.TAB
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Fill the table with critical information from detail in 
..                  line zoom. 
..                  Highlight critical data in table and add error messages to 
..                  the text field in the 2nd register of the line zoom.
..*****************************************************************************
..!meta M|=dfue/EDIGA
.set trans -
..
.formula M|foto = ""
.formula M|fehler = ""
.. 
.colour -foreground -1 -1 -1  -background -1 -1 -1        'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1  preis 'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1  mge   'M|aktzeile'
..
.. sum rows
.colour -foreground -1 -1 -1  -background 'U|xabastotal' 'M|aktzeile' ? F|empty(M|tedinr)
..
.continue END ? F|empty(M|tedinr)
..
..*****************************************************************************
..
.formula M|ganr = M|tganr
.copy M|gaschl = M|tgaschl
.copy M|gafdat = M|tgafdat
.copy M|gadat = M|tgadat
.formula M|werk = M|tgawerk
.formula M|ablade = M|tgaablstelle
.formula M|elsnr = M|tedllsnr
.formula M|abschlussnr = M|tgaabschlussnr
.formula M|elsdat = M|tedllsdat
.formula M|lsdat = M|tlidatint
.formula M|lsnr = M|tlieferschein^id
.formula M|rechnr = M|trechnung^id
.formula M|repwert = M|trepwert
.formula M|rechbetr = M|rechnr^rebetr
.copy M|kuartnr = M|tkuartnr
.copy M|art = M|tartikel
.formula M|namebspr = tartikelsucherw
.formula M|mge = M|tgamenge
.copy M|mgeeh = M|tgamengeneinheit
.formula M|prbasis = M|tgaprbasis
.formula M|lsfaktor = M|tliprfakt
.formula M|lsprbasis = M|tliprbasis
.formula M|preis = M|tgapreis
.formula M|lspreis = M|tlipreis
.formula M|umst = M|tgapossteuersatz
.formula M|ustbetrag = M|tgapossteuer
.formula M|zabetrag = M|tgazabetrag
.formula M|lsendwert = M|tlipwert
.formula M|skonto = M|tgaposskontosatz
.formula M|sktbetr = M|tgaposskontobetrag
.formula M|whr = M|tgawaehrung^symbol
.formula M|gesamtpr = M|tgaposwert 
..
..*****************************************************************************
..
.type text xGaNummerFehlt ? _F|defined(xGaNummerFehlt)
.type text xPackingSlipItemNotFound ? _F|defined(xPackingSlipItemNotFound)
.type text xPackingSlipItemWithoutCreditNoteNumber ? _F|defined(xPackingSlipItemWithoutCreditNoteNumber)
.type text xPackingSlipNotPosted ? _F|defined(U|xPackingSlipNotPosted)
..
.set trans +
.formula U|xGaNummerFehlt = "In EDI-Nachricht {1} fehlt die Gutschriftanzeigenummer!"
.formula U|xPackingSlipItemNotFound = "Zur Position in der Gutschriftenanzeige konnte keine Lieferscheinposition ermittelt werden."
.formula U|xPackingSlipItemWithoutCreditNoteNumber = "Die ermittelte Lieferscheinposition hat keine Gutschriftenanzeigenummer." 
.formula U|xPackingSlipNotPosted = "Der ermittelte Lieferschein ist nicht gebucht."
.set trans -
.. 
.. highlight mismatched prices and quantities
.colour -foreground 'U|xabaswhite' -background 'U|xabasred' preis 'M|aktzeile'  ? M|tgapreis<>M|tlipreis
.colour -foreground 'U|xabaswhite' -background 'U|xabasred' mge   'M|aktzeile'  ? M|tgamenge<>M|tlimge
..
.continue GAOK ? _F|empty(M|ganr)
.formula M|foto   = "icon:ball_red"
.formula M|fehler = M|fehler + ";" ? _F|empty(M|fehler)
.formula M|fehler = M|fehler + F|formatstr(U|xGaNummerFehlt, 'M|tedinr')
!GAOK
..
.continue LSOK1 ?  _F|empty(M|tlieferposition)
.formula M|foto   = "icon:ball_red"
.formula M|fehler = M|fehler + ";" ? _F|empty(M|fehler)
.formula M|fehler = M|fehler + U|xPackingSlipItemNotFound
!LSOK1
..
.continue LSOK2 ? _F|empty(M|tlieferposition^ganr)
.formula M|foto   = "icon:ball_red"
.formula M|fehler = M|fehler + ";" ? _F|empty(M|fehler)
.formula M|fehler = M|fehler + U|xPackingSlipItemWithoutCreditNoteNumber
!LSOK2
..
.continue LSOK3 ? _M|tlieferschein^uebertr
.formula M|foto   = "icon:ball_red"
.formula M|fehler = M|fehler + ";" ? _F|empty(M|fehler)
.formula M|fehler = M|fehler + U|xPackingSlipNotPosted
!LSOK3
..
.formula M|foto   = "icon:ball_green" ? F|empty(M|foto)
..
..*****************************************************************************
!END
.continue
