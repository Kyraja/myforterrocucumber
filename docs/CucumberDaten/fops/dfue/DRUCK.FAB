..!interpreter english translate
.continue INI
..*******************************************************************************************************
..*
..*  Programmname : DRUCK.FAB
..*
..*  Autor        : Holger Klein ais
..  Verantwortlich    : mh
..*
..*  am           : 17.04.2000
..*  ge„ndert am  : 26.02.01, Ozan Kesim
..*  Funktion     : Druckt FABs aus der EDI Datenbank
..*
..*  Bemerkung    : Ist Unterprogramm von DRUCK.VORGANG
..*
..*
..*
..*******************************************************************************************************
.set trans +
!INI
.type text xtfotmp
.type integer  xi1zaehl
..**ok,13.12.2004 (xbzeitraum wurde definiert)
.type bool xbzeitraum
.continue START
..
!START
.up
.page 1
?EDI-ID: 'H|num   '                                                    Mandant: 'mandant '      ? H|tzeilen > 0
?vom   : 'H|ddatei '                VDA - Feinabruf                    Datum  : 'datum   '      ? H|tzeilen > 0
?Zeit  : 'H|zdatei '                                                   Seite  : 'seite   '      ? H|tzeilen > 0
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!MAIN0
.select line
.continue ENDE0       ? _mehr
.continue M700        ?  H|text1 / "*700*"
.continue M800        ?  H|text1 / "*800*"
.continue M820        ?  H|text1 / "*820*"
.continue M821        ?  H|text1 / "*821*"
.continue M822        ?  H|text1 / "*822*"
.continue M823        ?  H|text1 / "*823*"
.continue M824        ?  H|text1 / "*824*"
.continue MAIN0
..
!M700
Kundennummer       : 'H|text4             '   Lieferantennr.     : 'H|text5               '
šbertragungsdatum  : 'H|text8             '
šbertragungs-Nr Alt: 'H|text6             '   šbertragungs-Nr Neu: 'H|text7               '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
EFZ - Datum        : 'H|text9             '
.continue MAIN0
..
!M800
Werk-Kunde         : 'H|text4             '
Abladestelle       : 'H|text9             '   Lager            : 'H|text10               '
Feinabruf-Datum Neu: 'H|text6             '   Feinabruf-Nr Neu : 'H|text5                '
Sachnummer Kunde   : 'H|text7             '   Sachnr. Lieferant: 'H|text8                '
kritischer Bestand : 'H|text11            '   Verwendungsschl. : 'H|text12               '
Feinabruf Horizont : 'H|text13            '   Termin Schlssel : 'H|text14               '
F.Zahl-Differenz   : 'H|text16            '   Verbrauchsstelle : 'H|text17               '
Abschluánummer     : 'H|text15            '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M820
Eingangs-F.Zahl   : 'H|text4             '
----------------------------------------- 1. ---------------------------------------------
Lieferstatus Schl. : 'H|text9             '
Mge letzter Eingang: 'H|text8             '   Erf. Dat. l. Eing: 'H|text5                '
Datum letzter LS   : 'H|text7             '   Nummer letzter LS: 'H|text6                '
----------------------------------------- 2. ---------------------------------------------
Lieferstatus Schl. : 'H|text14            '
Mge letzter Eingang: 'H|text13            '   Erf. Dat. l. Eing: 'H|text10               '
Datum letzter LS   : 'H|text12            '   Nummer letzter LS: 'H|text11               '
----------------------------------------- 3. ---------------------------------------------
Lieferstatus Schl. : 'H|text19            '
Mge letzter Eingang: 'H|text18            '   Erf. Dat. l. Eing: 'H|text15               '
Datum letzter LS   : 'H|text17            '   Nummer letzter LS: 'H|text16               '
------------------------------------------------------------------------------------------
.continue MAIN0
..
!M821
.. .seite                                                                                          ? zeilen < 3
.formula xdtmp      = ""
.formula xbzeitraum = true                                                                           ?  H|text4 / "*555555*"
.formula xbzeitraum = false                                                                          ?  H|text4 / "*333333*" ; H|text4 / "*444444*" ; H|text4 / "*222222*" ; H|text4 / "*999999*"
..
..      .fo xdtmp      = H|text4 >> 2 + "." + (H|text4  >> 4) << 2  + "." +  H|text4  << 4
..**ok,03.12.2004 (untere 2 Zeilen wurden wieder aktiviert)
.formula xdtmp      = H|text4 >> 2 + "." + (H|text4  >> 4) << 2  + "." +  H|text4  << 4              ? _xbzeitraum
.formula xdtmp      = H|text4                                                                        ?  xbzeitraum
.formula xi1zaehl   = xi1zaehl + 1
?PosNr     Termin         Bemerkung                  Menge        Zeit      Bestschl.              ?   xi1zaehl = 1
?------------------------------------------------------------------------------------------        ?  H|tzeilen > 0 & xi1zaehl=1
?'xi1z ''xdtmp    '                                  'H|text5 '  'H|text6 ' 'H|text7 '             ? _(H|text4 / "*222222*" ; H|text4 / "*333333*" ; H|text4 / "*444444*" ; H|text4 / "*555555*" ; H|text4 / "*999999*" )
?'xi1z ''H|text4  '       KEIN BEDARF !              'H|text5 '  'H|text6 ' 'H|text7 '             ?   H|text4 / "*222222*"
?'xi1z ''H|text4  '        RšCKSTAND  !              'H|text5 '  'H|text6 ' 'H|text7 '             ?   H|text4 / "*333333*"
?'xi1z ''H|text4  '       SOFORTBEDARF!              'H|text5 '  'H|text6 ' 'H|text7 '             ?   H|text4 / "*444444*"
?'xi1z ''H|text4  '   ABRUFZEITRAUM - ANGABEN folgen 'H|text5 '  'H|text6 ' 'H|text7 '             ?   H|text4 / "*555555*"
?'xi1z ''H|text4  '     VORSCHAUMENGEN!              'H|text5 '  'H|text6 ' 'H|text7 '             ?   H|text4 / "*999999*"
.continue MAIN0
..
!M822
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
Zwischenlieferant  : 'H|text4             '   erg„nzende SachNr: 'H|text5                 '
Fortschr.Zahl-Null : 'H|text6             '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M823
Sachnr. Kunde Packm: 'H|text4             '   Sachnr.Lief.Packm: 'H|text5                 '
Fassungsverm”gen   : 'H|text6             '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M824
.formula xtfotmp = H|text4 + H|text5 + H|text6
Feinabruf-Text     : 'xtfotmp                                                                              '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.formula xtfotmp =""
.continue MAIN0
..
!ENDE0
.continue
