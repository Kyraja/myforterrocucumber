..!interpreter english  
..noabbrev translate
..*****************************************************************************
.. Name           : DFUE.EXP.SPED.EDI
.. Author         : 
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : sonderbehandlung des SPED beim dateiversenden
..*****************************************************************************
.set trans -
..
.type date xdatum
.type bool  xmehr
.type text  xUebNrAlt
.type text  xUebNrNeu
.type time  xzeit
..
.. ----------------------------------------
.reserve
.. Åbertragungsnummern im kunden
..**ok,12.08.2003 (idkundeab geÑndert auf idkundesab)
..
..
.continue EL001 ? _(+h|idkundesab > 0)
.. IF001
.select customer lock 'h|idkundesab'
..
..
.continue EL002 ? _(mehr)
.. IF002
.type text xvorgang ? _F|defined(U|xvorgang)
.formula U|xvorgang = "VKLS"
.formula U|xediuebnrMOD = +1
.input "DFUE.PUT.PROTOK.UEBNR"
.copy U|xbreturn = G|true
..
.continue FI002
!EL002
.. fehler 52
.formula xbreturn = false
.formula xfcode = 52
.. und wieder zurÅck
.continue
..
!FI002
..
.continue FI001
!EL001
.. fehler 52
.formula xbreturn = false
.formula xfcode = 52
.. und wieder zurÅck
.continue
..
!FI001
..
.select
.. ----------------------------------------
..
.. datum / zeit der dateierstellung
.formula xdatum = datum
.formula xzeit = zeit
.formula h|dinhouse = xdatum
.formula h|zinhouse = xzeit
.formula h|ddatei   = xdatum
.formula h|zdatei   = xzeit
..
.. Åbertragungsnr in den EDI-datensatz
.formula h|uebnra = xUebNrAlt
.formula h|uebnr  = xUebNrNeu
.formula h|uebdat = datum
.rewrite
..
.. dann mal die zeilen nach satz UNBI
.select lock line
.formula xmehr = mehr
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(xmehr)
..
.continue EL003 ? _(h|text1 = "UNBI")
.. IF003
.. datum und uhrzeit in satz UNBI eintragen
.formula h|text9  = xdatum:8
.formula h|text10 = (("00" + ('xzeit' << ":")) >> 2) + (("00" + ('xzeit' >> ":")) >> 2)
.rewrite
..
.. Åbertragungsnr setzen
.formula h|text12 = xUebNrAlt
.formula h|text13 = xUebNrNeu
.formula h|text15 = xdatum:8
.rewrite
.formula xmehr = false
..
.continue FI003
!EL003
.select lock line
.formula xmehr = mehr
..
!FI003
..
.continue LOOP001
!ELOP001: ==============================
..
..*****************************************************************************
!END
.continue
