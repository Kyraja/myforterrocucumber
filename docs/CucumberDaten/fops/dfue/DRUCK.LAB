..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DRUCK.LAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Lieferabrufdaten aus EDI-Nachricht
.. Functionality  :
..  include     dfue/EDI2VKAUV.ABRUFTERMIN
..  include     dfue/EDI2VKAUV.ABTERM.VDA
..  include     dfue/EDI2VKAUV.ABTERM.DELFOR
..  include     dfue/EDI2VKAUV.ABTERM.KONST
..*****************************************************************************
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#EDI#22.08.2008#1#ok#
.set trans +
.type text   xtfotmp
.type integer    xi1z
.type bool   xbzeitraum
.type integer    xmge
.type GD     xd1        ? _defined(T|xd1)
.type GD     xd2        ? _defined(T|xd2)
..
.up
.page 1
?EDI-ID: 'H|nummer '                                                   Mandant: 'mandant '       ? H|tzeilen > 0
?vom   : 'H|ddatei ' '  H|edinachraz                                '  Datum  : 'datum   '       ? H|tzeilen > 0 
?Zeit  : 'H|zdatei '                                                   Seite  : 'seite   '       ? H|tzeilen > 0
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
..
..
!MAIN0
.select line
.continue ENDE0       ? _mehr
.continue M400        ?  H|text1 / "*400*"
.continue M500        ?  H|text1 / "*500*"
..**ok,22.08.2008 (Satzart 502 ist neu fÅr den Feinabruf)
.continue M502        ?  H|text1 / "*502*"
.continue M512        ?  H|text1 / "*512*"
.continue M520        ?  H|text1 / "*520*"
.continue M521        ?  H|text1 / "*521*"
.continue M523        ?  H|text1 / "*523*"
.continue M524        ?  H|text1 / "*524*"
.continue MAIN0
..
!M400
.. mh, 16.12.2010: common invalid values in date fields
.formula T|xd1 = "00000000"
.formula T|xd2 = "00000000"
.formula T|xd1 = F|date(H|text8)   ?  H|text8 <> "0" & H|text8 <> "000000"
.formula T|xd2 = F|date(H|text9)   ?  H|text9 <> "0" & H|text9 <> "000000"
Kundennummer       : 'H|text4             '   Lieferantennr.     : 'H|text5               '
öbertragungsdat    : 'T|xd1               '
öbertragungs-Nr Alt: 'H|text6             '   öbertragungs-Nr Neu: 'H|text7               '
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
Eing.F.Zahl-Datum  : 'T|xd2               '
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
.continue MAIN0
..
!M500
Werk-Kunde         : 'H|text4             '
Abladestelle       : 'H|text12            '
Abrufdatum alt     : 'H|text8             '   Abrufdatum neu   :  'H|text6                '
Abrufnummer alt    : 'H|text7             '   Abrufnummer neu  :  'H|text5                '
Sachnummer Kunde   : 'H|text9             '   Sachnr. Lief.    :  'H|text10               '
Kundenzeichen      : 'H|text13            '
Mengeneinheit      : 'H|text14            '   Anlieferungsint. :  'H|text15               '
Fertigungsfreigabe : 'H|text16            '   Verwendungsschl. :  'H|text18               '
Materialfreigabe   : 'H|text17            '   Kontierungsschl. :  'H|text19               '
Abschlu·nummer     : 'H|text11            '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M502
Kritischer BestandschlÅssel   : 'H|text3          '    Feinabrufhorizont        : 'H|text4         '
TerminschlÅssel               : 'H|text5          '
Fortschrittszahldifferenz     : 'H|text6          '    Verbrauchsstelle         : 'H|text7         '
Lieferstatus-SchlÅssel 1      : 'H|text8          '
Eintreffdatum 2               : 'H|text9          '    Lieferscheinnummer 2     : 'H|text10        '
Lieferscheindatum 2           : 'H|text11         '    Liefermenge 2            : 'H|text12        '
Lieferstatus-SchlÅssel 2      : 'H|text13         '
Eintreffdatum 3               : 'H|text14         '    Lieferscheinnummer 3     : 'H|text15        '
Lieferscheindatum 3           : 'H|text16         '    Liefermenge 3            : 'H|text17        '
Lieferstatus-SchlÅssel 3      : 'H|text18         '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M512
.continue MAIN0
..
!M520
Erfass. Dat. l. Ls : 'H|text4             '   LS-Nr l. Eingang :  'H|text5                '
Mge letzter Eingang: 'H|text7             '   Eingangfort. Zahl:  'H|text8                '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M521:............................ Hier werden die LAB Positionen ausgegeben / öberschrift nur einmal ausgeben
.formula xi1z = xi1z + 1
?PosNr     Termin             Bemerkung                                              Menge      ?   xi1z = 1
?------------------------------------------------------------------------------------------     ?   H|tzeilen > 0  & xi1z = 1
.formula T|xmge  = 'H|text5'
.input "dfue/EDI2VKAUV.ABRUFTERMIN"
.formula T|xd1 = T|xtterm
'xi1z ''T|xd1         '      'T|xptext                              ' '           T|xmge'
.continue MAIN0
..
!M523
Sachnr. Kunde Packm: 'H|text4             '   Sachnr.Lief.Packm: 'H|text5                 '
Fassungsvermîgen   : 'H|text6             '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M524
.formula xtfotmp = H|text4 + H|text5 + H|text6
Lieferabruf-Text   : 'xtfotmp                                                              '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.formula xtfotmp =""
.continue MAIN0
..
!ENDE0
.continue
