..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PARTNERID.KEDINACHR.FA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. Initialize empty
.make screen line -- ?  M|tzeilen > 0
.copy M|kbgeladen = G|false
.formula M|kdatei = ""
.copy M|kbersetzewerk = G|false
.copy M|kbersetzekunde = G|false
..
..
.. File with mapping information + replace customer or plant?
..
.. forecast
.formula M|kdatei = "dfue/DFUE.EDI2VKAUV.DTR" ? M|kedinachr^nummer = "2101"
.copy M|kbersetzekunde = G|true ? M|kedinachr^nummer = "2101" 
..
.. jit
.formula M|kdatei = "dfue/DFUE.EDI2VKAUVF.DTR" ? M|kedinachr^nummer = "2102"
.copy M|kbersetzekunde = G|true ? M|kedinachr^nummer = "2102"
..
.. esp 
.formula M|kdatei = "dfue/DFUE.27.DTR" ? M|kedinachr^nummer = "2110"
.copy M|kbersetzewerk = G|true ? M|kedinachr^nummer = "2110"
..
.. credit note 
.formula M|kdatei = "dfue/DFUE.55.DTR" ? M|kedinachr^nummer = "2112"
.copy M|kbersetzewerk = G|true ? M|kedinachr^nummer = "2112"
..
..*****************************************************************************
!END
.continue
