..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIEINTR.SELECT
.. Autor          : mh/tg/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Startbutton / Selektion EDIEINTR
.. Functionality  : Start butotn / query EDIEINTR
..*****************************************************************************
.set trans -
..
.. start with empty table
.make screen line --  ? M|tzeilen > 0
..
.continue ERRNUM  ?  _F|isvalue(M|kvon, "N0")
.continue ERRNUM  ?  _F|isvalue(M|kbis, "N0")

.. query: info system is set to grliste=0:4
.formula M|select = "$,,;@gruppe=4;@ordnung=klnum^nummer"         ?  M|minfo ; M|liefminfo
.formula M|select = "$,,;@gruppe=1.2;@ordnung=nummer"             ?  M|ainfo ; M|liefainfo
.formula M|select = "$,,;@gruppe=1.2;@ordnung=nummer;edinfosnr=`" ?  M|oinfo ; M|liefoinfo
..
.formula M|select = M|select + ";abmodell=" + M|kabmodell^id     ?  _F|empty(M|kabmodell)   & (M|minfo ; M|liefminfo)
.formula M|select = M|select + ";ieabmodell=" + M|kieabmodell^id ?  _F|empty(M|kieabmodell) & (M|minfo ; M|liefminfo)
..
.. restrict by customer idno (von!bis)
.formula M|select = M|select + ";klnum^nummer=" + M|kvon + "!" + M|kbis  ?  (M|minfo;M|liefminfo) & (_F|empty(M|kvon);_F|empty(M|kbis))
.formula M|select = M|select + ";nummer=" + M|kvon + "!" + M|kbis        ? _(M|minfo;M|liefminfo) & (_F|empty(M|kvon);_F|empty(M|kbis))
..
.. Overload grliste for use with is/HOL.LISTE
.. should be minfo=true, and grliste=0:4 (only customers with edi), for fast result
.formula M|grliste = "0:4"       ? M|minfo
.formula M|grliste = "0:1.2"     ? M|oinfo ; M|ainfo
.formula M|grliste = "1:4"       ? M|liefminfo
.formula M|grliste = "1:1.2"     ? M|liefoinfo ; M|liefainfo
..*****************************************************************************
!END
.continue
..
..
!ERRNUM
.error Geben Sie eine gÅltige Identnummer an.
.cursor kvon 0
.end 1

