..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LABDIFF.KBUCHART.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Erstelle Balkendiagramm zu Fortschrittszahlen
.. Functionality  : Create column chart for cumulative quantities
..*****************************************************************************
.set trans -
..
.. load color constants
.input "is/ABASFARBEN.DEF"
..
.type text xTitelChart
.type text xTitelX
.type text xTitelY
.type text xMarker
.type text xWerteFZahlAlt
.type text xWerteFZahlNeu
.type text xWerteDifferenz
..
.set trans +
.formula U|xTitelChart = "Fortschrittszahlen"
.formula U|xTitelX = "Abrufe"
.formula U|xTitelY = "Fortschritt (Menge)"
.formula U|xWerteFZahlAlt = "Fortschritt (alt)"
.formula U|xWerteFZahlNeu = "Fortschritt (neu)"
.formula U|xWerteDifferenz = "Differenz"
.set trans -
.formula U|xMarker = ""
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -3D NO
.chart -PARAM -TITLECHART 'U|xTitelChart'
.chart -PARAM -TITLEX 'U|xTitelX'
.chart -PARAM -TITLEY 'U|xTitelY'
.chart -PARAM -MINMAXY
..
.select screen header
!NMARK
.select screen line
.continue EMARK  ? _G|mehr
.formula U|xMarker = U|xMarker + 'M|ttermin' + ";"
.continue NMARK
!EMARK
.chart -PARAM -MARKERX 'U|xMarker'
..
.chart -STARTVALUES 'U|xWerteFZahlAlt'  -RGBCOLOR 255 171 227
.select screen header
!NFZALT
.select screen line
.continue EFZALT  ? _G|mehr
.chart -VALUE 'M|tlab1fzahl'
.continue NFZALT
!EFZALT
..
.chart -STARTVALUES 'U|xWerteFZahlNeu'  -RGBCOLOR 43 135 186
.select screen header
!NFZNEU
.select screen line
.continue EFZNEU  ? _G|mehr
.chart -VALUE 'M|tlab2fzahl'
.continue NFZNEU
!EFZNEU
..
.chart -STARTVALUES 'U|xWerteDifferenz'  -RGBCOLOR 'U|xabasred'
.select screen header
!NFZDIFF
.select screen line
.continue EFZDIFF  ? _G|mehr
.chart -VALUE 'M|tdifffzahl'
.continue NFZDIFF
!EFZDIFF
..
..
.. Show chart
.chart -SHOW kchart 0
..
..
..*****************************************************************************
!END
.continue
