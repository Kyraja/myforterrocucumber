..!interpreter english translate noabbrev
..!meta M|=dfue/EDIREF
..*****************************************************************************
.. Name           : EDIREF.VERGLEICH.TAB
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Compare two reference data sets
..*****************************************************************************
.set trans -
..
.formula M|tstatus = M|icoidentisch
.formula M|tstatus = M|icoangepasst  ?  'M|text1'   <> 'F|trim(H|text1 << 4)'
.formula M|tstatus = M|icoangepasst  ?  'M|tsabez'  <> 'F|trim(H|text1 << 4)'
.formula M|tstatus = M|icoangepasst  ?  'M|tsamc'   <> 'F|trim(H|text3 << 1)'
.formula M|tstatus = M|icoangepasst  ?  'M|tsapos'  <> 'F|trim(H|text2 << 1)'
.formula M|tstatus = M|icoangepasst  ?  'M|tsaanz'  <> 'F|trim(H|text4 << 1)'
.formula M|tstatus = M|icoangepasst  ?  'M|tvorsa'  <> 'H|text5'
.formula M|tstatus = M|icoangepasst  ?  'M|tnachsa' <> 'H|text6'
.. 
.formula U|xtext7 = H|text7
.formula U|xtext8 = H|text8
.formula U|xtext9 = H|text9
..
.formula U|xi = 1
!NEXT: there are up to 25 fields for each row (indexed by xi)
.continue END ?  U|xi > 25
.type text txmc.xi ? _F|defined(U|txmc.xi)
.formula U|txmc.xi = U|xtext7<<"|"
.formula U|txmc.xi = U|txmc.xi << ";" + U|txmc.xi >> ";"  ?  U|txmc.xi / "*;*"
.type text ttxformat.xi ? _F|defined(U|ttxformat.xi)
.formula U|ttxformat.xi = U|xtext8<<"|"
.formula U|ttxformat.xi = U|ttxformat.xi << ";" + U|ttxformat.xi >> ";"  ?  U|ttxformat.xi / "*;*"
.type text ttxvar.xi ? _F|defined(U|ttxvar.xi)
.formula U|ttxvar.xi = U|xtext9<<"|"
.formula U|ttxvar.xi = U|ttxvar.xi << ";" + U|ttxvar.xi >> ";"  ?  U|ttxvar.xi / "*;*"
.formula U|xtext7 = U|xtext7>>"|"
.formula U|xtext8 = U|xtext8>>"|"
.formula U|xtext9 = U|xtext9>>"|"
.formula M|tstatus.xi = M|icoidentisch
.formula M|tstatus.xi = M|icoangepasst ? 'U|txmc.xi' <>'M|txmc.xi'
.formula M|tstatus.xi = M|icoangepasst ? 'U|ttxformat.xi' <>'M|ttxformat.xi'
.formula M|tstatus.xi = M|icoangepasst ? 'U|ttxvar.xi' <>'M|ttxvar.xi'
.formula M|tstatus = M|icoangepasst ? 'M|tstatus.xi' = 'M|icoangepasst'
.formula U|xi = U|xi + 1
.continue NEXT
.. 
..*****************************************************************************
!END
.continue
