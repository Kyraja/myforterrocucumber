..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ABRUFZENTRALE.TAB.STATUS
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Evaluate status of a row's forecast by checking its forecast
..                  quality, early warning and backlog
..*****************************************************************************
.set trans -
..
.type bool xbkennzkritisch       ? _F|defined(U|xbkennzkritisch)
.type bool xbfwdiffkritisch      ? _F|defined(U|xbfwdiffkritisch)
.type bool xbrueckstandkritisch  ? _F|defined(U|xbrueckstandkritisch)
..
.copy U|xbkennzkritisch = G|false
.copy U|xbfwdiffkritisch = G|false
.copy U|xbrueckstandkritisch = G|false
..
..
.. Forecast Quality
.formula M|tstatuskennzt1 = M|kkenngruen
.formula M|tstatuskennzt1 = M|kkenngelb     ?  M|tFQtag1  >= M|kkenngelbtag
.formula M|tstatuskennzt1 = M|kkennrot      ?  M|tFQtag1  >= M|kkennrottag
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzt1<>M|kkenngruen
..
.formula M|tstatuskennzt2 = M|kkenngruen
.formula M|tstatuskennzt2 = M|kkenngelb     ?  M|tFQtag2  >= M|kkenngelbtag
.formula M|tstatuskennzt2 = M|kkennrot      ?  M|tFQtag2  >= M|kkennrottag
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzt2<>M|kkenngruen
..
.formula M|tstatuskennzt3 = M|kkenngruen
.formula M|tstatuskennzt3 = M|kkenngelb     ?  M|tFQtag3  >= M|kkenngelbtag
.formula M|tstatuskennzt3 = M|kkennrot      ?  M|tFQtag3  >= M|kkennrottag
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzt3<>M|kkenngruen
..
.formula M|tstatuskennzt4 = M|kkenngruen
.formula M|tstatuskennzt4 = M|kkenngelb     ?  M|tFQtag4  >= M|kkenngelbtag
.formula M|tstatuskennzt4 = M|kkennrot      ?  M|tFQtag4  >= M|kkennrottag
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzt4<>M|kkenngruen
..
.formula M|tstatuskennzt5 = M|kkenngruen
.formula M|tstatuskennzt5 = M|kkenngelb     ?  M|tFQtag5  >= M|kkenngelbtag
.formula M|tstatuskennzt5 = M|kkennrot      ?  M|tFQtag5  >= M|kkennrottag
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzt5<>M|kkenngruen
..
.formula M|tstatuskennz5t = M|kkenngruen
.formula M|tstatuskennz5t = M|kkenngelb     ?  M|tFQ5tage >= M|kkenngelbtag
.formula M|tstatuskennz5t = M|kkennrot      ?  M|tFQ5tage >= M|kkennrottag
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennz5t<>M|kkenngruen
..
.formula M|tstatuskennzw1 = M|kkenngruen
.formula M|tstatuskennzw1 = M|kkenngelb     ?  M|tFQwoche1 >= M|kkenngelbwoche
.formula M|tstatuskennzw1 = M|kkennrot      ?  M|tFQwoche1 >= M|kkennrotwoche
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzw1<>M|kkenngruen
..
.formula M|tstatuskennzw2 = M|kkenngruen
.formula M|tstatuskennzw2 = M|kkenngelb     ?  M|tFQwoche2 >= M|kkenngelbwoche
.formula M|tstatuskennzw2 = M|kkennrot      ?  M|tFQwoche2 >= M|kkennrotwoche
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzw2<>M|kkenngruen
..
.formula M|tstatuskennzw3 = M|kkenngruen
.formula M|tstatuskennzw3 = M|kkenngelb     ?  M|tFQwoche3 >= M|kkenngelbwoche
.formula M|tstatuskennzw3 = M|kkennrot      ?  M|tFQwoche3 >= M|kkennrotwoche
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzw3<>M|kkenngruen
..
.formula M|tstatuskennzw4 = M|kkenngruen
.formula M|tstatuskennzw4 = M|kkenngelb     ?  M|tFQwoche4 >= M|kkenngelbwoche
.formula M|tstatuskennzw4 = M|kkennrot      ?  M|tFQwoche4 >= M|kkennrotwoche
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzw4<>M|kkenngruen
..
.formula M|tstatuskennz2w = M|kkenngruen
.formula M|tstatuskennz2w = M|kkenngelb     ?  M|tFQ2wochen >= M|kkenngelbwoche
.formula M|tstatuskennz2w = M|kkennrot      ?  M|tFQ2wochen >= M|kkennrotwoche
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennz2w<>M|kkenngruen
..
.formula M|tstatuskennz4w = M|kkenngruen
.formula M|tstatuskennz4w = M|kkenngelb     ?  M|tFQ4wochen >= M|kkenngelbwoche
.formula M|tstatuskennz4w = M|kkennrot      ?  M|tFQ4wochen >= M|kkennrotwoche
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennz4w<>M|kkenngruen
..
.formula M|tstatuskennzm1 = M|kkenngruen
.formula M|tstatuskennzm1 = M|kkenngelb     ?  M|tFQmonat1 >= M|kkenngelbmonat
.formula M|tstatuskennzm1 = M|kkennrot      ?  M|tFQmonat1 >= M|kkennrotmonat
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzm1<>M|kkenngruen
..
.formula M|tstatuskennzm2 = M|kkenngruen
.formula M|tstatuskennzm2 = M|kkenngelb     ?  M|tFQmonat2 >= M|kkenngelbmonat
.formula M|tstatuskennzm2 = M|kkennrot      ?  M|tFQmonat2 >= M|kkennrotmonat
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzm2<>M|kkenngruen
..
.formula M|tstatuskennzm3 = M|kkenngruen
.formula M|tstatuskennzm3 = M|kkenngelb     ?  M|tFQmonat3 >= M|kkenngelbmonat
.formula M|tstatuskennzm3 = M|kkennrot      ?  M|tFQmonat3 >= M|kkennrotmonat
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzm3<>M|kkenngruen
..
.formula M|tstatuskennzm4 = M|kkenngruen
.formula M|tstatuskennzm4 = M|kkenngelb     ?  M|tFQmonat4 >= M|kkenngelbmonat
.formula M|tstatuskennzm4 = M|kkennrot      ?  M|tFQmonat4 >= M|kkennrotmonat
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennzm4<>M|kkenngruen
..
.formula M|tstatuskennz2m = M|kkenngruen
.formula M|tstatuskennz2m = M|kkenngelb     ?  M|tFQ2monate >= M|kkenngelbmonat
.formula M|tstatuskennz2m = M|kkennrot      ?  M|tFQ2monate >= M|kkennrotmonat
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennz2m<>M|kkenngruen
..
.formula M|tstatuskennz4m = M|kkenngruen
.formula M|tstatuskennz4m = M|kkenngelb     ?  M|tFQ4monate >= M|kkenngelbmonat
.formula M|tstatuskennz4m = M|kkennrot      ?  M|tFQ4monate >= M|kkennrotmonat
.copy U|xbkennzkritisch = G|true            ?  M|tstatuskennz4m<>M|kkenngruen
..
.formula M|tstatuskennz = M|kstatusgruen
.formula M|tstatuskennz = M|kkenngelb       ?  U|xbkennzkritisch
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzt1=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzt2=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzt3=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzt4=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzt5=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennz5t=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzw1=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzw1=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzw1=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzw1=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennz2w=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennz4w=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzm1=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzm2=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzm3=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennzm4=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennz2m=M|kkennrot
.formula M|tstatuskennz = M|kkennrot        ?  M|tstatuskennz4m=M|kkennrot
..
..
.. Early Warning System
.formula M|tstatusfw = M|kstatusgruen
.formula M|tstatusfw = M|kfruehwarnung      ?  F|abs(M|tedifwdiff0)> M|tediffprozent  &  _F|empty(M|tediffprozent)
.copy U|xbfwdiffkritisch = G|true           ?  M|tstatusfw<>M|kstatusgruen
..
..
.. Backlog
.formula M|tstatusrueck = M|kstatusgruen
.formula M|tstatusrueck =  M|krueckstand    ?  M|trueckstand0 > 0.0
.copy U|xbrueckstandkritisch = G|true       ?  M|tstatusrueck<>M|kstatusgruen
..
..*****************************************************************************
!END
.continue
