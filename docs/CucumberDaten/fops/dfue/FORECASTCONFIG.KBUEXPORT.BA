..!interpreter english translate noabbrev
..!meta M|=dfue/FORECASTCONFIG
..*****************************************************************************
.. Name           : FORECASTCONFIG.KBUEXPORT.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans - 
..
.make screen line --
.. 
.type text exportfile
.file -tempname U|exportfile
.output new 'U|exportfile'
.input "DATEI.F"
..*****************************************************************************
.input "FORECASTCONFIG.SE"
.copy M|kbnachricht1 = G|true
.copy M|kbnachricht2 = G|false
.copy M|kbnachricht3 = G|false
.copy M|kedinachr = M|kedinachr1
.copy M|kbohnenachricht = G|false
.copy M|kbmitediinfos = G|true
.formula M|select = "$,,;@gruppe=2;@ordnung=nummer;edinfosnr<>`"
.input is/HOL.LISTE
.output addedto 'U|exportfile'

# Export customer ref settings for message 'M|kedinachraz' / 'M|kedinachraz(L=":")' / ('M|kedinachr^nummer')

#!action=store
#!database=0:4
#!dontchange=~
#!flddelimiter=#

klnum # klnum \
  zn # edinachr # protokoll # abmodell # zuoschema # ieabmodell # labmgsplit # abrvols # abrlspruef # abrdiffab # abrufdruck # abrufrang # abrufakt # auidfld # auupdate # abholen # erlaubt

.select screen header
!ROWS1
.select screen line
.continue END1 ? _G|mehr

$,,klnum='M|tkunde^nummer' # 'M|tkunde^nummer' \
  $,,edinachraz='M|tedinachraz(L=":")' # 'M|tedinachr^nummer' # 'M|tprotokoll(L=":")' # 'M|tabmodell^nummer' # 'M|tzuoschema^nummer' # 'M|tieabmodell^nummer' # 'M|tlabmgsplit(L="0")' # 'M|tabrvols(L="0")' # 'M|tabrdiffab(L="0")' # 'M|tabrlspruef(L="0")' # 'M|tabrufdruck(L="0")' # 'M|tabrufrang' # 'M|kabrufakt(L="0")' # 'M|kauidfld(L="0")' # 'M|kauupdate(L="0")' # 'M|kabholen(L="0")' # 'M|terlaubt(L="0")' 
 
.continue ROWS1
!END1
..*****************************************************************************
