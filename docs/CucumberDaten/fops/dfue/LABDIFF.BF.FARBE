..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LABDIFF.BF.FARBE
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Farbe fuer Tabelle und Liefereinteilung
.. Functionality  : Color Table and Shipping Schedule Lines
..*****************************************************************************
.set trans -
..
.. no need for colors
.continue END  ?  M|tzeilen = 0  ;  M|kbportal
..
.. load color constants
.input "is/ABASFARBEN.DEF"
..
.. which evaluation is shown in info system?
.type bool  xbdiffliste
.type bool  xbhistorie
.copy U|xbdiffliste = G|true  ?  G|evtvar="kbudiffliste"  ;  G|evtvar="tbudiffliste"  ;  G|evtvar="bstart"
.copy U|xbhistorie = G|true  ?  G|evtvar="kbuhisau"
..
..
.. colorize table
..
.select screen header
.continue EROW  ? _G|mehr
..
!NROW
.select screen line
.continue EROW  ? _G|mehr
..
.. reset colors
.colour -foreground -1 -1 -1   -background -1 -1 -1  tlab2offen      'M|aktzeile'
.. color fields (diff list)
.colour -foreground -1 -1 -1       -background 'U|xabaslightgreen3'   tlab2offen      'M|aktzeile'  ?  U|xbdiffliste  & _F|empty(M|tlab2offen)
..
.continue NROW
!EROW
..
..
.. colorize (shipping) schedule lines ("VDA Liefereinteilung")
..
.select screen header
.continue ELINE  ? _G|mehr
..
.type text xlabd ? _F|defined(U|xlabd)
.type text xdtyp ? _F|defined(U|xdtyp)
.type text xlabm ? _F|defined(U|xlabm)
.type text xefz  ? _F|defined(U|xefz)
.type text xdiff ? _F|defined(U|xdiff)
..
!NLINE
.select screen line
.continue ELINE  ? _G|mehr
.continue ELINE  ?  M|aktzeile>64
..
.. iterate field names
.formula U|xlabd = "labd" + 'M|aktzeile'
.formula U|xdtyp = "labdattyp" + 'M|aktzeile'
.formula U|xlabm = "labm" + 'M|aktzeile'
.formula U|xefz  = "efz"  + 'M|aktzeile'
.formula U|xdiff = "diff" + 'M|aktzeile'
..
.. reset colors
.colour -foreground -1 -1 -1  -background -1 -1 -1  'U|xdiff'  0
..
.. no data -> no colors
.continue NLINE  ?  F|empty(M|.xlabd) ; _U|xbdiffliste
..
.. color fields
.colour -foreground -1 -1 -1       -background 'U|xabaslightgreen3'  'U|xdiff'  0   ?  M|.xdiff <> 0.0
..
.continue NLINE
!ELINE
..
..*****************************************************************************
!END
.continue
