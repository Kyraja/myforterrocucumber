.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
.set trans -
.type bool  xbquerFormat
.type integer   xCnt400
.type integer   xCnt500
.type integer   xCnt525
.type integer   xCnt550
.type integer   xCnt600
.type integer   xCntAll
.type integer   xDFUEproto
.type text  xdPARAM
.type text  xentgelt1
.type text  xentgelt2
.type text  xKuAbt
.type text  xKuAns
.type text  xKuAnsz1
.type text  xKuAnsz2
.type text  xKuAnsz3
.type text  xKuAnsz4
.type text  xKuAnsz5
.type text  xKuFax
.type text  xKuFirma
.type text  xKuTele
.type text  xKuUstid
.type text  xLiAbt
.type text  xLiAns
.type text  xLiAnsz1
.type text  xLiAnsz2
.type text  xLiAnsz3
.type text  xLiAnsz4
.type text  xLiAnsz5
.type text  xLiFax
.type text  xLiFirma
.type text  xLiNr
.type text  xLiTele
.type text  xLiUstid
..... procedure stack pointer .....
..art int   xprocsp
.type text  xReNrfirst
.type text  xReNrlast
.type text  xrewert
.type text  xtxt
..**ok,19.04.2002 (xuebdat datum --> text umdefiniert)
.type text  xuebdat
.type text  xuebalt
.type text  xumsatz1
.type text  xumsatz2
.type text  xumst1
.type text  xumst2
.type text  xvorgang
.type text  xWaehrung
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
..fo xprocsp = 0
.. alle variablen mssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.. --------------------   BLOCK  --------------------
.. initialisierung
..die parameterdatei
..**ok,07.01.2003 (xarb wurde entfernt)
.formula xdPARAM = "dfue/DFUE.EXP.INI"
.input 'xdPARAM'
..
.. vorgangsart fr edinfo
.formula xvorgang = "VKRE"
..
.. -------------------- ENDBLOCK --------------------
..
..
.continue EL001 ? _(txname / "*DFUE.SAMABRELI*")
.. IF001
.. programm wurde vom * aufgerufen
..**ok,23.01.2001 (das ganze Programm wurde als Sub-Programm
..**ok, 23.01.2001 zu dem Main-Programm "DFUE.SAMABRELI" angepaát)
..ein DRUCKER
..
.. -> selektionsleiste aufrufen
..fo xtxt = "%" + xIDSelEDIKunUebnr
..hol edi sperr 'xtxt'
..
.. wo soll gedruckt werden
.output 'xDRgeraet'
.formula geraet = 'xDRgeraet'
..
.continue FI001
!EL001
.. programm wurde von "DFUE.EXP" aufgerufen
.. xkunde und xuebnr werden uebergeben
..
..
.continue EL002 ? _((+xkunde = 0) ; (+xuebnr = 0))
.. IF002
.set trans +
Kann EDI-Datensatz nicht drucken!
šbergabeparameter fehlen.
.set trans -
xkunde: 'xkunde'
xuebnr: 'xuebnr'
.formula xbfehler = true
.continue
..
!EL002
.. FI002
..
.. wo soll gedruckt werden
.output 'xDfueVKREgeraet'
.formula geraet = 'xDfueVKREgeraet'
..
..**ok,19.06.2001 (wiederholte Selektion wurde entfernt,
..**ok,19.06.2001  ich befinde mich sowiese im EDI-Datensatz)
..
..**ok,09.04.2001 (Programm wurde stabiler gestaltet)
..hol edi sperr 'xcom'
..
!FI001
..
..
.continue EL003 ? _(h|vorart = reko)
.. IF003
.. werte aus dem kopf merken
.formula xkunde = ""
.formula xuebnr = ""
..fo xkunde = h|idkundeab
..**ok,18.06.2001 (statt idkundeab jetzt idkunderab verwendet)
.formula xkunde = h|idkunderab
.formula xuebnr = h|uebnr
.formula xReNrfirst = ""
.formula xReNrlast  = ""
..
..**ok,13.06.2001 (statt merk lifo, hol lifo nur merk/hol)
..
.. ----------------------------------------
.reserve
.. lieferantendaten
.select company "$,,;gruppe=10;@gruppe=10"
..
..
.continue EL004 ? _(mehr)
.. IF004
.. wichtige felder des lieferanten
.formula xLiAns     = h|ans + ";" + h|str + ";"
.formula xLiAns     = xLiAns + ((h|plz + " " + (h|nort << ";")) << 34)
.. die 5 zeilen der lieferantenanschrift
.formula xtxt       = xLiAns
.formula xLiAnsz1   = xtxt << ";"
.formula xtxt       = xtxt >> ";"
.formula xLiAnsz2   = xtxt << ";"
.formula xtxt       = xtxt >> ";"
.formula xLiAnsz3   = xtxt << ";"
.formula xtxt       = xtxt >> ";"
.formula xLiAnsz4   = xtxt << ";"
.formula xtxt       = xtxt >> ";"
.formula xLiAnsz5   = xtxt << ";"
.formula xLiFirma   = h|knam1    << 20
.formula xLiAbt     = ""
.formula xLiTele    = h|tele     << 35
.formula xLiFax     = h|fax      << 35
.formula xLiUstid   = h|ustid    << 20
..
.continue FI004
!EL004
.. fehler
.set trans +
FEHLER: Konnte Betriebsdatensatz nicht finden!
.set trans -
.continue
..
!FI004
..
.select
.. ----------------------------------------
..
.. ----------------------------------------
.reserve
.. Kundendaten
.. Uebertragungsprotokoll ermitteln
.select customer 'U|xkunde'
..
..
.continue EL005 ? _(mehr)
.. IF005
.input "DFUE.GET.PROTOK"
.formula U|xbquerFormat = ( U|xedidrformat = "VDAREQUER")
..
.. Kunde ist Rechnungslistenempfaenger, falls in EDI-INFO nicht anders definiert
.. RELI-Tausch nur fuer VDA erlaubt (?)
.formula U|xvreliempf = H|id ?  U|xDFUEproto<>1 ; F|empty(U|xvreliempf)
..
.formula U|xKuAns = U|xvreliempf^ans + ";" + U|xvreliempf^str + ";"
.formula U|xKuAns = U|xKuAns + ((U|xvreliempf^lakenn + " " + U|xvreliempf^plz + " " + (U|xvreliempf^nort << ";")) << 34)
..
.formula U|xtxt       = U|xKuAns
.formula U|xKuAnsz1   = U|xtxt << ";"
.formula U|xtxt       = U|xtxt >> ";"
.formula U|xKuAnsz2   = U|xtxt << ";"
.formula U|xtxt       = U|xtxt >> ";"
.formula U|xKuAnsz3   = U|xtxt << ";"
.formula U|xtxt       = U|xtxt >> ";"
.formula U|xKuAnsz4   = U|xtxt << ";"
.formula U|xtxt       = U|xtxt >> ";"
.formula U|xKuAnsz5   = U|xtxt << ";"
.formula U|xKuFirma   = U|xvreliempf^name     << 20
.formula U|xKuAbt     = U|xvreliempf^funktion << 35
.formula U|xKuTele    = U|xvreliempf^tele     << 35
.formula U|xKuFax     = U|xvreliempf^fax      << 35
.formula U|xKuUstid   = U|xvreliempf^ustid    << 20
..
!EL005
.. FI005
..
.select
.. ----------------------------------------
..
..
.. =====   CASE001   =====
.continue BRK001 ? _(xDFUEproto = 1)
.. VDA 4906 sammelrechnungsprotokoll
.select line
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(mehr)
..
.continue EL006 ? _(h|text1 = "400")
.. IF006
.. vda-vorsatz 811
.formula xLiNr = h|text4
.formula xuebnr  = ("00000" + h|text6) >> 5
.formula xuebalt = ("00000" + h|text5) >> 5
.formula xtxt    = h|text7 >> 2 + "." + ((h|text7 >> 4) << 2) + "." + h|text7 << 4
..**ok,13.06.2001 (untere Zeile auskommentiert: fo xuebdat = xtxt)
..**ok,19.04.2002 (xuebdat wieder aktiviert)
.formula xuebdat = xtxt
..
!EL006
.. FI006
..
..
.continue EL007 ? _(h|text1 = "500")
.. IF007
.. erste und letzte rechnungsnummer
.formula xReNrfirst = h|text3 ? +xReNrfirst = 0
.formula xReNrlast  = h|text3
.. w„hrungsschlssel
.formula xWaehrung  = h|text7 ? +xWaehrung = 0
..
!EL007
.. FI007
..
..
.continue EL008 ? _(h|text1 = "600")
.. IF008
.. die z„hler
.formula xCnt400 = h|text3
.formula xCnt500 = h|text4
.formula xCnt525 = h|text5
.formula xCnt550 = h|text6
.formula xCnt600 = h|text7
.formula xCntAll = xCnt400 + xCnt500 + xCnt525 + xCnt550 + xCnt600
..
.. betr„ge
.formula xrewert   = h|text8
.formula xentgelt1 = h|text9
.formula xumst1    = h|text10
.formula xumsatz1  = h|text11
.formula xentgelt2 = h|text12
.formula xumst2    = h|text13
.formula xumsatz2  = h|text14
..
!EL008
.. FI008
..
.select line
..
.continue LOOP001
!ELOP001: ==============================
..
..**ok,13.06.2001 (Neu: .seite und .oben)
.page
.input VDA.F
.up
..
..
.continue EL009 ? _(xbquerFormat)
.. IF009
.print fo.quer
.input "DFUE.VKRE.VDA.QF"
..**ok,13.11.2000 (.seite ist NEU)
..seite
.print fo.hoch
..
.continue FI009
!EL009
.print fo.hoch
.input "DFUE.VKRE.VDA.HF"
..**ok,13.11.2000 (.seite ist NEU)
..seite
..
!FI009
..
.continue ESAC001
!BRK001
.continue BRK002 ? _(xDFUEproto = -1)
.. fehler
.set trans +
FEHLER: Konnte šbertragungsprotokoll nicht ermitteln!
.set trans -
..
.continue ESAC001
!BRK002
!ESAC001: =====   ENDCASE   =====
..
.continue FI003
!EL003
.. fehler
.set trans +
FEHLER: Das ist keine Rechnung!
.set trans -
..
!FI003
..
