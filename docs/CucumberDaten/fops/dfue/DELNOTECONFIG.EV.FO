..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : DELNOTECONFIG.EV.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : 
...Includes
..  include dfue/DELNOTECONFIG.PROTECTION.BEFORE.FO
..  include dfue/DELNOTECONFIG.PROTECTION.AFTER.FO
..*****************************************************************************
..<META M|='dfue/DELNOTECONFIG'>
.set trans -
..
.type bool xb
.. 
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbmitediinfos"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="khauptkunde"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kkundevon"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kkundebis"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kkundesuch"
.. ----------- ---------- ---------- -------------------------------------------
.continue LINKED1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbohnejedis"
.. ----------- ---------- ---------- -------------------------------------------
.continue TOGGLE1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbvda"
.continue TOGGLE1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbedifact"
.. ----------- ---------- ---------- -------------------------------------------
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbanlegen"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbloeschen"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbkonfigurieren"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbaktivieren"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbdeaktivieren"
.. ----------- ---------- ---------- -------------------------------------------
.continue PARAM6  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kzuoschema"
.continue PARAM7  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kieabmodell"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!LINKED1
.copy M|kbmitediinfos = G|true ? M|kbohnejedis
.continue END 
.. 
!PARAM6
.formula M|kieabmodell = "" ? F|empty(M|kzuoschema)
.continue END ? F|empty(M|kzuoschema)
.assign M|kieabmodell = 'F|formatstr("$,,;imex=(Import);imschema=={1}", M|kzuoschema^id)'  
.continue MSGTYPE ? M|kedinachr^id<>M|kzuoschema^edinachr^id  
.continue END
..
!PARAM7 
.formula M|kzuoschema = M|kieabmodell^imschema^id
.continue MSGTYPE ? M|kedinachr^id<>M|kzuoschema^edinachr^id  
.continue END
.. 
!TOGGLE1
.copy M|kbvda = G|false
.copy M|kbedifact = G|false
.copy M|.evtvar = G|true 
.input "DELNOTECONFIG.KBUVORBELEGUNG.BA.FO"
.continue END
..
!TOGGLE2
.input "DELNOTECONFIG.PROTECTION.BEFORE.FO"
.formula U|xb = M|.evtvar
.copy M|kbanlegen = G|false
.copy M|kbloeschen = G|false
.copy M|kbkonfigurieren = G|false
.copy M|kbaktivieren = G|false
.copy M|kbdeaktivieren = G|false
.copy M|.evtvar = U|xb 
.input "DELNOTECONFIG.PROTECTION.AFTER.FO"
.continue END 
.. 
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
.. 
.. 
!MSGTYPE
.error Abbildungsmodelle und Schema sind fÅr eine andere EDI-Nachricht definiert.
.formula M|kieabmodell = ""
.formula M|kzuoschema = ""
.end 1
.. 
!ABMTYPE
.error Das zugeordnete Abbildungsmodell enthÑlt einen nicht zulÑssigen öbertragungswert.
.end 1
