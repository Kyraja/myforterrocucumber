..!interpreter english translate
.continue INI
..*******************************************************************************************************
..*
..*  Programmname : DRUCK.EDL
..*
..*  Autor        : Ozan Kesim
..*
..*  am           : 07.02.2003, Ozan Kesim
..*  Funktion     : Druckt EDL-Meldungen
..*
..*  Bemerkung    : Ist Unterprogramm von DRUCK.VORGANG
..Aenderungshistorie:
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#EDL#07.02.2003#0#ok#
..#KOR#EDL#11.08.2003#1#ok#
..#KOR#EDL#23.04.2004#2#ok#
..#KOR#EDL#20.08.2008#3#ok#
..
..*******************************************************************************************************
.set trans +
!INI
.type text  xtfotmp
.type integer   xi1zaehl
..**ok,11.08.2003 (untere Variablen xmenge unx meinh sind NEU)
.type realx xmenge
.type text  xmeinh
..**ok,11.08.2003 (dezimal auf "," gesetzt)
.set decpoint 'dezpunkt'
.set thoussep 'tsdtrenn'
.continue START
..
!START
.up
.page 1
?EDI-ID: 'H|num   '                                                    Mandant: 'mandant '        ? H|tzeilen > 0
?vom   : 'H|ddatei '                  EDL-Meldung                      Datum  : 'datum   '        ? H|tzeilen > 0
?Zeit  : 'H|zdatei '               (Entnahme-Meldung)                  Seite  : 'seite   '        ? H|tzeilen > 0 & h|funktion="36"
?Zeit  : 'H|zdatei '               (Eingangs-Meldung)                  Seite  : 'seite   '        ? H|tzeilen > 0 & h|funktion="30"
..**ok,11.08.2003 (um Bestandsmeldung erweitert)
?Zeit  : 'H|zdatei '               (Bestands-Meldung)                  Seite  : 'seite   '        ? H|tzeilen > 0 & h|funktion="35"
..**ok,23.04.2004 (um Transportschaden/Differenz und RÅcksendung erweitert)
?Zeit  : 'H|zdatei '          (Transportschaden/Differenz)             Seite  : 'seite   '        ? H|tzeilen > 0 & h|funktion="32"
?Zeit  : 'H|zdatei '                 (RÅcksendung)                     Seite  : 'seite   '        ? H|tzeilen > 0 & h|funktion="33"


?------------------------------------------------------------------------------------------       ? H|tzeilen > 0
.continue MAIN0
..
!MAIN0
.select line
.continue ENDE0       ? _mehr
.continue MUNBI       ?  H|text1 / "*UNBI*"
.continue MBGMI       ?  H|text1 / "*BGMI*"
.continue MSUP1       ?  H|text1 / "*SUP1*"
.continue MBUY1       ?  H|text1 / "*BUY1*"
..**ok,20.08.2008 (unten RFH1 ist neu)
.continue MRFH1       ?  H|text1 / "*RFH1*" & H|funktion="35"
.continue MRFL1       ?  H|text1 / "*RFL1*"
.continue MART1       ?  H|text1 / "*ART1*"
.continue MQTY1       ?  H|text1 / "*QTY1*"
.continue MPAC1       ?  H|text1 / "*PAC1*"
.continue MAIN0
..
!MUNBI
öbertragungsdatum   : 'H|text9             '
öbertragungs-Nr Alt : 'H|text12            '  öbertragungs-Nr Neu: 'H|text13               '
.continue MAIN0
..
!MBGMI
?EDL-Lieferschein-Nr : 'H|text3             '  Lieferscheindatum : 'H|text4                '     ? H|funktion="36"
?Lieferschein-Nr     : 'H|text3             '  Lieferscheindatum : 'H|text4                '     ? H|funktion="30"
..**ok,23.04.2004 (um Transportschaden/Differenz und RÅcksendung erweitert)
?Lieferschein-Nr     : 'H|text3             '  Lieferscheindatum : 'H|text4                '     ? H|funktion="32"
?Lieferschein-Nr     : 'H|text3             '  Lieferscheindatum : 'H|text4                '     ? H|funktion="33"
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!MSUP1
Lieferant-GLN       : 'H|text3             '  Lieferant-Nr. bei Kunde: 'H|text4                '
.continue MAIN0
..
!MBUY1
Kunden-GLN          : 'H|text3             '  Abladestelle           : 'H|text7                '
Werk-Kunde          : 'H|text6             '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
..**ok,20.08.2008 (unten MRFH1 ist neu)
!MRFH1
Bestandsmeldung zum : 'H|text8             '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!MRFL1
?Ursprungs-LS-Nummer : 'H|text7             '                                                    ? h|funktion="36"
..**ok,11.08.2003 (um Bestandsmeldung erweitert)
..**ok,20.08.2008 (unten die Ausgabe der Ursprungs-LS-Nr bei der Bestandsmeldung auskommentiert)
..      ?Ursprungs-LS-Nummer : 'H|text7             '                                                    ? h|funktion="35"
..**ok,23.04.2004 (um Transportschaden/Differenz und RÅcksendung erweitert)
?Ursprungs-LS-Nummer : 'H|text7             '                                                    ? h|funktion="32"
?Ursprungs-LS-Nummer : 'H|text7             '                                                    ? h|funktion="33"
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0 &  h|funktion="36"
..**ok,20.08.2008 (unten die Ausgabe der Ursprungs-LS-Nr bei der Bestandsmeldung auskommentiert)
..      ?------------------------------------------------------------------------------------------     ? H|tzeilen > 0 &  h|funktion="35"
..**ok,23.04.2004 (um Transportschaden/Differenz und RÅcksendung erweitert)
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0 &  h|funktion="32"
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0 &  h|funktion="33"
.continue MAIN0
..
!MART1
Kunden-Artikelnummer: 'H|text4             '  Lieferanten-Artikel-Nr : 'H|text5                '
.continue MAIN0
..
!MQTY1
..**ok,11.08.2003 (untere PrÅfungen sind neu)
.formula xmenge = 'H|text3'
.formula xmeinh = 'H|text4'
.formula xmenge = 'H|text7'       ?  _xmenge > 0 & 'H|text7' <> ""
.formula xmeinh = 'H|text8'       ?  _xmenge > 0 & 'H|text7' <> ""
..
?Entnahmemenge       : 'xmenge'  Einheit : 'xmeinh'        ?  h|funktion="36"
?Menge               : 'xmenge'  Einheit : 'xmeinh'        ?  h|funktion="30"
?Menge               : 'xmenge'  Einheit : 'xmeinh'        ?  h|funktion="35"
..**ok,23.04.2004 (um Transportschaden/Differenz und RÅcksendung erweitert)
?Menge               : 'xmenge'  Einheit : 'xmeinh'        ?  h|funktion="32"
?Menge               : 'xmenge'  Einheit : 'xmeinh'        ?  h|funktion="33"
.continue MAIN0
..
!MPAC1
Packmittel-Nr Kunde : 'H|text4             '  Packmittel-Nr Lieferant: 'H|text5                '
                                              Anzahl Packmittel      : 'H|text14               '
.continue MAIN0
..
!ENDE0
.continue
