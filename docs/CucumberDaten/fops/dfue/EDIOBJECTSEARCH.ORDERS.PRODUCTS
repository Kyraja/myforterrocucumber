..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.ORDERS.PRODUCTS
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Finds products for edi messages in abas
..*****************************************************************************
..
.set trans -
..
.input "DATEI.F"
.output addedto 'U|xtfehler'
..
.type P0      xapkunde    ? _F|defined(U|xapkunde)
.type integer xstatus     ? _F|defined(U|xstatus)
.type integer xfcode      ? _F|defined(U|xfcode)
..
.select screen header
.assign  U|xapkunde = M|kunde
..
!PRODUCT
.select screen line
.select screen line 'U|xaktzeile' ? U|xbsingle
.continue END  ? _G|mehr
..
.type text xapnummer  ? _F|defined(U|xapnummer)
.type text xapkuartnr ? _F|defined(U|xapkuartnr)
.type text xapgtin    ? _F|defined(U|xapgtin)
.type text xaktsatz   ? _F|defined(T|xaktsatz)
.type text xaktzeile  ? _F|defined(T|xaktzeile)
..
.formula T|xaktsatz   = "220"
.formula T|xaktzeile  = M|aktzeile
.formula U|xapnummer  = M|artlief
.formula U|xapkuartnr = M|artkunde
.formula U|xapgtin    = M|artgtin
..
.input "ARTIKELPRUEFUNG"
..
.. Artikel nicht gefunden => Fehler ausgegeben
.continue EPRODUCT ? _F|defined(5|id)
..
.formula M|art       = 5|id
.colour -background -1 -1 -1 art 'M|aktzeile'
.load 5 ? F|defined(5|id)
..
.continue PRODUCT  ? _U|xbsingle
..
..*****************************************************************************
!END
..
.formula U|xstatus = 4 ? _F|empty(U|xfcode)
.continue
..
!EPRODUCT
..
.. No Success!
'U|xaptext1'
'U|xaptext2'
..
.formula U|xfcode  = U|xapfcode
.colour -background 'U|xabasyellow' art 'M|aktzeile' ? _F|defined(5|id)
.continue PRODUCT  ? _U|xbsingle
