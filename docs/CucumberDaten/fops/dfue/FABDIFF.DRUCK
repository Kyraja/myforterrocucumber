..>> Eintreffzeit aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttimeact = ""
..>> Eintreffzeit vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttimeprv = ""
..>> Bedarfsstatus aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.formula xbstatusact = ""
..>> Bedarfsstatus vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xbstatusprv = ""
..>> Abrufmenge aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeact = 0
..>> gesamte Abrufmenge aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeactges = xeinfzahl
..>> Differenz Abrufmenge Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgedif = 0
..>> Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeprv = 0
..>> gesamte Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeprvges = xeinfzahl
..
.select from
..
..
!REPT002: ==============================
.select from 'xndiffreptemp' xzttermact # xzttimeact # xzedinumact # xzmgeact # xzeinfzahlact # xbstatusact #
..??    <'xzttermact'> <'xzttimeact'> <'xzedinumact'> <'xzmgeact'> <'xzeinfzahlact'> <'xbstatusact'>
..
.. >> Formatierung der Ausgabe in AbhÑngikeit von den Daten
..>> Test, ob nicht 1. Zeile aus temporÑrer Differenz-Report-Datei
..>>
..
..
.continue EL014 ? _(xzedinumprv <> "")
.. IF014
..>> Testergebnis positiv:
..>>
..>> EDI-Identnummer vorige / aktuelle Zeile aus temporÑrer Differenz-Report-Datei
..??    <'xzedinumprv'> / <'xzedinumact'>
..>> Kunden-Fortschrittszahl vorige / aktuelle Zeile aus temporÑrer Differenz-Report-Datei
..??    <'xzeinfzahlprv'> / <'xzeinfzahlact'>
..>> Abruftermin vorige / aktuelle Zeile aus temporÑrer Differenz-Report-Datei
..??    <'xzttermprv'> / <'xzttermact'>
..>> Abrufmenge vorige / aktuelle Zeile aus temporÑrer Differenz-Report-Datei
..??    <'xzmgeprv'> / <'xzmgeact'>
..??    .aus bild ...
..>>
..>> Test, ob:
..>> - Identnummer Feinabruf aktuelle Zeile gleich
..>>   Identnummer Feinabruf vorige Zeile
..>> und
..>> - Termin Feinabruf aktuelle Zeile gleich
..>>   Termin Feinabruf vorige Zeile
..>>
..
..
.continue EL015 ? _((xzedinumact = xzedinumprv) & (xzttermprv = xzttermact) & (xzttimeprv = xzttimeact))
.. IF015
..>> Testergebnis positiv:
..>>
..>> Test, ob Identnummer Feinabruf vorige Zeile gleich aktueller Feinabruf
..>>
..
..
.continue EL016 ? _(xzedinumprv = xediactnum)
.. IF016
..>> Testergebnis positiv: "- - x x"
..>>
..>> Formatierung
.formula xterm = xzttermprv
.formula xw = 'xterm'
.formula xz = xzttimeprv
.formula xz1 = xzttermprv
.formula xz2 = "-"
.formula xz3 = "-"
.formula xz4 = "-"
.formula xz5 = 'xzmgeprv:0'
.formula xzmgeactges = xzmgeactges + xzmgeprv
.formula xzeinfzahlprv = xzmgeactges
.formula xz6 = 'xzeinfzahlprv:0'
.formula xz7 = xbstatusprv
.formula xz8 = 'xzmgeprv:0'
..??    xzeinfzahldif
..??    .fo xz9 = xzeinfzahlprv - xfzahl
.formula xzx = xzmgeactges - xzmgeprvges
.formula xz9 = 'xzx:0'
..
.continue FI016
!EL016
..>> Testergebnis negativ: (x x - -)
..>>
..>> Formatierung
.formula xterm = xzttermprv
.formula xw = 'xterm'
.formula xz = xzttimeprv
.formula xz1 = xzttermprv
.formula xz2 = 'xzmgeprv:0'
.formula xzmgeprvges = xzmgeprvges + xzmgeprv
.formula xzeinfzahlprv = xzmgeprvges
.formula xz3 = 'xzeinfzahlprv:0'
.formula xz4 = xbstatusprv
.formula xz5 = "-"
.formula xz6 = "-"
.formula xz7 = "-"
..??    xzmgedif
.formula xzx = -1 * xzmgeprv
.formula xz8 = 'xzx:0'
..??    xzeinfzahldif
..??    .fo xz9 = xzeinfzahlprv - xfzahl
.formula xzx = xzmgeactges - xzmgeprvges
.formula xz9 = 'xzx:0'
..
!FI016
..
.continue FI015
!EL015
..>> Testergebnis negativ:
..>>
..>> Test, ob Termin Feinabruf aktuelle Zeile ungleich Termin Feinabruf vorige Zeile
..>>
..
..
.continue EL017 ? _((xzttermact <> xzttermprv) ; (xzttimeact <> xzttimeprv))
.. IF017
..>> Testergebnis positiv:
..>>
..>> Test, ob Identnummer Feinabruf vorige Zeile gleich Identnummer aktueller Feinabruf
..>>
..
..
.continue EL018 ? _(xzedinumprv = xediactnum)
.. IF018
..>> Testergebnis positiv: "- - x x"
..>>
..>> Formatierung
.formula xterm = xzttermprv
.formula xw = 'xterm'
.formula xz = xzttimeprv
.formula xz1 = xzttermprv
.formula xz2 = "-"
.formula xz3 = "-"
.formula xz4 = "-"
.formula xz5 = 'xzmgeprv:0'
.formula xzmgeactges = xzmgeactges + xzmgeprv
.formula xzeinfzahlprv = xzmgeactges
.formula xz6 = 'xzeinfzahlprv:0'
.formula xz7 = xbstatusprv
.formula xz8 = 'xzmgeprv:0'
..??    xzeinfzahldif
..??    .fo xz9 = xzeinfzahlprv - xfzahl
.formula xzx = xzmgeactges - xzmgeprvges
.formula xz9 = 'xzx:0'
..
.continue FI018
!EL018
..>> Testergebnis negativ: "x x - -"
..>>
..>> Formatierung
.formula xterm = xzttermprv
.formula xw = 'xterm'
.formula xz = xzttimeprv
.formula xz1 = xzttermprv
.formula xz2 = 'xzmgeprv:0'
.formula xzmgeprvges = xzmgeprvges + xzmgeprv
.formula xzeinfzahlprv = xzmgeprvges
.formula xz3 = 'xzeinfzahlprv:0'
.formula xz4 = xbstatusprv
.formula xz5 = "-"
.formula xz6 = "-"
.formula xz7 = "-"
..??    xzmgedif
.formula xzx = -1 * xzmgeprv
.formula xz8 = 'xzx:0'
..??    xzeinfzahldif
..??    .fo xz9 = xzeinfzahlprv - xfzahl
.formula xzx = xzmgeactges - xzmgeprvges
.formula xz9 = 'xzx:0'
..
!FI018
..
.continue FI017
!EL017
..>> Testergebnis negativ: "x x x x"
..>>
..>> Formatierung
.formula xterm = xzttermact
.formula xw = 'xterm'
.formula xz = xzttimeact
.formula xz1 = xzttermact
.formula xz2 = 'xzmgeprv:0'
.formula xzmgeprvges = xzmgeprvges + xzmgeprv
.formula xzeinfzahlprv = xzmgeprvges
.formula xz3 = 'xzeinfzahlprv:0'
.formula xz4 = xbstatusprv
.formula xz5 = 'xzmgeact:0'
.formula xzmgeactges = xzmgeactges + xzmgeact
.formula xzeinfzahlact = xzmgeactges
.formula xz6 = 'xzeinfzahlact:0'
.formula xz7 = xbstatusact
..??    xzmgedif
.formula xzx = xzmgeact - xzmgeprv
.formula xz8 = 'xzx:0'
..??    xzeinfzahldif
.formula xzx = xzeinfzahlact - xzeinfzahlprv
.formula xz9 = 'xzx:0'
..>>
..>> nÑchste Zeile ist:
..>> ==================
..>> - erste Zeile von einem Zeilen-Paar fÅr vorigen und aktuellen Feinabruf
..>> oder
..>> - einzelne Zeile fÅr vorigen oder aktuellen Feinabruf
..>>
..>> ==>> Leeren aktuelle Parameter
..>>
..>> EDI-Identnummer vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzedinumact = ""
..>> Kunden-Fortschrittszahl vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzeinfzahlact = 0
..>> Abruftermin vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttermact = ""
..>> Eintreffzeit vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttimeact = ""
..>> Bedarfsstatus
.formula xbstatusact = ""
..>> Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeact = 0
..
!FI017
..
!FI015
..
..>> Ausgabe
..                                        Alte Liefereinteilung            Neue Liefereinteilung                Differenz
..oche   Datum       Eintreffzeit     Menge         Endzahl Status     Menge         Endzahl Status       Menge         Endzahl
..-----+-----------+-------------+---------+----+----------+------+---------+----+----------+------+-+-----------+-+-----------
..**ok,09.01.2002 (Angabe Woche aus PlatzgrÅnden fÅr die Bildschirmausgabe entfernt)
 '   xz1'    ' xz'        '    xz2'      '     xz3' ' xz4' '    xz5'      '     xz6' ' xz7'   '      xz8'   '      xz9'
..
!EL014
.. FI014
..
.. >> vorige Parameter gleich aktuelle Parameter
..>> EDI-Identnummer vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzedinumprv = xzedinumact
..>> Kunden-Fortschrittszahl vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzeinfzahlprv = xzeinfzahlact
..>> Abruftermin vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttermprv = xzttermact
..>> Eintreffzeit vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttimeprv = xzttimeact
..>> Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeprv = xzmgeact
..>> Bedarfsstatus
.formula xbstatusprv = xbstatusact
..>>
..
.continue REPT002 ? _(_(mehr))
..
.select from
..
.up
..
.formula xsybefehl = "rm -f " + xndiffreptemp + " 1> ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
..
..>> (ZurÅck-)Holen gemerkten aktuellen Datensatz
.select
..
!EL010
.. FI010
..
.continue
