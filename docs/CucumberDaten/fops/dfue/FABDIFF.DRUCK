..>> Suchwort Auftrag
.type text       xsueksvor
..>> Abruftermin (Woche)
.type week      xterm
..>> Abruftermin (Datum)
.type date      xtterm
..>> spÑtester Abruftermin des Abrufs
.type date      xttermlast
..>> Abrufdatum Wochentag
.type integer    xttermwt
..>> Abruftermin (Sicherung, Text)
.type text       xtxttterm
..>> VerwendungsschlÅssel
