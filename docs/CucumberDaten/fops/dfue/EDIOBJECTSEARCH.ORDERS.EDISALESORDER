..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.ORDERS.EDISALESORDER
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Find edi sales order for ORDCHG message
..*****************************************************************************
.set trans -
..
.continue END    ? _(M|edifact^edinachr^nummer="2106")
..
.type integer xstatus     ? _F|defined(U|xstatus)
.type integer xfcode      ? _F|defined(U|xfcode)
..
.input "DATEI.F"
.output addedto 'U|xtfehler'
..
.. Find edi sales order
.load 7 ediprocessing 'F|formatstr("$,,;@gruppe=3;abschlnr={1};warenempf={2};@ablageart=(Active);", M|belegnummer, M|wempf^nummer)'
.continue NOORDER ? _G|mehr
..
..remember edi sales order
.load 8 ediprocessing '7|id'
..
..check if edi sales order is unique
.load 7 ediprocessing
.continue MULTIORD ? G|mehr
..
.formula M|vorgaenger = 8|id
.colour -background -1 -1 -1 vorgaenger 'M|aktzeile'
.continue END
..
..*****************************************************************************
!END
..
.formula U|xstatus = 4 ? _F|empty(U|xfcode)
..
.. release buffers
.load 7 ? F|defined(7|id)
.load 8 ? F|defined(8|id)
.continue
..
!NOORDER
.set trans +
Mit der angegebenen Bestellnummer 'M|belegnummer' wurde kein EDI-Auftrag gefunden.
.set trans -
..
.formula U|xfcode  = 50
.colour -background 'U|xabasyellow' vorgaenger 'M|aktzeile'
.continue END
..
!MULTIORD
.set trans +
Mit der angegebenen Bestellnummer 'M|belegnummer' wurden mehrere EDI-Auftr„ge gefunden.
.set trans -
..
.formula U|xfcode  = 57
.colour -background 'U|xabasyellow' vorgaenger 'M|aktzeile'
.continue END
