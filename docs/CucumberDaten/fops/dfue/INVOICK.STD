.formula xZahlFrist = 0
.formula xZahlSkonto= ""
.formula xZbedNr    = ""
..
..
.continue EL008 ? _(h|zbed<>"")
.. IF008
.select add h|zbed
.formula xZbedNr = h|num
.select line
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(mehr=true)
.formula xZahlFrist = h|frist
.formula xZahlSkonto= h|skonto
.formula xrSKONTO   = h|skonto
..
..Skonto-Betrag berechnen
.formula xrSkontoBetrag = xrSKBBETR * xrSKONTO / 100
.formula xSkontoBetrag = 'xrSkontoBetrag'
..
..**ok,04.12.2003 (xZahlungZum wird berechnet)
..
.formula xZahlungZum = xValutaDatum + xZahlFrist
..
.. zeile raus
..**ok,04.12.2003 (jetzt xZahlungZum, xValutaDatum hier in 8-stellige Format umgewandelt)
.output addedto 'xDatRech'
108 # 01 #'xZahlungsMethode'#'xZahlungZum:8'#'xValutaDatum:8'#'xBudat'#'xZahlungsart'#'xZahlFrist'#'xZahlSkonto'#'xZbedNr'#'xland'#'xWeinheit'#'xSkontoBezugsBetrag'#'xSkontoBetrag'# # # # # # # # # # # 'xLfdNr' #
..
.formula xLfdNr  = xLfdNr  + 1
.formula xCnt108 = xCnt108 + 1
..
.select line
..
.continue LOOP001
!ELOP001: ==============================
