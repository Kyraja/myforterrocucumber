..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FOP.1500.GENSCHEMA
.. Autor          : dsch
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : generates a multisite schema for a database group
..*****************************************************************************
.type text xtsuch    ? _F|defined(U|xtsuch)
.type text xtdn      ? _F|defined(U|xtdn)
.type text xtgrp     ? _F|defined(U|xtgrp)
.type text xtneu     ? _F|defined(U|xtneu)
.type text xtaendern ? _F|defined(U|xtaendern)
.type A78  xaenglspr ? _F|defined(U|xaenglspr)
.type text xtenglopt ? _F|defined(U|xtenglopt)
.formula U|xtneu = "neu"
.formula U|xtaendern = "„ndern"
.set trans -
..
.. must be in update/new-mode
.continue ERRSTART ? G|evtkommd <> U|xtaendern & G|evtkommd <> U|xtneu
..
.formula U|xaenglspr = "(English)"
.formula U|xtenglopt = ""
.formula U|xtenglopt = "-e" ? M|varsprache = U|xaenglspr
..
.input de.abas.multisite.schema.SchemaGenerator.java -v 'M|grliste' 'U|xtenglopt'
.continue ERRGEN ? G|status <> 0
..
.formula U|xtgrp  = F|substr(M|grliste, F|strindex(M|grliste, ":")+1)
.formula U|xtgrp  = F|formatstr("0{1}", U|xtgrp) ? +U|xtgrp=1
.formula U|xtdn   = F|regreplace(M|grliste, ":.*", "")
.formula U|xtdn   = F|formatstr("0{1}", U|xtdn) ? +U|xtdn=1
.formula U|xtsuch = F|formatstr("V-{1}-{2}", U|xtdn, U|xtgrp)
.formula M|schema = "$,,mandant^eigmand=1;such=" + U|xtsuch + ";@gruppe=1;@ordnung=stand.(Backwards)" 
..
..*****************************************************************************
!END
.continue
..
..
!ERRSTART
.error Diese Funktion ist nur im Žndern-Modus oder Neu-Modus m”glich!
.end 1
..
!ERRGEN
.end 1
