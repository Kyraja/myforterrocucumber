.formula xPostStichw4Erw = "Warnung"
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
..
..>> FEHLER
..
.. Namen Kopie der Daten- und Protokoll-Datei
..>> Name der Daten-Datei
.formula xsybefehl = "echo " + dblquote + "Daten-Datei:     " + xEmpfangsVerz + xmmvvl + xsekundenz + dblquote + " > " + xnfprotokollerw
.system 'xsybefehl' background
..>> Name der Protokoll-Datei
.formula xsybefehl = "echo " + dblquote + "Protokoll-Datei: " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR" + dblquote + " >> " + xnfprotokollerw
.system 'xsybefehl' background
..>> Leerzeile
.formula xsybefehl = "echo '' >> " + xnfprotokollerw
.system 'xsybefehl' background
..
.. Protokoll Fehler
