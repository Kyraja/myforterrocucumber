.formula xdfueuprog = tname
..>> <EKS-Modul><Vorgang><Vorgangstyp>
.formula xmmvvl = xdfueprog >> "."
..>> <EKS-Modul><Vorgang><Vorgangstyp> (Kleinbuchstaben)
.formula xntemp = "X" + xmmvvl + panummer + ".TMP"
.formula xsybefehl = "echo " + xmmvvl + "|awk '{ print tolower($1) }' > " + xntemp
.system 'xsybefehl'
.output addedto 'xntemp'
.output new WERF.WEG
.select from
.select from 'xntemp' xmmvvlklein
.formula xsybefehl = "rm -f " + xntemp + " 1> ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
..**ok,12.11.2001 (Vorgangsart fÅr die Gutschriftanzeige ist "55")
.formula xvorart = 55
