..
..
.continue EL019 ? _(xprocreturn)
.. IF019
>> Ermitteln, ob Fehlerprotokoll nach automatischen Korrekturen
.formula xsybefehl = "test -s " + xnfprotokollerw
.system 'xsybefehl' background
..
..>> Test, ob Fehlerprotokoll nach automatischen Korrekturen
..
..
.continue EL020 ? _(mehr)
.. IF020
.. >> EKS-Post, Fehlerprotokoll in Empfangsverzeichnis
..>> Merken Uhrzeit
.formula xsekundenz = sekundenz
..
..>> Sichern Protokoll korrigierte Fehler
.. Fehler und Warnungen sichern
.formula xntemp = xtmpdir + "XIAV.IMP.T" + 'panummer' + ".TMP"
.formula xsybefehl = "mv " + xnfprotokollerw + " " + xntemp
.system 'xsybefehl' background
..
.. Namen Kopie der Daten- und Protokoll-Datei sowie Protokoll
..>> Name der Daten-Datei
.formula xsybefehl = "echo " + dblquote + "Daten-Datei:     " + xEmpfangsVerz + xmmvvl + xsekundenz + dblquote + " > " + xnfprotokollerw
.system 'xsybefehl' background
..>> Name der Protokoll-Datei
.formula xsybefehl = "echo " + dblquote + "Protokoll-Datei: " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR" + dblquote + " >> " + xnfprotokollerw
.system 'xsybefehl' background
..>> Leerzeile
.formula xsybefehl = "echo '' >> " + xnfprotokollerw
.system 'xsybefehl' background
..>> Protokoll
.formula xsybefehl = "cat " + xntemp + " >> " + xnfprotokollerw
.system 'xsybefehl' background
..
..>>  Setzen Parameter fÅr nachfolgende Prozedur: Warnung
.formula xistfehler = true
.formula xPostBetreffErw = ": Operationen mit Warnungen ausgefÅhrt (siehe Freitext 1)"
.formula xPostStichw4Erw = "Warnung"
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
..
.. Fehler und Warnungen wiederherstellen
.formula xsybefehl = "mv " + xntemp + " " + xnfprotokollerw
.system 'xsybefehl' background
..
.. >> Kopieren Fehlerprotokoll in Empfangsverzeichnis
..>> Protokoll
.formula xsybefehl = "echo " + 'datum' + ", " + 'zeit' + ", Fehler in INHOUSE-Schnittstellen-Datei: " + xmmvvl + xsekundenz + " > " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.system 'xsybefehl' background
.formula xsybefehl = "echo ---------------------------------------------------------------------------- >> " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.system 'xsybefehl' background
.formula xsybefehl = "cat " + xnfprotokollerw + " >> " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.system 'xsybefehl' background
..>> Kopieren fehlerhafte INHOUSE-Schnittstellen-Datei
.formula xsybefehl = "if [ -f " + xninhouse + " ] ; then ( cp " + xninhouse + " " + xEmpfangsVerz + xmmvvl + xsekundenz + " 1> ${DEVNULL:-/dev/null} 2>&1 ) ; fi"
.system 'xsybefehl' background
..
.. >> Ausgabe an permanente Protokoll-Datei
.formula xsybefehl = "cat " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR >> " + xnfprotokoll
.system 'xsybefehl' background
..
..>>  leeren temporÑre Protokoll-Datei
.formula xsybefehl = "echo '' > " + xnfprotokollerw
.system 'xsybefehl' background
..
..>>  Setzen Schalter, da· nur korrigierte Fehler in INHOUSE-Schnittstelle
.formula xistihsswarnung = true
..
.output terminal
?Testen Format der INHOUSE-Schnittstellen-Datei, bitte warten ...? _grafik
n.o.k.
..
!EL020
.. FI020
..
..>> Daten aus INHOUSE-Schnittstelle in EKS-EDI-DB (DFUE.IHSS2EDI)
..>>  Anzeige Info
