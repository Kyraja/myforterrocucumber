..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC002
!RET003
.formula xprocsp = xprocsp - 1
..
.. Fehler und Warnungen wiederherstellen
.formula xsybefehl = "mv " + xntemp + " " + xnfprotokollerw
.system 'xsybefehl' background
..
.. >> Kopieren Fehlerprotokoll in Empfangsverzeichnis
..>> Protokoll
.formula xsybefehl = "echo " + 'datum' + ", " + 'zeit' + ", Fehler in INHOUSE-Schnittstellen-Datei: " + xmmvvl + xsekundenz + ".ERR > " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.system 'xsybefehl' background
.formula xsybefehl = "echo -------------------------------------------------------------------------------- >> " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.system 'xsybefehl' background
.formula xsybefehl = "cat " + xnfprotokollerw + " >> " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.system 'xsybefehl' background
..>> Verschieben ??? fehlerhafte INHOUSE-Schnittstellen-Datei
.formula xsybefehl = "if [ -f " + xninhouse + " ] ; then ( mv " + xninhouse + " " + xEmpfangsVerz + xmmvvl + xsekundenz + " 1> ${DEVNULL:-/dev/null} 2>&1 ) ; fi"
.system 'xsybefehl' background
..
.output terminal
?Testen Format der INHOUSE-Schnittstellen-Datei, bitte warten ...? _grafik
n.o.k.
..
..>>  Setzen Schalter, da· nicht korrigierbare Fehler in INHOUSE-Schnittstelle
.formula xistihssfehler = true
..
!FI019
..
!EL018
.. FI018
..
.. Protokolle
..>> Kopf an temporÑre Ergebnisprotokoll-Datei
.output addedto 'xneprotokollerw'
.length 1
.right 299
.tablerecord

'txname                        'START: 'datum'_'zeit'   PID: 'pid'
  Datum_Zeit     EDI-IdNr  VorgIdNr Vo Kunde    Fehl       Bemerkung
--------------------------------------------------------------------------------
..
