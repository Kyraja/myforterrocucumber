..!interpreter declaration english translate
..*****************************************************************************
.. FOP-Name       : EDICENTER.HOL
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Prft ob ein Kunde eingetragen ist
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. Switch Id numbers von!bis
.type text  xtnum
..
.. start with empty table
.make screen line -- ? M|tzeilen > 0
..
.. check date range
.continue ERRDATE     ?  _F|empty(M|datumv) & _F|empty(M|datumb) & ( M|datumb < M|datumv )
..
.. build selection
.formula M|select = "$,,;@gruppe=0;erfass=" + 'M|datumv' + "!" + 'M|datumb'
.formula M|select = M|select + ";imex=IM"                          ?  M|import & _M|export
.formula M|select = M|select + ";imex=EX"                          ?  M|export & _M|import
.formula M|select = M|select + ";edinachraz=" + M|kedinachraz^id   ? _M|kedinachrazabrufe & _F|empty(M|kedinachraz)
.formula M|select = M|select + ";edinachr=2101!2104"               ?  M|kedinachrazabrufe
.formula M|select = M|select + ";idkundeab="  + 'M|kkunde^nummer'  ? _F|empty(M|kkunde)  & 'M|kkunde^dnr'="0"
.formula M|select = M|select + ";idabkunde="  + 'M|kkunde^nummer'  ? _F|empty(M|kkunde)  & 'M|kkunde^dnr'="1"
.formula M|select = M|select + ";idkundesab=" + 'M|kwempf^nummer'  ? _F|empty(M|kwempf)
.formula M|select = M|select + ";idkunderab=" + 'M|krempf^nummer'  ? _F|empty(M|krempf)
.formula M|select = M|select + ";status="     +  M|astatus         ? _F|empty(M|astatus)
.formula M|select = M|select + ";abbenr="     +  M|kabbenr         ? _F|empty(M|kabbenr)
..
.. Add num-range to Query
.continue ERRNUM  ? _F|empty(M|kedinumvon) & _F|isvalue('M|kedinumvon', "N53")
.continue ERRNUM  ? _F|empty(M|kedinumbis) & _F|isvalue('M|kedinumbis', "N53")
.continue NUMSEL  ?  F|empty(M|kedinumvon) ; F|empty(M|kedinumbis)
.continue NUMSEL  ? +M|kedinumvon<+M|kedinumbis
.continue NUMSEL  ?  M|kedinumvon<=M|kedinumbis & +M|kedinumvon=+M|kedinumbis
.formula U|xtnum = M|kedinumvon
.formula M|kedinumvon = M|kedinumbis
.formula M|kedinumbis = U|xtnum
..
!NUMSEL
.formula M|select = M|select + ";nummer=" + M|kedinumvon + "!" + M|kedinumbis  ? _F|empty(M|kedinumvon) ; _F|empty(M|kedinumbis)
..
.. Add customer product number, ONLY IF product could not be identified!
.formula M|select = M|select + ";kuartnr="  + M|kkuartnr  ?  F|empty(M|kartikel) & _F|empty(M|kkuartnr)
.formula M|select = M|select + ";kuartnr==" + M|kkuartnr  ? _F|empty(M|kartikel) & _F|empty(M|kkuartnr)
..
..*****************************************************************************
!END
.continue
..
..
!ERRDATE: date range has error
.error Bitte geben Sie einen gltigen Zeitraum ein.
.cursor datumv 0
.end 1
..
!ERRNUM
.error Geben Sie eine gltige Identnummer an.
.cursor kedinumvon 0
.end 1

