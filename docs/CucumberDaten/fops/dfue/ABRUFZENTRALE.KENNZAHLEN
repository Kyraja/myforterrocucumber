..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABRUFZENTRALE.KENNZAHLEN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Calcuates forecast quality and tracking signal
..*****************************************************************************
.set trans -
..
.. message count
.type integer    U|xn   ? _F|defined(U|xn)
..
.. type of forecast
.type bool   U|xisFDS1 ? _F|defined(U|xisFDS1)
.type bool   U|xisFDS2 ? _F|defined(U|xisFDS2)
.type bool   U|xisFDS3 ? _F|defined(U|xisFDS3)
.type bool   U|xisFDS4 ? _F|defined(U|xisFDS4)
.type bool   U|xisFDS5 ? _F|defined(U|xisFDS5)
.type bool   U|xisFDS6 ? _F|defined(U|xisFDS6)
..
.. quantities of forecasts
.type M9.3   U|xp1  ? _F|defined(U|xp1)
.type M9.3   U|xp2  ? _F|defined(U|xp2)
.type M9.3   U|xp3  ? _F|defined(U|xp3)
.type M9.3   U|xp4  ? _F|defined(U|xp4)
.type M9.3   U|xp5  ? _F|defined(U|xp5)
.type M9.3   U|xp6  ? _F|defined(U|xp6)
..
.type M9.3   U|xREF ? _F|defined(U|xREF)
..
.type M9.3   U|xFQ         ? _F|defined(U|xFQ)
.type M9.3   U|xFQzaehler  ? _F|defined(U|xFQzaehler)
.type M9.3   U|xFQnenner   ? _F|defined(U|xFQnenner)
..
.type M9.3   U|xTS         ? _F|defined(U|xTS)
.type M9.3   U|xTSzaehler  ? _F|defined(U|xTSzaehler)
.type M9.3   U|xTSnenner   ? _F|defined(U|xTSnenner)
..
.. empty return values
.formula U|xFQ  = 0.000
.formula U|xTS  = 0.000
.formula U|xREF = 0.000
..
..*****************************************************************************
..
.. count type "FDS" forecasts
.formula U|xn = 0
.formula U|xn = U|xn + 1  ?  U|xisFDS1
.formula U|xn = U|xn + 1  ?  U|xisFDS2
.formula U|xn = U|xn + 1  ?  U|xisFDS3
.formula U|xn = U|xn + 1  ?  U|xisFDS4
.formula U|xn = U|xn + 1  ?  U|xisFDS5
.formula U|xn = U|xn + 1  ?  U|xisFDS6
..
.. nothing to do
.. need at least 2 type "FDS" forecasts!
.continue END  ? _F|defined(U|xn)
.continue END  ?  F|empty(U|xn)
.continue END  ?  U|xn <= 1
..
..*****************************************************************************
..
.. Which Reference Quantity?
.. ----------- ---------- ----------
.continue AKT     ?  M|kbrefneuster
.continue VOR     ?  M|kbrefvorgaenger
.continue VORAVG  ?  M|kbrefvergangenheit
.. ----------- ---------- ----------
.continue END
..
!AKT
.formula U|xREF = 0.000
.formula U|xREF = U|xp1  ?  U|xisFDS1
.formula U|xREF = U|xp2  ?  U|xisFDS2  & _( U|xisFDS1 )
.formula U|xREF = U|xp3  ?  U|xisFDS3  & _( U|xisFDS1 ; U|xisFDS2 )
.formula U|xREF = U|xp4  ?  U|xisFDS4  & _( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 )
.formula U|xREF = U|xp5  ?  U|xisFDS5  & _( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 )
.formula U|xREF = U|xp6  ?  U|xisFDS6  & _( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 ; U|xisFDS5 )
.continue ENDREF
..
!VOR
.formula U|xREF = 0.000
.formula U|xREF = U|xp2  ?  U|xisFDS2  & ( U|xisFDS1 )
.continue ENDREF          ?  U|xisFDS2  & ( U|xisFDS1 )
.formula U|xREF = U|xp3  ?  U|xisFDS3  & ( U|xisFDS1 ; U|xisFDS2 )
.continue ENDREF          ?  U|xisFDS3  & ( U|xisFDS1 ; U|xisFDS2 )
.formula U|xREF = U|xp4  ?  U|xisFDS4  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 )
.continue ENDREF          ?  U|xisFDS4  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 )
.formula U|xREF = U|xp5  ?  U|xisFDS5  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 )
.continue ENDREF          ?  U|xisFDS5  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 )
.formula U|xREF = U|xp6  ?  U|xisFDS6  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 ; U|xisFDS5 )
.continue ENDREF
..
!VORAVG
.formula U|xREF = 0.000
.formula U|xREF = U|xREF + U|xp2  ?  U|xisFDS2  & ( U|xisFDS1 )
.formula U|xREF = U|xREF + U|xp3  ?  U|xisFDS3  & ( U|xisFDS1 ; U|xisFDS2 )
.formula U|xREF = U|xREF + U|xp4  ?  U|xisFDS4  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 )
.formula U|xREF = U|xREF + U|xp5  ?  U|xisFDS5  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 )
.formula U|xREF = U|xREF + U|xp6  ?  U|xisFDS6  & ( U|xisFDS1 ; U|xisFDS2 ; U|xisFDS3 ; U|xisFDS4 ; U|xisFDS5 )
.formula U|xREF = U|xREF / ( U|xn - 1 )
.continue ENDREF
..
!ENDREF
..
..*****************************************************************************
..
..                          sum(i..n) |Pi-R|
.. Forecast Quality "FQ" = ------------------
..                                  R*n
..
.formula U|xFQ = 0.000
.formula U|xFQzaehler = 0.000
.formula U|xFQzaehler = U|xFQzaehler + F|abs(U|xp1-U|xREF)  ?  U|xisFDS1
.formula U|xFQzaehler = U|xFQzaehler + F|abs(U|xp2-U|xREF)  ?  U|xisFDS2
.formula U|xFQzaehler = U|xFQzaehler + F|abs(U|xp3-U|xREF)  ?  U|xisFDS3
.formula U|xFQzaehler = U|xFQzaehler + F|abs(U|xp4-U|xREF)  ?  U|xisFDS4
.formula U|xFQzaehler = U|xFQzaehler + F|abs(U|xp5-U|xREF)  ?  U|xisFDS5
.formula U|xFQzaehler = U|xFQzaehler + F|abs(U|xp6-U|xREF)  ?  U|xisFDS6
.formula U|xFQnenner  = U|xREF * U|xn
.formula U|xFQ = U|xFQzaehler / U|xFQnenner * 100    ?  U|xFQnenner <> 0.000
.formula U|xFQ = 999                                 ?  U|xFQnenner  = 0.000  &  U|xFQzaehler > 0.0
..
..*****************************************************************************
..
..                          sum(i..n)  (Pi-R)
.. Tracking Signal "TS" =  -------------------
..                          sum(i..n)  |Pi-R|
..
.formula U|xTS = 0.000
.formula U|xTSzaehler = 0.000
.formula U|xTSzaehler = U|xTSzaehler + ( U|xp1 - U|xREF )  ?  U|xisFDS1
.formula U|xTSzaehler = U|xTSzaehler + ( U|xp2 - U|xREF )  ?  U|xisFDS2
.formula U|xTSzaehler = U|xTSzaehler + ( U|xp3 - U|xREF )  ?  U|xisFDS3
.formula U|xTSzaehler = U|xTSzaehler + ( U|xp4 - U|xREF )  ?  U|xisFDS4
.formula U|xTSzaehler = U|xTSzaehler + ( U|xp5 - U|xREF )  ?  U|xisFDS5
.formula U|xTSzaehler = U|xTSzaehler + ( U|xp6 - U|xREF )  ?  U|xisFDS6
.formula U|xTSnenner  = U|xFQzaehler
.formula U|xTS = U|xTSzaehler / U|xTSnenner          ?  U|xTSnenner <> 0.000
.formula U|xTS =  1                                  ?  U|xTSnenner = 0.000  &  U|xTSzaehler > 0
.formula U|xTS = -1                                  ?  U|xTSnenner = 0.000  &  U|xTSzaehler < 0
..
..*****************************************************************************
!END
.continue
