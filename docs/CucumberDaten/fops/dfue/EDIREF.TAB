..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIREF.TAB
.. Datum          : 30.12.2003
.. Version        :
.. Autor          : ok/mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Zeilen zu einem EDI-Referenzsatz aufbauen,
..                  Jede Zeile im Referenzdatensat hat bis zu 25 Felder.
..                  Zu jedem Feld wird auch die Bezeichnung aus den
..                  Inhouseschnittstellenbeschreibung (*.IHSSMES FOPs)
..                   ausgegeben.
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Zeilen-FOP
..
.. Functionality  : Fill rows for an edi reference message,
..                  Each row in a reference message has up to 25 fields.
..                  To each field the label from the *.ihssmes eopf is shown.
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : row efop
...Includes       :
..*****************************************************************************
.set trans -
..
.make screen line +O
.formula M|text1     = H|text1 << 4
.formula M|tsabez    = H|text1 << 4
.formula M|tsamc     = H|text3 << 1
.formula M|tsapos    = H|text2 << 1
.formula M|tsaanz    = H|text4 << 1
.formula M|tvorsa    = H|text5
.formula M|tnachsa   = H|text6
.formula T|xtext7    = H|text7
.formula T|xtext8    = H|text8
.formula T|xtext9    = H|text9
.formula T|xi = 1
..
!LOOP: there are up to 25 fields for each row (indexed by xi)
.continue END     ?  T|xi = 26
.formula M|txmc.xi      = T|xtext7<<"|"
.formula M|txmc.xi      = M|txmc.xi << ";" + M|txmc.xi >> ";"            ? M|txmc.xi / "*;*"
.formula M|ttxformat.xi = T|xtext8<<"|"
.formula M|ttxformat.xi = M|ttxformat.xi << ";" + M|ttxformat.xi >> ";"  ? M|ttxformat.xi / "*;*"
.formula M|ttxvar.xi    = T|xtext9<<"|"
.formula M|ttxvar.xi    = M|ttxvar.xi << ";" + M|ttxvar.xi >> ";"        ? M|ttxvar.xi / "*;*"
.formula T|xtext7       = T|xtext7>>"|"
.formula T|xtext8       = T|xtext8>>"|"
.formula T|xtext9       = T|xtext9>>"|"
.. ihssmes labels: T|."xtb" + 'record type' + 'field index'
..  alert: leading zero on 1-digit field index, i.e. 01 instead of 1
.formula T|xti = 'T|xi'
.formula T|xti = "0" + 'T|xi'                        ?  T|xi < 10
.formula T|xtfname = "xtb" + 'M|text1' + 'T|xti'
.formula M|tbes.xi = T|.xtfname                      ?  F|defined(T|.xtfname)
.formula T|xi = T|xi + 1
.continue LOOP
..*****************************************************************************
!END
.continue
