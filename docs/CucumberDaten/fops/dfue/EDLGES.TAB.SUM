..!interpreter english translate noabbrev
..!meta M|=dfue/EDLGES
..*****************************************************************************
.. Name           : EDLGES.TAB.SUM
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : Create summary rows for withdrawn quantities for one 
..                  product. Is called, when all withdraw packing slip rows 
..                  for current product habe been read.
..*****************************************************************************
.set trans -
.. 
.type bool noWithdraw ? _F|defined(U|noWithdraw)
.type bool negativeWithdraw ? _F|defined(U|negativeWithdraw)
.type bool originFullyWithdrawn ? _F|defined(U|originFullyWithdrawn)
.type bool diffInWithdraw ? _F|defined(U|diffInWithdraw)
.. 
.copy U|noWithdraw = G|false
.copy U|negativeWithdraw = G|false
.copy U|originFullyWithdrawn = G|false
.copy U|diffInWithdraw = G|false
.. 
.. 
.. Evaluate withdraw quantities vs origin quantities 
.copy U|noWithdraw = G|true ? F|empty(M|kmgeges)
.copy U|negativeWithdraw = G|true ? M|kmgeges < 0.000
.copy U|originFullyWithdrawn = G|true ?  _F|empty(M|kmgeges) &  M|kmgeges  = 2|mge
.copy U|diffInWithdraw = G|true ? _F|empty(M|kmgeges) &  M|kmgeges <> 2|mge 
.. 
.. 
.. Skipp no-sum rows
.continue END ? U|noWithdraw
.. 
..   
.. Create summary row
.make screen line +O           
.formula M|turspr = U|xSumme    
..
.. Total withdrawn quantities for current product has been summed in header field kmgeges 
.formula M|tmge = M|kmgeges      
.. 
.formula M|tstatusz = G|icoerror              ? U|diffInWithdraw
.formula M|tstatusz = G|icook                 ? U|originFullyWithdrawn
..
.colour -background 'U|xabastotal' 'M|aktzeile'  ? U|diffInWithdraw
.colour -background 'U|xabastotal' 'M|aktzeile'  ? U|originFullyWithdrawn
.colour -background 'U|xabasmidyellow' 'M|aktzeile' ? U|noWithdraw ; U|negativeWithdraw
.. 
..*****************************************************************************
!END
.continue
