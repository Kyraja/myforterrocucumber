..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PARTNERID.KBUSUCHEN.BN
.. Autor          : mh/ok
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Sucht nach einem PartnerId-Mapping zum Kunden der EDI-Nachricht
.. Functionality  : Searches for PartnerId-Mapping for customer of current edi message
..*****************************************************************************
.set trans -
..
.colour  -background -1 -1 -1  kergebnis   0
.colour  -background -1 -1 -1  kidkundeab  0
..
.type text xergebnis1
.type text xergebnis2
.type text xergebnis3
.type text xergebnis4
..
.. Initialize with no result
.formula M|kergebnis = ""
.formula U|xergebnis1 = ""
.formula U|xergebnis2 = ""
.formula U|xergebnis3 = ""
.formula U|xergebnis4 = ""
..
.. Only search if mapping file exists
.continue END  ?  F|empty(M|kedi)
.continue END  ?  F|empty(M|kdatei)
..
.. Read Forecast PartnerId mapping
.input "dfue/PARTNERID.BSTART.BV"
.input "dfue/PARTNERID.BSTART.BN"
..
.. Find Match in table with values from kedi^-fields
.select screen header
.continue END  ? _G|mehr
..
!NEXT
.select screen line
.continue RESULT  ? _G|mehr
.formula U|xergebnis1  = M|ersetzt  ?  M|kidkundeab=M|kunde  &  M|kwerk=M|werk  &  M|kablstelle=M|ablade
.formula U|xergebnis2  = M|ersetzt  ?  M|kidkundeab=M|kunde  &  M|kwerk=M|werk  &  M|ablade=""
.formula U|xergebnis3  = M|ersetzt  ?  M|kidabkunde=M|kunde  &  M|kwerk=M|werk  &  M|kablstelle=M|ablade
.formula U|xergebnis4  = M|ersetzt  ?  M|kidabkunde=M|kunde  &  M|kwerk=M|werk  &  M|ablade=""
.continue RESULT  ? _F|empty(U|xergebnis1)
.continue NEXT
..
!RESULT
.formula M|kergebnis = U|xergebnis1
.formula M|kergebnis = U|xergebnis2  ?   F|empty(M|kergebnis)
.formula M|kergebnis = U|xergebnis3  ?   F|empty(M|kergebnis)
.formula M|kergebnis = U|xergebnis4  ?   F|empty(M|kergebnis)
..
..*****************************************************************************
!END
.continue
