..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.ORDERS.CURRENCY
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Find currency from edi message
..*****************************************************************************
.set trans -
..
.formula M|waehrung = G|inland
.continue END ? _U|xbpreisausedi
..
.type integer xstatus     ? _F|defined(U|xstatus)
.type integer xfcode      ? _F|defined(U|xfcode)
..
.input DATEI.F
.output addedto 'U|xtfehler'
..
.load 1 currency 'F|formatstr("$,,;@gruppe=1;iso3a={1};", M|ediwaehr)'
.continue ERRCURR   ? _G|mehr
..
.formula M|waehrung = 1|id
.colour -background -1 -1 -1 waehrung 'M|aktzeile'
.continue END
..
..*****************************************************************************
!END
.formula U|xstatus = 4 ? _F|empty(U|xfcode)
..
.. release buffers
.load 1 ? F|defined(1|id)
.continue
..
!ERRCURR
.formula U|xfcode  = 56
.colour -background 'U|xabasyellow' waehrung 'M|aktzeile'
..
.set trans +
W„hrung 'M|ediwaehr' nicht gefunden.
.set trans -
..
.continue END
