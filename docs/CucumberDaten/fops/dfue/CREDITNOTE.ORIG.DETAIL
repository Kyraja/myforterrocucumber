..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CREDITNOTE.ORIG.DETAIL
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
...Includes       :
..  include  dfue/ARTIKELPRUEFUNG
..*****************************************************************************
..!meta M|=dfue/CREDITNOTE
..!meta H|=P53
.set trans -
..
.type P0         xapkunde        ? _F|defined(T|xapkunde)
.type text       xapnummer       ? _F|defined(T|xapnummer)
.type BT128      xapkuartnr      ? _F|defined(T|xapkuartnr)
.type text       xapgtin         ? _F|defined(T|xapgtin)
.. 
.select header
.. 
!ROWS
.select line
.continue EROWS ? _G|mehr
.continue RFL1  ?  H|text1="RFL1"
.continue RFL2  ?  H|text1="RFL2"
.continue ART1  ?  H|text1="ART1"
.continue QTY1  ?  H|text1="QTY1"
.continue PRI1  ?  H|text1="PRI1"
.continue ALC1  ?  H|text1="ALC1"
.continue MOA1  ?  H|text1="MOA1"
.continue ROWS
..
!RFL1
.make screen line +O
.assign M|tgalitext = H|text7
.. 
.copy M|tgakunde =M|kkunde
.copy M|tgakunde2=M|kkunde2 
.copy M|tgakunde3=M|kkunde3
.continue ROWS
..
!RFL2
.formula M|tgawerk = H|text12
.formula M|tgaablstelle = H|text13
.continue ROWS
..
!ART1
.formula U|xapnummer  = H|text5
.formula U|xapkuartnr = H|text4
.formula U|xapgtin    = H|text3
.assign U|xapkunde = 'M|kkunde^id'
.input "ARTIKELPRUEFUNG"
.formula M|tartikel = 5|id ? F|defined(5|id)
.formula M|tkuartnr = H|text4
.continue ROWS
.. 
!QTY1
.formula M|tgamenge = H|text3
.assign M|tgamengeneinheiti = H|text4
.. .formula M|tgamengeneinheiti = "PCE" ? _G|mehr
.continue ROWS
..
!PRI1
.formula M|tgapreis = H|text11
.formula M|tgaprbasis = H|text7
.formula M|tgaprbasis =    1 ? H|text7="01"
.formula M|tgaprbasis =  100 ? H|text7="02"
.formula M|tgaprbasis = 1000 ? H|text7="03"
.continue ROWS
..
!ALC1
.. TODO: Skonto, Steuersatz
.continue ROWS
..
!MOA1
.formula M|tgaposwert = H|text5
.formula M|tgaposwert = M|tgaposwert * -1 ? H|text6="2"
.formula M|tgapossteuer = H|text8
.formula M|tgapossteuer = M|tgapossteuer * -1 ? H|text6="2"
.formula M|tgawaehrung = H|text14
.continue ROWS
!EROWS
..
..*****************************************************************************
!END
.continue
