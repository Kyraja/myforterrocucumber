..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FOP.137.BUPDMREQ
.. Datum          : 02.04.2014
.. Version        :
.. Autor          : dsch
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : PDM Request Response aus der EDI-Nachricht generieren
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : EFOP fÅr Maske 137 (EDI-Nachricht), <Ñndern>
..
.. Functionality  : generates a PDM Request Response
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..include pdm/PDMCENTER.INIT
..*****************************************************************************
.type bool xbcalledi2 ? _F|defined(U|xbcalledi2)
.type text xtcalljedi ? _F|defined(U|xtcalljedi)
.type text xtaendern  ? _F|defined(U|xtaendern)
.formula U|xtaendern = "Ñndern"
.set trans -
..
.continue END ? _F|sysinfo(18)^pdm
..
.. must be in update-mode
.continue ERRSTART ? G|evtkommd <> U|xtaendern
..
.continue ERRREQID ? F|empty(M|msgid)
..
.input PDMCENTER.INIT
.continue END ? F|empty(U|xmodelpdmresp)
..
.formula U|xtcalljedi = F|formatstr("input de.abas.edi.JEdi.java -id {1} -exportid {2}", U|xmodelpdmresp, M|nummer)  ? _U|xbcalledi2
.formula U|xtcalljedi = F|formatstr("input de.abas.edi2.JEdi.java -id {1} -exportid {2}", U|xmodelpdmresp, M|nummer) ?  U|xbcalledi2
..
.'U|xtcalljedi'
..
.continue ERREXPORT ? G|status <> 0
..
!END
.continue
..
..
!ERRSTART
.error Diese Funktion ist nur im éndern-Modus mîglich!
.end 1
!ERRREQID
.error Die erforderliche PDM Request ID ist nicht definiert.
.end 1
!ERREXPORT
.end 1
