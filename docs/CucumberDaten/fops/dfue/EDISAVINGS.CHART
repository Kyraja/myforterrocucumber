..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDISAVINGS.CHART
.. Autor          : tg
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Ausgabe Chart
.. Functionality  : show a chart
..*****************************************************************************
.set trans -
..
.type M7.3   xrmge
.type date  xdterm
.type text   xtz1:300 xtle:6 xtadat xtedat xtkkpg xtkkunde xtkartpg
.type integer    xi xi1 xi2 xi3 xiz xiy xic xih xmax
.type real   xrsum
.type text   xtadat      ? _defined(T|xtadat)
..
.formula xiz = 0
.formula xic = 0
..
.set trans +
.formula T|xtkkpg    = M|kkpg
.formula T|xtkkpg    = "keine Rahmenauftragsnummer vorhanden"      ? M|kkpg = ""
.formula T|xtkkunde  = M|kkunde
.formula T|xtkkunde  = "keine Kundennummer vorhanden"              ? M|kkunde = ""
.formula T|xtkartpg  = M|kartpg
.formula T|xtkartpg  = "keine Artikelnummer vorhanden"             ? M|kartpg = ""
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.type text xtitlechart ? _defined(xtitlechart)
.set trans +
.formula xtitlechart = "Rahmenauftrag" + ": " + 'T|xtkkpg' + " Kunde" + ": " + 'xtkkunde' + " Artikel" + ": " + 'xtkartpg'
.set trans -
.chart -PARAM -TITLECHART  'xtitlechart'
.chart -PARAM -TITLEX ";Preis - Zeitraum"
..  @@@ NOCHARCHECK @@@
.chart -PARAM -TITLEY "Preis in þ;"
..  @@@ CHARCHECK @@@
.chart -PARAM -3D "NO"
.chart -PARAM -2LEVELSX
.chart -PARAM -SCROLLY 0 100
..
..
.select screen header
!A: Preise aus den Zeilen holen
.select screen line
.continue DAT1            ? _mehr
.formula xtadat   = M|tvon
.formula xtedat   = M|tbis
..
.formula xiz     = xiz + 1
..
.type real xi.xiz     ? _defined(xi.xiz)
.type text xtadat.xiz ? _defined(xtadat.xiz)
.type text xtedat.xiz ? _defined(xtedat.xiz)

..
.formula xi.xiz     = M|tpreis
.formula xtadat.xiz = xtadat
.formula xtedat.xiz = xtedat
..
.continue A
..
!DAT1
.chart -STARTVALUES
..
..
!DAT2:
.continue DAT3 ? xic = xiz
.formula xic = xic + 1
.chart -VALUE 'xi.xic'
.chart -PARAM -MARKERX "'xtadat.xic' bis 'xtedat.xic'"
.chart -PARAM -MARKERY 'xi.xic'
.chart -PARAM -MINORGRIDY
.continue DAT2
..
!DAT3
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
