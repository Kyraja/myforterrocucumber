..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDICENTER.TAB.COLOUR
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Assing color to row based on value of edi message enumeration       
..                  FOr possible values see enumeration 20131 in abas client
..*****************************************************************************
.set trans -
..
.type text  xtedinachr ? _F|defined(U|xtedinachr)
..
..
.. Colour scheme
.. ----------- ---------- ---------- -------------------------------------------
.continue NONE        ? 'M|kedinachraz'<>""
.continue FORCAST     ?  M|kedinachrazabrufe
.continue ALL         ? 'M|kedinachraz'=""
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!NONE
.colour -foreground 'U|xabasblack' -background "-1 -1 -1" 'M|aktzeile'
.continue END
..
..
!FORCAST
.formula U|xtedinachr = 'M|tedinachraz(L=":")'
.colour -foreground 'U|xabasblack' -background "-1 -1 -1"          'M|aktzeile'  ?  U|xtedinachr="(ForecastDeliverySchedule)"
.colour -foreground 'U|xabasblack' -background 'U|xabaslightblue'  'M|aktzeile'  ?  U|xtedinachr="(JITDeliverySchedule)"
.colour -foreground 'U|xabasblack' -background 'U|xabasmidblue'    'M|aktzeile'  ?  U|xtedinachr="(PickUpSheet)"
.continue END
.. 
.. 
!ALL
.. Rechnungen: Rechnungen, Gutschriften, Zahlungsavis -> xabaslightgreen3
.. Lieferungen: Lieferschein, EDL-Meldung, Ladungstr„gerkontoauszge ->                                   
.. Auftr„ge: Auftrag, Auftrags„nderungen, Auftragsbest„tigung -> -1 -1 -1
.. Abrufe: Lieferabruf, Feinabruf, Versandabruf, .. -> xabaslightblue
.formula U|xtedinachr = 'M|tedinachraz(L=":")'
.colour -foreground 'U|xabasblack' -background 'U|xabaslightgreen3' 'M|aktzeile'  ?  U|xtedinachr="(Invoice)" ; U|xtedinachr="(CreditNote)" ; U|xtedinachr="(PaymentAdviceNote)"
.colour -foreground 'U|xabasblack' -background 'U|xabasmidblue'     'M|aktzeile'  ?  U|xtedinachr="(PackingSlip)" ; U|xtedinachr="(ESPMessage)" ; U|xtedinachr="(LoadCarrierAccountStatement)"
.colour -foreground 'U|xabasblack' -background "-1 -1 -1"           'M|aktzeile'  ?  U|xtedinachr="(SalesOrder)" ; U|xtedinachr="(OrderChange)" ; U|xtedinachr="(SalesOrderConfirmation)"
.colour -foreground 'U|xabasblack' -background 'U|xabaslightblue'   'M|aktzeile'  ?  U|xtedinachr="(ForecastDeliverySchedule)" ; U|xtedinachr="(JITDeliverySchedule)" ; U|xtedinachr="(PickUpSheet)"
.continue END
..
..*****************************************************************************
!END
.continue
