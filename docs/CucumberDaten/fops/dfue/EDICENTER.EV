..!interpreter english translate
..*****************************************************************************
.. FOP-Name       : EDICENTER.EV
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Infosystem EDICENTER, alle Events
.. Functionality  : Infosystem EDCIENTER, all events
..*****************************************************************************
.set trans -
..
.type text  xname
.type bool  xreaend
.type text  xuebnra
.type text  xtsel
.type ID87:9 xcallparam  ? _F|defined(U|xcallparam)
..
.. Status texts and menu
.type text U|txtAuswahlStatus
.type text U|txtFehlerhaft
.type text U|txtErledigt
.type text U|txtVerarbeitung
.type text U|txtDeaktiviert
.type text U|txtNeu
.type text U|txtALLE
.set trans +
.formula U|txtAuswahlStatus = "Auswahl des Status"
.formula U|txtFehlerhaft    = "Fehlerhaft"
.formula U|txtErledigt      = "Erledigt"
.formula U|txtVerarbeitung  = "In Verarbeitung"
.formula U|txtDeaktiviert   = "Deaktiviert"
.formula U|txtNeu           = "Neu"
.formula U|txtALLE          = "ALLE"
.set trans -
..
..
.. Event evaluation
.. ----------- ----- Events -------- -------------------------------------------
.continue ART         ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kartikel"
.continue KUARTNR     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kkuartnr"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "datumv"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "datumb"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kkunde"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kwempf"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "krempf"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kedinumvon"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kedinumbis"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar / "kbetreuer*"
.continue TABINIT     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "krahmen"
.. ----------- ---------- ---------- -------------------------------------------
.continue NACHRAZ     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kedinachraz"
.continue NACHRAZ     ?  G|evtartengl = "FIELD_EXIT"     &  G|evtvar = "kedinachrazabrufe"
.continue LEGACY      ?  G|evtartengl = "BUTTON_BEFORE"  &  G|evtvar = "buvorgang"
.continue STATSEL     ?  G|evtartengl = "BUTTON_BEFORE"  &  G|evtvar = "bustatus"
.continue FTEXT       ?  G|evtartengl = "BUTTON_BEFORE"  &  G|evtvar = "ftext"
.continue STATUS      ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "bust"
.continue FCODE       ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "bufcode"
.continue EDISEARCH   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "bearb"
.continue EDISEARCH   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "holedisearch"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!NACHRAZ
.formula M|kedinachraz="" ? G|evtvar="kedinachrazabrufe" & M|kedinachrazabrufe
.copy M|kedinachrazabrufe=G|false ? G|evtvar="kedinachraz"
.formula M|tabausf = G|false
.formula M|tabausf = G|true ? M|kedinachr = "2105"; M|kedinachr = "2106"
.continue TABINIT
..
!ART
.formula M|kartikelsucherw = M|kartikel^sucherw
.formula M|kkuartnr = ""
.continue TABINIT
..
!KUARTNR
.continue END  ?  F|empty(M|kkuartnr)
.formula M|kartikel = ""
.formula U|xtsel = "$,,;@gruppe=6"
.formula U|xtsel = U|xtsel + ";kuartnr==" + M|kkuartnr  ? _F|empty(M|kkuartnr)
.formula U|xtsel = U|xtsel + ";kl=="  + M|kkunde^id     ? _F|empty(M|kkunde)
.load 1 parts 'U|xtsel'
.continue KUARTOK  ?  G|mehr
.formula U|xtsel = "$,,;@gruppe=6"
.formula U|xtsel = U|xtsel + ";kuartnr==" + M|kkuartnr  ? _F|empty(M|kkuartnr)
.load 1 parts 'U|xtsel'
.continue KUARTOK  ?  G|mehr
.continue TABINIT
!KUARTOK
.formula M|kartikel = 1|art^id  ?  G|mehr
.formula M|kartikelsucherw = M|kartikel^sucherw
.load 1
.continue TABINIT
..
!FTEXT
.input -text 'M|edinr^ftext'
.continue
..
..
!STATSEL: **tg,10.12.2003 (Tabelle autom. leeren)
.input "is/TABLEEREN"
.menu 'U|txtAuswahlStatus'
'U|txtFehlerhaft'           >> .continue FEHL
'U|txtErledigt'             >> .continue ERL
'U|txtVerarbeitung'         >> .continue INVE
'U|txtDeaktiviert'          >> .continue DEA
'U|txtNeu'                  >> .continue NEU
'U|txtALLE'                 >> .continue ALLE
.continue W2
..
!FEHL
.formula M|astatus      = "4"
.formula M|statname     = U|txtFehlerhaft
.continue W2
..
!ERL
.formula M|astatus      = "0"
.formula M|statname     = U|txtErledigt
.continue W2
..
!INVE
.formula M|astatus      = "5!10"
.formula M|statname     = U|txtVerarbeitung
.continue W2
..
!DEA
.formula M|astatus      = "-9"
.formula M|statname     = U|txtDeaktiviert
.continue W2
..
!NEU
.formula M|astatus      = "2!3"
.formula M|statname     = U|txtNeu
.continue W2
..
!ALLE
.formula M|astatus     = "!"
.formula M|statname     = U|txtALLE
..
!W2
.continue
..
!FCODE
.continue REFCODE  ?  M|edinr^such/"R-*"
.input "FOP.137.FTHFFCODE"
.continue END
..
!STATUS
.continue REFSPERR  ? M|edinr^such/"R-*"
.input "FOP.137.FTHFSTATUS"
.continue END
..
!EDISEARCH
.continue EDIERGREF  ? M|edinr^vorart= 0
.continue OBJECTSEARCH ? M|edinr^edinachr = "2105";M|edinr^edinachr = "2106"
.command -parallel 'F|formatstr("(Infosystem) EDISEARCH ? edinr={1}", M|edinr^id)'
.continue END
..
!OBJECTSEARCH
.assign U|xcallparam = "59367"
.input "st/CALLPARAM.EXEC"
.continue END
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
..
..
!EDIERGREF
.error Referenzdatens„tze drfen nicht ge„ndert werden!
.end 1
..
!REFCODE
.error Fehlercodes haben fr Referenzdatens„tze keine Bedeutung!
.end 1
..
!REFSPERR
.error Referenzdatensatz ist gesperrt (aufgrund Fehler oder noch aktiven Verarbeitung) ? M|status=3
.error Referenzdatensatz ist frei! Verarbeitung kann gestartet werden!                 ? M|status<>3
.end 1
..
!LEGACY
.error Diese Funktion ist abgeschafft!
.end 1
