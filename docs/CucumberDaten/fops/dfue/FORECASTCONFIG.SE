..      include     dfue/FORECASTCONFIG.SE.FOCHECK
..      include     dfue/FORECASTCONFIG.SE.FOCHECK.SUB
..      include     dfue/FORECASTCONFIG.VIEW
..*****************************************************************************
.set trans -
..
.input "FORECASTCONFIG.PROTECTION.BEFORE"
.. 
.copy M|kbnachricht1 = G|true
.formula M|kedinachr1  = "2101"
.copy M|kedinachr = M|kedinachr1
.copy M|kbnachricht2 = G|false
.formula M|kedinachr2 = "2102"
.copy M|kbnachricht3 = G|false
.formula M|kedinachr3 = "2104"
.input "FORECASTCONFIG.UPGRADE.STDLAB"
..
.copy M|kbmitediinfos = G|true
.copy M|kbediaktiv = F|sysinfo(18)^edi
.copy M|kbautomotiveaktiv = F|sysinfo(18)^automotive
.input "FORECASTCONFIG.SE.FOCHECK"
..
.copy M|kbabruffelder = G|true
.input "FORECASTCONFIG.VIEW" 
..
.. Characteristics
.select enumeration "20080"
.formula M|kmerkmalbez1 = 'H|sucherw' ? G|mehr
.select enumeration "20081"
.formula M|kmerkmalbez2 = 'H|sucherw' ? G|mehr
.select enumeration "20082"
.formula M|kmerkmalbez3 = 'H|sucherw' ? G|mehr
.select enumeration "20083"
.formula M|kmerkmalbez4 = 'H|sucherw' ? G|mehr
.select enumeration "20084"
.formula M|kmerkmalbez5 = 'H|sucherw' ? G|mehr
.select enumeration "20085"
.formula M|kmerkmalbez6 = 'H|sucherw' ? G|mehr
.select -
..
.input "FORECASTCONFIG.PROTECTION.AFTER"
.. 
..*****************************************************************************
!END
.continue
