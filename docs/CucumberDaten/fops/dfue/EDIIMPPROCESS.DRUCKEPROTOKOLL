..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIIMPPROCESS.DRUCKEPROTOKOLL
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Protokoll drucken  (Legacy-Code)
.. Functionality  : Print prodocoll.
..*****************************************************************************
.set trans -
..
.type text xProtDrucker  ? _F|defined(U|xProtDrucker)
.type text xProtText     ? _F|defined(U|xProtText)
..
.. Default Return value
.copy U|xprocreturn = G|true
..
.continue EDRUCK          ? _xistfehler
.formula xProtDrucker  = xProtDruckerErr
.formula xProtText     = xnfprotokollerw
.output 'xProtDrucker'     ? xProtDrucker <> ""
.input "BLANKOB.F"        ? xProtDrucker <> ""
.input 'xProtText'        ? xProtDrucker <> ""
.output terminal               ? xProtDrucker <> ""
..
!EDRUCK
.continue ? xProtDruckerOut = ""
..
.. Ermitteln, ob (mindestens) ein neuer Lieferabruf eingetragen oder verarbeitet
.formula xsybefehl = "grep -s -E 'eingehender Lieferabruf VDA/ODETT/EDIFACT$' " + xneprotokollerw + " > ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
.continue MEHR1          ? mehr
.formula xsybefehl = "grep -s -E 'eingehender Feinabruf VDA/ODETT/EDIFACT$' " + xneprotokollerw + " > ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
.continue MEHR1          ? mehr
.formula xsybefehl = "grep -s -E 'eingehender Feinabruf (Mais-Pick-Up-Sheet)$' " + xneprotokollerw + " > ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
.continue                ? _mehr
..
!MEHR1
.formula xProtDrucker = xProtDruckerOut
.formula xProtText = "XIAV.DR." + panummer + ".TMP"
.formula xsybefehl = "grep -v '^#.*' " + xneprotokollerw + " > " + xProtText
.system 'xsybefehl' background
.output 'xProtDrucker'
.input "BLANKOB.F"
.input 'xProtText'
.output terminal
.formula xsybefehl = "rm -f " + xProtText + " > ${DEVNULL:-/dev/null}"
.system 'xsybefehl' background
.continue
..
..*****************************************************************************
!END
.continue
