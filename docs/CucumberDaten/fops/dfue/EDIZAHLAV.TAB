..!interpreter declaration english translate
..*****************************************************************************
.. Name           : EDIZAHLAV.TAB
.. Datum/Date     : 18.01.06
.. Version        : 2006
.. Autor/Author   : tg
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Mit dem Infosystem EDIZAHLAV k”nnen die mit der EDI-
..                  Schnittstelle empfangenen Zahlungsavisen gedruckt werden
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
...Includes       :
..*****************************************************************************
.set trans -
.type text xwechsel
.atext -language 'T|bspr' xwechsel 6060 Wechsel
..
!KOPF
.select line
.continue ERROR1 ? _mehr
.continue ZEILE                ? H|text1  = "RFL1"
.formula M|uebdat  = H|text15 ? H|text1  = "UNBI" & H|text15<>""
.formula M|uebdat  = H|text9  ? H|text1  = "UNBI" & H|text15="" & H|text9<>""
.formula M|uebnr   = H|text13 ? H|text1  = "UNBI"
.formula M|uebnra  = H|text12 ? H|text1  = "UNBI"
.formula M|zahlnr  = H|text3  ? H|text1  = "BGMI"
.formula M|zahldat = H|text4  ? H|text1  = "BGMI"
.formula M|liefnum = H|text4  ? H|text1  = "SUP1"
.formula M|knum    = H|text4  ? H|text1  = "BUY1"
.continue KOPF
..
!ZEILE
.formula xtlsnum   = H|text7  ? H|text1  = "RFL1"
.formula xtrenum   = H|text9  ? H|text1  = "RFL1"
.formula xdredat   = H|text10 ? H|text1  = "RFL1"
.formula xtwerk    = H|text12 ? H|text1  = "RFL2"
.formula xtbablnr  = H|text14 ? H|text1  = "RFL2"
.formula xrbetr    = H|text5  ? H|text1  = "MOA1"
.formula xrskonto  = H|text7  ? H|text1  = "MOA1"
..
..W„hrung lesen
.continue KWHR                              ? H|text1 = "MOA1" & 'H|text14' = ""
.formula T|xtsel = "$,,;@gruppe=1;iso3n==" + H|text14 ? H|text1 = "MOA1"
.load 0 currency 'xtsel'                  ? H|text1 = "MOA1"
.formula T|xtwhr = 0|iso3a                 ? mehr & H|text1 = "MOA1"
..
!KWHR
.continue AUSGABE                           ? H|text1  = "SUM0"
.continue ESUM                              ? H|text1  = "SUM1"
.continue NEXT
..
!NEXT
.select line
.continue ERROR1 ? _mehr
.continue ZEILE
..
!AUSGABE
.make screen line +O
.formula M|lsnummer  = T|xtlsnum
.formula M|renummer  = T|xtrenum
.formula M|redat     = T|xdredat
.formula M|werk      = T|xtwerk
.formula M|whr       = T|xtwhr
.formula M|werk      = T|xtwerk
.formula M|journalnr = T|xtbablnr
.formula M|rebtr     = T|xrbetr
.formula M|skontobetr= T|xrskonto
..
.formula T|xtwhr     = ""
.continue NEXT
..
!ESUM: Endsumme
.formula M|resum    = H|text8  ? H|text1 = "SUM1"
.formula M|sskobetr = H|text6  ? H|text1 = "SUM1"
.formula M|gsum     = H|text17 ? H|text1 = "SUM1"
.select line
..Zahlungsart aus SUM2
.set trans +
.formula M|zahlart  = "frei"                  ? H|text7 = "0" & H|text1 = "SUM2"
.formula M|zahlart  = "Scheck"                ? H|text7 = "1" & H|text1 = "SUM2"
.formula M|zahlart  = "šberweisung"           ? H|text7 = "2" & H|text1 = "SUM2"
.formula M|zahlart  = xwechsel                ? H|text7 = "3" & H|text1 = "SUM2"
.formula M|zahlart  = "Scheck/Wechsel"        ? H|text7 = "4" & H|text1 = "SUM2"
.formula M|zahlart  = "Verrechnung Debitoren" ? H|text7 = "5" & H|text1 = "SUM2"
.set trans -
.continue ENDE
..
!ERROR1
.error Datensatz unvollst„ndig
..
.end 1

!ENDE
.end 0
