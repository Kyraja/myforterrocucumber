..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERFLIE.EV
.. Datum          : 05.01.2004
.. Autor          : mh/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Zentrale Ereignisbehandlung im Infosystem ERFLIE
...Includes       :
..*****************************************************************************
..!meta M|=dfue/ERFLIE
.set trans -
..
.type text xvorgang
.type text xtsel
.type text xles
.type text xtfehler
.type real xlfzahl
.type real xefzahl
.type text xt
.type ARTR51000  xmenge
.type bool x555555
.type text xtfeld
.type text xtposphe
.type text xtlabediid
.type integer  xiaktzeile
.type integer  xiaktzeile5
.type text xtdattmp
.type integer  xi1zaehl
.type text xtfotmp
.type P109:2 xedinachr
.type integer    xirows
.formula T|xirows = 0
..
..
.. translate output text for return value T|xptext
.type text U|xtextLeer
.type text U|xtextKeinBedarf
.type text U|xtextRueckstand
.type text U|xtextSofortbedarf
.type text U|xtextVorschaumenge
.type text U|xtextAbrufzeitraum
.set trans +
.formula T|xtextLeer = "Leer"
.formula T|xtextKeinBedarf = "Kein Bedarf"
.formula T|xtextRueckstand = "RÅckstand"
.formula T|xtextSofortbedarf = "Sofortbedarf"
.formula T|xtextVorschaumenge = "Vorschaumenge"
.formula T|xtextAbrufzeitraum = "Abrufzeitraum - Angaben folgen"
.set trans -
..
.input "is/ABASFARBEN.DEF"
..
.. ----------- ----- Events -------- -------------------------------------------
.continue VERWSCH  ? T|evtartengl="FIELD_VALIDATION"     & T|evtvar="verwschl"
.continue VS4984   ? T|evtartengl="BUTTON_BEFORE"     & T|evtvar="buverwschl"
.continue PANLINT  ? T|evtartengl="FIELD_VALIDATION"     & T|evtvar="anliint"
.continue MENANLI  ? T|evtartengl="BUTTON_BEFORE"     & T|evtvar="buanliint"
.continue METERMS  ? T|evtartengl="BUTTON_BEFORE"     & T|evtvar="buts"
.continue RAHMENP  ? T|evtartengl="FIELD_VALIDATION"     & T|evtvar="rahmen"
.continue TERMUMW  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="termint"
.continue ZIMP     ? T|evtartengl="BUTTON_AFTER"    & T|evtvar="impverz"
.continue EFZAHL   ? T|evtartengl="FIELD_EXIT"       & T|evtvar="einfzahl"
.continue AUFTRAG  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kauftrag"
.continue TERMCOD  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="termcod"
.continue ARTIKEL  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kartikel"
.continue NEUZEI   ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kinzeilen"
.. ----------- ---------- ---------- -------------------------------------------
.continue KBLAB    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kblab"
.continue KBFAB    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kbfab"
.continue KBFAB    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kbfabinfo"
.continue KBFAB    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kbpusinfo"
.. ----------- ---------- ---------- -------------------------------------------
.continue FAMENGE  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="menge"
.continue VDA2TAZ  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="meinheit"
.continue TAZ2VDA  ? T|evtartengl="FIELD_EXIT"       & T|evtvar="keinhtaz"
.continue BUEINH   ? T|evtartengl="BUTTON_BEFORE"     & T|evtvar="bumeinheit"
.. ----------- ---------- ---------- -------------------------------------------
.continue FARBE    ? T|evtartengl="FIELD_VALIDATION"     & T|evtvar="vkundeab"
.continue FARBE    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="werk"
.continue FARBE    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="ablstelle"
.continue FARBE    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="kuartnr"
.continue FARBE    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="zekunde"
.continue FARBE    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="labruf"
.continue FARBE    ? T|evtartengl="FIELD_EXIT"       & T|evtvar="labrufd"
.. ----------- ---------- ---------- -------------------------------------------
.continue ZEILEIN  ? T|evtartengl="ROW_INSERTION_AFTER"
.continue FAMENGE  ? T|evtartengl="ROW_MOVE_AFTER"
.continue FAMENGE  ? T|evtartengl="ROW_DELETION_AFTER"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!KBLAB: kblab
.protection -reset kfabhorizont 0   ? _M|kblab
.protection kfabhorizont 0          ?  M|kblab
.formula M|kfabhorizont = ""     ?  M|kblab
.copy M|kbfab     = _M|kblab
.copy M|kbfabinfo =  G|false
.copy M|kbpusinfo =  G|false
.continue ABMOD
..
!KBFAB: kbfab, kbfabinfo, kbpusinfo
.type bool U|xb
.formula U|xb = M|.EVTVAR
.protection -reset kfabhorizont 0   ?  U|xb
.protection kfabhorizont 0          ? _U|xb
.formula M|kfabhorizont = ""     ? _U|xb
.copy M|kblab = G|true      ? _U|xb
.copy M|kblab = G|false     ?  U|xb
.copy M|kbfab = G|false     ?  G|evtvar <> "kbfab"
.copy M|kbfabinfo = G|false ?  G|evtvar <> "kbfabinfo"
.copy M|kbpusinfo = G|false ?  G|evtvar <> "kbpusinfo"
.continue ABMOD
..
!ABMOD
.continue END ? F|empty(M|rahmen)
.select sales 'M|rahmen^id'
.continue EDI
..
!EFZAHL
.colour -background -1 -1 -1    einfzahl
.continue FAMENGE  ?  M|ozeilen > 0
.continue END
..
!ARTIKEL
.formula M|lfzahl=""
.formula M|kuartnr=""
.continue FARBE   ?  F|empty(M|kartikel)
.continue FARBE   ?  F|empty(M|rahmen)
.. fine product in blanket order
.select sales 'M|rahmen^id'
.continue ARTART  ? _G|mehr
!ARTZEIL
.select line
.continue FARBE   ? _G|mehr
.continue RAHZEIL ?  H|artex^id = M|kartikel^id
.continue ARTZEIL
.. find product in product customer relations
!ARTART
.formula M|kuartnr = ""
.formula U|xtsel = "$,,;kl=" + 'M|vkundeab^id' + ";art=" + 'M|kartikel^id' + ";@gruppe=6"
.select parts 'U|xtsel'
.formula M|kuartnr = H|kuartnr  ?  G|mehr
.continue FARBE
..
!FARBE
.colour -background -1 -1 -1    vkundeab  ? M|vkundeab<>""
.colour -background 'U|xabaslightyellow' vkundeab  ? M|vkundeab=""
.colour -background -1 -1 -1    werk      ? M|werk<>""
.colour -background 'U|xabaslightyellow' werk      ? M|werk=""
.colour -background -1 -1 -1    ablstelle ? M|ablstelle<>""
.colour -background 'U|xabaslightyellow' ablstelle ? M|ablstelle=""
.colour -background -1 -1 -1    kuartnr   ? M|kuartnr<>""
.colour -background 'U|xabaslightyellow' kuartnr   ? M|kuartnr=""
.colour -background -1 -1 -1    verwschl  ? M|verwschl<>""
.colour -background 'U|xabaslightyellow' verwschl  ? M|verwschl=""
.colour -background -1 -1 -1    zekunde   ? M|zekunde<>""
.colour -background 'U|xabaslightyellow' zekunde   ? M|zekunde=""
.colour -background -1 -1 -1    labruf
.colour -background 'U|xabaslightyellow' labruf    ?  F|empty(M|labruf)
.colour -background -1 -1 -1    labrufd
.colour -background 'U|xabaslightyellow' labrufd   ?  F|empty(M|labrufd)
.continue END
..
!ZIMP: show import directory
.command -parallel "(Infosystem) EDIVERZ ? empverz=(Yes) | bstart="
.continue END
..
!VERWSCH
.continue ERRVERW ? _(M|verwschl="11" ; M|verwschl="12" ; M|verwschl="13" ; M|verwschl="14" ; M|verwschl="15" ; M|verwschl="16" ;  M|verwschl="17" ; M|verwschl="18" ; M|verwschl="19" ; M|verwschl="S" ; M|verwschl="P" ; M|verwschl="E" ; M|verwschl="X" ; M|verwschl="M")
.colour -background -1 -1 -1    verwschl   ? M|verwschl<>""
.colour -background 'U|xabaslightyellow' verwschl   ? M|verwschl=""
.continue END
..
!MEVERWS
.set trans +
.menu Auswahl des VerwendungsschlÅssels
S=Serie                     >> .formula verwschl   = "S"
P=Pilot                     >> .formula verwschl   = "P"
E=Ersatz allgemein          >> .formula verwschl   = "E"
X=Sonstiges                 >> .formula verwschl   = "X"
M=Erstmuster                >> .formula verwschl   = "M"
.set trans -
.colour -background -1 -1 -1    verwschl   ? M|verwschl<>""
.colour -background 'U|xabaslightyellow' verwschl   ? M|verwschl=""
.continue END
..
!VS4984: Verwendungsschluessel nach VDA 4984
.set trans +
.menu Auswahl des VerwendungsschlÅssels
11 Produktion                 >> .formula verwschl = "11"
12 Ersatzteil                 >> .formula verwschl = "12"
13 Produktion und Ersatzteil  >> .formula verwschl = "13"
14 Probe                      >> .formula verwschl = "14"
15 Pilot                      >> .formula verwschl = "15"
16 ZusÑtzliche Anforderung    >> .formula verwschl = "16"
17 Ersatzmuster               >> .formula verwschl = "17"
18 Muster                     >> .formula verwschl = "18"
19 Anderes                    >> .formula verwschl = "19"
.set trans -
.colour -background -1 -1 -1    verwschl   ? M|verwschl<>""
.colour -background 'U|xabaslightyellow' verwschl   ? M|verwschl=""
.continue END
..
!PANLINT
.continue ERRINTV ? M|anliint <> "L" &  M|anliint <> "T" & M|anliint <> "W" & M|anliint <> "M"
.continue END
..
!MENANLI
.set trans +
.menu Auswahl des Intervalls
L(laut Termin)          >> .formula anliint      = "L"
T(TÑglich)              >> .formula anliint      = "T"
W(Wîchentlich)          >> .formula anliint      = "W"
M(Monatlich)            >> .formula anliint      = "M"
.set trans -
.continue END
..
!METERMS
.set trans +
.menu Auswahl des Sonderzeichens
000000 (leer)                  >> .formula M|termcod      = "000000"
222222 (kein Bedarf)           >> .formula M|termcod      = "222222"
333333 (RÅckstand)             >> .formula M|termcod      = "333333"
444444 (Sofortbedarf)          >> .formula M|termcod      = "444444"
555555 (Zeitraum - Startzeile) >> .formula M|termcod      = "555555"
555555 (Zeitraum - Termin)     >> .formula M|termcod      = "55555X"
999999 (Vorschaumengen)        >> .formula M|termcod      = "999999"
.set trans -
.continue END     ?  G|menue=0
.continue TERMINT  ?  M|termcod <> "55555X"
..
.set trans +
.menu Auswahl
Zeitraumbedarf (von/bis Woche) >> .formula M|txbuts = "Bedarf fÅr den Zeitraum (von/bis Woche)"
Monatsbedarf MM                >> .formula M|txbuts = "Bedarf fÅr den Monat MM"
Wochenbedarf WW                >> .formula M|txbuts = "Bedarf fÅr die Woche WW"
.set trans -
.formula M|nrtxbuts = 1      ? G|menue=1 ; G|menue=2 ; G|menue=3
.continue END     ? G|menue=0
..
.read "Jahr und von Woche WW bis Woche WW eingeben(JJWWWW)" xles    ? G|menue=1
.read "Jahr JJ und Monat MM eingeben (JJMM)" xles                   ? G|menue=2
.read "Jahr JJ und Woche WW eingeben (JJWW)" xles                   ? G|menue=3
.set trans -
.formula U|xles = U|xles + "00"                                           ? G|menue=2
.formula U|xles = U|xles << 2 + "00" + U|xles >> 2                        ? G|menue=3
.formula M|termcod = U|xles                                             ? +xles=6
.protection termint 'M|aktzeile'
..
!P555: check if a line with 555555 exists
.formula T|xiaktzeile = M|aktzeile
.select screen header
!N555
.select screen line
.continue I555 ? _T|mehr
.continue I555 ?  M|aktzeile = T|xiaktzeile
.continue E555 ?  M|termcod  = "555555"
.continue N555
!I555
.formula T|xt = M|txbuts
.formula T|xmenge = M|menge
.formula M|termcod = "555555"
.formula M|txbuts = T|xtextAbrufzeitraum
.formula M|menge = 0.0
.make screen line +O
.formula M|termcod = T|xles
.formula M|txbuts = T|xt
.formula M|menge = T|xmenge
.protection termint 'M|aktzeile'
.continue END
!E555
.select screen line 'xiaktzeile'
.continue END
..
!TERMINT
.formula M|termint = ""
.formula M|termint = "-1" ? G|menue=3
.formula M|termint = "."  ? G|menue=4
..
!TERMCOD
.formula M|txbuts = T|xtextLeer          ? M|termcod = "000000"
.formula M|txbuts = T|xtextKeinBedarf    ? M|termcod = "222222"
.protection termint 'M|aktzeile'            ? M|termcod = "222222"
.formula M|txbuts = T|xtextRueckstand    ? M|termcod = "333333"
.protection termint 'M|aktzeile'            ? M|termcod = "333333"
.formula M|txbuts = T|xtextSofortbedarf  ? M|termcod = "444444"
.protection termint 'M|aktzeile'            ? M|termcod = "444444"
.formula M|txbuts = T|xtextAbrufzeitraum ? M|termcod = "555555"
.formula M|menge  = 0                    ? M|termcod = "555555"
.formula M|fzahl  = 0                    ? M|termcod = "555555"
.protection termint 'M|aktzeile'            ? M|termcod = "555555"
.protection menge 'M|aktzeile'              ? M|termcod = "555555"
.formula M|txbuts = T|xtextVorschaumenge ? M|termcod = "999999"
.protection termint 'M|aktzeile'            ? M|termcod = "999999"
.continue END
..
!TERMUMW
.formula M|termcod = M|termint:8
.continue END
..
!AUFTRAG: Feldaustritt Rahmen
.continue END     ?  F|empty(M|kauftrag)
.continue END     ?  F|empty(M|kauftrag^rahmen)
.assign M|rahmen =  M|kauftrag^rahmen^id
..
!RAHMENP
.continue ERRRAH ? F|empty(M|rahmen)
.select sales 'M|rahmen^id'
.continue ERRRAH ? _mehr
.continue ZUO
..
!AUSW
.formula U|xtsel = "%,,nummer=;kunde=;werk=;ablstelle=;typ=(BlanketOrder)"
.select sales 'xtsel'
.continue END     ? _mehr
..
!ZUO
.formula M|rahmen   = H|nummer
.formula M|vkundeab = H|kunde2
.formula M|werk     = H|werk
.formula M|ablstelle= H|ablstelle
.formula M|verwschl = H|verwschl
.formula M|abbenr   = H|abschlnr
.colour -background -1 -1 -1    vkundeab  ? M|vkundeab<>""
.colour -background 'U|xabaslightyellow' vkundeab  ? M|vkundeab=""
.colour -background -1 -1 -1    werk      ? M|werk<>""
.colour -background 'U|xabaslightyellow' werk      ? M|werk=""
.colour -background -1 -1 -1    ablstelle ? M|ablstelle<>""
.colour -background 'U|xabaslightyellow' ablstelle ? M|ablstelle=""
.colour -background -1 -1 -1    verwschl  ? M|verwschl<>""
.colour -background 'U|xabaslightyellow' verwschl  ? M|verwschl=""
..
!EDI
.copy M|kbvkauv = G|false
.copy M|kbvklab = G|false
.formula M|kabm = ""
.formula U|xvorgang = "VKAUV"
.formula U|xedinachr = "2101" ?  M|kblab
.formula U|xedinachr = "2102" ?  M|kbfab
.formula U|xedinachr = "2104" ?  M|kbpusinfo
.formula U|xedinachr = ""     ?  M|kbfabinfo
.select add kunde
.input "dfue/DFUE.GET.PROTOK"
.select add
.. kbfabinfo is not supported with new forecasts
.. kbfabinfo is not supported with new forecasts
.formula U|xediieabm = "4010" ?  M|kblab & _F|empty(U|xediabm) & F|empty(U|xediieabm)
.formula U|xediieabm = "4020" ?  M|kbfab & _F|empty(U|xediabm) & F|empty(U|xediieabm)
.copy M|kabm = U|xediieabm    ? _M|kbfabinfo
.copy M|kbvkauv = G|true  ?  U|xediaktiv  &  F|empty(M|kabm)
.copy M|kbvklab = G|true  ?  U|xediaktiv  & _F|empty(M|kabm)
.formula M|labdat = M|kabm^datprefix  ? _F|empty(M|kabm)
.input "dfue/ERFLIE.LABDATEI.FA"
.continue END ? G|evtvar="kblab" ; G|evtvar="kbfab" ;G|evtvar="kbfabinfo" ; G|evtvar="kbpusinfo"
!EEDI
..
!Z1
.select line
.continue ? _mehr
.continue Z1 ? typ<>arpos
.continue Z1 ? art^packmit=true
!RAHZEIL: used on product change
.formula M|kuartnr  = H|zkuartnr
.assign M|kartikel = H|artex^id
.colour -background -1 -1 -1    kuartnr   ? M|kuartnr<>""
.colour -background 'U|xabaslightyellow' kuartnr   ? M|kuartnr=""
.formula M|keinhtaz = H|he
.type text U|xposphe ? _F|defined(U|xposphe)
.formula U|xposphe = 'M|keinhtaz(L=":")'
.input "EDI.UNITS"
.formula M|meinheit = U|evda
.formula M|lfzahl   = H|fzahl
.formula M|labrufa  = ""
.formula M|labrufad = ""
.continue END  ?  F|empty(H|labediid)
.select edifact 'H|labediid'
.formula M|labrufa  = H|labruf   ?  G|mehr
.formula M|labrufad = H|labrufd  ?  G|mehr
.continue END
..
..
!BUEINH
.set trans +
.menu Auswahl der Einheit
ST=StÅck                >> .formula M|meinheit     = "ST"
M=Meter                 >> .formula M|meinheit     = "M"
M2=Quadratmeter         >> .formula M|meinheit     = "M2"
M3=Kubikmeter           >> .formula M|meinheit     = "M3"
L=Liter                 >> .formula M|meinheit     = "L"
T=Tonne                 >> .formula M|meinheit     = "T"
KG=Kilogramm            >> .formula M|meinheit     = "KG"
KM=Kilometer            >> .formula M|meinheit     = "KM"
.set trans -
.continue VDA2TAZ
..
!VDA2TAZ
.type text U|xposphe ? _F|defined(U|xposphe)
.formula U|xposphe=M|meinheit
.input EDI.UNITS
.formula M|meinheit=U|evda
.assign  M|keinhtaz=U|etaz
.formula M|isoeinheit=U|eiso
.continue PRUEINH
..
!TAZ2VDA
.type text U|xposphe ? _F|defined(U|xposphe)
.formula U|xposphe = 'M|keinhtaz(L=":")'
.input EDI.UNITS
.formula M|meinheit=U|evda
.assign  M|keinhtaz=U|etaz
.formula M|isoeinheit=U|eiso
.continue PRUEINH
..
!PRUEINH
.continue ERREINH ? F|empty(M|meinheit)
.continue END
..
..
!FAMENGE
.formula U|xiaktzeile  = M|aktzeile
.select screen header
.formula U|xlfzahl = M|lfzahl
.formula U|xefzahl = M|einfzahl
!LFZ
.select screen line
.continue MACH ? _mehr
.formula M|meinheitt = M|meinheit    ? _F|empty(M|meinheit)
.formula M|teinhtaz  = M|keinhtaz    ? _F|empty(M|meinheit)
.formula U|xlfzahl  = U|xlfzahl + M|menge
.formula U|xefzahl  = U|xefzahl + M|menge
.formula M|fzahl = U|xlfzahl
.formula M|tefz  = U|xefzahl
.continue LFZ
!MACH
.select screen line 'xiaktzeile'
.continue END
..
!NEUZEI: needed to add rows via edp do typedcmd=infosystem
.continue END     ? M|kinzeilen <= T|xirows
.make screen line +O
.formula T|xirows = T|xirows +1
.continue NEUZEI
..
!ZEILEIN
.formula M|meinheitt = M|meinheit    ? _F|empty(M|meinheit)
.formula M|teinhtaz  = M|keinhtaz    ? _F|empty(M|meinheit)
..*****************************************************************************
!END
.continue
..
..
!ERRVERW
.set trans +
.formula T|xtfehler = F|formatstr("Der VerwendungsschlÅssel {1}{2}{1} ist nicht erlaubt!", dblquote, 'M|verwschl')
.set trans -
.error 'T|xtfehler'
.colour -background 'U|xabaslightyellow' verwschl
.end 1
..
!ERREINH
.set trans +
.formula T|xtfehler = F|formatstr("Die Einheit {1}{2}{1} ist keine gÅltige VDA-Einheit.", dblquote, 'M|keinhtaz')
.set trans -
.error 'T|xtfehler'
.colour -background 'U|xabaslightyellow' meinheit
.end 1
..
!ERRINTV
.set trans +
.formula T|xtfehler = F|formatstr("Das Intervall {1}{2}{1} ist nicht erlaubt.", dblquote, 'M|anliint')
.set trans -
.colour -background 'U|xabaslightyellow' anliint
.error 'T|xtfehler'
.end 1
..
!ERRRAH
.. possibly 2 lines, have to use .box instead of .fehler
.formula T|xtfehler = ""
.set trans +
.formula T|xtfehler = F|formatstr("Mit der Identnummer {1}{2}{1} ist kein Rahmenauftrag vorhanden!", dblquote, 'M|rahmen^nummer')    ? _F|empty(M|rahmen)
.set trans -
.box Fehler
?'T|xtfehler'       ? T|xtfehler <> ""
Bitte wÑhlen Sie einen Rahmenauftrag!
..
.formula M|rahmen = ""
.continue AUSW
