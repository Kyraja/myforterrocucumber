..!interpreter english translate noabbrev
..!meta M|=dfue/EDLGES
..*****************************************************************************
.. Name           : EDLGES.TAB.WITHDRAW
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : Create row for withdraw packing slip row.
..*****************************************************************************
.set trans -
..
.. Create withdraw row
.make screen line +O
.colour -background 'U|xabassubtotal' 'M|aktzeile'
.formula M|turspr  = T|xEntnahme
..
.. Sum withdraw quantities for this product in field kmgeges
.formula M|kmgeges = M|kmgeges + 4|mge
.. 
.. Withdraw head
.assign M|tkunde = 3|kunde^id
.assign M|tkunde2 = 3|kunde2^id
.assign M|tedl = 3|edl^id
.copy M|twerk = 3|werk
.copy M|tablstelle = 3|ablstelle
.assign M|tnummer = 3|id
.assign M|tedinr = 3|ident
.copy M|tvom = 3|vom
.copy M|tedlnr = 3|edllsnr
.copy M|tedldat = 3|edllsdat
.. 
.. Withdraw row
.assign M|tart = 4|artex^id
.copy M|tnamebspr = 4|artex^sucherw
.copy M|tkuart = 4|zkuartnr
.copy M|tcharge = 4|charge
.copy M|tmge = 4|mge
.copy M|tfmenge = 4|fmenge ? 4|artex^packmit
.formula M|tganr = 4|ganr
.copy M|tfzahl = 4|fzahl
.. 
..*****************************************************************************
!END
.continue
