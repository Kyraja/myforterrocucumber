..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TSBPRINT.KBUZEIGEN.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Show files in text box or with pdf viewer
..*****************************************************************************
..!meta M|=dfue/TSBPRINT
.set trans -
.. 
.type text xtsource
.. 
.. 
.. Show which type of file?
.. ----------- ---------- ---------- -------------------------------------------
.continue TEXT    ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbuihsszeigen"
.continue TEXT    ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbuimportzeigen"
.continue PDF     ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbugtlzeigen"
.continue PDF     ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbutsbzeigen"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
.. 
.. 
!TEXT
.formula U|xtsource = M|kihssdatei    ? G|evtvar="kbuihsszeigen"
.formula U|xtsource = M|kimportdatei ? G|evtvar="kbuimportzeigen"
.continue END ? _F|fileexists(U|xtsource) ; F|isdir(U|xtsource) ; F|filesize(U|xtsource)=0
.. 
.. Show text file in text box
.output terminal
.input "DATEI.F"
.input -text 'U|xtsource'
.continue END
.. 
..
!PDF
.copy U|xtsource = M|kgtldatei ? G|evtvar="kbugtlzeigen"
.copy U|xtsource = M|ktsbdatei ? G|evtvar="kbutsbzeigen"
.continue END ? _F|fileexists(U|xtsource) ; F|isdir(U|xtsource) ; F|filesize(U|xtsource)=0
.. 
.. Show pdf file with pdf viewer on client
.pc.copy -BIN -PC 'F|formatstr("{1} {4}{3}\TSB.{2}.pdf{4}", U|xtsource, G|evtvar, G|cltempdir, G|dblquote)'
.pc.open 'F|formatstr("{2}{1}\TSB.{3}.pdf{2}", G|cltempdir, G|dblquote, G|evtvar)'
.continue END
..
..*****************************************************************************
!END
.continue
