..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MULTISITE.SEND.ERROR
.. Autor          : dsch
.. Verantwortlich : dsch
.. Kontrolle      : mh
.. Funktion       : erzeugt eine Administrationsmeldung falls das Senden der   
..                  Multisite-Nachricht nicht funktioniert.
.. Functionality  : generates an administration message if the multisite message
..                  can not be send
..*****************************************************************************
..
.set trans -
..
.type text U|xerrmsg?  _F|defined(U|xerrmsg)
.type text U|xerrmsg1? _F|defined(U|xerrmsg1)
.type text U|xerrmsg2? _F|defined(U|xerrmsg2)
..
.type text U|xmessageid ? _F|defined(U|xmessageid)
.type text xtempFopFile ? _F|defined(U|xtempFopFile)
.type text xdestFopFile ? _F|defined(U|xdestFopFile)
..
.formula U|xmessageid = G|versionneu ? F|empty(U|xmessageid)
.formula U|xdestFopFile = "rmtmp/" + U|xmessageid
..
.set trans +
.formula U|xerrmsg1 = F|formatstr("Fehler beim Senden der Nachricht {1}.", U|xmessageid)
.formula U|xerrmsg2 = F|formatstr("Die Datei {1} wurde in das Verzeichnis {2} verschoben und muss manuell verarbeitet werden.", U|xtempFopFile,U|xdestFopFile)
.set trans -
.formula U|xerrmsg = F|formatstr("{1} {2}", U|xerrmsg1,  U|xerrmsg2)
..
.continue END ? F|empty(U|xtempFopFile)
..
.output addedto "ADM.FEHL"
.input -text 'U|xtempFopFile'
.output
..
.system 'F|formatstr("mv -f {1} {2}", U|xtempFopFile, U|xdestFopFile)' background
.continue END ? G|status=0
.system 'F|formatstr("cp -f {1} {2}", U|xtempFopFile, U|xdestFopFile)' background
.system 'F|formatstr("rm -f {1}", U|xtempFopFile)' background
..
!END
.note -errorreport 'U|xerrmsg'
.end 1
