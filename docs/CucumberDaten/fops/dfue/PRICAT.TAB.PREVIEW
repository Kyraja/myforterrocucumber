..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRICAT.TAB.PREVIEW
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Data is used to evalute difference with previous message
...Includes       :
..  include dfue/PRICAT.IHSS.DETAIL
..*****************************************************************************
.set trans -
..
.type text xtvorschau ? _F|defined(U|xtvorschau)
.type text xtzeile ? _F|defined(U|xtzeile)
..
.formula M|tdetailvorschau = ""
..
.file -tempname U|xtvorschau
.output new 'U|xtvorschau'
.output 
.formula M|dateiname = U|xtvorschau
.input "PRICAT.IHSS.DETAIL"
!NVIEW
.select from 'U|xtvorschau' xtzeile^
.continue EVIEW ? _G|mehr
.continue NVIEW ?  U|xtzeile/"PGI1*"
.continue NVIEW ?  U|xtzeile/"LIN1*"
.formula M|tdetailvorschau = M|tdetailvorschau + U|xtzeile
.continue NVIEW 
!EVIEW
.formula M|dateiname = ""
..
..*****************************************************************************
!END
.continue
