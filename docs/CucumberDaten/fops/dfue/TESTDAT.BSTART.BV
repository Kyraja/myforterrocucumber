..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TESTDAT.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Startbutton: Import der Daten ins Infosystem
.. Functionality  : Start button: import of data into infosystem
...Includes
..  include     dfue/TESTDAT.HOLEVON
..  include     dfue/TD.LIE.DAT
..  include     dfue/TD.LIE.EDINFO.DAT
..  include     dfue/TD.KDE.DAT
..  include     dfue/TD.KDE.EDINFO.DAT
..  include     dfue/TD.KSA.DAT
..  include     dfue/TD.KSA.EDINFO.DAT
..  include     dfue/TD.ART.DAT
..  include     dfue/TD.ART.AKLE.DAT
..  include     dfue/TD.PAC.DAT
..  include     dfue/TD.RAH.DAT
..  include     dfue/TD.EKRAH.DAT
..  include     dfue/TD.LAB.DAT
..  include     dfue/TD.FAB.DAT
..*****************************************************************************
.set trans -
..
.. load default test data from scripts into table in this order
..  kblieferant
..  kbkunde
..  kbkunsach
..  kbartikel
..  kbkunartbez
..  kbpackanw
..  kbvkrahmen
..  kbekrahmen
..  kbliefab
..
.type text   xtlader
.type text   xtdbgruppe
..
.. start with empty table
.make screen line --
..
..
.continue ELIF    ? _M|kblieferant
.formula U|xtlader = F|foppath("TD.LIE.DAT")
.formula U|xtdbgruppe = "1:1"
.input "dfue/TESTDAT.HOLEVON"
.formula U|xtlader = F|foppath("TD.LIE.EDINFO.DAT")
.formula U|xtdbgruppe = "1:4"
.input "dfue/TESTDAT.HOLEVON"
!ELIF
..
..
.continue EKUN    ? _M|kbkunde
.formula U|xtlader = F|foppath("TD.KDE.DAT")
.formula U|xtdbgruppe = "0:1"
.input "dfue/TESTDAT.HOLEVON"
.formula U|xtlader = F|foppath("TD.KDE.EDINFO.DAT")
.formula U|xtdbgruppe = "0:4"
.input "dfue/TESTDAT.HOLEVON"
!EKUN
..
..
.continue EKSB    ? _M|kbkunsach
.formula U|xtlader = F|foppath("TD.KSA.DAT")
.formula U|xtdbgruppe = "0:2"
.input "dfue/TESTDAT.HOLEVON"
.formula U|xtlader = F|foppath("TD.KSA.EDINFO.DAT")
.formula U|xtdbgruppe = "0:4"
.input "dfue/TESTDAT.HOLEVON"
!EKSB
..
..
.continue EART    ? _M|kbartikel
.formula U|xtlader = F|foppath("TD.ART.DAT")
.formula U|xtdbgruppe = "2:1"
.input "dfue/TESTDAT.HOLEVON"
!EART
..
..
.continue EAKLE   ? _M|kbkunartbez
.formula U|xtlader = F|foppath("TD.ART.AKLE.DAT")
.formula U|xtdbgruppe = "2:7"
.input "dfue/TESTDAT.HOLEVON"
!EAKLE
..
..
.continue EPAK    ? _M|kbpackanw
.formula U|xtlader = F|foppath("TD.PAC.DAT")
.formula U|xtdbgruppe = "106:1"
.input "dfue/TESTDAT.HOLEVON"
!EPAK
..
..
.continue EVKR    ? _M|kbvkrahmen
.formula U|xtlader = F|foppath("TD.RAH.DAT")
.formula U|xtdbgruppe = "3:20"
.input "dfue/TESTDAT.HOLEVON"
!EVKR
..
..
.continue EEKR    ? _M|kbekrahmen
.formula U|xtlader = F|foppath("TD.EKRAH.DAT")
.formula U|xtdbgruppe = "4:20"
.input "dfue/TESTDAT.HOLEVON"
!EEKR
..
..
.continue ELAB    ? _M|kbliefab
.formula U|xtlader = F|foppath("TD.LAB.DAT")
.formula U|xtdbgruppe = "53:0"
.input "dfue/TESTDAT.HOLEVON"
.formula U|xtlader = F|foppath("TD.FAB.DAT")
.formula U|xtdbgruppe = "53:0"
.input "dfue/TESTDAT.HOLEVON"
!ELAB
..
..
..*****************************************************************************
!END
.continue
