..!interpreter english translate noabbrev
..!meta M|=dfue/FORECASTCONFIG
..*****************************************************************************
.. Name           : FORECASTCONFIG.EV
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
...Includes
..      include     dfue/FORECASTCONFIG.PROTECTION.BEFORE
..      include     dfue/FORECASTCONFIG.PROTECTION.AFTER
..      include     dfue/FORECASTCONFIG.UPGRADE.STDLAB
..      include     dfue/FORECASTCONFIG.UPGRADE.STDFAB
..      include     dfue/FORECASTCONFIG.UPGRADE.STDVAB
..*****************************************************************************
.set trans -
..
.type bool xb
.. 
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbmitediinfos"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="khauptkunde"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kkundevon"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kkundebis"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kkundesuch"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kmerkmal1"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kmerkmal2"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kmerkmal3"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kmerkmal4"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kmerkmal5"
.continue INIT     ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kmerkmal6"
.. ----------- ---------- ---------- -------------------------------------------
.continue LINKED1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbohnejedis"
.. ----------- ---------- ---------- -------------------------------------------
.continue TOGGLE1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbnachricht1"
.continue TOGGLE1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbnachricht2"
.continue TOGGLE1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbnachricht3"
.. ----------- ---------- ---------- -------------------------------------------
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbanlegen"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbloeschen"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbkonfigurieren"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbaktivieren"
.continue TOGGLE2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kbdeaktivieren"
.. ----------- ---------- ---------- -------------------------------------------
.continue PARAM1  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kauidfldneu"
.continue PARAM2  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kauupdateneu"
.continue PARAM3  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kabrdiffabneu"
.continue PARAM4  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kabrlspruefneu"
.continue PARAM5  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kabmodellneu"
.continue PARAM6  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kzuoschemaneu"
.continue PARAM7  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar ="kieabmodellneu"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!LINKED1
.copy M|kbmitediinfos = G|true ? M|kbohnejedis
.continue END 
.. 
!PARAM1
.copy M|kauupdateneu = G|false ? M|kauidfldneu
.continue END
.. 
!PARAM2
.copy M|kauidfldneu = G|false ? M|kauupdateneu
.continue END
.. 
!PARAM3
.formula M|kabrlspruefneu = G|false ?  M|kabrdiffabneu
.continue END 
.. 
!PARAM4
.formula M|kabrdiffabneu = G|false ?  M|kabrlspruefneu
.continue END
..
!PARAM5 
.formula M|kzuoschemaneu = M|kabmodellneu^imschema^id
.continue END ? F|empty(M|kzuoschemaneu)
.assign M|kieabmodellneu = 'F|formatstr("$,,;imex=(Import);imschema=={1}", M|kzuoschemaneu^id)'
.continue MSGTYPE ? M|kedinachr^id<>M|kzuoschemaneu^edinachr^id  
.continue ABMTYPE ? 'M|kabmodellneu^imex(L=":")'<>"(Processing)"
.continue END
..
!PARAM6
.formula M|kabmodellneu = "" ? F|empty(M|kzuoschemaneu)
.formula M|kieabmodellneu = "" ? F|empty(M|kzuoschemaneu)
.continue END ? F|empty(M|kzuoschemaneu)
.assign M|kabmodellneu = 'F|formatstr("$,,;imex=(Processing);imschema=={1}", M|kzuoschemaneu^id)'  
.assign M|kieabmodellneu = 'F|formatstr("$,,;imex=(Import);imschema=={1}", M|kzuoschemaneu^id)'  
.continue MSGTYPE ? M|kedinachr^id<>M|kzuoschemaneu^edinachr^id  
.continue END
..
!PARAM7 
.formula M|kzuoschemaneu = M|kieabmodellneu^imschema^id
.continue END ? F|empty(M|kzuoschemaneu)
.assign M|kabmodellneu = 'F|formatstr("$,,;imex=(Processing);imschema=={1}", M|kzuoschemaneu^id)'  
.continue MSGTYPE ? M|kedinachr^id<>M|kzuoschemaneu^edinachr^id  
.continue ABMTYPE ? 'M|kieabmodellneu^imex(L=":")'<>"(Import)"
.continue END
.. 
!TOGGLE1
.input "FORECASTCONFIG.PROTECTION.BEFORE"
.formula U|xb = M|.evtvar
.copy M|kbanlegen = G|false
.copy M|kbloeschen = G|false
.copy M|kbkonfigurieren = G|false
.copy M|kbaktivieren = G|false
.copy M|kbdeaktivieren = G|false
.copy M|kbnachricht1 = G|false
.copy M|kbnachricht2 = G|false
.copy M|kbnachricht3 = G|false
.copy M|.evtvar = U|xb 
.copy M|kedinachr = M|kedinachr1
.copy M|kedinachr = M|kedinachr2 ? M|kbnachricht2
.copy M|kedinachr = M|kedinachr3 ? M|kbnachricht3
.input "FORECASTCONFIG.UPGRADE.STDLAB" ? M|kbnachricht1
.input "FORECASTCONFIG.UPGRADE.STDFAB" ? M|kbnachricht2
.input "FORECASTCONFIG.UPGRADE.STDVAB" ? M|kbnachricht3
.copy M|kbnachricht1 = G|false ? F|empty(M|kabmodellneu) ; F|empty(M|kzuoschemaneu) ; F|empty(M|kieabmodellneu)
.copy M|kbnachricht2 = G|false ? F|empty(M|kabmodellneu) ; F|empty(M|kzuoschemaneu) ; F|empty(M|kieabmodellneu)
.copy M|kbnachricht3 = G|false ? F|empty(M|kabmodellneu) ; F|empty(M|kzuoschemaneu) ; F|empty(M|kieabmodellneu)
.make screen line -- ? M|tzeilen > 0
.input "FORECASTCONFIG.PROTECTION.AFTER"
.continue END 
..
.. 
!TOGGLE2
.input "FORECASTCONFIG.PROTECTION.BEFORE"
.formula U|xb = M|.evtvar
.copy M|kbanlegen = G|false
.copy M|kbloeschen = G|false
.copy M|kbkonfigurieren = G|false
.copy M|kbaktivieren = G|false
.copy M|kbdeaktivieren = G|false
.copy M|.evtvar = U|xb 
.input "FORECASTCONFIG.PROTECTION.AFTER"
.continue END 
.. 
.. 
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
.. 
.. 
!MSGTYPE
.error Abbildungsmodelle und Schema sind fÅr eine andere EDI-Nachricht definiert.
.formula M|kabmodellneu = ""
.formula M|kieabmodellneu = ""
.formula M|kzuoschemaneu = ""
.end 1
.. 
!ABMTYPE
.error Das zugeordnete Abbildungsmodell enthÑlt einen nicht zulÑssigen öbertragungswert.
.end 1
