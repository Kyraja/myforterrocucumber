..
.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
.set trans +
.type text  xAUnr
.type text  xAbbenr
.type text  xAUid
.type bool  xbfehler
.type text  xintedi
.type text  xdfehler
.type text  xAblStelle
.type bool  xbsperre
.type text  xcom
.type integer   xDFUEproto
.type text  xdPARAM
.type text  xdEDI
.type text  xEDInr
.type text  xIDrahmen
.type integer   xii
.type text  xKuLiNr
.type text  xKuNr xKuNrGLN
.type text  xKuNrDeb xKuNrDebGLN
.type text  xWEmpfNr xWEmpfNrGLN
.type integer   xLfdNr
.type text  xLiefKenn
.type text  xLiWerk
.type text  xLSnr
.type bool  xmehr
.type integer   xPlausiArt
.type integer xzaehler
.type text xlsliste
.type text  xpnum
.type integer   xpos
..... procedure stack pointer .....
.type integer   xprocsp
.type text  xpuffer
.type text  xrahmen
.type text  xsuch
.type text  xsys
.type text  xtxt1 xtxt2 xtxt3 xtxt4 xtxt5 xtxt6 xtxt7
.type text  xtxt8 xtxt9 xtxt10 xtxt11 xtxt12 xtxt13
.type text  xtxt14 xtxt15 xtxt16 xtxt17 xtxt18 xtxt19
.type text  xtxt20 xtxt21 xtxt22 xtxt23 xtxt24 xtxt25
.type text  xuebdat
.type text  xuebzeit
.type text  xVerwSchl
.type text  xvorgang
.type text  xVorgSchl
.type text  xvortxt
.type text  xWerk
.type text  xZeichKu
..
.type text  xPostBetreff
.type text  xPostEmpf
.type text  xPostFtext
.type text  xPostStichw1
.type text  xPostStichw2
.type text  xPostStichw3
.type text  xPostStichw4
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
.formula xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
..
!PROC001: ----- FEHLER -----
.formula xbfehler = true
..
.output addedto 'xdfehler'
?'xtxt1' ? +xtxt1 > 0
?'xtxt2' ? +xtxt2 > 0
..
.continue 'xprocst.xprocsp'
..
..
!PROC002: ----- SENDE.POST -----
.formula xPostBetreff = "Fehler beim öbernehmen von VK-VorgÑngen in EDI-Datenbank"
.formula xPostStichw1 = "DFö-Fehler"
.formula xPostFtext   = xdfehler
.formula xPostEmpf    = xIdDfueExVerteil
..
..**ok,30.11.2005
.input 'xdPostSenden' ? xPostEmpf<>""
..
.continue 'xprocst.xprocsp'
..
..
!PROC003: ----- WRITE_EDI_SET -----
.. hol zeile aus zwischendatei
.select from 'xdEDI' xtxt1 # xtxt2 # xtxt3 # xtxt4 # xtxt5 # xtxt6 # xtxt7 # xtxt8 # xtxt9 # xtxt10 # xtxt11 # xtxt12 # xtxt13 # xtxt14 # xtxt15 # xtxt16 # xtxt17 # xtxt18 # xtxt19 # xtxt20 # xtxt21 # xtxt22 # xtxt23 # xtxt24 # xtxt25 #
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(mehr)
.make line
..
.formula xii = 1
..
..
!LOOP002: ==============================
.continue ELOP002 ? _(xii <= 25)
.formula h|text.xii = xtxt.xii
..**ok,22.09.2000 (untere if then else ist NEU)
..
..
.continue EL001 ? _(xii=25)
.. IF001
.formula xzaehler = xzaehler + 1
.formula h|text.xii = xzaehler
..
!EL001
.. FI001
..
.formula xii = xii + 1
..
.continue LOOP002
!ELOP002: ==============================
..
.. hol zeile aus zwischendatei
.select from 'xdEDI' xtxt1 # xtxt2 # xtxt3 # xtxt4 # xtxt5 # xtxt6 # xtxt7 # xtxt8 # xtxt9 # xtxt10 # xtxt11 # xtxt12 # xtxt13 # xtxt14 # xtxt15 # xtxt16 # xtxt17 # xtxt18 # xtxt19 # xtxt20 # xtxt21 # xtxt22 # xtxt23 # xtxt24 # xtxt25 #
..
.continue LOOP001
!ELOP001: ==============================
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.. --------------------   BLOCK  --------------------
.. initialisierung
..die parameterdatei
..**ok,08.01.2003 (xarb wurde entfernt)
.formula xdPARAM = "dfue/DFUE.EXP.INI"
.input 'xdPARAM'
..
.. die tmp. datei, die spÑter der EDI-datensatz wird
.formula xdEDI  = "X.ORDSP." + pid + ".TMP"
..
.. globale fehlermeldungsdatei, die als freitext per post gesendet wird
.formula xdfehler = "X.ERR." + pid + ".TMP"
.input DATEI.F
.output new 'xdfehler'
.output terminal
..
.. -------------------- ENDBLOCK --------------------
..
.. werk lieferant
.select company "$,,;@gruppe=10;gruppe=10"
..
..
.continue EL002 ? _(mehr)
.. IF002
.formula xLiWerk = h|werk
.select -
..
.continue FI002
!EL002
.. fehler
.formula xtxt1 = "Kann Betriebsdatensatz 1 nicht finden!"
.formula xtxt2 = ""
..
!FI002
..
.. Meldungen fÅr Anwender
..
.continue EL003 ? _(xbRMeldAn)
.. IF003
.formula U|xtsel = "$,,;@gruppe=1;@ablageart=(1);@zeilen=(0);dfuesenden=yes;ktyp=(3);ablagef=no"
.select sales 'xtsel'
..
..
.continue EL004 ? _(mehr)
.. IF004
Folgende AuftragsbestÑtigungen stehen zum Senden bereit

Datum: 'datum'


Ident-Nr Senden Kunde    Debitor   Datum
-------- ------ -------- --------- --------

.formula xd = H|dfuesenden
'   num' '  xd' 'kunde ' 'kunde2 ' '   vom'
.select sales
..
..
!LOOP003: ==============================
.continue ELOP003 ? _(mehr)
.formula xd = H|dfuesenden
'   num' '  xd' 'kunde ' 'kunde2 ' '   vom'
.select sales
..
.continue LOOP003
!ELOP003: ==============================
..
.menu Sollen diese gesendet werden
JA, senden         >>
NEIN, nicht senden >>
..
..
.. =====   CASE001   =====
.continue BRK001 ? _(G|menue = 1)
..
..
.continue ESAC001
!BRK001
.end
..
!ESAC001: =====   ENDCASE   =====
..
.continue FI004
!EL004
.. keine vorhanden
.box Meldung
Aktuell sind keine AuftragsbestÑtigungen zum Senden vorhanden!
.end
..
!FI004
..
!EL003
.. FI003
..
!HOLAU
..
.formula U|xtsel = "$,,;@gruppe=1;@ablageart=(1);@zeilen=(0);dfuesenden=yes;ktyp=(3);ablagef=no"
.formula U|xtsel = U|xtsel + F|formatstr(";kunde={1}", M|kkunde^id) ? _F|empty(M|kkunde)
.formula U|xtsel = U|xtsel + F|formatstr(";betreuer={1}", M|betreuer^id) ? _F|empty(M|betreuer)
.select sales 'xtsel'
..
..
.continue EL005 ? _(mehr)
.. IF005
.. Nummer fÅr Textausgabe, Id zum Lesen
.formula T|xAUnr = H|num
.formula T|xAUid = H|id
.formula T|xAbbenr = H|frzeich
.formula T|xAbbenr = H|abschlnr ? _F|empty(H|abschlnr)
..
.formula xvortxt = "Auftrag " + xAUnr
..
..**ok,22.09.2000 (Kunden-Nr vom Auftrag merken, um spÑter in die EDI-DB-Kopf zu schreiben
.formula xKuNr    = h|kunde
.formula xKuNrGLN    = 'h|kunde^gln'
.formula xKuNrDeb = h|kunde2
.formula xKuNrDebGLN = 'h|kunde2^gln'
.formula xWEmpfNr = h|kunde3
.formula xWEmpfNrGLN = 'h|kunde3^gln'
..
.. dfue-protokoll aus kunde.edinfo
.. ----------------------------------------
.add h|kunde
..
.continue EL006 ? _(mehr)
.. IF006
.. ----------------------------------------
.reserve
..
.continue EL007 ? _(gruppe=2)
.. IF007
..**ok,22.09.2000 (werk und ablade merken, um spÑter in die EDI-DB-Kopf zu schreiben
.formula xWerk = d|werk
.formula xAblStelle = d|ablstelle
..
!EL007
.. FI007
..
.. erst mal kein protokoll
.formula xDFUEproto = -1
.formula xvorgang = "VKAUB"
.input "DFUE.GET.PROTOK"
.formula U|xintedi = "ORDRSP.STD"  ?  F|empty(U|xintedi)
..
.select
.. ----------------------------------------
..
..
.continue EL008 ? _(xDFUEproto < 0)
.. IF008
.. kein Åbertragungsprotokoll
.formula xtxt1 = "Kann öbertragungsprotokoll von Kunde " + h|kunde
.formula xtxt2 = "nicht ermitteln! Auftrag-ID:" + xAUnr
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
..
.select lock sales 'xAUid'
.formula h|dfuesenden = false
.formula h|ident = "ERROR"
.rewrite
..
..
.continue EL009 ? _(xbRMeldAn)
.. IF009
.. Fehler
.output terminal
Fehler im Auftrag 'xAUnr',
siehe die Post bzw. das Fehlerprotokoll!
..
!EL009
.. FI009
..
.formula xbfehler = false
..
.continue HOLAU
..
!EL008
.. FI008
..
.continue FI006
!EL006
.. kein kunde
.formula xtxt1 = "Kann Kunden " + 'h|kunde' + " nicht lesen!"
.formula xtxt2 = "Auftrag-ID: " + xAUnr
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
..
.select lock sales 'xAUid'
.formula h|dfuesenden = false
.formula h|ident = "ERROR"
.rewrite
..
..
.continue EL010 ? _(xbRMeldAn)
.. IF010
.output terminal
Fehler im Auftrag 'xAUnr',
siehe die Post bzw. das Fehlerprotokoll!
..
!EL010
.. FI010
..
.formula xbfehler = false
..
.continue HOLAU
..
!FI006
..
.add
.. ----------------------------------------
..
.. ab hier wird exclusiv gearbeitet
.formula T|xcom = dblquote + "AUB2EDI:" + xAUnr + dblquote
.occupy 'T|xcom'
..
..
.continue EL011 ? _(_(h|dfuesenden))
.. IF011
.. FEHLER
.occupy
.formula xtxt1 = "AuftragsbestÑtigung " + h|num + " soll nicht gesendet werden!"
.formula xtxt2 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
..
.select lock sales 'xAUid'
.formula h|dfuesenden = false
.formula h|ident = "ERROR"
.rewrite
..
..
.continue EL012 ? _(xbRMeldAn)
.. IF012
.. Fehler
.output terminal
Fehler im Auftrag 'xAUnr',
siehe die Post bzw. das Fehlerprotokoll!
..
!EL012
.. FI012
..
.formula xbfehler = false
..
.continue HOLAU
..
!EL011
.. FI011
..
.select -
..
.output new 'xdEDI'
.output
..
.. die Variable xintedi wird im Unterprogramm DFUE.GET.PROTOK gefÅllt
.formula U|xtvorgang = xAUnr
.type integer xanzls ? _F|defined(U|xanzls)
.formula U|xanzls = 0
.input 'U|xintedi'
.formula xanzls = 1
..
.. und ab in die EDI-DB damit
.output
..
.. erst mal den kopf des EDI-datensatzes anlegen
..**ok,02.09.2002 (ORDERSSP als ORDRSP geÑndert)
.formula xsuch = "VKORDRSP"
..
.make edifact
.formula such = xsuch
.. Nachricht Kennung 2107 = Auftragsbestaetigung
.formula h|edinachr = "2107"
..
.. interne bezeichnung
.formula h|name = "ausgehende AuftragsbestÑtigung "
.formula h|name = h|name + " " + xtvorgang
..
.. status: erstmal undefiniert
.formula h|status = 99
..
.. eks-vorgangsnr, wenn nur ein vorgang
.formula h|ideksvor = xAUnr
.formula h|abbenr   = xAbbenr
..
.. fehlercode: erstmal undefiniert
.formula h|fcode = 99
..
.. import/export-flag setzen
.formula h|imex = "EX"
..
.. vorgangsart -> AUB
.formula h|vorart = "23"
..
.. Vorgang
.formula h|ideksvor = xtvorgang
..
.. idnr fÅr kunde bei lieferant (Kundenkontakt)
.formula h|idkundeab = xKuNr
.formula h|glkundeab = xKuNrGLN
..
.. idnr fÅr WarenempfÑnger
.formula h|idkundesab = xWEmpfNr
.formula h|glkundesab = xWEmpfNrGLN
..
.. idnr fÅr RechnungsempfÑnger
.formula h|idkunderab = xKuNrDeb
.formula h|glkunderab = xKuNrDebGLN
..
.. idnr fÅr lieferant bei kunde
..fo h|idabkunde = xKuLiNr
..
.. eks-idnr des rahmen
..fo h|ideksrah = xIDrahmen
..
.. verwendungsschlÅssel
..fo h|verwschl = xVerwSchl
..
.. werk / abladestelle
.formula h|werk = xWerk
.formula h|ablstelle = xAblStelle
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC003
!RET004
.formula xprocsp = xprocsp - 1
..
.. alles roger
.select lock header
.. status: vorgang in edi-datenbank eingetragen
.formula h|status = 2
.. alles ohne fehler
.formula h|fcode = 0
.rewrite
..
..
.continue EL013 ? _(_(mehr))
.. IF013
.. schwerer fehler
.formula xtxt1 = "Konnte keinen Datensatz in der EDI-Datenbank anlegen!"
.formula xtxt2 = "PROGRAMMABBRUCH   PID: " + pid + ", Auftrags-ID:" + xAUnr
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC002
!RET006
.formula xprocsp = xprocsp - 1
..
.select lock sales 'xAUid'
.formula h|dfuesenden = false
.formula h|ident = "ERROR"
.rewrite
..
.continue FI013
!EL013
.. Meldung fÅr Anwender
..
.continue EL014 ? _(xbRMeldAn)
.. IF014
..
.continue EL015 ? _(_(xbfehler))
.. IF015
.output terminal
Die AuftragsbestÑtigung 'xtvorgang' ist erfolgreich
in die EDI-Datenbank Åbernommen!
..
.continue FI015
!EL015
.. Fehler
.output terminal
Fehler im Auftrag 'xtvorgang',
siehe die Post bzw. das Fehlerprotokoll!
..
!FI015
..
!EL014
.. FI014
..
!FI013
..
.formula xEDInr = h|num
.select -
.. jetzt mu· das feld "dfuesenden" in Auftrag auf "nein"
.. gesetzt und im Auftrag die ID des EDI-datensatzes eingetragen werden
..
.select lock sales 'xtvorgang'
.formula h|dfuesenden = false
.formula h|ident = xEDInr
.rewrite
..
.select -
..
.output new WERF.WEG
.. die tmp. datei lîschen
.formula xsys = "rm -f " + xdEDI
.system 'xsys' background
..
.continue HOLAU
..
!EL005
.. FI005
..
.. evtl. mu· noch post versendet werden
.formula xsys = "test -s " + xdfehler
.system 'xsys' background
..
..
.continue EL016 ? _(mehr)
.. IF016
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC002
!RET007
.formula xprocsp = xprocsp - 1
..
!EL016
.. FI016
..
..
.continue EL017 ? _(xProtDrucker<>"")
.. IF017
.output 'xProtDrucker'
.input "BLANKOB.F"
.input 'xdfehler'
.output terminal
..
!EL017
.. FI017
..
.output new WERF.WEG
.formula xsys = " rm -f " + xdfehler
.system 'xsys' background
..
