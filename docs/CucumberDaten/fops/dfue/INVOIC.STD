.formula xPosWGPreis = 'xPosWGPreis' << -1  ? xBelegart = "381" & ('xPosWGPreis' << 1) = "-"
..
.formula xGeldBetr2  = 'xGeldBetr2'  << -1  ? xBelegart = "381" & ('xGeldBetr2' << 1) = "-"
..
223 # 01 # #'xPosPreis'# # #'xPosPreisBasis'#'xPosPreisEinheit'# # # #'xPosWGPreis'# # 'xPosZAQ' # # # # # 'xProzQ' #'xPosProz'# 'xGeldBetrQ' # 'xGeldBetr2' # # # 'xLfdNr' #
..
.formula xLfdNr  = xLfdNr  + 1
.formula xCnt223 = xCnt223 + 1
..
