..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PEDINACHRICHTEN.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       :
.. Functionality  :
...Includes       :
..      include         dfue/EDISTATUS
..*****************************************************************************
.set trans -
..
.. do not show references
.continue END     ?  H|such/"R-*"
..
.. helper for counting same type messages
.type text xtrow ? _F|defined(U|xtrow)
..
.. refine message data
.type P53 xvEDI  ? _F|defined(U|xvEDI)
.formula U|xvEDI = H|id
.input "EDISTATUS"
..
.. filter bei status
.continue END     ? _M|kbNeuOffen     &  U|xtstatus = U|xNeuOffen
.continue END     ? _M|kbInArbeit     &  U|xtstatus = U|xInArbeit
.continue END     ? _M|kbNeuErledigt  &  U|xtstatus = U|xNeuErledigt
.continue END     ? _M|kbFehler       &  U|xtstatus = U|xFehler
.continue END     ? _M|kbDeaktiviert  &  U|xtstatus = U|xDeaktiviert
.continue END     ? _M|kbHistorie     &  U|xtstatus = U|xHistorie
..
..
..
.. which type of evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue COUNT   ?  M|kbedivorkommen
.continue DETAIL  ?  M|kbedizeigen
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
..
!COUNT: sum distinct edinachr + imex + status
.continue CFIRST  ?  M|tzeilen = 0
.select screen header
.select screen line 'F|formatstr("$,,;tedinachr=={1};timex=={2}", H|edinachr^id, U|xvEDI^imex)'
.continue CFIRST  ? _G|mehr
.continue CADD
!CFIRST
.make screen line +O
.copy M|tedinachr = H|edinachr
.formula M|tstatus = U|xtstatus
.formula M|tfcode  = H|fcode
.formula M|timex   = H|imex
!CADD
.. sum this message type / status
.formula M|tanzneuoffen = M|tanzneuoffen +1  ?  U|xtstatus = U|xNeuOffen
.formula M|tanzinarbeit = M|tanzinarbeit +1  ? U|xtstatus = U|xInArbeit
.formula M|tanzneuerledigt = M|tanzneuerledigt +1  ? U|xtstatus = U|xNeuErledigt
.formula M|tanzfehler = M|tanzfehler +1  ? U|xtstatus = U|xFehler
.formula M|tanzdeaktiviert = M|tanzdeaktiviert +1  ?  U|xtstatus = U|xDeaktiviert
.formula M|tanzhistorie = M|tanzhistorie +1  ? U|xtstatus = U|xHistorie
.. sum message type
.formula M|tanzvorart = M|tanzvorart +1
.. sum all
.formula M|kanzalle = M|tanzvorart   ?  M|tanzvorart > M|kanzalle
.continue END
..
..
..
!DETAIL
.make screen line +O
.formula M|tedi = H|id
.copy M|tedinachr = H|edinachr
.formula M|tstatus = U|xtstatus
.formula M|tfcode  = H|fcode
.formula M|timex   = H|imex
.assign M|tkl = 'F|formatstr("K {1}", H|idkundeab)'  ? _F|empty(H|idkundeab)
.assign M|tkl = 'F|formatstr("L {1}", H|idkundeab)'  ? _F|empty(H|idkundeab) & _G|mehr
.formula M|tuebdat = H|uebdat
.copy M|terfass = H|erfass
.continue END
..
..*****************************************************************************
!END
.continue
