..!interpreter english translate noabbrev
..!meta M|=dfue/FORECASTVALIDATION
..*****************************************************************************
.. Name           : FORECASTVALIDATION.KBUEXPORT.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
...Includes       :
..  include dfue/FORECASTVALIDATION.EXPORT.EDI
..  include dfue/FORECASTVALIDATION.EXPORT.ORDER
..*****************************************************************************
.set trans -
.. 
.formula M|kexportdatei = ""
.. 
.type text exportfile
.file -tempname U|exportfile
.output new 'U|exportfile'
.input "DATEI.F"
.. 
.select screen header
!NEXT
.select screen line 
.continue ENDEX ? _G|mehr
.input "FORECASTVALIDATION.EXPORT.EDI"
.input "FORECASTVALIDATION.EXPORT.ORDER"
.continue NEXT
!ENDEX
.output terminal 
.. 
.formula M|kexportdatei = "rmtmp/X.FORECASTVALIDATION.LAB." + 'G|zeitpunkt:14' + ".TXT" ? M|kblab
.formula M|kexportdatei = "rmtmp/X.FORECASTVALIDATION.FAB." + 'G|zeitpunkt:14' + ".TXT" ? M|kbfab
.formula M|kexportdatei = "rmtmp/X.FORECASTVALIDATION.VAB." + 'G|zeitpunkt:14' + ".TXT" ? M|kbvab
.system 'F|formatstr("cp -f {1} {2}", U|exportfile, M|kexportdatei)' background
.. 
..*****************************************************************************
!END
.continue
