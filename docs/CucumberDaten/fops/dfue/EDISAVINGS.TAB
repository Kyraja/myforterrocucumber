..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDISAVINGS.TAB
.. Autor          : tg
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Zeilen-FOP
.. Functionality  : row efop
..*****************************************************************************
.set trans -
..
.input "is/ABASFARBEN.DEF"
..
.. validate date range
.continue ZEILEOK ?  F|empty(H|gltvon)  &   F|empty(H|gltbis)
.continue ZEILEOK ?  F|empty(M|kvon)    &   F|empty(M|kbis)
.continue END     ? _F|empty(H|gltvon)  &  _F|empty(M|kbis) &  H|gltvon > M|kbis
.continue END     ? _F|empty(H|gltbis)  &  _F|empty(M|kvon) &  H|gltbis < M|kvon
..
!ZEILEOK
.make screen line
.formula M|tsdaktz = "icon:bulb_off"
.formula M|tsaktz  = "icon:bulb_on"
.colour -foreground -1 -1 -1 -background -1 -1 -1 tpreis 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 tbis 'M|aktzeile'
..
.copy M|tnum = H|sn
.formula M|tsuch = H|such
.formula M|tklpg = H|klpg
.assign M|trahmen = "$,,;@gruppe=1;nummer==" + 'H|klpg'  ?  F|isvalue('H|klpg', "N3")
.formula M|tartpg = H|artpg
.assign M|tartikel = "$,,;@gruppe=1;vprg==" + 'H|artpg'  ?  F|isvalue('H|artpg', "N2") ; F|isvalue('H|artpg', "SW2")
.copy M|ttyp = H|typ
.copy M|tvon = H|gltvon
.copy M|tbis = H|gltbis
.formula M|kldat = H|gltbis
.assign M|tkunde = M|trahmen^kunde^id
.assign M|tkunde = "$,,;@gruppe=1.2;nummer==" + 'H|kenn'  ?  F|empty(M|tkunde)
.formula M|tland = M|tkunde^firma^land           ?  F|defined(M|tkunde^firma)
.formula M|tland = M|tkunde^land                 ?  F|defined(M|tkunde^land)   &  F|empty(M|tland)
.formula M|tdb = true
.copy M|tsaktion = H|saktion
.colour -foreground -1 -1 -1 -background 'T|xabasgreen' tpreis 'M|aktzeile' ? H|saktion
.protection tpreis 'M|aktzeile'
..
.select line
.continue EPREIS  ? _T|mehr
.formula M|tpreis = H|mpreis
.formula M|tland  = H|mland  ? _F|empty(H|mland)
.select line
.continue EPREIS  ? _T|mehr
.formula M|tbtab = true
!EPREIS
..
.load 1 sales 'M|trahmen^id'
.continue END     ? _T|mehr
!ZRAHMEN
.load 1 line
.continue ERAHMEN ? _T|mehr
.formula M|tbsavings = true  ?  M|tartikel^id  =  1|artex^id  &  1|savings
.continue ZRAHMEN
!ERAHMEN
..*****************************************************************************
!END
.continue
