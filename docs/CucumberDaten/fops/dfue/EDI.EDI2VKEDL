.formula xedisuchschluessel1 = "$,,;@ordnung=nummer;@gruppe=0;@ablage=(1);@zeilen=(0);imex=IM;fcode=0;status=3;vorart=" + xvorart + ";idkundeab=" + xidkundeabe
