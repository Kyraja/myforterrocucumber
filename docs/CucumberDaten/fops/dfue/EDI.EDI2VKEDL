.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
.. Prozedur: EDISchreibeProtokoll
..
!PROC001: ----- EDISchreibeProtokoll -----
..>> AnhÑngen von Informationen an Fehlerprotokoll bei Fehlern bzgl. der
..>> Verarbeitung von EKS-EDI-DatensÑtzen
..>>
..>> Parameter:
..>>
..>> Ein: - Name der Ergebnisprotokoll-Datei (xneprotokollerw)
..>>      - Name der Fehlerprotokoll-Datei (xnfprotokollerw)
..>>      - EKS-EDI-Identnummer des EKS-EDI-Datensatzes (xedinumactinnachr1)
..>>      - Beschreibungen der Fehlercodes (xedireffcod<i>)
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>      - globaler Schalter, ob Protokoll erweitert (xistfproterw)
..>>
..>> Interne Variablen: - xfobefehl
..>>
..
..>> Erfolg der Operation
.formula xprocreturn = true
..
.. >> Erweitern Protokoll-Datei
.select edifact 'xedinumactinnachr1'
..
.. >> Protokollzeile
....      Datum_Zeit     EDI-Nr    Vorgang  Vo Kunde    Fehl       Bemerkung
....    # 29.04.98_21:29 15        400005   3           52 ausgehende VK-RE 400005
....      29.04.98_21:29 16        400006   3  70001       ausgehende VK-RE 400006
.set separator=^
.formula xfobefehl = (('datum' + "_" + 'zeit' + "              ") << 14) + " "
.formula xfobefehl = xfobefehl + ((num + "         ") << 9) + " "
.formula xfobefehl = xfobefehl + ((ideksvor + "        ") << 8) + " "
.formula xfobefehl = xfobefehl + (('vorart' + "  ") << 2) + " "
.formula xfobefehl = xfobefehl + ((idkundeab + "        ") << 8) + " "
..
..
.continue EL001 ? _(fcode = 0)
.. IF001
..
.continue EL002 ? _((status = 5) ; (status = 6))
.. IF002
....                                 gespoolt      (e -> eingegegangen)
....                                 |             (v -> verarbeitet)
....                                 |
.formula xfobefehl = "  " + xfobefehl + " s " + (name << ";") + ((name >> ";") >> "")
..
.continue FI002
!EL002
..
.continue EL003 ? _(0|status = 10)
.. IF003
....                                 verarbeitet   (e -> eingegegangen)
....                                 |             (s -> gespoolt)
....                                 |
.formula xfobefehl = "  " + xfobefehl + " v " + (name << ";") + ((name >> ";") >> "")
..
.continue FI003
!EL003
....                                 eingegegangen (s -> gespoolt)
....                                 |             (v -> verarbeitet)
....                                 |
.formula xfobefehl = "  " + xfobefehl + " e " + (name << ";") + ((name >> ";") >> "")
..
!FI003
..
!FI002
..
.output addedto 'xneprotokollerw'
.length 1
.right 80
.tablerecord
..
.continue FI001
!EL001
.formula xfobefehl = "# " + xfobefehl + (('fcode' + "  ") << 2) + " " + 'xedireffcod.fcode'
..
.formula xistfproterw = true
..
.output addedto 'xnfprotokollerw'
.length 1
.right 80
.tablerecord
..
!FI001
..
'xfobefehl'
.set
..
.output new WERF.WEG
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: VervollstÑndigeEDIInfos
..
!PROC002: ----- VervollstaendigeEDIInfos -----
..>> VervollstÑndigen der Kunden-Informationen des EDI-Datensatzes
..>> bzgl. EDL-Meldung
..>> Parameter:
..>> Ein:
..>> Aus: - Erfolg Operation (xprocreturn)
..>> Interne Variablen: - xkdsuchschluessel1
..>>                    - xvksuchschluessel1
..>>                    - xistsatz3
..>>                    - xistzeile1
..>>                    - xedistatus
..>>                    - xedifcode
..>>                    - xedifcodemax
..>>                    - xideksart
..>>                    - xkuartnr
..>>                    - xwerk
..>>                    - xablstelle
..>>                    - xverwschl
..>>                    - xidabkunde
..>>                    - xidkundeab
..
..>> Init RÅckgabewerte: ein Erfolg der Operation
.formula xprocreturn = false
..
.. >> VervollstÑndigen der Status/Fehlercode-Informationen des EDI-Datensatzes bzgl. EDL-Meldung
..>> PrÅfen und Speichern der Partner-Informationen aus dem EDI-Datensatz
.input "PRUEF.PARTNERINFO"
..
..
.continue EL004 ? _(xedifcode = 0)
.. IF004
.. >> Speichern Status in abas EDI-Datensatz
.select lock edifact 'xedinumactinnachr1'
..
.set trans +
.formula name = "eingehende EDL-Meldung"
.set trans -
.formula xedistatus = 3
.formula status = xedistatus
.formula xedifcode = 0
.formula fcode = xedifcode
..
.rewrite
..
.formula xprocreturn = true
..
.continue FI004
!EL004
.. >> Speichern Fehler-Status und Fehlercode in abas EDI-Datensatz
.select lock edifact 'xedinumactinnachr1'
..
.set trans +
.formula name = "eingehende EDL-Meldung"
.set trans -
.formula xedistatus = 4
.formula status = xedistatus
.formula fcode = xedifcode
..
.. Die Fehlerprotokoll in T1 geschrieben
.formula ftext = xdfehler
..
.rewrite
..
.formula xprocreturn = false
..
!FI004
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: FEHLER
..
!PROC003: ----- FEHLER -----
.formula xbfehler = true
..
.output addedto 'xdfehler'
.input DATEI.F
?'xtxt2     ' 'xtxt1' ? +xtxt2 > 0 ; +xtxt1 > 0
.output
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.. Modulsperre setzen
.formula U|xmmvvl = "VKEDL"
.formula U|xaktion = 1
.input "EDIIMPPROCESS.MODULSPERRE"
..
..
.continue EL005 ? _(xprocreturn)
.. IF005
..die parameterdatei
..**ok,28.01.2003 (xarb wurde entfernt)
.formula xdPARAM = "dfue/DFUE.IMP.INI"
.input 'xdPARAM'
..
.. >> Start der Funktion
..>> Merken DFUE-Programm und -Unterprogramm
..>> Name des DFUE-Unterprogramms
.formula xdfueuprog = tname
..
..  VervollstÑndigen der Informationen des abas Kunden fÅr alle neuen EDL-Meldung-EDI-DatensÑtze
.. Holen alle neuen, nicht weiterverarbeiteten EDI-DatensÑtze (VorgÑnge)
.formula xedisuchschluessel1 = "$,,;@ordnung=nummer;@gruppe=0;@ablage=(1);@zeilen=(0);imex=IM;fcode=0;status=2;vorart=" + xvorart
.select edifact 'xedisuchschluessel1'
..
..>> Merken, ob nicht weiterverarbeiteten EDI-Datensatz (Vorgang) gefunden
.formula xistsatz1 = mehr
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(xistsatz1)
..>> Merken neuen abas Edi-Datensatz
.formula xedinumneu = num
..
.. Fehlerdatei
.. Fehlermeldungsdatei, die als Freitext T1 geschrieben wird
..**ok,28.01.2003 (xarb wurde entfernt)
.formula xdfehler = "X.ERR." + xedinumneu + ".TMP"
.output new 'xdfehler'
.input DATEI.F
.set trans +
EDI-Datensatz: 'xedinumneu'

Satzart, Zeile, Fehlerbeschreibung
--------------------------------------------------------------------------------------------------------
.set trans -
.output terminal
..
..>> Setzen Parameter fÅr Prozedur
.formula xedinumactinnachr1 = num
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
..
.. Holen alle nicht weiterverarbeiteten EDI-DatensÑtze (VorgÑnge), wenn vorhanden
.formula xedisuchschluessel1 = "$,,;@ordnung=nummer;@gruppe=0;@ablage=(1);@zeilen=(0);;imex=IM;fcode=0;status=2;vorart=" + xvorart
.select edifact 'xedisuchschluessel1'
..
..>> Merken, ob nicht weiterverarbeiteten EDI-Datensatz (Vorgang) gefunden
.formula xistsatz1 = mehr
..
.continue LOOP001
!ELOP001: ==============================
..
.. >> Verarbeiten alle neuen, nicht weiterverarbeiteten EDI-DatensÑtze (VorgÑnge)
.. >> Holen alle neuen, nicht weiterverarbeiteten EDI-DatensÑtze (VorgÑnge)
..>> idkundeab=" + xidkundeabe + ";fcode=0;status=3
.formula xedisuchschluessel1 = "$,,;@ordnung=nummer;@gruppe=0;@ablage=(1);@zeilen=(0);imex=IM;fcode=0;status=3;vorart=" + xvorart + ";idkundeab=" + xidkundeabe
.select edifact 'xedisuchschluessel1'
..
.formula xistsatz1 = mehr
..
..
!LOOP002: ==============================
.continue ELOP002 ? _(xistsatz1)
..>> Merken neuen abas Edi-Datensatz
.formula xedinumneu = num
..
.. Fehlerdatei
.. Fehlermeldungsdatei, die als Freitext T1 geschrieben wird
..**ok,28.01.2003 (xarb wurde entfernt)
.formula xdfehler = "X.ERR." + xedinumneu + ".TMP"
.output new 'xdfehler'
.input DATEI.F
.set trans +
EDI-Datensatz: 'xedinumneu'

Satzart, Zeile, Fehlerbeschreibung
--------------------------------------------------------------------------------------------------------
.set trans -
.output terminal
..
..**ok,28.01.2003 (untere Prozedur VervollstaendigeEDIInfos hier NEU)
..
..>> Setzen Parameter fÅr Prozedur
.formula xedinumactinnachr1 = num
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
..
..>> Holen neuen abas Edi-Datensatz
.select edifact 'xedinumneu'
..
..**ok,31.01.2003 (Programmteil fÅr "Ermitteln EDI-Info-Eintrag" wurde entfernt)
..**ok,31.01.2003 (es wird im Prozedur "VervollstaendigeEDIInfos" vorgenommen)
..
..>> Test, ob: EDI-EDL fÅr Kunde aktiviert ist und
..>>   - ein Kunde mit der automatischen Verarbeitung von EDI-EDL-Meldungen oder
..>>   - aktuelle Identnummer des Lieferanten bei Kunde mit gewÑhlter Åbereinstimmt
..
..
.continue EL006 ? _((xediaktiv) & (((xidkundeabe = "") & (xmenu=1) & (xedimanu)) ; ((xidkundeabe = "") & (xmenu=2) & (xediauto)) ; ((xidkundeabe = "") & (xediauto)) ; ((xidkundeabe = "") & (xmenu=3) & ((xediauto) ; (xedimanu))) ; (xidkundeabe = idkundeab)))
.. IF006
.. >> Verarbeitung
..>> Test, ob EDI-EDL
..
..**ok,11.06.2003 (statt nachrtyp="VKEDL" jetzt vorart=27)
..
..
.continue EL007 ? _(vorart = 27)
.. IF007
..
.. =====   CASE001   =====
.continue BRK001 ? _(funktion = "30")
.. Eingangsmeldung:  EDL --> Lieferant
.. Eingangsmeldung:  EDL --> Lieferant
..
..**ok,11.06.2003 (jetzt statt Fehler "38" Meldungen gedruckt)
..
..
.continue EL008 ? _(xEDLDrucker <> "")
