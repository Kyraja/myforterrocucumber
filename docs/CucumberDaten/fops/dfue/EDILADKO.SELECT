..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDILADKO.SELECT
.. Autor          : tg
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Startbutton
.. Functionality  : Start button
..*****************************************************************************
.set trans -
..
.. check required parameters
.continue NOEDI   ?  F|empty(M|edinr)
.continue NOLAKO  ?  M|edinr^such <> "LAKO"
..
.. only one edi message is selected
.formula M|select = 'M|edinr^id'
..
!START
.input "is/KOPFLEEREN"
.assign M|edinr = M|select
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..
..
!NOEDI
.error Geben Sie einen Ladungstr„ger-Kontoauszug ein!
.cursor edinr 0
.end 1
..
!NOLAKO
.error Vorgang 'M|edinr' ist kein Ladungstr„ger-Kontoauszug!
.cursor edinr 0
.end 1
