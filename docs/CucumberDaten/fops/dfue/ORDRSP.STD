..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ORDRSP.STD
.. Autor          : unbekannt
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Erstellen einer EDI-Auftragsbest„tigung
...Includes
..  include  dfue/EDI.UNITS
..*****************************************************************************
.set trans -
..
.type text  xtdatname    ? _F|defined(xtdatname)
.type text  xtsatzunbi   ? _F|defined(xtsatzunbi)
.type text  xtversion1   ? _F|defined(xtversion1)
.type text  xtsatzunhi   ? _F|defined(xtsatzunhi)
.type text  xrefnr       ? _F|defined(xrefnr)
.type text  xtntyp       ? _F|defined(xtntyp)
.type text  xversfrgnr   ? _F|defined(xversfrgnr)
.type text  xbelegart    ? _F|defined(xbelegart)
.type text  xverworg     ? _F|defined(xverworg)
.type text  xtsatzbgm1   ? _F|defined(xtsatzbgm1)
.type text  xvnum        ? _F|defined(xvnum)
.type date xdatum       ? _F|defined(xdatum)
.type text  xfunktion    ? _F|defined(xfunktion)
.type text  xtsatzrfh1   ? _F|defined(xtsatzrfh1)
.type text  xwaehrc      ? _F|defined(xwaehrc)
.type text  xtsatzrfh2   ? _F|defined(xtsatzrfh2)
.type text  xtsatzdah1   ? _F|defined(xtsatzdah1)
.type text  xrefdat1     ? _F|defined(xrefdat1)
.type text  xrefdat2     ? _F|defined(xrefdat2)
.type text  xtsatzsup1   ? _F|defined(xtsatzsup1)
.type text  xtsatzsup2   ? _F|defined(xtsatzsup2)
.type text  xtsatzbuy1   ? _F|defined(xtsatzbuy1)
.type text  xtsatzbuy2   ? _F|defined(xtsatzbuy2)
.type text  xtsatziv1    ? _F|defined(xtsatziv1)
.type text  xtsatzdpa1   ? _F|defined(xtsatzdpa1)
.type text  xtsatzdpa2   ? _F|defined(xtsatzdpa2)
..
.type text  xagln        ? _F|defined(xagln)
.type text  xsugln       ? _F|defined(xsugln)
.type text  xsuustdid    ? _F|defined(xsuustdid)
.type text  xbfunktion   ? _F|defined(xbfunktion)
.type text  xbgln        ? _F|defined(xbgln)
.type text  xbnum        ? _F|defined(xbnum)
.type text  xbustid      ? _F|defined(xbustid)
.type text  xegln        ? _F|defined(xegln)
.type text  xivgln       ? _F|defined(xivgln)
.type text  xivnum       ? _F|defined(xivnum)
.type text  xivustid     ? _F|defined(xivustid)
.type text  xdpfunktio   ? _F|defined(xdpfunktio)
.type text  xdpgln       ? _F|defined(xdpgln)
.type text  xdpsunr      ? _F|defined(xdpsunr)
.type text  xpnum        ? _F|defined(xpnum)
.type text  xsubposnr    ? _F|defined(xsubposnr)
..
.. POSITIONEN
.type text  xtsatzlin1   ? _F|defined(xtsatzlin1)
.type text  xtsatzrfl1   ? _F|defined(xtsatzrfl1)
.type text  xaunr        ? _F|defined(xaunr)
.type date  xaudatum     ? _F|defined(xaudatum)
.type date  xlsdatum     ? _F|defined(xlsdatum)
.type text  xlztabruf    ? _F|defined(xlztabruf)
.type text  xtsatzrfl2   ? _F|defined(xtsatzrfl2)
.type text  xwerk        ? _F|defined(xwerk)
.type text  xablstelle   ? _F|defined(xablstelle)
.type text  xtsatzart1   ? _F|defined(xtsatzart1)
.type text  xgtin        ? _F|defined(xgtin)
.type text  xkuartnr     ? _F|defined(xkuartnr)
.type text  xsuartnum    ? _F|defined(xsuartnum)
.type text  xvbez        ? _F|defined(xvbez)
.type text  xtsatzart2   ? _F|defined(xtsatzart2)
.type text  xtsatzqty1   ? _F|defined(xtsatzqty1)
.type text  xtstmge      ? _F|defined(xtstmge)
.type text  xmeinheit    ? _F|defined(xmeinheit)
.type text  xaumge       ? _F|defined(xaumge)
.type text  xauhe        ? _F|defined(xauhe)
.type text  xtsatzalc1   ? _F|defined(xtsatzalc1)
.type text  xprozsatzq   ? _F|defined(xprozsatzq)
.type text  xprozsatz    ? _F|defined(xprozsatz)
.type text  xsatzartpr   ? _F|defined(xsatzartpr)
.type text  xversion     ? _F|defined(xversion)
.type text  xpreis       ? _F|defined(xpreis)
.type text  xmasseinhq   ? _F|defined(xmasseinhq)
.type text  xvkpreis     ? _F|defined(xvkpreis)
.type text  xwaehrung    ? _F|defined(xwaehrung)
..
.type text  xfrbez       ? _F|defined(xfrbez)
.type text  xdpablade    ? _F|defined(xdpablade)
.type text  xdpwerk      ? _F|defined(xdpwerk)
.type text  xtsatzunzi   ? _F|defined(xtsatzunzi)
..
.type text  xposphe      ? _F|defined(xposphe)
..
.formula U|xtversion1 = "01"
..
.formula U|xtsatzunzi = "UNZI"
.formula U|xtsatzunbi = "UNBI"
.formula U|xtsatzunhi = "UNHI"
.formula U|xtsatzbgm1 = "BGMI"
.formula U|xtsatzrfh1 = "RFH1"
.formula U|xtsatzrfh2 = "RFH2"
.formula U|xtsatzdah1 = "DAH1"
.formula U|xtsatzsup1 = "SUP1"
.formula U|xtsatzsup2 = "SUP2"
.formula U|xtsatzbuy1 = "BUY1"
.formula U|xtsatzbuy2 = "BUY2"
.formula U|xtsatziv1  = "IV1"
.formula U|xtsatzdpa1 = "DPA1"
.formula U|xtsatzdpa2 = "DPA2"
.formula U|xtsatzlin1 = "LIN1"
.formula U|xtsatzrfl1 = "RFL1"
.formula U|xtsatzrfl2 = "RFL2"
.formula U|xtsatzart1 = "ART1"
.formula U|xtsatzart2 = "ART2"
.formula U|xtsatzqty1 = "QTY1"
.formula U|xtsatzalc1 = "ALC1"
.formula U|xsatzartpr = "PRI1"
..
.formula U|xtntyp = "ORDRSP"
.formula U|xversfrgnr = "D 96 A"
.formula U|xbelegart = "231"
.formula U|xverworg = "UN"
..
.. clear old buffers
.select add
.reserve -
.select -
..
.. read order
.select sales 'xtvorgang'
..
.formula U|xrefnr = H|nummer
.formula U|xvnum = H|frzeich
.formula U|xwaehrc = H|land
..
.formula U|xtdatname = xdEDI
.output new 'xtdatname'
.input "DATEI.F"
..
.formula U|xdatum = H|navom
.formula U|xagln = F|sysinfo(10)^gln
.formula U|xsugln = F|sysinfo(10)^gln
.formula U|xsuustdid = F|sysinfo(10)^ustid
.select add kunde
.continue KDE ? _mehr
.formula U|xbfunktion = H|funktion
.formula U|xbgln = H|gln
.formula U|xbnum = H|nummer
.formula U|xbustid = H|ustid
.formula U|xegln = H|gln
.formula U|xfrbez = H|frbez ? gruppe= 1
!KDE
.select add
.select add kunde2
.continue KD2E ? _G|mehr
.formula U|xivgln = H|gln
.formula U|xivnum = H|nummer
.formula U|xivustid = H|ustid
!KD2E
.select add
.select add kunde3
.continue KD3E ? _mehr
.formula U|xdpablade = H|ablstelle ? gruppe= 2
.formula U|xdpfunktio = H|funktion
.formula U|xdpgln = H|gln
.formula U|xdpsunr = H|nummer
.formula U|xdpwerk = H|werk ? gruppe= 2
!KD3E
.select add
.continue POSITIONEN ? xanzls = 1
.output addedto 'xtdatname'
'xtsatzunbi' # 'xtversion1' # 'xagln' #  #  # 'xegln' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzunhi' # 'xtversion1' # 'xrefnr' # 'xtntyp' # 'xversfrgnr' # 'xbelegart' # 'xverworg' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzbgm1' # 'xtversion1' # 'xvnum' # 'xdatum:8' # 'xfunktion' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzrfh1' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  # 'xwaehrc' #  #  #  #  #  #
'xtsatzrfh2' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzdah1' # 'xtversion1' #  #  # 'xrefdat1' # 'xrefdat2' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzsup1' # 'xtversion1' # 'xsugln' # 'xfrbez' #  #  #  #  # 'xsuustdid' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzsup2' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzbuy1' # 'xtversion1' # 'xbgln' # 'xbnum' #  #  #  #  # 'xbustid' # 'xbfunktion' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzbuy2' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatziv1' # 'xtversion1' # 'xivgln' # 'xivnum' #  #  #  #  # 'xivustid' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzdpa1' # 'xtversion1' # 'xdpgln' # 'xdpsunr' #  # 'xdpwerk' # 'xdpablade' #  #  # 'xdpfunktio' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzdpa2' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
.output
..
..
!POSITIONEN
.select line
.continue FUSS  ? _mehr
.continue POSITIONEN  ? typ<>arpos
.continue POSITIONEN  ? artex^gruppe <> 1
.continue POSITIONEN  ? mge=0
.formula U|xpnum    = H|pnum
.formula U|xsubposnr= H|subposnr
.formula U|xlsdatum = H|tterm
.formula U|xtstmge  = H|mge
.formula U|xaumge   = H|mge
.formula U|xvkpreis = H|preis
.formula U|xkuartnr = H|zkuartnr
.formula U|xaudatum = H|oterm
.select add art
.continue EART ? _G|mehr
.formula U|xauhe = H|le
.formula U|xposphe = U|xauhe
.input "EDI.UNITS"
.formula U|xauhe = U|eiso
.formula U|xgtin = H|gtin
.formula U|xmasseinhq = H|vpe
.formula U|xposphe = U|xmasseinhq
.input "EDI.UNITS"
.formula U|xmasseinhq = U|eiso
.formula U|xmeinheit = H|le
.formula U|xposphe = U|xmeinheit
.input "EDI.UNITS"
.formula U|xmeinheit = U|eiso
.formula U|xsuartnum = H|nummer
.formula U|xvbez = H|vbez
!EART
.select add
.select add kopf
.continue EKOPF ? _G|mehr
.formula U|xablstelle = H|ablstelle
.formula U|xaunr = H|frzeich
.formula U|xlztabruf = H|lztabruf
.formula U|xwaehrung = H|land
.formula U|xwerk = H|werk
!EKOPF
.select add
!LIN1
.output addedto 'xtdatname'
'xtsatzlin1' # 'xtversion1' #  # 'xpnum' #  #  #  #  # 'xsubposnr' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzrfl1' # 'xtversion1' #  #  # 'xaunr' # 'xaudatum' #  # 'xlsdatum:8' #  #  #  # 'xlztabruf' #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzrfl2' # 'xtversion1' #  #  #  #  #  #  #  #  #  # 'xwerk' # 'xablstelle' #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzart1' # 'xtversion1' # 'xgtin' # 'xkuartnr' # 'xsuartnum' #  #  #  #  # 'xvbez' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzart2' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzqty1' # 'xtversion1' # 'xtstmge' # 'xmeinheit' #  #  # 'xaumge' # 'xauhe' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xtsatzalc1' # 'xtversion1' #  #  #  #  #  # 'xprozsatzq' # 'xprozsatz' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
'xsatzartpr' # 'xtversion1' #  # 'xpreis' #  #  #  # 'xmasseinhq' #  #  #  # 'xvkpreis' #  #  #  #  #  #  # 'xwaehrung' #  #  #  #  #  #  #
.output
.continue POSITIONEN
..
!FUSS
.select add
!UNZI
.output addedto 'xtdatname'
'xtsatzunzi' # 'xtversion1' #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #  #
.output
..*****************************************************************************
!END
.continue
