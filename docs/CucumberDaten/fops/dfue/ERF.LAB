..==
..========================================================================
..@@ENDHEAD
..
.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
.set trans +
..... procedure stack pointer .....
!INI
.type integer   xprocsp
...
.type text    xdimpini
.type text    xtlabname
.type text    xtVORLAGE
.type text    xtMENU
.type text    xtPROT
.type text    xtVARDEF
.type text    xtDATEIDEF
.type integer xifotmp
.type date   xdfotmp
.type bool    xbdebug
.type bool    xbende
.type text    xtfotmp
.type time    xzfotmp
.type text    xt2fotmp
.type text    xt3fotmp
.type text    xt4fotmp
.type text    xtdatname
.type text    xt2dattmp
..
.type integer xiktmp
.type integer xiptmp
.type integer xi1zaehl
.type integer xi2zaehl
.type integer xi3zaehl
.type integer xi4zaehl
.type integer xi5zaehl
.type integer ximenu
.type integer xizeilen
.type integer xitmp
.type integer xifunktion
..
.................... Array fÅr Termine und Menge
.type text xtlterm
.formula xtltermin = "xtlterm"
.type text xtlmge
.formula xtlmge    = "xtlmge"
...
.................... Programm Steuervariablen
.type bool xbdatei
.type bool xbok
.................... Steuervariablen Datum
.type bool xbzeitraum
.type bool xbkw
..................... LAB Variablen ...................
...-> Defaultwerte setzen!
...
.................. 000
.type text xtabsender
...
.type text xtdaterst
.formula                     xtdaterst = 'datum:8'
...
.type text xtzeiterst
.formula                     xtzeiterst= ('zeit'<<":") + ('zeit'>>":")
...
.................. 400
..
.type text xtkdnr
...
.type text xtliefnr
..................... Wird defaultmÑ·ig bei Angabe der
..................... Kundennummer gefÅllt
..................... Procedur "KUNDENNUMMER_EINGEBEN"
...
.type text xtaltuebnr
.formula                    xtaltuebnr = "1"
...
.type text xtneuuebnr
.formula                    xtneuuebnr = "2"
...
.type text xtefzdat
.formula                    xtuefzdat  = 'datum:8'
...
.type text xtuebdat
.formula                    xtuebdat   = 'datum:8'
..
.................. 500
.type text xtwerk
...
.type text xtlabnrneu
.formula                    xtlabnrneu  = "1"
...
.type text xtlabdatneu
.formula                    xtlabdatneu = 'datum:8'
...
.type text xtlabnralt
.formula                    xtlabnralt  = "0"
...
.type text xtlabdatalt
.formula                    xtlabdatalt = 'datum:8'
...
.type text xtkdartnr
...
.type text xtartnr
...
.type text xtabschlu·
...
.type text xtablade
...
.type text xtkdnzeich
.formula                     xtkdnzeich = "FAX"
...
.type text xtmgeeinh
.formula                     xtmgeeinh  = "ST"
...
.type text xtliefint
.formula                     xtliefint  = "L"
...
.type text xtfertfrg
...
.type text xtmatfrg
...
.type text xtversc
.formula                     xtversc     = "S"
...
.................. 520
.type text xterfdls
.formula                     xterfdls    = 'datum:8'
...
.type text xtllsnr
.formula                     xtllsnr     = "000000"
...
.type text xtlsdateing
.formula                     xtlsdateing = 'datum:8'
...
.type text xtlemge
.formula                     xtlemge     = "0"
...
.type text xteingfzahl
.formula                     xteingfzahl = "0"
...
................. 522
.type text xtfzfertfrg
...
.type text xtfzmatfrg
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
.formula xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
.. ENDE0
..
!PROC001: ----- ENDE0 -----
.set background +
.formula xtfotmp = "rm -f " + 'xtMENU'
.system 'xtfotmp'
.formula xtfotmp = "rm -f " + 'xtPROT'
.system 'xtfotmp'
.formula xtfotmp = "rm -f " + 'xtdattmp'
.system 'xtfotmp'
.formula xtfotmp = "rm -f " + 'xtDATM'
.system 'xtfotmp'
.formula xtfotmp = "rm -f " + 'xt2dattmp'
.system 'xtfotmp'
.occupy
.end .
..
.continue 'xprocst.xprocsp'
..
.. PLAUSILISTE
..
!PROC002: ----- PLAUSILISTE -----
..
.continue EL001 ? _(+xtkdnr=0 ; +xtkdartnr=0; +xtwerk=0; +xtablade=0 ; +xtversc=0; +xtlabnralt=0 ; +xtlabnrneu=0 ; +xtlabdatalt=0 ; +xtlabdatneu=0 ; +xtuebdat=0 ; + xteingfzahl=0 ; +xtliefnr=0)
.. IF001
.. Daten ausgeben
.menu Folgende MU·-Angaben fehlen und mÅssen nachgetragen werden:
?Kundennummer                   ? +xtkdnr   = 0
?Kundenartikelnummer            ? +xtkdartnr= 0
?Werk                           ? +xtwerk   = 0
?Abladestelle                   ? +xtablade = 0
?VerwendungsschlÅssel           ? +xtversc  = 0
?Lieferabrufnummer alt          ? +xtlabnralt  = 0
?Lieferabrufnummer neu          ? +xtlabnrneu  = 0
?Lieferabrufdatum alt                 ? +xtlabdatalt = 0
?Lieferabrufdatum neu                 ? +xtlabdatneu = 0
?öbertragungsdatum              ? +xtuebdat    = 0
?Fortschrittszahl               ? +xteingfzahl = 0
..
.continue FI001
!EL001
.formula xbok = true
..
!FI001
..
.continue 'xprocst.xprocsp'
..
.. DATEI_GEéNDERT
..
!PROC003: ----- DATEI_GEéNDERT -----
.formula xbdatei = false
.formula xtfotmp = "diff " + 'xtdattmp' + " " + 'xt2dattmp' + " > " + 'xtDATM'
.system 'xtfotmp' background
.formula xtfotmp = "test -s " + 'xtDATM'
.system 'xtfotmp' background
..
..
.continue EL002 ? _(mehr)
.. IF002
... Datei wurde geÑndert
.formula xbdatei = true
..
!EL002
.. FI002
..
.continue 'xprocst.xprocsp'
..
.. MANAGE_DATEI
..
!PROC004: ----- MANAGE_DATEI -----
...Empfangsverzeichnis
...fo xEmpfangsVerz = "${MANDANTDIR}/dfue/empfangen"
...Name der generierten Datei 'xtdattmp'
.formula xtfotmp = "ls " + 'xEmpfangsVerz' + "/VKAUV > " + 'xtDATM'
.system 'xtfotmp' background
.formula xtfotmp = "test -s " + 'xtDATM'
.system 'xtfotmp'
..
..
.continue EL003 ? _(mehr)
.. IF003
.. Datei anhÑngen
... Es ist eine Datei vorhanden
...
.formula xtfotmp = ""
.select from 'xtDATM' xtfotmp^
..
..
.continue EL004 ? _(+xtfotmp <> 0)
.. IF004
.formula xtfotmp = "cat " + 'xtdattmp' + " >> " + 'xtfotmp'
.system 'xtfotmp'
..
!EL004
.. FI004
..
.continue FI003
!EL003
.. Datei kopieren
.formula xtfotmp = "cp " + xtdattmp + " " + 'xEmpfangsVerz' + "/" + 'xtlabname'
.system 'xtfotmp'
..
!FI003
..
.continue 'xprocst.xprocsp'
..
.. DATEI_SCHREIBEN
..
!PROC005: ----- DATEI_SCHREIBEN -----
.input DATEI.F
.formula xi1zaehl = 0
.formula xi2zaehl = 0
.formula xi3zaehl = 0
..
.. ----------------------------------------
.output new 'xtdattmp'
.. Kopf und Positionskopf schreiben
..**ok,28.11.2003 (Leerzeichen nach Satzart 000 entfernt)
000# 01 # VDA # VKAU # 4905 # 'xtabsender' ### 'xtdaterst' # 'xtzeiterst' # ############## 1 #
400 # 02 # 511 # 'xtkdnr' # 'xtliefnr' # 'xtaltuebnr'  # 'xtneuuebnr' # 'xtefzdat' # 'xtuebdat'  # ############### 2 #
500 # 01 # 512 # 'xtwerk' # 'xtlabnrneu' # 'xtlabdatneu' # 'xtlabnralt' # 'xtlabdatalt' # 'xtkdartnr' # 'xtartnr' # 'xtabschlu·' # 'xtablade' # 'xtkdnzeich' # 'xtmgeeinh' # 'xtliefint' # 'xtfertfrg' # 'xtmatfrg' # 'xtversc' ####### 3 #
520 # 01 # 513 # 'xterfdls' # 'xtllsnr' # 'xtlsdateing' # 'xtlemge' # 'xteingfzahl' # ################ 4 #
..
..
.continue EL005 ? _(xiptmp > 0)
.. IF005
.. Positionen schreiben
.formula xi3zaehl = xiptmp
.formula xi1zaehl = 0
.formula xi2zaehl = 4
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(xi1zaehl <> xi3zaehl)
.formula xi2zaehl = xi2zaehl + 1
.formula xi1zaehl = xi1zaehl + 1
...Datum: 'xtlterm.xi1zaehl ' Menge: 'xtlmge.xi1zaehl '
521 # 01 # 514814 # 'xtlterm.xi1zaehl' # 'xtlmge.xi1zaehl' #################### 'xi2zaehl' #
..
.continue LOOP001
!ELOP001: ==============================
..
!EL005
.. FI005
..
.output
.. ----------------------------------------
..
.formula xi2zaehl = xi2zaehl + 1
..
.. Fu· schreiben
.. ----------------------------------------
.output addedto 'xtdattmp'
601#02#519#0#0#0#0#0#0#0#0############## 'xi2zaehl' #
..
.output
.. ----------------------------------------
..
..Kopie erzeugen
.formula xtfotmp = "cp " + 'xtdattmp' + " " + xt2dattmp
.system 'xtfotmp'
..
.continue 'xprocst.xprocsp'
..
.. DATEI_EDITIEREN
..
!PROC006: ----- DATEI_EDITIEREN -----
.editing 'xtdattmp'
..
.continue 'xprocst.xprocsp'
..
.. > FEHLERMELDUNGEN <
.. FEHL1
..
!PROC007: ----- FEHL1 -----
.box(0,0)Fehler
Sie haben noch keine Positionen (Menge, Termin)
eingegeben
..
.continue 'xprocst.xprocsp'
..
.. FEHL2
..
!PROC008: ----- FEHL2 -----
.box(0,0)Fehler
Sie kînnen die Datenfelder nicht mehr Ñndern, da
Sie die Datei bereits editiert haben
..
