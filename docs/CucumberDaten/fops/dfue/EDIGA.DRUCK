..!interpreter english translate
..*****************************************************************************
..
..  FOP-Name       : EDIGA.DRUCK
..  Datum          : 03.12.2004
..  Version        :
..  Autor          : ok
..  Verantwortlich : mh
..  Kontrolle      :
..
..  Funktion       : Ausdruck der Maskendaten aus dem Infosystem EDIGA
..                   Maske wird gelesen und ausgegeben
..
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#GA#10.05.2004#0#tg#
..#KOR#GA#03.12.2004#1#ok# (Programmkopfdaten hinzugefÅgt)
..*****************************************************************************
..
.type real xrb     ? _defined(xrb)
.type real xrs     ? _defined(xrs)
.type real xrm     ? _defined(xrm)
.type real xrp     ? _defined(xrp)
.type real xrpr    ? _defined(xrpr)
.type real xgesamt ? _defined(xgesamt)
.type text xdl     ? _defined(xdl)
.type text xtme    ? _defined(xtme)
.type text xfehler ? _defined(xfehler)
.type text xf1     ? _defined(xf1)
.type text xf2     ? _defined(xf2)
.type text xf3     ? _defined(xf3)
..
.input DRUCKER
...formel geraet = "Bildschirm"  ?  geraet = ""
.input BLANKOB.F
..
.select screen header
..
                                    E D I - G U T S C H R I F T E N P R O T O K O L L

Datum: 'T|datum '  'T|bzeichen  '

?Gutschriftennummer: 'M|kganum                          '  EDI-ID: 'M|edivon' - 'M|edibis' ? M|kganum<>"" & M|edivon<>"" & M|edibis<>""
?EDI-ID            : 'M|edivon' - 'M|edibis'                                               ? M|kganum=""  & M|edivon<>"" & M|edibis<>""
?Kunde             : 'M|kunde  '                           Kunde : 'M|dvon'  - 'M|dbis'    ? M|kunde<>""  & 'M|dvon'<>"" & 'M|dbis'<>""
?Datum             : 'M|dvon' - 'M|dbis'                                                   ? M|kunde=""   & 'M|dvon'<>"" & 'M|dbis'<>""


EDI-ID     GA-Nummer    Lieferschein   LS-Datum Artikel      Menge      ME      PB       Preis       Poswert   End-Betrag
-------------------------------------------------------------------------------------------------------------------------
..
.up



EDI-ID     GA-Nummer    Lieferschein   LS-Datum Artikel      Menge      ME      PB        Preis       Poswert   End-Betrag
--------------------------------------------------------------------------------------------------------------------------




..
!ZEILE
.set trans -
.select screen line
.continue ENDE    ? _mehr
.formula xrb     =  M|lsendwert
.formula xgesamt =  M|gesamtpr
.formula xrs     =  M|skonto
.formula xdl     = 'M|lsdat'
.formula xrm     =  M|mge:2
.formula xrp     =  M|prbasis
.formula xtme    =  M|mgeeh
.formula xrpr    =  M|preis
..
'M|tedinr ''M|ganr    ' 'M|elsnr     ' 'xdl   ' 'M|art     ' '  0xrm'  'xtme ' ' 0xrp'  ' 0xrpr' ' 0xgesamt' '    0xrb'
.set trans +
?RECHNUNGS-NR:'M|rechnr '                                                                                  ' M|rechbetr'  ? M|druckre & +M|rechnr>0
.set trans -
.formula xfehler = M|fehler
.formula xf1     = M|fehler << ";"
.formula xf2     = (M|fehler >> ";") << ";"
.formula xf3     = ((M|fehler >> ";") >> ";") << ";"
?'xf1' ? M|druckfehl & +xf1>0
?'xf2' ? M|druckfehl & +xf2>0
?'xf3' ? M|druckfehl & +xf3>0
?************************************************************************************************************************* ? M|fehler <> ""
.set trans +
?************************************************************************************************************************* ? M|elsnr/"*Summe*"
.set trans -
.formula xf1 = ""
.formula xf2 = ""
.formula xf3 = ""
..
.continue ZEILE
..
!ENDE
.continue
