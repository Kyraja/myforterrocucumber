..!interpreter english
..@@BEGINHEAD
..========================================================================
..==
..==  Name              : INV.EXP.VKRE.EDI
..==
..==  Pfad              : dfue
..==
..==  Funktion          : unterprogramm von DFUE.EXP
..==                      extrabehandlung fÅr VKRE nach edifact
..==
..==  Erstellungsdatum  : 27.7.99
..==
..==  Autor             : Hagen Schulze
..==
..==  Verantwortlich    : mh
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..========================================================================
..@@ENDHEAD
..
.. include standard programs
.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
.set trans -
.type date xdatum
.type bool  xmehr
..... procedure stack pointer .....
..art int   xprocsp
.type time  xzeit
..
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
..fo xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. programm ist unterprogramm von DFUE.EXP
.end . ? txname / "*INV.EXP.VKRE.EDI"
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.. ----------------------------------------
.reserve
..**ok,18.06.2001 (jetzt idkunderab statt idkundeab)
..
.. Åbertragungsnummern im kunden
..
.continue EL001 ? _(+h|idkunderab > 0)
.. IF001
.select customer lock 'h|idkunderab'
..
..
.continue EL002 ? _(mehr)
.. IF002
.type text xvorgang ? _F|defined(U|xvorgang)
.formula U|xvorgang = "VKRE"
.formula U|xediuebnrMOD = +1
.input "DFUE.PUT.PROTOK.UEBNR"
.copy U|xbreturn = G|true
..
.continue FI002
!EL002
.. fehler 52
.formula xbreturn = false
.formula xfcode = 52
.. und wieder zurÅck
.continue
..
!FI002
..
.continue FI001
!EL001
.. fehler 52
.formula xbreturn = false
.formula xfcode = 52
.. und wieder zurÅck
.continue
..
!FI001
..
.select
.. ----------------------------------------
..
.. datum / zeit der dateierstellung
.. datum / zeit der dateierstellung
.formula xdatum = datum
.formula xzeit = zeit
.formula h|dinhouse = xdatum
.formula h|zinhouse = xzeit
.formula h|ddatei   = xdatum
.formula h|zdatei   = xzeit
..
.. Åbertragungsnr in den EDI-datensatz
.formula h|uebnra = xUebNrAlt
.formula h|uebnr  = xUebNrNeu
.formula h|uebdat = datum
.rewrite
..
.. dann mal die zeilen nach satz 000
.select lock line
.formula xmehr = mehr
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(xmehr)
..
.continue EL003 ? _(h|text1 = "000")
.. IF003
.. datum und uhrzeit in satz 000 eintragen
.formula h|text12 = xdatum:8
.formula h|text13 = (("00" + ('xzeit' << ":")) >> 2) + (("00" + ('xzeit' >> ":")) >> 2)
.formula h|text14 = xUebNrNeu
.rewrite
..
.select lock line
.formula xmehr = mehr
..
..ein
..
.continue FI003
!EL003
.select lock line
.formula xmehr = mehr
..
!FI003
..
.continue LOOP001
!ELOP001: ==============================
..
