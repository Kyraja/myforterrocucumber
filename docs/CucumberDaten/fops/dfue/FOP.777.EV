..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FOP.777.EV
.. Autor          : ok
.. Verantwortlich : dsch
.. Kontrolle      : mh
.. Funktion       : EFOP fuer Nachrichten-Schema
.. Functionality  : efop for db (Schemata) group (Schema)
..*****************************************************************************
.set trans -
.type text xsys        ? _defined(xsys)
.type text xnummer     ? _defined(xnummer)
.type text xdatei      ? _defined(xdatei)
.type text xsel        ? _defined(xsel)
.type text xsubrequest ? _defined(xsubrequest)
.type text xbzeichen   ? _defined(xbzeichen)
..
.. Event Evaluation
.. 	TODO: remove unused events from fop.txt (.vlge)
.. ----------- ---------- ---------- -------------------------------------------
.continue END      ?  G|evtartengl="BUTTON_AFTER"   &  G|evtvar="bustruktur"
.continue END      ?  G|evtartengl="BUTTON_AFTER"   &  G|evtvar="confsel"
.continue MASKEIN  ?  G|evtartengl="SCREEN_ENTER"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!MASKEIN
.formula xsel = "$,,;@gruppe=1;gruppe=1;request=" + 'M|request'
.select ediconfiguration 'xsel'
.continue END ? _G|mehr
.formula xnummer = H|num92
..
.formula xdatei = "X" + 'xnummer' + ".TMP"
.output new 'xdatei'
.input "DATEI.F"
..
.. VORGŽNGE
!L0
.select line
.continue ENDE ? _mehr
..
.. VORGANG holen
.load 0 ediconfiguration 'H|ozo'
.continue L0 ? _mehr
.. SETUPs
!L1
.load 0 line
.continue L0 ? _mehr
.. SETUP
.load 1 ediconfiguration '0|fzo'
.continue L1 ? _mehr
.. SATZARTEN und Tag's
!L2
.load 1 line
.continue L1 ? _mehr
.continue L2 ? +'1|ediptag'=0
'1|ediptag'#
.continue L2
..
!ENDE
.formula xsys = "sort -t# -u +0 -1 -o " + 'xdatei' + " " + 'xdatei'
.system 'xsys' background
.continue END ? _mehr
..
!SATZART
.continue
..
!CONFSEL
.continue
..
..*****************************************************************************
!END
.continue
