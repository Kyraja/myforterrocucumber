.set trans -
.. 
.input "is/ABASFARBEN.DEF"
..
.type P109:2 edinachr ? _F|defined(U|edinachr)
.type text   xedisuch ? _F|defined(U|xedisuch)
.. 
.continue END1 ? _M|kbnachricht1 &  _M|kbohnenachricht
.copy U|edinachr = M|kedinachr1 
.formula U|xedisuch = "VKAUVE-A"
.input "FORECASTCONFIG.EDINFO.TAB"
!END1
..
.continue END2 ? _M|kbnachricht2 & _M|kbohnenachricht
.copy U|edinachr = M|kedinachr2
.formula U|xedisuch = "VKAUVEF-A"
.input "FORECASTCONFIG.EDINFO.TAB"
!END2
..
.continue END3 ? _M|kbnachricht3 & _M|kbohnenachricht
.copy U|edinachr = M|kedinachr3
.formula U|xedisuch = "VKAUVEP-A"
.input "FORECASTCONFIG.EDINFO.TAB"
!END3
.. 
..*****************************************************************************
!END
.continue
