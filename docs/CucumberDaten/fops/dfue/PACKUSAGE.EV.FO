..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PACKUSAGE.EV.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : simple field exits -> reset table rows
...Includes
..  include dfue/PACKUSAGE.VIEW.FO
..*****************************************************************************
.set trans -
..
..<META M|='dfue/PACKUSAGE'>
..<META 1|='P106:1'>
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INSTR   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbpackanweisungen"
.continue INSTR   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpackanw"
.continue PACKMAT ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbpackmittel"
.continue PACKMAT ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpackmit"
.continue ANW2MAT ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbanwzupackmit"
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbartikel"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbkuart"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbvplan"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbrahmen"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbauftrag"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbliefer"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbpackanw"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbfertigungsliste"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbkonto"
.. ----------- ---------- ---------- -------------------------------------------
.continue FORBID  ?  G|evtartengl = "ROW_MOVE_BEFORE" 
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!ANW2MAT
.copy M|packinstructview = M|kbanwzupackmit
.copy M|smallunitview = M|kbanwzupackmit
.input "PACKUSAGE.VIEW.FO"
.continue INIT
..
!PACKMAT: pack material bool
.formula M|kpackanw = ""
.formula M|kpackm = ""
.copy M|kbpackmittel = G|true
.copy M|kbpackanweisungen = G|false
.copy M|processview = G|true
.copy M|productview = G|false
.copy M|packmatview = G|false
.copy M|packinstructview = M|kbanwzupackmit
.copy M|smallunitview = M|kbanwzupackmit
.input "PACKUSAGE.VIEW.FO"
.continue INIT
.. 
!INSTR: find small unit
.formula M|kpackm = ""
.continue SKIP1 ? F|empty(M|kpackanw)
.load 1 nolock packinginstructions 'M|kpackanw^id'
.load 1 nolock line
.continue SKIP1 ? _G|mehr
.copy M|kpackm = 1|artikel 
.load 1 
!SKIP1
.formula M|kpackmit = ""
.copy M|kbpackanweisungen = G|true
.copy M|kbpackmittel = G|false
.copy M|kbanwzupackmit = G|false
.. Set default pack instruction views 
.copy M|processview = G|true
.copy M|productview = G|true
.copy M|packmatview = G|false
.copy M|packinstructview = G|true
.copy M|smallunitview = G|false
.input "PACKUSAGE.VIEW.FO"
.continue INIT
..    
!INIT: remove rows
.make screen line --  ?  M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error 
.end 1
..*****************************************************************************
!END
.continue 
