..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TESTDAT.NEUEZEILE
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Wird bei EinfÅgen einer Zeile ausgefÅhrt. Das FOP Åbernimmt
..                  Feldnamen, Feldarten und Beschreibung zur aktuellen Datei.
.. Functionality  : Is called when inserting a new row. The efop fills
..                  field name, type and description for current file.
..*****************************************************************************
.set trans -
..
.continue END  ?  M|aktzeile = 0
.continue END  ?  F|empty(M|tdbgruppe)
..
..
.type text   xtdbgruppe
.type integer    xi
.type integer    xaktzeile
..
.type text   xttabellenfeld
..
.type text   xtname1
.type text   xtname2
.type text   xtname3
.type text   xtname4
.type text   xtname5
.type text   xtname6
.type text   xtname7
.type text   xtname8
.type text   xtname9
.type text   xtname10
.type text   xtname11
.type text   xtname12
.type text   xtname13
.type text   xtname14
.type text   xtname15
.type text   xtname16
..
.type text   xtbem1
.type text   xtbem2
.type text   xtbem3
.type text   xtbem4
.type text   xtbem5
.type text   xtbem6
.type text   xtbem7
.type text   xtbem8
.type text   xtbem9
.type text   xtbem10
.type text   xtbem11
.type text   xtbem12
.type text   xtbem13
.type text   xtbem14
.type text   xtbem15
.type text   xtbem16
..
.type text   xtart1
.type text   xtart2
.type text   xtart3
.type text   xtart4
.type text   xtart5
.type text   xtart6
.type text   xtart7
.type text   xtart8
.type text   xtart9
.type text   xtart10
.type text   xtart11
.type text   xtart12
.type text   xtart13
.type text   xtart14
.type text   xtart15
.type text   xtart16
..
.type text   xtwert1
.type text   xtwert2
.type text   xtwert3
.type text   xtwert4
.type text   xtwert5
.type text   xtwert6
.type text   xtwert7
.type text   xtwert8
.type text   xtwert9
.type text   xtwert10
.type text   xtwert11
.type text   xtwert12
.type text   xtwert13
.type text   xtwert14
.type text   xtwert15
.type text   xtwert16
..
.formula U|xtdbgruppe = M|tdbgruppe
..
.formula U|xi = 0
!VALUES
.formula U|xi = U|xi + 1
.formula U|xtwert.xi = M|twert.xi
.continue VALUES   ?  U|xi < 16
..
.formula U|xi = 0
!NNAME
.formula U|xi = U|xi + 1
.formula U|xtname.xi = M|tname.xi
.formula U|xtbem.xi  = M|tbem.xi
.formula U|xtart.xi  = M|tart.xi
.formula U|xttabellenfeld = M|ttabellenfeld
.continue NNAME   ?  U|xi < 16
..
.make screen line +O
.formula M|tdbgruppe = U|xtdbgruppe
.formula U|xi = 0
!NFIELD
.formula U|xi = U|xi + 1
.formula M|twert.xi = U|xtwert.xi
.formula M|tname.xi = U|xtname.xi
.formula M|tbem.xi  = U|xtbem.xi
.formula M|tart.xi  = U|xtart.xi
.formula M|ttabellenfeld = U|xttabellenfeld
.continue NFIELD  ?  U|xi < 16
..
..*****************************************************************************
!END
.continue
