..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIRAH.KBFELDER.FA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Controls views: shown fields in table, as well as
..                  hiding or showing the administration register depending
..                  on user priority.
..*****************************************************************************
.set trans -
..
..
.. Event evaluation
.. ----------- ----- Header -------- -------------------------------------------
.continue INIT    ?  G|evtartengl = "SCREEN_ENTER"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbstandard"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbkundeartikel"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbfruehwarn"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbfzahl"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbgueltigkeit"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbpreise"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbversand"
.continue FIELDS  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbabrufe"
.continue UPGRADE ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbupgrade"
.continue PREISE  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbpreiseneu"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!INIT: get permissions^prioty of current user
.type A104 xprio
.formula U|xprio = "A"
.load 1 company 'G|passw^id'
.load 1 line
.continue EPRIO   ? _G|mehr
.formula xprio = 1|rechte^prio
!EPRIO
.load 1
.formula M|kbupgradeprio = (U|xprio >= "E")
.. set initial fields
.copy M|kbstandard = G|true
.. always show upgrade fields on prio e
.copy M|kbupgrade = M|kbupgradeprio
.continue SHOW
..
..
!FIELDS
.copy M|kbstandard = G|false
.copy M|kbkundeartikel = G|false
.copy M|kbfruehwarn = G|false
.copy M|kbfzahl = G|false
.copy M|kbgueltigkeit = G|false
.copy M|kbpreise = G|false
.copy M|kbversand = G|false
.copy M|kbabrufe = G|false
.copy M|.evtvar = G|true
.continue SHOW
..
..
!PREISE
.copy M|kbstandard = G|false
.copy M|kbkundeartikel = G|false
.copy M|kbfruehwarn = G|false
.copy M|kbfzahl = G|false
.copy M|kbgueltigkeit = G|false
.copy M|kbpreise = G|true
.copy M|kbversand = G|false
.copy M|kbabrufe = G|false
.continue SHOW
..
..
!UPGRADE
.. do not switch shown "regular" fields
..
!SHOW
.. toggle register with upgrade button
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = "fop_upgradeflag"                       ?  M|kbupgradeprio
.formula P|maskkontextfop = "fop_upgradeflag fop_upgrade"           ?  M|kbupgradeprio & M|kbupgrade
.formula P|maskkontextfop = P|maskkontextfop + " fop_standard"      ?  M|kbstandard
.formula P|maskkontextfop = P|maskkontextfop + " fop_kundeartikel"  ?  M|kbkundeartikel
.formula P|maskkontextfop = P|maskkontextfop + " fop_fruehwarn"     ?  M|kbfruehwarn
.formula P|maskkontextfop = P|maskkontextfop + " fop_fzahl"         ?  M|kbfzahl
.formula P|maskkontextfop = P|maskkontextfop + " fop_gueltig"       ?  M|kbgueltigkeit
.formula P|maskkontextfop = P|maskkontextfop + " fop_preise"        ?  M|kbpreise
.formula P|maskkontextfop = P|maskkontextfop + " fop_versand"       ?  M|kbversand
.formula P|maskkontextfop = P|maskkontextfop + " fop_abrufe"        ?  M|kbabrufe
.formula P|maskkontextfop = P|maskkontextfop + " fop_preisupgrade"  ?  M|kbpreise & M|kbupgrade
.formula P|maskkontextfop = P|maskkontextfop + " fop_packupgrade"   ?  M|kbversand & M|kbupgrade
..
..*****************************************************************************
!END
.continue
