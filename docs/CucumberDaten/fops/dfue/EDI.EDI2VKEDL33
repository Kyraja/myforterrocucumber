.formula xz.text1 = xz.text1 + 1 ? text1 = "PAC1"
.formula xz.text1 = xz.text1 + 1 ? text1 = "PAC2"
.formula xz.text1 = xz.text1 + 1 ? text1 = "PAC3"
.formula xz.text1 = xz.text1 + 1 ? text1 = "DAL1"
.formula xz.text1 = xz.text1 + 1 ? text1 = "SUM1"
.formula xz.text1 = xz.text1 + 1 ? text1 = "UNZI"
..
..
!LOOP006: ==============================
.continue ELOP006 ? _(xzaehl < 26)
..
