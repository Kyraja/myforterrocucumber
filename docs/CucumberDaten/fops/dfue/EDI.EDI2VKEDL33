..
!LOOP002: ==============================
.continue ELOP002 ? _(xmehr)
.formula xi = xi + 1
..
..
.continue EL003 ? _((xart.xi = "") ; (xi > 30))
.. IF003
.formula xmehr = false
..
!EL003
.. FI003
..
..
.continue EL004 ? _((xart.xi = "") & (xi < 31))
.. IF004
.formula xart.xi = xart
..
