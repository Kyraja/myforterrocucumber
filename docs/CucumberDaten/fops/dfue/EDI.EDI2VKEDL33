.. IF009
.formula xvar = text.xzaehl ? text.xzaehl <> ""
.formula xvar = ""          ? text.xzaehl = ""
.formula x1 = xz.text1
.formula xs.text1.x1.xzaehl = xvar
..
.formula xkette = xkette + 'xs.text1.x1.xzaehl' + "#"
..
.formula xzaehl = xzaehl + 1
..
