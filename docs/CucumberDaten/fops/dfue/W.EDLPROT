..!interpreter english translate
..*****************************************************************************
.. FOP-Name       : W.EDLPROT
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Protokoll eingehende EDL-Meldungen
.. Functionality  :
..*****************************************************************************
.set trans +
.type text xkunde xdanf xdend xtemp xtemp2 xfrage
.type text  xnum xidr xidku xkuartnr xw xab xve xs xf xidart xfunktion xlabru xabbenr xefz xvo
.type date xedanf xedend xerf xerfvor
.type integer xidat
.formula xtemp ="WEDLPROT"+pid+".TMP"
.formula xtemp2="WEDLPROT2"+pid+".TMP"
.formula xkunde=""
!LES
.read "Geben Sie das Anfangs-Datum ein, von" xedanf
.read "Geben Sie ein End-Datum ein, bis" xedend
Daten werden selektiert, bitte warten!
.formula xdanf=xedanf
.formula xdend=xedend
.formula xdanf="." ? xdanf=""
.formula xdend="." ? xdend=""
.formula xtsel="$,,;@gruppe=0;erfass=" + xdanf + "!" + xdend + ";vorart=27!27"
..
.input "ARB"
.formula ximpini = "dfue/DFUE.IMP.INI"
.input 'ximpini'
.output new WERF.WEG
..
.output new 'xtemp'
.input "DATEI.F"
.select edifact 'xtsel'
.continue E0 ? _mehr
.formula xidat=erfass:8
'num'#'ideksrah'#'idkundeab'#'kuartnr'#'werk'#'ablstelle'#'verwschl'#'status'#'fcode'#'ideksart'#'funktion'#'labruf'#'abbenr'#'einfzahl'#'xidat'#'ideksvor'#
!A10
.select edifact
.continue SORT ? _mehr
.formula xidat=erfass:8
'num'#'ideksrah'#'idkundeab'#'kuartnr'#'werk'#'ablstelle'#'verwschl'#'status'#'fcode'#'ideksart'#'funktion'#'labruf'#'abbenr'#'einfzahl'#'xidat'#'ideksvor'#
.continue A10
!SORT
.formula xsort ="sort -t# +14 -15 +2n -3 +3 -4 +0n -1 +4 -5 +5 -6 +6 -7 +12 -13 -o " + xtemp2 + " " + xtemp
.system 'xsort'
.input DRUCKER
.input BLANKOB.F
.page 1
.up
.page 1
'txname'                                                                                                    'datum'
                                                  EDL-MELDUNGEN
                                              =====================
                                                 Seite: 'seite'


.formula xkundevor=""
.formula xartvor=""
!AUSG
.select from 'xtemp2' xnum # xidr # xidku # xkuartnr # xw # xab # xve # xs # xf # xidart # xfunk # xlabru # xabbenr # xefz # xerf # xvo #
.continue ENDE ? _mehr
.continue MERK ? xerfvor=xerf

EDL-Meldungen vom: 'xerf'
!MERK
.formula xerfvor=xerf
.reserve
.continue ARTIKEL ? xkundevor=xidku

Kunde: 'xidku   '   Werk: 'xw   '  Abladestelle: 'xab     '
EDI-ID  Stat. F.cod Vorgangs-ID  Funktion
------- ----- ----- -----------  ----------
.formula xkundevor= xidku
!ARTIKEL
.continue GAUSG ? xartvor=xkuartnr
.formula xartvor = xkuartnr
!GAUSG
?' xnum' 'xs ' 'xf ' 'xvo      '   'xfunk' (Entnahme-Meldung) ? xfunk="36"
?' xnum' 'xs ' 'xf ' 'xvo      '   'xfunk' (Bestands-Meldung) ? xfunk="35"
?' xnum' 'xs ' 'xf ' 'xvo      '   'xfunk' (Eingangs-Meldung) ? xfunk="30"
.continue AUSG
..
!E0
.box Meldung
Im angegebenen Zeitraum wurden keine EDL-Meldungen gefunden!
.formula xfrage = "Wollen Sie einen anderen Zeitraum eingeben?"
.menu 'xfrage'
Ja, Eingabe wiederholen >> .continue LES
Nein, beenden           >>
..*****************************************************************************
!ENDE
.end

