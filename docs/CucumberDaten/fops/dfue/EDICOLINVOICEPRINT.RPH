..!interpreter english translate noabbrev
..!meta M|=dfue/EDICOLINVOICEPRINT
..*****************************************************************************
.. Name           : EDICOLINVOICEPRINT.RPH
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : report footer: sender + recipient data
..*****************************************************************************
.set trans -
.. 
..*****************************************************************************
.. Company data
..*****************************************************************************
..
.select company 'F|sysinfo(10)'
..!meta H|=P12:10 
..
.type text xtlians
.formula U|xtlians = H|ans + ";" + H|str + ";" + H|plz + " " + H|nort + ";"
.formula M|klianszeile1 = U|xtlians << ";"
.formula u|xtlians = U|xtlians >> ";"
.formula M|klianszeile2 = U|xtlians << ";"
.formula u|xtlians = U|xtlians >> ";"
.formula M|klianszeile3 = U|xtlians << ";"
.formula u|xtlians = U|xtlians >> ";"
.formula M|klianszeile4 = U|xtlians << ";"
.formula u|xtlians = U|xtlians >> ";"
.formula M|klianszeile5 =  U|xtlians << ";"
..
.formula M|klikurzname = H|knam1
.formula M|kliabteilung = ""
.formula M|klitelefon = H|tele
.formula M|klifax = H|fax
.formula M|kliustid = H|ustid
.formula M|kligln = H|gln
..
.select -
..
..*****************************************************************************
.. Header fields in edi invoice
..*****************************************************************************
..
.select edifact 'M|kedi^id'
..!meta H|=P53
..
.copy M|kedinachr = H|edinachr
..
.. Muss in Nachricht schauen, welches Protokoll in der nachricht verwendet worden ist!
.formula M|kprotokoll = "(VDA)" 
.formula M|kprotokoll = "(EDIFACT)" ? H|nachrtyp="INVOIC"
..
.. Uebertragung
.copy M|kuebnralt = H|uebnra
.copy M|kuebdat = H|uebdat
..
.. Lieferantendaten fuer Kunden
.formula M|klifrbez = H|idabkunde
..
..*****************************************************************************
.. Kunde / Rechnungslistenempfaenger
..*****************************************************************************
..
.. Kunde
.assign M|kkunde = H|idkunderab
.load 2 customer 'M|kkunde^id'
..!meta 2|=P0
..
.. Rechnungslistenempfaenger?
.type VPK17 xvreliempf ? _F|defined(U|xvreliempf)
.input "EDI.GET.CUSTOMERCONFIG"
.assign M|kreliempf = U|xvreliempf^id
..
.load 2 customer 'M|kreliempf^id' ? _F|empty(M|kreliempf)
..!meta 2|=P0
..
.continue EKUNDE ? _F|defined(2|id)
..
.type text xkuans
.formula U|xkuans = 2|ans + ";" + 2|str + ";" + 2|lakenn + " " + 2|plz + " " + 2|nort + ";"
.formula M|kkuanszeile1 = U|xkuans << ";"
.formula u|xkuans = U|xkuans >> ";"
.formula M|kkuanszeile2 = U|xkuans << ";"
.formula u|xkuans = U|xkuans >> ";"
.formula M|kkuanszeile3 = U|xkuans << ";"
.formula u|xkuans = U|xkuans >> ";"
.formula M|kkuanszeile4 = U|xkuans << ";"
.formula u|xkuans = U|xkuans >> ";"
.formula M|kkuanszeile5 =  U|xkuans << ";"
..
.formula M|kkustrasse = 2|str
.formula M|kkuort = 2|nort
.formula M|kkuplz = 2|plz
.formula M|kkulakenn = 2|lakenn
.formula M|kkustaat = 2|staat
.formula M|kkukurzname = 2|sucherw
.formula M|kkuabteilung = ""
.formula M|kkutelefon = 2|tele
.formula M|kkufax = 2|fax
.formula M|kkuustid = 2|ustid
..
.load 2
..
!EKUNDE
..
..*****************************************************************************
.. Warenempfaenger
..*****************************************************************************
..
.assign M|kwempf = h|idkundesab
.formula M|kwempfgln = H|glkundesab
..
.continue EWEMPF ? F|empty(M|kwempf)
..
.load 2 customer 'M|kwempf^id'
..!meta 2|=P0
..
.type text xwempf
.formula U|xwempf = 2|sucherw + ";"
.formula M|kwempfname1 = U|xwempf  << ";"
.formula U|xwempf = U|xwempf >> ";"
.formula M|kwempfname2 = U|xwempf  << ";"
.formula U|xwempf = U|xwempf >> ";"
.formula M|kwempfname3 = U|xwempf  << ";"
..
.formula U|xwempf = 2|nort + ";"
.formula M|kwempfortzeile1 = U|xwempf << ";"
.formula U|xwempf = U|xwempf >> ";"
.formula M|kwempfortzeile2 = U|xwempf << ";"
..
.formula M|kwempfnummer = 2|nummer
.formula M|kwempfland = 2|land ? F|defined(2|land)
.formula M|kwempfland = 2|firma^land ? F|defined(2|firma)
.formula M|kwempfplz = 2|plz
.formula M|kwempfstrasse = 2|str
.formula M|kwempfustid = 2|ustid
.formula M|kwempfabteilung = ""
..
.load 2
..
!EWEMPF
..
..*****************************************************************************
!END
.continue
