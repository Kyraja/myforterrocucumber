..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PACKANW.EV.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : simple field exits -> reset table rows
..*****************************************************************************
.set trans -
..
..<META M|='dfue/PACKANW'>
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "ksuch"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "ksucherw"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpackmittel"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "klayout"
.continue FBOOL   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kauffuellen"
.continue FBOOL   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kauffuellenebene"
.continue STRUKT  ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpackanw"
.. ----------- ---------- ---------- -------------------------------------------
.continue DUPLI   ?  G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "tbuduplikate"
.continue VERW    ?  G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "tbuverwendungen"
.. ----------- ---------- ---------- -------------------------------------------
.continue FORBID  ?  G|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!STRUKT
.formula M|kpmstruktur = ""
.continue INIT
.. 
!FBOOL
.type bool xb
.formula U|xb = M|.evtvar 
.copy M|kauffuellen = G|false
.copy M|kauffuellenebene = G|false
.formula M|.evtvar = U|xb 
.continue INIT
..
!INIT: remove rows
.make screen line --  ?  M|tzeilen > 0
.continue END
..
!DUPLI: block jfop if no duplicate-status for this row
.continue FORBID  ?  F|empty(M|tduplikatstatus)  
.continue END
..
!VERW
.continue FORBID  ? _M|tverwendet
.continue TOOMANY ?  M|tanzverwend > M|kmaxverwend
.continue VERWEND ?  M|tbuverwendungen=M|infoicon & M|tanzverwend>0
.continue FORBID  ? F|empty(M|tbuverwendungen)
.continue END
..
!VERWEND
.type ID87:9 xcallparam
.formula U|xcallparam = "52957"
.input "st/CALLPARAM.EXEC"
.continue FORBID
..
!FORBID: an event was triggered, which is not allowed
.error 
.end 1
..*****************************************************************************
!END
.continue 
..
.. 
!TOOMANY
.error Zu viele Verwendungen zum Aufklappen
.end 1
..
!STOP: prevent button after efop / no expanding without usage
.error 
.end 1
