..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.ACTCODE.EV
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Pick action codes for product in PRICAT inhouse file
..*****************************************************************************
.set trans -
..
.. event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue VALUE   ?  G|evtartengl="FIELD_EXIT"    &  G|evtvar="actcode"
.continue MENU    ?  G|evtartengl="BUTTON_AFTER"  &  G|evtvar="bactcode"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!VALUE
.continue TEXT  ?  M|actcode<5
..
!MENU
.menu 'M|aktionscodes'
1 'M|aktaddiert'        >> .formula  M|actcode = 1
2 'M|aktgeloescht'      >> .formula  M|actcode = 2
3 'M|aktgeaendert'      >> .formula  M|actcode = 3
4 'M|aktkeineaenderung' >> .formula  M|actcode = 4
  'M|aktleer'           >> .formula  M|actcode = ""
..
!TEXT
.formula M|aktion = ""
.formula M|aktion = 'M|aktaddiert'        ? M|actcode = 1
.formula M|aktion = 'M|aktgeloescht'      ? M|actcode = 2
.formula M|aktion = 'M|aktgeaendert'      ? M|actcode = 3
.formula M|aktion = 'M|aktkeineaenderung' ? M|actcode = 4
..*****************************************************************************
!END
.continue
