..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MULTISITE.IMPORT.PROCESSING
.. Autor          : dsch
.. Verantwortlich : dsch
.. Kontrolle      : mh
.. Funktion       : startet die Verarbeitung einer Multisite-Nachricht
.. Functionality  : starts the processing of a multisite message
..*****************************************************************************
..
.set trans -
..
.type text xtforcemsimport ? _F|defined(U|xtforcemsimport)
.formula U|xtforcemsimport = ""
.formula U|xtforcemsimport = "-force" ? M|importnifi
.continue CALL                        ? M|importnifi
..
.select company "$,,pdreinst^multisiteimport==(Yes);@gruppe=11;@ablageart=(Active)"
.continue NOPWD ? _G|mehr
.formula G|neuespassw = H|id
.select company
!CALL
.input de.abas.multisite.receive.XmlImporter.java -P -pid 'M|id' -cfg dfue/mqueue.cfg 'U|xtforcemsimport'
.continue
!NOPWD
.error Passwortdatensatz mit dem Multisite-Importkennzeichen nicht gefunden
.end 1
