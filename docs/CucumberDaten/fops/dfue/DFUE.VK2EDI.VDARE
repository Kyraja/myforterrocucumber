.formula xStBetragG= 0.00
.formula xStBetrag = 0.00
.formula xStBetrag0= 0.00
.formula xStBetrag1= 0.00
.formula xStBetrag2= 0.00
.formula xStBetrag3= 0.00
.formula xStBetrag4= 0.00
.formula xStBetrag5= 0.00
.formula xStBetrag6= 0.00
.formula xStBetrag7= 0.00
.formula xStBetrag8= 0.00
.formula xStBetrag9= 0.00
