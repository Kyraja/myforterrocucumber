.continue EL042 ? _(F|defined(xmsteuer))
.. IF042
..**ok,07.06.2002 (wenn Rechnung Fehler beinhaltet, folgende BetrÑge setze ich wieder zurÅck)
.formula xGSt.xmsteuer      = xGSt.xmsteuer - xmpwert
.formula xNet.xmsteuer      = xNet.xmsteuer - xReBetragNetto
.formula xNettoG.xmsteuer   = xNettoG.xmsteuer - xReBetragNetto
.formula xStBetrag.xmsteuer = xStBetrag.xmsteuer - xmpwert
