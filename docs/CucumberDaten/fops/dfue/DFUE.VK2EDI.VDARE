.continue EPROCDEF
.. procedure definitions
..
!PROC001: ----- FEHLER -----
.formula xbfehler = true
..
.output addedto 'xdfehler'
..box Fehler
?'xtxt1' ? +xtxt1 > 0
?'xtxt2' ? +xtxt2 > 0
..
.. wieder auf alte datei schreiben
.output addedto 'xgeraet'
..
..**ok,29.06.2005 (wenn vom Infosystem aufgerufen)
..
..
.continue EL001 ? _(xbinfo)
.. IF001
.formula M|fehltext = M|fehltext + xtxt1 + ";" + xtxt2
..
!EL001
.. FI001
..
.continue 'xprocst.xprocsp'
..
..
!PROC002: ----- SENDE.POST -----
.formula xPostBetreff = "Fehler beim öbernehmen von Rechnungen in EDI-Datenbank"
.formula xPostStichw1 = "DFö-Fehler"
.formula xPostFtext   = xdfehler
.formula xPostEmpf    = xIdDfueExVerteil
..
.input 'xdPostSenden' ? xPostEmpf<>""
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
