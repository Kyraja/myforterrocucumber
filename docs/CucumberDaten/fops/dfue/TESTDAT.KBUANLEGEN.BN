..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TESTDAT.KBUANLEGEN.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Erstellt das EDP-Skript anhand der Daten aus der
..                  Infosystemtabelle. - Optional wird das Skript ausgefÅhrt
..                  oder angezeigt.
.. Functionality  : Creates the edp script with data from infosystem table.
..                  Optionally the script is executed or displayed.
..*****************************************************************************
.set trans -
..
.type bool   xbzeigen
.type bool   xbanlegen
..
.type text   xtsystem
.type text   xtedpskript
.type text   xtedpout
.type text   xtedperr
.type bool   xberror
..
.type integer    xi
..
.type text   xtwert1
.type text   xtwert2
.type text   xtwert3
.type text   xtwert4
.type text   xtwert5
.type text   xtwert6
.type text   xtwert7
.type text   xtwert8
.type text   xtwert9
.type text   xtwert10
.type text   xtwert11
.type text   xtwert12
.type text   xtwert13
.type text   xtwert14
.type text   xtwert15
.type text   xtwert16
..
..
.. event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.formula U|xbzeigen  = true      ?  G|evtvar = "kbuladerzeigen"
.formula U|xbanlegen = true      ?  G|evtvar = "kbuanlegen"
.. ----------- ---------- ---------- -------------------------------------------
.continue END  ?  _( U|xbzeigen ; U|xbanlegen )
..
.. prepare output
.file -tempname U|xtedpskript
.output new 'U|xtedpskript'
.input "DATEI.F"
..
..
.select screen header
!NROW
.select screen line
.continue ESKRIPT ? _G|mehr
.continue NROW    ?  F|empty(M|tdbgruppe)
.continue NROW    ?  F|empty(M|twert1) & F|empty(M|twert2)
.continue HEAD    ?  M|tname1 = M|twert1
.continue DATA
..
!HEAD

#!database='M|tdbgruppe'
?#!action=new                     ? _('M|tdbgruppe'="0:1"; 'M|tdbgruppe'="0:2"; 'M|tdbgruppe'="1:1"; 'M|tdbgruppe'="2:1"; 'M|tdbgruppe'="106:1"; 'M|tdbgruppe'="53:0")
?#!action=store                   ?   'M|tdbgruppe'="0:1"; 'M|tdbgruppe'="0:2"; 'M|tdbgruppe'="1:1"; 'M|tdbgruppe'="2:1"; 'M|tdbgruppe'="106:1"
?#!action=do                      ?   'M|tdbgruppe'="53:0"
?#!typedcmd=infosystem            ?   'M|tdbgruppe'="53:0"
#!flddelimiter=#
#!dontchange=~
?#!RECORDIDFLD='M|tname1'         ? _F|empty(M|ttabellenfeld) & 'M|tdbgruppe'<>"53:0"
?#!RECORDIDFLD='M|tname2'         ? _F|empty(M|ttabellenfeld) & 'M|tdbgruppe'="53:0"
?#!FIRSTTABFLD='M|ttabellenfeld'  ? _F|empty(M|ttabellenfeld)

.formula U|xi = 0
!NNAME
.formula U|xi = U|xi + 1
.formula U|xtwert.xi  = M|tname.xi + "#"
.formula U|xtwert.xi = ""        ?  F|empty(M|tname.xi)
.continue ENAME   ?  U|xi > 15
.continue NNAME
!ENAME
'U|xtwert1''U|xtwert2''U|xtwert3''U|xtwert4''U|xtwert5''U|xtwert6''U|xtwert7''U|xtwert8''U|xtwert9''U|xtwert10''U|xtwert11''U|xtwert12''U|xtwert13''U|xtwert14''U|xtwert15''U|xtwert16'

.continue NROW
..
!DATA
.formula U|xi = 0
!NWERT
.formula U|xi = U|xi + 1
.formula U|xtwert.xi  = M|twert.xi + "#"
.formula U|xtwert.xi = "~#"      ?  U|xtwert.xi = "#"
.formula U|xtwert.xi = ""        ?  F|empty(M|tname.xi)
.continue EWERT   ?  U|xi > 15
.continue NWERT
!EWERT
'U|xtwert1''U|xtwert2''U|xtwert3''U|xtwert4''U|xtwert5''U|xtwert6''U|xtwert7''U|xtwert8''U|xtwert9''U|xtwert10''U|xtwert11''U|xtwert12''U|xtwert13''U|xtwert14''U|xtwert15''U|xtwert16'
.continue NROW
..
!ESKRIPT

.output
.editing 'U|xtedpskript'   ?  U|xbzeigen
.continue END                 ?  U|xbzeigen
..
..
.file -tempname U|xtedpout
.file -tempname U|xtedperr
..
.formula U|xtsystem = "edpimport.sh -P -c EKS -I " + 'U|xtedpskript' + " >> " + 'U|xtedpout' + " 2>> " + 'U|xtedperr'
.system 'U|xtsystem' password background
.. remember value for 'mehr'
.formula U|xberror = _G|mehr
..
.. check created objects
.input "dfue/TESTDAT.BSTART.BN"
..

.. show error messages
.editing 'U|xtedperr'  ?  U|xberror & _G|edp
.input -text 'U|xtedperr'  ?  U|xberror &  G|edp
..
..*****************************************************************************
!END
.continue
