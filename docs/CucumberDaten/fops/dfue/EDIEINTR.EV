..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIEINTR.EV
.. Autor          : mh/tg/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Allgemeine Events EDIEINTR
.. Functionality  : General event handling EDIEINTR
..*****************************************************************************
.set trans -
..
.type text   xtcmd
..
..
.. event evaluation
..------------------------- Kopf/Header ---------------------------------------
.continue TABINIT  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kvon"
.continue TABINIT  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbis"
.continue TABINIT  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kabmodell"
.continue TABINIT  ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kieabmodell"
.continue BOOLM    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "minfo"
.continue BOOLO    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "oinfo"
.continue BOOLA    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "ainfo"
.continue LBOOLM   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "liefminfo"
.continue LBOOLO   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "liefoinfo"
.continue LBOOLA   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "liefainfo"
..------------------------- Tabelle/Table ---------------------------------------
.continue EDINFO   ?  G|evtartengl = "BUTTON_BEFORE" &  G|evtvar = "chnginfo"
..------------------------- ----------- ---------------------------------------
.continue FORBID   ?  G|evtartengl = "ROW_INSERTION_BEFORE"
.continue FORBID   ?  G|evtartengl = "ROW_DELETION_BEFORE"
..------------------------- ----------- ---------------------------------------
.continue END
..
!BOOLM: only one bool must be marked
.copy M|oinfo = _M|minfo
.copy M|ainfo =  G|false
.continue NOLIEF
!BOOLO: only one bool must be marked
.copy M|ainfo = _M|oinfo
.copy M|minfo =  G|false
.continue NOLIEF
!BOOLA: only one bool must be marked
.copy M|minfo = _M|ainfo
.copy M|oinfo =  G|false
!NOLIEF
.copy M|liefminfo = G|false
.copy M|liefoinfo = G|false
.copy M|liefainfo = G|false
.continue TABINIT
..
!LBOOLM: only one bool must be marked
.formula M|liefoinfo = _M|liefminfo
.formula M|liefainfo =  false
.continue NOKUN
!LBOOLO: only one bool must be marked
.formula M|liefainfo = _M|liefoinfo
.formula M|liefminfo =  false
.continue NOKUN
!LBOOLA: only one bool must be marked
.formula M|liefminfo = _M|liefainfo
.formula M|liefoinfo =  G|false
!NOKUN
.formula M|minfo = G|false
.formula M|oinfo = G|false
.formula M|ainfo = G|false
.continue TABINIT
..
..
!TABINIT: a key field was changed, remove old rows, refresh table
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..
..
!EDINFO
.command -parallel 'F|formatstr("<(Customer)>{1}<(Edit)> ? edinfo=|[invisible]=1", M|tkdnummer^id)'  ?  M|tkdnummer^dnr=0
.command -parallel 'F|formatstr("<(Vendor)>{1}<(Edit)> ? edinfo=|[invisible]=1", M|tkdnummer^id)'  ?  M|tkdnummer^dnr=1
.continue END
..*****************************************************************************
!END
.continue
