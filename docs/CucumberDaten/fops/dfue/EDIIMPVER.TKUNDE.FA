..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIIMPVER.TKUNDE.FA
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Ergaenzt Kunden- und Kundenkontakt-Daten nach Eingabe M|tkunde
.. Functionality  : Adds Customer and Customer Contact data after entry of M|tkunde
..*****************************************************************************
.set trans -
..
.. Disable "All customers", if customer data is entered in table
.copy M|kballekunden = G|false  ? _F|empty(M|tkunde)
..
..
..  Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ?  F|empty(M|tkunde)
.continue KUNDE   ?  M|tkunde^gruppe = 1
.continue KONTAKT ?  M|tkunde^gruppe = 2
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!INIT
.input 'M|tab'
.continue END
..
..
!KUNDE
.input 'M|tab'
..
.select customer 'F|formatstr("$,,;@gruppe=2;firma=={1}", M|thauptkunde^id)'
.continue END  ? _G|mehr
!KSHOW
.make screen line +O
.formula M|tkunde = H|id
.protection tkunde 'M|aktzeile'
.input 'M|tab'
.select customer
.continue KSHOW  ?  G|mehr
.input "dfue/EDIIMPVER.KBUPRUEFEN.BN"
.continue END
..
..
!KONTAKT
.input 'M|tab'
.input "dfue/EDIIMPVER.TBUVERARB.BV"
.continue END
..
..*****************************************************************************
!END
.continue


