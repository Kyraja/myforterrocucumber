..!interpreter english translate noabbrev
..!meta M|=dfue/EDICOLINVOICEPRINT
..*****************************************************************************
.. Name           : EDICOLINVOICEPRINT.BSTART.BA
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : Start button - button after event
...Incluces       :
..		include		dfue/EDICOLINVOICEPRINT.RPH
..		include		dfue/EDICOLINVOICEPRINT.TAB
..		include		dfue/EDICOLINVOICEPRINT.RPF
..*****************************************************************************
.set trans -
..
.type text protokollValue
.type bool vda
.type bool edifact
.type bool odette
.. 
.input 'M|bkopf'
..
.formula U|protokollValue = 'F|value(M|kprotokoll, "AS56")'
.formula U|vda = ( U|protokollValue="(VDA)" )
.formula U|edifact = ( U|protokollValue="(EDIFACT)" )
.formula U|odette = ( U|protokollValue="(ODETTE)" )
..
!NLINE
.select line
.continue ELINES ? _G|mehr
.input 'M|tab'
.continue NLINE
!ELINES
..
.input 'M|bfuss'
..
..*****************************************************************************
!END
.continue

