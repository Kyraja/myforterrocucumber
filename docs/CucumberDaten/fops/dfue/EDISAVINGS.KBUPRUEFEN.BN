..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDISAVINGS.KBUPRUEFEN.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.continue END     ?  M|tzeilen = 0
.continue ERR1    ?  F|empty(M|kkpg)  ;  F|empty(kartpg)
..
.input "is/ABASFARBEN.DEF"
..
.type text   xtsortfile
.type text   xtvon
.type text   xtbis
.type text   xtrow
.type integer    xirow
.type text   xtlastvon
.type text   xtlastbis
..
.file -tempname T|xtsortfile
.output new 'T|xtsortfile'
.input "DATEI.F"
..
.select screen header
!ROWS
.select screen line
.continue SORT    ? _T|mehr
'M|tvon:8' # 'M|tbis:8' # 'M|aktzeile'
.continue ROWS
..
!SORT
.output
.sort 'T|xtsortfile' 1 # num
..
!CHECK
.select from 'T|xtsortfile' xtvon # xtbis # xtrow
.continue END     ? _T|mehr
.formula T|xirow = 'T|xtrow'
.select screen line 'T|xirow'
.. ignore special offer
.continue CHECK   ?  M|tsaktion
.colour -foreground -1 -1 -1 -background -1 -1 -1  tvon  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1  tbis  'M|aktzeile'
.continue REM     ?  F|empty(T|xtlastvon)  &  F|empty(T|xtlastbis)
.continue NODATE  ?  F|empty(T|xtvon)  ;  F|empty(T|xtbis)
.continue ERRDAT  ?  M|tvon > M|tbis
.continue ERR2    ?  T|xtlastbis >= T|xtvon
!REM: remember to compare with next row
.formula T|xtlastvon = T|xtvon
.formula T|xtlastbis = T|xtbis
.continue CHECK
..*****************************************************************************
!END
.continue
..
..
!ERR1: no product, no blanket order
.error FÅr die PrÅfung muss ein Rahmenauftrag und ein Artikel ausgewÑhlt sein.
.cursor kkpg 0      ?  F|empty(M|kkpg)
.cursor kartpg 0    ?  F|empty(M|kartpg)
.end 1
..
!NODATE: no start or end date for price
.error Kein GÅltigkeitsdatum!
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow' tvon 'M|aktzeile'  ?  F|empty(M|tvon)
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow' tbis 'M|aktzeile'  ?  F|empty(M|tbis)
.cursor tvon 'M|aktzeile'  ?  F|empty(M|tvon)
.cursor tbis 'M|aktzeile'  ?  F|empty(M|tbis)
.end 1
..
!ERR2
.error Gleicher Zeitraum fÅr mindestens zwei Preise.
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow' tvon 'M|aktzeile'
.cursor tvon 'M|aktzeile'
.end 1
..
!ERRDAT
.error Bis-Datum ist kleiner als Vom-Datum !
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow' tvon 'M|aktzeile'
.colour -foreground 'T|xabasblack' -background 'T|xabasyellow' tbis 'M|aktzeile'
.end 1

