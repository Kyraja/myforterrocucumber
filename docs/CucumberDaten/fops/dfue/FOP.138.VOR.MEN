..@@ENDHEAD
..
.. include standard programs
.input "ARB"
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
..====================================================
..@@ENDVARDEFS
.set trans +
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.menu Nachricht auswÑhlen
01- Lieferabruf -automatisch           >> .formula xvorgang = "VKAUVE-A"
02- Lieferabruf -manuell               >> .formula xvorgang = "VKAUVE-M"
03- Feinabruf -automatisch             >> .formula xvorgang = "VKAUVEF-A"
04- Feinabruf -manuell                 >> .formula xvorgang = "VKAUVEF-M"
05- Pick-Up-Sheet -automatisch         >> .formula xvorgang = "VKAUVEP-A"
06- Pick-Up-Sheet -manuell             >> .formula xvorgang = "VKAUVEP-M"
07- Auftrag (Orders) -automatisch      >> .formula xvorgang = "VKAUEE-A"
08- Auftrag (Orders) -manuell          >> .formula xvorgang = "VKAUEE-M"
09- Gutschrift -automatisch            >> .formula xvorgang = "VKGAV-A"
10- Gutschrift -manuell                >> .formula xvorgang = "VKGAV-M"
11- AuftragsbestÑtigung -manuell       >> .formula xvorgang = "VKAUB"
12- Lieferschein                       >> .formula xvorgang = "VKLS"
13- Rechnung                           >> .formula xvorgang = "VKRE"
14- Artikelpreisliste                  >> .formula xvorgang = "PRICAT"
15- EDL-Meldungen -automatisch         >> .formula xvorgang = "VKEDL-A"
16- EDL-Meldungen -manuell             >> .formula xvorgang = "VKEDL-M"
.end ? F|empty(G|menue)
..
.formula m|tvorgang = "Lieferabruf -automatisch"          ? G|menue=1
.formula m|tvorgang = "Lieferabruf -manuell"              ? G|menue=2
.formula m|tvorgang = "Feinabruf -automatisch"            ? G|menue=3
.formula m|tvorgang = "Feinabruf -manuell"                ? G|menue=4
.formula m|tvorgang = "Pick-Up-Sheet -automatisch"        ? G|menue=5
.formula m|tvorgang = "Pick-Up-Sheet -manuell"            ? G|menue=6
.formula m|tvorgang = "Auftrag (Orders) -automatisch"     ? G|menue=7
.formula m|tvorgang = "Auftrag (Orders) -manuell"         ? G|menue=8
.formula m|tvorgang = "Gutschrift -automatisch"           ? G|menue=9
.formula m|tvorgang = "Gutschrift -manuell"               ? G|menue=10
.formula m|tvorgang = "AuftragsbestÑtigung -manuell"      ? G|menue=11
.formula m|tvorgang = "Lieferschein"                      ? G|menue=12
.formula m|tvorgang = "Rechnung"                          ? G|menue=13
.formula m|tvorgang = "Artikelpreisliste"                 ? G|menue=14
.formula m|tvorgang = "EDL-Meldungen -automatisch"        ? G|menue=15
.formula m|tvorgang = "EDL-Meldungen -manuell"            ? G|menue=16
..
.set trans -
.formula xaktzeile   = M|aktzeile
.formula xaktvorgang = xvorgang
..**ok,05.01.2005 (PrÅfung von Doppeleintrag ist NEU)
.select screen header
!LOOP
.select screen line
.continue ENDE ? _mehr
.continue M2          ?  M|aktzeile = xaktzeile & 'xaktvorgang'="VKRE"   & klnum^gruppe=2
.continue M4          ?  M|aktzeile = xaktzeile & 'xaktvorgang'="VKRE"   & klnum^gruppe=1
.continue M3          ?  M|aktzeile = xaktzeile & 'xaktvorgang'/"VKAUV*" & klnum^gruppe=1
..**ok,16.05.2006 (die PrÅfung bei VKAUE/ORDERS wurde rausgenommen)
.continue M3          ?  M|aktzeile = xaktzeile & 'xaktvorgang'/"VKEDL*" & klnum^gruppe=1
.continue LOOP        ?  M|aktzeile = xaktzeile
.continue M1          ? 'M|vorgang'<<"-" = 'xaktvorgang'<<"-"
.continue LOOP
..
!M1
.box Fehler
Diese Nachricht ist bereits eingetragen!
Die neue Zeile wird entfernt!
.select screen line 'xaktzeile'
.make screen line -
.end
!M2
.box Fehler
Diese Nachricht ist nur im Debitor-Kunden erlaubt!
Die neue Zeile wird entfernt!
.select screen line 'xaktzeile'
.make screen line -
.end
!M3
.box Fehler
Diese Nachricht ist nur im Kontakt erlaubt!
Die neue Zeile wird entfernt!
.select screen line 'xaktzeile'
.make screen line -
.end
!M4
.box Meldung
Bei dieser Nachricht mÅssen die Parameter fÅr Sendedatum ausgefÅllt werden!
Bitte, fÅllen Sie die zugehîrige Felder in der Zeilenlupe aus!
.cursor turnus 'M|aktzeile'
!ENDE
.select screen line 'xaktzeile'
.formula M|vorgang = xaktvorgang
.end
.. end of FOP.138.VORGANG.MENUE
