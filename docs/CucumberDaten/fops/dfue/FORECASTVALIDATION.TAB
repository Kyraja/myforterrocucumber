..!interpreter english translate noabbrev
..!meta M|=dfue/FORECASTVALIDATION
..*****************************************************************************
.. Name           : FORECASTVALIDATION.TAB
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.make screen line +O
.. 
.formula M|tedi = H|id
.copy M|tedinachr = H|edinachr
.assign M|tauftrag = 'F|formatstr("$,,;ktyp=(SalesOrder);nummer=={1};@ablageart=(Both)",  H|ideksvor)' 
.assign M|tauftrag = 'F|formatstr("$,,;ktyp=(SalesOrder);ident=={1};erfass<={2};@ablageart=(Both)",  M|tedi^nummer, M|kerfassbis)' ? F|empty(M|tauftrag)
.formula M|tkunde = M|tauftrag^kunde^id
.formula M|tediconfig = M|tkunde^edinfosnr^id 
.formula M|tkunde2 = M|tauftrag^kunde2^id
.. 
..*****************************************************************************
!END
.continue
