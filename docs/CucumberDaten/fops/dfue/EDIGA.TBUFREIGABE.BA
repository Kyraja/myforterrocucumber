..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIGA.DO.RELEASE
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Mark delivery note item or invoice item as "released" for 
..                  credit note process, - 
..                  Done on manual action by user (button)!
..                  An item is "released" for further processing, if field 
..                  (ev)ganr contains the credit note number.
..*****************************************************************************
..!meta M|=dfue/EDIGA
.set trans -
..
.type P3:2 xvpos ? _F|defined(U|xvpos)
.type integer xi ? _F|defined(U|xi)
.. 
.. Must have credit note number!
.continue END ? F|empty(M|tganr)
..
.. Nothing to do for this row
.continue END ? F|empty(M|tlieferposition)
..
.. Credit note has alreaedy been "released"
.continue END ? M|tganr=M|tliganr & M|tganr=M|treganr
.continue END ? M|tganr=M|tliganr & F|empty(M|treposition)
.continue ENDPACK ? M|tganr=M|tliganr 
.. 
..
.. Release packing slip item
.copy M|tlifreigabe = G|true
.copy M|tliganr = M|tganr
.. 
.formula U|xi = 0
!NPACK
.formula U|xi = U|xi + 1
.continue ENDPACK ? U|xi > 10
.copy U|xvpos = M|ttlipos.xi
.continue ENDPACK ? F|empty(U|xvpos)
.select lock nowait sales 'U|xvpos^id'
.continue ENDPACK ? _G|mehr
.continue ENDPACK ? _G|gesperrt
.copy H|ganr = M|tganr
.rewrite
.continue NPACK
!ENDPACK
.. 
.. 
.. Release invoice item
.copy M|trefreigabe = G|true
.copy M|treganr = M|tganr
.. 
.formula U|xi = 0
!NINV
.formula U|xi = U|xi + 1
.copy U|xvpos = M|ttrepos.xi
.continue ENDINV ? F|empty(U|xvpos)
.select lock nowait sales 'U|xvpos^id'
.continue ENDINV ? _G|mehr
.continue ENDINV ? _G|gesperrt
.copy H|ganr = M|tganr
.rewrite
.continue NPACK
!ENDINV
.. 
..*****************************************************************************
!END
.continue
