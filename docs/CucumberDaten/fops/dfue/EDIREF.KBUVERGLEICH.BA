..!interpreter english translate noabbrev
..!meta M|=dfue/EDIREF
..*****************************************************************************
.. Name           : EDIREF.KBUVERGLEICH.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Compare two reference data sets
..*****************************************************************************
.set trans -
.. 
.continue END ? F|empty(M|edinr2)
.continue END ? M|tzeilen = 0
.. 
.type text satzart ? _F|defined(U|satzart)
.type text xtext7 ? _F|defined(U|xtext7)
.type text xtext8 ? _F|defined(U|xtext8)
.type text xtext9 ? _F|defined(U|xtext9)
.type integer xi ? _F|defined(U|xi)
.. 
.select screen header 
.select edifact 'M|edinr2^id'
.continue END ? _G|mehr
!NEXT
.select screen line
.select line
.continue END ? _G|mehr
.formula U|satzart = F|trim(H|text1 << 4)
.continue NEXT ? F|empty(U|satzart)
.continue ERROR1 ? U|satzart<>M|tsabez
.input "EDIREF.VERGLEICH.TAB"
.continue NEXT
.. 
..*****************************************************************************
!END
.continue
.. 
.. 
!ERROR1
.error Die beiden Referenzdatens„tze haben unterschiedliche Satzarten.
.end 1
