..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIRAH.BSTART.BN
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Count blanket orders in table
..*****************************************************************************
.set trans -
..
.. Initialize Counters
.copy M|kanzrahmen = 0
.copy M|kanzrahmengueltig = 0
.copy M|kanzrahmenmitabruf = 0
..
..
.. Count blanket orders / check valid until / count forecasts
.continue END ? M|tzeilen = 0
.select screen header
!NEXT
.select screen line
.continue END ? _G|mehr
.formula M|kanzrahmen = M|kanzrahmen +1  ? _F|empty(M|rahmen)
.formula M|kanzrahmengueltig = M|kanzrahmengueltig +1  ?  M|tterm >= G|datum
.formula M|kanzrahmenmitabruf = M|kanzrahmenmitabruf +1  ? _F|empty(M|labediid)
.continue NEXT
..
..*****************************************************************************
!END
.continue
