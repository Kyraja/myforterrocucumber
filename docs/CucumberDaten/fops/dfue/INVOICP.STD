..
.formula xGeldBetr1 = h|nwert - h|pwert
.formula xGeldBetr2 = 'xGeldBetr1'
.formula xGeldBetrQ = "131"
..
!EL029
.. FI029
..
!FI028
..
.. Satzart 223
..**ok,14.04.2003 (bei Gutschriften xBelegart = "381" werden bei BetrÑgen und Mengen kein Minus-Zeichen verwendet)
.formula xPosWGPreis = 'xPosWGPreis' << -1  ? xBelegart = "381" & ('xPosWGPreis' << 1) = "-"
..
.formula xGeldBetr2  = 'xGeldBetr2'  << -1  ? xBelegart = "381" & ('xGeldBetr2' << 1) = "-"
..
223 # 01 # # # # # # # # # #'xPosWGPreis'# # 'xPosZAQ' # # # # # # # 'xGeldBetrQ' # 'xGeldBetr2' # # # 'xLfdNr' #
