.. Kontrolle      :
.. Funktion       : Event Efop des Infosystem EDIGA
.. Functionality  : Central eventhandling for infosystem EDIGA
..*****************************************************************************
..!meta M|=dfue/EDIGA
.set trans -
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ? evtartengl="FIELD_EXIT"    & evtvar="kganum"
.continue INIT    ? evtartengl="FIELD_EXIT"    & evtvar="edivon"
.continue INIT    ? evtartengl="FIELD_EXIT"    & evtvar="edibis"
.continue INIT    ? evtartengl="FIELD_EXIT"    & evtvar="kunde"
.continue DAT     ? evtartengl="FIELD_EXIT"    & evtvar="dvon"
.continue INIT    ? evtartengl="FIELD_EXIT"    & evtvar="dbis"
.. ----------- ---------- ---------- -------------------------------------------
.. row operation is blocked with is/VERBOTEN
.. ----------- ---------- ---------- -------------------------------------------
.continue
..
!DAT
.formula M|dbis = M|dvon
.continue INIT
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..
..*****************************************************************************
!END
.continue
