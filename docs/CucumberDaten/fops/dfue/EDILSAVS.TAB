..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDILSAVS.TAB
.. Autor          : tg
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Add rows to info system table
..*****************************************************************************
.set trans -
..
.type text  xtsel      ? _defined(xtsel)
.type text  xtlief     ? _defined(xtlief)
.type text  xtlwerk    ? _defined(xtlwerk)
.type text  xtlsnummer ? _defined(tlsnummer)
.type text  xtlablade  ? _defined(xtlablade)
.type text  xtarta     ? _defined(xtarta)
.type text  xtkopf     ? _defined(xtkopf)
.type text  xtart      ? _defined(xtart)
.type bool  xbfirst    ? _defined(xbfirst)
.type bool  xbeok      ? _defined(xbeok)
.type bool  xbmehr     ? _defined(xbmehr)
.type P4:22 tbenummer  ? _defined(tbenummer)
.type text  tmerkbenum ? _defined(tmerkbenum)
.type text  xtschl     ? _defined(xtschl)
.type real  xlimge     ? _defined(xlimge)
.type real  xrtmge     ? _defined(xrtmge)
.type real  xrtmp      ? _defined(xrtmp)
.type integer xi1      ? _defined(xi1)
.type integer xi2      ? _defined(xi2)
.type integer xiz      ? _defined(xiz)
.type integer xil      ? _defined(xil)
.type GD2   xdtlterm   ? _defined(xdtlterm)
..
..
.formula T|xtlief     = ""
.formula T|xtlwerk    = ""
.formula T|xtlsnummer = ""
.formula T|xbfirst    = false
.formula T|xbeok      = false
.formula T|xrtmge     = 0
.formula T|xil        = 0
.formula T|tmerkbenum = ""
.formula T|xtsel      = ""
..
!ZEILE.KOPF
.select line
.continue ENDE          ? _mehr
.make screen line +O ? H|text1     = "RFH1"
.continue LIN           ? H|text1     = "LIN1"
.formula   T|xbfirst     = true        ?  H|text1 = "SUP1"
.formula   M|tlsnummer = H|text7     ? H|text1 = "RFH1"
.assign M|tlief     = H|text4     ? H|text1 = "SUP1"
.set trans +
.formula   M|thinweis  = "Lieferant" + " " + 'H|text4' + " " + " nicht vorhanden !" ? _mehr
.set trans -
.formula   M|zicon     = G|icocrit   ? _G|mehr
.formula   M|tlwerk    = H|text6     ? H|text1 = "SUP1"
.formula   M|tlablade  = H|text7     ? H|text1 = "SUP1"
.formula   T|xtlief      = M|tlief   ? mehr & H|text1 = "SUP1"
.formula   T|xtlwerk   = M|tlwerk    ? mehr & H|text1 = "SUP1"
.formula   T|xtlablade = M|tlablade  ? mehr & H|text1 = "SUP1"
.formula   T|xtlsnummer= M|tlsnummer ? mehr & H|text1 = "RFH1"
.formula   M|edident   = H|nummer    ? H|text1 = "RFH1"
.assign T|tbenummer = H|text7     ? H|text1 = "RFH2"
.formula   T|xbeok       = true      ? mehr & H|text1 = "RFH2"
.formula   T|tmerkbenum= H|text7     ? H|text1 = "RFH2"
.set trans +
.formula   M|thinweis  = M|thinweis + "Es wurde keine Bestellnummer Åbermittelt"                                        ? H|text1 = "RFH2" & 'H|text7' = ""
.set trans -
.formula   M|zicon     = G|icokrit                                                                                      ? H|text1 = "RFH2" & 'H|text7' = ""
.set trans +
.formula   M|thinweis  = M|thinweis + "Bestellung" + " " + 'T|tmerkbenum' + " " + " nicht vorhanden oder abgelegt !"    ? _T|xbeok & H|text1 = "RFH2"
.set trans -
.formula   M|zicon     = G|icokrit                                                                                      ? _T|xbeok & H|text1 = "RFH2"
.assign M|tkbenum   = T|tmerkbenum                                                                                   ?  T|xbeok & H|text1 = "RFH2"
.set trans +
.formula   M|thinweis  = M|thinweis + ";öbermittelte Bestellung mit der Nummer " + 'T|tmerkbenum' + " " + "vorhanden !" ?  T|xbeok & H|text1 = "RFH2"
.set trans -
.continue ZEILE.KOPF
..
!LIN
.select line
.continue ENDE                                  ? _mehr
.make screen line +O                          ? H|text1 = "LIN1"
.formula M|edident = H|id
.formula M|tlief     = T|xtlief
..formel M|tlsnummer = T|xtlsnummer
.formula   T|xbfirst
.assign M|tlterm      = H|text13 ? H|text1 = "RFL1"
.formula   T|xdtlterm    = M|tlterm ? mehr    & H|text1 = "RFL1"
.set trans +
.formula   M|thinweis    = "Datum" + " " + 'H|text13' + " " + "ist nicht korrekt"  ? _mehr & H|text1 = "RFL1"
.set trans -
.formula   M|zicon       = G|icokrit                                               ? _mehr & H|text1 = "RFL1"
.continue ART             ? H|text1 = "ART1"
.continue QTY1            ? H|text1 = "QTY1"
.continue PAC             ? H|text1 = "PAC1" & M|mitpack
.continue LIN
..
!ART
.assign M|tart = H|text5
.formula M|tnamebspr = M|tart^namebspr
.formula T|xbmehr = mehr
.formula T|xtart = 'M|tart'                                                      ?  T|xbmehr
.formula   M|zicon    = G|icokrit                                                ? _T|xbmehr ; _T|xbeok
.set trans +
.formula   M|thinweis = "Artikel" + " " + 'H|text5' + " " + " nicht vorhanden !" ? _T|xbmehr
.set trans -
..
..Selektionsstring fÅr spÑtere Suche im Dialog
.formula T|xtsel     = ""
.formula T|xtkopf    = "$,,;@gruppe=2;kopf=" + 'T|tmerkbenum'                             ?  T|xbeok
.formula T|xtkopf    = "$,,;@gruppe=2;kopf="                                              ? _T|xbeok
.formula T|xtsel = T|xtsel + T|xtkopf + ";kopf^lief=" + 'M|tlief' +  ";kopf^abschlnr=" + 'M|abschlnr' + ";kopf^lztabruf=" + 'M|abrufnr'
.formula T|xtsel = T|xtsel + ";art=" + 'M|tart' + ";mge=;limge=;lifrg=" + ";lirelev=true;" + "ablagef=false"
.formula M|tbesuchstrg = 'xtsel'
.formula M|tbesuchstrg = M|tbesuchstrg<<-1
.formula M|tbesuchstrg = "%" + M|tbesuchstrg
..
..Keine Suche nach Bestellung wenn nicht Åbermittelt
.continue LIN                                                                                   ? _T|xbeok
.load 0 purchasing 'xtsel'
.formula T|xbmehr = mehr
.set trans +
.formula M|thinweis  = M|thinweis + ";öbermittelte Bestellung konnte nicht selektiert werden"  ? _xbmehr
.formula M|thinweis  = M|thinweis + ";Selektionskriterien: " + 'xtsel'                         ? _T|xbmehr
.formula   M|zicon   = G|icokrit                                                               ? _T|xbmehr
.set trans -
.continue LIN                                                                                   ? _T|xbmehr
.formula M|tpos      = '0|pnum'
.formula T|xlimge    =  0|limge ? _M|inkllsre
.formula T|xlimge    =  0|limge - 0|lifrg ? M|inkllsre
.formula M|tofmge    =  T|xlimge
.formula M|tbemge    =  0|mge
.formula M|term      =  0|tterm
.formula M|posid     =  0|id
..
.continue LIN
..
!QTY1
.assign M|tmge    = H|text9  ? H|text1 = "QTY1"
.formula   T|xrtmge  = H|text9  ? H|text1 = "QTY1"
.set trans +
.formula M|thinweis  = M|thinweis + ";Die avisierte Menge" + " " + 'T|xrtmge' + " "                      ? T|xlimge <> T|xrtmge & T|xbmehr
.formula M|thinweis  = M|thinweis + ";weicht von der offenen Bestellmenge" + ";" + 'xlimge' + " " + "ab" ? T|xlimge <> T|xrtmge & T|xbmehr
.set trans -
.formula   M|zicon   = G|icovkrit                                                                        ? T|xlimge <> T|xrtmge & T|xbmehr & T|xbeok
..
.assign M|tkbenum   = T|tmerkbenum                                                                    ?  T|xbeok
.formula   M|tlsnummer = T|xtlsnummer
..
..Neue Position bei öberlieferung, nur vorschlagen wenn Åbermittelte Bestellung vorhanden
.continue LIN ? _M|buebl ; T|xrtmge <= T|xlimge ; _T|xbeok
..
.. Liefermenge in aktueller Position verringern
.formula M|tmge = M|tmge - (T|xrtmge - T|xlimge)
.make screen line +O
.formula T|xrtmp = T|xrtmge - T|xlimge
.set trans +
.formula M|thinweis  = M|thinweis + ";Neuer Lieferschein wegen Mengendiffernz vorgeschlagen"
.formula M|thinweis  = M|thinweis + ";Lieferscheinmenge: " + 'T|xrtmge' + "  - " + 'T|xlimge' + " " + "=" + " " + 'T|xrtmp'
.set trans -
.formula M|tkbenum   = T|tmerkbenum
.formula M|tlterm    = T|xdtlterm
.formula M|tart      = T|xtart
.formula M|tnamebspr = M|tart^namebspr
.formula M|tmge      = T|xrtmp
.formula T|xil       = T|xil + 1
.formula M|tlsnummer = 'T|xtlsnummer' + "." + 'xil'
.continue LIN
..
!PAC
.continue PAC.ZEILE         ? H|text1 = "PRI1"
.formula T|xi1 = T|xi1 + 1 ? H|text1 = "PAC1"
.formula T|xi2 = T|xi2 + 1 ? H|text1 = "PAC2"
..
.type text xpa1.xi1  ? _defined(xpa1.xi1)
.type text xpmf1.xi2 ? _defined(xpmf1.xi2)
.type text xpma1.xi1 ? _defined(xpma1.xi1)
..
.formula T|xpa1.xi1  =  H|text4   ? H|text1 = "PAC1"
.formula T|xpmf1.xi2 =  H|text4   ? H|text1 = "PAC2"
.formula T|xpma1.xi1 = 'H|text14' ? H|text1 = "PAC1"
.select line
.continue PAC
..
!PAC.ZEILE
.continue LIN ? T|xiz = T|xi1
.make screen line +O
.protection tzu 'M|aktzeile'
.formula M|edident   = H|id
.formula M|tlief     = T|xtlief
.formula M|tkbenum   = T|tmerkbenum
.formula M|tlsnummer = T|xtlsnummer
.formula T|xiz       = T|xiz + 1
.formula M|tart      = T|xpa1.xiz
.formula M|tnamebspr = M|tart^namebspr
.formula M|fuelmge   = T|xpmf1.xiz
.formula M|tmge      = 'T|xpma1.xiz'
.continue PAC.ZEILE
..
!ENDE
.continue
