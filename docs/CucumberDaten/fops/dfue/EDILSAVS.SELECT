..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDILSAVS.SELECT
.. Autor          : tg
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Query edi messages
..*****************************************************************************
.set trans -
..
.input "is/TABLEEREN"
.formula M|select = "$,,;@gruppe=0;nummer="  + 'M|edinr' + "!"  + 'M|edinrbis' + ";such=EKAVS;edinachr=2108"
.formula M|select = M|select + ";status=2!3" + ";erfass=" + 'M|dvon' + "!" + 'M|dbis' + ";idabkunde=" + 'M|kliefnr'
.formula M|select = M|select + ";@ordnung=nummer.(Backwards)"
.note  'M|select'
.select edifact 'M|select'
!LOOP
.continue      ? _mehr
.input 'M|tab' ? 'M|tab'<>""
.select edifact
.continue LOOP
..
..*****************************************************************************
!ENDE
.error
.end 1
