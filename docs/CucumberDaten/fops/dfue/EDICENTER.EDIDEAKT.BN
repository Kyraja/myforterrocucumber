..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDICENTER.EDIDEAKT.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Deaktivieren einer EDI-Nachricht
.. Functionality  : deaktivate an edi message
..*****************************************************************************
.set trans -
..
.. nothing to do, edi message is deactivated
.continue END     ?  M|status = -9
..
.select lock edifact 'M|edinr^id'
.continue ERREDI  ? _T|mehr
..
.. To deaktivate always set state -9
.formula H|status = -9       ?  M|edinr^vorart <> 0
.formula H|status =  3       ?  M|edinr^vorart =  0
.formula H|edistatusaz = "(Deactivated)" 
.formula H|fcode  =  0
.rewrite
.continue ERRBRI  ? _T|mehr
..
.. Update infosystem table
.formula M|status = H|status
.formula M|fcode  = H|fcode
.formula M|fotoz  = "icon:ball_grey"     ?  H|status = -9
.formula M|fotoz  = "icon:stop"          ?  H|status =  3
..*****************************************************************************
!END
.continue
..
..
!ERREDI: could not read edi msg with lock
.error Fehler beim Sperren der Nachricht! Die Nachricht wurde nicht deaktiviert.
.end 1
..
!ERRBRI: error when updating edi message
.error Das Deaktivieren der Nachricht ist fehlgeschlagen!
.end 1
