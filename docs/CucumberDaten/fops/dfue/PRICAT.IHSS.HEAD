..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.IHSS.HEAD
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Construct message ABPRICAT
.. 
..  1       UNBI Muss    1  Dateiuebertragungs-Info 
..  1       UNHI Muss    1  Nachrichten-Info 
..  1       BGMI Muss    1  Vorgangs-Info 
..  1       DAH1 Muss    1  Datum-Info fuer Kopfdaten 
..  1       SUP1 Muss    1  Lieferanten-Info 
..  1       SUP2 Kann    1  Lieferanten-Info 
..  1       BUY1 Muss    1  Kunden-Info 
..  1       BUY2 Kann    1  Kunden-Info 
..  1       MFA1 Kann    1  Hersteller-Info 
..  1       MFA2 Kann    1  Hersteller-Info 
..
..*****************************************************************************
.set trans - 
..
.type text xtversion1 ? _F|defined(U|xtversion1)
.formula U|xtversion1 = "01"
..
.type text xUNBI
.type text xUNHI
.type text xBGMI
.type text xDAH1
.type text xSUP1
.type text xSUP2
.type text xBUY1
.type text xBUY2
.type text xMFA1
.type text xMFA2
..
.formula U|xUNBI = "UNBI"
.formula U|xUNHI = "UNHI"
.formula U|xBGMI = "BGMI"
.formula U|xDAH1 = "DAH1"
.formula U|xSUP1 = "SUP1"
.formula U|xSUP2 = "SUP2"
.formula U|xBUY1 = "BUY1"
.formula U|xBUY2 = "BUY2"
.formula U|xMFA1 = "MFA1"
.formula U|xMFA2 = "MFA2"
..
.. UNHI data
.type text xtntyp
.type text xversfrgnr
.type text xbelegart
.type text xverworg
.. 
.formula U|xtntyp = "PRICAT"
.formula U|xversfrgnr = "D 96B"
.formula U|xbelegart = "9"
.formula U|xverworg = "UN"
..
.. BGMI data
.type text xdatum
.type text xfunktion
.. 
.formula U|xdatum = G|datum:8
.formula U|xfunktion = "9"
..
.. DAH1 data
.type text xrefdat1
.type text xrefdat2
.. 
.formula U|xrefdat1 = M|datvom:8
.formula U|xrefdat2 = M|datbis:8
.. 
.. Supplier
..!meta 1|=P12:10
.load 1 company 'F|sysinfo(10)'
..
.. Buyer
..!meta 2|=P0:1
.load 2 customer 'M|kunde^id'
..
.output new 'M|dateiname'
.input "DATEI.F"
'U|xUNBI'#'U|xtversion1'#'1|gln'###'2|gln'####################
'U|xUNHI'#'U|xtversion1'##'U|xtntyp'#'U|xversfrgnr'#'U|xbelegart'#'U|xverworg'###################
'U|xBGMI'#'U|xtversion1'##'U|xdatum'#'U|xfunktion'#####################
'U|xDAH1'#'U|xtversion1'###'U|xrefdat1'#'U|xrefdat2'####################
'U|xSUP1'#'U|xtversion1'#'1|gln'#'2|frbez'######################
.. 'U|xSUP2'#'U|xtversion1'########################
'U|xBUY1'#'U|xtversion1'#'2|gln'#'2|nummer'#####'2|ustid'#'2|funktion'################
.. 'U|xBUY2'#'U|xtversion1'########################
.. 'U|xMFA1'#'U|xtversion1'########################
.. 'U|xMFA2'#'U|xtversion1'########################
.output
..
.load 1
.load 2
..  
..*****************************************************************************
!END
.continue
