..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIEINTR.TAB
.. Autor          : mh/tg/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Zeilen-FOP EDIEINTR
.. Functionality  : row efop EDIEINTR
..*****************************************************************************
.set trans -
..
.input "is/ABASFARBEN.DEF"  ? _F|defined(xabasred)
.type text xaktfarbe  ? _F|defined(U|xaktfarbe)
.formula U|xaktfarbe = ""                ? U|xaktfarbe = U|xabasgrouplight
.formula U|xaktfarbe = U|xabasgrouplight  ? U|xaktfarbe = U|xabasgroupdark
.formula U|xaktfarbe = U|xabasgroupdark ? U|xaktfarbe = ""
..
.. Avoid empty row sfor supplier/vendor if "with edi" check box is marked
.continue END ? H|ozeilen=0 & M|minfo
.continue END ? H|ozeilen=0 & M|liefminfo
..
.make screen line +O
.colour -foreground 'T|xabasblack' -background 'T|xaktfarbe' 'M|aktzeile'
.formula M|tkdnummer  = H|klnum^id     ?   M|minfo;M|liefminfo
.formula M|tkdnummer  = H|id           ? _(M|minfo;M|liefminfo)
..
.continue EROWS   ?  M|oinfo;M|liefoinfo
.continue DAZU    ?  M|ainfo;M|liefainfo
.continue FIRST   ?  M|minfo;M|liefminfo
..
!DAZU: read edi-info object if not yet read
.select add edinfosnr
.continue EROWS   ? _G|mehr
..
!FIRST
.select line
.continue EROWS   ? _G|mehr
!ROWS
.formula M|tkdnummer  = H|klnum^id
.copy M|tedinachraz= H|edinachraz
.copy M|tabmodell     = H|abmodell
.copy M|tieabmodell   = H|ieabmodell
.copy M|tzuoschema    = H|zuoschema
.formula M|tvorgang   = H|tvorgang
.formula M|taktiv     = H|erlaubt
.formula M|tprotokoll = H|protokoll  ?  _F|empty(H|protokoll)
.formula M|tintedi    = H|intedi
.formula M|textedi    = H|extedi
..
.. read next row
.. adding new rows is done here to avoid empty rows
.select line
.continue EROWS   ? _G|mehr
.make screen line +O
.colour -foreground 'T|xabasblack' -background 'T|xaktfarbe' 'M|aktzeile'
.continue ROWS
!EROWS
..
.. clear "dazu" buffer
.select add              ?  M|oinfo ; M|ainfo ; M|liefoinfo ; M|liefainfo
..*****************************************************************************
!END
.continue
