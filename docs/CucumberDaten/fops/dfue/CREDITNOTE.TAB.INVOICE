..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CREDITNOTE.TAB.INVOICE
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Add information from invoice 
..*****************************************************************************
..!meta M|=dfue/CREDITNOTE
.set trans -
..
.type integer xipos ? _F|defined(U|xipos) 
.continue ERRPOS ? U|xipos < 1 ; U|xipos > 9
.. 
..!meta H|=P3:2
.formula M|treposition = H|id
.copy M|treganr = H|ganr
.copy M|tremengeneinheit = H|he
.. 
.formula M|ttrepos.xipos = H|id
.copy M|ttrepreis.xipos = H|preis
.copy M|ttremge.xipos = H|mge
.copy M|ttrepwert.xipos = H|pwert
..
.. Sum quantities and value, show average price
.formula M|trepreis = H|preis ? U|xipos = 1
.formula M|trepreis = ( M|tremge * M|trepreis + H|mge * H|preis ) / (M|tremge + H|mge) ? H|preis<>M|trepreis
.formula M|tremge = M|tremge + H|mge
.formula M|trepwert = M|trepwert + H|pwert
..  
.. .formula M|trepossteuer = ?
.. .formula M|trepossteuersatz ?
.. 
.add H|kopf
..!meta H|=P3:1
.formula M|trechnung = D|id
.copy M|trewaehrung = D|land
.formula M|krechnung = D|id
.formula M|kresum = D|sumnetto
.formula M|krebetr = D|rebetr
.copy M|krewaehrung = D|land
.add
..
.. Only one invoice item ;)
.copy M|tbelegmoeglich = G|false ? _F|empty(M|treposition)
.. 
.. set invoice item as released, if its credit note number matches   
.copy M|trefreigabe = G|true ? M|treganr = M|tganr

..*****************************************************************************
!END
.continue
.. 
.. 
!ERRPOS
.error Zu einer Gutschriftenposition wurden sehr viele Rechnungspositionen ermittelt!
.end 1
