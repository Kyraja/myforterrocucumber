..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.EXECUTE.SINGLEFOP
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Excecute a single fop from the configuration
..*****************************************************************************
..
.set trans -
..
.type text    xtindex       ? _F|defined(U|xtindex)
.type text    xtfop         ? _F|defined(U|xtfop)
.type integer xstatus       ? _F|defined(U|xstatus)
.type integer xfcode        ? _F|defined(U|xfcode)
.type text    xtfehler      ? _F|defined(U|xtfehler)
.type bool    xbpreisausedi ? _F|defined(U|xbpreisausedi)
.type bool    xbsingle      ? _F|defined(U|xbsingle)
.type integer xaktzeile     ? _F|defined(U|xaktzeile)
..
.formula U|xtfehler = "rmtmp/X.ERR." + pid + 'M|edifact' + ".TMP"
.formula U|xstatus = 0
.formula U|xfcode  = 0
.formula U|xbpreisausedi = M|preisausedi
.formula U|xbsingle = G|true
..
.input "is/ABASFARBEN.DEF"
..
..Find configuration for partner in edi message
.input "EDIOBJECTSEARCH.GET.CONFIGURATION" ? F|empty(M|suchkonfig)
..
.assign U|xtindex = 'G|evtvar' >$ "ausfuehren"
.continue HEAD  ?  U|xbinhead
.continue TABLE ? _U|xbinhead
..
!HEAD
.select screen header
.continue FOP
..
!TABLE
.formula U|xaktzeile = M|aktzeile
.select screen line 'U|xaktzeile'
.continue FOP
..
!FOP
.formula U|xtfop = M|fop.xtindex
..
..no fop available
.continue END ? F|empty(U|xtfop)
..
..Load edi message into H buffer
.select nolock edifact 'M|edifact'
..
.input 'U|xtfop'
..
..*****************************************************************************
!END
..release buffer
.select
.continue
