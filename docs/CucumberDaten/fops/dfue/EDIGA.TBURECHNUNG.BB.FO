..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIGA.TBURECHNUNG.BB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  :
..*****************************************************************************
.set trans -
..
..<META M|='dfue/EDIGA' >
..<META H|='P3:2' >
..
.continue END ? _M|tbelegmoeglich
.continue END ?  F|empty(M|tbeleg)
.continue END ?  F|empty(M|tganr)
.continue END ?  F|empty(M|tartikel)
..
.type text U|queryInvoiceItem
.formula U|queryInvoiceItem = "$,,;@gruppe=2;@ablageart=(Both);kotyp=(Invoice)"
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";orig=" + M|tbeleg^id
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";ganr=" + M|tganr
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";artex=" + M|tartikel^id
.select nolock sales 'U|queryInvoiceItem'
.continue END ? _G|mehr
..
..
.type IP9 currentRow ? _F|defined(U|currentRow)
.type P53 edinr ? _F|defined(U|edinr)
.type P3:1 rechnr ? _F|defined(U|rechnr)
..
.copy U|currentRow = M|aktzeile
.copy U|edinr = M|tedinr
.copy U|rechnr = H|kopf
..
.box Rechnung bereits vorhanden
'F|formatstr("Zu Gutschriftenanzeige {1} ist bereits die Rechnung {2} erstellt worden.", M|tganr, U|rechnr)'
..
.select screen header
!REFRESH
.select screen line
.continue LINE ? _G|mehr
.continue REFRESH ? M|tedinr <> U|edinr
.copy M|tbelegmoeglich = G|false
.copy M|rechnr =  U|rechnr
.continue REFRESH
!LINE
.select screen line U|currentRow
.. 
..*****************************************************************************
!END
.continue
