.. FI049
..
..>> Test, ob nicht Vorschaumenge
..
..
.continue EL050 ? _(xtxtttermprv <> "999999")
.. IF050
..>> Erhîhen vorige Gesamtmenge
.formula xzmgeactges = xzmgeactges + xzmgeprv
..
!EL050
.. FI050
..
.formula xzeinfzahlact = xzmgeactges
.formula xz5 = 'xzeinfzahlprv:0'
..
!FI042
..
..??    xzmgedif
.formula xzx = xzmgeact - xzmgeprv
.formula xz6 = 'xzx:0'
..??    xzeinfzahldif
.formula xzx = xzeinfzahlact - xzeinfzahlprv
.formula xz7 = 'xzx:0'
..>>
..>> nÑchste Zeile ist:
..>> ==================
..>> - erste Zeile von einem Zeilen-Paar fÅr vorigen und aktuellen Lieferabruf
..>> oder
..>> - einzelne Zeile fÅr vorigen oder aktuellen Lieferabruf
..>>
..>> ==>> Leeren aktuelle Parameter
..>>
..>> EDI-Identnummer vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzedinumact = ""
..>> Kunden-Fortschrittszahl vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzeinfzahlact = 0
..>> Abruftermin vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttermact = ""
..>> Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeact = 0
..
!FI036
..
!FI030
..
..>> Ausgabe
..         Termin                                   Alte Liefereinteilung         Neue Liefereinteilung             Differenz
..oche   Berechnet  Beschreibung                  Menge     offen   Endzahl     Menge      offen   Endzahl      Menge     Endzahl
..-------------------------------------------------------------------------------------------------------------------------------
..-----+-----------+-------------------------+---------+---------+---------++---------+---------+---------++---------+-+---------
 '   xz1'   'xptext                 ' '    xz2' '    xz8' '     xz3' '    xz4' '    xz9' '     xz5' '    xz6'   '    xz7'
..
!EL029
.. FI029
..
.. >> vorige Parameter gleich aktuelle Parameter
..>> EDI-Identnummer vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzedinumprv = xzedinumact
..>> Kunden-Fortschrittszahl vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzeinfzahlprv = xzeinfzahlact
..>> Abruftermin vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzttermprv = xzttermact
..>> Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xzmgeprv = xzmgeact
..>> Abrufzeitraum vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xptextprv = xptextact
..>> Abruftermin (Sicherung, Text) vorige Zeile aus temporÑrer Differenz-Report-Datei
.formula xtxtttermprv = xtxtttermact
..
.continue REPT002 ? _(_(mehr))
