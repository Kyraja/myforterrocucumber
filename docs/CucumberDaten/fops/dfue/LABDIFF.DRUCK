..>> Bezeichnung Rahmenauftrag
.type text       xnaeksrah
..>> Bezeichnung Auftrag
.type text       xnaeksvor
..>> Name der temporÑren Differenz-Report-Datei
.type text       xndiffreptemp
..>> Name der temporÑren Differenz-Report-Datei (Sort)
.type text       xndiffreptemp1
..>> Erfolg Operation
.type bool       xprocreturn
..>> Abrufzeitraum
.type text       xptext
..>> Abrufzeitraum aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type text       xptextact
..>> Abrufzeitraum vorige Zeile aus temporÑrer Differenz-Report-Datei
.type text       xptextprv
..>> RÅckstand (xrÅckst.xsaveerw)
.type realx      xrÅckstact
.type realx      xrÅckstprv
..>> Endung Variable fÅr Speicherung RÅckstand, Gesamt
.type text       xsaveerw
..>> Suchwort Artikel
.type text       xsueksart
..>> Suchwort Rahmenauftrag
.type text       xsueksrah
..>> Suchwort Auftrag
.type text       xsueksvor
..>> Abruftermin (Woche)
.type week      xterm
..>> Abruftermin (Datum)
.type date      xtterm
.type date      xtterm0
..>> spÑtester Abruftermin des Abrufs
.type date      xttermlast
..>> Abrufdatum Wochentag
.type integer    xttermwt
..>> Abruftermin (Sicherung, Text)
.type text       xtxttterm
..>> Abruftermin (Sicherung, Text) aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type text       xtxtttermact
..>> Abruftermin (Sicherung, Text) vorige Zeile aus temporÑrer Differenz-Report-Datei
.type text       xtxtttermprv
..>> VerwendungsschlÅssel
.type text       xverwschl
..>> 1. SuchschlÅssel Verkauf
.type text       xvksuchschluessel1
..>> Variablen fÅr Ausgabeformatierung
.type text xw xz1 xz2 xz3 xz4 xz5 xz6 xz7 xz8 xz9
.type realx xzx
..>> Werk des Kunden
.type text       xwerk
..>> Woche
.type integer    xwoche
..>> EDI-Identnummer aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type text       xzedinumact
..>> EDI-Identnummer vorige Zeile aus temporÑrer Differenz-Report-Datei
.type text       xzedinumprv
..>> Kunden-Fortschrittszahl aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type realx      xzeinfzahlact
..>> Differenz Kunden-Fortschrittszahl aus temporÑrer Differenz-Report-Datei
.type realx      xzeinfzahldif
..>> Kunden-Fortschrittszahl vorige Zeile aus temporÑrer Differenz-Report-Datei
.type realx      xzeinfzahlprv
..>> Abrufmenge aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type realx      xzmgeact
..>> gesamte Abrufmenge aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type realx      xzmgeactges
..>> Differenz Abrufmenge aus temporÑrer Differenz-Report-Datei
.type realx      xzmgedif
..>> Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.type realx      xzmgeprv
..>> gesamte Abrufmenge vorige Zeile aus temporÑrer Differenz-Report-Datei
.type realx      xzmgeprvges
..>> Zeilennnummer Lieferabruf (fÅr Sortierung)
.type integer    xznummer
..>> Abruftermin aktuelle Zeile aus temporÑrer Differenz-Report-Datei
.type date      xzttermact
..>> Abruftermin vorige Zeile aus temporÑrer Differenz-Report-Datei
.type date      xzttermprv
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
..?? folgende Zeile mu· bei Aufruf aus LABDIFF kommentiert werden
..fo xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
..?? folgende Zeile mu· bei Aufruf aus LABDIFF auskommentiert werden
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
.. Prozedur: EKSHoleRahmenInfos
..
!PROC001: ----- EKSHoleRahmenInfos -----
..>> Holen Informationen aus Rahmenauftrag:
..>>
..>> - Suchwort, Name des Auftrags
..>> - Suchwort, Name des Kundenartikels
..>> - Suchwort, Name des Rahmenauftrags
..>> - (Lieferanten-)Fortschrittszahl der ersten Position des Kundenartikels
..>>
..>> Parameter:
..>>
..>> Ein: - Identnummer des Rahmenauftrags (xideksrah)
..>>      - Identnummer der Rahmen-Artikels (xideksart)
..>>      - Kundenartikelnummer (xkuartnr)
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>      - (Lieferanten-)Fortschrittszahl (xfzahl)
..>>      - Suchwort Artikel (xsueksart)
..>>      - Bezeichnung Artikel (xnaeksart)
..>>      - Suchwort Rahmenauftrag (xsueksrah)
..>>      - Bezeichnung Rahmenauftrag (xnaeksrah)
..>>      - Suchwort Auftrag (xsueksvor)
..>>      - Bezeichnung Auftrag (xnaeksvor)
..>>
..>> Interne Variablen: - xistzeile1
..>>                    - xidrahvor
..>>                    - xidrahart
..
..>> Erfolg der Operation
.formula xprocreturn = false
..>> (Lieferanten-)Fortschrittszahl
.formula xfzahl = -1
..
.. >> Ermitteln Kundenartikel-Position in Rahmenauftrag
..>> Test, ob Rahmenauftrag eingetragen
..>>
..
..
.continue EL001 ? _(xideksrah <> "")
.. IF001
.formula xidrahvor = ""
.formula xidrahart = ""
..
.select sales 'xideksrah'
..
..
.continue EL002 ? _(mehr)
.. IF002
.formula xsueksrah = such
.formula xnaeksrah = betreff
.formula xidrahvor = lztabruf
..
.. >> Holen Artikel, wenn vorhanden und Merken Auftrags-Informationen
..
!REPT001: ==============================
.select line
..
.formula xistzeile1 = mehr
..
..
.continue EL003 ? _(mehr)
.. IF003
..
.continue EL004 ? _(typ = arpos)
.. IF004
.add art
..
..
.continue EL005 ? _(mehr)
.. IF005
..
.continue EL006 ? _((num = xideksart) & (kuartnr = xkuartnr))
.. IF006
.formula xsueksart = such
.formula xnaeksart = name
.formula xidrahart = num
..
.add
..
.formula xfzahl = fzahl
..
.formula xprocreturn = true
..
.continue FI006
!EL006
.add
..
!FI006
..
.continue FI005
!EL005
.add
..
!FI005
..
!EL004
.. FI004
..
!EL003
.. FI003
..
.continue REPT001 ? _((_(xistzeile1)) ; (xfzahl <> -1))
..
.. >> Holen Auftrag, wenn vorhanden und Merken Auftrags-Informationen
..>> Test, ob Identnummer des Auftrages in Rahmenauftrag eingetragen
..
..
.continue EL007 ? _(xidrahvor <> "")
.. IF007
.select sales 'xidrahvor'
..
..
.continue EL008 ? _(_(mehr))
.. IF008
.formula xvksuchschluessel1 = "+" + xideksvor + "!" + xideksvor
.select sales 'xvksuchschluessel1'
..
!EL008
.. FI008
..
..
.continue EL009 ? _(mehr)
.. IF009
.formula xsueksvor = such
.formula xnaeksvor = betreff
..
!EL009
.. FI009
..
!EL007
.. FI007
..
!EL002
.. FI002
..
!EL001
.. FI001
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EDIEntschluesselAbrufTermin
..
!PROC002: ----- EDIEntschluesselAbrufTermin -----
..>> EntschlÅsseln Abruftermine aus VDA-SchlÅssel
..>>
..>> Parameter:
..>>
..>> Ein: - verschlÅsselter Abruf-Termin (text4)
..>>      - Abruftermin Lieferabrufdatum neu (xlabrufd)
..>>      - Endung Variable fÅr Speicherung RÅckstand, Gesamt
..>>        (xsaveerw)
..>>
..>> Aus: - Schalter, ob ZeitrÑume verschlÅsselt (xistabrzeitraum)
..>>      - Abrufmge (korrigiert, xmge)
..>>      - Abruftermin (xtterm)
..>>      - Abrufzeitraum (xptext)
..>>      - RÅckstand (xrÅckst.xsaveerw)
..>>      - Gesamt (xgesamt.xsaveerw)
..>>
..>> Interne Variablen: - xtxttterm
..>>                    - xterm
..>>
..
..>> Zeitraum nicht Monat
.formula xistlabrufmon = false
..>> Positionstext
.formula xptext = ""
..>> ZÑhler expandierte Abrufe
.formula xlabrufexpd = 1
..
.. >> EntschlÅsselung
..>> VerschlÅsselung:
..>>
..>> JJMMTT bedeutet Tagesdatum als Eintrefftermin
..>> 000000 Kennzeichnet das letzte Abruf-Feld einer Sachnummer im vorliegenden
..>>        Lieferabruf. Das dazugehîrige Mengenfeld sowie alle weiteren
..>>        Abruffelder des Datensatzes sind BLANK.
..>> 222222 Kennzeichnet, da· fÅr die Sachnummer kein Bedarf vorliegt.
..>>        Das dazugehîrige Mengenfeld sowie alle weiteren Abruffelder dieser
..>>        Satzart sind BLANK.
..>> 333333 Kennzeichnet die dazugehîrige Menge als RöCKSTAND.
..>> 444444 Kennzeichnet die dazugehîrige Menge als SOFORTBEDARF.
..>> 555555 Kennzeichnet, da· die folgenden Abruffelder Abrufmengen enthalten,
..>>        die sich auf den im Abrufdatum angegebenen Zeitraum beziehen.
..>>        Das dazugehîrige Mengenfeld ist auf "Null" zu setzen. Wenn alle
..>>        Mengen einer Sachnummer sich auf ZeitrÑume beziehen, beginnt das
..>>        erste Abruffeld mit 555555
..>> JJWWWW Bedarf fÅr den Zeitraum WW bis WW
..>> JJMM00 Bedarf fÅr Monat MM
..>> JJ00WW Bedarf fÅr Woche WW
..>> 999999 Kennzeichnet das Mengenfeld, das im Lieferabruf unterm dem Termin
..>>        "Rest" die Vorschaumengen mehrerer Monate enthalten kann.
..
..
.. =====   CASE001   =====
.continue BRK001 ? _(text4 = "000000")
..>> Abrufmenge 0
..>> SchlÅssel "000000" -> kein Abruf ???
.formula xmge = 0
..
..>> nachfolgende ZeitrÑume nicht verschlÅsselt
.formula xistabrzeitraum = false
..
.continue ESAC001
!BRK001
.continue BRK002 ? _(text4 = "222222")
.. >> SchlÅssel "222222" -> kein Abruf ???
..>> Abrufmenge 0
..>>
.formula xmge = 0
..
.formula xistabrzeitraum = false
..
.continue ESAC001
!BRK002
.continue BRK003 ? _(text4 = "333333")
.. >> SchlÅssel "333333" (RÅckstand) -> Lieferung Lieferabrufdatum - 1
..>> Abruftermin Lieferabrufdatum - 1
.formula xtterm = xlabrufd - 1
..>> Merken RÅckstand
.formula xrÅckst.xsaveerw = xmge
..>> Positionstext RÅckstand
.formula xptext = "RÅckstand"
..>>
..
.formula xistabrzeitraum = false
..
.continue ESAC001
!BRK003
.continue BRK004 ? _(text4 = "444444")
.. >> SchlÅssel "444444" (Sofortbedarf) -> Lieferung zu Lieferabrufdatum
..??    ..>> Abruftermin Tagesdatum
..??    .fo xtterm = datum
..>> Abruftermin Lieferabrufdatum neu
.formula xtterm = xlabrufd
..>> Positionstext Sofortbedarf
.formula xptext = "Sofortbedarf"
..>>
..
.formula xistabrzeitraum = false
..
.continue ESAC001
!BRK004
.continue BRK005 ? _(text4 = "555555")
.. >> SchlÅssel "555555" -> kein Abruf, folgende Abrufe fÅr Zeitraum verschlÅsselt
..>> Abrufmenge 0
.formula xmge = 0
..>> Merken, da· folgende Abrufe fÅr Zeitraum
.formula xistabrzeitraum = true
..>>
..
.continue ESAC001
!BRK005
.continue BRK006 ? _(text4 = "999999")
.. >> SchlÅssel "999999" -> Termin "Rest", Vorschaumenge mehrere Monate
..>> Test, ob vorangegangener Abruftermin nicht vorhanden
..>>
..
..
.continue EL010 ? _('xttermlast:8' = "19810101")
.. IF010
.. >> Testergebnis positiv: Liefertermin 31.12. des aktuellen Jahres
.formula xtterm = ('datum:8' << 4) + "1231"
..>>
..
.continue FI010
!EL010
.. >> Testergebnis negativ: Liefertermin 31.12. im Jahr des vorangegangenen Termins
..??    ..>> Abruftermin weit hinten (z.B. geht momentan spÑtestens 31.12.2080 !!!)
..??    .fo xtterm = "31.12.2081"
.formula xtterm = ('xttermlast:8' << 4) + "1231"
..
!FI010
..
..>> Positionstext: "Vorschaumenge"
.formula xptext = "Vorschaumenge"
..
.formula xistabrzeitraum = false
..
.continue ESAC001
!BRK006
.. >> Umformatieren JJ???? zu JJJJ????
..>> Test, ob Datum mit JJMMTT formatiert
..
..
.continue EL011 ? _(+text4 < 8)
.. IF011
..>> Jahr ermitteln
.formula xdatumjj = text4 << 2
..
..>> Test, ob nach Jahr nach Jahrtausendwende in VDA-Datum JJMMTT
..>> (JJ < 81, da max. Datum im EKS 31.12.2080 !!!)
..
..
.continue EL012 ? _(xdatumjj < 81)
.. IF012
..>> Abruftermin aus Datensatz
..>> Datumsangabe "20JJ????"
.formula xtxttterm = "20" + text4
..
.continue FI012
!EL012
..>> Abruftermin aus Datensatz
..>> Datumsangabe "19JJ????"
.formula xtxttterm = "19" + text4
..
!FI012
..
.continue FI011
!EL011
..>> Abruftermin aus Datensatz
.formula xtxttterm = text4
..
!FI011
..
..
.continue EL013 ? _(xistabrzeitraum)
.. IF013
.. >> Testergebnis positiv: SchlÅssel fÅr Zeitraum
..>> Testen Format, ob Woche
..
..
.continue EL014 ? _(xtxttterm / "????00??")
.. IF014
..> Abruftermin Montag der Woche
.formula xterm = (xtxttterm >> 2) + "/" + (xtxttterm << 4)
.formula xtterm = xterm
.formula xtterm = xtterm - 2
..>> Positionstext: "Woche <woche>/<jahr>"
.formula xptext = "Woche " + (xtxttterm >> 2) + "/" + (xtxttterm << 4)
..
.continue FI014
!EL014
..>> Test Format, ob Monat
..
..
.continue EL015 ? _(xtxttterm / "??????00")
.. IF015
.. >> Testergebnis positiv: Bedarf fÅr Monat
..>> Abruf fÅr ersten Wochentag des Monats erzeugen,
..>> wenn Liefermonat gleich aktueller Monat, Abruf fÅr aktuelles Datum
..>> Jahr, Monat Abruf
.formula xtxttterm = xtxttterm << 6
..>> Test, ob Monat Abruf gleich aktueller Monat
..
..
.continue EL016 ? _(xtxttterm = ('datum:8' << 6))
.. IF016
..>> Liefertermin heute
.formula xtterm = datum
..
.continue FI016
!EL016
.. Liefertermin erster Wochentag des Monats
..>> 01. des Monats
.formula xtterm = xtxttterm + "01"
..>> Wochentag
.formula xttermwt = xtterm // 7
..>> Test, ob Sonnabend oder Sonntag
..>>
..
..
.continue EL017 ? _((xttermwt = 6) ; (xttermwt = 7))
.. IF017
..>> auf nÑchsten Montag vor
.formula xtterm = xtterm + (8 - xttermwt)
..
!EL017
.. FI017
..
!FI016
..
..>> Positionstext: "Monat <monat>/<jahr>"
.formula xptext = "Monat " + (('xtterm:8' >> 4) << 2) + "/" + ('xtterm:8' << 4)
..
.continue FI015
!EL015
.. >> Testergebnis negativ: Bedarf fÅr Woche bis Woche
..> Abruftermin Montag der Woche
.formula xjahr = (xtxttterm << 4)
.formula xwoche = ((xtxttterm >> 4) << 2)
..>> Test, ob Woche grî·er 52
..
..
.continue EL018 ? _(xwoche > 52)
.. IF018
..>> Testergebnis positiv: Jahr und Woche umrechnen
.formula xjahr = xjahr + 1
.formula xwoche = xwoche - 52
..
!EL018
.. FI018
..
.formula xterm = 'xwoche' + "/" + 'xjahr'
.formula xtterm = xterm
.formula xtterm = xtterm - 2
..>> Positionstext: "von Woche <woche>/<jahr> bis <woche>/<Jahr>"
.formula xptext = "Woche " + ((xtxttterm >> 4) << 2) + "/" + (xtxttterm << 4)
.formula xptext = xptext + " bis " + (xtxttterm >> 2) + "/" + (xtxttterm << 4)
..
!FI015
..
!FI014
..
.continue FI013
!EL013
..>> Abruftermin aus dem auf vier Jahresstellen umformatiertem Datensatz
..>> SchlÅssel <JJMMTT> -> Lieferung Eintrefftermin
..**ok,25.08.2008 (unten .fo als .zuweisen geÑndert)
.assign T|xtterm = xtxttterm
..
!FI013
..
!ESAC001: =====   ENDCASE   =====
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EDISchreibeLABDatenTMP
..
!PROC003: ----- EDISchreibeLABDatenTMP -----
..>> Ausgabe Daten zu Lieferabrufterminen
..>>
..>> Parameter:
..>>
..>> Ein: - Identnummer EDI-Datensatz (num, geholt)
..>>      - Endung Variable fÅr Speicherung RÅckstand, Gesamt
..>>        (xsaveerw)
..>>
..>> Aus: - RÅckstand (xrÅckst.xsaveerw)
..>>      - Gesamt (xgesamt.xsaveerw)
..>>
..>> Interne Variablen: - Schalter, ob ZeitrÑume verschlÅsselt (xistabrzeitraum)
..>>                    - Abrufmge (korrigiert, xmge)
..>>                    - Abruftermin (xtterm)
..>>                    - xtxttterm
..>>                    - xterm
..>>
..
.. >> Ausgabe Lieferabrufdaten aus EDI-Datensatz
.formula xistsatz1 = num <> ""
..
..
.continue EL019 ? _(xistsatz1)
.. IF019
.. >> Merken Kopf-Variablen
..>> Artikelnummer
.formula xideksart = ideksart
..>> Datum Lieferabruf
.formula xlabrufd = labrufd
..>> Kunden-Fortschrittszahl
.formula xzkdfzahlact = einfzahl
..
.select line
..
..>> selektive Verarbeitung der einzelnen Tabellenzeilen des EDI-Datensatzes
..>> (Abruftermine des Lieferabrufs, Packmittel)
..>> (Anmerkung: Rechnen mit Datum siehe Hilfe 9.1.5)
..
..>> Initialisieren: Zeilennummer
.formula xznummer = 1
..
..>> Initialisieren: kein voriger Termin
.formula xtterm0 = ""
..
..>> Initialisieren: folgende Abrufe nicht fÅr Zeitraum
.formula xistabrzeitraum = false
..
..>> Initialisieren: spÑtester Abruftermin des Abrufs
.formula xttermlast = "19810101"
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(mehr)
..>> Verzweigung entsprechend Satzkennzeichen
..
..
.. =====   CASE002   =====
.continue BRK007 ? _(text1 = "521")
.. >> 521, Abrufe
..>> Abrufmenge
.formula xmge = text5
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
..
