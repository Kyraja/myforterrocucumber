..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIDAT.EV
.. Autor          : dsch
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Events Bearbeitung fÅr Infosystem EDIDAT
.. Functionality  : Event-Control for the infosystem EDIDAT
..*****************************************************************************
..
.set trans -
.input "is/TABLEEREN"
.continue SCHENAME  ? T|evtartengl="FIELD_EXIT" & T|evtvar="kschema"
.continue DATNAME   ? T|evtartengl="FIELD_EXIT" & T|evtvar="kdateiname"
.continue EDINUM    ? T|evtartengl="FIELD_EXIT" & T|evtvar="kedinum"
.continue FPROT     ? T|evtartengl="FIELD_EXIT" & T|evtvar="kdofprot"
.continue SCHEFILE  ? T|evtartengl="FIELD_EXIT" & T|evtvar="kschemadatei" & M|kschemadatei = true
.continue
!SCHENAME
.formula M|kstandard  = M|kschema^standard
.formula M|krequest   = M|kschema^request
.formula M|kversion   = M|kschema^version
.continue
!DATNAME
.formula M|kedinum    = "" ? M|kdateiname <> ""
.continue
!EDINUM
.formula M|kdateiname = "" ? M|kedinum <> ""
.continue
!FPROT
.formula M|kdatfprot  = "" ? _M|kdofprot
.continue
!SCHEFILE
.continue NOSCHEMA ? F|empty(M|kschema)
..
.. PrÅfen ob Datei bereits vorhanden ist...
..
.type text xtdatei ? _defined(xtdatei)
.formula T|xtdatei = "ow1/S"+M|kschema+".FOP"
.continue NOFILE ? _F|fileexists(T|xtdatei)
..
!END
.continue
..
..
!NOSCHEMA
.error WÑhlen Sie bitte ein Schema aus.
.cursor kschema 0
.end 1
.continue
!NOFILE
.error Kann Datei 'T|xtdatei' nicht finden.
.continue
