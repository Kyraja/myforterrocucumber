..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIIMPINI.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Allgemeines Eventhandling Infosystem EDIIMPINI
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type text  xt
.type text  xtsel
..
.type text xLieferabruf
.type text xFeinabruf
.type text xEDLMeldung
..
.formula U|xLieferabruf = "(ForecastDeliverySchedule)"
.formula U|xFeinabruf = "(JITDeliverySchedule)"
.formula U|xEDLMeldung = "(ESPMessage)"
..
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue LAB     ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "partidlab"
.continue FAB     ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "partidfab"
.continue EDL     ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "partidedl"
.continue LABFABI ? T|evtartengl = "FIELD_EXIT"   & T|evtvar = "labfabint"
.continue EDINFO  ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "edinfo"
.continue PASS    ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "buekspassw"
.continue DRUCKER ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "buprintout"
.continue DRUCKER ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "buprinterr"
.continue DRUCKER ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "bugadrucker"
.continue DRUCKER ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "buedldrucker"
.continue FLAGUP  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "writeflagfileupper"
.continue FLAGLOW ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "writeflagfilelower"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!FLAGUP
.copy M|writeflagfilelower = G|false
.continue END
..
!FLAGLOW
.copy M|writeflagfileupper = G|false
.continue END
..
!LAB
.command -parallel 'F|formatstr("(Infosystem) PARTNERID ? kedinachraz={1} | bstart=", xLieferabruf)'
.continue END
..
!FAB
.command -parallel 'F|formatstr("(Infosystem) PARTNERID ? kedinachraz={1} | bstart=", xFeinabruf)'
.continue END
..
!EDL
.command -parallel 'F|formatstr("(Infosystem) PARTNERID ? kedinachraz={1} | bstart=", xEDLMeldung)'
.continue END
..
!LABFABI
.formula M|autodeaktl = false ? M|labfabint = true
.formula M|deaktoldl  = false ? M|labfabint = true
.protection autodeaktl         ? M|labfabint = true
.protection deaktoldl          ? M|labfabint = true
.protection -reset autodeaktl  ? M|labfabint = false
.protection -reset deaktoldl   ? M|labfabint = false
.continue END
..
!EDINFO
.command -parallel "(Infosystem) EDIEINTR ? minfo=1 | bstart="
.continue END
..
!PASS: **ok,07.07.2005 (Paáwortdatensatz/Drucker/Postverteiler-Selektion)
.formula xtsel = "%,,nummer=;name=;bezeich=;gruppe=11;@auto=(1)"
.select company 'xtsel'
.end ? _mehr
.formula M|ekspassw = H|bezeich
.end
..
!DRUCKER
.input DRUCKER
.formula M|printout   = geraet ? evtvar="buprintout"
.formula M|printerr   = geraet ? evtvar="buprinterr"
.formula M|gadrucker  = geraet ? evtvar="bugadrucker"
.formula M|edldrucker = geraet ? evtvar="buedldrucker"
.end
..*****************************************************************************
!END
.continue
