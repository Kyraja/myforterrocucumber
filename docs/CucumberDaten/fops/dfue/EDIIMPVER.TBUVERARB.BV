..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIIMPVER.TBUVERARB.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Prueft ob der Kunde in der Zeile die ausgewaehlten
..                  Nachrichten verarbeiten darf
.. Functionality  : Checks if customer in row is allowed to process the
..                  chosen message types
..*****************************************************************************
.set trans -
..
.type text xvorgang    ? _F|defined(U|xvorgang)
.type P109:2 xedinachr ? _F|defined(xedinachr)
..
.formula M|tedinachr=""
.formula M|tabmodell=""
..
..
.. Default: do not process
.copy M|tbaktiv = G|false
.continue END  ?  F|empty(M|thauptkunde) & F|empty(M|tkundenkontakt)
..
.. Contact or primary customer ..
.. Has to be in buffer H for "DFUE.GET.PROTOK"
.select customer 'M|tkunde^id'
.continue END  ? _G|mehr
..
..
.. Forcast Schedule
.continue EVKAUV  ?  _M|kballe & _M|kbabrufe
.formula U|xvorgang = "VKAUVE-"
.. FIXME: LAB / FAB
.formula U|xedinachr = ""
.input "DFUE.GET.PROTOK"
.copy M|tbaktiv = U|xediaktiv
.copy M|tedinachr = U|xediabm^edinachr  ? _M|kballe & U|xediaktiv
.copy M|tabmodell = U|xediabm   ? _M|kballe
.continue ENDPR  ?  U|xediaktiv
!EVKAUV
..
.. Pickup-Sheets
.continue EVKAUVEP  ?  _M|kballe & _M|kbpus
.formula U|xvorgang = "VKAUVEP"
.formula U|xedinachr = "2104"
.input "DFUE.GET.PROTOK"
.copy M|tbaktiv = U|xediaktiv
.copy M|tedinachr = U|xedinachr ? _M|kballe & U|xediaktiv
.copy M|tabmodell = U|xediabm   ? _M|kballe
.continue ENDPR  ?  U|xediaktiv
!EVKAUVEP
..
.. Orders
.continue EVKAUE  ? _M|kballe & _M|kborders
.formula U|xvorgang = "VKAUE"
.. FIXME: Orders + Change
.formula U|xedinachr = ""
.input "DFUE.GET.PROTOK"
.copy M|tbaktiv = U|xediaktiv
.copy M|tedinachr = U|xediabm^edinachr  ? _M|kballe & U|xediaktiv
.copy M|tabmodell = U|xediabm   ? _M|kballe
.continue ENDPR  ?  U|xediaktiv
!EVKAUE
..
.. ESP messaging
.continue EVKEDL  ? _M|kballe & _M|kbedl
.formula U|xvorgang = "VKEDL"
.formula U|xedinachr = "2110"
.input "DFUE.GET.PROTOK"
.copy M|tbaktiv = U|xediaktiv
.copy M|tedinachr = U|xedinachr ? _M|kballe & U|xediaktiv
.copy M|tabmodell = U|xediabm   ? _M|kballe
.continue ENDPR  ?  U|xediaktiv
!EVKEDL
..
.. Container Accounting
.continue ELAKO ? _M|kballe & _M|kblako
.formula U|xvorgang = ""
.formula U|xedinachr = "2114"
.input "DFUE.GET.PROTOK"
.copy M|tbaktiv = U|xediaktiv
.copy M|tedinachr = U|xedinachr ? _M|kballe & U|xediaktiv
.copy M|tabmodell = U|xediabm   ? _M|kballe
.continue ENDPR  ?  U|xediaktiv
!ELAKO
..
..
!ENDPR
.select -
..
..*****************************************************************************
!END
.continue
