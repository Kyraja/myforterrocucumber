..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TESTDAT.BSTART.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Startbutton "Nach" und "PrÅfen" Button: prÅft ob es zu den
..                  Objektangaben in einer Tabellenzeile bereits ein Objekt in
..                  der Datenbank gibt; und weisst ggf. auf Abweichungen
..                  zwischen dem vorhandenen Objekt und dem gewÅnschten Objekt
..                  hin.
.. Functionality  : Start button "after" and "verfiy data" button: verifies if
..                  there already is an object matching the data given in a
..                  table row. If there is an object possible dissimilarities
..                  of the existing object and the desired object are
..                  highlighted.
..*****************************************************************************
.set trans -
..
.type text   xtsel
.type text   xtdatei
.type text   xtgruppe
.. checking references, to avoid errors on not yet created objects
.type VPB99  xv
.type text   xvdatei
.type bool   xbsuch
..
.type integer    xi          ? _F|defined(U|xi)
.type integer    xilen       ? _F|defined(U|xilen)
.type text   xtfeld
.type text   xtfopzeile
.type text   xtwert
.type bool   xbdiff
.type bool   xbtabellenfeld
..
.input "is/ABASFARBEN.DEF"
..
..
..  first check: very precise query
..
.select screen header
!NROW
.select screen line
.continue END1 ?  _G|mehr
.formula   M|tobjekt = ""
.formula   M|tstatus = false
.colour -foreground -1 -1 -1 -background -1 -1 -1 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert1  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert2  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert3  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert4  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert5  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert6  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert7  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert8  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert9  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert10 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert11 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert12 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert13 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert14 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert15 'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1 twert16 'M|aktzeile'
.continue NROW ?   M|tname1 = M|twert1
.continue NROW ?   F|empty(M|tdbgruppe)
.continue NROW ?   'M|tdbgruppe'="53:0"
.continue NROW ?   F|empty(M|twert1) & F|empty(M|twert2)
.formula U|xtdatei  = M|tdbgruppe<<":"
.formula U|xtgruppe = M|tdbgruppe>>":"
.. special treatment required :( - 2:6 does not know which field is a table, 2:7 does not have queries defined
.formula U|xtdatei  = "2"  ? M|tdbgruppe="2:7"
.formula U|xtgruppe = "6"  ? M|tdbgruppe="2:7"
..
.formula U|xtsel = "$,,;@datenbank=" + U|xtdatei + ";@gruppe=" + U|xtgruppe
.formula U|xi = 0
!NFIELD
.formula U|xi = U|xi + 1
.continue EFIELD  ?  U|xi > 16
.formula U|xtfeld = "twert" + 'xi'
.colour -background 'U|xabasred' -foreground -1 -1 -1 'xtfeld' 'M|aktzeile'     ?  F|empty(M|tname.xi)  &  _F|empty(M|twert.xi)
.continue NFIELD  ?  F|empty(M|tname.xi) ; F|empty(M|twert.xi)
.. avoid error messages for empty references
.continue XFIELD  ?  (M|tart.xi)<<1 <> "P"
.formula U|xbsuch  = false
.formula U|xbsuch  = true  ?  'M|tart.xi' / "PS*"
.formula U|xvdatei = (M|tart.xi)<<-2    ?  U|xbsuch
.formula U|xvdatei = (M|tart.xi)<<-1    ? _U|xbsuch
.formula U|xvdatei =  U|xvdatei<<":"    ?  U|xvdatei / "*:*"
.formula U|xbsuch  = _( ((M|twert.xi)<<1) / "(0-9)" )
.assign U|xv  = "$,,;@gruppe=;@datenbank=" + U|xvdatei + ";nummer=" + M|twert.xi   ?  _U|xbsuch
.assign U|xv  = "$,,;@gruppe=;@datenbank=" + U|xvdatei + ";such="   + M|twert.xi   ?   U|xbsuch
.continue NFIELD  ? _G|mehr
!XFIELD
.formula U|xtsel = U|xtsel + ";" + M|tname.xi + "=" + M|twert.xi
.continue EFIELD  ? +U|xtsel > 160
.continue NFIELD
!EFIELD
.assign M|tobjekt = U|xtsel
.formula   M|tstatus = G|mehr
.continue NROW
!END1
..
..
..  second check: query with critical key elements i.e. "nummer"
..
.select screen header
!NROW2
.select screen line
.continue END   ?  _G|mehr
.continue PRUEF ?   M|tstatus

.continue NROW2 ?   M|tname1 = M|twert1
.continue NROW2 ?   F|empty(M|tdbgruppe)
.continue NROW2 ?   F|empty(M|twert1) & F|empty(M|twert2)
.continue PRUEF ?  'M|tdbgruppe'="53:0"
.formula U|xtdatei  = M|tdbgruppe<<":"
.formula U|xtgruppe = M|tdbgruppe>>":"
..
.formula U|xtsel = "$,,;@datenbank=" + U|xtdatei + ";@gruppe=" + U|xtgruppe
.formula U|xi = 0
.formula U|xilen = +U|xtsel
!NFIELD2
.formula U|xi = U|xi + 1
.continue EFIELD2  ?  U|xi > 16
.continue NFIELD2  ?  F|empty(M|tname.xi) ; F|empty(M|twert.xi)
.formula U|xtsel = U|xtsel + ";" + M|tname.xi + "=" + M|twert.xi     ?  M|tname.xi = "nummer"
.formula U|xtsel = U|xtsel + ";" + M|tname.xi + "=" + M|twert.xi     ?  M|tname.xi = "such"
.continue NFIELD2
!EFIELD2
.continue NROW2   ?  U|xilen = +U|xtsel
.assign M|tobjekt = U|xtsel
.continue NROW2   ? _G|mehr
..
!PRUEF
.formula U|xi = 0
.formula U|xbtabellenfeld = false
!NPRUEF
.formula U|xbdiff = false
.formula U|xi = U|xi + 1
.continue NROW2   ?  U|xi > 16
.continue NPRUEF  ?  F|empty(M|tname.xi)
.formula U|xbtabellenfeld = true     ?  M|tname.xi = M|ttabellenfeld
.formula U|xtfeld = "twert" + 'xi'
.continue TAB     ?  U|xbtabellenfeld ; 'M|tdbgruppe'="53:0"
.formula U|xtfopzeile = F|formatstr("'M|tobjekt^{1}'", M|tname.xi)
.formula U|xtwert = F|eval(U|xtfopzeile)
.formula U|xbdiff = true   ?  'M|twert.xi' <> 'U|xtwert'
.colour -background 'U|xabasyellow' -foreground -1 -1 -1 'xtfeld' 'M|aktzeile'  ?  U|xbdiff
!TAB
.colour -background 'U|xabaslightyellow'   -foreground -1 -1 -1 'xtfeld' 'M|aktzeile'  ?  U|xbtabellenfeld
.continue NPRUEF
..
..*****************************************************************************
!END
.continue
