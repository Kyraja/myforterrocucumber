..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIRAH.EKVK.FA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Toggles possible views, query fields, and administration
..                  options when switching between sales and purchasing.
..*****************************************************************************
.set trans -
..
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue SALES     ?  G|evtartengl = "SCREEN_ENTER"
.continue SALES     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "verkauf"
.continue PURCHASE  ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "einkauf"
.continue CUSTOMER  ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kunde"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!CUSTOMER
.. Show matching plant and unloading point for customer/supplier
.formula M|werk = ""
.formula M|ablstelle = ""
.continue TABINIT  ?  F|empty(M|kunde)
.formula M|werk = M|kunde^werk  ?  M|kunde^gruppe=2
.formula M|ablstelle = M|kunde^ablstelle  ?  M|kunde^gruppe=2
.. Switch between sales and purchasing to match customer/supplier
.continue PURCHASE  ?  M|kunde^dnr=1
.continue SALES ? M|kunde^dnr=0
.continue END
..
..
!PURCHASE
.copy M|einkauf = G|true
.copy M|verkauf = G|false
.. PROTECT FIELDS
.. views
.protection -reset kbstandard    0
.protection -reset kbfzahl       0
.protection -reset kbgueltigkeit 0
.protection -reset kbpreise      0
.protection -reset kbversand     0
.protection -reset kbupgrade     0
.. views - not supported for purchasing
.protection kbfruehwarn    0
.protection kbabrufe       0
.protection kbkundeartikel 0
.. query fields
.protection -reset kbetreuer  0
.protection -reset kunde      0
.protection -reset kspediteur 0
.protection -reset art        0
.protection -reset kuartnr    0
.protection -reset kabschlnr  0
.protection -reset kverwschl  0
.protection -reset werk       0
.protection -reset ablstelle  0
.protection -reset mitpack    0
.protection -reset kpackanw   0
.. administration options: header
.protection -reset kbspediteurneu  0
.protection -reset kspediteurneu   0
.protection -reset kbudatersetzen  0
.protection -reset kneuesbudat     0
.protection -reset kbversandartneu 0
.protection -reset kversandartneu  0
.protection -reset kbabschlnrneu   0
.protection -reset kabschlnrneu    0
.. administration options: row
.protection -reset kblzeit2vorlauf 0
.protection -reset kbfzahlaufnull  0
.protection -reset kbpackanwneu    0
.protection -reset kpackanwneu     0
.protection -reset kpreisprozentneu  0
.. administration options: row - not supported for purchasing
.protection kbfzahlausabruf   0
.protection kbfruehwarnneu    0
.protection kfzdiffneu        0
.protection kzefzdiffneu      0
.protection kbvorlauf2vorlauf 0
.. INITIALIZE FIELDS
.. views
.copy M|kbstandard = G|true ? (M|kbfruehwarn ; M|kbabrufe ; M|kbkundeartikel)
.copy M|kbfruehwarn = G|false
.copy M|kbabrufe = G|false
.copy M|kbkundeartikel = G|false
.. query fields
.assign M|kunde = "" ? M|kunde^dnr=0
.. admin options
.copy M|kbfzahlausabruf = G|false
.copy M|kbfruehwarnneu = G|false
.copy M|kfzdiffneu = 0.0
.copy M|kzefzdiffneu = 0
.copy M|kbvorlauf2vorlauf = G|false
.copy M|kpreisprozentneu = 0.0
.. protection value fields
.protection kspediteurneu 0    ? _M|kbspediteurneu
.protection kneuesbudat 0      ? _M|kbudatersetzen
.protection kpackanwneu 0      ? _M|kbpackanwneu
.protection kfzdiffneu 0       ? _M|kbfruehwarnneu
.protection kzefzdiffneu 0     ? _M|kbfruehwarnneu
.protection kabschlnrneu 0     ? _M|kbabschlnrneu
.protection kversandartneu 0   ? _M|kbversandartneu
.protection kpreisprozentneu 0 ? _M|kbpreiseneu
.continue TABINIT
..
!SALES
.copy M|einkauf = G|false
.copy M|verkauf = G|true
.. PROTECT FIELDS
.. views
.protection -reset kbstandard     0
.protection -reset kbfruehwarn    0
.protection -reset kbfzahl        0
.protection -reset kbgueltigkeit  0
.protection -reset kbpreise       0
.protection -reset kbversand      0
.protection -reset kbabrufe       0
.protection -reset kbkundeartikel 0
.protection -reset kbupgrade      0
.. query fields
.protection -reset kbetreuer  0
.protection -reset kunde      0
.protection -reset kspediteur 0
.protection -reset art        0
.protection -reset kuartnr    0
.protection -reset kabschlnr  0
.protection -reset kverwschl  0
.protection -reset werk       0
.protection -reset ablstelle  0
.protection -reset mitpack    0
.protection -reset kpackanw   0
.. administration options: header
.protection -reset kbspediteurneu  0
.protection -reset kspediteurneu   0
.protection -reset kbudatersetzen  0
.protection -reset kneuesbudat     0
.protection -reset kbversandartneu 0
.protection -reset kversandartneu  0
.protection -reset kbabschlnrneu   0
.protection -reset kabschlnrneu    0
.. administration options: row
.protection -reset kblzeit2vorlauf   0
.protection -reset kbvorlauf2vorlauf 0
.protection -reset kbpackanwneu      0
.protection -reset kpackanwneu       0
.protection -reset kbfzahlaufnull    0
.protection -reset kbfzahlausabruf   0
.protection -reset kbfruehwarnneu    0
.protection -reset kfzdiffneu        0
.protection -reset kzefzdiffneu      0
.protection -reset kpreisprozentneu  0
.. INITIALIZE FIELDS
.. query fields
.assign M|kunde = "" ? M|kunde^dnr=1
.. protection value fields
.protection kspediteurneu 0    ? _M|kbspediteurneu
.protection kneuesbudat 0      ? _M|kbudatersetzen
.protection kpackanwneu 0      ? _M|kbpackanwneu
.protection kfzdiffneu 0       ? _M|kbfruehwarnneu
.protection kzefzdiffneu 0     ? _M|kbfruehwarnneu
.protection kabschlnrneu 0     ? _M|kbabschlnrneu
.protection kversandartneu 0   ? _M|kbversandartneu
.protection kpreisprozentneu 0 ? _M|kbpreiseneu
.continue TABINIT
..
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..
..*****************************************************************************
!END
.continue
