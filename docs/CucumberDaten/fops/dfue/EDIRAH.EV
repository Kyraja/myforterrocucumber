..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIRAH.EV
.. Autor          : mh/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : General events, e.g. query field changed -> clear table
..*****************************************************************************
.set trans -
..
.type text   xtsel
.type text   xtcmd
.type ID87:9 xcallparam
..
..
.. Event evaluation
.. ----------- ----- Header -------- -------------------------------------------
.continue ART     ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "art"
.continue FZPROT  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "kbufzahlprotokoll"
.. ----------- ---------- ---------- -------------------------------------------
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kuartnr"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kabschlnr"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kverwschl"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "werk"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "ablstelle"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "mitpack"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kpackanw"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbetreuer"
.continue TABINIT ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kspediteur"
.. ----------- ----- Row buttons --- -------------------------------------------
.continue LABINFO ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "labinfo"
.continue PRINFO  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "savinfo"
.. ----------- ----- Row insertion / deletion ----------------------------------
.continue MAYBE   ? G|evtartengl = "ROW_DELETION_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!FZPROT
.continue END ?  F|empty(M|kfzahlprotokoll)
.continue END ? _F|fileexists(M|kfzahlprotokoll)
.output terminal
.input -text 'M|kfzahlprotokoll'
.continue END
..
..
!ART
.formula M|kartbez = M|art^sucherw
.continue TABINIT
..
..
!LABINFO
.continue END ? F|empty(M|labinfo) ; M|rahmen^dnr<>3
.copy U|xcallparam = M|klabdiffcallparam
.input "st/CALLPARAM.EXEC"
.continue END
..
!PRINFO
.continue END ? F|empty(M|savinfo) ; M|rahmen^dnr<>3
.copy U|xcallparam = M|ksavingscallparam
.input "st/CALLPARAM.EXEC"
.continue END
..
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..
!MAYBE: allow removal of rows when upgrading to easily prevent price upgrades
.continue ? M|kbupgrade
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..
..*****************************************************************************
!END
.continue
