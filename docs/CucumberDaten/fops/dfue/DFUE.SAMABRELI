.set trans -
..@@ENDHEAD
..
.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
..... procedure stack pointer .....
..art int   xprocsp
..**ok,18.06.2001 (xDRgeraet NEU)
.type text xDRgeraet
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
..fo xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.. --------------------   BLOCK  --------------------
.. initialisierung
..die parameterdatei
..**ok,07.01.2003 (xarb wurde entfernt)
.formula xdPARAM = "dfue/DFUE.EXP.INI"
.input 'xdPARAM'
..
.. vorgangsart fÅr edinfo
.formula xvorgang = "VKRE"
..
.. -------------------- ENDBLOCK --------------------
..
.input DRUCKER
..**ok,18.06.2001 (BLANKOB.F wurde von hier entfernt)
..
.formula xDRgeraet = geraet
..
.. -> selektionsleiste aufrufen
..fo xtxt = "%" + xIDSelEDIKunUebnr
..**ok,13.06.2001 (Selektion jetzt mit dem Vorbelegen und rÅckwÑrts)
..**ok,05.10.2001 (Selektion jetzt mit idkunderab=;ideksvor=;erfass=)
..**ok,19.04.2002 (Selektion jetzt mit num53)
.formula xtxt = "%" + xIDSelEDIKunUebnr + ",,num53=;idkunderab=;ideksvor=;erfass=;vorart=5!5;@richtung=rÅckw"
.select edifact lock 'xtxt'
..
..**ok,18.06.2001 (statt idkundeab jetzt idkunderab verwendet)
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(mehr)
..
.continue EL001 ? _((h|idkunderab<>"") & ((h|fcode=0) & (h|vorart = reko)))
.. IF001
..
.continue EL002 ? _(h|nachrtyp="INVOIC")
.. IF002
.. EDIFACT
.formula xDFUEproto = 3
..
.continue FI002
!EL002
.. VDA
.formula xDFUEproto = 1
..
!FI002
..
..
.continue EL003 ? _(xDFUEproto = 1)
.. IF003
.input "DFUE.VKRE.DRUCK"
..
.continue FI003
!EL003
..
.continue EL004 ? _(xDFUEproto = 3)
.. IF004
.input "INV.SAMABRELI"
..
!EL004
.. FI004
..
!FI003
..
!EL001
.. FI001
..
.select edifact lock
..
.continue LOOP001
!ELOP001: ==============================
