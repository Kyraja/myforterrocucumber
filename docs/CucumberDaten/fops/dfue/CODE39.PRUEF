..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CODE39.PRUEF
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Prft eine Zeichenkette auf nicht zul„ssige Zeichen
.. Functionality  : Checks a string for forbidden Symbols
..                  Code39 allows numbers, uppercase letters and
..                  7 special symbols  (- . space $ / + %).
..
.. Interface (arguments and their meaning)
..
..   Argument       meaning
..   ---------------------------------------------------------
..   xt39pruefcode  text that needs checking for code39 compliance
..   xb39fehler     return-value, true if code was not compliant
..*****************************************************************************
.set trans -
..
.type bool   xb39fehler      ? _F|defined(T|xb39fehler)
.type text   xt39fehler      ? _F|defined(T|xt39fehler)
.type integer    xi39            ? _F|defined(T|xi39)
.type integer    xi39max         ? _F|defined(T|xi39max)
.type text   xt39            ? _F|defined(T|xt39)
.formula T|xb39fehler = false
.formula T|xt39fehler = ""
..
.. nothing to check?
.continue ERRARG  ? _F|defined(T|xt39pruefcode)
..
.. check each digit for compliance:
.formula T|xi39 = 0
.formula T|xi39max = +T|xt39pruefcode
!NEXT
.formula T|xi39 = T|xi39 + 1
.continue END     ? T|xi39 > T|xi39max
.formula T|xt39 = F|substr(T|xt39pruefcode,T|xi39,1)
.continue NEXT    ? F|regmatch(T|xt39,"[0-9]")
.continue NEXT    ? F|regmatch(T|xt39,"[A-Z]")
.continue NEXT    ? F|regmatch(T|xt39,"[a-z]")
.continue NEXT    ? F|regmatch(T|xt39,"[\-\.\ \$\/\+\%]")
.formula T|xb39fehler = true
.formula T|xt39fehler = T|xt39
..*****************************************************************************
!END
.continue
