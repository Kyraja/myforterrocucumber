!PROC002: ----- ZeitDatumEDI -----
.. Aktuelle Zeit und Datum in den EDI-Datensatz schreiben
.. datum / zeit der dateierstellung
.formula xdatum     = datum
.formula xzeit      = zeit
.formula h|dinhouse = xdatum
.formula h|zinhouse = xzeit
.formula h|ddatei   = xdatum
.formula h|zdatei   = xzeit
..
.formula h|uebnr  = xUebNrNeu
.formula h|uebnra = xUebNrAlt
..**ok,14.08.2003 (jetzt hier auch uebdat eintragen)
.formula h|uebdat = datum
.rewrite
..
.. Satzart
.select lock line
.formula xmehr = mehr
..**ok,10.01.2006 (jetzt EintrÑge auch fÅr EK-Lieferabruf)
..
..
!LOOP002: ==============================
.continue ELOP002 ? _(xmehr)
..
.continue EL008 ? _((h|text1 = "UNBI") & ((xvorgang = "VKAUB") ; (xvorgang = "PRICAT") ; (xvorgang = "VKLS") ; (xvorgang = "EKLAB")))
.. IF008
.. Datum und Uhrzeit in Satz UNBI eintragen
.formula h|text9  = xdatum:8
.formula h|text10 = (("00" + ('xzeit' << ":")) >> 2) + (("00" + ('xzeit' >> ":")) >> 2)
.formula h|text12 = xUebNrAlt
.formula h|text13 = xUebNrNeu
.formula h|text15 = xdatum:8
.rewrite
.continue UEBNR
..
!EL008
.. FI008
..
..
.continue EL009 ? _((h|text1 = "000") & ((xvorgang = "VKRE") ; (xvorgang = "VKLS")))
.. IF009
.. Datum und Uhrzeit in Satz 000 eintragen
.formula h|text12 = xdatum:8
.formula h|text13 = (("00" + ('xzeit' << ":")) >> 2) + (("00" + ('xzeit' >> ":")) >> 2)
..
..
.continue EL010 ? _(xDFUEproto=2;xDFUEproto=3)
.. IF010
.formula h|text14 = xUebNrNeu
..
!EL010
.. FI010
..
.rewrite
..
!EL009
.. FI009
..
..
.continue EL011 ? _((h|text1 = "400") & ((xvorgang = "VKRE") ; (xvorgang = "VKLS")) & (xDFUEproto = 1))
.. IF011
.. im ersten satz 400 Åbertragungsnr setzen -> vda4906-811
.formula h|text5 = xUebNrAlt
.formula h|text6 = xUebNrNeu
.formula h|text7 = datum:8
.rewrite
.continue UEBNR
..
!EL011
.. FI011
..
.select lock line
.formula xmehr = mehr
..
.continue LOOP002
!ELOP002: ==============================
..
.. neue uebertragungsnummer mit fÅhrenden nullen
!UEBNR
.formula xtxt = xUebNrNeu
.formula xtxt = ("000" + xtxt) >> 3
..
.continue 'xprocst.xprocsp'
..
