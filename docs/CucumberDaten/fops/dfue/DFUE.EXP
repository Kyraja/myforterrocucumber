..!interpreter english translate 
..noabbrev
..*****************************************************************************
.. Name           : DFUE.EXP
.. Author         : 
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : steuert den Export von EDI-DatensÑtzen 
..*****************************************************************************
.set trans +
.. Variable definitions
.type bool  xbreturn
.type bool  xbEdiFehler
.type text  xcom
.type text  xdExport
.type text  xdExport2
.....edifact-Format
.type text  xdEdiExport1
.type text  xdEdiExport2
.type text  xdfehler
.type integer   xDFUEproto
.type text  xdPARAM
.type text  xdSendeDatei
.type text  xdEdiSendeDatei
.type integer   xExportCnt
.type integer   xfcode
.type integer   xFehlerCnt
.type text  xkunde
.type bool  xmehr
.type text  xPostBetreff
.type text  xPostEmpf
.type text  xPostFtext
.type text  xPostStichw1
.type text  xPostStichw2
.type text  xPostStichw3
.type text  xPostStichw4
..... procedure stack pointer .....
.type integer   xprocsp
.type integer   xsearchFcode
.type text  xsearchIMEX
.type integer   xsearchStatus
.type text  xsys
.type text  xtxt
.type text  xtxt1
.type text  xuebnr
.type integer xiuebnr
.type text  xUebNrNeu
.type text  xUebNrAlt
.type text  xUebNrAktuell
.type integer   xVorArtVKAU
.type integer   xVorArtVKLS
.type integer   xVorArtVKRE
.type integer   xVorArtVKSP
.type text  xvorgang
..
.. initialize procedure stack pointer
.formula xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
..
..
.. --------------------   BLOCK  --------------------
.. initialisierung
..die parameterdatei
.formula xdPARAM = "dfue/DFUE.EXP.INI"
.input 'xdPARAM'
.up
.down
..
..
.. protokolldatei erzeugen, falls noch nicht existiert
.formula xsys = "test -f " + xdProto
.system 'xsys' background
..
..
.continue EL012 ? _(_(mehr))
.. IF012
.. ueberschrift in protokolldatei setzen
.input DATEI.F
.output new 'xdProto'
'txname                       ' START: 'datum'_'zeit ' PID: 'pid'
  Datum_Zeit     EDI-Nr    Vorgang  Vo Kunde    Fehl       Bemerkung
--------------------------------------------------------------------------------
..
..
.continue FI012
!EL012
.. anfÅgen
.input DATEI.F
.output addedto 'xdProto'

'txname                       ' START: 'datum'_'zeit ' PID: 'pid'
  Datum_Zeit     EDI-Nr    Vorgang  Vo Kunde    Fehl       Bemerkung
--------------------------------------------------------------------------------
..
..
!FI012
..
.. Dateinamen vergeben, Variablen auf Initialwert setzen
.. wichtige globale variablen fÅr vorgangsarten
..**ok,14.01.2002 (vom abko zu 23 geÑndert)
.formula xVorArtVKAU = 23
.formula xVorArtVKSP = spko
.formula xVorArtVKLS = liko
.formula xVorArtVKRE = reko
....**ok,13.02.2002 (neu: xVorArtPRICAT = 33 fÅr die Artikelpreisliste)
.formula xVorArtPRICAT = 33
..
.. import/export flag der zu exportierenden datensÑtze
.formula xsearchIMEX = "EX"
.. status der zu exportierenden datensÑtze
.formula xsearchStatus = 2
.. fehlercode der zu exportierenden datensÑtze
.formula xsearchFcode = 0
..
.. zÑhler fÅr anzahl vorgÑnge und fehler
.formula xExportCnt = 0
.formula xFehlerCnt = 0
..
.. datei fÅr fehlermeldungen -> kommt an den freitext der post
.formula xdfehler = "X.ERR." + pid + ".TMP"
..
.. die tmp. exportdatei
.formula xdExport  = "X.EX." + pid + ".TMP"
.formula xdExport2 = "X.EX2." + pid + ".TMP"
..
.. die tmp. exportdatei fÅr edifact Format
.formula xdEdiExport1 = "X.EDIEX1." + pid + ".TMP"
.formula xdEdiExport2 = "X.EDIEX2." + pid + ".TMP"
..
.. -------------------- ENDBLOCK --------------------
..
.. Pruefung der Export-Konfiguration
.. Werden Fehler gefunden, wird DFUE.EXP mit Fehler beendet
.type bool xbquiet  ? _F|defined(T|xbquiet)
.formula T|xbquiet = true
.input "dfue/DFUE.EXP.CHECK"
.continue EPRUEF  ? _T|xbfehler
.error Bei der PrÅfung der Export-Konfiguration wurden Fehler gefunden.
.error Starten Sie in der Export-Konfiguration das ExportprÅfpogramm!
.end 1
!EPRUEF
..
.. Meldungen fÅr Anwender
..
.continue EL013 ? _(xbRMeldAn)
.. IF013
.output terminal
.left 1
.right 210
.view sg.klein
..
.. 2017-06: Abbildungsmodell muss leer sein
.formula U|xcom = "$,,;@gruppe=0;@ablage=(1);@zeilen=(0);imex=EX;status=2;fcode=0;abmodell=`"
..
.select edifact 'U|xcom'
..
..
.continue EL014 ? _(mehr)
.. IF014
