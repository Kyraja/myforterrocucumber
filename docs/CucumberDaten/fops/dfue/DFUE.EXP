.continue BRK004 ? _(G|menue = 1)
..
..
.continue ESAC002
!BRK004
.end
..
!ESAC002: =====   ENDCASE   =====
..
!EL013
.. FI013
..
.input DATEI.F
.output new 'xdfehler'
ID-Nummern der fehlerhaften EDI-Datenbank-DatensÑtze
----------------------------------------------------
.output new WERF.WEG
..
.. 2017-06: Abbildungsmodell muss leer sein
.formula U|xcom = "$,,;@gruppe=0;@ablage=(1);@zeilen=(0);imex=EX;status=2;fcode=0;abmodell=`"
.select edifact lock 'U|xcom'
..
..
!LOOP005: ==============================
.continue ELOP005 ? _(mehr)
..
.continue EL016 ? _(H|such/"AT*")
.. IF016
.. mh, 02.09.2008: zur Info
..
.. ATLAS-Nachrichten werden in der EDI-DB zu Archivierungszwecken
.. gespeichert, aber Åber eine ATLAS-Software versendet,
.. und nicht Unter Einsatz einer Konvertierungssoftware.
..
.. Theoretisch sollten die ATLAS-Nachrichten in sehr kurzer
.. Zeit (1 Sekunde) von Status 2 in Status 0 Åbergehen.
.. Scheitert dies fÅr die ATLAS-Nachrichten aus irgendeinen
.. Grund, kann hier ein Stau entstehen.
..
..
.continue FI016
!EL016
.. ich zÑhle mal mit, wieviel vorgÑnge es gibt
.formula xExportCnt = xExportCnt + 1
.. das returnflag fÅr die unterprogramme erst mal auf fehler
.formula xbreturn = false
.. fehlercode auf undefiniert setzen
.formula xfcode  = 99
.formula h|fcode = xfcode
.formula xEDINr = h|num
.rewrite
..
.. exportdatei erzeugen
.input DATEI.F
.output new 'xdExport'
..
.. öbertrag-Nr, Zeit, Datum eintragen, Sendedateiname vergeben
.. Transact no, Time, Date, Send-filename
.. * gets the protokoll for a given edi-transaction
.. * adds send date and time to the edi-transaction
.. * constructs the filename for sending
..
.. initialize filenames
.formula T|xdSendeDatei = ""
.formula T|xdEdiSendeDatei = ""
..
.. set params for finding protokoll
..
..
.. =====   CASE003   =====
.continue BRK005 ? _(h|vorart = xVorArtVKAU)
.. sales order confirmation, AuftragsbestÑtigung
.formula T|xvorgang = "VKAUB"
.formula T|xkunde   = 'h|idkundeab'
..
.continue ESAC003
!BRK005
.continue BRK006 ? _(h|vorart = xVorArtVKLS)
.. delivery note (sales), VK-LS -> do nothing for now
.continue ENDSEND
..
.continue ESAC003
!BRK006
.continue BRK007 ? _(h|vorart = xVorArtVKSP)
.. shipping orders, SpeditionsauftrÑge
.formula T|xvorgang = "VKLS"
.formula T|xkunde   = 'h|idkundeab'
..
.continue ESAC003
!BRK007
.continue BRK008 ? _(h|vorart = xVorArtVKRE)
.. invoices, Rechnungen
.formula T|xvorgang = "VKRE"
.formula T|xkunde   = 'h|idkunderab'
..
.continue ESAC003
!BRK008
.continue BRK009 ? _(h|vorart = xVorArtPRICAT)
.. product price list, Artikelpreisliste (PRICAT)
.formula T|xvorgang = "PRICAT"
.formula T|xkunde   = 'h|idkundeab'
..
.continue ESAC003
!BRK009
.continue BRK010 ? _(h|vorart = 3)
.. forecast delivery schedule (purchasing), Lieferabruf Einkauf
.formula T|xvorgang = "EKLAB"
.formula T|xkunde   = 'h|idabkunde'
..
.continue ESAC003
!BRK010
.. show error on screen
.output terminal
UNBEKANNTER VORGANG: 'h|vorart' in EDI-IdNr: 'h|num'
.formula T|xbreturn = false
.formula T|xfcode = 51
.continue ENDSEND
..
!ESAC003: =====   ENDCASE   =====
..
.. get protokoll for edi transaction type
.. note: T|xbreturn is set to 'false' by default, only if UebProtHolen succeeds it is set to 'true'
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
..
..
.continue EL017 ? _(T|xbreturn)
.. IF017
.. write current date and time into edi message
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC002
!RET002
.formula xprocsp = xprocsp - 1
..
.. building the path for send files is done in 3 steps
.. 1) make filename (without path) with fields from edi message / transaction
.. 2) strip non-compliant symbols (e.g. those that might mess up file operations)
.. 3) add directory name to path
..
..<META H|='P53:0' > 
..
.. =====   CASE004   =====
.continue BRK011 ? _(T|xvorgang = "VKAUB")
.. substitute H|idkundesab if both "werk" and "ablstelle" are empty
.formula T|xdSendeDatei    = "OSP" + 'idkunderab' + "_" + 'h|werk' + "_" + 'h|ablstelle'  ? _F|empty(H|werk) ; _F|empty(H|ablstelle)
.formula T|xdEdiSendeDatei = "OSP" + 'idkunderab' + "_" + 'h|werk' + "_" + 'h|ablstelle'  ? _F|empty(H|werk) ; _F|empty(H|ablstelle)
.formula T|xdSendeDatei    = "OSP" + 'idkunderab' + "_" + 'h|idkundesab'                  ?  F|empty(H|werk) &  F|empty(H|ablstelle)
.formula T|xdEdiSendeDatei = "OSP" + 'idkunderab' + "_" + 'h|idkundesab'                  ?  F|empty(H|werk) &  F|empty(H|ablstelle)
..
.continue ESAC004
!BRK011
.continue BRK012 ? _(T|xvorgang = "VKLS")
.. substitute H|idkundesab if both "werk" and "ablstelle" are empty
.formula T|xdSendeDatei    = "SP" + 'idkunderab' + "_" + 'h|werk' + "_" + 'h|ablstelle'   ? _F|empty(H|werk) ; _F|empty(H|ablstelle)
.formula T|xdSendeDatei    = "SP" + 'idkunderab' + "_" + 'h|idkundeab'                    ?  F|empty(H|werk) &  F|empty(H|ablstelle)
..
.continue ESAC004
!BRK012
.continue BRK013 ? _(T|xvorgang = "VKRE")
.formula T|xdSendeDatei    = "RG" + 'h|idkunderab'
.formula T|xdEdiSendeDatei = "RGE"+ 'h|idkunderab'
..
.continue ESAC004
!BRK013
.continue BRK014 ? _(T|xvorgang = "PRICAT")
.formula T|xdSendeDatei    = "PRI" + 'idkundeab'
..
.continue ESAC004
!BRK014
.continue BRK015 ? _(T|xvorgang = "EKLAB")
.formula T|xdSendeDatei    = "EKLAB" + 'h|idabkunde'
..
.continue ESAC004
!BRK015
..
..
!ESAC004: =====   ENDCASE   =====
..
..
.continue EL018 ? _(F|empty(T|xdSendeDatei))
.. IF018
.continue FI018
!EL018
.. replace non-compliant symbols in filename with underscore: blank, slash, dot (note regexpression syntax)
.formula T|xdSendeDatei = F|regreplaceall(T|xdSendeDatei, 'dblquote', "_")
.formula T|xdSendeDatei = F|regreplaceall(T|xdSendeDatei, " ", "_")
.formula T|xdSendeDatei = F|regreplaceall(T|xdSendeDatei, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^]", "_")
.. build path with directory + filename + extension
.formula T|xdSendeDatei = T|xSendeVerz + "/" + T|xdSendeDatei + "." + T|xtxt
..
!FI018
..
..
.continue EL019 ? _(F|empty(T|xdEdiSendeDatei))
.. IF019
.continue FI019
!EL019
.. replace non-compliant symbols in filename with underscore: blank, slash, dot
.formula T|xdEdiSendeDatei = F|regreplaceall(T|xdEdiSendeDatei, " ", "_")
.formula T|xdEdiSendeDatei = F|regreplaceall(T|xdEdiSendeDatei, 'dblquote', "_")
.formula T|xdEdiSendeDatei = F|regreplaceall(T|xdEdiSendeDatei, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^]", "_")
.. build path with directory + filename + extension
.formula T|xdEdiSendeDatei = T|xSendeVerz + "/" + T|xdEdiSendeDatei + "." + T|xtxt
..
!FI019
..
!EL017
.. FI017
..
.. end send filename finding
!SENDEND
..
..
.continue EL020 ? _(xbreturn)
.. IF020
.. FEHLERFREI: --> ASCII-Datei erzeugen und Protokoll schreiben
.formula xbreturn = false
..
.. ASCII-datei erzeugen und verschieben
.select lock header
.input 'xdDFUEEXPEDI2IHS'
.output new WERF.WEG
..
.. Deaktivierter Block
..
.continue EL021 ? _((xDFUEproto=3) & (h|vorart=xVorArtVKRE))
.. IF021
..xbEdiFehler = RÅckgabe-Status der EDIFACT-INVOICE-DATEI-ERZEUGUNG
..fo xbEdiFehler = false
.. exportdatei erzeugen
..ein DATEI.F
..aus auf 'xdEdiExport1'
..
..hol sperr kopf
..ein 'xdDfueExpEdi2INV'
..aus auf WERF.WEG
..
!EL021
.. FI021
..
.. Aus der Unix-datei eine Dos-datei machen
.formula xsys = "crlf+ < " + xdExport + " > " + xdExport2
.system 'xsys' background
.formula  xsys = "mv -f " + xdExport2 + " " + xdExport
.system 'xsys' background
..
..**ok,16.05.2002 (von s3-Zeichensatz in die ANSII-Datensatz konvertiert)
.formula  xsys = "s3_conv 3 " + xdExport
.system 'xsys' background
..
.. move file to export directory (sendeverzeichnis)
.. mh, 30.05.2011: shell command replaces use of dfue.cp.sh
.formula U|xsys = "mv -f " + xdExport + " " + xdSendeDatei
.system 'U|xsys' background
..
..
.continue EL022 ? _(mehr)
.. IF022
.formula xbreturn = true
.formula xfcode = 0
..
.continue FI022
!EL022
.formula xbreturn = false
.formula xfcode = 53
..
!FI022
..
.. status 0 -> ok
.formula h|status = 0
..**ok,14.08.2003 (jetzt hier ".bringe")
.rewrite
..
.. Protokolleintrag
.input DATEI.F
.output addedto 'xdProto'
..
.. sauber verarbeitet und exportiert
..**ok,10.01.2006 (jetzt zusÑtzlich EK-Lieferabruf)
..
