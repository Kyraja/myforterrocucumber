!PROC001: ----- UebProtHolen -----
.. öbertragungsprotokoll holen
.. invoices only get one transaction number, if an invoice is sent a second time,
.. it must ust the same transaction number (uebnr).
.. h buffer is edi message, if invoice has not beent sent, current uebnr in edi msg is 0
.. here: remember current uebnr
.formula T|xUebNrAktuell = H|uebnr
.formula U|xUebNrAktuell = "0" ? F|empty(H|uebnr)
.. remember uebnr/a to 'update' edi msg with its current uebnr/a after sending
.formula T|xUebNrNeu = H|uebnr
.formula T|xUebNrAlt = H|uebnra
.formula U|xUebNrAlt = "0" ? F|empty(U|xUebNrAlt)
..
.. ----------------------------------------
.reserve
.. erst mal kein protokoll
.formula xDFUEproto = -1
..
..
.continue EL001 ? _(+xkunde > 0)
.. IF001
..
.continue EL002 ? _(xvorgang<>"EKLAB")
.. IF002
.select customer lock 'xkunde'
..
.continue FI002
!EL002
.select supplier lock 'xkunde'
..
!FI002
..
..
.continue EL003 ? _(mehr)
.. IF003
.. ----------------------------------------
.select lock add edinfosnr
..
.continue EL004 ? _(mehr)
.. IF004
.select line lock
.formula xmehr = mehr
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(xmehr)
..
.continue EL005 ? _(h|vorgang = xvorgang)
.. IF005
..
.. =====   CASE001   =====
.continue BRK001 ? _(-h|protokoll = "VDA")
.formula xDFUEproto = 1
..
.continue ESAC001
!BRK001
.continue BRK002 ? _(-h|protokoll = "ODETTE")
.formula xDFUEproto = 2
..
.continue ESAC001
!BRK002
.continue BRK003 ? _(-h|protokoll = "EDIFACT")
.formula xDFUEproto = 3
..
.continue ESAC001
!BRK003
!ESAC001: =====   ENDCASE   =====
..
..
.continue EL006 ? _(h|vorgang="PRICAT")
.. IF006
..
!EL006
.. FI006
..
.. do not increment transaction number (uebnr)
.. if sending an invoice a second time!
..
..
.continue EL007 ? _(H|vorgang = "VKRE" & T|xUebnrAktuell <> "0")
.. IF007
.continue FI007
!EL007
.. alte und neue Åbertragungsnr
.formula xUebNrAlt  = h|uebnr
.formula U|xUebNrAlt = "0" ? F|empty(U|xUebNrAlt)
.formula xUebNrNeu  = h|uebnr
.. only increment if numeric
.formula U|xiuebnr = 0
.assign U|xiuebnr = H|uebnr
.assign U|xiuebnr = 0 ? F|empty(H|uebnr)
.formula U|xiuebnr = U|xiuebnr + 1  ?  G|mehr
.formula U|xUebnrNeu = 'U|xiuebnr' ? U|xiuebnr<>0
.formula h|uebnr    = xUebNrNeu
..
!FI007
..
.rewrite
.formula xmehr = false
.formula xbreturn = true
..
.continue FI005
!EL005
.select line lock
.formula xmehr = mehr
..
!FI005
..
.continue LOOP001
!ELOP001: ==============================
..
.continue FI004
!EL004
.formula xbreturn = false
.formula xfcode = 54
..
!FI004
..
.add
.. ----------------------------------------
..
.continue FI003
!EL003
.formula xbreturn = false
.formula xfcode = 52
..
!FI003
..
.continue FI001
!EL001
.formula xbreturn = false
.formula xfcode = 52
..
!FI001
..
.select
