..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : DELNOTECONFIG.TAB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : 
..*****************************************************************************
..<META M|='dfue/DELNOTECONFIG'>
.set trans -
.. 
.input "is/ABASFARBEN.DEF" ? _F|defined(U|xabasorange)
..
..<META H|='P0:2'>
..<META 2|='P0:4'>
.. 
.load 2 customer 'H|edinfosnr^id'
.continue END ? _G|mehr & M|kbmitediinfos 
.continue KUNDE ? _G|mehr
.. 
.load 2 line 'F|formatstr("$,,;edinachr={1}", "2108")'                
.load 2 line 'F|formatstr("$,,;edinachr=`;vorgang=={1}", "VKLS")' ? _G|mehr
.continue END ? _G|mehr & M|kbmitediinfos
.. 
..
.. Skipp jedi-configs
.continue KUNDE  ?  M|kbohnenachricht    
.continue KUNDE  ? _M|kbohnejedis ; _F|defined(2|ieabmodell)
.continue END    ?  M|kbohnejedis & _F|empty(2|ieabmodell)
.. 
!KUNDE
.make screen line +O
.colour -foreground -1 -1 -1 -background -1 -1 -1  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1  tedinachr  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1  tkunde     'M|aktzeile'
.formula M|tkunde = H|id
.formula M|tkundefirma = H|firma^id ? H|gruppe=2
.formula M|tkundewerk = H|werk ? H|gruppe=2
.formula M|tkundeablstelle = H|ablstelle ? H|gruppe=2
..
.. Message
.copy M|terlaubt = G|false
..
!CONFIG
.. Exit if no EDI-Settings
.continue END ? _F|defined(2|erlaubt)
.. 
.formula M|tkundeinfo = 2|id
.copy M|terlaubt = 2|erlaubt
.copy M|tprotokoll = 2|protokoll
.copy M|tedinachr = 2|edinachr
.copy M|tvorgang = 2|vorgang
.copy M|tzuoschema = 2|zuoschema
.copy M|tieabmodell = 2|ieabmodell
.copy M|tsortpack = 2|sortpack
.copy M|tpackmitnum = 2|packmitnum
.copy M|tpackte = 2|packte
.copy M|tpackohnenum = 2|packohnenum
.copy M|tpackzuartikel = 2|packzuartikel
.copy M|tpackzupmz = 2|packzupmz
.copy M|tnoexpdeckel = 2|noexpdeckel
.copy M|tnoexphfz = 2|noexphfz
.copy M|tintedi = 2|intedi
..
.colour -foreground -1 -1 -1 -background 'U|xabasorange' tedinachr 'M|aktzeile' ? F|empty(2|edinachr)
.colour -foreground -1 -1 -1 -background 'U|xabasorange' tkunde    'M|aktzeile' ? H|gruppe=1 & 'F|value(2|protokoll, "AS118")'="(VDA)"      
.. 
.load 2
.. 
..*****************************************************************************
!END
.continue
