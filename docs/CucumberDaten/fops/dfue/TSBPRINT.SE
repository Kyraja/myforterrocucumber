..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TSBPRINT.SE
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Screen Entry - read settings from TSB.INIT
..*****************************************************************************
..!meta M|=dfue/TSBPRINT
.set trans -
..
.. Default settings (TSB 3.5)
.formula M|ktsbverzeichnis = "win/tsb"
.formula M|kvdaverz = "in"
.formula M|kvdasuffix = ".VDA"
.formula M|ktsbverz = "out_tsb"
.formula M|ktsbsuffix = "_VDA4939.pdf"
.formula M|kgtlverz = "out_gtl"
.formula M|kgtlsuffix = "_GTL_0.pdf"
.. Wait-Duration for processing with Start-Button
.formula M|ksleep = 1
.formula M|kmaxwait = 5
.. 
.. 
.. Configured settings
.input "TSB.INIT"
.formula M|ktsbverzeichnis = U|xttsbverzeichnis ? F|defined(U|xttsbverzeichnis)
.formula M|kbtsbinstalliert = _F|empty(M|ktsbverzeichnis) & F|fileexists(M|ktsbverzeichnis) & F|isdir(M|ktsbverzeichnis)
.formula M|kvdaverz = U|xtvdaverz  ? F|defined(U|xtvdaverz)
.formula M|kvdasuffix = U|xtvdasuffix  ? F|defined(U|xtvdasuffix)
.formula M|ktsbverz = U|xttsbverz  ? F|defined(U|xttsbverz)
.formula M|ktsbsuffix = U|xttsbsuffix  ? F|defined(U|xttsbsuffix)
.formula M|kgtlverz = U|xtgtlverz  ? F|defined(U|xtgtlverz)
.formula M|kgtlsuffix = U|xtgtlsuffix  ? F|defined(U|xtgtlsuffix)
.formula M|ksleep = U|xisleep ? F|defined(U|xisleep)
.formula M|kmaxwait = U|ximaxwait ? F|defined(U|ximaxwait)
.. 
..*****************************************************************************
!END
.continue
