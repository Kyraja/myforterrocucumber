..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABRUFZENTRALE.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : common events for info system ABRUFZENTRALE
...Includes       :
..  include     dfue/ABRUFZENTRALE.INITZEITEN
..  include     dfue/ABRUFZENTRALE.TBUCHART.BA.FO
..*****************************************************************************
.set trans -
..
..  Event evaluation
.. ----------- ----- Header -------- -------------------------------------------
.continue CHBOOL  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbtage"
.continue CHBOOL  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbwochen"
.continue CHBOOL  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbmonate"
.continue CHBOOL  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kblieferungen"
.continue CHART   ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbzeigenach"
.continue CHART   ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbzeigevor"
.continue CHART   ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kmax"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbetreuer"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kkunde"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "krahmen"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kartikel"
.continue REFBOOL ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbrefvergangenheit"
.continue REFBOOL ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbrefneuster"
.continue REFBOOL ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbrefvorgaenger"
.continue ZEITEN  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kstichtag"
.continue ZEITEN  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kzeitraum"
.continue ZEITEN  ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kmaxzeitraum"
.continue EINST   ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbstandard"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbindivstatus"
.continue AFILTER ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbfilteralle"
.continue XFILTER ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbfilterfqgruen"
.continue XFILTER ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbfilterfqgelb"
.continue XFILTER ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbfilterfqrot"
.continue XFILTER ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbfilterrueckstand"
.continue XFILTER ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar = "kbfilterfwdiff"
.continue KENNZ   ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar / "kbkennz*"
.continue KENNZ   ?  G|evtartengl = "FIELD_EXIT"  &  G|evtvar / "kbliefer*"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!REFBOOL
.copy M|kbrefvergangenheit = G|false
.copy M|kbrefneuster = G|false
.copy M|kbrefvorgaenger = G|false
.formula M|.evtvar = G|true
.continue TABINIT
..
!CHBOOL
.copy M|kbtage = G|false
.copy M|kbwochen = G|false
.copy M|kbmonate = G|false
.copy M|kblieferungen = G|false
.formula M|.evtvar = G|true
.continue CHART
..
!CHART: redraw charts
.continue END  ?  M|tzeilen = 0
.continue END  ?  M|kchartzeile = 0
.continue END  ?  M|kchartzeile > M|tzeilen
.select screen line 'M|kchartzeile'  ?  M|kchartzeile <> M|aktzeile
.continue END  ? _G|mehr
.input "dfue/ABRUFZENTRALE.TBUCHART.BA.FO"
.continue END
..
!ZEITEN
.continue ERRZEIT  ?  M|kstichtag > G|datum
.continue NODATE   ?  F|empty(M|kstichtag)
.input "dfue/ABRUFZENTRALE.INITZEITEN"
.continue TABINIT
..
!EINST
.input "dfue/ABRUFZENTRALE.ME"
.continue END
..
!KENNZ
.input "dfue/ABRUFZENTRALE.AUSBLENDEN"
.continue END
..
!AFILTER
.copy M|kbfilterrueckstand = G|true  ?  M|kbfilteralle
.copy M|kbfilterfwdiff = G|true  ?  M|kbfilteralle
.copy M|kbfilterfqgruen = G|true  ?  M|kbfilteralle
.copy M|kbfilterfqgelb = G|true  ?  M|kbfilteralle
.copy M|kbfilterfqrot = G|true  ?  M|kbfilteralle
.. do not read deliveries when showing ALL forecasts (takes too long)
.copy M|kblieferungen = G|false  ?  M|kbfilteralle
.continue TABINIT
..
!XFILTER
.copy M|kbfilteralle = G|false ? _M|.evtvar
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.formula M|kchartzeile = 0
.continue END
..*****************************************************************************
!END
.continue
..
!ERRZEIT
.error Der Stichtag darf nicht in der Zukunft liegen!
.formula M|kstichtag = G|datum
.input "dfue/ABRUFZENTRALE.INITZEITEN"
.end 1
..
!NODATE
.error Geben Sie den Stichtag fÅr den Auswertungszeitraum an!
.end 1

