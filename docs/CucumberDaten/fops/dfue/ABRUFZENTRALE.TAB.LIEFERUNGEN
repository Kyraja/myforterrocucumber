.formula M|tlimge26 = 0.0
.formula M|tlimge27 = 0.0
.formula M|tlimge28 = 0.0
..
..
.load 1 sales 'F|formatstr("$,,;@gruppe=2;kotyp=={1};artikel=={2};tterm={3}!{4};kunde={5};kopf^uebertr=(No);@ablageart=(Both)", "(PackingSlip)", M|tartikel^id, M|kstartwt1:8, M|kstartwt28:8, M|tkunde^id)'
.continue END  ?  _G|mehr
..
!LIPO
.formula U|xnabdat = 1|tterm
..
.formula M|tlimge1  =  M|tlimge1  + 1|mge  ?  U|xnabdat >= M|kstartwt1   &  U|xnabdat < M|kstartwt2
.formula M|tlimge2  =  M|tlimge2  + 1|mge  ?  U|xnabdat >= M|kstartwt2   &  U|xnabdat < M|kstartwt3
