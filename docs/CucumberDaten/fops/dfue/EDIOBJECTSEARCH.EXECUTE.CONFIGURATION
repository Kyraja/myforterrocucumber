..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.EXECUTE.CONFIGURATION
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Execute edi object search according to configuration
..*****************************************************************************
.set trans -
..Load edi message into H buffer
.select nolock edifact 'M|edifact'
..
..Important: edi message is in buffer H, edi message is not locked before object search
.input "EDI.DO.OSEARCH.INIT"
..
!LINE
.load 6 line
.continue RETURN ? _G|mehr
.continue LINE   ? 6|vkt & _M|tabausf
..
.input '6|fopname'
.continue LINE
..
!RETURN
.input "EDIOBJECTSEARCH.ORDERS.REWRITE.EDI"
.input "EDI.DO.OSEARCH.FINISH"
..*****************************************************************************
!END
..release locks and buffers
.select -
.load 6 ? F|defined(6|id)
.continue
