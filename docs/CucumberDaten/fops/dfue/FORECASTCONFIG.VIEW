.set trans -
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue BOOL    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbabruffelder"
.continue BOOL    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbedifelder"
.continue BOOl    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbkdfelder"
.. ----------- ---------- ---------- -------------------------------------------
.continue VIEW
..
..
!BOOL
..opy M|kbabruffelder = G|false
..opy M|kbedifelder = G|false
..opy M|.evtvar = G|true
..
..
!VIEW  
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = P|maskkontextfop + " fop_tab_customer"  ?  M|kbkdfelder
.formula P|maskkontextfop = P|maskkontextfop + " fop_tab_edi"       ?  M|kbedifelder
.formula P|maskkontextfop = P|maskkontextfop + " fop_tab_forecast"  ?  M|kbabruffelder 
..
..*****************************************************************************
!END
.continue
