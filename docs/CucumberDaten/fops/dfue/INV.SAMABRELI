.select customer 'idkunderab'
..
..
.continue EL001 ? _(G|mehr)
.. IF001
.formula U|xRELIans1 = H|ans<<";"
.formula U|xRELIans2 = H|ans>>";"<<";"
.formula U|xRELIans3 = H|ans>>";">>";"
.formula U|xRELIstr  = H|str
.formula U|xRELIort  = H|nort
.formula U|xRELIplz  = H|plz
.formula U|xRELIland = H|lakenn
.formula U|xRELIfax  = H|fax
.formula U|xRELIstaat= H|staat
