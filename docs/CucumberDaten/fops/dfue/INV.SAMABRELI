..
.continue EL002 ? _(F|empty(U|xvreliempf))
.. IF002
.continue FI002
!EL002
.formula U|xRELIans1 = U|xvreliempf^ans<<";"
.formula U|xRELIans2 = U|xvreliempf^ans>>";"<<";"
.formula U|xRELIans3 = U|xvreliempf^ans>>";">>";"
.formula U|xRELIstr  = U|xvreliempf^str
.formula U|xRELIort  = U|xvreliempf^nort
.formula U|xRELIplz  = U|xvreliempf^plz
.formula U|xRELIland = U|xvreliempf^lakenn
.formula U|xRELIfax  = U|xvreliempf^fax
.formula U|xRELIstaat= U|xvreliempf^staat
