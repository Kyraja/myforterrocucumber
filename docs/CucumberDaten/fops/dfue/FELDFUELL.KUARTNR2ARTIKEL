..!interpreter english translate
..*****************************************************************************
.. FOP-Name       : FELDFUELL.KUARTNR2ARTIKEL
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Ermittelt den Artikel zu einer Kundenartikelnummer.
..                  Einsatz als Feldfuell-EFOP zu Artikel-Verweisen.
.. Functionality  : Find Product for a given customer product number.
..                  Use as field filled efop for Product references.
..*****************************************************************************
.set trans -
..
.. check if product exists
.type P2 xproduct
.assign U|xproduct = G|evtfeldneu
.continue END     ?  G|mehr
..
.. query customer product properties (cpp)
.type text xtselCPP
!SELCPP
.formula U|xtselCPP = "$,,;@gruppe=6;kuartnr==" + G|evtfeldneu
.load 1 parts 'U|xtselCPP'
.continue GARNIX  ? _G|mehr  &  -G|evtfeldneu <> G|evtfeldneu
.continue ENDCPP  ? _G|mehr
.assign U|xproduct = 1|art^id
.formula G|evtfeldneu = 1|art^id
!VERIFY: must be same product if multiple cpp entries exist
.load 1 parts
.continue ENDCPP  ? _G|mehr
.continue ERROR   ?  1|art^id <> U|xproduct^id
.continue VERIFY
!GARNIX
.. try again after normalizing customer product number, i.e. lower to upper case
.formula G|evtfeldneu = -G|evtfeldneu
.continue SELCPP
!ENDCPP
.load 1
..
..*****************************************************************************
!END
.continue
..
..
!ERROR
.error Dieser Kundenartikelnummer sind unterschiedliche Artikel zugeordnet.
.end 1

