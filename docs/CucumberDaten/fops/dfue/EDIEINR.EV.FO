..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIEINR.EV.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : handles events for info system EDIEINR,
..                  apply settings if the corresponding button is used,
..                  updates setting-information afterwards
..
...Includes       :
..  include dfue/EDIEINR.GETSETTINGS.FO
..
.. Other edi fo programs (should not be included)
..  dfue/DFUE.EXP.CHECK
..*****************************************************************************
.set trans -
..
..<META M|='dfue/EDIEINR' > 
..
..
.type text U|xSwVersand 
.type text U|xSwVerpackung 
.type text U|xIDBeipack
..
.type text U|xLader
.type text U|xLaderEDS
..
.. 
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue BUT01   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "aefop" 
.continue BUT02   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "zaefop"    
.continue BUT03   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "iempfverz"    
.continue BUT04   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "igaref"      
.continue BUT05   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "igaflag"     
.continue BUT06   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "iedlref"   
.continue BUT07   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "iedlflag"    
.continue BUT08   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "esendverz"    
.continue BUT09   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "elsefop"    
.continue BUT10   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "zelsefop"    
.continue BUT11   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "elszupos"    
.continue BUT12   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "zelszupos"    
.continue BUT13   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "elsversart"    
.continue BUT14   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "zelsversart"    
.continue BUT15   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "elsexpcheck"    
.continue BUT16   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "ereefop"    
.continue BUT17   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "zereefop"    
.continue BUT18   ?  G|evtartengl = "BUTTON_AFTER"   &  G|evtvar = "kbuprotverz"   
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!BUT01: EDI-EFOPs aktivieren
.continue END ? M|abefop
.system "cat dfue/fop.txt.allg >> fop.txt" background
.continue ERREFOP ? _G|mehr
.continue REFRESH
..
..
!BUT02: EDI-EFOPs zeigen
.editing "dfue/fop.txt.allg"
.continue END
..
..
!BUT03: Empfangsverzeichnis anlegen
.continue END ? M|ibempfverz 
.system 'F|formatstr("mkdir {1}", M|ziempfverz)' background
.continue ERREMP ? _G|mehr
.continue REFRESH
..
..
!BUT04: Gutschrift-Referenzdatensatz anlegen
.continue END ? M|ibgaref
.formula U|xLader = "dfue/CRE.INSLADVKGAV"
.continue ERRREF ? _F|fileexists(U|xLader)
.formula U|xLaderEDS = (("0000000000" + U|xLader ) >> 9) + "eds" 
.system 'F|formatstr("batchlg.sh LESELADER {1} {2}", U|xLader, U|xLaderEDS)' password background
.continue ERRREF ? _G|mehr
.continue REFRESH
..
..
!BUT05: Gutschrift-Flagfile anlegen
.continue END ? M|ibgaflag
.system 'F|formatstr("touch {1}/{2}", M|ziempfverz, "VKGAVOK")' background
.continue ERRFLAG ? _G|mehr
.continue REFRESH
..
..
!BUT06: EDL-Referenzdatensatz anlegen
.continue END ? M|ibedlref
.formula U|xLader = "dfue/VKEDL.REF"
.continue ERRREF ? _F|fileexists(U|xLader)
.formula U|xLaderEDS = (("0000000000" + U|xLader ) >> 9) + "eds" 
.system 'F|formatstr("batchlg.sh LESELADER {1} {2}", U|xLader, U|xLaderEDS)' password background
.continue ERRREF ? _G|mehr
.continue REFRESH
..
..
!BUT07: EDL-Flagfile anlegen
.continue END ? M|ibedlflag
.system 'F|formatstr("touch {1}/{2}", M|ziempfverz, "VKEDLOK")' background
.continue ERRFLAG ? _G|mehr
.continue REFRESH
..
..
!BUT08: Sendeverzeichnis anlegen
.continue END ? M|ebsendverz 
.system 'F|formatstr("mkdir {1}", M|zesendverz)' background
.continue ERRSEND ? _G|mehr
.continue REFRESH
..
..
!BUT09: Lieferschein-EFOPs anh„ngen
.continue END ? M|eblsefop
.system "cat dfue/fop.txt.lsdfue >> fop.txt" background
.continue ERREFOP ? _G|mehr
.continue REFRESH
..
..
!BUT10: Lieferschein-EFOPs zeigen
.editing "dfue/fop.txt.lsdfue"
.continue END
..
..
!BUT11: Zusatzpositionen anlegen
.continue END ? M|eblszupos
.input "dfue/DFUE.EXP.INI"
.formula U|xSwVersand = U|xSwVersand >> -1
.formula U|xSwVerpackung = U|xSwVerpackung >> -1
.formula U|xIDBeipack = U|xIDBeipack >> -1
.select parts 'U|xSwVersand'
.continue ERRSUP ? G|mehr
.select parts 'U|xSwVerpackung'
.continue ERRSUP ? G|mehr
.select parts 'U|xIDBeipack'
.continue ERRSUP ? G|mehr
.formula U|xLader = "dfue/LADER.ZUPOS"
.continue ERRSUP ? _F|fileexists(U|xLader)
.formula U|xLaderEDS = (("0000000000" + U|xLader ) >> 9) + "eds" 
.system 'F|formatstr("batchlg.sh LESELADER {1} {2}", U|xLader, U|xLaderEDS)' password background
.continue ERRSUP ? _G|mehr
.continue REFRESH
..
..
!BUT12: Zusatzpositionen zeigen
.input "dfue/DFUE.EXP.INI"
.formula U|xSwVersand = U|xSwVersand >> -1
.formula U|xSwVerpackung = U|xSwVerpackung >> -1
.formula U|xIDBeipack = U|xIDBeipack >> -1
.command -parallel 'F|formatstr("<(Part)>$,,;@gruppe=4;such=={1}<(View)>", U|xSwVersand)'
.command -parallel 'F|formatstr("<(Part)>$,,;@gruppe=4;such=={1}<(View)>", U|xSwVerpackung)'
.command -parallel 'F|formatstr("<(Part)>$,,;@gruppe=4;such=={1}<(View)>", U|xIDBeipack)'
.continue END
..
..
!BUT13: Versandarten anlegen
.continue END ? M|eblsversart
.formula U|xLader = "dfue/VERSANDART"
.continue ERRVART ? _F|fileexists(U|xLader)
.formula U|xLaderEDS = (("0000000000" + U|xLader ) >> 9) + "eds" 
.system 'F|formatstr("batchlg.sh LESELADER {1} {2}", U|xLader, U|xLaderEDS)' password background
.continue ERRVART ? _G|mehr
.continue REFRESH
..
..
!BUT14: Versandarten zeigen
.command -parallel "<(Company)>%,,such=VA-;schl=;namebspr=;@group=3;@range=(Yes);@autostart=(Yes)<(View)>"
.continue END
..
..
!BUT15: Export-Prfprogramm starten
.input "dfue/DFUE.EXP.CHECK"
.continue END
..
..
!BUT16: Rechnung-EFOPs anh„ngen
.continue END ? M|ebreefop
.system "cat dfue/fop.txt.vkre >> fop.txt" background
.continue ERREFOP ? _G|mehr
.continue REFRESH
..
..
!BUT17: Rechnung-EFOPs zeigen
.editing "dfue/fop.txt.vkre"
.continue END
..
..
!BUT18: Protokollverzeichnis anlegen
.continue END ? M|kbprotverz 
.system 'F|formatstr("mkdir {1}", M|kprotverz)' background
.continue ERRPROT ? _G|mehr
.continue REFRESH
..
..
!REFRESH
.input "dfue/EDIEINR.GETSETTINGS.FO"
..
..
..*****************************************************************************
!END
.continue
..
..
!ERREFOP
.error Die EFOPs konnten nicht aktiviert werden!
.end 1
..
!ERREMP
.error Das Empfangsverzeichnis konnte nicht angelegt werden!
.end 1 
..
!ERRFLAG
.error Das Flagfile konnte nicht angelegt werden!
.end 1
..
!ERRREF 
.error Der Referenzdatensatz konnte nicht angelegt werden!
.end 1
..
!ERRSEND
.error Das Sendeverzeichnis konnte nicht angelegt werden!
.end 1
..
!ERRPROT
.error Das Protokollverzeichnis konnte nicht angelegt werden!
.end 1
..
!ERRVART 
.error Versandarten konnten nicht angelegt werden!
.end 1
..
!ERRSUP
.error Zusatzpositionen konnten nicht angelegt werden!
.end 1
