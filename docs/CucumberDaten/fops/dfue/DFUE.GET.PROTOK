..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DFUE.GET.PROTOK
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Funktion       : Ermittelt das öbertragungsprotokoll
.. Functionality  : Find transmit protocoll
..
..    Argument          meaning
..    -------------------------------------------------------------------------
..    h/d buffer        customer/supplier
..    xvorgang          transmit protokoll, text
..    xedinachr         P109:2 / AuszÑhlung EDI-Nachricht
..    xmmvvl            <Modul><Vorgang><Vorgangstyp>    (optional)
..
..    Return value      meaning
..    -------------------------------------------------------------------------
..    xDFUEprotoTXT     VDA     EDIFACT ODETTE  other
..    xDFUEproto        1       3       2       4+
..    xintedi           customized program 1
..    xintedi           customized program 2
..    xidkuart          key, e.g. sorting of packaging materials
..    xediuebnr         last transmit number
..    xediaktiv         yes/no: xvorgang is active
..    xediauto          yes/no: processing xvorgang will be started automatically
..    xedimanu          yes/no: processing xvorgang has to be started manually
..    xedidrformat      print format (NT15)
..
..*****************************************************************************
.set trans -
..
.. required arguments
.type P109:2 xedinachr       ? _F|defined(xedinachr)
.type text   xvorgang        ? _F|defined(xvorgang)
.type text   xmmvvl          ? _F|defined(xmmvvl)
..
.. return values
.type text   xDFUEprotoTXT   ? _F|defined(xDFUEprotoTXT)
.type integer    xDFUEproto      ? _F|defined(xDFUEproto)
.type text   xintedi         ? _F|defined(xintedi)
.type text   xextedi         ? _F|defined(xextedi)
.type integer    xidkuart        ? _F|defined(xidkuart)
.type bool   xedlabwicklung  ? _F|defined(xedlabwicklung)
..
.. return true if active
.type bool   xediaktiv       ? _F|defined(U|xediaktiv)
.type bool   xediauto        ? _F|defined(U|xediauto)
.type bool   xedimanu        ? _F|defined(U|xedimanu)
.type text   xediuebnr       ? _F|defined(U|xediuebnr)
.type P92:1  xediabm         ? _F|defined(U|xediabm)
.type P92:1  xediieabm       ? _F|defined(U|xediieabm)
..
.. xintedi-variations
.type bool  xbintedikopf     ? _F|defined(U|xbintedikopf)
.type bool  xbintedipos      ? _F|defined(U|xbintedipos)
.type bool  xbintedikomplett ? _F|defined(U|xbintedikomplett)
.. local use
.type text  xtintediKP       ? _F|defined(U|xtintediKP)
..
.. invoice/shipping list recipient
.type VPK17 xvreliempf       ? _F|defined(U|xvreliempf)
..
.. print format
.type NT15  xedidrformat     ? _F|defined(U|xedidrformat)
..
.. local variables
.type VPK17  xvpartner       ? _F|defined(xvpartner)
.type text   xtselPROT       ? _F|defined(xtselPROT)
..
.. initialize return value
.formula U|xDFUEprotoTXT = ""
.formula U|xDFUEproto = -1
.formula U|xintedi = ""
.formula U|xextedi = ""
.formula U|xidkuart = 0
.copy U|xediaktiv = G|false
.copy U|xediauto = G|false
.copy U|xedimanu = G|false
.formula U|xediuebnr = "0"
.copy U|xedlabwicklung = G|false
.copy U|xbintedikopf = G|false
.copy U|xbintedipos = G|false
.copy U|xbintedikomplett = G|false
.formula U|xtintediKP = ""
.formula U|xvreliempf = ""
.formula U|xedidrformat = ""
.formula U|xediabm = ""
.formula U|xediieabm = ""
..
.. avoid d-buffer / h-buffer complication
.formula U|xvpartner = ""
.assign U|xvpartner = H|id      ?  F|defined(H|id)
.assign U|xvpartner = D|id      ?  F|defined(D|id)  &  F|empty(U|xvpartner)
..
.. 2012R1: no xvorgang but xmmvvl?
.formula U|xvorgang = U|xmmvvl  ?  F|empty(U|xvorgang) & F|empty(U|xedinachr) & _F|empty(U|xmmvvl)
..
.. check required arguments
.. must be customer or supplier database
.continue NOXVOR  ?  F|empty(U|xvorgang) & F|empty(U|xedinachr)
.continue NOKULI  ?  F|empty(U|xvpartner)
.continue NOKULI  ?  U|xvpartner^dnr <> 0 & U|xvpartner^dnr <> 1
..
.. query directly from edinfo rows
.formula U|xtselPROT = "$,,;@gruppe=4;@zeile=(1);erlaubt=yes"
.formula U|xtselPROT = U|xtselPROT + ";vorgang=`" + U|xvorgang          ?  F|empty(U|xedinachr)
.formula U|xtselPROT = U|xtselPROT + ";edinachr=" +  U|xedinachr^id     ? _F|empty(U|xedinachr)
.formula U|xtselPROT = U|xtselPROT + ";klnum="   + U|xvpartner^id
..
.load 9 customer 'U|xtselPROT'     ?  U|xvpartner^dnr = 0
.load 9 supplier 'U|xtselPROT'     ?  U|xvpartner^dnr = 1
.continue NOPROT  ? _G|mehr
.continue NOPROT  ?  9|selzeile = 0
.load 9 line '9|selzeile'
.continue NOPROT  ? _G|mehr
..
.. match / auto / manual
.copy U|xediaktiv = G|true
.copy U|xediauto = G|true   ?  9|vorgang / "*-A"
.copy U|xedimanu = G|true   ?  9|vorgang / "*-M"
.copy U|xediabm = 9|abmodell
.copy U|xediieabm = 9|ieabmodell
..
.. last transmit number
.formula U|xediuebnr = 9|uebnr
..
.. multi-purpose variable
.formula U|xidkuart = 9|idkuart
..
.. customer specific parameters: external service provider for shipping
.continue NOCUST ? 9|dnr<>0
.copy U|xedlabwicklung = G|true   ?  _F|empty(9|edlnum)  & _F|empty(9|umplatz)
!NOCUST
..
.. specific parameters: invoice/shipping list recipient
.formula U|xvreliempf = 9|reliempf^id
..
.. print format
.copy U|xedidrformat = 9|drformat
..
.. 2012R1: modify xintedi/xextedi with foppath (if F|foppath does not find a valid program, the function returns the empty string)
.formula U|xintedi  = F|foppath(9|intedi) ? _F|empty(9|intedi)
.formula U|xextedi  = F|foppath(9|extedi) ? _F|empty(9|extedi)
..
.. normalize protokoll
.formula U|xDFUEprotoTXT = -9|protokoll
..
.. VDA / ODETTE / EDIFACT
.formula U|xDFUEproto = 1    ?  U|xDFUEprotoTXT = "VDA"
.formula U|xDFUEproto = 2    ?  U|xDFUEprotoTXT = "ODETTE"
.formula U|xDFUEproto = 3    ?  U|xDFUEprotoTXT = "EDIFACT"
..
.. xintedi-variations for invoices using edifact programs VKRE/ODETTE, VKRE/EDIFACT
.continue EINTEDI  ?  F|empty(U|xintedi) ; 9|vorgang<>"VKRE" ; U|xDFUEproto < 2 ; U|xDFUEproto > 3
.formula U|xtintediKP = (( xintedi <$ ("."+(xintedi>$".")) ) >>1)
.formula U|xbintedikopf = U|xtintediKP="K"
.formula U|xbintedipos = U|xtintediKP="P"
.formula U|xbintedikomplett = _(U|xbintedipos;U|xbintedikopf)
!EINTEDI
..
.. release buffer!
.load 9
..*****************************************************************************
!END
.continue
..
..
!NOXVOR
.error Fehler bei Ermittlung des öbertragungs-Protokolls: Keine Vorgangsart angegeben.
.end 1
..
!NOKULI
.error Fehler bei Ermittlung des öbertragungs-Protokolls: Keine Handelspartner angegeben.
.end 1
..
!NOPROT
.note Die EDI-Nachricht 'U|xedinachr^sucherw' ist fÅr den Handelspartner 'U|xvpartner^sucherw' ('U|xvpartner^nummer') nicht aktiviert.
.formula U|xDFUEprotoTXT = ""
.formula U|xDFUEproto = 0
.continue
