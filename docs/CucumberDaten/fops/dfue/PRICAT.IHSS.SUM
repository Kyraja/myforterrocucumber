..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.IHSS.SUM
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Construct message ABPRICAT
.. 
..  1       UNZI Muss    1  Zaehler fuer Satzarten 
..  
..*****************************************************************************
.set trans - 
..
.type text xtversion1 ? _F|defined(U|xtversion1)
.copy U|xtversion1 = "01"
..
.type text xUNZI
.formula U|xUNZI = "UNZI"
..
.output addedto 'M|dateiname'
.input "DATEI.F"
'U|xUNZI'#'U|xtversion1'########################
.output
..
..*****************************************************************************
!END
.continue
