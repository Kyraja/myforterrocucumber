..>> <ABAS-Modul><Vorgang><Vorgangstyp> (Kleinbuchstaben)
.formula xntemp = "X" + xmmvvl + panummer + ".TMP"
.formula xsybefehl = "echo " + xmmvvl + "|awk '{ print tolower($1) }' > " + xntemp
.system 'xsybefehl'
