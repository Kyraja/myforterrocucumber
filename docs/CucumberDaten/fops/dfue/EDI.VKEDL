..>> Name der stdout-Protokoll-Datei fÅr Lader-Batch-LG
.formula xnbatchlogoutl = xnverzout + "/" + xnbatchlogoutl ? xnbatchlogoutl <> "" & xnverzout <> ""
..>> Name der stderr-Protokoll-Datei fÅr Lader-Batch-LG
.formula xnbatchlogerrl = xnverzerr + "/" + xnbatchlogerrl ? xnbatchlogerrl <> "" & xnverzerr <> ""
..>> Name der stdout-Protokoll-Datei fÅr öberwachungs-Batch-LG
