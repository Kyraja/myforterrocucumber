.. >> abas-Post, Fehlerprotokoll in Empfangsverzeichnis
..>> Merken Uhrzeit
.formula xsekundenz = sekundenz
..
..>> Sichern Protokoll korrigierte Fehler
.. Fehler und Warnungen sichern
.formula xntemp = xtmpdir + "XIAV.IMP.T" + 'panummer' + ".TMP"
.formula xsybefehl = "mv " + xnfprotokollerw + " " + xntemp
.system 'xsybefehl' background
..
.. Namen Kopie der Daten- und Protokoll-Datei sowie Protokoll
..>> Name der Daten-Datei
.set trans +
.formula xsybefehl = "echo " + dblquote + "Daten-Datei:     " + xEmpfangsVerz + xmmvvl + xsekundenz + dblquote + " > " + xnfprotokollerw
.system 'xsybefehl' background
..>> Name der Protokoll-Datei
.formula xsybefehl = "echo " + dblquote + "Protokoll-Datei: " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR" + dblquote + " >> " + xnfprotokollerw
.set trans -
.system 'xsybefehl' background
..>> Leerzeile
.formula xsybefehl = "echo '' >> " + xnfprotokollerw
.system 'xsybefehl' background
..>> Protokoll
.formula xsybefehl = "cat " + xntemp + " >> " + xnfprotokollerw
.system 'xsybefehl' background
..
..>>  Setzen Parameter fÅr nachfolgende Prozedur: Warnung
.formula xistfehler = true
.set trans +
.formula xPostBetreffErw = ": Operationen mit Warnungen ausgefÅhrt (siehe Freitext 1)"
.formula xPostStichw4Erw = "Warnung"
.set trans -
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC002
!RET001
.formula xprocsp = xprocsp - 1
..
.. Fehler und Warnungen wiederherstellen
.formula xsybefehl = "mv " + xntemp + " " + xnfprotokollerw
.system 'xsybefehl' background
..
.. >> Kopieren Fehlerprotokoll in Empfangsverzeichnis
..>> Protokoll
.set trans +
.formula xsybefehl = "echo " + 'datum' + ", " + 'zeit' + ", Fehler in INHOUSE-Schnittstellen-Datei: " + xmmvvl + xsekundenz + " > " + xEmpfangsVerz + xmmvvl + xsekundenz + ".ERR"
.set trans -
