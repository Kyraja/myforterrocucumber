..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : DELNOTECONFIG.START.BB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : 
...Includes
..  include dfue/DELNOTECONFIG.PROTECTION.BEFORE.FO
..  include dfue/DELNOTECONFIG.PROTECTION.AFTER.FO
..*****************************************************************************
..<META M|='dfue/DELNOTECONFIG'>
.set trans -
..
.make screen line --
..
.input "DELNOTECONFIG.PROTECTION.BEFORE.FO"
.. 
.copy M|kbanlegen = G|false
.copy M|kbloeschen = G|false
.copy M|kbkonfigurieren = G|false
.copy M|kbaktivieren = G|false
.copy M|kbdeaktivieren = G|false
..
.copy M|kbohnenachricht = G|false
.formula M|select = F|formatstr("$,,;@gruppe=2;@ordnung=nummer;such={1};nummer={2}!{3};firma={4}", M|kkundesuch, M|kkundevon^nummer, M|kkundebis^nummer, M|khauptkunde^id) ? _F|empty(M|khauptkunde)
.formula M|select = F|formatstr("$,,;@gruppe=1.2;@ordnung=nummer;such={1};nummer={2}!{3}", M|kkundesuch, M|kkundevon^nummer, M|kkundebis^nummer)         ?  F|empty(khauptkunde)
.formula M|select = M|select + ";edinfosnr<>`" ? M|kbmitediinfos
.continue END
.. 
..*****************************************************************************
!END
.continue
