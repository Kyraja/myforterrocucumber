..!interpreter english translate
.continue INI
..*******************************************************************************************************
..*
..*  Programmname : DRUCK.VORGANG
..*
..*  Autor        : Holger Klein ais
..  Verantwortlich    : mh
..* 
..*  am           : 17.04.2000
..*  GeÑndert am  : 26.02.2001, Ozan Kesim
..*  Funktion     : Ruft Druckprogramme auf, um VorgÑnge aus der EDI Datenbank zu drucken
..*
..*  Bemerkung    :
..*
..==  Aenderungshistorie:
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#LAB#16.10.2002#0#ok#
..#KOR#LAB#07.01.2003#1#ok# (xarb wurde entfernt)
..#KOR#EDL#07.02.2003#2#ok# (erweitert um EDL)
..#KOR#EDI#08.12.2003#3#ok#
..#KOR#EDI#23.04.2004#4#ok#
..*
..*
..*******************************************************************************************************
!INI
.set trans +
.type integer  xi1zaehl
.type text xtvorgang
..**ok,23.04.2004 (neue Variable xttvorgang)
.type text xttvorgang
..**ok,23.04.2004 (xfunktion definiert)
.type text xfunktion
..**ok,23.04.2004 (xmenue definiert)
.type integer  xmenue
.type text xtbereich
.type text xtproglab
.type text xtprogfab
.type text xtprogorder
.type text xtprogls
.type text xtprogre
.type text xtfotmp
..**ok,08.12.2003 (neue Variablen definiert)
.type text xtprogga xtprogab xtprogreinv xtproglsneu xtprogpricat
.input "ARB"
................................................ Name der *.INI Datei
..**ok,07.01.2003 (xarb wurde entfernt)
.formula xtfotmp       = "dfue/DFUE.IMP.INI"
.input 'xtfotmp'
................................................ EDI Druckprogramme
..**ok,07.01.2003 (xarb wurde entfernt)
.formula  xtproglab    = "DRUCK.LAB"
.formula  xtprogfab    = "DRUCK.FAB"
.formula  xtprogorder  = "DRUCK.ORD"
.formula  xtprogls     = "DRUCK.LS"
.formula  xtprogre     = "DRUCK.RE"
.formula  xtprogedl    = "DRUCK.EDL"
.formula  xtprogga     = "DRUCK.GA"
.formula  xtprogab     = "DRUCK.AB"
.formula  xtprogreinv  = "DRUCK.REINV"
.formula  xtproglsneu  = "DRUCK.LSNEU"
.formula  xtprogpricat = "DRUCK.PRICAT"
.continue MAIN0
..
!MAIN0
.output terminal
AUSGABE VON EDI VorgÑngen
=========================

.menu AuswahlmenÅ
?1 Nummernbereich 'xtbereich'        >> .continue M1AIN0   ? +xtbereich <> 0
?1 Nummernbereich  - ALLE -          >> .continue M1AIN0   ? +xtbereich  = 0
?2 Vorgang        'xttvorgang'       >> .continue M2AIN0   ? +xttvorgang <> 0
?2 Vorgang         - ALLE -          >> .continue M2AIN0   ? +xttvorgang  = 0
3 Selektion Åber Leiste              >> .continue M3AIN0
4 Verarbeitung starten               >> .continue M4AIN0
5 Programm beenden                   >> .continue ENDE0
.continue ENDE0                            ? menu =0
.continue M1AIN0
..
!M1AIN0
.formula xtbereich = ""
.read "Bitte geben Sie den Bereich ein" xtbereich
.continue MAIN0
..
!M2AIN0
.formula xtvorgang = ""
.output terminal
..**ok,08.12.2003 (mehrere MenÅpunkte fÅr EDL-Meldungen)
..**ok,23.04.2004 (noch mehr MenÅpunkte fÅr EDL-Meldungen)
..**ok,23.04.2004 (xfunktion initialisiert)
.formula xfunktion = ""
Vorgang eingeben
.menu AuswahlmenÅ
1  Lieferabruf  (VDA)     >> .formula xtvorgang = "LAB"
2  Feinabruf    (VDA)     >> .formula xtvorgang = "FAB"
3  Rechnung     (VDA)     >> .formula xtvorgang = "RE"
4  Lieferschein (VDA)     >> .formula xtvorgang = "LS"
5  EDL-Meldungen (Entnahme)         >> .formula xfunktion = "36"
6  EDL-Meldungen (Eingang)          >> .formula xfunktion = "30"
7  EDL-Meldungen (Bestand)          >> .formula xfunktion = "35"
8  EDL-Meldungen (Transportschaden) >> .formula xfunktion = "32"
9  EDL-Meldungen (RÅcksendung)      >> .formula xfunktion = "33"
10 EDL-Meldungen (Alle)             >> .formula xfunktion = ""
11 Gutschriften           >> .formula xtvorgang = "GA"
12 Auftrag      (EDIFACT) >> .formula xtvorgang = "ORD"
13 Lieferschein (EDIFACT) >> .formula xtvorgang = "LSNEU"
14 Rechnung     (EDIFACT) >> .formula xtvorgang = "REINV"
15 Artikelpreisliste      >> .formula xtvorgang = "PRICAT"
16 AuftragsbestÑtigung    >> .formula xtvorgang = "AB"
17 ZurÅck (keine Auswahl)  >>
..**ok,23.04.2004 (MenÅtexte definiert)
.formula xttvorgang = "Lieferabruf  (VDA)"        ? xtvorgang = "LAB"
.formula xttvorgang = "Feinabruf    (VDA)"        ? xtvorgang = "FAB"
.formula xttvorgang = "Rechnung     (VDA)"        ? xtvorgang = "RE"
.formula xttvorgang = "Lieferschein (VDA)"        ? xtvorgang = "LS"
.formula xttvorgang = "EDL-Meldungen (Entnahme)"  ? xfunktion = "36"
.formula xttvorgang = "EDL-Meldungen (Eingang)"   ? xfunktion = "30"
.formula xttvorgang = "EDL-Meldungen (Bestand)"   ? xfunktion = "35"
.formula xttvorgang = "EDL-Meldungen (Transportschaden)" ? xfunktion = "32"
.formula xttvorgang = "EDL-Meldungen (RÅcksendung)"      ? xfunktion = "33"
.formula xttvorgang = "EDL-Meldungen (Alle)"      ? xfunktion = "" & xtvorgang =""
.formula xmenue     = G|menue
.formula xttvorgang = "Gutschriften"              ? xtvorgang = "GA"
.formula xttvorgang = "Auftrag      (EDIFACT)"    ? xtvorgang = "ORD"
.formula xttvorgang = "Lieferschein (EDIFACT)"    ? xtvorgang = "LSNEU"
.formula xttvorgang = "Rechnung     (EDIFACT)"    ? xtvorgang = "REINV"
.formula xttvorgang = "Artikelpreisliste"         ? xtvorgang = "PRICAT"
.formula xttvorgang = "AuftragsbestÑtigung"       ? xtvorgang = "AB"
.continue MAIN0
..
!M3AIN0
.select edifact "%?"
.continue MAIN1
..
!M4AIN0:......... FÅr verschiedene VorgÑnge werden Selektionsleisten aus dem
.................. VDA Standart benutzt
.formula xtsel = xSELEDLABId + ",sinhouse=500;num53=" + xtbereich                     ?  xtvorgang = "LAB"
.formula xtsel = xSELEDFABId + ",sinhouse=800;num53=" + xtbereich                     ?  xtvorgang = "FAB"
..**ok,08.12.2003 (jetzt auch EDIFACT-Auftrag)
.formula xtsel = xSELEDSEId  + ",vorart=3!3;such53=VKAUE;num53 ="  + xtbereich        ?  xtvorgang = "ORD"
..**ok,08.12.2003 (jetzt auch EDIFACT-Rechnung)
.formula xtsel = xSELEDSEId  + ",vorart=5!5;such53=VKREVA;num53 ="  + xtbereich       ?  xtvorgang = "RE"
.formula xtsel = xSELEDSEId  + ",vorart=5!5;such53=VKREEA;num53 ="  + xtbereich       ?  xtvorgang = "REINV"
..**ok,08.12.2003 (AuftragsbestÑtigung vorart=23 NEU)
.formula xtsel = xSELEDSEId  + ",vorart=23!23;num53=" + xtbereich                     ?  xtvorgang = "AB"
..**ok,08.12.2003 (jetzt auch EDIFACT-Lieferschein)
.formula xtsel = xSELEDSEId  + ",vorart=25!25;such53=VKSPVA;num53=" + xtbereich       ?  xtvorgang = "LS"
.formula xtsel = xSELEDSEId  + ",vorart=25!25;such53=VKDESADV;num53=" + xtbereich     ?  xtvorgang = "LSNEU"
..**ok,08.12.2003 (bei EDL jetzt mehrere MenÅpunkte)
.formula xtsel = xSELEDSEId  + ",vorart=27!27;funktion=" + xfunktion + ";num53=" + xtbereich ? (xfunktion="32" ; xfunktion="33" ; xfunktion="35" ; xfunktion="36" ; xfunktion="30") ; (xfunktion = "" & xtvorgang ="")
..**ok,08.12.2003 (Artikelpreisliste vorart=33 NEU)
.formula xtsel = xSELEDSEId  + ",vorart=33!33;num53=" + xtbereich                     ?  xtvorgang = "PRICAT"
..**ok,08.12.2003 (Gutschrift vorart=55 NEU)
.formula xtsel = xSELEDSEId  + ",vorart=55!55;num53=" + xtbereich                     ?  xtvorgang = "GA"
.formula xtsel = xSELEDSEId  + ",num53="              + xtbereich                     ? +xtvorgang = 0  & xfunktion = "" & xmenue<>10
.select edifact 'xtsel'
.continue MAIN1
..
!MAIN1
.continue ENDE0                         ? _mehr
.input DRUCKER
.input BLANKOB.F
.continue MAIN2
..
!MAIN2
..**ok,08.12.2003 (um neue Programmaufrufe erweitert)
.input 'xtprogorder'                    ? H|vorart = 3   & H|such="VKAUE"
.input 'xtproglab'                      ? H|vorart = 3   & H|sinhouse / "*500*"
.input 'xtprogfab'                      ? H|vorart = 3   & H|sinhouse / "*800*"
.input 'xtprogre'                       ? H|vorart = 5   & H|such="VKREVA"
.input 'xtprogreinv                     ? H|vorart = 5   & H|such="VKREEA"
.input 'xtprogab'                       ? H|vorart = 23
.input 'xtprogls'                       ? H|vorart = 25  & H|such="VKSPVA"
.input 'xtproglsneu'                    ? H|vorart = 25  & H|such="DESADV"
.input 'xtprogedl'                      ? H|vorart = 27
.input 'xtprogpricat'                   ? H|vorart = 33
.input 'xtprogga'                       ? H|vorart = 55
.select edifact
.continue ENDE0                         ? _mehr ; ( +xtbereich<> 0 &  _xtbereich / "*!*")
.continue MAIN2
..
!ENDE0
..**ok,16.10.2002 (statt .ende . jetzt nur .ende)
.end
