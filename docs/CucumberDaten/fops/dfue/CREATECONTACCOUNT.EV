..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CREATECONTACCOUNT.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type text xsel
..
.continue BUARTIKEL ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buartikel"
.continue KTOFUEHR  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ktofuehr"
.continue KREISLAUF ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kreislauf"
.continue ARTIKEL   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "artikel"
.continue ALL       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "all"
.continue END
..
!ALL
.continue TABLEEREN
..
!KTOFUEHR
.continue TABLEEREN
..
!KREISLAUF 
.continue KLEEREN    ? F|empty(M|kreislauf)
.formula M|bezkreislauf = M|kreislauf^name
.continue TABLEEREN
..
!BUARTIKEL
.formula U|xsel = "%,,nummer=;such=;packmit=ja;vpkenn=(ReturnablePackaging);@gruppe=1;@ablageart=lebendig"
.load 1 parts 'U|xsel'
.formula M|artikel = ""  ? _G|mehr
.continue TABLEEREN      ? _G|mehr
.formula M|artikel = 1|id
..
!ARTIKEL 
.continue ALEEREN    ? F|empty(M|artikel)
.continue ERROR1        ? _M|artikel^packmit
.continue ERROR2        ?  F|value(M|artikel^vpkenn, "AS189") <> "(ReturnablePackaging)"
.continue TABLEEREN
..
!KLEEREN
.formula M|bezkreislauf = ""
.continue TABLEEREN
..
!ALEEREN
.formula M|bezart = ""
.continue TABLEEREN
..
!TABLEEREN
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR1
.error -field M|artikel -message Artikel ist kein Packmittel!
.formula M|artikel = ""
.end 1
..
!ERROR2
.error -field M|artikel -message Packmittel ist keine Mehrwegverpackung!
.formula M|artikel = ""
.end 1
