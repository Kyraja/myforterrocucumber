..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CREDITNOTE.ORIG.SUM
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
..!meta M|=dfue/CREDITNOTE
..!meta H|=P53
.set trans -
..
.select header
.. 
!ROWS
.select line
.continue EROWS ? _G|mehr
.continue SUM0  ?  H|text1="SUM0"
.continue SUM1  ?  H|text1="SUM1"
.continue SUM2  ?  H|text1="SUM2"
.continue ROWS
.. 
!SUM0
.. sum by packaging slip
.. not used
.. .formula M|ksumsteuer = H|text6
.. .formula M|ksumsteuer = M|ksumsteuer * -1 ? H|text8<>"1"
.. .formula M|ksumpreise = H|text7
.. .formula M|ksumpreise = M|ksumpreise * -1 ? H|text8<>"1"
.. Except for currency in case it is missing in SUM1
.formula M|kgawaehrung = H|text9
.continue ROWS
.. 
!SUM1
.. sum by credit note
.formula M|kgasumsteuer = H|text7
.formula M|kgasumsteuer = M|kgasumsteuer * -1 ? H|text9="2"
.formula M|kgasumbrutto = H|text8
.formula M|kgasumbrutto = M|kgasumbrutto * -1 ? H|text9="2"
.formula M|kgawaehrung = H|text10 ? _F|empty(H|text10)
.continue ROWS
.. 
!SUM2
.. sum by edi message = several credit notes
.. abas splits credit notes into several messages
.. values in SUM2 should equal values in SUM1
.continue ROWS 
!EROWS
..
..*****************************************************************************
!END
.continue
