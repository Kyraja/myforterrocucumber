..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : INVOICE.GET.TAXED
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
..
..!meta H|=P3:1
.continue NOINVOI ? _F|defined(H|id)
.continue NOINVOI ? H|dnr<>3 ; H|gruppe<>1 ; ('F|value(H|typ, "AS5")'<>"(Invoice)")
..
..!meta 3|=P3:1
.load 3 nolock sales 'H|id'
.continue NOINVOI ? _G|mehr
..
..
.. Return values: yes/no has tax lines
.type bool invoiceHasTaxedTotals ? _F|defined(U|invoiceHasTaxedTotals)
.type bool invoiceHasTaxfreeNoTaxedTotals ? _F|defined(U|invoiceHasTaxfreeNoTaxedTotals)
.copy U|invoiceHasTaxedTotals = G|false
.copy U|invoiceHasTaxfreeNoTaxedTotals = G|false
..
!NEXT
..!meta 3|=P3:2
.load 3 nolock line
.continue ELINES ? _G|mehr
.continue NEXT ?  'F|value(3|typ, "AS5")'<>"(VATInputTaxItem)" & 'F|value(3|typ, "AS5")'<>"(VATInputTaxItemInclusive)" 
.. has tax totals with net value / has tax totals with zero value
.copy U|invoiceHasTaxfreeNoTaxedTotals = G|true ? 3|pwert=0.0
.copy U|invoiceHasTaxedTotals = G|true ? 3|pwert<>0.0
.continue NEXT
!ELINES
.. 
.load 3
..
..*****************************************************************************
!END
.continue
..
.. 
!NOINVOI 
.error Zur Auswertung der Steuersaetze muss eine Verkaufsrechnung im Hole-Puffer sein.
.end 1
