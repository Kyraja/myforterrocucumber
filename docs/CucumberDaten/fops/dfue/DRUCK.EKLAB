..!interpreter english translate
.continue INI
..*******************************************************************************************************
..*
..*  Programmname : DRUCK.EKLAB
..*
..*  Autor        : Ozan Kesim
..*
..*  am           : 01.09.2005
..*  Funktion     : Druckt Einkauf-LABs aus der EDI Datenbank aus
..*
..*  Bemerkung    : Ist Unterprogramm von DRUCK.VORGANG
..*
..#KOR#EDI-MODUL#DATUM#ŽNDERUNGS-INDEX#Mitarbeiterkrzel#
..#KOR#LAB#01.09.2005#0#ok#
..*
..*
..*******************************************************************************************************
.set trans +
!INI
.type text   xtfotmp
.type integer    xi1zaehl
.type text   xdtmp
.type bool   xbzeitraum x1art
.continue START
..
!START
.up
.page 1
?EDI-ID: 'H|num   '                                                    Mandant: 'mandant '       ? H|tzeilen > 0
?vom   : 'H|dinhouse '              VDA - Lieferabruf                  Datum  : 'datum   '       ? H|tzeilen > 0
?Zeit  : 'H|zinhouse '                 (Einkauf)                       Seite  : 'seite   '       ? H|tzeilen > 0
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
.continue MAIN0
..
!MAIN0
.select line
.continue ENDE0       ? _mehr
.continue MUNBI       ?  H|text1 / "*UNBI*"
.continue MBGMI       ?  H|text1 / "*BGMI*"
.continue MRFH1       ?  H|text1 / "*RFH1*"
.continue MRFH2       ?  H|text1 / "*RFH2*"
.continue MBUY1       ?  H|text  / "*BUY1*"
.continue MRFL1       ?  H|text1 / "*RFL1*"
.continue MQTY1       ?  H|text1 / "*QTY1*"
.continue MART1       ?  H|text1 / "*ART1*"
.continue MPAC1       ?  H|text1 / "*PAC1*"
.continue MAIN0
..
!MUNBI
Lieferantennummer  : 'H|text6             '   Kundennummer       : 'H|text3               '
šbertragungsdat    : 'H|text15            '
šbertragungs-Nr Alt: 'H|text12            '   šbertragungs-Nr Neu: 'H|text13              '
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
Eing.F.Zahl-Datum  : 'H|text9             '
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
.continue MAIN0
..
!MBGMI
LAB-Datum neu      : 'H|text4             '   LAB-Nummer neu   :  'H|text3                '
?------------------------------------------------------------------------------------------      ? H|tzeilen > 0
.continue MAIN0
..
!MBUY1
Werk-Kunde         : 'H|text6             '   Abladestelle     :  'H|text7                '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
Kundenzeichen      : 'H|text13            '
Mengeneinheit      : 'H|text14            '   Anlieferungsint. :  'H|text15               '
Fertigungsfreigabe : 'H|text16            '   Verwendungsschl. :  'H|text18               '
Materialfreigabe   : 'H|text17            '   Kontierungsschl. :  'H|text19               '
Abschluánummer     : 'H|text11            '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!MRFH1
LAB-Datum alt      : 'H|text13            '   LAB-Nummer alt   :  'H|text12               '
Erfass. Dat. l. Ls : 'H|text8             '   LS-Nr l. Eingang :  'H|text7                '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!MRFH2
Mge letzter Eingang: 'H|text14            '   Eingangfort. Zahl:  'H|text13               '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!MRFL1
.formula xdtmp      = ""
.formula xbzeitraum = true                                                                           ?  H|text13 / "*555555*"
.formula xbzeitraum = false                                                                          ?  H|text13 / "*333333*" ; H|text13 / "*444444*" ; H|text13 / "*222222*" ; H|text13 / "*999999*"
..
.formula xdtmp      = H|text13>> 2 + "." + (H|text13 >> 4) << 2  + "." +  H|text13 << 4              ? _xbzeitraum
.formula xdtmp      = H|text13                                                                       ?  xbzeitraum
.continue MAIN0
..
!MART1
.continue MAIN0 ? x1art=true
Sachnummer Kunde   : 'H|text3             '   Sachnr. Lief.    :  'H|text4                '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.formula x1art = true
.continue MAIN0
..
!MQTY1:............................ Hier werden die LAB Positionen ausgegeben / šberschrift nur einmal ausgeben
.formula xi1zaehl   = xi1zaehl + 1
?PosNr     Termin             Bemerkung                      Menge                              ?   xi1zaehl = 1
?------------------------------------------------------------------------------------------     ?   H|tzeilen > 0  & xi1zaehl = 1
?'xi1z ''xdtmp       '                                       'H|text7                '          ? _(xdtmp / "*222222*" ; H|text4 / "*333333*" ; xdtmp / "*444444*" ; xdtmp / "*555555*" ; xdtmp / "*999999*" )
?'xi1z ''xdtmp       '        KEIN BEDARF !                  'H|text7                '          ?   xdtmp / "*222222*"
?'xi1z ''xdtmp       '         RšCKSTAND  !                  'H|text7                '          ?   xdtmp / "*333333*"
?'xi1z ''xdtmp       '        SOFORTBEDARF!                  'H|text7                '          ?   xdtmp / "*444444*"
?'xi1z ''xdtmp       '    ABRUFZEITRAUM - ANGABEN folgen     'H|text7                '          ?   xdtmp / "*555555*"
?'xi1z ''xdtmp       '      VORSCHAUMENGEN!                  'H|text7                '          ?   xdtmp / "*999999*"
.continue MAIN0
..
!MPAC1
Sachnr. Kunde Packm: 'H|text4             '   Sachnr.Lief.Packm: 'H|text5                 '
Fassungsverm”gen   : 'H|text6             '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.continue MAIN0
..
!M524
.formula xtfotmp = H|text4 + H|text5 + H|text6
Lieferabruf-Text   : 'xtfotmp                                                              '
?------------------------------------------------------------------------------------------     ? H|tzeilen > 0
.formula xtfotmp =""
.continue MAIN0
..
!ENDE0
.continue
