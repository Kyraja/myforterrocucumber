..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDILSHIS.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Gibt Lieferscheinzeilen in Tabelle aus
.. Functionality  : Shows delivery note rows in Table
..*****************************************************************************
.set trans -
..
.make screen line +O
.assign M|lsnum = H|kopf^id
.assign M|tauftrag = H|orig^kopf^id
.formula   M|lsdat = H|kopf^vom
.assign M|kunde = H|kopf^kunde^id         ? 'M|rahmen^dnr'="3"
.assign M|kunde = H|kopf^lief^id          ? 'M|rahmen^dnr'="4"
.assign M|labnr = H|kopf^lztabruf
..
.assign M|art     = H|artex^id
.formula   M|namebspr = M|art^sucherw
.formula   M|kuartnr = H|zkuartnr            ?  F|defined(H|zkuartnr)
.copy M|tme     = H|he
.formula   M|lfzahl  = H|fzahl
.formula   M|preis   = H|preis
.formula   M|land    = H|kopf^land
..
.formula   M|mge     = H|mge
.formula   M|gesmge  = M|gesmge + H|mge      ? _M|kballe
..
.assign M|tzicon  =  G|icovkrit ?  H|kopf^uebertr
..
..*****************************************************************************
!END
.continue
