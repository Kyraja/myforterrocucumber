.. Functionality  : default setting pickup-sheets (VAB)
..*****************************************************************************
.set trans -
..
.assign M|kabmodellneu = "4031"
.assign M|kzuoschemaneu = "4030"
.assign M|kieabmodellneu = "4030"
.formula M|kprotokollneu = "VDA"
.copy M|klabmgsplitneu = G|false
.copy M|kabrvolsneu = G|false
.copy M|kabrlspruefneu = G|false
.copy M|kabrdiffabneu = G|true
.copy M|kabrufdruckneu = G|false
.copy M|kabrufrangneu = 2
.copy M|kabrufaktneu = G|true
.copy M|kauidfldneu = G|false
.copy M|kauupdateneu = G|true
.copy M|kabholenneu = G|true
..
.input "dfue/DFUE.IMP.INI"
.copy M|klabmgsplitneu = U|xMonatSplit
.copy M|kabrvolsneu = U|xVerarbWennLSoffenP
.copy M|kabrufdruckneu = U|xDruckNeuenAuftrag
.copy M|kauidfldneu = U|xAUIDLFD
..
..*****************************************************************************
!END
.continue

