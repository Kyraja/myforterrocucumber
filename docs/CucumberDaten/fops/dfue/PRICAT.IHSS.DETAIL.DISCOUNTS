..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.IHSS.DETAIL.DISCOUNTS
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Construct message ABPRICAT
.. 
..      3        Kann   99  Zu-/Abschlaege der Artikelpreisliste           SUDI_PROD_PRICE_LIST 
..        4 ALC1 Kann    1  Zu-Abschlaege, Steuer-Info auf Positionsebene 
..        4 QTYA Kann    1  Mengen-Info 
..        4 RNGA Kann    1  Wertebereich-Info 
..        4 MOA1 Kann    2  Geldbetraege 
..        4 RNGB Kann    1  Wertebereich-Info 
..  
..*****************************************************************************
.set trans -
..
.type text xtversion1 ? _F|defined(U|xtversion1)
.copy U|xtversion1 = "01"
.. 
.type text xALC1 ? _F|defined(U|xALC1)
.type text xQTYA ? _F|defined(U|xQTYA)
.type text xRNGA ? _F|defined(U|xRNGA)
.type text xMOA1 ? _F|defined(U|xMOA1)
.type text xRNGB ? _F|defined(U|xRNGB)
..
.formula U|xALC1 = "ALC1"
.formula U|xQTYA = "QTYA"
.formula U|xRNGA = "RNGA"
.formula U|xMOA1 = "MOA1"
.formula U|xRNGB = "RNGB"
..
.type text xARTBERQ ? _F|defined(U|xARTBERQ)
.type text xPROZSATZQ ? _F|defined(U|xPROZSATZQ)
..
.type text mgrenzeUntenRabatte ? _F|defined(U|mgrenzeUntenRabatte)
.. 
.. Trim white spaces from MP7.3 fields 
.type text xtmgrenze ? _F|defined(U|xtmgrenze)
.type text xtmnrab ? _F|defined(U|xtmnrab)
.type text xtmproz ? _F|defined(U|xtmproz)
.. 
..!meta 2|=P82:1
.load 2 pricing 'M|trabatte^id'
.formula U|mgrenzeUntenRabatte = "1"
!NRABATT
.load 2 pricing line
.continue ERABATT ? _G|mehr
.continue NRABATT ?  F|empty(2|mproz)
.formula U|xARTBERQ = "4"
.formula U|xPROZSATZQ= "1"  ? _F|empty(2|mproz)
.formula U|xPROZSATZQ= "2"  ?  2|mproz > 0 
.formula U|xtmgrenze = '2|mgrenze'
.formula U|xtmnrab = '2|mnrab'
.formula U|xtmproz = '2|mproz'
'U|xALC1'#'U|xtversion1'######'U|xPROZSATZQ'#'U|xtmproz'#################
'U|xQTYA'#'U|xtversion1'#'U|xtmgrenze'#'M|vpeiso'#'U|xtmnrab'#####################                   
'U|xRNGA'#'U|xtversion1'#'U|xARTBERQ'#'M|vpeiso'#'U|mgrenzeUntenRabatte'#'U|xtmgrenze'####################
.. 'U|xMOA1'#'U|xtversion1'########################
.. 'U|xRNGB'#'U|xtversion1'########################
.formula U|mgrenzeUntenRabatte = 'U|xtmgrenze'
.continue NRABATT
!ERABATT
.load 2
..
..*****************************************************************************
!END
.continue
