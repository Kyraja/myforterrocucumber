.formula xdfh15 = text15
.formula xdfh16 = text16
.formula xdfh17 = text17
.formula xdfh18 = text18
.formula xdfh19 = text19
.formula xdfh20 = text20
.formula xdfh21 = text21
.formula xdfh22 = text22
.formula xdfh23 = text23
.formula xdfh24 = text24
.formula xdfh25 = text25
..
.reserve
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004"
.continue PROC003
!RET004
.formula xprocsp = xprocsp - 1
..
..> (Ziel)
.select lock edifact 'xedinumactinnachr2'
..
.. neue Tabellenzeile erzeugen
.select line 'xnumkdzeile'
.make line
..
.. Eintragen gemerkte Parameter in Tabellenzeile des aktuellen neuen EDI-Datensatzes
.. der gerade verarbeiteten DFUE-Nachricht (Ziel)
..
.formula text1 = xdfh1
.formula text2 = xdfh2
.formula text3 = xdfh3
.formula text4 = xdfh4
.formula text5 = xdfh5
.formula text6 = xdfh6
.formula text7 = xdfh7
.formula text8 = xdfh8
.formula text9 = xdfh9
