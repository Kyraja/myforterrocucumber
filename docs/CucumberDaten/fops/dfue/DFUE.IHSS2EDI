..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DFUE.IHSS2EDI
.. Autor          : alltrotec© GmbH, Matthias Schrîder
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Funktion       : Daten aus INHOUSE-Schnittstelle in EDI-Datenbank speichern
.. Functionality  :
..*****************************************************************************
.. Besonderheiten    : Parameter aus DFUE.<MMVVL>:
..                     - <Modul><Vorgang><Vorgangstyp> (xmmvvl)
..                     - Vorgangsart (xvorart)
..                     - Name des DFUE-Programms (xdfueprog)
..                     - Name des DFUE-Unterprogramms (xdfueuprog)
..                     - Batch-Pa·wort (xekspasswort)
..                     - Post-Verteiler (xPostEmpf)
..                     - globaler Schalter, ob Protokoll erweitert
..                       (xistfproterw)
..                     - Name der Protokoll-Datei
..                       Erweiterung (xnfprotokollerw)
..                     - Name der Protokoll-Datei (xnfprotokoll)
..                     - Umgebungsvariable "MANDANTDIR" (xeksmandantdir)
..                     - Umgebungsvariable "MANDANT" (xeksmname)
..                     - Umgebungsvariable "PATH" (xekspath)
..                     - Name der INHOUSE-Schnittstellendatei (xninhouse)
..                     - Uhrzeit der INHOUSE-Schnittstellendatei (xzinhouse)
..                     - Datum der INHOUSE-Schnittstellendatei (xdinhouse)
..                     - Anzahl der Beschreibungen der Bearbeitungsstati
..                       (xedinumstat)
..                     - Beschreibungen der Bearbeitungsstati
..                       (xedirefstat<i>)
..                     - Anzahl der Beschreibungen der Fehlercodes
..                       (xedinumfcod)
..                     - Beschreibungen der Fehlercodes (xedireffcod<i>)
..                     - Anzahl der Namen der Kopf-Variablen
..                       des EDI-Datensatzes (xedinumfcod)
..                     - Namen der Kopf-Variablen des EDI-Datensatzes
..                       (xedirefkvna<i>)
..                     - Anzahl der Beschreibungen der Kopf-Variablen
..                       des EDI-Datensatzes (xedinumkvbe)
..                     - Beschreibungen der Kopf-Variablen
..                       des EDI-Datensatzes (xedirefkvbe<i>)
..                     - debug (xdebug)
..                     - procedure stack pointer (xprocsp)
..*****************************************************************************
.set trans -
..
.input "ARB"
..
.. Variablendefinition
..
.. Dummies fÅr noch nicht vorhandene EDI-Kopfvariablen
.type text       datenart
.type text       kdelager
.type text       kontschl
.type text       vbrstelle
..
.. procedure stack pointer
..art int   xprocsp
..
.. Abladestelle
.type text       xablstelle
.. Basisname der Variablen mit Inhalten der aus Tabelle
.. in Kopf zu kopierenden Variablen
.type text       xCpyBasisName
.. Datennorm
.type text       xdatennorm
.. Datum der von DFö-Anbieter gelieferten INHOUSE-Schnittstellendatei
.. (aus SATZINFO - "000")
.type date      xddatei
.. 1. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf1
.. 2. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf2
.. 3. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf3
.. 4. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf4
.. 5. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf5
.. 6. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf6
.. 7. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf7
.. 8. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf8
.. 9. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf9
.. 10. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf10
.. 11. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf11
.. 12. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf12
.. 13. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf13
.. 14. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf14
.. 15. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf15
.. 16. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf16
.. 17. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf17
.. 18. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf18
.. 19. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf19
.. 20. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf20
.. 21. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf21
.. 22. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf22
.. 23. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf23
.. 24. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf24
.. 25. Parameter aus Datensatz INHOUSE-Schnittstelle
.type text       xdf25
.. 1. Hilfsvariable
.type text       xdfh1
.. 2. Hilfsvariable
.type text       xdfh2
.. 3. Hilfsvariable
.type text       xdfh3
.. 4. Hilfsvariable
.type text       xdfh4
.. 5. Hilfsvariable
.type text       xdfh5
.. 6. Hilfsvariable
.type text       xdfh6
.. 7. Hilfsvariable
.type text       xdfh7
.. 8. Hilfsvariable
.type text       xdfh8
.. 9. Hilfsvariable
.type text       xdfh9
.. 10. Hilfsvariable
.type text       xdfh10
.. 11. Hilfsvariable
.type text       xdfh11
.. 12. Hilfsvariable
.type text       xdfh12
.. 13. Hilfsvariable
.type text       xdfh13
.. 14. Hilfsvariable
.type text       xdfh14
.. 15. Hilfsvariable
.type text       xdfh15
.. 16. Hilfsvariable
.type text       xdfh16
.. 17. Hilfsvariable
.type text       xdfh17
.. 18. Hilfsvariable
.type text       xdfh18
.. 19. Hilfsvariable
.type text       xdfh19
.. 20. Hilfsvariable
.type text       xdfh20
.. 21. Hilfsvariable
.type text       xdfh21
.. 22. Hilfsvariable
.type text       xdfh22
.. 23. Hilfsvariable
.type text       xdfh23
.. 24. Hilfsvariable
.type text       xdfh24
.. 25. Hilfsvariable
.type text       xdfh25
.. EDI-Fehlercode
.type integer    xedifcode  ? _F|defined(U|xedifcode)
.formula U|xedifcode = 0
.. EDI-Fehlercode (Maximalwert)
.type integer    xedifcodemax
.. EDI-Fehlerbeschreibung
.type text       xedifbeschreibung
.. EDI-Identnummer
.type real       xediidentnum
.. EDI-Datensatz erzeugt
.type bool       xedimach
.. 1. EDI-Identnummer des aktuellen EDI-Datensatzes
.. der gerade verarbeiteten DFö-Nachricht
.type text       xedinumactinnachr1 ? _F|defined(U|xedinumactinnachr1)
.formula U|xedinumactinnachr1 = ""
.. 2. EDI-Identnummer des aktuellen EDI-Datensatzes
.. der gerade verarbeiteten DFö-Nachricht
.type text       xedinumactinnachr2
.. EDI-Identnummer des ersten EDI-Datensatzes
.. der gerade verarbeiteten DFö-Nachricht
.type text       xedinumfstinnachr
.. EDI-Identnummer des letzten EDI-Datensatzes
.. der gerade verarbeiteten DFö-Nachricht
.type text       xedinumlstinnachr
.. EDI-Identnummer des neuen EDI-Datensatzes
.type text       xedinumneu
.. Nummer der neuen EDI-Zeile
.type integer    xedinumzeile
.. EDI-Bearbeitungsstatus
.type integer    xedistatus
.. EDI-Suchwort
.type text       xedisuch
.. 1. SuchschlÅssel EDI
.type text       xedisuchschluessel1 ? _F|defined(U|xedisuchschluessel1)
.formula U|xedisuchschluessel1 = ""
.. Satzkennzeichen aus Variable text1 aus Tabellenzeile des EDI-Datensatzes
.type text       xeditabskzn
.. Fehler Format Datums-Variable
.type bool       xFehlDatum
.. Format EDI-Kopf-Varibale
.type text       xformedikopfvar
.. Identnummer von ABAS beim Kunden
.type text       xidabkunde
.. Identnummer des zugehîrigen Artikels
.type text       xideksart
.. Identnummer des Rahmens
.type text       xideksrah ? _F|defined(U|xideksrah)
.formula U|xideksrah = ""
.. Identnummer des Kunden bei ABAS
.type text       xidkundeab ? _F|defined(U|xidkundeab)
.formula U|xidkundeab = ""
.. Nachricht Kennung
.type P109:2     xihssedinachr ? _F|defined(U|xihssedinachr)
.formula U|xihssedinachr = ""
.. Namen der EDI-Kopfvariablen des Datensatzes aus INHOUSE-Schnittstelle
.type text       xihsssatzedikvars
.type text       xihsssatzedikvars1
.. Erfordernis des Datensatzes aus INHOUSE-Schnittstelle
.type text       xihsssatzerf ? _F|defined(U|xihsssatzerf)
.formula U|xihsssatzerf = ""
.type text       xihsssatzerf1 ? _F|defined(U|xihsssatzerf1)
.formula U|xihsssatzerf1 = ""
.. Format-Definition der Parameter
.type text       xihsssatzformat ? _F|defined(U|xihsssatzformat)
.formula U|xihsssatzformat = ""
.type text       xihsssatzformat1 ? _F|defined(U|xihsssatzformat1)
.formula U|xihsssatzformat1 = ""
.type text       xihsssatzformtmp
.. Kennzeichen des Datensatzes aus INHOUSE-Schnittstelle
.type text       xihsssatzkzn
.. Kennzeichen des Datensatzes aus INHOUSE-Schnittstelle (Parameter)
.type text       xihsssatzkzn1 ? _F|defined(U|xihsssatzkzn1)
.formula U|xihsssatzkzn1 = ""
.. Kennzeichen des VorgÑnger-Datensatzes aus INHOUSE-Schnittstelle
.type text       xihsssatzkznv
.. Position des Datensatzes aus INHOUSE-Schnittstelle in Nachricht
.. ("K"opf / "V"organgsbeginn / "D"aten / "S"chlu·)
.type text       xihsssatzpos
.type text       xihsssatzpos1
.. Position des Datensatzes aus INHOUSE-Schnittstelle in Nachricht Sicherung
.. ("K"opf / "V"organgsbeginn / "D"aten / "S"chlu·)
.type text       xihsssatzposs
.. Position des VorgÑnger-Datensatzes aus INHOUSE-Schnittstelle in Nachricht
.. ("K"opf / "V"organgsbeginn / "D"aten / "S"chlu·)
.type text       xihsssatzposv
.. 1. Schalter, ob nach Holen Satz vorhanden
.type bool       xistsatz1 ? _F|defined(U|xistsatz1)
.copy U|xistsatz1 = G|false
.. 2. Schalter, ob nach Holen Satz vorhanden
.type bool       xistsatz2 ? _F|defined(U|xistsatz2)
.copy U|xistsatz2 = G|false
.. 3. Schalter, ob nach Holen Satz vorhanden
.type bool       xistsatz3 ? _F|defined(U|xistsatz3)
.copy U|xistsatz3 = G|false
.. 1. Schalter, ob nach Holen Tabellenzeile vorhanden
.type bool       xistzeile1 ? _F|defined(U|xistzeile1)
.copy U|xistzeile1 = G|false
.. 2. Schalter, ob nach Holen Tabellenzeile vorhanden
.type bool       xistzeile2 ? _F|defined(U|xistzeile2)
.copy U|xistzeile2 = G|false
.. Kundenartikelnummer
.type text       xkuartnr
.. Schalter, ob in Prozedur .merke lifo
.type integer    xmerklifo ? _F|defined(U|xmerklifo)
.formula U|xmerklifo = 0
.. Schalter, ob neue Nachricht erzeugt / begonnen
.type bool       xnachrichtneu
.. Name der EDI-Kopfvariablen des Datensatzes aus INHOUSE-Schnittstelle (Kopie)
.type text       xnameedikopfvar
.. ZÑhler fÅr neue VorgÑnge
.type integer    xnumedineu
.. Nummer der Fu·-Datenzeile
.type integer    xnumfdzeile
.. Nummer der Kopf-Datenzeile
.type integer    xnumkdzeile
.. Post-Betreff
.type text       xPostBetreff ? _F|defined(U|xPostBetreff)
.formula U|xPostBetreff = ""
.. Post-Freitext-Datei
.type text       xPostFtext ? _F|defined(U|xPostFtext)
.formula U|xPostFtext = ""
.. Post-Stichworte
.type text       xPostStichw1 ? _F|defined(U|xPostStichw1)
.formula U|xPostStichw1 = ""
.type text       xPostStichw2 ? _F|defined(U|xPostStichw2)
.formula U|xPostStichw2 = ""
.type text       xPostStichw3 ? _F|defined(U|xPostStichw3)
.formula U|xPostStichw3 = ""
.type text       xPostStichw4 ? _F|defined(U|xPostStichw4)
.formula U|xPostStichw4 = ""
.. Erfolg der Operation in Prozedur
.type bool       xprocreturn ? _F|defined(U|xprocreturn)
.copy U|xprocreturn = G|false
.. Schalter fÅr trace in Prozeduren
.type bool       xproctrace ? _F|defined(U|xproctrace)
.copy U|xproctrace = G|false
.. 1. temp. Textvariable
.type text       xtxttmp1
.. 2. temp. Textvariable
.type text       xtxttmp2
.. VerwendungsschlÅssel
.type text       xverwschl
.. Schalter, ob neuer Vorgang erzeugt / begonnen
.type bool       xvorgangneu
.. Werk des Kunden
.type text       xwerk
.. SchleifenzÑhler
.type integer    xzaehl1 ? _F|defined(U|xzaehl1)
.formula U|xzaehl1 = 0
.type integer    xzaehl3 ? _F|defined(U|xzaehl3)
.formula U|xzaehl3 = 0
..
.. Uhrzeit der von DFö-Anbieter gelieferten INHOUSE-Schnittstellendatei
.. (aus SATZINFO - "000")
.type time       xzdatei
..
.type text  xzeile
.type text  xfunktion ? _F|defined(U|xfunktion)
..
.. 2014, define missing variables
.type date xdinhouse ? _F|defined(U|xdinhouse)
.type time xzinhouse ? _F|defined(U|xzinhouse)
.type text xl ? _F|defined(U|xl)
.type text xAutoFehlDatumKorr ? _F|defined(U|xAutoFehlDatumKorr)
..
.. initialize procedure stack pointer
..formel xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
..
.. Merken DFUE-Programm und -Unterprogramm
.. Name des DFUE-Unterprogramms
.formula xdfueuprog = tname
..
..
.. Verarbeitung DatensÑtze aus INHOUSE-Schnittstelle
.. Initialisieren Parameter des VorgÑnger-Datensatzes aus INHOUSE-Schnittstelle
.. Satzkennzeichen
.formula xihsssatzkznv = "9999"
.. Position
.formula xihsssatzposv = "K"
..
.. Initialisierung Steuervariablen fÅr Verarbeitung Abschnitte nach SATZINFO aus INHOUSE-Schnittstelle
.. - EDI-Datensatz erzeugt = nein
.. - EDI-Identnummer des ersten EDI-Datensatzes
..   der gerade verarbeiteten DFö-Nachricht
.. - EDI-Identnummer des letzten EDI-Datensatzes
..   der gerade verarbeiteten DFö-Nachricht
.formula xedimach = false
.formula xedinumfstinnachr = ""
.formula xedinumlstinnachr = ""
..
..
!REPT008: ==============================
.. Lesen Datensatz aus INHOUSE-Schnittstelle
.select from 'xninhouse' xzeile^
..
.formula xistsatz1 = mehr
..
.. Test, ob Datensatz aus INHOUSE-Schnittstelle gelesen
..
..
.continue EL030 ? _((xistsatz1) & (xzeile<>""))
.. IF030
.formula xi = 1
.formula xdf.xi = xzeile << "#"
.formula xi = xi+1
..
..
!LOOP005: ==============================
.continue ELOP005 ? _(xi<26)
.formula xzeile = xzeile >> "#"
..
.formula xdf.xi = xzeile << "#"
..
.formula xi = xi+1
..
.continue LOOP005
!ELOP005: ==============================
..
.. Testergebnis positiv: Speichern in EDI-Datenbank
.. Merken Satzkennzeichen
.formula xihsssatzkzn = (xdf1 << "") >> ""
.formula xihsssatzkzn1 = xihsssatzkzn
..
..
.continue EL031 ? _(xihsssatzkzn = "000")
.. IF031
.. Merken globale Variablen aus SATZINFO aus INHOUSE-Schnittstelle
.. Datum der Dateierstellung (xddatei, D)
.assign U|xddatei = U|xdf12
.. Uhrzeit der Dateierstellung (xzdatei, Z)
.assign U|xzdatei = ("0000" + U|xdf13) >> 4
.. Datennorm
.formula xdatennorm = xdf5
.. Funktion einer Nachricht
.. (EDIFACT-LAB / -FAB, "4": change)
.formula xfunktion = xdf14
..
.continue FI031
!EL031
..
.continue EL032 ? _(xihsssatzkzn = "UNBI")
.. IF032
.. Datum der Dateierstellung (xddatei, D)
.assign U|xddatei = U|xdf9
.. Uhrzeit der Dateierstellung (xzdatei, Z)
.assign U|xzdatei = ("0000" + U|xdf10) >> 4
..
!EL032
.. FI032
..
!FI031
..
.. Merken Parameter des Datensatzes aus INHOUSE-Schnittstelle
.. - Erfordernis: xihsssatzerf
.. - Position: xihsssatzpos
.. - Kopf-Variablennamen: xihsssatzedikvars
.. - Kopf-Variablentypen: xihsssatzformat
..
.reserve
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009"
.continue PROC003
!RET009
.formula xprocsp = xprocsp - 1
..
.select
..
.. - Erfordernis:
.formula xihsssatzerf1 = xihsssatzerf
.. - Position:
.formula xihsssatzpos1 = xihsssatzpos
.. - Kopf-Variablennamen:
.formula xihsssatzedikvars1 = xihsssatzedikvars
.. - Kopf-Variablentypen:
.formula xihsssatzformat1 = xihsssatzformat
..
.. Vorgang fertig
.. Speichern EDI-Datensatz, wenn:
.. - erzeugt und
.. - der aktuelle Datensatz aus INHOUSE-Schnittstelle ein Vorgangsbeginn-Datensatz und
.. - der vorige Datensatz aus INHOUSE-Schnittstelle ein Vorgangsbeginn-Datensatz oder
..   der vorige Datensatz aus INHOUSE-Schnittstelle ein Vorgangs-Datensatz
..
..
.continue EL033 ? _((xedimach) & (xihsssatzpos = "V") & ((xihsssatzposv = "V") ; (xihsssatzposv = "D")))
.. IF033
.rewrite
..
.formula xedimach = false
..
.. fÅr Kopieren der Schlu·datensÑtze
.formula xedinumlstinnachr = xedinumneu
..
.. Test, ob erster EDI-Datensatz der DFUE-Nachricht noch nicht gemerkt
..
..
.continue EL034 ? _(xedinumfstinnachr = "")
.. IF034
.formula xedinumfstinnachr = xedinumlstinnachr
..
!EL034
.. FI034
..
!EL033
.. FI033
..
.. Nachricht fertig
.. Kopieren Kopf- und Schlu·datensÑtze in alle EDI-DatensÑtze (VorgÑnge)
.. der gerade verarbeiteten DFUE-Nachricht, wenn:
.. - erzeugt und
.. - der vorherige Datensatz aus INHOUSE-Schnittstelle ein Fu·-Datensatz und
..   der aktuelle Datensatz aus INHOUSE-Schnittstelle kein Fu·-Datensatz     oder
.. - der aktuelle Datensatz aus INHOUSE-Schnittstelle ein Kopf-Datensatz und
..   der vorherige Datensatz aus INHOUSE-Schnittstelle kein Kopf-Datensatz
..
..
.continue EL035 ? _((xedimach) & (((xihsssatzposv = "S") & (xihsssatzpos <> "S")) ; ((xihsssatzpos = "K") & (xihsssatzposv <> "K"))))
.. IF035
.rewrite
..
.formula xedimach = false
..
.. fÅr Kopieren der Schlu·datensÑtze
.formula xedinumlstinnachr = xedinumneu
..
.. Test, ob erster EDI-Datensatz der DFUE-Nachricht noch nicht gemerkt
..
..
.continue EL036 ? _(xedinumfstinnachr = "")
.. IF036
.formula xedinumfstinnachr = xedinumlstinnachr
..
!EL036
.. FI036
..
.. Sichern Position des Datensatzes aus INHOUSE-Schnittstelle in Nachricht (bei Kopieren benutzt)
.formula xihsssatzposs = xihsssatzpos
..
.. Kopieren der Kopf- und Schlu·datensÑtze in alle EDI-DatensÑtze
.formula xihsssatzkzn1 = xihsssatzkzn
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET010"
.continue PROC007
!RET010
.formula xprocsp = xprocsp - 1
..
.formula xihsssatzpos = xihsssatzposs
..
.. - EDI-Identnummer des ersten EDI-Datensatzes
..   der gerade verarbeiteten DFö-Nachricht
.. - EDI-Identnummer des letzten EDI-Datensatzes
..   der gerade verarbeiteten DFö-Nachricht
..
.formula xedinumfstinnachr = ""
.formula xedinumlstinnachr = ""
..
!EL035
.. FI035
..
.. Test, ob kein neuer EDI-Datensatz erzeugt
..
..
.continue EL037 ? _(_(xedimach))
.. IF037
.make edifact
..
.formula xedimach = true
.formula xedinumzeile = 0
..
.. Suchwort
.formula such = xmmvvl
.. Nachricht Kennung
.formula U|xihssedinachr = "2101" ? H|such/"VKAUV" & U|xfunktion<>"915"
.formula U|xihssedinachr = "2102" ? H|such/"VKAUV" & U|xfunktion="915"
.formula U|xihssedinachr = "2105" ? H|such/"VKAUE"
.formula U|xihssedinachr = "2106" ? H|such/"VKAUE" & U|xdatennorm="230"
.formula U|xihssedinachr = "2110" ? H|such/"VKEDL"
.formula U|xihssedinachr = "2112" ? H|such/"VKGAV"
.assign H|edinachr = U|xihssedinachr
.. Datum der INHOUSE-Schnittstellendatei (dinhouse, D)
.assign H|dinhouse = U|xdinhouse
.. Uhrzeit der INHOUSE-Schnittstellendatei (zinhouse, Z)
.formula H|zinhouse = U|xzinhouse
.. Datum der Dateierstellung (ddatei, D)
.assign H|ddatei = U|xddatei
.. Uhrzeit der Dateierstellung (zdatei, D)
.assign H|zdatei = U|xzdatei
.. Datennorm
.formula nachrtyp = xdatennorm
.. Funktion einer Nachricht
.. (EDIFACT-LAB / -FAB, "4": change)
.formula funktion = xfunktion
.. Fehlercode (fcode, K1; kein Fehler)
.formula fcode = 0
.. Bearbeitungsstatus (status, K1; Vorgang in EDI-Datenbank eingetragen)
.formula status = 2
.. Korrekturwert fuer Fortschrittszahl (korfzahl, I9)
.formula korfzahl = 0
.. Import/Exportflag
.formula imex = "IM"
.. Codierte Vorgangsart
.formula vorart = xvorart
..
.rewrite
.formula xedinumneu = H|nummer
..
.select lock edifact 'xedinumneu'
.formula xzaehl3 = 1
..
.continue FI037
!EL037
.. Testergebnis negativ: holen neuen EDI-Datensatz zum Speichern
.select lock edifact 'xedinumneu'
.select line 'xedinumzeile'
..
!FI037
..
.make line
.formula xedinumzeile = xedinumzeile + 1
..
.. Belegen Variablen in Tabellenzeile im aktuell angelegten EDI-Datensatz
..
.formula text1 = xdf1
.formula text2 = xdf2
.formula text3 = xdf3
.formula text4 = xdf4
.formula text5 = xdf5
.formula text6 = xdf6
.formula text7 = xdf7
.formula text8 = xdf8
.formula text9 = xdf9
.formula text10 = xdf10
.formula text11 = xdf11
.formula text12 = xdf12
.formula text13 = xdf13
.formula text14 = xdf14
.formula text15 = xdf15
