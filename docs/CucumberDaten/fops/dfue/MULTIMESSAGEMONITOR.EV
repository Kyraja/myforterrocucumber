..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : MULTIMESSAGEMONITOR.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
..
.input "is/TABLEEREN"
.continue BSTART ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue DATUM  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "vonerfass"
.continue DATUM  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "biserfass"
.continue END
..
!DATUM
.input "is/TABLEEREN"
.continue END
..
!BSTART
.continue ERROR1             ? M|biserfass < M|vonerfass & _F|empty(M|biserfass) & _F|empty(M|vonerfass)
.formula M|select = "$,,"
.formula M|select = M|select + ";erfass=" + 'M|vonerfass' + "!" + 'M|biserfass'           ? _F|empty(M|vonerfass) ; _F|empty(M|biserfass)
.formula M|select = M|select + ";nachrvstatusaz=" + 'F|value(M|nachrvstatus, "AZL20134")' ? _F|empty(M|nachrvstatus)
.formula M|select = M|select + ";objquellmandant==" + 'M|objquellmandant'                 ? _F|empty(M|objquellmandant)
.formula M|select = M|select + ";objquelldn=" + 'M|objquelldn'                            ? _F|empty(M|objquelldn)
.formula M|select = M|select + ";objquellgrtxt==" + 'M|objquellgrtxt'                     ? _F|empty(M|objquellgrtxt)
.formula M|select = M|select + ";objquellid=" + 'M|objquellid'                            ? _F|empty(M|objquellid)
.formula M|select = M|select + ";objquellnum=" + 'M|objquellnum'                          ? _F|empty(M|objquellnum)
.formula M|select = M|select + ";objzieldn=" + 'M|objzieldn'                              ? _F|empty(M|objzieldn)
.formula M|select = M|select + ";objzielgrtxt==" + 'M|objzielgrtxt'                       ? _F|empty(M|objzielgrtxt)
.formula M|select = M|select + ";objzielid=" + 'M|objzielid'                              ? _F|empty(M|objzielid)
.formula M|select = M|select + ";objzielnum=" + 'M|objzielnum'                            ? _F|empty(M|objzielnum)
.input "is/HOL.LISTE"
.continue END
..
!ERROR1
.error -line 0 -field M|vonerfass -message Kein korrekter Zeitraum.
.end 1
.set trans -
..*****************************************************************************
!END
.continue
