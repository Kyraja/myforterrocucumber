..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FORECASTCONFIG.EDINFO.TAB
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
.. 
.type P109:2 edinachr ? _F|defined(U|edinachr)
.type text   xedisuch ? _F|defined(U|xedisuch)
..
..!meta H|=P0:2
..!meta 2|=P0:4
.. 
.load 2 customer 'H|edinfosnr^id'
.continue END ? _G|mehr & M|kbmitediinfos 
.continue KUNDE ? _G|mehr
.. 
.load 2 line 'F|formatstr("$,,;edinachr=`;vorgang=={1}", U|xedisuch)' ?  M|kbohnenachricht & H|gruppe=2
.load 2 line 'F|formatstr("$,,;edinachr=;vorgang=={1}", U|xedisuch)'  ?  M|kbohnenachricht & H|gruppe=1
.load 2 line 'F|formatstr("$,,;edinachr={1}", U|edinachr^id)'         ? _M|kbohnenachricht
.continue END ? _G|mehr & M|kbmitediinfos
.. 
..
.. Skipp jedi-configs
.continue KUNDE  ?  M|kbohnenachricht    
.continue KUNDE  ? _M|kbohnejedis ; _F|defined(2|abmodell)
.continue END    ?  M|kbohnejedis & _F|empty(2|abmodell)
.. 
!KUNDE
.make screen line +O
.colour -foreground -1 -1 -1 -background -1 -1 -1  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1  tedinachr  'M|aktzeile'
.colour -foreground -1 -1 -1 -background -1 -1 -1  tkunde     'M|aktzeile'
.formula M|tkunde = H|id
.formula M|tkundefirma = H|firma^id ? H|gruppe=2
.formula M|tkundewerk = H|werk ? H|gruppe=2
.formula M|tkundeablstelle = H|ablstelle ? H|gruppe=2
..
.. Message
.copy M|tedinachr = U|edinachr
.copy M|terlaubt = G|false
..
!CONFIG
.. Exit if no EDI-Settings
.continue END ? _F|defined(2|erlaubt)
.. 
.formula M|tkundeinfo = 2|id
.copy M|terlaubt = 2|erlaubt
.copy M|tprotokoll = 2|protokoll
.copy M|tedinachr = 2|edinachr
.copy M|tvorgang = 2|vorgang
.copy M|tabmodell = 2|abmodell
.copy M|tzuoschema = 2|zuoschema
.copy M|tieabmodell = 2|ieabmodell
.copy M|tlabmgsplit = 2|labmgsplit
.copy M|tabrvols = 2|abrvols
.copy M|tabrlspruef = 2|abrlspruef
.copy M|tabrdiffab = 2|abrdiffab
.copy M|tabrufdruck = 2|abrufdruck
.formula M|tabrufrang = 2|abrufrang
.copy M|kabrufakt = 2|abrufakt
.copy M|kauidfld = 2|auidfld
.copy M|kauupdate = 2|auupdate
.copy M|kabholen = 2|abholen ? F|defined(2|abholen)
..
.formula M|kanzabrufefo = M|kanzabrufefo + 1     ?  F|empty(M|tabmodell)
.formula M|kanzabrufejedi = M|kanzabrufejedi + 1 ? _F|empty(M|tabmodell)
..
.colour -foreground -1 -1 -1 -background 'U|xabasorange' tedinachr 'M|aktzeile' ? F|empty(2|edinachr)
.colour -foreground -1 -1 -1 -background 'U|xabasorange' tkunde    'M|aktzeile' ? H|gruppe=1          
.. 
.load 2
.. 
..*****************************************************************************
!END
.continue
