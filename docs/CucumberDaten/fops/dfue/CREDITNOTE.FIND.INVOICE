..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CREDITNOTE.FIND.INVOICE
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Find invoice item taht matches the delivery note item, 
..                  which previously has been matched to the credit note item.
...Includes       :
..  include  dfue/CREDITNOTE.TAB.INVOICE
..*****************************************************************************
..!meta M|=dfue/CREDITNOTE
.set trans -
..
.. Must have found a matching delivery note item in abas erp
.continue END ?  F|empty(M|tlieferposition)
.. 
.type integer xilipos ? _F|defined(U|xilipos)
.copy U|xilipos = 0
.type P3:2  xvpos ? _F|defined(U|xvpos)
.. 
.type integer xipos ? _F|defined(U|xipos)
.copy U|xipos = 0
.. 
.type text queryInvoiceItem ? _F|defined(U|queryInvoiceItem)
.. 
!NEXT
.formula U|xilipos = U|xilipos + 1
.copy U|xvpos = M|ttlipos.xilipos
.continue END ? F|empty(U|xvpos)
.. 
.. invoice item with equal ganr
.formula U|queryInvoiceItem = "$,,;@gruppe=2;@ablageart=(Both);kotyp=(Invoice)"
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";orig=" + U|xvpos^id
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";ganr=" + M|kganr
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";artex=" + M|tartikel^id
.select nolock sales 'U|queryInvoiceItem'
!INVOI1
.continue END1 ? _G|mehr
.formula U|xipos = U|xipos + 1
.input "CREDITNOTE.TAB.INVOICE"
.select nolock sales
.continue INVOI1
!END1
.. 
.. invoice item with empty ganr
.formula U|queryInvoiceItem = "$,,;@gruppe=2;@ablageart=(Both);kotyp=(Invoice)"
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";orig=" + U|xvpos^id
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";ganr=`"
.formula U|queryInvoiceItem = U|queryInvoiceItem + ";artex=" + M|tartikel^id
.select nolock sales 'U|queryInvoiceItem'
!INVOI2
.continue END2 ? _G|mehr
.formula U|xipos = U|xipos + 1
.input "CREDITNOTE.TAB.INVOICE"
.select nolock sales
.continue INVOI2
!END2
..  
.continue NEXT
.. 
..*****************************************************************************
!END
.continue
