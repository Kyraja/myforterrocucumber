.. - Fehler 54 (Artikel nicht im Ursprungslieferschein)
..
.continue ESAC001
!BRK004
.continue BRK005 ? _(text1 = "QTY1")
.. QT1-Satzart
.. (Re-)Initialisieren Variablen
.. Positionsnummer
.formula U|xpnum = ""
.. Menge
.formula U|xmge = 0
.. Mengeneinheit
.formula U|xeinhmge = ""
.. Termin
.formula U|xtterm = ""
.. Positionstext
.formula U|xptext = ""
..
.. Positionstext aus EDI-Datensatz
.formula U|xptext = text10 + ";" + text11 + ";" + text12
..
.. Abrufmenge und Mengeneinheit (Variante 1)
.formula U|xmge = text3 ? _F|empty(text3)
.formula U|xeinhmge = text4 ? _F|empty(text4)
..
.. Abrufmenge und Mengeneinheit (Variante 2)
.formula U|xeinhmge = text8  ?  _(xmge>0) & _F|empty(text7)
.formula U|xmge = text7      ?  _(xmge>0) & _F|empty(text7)
..
.. Einheiten-PrÅfung: Einheit in EDL-Meldung ?= Einheit in Urspurngslieferschein
.. mh, 16.08.2010: Korrektur der EinheitenprÅfung
..  Theoretisch sollte die Einheit in der Entnahmemeldung eine ISO-Einheit
..  sein, in der Praxis ist diese Einheit aber oft eine VDA-Einheit.
..  Die Einheit im Ursprungslieferschein ist immer eine ABAS-Einheit.
..
.. Selektion der Einheit
.type text xtselTAZ      ? _F|defined(xtselTAZ)
..
.. Einheiten-Varianten fÅr Ursprungslieferschein
.type text xISOursprung  ? _F|defined(xISOursprung)
.type text xTAZursprung  ? _F|defined(xTAZursprung)
.type text xVDAursprung  ? _F|defined(xVDAursprung)
..
.. Die Einheit des Ursprungslieferscheins steht in 2|he, im internen ABAS-Format.
.formula U|xISOurpsrung = ""
.formula U|xTAZursprung = ""
.formula U|xVDAurpsrung = ""
.formula U|xtselTAZ =  "$,,;@gruppe=1;gruppe=1;evda=;eiso=;einheitbspr=" + 2|he
.load 9 unit 'U|xtselTAZ'
..
..
.continue EL018 ? _(G|mehr)
.. IF018
.formula U|xISOurpsrung = -9|eiso
.formula U|xTAZursprung = -9|einheitbspr
.formula U|xVDAurpsrung = -9|evda
..
.continue FI018
!EL018
..
.continue EL019 ? _(2|mge <> 0)
.. IF019
.. Fehler XX (Mengeneinheit Ursprungs-LS-Pos unbekannt)
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("FÅr die Artikelposition {1} angegebene Mengeneinheit -{2} ist unbekannt!", xideksart, 2|he)'
.formula xtxt2 = xtxt2 + ";Lieferschein: " + xlsnum + ", Zeile: " + 'zeile'
.set trans -
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET008" 
.continue PROC001
!RET008
.formula xprocsp = xprocsp - 1
..
!EL019
.. FI019
..
!FI018
..
.. Einheiten-Varianten fÅr Entnahmemeldung
.type text xISOentnahme  ? _F|defined(xISOentnahme)
.type text xTAZentnahme  ? _F|defined(xTAZentnahme)
.type text xVDAentnahme  ? _F|defined(xVDAentnahme)
..
.. Die Einheit der Entnahmemeldung steht in U|xeinhmge, es ist unklar, ob die Einheit
.. im ISO- oder VDA-Format Åbertragen worden ist!
.formula U|xISOentnahme = ""
.formula U|xTAZentnahme = ""
.formula U|xVDAentnahme = ""
.formula U|xtselTAZ =  "$,,;@gruppe=1;gruppe=1;eiso=;einheitbspr=;evda=" + -U|xeinhmge
.load 9 unit 'U|xtselTAZ'
.formula U|xtselTAZ =  "$,,;@gruppe=1;gruppe=1;einheitbspr=;evda=;eiso=" + -U|xeinhmge        ? _G|mehr
.load 9 unit 'U|xtselTAZ'                                                                     ? _G|mehr
..
..
.continue EL020 ? _(G|mehr)
.. IF020
.formula U|xISOentnahme = -9|eiso
.formula U|xTAZentnahme = -9|einheitbspr
.formula U|xVDAentnahme = -9|evda
..
.continue FI020
!EL020
.. Fehler XX (Mengeneinheit Entnahme unbekannt)
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("Die fÅr die Artikelposition {1} angegebene Mengeneinheit -{2} ist unbekannt!", xideksart, U|xeinhmge)'
.set trans -
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET009" 
.continue PROC001
!RET009
.formula xprocsp = xprocsp - 1
..
!FI020
..
..
.continue EL021 ? _(_U|xbfehler)
.. IF021
..
.continue EL022 ? _(U|xTAZursprung <> U|xTAZentnahme)
.. IF022
.. Fehler XX (Mengeneinheit Entnahme und Ursprung stimmen nicht Åberein)
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("FÅr die Artikelposition {1} stimmen die Mengeneinheiten nicht Åberein!", xideksart)'
.formula xtxt2 = xtxt2 + ";Im EDI-Datensatz: " + U|xTAZentnahme + " im Lieferschein " + xlsnum + ": " + U|xTAZursprung + ", Zeile: " + 'zeile'
.formula xtxt3 = 'F|formatstr("Die Einheit im EDI-Datensatz wurde von {1} zu {2} konvertiert.", U|xeinhmge, U|xTAZentnahme)'
.set trans -
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET010" 
.continue PROC001
!RET010
.formula xprocsp = xprocsp - 1
..
!EL022
.. FI022
..
.continue FI021
!EL021
.. Mengeneinheiten Urpsrung und Entnahme stimmen Åberein
..
!FI021
..
.. mîgliche Fehler (xbfehler wird gesetzt):
.. - Fehler XX (Mengeneinheit Entnahme unbekannt)
.. - Fehler XX (Mengeneinheit Ursprungs-LS-Pos unbekannt)
.. - Fehler XX (Mengeneinheit Entnahme und Ursprung stimmen nicht Åberein)
..
..
.continue EL023 ? _((_U|xbfehler) & (U|xladerkopf) & (U|xmge > 0))
.. IF023
.. ErgÑnzen der Entnahme-Lieferschein-Erstellung:
.. Muss zum EDP-Skript (s.o. RFL1) passen:
..      Puffer H: EDI-Zeile
..      Puffer 1: Ursprungslieferschein (Kopf)                  (RFL1)
..      Puffer 2: Ursprungslieferschein-Artikel-Position        (ART1)
..      Puffer 5: Artikel aus ARTIKELPRUEFUNG                   (ART1)
..
.. Erstellen der EDP-Zeilen Åber individualisierbares FOP
.type text xedpmarke ? _F|defined(U|xedpmarke)
.formula U|xedpmarke = "QTY1"
.input "EDI.EDI2VKEDL36.EDPZEILE"
..
.formula U|xladerpos = true
..
!EL023
.. FI023
..
.continue ESAC001
!BRK005
.continue BRK006 ? _(text1 = "PAC1")
.. PAC1-Satzart
.. Packmittel-Angaben
.formula T|xpakuartnr  = text4
.formula T|xpaideksart = text5
.formula T|xanzpackst  = text14
..
.. use fop ARTIKELPRUEFUNG to find product / customer product no / gtin
.type text xapnummer  ? _F|defined(xapnummer)
.type BT128 xapkuartnr ? _F|defined(xapkuartnr)
.type text xapgtin    ? _F|defined(xapgtin)
.type P0   xapkunde   ? _F|defined(xapkunde)
.formula T|xedifcode  = 0
.formula T|xapnummer  = T|xpaideksart
.formula T|xapkuartnr = T|xpakuartnr
.formula T|xapgtin    = ""
.assign T|xapkunde = 'T|xidkundeab'
.input "ARTIKELPRUEFUNG"
.formula T|xedifcode = T|xapfcode
..
..
.continue EL024 ? _(T|xedifcode > 0)
.. IF024
.. Fehler XX (FOP ARTIKELPRUEFUNG gescheitert)
.formula T|xbfehler = true
.formula T|xtxt1 = T|xaptext1
.formula T|xtxt2 = T|xaptext2
.formula T|xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET011" 
.continue PROC001
!RET011
.formula xprocsp = xprocsp - 1
..
.continue FI024
!EL024
.formula T|xpaideksart = 5|nummer
.formula T|xpakugtinnr = 5|gtin
..
!FI024
..
..
.continue EL025 ? _(_U|xbfehler)
.. IF025
.. Positionen mit Artikel-Kunde (evkopf;evartex;evkotyp;vkkunde;evkovom) prÅfen
..
.formula U|xtsel = "$,,;@gruppe=2;kotyp=(4)"
.formula U|xtsel = U|xtsel + ";kopf="      + 1|id
.formula U|xtsel = U|xtsel + ";artex="     + 5|id
.formula U|xtsel = U|xtsel + ";@ablageart=(3)"
.formula U|xtsel = U|xtsel + ";@gruppe=2"
..
.load 2 sales 'U|xtsel'
..
..
.continue EL026 ? _(_G|mehr)
.. IF026
.. Fehler 54 (Packmittel nicht in Ursprungslieferschein)
.formula xedifcode = 54
..
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("Das Packmittel: {1} ist im Ursprungs-Lieferschein-Nr {2} nicht vorhanden!", xpaideksart, xursplsnr)'
.set trans -
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET012" 
.continue PROC001
!RET012
.formula xprocsp = xprocsp - 1
..
!EL026
.. FI026
..
!EL025
.. FI025
..
..
.continue EL027 ? _(false)
.. IF027
.. Packmittel-Fehler ignorieren?
..**ok,30.07.2003 (nur bei Fehler, also bei xbfehler=true)
..
..
.continue EL028 ? _((xladerkopf) & (xladerpos) & (xbfehler))
.. IF028
.. NEU: auch bei Packmittelfehler LS anlegen
..**ok,28.07.2003 (jetzt xAPackFehl aus der Datei "EDL.PACK")
..**ok,28.07.2003 (EDL.PACK im Kunden-EDI-Info bei EDL als Internes Programm einzutragen)
..
.. PrÅfen ob die Datei existiert
.formula U|xintedi  = F|foppath(U|xintedi)
.input 'U|xintedi' ? _F|empty(U|xintedi)
..
..
.continue EL029 ? _(xAPackFehl)
.. IF029
..**ok,30.07.2003 (Fehlertext geÑndert)
..
.. Fehlertext
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("Trotz des vorhandenen Packmittelfehlers bei {1} kann der Lieferschein ohne die fehlerhafte Packmittelposition angelegt werden.", xpaideksart)'
.set trans -
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET013" 
.continue PROC001
!RET013
.formula xprocsp = xprocsp - 1
..
.formula xbfehler = false
..
!EL029
.. FI029
..
!EL028
.. FI028
..
..**ok,14.07.2003 (neue Variable xistpac1)
.formula xistpac1 = true
..
!EL027
.. FI027
..
.. mîgliche Fehler (xbfehler wird gesetzt):
.. - Fehler XX (FOP ARTIKELPRUEFUNG gescheitert)
.. - Fehler 54 (Packmittel nicht in Ursprungslieferschein)
..
..
.continue EL030 ? _((_U|xbfehler) & (U|xladerpos))
.. IF030
.. ErgÑnzen der Entnahme-Lieferschein-Erstellung:
.. Muss zum EDP-Skript (s.o. RFL1) passen:
..      Puffer H: EDI-Zeile
..      Puffer 1: Ursprungslieferschein (Kopf)                  (RFL1)
..      Puffer 2: Ursprungslieferschein-Packmittel-Position     (PAC1)
..      Puffer 5: Packmittel aus ARTIKELPRUEFUNG                (PAC1)
..
.. Erstellen der EDP-Zeilen Åber individualisierbares FOP
.type text xedpmarke ? _F|defined(U|xedpmarke)
.formula U|xedpmarke = "PAC1"
.input "EDI.EDI2VKEDL36.EDPZEILE"
..
!EL030
.. FI030
..
.continue ESAC001
!BRK006
!ESAC001: =====   ENDCASE   =====
..
.select line
..
.continue LOOP001
!ELOP001: ==============================
..
.. Alte/Vorrausgegangene Puffer/VorgÑnge freigeben!
.load 1
.load 2
..
..
.continue EL031 ? _((_U|xbfehler) & (U|xladerkopf))
.. IF031
.. Abschluss der Entnahme-Lieferschein-Erstellung
.. Erstellen der EDP-Zeilen Åber individualisierbares FOP
.type text xedpmarke ? _F|defined(U|xedpmarke)
.formula U|xedpmarke = "ENDE"
.input "EDI.EDI2VKEDL36.EDPZEILE"
..
.. Erzeugen Lader-Abschnitt fÅr Status 10 und Fehlercode 0 in ABAS-EDI-Datensatz
.. EFOPs fÅr EDI-Nachricht nicht berÅcksichtigen
..
.output addedto 'U|xnlader'
..

# EDI-Nachricht: Status = Lader fertig

#!action=update
#!database=53
#!dontchange=~
#!EDP_FOPMODE=0

nummer;status;fcode
'U|xvedi^id';10;0

..
.output new WERF.WEG
..
.. Was tun mit "LADER.ENDE" ?
.. Erzeugen Lader-Abschnitt fÅr Lîschen des Lader-Files
.. sys rm -f 'xnlader' 1> ${DEVNULL:-/dev/null} 2>&1
.. <Text> LADER.ENDE
.. <zeigen>
..
!EL031
.. FI031
..
..
.continue EL032 ? _((U|xladerkopf) & (U|xladerpos) & (_U|xmgeueb) & (_U|xbfehler))
.. IF032
.. EDI-Nachricht: Status setzen - Lader wird gestartet
.. Status 6 -> Lader fÅr Vorgang aus EDI-Datenbank ohne Korrekturen erzeugt
.. Fcode  0 -> Lader fÅr Vorgang aus EDI-Datenbank gestartet
.. Datum Laderstart merken
..
.select lock edifact 'U|xvedi^id'
.formula H|status = 6
.formula H|fcode = 0
.formula H|sdatlader = datum
.formula H|szeitlader = zeit
.rewrite
.select -
..
.. LADER ausfuehren, bei Erfolg LADER lîschen
.formula U|xnbatchspooldir = "batchlg.spooler"
.formula U|xtladerEDI  = (("0000000000" + xedinumneu) >> 10)
.formula U|xtladerErr  = xnbatchspooldir + "/X.stderr" + U|xtladerEDI + "eds.TMP"
.formula U|xtladerHinw = xnbatchspooldir + "/X.stderr" + U|xtladerEDI + "eds.HINW"
..
.. Alte Ausgabedateien wegrÑumen
.formula T|xsybefehl = "rm -f " + U|xtladerErr
.system 'T|xsybefehl' background
.formula T|xsybefehl = "rm -f " + U|xtladerHinw
.system 'T|xsybefehl' background
..
.. Neuen Lader Starten, OHNE &
.formula T|xsybefehl = "edpimport.sh -P -I " +  T|xnlader + " 2> " + U|xtladerErr + " -H " + U|xtladerHinw
.system 'T|xsybefehl' password background
..
..
.continue EL033 ? _(mehr)
.. IF033
.. Nach fehlerfreiem Laderlauf den Lader lîschen
.formula U|xsybefehl = "rm -f " + xnlader
.system 'U|xsybefehl' background
.formula U|xsybefehl = "rm -f " + U|xtladerHinw
.system 'U|xsybefehl' background
..
!EL033
.. FI033
..
.continue FI032
!EL032
.. EDI-Nachricht: Status setzen - Lader wird NICHT gestartet
.select lock edifact 'U|xvedi^id'
.formula H|status = 4
.formula H|fcode = 54 ? +fcode=0
.rewrite
.select -
..
.. LADER ungenutzt loeschen
.formula U|xsybefehl = "rm -f " + xnlader
.system 'U|xsybefehl' background
..
!FI032
..
.. EDI-Nachricht: Fehler und/oder Warnungen in ftext schreiben
.select lock edifact 'U|xvedi^id'
.formula H|ftext = U|xdfehler
.rewrite
.select -
..
.. Zum Abschluss den EDI-Datensatz wieder in den H-Puffer lesen
.select nolock edifact 'U|xvedi^id'
..
!FI001
..
!END
.continue
..
