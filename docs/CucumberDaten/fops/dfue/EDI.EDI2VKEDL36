..@@ENDVARDEFS
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
..
!PROC001: ----- FEHLER -----
.formula xbfehler = true
..
.output addedto 'xdfehler'
?'xtxt1' ? +xtxt1 > 0
?'xtxt2' ? +xtxt2 > 0
?'xtxt3' ? +xtxt3 > 0
.output
..
.continue 'xprocst.xprocsp'
..
..
!PROC002: ----- SENDE.POST -----
.set trans +
.formula xPostBetreff = "Fehler beim Verarbeiten der EDL-Meldungen in EDI-Datenbank"
.formula xPostStichw1 = "EDI-Fehler"
.set trans -
.formula xPostFtext   = xdfehler
.formula xPostEmpf    = xPostEmpfErr
..
.input 'xdPostSenden' ? xPostEmpf<>""
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.input ARB
.input DATEI.F
.input "dfue/DFUE.IMP.INI"
..
.. EDL-Meldung aus EDI-Nachricht verarbeiten
.. Wichtige Schalter initialisieren
.formula U|xladerkopf = false
.formula U|xladerpos = false
.formula U|xmgeueb = false
.formula U|xbfehler = false
..
.. Verweis auf EDI-Nachricht merken
.. Aus Ausrufparameter: xedinumneu == H|nummer
.formula U|xvedi = H|id
..
.. Holen EDI-Datensatz (ist eigentlich schon da)
.select edifact nolock 'U|xvedi^id'
..
..
.continue EL001 ? _(_G|mehr)
.. IF001
.. ABBRUCH - Achtung: ohne EDI-Nachricht kann der Fehler nicht in EDI geschrieben werden!
.formula U|xedistatus = 4
.formula U|xedifcode = 40
.formula U|xbfehler = false
..
.continue END
..
.continue FI001
!EL001
.. LADER komplett erstellen
.. Felder aus EDI-Nachricht
.. Felder aus EDI-Nachricht merken
.. Identnummer der ABAS-Vorgangs
.formula U|xideksvor = ideksvor
..>> Abschlu·/Bestellnummer
.formula U|xabbenr = abbenr
.. Zeichen des Kunden
.formula U|xkdzeich = kdzeich
.. Ident-Nr. Kunde
.formula U|xidkundeab = idkundeab
.. GLN-Nr. Kunde
.formula U|xglkundeab = glkundeab
.. Ident-Nr. WarenempfÑnger
.formula U|xidkundeabs = idkundesab
.. GLN-Nr. WarenempfÑnger
.formula U|xglkundeabs = glkundesab
.. Ident-Nr. RechnungsempfÑnger
.formula U|xidkundeabr = idkunderab
.. GLN-Nr. RechnungsempfÑnger
.formula U|xglkundeabr = glkunderab
.. Werk
.formula U|xwerk = werk
.. Abladestelle
.formula U|xablstelle = ablstelle
.. Funktion der Nachricht
.formula U|xfunktion = funktion
.. Fehlercode des EDI-Datensatzes
.formula U|xedifcode = fcode
..
.. Belegen Name Lader-Datei und Erzeugen leere Lader-Datei
.formula xnlader = xmmvvl + "." + xedinumneu + ".EDP
.output new 'xnlader'
.output new WERF.WEG
..
.. Holen erste Tabellenzeile
.select line
..
..
!LOOP001: ==============================
.continue ELOP001 ? _((G|mehr) & (_U|xbfehler))
..
.. =====   CASE001   =====
.continue BRK001 ? _(text1 = "BGMI")
.. BGMI-Satzart
.. EDL-Lieferschein-Datum
.assign T|xedllsdat = text4
..
.continue ESAC001
!BRK001
.continue BRK002 ? _(text1 = "RFH1")
.. RFH1-Satzart
.. EDL-Lieferschein-Nr
.formula U|xedllsnr = text7
..
.. EDL-Lieferschein-Datum
.assign U|xedllsdat = text8 ? text8<>""
..
.. Erzeugen Lader-Abschnitt fÅr Status 9 und Fehlercode 0 in ABAS-EDI-Datensatz
.. EFOPs fÅr EDI-Nachricht nicht berÅcksichtigen
..
.output addedto 'U|xnlader'
..

# EDI-Nachricht: Status = Lader gestartet

#!action=update
#!database=53
#!dontchange=~
#!EDP_FOPMODE=0

nummer;status;fcode
'U|xvedi^id';9;0

..
.output new WERF.WEG
..
.continue ESAC001
!BRK002
.continue BRK003 ? _(text1 = "RFL1")
..
.continue EL002 ? _(U|xladerkopf)
.. IF002
.. Alte/Vorrausgegangene Puffer/VorgÑnge freigeben!
.load 1
.load 2
..
.. Erstellen der EDP-Zeilen Åber individualisierbares FOP
.type text xedpmarke ? _F|defined(U|xedpmarke)
.formula U|xedpmarke = "RFL1MEHR"
.input "EDI.EDI2VKEDL36.EDPZEILE"
..
!EL002
.. FI002
..
.. RFL1-Satzart
.. Ursprungslieferschein in Puffer 1
.formula U|xursplsnr = H|text7
..
.formula U|xinput = U|xursplsnr
..
..
!LOOP002: ==============================
.continue ELOP002 ? _(U|xinput << 1 = "0")
.formula U|xinput = U|xinput << -1
..
.continue LOOP002
!ELOP002: ==============================
..
.formula U|xursplsnr = U|xinput
..
..
.continue EL003 ? _(_F|empty(T|xursplsnr))
.. IF003
.formula T|xtsel = "$,,;@gruppe=1;ktyp=4;@ablageart=(2);@gruppe=1;umplatz<>`;umlgruppe<>`;nummer=" + T|xursplsnr
.load 1 sales 'T|xtsel'
..
.continue FI003
!EL003
.load 1
..
!FI003
..
.. Charge aus RFL1 Feld 18
.formula U|xchargeorig = H|text18
.formula U|xcharge = ""
.assign U|xcharge = "$,,;@gruppe=0;nummer==" + H|text18  ? _F|empty(H|text18) &  F|isvalue(H|text18, "N59")
.assign U|xcharge = "$,,;@gruppe=0;exnum=" + H|text18 + "!" + H|text18 ? _F|empty(H|text18) & F|empty(U|xcharge)
..
..
.continue EL004 ? _(F|defined(1|id))
.. IF004
.. Ursprungslieferschein prÅfen
.formula U|xursplsnr = 1|nummer
.formula U|xidursplsnr = 1|id
.formula U|xumplatz = 1|umplatz
.formula U|xedlnr = 1|edl
..
.formula xi = 0
.formula xanzpos = 0
.formula xzeilez = 0
..
.. PrÅfung: Passen Kundenangaben aus EDI-Nachricht zum Ur-Lieferschein
.. 1) Besteller
.. 2) WarenempfÑnger
.. 3) RechnungsempfÑnger
..
..
.continue EL005 ? _(xidkundeab <> "")
.. IF005
..
.continue EL006 ? _(_((xidkundeab = 1|kunde^nummer) ; (xidkundeab = 1|kunde2^nummer)))
.. IF006
.. Fehler 51 (Besteller aus Satzart BUY1 und LS stimmen nicht Åberein)
.formula xedifcode = 51
.formula xistsatz1 = false
..
.set trans +
.formula xtxt1 = 'F|formatstr("- Besteller: {1} aus der Satzart BUY1 und aus dem gefundenen Lieferschein: {2} stimmen nicht Åberein", xidkundeab, xursplsnr)'
.set trans -
.formula xtxt2 = ""
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
..
!EL006
.. FI006
..
!EL005
.. FI005
..
..
.continue EL007 ? _(xidkundeabs <> "")
.. IF007
..
.continue EL008 ? _(_((xidkundeabs = 1|kunde^nummer) ; (xidkundeabs = 1|kunde3^nummer)))
.. IF008
.. Fehler 52 (WarenempfÑnger aus Satzart DPA1 und LS stimmen nicht Åberein)
.formula xedifcode = 52
.formula xistsatz1 = false
..
.set trans +
.formula xtxt1 = 'F|formatstr("- WarenempfÑnger: {1} aus der Satzart DPA1 und aus dem gefundenen Lieferschein: {2} stimmen nicht Åberein", xidkundeabs, xursplsnr)'
.set trans -
.formula xtxt2 = ""
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
..
!EL008
.. FI008
..
!EL007
.. FI007
..
..
.continue EL009 ? _(xidkundeabr <> "")
.. IF009
..
.continue EL010 ? _(_(xidkundeabr = 1|kunde2^nummer))
.. IF010
.. Fehler 53 (RechnungsempfÑnger aus Satzart IV12 und LS stimmen nicht Åberein)
..**ok,11.06.2003 (hier keine Fehlercode mehr eingetragen)
..
.formula xedistatus = 4
.formula xedifcode = 53
..>> "RechnungsempfÑnger aus der Satzart IV12 und aus dem LS stimmt nicht Åberein"
.formula xistsatz1 = false
..
.set trans +
.formula xtxt1 = 'F|formatstr("- RechnungsempfÑnger: {1} aus der Satzart IV1 und aus dem gefundenen Lieferschein: {2} stimmen nicht Åberein", xidkundeabr, xursplsnr)'
.set trans -
.formula xtxt2 = ""
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET003" 
.continue PROC001
!RET003
.formula xprocsp = xprocsp - 1
..
!EL010
.. FI010
..
!EL009
.. FI009
..
.. PrÅfung: gibt es bereits einen Entnahme-LS mit dieser EDLLSNR?
..
..
.continue EL011 ? _(xedllsnr <> "")
.. IF011
.formula T|xtsel = "$,,;@gruppe=1;@ablage=(3);@zeilen=(0);ktyp=4;edllsnr=" + T|xedllsnr + ";edllsdat=" + 'T|xedllsdat' + ";ursplsnr=" + T|xursplsnr
.load 0 sales 'T|xtsel'
..
..
.continue EL012 ? _(mehr)
.. IF012
.continue FI012
!EL012
.formula T|xtsel = "$,,;@gruppe=1;@ablage=(3);@zeilen=(0);ktyp=4;edllsnr=" + T|xedllsnr + ";ursplsnr=" + T|xursplsnr
.load 0 sales 'T|xtsel'
..
!FI012
..
..
.continue EL013 ? _(mehr)
.. IF013
.. Fehler 54 (Bereits Entnahme-LS zu dieser EDLLSNR vorhanden)
..>> "In ABAS mit dieser EDL-LS-Nr wurde bereits ein Entnahme-LS angelegt"
.formula xedifcode = 54
..
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("Mit der EDL-LS-Nr: {1} wurde bereits ein Entnahme-Lieferschein: {2} angelegt!", xedllsnr, 0|nummer)'
.formula xtxt3 = 'F|formatstr("Ursprungs-LS-Nr: {1}, EDI-Id: {2}", 0|ursplsnr, 0|ident)'
.set trans -
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET004" 
.continue PROC001
!RET004
.formula xprocsp = xprocsp - 1
..
.formula xladerkopf = false
..
!EL013
.. FI013
..
.load 0
..
!EL011
.. FI011
..
.continue FI004
!EL004
.. Fehler 50 (Kein Usprungslieferschein)
.formula xedifcode = 50
..
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("Mit der angegebenen Ursprungs-Lieferschein-Nr {1} wurde kein Lieferschein mit Umlagerung gefunden", xursplsnr)'
.set trans -
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET005" 
.continue PROC001
!RET005
.formula xprocsp = xprocsp - 1
..
!FI004
..
.. mîgliche Fehler (xbfehler wird gesetzt):
.. - Fehler 50 (kein Ursprungslieferschein)
.. - Fehler 51 (Besteller aus Satzart BUY1 und LS stimmen nicht Åberein)
.. - Fehler 52 (WarenempfÑnger aus Satzart DPA1 und LS stimmen nicht Åberein)
.. - Fehler 53 (RechnungsempfÑnger aus Satzart IV12 und LS stimmen nicht Åberein)
.. - Fehler 54 (Bereits Entnahme-LS zu dieser EDLLSNR vorhanden)
..
..
.continue EL014 ? _(_U|xbfehler)
.. IF014
.. Erstelle Entnahme-Lieferschein als Kopie des Usprungslieferscheins
..      Puffer H: EDI-Zeile
..      Puffer 1: Ursprungslieferschein (Kopf)
..
.. Erstellen der EDP-Zeilen Åber individualisierbares FOP
.type text xedpmarke ? _F|defined(U|xedpmarke)
.formula U|xedpmarke = "RFL1"
.input "EDI.EDI2VKEDL36.EDPZEILE"
..
.formula U|xladerkopf = true
..
!EL014
.. FI014
..
.continue ESAC001
!BRK003
.continue BRK004 ? _(text1 = "ART1")
.. ART1-Satzart
.. Artikel-Angaben
.formula T|xkugtinnr = text3
.formula T|xkuartnr  = text4
.formula T|xideksart = text5
..
.type text xapnummer  ? _F|defined(xapnummer)
.type BT128 xapkuartnr ? _F|defined(xapkuartnr)
.type text xapgtin    ? _F|defined(xapgtin)
.type P0   xapkunde   ? _F|defined(xapkunde)
.formula T|xedifcode  = 0
.formula T|xapnummer  = H|text5
.formula T|xapkuartnr = H|text4
.formula T|xapgtin    = H|text3
.assign T|xapkunde = 'T|xidkundeab'
.input "ARTIKELPRUEFUNG"
.formula T|xedifcode = T|xapfcode
..
..
.continue EL015 ? _(T|xapfcode > 0)
.. IF015
.. Fehler XX (FOP ARTIKELPRUEFUNG gescheitert)
.formula T|xtxt1 = T|xaptext1
.formula T|xtxt2 = T|xaptext2
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET006" 
.continue PROC001
!RET006
.formula xprocsp = xprocsp - 1
..
.continue FI015
!EL015
.formula T|xkugtinnr = 5|gtin
.formula T|xideksart = 5|nummer
.formula T|xbfehler = false
.formula T|xart = 5|nummer
..
!FI015
..
..
.continue EL016 ? _(_U|xbfehler)
.. IF016
.. Positionen mit Artikel-Kunde (evkopf;evartex;evkotyp;vkkunde;evkovom) prÅfen
..
.formula U|xtsel = "$,,;@gruppe=2;kotyp=(4)"
.formula U|xtsel = U|xtsel + ";kopf="      + 1|id
.formula U|xtsel = U|xtsel + ";artex="     + 5|id
.formula U|xtsel = U|xtsel + ";charge="    + U|xcharge^id ? _F|empty(U|xcharge)
.formula U|xtsel = U|xtsel + ";mge<>0;@ablageart=(3)"
..
.load 2 sales 'U|xtsel'
..
..
.continue EL017 ? _((_G|mehr) ; (F|empty(U|xcharge) & _F|empty(U|xchargeorig)))
.. IF017
.. Fehler 54 (Artikel nicht in Ursprungslieferschein)
.formula xedifcode = 54
..
.set trans +
.formula xtxt1 = 'F|formatstr("- Satzart: {1}, Zeile: {2}:", xaktsatz, xaktzeile)'
.formula xtxt2 = 'F|formatstr("Der Artikel: {1} ist im Ursprungs-Lieferschein-Nr {2} nicht vorhanden!", xideksart, xursplsnr)'
.formula xtxt1 = 'F|formatstr("Der Artikel {1} mit Charge {2} ist im Ursprungslieferschein {3} nicht vorhanden!", U|xideksart, U|xchargeorig, U|xursplsnr)' ? _F|empty(U|xchargeorig)
.formula xtxt2 = ""  ? _F|empty(U|xchargeorig)
.set trans -
.formula xtxt3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET007" 
.continue PROC001
!RET007
.formula xprocsp = xprocsp - 1
..
!EL017
.. FI017
..
!EL016
.. FI016
..
