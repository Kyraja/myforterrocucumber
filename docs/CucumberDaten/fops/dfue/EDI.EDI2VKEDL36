.. Variablendefinition
..@@BEGINVARDEFS
..====================================================
.set trans -
.. Variablendefinition
..
..**ok,16.08.2004 (xedllsdat als datum definiert)
.type date xedllsdat
..**ok,23.03.2004 (neue Variable xzusatzc)
.type integer   xzusatzc xczaehler
..**ok,23.03.2004 (fehlende Definition von xcpin ergÑnzt)
.type integer   xcpin
..**ok,28.07.2003 (neue Variable Laderkopf)
.type bool  xladerpos
.type bool  xAPackFehl
..**ok,22.07.2003 (xmgeueb, xfmenge, xreal definiert)
.type real4  xreal
.type bool   xmgeueb
..**ok,23.03.2004 (xfmenge real4 --> MP7.2)
.type MP7.2  xfmenge
.type text   xtext xtex1
.type real4  xerg xzeilmge
.type integer    xipaentmge
..**ok,22.07.2003 (xtxt3 ist NEU)
.type text xtxt1 xtxt2 xtxt3
.type text xlsnum xumplatz xedlnr
.type bool xmehr
.type integer  xcpzaehler xrunde
..**ok,11.06.2003 (neu xinput, xoutput, xinputvar, xanzpos)
.type text  xinput xoutput xinputvar xzeilenr
.type integer   xanzpos xzeilez
.type bool  xeintrag
..**ok,07.07.2003 (neue Variable Laderkopf)
.type bool  xladerkopf
..**ok,14.07.2003 (neue Variable xistpac1)
.type bool  xistpac1
..**ok,22.07.2003 (neue Variable xPackEntAuto, xpaentmge)
.type bool  xPackEntAuto
.type real4  xpaentmge
.type text  xursplsnr xsum xusum xart
..**ok,13.02.2004 (neue Variable xidursplsnr)
.type text  xidursplsnr
.type integer   xi
.type text  xz
..
.. Charge aus RFL1 Feld 18 im Ursprungslieferschein
.type P59 xcharge
.type text xchargeorig
..
.. ZÑhlervariablen fÅr Satzarten
.. KOPF
.type integer xzUNBI xzUNHI
..      SCHLEIFE 1 START
.type integer xzBGMI xzRFH1 xzRFH2 xzDAH1 xzSUP1 xzSUP2 xzBUY1 xzBUY2 xzDPA1 xzDPA2 xzIV1 xzTRA1 xzTRA2
..              SCHLEIFE 2 START
.type integer xzLIN1 xzRFL1 xzRFL2 xzART1 xzART2 xzQTY1 xzALC1 xzPAC1 xzPAC2 xzPAC3 xzDAL1
..              SCHLEIFE 2 ENDE
.type integer xzSUM1
..      SCHLEIFE 1 ENDE
.. KOPF
.type integer xzUNZI
..**ok,17.12.2003 (Variable xanzrfl ist NEU)
.type integer xanzrfl
..
.. Schluessel-Textfelder
.type text xLieferscheinEDL
.set trans +
.formula T|xLieferscheinEDL = "Lieferscheinnummer_EDL"
.set trans -
..
.. Verweis auf EDI-Nachricht mit der EDL-Meldung
.. Programm startet mit dieser Meldung im H-Puffer
.type P53 xvedi
..
.. Bemerkung fÅr Entnahmelieferschein
.type text xbem
..
.. Selektionen
.type text xtsel         ? _F|defined(xtsel)
..
.. mh, 20.05.2010: Fehlerdateien fÅr Lader-Vorgaenge
.type text       xtladerEDI    ? _F|defined(xtladerEDI)
.type text       xtladerErr    ? _F|defined(xtladerErr)
.type text       xtladerHinw   ? _F|defined(xtladerHinw)
