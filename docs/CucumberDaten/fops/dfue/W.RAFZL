..!interpreter english translate
..*****************************************************************************
.. FOP-Name       : W.RAFZL
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Lieferfortschrittszahl in Rahmen auf "0" setzen
.. Functionality  :
..*****************************************************************************
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#FOP-Dateigrîsse(vor/nach)#ETF-Dateigrîsse(vor/nach)#
..#KOR#LAB#19.09.2001#1#ok#942/1584#nur FOP#
..#KOR#LAB#14.01.2003#2#ok#
..*****************************************************************************
..
.set trans -
..
.type text xdatum xzeit xtsel
.input "ARB"
.formula xdatum=datum
.formula xdatumr=xdatum>>2
.formula xdatuml=xdatum<<2
.formula xdatumm=(xdatum>>-3)>>2
.formula xdatum=xdatuml+xdatumm+xdatumr
.formula xzeit=zeit
.formula xzeitl=xzeit<<":"
.formula xzeitr=xzeit>>":"
.formula xzeit=xzeitl+xzeitr
.formula xdatei = xarb + "ALTFZ" + xdatum + xzeit
.output new 'xdatei'
.input "DATEI.F"
..
.formula xtsel = "$,,;@gruppe=1;ktyp=(BlanketOrder);ablagef=(No)"
.select sales 'xtsel'
.continue ENDE ? _mehr
.formula xnum=num
.formula xwerk=werk
.formula xablstelle=ablstelle
.formula xkunde2=kunde2
!ZEILE
.select line
.continue SCHLEIFE ? _mehr
..**ok,14.01.2003 (jetzt wird geprueft, ob eine Artikelposition ist)
.continue ZEILE    ? 'art^gruppe'<>"1"
.formula xart=art
..**ok,19.09.2001 (jetzt die kuartnr aus der Zeile Åber Verweis gelesen)
.formula xkuartnr='art^kuartnr'
.formula xfzahl=fzahl
'xnum'#'xkuartnr'#'xwerk'#'xablstelle'#'xkunde2'#'xart'#'xfzahl'#
.continue ZEILE
!SCHLEIFE
.select sales
.continue ENDE ? _mehr
.formula xnum=num
.formula xwerk=werk
.formula xablstelle=ablstelle
.formula xkunde2=kunde2
!Z1
.select line
.continue SCHLEIFE ? _mehr
..**ok,14.01.2003 (jetzt wird geprueft, ob eine Artikelposition ist)
.continue ZEILE    ? 'art^gruppe'<>"1"
.formula xart=art
..**ok,19.09.2001 (jetzt die kuartnr aus der Zeile Åber Verweis gelesen)
.formula xkuartnr='art^kuartnr'
.formula xfzahl=fzahl
'xnum'#'xkuartnr'#'xwerk'#'xablstelle'#'xkunde2'#'xart'#'xfzahl'#
.continue Z1
.continue SCHLEIFE
..*****************************************************************************
!ENDE
.continue

