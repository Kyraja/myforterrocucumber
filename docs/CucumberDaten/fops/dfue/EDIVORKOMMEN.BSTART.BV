..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIVORKOMMEN.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. query without restricting by date is too expensive
.continue NOARGS  ?  F|empty(M|kdatumvon)
..
.. start empty
.make screen line -- ? M|tzeilen > 0
.copy M|kanzalle = 0
..
..
.. alive or all (include files) edi messages?
.formula M|select = "$,,;@gruppe=0;@ablageart=(1);@zeilen=(0);@ordnung=nummer"  ? _M|kbablage
.formula M|select = "$,,;@gruppe=0;@ablageart=(3);@zeilen=(0);@ordnung=nummer"  ?  M|kbablage
..
.. restrict date range
.formula M|select = M|select + ";uebdat=" + M|kdatumvon:8 + "!" + M|kdatumbis:8  ? _F|empty(M|kdatumbis)
.formula M|select = M|select + ";uebdat=" + M|kdatumvon:8 + "!"                  ?  F|empty(M|kdatumbis)
..
.. restrict by sent/received
.formula M|select = M|select + ";imex=" + M|kimex  ? _F|empty(M|kimex)
..
.. restrict by customer
.formula M|select = M|select + ";idkundeab=" + M|kkunde^nummer  ? _F|empty(M|kkunde)
..
.. restrict by product
.formula M|select = M|select + ";ideksart=" + M|kartikel^nummer  ? _F|empty(M|kartikel)
..
.. restrict by message
.formula M|select = M|select + ";edinachr=" + M|kedinachr^id  ? _F|empty(M|kedinachr)
..
..*****************************************************************************
!END
.continue
..
..
!NOARGS
.error Geben Sie ein Anfangsdatum an!
.end 1
