..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.IHSS.DETAIL.GROUP
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Construct message ABPRICAT
.. 
..    2     PGI1 Muss    1  Artikelgruppen-Daten 
..  
..*****************************************************************************
.set trans - 
..
.. Message detail is grouped by Product Group 
.. (only write PGI1 once before products of same group)
.. 
.. Fields initialize as empty on define!
.type text xlastProductGroup ? _F|defined(U|xlastProductGroup)
.type bool xPGIwritten ? _F|defined(U|xPGIwritten)
..
.. Already written -> Done
.continue END ? U|xlastProductGroup = M|pgrnr & U|xPGIwritten
.formula U|xlastProductGroup = M|pgrnr
.copy U|xPGIwritten = G|true
..
.type text xtversion1 ? _F|defined(U|xtversion1)
.copy U|xtversion1 = "01"
..
.type text xPGI1 ? _F|defined(U|xPGI1)
.copy U|xPGI1 = "PGI1"
..
.type text xPGTYP ? _F|defined(U|xPGTYP)
..
.output addedto 'M|dateiname'
.input "DATEI.F"
.copy U|xPGTYP = "2" ?  F|empty(M|pgrnr)
.copy U|xPGTYP = "4" ? _F|empty(M|pgrnr)
'U|xPGI1'#'U|xtversion1'#'U|xPGTYP'##'M|pgrnr'#####################
.output
.. 
..*****************************************************************************
!END
.continue
