..!interpreter english translate noabbrev
..!meta M|=dfue/PRICAT
..*****************************************************************************
.. Name           : PRICAT.IHSS
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Construct message ABPRICAT
.. 
..  1       UNBI Muss    1  Dateiuebertragungs-Info 
..  1       UNHI Muss    1  Nachrichten-Info 
..  1       BGMI Muss    1  Vorgangs-Info 
..  1       DAH1 Muss    1  Datum-Info fuer Kopfdaten 
..  1       SUP1 Muss    1  Lieferanten-Info 
..  1       SUP2 Kann    1  Lieferanten-Info 
..  1       BUY1 Muss    1  Kunden-Info 
..  1       BUY2 Kann    1  Kunden-Info 
..  1       MFA1 Kann    1  Hersteller-Info 
..  1       MFA2 Kann    1  Hersteller-Info 
..  1            Muss 1000  Positionsdaten der Artikelpreisliste          PRODUCT_PRICE_DETAIL 
..    2     PGI1 Muss    1  Artikelgruppen-Daten 
..    2          Muss 9999  Positionsdaten Produkt der Artikelpreisliste  PRODUCT_ITEM_DATA 
..      3   LIN1 Muss    1  Positions-Info 
..      3   ART1 Muss    1  Artikeldaten 
..      3   QTY1 Kann   10  Mengen-Info 
..      3   PRI1 Kann  100  Preis-Info 
..      3   RNG1 Kann    1  Wertebereich-Info 
..      3        Kann   99  Zu-/Abschlaege der Artikelpreisliste           SUDI_PROD_PRICE_LIST 
..        4 ALC1 Kann    1  Zu-Abschlaege, Steuer-Info auf Positionsebene 
..        4 QTYA Kann    1  Mengen-Info 
..        4 RNGA Kann    1  Wertebereich-Info 
..        4 MOA1 Kann    2  Geldbetraege 
..        4 RNGB Kann    1  Wertebereich-Info 
..  1       UNZI Muss    1  Zaehler fuer Satzarten 
..  
...Includes       :
..  include dfue/PRICAT.IHSS.HEAD
..  include dfue/PRICAT.IHSS.DETAIL
..  include dfue/PRICAT.IHSS.DETAIL.GROUP
..  include dfue/PRICAT.IHSS.DETAIL.ITEMDATA
..  include dfue/PRICAT.IHSS.DETAIL.DISCOUNTS 
..  include dfue/PRICAT.IHSS.SUM
..*****************************************************************************
.set trans - 
..
!HEAD
.select screen header
.input "PRICAT.IHSS.HEAD"
..
!DETAIL
.select screen line
.continue SUM ? _G|mehr
.input "PRICAT.IHSS.DETAIL"
.continue DETAIL
..
!SUM
.input "PRICAT.IHSS.SUM"
.. 
..*****************************************************************************
!END
.continue
