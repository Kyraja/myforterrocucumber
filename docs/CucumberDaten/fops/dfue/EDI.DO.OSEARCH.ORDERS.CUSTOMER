..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDI.DO.OSEARCH.ORDERS.CUSTOMER
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Finds customer for edi messages in abas
..*****************************************************************************
.set trans -
..
.input "DATEI.F"
.output addedto 'U|xtfehler'
..
.. Verify customers in abas
!IDNO
.continue GLN ? F|empty(U|xtfrbez)
.load 2 customer 'F|formatstr("$,,;@gruppe={1};such=={2}", U|xtgruppe, U|xtfrbez)'   ? F|isvalue('U|xtfrbez', "SW0")
.load 2 customer 'F|formatstr("$,,;@gruppe={1};nummer=={2}", U|xtgruppe, U|xtfrbez)' ? F|isvalue('U|xtfrbez', "N0")
.continue NOID ? _G|mehr
.formula U|xvkunde = 2|id
.continue END
..
!GLN
.continue NOGLN ? F|empty(U|xtgln)
.load 2 customer 'F|formatstr("$,,;@gruppe={1};gln=={2}", U|xtgruppe, U|xtgln)'
.continue NOGLN ? _G|mehr
.formula  U|xvkunde = 2|id
.continue END
..
..*****************************************************************************
..
!NOID
.set trans +
Der 'U|xtbezeichner' mit der Kundennummer 'U|xtfrbez' aus dem EDI-Datensatz 'U|xvedifact^nummer' wurde nicht gefunden.
.set trans -
.continue GLN
..
!NOGLN
.set trans +
Der 'U|xtbezeichner' mit der GLN 'U|xtgln' aus dem EDI-Datensatz 'U|xvedifact^nummer' wurde nicht gefunden.
.set trans -
.continue END
..
..*****************************************************************************
!END
..
.load 2 ? F|defined(2|id)
.continue
