..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIIMPVER.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Zeigt alle Kunden mit aktiver EDI-Verarbeitung
.. Functionality  : Show all Customers with active EDI-processing
..
..                  Using the start button is not required to use this info
..                  system. But an info system should have some functionality
..                  on its start button ;)
..                  This start button mimics entering all edi-enabled
..                  customers into the table.
..*****************************************************************************
.set trans -
..
.. Start empty
.make screen line -- ? M|tzeilen > 0
..
.continue END  ?  M|kballekunden
..
.formula M|select = "$,,;@ordnung=klnum^nummer;erlaubt=(Yes);@gruppe=4"
.select customer 'M|select'
.continue END  ? _G|mehr
..
!SHOW
.make screen line +O
.formula M|tkunde = H|klnum^id
.input 'M|tab'
..
!NEXT: one row for each customer (not for each message)
.select customer
.continue END   ? _G|mehr
.continue NEXT  ?  M|tkunde^id = H|klnum^id
.continue SHOW
..
..*****************************************************************************
!END
.continue
