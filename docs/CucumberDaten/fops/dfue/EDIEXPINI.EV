..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIEXPINI.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Allgemeines Eventhandling Infosystem EDIEXPINI
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type text   xtkommando
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue EDINFO  ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "edinfo"
.continue DRUCKER ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "bdruckervkre"
.continue DRUCKER ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "buprotdruck"
.continue EXPCHK  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "elsexpcheck"  
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!EDINFO
.command -parallel "(Infosystem) EDIEINTR ? minfo=1 | bstart="
.continue END
..
!DRUCKER
.input DRUCKER
.formula M|druckervkre = T|geraet  ? T|evtvar = "bdruckervkre"
.formula M|protdrucker = T|geraet  ? T|evtvar = "buprotdruck"
.continue END
..
!EXPCHK: Export-Pruefprogramm starten
.input "dfue/DFUE.EXP.CHECK"
.continue END
..*****************************************************************************
!END
.continue
