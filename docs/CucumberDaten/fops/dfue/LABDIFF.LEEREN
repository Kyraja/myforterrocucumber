..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LABDIFF.LEEREN
.. Autor          : mh/ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Kopf und Tabelle leeren, und Selektionsfelder neu fllen
.. Functionality  : Clear Head and Table, refill query fields
..*****************************************************************************
.set trans -
..
.type P53    xklab           ? _F|defined(xklab)
.type text   xklabnummer     ? _F|defined(xklabnummer)
.type P53    xklab1          ? _F|defined(xklab1)
.type P53    xklab2          ? _F|defined(xklab2)
.type P3     xkrahmen        ? _F|defined(xkrahmen)
.type P2     xkartikel       ? _F|defined(xkartikel)
.type BGL35  xkkuartnr       ? _F|defined(xkkuartnr)
.type gd19   xklabdiffstart  ? _F|defined(xklabdiffstart)
.type gd     xklabhisvon     ? _F|defined(xklabhisvon)
.type gd     xklabhisbis     ? _F|defined(xklabhisbis)
.type P109:2 xklabedinachr   ? _F|defined(xklabedinachr)
.type bool   xkbdiffkomplett ? _F|defined(xkbdiffkomplett)
.type bool   xkbdiffeingang  ? _F|defined(xkbdiffeingang)
.type bool   xkbdiffabterm   ? _F|defined(xkbdiffabterm)
.type bool   xkbablage       ? _F|defined(U|xkbablage)
..
.. clear table
.make screen line -- ? M|tzeilen > 0
..
.. remmeber some header fields
.formula U|xklab          = M|klab^id
.formula U|xklabnummer    = M|klabnummer
.formula U|xklab1         = M|klab1^id
.formula U|xklab2         = M|klab2^id
.formula U|xkrahmen       = M|krahmen^id
.formula U|xkartikel      = M|kartikel^id
.formula U|xkkuartnr      = M|kkuartnr
.formula U|xklabdiffstart = M|klabdiffstart
.formula U|xklabhisvon    = M|klabhisvon
.formula U|xklabhisbis    = M|klabhisbis
.copy U|xklabedinachr     = M|klabedinachr
.formula U|xkbdiffkomplett = M|kbdiffkomplett
.formula U|xkbdiffeingang  = M|kbdiffeingang
.formula U|xkbdiffabterm   = M|kbdiffabterm
.copy U|xkbablage = M|kbablage
..
.. clear all header fields
.input "is/KOPFLEEREN"
..
.. fill core header fields
.formula M|klab           = U|xklab^id
.formula M|klabnummer     = U|xklabnummer
.formula M|klab1          = U|xklab1^id
.formula M|klab2          = U|xklab2^id
.formula M|krahmen        = U|xkrahmen^id
.formula M|kartikel       = U|xkartikel^id
.formula M|kkuartnr       = U|xkkuartnr
.formula M|klabdiffstart  = U|xklabdiffstart
.formula M|klabhisvon     = U|xklabhisvon
.formula M|klabhisbis     = U|xklabhisbis
.copy M|klabedinachr     = U|xklabedinachr
.formula M|kbdiffkomplett = U|xkbdiffkomplett
.formula M|kbdiffeingang  = U|xkbdiffeingang
.formula M|kbdiffabterm   = U|xkbdiffabterm
.copy M|kbablage = U|xkbablage
..
..*****************************************************************************
!END
.continue
