..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : MULTISITE.EXPORT.RESPONSE
.. Autor          : dsch
.. Verantwortlich : dsch
.. Kontrolle      : mh
.. Funktion       : Aus der Datenbankgruppe Multisite-Nachricht (140:4) wird
..                  eine Rueckmeldung gesendet
.. Functionality  : sends a response from the object multisite message
..*****************************************************************************
..
.set trans -
..
.continue END ? M|nachrvstatusaz = "(New)"
.continue END ? M|nachrvstatusaz = "(Ignore)"
..
.type text U|xfopname ? _F|defined(U|xfopname)
.formula U|xfopname = "gen/multisite/d140/G04.FOP"
..
.continue END ? _F|fileexists(U|xfopname) ; F|isdir(U|xfopname)
..
.input 'U|xfopname'
..
!END
.continue
