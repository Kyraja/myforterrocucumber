..!interpreter english
..@@BEGINHEAD
..========================================================================
..==
..==  Name              : FOP.137.FTHFSTATUS
..==
..==  Pfad              : dfue
..==
..==  Funktion          : Anzeige der Beschreibung des Bearbeitungsstatus
..==
..==  Erstellungsdatum  : 19.05.1998
..==
..==  Autor             : alltrotec GmbH, Matthias Schrîder
..==  Verantwortlich    : mh
..==  notwendige Pfade  : dfue
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          : <zeigen>, <Ñndern>
..==
..==  Besonderheiten    : Anbindung an <hole>-Taste auf EDI-Kopf-Variable
..==                      status
..==
..==  Aenderungshistorie:
..==
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#FOP-Dateigrî·e(vor/nach)#ETF-Dateigrî·e(vor/nach)#
..#KOR#EDI#30.08.2001#0#ok#5614/00000#7303/0000#
..#KOR#EDI#31.01.2003#1#ok#
..#KOR#EDI#21.06.2005#2#ok#
..#KOR#EDI#17.02.2015#3#dsch#Variable tsuch wurde aus dem Infosystem EDICENTER abgeschafft.
..========================================================================
..@@ENDHEAD
..
.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
.set trans -
..... procedure stack pointer .....
.type integer   xprocsp
..>> Schalter, ob automatisch deaktiviert
.type bool       xAutoDeactivated
..>> EDI-Status
.type integer    xedistatus
..>> EDI-Status original
.type integer    xedistatuso
..>> EDI-Status-Beschreibung
.type text       xedistatusbeschr1
.type text       xedistatusbeschr2
.type text       xedistatusbeschr3
.type text       xedistatusbeschr4
.type text       xedistatusbeschr5
.type text       xedistatusbeschr6
.type text       xedistatusbeschr7
..>> FO-Befehl
.type text       xfobefehl
.type text       xtxt1
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
.formula xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
..>> Merken Status
.formula xedistatus = status
.formula xedistatuso = status
..
..
.continue EL001 ? _(xedistatus < 0)
.. IF001
..>> Testergebnis positiv: 12 addieren; Merken, da· automatisch geÑndert
.formula xedistatus = xedistatus + 12
.formula xAutoDeactivated = true
..
.continue FI001
!EL001
..>> Testergebnis negativ: Setzen, da· nicht automatisch geÑndert
.formula xAutoDeactivated = false
..
!FI001
..
..**ok,31.01.2003 (Test und xarb wurde entfernt)
..>> Unterprogramms aus DFUE.IMP.INI
.formula xdummvvlmes = "DFUE." + such + "MES"
.formula xdummvvlmes = "DFUE." + 'M|edinr^such' + "MES"  ? F|defined(M|edinr)
..
..**ok,21.06.2005 (Test der Datei Neu)
.formula xsys = "test -s dfue/" + xdummvvlmes
.system 'xsys' background
..
..
.continue EL002 ? _(mehr)
.. IF002
.. >> Testergebnis positiv: Holen Beschreibung des Bearbeitungsstatus
..>> Einlesen DFUE.XXXXXMES
.input 'xdummvvlmes'
..>> Test, ob aktueller Bearbeitungsstatus kleiner als Anzahl der Beschreibungen fÅr Bearbeitungsstatus
..
..
.continue EL003 ? _(xedistatus < xedinumstat)
.. IF003
.formula xtxt1 = xedirefstat.xedistatus
..>> Test, ob automatisch deaktiviert
..
..
.continue EL004 ? _(xAutoDeactivated)
.. IF004
.set trans +
.formula xtxt1 = xtxt1 + ";(automatisch deaktiviert)"
.set trans -
..
!EL004
.. FI004
..
.formula xedistatusbeschr1 =       ((xtxt1 << ";") << "") >> ""
.formula xedistatusbeschr2 =      (((xtxt1 >> ";") << ";") << "") >> ""
.formula xedistatusbeschr3 =     ((((xtxt1 >> ";") >> ";") << ";") << "") >> ""
.formula xedistatusbeschr4 =    (((((xtxt1 >> ";") >> ";") >> ";") << ";") << "") >> ""
.formula xedistatusbeschr5 =   ((((((xtxt1 >> ";") >> ";") >> ";") >> ";") << ";") << "") >> ""
.formula xedistatusbeschr6 =  (((((((xtxt1 >> ";") >> ";") >> ";") >> ";") >> ";") << ";") << "") >> ""
.formula xedistatusbeschr7 = ((((((((xtxt1 >> ";") >> ";") >> ";") >> ";") >> ";") >> ";") << ";") << "") >> ""
..
.continue FI003
!EL003
.set trans +
.formula xedistatusbeschr1 = "nicht verfÅgbar"
.set trans -
.formula xedistatusbeschr2 = ""
.formula xedistatusbeschr3 = ""
.formula xedistatusbeschr4 = ""
.formula xedistatusbeschr5 = ""
.formula xedistatusbeschr6 = ""
.formula xedistatusbeschr7 = ""
..
!FI003
..
..>> Anzeige Status
.box Info

 Beschreibung EDI-Bearbeitungsstatus 'xedistatuso' :

 'xedistatusbeschr1'
? 'xedistatusbeschr2' ? xedistatusbeschr2 <> ""
? 'xedistatusbeschr3' ? xedistatusbeschr3 <> ""
? 'xedistatusbeschr4' ? xedistatusbeschr4 <> ""
? 'xedistatusbeschr5' ? xedistatusbeschr5 <> ""
? 'xedistatusbeschr6' ? xedistatusbeschr6 <> ""
? 'xedistatusbeschr7' ? xedistatusbeschr7 <> ""

..
..
.continue FI002
!EL002
.box Meldung
nicht vorhanden oder leer
..
!FI002
..
.end .
..
