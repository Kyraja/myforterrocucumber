..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TESTDAT.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Allgemeine Events
.. Functionality  : General event handling
...Includes
..  include     dfue/TESTDAT.NEUEZEILE
..*****************************************************************************
.set trans -
..
..
.. event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue ALLE    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kballe"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kblieferant"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkunde"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkunsach"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbartikel"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbkunartbez"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbpackanw"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbvkrahmen"
.continue BOOL    ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbekrahmen"
.continue LAB     ? G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbliefab"
.. ----------- ----- Tabellenteil -- -------------------------------------------
.. deleting rows is allowed!
.continue ZEILEIN ? G|evtartengl = "ROW_INSERTION_BEFORE"
.continue FORBID  ? G|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!BOOL
.formula M|kballe = ( M|kblieferant & M|kbkunde & M|kbkunsach & M|kbartikel & M|kbkunartbez & M|kbpackanw & M|kbvkrahmen & M|kbekrahmen )
.formula M|kbliefab = G|false
.continue TABINIT
..
!ALLE
.formula M|kblieferant  = M|kballe
.formula M|kbkunde      = M|kballe
.formula M|kbkunsach    = M|kballe
.formula M|kbartikel    = M|kballe
.formula M|kbkunartbez  = M|kballe
.formula M|kbpackanw    = M|kballe
.formula M|kbvkrahmen   = M|kballe
.formula M|kbekrahmen   = M|kballe
.formula M|kbliefab     = G|false
.continue TABINIT
..
!LAB
.formula M|kballe  = G|false
.formula M|kblieferant  = M|kballe
.formula M|kbkunde      = M|kballe
.formula M|kbkunsach    = M|kballe
.formula M|kbartikel    = M|kballe
.formula M|kbkunartbez  = M|kballe
.formula M|kbpackanw    = M|kballe
.formula M|kbvkrahmen   = M|kballe
.formula M|kbekrahmen   = M|kballe
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows, refresh table
.make screen line -- ? M|tzeilen > 0
.continue END
..
!ZEILEIN
.continue FORBID  ?   M|aktzeile = 0
.continue FORBID  ?   F|empty(M|tdbgruppe)
.input "dfue/TESTDAT.NEUEZEILE"
.. row was created with FOP, stopping GUI from making a second row
.continue FORBID
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue
