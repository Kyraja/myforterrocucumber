..!interpreter english translate noabbrev
..!meta M|=dfue/EDICOLINVOICEPRINT
..*****************************************************************************
.. Name           : EDICOLINVOICEPRINT.RPF
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : Report footer, convert text data into printable data
..*****************************************************************************
.set trans -
..
.type bool vda ? _F|defined(U|vda)
.type bool edifact ? _F|defined(U|edifact)
.type bool odette ? _F|defined(U|odette)
..
.type bool hatSummenzeilen ? _F|defined(U|hatSummenzeilen)
.copy U|hatSummenzeilen = G|false
.. 
.type integer lfdnummer ? _F|defined(U|lfdnummer)
.type text lastinvoice ? _F|defined(U|lastinvoice)
.formula U|lfdnummer = 0
.formula U|lastinvoice = ""
..
.type text xtbetraghinweis ? _F|defined(U|xtbetraghinweis)
.set trans +
.formula U|xtbetraghinweis = "Alle Betr„ge in: {1}"
.set trans -
..
.select screen header
!NLINE
.select screen line
.continue END ? _G|mehr
.continue VDAROW ? _F|empty(M|trechnung) &   U|vda
.continue VDASUM ?  F|empty(M|trechnung) &   U|vda
.continue EDIROW ? _F|empty(M|trechnung) & ( U|edifact ; U|odette )
.continue EDISUM ?  F|empty(M|trechnung) & ( U|edifact ; U|odette )
.continue NLINE
..
!VDAROW
.continue NLINE
..
!VDASUM
.continue NLINE
..
!EDIROW
.. enumerate first row for same invoice
.formula U|lfdnummer = U|lfdnummer +1 ? U|lastinvoice<>M|trechnung
.formula M|tlfdnummer = U|lfdnummer ? U|lastinvoice<>M|trechnung
.formula U|lastinvoice = M|trechnung
.. invoice detail
.formula M|tbelegnr = M|trechnung
.assign  M|tbelegdatum = M|trechnungsdatum
.formula M|tbelegkunde = M|kkukurzname
.formula M|tbeleggln = M|kkugln
.assign M|tbelegnettobetrag = M|trebetragnetto
.assign M|tbelegsteuersatz = M|tstsatz
.assign M|tbelegsteuerbetrag = M|tstbetrag
.assign M|tbelegbruttobetrag = M|trebetragbrutto
.assign M|tbelegendbetrag = M|trebetragbrutto
.formula M|tbelegland = M|tland
.continue NLINE
..
!EDISUM
.copy M|terstesummenzeile = G|true ? _U|hatSummenzeilen
.copy U|hatSummenzeilen = G|true
.formula M|tbelegnr = ""
.assign  M|tbelegdatum = ""
.formula M|tbelegkunde = ""
.formula M|tbeleggln = ""
.assign M|tbelegnettobetrag = M|tnettobetragstsatz
.assign M|tbelegsteuersatz = M|tsteuersatz
.assign M|tbelegsteuerbetrag = M|tmwstbetragstsatz
.assign M|tbelegbruttobetrag = M|trechnungsenbetrag
.assign M|tbelegendbetrag = M|trechnungsenbetrag
.formula M|tbelegland = M|kland
.formula M|twaehrungstext = F|formatstr(U|xtbetraghinweis, M|tbelegland)
.continue NLINE
..
..*****************************************************************************
!END
.continue

