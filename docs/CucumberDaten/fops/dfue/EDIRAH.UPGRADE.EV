..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIRAH.UPGRADE.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Switch settings (allow editing of fields) for
..                  administation option.
..*****************************************************************************
.set trans -
..
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue LZEIT   ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kblzeit2vorlauf"
.continue VORLAUF ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbvorlauf2vorlauf"
.continue FZAHL0  ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbfzahlaufnull"
.continue FZAHL1  ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbfzahlausabruf"
.. ----------- ---------- ---------- -------------------------------------------
.continue FWARN   ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbfruehwarnneu"
.continue SPED    ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbspediteurneu"
.continue BUDAT   ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbudatersetzen"
.continue PACK    ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbpackanwneu"
.continue ABSCHL1 ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbabschlnrneu"
.continue ABSCHL2 ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbabschlnrausabruf"
.continue VERSART ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbversandartneu"
.continue PREIS   ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbpreiseneu"
.. ----------- ---------- ---------- -------------------------------------------
.continue PROZENT ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kpreisprozentneu"
.. ----------- ---------- ---------- -------------------------------------------
.continue END     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kabschlnrneu"
.continue PACKNEU ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kpackanwneu"
.continue FMENGE  ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kbfmengeneu"
.continue FMENGE2 ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kfmengeneu"
.continue END     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kfzdiffneu"
.continue END     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kzefzdiffneu"
.continue END     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kversandartneu"
.continue END     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kspediteurneu"
.continue END     ?  G|evtartengl = "FIELD_EXIT"    &  G|evtvar = "kneuesbudat"
.. ----------- ---------- ---------- -------------------------------------------
.continue RESET   ?  G|evtartengl = "BUTTON_AFTER"  &  G|evtvar = "kbuupgrade"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!LZEIT: must pick either vorlauf or lzeit
.copy M|kbvorlauf2vorlauf = G|false  ?  M|kblzeit2vorlauf
.continue END
!VORLAUF: must pick either vorlauf or lzeit
.copy M|kblzeit2vorlauf = G|false  ?  M|kbvorlauf2vorlauf
.continue END
..
!FZAHL0
.formula M|kfzahlprotokoll = "X.EDIRAH.CUMQTY.ZERO." + 'G|zeitpunkt:14'  ?  M|kbfzahlaufnull
.copy M|kbfzahlausabruf = G|false  ?  M|kbfzahlaufnull
.continue FZAHL
!FZAHL1
.formula M|kfzahlprotokoll = "X.EDIRAH.CUMQTY.FORECAST." + 'G|zeitpunkt:14'  ?  M|kbfzahlausabruf
.copy M|kbfzahlaufnull = G|false  ?  M|kbfzahlausabruf
!FZAHL
.copy M|kfzahlprotokoll = ""  ? _M|kbfzahlausabruf & _M|kbfzahlaufnull
.continue END
..
!SPED
.protection -reset kspediteurneu 0     ?  M|kbspediteurneu
.protection kspediteurneu 0            ? _M|kbspediteurneu
.assign M|kspediteurneu = ""        ? _M|kbspediteurneu
.continue END
..
!BUDAT
.protection -reset kneuesbudat 0  ?  M|kbudatersetzen
.protection kneuesbudat 0         ? _M|kbudatersetzen
.assign M|kneuesbudat = ""        ? _M|kbudatersetzen
.continue END
..
!PACK
.protection -reset kpackanwneu 0       ?  M|kbpackanwneu
.protection kpackanwneu 0              ? _M|kbpackanwneu
.assign M|kpackanwneu = ""          ? _M|kbpackanwneu
.assign M|kpackm = ""          ? _M|kbpackanwneu
.continue END
..
!FWARN
.protection -reset kfzdiffneu 0        ?  M|kbfruehwarnneu
.protection kfzdiffneu 0               ? _M|kbfruehwarnneu
.copy M|kfzdiffneu = 0.0            ? _M|kbfruehwarnneu
.protection -reset kzefzdiffneu 0      ?  M|kbfruehwarnneu
.protection kzefzdiffneu 0             ? _M|kbfruehwarnneu
.copy M|kzefzdiffneu = 0            ? _M|kbfruehwarnneu
.continue END
..
!ABSCHL1
.copy M|kbabschlnrausabruf = G|false  ?  M|kbabschlnrneu
.continue ABSCHL
!ABSCHL2
.copy M|kbabschlnrneu = G|false  ?  M|kbabschlnrausabruf
!ABSCHL
.protection -reset kabschlnrneu 0      ?  M|kbabschlnrneu
.protection kabschlnrneu 0             ? _M|kbabschlnrneu
.formula M|kabschlnrneu = ""           ? _M|kbabschlnrneu
.continue END
..
!VERSART
.protection -reset kversandartneu 0    ?  M|kbversandartneu
.protection kversandartneu 0           ? _M|kbversandartneu
.assign M|kversandartneu = ""       ? _M|kbversandartneu
.continue END
..
!PREIS
.protection -reset kpreisprozentneu 0  ?  M|kbpreiseneu
.protection kpreisprozentneu 0         ? _M|kbpreiseneu
.assign M|kpreisprozentneu = 0.0    ? _M|kbpreiseneu
.select screen header
!NPREIS
.select screen line
.continue EPREIS ? _G|mehr
.protection -reset preisneu 'M|aktzeile' ?  M|kbpreiseneu
.protection -reset tterm 'M|aktzeile'    ?  M|kbpreiseneu
.protection preisneu 'M|aktzeile'        ? _M|kbpreiseneu ; M|tbsavings
.protection tterm 'M|aktzeile'           ? _M|kbpreiseneu ; M|tbsavings
.continue NPREIS
!EPREIS
.. force price view in table
.input "EDIRAH.KBFELDER.FA"  ?  _M|kbpreise & M|kbpreiseneu
..
.. show old and new prices depending on percentage increase
!PROZENT
.type realx U|xproz
.formula U|xproz = 1.0
.formula U|xproz = ( M|kpreisprozentneu / 100 ) + 1.0
.select screen header
!NPROZ
.select screen line
.continue EPROZ ? _G|mehr
.continue NPROZ ?  M|tbsavings
.formula M|preisneu = M|preis * U|xproz
.continue NPROZ
!EPROZ
.continue END
..
!PACKNEU
.formula M|kpackm = "" ? F|empty(M|kpackanwneu)
.continue TABINIT ? F|empty(M|kpackanwneu)
.load 1 nolock packinginstructions 'M|kpackanwneu^id'
.load 1 line
.copy M|kpackm = 1|artikel
.load 1
.continue END
..
!FMENGE
.protection -reset kfmengeneu 0  ?  M|kbfmengeneu
.protection kfmengeneu 0         ? _M|kbfmengeneu
.assign M|kfmengeneu = 0.0       ? _M|kbfmengeneu
.select screen header
!NMENGE
.select screen line
.continue EMENGE ? _G|mehr
.protection -reset fmengeneu 'M|aktzeile' ?  M|kbfmengeneu
.protection fmengeneu 'M|aktzeile'        ? _M|kbfmengeneu ; F|empty(M|packanw) 
.continue NMENGE
!EMENGE
.continue END
..
!FMENGE2
.select screen header
!NMGE2
.select screen line
.continue EMGE2 ? _G|mehr
.formula M|fmengeneu = M|kfmengeneu ? _F|empty(M|packanw)
.continue NMGE2
!EMGE2
.continue END
..
!RESET
.protection kspediteurneu 0
.protection kneuesbudat 0
.protection kpackanwneu 0
.protection kfzdiffneu 0
.protection kzefzdiffneu 0
.protection kabschlnrneu 0
.protection kversandartneu 0
.protection kpreisprozentneu 0
.copy M|kbspediteurneu  = G|false
.copy M|kbudatersetzen  = G|false
.copy M|kbpackanwneu    = G|false
.copy M|kbfruehwarnneu  = G|false
.copy M|kbabschlnrneu   = G|false
.copy M|kbabschlnrausabruf = G|false
.copy M|kbversandartneu = G|false
.copy M|kbpreiseneu     = G|false
.copy M|kblzeit2vorlauf = G|false
.copy M|kbvorlauf2vorlauf = G|false
.copy M|kbfzahlaufnull  = G|false
.copy M|kbfzahlausabruf = G|false
.copy M|kpreisprozentneu = 0.0
.. lock price fields
.select screen header
!NRESET
.select screen line
.continue ERESET ? _G|mehr
.protection preis 'M|aktzeile'
.protection tterm 'M|aktzeile'
.protection preisneu 'M|aktzeile'
.protection fmengeneu 'M|aktzeile'
.add M|rahmen
.copy M|spediteur  = D|spediteur
.assign M|versand  = D|versand^sucherw
.copy M|tabschlnr  = D|abschlnr
.copy M|budat = D|budat
.add
.add M|tpos
.assign M|fzahl = D|fzahl
.continue EPACK ? F|empty(D|packanw)
.copy M|packanw = D|packanw
.load 1 nolock packinginstructions 'D|packanw^id'
.load 1 line
.formula M|packm = 1|artikel^id
.load 1
!EPACK
.copy M|fmenge = D|fmenge
.copy M|tvorlaufrah = D|vorlauf
.formula M|tterm = D|tterm
.copy M|preis = D|preis
.copy M|preisneu = M|preis
.. early warning only for sales
.copy M|tfzdiff = D|fzdiff ? D|dnr=3
.copy M|tzefzdiff = D|zefzdiff ? D|dnr=3
.add
.continue NRESET
!ERESET
.continue END
..
..*****************************************************************************
!END
.continue




