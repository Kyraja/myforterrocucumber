.formula M|icofehler = G|icoerror
..
.. Allowed directories
.select company 'F|formatstr("$,,;@gruppe=11;gruppe=11;bezeich={1}", G|bzeichen)'
.assign M|karb = H|arbber ? G|mehr
.select -
..
..*****************************************************************************
!END
