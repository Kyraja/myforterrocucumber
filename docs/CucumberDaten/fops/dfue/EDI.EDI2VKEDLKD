..
.. initialize procedure stack pointer
.formula xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
.set cancel -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
.. Prozedur: EDISchreibeProtokoll
..
!PROC001: ----- EDISchreibeProtokoll -----
..>> AnhÑngen von Informationen an Fehlerprotokoll bei Fehlern bzgl. der
..>> Verarbeitung von EKS-EDI-DatensÑtzen
..>>
..>> Parameter:
..>>
..>> Ein: - Name der Ergebnisprotokoll-Datei (xneprotokollerw)
..>>      - Name der Fehlerprotokoll-Datei (xnfprotokollerw)
..>>      - EKS-EDI-Identnummer des EKS-EDI-Datensatzes (xedinumactinnachr1)
..>>      - Beschreibungen der Fehlercodes (xedireffcod<i>)
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>      - globaler Schalter, ob Protokoll erweitert (xistfproterw)
..>>
..>> Interne Variablen: - xfobefehl
..>>
..
..>> Erfolg der Operation
.formula xprocreturn = true
..
.. >> Erweitern Protokoll-Datei
.select edifact 'xedinumactinnachr1'
..
.. >> Protokollzeile
....      Datum_Zeit     EDI-Nr    Vorgang  Vo Kunde    Fehl       Bemerkung
....    # 29.04.98_21:29 15        400005   3           52 ausgehende VK-RE 400005
....      29.04.98_21:29 16        400006   3  70001       ausgehende VK-RE 400006
.set separator=^
.formula xfobefehl = (('datum' + "_" + 'zeit' + "              ") << 14) + " "
.formula xfobefehl = xfobefehl + ((num + "         ") << 9) + " "
.formula xfobefehl = xfobefehl + ((ideksvor + "        ") << 8) + " "
.formula xfobefehl = xfobefehl + (('vorart' + "  ") << 2) + " "
.formula xfobefehl = xfobefehl + ((idkundeab + "        ") << 8) + " "
..
..
.continue EL001 ? _(fcode = 0)
.. IF001
..
.continue EL002 ? _((status = 5) ; (status = 6))
.. IF002
....                                 gespoolt      (e -> eingegegangen)
....                                 |             (v -> verarbeitet)
....                                 |
.formula xfobefehl = "  " + xfobefehl + " s " + (name << ";") + ((name >> ";") >> "")
..
.continue FI002
!EL002
..
.continue EL003 ? _(status = 10)
.. IF003
....                                 verarbeitet   (e -> eingegegangen)
....                                 |             (s -> gespoolt)
....                                 |
.formula xfobefehl = "  " + xfobefehl + " v " + (name << ";") + ((name >> ";") >> "")
..
.continue FI003
!EL003
....                                 eingegegangen (s -> gespoolt)
....                                 |             (v -> verarbeitet)
....                                 |
.formula xfobefehl = "  " + xfobefehl + " e " + (name << ";") + ((name >> ";") >> "")
..
!FI003
..
!FI002
..
.output addedto 'xneprotokollerw'
.length 1
.right 80
.tablerecord
..
.continue FI001
!EL001
.formula xfobefehl = "# " + xfobefehl + (('fcode' + "  ") << 2) + " " + 'xedireffcod.fcode'
..
.formula xistfproterw = true
..
.output addedto 'xnfprotokollerw'
.length 1
.right 80
.tablerecord
..
!FI001
..
'xfobefehl'
.set
..
.output new WERF.WEG
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSErzeugePost
..
!PROC002: ----- EKSErzeugePost -----
..>> Erzeugen ABAS-Post mit Protokoll Åber:
..>> - Fehler (xistfehler = true)
..>> - Ergebnis (xistfehler = false)
..>>
..>> Parameter:
..>>
..>> Ein: - <ABAS-Modul><Vorgang><Vorgangstyp> (xmmvvl)
..>>      - Schalter, ob Fehler (xistfehler)
..>>      - Name der Ergebnisprotokoll-Datei (xneprotokollerw)
..>>      - Name der Fehlerprotokoll-Datei (xnfprotokollerw)
..>>      - Name des DFUE-Programms (xdfueprog)
..>>      - ABAS-Post-Verteiler fÅr EDL-Meldungen import Ergebnisse (xPostEmpfOut)
..>>      - ABAS-Post-Verteiler fÅr EDL-Meldungen import Fehler (xPostEmpfErr)
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>
..>> Interne Variablen: - Verteiler (xPostEmpf)
..>>                    - Betreff (xPostBetreff)
..>>                    - Protokoll-Datei (xPostFtext)
..>>                    - Stichworte
..>>                      (xPostStichw1, xPostStichw2, xPostStichw3, xPostStichw4)
..>>
..
..>> Erfolg der Operation
.formula xprocreturn = true
..
.. >> Erzeugen abas Post
..>> Test, ob Fehlerprotokoll
..
..
.continue EL004 ? _(xistfehler)
.. IF004
..>> EmpfÑnger
.formula xPostEmpf = xPostEmpfErr
..>> Betreff
.set trans +
.formula xPostBetreff = xdfueprog + ": Operationen fehlerhaft ausgefÅhrt (siehe Freitext 1)"
.set trans -
..>> Fehlerprotokoll-Datei
.formula xPostFtext = xnfprotokollerw
..>> Stichworte
.set trans +
.formula xPostStichw1 = "DFUE"
.formula xPostStichw2 = xmmvvl
.formula xPostStichw3 = "Eingang"
.formula xPostStichw4 = "Fehler"
.set trans -
..
..
.continue EL005 ? _(xPostEmpf <> "")
.. IF005
.input 'xdPostSenden' ? xPostEmpf<>""
..
!EL005
.. FI005
..
!EL004
.. FI004
..
.formula xsybefehl = "grep -s -E '.*eingehende EDL-Meldung$' " + xneprotokollerw + " > ${DEVNULL:-/dev/null}"
.system 'xsybefehl' background
..
..>> Test, ob (mindestens) eine neue EDL-Meldungen eingetragen oder verarbeitet
..
..
.continue EL006 ? _(mehr)
.. IF006
..>> EmpfÑnger
.formula xPostEmpf = xPostEmpfOut
..>> Betreff
.set trans +
.formula xPostBetreff = xdfueprog + ": Operationen fehlerfei ausgefÅhrt (siehe Freitext 1)"
.set trans -
..>> Protokoll-Datei
.formula xPostFtext = xneprotokollerw
..>> Stichworte
.set trans +
.formula xPostStichw1 = "DFUE"
.formula xPostStichw2 = xmmvvl
.formula xPostStichw3 = "Eingang"
.formula xPostStichw4 = "Ergebnis"
.set trans -
..
.continue FI006
!EL006
.formula xPostEmpf = ""
..
!FI006
..
..
.continue EL007 ? _(xPostEmpf <> "")
.. IF007
.input 'xdPostSenden' ? xPostEmpf<>""
..
!EL007
.. FI007
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSDruckeProtokoll
..
!PROC003: ----- EKSDruckeProtokoll -----
..>> Erzeugen ABAS-Druck mit Protokoll Åber:
..>> - Fehler (xistfehler = true)
..>> - Ergebnis (xistfehler = false)
..>>
..>> Parameter:
..>>
..>> Ein: - <ABAS-Modul><Vorgang><Vorgangstyp> (xmmvvl)
..>>      - Schalter, ob Fehler (xistfehler)
..>>      - Name der Ergebnisprotokoll-Datei (xneprotokollerw)
..>>      - Name der Fehlerprotokoll-Datei (xnfprotokollerw)
..>>      - Name des DFUE-Programms (xdfueprog)
..>>      - ABAS-Drucker fÅr EDL-Meldungen import Ergebnisse (xProtDruckerOut)
..>>      - ABAS-Drucker fÅr EDL-Meldungen import Fehler (xProtDruckerErr)
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>
..>> Interne Variablen: - Drucker (xProtDrucker)
..>>                    - Protokoll-Datei (xProtText)
..>>
..
..>> Erfolg der Operation
.formula xprocreturn = true
..
.. >> Erzeugen abas-Druck
..>> Test, ob Fehlerprotokoll
..
..
.continue EL008 ? _(xistfehler)
.. IF008
..>> Drucker
.formula xProtDrucker = xProtDruckerErr
..>> Druck-Datei
.formula xProtText = xnfprotokollerw
..
..>> Test, ob Druckername konfiguriert
..
..
.continue EL009 ? _(xProtDrucker <> "")
.. IF009
.output 'xProtDrucker'
.input "BLANKOB.F"
.input 'xProtText'
.output terminal
..
!EL009
.. FI009
..
!EL008
.. FI008
..
.formula xsybefehl = "grep -s -E '.*eingehende EDL-Meldung$' " + xneprotokollerw + " > ${DEVNULL:-/dev/null}"
.system 'xsybefehl' background
..
..>> Test, ob (mindestens) eine neue EDL-Meldungen eingetragen oder verarbeitet
..
..
.continue EL010 ? _(mehr)
.. IF010
..>> Drucker
.formula xProtDrucker = xProtDruckerOut
..>> Druck-Datei
.formula xProtText = xneprotokollerw
..
.continue FI010
!EL010
.formula xProtDrucker = ""
..
!FI010
..
..
.continue EL011 ? _(xProtDrucker <> "")
.. IF011
.output 'xProtDrucker'
.input "BLANKOB.F"
.input 'xProtText'
.output terminal
..
!EL011
.. FI011
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSErgaenzePermanentesProtokoll
..
!PROC004: ----- EKSErgaenzePermanentesProtokoll -----
..>> AnhÑngen der Erweiterungen des Protokolls an permanente Protokoll-Datei
..>>
..>> Parameter:
..>>
..>> Ein: - globaler Schalter, ob Fehlerprotokoll erweitert
..>>        (xistfproterw)
..>>      - Name der Ergebnisprotokoll-Datei
..>>        Erweiterung (xnfprotokollerw)
..>>      - Name der Fehlerprotokoll-Datei
..>>        Erweiterung (xnfprotokollerw)
..>>      - Name der Protokoll-Datei (xnfprotokoll)
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>
..>> Interne Variablen: - xsybefehl
..>>
..
..>> Erfolg der Operation
.formula xprocreturn = true
..
.. >> Erweitern permanente Protokoll-Dateien
..>> Test, ob Name fÅr permanente Protoll-Datei konfiguriert
..
..
.continue EL012 ? _(xnfprotokoll <> "")
.. IF012
.output addedto 'xnfprotokoll'
.length 1
.right 80
.tablerecord
..
.formula xsybefehl = "grep -s -E '.*eingehende EDL-Meldung$' " + xneprotokollerw + " > ${DEVNULL:-/dev/null}"
.system 'xsybefehl' background
..
..>> Test, ob (mindestens) eine neue EDL-Meldungen eingetragen oder verarbeitet
..
..
.continue EL013 ? _(mehr)
.. IF013
.input 'xneprotokollerw'
..
.output addedto 'xnfprotokoll'
.length 1
.right 80
.tablerecord

..
!EL013
.. FI013
..
..>> Test, ob Fehler
..
..
.continue EL014 ? _(xistfproterw)
.. IF014
.input 'xnfprotokollerw'
..
.output addedto 'xnfprotokoll'
.length 1
.right 80
.tablerecord

..
!EL014
.. FI014
..
.output new WERF.WEG
..
.formula xsybefehl = "rm -f " + xneprotokollerw + " 1> ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
