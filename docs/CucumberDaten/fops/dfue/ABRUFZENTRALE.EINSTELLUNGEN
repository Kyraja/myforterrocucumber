..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABRUFZENTRALE.EINSTELLUNGEN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Default settings, @see ABRUFZENTRALE.ME how to overload
..*****************************************************************************
.set trans -
..
.. Color of selected row
.formula M|kchartzeilefarbe = U|xabaslightgreen3
..
.. Color of deliveries in 2x2 charts register
.. See online help for chart-color constants!
.formula M|kfarbelieferung = "28"
.. Color for work-free days
.. See online help for chart-color constants!
.formula M|kfarbearbeitsfrei = "35"
..
.. Start with week as default date range for primary chart
.copy M|kbwochen = G|true
.copy M|kbmonate = G|false
.copy M|kbtage   = G|false
.copy M|kblieferungen = G|false
..
.. Hide cumulated quantities before and after shown date range
.copy M|kbzeigevor = G|false
.copy M|kbzeigenach = G|false
..
.. Remove non-critical rows after evaluating forecasts
.copy M|kbfilteralle = G|false
.copy M|kbfilterFQgruen = G|true
.copy M|kbfilterFQgelb = G|true
.copy M|kbfilterFQrot = G|true
.copy M|kbfilterrueckstand = G|true
.copy M|kbfilterfwdiff = G|true
..
.. Pick used reference quantity
.copy M|kbrefvergangenheit = G|true
.copy M|kbrefvorgaenger = G|false
.copy M|kbrefneuster = G|false
..
.. Shift evaluation date - e.g. looking at historic forecasts
.formula M|kstichtag = G|datum
.formula M|kzeitraum = 5
.formula M|kmaxzeitraum = 60
..
.. Show which FQ/TS in table?
.copy M|kbkennzinlupe = G|false
.copy M|kbkennztag1 = G|false
.copy M|kbkennztag2 = G|false
.copy M|kbkennztag3 = G|false
.copy M|kbkennztag4 = G|false
.copy M|kbkennztag5 = G|false
.copy M|kbkennzwoche1 = G|false
.copy M|kbkennzwoche2 = G|false
.copy M|kbkennzwoche3 = G|false
.copy M|kbkennzwoche4 = G|false
.copy M|kbkennzmonat1 = G|false
.copy M|kbkennzmonat2 = G|false
.copy M|kbkennzmonat3 = G|false
.copy M|kbkennzmonat4 = G|false
.copy M|kbkennz5tage = G|false
.copy M|kbkennz2wochen = G|false
.copy M|kbkennz4wochen = G|true
.copy M|kbkennz2monate = G|false
.copy M|kbkennz4monate = G|false
.. Show which delivery quanties in table?
.copy M|kbliefertag1 = G|true
.copy M|kbliefertag2 = G|false
.copy M|kbliefertag3 = G|false
.copy M|kbliefertag4 = G|false
.copy M|kbliefertag5 = G|false
.copy M|kblieferwoche1 = G|true
.copy M|kblieferwoche2 = G|false
.copy M|kblieferwoche3 = G|false
.copy M|kblieferwoche4 = G|false
..
.. Assign Icon to status
.formula M|kstatusgruen = G|icook
.formula M|kkenngruen = G|icoukrit
.formula M|kkenngelb = G|icovkrit
.formula M|kkennrot = G|icokrit
.formula M|kfruehwarnung = "icon:attention"
.formula M|krueckstand = "icon:flash"
..
.formula M|kkenngelbtag   = 10.0
.formula M|kkenngelbwoche = 10.0
.formula M|kkenngelbmonat = 10.0
..
.formula M|kkennrottag   = 15.0
.formula M|kkennrotwoche = 15.0
.formula M|kkennrotmonat = 15.0
..
.. Only read delivery forecasts and not JITs
.copy M|kbnurlieferabrufe = G|true
..
.. Do not use individual status FOP (@see dfue/ABRUFZENTRALE.TAB)
.copy M|kbindivstatus = G|false
..
..*****************************************************************************
!END
.continue
