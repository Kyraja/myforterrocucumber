.formula M|gadrucker    =  T|xgadrucker
.formula M|selededlschl =  T|xselededlschlna
.formula M|duedi2vkedl  =  T|xduedi2vkedl
.formula M|duvkedlmes   =  T|xduvkedlmes
.formula M|edldrucker   =  T|xedldrucker
.formula M|ladpostvkedl =  T|xduladpostvkedl
..*****************************************************************************
!END
.continue
..
