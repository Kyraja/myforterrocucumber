.formula M|timeoutlad   =  T|xtimtestaktlader
.formula M|timeoutproz  =  T|xtimtestladerakt
.formula M|waittime     =  T|xwaitforinhousetout
.formula M|waitcount    =  T|xwaitforinhousecnt
.formula M|ihssversion  =  T|xihssversion
.formula M|prgvkauv1    =  T|xdpostsenden
.formula M|prgvkauv2    =  T|xduin
.formula M|prgvkauv3    =  T|xduchkfile
.formula M|prgvkauv4    =  T|xduihss2edi
.formula M|prgvkauv5    =  T|xduladstart
.formula M|prgvkauv6    =  T|xdummvvlmes
.formula M|prgvkauv7    =  T|xduedi2vkauv
