.. Functionality  : Common/Simple Events of info system
..*****************************************************************************
.set trans -
..
..<META M|='dfue/EDIIMPVER'> 
..
..  Event evaluation
.. ----------- ----- Header -------- -------------------------------------------
.continue ALLEKD  ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kballekunden"
.continue NBOOL   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kballe"
.continue NBOOL   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbabrufe"
.continue NBOOL   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbpus"
.continue NBOOL   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kborders"
.continue NBOOL   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbedl"
.continue NBOOL   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kblako"
.. ----------- ----- Table ------ ----------------------------------------------
.. Inserting and Deleting rows is allowed!
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!NBOOL
.copy M|kballe = G|false
.copy M|kbabrufe = G|false
.copy M|kbpus = G|false
.copy M|kborders = G|false
.copy M|kbedl = G|false
.copy M|kblako = G|false
.copy M|.evtvar = G|true
.input "dfue/EDIIMPVER.KBUPRUEFEN.BN"
.continue END
..
!ALLEKD
.make screen line -- ?  M|kballekunden
.continue END
..
..*****************************************************************************
!END
.continue
