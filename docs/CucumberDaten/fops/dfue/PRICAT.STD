..!interpreter english translate
.continue ENDE ? M|begin=false
.type bool xerst
.formula xpprot = "XPPROT" + M|idprialt + ".TMP"
.formula xsys = "rm -f " + xpprot
.system 'xsys'
.continue KOPF
