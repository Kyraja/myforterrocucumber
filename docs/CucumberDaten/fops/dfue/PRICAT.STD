.set trans -
..
!KOPF
.type text xtdatname
.formula xtdatname = "PRICAT" + pid + ".TMP"
.output new 'xtdatname'
.formula M|dateiname = xtdatname
.input "DATEI.F"
.type text xPGNRvor
.formula xPGNRvor = "XX"
.type bool xanfang
.formula xanfang  = true
.type bool xPGI
.formula xPGI = true
.type text xnumvor
.formula xpprot = "XPPROT" + M|idprialt + ".TMP"
.output new 'xpprot'
.formula M|pprot = xpprot
.output
.select add
.reserve -
.select -
.select screen header
.type text xtsatzunbi
.type text xtsatzunhi
.type text xtntyp
.type text xversfrgnr
.type text xbelegart
.type text xverworg
.type text xtsatzbgm1
.type text xdatum
.type text xfunktion
.type text xtsatzdah1
.type text xrefdat1
.type text xrefdat2
.type text xtsatzsup1
.type text xtsatzsup2
.type text xtsatzbuy1
.type text xtsatzbuy2
.type text xtsatzmfa1
.type text xtsatzmfa2
.formula xtsatzunbi = "UNBI"
.formula xtversion1 = "01"
.formula xtsatzunhi = "UNHI"
.formula xtntyp = "PRICAT"
.formula xversfrgnr = "D 96B"
.formula xbelegart = "9"
.formula xverworg = "UN"
.formula xtsatzbgm1 = "BGMI"
.formula T|xdatum = datum:8
.formula xfunktion = "9"
.formula xtsatzdah1 = "DAH1"
.formula T|xrefdat1 = M|datvom:8
.formula T|xrefdat2 = M|datbis:8
.formula xtsatzsup1 = "SUP1"
.formula xtsatzsup2 = "SUP2"
.formula xtsatzbuy1 = "BUY1"
.formula xtsatzbuy2 = "BUY2"
.formula xtsatzmfa1 = "MFA1"
.formula xtsatzmfa2 = "MFA2"
.formula T|xagln = F|sysinfo(10)^gln
.formula T|xsugln = F|sysinfo(10)^gln
.select add M|kunde
.formula T|xbfunktion = H|funktion ? mehr
.formula T|xbgln = H|gln ? mehr
.formula T|xbnum = H|num ? mehr
.formula T|xbustid = H|ustid ? mehr
.formula T|xegln = H|gln ? mehr
.formula T|xfrbez = H|frbez ? mehr
.select add
!UNBI
.output addedto 'xtdatname'
'xtsatzunbi'#'xtversion1'#'xagln'###'xegln'####################
.output
!UNHI
.output addedto 'xtdatname'
'xtsatzunhi'#'xtversion1'##'xtntyp'#'xversfrgnr'#'xbelegart'#'xverworg'###################
.output
!BGMI
.output addedto 'xtdatname'
'xtsatzbgm1'#'xtversion1'##'xdatum'#'xfunktion'#####################
.output
!DAH1
.output addedto 'xtdatname'
'xtsatzdah1'#'xtversion1'###'xrefdat1'#'xrefdat2'####################
.output
!SUP1
.output addedto 'xtdatname'
'xtsatzsup1'#'xtversion1'#'xsugln'#'xfrbez'######################
.output
!SUP2
.output addedto 'xtdatname'
'xtsatzsup2'#'xtversion1'########################
.output
!BUY1
.output addedto 'xtdatname'
'xtsatzbuy1'#'xtversion1'#'xbgln'#'xbnum'#####'xbustid'#'xbfunktion'################
.output
!BUY2
.output addedto 'xtdatname'
'xtsatzbuy2'#'xtversion1'########################
.output
!MFA1
.output addedto 'xtdatname'
'xtsatzmfa1'#'xtversion1'########################
.output
!MFA2
.output addedto 'xtdatname'
'xtsatzmfa2'#'xtversion1'########################
.output
.type text xtsatzpgi1
.type text xPGTYP
.type text xPGNR
.type text xtsatzlin1
.type text xartaktiv
.type text xtsatzart1
.type text xgtin
.type text xkuartnr
.type text xsuartnum
.type text xvbez
.type text xtsatzqt11
.type text xtstmge
.type text xmeinheit
.type text xrabnat
.type text xtsatzpri1
.type text xpreis
.type text xmasseinhq
.type text xvkpreis
.type text xwaehrung
.type text xtsatzrng1
.type text xARTBERQ
.type text xmeinheit
.type text xbergrunt
.type text xtstmge
.type text xtsatzalc1
.type text xprozsatzq
.type text xprozsatz
.type text xtsatzqt12
.continue POSITIONEN
..
!POSITIONEN
.select screen line
.formula xmehr = mehr
.continue ACT1 ? _xmehr
.formula xtsatzpgi1 = "PGI1"
.formula xtsatzlin1 = "LIN1"
.formula xtsatzart1 = "ART1"
.formula xtsatzqt11 = "QTY1"
.formula xtsatzpri1 = "PRI1"
.formula xtsatzpri1 = "PRI1"
.formula xtsatzrng1 = "RNG1"
.formula xARTBERQ = "4"
.formula xtsatzalc1 = "ALC1"
.formula xtsatzqt12 = "QTY1"
.type text xmasseinhq
.type text xvkpreis
..**ok,03.08.2006 (unten M|num --> M|art)
.select add M|art
.continue EART
.formula T|xgtin = H|gtin
.formula T|xkuartnr  = H|kuartnr
.formula T|xmasseinhq = H|vpe
.formula xposphe = 'H|vpe(L=":")'
.input "EDI.UNITS"
.formula xmasseinhq = U|eiso ? _F|empty(U|eiso)
.formula T|xsuartnum = H|num
.formula T|xvbez = H|vbez
.formula T|xvkpreis = H|vpr
.formula xmarke = "VPRGRP"
.input "SAM.PRICAT"
.formula T|xwaehrung = H|vland
.select add
!EART
.formula x1tdatname = "XNEU" + M|idprialt + 'M|art^nummer' + ".TMP"
.continue PRUEF ? xanfang = true  ;  xPGI    = false
!PGI1
.output addedto 'xtdatname'
'xtsatzpgi1'#'xtversion1'#'xPGTYP'##'xPGNR'#####################
.output
!PRUEF
.formula xmarke = "ACTCPRU"
.input "SAM.PRICAT"
.type real xrpreis
!ACT1
.formula xmarke = "ACTCODE"
.input "SAM.PRICAT"
.continue FUSS ? _xmehr
!LIN1
.formula xzaehler = 0
!ART1
.output addedto 'x1tdatname'
'xtsatzart1'#'xtversion1'#'xgtin'#'xkuartnr'#'xsuartnum'#####'xvbez'################
.output
.formula xmarke = "VPRFIND"
.input "SAM.PRICAT"
.continue PRI1 ? xmitstapel=false
.formula xmarke = "VPRZUOR"
.input "SAM.PRICAT"
.continue PRI1 ? xrabnat="0.00"
!QTY11
.formula xmarke = "VPRZUOR"
.input "SAM.PRICAT"
.continue PRI1 ? xrabnat="0.00"
.output addedto 'x1tdatname'
'xtsatzqt11'#'xtversion1'#'xtstmge'#'xmeinheit'#'xrabnat'#####################
.output
!PRI1
.formula xrpreis  = 'xpreis'
.formula xvkpreis = xpreis ? xrpreis>0
.output addedto 'x1tdatname'
'xtsatzpri1'#'xtversion1'##'xpreis'####'xmasseinhq'####'xvkpreis'#######'xwaehrung'#######
.output
.formula xzaehler= xzaehler + 1
.continue POSITIONEN ? (_xmitstapel & xprozsatzq="")   ;  xzaehler>xi
!RNG11
.output addedto 'x1tdatname'
'xtsatzrng1'#'xtversion1'#'xARTBERQ'#'xmeinheit'#'xbergrunt'#'xtstmge'####################
.output
.continue POSITIONEN ? (_xmitstapel & xprozsatzq="")   &  xzaehler=xi
.continue QTY11 ? xzaehler<xi & xprozsatzq=""
!ALC1
.output addedto 'x1tdatname'
'xtsatzalc1'#'xtversion1'######'xprozsatzq'#'xprozsatz'#################
.output
.continue POSITIONEN ? _xmitstapel
.continue QTY11 ? xzaehler<xi
.continue POSITIONEN
..
!FUSS
.select screen line
.type text xtsatzunzi
.formula xtsatzunzi = "UNZI"
.select add
!UNZI
.output addedto 'xtdatname'
'xtsatzunzi'#'xtversion1'########################
.output
.continue ENDE
..
!ENDE
!EINACT
.formula xactprot = "XACTPROT" + M|idprialt + ".TMP"
.formula xsys = "grep ART1 " + 'M|pprot' + " > " + xactprot
.system 'xsys'
.. Es wird getestet, ob die Datei mit dem Namen "XALT.." existiert und die
.. Dateigr”áe gr”áer als 0 ist
.formula xsys = "test -s " + xactprot
.system 'xsys'
.continue E0 ? _mehr
.select screen header
!ZEIL
.select screen line
.continue E0 ? _mehr
.reserve
!DATHOL
.select from 'xactprot' x1 # x2 # x3 # x4 # x5 #
.continue E0 ? _mehr
.continue DATHOL                             ? x5<>'M|art^nummer'
.formula xacode = x2
.formula M|actcode = xacode                     ? _(xacode/"*01*")
.formula M|actcode = "3"                        ? xacode/"*01*"
.select
.continue ZEIL
!E0
.continue
