.set trans -
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkunde"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kwerk"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kablstelle"
.. ----------- ---------- ---------- -------------------------------------------
.continue MASKEIN ? G|evtartengl = "SCREEN_ENTER"
.. ----------- ----- Tabellenteil ----------------------------------------------
.. row deleting / sorting is allowed, inserting is not
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!MASKEIN
.formula M|klesavings = G|icovkrit           
.formula M|klekonflikt = G|icokrit         
.formula M|klegebucht = G|icoukrit         
.formula M|klesperrstop = "icon:stop"
.continue END
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
