..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDICENTER.KBSTATUS.FA
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans +
.type text xALLE
.formula U|xALLE = "ALLE"
.type text xFehlerhaft
.formula U|xFehlerhaft = "Fehlerhaft"
.type text xErledigt
.formula U|xErledigt = "Erledigt"
.type text xInVerarbeitung
.formula U|xInVerarbeitung = "In Verarbeitung"
.type text xDeaktiviert
.formula U|xDeaktiviert = "Deaktiviert"
.type text xNeu
.formula U|xNeu = "Neu"
.set trans -
..
..
.. event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue ALLE    ?  T|evtartengl = "FIELD_EXIT"  &  T|evtvar = "kbstatusalle"       & M|kbstatusalle
.continue ERL     ?  T|evtartengl = "FIELD_EXIT"  &  T|evtvar = "kbstatuserledigt"   & M|kbstatuserledigt
.continue NEU     ?  T|evtartengl = "FIELD_EXIT"  &  T|evtvar = "kbstatusneu"        & M|kbstatusneu
.continue DEA     ?  T|evtartengl = "FIELD_EXIT"  &  T|evtvar = "kbstatusinaktiv"    & M|kbstatusinaktiv
.continue FEHL    ?  T|evtartengl = "FIELD_EXIT"  &  T|evtvar = "kbstatusfehler"     & M|kbstatusfehler
.continue INVE    ?  T|evtartengl = "FIELD_EXIT"  &  T|evtvar = "kbstatusverarb"     & M|kbstatusverarb
.. ----------- ---------- ---------- -------------------------------------------
.. Standard-Setting: Falls unklar -> "Alle" ankreuzen
.continue ALLE
..
..
!ALLE
.. Alle
.formula M|astatus   = "!"
.formula M|statname  = U|xALLE
.. Ankreuzfelder Status setzen: nur eins markiert
.formula M|kbstatusalle     = true
.formula M|kbstatuserledigt = false
.formula M|kbstatusneu      = false
.formula M|kbstatusinaktiv  = false
.formula M|kbstatusfehler   = false
.formula M|kbstatusverarb   = false
.continue INIT
..
!FEHL
.. Fehlerhaft
.formula M|astatus   = "4"
.formula M|statname  = U|xFehlerhaft
.. Ankreuzfelder Status setzen: nur eins markiert
.formula M|kbstatusalle     = false
.formula M|kbstatuserledigt = false
.formula M|kbstatusneu      = false
.formula M|kbstatusinaktiv  = false
.formula M|kbstatusfehler   = true
.formula M|kbstatusverarb   = false
.continue INIT
..
!ERL
.. Erledigt
.formula M|astatus   = "0"
.formula M|statname  = U|xErledigt
.. Ankreuzfelder Status setzen: nur eins markiert
.formula M|kbstatusalle     = false
.formula M|kbstatuserledigt = true
.formula M|kbstatusneu      = false
.formula M|kbstatusinaktiv  = false
.formula M|kbstatusfehler   = false
.formula M|kbstatusverarb   = false
.continue INIT
..
!INVE
.. In Verarbeitung
.formula M|astatus   = "5!10"
.formula M|statname  = U|xInVerarbeitung
.. Ankreuzfelder Status setzen: nur eins markiert
.formula M|kbstatusalle     = false
.formula M|kbstatuserledigt = false
.formula M|kbstatusneu      = false
.formula M|kbstatusinaktiv  = false
.formula M|kbstatusfehler   = false
.formula M|kbstatusverarb   = true
.continue INIT
..
!DEA
.. Inaktiv / Deaktiviert
.formula M|astatus   = "-9"
.formula M|statname  = U|xDeaktiviert
.. Ankreuzfelder Status setzen: nur eins markiert
.formula M|kbstatusalle     = false
.formula M|kbstatuserledigt = false
.formula M|kbstatusneu      = false
.formula M|kbstatusinaktiv  = true
.formula M|kbstatusfehler   = false
.formula M|kbstatusverarb   = false
.continue INIT
..
!NEU
.. Neu
.formula M|astatus   = "2!3"
.formula M|statname  = U|xNeu
.. Ankreuzfelder Status setzen: nur eins markiert
.formula M|kbstatusalle     = false
.formula M|kbstatuserledigt = false
.formula M|kbstatusneu      = true
.formula M|kbstatusinaktiv  = false
.formula M|kbstatusfehler   = false
.formula M|kbstatusverarb   = false
.continue INIT
..
..
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue
