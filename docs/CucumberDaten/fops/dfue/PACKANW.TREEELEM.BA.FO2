..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PACKANW.TREEELEM.BA.FO2
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : expand or collapse rows with objects using the given packaging instruction
..*****************************************************************************

..<META M|='dfue/PACKANW'>

def main() {
    .set trans -

    .type integer row
    .formula U|row = M|aktzeile

    if (M|tbuverwendungen = "icon:plus_black") {
        .call showUsageCount()
    } else {
        .call collapse()
    }
    
    .call paint()
    .select screen line 'U|row'
}

def showUsageCount( ) { 
    .type P106:1 packInstruction
    .type integer usageCount
    .type integer partsCount
    .type integer propertiesCount
    .type integer blanketOrdersCount
    .type integer ordersCount
    .type integer packingSlipsCount
    .type integer shippingOrdersCount
    .type integer prodCount
    
    .copy U|packInstruction = M|tpackanw
    .formula U|usageCount = M|tanzverwend
    .formula U|partsCount = M|tverwendartikelz 
    .formula U|propertiesCount = M|tverwendkuartbezz 
    .formula U|blanketOrdersCount = M|tverwendrahmenz 
    .formula U|ordersCount = M|tverwendauftragz
    .formula U|packingSlipsCount = M|tverwendlieferz
    .formula U|shippingOrdersCount = M|tverwendvplanz
    .formula U|prodCount = M|tverwendfertvorz

    if (U|partsCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction
        .formula M|tanzverwend = U|partsCount
        .set trans +
        .formula M|tverwendgruppe = "Artikel"  
        .set trans -
        .copy M|tverwendartikel = G|true
        .copy M|tverwendet = G|true
    }
    if (U|propertiesCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction
        .formula M|tanzverwend = U|propertiesCount
        .set trans +
        .formula M|tverwendgruppe = "Kundenartikeleigenschaften"  
        .set trans -
        .copy M|tverwendkuartbez = G|true
        .copy M|tverwendet = G|true
    }
    if (U|blanketOrdersCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction
        .formula M|tanzverwend = U|blanketOrdersCount
        .set trans +
        .formula M|tverwendgruppe = "Rahmenauftrag"
        .set trans -
        .copy M|tverwendrahmen = G|true
        .copy M|tverwendet = G|true
    }
    if (U|ordersCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction
        .formula M|tanzverwend = U|ordersCount
        .set trans +
        .formula M|tverwendgruppe = "Auftrag"
        .set trans -
        .copy M|tverwendauftrag = G|true
        .copy M|tverwendet = G|true
    }
    if (U|packingSlipsCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction^id
        .formula M|tanzverwend = U|packingSlipsCount
        .set trans +
        .formula M|tverwendgruppe = "Lieferschein"
        .set trans -
        .copy M|tverwendliefer = G|true
        .copy M|tverwendet = G|true
    }
    if (U|shippingOrdersCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction
        .formula M|tanzverwend = U|shippingOrdersCount
        .set trans +
        .formula M|tverwendgruppe = "Versandplanung"  
        .set trans -
        .copy M|tverwendvplan = G|true
        .copy M|tverwendet = G|true
    }
    if (U|prodCount > 0) {
        .make screen line +O
        .formula M|tbuverwendungen = "icon:screen_view"
        .formula M|tpackanwx = U|packInstruction
        .formula M|tanzverwend = U|prodCount
        .set trans +
        .formula M|tverwendgruppe = "Fertigung"
        .set trans -
        .copy M|tverwendfertvor = G|true
        .copy M|tverwendet = G|true
    }
    .select screen line 'U|row'
    .formula M|tbuverwendungen = "icon:minus_black"
} 

def collapse() {
    .select screen line
    while ( F|empty(M|tpackanw)) {
        .make screen line -O
    }
    .select screen line 'U|row'
    .formula M|tbuverwendungen = "icon:plus_black"
}


def paint() {
    .input "is/ABASFARBEN.DEF"
    .select screen header
    .select screen line
    while (G|mehr) {
        if (F|empty(M|tpackanw)) {
            .colour -foreground -1 -1 -1 -background 'U|xabasstructuresub' 'M|aktzeile'
        } else {
            .colour -foreground -1 -1 -1 -background -1 -1 -1 'M|aktzeile'
        }
        .select screen line
    }
}
