..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    :
..==
..==  Aenderungshistorie:
..==
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#EDL#01.11.2002#0#ok#
..#KOR#EDL#29.01.2003#1#ok#
..#KOR#EDL#31.01.2003#2#ok# EDI-Info-Eintrag-Pruefen jetzt als Prozedur
..#KOR#EDL#07.02.2003#3#ok# Fehlertext wurden standardisiert
..#KOR#EDL#11.06.2003#4#ok#
..#KOR#EDL#07.07.2003#5#ok#
..#KOR#EDL#01.08.2003#6#ok#
..#KOR#EDL#11.08.2003#7#ok#
..#KOR#EDL#28.08.2003#8#ok#
..#KOR#EDL#20.11.2003#9#ok#
..#KOR#EDL#22.02.2005#10#ok#
..========================================================================
..@@ENDHEAD
..
.input ARB
..
.. variablendefinition
..@@BEGINVARDEFS
..====================================================
.set trans +
..>> variablendefinition
..>>
..**ok,11.06.2003 (xgrpidkundeab ist NEU)
.type integer xgrpidkundeab
..**ok,07.07.2003 (xprkunde ist NEU)
.type text xprkunde
..
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
..
!PROC001: ----- FEHLER -----
.. FEHLER
.formula xbfehler = true
..
..**ok,11.06.2003 (Fehlertexte getrennt ausgegeben)
..
.output addedto 'xdfehler'
.input DATEI.F
?'xtxt1' ? +xtxt1 > 0
?'xtxt2' ? +xtxt2 > 0
.output
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
..>> Init RÅckgabewerte: kein Erfolg der Operation
.formula xprocreturn = false
..
.. >> Initialisieren temporÑre Variablen fÅr Suchergebnisse
..>> Fehlercode 0
.formula xedifcode = 0
..>> max. Fehlercode 5
.formula xedifcodemax = 5
..>> Bearbeitungsstatus 2
.formula xedistatus = 2
..>> Ident-Nr. Kunde
.formula xidkundeab = ""
..>> GLN-Nr. Kunde
.formula xglkundeab = ""
..>> Ident-Nr. Kundenkontakt
.formula xidkundeabs = ""
..>> GLN-Nr. Kundenkontakt
.formula xglkundeabs = ""
..>> Ident-Nr. RechnungsempfÑnger
.formula xidkundeabr = ""
..>> GLN-Nr. RechnungsempfÑnger
.formula xglkundeabr = ""
..>> Eintrag fÅr EDI-EDL-Meldungen in EDI-Info Kundenkontakt
..>> aktiv
.formula xediaktiv = false
..>> manuell
.formula xedimanu = false
..>> automatisch
.formula xediauto = false
..
.. PRöFEN DER PARTNER-INFOS
.select edifact 'xedinumactinnachr1'
..
.. >> Merken Variablen des abas EDI-Datensatzes
..>> Ident-Nr. Kunde
.formula xidkundeab = idkundeab
..>> Lieferanten-Nr bei Kunde
.formula xidabkunde = idabkunde
..>> GLN-Nr. Kunde
.formula xglkundeab = glkundeab
..>> Ident-Nr. WarenempfÑnger
.formula xidkundeabs = idkundesab
..>> GLN-Nr. WarenempfÑnger
.formula xglkundeabs = glkundesab
..>> Ident-Nr. RechnungsempfÑnger
.formula xidkundeabr = idkunderab
..>> GLN-Nr. RechnungsempfÑnger
.formula xglkundeabr = glkunderab
..>> Werk
.formula xwerk = werk
..>> Abladestelle
.formula xablstelle = ablstelle
..
.. Validate Buyer/Customer for Credit Notes and ESP withdrawal messages
.. ESP messages with function 30 and 35 do not create a transaction in abas ERP.
.. For these messages the buyer/customer is not validated.
.. Note: A validation of the goods recipient should still be done!
..
..
.continue EL001 ? _(H|funktion="35" ; H|funktion="30")
.. IF001
.. do nothing
..
.continue FI001
!EL001
.reserve
..
.. PRöFEN BESTELLER/KUNDE AUS DEM BUY1-Satzart
.. Suchen mit Kunden-Nr in ABAS
..
.continue EL002 ? _(((xidkundeab >> "") << "") <> "")
.. IF002
.select customer 'xidkundeab'
..
..
.continue EL003 ? _(mehr)
.. IF003
..
.continue EL004 ? _(gruppe = 2)
.. IF004
.formula xidkundeab = firma
.formula xglkundeab = gln
.formula xgrpidkundeab = 2
..
.continue FI004
!EL004
.formula xidkundeab = num
.formula xglkundeab = gln
.formula xgrpidkundeab = 1
..
!FI004
..
.continue FI003
!EL003
..>> "Kunde/Kundenkontakt aus BUY1-Segment fÅr Kunde nicht gefunden (Ident-Nr.)"
.formula xedifcode = 5
..
.. Fehlertext
.formula xtxt1 = "- Kunde/Kundenkontakt-ID aus BUY1-Segment: " + 'xidkundeab' + " nicht gefunden!"
.formula xtxt2 =  ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001" 
.continue PROC001
!RET001
.formula xprocsp = xprocsp - 1
..
..**ok,29.01.2003 (.fo xidkundeab = "" hier NEU)
.formula xidkundeab = ""
..
!FI003
..
!EL002
.. FI002
..
..
.continue EL005 ? _(xidkundeab = "")
.. IF005
.. Suchen mit Kunden-GLN-Nr
..
.continue EL006 ? _(((xglkundeab >> "") << "") <> "")
.. IF006
.formula U|xkdsuchschluessel1 = "$,,;@gruppe=1.2;@ablage=(1);@zeilen=(0);gln=" + xglkundeab
.select customer 'xkdsuchschluessel1'
..
..
.continue EL007 ? _(mehr)
.. IF007
..
.continue EL008 ? _(gruppe = 2)
.. IF008
..**ok,22.02.2005 (unten bei gruppe 2 xidkundeab = firma)
.formula xidkundeab = firma
.formula xglkundeab = gln
.formula xgrpidkundeab = 2
..
.continue FI008
!EL008
.formula xidkundeab = num
.formula xglkundeab = gln
.formula xgrpidkundeab = 1
..
!FI008
..
.continue FI007
!EL007
..>> "Kunde/Kundenkontakt aus BUY1 fÅr Kunde nicht gefunden (GLN-Nr.)"
.formula xedifcode = 4
..
