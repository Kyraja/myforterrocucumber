.formula xtxt2 =  ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002" 
.continue PROC001
!RET002
.formula xprocsp = xprocsp - 1
..
.formula xglkundeab = ""
..
!FI007
..
!EL006
.. FI006
..
!EL005
.. FI005
..
..
.continue EL009 ? _(xidkundeab = "")
.. IF009
.. Suchen mit Lieferanten-Nr bei Kunde
..**ok,11.06.2003 (auch mit "Lieferanten-Nr bei Kunde" gesucht)
..
..
