.set trans -
.continue START  ? evtartengl="FIELD_EXIT"    & evtvar="edinr"
.continue
..
!START
.continue FEHLER1   ? M|edinr^such <> "VKZAV" & M|edinr <> ""
..
!KOPF
.input "is/TABLEEREN"
