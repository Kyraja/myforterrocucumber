..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDISEARCH.EV
.. Datum          : 14.09.2003
.. Version        :
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Eventhandling fÅr Feldaustritte
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Feldaustritts-FOP
..
.. Functionality  : Eventhandling for field exit
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : field exit efop
...Includes       :
..*****************************************************************************
.set trans -
..
.type bool xbeinkauf
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue EDINR   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "edinr"
.continue EDINR   ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "bstart"
.continue BKULI   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bku"
.continue BKULI   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bli"
.continue BVKEK   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bvk"
.continue BVKEK   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bek"
.continue ARTRAH  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bzkuartnr"
.continue ARTKUN  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bkuartbez1"
.continue ARTSAB  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bkuartbez2"
.continue ARTGTIN ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "bartgtin"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!EDINR: start button or new edinr refresh all fields
.continue END     ?  F|empty(M|edinr)
.formula T|xbeinkauf = ('M|edinr^such'/"EK*")
.formula M|bku = _T|xbeinkauf
.formula M|bli =  T|xbeinkauf
.formula M|bvk = _T|xbeinkauf
.formula M|bek =  T|xbeinkauf
.. fill all fields from edi message
.select edifact 'M|edinr^id'
.continue END     ? _T|mehr
.formula M|kdnum      = H|idkundeab      ? _T|xbeinkauf
.formula M|kdfrbez    = H|idabkunde      ? _T|xbeinkauf
.formula M|wfrbez     = H|idabkunde      ? _T|xbeinkauf
.formula M|rfrbez     = H|idabkunde      ? _T|xbeinkauf
.formula M|kdnum      = H|idabkunde      ?  T|xbeinkauf
.formula M|kdfrbez    = ""               ?  T|xbeinkauf
.formula M|wfrbez     = ""               ?  T|xbeinkauf
.formula M|rfrbez     = ""               ?  T|xbeinkauf
.formula M|kdgln      = H|glkundeab
.formula M|rnum       = H|idkunderab
.formula M|rgln       = H|glkunderab
.formula M|wnum       = H|idkundesab
.formula M|wgln       = H|glkundesab
.formula M|wwerk      = H|werk
.formula M|wablstelle = H|ablstelle
.formula M|artnum     = H|ideksart
.formula M|artkuart   = H|kuartnr
.formula M|artgtin    = H|gtin
.formula M|ranum      = H|ideksrah
.formula M|raverwschl = H|verwschl
.formula M|raabbenr   = H|abbenr
.formula M|efzahl     = H|einfzahl
.formula M|lfzahl     = H|lfzahl
.select -
.continue END
..
!BKULI: one (and only one) check box customer / supplier must be marked
.formula M|bli = _M|bku      ?  T|evtvar = "bku"
.formula M|bku = _M|bli      ?  T|evtvar = "bli"
.formula M|kdfrbez = ""      ?  M|bli
.formula M|wfrbez  = ""      ?  M|bli
.formula M|rfrbez  = ""      ?  M|bli
.continue END
..
!BVKEK: one (and only one) check box sales / purchasing must be marked
.formula M|bek = _M|bvk      ?  T|evtvar = "bvk"
.formula M|bvk = _M|bek      ?  T|evtvar = "bek"
.continue END
..
.. max ein Ankreuzfeld markieren "bzkuartnr, bkuartbez1, bkuartbez2"
!ARTRAH
.formula M|bkuartbez1 = false    ?  M|bzkuartnr
.formula M|bkuartbez2 = false    ?  M|bzkuartnr
.formula M|bartgtin   = false    ?  M|bzkuartnr
.continue END
!ARTKUN
.formula M|bzkuartnr  = false    ?  M|bkuartbez1
.formula M|bkuartbez2 = false    ?  M|bkuartbez1
.formula M|bartgtin   = false    ?  M|bkuartbez1
.continue END
!ARTSAB
.formula M|bkuartbez1 = false    ?  M|bkuartbez2
.formula M|bzkuartnr  = false    ?  M|bkuartbez2
.formula M|bartgtin   = false    ?  M|bkuartbez2
.continue END
!ARTGTIN
.formula M|bkuartbez1 = false    ?  M|bartgtin
.formula M|bkuartbez2 = false    ?  M|bartgtin
.formula M|bzkuartnr  = false    ?  M|bartgtin
.continue END
..*****************************************************************************
!END
.continue
