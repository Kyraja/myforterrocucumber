..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDICENTER.TAB.ICON
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Set icons to row depending on status of the shown message
..*****************************************************************************
.set trans -
..
.. Status icon
.formula M|fotoz        = G|icoerror                ? H|status = 4
.formula M|fotoz        = G|icoerror                ? H|status = 11
.formula M|fotoz        = G|icook                   ? H|status = 0
.formula M|fotoz        = G|icowarn                 ? (H|status=5 ; H|status=6 ; H|status=7 ; H|status=8 ; H|status=9 ; H|status=10)
.formula M|fotoz        = G|icomessage              ? (H|status=2 ; H|status=3) & (H|fcode=0)
.formula M|fotoz        = G|icoerror                ? H|status=2  & H|fcode<>0
.formula M|fotoz        = M|orangez                 ? H|status < 0
.formula M|fotoz        = M|khistoriez              ? H|status = -10 ; H|status = -8
.formula M|fotoz        = M|freiz                   ? H|status = 0 & H|vorart = 0
.formula M|fotoz        = M|sperrez                 ? H|status = 3 & H|vorart = 0
.formula M|fotoz        = M|orangez                 ? H|fcode = 0  & H|einfzahl < 0
.formula M|fotoz        = M|orangez                 ? H|fcode = 0  & M|fzahl < 0
.formula M|edidruckz    = M|ledidruckz
.formula M|tprotz       = M|lprotz
.formula M|impexz       = M|limportz                ? M|imex = "IM"
.formula M|impexz       = M|lexportz                ? M|imex = "EX"
.formula M|bearbz       = M|lbearbz
.formula M|lockz        = M|llockz
.formula M|olockz       = M|lolockz
..
..*****************************************************************************
!END
.continue
