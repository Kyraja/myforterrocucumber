..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : CREDITNOTE.RPF.DELIVERY.DATA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Add information from delivery note 
..*****************************************************************************
..!meta M|=dfue/CREDITNOTE
.set trans -
..
.type integer xipos ? _F|defined(U|xipos) 
.continue ERRPOS ? U|xipos < 1 ; U|xipos > 9
.. 
.. H buffer has packing slip item / delivery note item 
.. Add detail information to current row in infosystem
.. 
.. Add packing slip item information
..!meta H|=P3:2
.formula M|tlieferposition = H|id
.copy M|tliganr = H|ganr
.copy M|tlimengeneinheit = H|he
.copy M|tlirerelev = H|rerelev
.. 
.formula M|ttlipos.xipos = H|id
.copy M|ttlipreis.xipos = H|preis
.copy M|ttlimge.xipos = H|mge
.copy M|ttlipwert.xipos = H|pwert
..
.. Sum quantities and value, show average price
.formula M|tlipreis = H|preis ? U|xipos = 1
.formula M|tlipreis = ( M|tlimge * M|tlipreis + H|mge * H|preis ) / (M|tlimge + H|mge) ? H|preis<>M|tlipreis
.formula M|tlimge = M|tlimge + H|mge
.formula M|tlipwert = M|tlipwert + H|pwert
.formula M|tlistorniert = F|empty(M|tlimge)
..  
.. .formula M|tliprbasis = ?
.. .formula M|tliprfakt = ?
.. .formula M|tlipossteuer = ?
.. .formula M|tlipossteuersatz ?
.. 
.. Add packing slip header information
.add H|kopf
..!meta H|=P3:1
.copy M|tliwaehrung = D|land
.copy M|tlifakt = D|fakt
.copy M|tliumlagerung = G|true ? _F|empty(D|umplatz)
.copy M|tlidatint = D|vom
.add
..
.. set delivery note item as released, if its credit note number matches   
.copy M|tlifreigabe = G|true ? M|tliganr = M|tganr
.. 
..*****************************************************************************
!END
.continue
.. 
.. 
!ERRPOS
.error Zu einer Gutschriftenposition wurden sehr viele Lieferscheinpositionen ermittelt!
.end 1
