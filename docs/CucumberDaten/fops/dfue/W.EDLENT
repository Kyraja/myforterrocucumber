..!interpreter english translate
..*****************************************************************************
.. FOP-Name       : W.EDLENT
.. Autor          : ok
.. Verantwortlich : mh
.. Kontrolle      : 
.. Funktion       : Bei EDL-Abwicklung werden fuer einen EDL die Gesamt-  
..                  Entnahmemengen der Ursprungslieferscheine ermittelt
..*****************************************************************************
.set trans -
..
.input "ARB"
..**ok,17.06.2003 (Markierung L1 jetzt hier)
..
..**ok,24.07.2003 (unten die Variablen)
.type integer  xlesuls
..**ok,16.09.2003 (x2eing separat mit defined definiert)
.type integer  x2eing ? _defined(x2eing)
.type text xgeraet
..
!L1
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
..
.type text xurlsnr xsum xusum xart
.type text xldat xedlsnr xedldat
.type real xmge
..**ok,17.06.2003 (neu Variablen)
.type text xident xedlnum
..**mh, 19.11.2010: FOP-Array sicherer gemacht (neu: xartsuch)
.type text xartsuch
..====================================================
..@@ENDVARDEFS
..
.. initialize procedure stack pointer
.formula xprocsp = 0
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.formula xi = 0
..
..
!LOOP001: ==============================
.continue ELOP001 ? _(xi < 12)
.formula xi = xi + 1
..
.type text xart.xi x.xi
..**mh, 19.11.2010: FOP-Array sicherer gemacht (neu: xartsuch)
.type text xartsuch.xi
..
.continue LOOP001
!ELOP001: ==============================
..
.formula xi = 0
..
..**ok,17.06.2003 (Abfrage von EDL wurde entfernt)
..**ok,24.07.2003 (unten xlesuls=0)
..
..
.continue EL001 ? _( xlesuls=0)
.. IF001
!L2
..**ok,02.12.2004 (fÅr den Aufruf vom Infosystem EDICENTER untere Zeile geÑndert
..
..
.continue EL002 ? _(x2eing = 0)
.. IF002
.read "Geben Sie die Identnummer fÅr den Ursprungs-Lieferschein ein (Abbruch mit <return>)" x2eing
..
!EL002
.. FI002
..
!EL001
.. FI001
..
..
.continue EL003 ? _(x2eing <> 0)
.. IF003
.formula x3eing = "+" + 'x2eing'
.formula U|xtsel = "$,,;@gruppe=1;@ablageart=(2);typ=(4);nummer=" + 'x2eing'
.select sales 'U|xtsel'
..
.continue FI003
!EL003
.end
..
!FI003
..
.. PRöFUNG DER EINGABEN
..
.continue EL004 ? _(mehr)
.. IF004
..**ok,16.06.2003 (edl --> edl^num)
..
..**ok,17.06.2003 (ident --> ursplsnr)
..
..
.continue EL005 ? _(+H|ursplsnr<>0)
.. IF005
..
.continue EL006 ? _(+H|umplatz=0)
.. IF006
.box Meldung
Dieser Lieferschein 'H|num' ist kein
Ursprungs-Lieferschein!
Die Verarbeitung wird beendet!
.continue BER ? xlesuls <> 0
.end .
..
!EL006
.. FI006
..
!EL005
.. FI005
..
.continue FI004
!EL004
.. kein LS
..**ok,02.12.2004 (unten x3eing --> x2eing)
.box Meldung
Es wurde kein Lieferschein
mit der Identnummer: 'x2eing' gefunden!
..**ok,02.12.2004 (unten .weiter L2 --> .weiter)
.continue
..
!FI004
..
.. WEITER
.select sales 'x3eing'
..
..
.continue EL007 ? _(mehr)
.. IF007
.formula xdatei = "rmtmp/WEDL" + pid + ".TMP"
.output new 'xdatei'
.input "DATEI.F"
..
..**ok,16.06.2003 (ident --> ursplsnr)
..
..
!LOOP002: ==============================
.continue ELOP002 ? _(mehr)
..
.continue EL008 ? _((+h|edl > 0) & (+h|umplatz > 0) & (+h|ursplsnr = 0))
.. IF008
.select line
..
..
!LOOP003: ==============================
.continue ELOP003 ? _(mehr)
..**ok,17.06.2003 (mge <> 0 wurde hinzugefÅgt)
..
..
.continue EL009 ? _((typ = arpos) & (mge <> 0))
.. IF009
..**ok,30.01.2003 (weitere Daten hinzugefÅgt)
..**ok,17.06.2003 (am Ende weitere Daten hinzugefÅgt)
..**mh, 19.11.2010: FOP-Array sicherer gemacht (xart), Nummer bzw. Suchwort als Sortier-Wert behalten (xartsuch)!
.formula T|xart = F|regreplaceall('H|artex^id',"[\(,\,\)]","")
.formula T|xartsuch = H|artex^nummer   ? _F|sysinfo(18)^swziffern
.formula T|xartsuch = H|artex^such     ?  F|sysinfo(18)^swziffern
'kopf^num3' #   # 'xartsuch' # 'mge' # 'kopf^vom' # # # # 'xart' #
..
!EL009
.. FI009
..
.select line
..
.continue LOOP003
!ELOP003: ==============================
..
!EL008
.. FI008
..
.select sales
..
.continue LOOP002
!ELOP002: ==============================
..
..**ok,16.06.2003 (ident --> ursplsnr)
..
..**ok,17.06.2003 (EDL aus der Selektion entfernt)
..
..**ok,24.07.2003 (unten x2eing --> 'x2eing')
..**mh,19.11.2010: Bei Selektion mit Text muss == fÅr Eindeutigkeit verwendet werden
.. Gesamt-Entnahme-Menge
.formula xtsel = "$,,;@gruppe=1;typ=(4);ursplsnr==" + 'x2eing '
.select sales 'xtsel'
..
..
.continue EL010 ? _(mehr)
.. IF010
..
!LOOP004: ==============================
.continue ELOP004 ? _(mehr)
.select line
..
..
!LOOP005: ==============================
.continue ELOP005 ? _(mehr)
..
.continue EL011 ? _(typ = arpos)
.. IF011
..**ok,16.06.2003 (ident --> ursplsnr)
..
..**ok,30.01.2003 (weitere Daten hinzugefÅgt)
..**mh, 19.11.2010: FOP-Array sicherer gemacht (xart), Nummer bzw. Suchwort als Sortier-Wert behalten (xartsuch)!
.formula T|xart = F|regreplaceall('H|artex^id',"[\(,\,\)]","")
.formula T|xartsuch = H|artex^nummer   ? _F|sysinfo(18)^swziffern
.formula T|xartsuch = H|artex^such     ?  F|sysinfo(18)^swziffern
.type real xge.xart  ? _F|defined(xge.xart)
'kopf^ursplsnr' # 'kopf' # 'xartsuch' # 'mge' # 'kopf^vom' # 'kopf^edllsnr' # 'kopf^edllsdat' # 'kopf^ident' # 'xart' #
.formula xedlnum = 'kopf^edl^num'
..
!EL011
.. FI011
..
.select line
..
.continue LOOP005
!ELOP005: ==============================
..
.select sales
..
.continue LOOP004
!ELOP004: ==============================
..
!EL010
.. FI010
..
.continue FI007
!EL007
.. Meldung
..**ok,02.12.2004 (unten x3eing --> x2eing)
.box Meldung
Ursprungs-Lieferschein mit der Identnummer 'x2eing' nicht gefunden!
..
!FI007
..
.. SORTIEREN NACH LS-NR, Artikel
.formula xsys = "sort -t# +0 -1 +1 -2 +2 -3 -o " + xdatei + " " + xdatei
.system 'xsys' background
..
.input DRUCKER   ? xgeraet = ""
.output 'xgeraet' ? xgeraet <> ""
.input BLANKOB.F
..
.formula xgeraet = geraet ? xgeraet = ""
..
.formula x1vurls = ""
.formula x2vurls = ""
.set trans +
.page 1
..
'txname                '                                Datum: 'datum'
                                                        Seite: 'seite'

EDL-Kunden-ID: 'xedlnum'


                MATERIALENTNAHMEN AUS DEM EDL-LAGER
                ===================================

.set trans -
..
..**ok,30.01.2003 (neue Daten wurden hinzugefÅgt)
..**mh, 19.11.2010: FOP-Array sicherer gemacht (xart), Nummer bzw. Suchwort als Sortier-Wert behalten (xartsuch)!
.select from 'xdatei' xurls # xlsnr # xartsuch # xmge # xldat # xedlsnr # xedldat # xident # xart #
..
..
!LOOP006: ==============================
.continue ELOP006 ? _(mehr)
..
.continue EL012 ? _(+xlsnr=0)
.. IF012
..
.continue EL013 ? _(xurls <> x1vurls)
.. IF013
..
.continue EL014 ? _(xurls <> x1vurls)
.. IF014
.. Gesamtmengen ausgeben
.formula xi = 0
-------------------------------------------
..
..
!LOOP007: ==============================
.continue ELOP007 ? _(xi < 10)
.formula xi = xi + 1
..
..
.continue EL015 ? _('x.xi' <> "")
.. IF015
.formula xy = x.xi
..
.set trans +
  GESAMT       'xartsuch.xi  '  '   xge.xy'
.set trans -
.formula xge.xy = 0
..
!EL015
.. FI015
..
.continue LOOP007
!ELOP007: ==============================
..
!EL014
.. FI014
..
.set trans +

Ursprungs-Lieferschein-Nr: 'xurls'

Artikel              Liefermenge
-------------------- -----------
.set trans -
..
!EL013
.. FI013
..
'xartsuch           ' '    xmge'
..
.formula x1vurls = xurls
..
.continue FI012
!EL012
.. LS-Zeilen
..**ok,30.01.2003 (neue Daten wurden hinzugefÅgt)
..
..
.continue EL016 ? _(xurls <> x2vurls)
.. IF016
.set trans +

abas-LS   Datum    EDL-LS     Datum      EDI-ID    Artikel              Entnahmemenge
--------- -------- ---------- ---------- --------- -------------------- -------------
.set trans -
..
!EL016
.. FI016
..
'xlsnr  ' 'xldat ' 'xedlsnr ' 'xedldat ' 'xident ' 'xartsuch          ' '       xmge'
..
.formula xge.xart = xge.xart + xmge
..
.formula xi = 0
..
..
!LOOP008: ==============================
.continue ELOP008 ? _(xi < 10)
.formula xi = xi + 1
..
..
.continue EL017 ? _('x.xi' = 'xart')
.. IF017
.. RAUS AUS DER SCHLEIFE
.formula xi = 11
..
.continue FI017
!EL017
..
.continue EL018 ? _(('xart' <> "") & ('x.xi' = ""))
.. IF018
.formula x.xi = xart
.formula xartsuch.xi = xartsuch
.formula xi = 11
..
!EL018
.. FI018
..
!FI017
..
.continue LOOP008
!ELOP008: ==============================
..
.formula x2vurls = xurls
..
!FI012
..
..**ok,30.01.2003 (neue Daten wurden hinzugefÅgt)
..**mh, 19.11.2010: FOP-Array sicherer gemacht (xart), Nummer bzw. Suchwort als Sortier-Wert behalten (xartsuch)!
.select from 'xdatei' xurls # xlsnr # xartsuch # xmge # xldat # xedlsnr # xedldat # xident # xart #
..
..
.continue EL019 ? _(mehr)
.. IF019
.continue FI019
!EL019
.formula xi = 0
-------------------------------------------------------------------------------------
..
..
!LOOP009: ==============================
.continue ELOP009 ? _(xi < 10)
.formula xi = xi + 1
..
..
.continue EL020 ? _('x.xi' <> "")
.. IF020
.formula xy = x.xi
..
.set trans +
               GESAMT                              'xartsuch.xi       ' '     xge.xy'
.set trans -
.formula xge.xy = 0
..
!EL020
.. FI020
..
.continue LOOP009
!ELOP009: ==============================
..
!FI019
..
.continue LOOP006
!ELOP006: ==============================
..
..**ok,17.06.2003 (neue MenÅ)
..
.continue BER ? xlesuls<>0
..**ok,16.09.2003 (wg. Infosystemaufruf angepa·t)
.end ? _txname/"*W.EDLENT*"
..**ok,13.06.2005 (unten L1 --> WL1)
..
.set trans +
.menu Auswahl
Weitermachen   >> .continue WL1
Weitermachen bis U-LS-Nr >> .read "bis U-LS-Nr" xlesuls
Beenden        >> .end
.set trans -
..
!BER
.type integer xint
.formula xint = x2eing
.formula x2eing = xint + 1
.continue L1 ? x2eing <= xlesuls
..
.end
..
..**ok,13.06.2005 (WL1-Block ist neu)
!WL1
.formula x2eing = 0
.continue L1
..
