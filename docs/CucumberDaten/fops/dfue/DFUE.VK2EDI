600 # 01 # 'xCnt400' # 'xCnt500g' # 'xCnt525g' # 'xCnt550g' # 'xCnt600' # 'xGReBetr:2' # 'xNet.x1Index:2' # 'xGSt.x1Index:2' # 'xStSatz.x1Index:1' # 'xNet.x2Index:2' # 'xGSt.x2Index:2' # 'xStSatz.x2Index:1' # # # # # # # # # # # 'xLfdNr' #
