.continue EPROCDEF
.. procedure definitions
..
!PROC001: ----- FEHLER -----
.formula xbfehler = true
..
.output addedto 'xdfehler'
..box Fehler
?'xtxt1' ? +xtxt1 > 0
?'xtxt2' ? +xtxt2 > 0
..
.. wieder auf alte datei schreiben
.output addedto 'xgeraet'
..
.continue 'xprocst.xprocsp'
..
..
!PROC002: ----- SENDE.POST -----
.formula xPostBetreff = "Fehler beim öbernehmen von VK-VorgÑngen in EDI-Datenbank"
.formula xPostStichw1 = "DFö-Fehler"
.formula xPostFtext   = xdfehler
.formula xPostEmpf    = xIdDfueExVerteil
..
.input 'xdPostSenden' ? xPostEmpf<>""
..
.continue 'xprocst.xprocsp'
..
..
!PROC003: ----- WRITE_EDI_SET -----
.. hol zeile aus zwischendatei
.select from 'xDatWriteEdi' xtxt1 # xtxt2 # xtxt3 # xtxt4 # xtxt5 # xtxt6 # xtxt7 # xtxt8 # xtxt9 # xtxt10 # xtxt11 # xtxt12 # xtxt13 # xtxt14 # xtxt15 # xtxt16 # xtxt17 # xtxt18 # xtxt19 # xtxt20 # xtxt21 # xtxt22 # xtxt23 # xtxt24 # xtxt25 #
..
..
!LOOP002: ==============================
.continue ELOP002 ? _(mehr)
.make line
..
.formula xii = 1
..
..
!LOOP003: ==============================
.continue ELOP003 ? _(xii <= 25)
.formula h|text.xii = xtxt.xii
.formula xii = xii + 1
..
.continue LOOP003
!ELOP003: ==============================
..
.. hol zeile aus zwischendatei
.select from 'xDatWriteEdi' xtxt1 # xtxt2 # xtxt3 # xtxt4 # xtxt5 # xtxt6 # xtxt7 # xtxt8 # xtxt9 # xtxt10 # xtxt11 # xtxt12 # xtxt13 # xtxt14 # xtxt15 # xtxt16 # xtxt17 # xtxt18 # xtxt19 # xtxt20 # xtxt21 # xtxt22 # xtxt23 # xtxt24 # xtxt25 #
