.continue END  ? _G|mehr
.continue NEXT ?  F|empty(M|tkunde)
.input "dfue/EDIIMPVER.TBUVERARB.BV"
.continue NEXT ? _M|tbaktiv
.input "EDIIMPVER.VERARBEITEN"
.continue NEXT
..
!ALLEKD
.input "EDIIMPVER.VERARBEITEN"
.continue END
..
..*****************************************************************************
!END
.continue
..
!NOMARK
.error Es ist keine Nachricht zur Verarbeitung ausgewÑhlt.
.end 1
..
!NOKUNDE
.error Es ist kein Kunde fÅr die Verarbeitung ausgewÑhlt.
