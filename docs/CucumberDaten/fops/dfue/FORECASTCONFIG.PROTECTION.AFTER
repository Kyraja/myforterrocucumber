.set trans -
..
.. Unlock allowed fields
.. ----------- ---------- ---------- -------------------------------------------
.continue FIX    ?  M|kbohnenachricht
.continue EDIT   ? (M|kbnachricht1 ; M|kbnachricht2 ; M|kbnachricht3) &   M|kbkonfigurieren
.continue ACTI   ? (M|kbnachricht1 ; M|kbnachricht2 ; M|kbnachricht3) &   M|kbaktivieren 
.continue ACTI   ? (M|kbnachricht1 ; M|kbnachricht2 ; M|kbnachricht3) &   M|kbdeaktivieren
.continue ACTI   ? (M|kbnachricht1 ; M|kbnachricht2 ; M|kbnachricht3) &   M|kbanlegen
.continue ACTI   ? (M|kbnachricht1 ; M|kbnachricht2 ; M|kbnachricht3) &   M|kbloeschen
.continue CONFIG ? (M|kbnachricht1 ; M|kbnachricht2 ; M|kbnachricht3) 
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
.. 
!CONFIG
.continue END ? M|tzeilen=0
.protection -reset kbkonfigurieren 0
.protection -reset kbaktivieren 0
.protection -reset kbdeaktivieren 0
.protection -reset kbloeschen 0
.protection -reset kbanlegen 0
.continue END
.. 
.. 
!ACTI
.continue END ? M|tzeilen=0
.protection -reset kbkonfigurieren 0
.protection -reset kbaktivieren 0
.protection -reset kbdeaktivieren 0
.protection -reset kbloeschen 0
.protection -reset kbanlegen 0
.protection -reset kbuupgrade 0
.continue END
.. 
.. 
!EDIT
