..
.formula U|kotermZEITRAUMENDE = 11
.formula U|kotermKEINBEDARF   = 12
.formula U|kotermRUECKSTAND   = 13
.formula U|kotermSOFORTBEDARF = 14
.formula U|kotermABRUFMENGE   = 15
.formula U|kotermREST         = 16
.formula U|kotermFREIGABE     = 17
.formula U|kotermTERMIN       =  1
.formula U|kotermTAG2TAG      =  2
.formula U|kotermWOCHE2WOCHE  =  3
.formula U|kotermMONAT2MONAT  =  4
.formula U|kotermWOCHE        =  5
.formula U|kotermMONAT        =  6
.formula U|kotermJAHR         =  7
.formula U|kotermLEER         = 99
.formula U|kotermUNBEKANNT    =  0
..
..
.. Reduce  "types of schedule date"  for  BI export
.. Use enumeration A270,
..   (EmptyEntry) (0)
..   RÅckstand (Backlog) (82)
..   Sofortbedarf (ImmediateRequirement) (83)
..   Tagesdatum (DeliveryScheduleDate) (84)
..   Kein Bedarf (NoRequirement) (75)
..   Vorschaumenge Woche (RequirementForWeek) (87)
..   Vorschaumenge Monat (RequirementForMonth) (77)
..   Vorschauzeitraum Tage (ForecastPeriodDays) (68)
..   Vorschauzeitraum Wochen (ForecastPeriodWeeks) (72)
..   Vorschauzeitraum Monate (ForecastPeriodMonths) (79)
..
.type A270 kobiUNBEKANNT      ? _F|defined(U|kobiUNBEKANNT)
.type A270 kobiRUECKSTAND     ? _F|defined(U|kobiRUECKSTAND)
.type A270 kobiTERMIN         ? _F|defined(U|kobiTERMIN)
.type A270 kobiSOFORT         ? _F|defined(U|kobiSOFORT)
.type A270 kobiWOCHE          ? _F|defined(U|kobiWOCHE)
.type A270 kobiMONAT          ? _F|defined(U|kobiMONAT)
.type A270 kobiKEINBEDARF     ? _F|defined(U|kobiKEINBEDARF)
.type A270 kobiTAG2TAG        ? _F|defined(U|kobiTAG2TAG)
.type A270 kobiWOCHE2WOCHE    ? _F|defined(U|kobiWOCHE2WOCHE)
.type A270 kobiMONAT2MONAT    ? _F|defined(U|kobiMONAT2MONAT)
..
.formula U|kobiUNBEKANNT = "(EmptyEntry)"
.formula U|kobiRUECKSTAND = "(Backlog)"
.formula U|kobiTERMIN = "(DeliveryScheduleDate)"
.formula U|kobiSOFORT = "(ImmediateRequirement)"
.formula U|kobiWOCHE  = "(RequirementForWeek)"
.formula U|kobiMONAT  = "(RequirementForMonth)"
.formula U|kobiKEINBEDARF = "(NoRequirement)"
.formula U|kobiTAG2TAG = "(ForecastPeriodDays)"
.formula U|kobiWOCHE2WOCHE = "(ForecastPeriodWeeks)"
.formula U|kobiMONAT2MONAT = "(ForecastPeriodMonths)"
..
..*****************************************************************************
!END
.continue
