.. Functionality  : Constants for termcode conversion
..*****************************************************************************
.set trans -
..
.type integer    kotermZEITRAUMENDE  ? _F|defined(U|kotermZEITRAUMENDE)
.type integer    kotermKEINBEDARF    ? _F|defined(U|kotermKEINBEDARF)
.type integer    kotermRUECKSTAND    ? _F|defined(U|kotermRUECKSTAND)
.type integer    kotermSOFORTBEDARF  ? _F|defined(U|kotermSOFORTBEDARF)
.type integer    kotermABRUFMENGE    ? _F|defined(U|kotermABRUFMENGE)
.type integer    kotermREST          ? _F|defined(U|kotermREST)
.type integer    kotermFREIGABE      ? _F|defined(U|kotermFREIGABE)
.type integer    kotermTERMIN        ? _F|defined(U|kotermTERMIN)
.type integer    kotermTAG2TAG       ? _F|defined(U|kotermTAG2TAG)
.type integer    kotermWOCHE2WOCHE   ? _F|defined(U|kotermWOCHE2WOCHE)
.type integer    kotermMONAT2MONAT   ? _F|defined(U|kotermMONAT2MONAT)
.type integer    kotermWOCHE         ? _F|defined(U|kotermWOCHE)
.type integer    kotermMONAT         ? _F|defined(U|kotermMONAT)
.type integer    kotermJAHR          ? _F|defined(U|kotermJAHR)
.type integer    kotermLEER          ? _F|defined(U|kotermLEER)
