def readPackInstructionsForPackMaterial() { 
    ..<META H|='P106:1'>
    if (U|noProcessCheckboxMarked ; M|kbpackanw) {
        .select packinginstructions 'F|formatstr("$,,;@gruppe=1;@zeilen=(Yes);artikel={1}", M|kpackmit^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = H|id
            .formula M|tvorgang = 'H|objgrbez'
            .formula M|tpackanw = H|id
            .select head
            .select line
            .formula M|tpackm = H|artikel^id
            .copy M|tblager = G|false 
            .copy M|tbversand = G|false 

            .select packinginstructions
        } 
    } 
}


def readProductionListForPackmaterial() {
    ..<META 2|='P2:1'>
    if (U|noProcessCheckboxMarked ; M|kbfertigungsliste) {
        .load 2 nolock parts 'F|formatstr("$,,;@gruppe=1;@zeilen=(Yes);elex={1}", U|packMaterial^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = 2|id
            .formula M|tvorgang = '2|objgrbez'
            .formula M|tartikel = 2|id
            .formula M|tle = 2|le
            .load 2 nolock parts
        }
    }
}

def readContainerAccountsForPackmaterial() {
    ..<META 2|='P158:1'>
    if (U|noProcessCheckboxMarked ; M|kbkonto) {
        .load 2 nolock containeraccount 'F|formatstr("$,,;@gruppe=1;artikel={1}", U|packMaterial^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = 2|id
            .formula M|tvorgang = '2|objgrbez'
            .formula M|tpartner = 2|partner^id
            .copy M|tblager = G|false
            .copy M|tbversand = G|false             
            .load 2 nolock containeraccount
        }
    }
}

def readBlanketOrdersForPackMaterial() {
    ..<META 2|='P3:2'>
    if (U|noProcessCheckboxMarked ; M|kbrahmen) {
        .load 2 nolock sales 'F|formatstr("$,,;@gruppe=2;artikel={1};kotyp=(BlanketOrder)", U|packMaterial^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = 2|kopf^id
            .formula M|tpos = 2|id
            .formula M|tvorgang = '2|objgrbez'
            .formula M|tpartner = 2|kopf^kunde^id
            .formula M|tpackmit = 2|artikel^id
            .formula M|tfmenge = 2|fmenge
            .formula M|tle = 2|he
            .copy M|tpackanw = 2|packanw
            if ( _F|empty(M|tpackanw)) {
                .load 1 nolock packinginstructions '2|packanw^id'
                .load 1 nolock line
                .formula M|tpackm = 1|artikel^id ?  G|mehr
            }
            .copy M|tblager = G|false
            .copy M|tbversand = G|true             
            .load 2 nolock sales
        }
    }
}

