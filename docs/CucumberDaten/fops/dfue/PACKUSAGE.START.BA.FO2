..<META M|='dfue/PACKUSAGE'>
..<META H|='P106:1'>
..<META 1|='P106:1'>

def main() {
    .set trans -

    .type bool noProcessCheckboxMarked
    .type P2:1 packMaterial
    .type P106:1 packInstruction
    
    .. Start empty
    .make screen line --  ?  M|tzeilen > 0
    
    .. Nothing marked means all marked
    .formula U|noProcessCheckboxMarked = _(M|kbartikel ; M|kbkuart ; M|kbrahmen ; M|kbauftrag ; M|kbliefer ; M|kbvplan ; M|kbpackanw ; M|kbfertigungsliste ; M|kbkonto)
    
    .. Query usage of single pack instruction
    if (M|kbpackanweisungen) {
        .copy U|packInstruction = M|kpackanw
        .call queryPackInstructionUsages()
    }    
    
    .. Query usage of all pack instructions that contain a pack material 
    .. note: Checkbox kbanwzupackmit is not visible on default screen
    if (M|kbpackmittel & M|kbanwzupackmit) {
        .select packinginstructions 'F|formatstr("$,,;@gruppe=1;@zeilen=(Yes);artikel={1}", M|kpackmit^id)'
        while (G|mehr) {
            .formula U|packInstruction = H|id
            .call addPackInstructionRowForPackMaterial()
            .call queryPackInstructionUsages()
            .select packinginstructions
        }
    }
    
    .. Query usage of a pack material
    if (M|kbpackmittel & _M|kbanwzupackmit) {
        .copy U|packMaterial = M|kpackmit
        .call queryPackMaterialUsage()
    }    
}
 
def addPackInstructionRowForPackMaterial() {
    .make screen line +O
    .colour -background 'U|xabasstructuretop' 'M|aktzeile'
    .formula M|tkopf = H|id
    .formula M|tvorgang = 'H|objgrbez'
    .formula M|tpackanw = H|id
    .select head
    .select line
    .formula M|tpackm = H|artikel^id
    .copy M|tblager = G|false 
    .copy M|tbversand = G|false 
} 
     
def queryPackInstructionUsages( ) { 
    .call readProductsForStoragePackInstruction()
    .call readProductsForShippingPackInstruction()
    .call readCustomerProductsForStoragePackInstruction()
    .call readCustomerProductsForShippingPackInstruction()
    .call readBlanketOrdersForPackInstruction()
    .call readOrdersForPackInstruction()
    .call readShippingPlanningForPackInstruction()
    .call readPackingSlipsForPackInstruction()
    .call readWorkOrderSuggestionForPackInstruction()
} 

def queryPackMaterialUsage( ) { 
    .call readPackInstructionsForPackMaterial()
    .call readProductionListForPackmaterial()
    .call readContainerAccountsForPackmaterial()
    .call readBlanketOrdersForPackMaterial()
    .call readOrdersForPackMaterial()    
    .call readPackingSlipForPackMaterial()
} 

def readProductsForStoragePackInstruction( ) { 
    ..<META 2|='P2:1'>
    if (U|noProcessCheckboxMarked ; M|kbartikel) {
        .load 2 nolock parts 'F|formatstr("$,,;@gruppe=1;packanwstdla={1}", U|packInstruction^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = 2|id
            .formula M|tvorgang = '2|objgrbez'
            .formula M|tartikel = 2|id 
            .formula M|tfmenge = 2|fmengestdla 
            .formula M|tle = 2|le
            .load 1 nolock packinginstructions '2|packanwstdla^id'
            .load 1 nolock line
            if (G|mehr) {
                .formula M|tpackanw = 1|id 
                .formula M|tpackm = 1|artikel^id 
            }
            .copy M|tblager = G|true
            .copy M|tbversand = G|false
            .load 2 nolock parts
        }
    }
} 

def readProductsForShippingPackInstruction( ) { 
    ..<META 2|='P2:1'>
    if (U|noProcessCheckboxMarked ; M|kbartikel) {
        .load 2 nolock parts 'F|formatstr("$,,;@gruppe=1;packanwstdversand={1}", U|packInstruction^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = 2|id
            .formula M|tvorgang = '2|objgrbez'
            .formula M|tartikel = 2|id 
            .formula M|tfmenge = 2|fmengestdversand 
            .formula M|tle = 2|le
            .load 1 nolock packinginstructions '2|packanwstdversand^id'
            .load 1 nolock line
            if (G|mehr) {
                .formula M|tpackanw = 1|id 
                .formula M|tpackm = 1|artikel^id 
            }
            .copy M|tblager = G|false
            .copy M|tbversand = G|true
            .load 2 nolock parts
        }        
    }
} 

def readCustomerProductsForStoragePackInstruction() {
    ..<META 2|='P2:6'>
    if (U|noProcessCheckboxMarked ; M|kbkuart) {
        .load 2 nolock parts 'F|formatstr("$,,;@gruppe=6;packanwla={1}", U|packInstruction^id)'
        while (G|mehr) {
            .make screen line +O
            .colour -background -1 -1 -1 'M|aktzeile'
            .formula M|tkopf = 2|artikel^id
            .formula M|tpos = 2|id
            .formula M|tvorgang = '2|objgrbez'
            .formula M|tpartner = 2|kl^id
            .formula M|tartikel = 2|artikel^id
            .formula M|tfmenge = 2|fmengela 
            .formula M|tle = 2|artikel^le
            .copy M|tpackanw = 2|packanwla
            .load 1 nolock packinginstructions '2|packanwla^id'
            .load 1 nolock line
            .formula M|tpackm = 1|artikel^id ?  G|mehr
            .copy M|tblager = G|true
            .copy M|tbversand = G|false            
            .load 2 nolock parts 
        } 
    }
}

