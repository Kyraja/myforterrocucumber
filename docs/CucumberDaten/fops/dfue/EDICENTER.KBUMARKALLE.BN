..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDICENTER.KBUMARKALLE.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Alle angezeigten Zeilen markieren
.. Functionality  : Mark all shown rows.
..*****************************************************************************
.set trans -
..
.. may only use mark all if transaction type and status are not empty
.. and not set to "all"
..
.continue ERRARG  ?  F|empty(M|kedinachraz) & _M|kedinachrazabrufe
.continue ERRARG  ?  F|empty(M|statname) ; F|empty(M|astatus) ; M|astatus = "!"
..
.type integer    xizeile
.formula T|xizeile = M|aktzeile
..
.select screen header
!NMARK
.select screen line
.continue EMARK  ? _G|mehr
.copy M|tbmark = G|true
.continue NMARK
!EMARK
.select screen line 'T|xizeile'
..*****************************************************************************
!END
.continue
..
..
!ERRARG
.error W„hlen Sie eine Vorgangsart und einen Status!
.end 1
