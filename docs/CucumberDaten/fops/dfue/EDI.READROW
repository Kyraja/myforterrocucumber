..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDI.READROW
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Split row from edi import file into fields, does NOT remove spaces
..*****************************************************************************
.set trans -
..
.. Arguments
.type text ediimportdatei ? _F|defined(U|ediimportdatei)
.type text ediimportzeile ?_F|defined(U|ediimportzeile)
.type text editrenner ? _F|defined(U|editrenner)
.. 
.. Required arguments
.continue NOFILE ? F|empty(U|ediimportdatei)
.continue NOFILE ? _F|fileexists(U|ediimportdatei)
.. 
.. Return values
.type BGL80 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 ? _F|defined(U|x1)
.. 
.. Initialize return values
.formula U|x1 = "" 
.formula U|x2 = "" 
.formula U|x3 = "" 
.formula U|x4 = "" 
.formula U|x5 = "" 
.formula U|x6 = "" 
.formula U|x7 = "" 
.formula U|x8 = "" 
.formula U|x9 = "" 
.formula U|x10 = "" 
.formula U|x11 = "" 
.formula U|x12 = "" 
.formula U|x13 = "" 
.formula U|x14 = "" 
.formula U|x15 = "" 
.formula U|x16 = "" 
.formula U|x17 = "" 
.formula U|x18 = "" 
.formula U|x19 = "" 
.formula U|x20 = "" 
.formula U|x21 = "" 
.formula U|x22 = "" 
.formula U|x23 = "" 
.formula U|x24 = "" 
.formula U|x25 = "" 
.formula U|x26 = "" 
.. 
.. Locally used fields
.type integer fi ? _F|defined(fi)
..
.. Assume default values
.formula U|editrenner = "#" ? F|empty(U|editrenner)
.. 
.. Read row from file and split into fields
.select from 'U|ediimportdatei' U|ediimportzeile^
.continue DONE ? _G|mehr
.formula U|fi = 0
!NEXT
.continue DONE ? U|fi > 25
.formula U|fi = U|fi + 1
.formula U|x.fi = U|ediimportzeile<<'U|editrenner'
.formula U|ediimportzeile = U|ediimportzeile>>'U|editrenner'
.continue NEXT
!DONE
..   
..*****************************************************************************
!END
.continue
.. 
.. 
!NOFILE
.error Ohne Importdatei kann nicht importiert werden.
.end 1
