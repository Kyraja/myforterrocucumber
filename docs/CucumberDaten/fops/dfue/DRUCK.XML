..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DRUCK.XML
.. Datum          : 26.07.2010
.. Version        : 2010r4n00
.. Autor          : ok
.. Verantwortlich : dsch
.. Kontrolle      : mh
.. Funktion       : XML-Vorgang aus der EDI-Datenbank drucken
..
.. Functionality  : prints the xml document stored in the edi database
..*****************************************************************************
.set trans +
..
.type text xtMEDI ? _F|defined(xtMEDI)
.type text xtMVOM ? _F|defined(xtMVOM)
.type text xtMZEI ? _F|defined(xtMZEI)
.type text xtMAND ? _F|defined(xtMAND)
.type text xtMDAT ? _F|defined(xtMDAT)
.type text xtMSEI ? _F|defined(xtMSEI)
..
.formula U|xtMEDI = "EDI-ID"
.formula U|xtMVOM = "vom"
.formula U|xtMZEI = "Zeit"
.formula U|xtMAND = "Mandant"
.formula U|xtMDAT = "Datum"
.formula U|xtMSEI = "Seite"
..
.set trans -
..
.type text xtmp xtext1
..
!START
.up
.page 1
..
..
'U|xtMEDI ': 'H|nummer   '                                         'U|xtMAND ': 'mandant'
'U|xtMVOM ': 'H|ddatei   '    'H|name                         '    'U|xtMDAT ': 'datum'
'U|xtMZEI ': 'H|zdatei   '                                         'U|xtMSEI ': 'seite'
------------------------------------------------------------------------------------------
.continue MAIN0
..
!MAIN0
.select line
.continue ENDE0       ? _mehr
.continue MAIN0       ?  +H|text3=0
.formula xtmp = text2>>":" ? text2/"*:*"
.formula xtmp = text2      ? _text2/"*:*"
?------------------------------------------------------------------------------------------ ? text1<>xtext1 & xtext1<>""
'xtmp                              ' 'text3                     '
.formula xtext1 = text1
.continue MAIN0
..
!ENDE0
.continue
