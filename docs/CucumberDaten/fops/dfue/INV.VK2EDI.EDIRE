.continue EL088 ? _((xUrsp = "001") ; (xUrsp = "002") ; (xUrsp = "003") ; (xUrsp = "004") ; (xUrsp = "005") ; (xUrsp = "006") ; (xUrsp = "007") ; (xUrsp = "008") ; (xUrsp = "009") ; (xUrsp = "010") ; (xUrsp = "011") ; (xUrsp = "030") ; (xUrsp = "032") ; (xUrsp = "038"))
