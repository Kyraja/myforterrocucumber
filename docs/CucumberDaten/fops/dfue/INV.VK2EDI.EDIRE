.formula xValutaDatum        = h|vdat
..
.formula xBudat              = h|budat:8
.formula xZahlungsart        = h|zaform
.formula xLand               = h|land
.formula xSkontoBezugsBetrag = 'h|skbbetr'
.formula xrSKBBETR           =  h|skbbetr
