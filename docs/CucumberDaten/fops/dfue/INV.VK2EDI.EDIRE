!ELOP003: ==============================
..
.. und wieder zurÅck, wo ich herkomme
.select lock header
..
.. Daten fÅr SÑtze 300 ( BetrÑge+Steuer )
..Variablen definition Satz 300
...xReBetragBrutto = rebetr
...xStBetragG      = Summe aller SteuerbetrÑge pro MWST-Satz
...xReBetragNetto  = xReBetragBrutto - alles SteuerbetrÑge - alle AbschlÑge + alle ZuschlÑge
..
.type integer xIndSt
.formula U|xIndSt = 0
..
.. mh, 08.12.2011: clearn xStBetrag (will be summed later if there are any taxes)
.formula U|xStBetrag = 0.0
..
..
.continue EL111 ? _(_(xMwStfrei))
.. IF111
..
!LOOP004: ==============================
.continue ELOP004 ? _(xIndSt<10)
..
.continue EL112 ? _(xReBetragNetto.xIndSt<>0)
.. IF112
.. Ausgabe 300
...GesamtWerte je Steuersatz bilden
.formula xGSt.xIndSt = xGSt.xIndSt + xStBetrag.xIndSt
.formula xGWW.xIndSt = xGWW.xIndSt + xWarenWert.xIndSt
..**ok,21.05.2003 (Gesamtbrutto auch je Steuersatz)
.formula xReBetragBrutto.xIndSt = xReBetragNetto.xIndSt + xStBetrag.xIndSt
..
.output addedto 'xDatRech'
..
..
.continue EL113 ? _(xBelegArt = "380")
.. IF113
