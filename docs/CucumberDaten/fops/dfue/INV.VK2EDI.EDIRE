300 # 01 #'xReBetragNetto.xIndSt'#'xReBetragBrutto.xIndSt'#'xStSatz.xIndSt'#'xStBetrag.xIndSt'#'xZuschlag.xIndSt'#'xAbschlag.xIndSt'#'xZuschlagG:2'#'xAbschlagG:2'#'xWarenWert.xIndSt'#'xStBetragG:2'#'xWarenWertG:2'#'xStBasis.xIndSt'# # # # # # # # # # # 'xLfdNr' #
..
.continue FI113
!EL113
.. xBelegArt = "381"
..**ok,14.04.2003 (bei Gutschriften xBelegart = "381" werden bei BetrÑgen und Mengen kein Minus-Zeichen verwendet)
..**ok,21.05.2003 (jetzt ??ReBetragNetto als ??ReBetragNetto.xIndSt)
.formula xMReBetragNetto.xIndSt   = 'xReBetragNetto.xIndSt'
.formula xMReBetragBrutto.xIndSt  = 'xReBetragBrutto.xIndSt'
.formula xMStSatz.xIndSt   = 'xStSatz.xIndSt'
.formula xMStBetrag.xIndSt = 'xStBetrag.xIndSt'
.formula xMZuschlag.xIndSt = 'xZuschlag.xIndSt'
.formula xMAbschlag.xIndSt = 'xAbschlag.xIndSt'
.formula xMZuschlagG       = 'xZuschlagG'
.formula xMAbschlagG       = 'xAbschlagG'
.formula xMWarenWert.xIndSt= 'xWarenWert.xIndSt'
.formula xMStBetragG       = 'xStBetragG'
