..
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
.. procedure stack pointer ist im hauptprogramm definiert
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
..
!PROC001: ----- FEHLER -----
.formula xbfehler = true
..
.output addedto 'xdfehler'
..box Fehler
?'xtxt1' ? +xtxt1 > 0
?'xtxt2' ? +xtxt2 > 0
..
.. wieder auf alte datei schreiben
.output addedto 'xgeraet'
..
..**ok,06.12.2004 (wenn vom Infosystem aufgerufen wird)
..
..
.continue EL001 ? _(xbinfo)
.. IF001
.formula M|fehltext = xtxt1 + ";" + xtxt2
..
!EL001
.. FI001
..
.continue 'xprocst.xprocsp'
..
..
!PROC002: ----- SENDE.POST -----
.set trans +
.formula xPostBetreff = "Fehler beim öbernehmen von Rechnungen in EDI-Datenbank"
.formula xPostStichw1 = "DFö-Fehler"
.set trans -
..fo xPostFtext   = xdfehler
.formula xPostEmpf    = xIdDfueExVerteil
..
.input 'xdPostSenden' ? xPostEmpf<>""
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
.. programm ist unterprogramm von DFUE.VK2EDI
.end . ? txname / "*INV.VK2EDI.EDIRE"
..
.. khuelskaemper 2024 Ob das Land des Mandanten in der EU ist
.. istInEU = (euKennung != '') AND (austritt='' OR (austritt > heute))
.formula U|xInland = F|sysinfo(10)^staat
.formula U|xobeuland = (U|xInland^egkenn <> "") & (('U|xInland^egbis:8' = "") ; ('U|xInland^egbis:8' > 'G|datum:8'))
..
.. Kunden-GLN fÅr EmpfÑnger ermitteln
.. ----------------------------------------
.reserve lifo
.formula U|xKundeGLN = ""
..
.select add kunde2
..
..
.continue EL002 ? _(mehr)
.. IF002
.. get xbintedi/kopf/pos and reliempf^GLN
.input "DFUE.GET.PROTOK"
..
.. xKundeGLN and xRELiGLN are both used in edi message!
.formula U|xKundeGLN = H|gln
.formula U|xKundeGLN = U|xvreliempf^gln  ? _F|empty(U|xvreliempf)
.formula U|xRELiGLN  = U|xKundeGLN
..
!EL002
.. FI002
..
.select lifo
.. ----------------------------------------
..
.. nur beim ersten durchlauf, einmal pro Nachricht
.. daten fÅr Satz 000
..
.continue EL003 ? _(xbfirstime)
.. IF003
.. daten fÅr satz 000 in datei
..EintrÑge edifact
..
.output new 'xDatRechAll'
.input DATEI.F
000 # 01 # EDIFACT # VKRE # 380 # 'xBetrGLN' # # #'xRELiGLN'# # #'datum:8'# 'zeit' # # # # # # # # # # # # 'xLfdNr' #
..
.formula xLfdNr  = xLfdNr  + 1
.formula xCnt000 = xCnt000 + 1
..
.formula xbfirstime = false
..
!EL003
.. FI003
..
..alle Zahlen erstmal mit dez="." damit kann bei Export noch gerechnet werden
.set decpoint .
..**ok,05.11.2003 (.setz tsd --> .setz tsdtrenn)
.set thoussep
..
.. zur Rechnung gehîrende LS-Nr und AU-Nr
.formula xLsNr = ""
.formula xAuNr = ""
.formula xAuDatum = ""
.formula xLsDatum = ""
..
.formula xgeraet     = xDatRech
..
..**ok,10.02.2003 (hier die Datei xDatRabat NEU)
..
.formula xDatRabat =  "X.RARE." + pid + ".TMP"
..
.output new 'xDatRabat'
.input DATEI.F
..
.. KOPFDATEN
.. Sammeln der Rechnungs-Kopfdaten
.. jetzt werden die daten der rechnung erst mal gesammelt
..**mh, 13.03.2007: AuNr = Bestellnummer Kunde, jetzt direkt aus der Rechnung
.formula T|xAuNr         = H|frzeich
.formula xReNr               = h|num
.formula xReDatum            = h|vom:8
.formula xbuart              = h|buart
.formula xKundeNr            = h|kunde
.formula xKunde2Nr           = h|kunde2
.formula xVersandArt         = H|vart
..
..**ok,04.12.2003 (ValutaDatum, xZahlungZum nicht 8-stellig genommen)
