.formula xFText1 = betreff << ";"
.formula xFText2 = (betreff >> ";" ) << ";"
.formula xFText3 = (betreff >> ";" ) >> ";"
.formula xFText4 = ((betreff >> ";" ) >> ";" ) >> ";"
