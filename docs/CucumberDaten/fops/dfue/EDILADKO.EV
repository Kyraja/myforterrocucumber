..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDILADKO.EV
.. Autor          : tg
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Eventhandling Infosystem EDILADKO
.. Functionality  : general eventhandling EDILADKO
..*****************************************************************************
.set trans -
..
.type P53    xvedi       ? _F|defined(xvedi)
..
.. event evaluation
.. ----------- ----- Header events ---------------------------------------------
.continue EDINR   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "edinr"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!EDINR
.continue NOLAKO  ?  M|edinr^such <> "LAKO"  &  _F|empty(M|edinr)
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.assign T|xvedi = M|edinr^id
.input "is/KOPFLEEREN"
.assign M|edinr = T|xvedi^id
.continue END
..*****************************************************************************
!END
.continue
..
..
!NOLAKO
.error Vorgang 'M|edinr' ist kein Ladungstr„ger-Kontoauszug!
.cursor edinr 0
.end 1
