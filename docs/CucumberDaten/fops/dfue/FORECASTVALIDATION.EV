.set trans -
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kedivon"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kedibis"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kkunde"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kwerk"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kablstelle"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kkunde2"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kerfassvon"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kerfassbis"
.continue NACHR   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kblab"
.continue NACHR   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbfab"
.continue NACHR   ?  G|evtartengl = "FIELD_EXIT"   &  G|evtvar = "kbvab"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!NACHR
.copy M|kblab = G|false
.copy M|kbfab = G|false
.copy M|kbvab = G|false
.copy M|.evtvar = G|true
.. 
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
