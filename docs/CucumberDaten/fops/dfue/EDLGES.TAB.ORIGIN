..!interpreter english translate noabbrev
..!meta M|=dfue/EDLGES
..*****************************************************************************
.. Name           : EDLGES.TAB.ORIGIN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : 
.. Functionality  : Create row for origin packing slip row.
..*****************************************************************************
.set trans -
..
.. Create origin row
.make screen line +O
.colour -background -1 -1 -1 'M|aktzeile'
.formula M|turspr = T|xUrsprung
..
.. Initialize withdraw quantities for this product in field kmgeges
.formula M|kmgeges = 0
.. 
.. Origin head
.assign M|tkunde = 1|kunde^id
.assign M|tkunde2 = 1|kunde2^id
.assign M|tedl = 1|edl^id
.copy M|twerk = 1|werk
.copy M|tablstelle = 1|ablstelle
.assign M|tnummer = 1|id
.assign M|tedinr = 1|sped^ediid
.copy M|tvom = 1|vom
.copy M|tedlnr = 1|edllsnr
.copy M|tedldat = 1|edllsdat
.. 
.. Origin row
.assign M|tart = 2|artex^id
.copy M|tnamebspr = 2|artex^sucherw
.copy M|tkuart = 2|zkuartnr
.copy M|tcharge = 2|charge
.copy M|tmge = 2|mge
.copy M|tfmenge = 2|fmenge ? 2|artex^packmit
.formula M|tganr = 2|ganr
.copy M|tfzahl = 2|fzahl
..
..*****************************************************************************
!END
.continue
