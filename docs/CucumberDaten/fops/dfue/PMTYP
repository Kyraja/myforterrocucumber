..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PMTYP
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Umsetzung von A215 in lesbare FOP-Felder
.. Functionality  : Transfers A215 into readable FOP fields
..
..   Argument           meaning
..   ---------------------------------------------------------
..   xpmtyp             Packaging material type,
..                      enumartion A215
..
..   Returnvalue        meaning
..   ---------------------------------------------------------
..   xtpmtyp            "text-value" for the argument field
..    ^                 "xpmtyp", is compareable to the following
..                      constant fields:
..
..   Contant field      meaing                  interal value
..   ---------------------------------------------------------
..   xContainer         container                     "(67)"
..   xPalette           palette                       "(80)"
..   xBehaelter         box                           "(66)"
..   xPackhilfsmittel   auxiliary packaging material  "(72)"
..   xZwischenlage      intermediate layer            "(90)"
..   xFuellmaterial     padding                       "(70)"
..   xDeckel            cover                         "(68)"
..   xLeer              "no value"                    "(0)"
..
..  EXAMPLE
..      .. h buffer has delivery note row
..      .art A215 xpmtyp
..      .formula U|xpmtyp = H|pmtyp
..      .input "PMTYP"
..      ..
..      .weiter PACKAGE   ?  U|xtpmtyp = U|xContainer ; U|xtpmtyp = U|xPalette ; U|xtpmtyp = U|xBox
..      .weiter FLUFF     ?  U|xtpmtyp = U|xAuxiliaryPackaging ; U|xtpmtyp = U|xIntermediateLayer ; U|xtpmtyp = U|xCover
..      .weiter NOPACK    ?  U|xtpmtyp = U|xEmpty
..
..*****************************************************************************
.set trans -
..
.continue NOPARAM  ? _F|defined(U|xpmtyp)
.continue ERRTYPE  ? 'F|typeof(U|xpmtyp)' <> "A215"
..
.. return field
.type text   xtpmtyp  ? _F|defined(xtpmtyp)
..
..  enumeration PackagingType A215
.type text   xContainer          ? _F|defined(U|xContainer)
.type text   xPalette            ? _F|defined(U|xPalette)
.type text   xBehaelter          ? _F|defined(U|xBehaelter)
.type text   xBox                ? _F|defined(U|xBox)
.type text   xPackhilfsmittel    ? _F|defined(U|xPackhilfsmittel)
.type text   xAuxiliaryPackaging ? _F|defined(U|xAuxiliaryPackaging)
.type text   xZwischenlage       ? _F|defined(U|xZwischenlage)
.type text   xIntermediateLayer  ? _F|defined(U|xIntermediateLayer)
.type text   xFuellmaterial      ? _F|defined(U|xFuellmaterial)
.type text   xPadding            ? _F|defined(U|xPadding)
.type text   xDeckel             ? _F|defined(U|xDeckel)
.type text   xCover              ? _F|defined(U|xCover)
.type text   xLeer               ? _F|defined(U|xLeer)
.type text   xEmpty              ? _F|defined(U|xEmpty)
..
.. internal values for enumeration PackagingType A215
.. double constant fields with different german/english names
.formula U|xContainer            = "(67)"
.formula U|xPalette              = "(80)"
.formula U|xBehaelter            = "(66)"
.formula U|xBox                  = "(66)"
.formula U|xPackhilfsmittel      = "(72)"
.formula U|xAuxiliaryPackaging   = "(72)"
.formula U|xZwischenlage         = "(90)"
.formula U|xIntermediateLayer    = "(90)"
.formula U|xFuellmaterial        = "(70)"
.formula U|xPadding              = "(70)"
.formula U|xDeckel               = "(68)"
.formula U|xCover                = "(68)"
.formula U|xLeer                 = "(0)"
.formula U|xEmpty                = "(0)"
..
.. extract value from enumeration
.formula U|xtpmtyp = U|xLeer
.formula U|xtpmtyp = F|value(U|xpmtyp,"AU215")
..
..*****************************************************************************
!END
.continue
..
.set trans +
..
!NOPARAM
.error Als Aufrufparameter fÅr dieses FOP muss die Variable xpmtyp verwendet werden.
.end 1
..
!ERRTYPE
.error Die Variable xpmtyp muss die Variablenart A215 haben.
.end 1
