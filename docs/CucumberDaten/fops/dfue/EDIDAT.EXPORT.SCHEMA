..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIDAT.EXPORT.SCHEMA
.. Datum/Date     : 24.03.11
.. Version        :
.. Autor/Author   : dsch
.. Verantwortlich : dsch
.. Funktion       : Schema-Export als FOP, in FO-Variablen.
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
.. Functionality  : schema-export in fop format, as fo-variables.
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..*****************************************************************************
.set trans -
.type text xtexport ? _F|defined(xtexport)
..
.continue IEXPORT ? U|xtexport="I"
.continue FEXPORT ? U|xtexport="F"
.continue SEXPORT ? U|xtexport="S"
.continue
..
.. Initialisierung der FO-Exportdatei
..
!IEXPORT
.set command %
..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : 'U|xtFProtDatei'
.. Author         : generiert mit Schemadaten exportieren
.. Verantwortlich : -
.. Kontrolle      :
.. Funktion       : Parameterdatei fÅr Infosystem EDIDAT
.. Functionality  : parameterfile for the info system EDIDAT
..*****************************************************************************
..
%set command .
.continue
..
.. Feld-Export als FO-Variablen
..
!FEXPORT
.set command %
..
.. Feld:'F|eval(F|tostring(U|xindex)+"|ref^nummer")' (Satz 'xiaid':'xipos')
..
.type text 'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtNAME+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtNAME''xipos')
.type text 'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtREFTOKEN+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtREFTOKEN''xipos')
.type int  'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtMIN+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtMIN''xipos')
.type int  'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtMAX+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtMAX''xipos')
.type text 'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtTYP+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtTYP''xipos')
.type int  'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtMINLEN+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtMINLEN''xipos')
.type int  'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtMAXLEN+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtMAXLEN''xipos')
.type int  'F|substr(F|expr("xAFeld"+F|tostring(xiaid)+xtNKOMMA+F|tostring(xipos)+F|string(" ",28)),1,28)' ? _defined(xAFeld'xiaid''xtNKOMMA''xipos')
..
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtNAME+F|tostring(xipos)+F|string(" ",30)),1,30)' = "'U|xAFeld.xiaid.xtNAME.xipos'"
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtREFTOKEN+F|tostring(xipos)+F|string(" ",30)),1,30)' = "'U|xAFeld.xiaid.xtREFTOKEN.xipos'"
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtMIN+F|tostring(xipos)+F|string(" ",30)),1,30)' = 'U|xAFeld.xiaid.xtMIN.xipos'
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtMAX+F|tostring(xipos)+F|string(" ",30)),1,30)' = 'U|xAFeld.xiaid.xtMAX.xipos'
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtTYP+F|tostring(xipos)+F|string(" ",30)),1,30)' = "'U|xAFeld.xiaid.xtTYP.xipos'"
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtMINLEN+F|tostring(xipos)+F|string(" ",30)),1,30)' = 'U|xAFeld.xiaid.xtMINLEN.xipos'
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtMAXLEN+F|tostring(xipos)+F|string(" ",30)),1,30)' = 'U|xAFeld.xiaid.xtMAXLEN.xipos'
.formula 'F|substr(F|expr("U|xAFeld"+F|tostring(xiaid)+xtNKOMMA+F|tostring(xipos)+F|string(" ",30)),1,30)' = 'U|xAFeld.xiaid.xtNKOMMA.xipos'
%set command .
.continue
..
.. Struktur-Export als FO-Variablen
..
!SEXPORT
.set command %
..
.. Satz:'xiaid' KÅrzel:'xAStruktur.xiaid.xtREFTOKEN'
..
.type text 'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtLISTID+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtLISTID')
.type text 'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtL3TOKEN+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtL3TOKEN')
.type text 'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtALLID+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtALLID')
.type text 'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtREFTOKEN+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtREFTOKEN')
.type int  'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtGRP+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtGRP')
.type int  'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtMIN+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtMIN')
.type int  'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtMAX+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtMAX')
.type int  'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtCNTID+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtCNTID')
.type int  'F|substr(F|expr("xAStruktur"+F|tostring(xiaid)+xtCOUNTER+F|string(" ",28)),1,28)' ? _defined(xAStruktur'xiaid''xtCOUNTER')
..
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtLISTID+F|string(" ",30)),1,30)' = "'U|xAStruktur.xiaid.xtLISTID'"
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtL3TOKEN+F|string(" ",30)),1,30)' = "'U|xAStruktur.xiaid.xtL3TOKEN'"
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtALLID+F|string(" ",30)),1,30)' = "'U|xAStruktur.xiaid.xtALLID'"
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtREFTOKEN+F|string(" ",30)),1,30)' = "'U|xAStruktur.xiaid.xtREFTOKEN'"
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtGRP+F|string(" ",30)),1,30)' = 'U|xAStruktur.xiaid.xtGRP'
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtMIN+F|string(" ",30)),1,30)' = 'U|xAStruktur.xiaid.xtMIN'
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtMAX+F|string(" ",30)),1,30)' = 'U|xAStruktur.xiaid.xtMAX'
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtCNTID+F|string(" ",30)),1,30)' = 'U|xAStruktur.xiaid.xtCNTID'
.formula 'F|substr(F|expr("U|xAStruktur"+F|tostring(xiaid)+xtCOUNTER+F|string(" ",30)),1,30)' = 'U|xAStruktur.xiaid.xtCOUNTER'
%set command .
.continue
