..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FORECASTCONFIG.KBUZAEHLEN.BA
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans - 
.. 
.type P109:2 edinachr ? _F|defined(U|edinachr)
.. 
.formula M|kanzlabjedi = 0
.formula M|kanzlabfo = 0
.formula M|kanzlabohne = 0
.. 
.formula M|kanzfabjedi = 0
.formula M|kanzfabfo = 0
.formula M|kanzfabohne = 0
.. 
.formula M|kanzvabjedi = 0
.formula M|kanzvabfo = 0
.formula M|kanzvabohne = 0
..
.select customer "$,,;@gruppe=1.2;@ordnung=nummer;edinfosnr<>`" 
.continue END ? _G|mehr
..
!NEXT 
.continue GROUP1 ? H|gruppe=1
.load 2 customer 'H|edinfosnr^id'
.load 2 line 'F|formatstr("$,,;edinachr={1}", M|kedinachr1^id)'
.continue END1 ? _G|mehr
.formula M|kanzlabfo = M|kanzlabfo + 1     ?  F|empty(2|abmodell)
.formula M|kanzlabjedi = M|kanzlabjedi + 1 ? _F|empty(2|abmodell)
.load 2
!END1
.. 
.load 2 customer 'H|edinfosnr^id'
.load 2 line 'F|formatstr("$,,;edinachr={1}", M|kedinachr2^id)'
.continue END2 ? _G|mehr
.formula M|kanzfabfo = M|kanzfabfo + 1     ?  F|empty(2|abmodell)
.formula M|kanzfabjedi = M|kanzfabjedi + 1 ? _F|empty(2|abmodell)
.load 2
!END2
..
.load 2 customer 'H|edinfosnr^id'
.load 2 line 'F|formatstr("$,,;edinachr={1}", M|kedinachr3^id)'
.continue END3 ? _G|mehr
.formula M|kanzvabfo = M|kanzvabfo + 1     ?  F|empty(2|abmodell)
.formula M|kanzvabjedi = M|kanzvabjedi + 1 ? _F|empty(2|abmodell)
.load 2
!END3
.. 
!GROUP1
.load 2 customer 'H|edinfosnr^id'
.load 2 line "$,,;vorgang==VKAUVE-A"
.continue END4 ? _G|mehr
.formula M|kanzlabohne = M|kanzlabohne + 1  ?  F|empty(2|edinachr) ; H|gruppe=1      
.load 2
!END4
.. 
.load 2 customer 'H|edinfosnr^id'
.load 2 line "$,,;vorgang==VKAUVEF-A"
.continue END5 ? _G|mehr
.formula M|kanzfabohne = M|kanzfabohne + 1  ?  F|empty(2|edinachr) ; H|gruppe=1
.load 2
!END5
.. 
.load 2 customer 'H|edinfosnr^id'
.load 2 line "$,,;vorgang==VKAUVEP-A"
.continue END6 ? _G|mehr
.formula M|kanzvabohne = M|kanzvabohne + 1  ?  F|empty(2|edinachr) ; H|gruppe=1
.load 2
!END6
.. 
.select customer
.continue NEXT ? G|mehr
.. 
..*****************************************************************************
!END
.continue
