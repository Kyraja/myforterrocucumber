..<META M|='dfue/DELNOTECONFIG'>
.set trans -
.. 
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue EDIT     ?  G|evtartengl = "BUTTON_BEFORE"  &  G|evtvar = "kbuupgrade"
.continue FIXIT    ?  G|evtartengl = "BUTTON_BEFORE"  &  G|evtvar = "kbukorrigieren"
.continue DEFAULT  ?  G|evtartengl = "BUTTON_BEFORE"  &  G|evtvar = "kbustandard"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
.. 
!EDIT
.continue NOROWS  ?  M|tzeilen=0
.continue ERROR   ?  M|kbohnenachricht
.continue END
.. 
!FIXIT
.continue NOROWS  ?  M|tzeilen=0
.continue ERROR   ? _M|kbohnenachricht
.continue END
.. 
!DEFAULT
.continue NOROWS  ?  M|tzeilen=0
.continue ERROR   ?  M|kbohnenachricht
.input "DELNOTECONFIG.KBUVORBELEGUNG.BA.FO"
.copy M|kbkonfigurieren = G|true
.continue END
..
..*****************************************************************************
!END
.continue
.. 
.. 
!NOROWS
.error Die Tabelle enth„lt keine Zeilen.
.end 1
.. 
!ERROR
.error Die gew„hlte Funktion passt nicht zu den in der Tabelle enthaltenen Zeilen.
.end 1
