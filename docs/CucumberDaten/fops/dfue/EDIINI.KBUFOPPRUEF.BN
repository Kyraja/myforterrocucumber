..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDIINI.KBUFOPPRUEF.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type text   xtini
.type text   xtfoppruef
.type text   xtsystem
.type text   xt1
.type integer    xi1
..
.. only difference when using this FOP in either Infosystems EDIIMPINI
.. and EDIEXPINI is the name of the INI-File / I-File efop
.formula T|xtini = "DFUE.EXP.INI"    ? M|num65 = "10074"
.formula T|xtini = "DFUE.IMP.INI"    ? M|num65 = "10075"
.continue END     ?  F|empty(T|xtini)
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue PRUEF1  ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "kbufoppruef1"
.continue PRUEF2  ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "kbufoppruef2"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!PRUEF1
.formula M|kfopliste = ""
.file -tempname T|xtfoppruef
.formula T|xtsystem = "find -name " + T|xtini + " > " + T|xtfoppruef
.system 'T|xtsystem' background
.continue AUSGABE
..
!PRUEF2
.formula M|kfopliste = ""
.formula M|kverz = 'M|kverz'
.continue NOTIME  ?  M|kverz = "*" ;  F|strindex(M|kverz,"/") = 1
.continue NOMAND  ?  F|strindex(M|kverz,"$") > 0 ; F|strindex(M|kverz,"..") > 0
.continue NOVERZ  ? _F|fileexists(M|kverz)  &  F|strindex(M|kverz,"*") = 0
.file -tempname T|xtfoppruef
.formula T|xtsystem = "grep -i -e " + dblquote + "^\.[[:alnum:]].*\" + dblquote + T|xtini + dblquote + " -r " + 'M|kverz' + " --exclude=EDIINI.KBUFOPPRUEF.BN  > " + T|xtfoppruef
.system 'T|xtsystem' background
.continue AUSGABE
..
!AUSGABE
.continue END     ?  F|empty(T|xtfoppruef)
.continue END     ? _F|filereadable(T|xtfoppruef)
.formula T|xi1 = 0
!ZEILE
.continue BILD    ?  T|xi1 > 15
.select from 'T|xtfoppruef' xt1 ^
.continue END     ? _T|mehr
.formula T|xi1 = T|xi1 + 1
.formula M|kfopliste = M|kfopliste + T|xt1 + ";"
.continue ZEILE
!BILD: too many matches to show in mask
.select -
.formula M|kfopliste = ""
.output
.input "DATEI.F"
.input -text 'T|xtfoppruef'
..*****************************************************************************
!END
.continue
..
..
!NOVERZ
.set trans +
.formula T|xt1 = "Das Verzeichnis {1} ist nicht vorhanden"
.set trans -
.error 'F|formatstr(T|xt1, M|kverz)'
.end 1
..
!NOTIME: verz=* takes too long, can still be achieved with verz=.
.error Bitte schrÑnken Sie die Verzeichnisauswahl ein.
.end 1
..
!NOMAND: blocking tricks to leave the mandanddir
.error Diese Eingabe fÅr das Verzeichnis ist nicht erlaubt.
.end 1
