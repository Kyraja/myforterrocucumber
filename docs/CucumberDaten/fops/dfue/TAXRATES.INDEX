..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TAXRATES.INDEX
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. Index number
.type integer itax ? _F|defined(U|itax)
.. Largest index number
.type integer maxitax ? _F|defined(U|maxitax)
.. Normalized index identifier
.type NT20 xt ? _F|defined(U|xt)
.. 
.. Current taxrate
.type RP3.2 taxrate ? _F|defined(U|taxrate)
..
.. Origin of method call
.continue ROW     ? "11" = 'U|taxcode^gruppe'
.continue INVOICE ? F|defined(H|zstrgl) & _F|empty(H|zstrgl)
.continue NOTAX
..
!INVOICE: Parameter:invoice row 
.copy U|taxcode = H|zstrgl^budatstper
.continue NOTAX ? _G|mehr
!ROW: Parameter: taxcode row with tax period data
.formula U|xt = F|regreplaceall('U|taxcode^nummer', "-","X")
..
!INDEX
.. Not every line in a sales order might have a taxcode
.continue NOTAX   ? F|empty(U|xt)
..
.. Check if taxcode has been indexed    
.continue BEKANNT ? F|defined(U|taxindex.xt)
..
.. Assign index number to taxcode
.formula U|maxitax = U|maxitax + 1
.. Map name to index
.type integer taxindex.xt
.type RP3.2   taxrate.xt
.copy U|taxindex.xt = U|maxitax
.copy U|taxrate.xt = U|taxcode^psatz
..
!BEKANNT
.copy U|itax = U|taxindex.xt
.copy U|taxrate = U|taxrate.xt
.continue END
..
!NOTAX 
.formula U|itax = 0
.formula U|taxrate = 0.0
.continue END
..
..*****************************************************************************
!END
.continue

