..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EDICENTER.PRINT.BN
.. Datum          : 19.10.2007
.. Version        : 2008r0n00
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Button "Print" in der Zeile im Infosystem EDI(A)CENTER
..
.. each transaction type uses a different efop for "printing"
.. reference messages are shown using an infosystem
..
..
.. Program flow   :
...Includes       :
..  include dfue/DRUCK.LAB
..  include dfue/DRUCK.EKLAB
..  include dfue/DRUCK.FAB
..  include dfue/DRUCK.ORD
..  include dfue/DRUCK.RE
..  include dfue/DRUCK.REINV
..  include dfue/DRUCK.AB
..  include dfue/DRUCK.LS
..  include dfue/DRUCK.LSNEU
..  include dfue/DRUCK.EDL
..  include dfue/DRUCK.PRICAT
..  include dfue/DRUCK.GA
..  include dfue/DRUCK.XML
..*****************************************************************************
.set trans -
..
.type text xtkommando
..
.continue SHOWREF         ?  M|edinr^vorart = 0
..
.input DRUCKER            ? _G|edp
.input BLANKOB.F
.select edifact 'M|edinr^id'
.continue END     ? _G|mehr
.input "DRUCK.LAB"        ?  H|vorart =  3  &  H|sinhouse="500" & H|imex="IM"
.input "DRUCK.EKLAB"      ?  H|vorart =  3  &  H|sinhouse="500" & H|imex="EX"
.input "DRUCK.FAB"        ?  H|vorart =  3  &  H|sinhouse="800"
.input "DRUCK.ORD"        ?  H|vorart =  3  &  H|sinhouse="200"
.input "DRUCK.RE"         ?  H|vorart =  5  &  H|such ="VKREVA"
.input "DRUCK.REINV"      ?  H|vorart =  5  &  H|such<>"VKREVA"
.input "DRUCK.AB"         ?  H|vorart = 23
.input "DRUCK.LS"         ?  H|vorart = 25  &  H|such ="VKSPVA"
.input "DRUCK.LSNEU"      ?  H|vorart = 25  &  H|such<>"VKSPVA"
.input "DRUCK.EDL"        ?  H|vorart = 27
.input "DRUCK.PRICAT"     ?  H|vorart = 33
.input "DRUCK.GA"         ?  H|vorart = 55
.input "DRUCK.XML"        ?  H|datenart = "XML"
.continue END
..
!SHOWREF
.command -parallel 'F|formatstr("(Infosystem) EDIREF ? edinr={1} | bstart=", M|edinr^id)'
..*****************************************************************************
!END
.continue
