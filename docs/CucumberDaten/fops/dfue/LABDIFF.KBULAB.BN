..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LABDIFF.KBULAB.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Buttons zum Wechsel der Abrufe
.. Functionality  : Buttons to change forecasts
..*****************************************************************************
.set trans -
..
.type text xtselEDI  ? _F|defined(U|xtselEDI)
..
.. must have a value for M|klab
.input "dfue/LABDIFF.KRAHMEN.FA"  ?  F|empty(M|klab) & _F|empty(M|krahmen)
.continue END                         ?  F|empty(M|klab)
..
..
.. event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue KBULAB  ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbulab2"
.continue KBULAB  ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbulab1"
.continue LEER1   ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbulab1leer"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!LEER1
.formula M|klab1 = ""
.continue ENDHOL
..
..
!KBULAB: query for forecast matching primary forecast
.formula U|xtselEDI = F|formatstr("%,,;@gruppe=0;@autostart=(1);.vorart=3;.imex=IM;.edinachr={1};nummer=", M|klabedinachr)
.formula U|xtselEDI = U|xtselEDI + ";@ordnung=nummer.(Backwards)"
.formula U|xtselEDI = U|xtselEDI + ";erfass="    + 'M|klabhisvon:8' + "!" + 'M|klabhisbis:8'
.formula U|xtselEDI = U|xtselEDI + ";labruf="
.formula U|xtselEDI = U|xtselEDI + ";.ideksrah="  + M|krahmen^nummer
.formula U|xtselEDI = U|xtselEDI + ";.ideksart="  + M|kartikel^nummer    ? _F|empty(M|kartikel)
.formula U|xtselEDI = U|xtselEDI + ";.kuartnr="                          ? _F|empty(M|kartikel)
.formula U|xtselEDI = U|xtselEDI + ";ideksart="                          ?  F|empty(M|kartikel)
.formula U|xtselEDI = U|xtselEDI + ";kuartnr="  +M|klab^kuartnr          ?  F|empty(M|kartikel)
.formula U|xtselEDI = U|xtselEDI + ";.idkundeab="
.formula U|xtselEDI = U|xtselEDI + ";.werk="
.formula U|xtselEDI = U|xtselEDI + ";.ablstelle="
.formula U|xtselEDI = U|xtselEDI + ";@ablageart=(3)"                     ?  M|kbablage
..
.select edifact 'xtselEDI'
.continue ENDHOL  ? _G|mehr
.formula M|klab1 = H|id  ?  G|evtvar = "kbulab1"
.formula M|klab2 = H|id  ?  G|evtvar = "kbulab2"
..
..
!ENDHOL
.select -
..
.. refresh fields/table
.input "dfue/LABDIFF.LEEREN"
..
.. fill header fields
.input "dfue/LABDIFF.BK"
..
..*****************************************************************************
!END
.continue
