..
.type P109:2 xemAusfuhranmeldung
.assign U|xemAusfuhranmeldung="$,,;@gruppe=2;nummer==2115"
.type P109:2 xemExportDeclaration
.copy U|xemExportDeclaration = U|xemAusfuhranmeldung
..
.type P109:2 xemArtikelpreisliste
.assign U|xemArtikelpreisliste="$,,;@gruppe=2;nummer==2116"
.type P109:2 xemProductPriceList
.copy U|xemProductPriceList = U|xemArtikelpreisliste
..
..*****************************************************************************
!END
.continue
