..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIMESSAGE.CONST
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : dsch
.. Functionality  : Constants for filling edi messages fields without having
..                  to remember the numbers.
..
.. HOWTO
..
..  Examples use types as fields in edi message
..  .type P109:2 xedinachr
..  .type AZL20131 xedinachraz
..
..  Assign and compare using reference-type field
..  .copy U|xedinachr = U|xemForecastDeliverySchedule
..  .continue MATCH ? U|xedinachr^id = U|xemForecastDeliverySchedule^id
..
..  Assign and compare using enumeration-type field
..  .formula U|xedinachraz = U|xemForecastDeliverySchedule^id
..  .continue MATCH ? U|xedinachraz^id = U|xemForecastDeliverySchedule^id
..
..  Query all delivery forecast schedules
..  .select edifact 'F|formatstr("$,,;@gruppe=0;edinachr={1}", U|xemForecastDeliverySchedule^id)'
..
..  Query all to-be-processed jedi-enabled forecast schedules
..  .select edifact 'F|formatstr("$,,;@gruppe=0;edinachr={1};status=3;schema<>`", U|xemForecastDeliverySchedule^id)'
..
..  Query all to-be-processed non-jedi ("old") forecast schedules
..  .select edifact 'F|formatstr("$,,;@gruppe=0;edinachr={1};status=3;schema=`", U|xemForecastDeliverySchedule^id)'
..
..  Query all delivery forecast schedules -- without reference
..  Only needed if not checking if schema<>`
..  .select edifact 'F|formatstr("$,,;@gruppe=0;edinachr={1};vorart<>0", U|xemForecastDeliverySchedule^id)'
..
..*****************************************************************************
.set trans -
..
.continue END ? F|defined(U|xemLieferabruf)
..
.type P109:2 xemLieferabruf
.assign U|xemLieferabruf="$,,;@gruppe=2;nummer==2101"
.type P109:2 xemForecastDeliverySchedule
.copy U|xemForecastDeliverySchedule = U|xemLieferabruf
..
.type P109:2 xemFeinabruf
.assign U|xemFeinabruf="$,,;@gruppe=2;nummer==2102"
.type P109:2 xemJITDeliverySchedule
.copy U|xemJITDeliverySchedule = U|xemFeinabruf
..
.type P109:2 xemProduktionssynchronerAbruf
.assign U|xemProduktionssynchronerAbruf="$,,;@gruppe=2;nummer==2103"
.type P109:2 xemJISDeliverySchedule
.copy U|xemJISDeliverySchedule = U|xemProduktionssynchronerAbruf
..
.type P109:2 xemLadelistePUS
.assign U|xemLadelistePUS="$,,;@gruppe=2;nummer==2104"
.type P109:2 xemLoadingListPUS
.copy U|xemLoadingListPUS = U|xemLadelistePUS
..
.type P109:2 xemAuftrag
.assign U|xemAuftrag="$,,;@gruppe=2;nummer==2105"
.type P109:2 xemSalesOrder
.copy U|xemSalesOrder = U|xemAuftrag
..
.type P109:2 xemAuftragsaenderung
.assign U|xemAuftragsaenderung="$,,;@gruppe=2;nummer==2106"
.type P109:2 xemEditInSalesOrder
.copy U|xemEditInSalesOrder = U|xemAuftragsaenderung
..
.type P109:2 xemAuftragsbestaetigung
.assign U|xemAuftragsbestaetigung="$,,;@gruppe=2;nummer==2107"
.type P109:2 xemSalesOrderConfirmation
.copy U|xemSalesOrderConfirmation = U|xemAuftragsbestaetigung
..
.type P109:2 xemLieferschein
.assign U|xemLieferschein="$,,;@gruppe=2;nummer==2108"
.type P109:2 xemDeliveryNote
.copy U|xemDeliveryNote = U|xemLieferschein
..
.type P109:2 xemSpeditionsauftrag
.assign U|xemSpeditionsauftrag="$,,;@gruppe=2;nummer==2109"
.type P109:2 xemShippingOrder
.copy U|xemShippingOrder = U|xemSpeditionsauftrag
..
.type P109:2 xemEDLMeldung
.assign U|xemEDLMeldung="$,,;@gruppe=2;nummer==2110"
.type P109:2 xemESPMessage
.copy U|xemESPMessage = U|xemEDLMeldung
..
.type P109:2 xemRechnung
.assign U|xemRechnung="$,,;@gruppe=2;nummer==2111"
.type P109:2 xemInvoice
.copy U|xemInvoice = U|xemRechnung
..
.type P109:2 xemGutschrift
.assign U|xemGutschrift="$,,;@gruppe=2;nummer==2112"
.type P109:2 xemCreditNote
.copy U|xemCreditNote = U|xemGutschrift
..
.type P109:2 xemZahlungsavis
.assign U|xemZahlungsavis="$,,;@gruppe=2;nummer==2113"
