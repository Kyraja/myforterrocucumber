..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LABDIFF.BK
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Berichtskopf: Daten zu Abrufen, Rahmen und Artikel
.. Functionality  : report header: data to forecasts, blanket order, and product
..*****************************************************************************
.set trans -
..
.. Skipp forecast fields?
.continue ENDLAB  ?  F|empty(M|klab)
..
..
.. primary forecast (usually the new forecast)
.formula M|klabnummer = M|klab^labruf
.assign M|krahmen  = M|klab^ideksrah      ?  F|empty(M|krahmen)
.copy M|klabedinachr = M|klab^edinachr
..
.. customer
.assign M|kkunde = M|klab^idkundesab
.formula M|kwerk  = M|klab^werk
.formula M|kablstelle = M|klab^ablstelle
..
.. product
.assign M|kartikel = M|klab^ideksart
.formula M|kkuartnr = M|klab^kuartnr
.formula M|kdbestand = M|kartikel^dbestand
..
..
.. new forecast
.formula M|klab2nummer = M|klab2^labruf
.formula M|klab2datum  = M|klab2^labrufd
.formula M|klab2datum  = M|klab2^uebdat      ?  F|empty(M|klab2^labrufd)
.copy M|klab2edinachr = M|klab2^edinachr
..
.. cumulative quantities new forecast
.formula M|klab2einfzahl = M|klab2^einfzahl
.formula M|klab2lfzahl = M|klab2^lfzahl
.formula M|klab2fzdiff = M|klab2lfzahl  - M|klab2einfzahl
..
.. detail data new forecast
.formula M|klab2kdzeich    = M|klab2^kdzeich
.formula M|klab2ffgfzahl   = M|klab2^ffgfzahl
.formula M|klab2mfgfzahl   = M|klab2^mfgfzahl
.formula M|klab2mgneinheit = M|klab^mgneinheit
..
.. last delivery (as reported by customer in forecast)
.formula M|klab2erflein  = M|klab2^erflein
.formula M|klab2leinlida = M|klab2^leinlida
.formula M|klab2leinlief = M|klab2^leinlief
.formula M|klab2mgellief = M|klab2^mgellief
..
..
.. old forecast
.formula M|klab1nummer = M|klab1^labruf
.formula M|klab1datum  = M|klab1^labrufd
.formula M|klab1datum  = M|klab1^uebdat      ?  F|empty(M|klab1^labrufd)
.copy M|klab1edinachr = M|klab1^edinachr
..
.. cumulative quantities old forecast
.formula M|klab1einfzahl = M|klab1^einfzahl
.formula M|klab1lfzahl = M|klab1^lfzahl
.formula M|klab1fzdiff = M|klab1lfzahl  - M|klab1einfzahl
..
!ENDLAB
..
..
.. blanket order
.formula M|kverwschl = M|krahmen^verwschl
.formula M|kabbenr   = M|krahmen^abschlnr
.formula M|krahmenpos = ""
.formula M|krahlfzahl = 0.0
.formula M|krahfzdiff = 0.0
.. read blanket order row for current cumulative quantity of product
.type text xtselRAH ? _F|defined(U|xtselRAH)
.formula U|xtselRAH = "$,,;@gruppe=2;kopf=" + M|krahmen^id + ";artikel=" + M|kartikel^id
.load 1 sales 'U|xtselRAH'
.continue ENDRAH  ? _G|mehr
.formula M|krahmenpos = 1|id
.formula M|krahlfzahl = 1|fzahl
.formula M|krahfzdiff = M|krahlfzahl - M|klab2einfzahl
.. Early warning system
.formula M|kediffzeitraum = 1|zefzdiff
.formula M|kediffprozent = 1|fzdiff
.formula M|kfwdiff = 0.0
.load 1
!ENDRAH
..
..*****************************************************************************
!END
.continue
