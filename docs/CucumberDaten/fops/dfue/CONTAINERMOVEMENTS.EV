.set trans -
..
.type text xtm1 xtm2 xtm3 xtm4 xtm5 xtm6 xtm7 xtm8 xtm9 xtm10 xtm11 xtm12 
.type text xtihm1 xtihm2 xtihm3 xtihm4 xtihm5 xtihm6 xtihm7 xtihm8 xtihm9 xtihm10 xtihm11 xtihm12
.type ARTR52000 xtabestandm1 xtabestandm2 xtabestandm3 xtabestandm4 xtabestandm5 xtabestandm6
.type ARTR52000 xtabestandinternm1 xtabestandinternm2 xtabestandinternm3 xtabestandinternm4 xtabestandinternm5 xtabestandinternm6
.type ARTR52000 xtabestandm7 xtabestandm8 xtabestandm9 xtabestandm10 xtabestandm11 xtabestandm12
.type ARTR52000 xtabestandinternm7 xtabestandinternm8 xtabestandinternm9 xtabestandinternm10 xtabestandinternm11 xtabestandinternm12
.type ARTR52000 xtzm1 xtzm2 xtzm3 xtzm4 xtzm5 xtzm6 xtzm7 xtzm8 xtzm9 xtzm10 xtzm11 xtzm12
.type ARTR52000 xtzinternm1 xtzinternm2 xtzinternm3 xtzinternm4 xtzinternm5 xtzinternm6 xtzinternm7 xtzinternm8 xtzinternm9 xtzinternm10 xtzinternm11 xtzinternm12
.type ARTR52000 xtam1 xtam2 xtam3 xtam4 xtam5 xtam6 xtam7 xtam8 xtam9 xtam10 xtam11 xtam12
.type ARTR52000 xtainternm1 xtainternm2 xtainternm3 xtainternm4 xtainternm5 xtainternm6 xtainternm7 xtainternm8 xtainternm9 xtainternm10 xtainternm11 xtainternm12
.type ARTR52000 xtebestandm1 xtebestandm2 xtebestandm3 xtebestandm4 xtebestandm5 xtebestandm6
.type ARTR52000 xtebestandinternm1 xtebestandinternm2 xtebestandinternm3 xtebestandinternm4 xtebestandinternm5 xtebestandinternm6
.type ARTR52000 xtebestandm7 xtebestandm8 xtebestandm9 xtebestandm10 xtebestandm11 xtebestandm12
.type ARTR52000 xtebestandinternm7 xtebestandinternm8 xtebestandinternm9 xtebestandinternm10 xtebestandinternm11 xtebestandinternm12
.type ARTR52000 xtendbestand xtvortrag
.type ARTR52000 xtendbestandintern xtvortragintern
.type ARTR52100 xtsz xtsa xtszintern xtsaintern
.type text xsel
.type integer xjahr
.type real xumlaufbestand 
..
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = "GP"              ?  F|equals(M|ktofuehr, "(Internal)")
.formula P|maskkontextfop = "Intern"          ?  F|equals(M|ktofuehr, "(BusinessPartner)")
.formula P|maskkontextfop = ""                ?  F|empty(M|artikel) ; F|empty(M|ktofuehr)
.formula P|maskkontextfop = "kobe"            ? _F|empty(M|artikel) & _F|empty(M|ktofuehr) & F|empty(M|behaelterkonto)
..
.protection -reset behaelterkonto
.protection -reset artikel
.protection -reset kreislauf
.protection -reset ktofuehr
.protection -reset kpartner
..
.formula U|xumlaufbestand = 0
.formula U|xjahr = F|year(G|datum)
.formula U|xjahr = 'U|xjahr' >> 2
.continue GJAHR     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "gjahr"
.continue KREISLAUF ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kreislauf"
.continue BUARTIKEL ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buartikel"
.continue ARTIKEL   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "artikel"
.continue BKONTO    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "behaelterkonto"
.continue BSTART    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue KWERK     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kwerk"
.continue KTOFUEHR  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ktofuehr"
.continue TABLEEREN
..
!KTOFUEHR
.formula P|maskkontextfop = ""                ?  F|empty(M|ktofuehr) ;  F|empty(M|artikel)
.continue KOPFLEEREN ? F|empty(M|ktofuehr)
.formula P|maskkontextfop = "GP"              ?  F|equals(M|ktofuehr, "(Internal)")
.formula P|maskkontextfop = "Intern"          ?  F|equals(M|ktofuehr, "(BusinessPartner)")
.formula P|maskkontextfop = ""                ?  F|empty(M|artikel)
.formula P|maskkontextfop = ""                ?  F|empty(M|ktofuehr)
.formula M|kwerkbez       = ""
.protection kwerkbez
.continue KOPFLEEREN
..
!KWERK
.continue KOPFLEEREN ? F|empty(M|kwerk)
.formula M|kwerkbez = M|behaelterkonto^werkname
.continue TABLEEREN
..
!GJAHR: wenn leer dann mit aktuellem Gesch„ftsjahr vorbelegen
.formula M|gjahr = F|currentfy()  ? F|empty(M|gjahr)
.formula M|umlaufbestand = 0      
.continue KOPFLEEREN
..
!KREISLAUF
.continue KOPFLEEREN ? F|empty(M|kreislauf)
.formula M|behaelterkonto = ""
.formula M|kwerkbez       = ""
.protection behaelterkonto                            
.continue KOPFLEEREN
..
!BUARTIKEL
.formula U|xsel = "%,,nummer=;such=;packmit=ja;vpkenn=(ReturnablePackaging);@gruppe=1;@ablageart=lebendig"
.load 1 parts 'U|xsel'
.formula M|artikel = ""  ? _G|mehr
.continue END            ? _G|mehr
.formula M|artikel = 1|id
.assign M|leartikel = 1|le
.assign M|dbestand = 1|dbestand
.formula M|datum = G|datum
..
!ARTIKEL: nur wenn packmit = TRUE und vpkenn = Mehrwegverpackung
.formula P|maskkontextfop = ""  ?  F|empty(M|artikel)
.continue KOPFLEEREN    ?  F|empty(M|artikel)
.continue ERROR1        ? _M|artikel^packmit
.continue ERROR2        ? _F|equals(M|artikel^vpkenn, "(ReturnablePackaging)")
.formula M|leartikel = M|artikel^le
.formula M|dbestand  = M|artikel^dbestand
.formula M|leartikel = M|artikel^le
.formula M|datum     = G|datum
.continue KOPFLEEREN
..
!BKONTO
.formula P|maskkontextfop = ""       ?  F|empty(M|behaelterkonto)
.formula M|kpartner = ""             ?  F|empty(M|behaelterkonto)
.formula M|kwerk = ""                ?  F|empty(M|behaelterkonto)
.formula M|ktobestand = 0            ?  F|empty(M|behaelterkonto)
.formula M|ktostandort = ""          ?  F|empty(M|behaelterkonto)
.protection -reset kwerk             ?  F|empty(M|behaelterkonto)
.protection -reset kpartner          ?  F|empty(M|behaelterkonto)
.continue KOPFLEEREN                 ?  F|empty(M|behaelterkonto)
.formula M|umlaufbestand  = 0
.formula M|kreislauf      = ""
.protection kreislauf
.assign M|artikel         = M|behaelterkonto^artikel
.assign M|leartikel       = M|behaelterkonto^artikel^le
.formula M|dbestand       = M|behaelterkonto^artikel^dbestand
.formula M|ktofuehr       = M|behaelterkonto^ktofuehr
.formula M|ktobestand     = M|behaelterkonto^bestand
.formula M|ktostandort = M|behaelterkonto^standort
.formula P|maskkontextfop = ""
.formula P|maskkontextfop = "GP"     ? F|equals(M|ktofuehr, "(Internal)")
.formula P|maskkontextfop = "Intern" ? F|equals(M|ktofuehr, "(BusinessPartner)")
.formula M|datum          = G|datum
.assign M|kpartner        = M|behaelterkonto^partner
.formula M|kwerk          = M|behaelterkonto^werk
.formula M|kwerkbez       = M|behaelterkonto^werkname
.protection kpartner
.protection kwerk
.continue KOPFLEEREN
..
!KOPFLEEREN
