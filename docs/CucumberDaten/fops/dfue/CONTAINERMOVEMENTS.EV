..
.formula M|select = "$,,"
.formula M|select = M|select + ";@gruppe=1"                              ?  F|empty(M|kreislauf)
.formula M|select = M|select + ";twerk="+M|kwerk+";@gruppe=2;@zeilen=ja" ? _F|empty(M|kreislauf) & _F|empty(M|kwerk)
.formula M|select = M|select + ";@gruppe=2;@zeilen=ja"                   ? _F|empty(M|kreislauf)
.continue SELBKONTO                                    ?  F|empty(M|kreislauf)
.continue SELKREISLAUF                                 ? _F|empty(M|kreislauf)
..
!SELBKONTO
.formula M|select = M|select + ";id=" + M|behaelterkonto^id  ? _F|empty(M|behaelterkonto)
.formula M|select = M|select + ";artikel=" + M|artikel^id
.formula M|select = M|select + ";werk=" + M|kwerk
.formula M|select = M|select + ";partner=" + M|kpartner
.formula M|select = M|select + ";ktofuehr="+M|ktofuehr 
.continue SELECT
..
!SELKREISLAUF
.formula M|select = M|select + ";id=" + M|kreislauf^id
.continue SELECT
..
!SELECT
.select containeraccount 'M|select' 
.continue BFUSS                   ? _G|mehr
.select line 'H|selzeile'         ? _F|empty(M|kreislauf)
.continue BFUSS                   ? _G|mehr  & _F|empty(M|kreislauf)
.formula M|umlaufbestand = 0
.continue TAB
..
!TAB
.input 'M|tab'        ? _F|empty(M|tab)
.continue BFUSS       ? _F|empty(M|kreislauf) & _F|empty(M|kwerk)
.select line          ? _F|empty(M|kreislauf)
.select continue      ?  F|empty(M|kreislauf)
.continue BFUSS       ? _G|mehr
.continue TAB
..
!BFUSS
.input 'M|bfuss'   ? _F|empty(M|bfuss)
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR1
.error -field M|artikel -message Artikel ist kein Packmittel!
.formula M|artikel = ""
.end 1
..
!ERROR2
.error -field M|artikel -message Packmittel ist keine Mehrwegverpackung!
.formula M|artikel = ""
.end 1
