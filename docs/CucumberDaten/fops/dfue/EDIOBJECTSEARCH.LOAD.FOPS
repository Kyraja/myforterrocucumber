..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.LOAD.FOPS
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Functionality  : Load FO programs from configuration
..*****************************************************************************
..
.set trans -
..
.type text foprogramm ? _F|defined(U|foprogramm)
.type integer xi      ? _F|defined(U|xi)
.type integer xt      ? _F|defined(U|xt)
..
.formula U|xi = 1
.formula U|xt = 11
..
!NEXT
.load 6 line
.continue END     ? _G|mehr
.continue NOSPACE ? U|xi > 10 ; U|xt > 15
.continue TABLE   ?  6|vkt &  M|tabausf
.continue NEXT    ?  6|vkt & _M|tabausf
.continue HEAD    ? _6|vkt

!HEAD
.select screen header
.formula M|fop.xi = '6|fopname'
.formula U|xi = U|xi + 1
.continue NEXT

!TABLE
.select screen line
..
!FILL
.continue NEXT ? _G|mehr
.formula M|fop.xt = '6|fopname'
.select screen line
.continue FILL ? G|mehr
.formula U|xt = U|xt + 1
.continue NEXT

..*****************************************************************************
!END
.continue
..
..
!NOSPACE
.error Zum Anzeigen der Such-FOPs steht nur eine begrenzte Anzahl Felder zur VerfÅgung
.continue
