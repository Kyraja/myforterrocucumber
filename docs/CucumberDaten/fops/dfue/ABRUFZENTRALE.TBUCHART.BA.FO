..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ABRUFZENTRALE.TBUCHART.BA.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : draw single chart for info system ABRUFZENTRALE
..*****************************************************************************
..<META M|='dfue/ABRUFZENTRALE' >
.set trans -
..
.. Do not draw for edp
.continue END  ?  G|edp
..
.. Anything to do?
.continue END  ?  F|empty(M|tbuchartz)
..
.. Remove old chart
.chart -INIT
.chart -SHOW kchart 0
..
.. Highlight row shown in diagramm
.colour -foreground -1 -1 -1  -background -1 -1 -1  'M|kchartzeile'  ?  M|kchartzeile <> 0
.colour -foreground -1 -1 -1  -background 'M|kchartzeilefarbe'  'M|aktzeile'
.formula M|kchartzeile = M|aktzeile
..
.. Translate texts
.type text xvorher  ? _F|defined(U|xvorher)
.type text xspaeter ? _F|defined(U|xspaeter)
.type text  xLieferung ? _F|defined(U|xLieferung)
.set trans +
.formula U|xvorher = "Vorher"
.formula U|xspaeter = "Sp„ter"
.formula U|xLieferung = "Geliefert"
.set trans -
..
.. Chart marking
.type text xMarker  ? _F|defined(U|xMarker)
.type integer   xicolor    ? _F|defined(U|xicolor)
..
.. Counter
.type integer  xiedi      ? _F|defined(U|xiedi)
..
..
..  Event evaluation
.. ----------- ----- BUTTON / CHECK BOX ----------------------------------------
.continue DAYS    ?  M|kbtage
.continue WEEKS   ?  M|kbwochen
.continue MONTHS  ?  M|kbmonate
.continue DELIVER ?  M|kblieferungen
.. ----------- ----- ------ ------ ---- ----------------------------------------
.continue END
..
..
..
.. ----------- ----- ------ ------ ---- ----------------------------------------
!DAYS
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -3D YES
.chart -PARAM -MINMAXY
.chart -PARAM -TOOLBAR NONE
.. .chart -PARAM -MINMAXY  "0.0" 'U|xrmax'
..
.formula U|xMarker = ""
.formula U|xMarker = U|xMarker + U|xvorher + ";" ? M|kbzeigevor
.formula U|xMarker = U|xMarker + 'M|ktexttag1' + ";" + 'M|ktexttag2' + ";" + 'M|ktexttag3' + ";" + 'M|ktexttag4' + ";" + 'M|ktexttag5'
.formula U|xMarker = U|xMarker + ";" + U|xspaeter  ? M|kbzeigenach
.chart -PARAM -MARKERX 'U|xMarker'
..
.continue DRAW ? F|empty(M|tedi0)
.formula U|xicolor = 1
.chart -STARTVALUES 'M|tedi0^nummer' -COLOR 'U|xicolor'
.chart -VALUE 'M|tedi0tmge0' ? M|kbzeigevor
.chart -VALUE 'M|tedi0tmge1'
.chart -VALUE 'M|tedi0tmge2'
.chart -VALUE 'M|tedi0tmge3'
.chart -VALUE 'M|tedi0tmge4'
.chart -VALUE 'M|tedi0tmge5'
.chart -VALUE 'M|tedi0tmge6' ? M|kbzeigenach
..
