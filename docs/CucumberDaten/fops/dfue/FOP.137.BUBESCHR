..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FOP.137.BUBESCHR
.. Datum          : 03.06.1998
.. Version        :
.. Autor          : ok/mh + alltrotec© GmbH, Matthias Schrîder
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : öbertragen der Feldbezeichner fÅr EDI-Nachrichten
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : EFOP fÅr Maske 137 (EDI-Nachricht), <zeigen>, <Ñndern>
..
.. Functionality  : Definition of lables for reference record "VKEDL"
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   :
...Includes       :
..  include dfue/LAB.IHSSMES
..  include dfue/GA.IHSSMES
..  include dfue/ORD.IHSSMES
..  include dfue/DESADV.IHSSMES
..  include dfue/INV.IHSSMES
..  include dfue/VKRE.IHSSMES
..  include dfue/VKLS.IHSSMES
..  include dfue/DESADV.IHSSMES
..  include dfue/PRICAT.IHSSMES
..  include dfue/AB.IHSSMES
..  include dfue/EKLAB.IHSSMES
..*****************************************************************************
.type text xtaendern
.formula T|xtaendern = "Ñndern"
.set trans -
..
.. must be in update-mode
.continue ERRZEIG ?  T|evtkommd <> T|xtaendern
..
.. field index / fieldname
.type integer  xi
.type text xti
.type text xtfname
..
.select screen header
.continue END     ? _T|mehr
.continue NEXT    ?  M|such / "R-*"
..
.. read inhouse description: labels are stored in buffer T
.input "LAB.IHSSMES"      ?  M|such = "VKAUV"
.input "GA.IHSSMES"       ?  M|such = "VKGAV"
.input "ORD.IHSSMES"      ?  M|such = "VKAUE"
.input "DESADV.IHSSMES"   ?  M|such = "VKEDL"
.input "INV.IHSSMES"      ?  M|such = "VKREEA"
.input "VKRE.IHSSMES"     ?  M|such = "VKREVA"
.input "VKLS.IHSSMES"     ?  M|such = "VKSPVA"
.input "DESADV.IHSSMES"   ?  M|such = "VKDESADV"
.input "PRICAT.IHSSMES"   ?  M|such = "VKPRICAT"
.input "AB.IHSSMES"       ?  M|such = "VKORDRSP"
.input "EKLAB.IHSSMES"    ?  M|such = "EKLAB"
..
!NEXT: read next row for adding labels
.select screen line
.continue END     ? _T|mehr
.continue REF     ?  M|such / "R-*"
..
.formula T|xi = 1
!LOOP: there are up to 25 fields for each row (indexed by xi)
.continue NEXT    ?  T|xi = 26
.. ihssmes labels: T|."xtb" + 'record type' + 'field index'
..  alert: leading zero on 1-digit field index, i.e. 01 instead of 1
.formula T|xti = 'T|xi'
.formula T|xti = "0" + 'T|xi'                        ?  T|xi < 10
.formula T|xtfname = "xtb" + 'M|text1' + 'T|xti'
.formula M|tbes.xi = T|.xtfname                      ?  F|defined(T|.xtfname)
.formula T|xi = T|xi + 1
.continue LOOP
..
!REF: labels for reference record itself
.set trans +
.formula M|tbes1 = "Satzart"
.formula M|tbes2 = "Position in Nachricht    ( K opf/ V org.-B./ D aten/ S chlu·)"
.formula M|tbes3 = "Erfordernis in Nachricht ( M ust/ C an)"
.formula M|tbes4 = "HÑufigkeit in Nachricht  (Anzahl/ R epeatable - beliebig oft)"
.formula M|tbes5 = "ZulÑssige erforderliche  M ust-SÑtze vor Satzart"
.formula M|tbes6 = "ZulÑssige mîgliche       M ust- / C an-SÑtze vor Satzart"
.formula M|tbes7 = "Erfordernisse der Parameter ( M ust/ C an/ L eer)"
.formula M|tbes8 = "Formate der Parameter ( A lfa[ N umerisch]/ N umerisch/ D atum)"
.formula M|tbes9 = "Namen der Kopfvariablen fÅr öbernahme von Parametern in EDI-Kopf"
.set trans -
.continue NEXT
..*****************************************************************************
!END
.continue
..
..
!ERRZEIG
.error Diese Funktion ist nur im éndern-Modus mîglich!
.end 1
