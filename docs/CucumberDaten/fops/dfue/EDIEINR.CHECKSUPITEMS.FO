..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIEINR.CHECKSUPITEMS.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Checks supplementary items used for edi / automotive
..
...I-Files (must not be included)
..  dfue/DFUE.EXP.INI   
..*****************************************************************************
.set trans -
..
.. Return values for efop CHECKSUPITEMS
.type bool xsupactive  ? _F|defined(U|xsupactive)
..
.. Default return value
.copy U|xsupactive = G|false
..
.type text U|xSwVersand ? _F|defined(U|xSwVersand)
.type text U|xSwVerpackung ? _F|defined(U|xSwVerpackung)
.type text U|xIDBeipack ? _F|defined(U|xIDBeipack)
..
.input "dfue/DFUE.EXP.INI"
..
.. Special settings in INI with SWD*-naming
.. Cut trailing * with >> -1
..
.formula U|xSwVersand = U|xSwVersand >> -1
.select parts 'F|formatstr("$,,;@gruppe=4;such={1}",U|xSwVersand)'
.copy U|xsupactive = G|mehr
.continue END ? _G|mehr
..
.formula U|xSwVerpackung = U|xSwVerpackung >> -1
.select parts 'F|formatstr("$,,;@gruppe=4;such={1}",U|xSwVerpackung)'
.copy U|xsupactive = G|mehr
.continue END ? _G|mehr
..
.formula U|xIDBeipack = U|xIDBeipack >> -1
.select parts 'F|formatstr("$,,;@gruppe=4;such={1}",U|xIDBeipack)'
.copy U|xsupactive = G|mehr
.continue END ? _G|mehr
..
.select -
..
..*****************************************************************************
!END
.continue
