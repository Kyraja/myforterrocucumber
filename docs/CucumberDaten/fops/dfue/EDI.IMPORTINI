..!interpreter english
..@@BEGINHEAD
..========================================================================
..==
..==  Name              : EDI.IMPORTINI
..==
..==  Pfad              : dfue
..==
..==  Funktion          : Initialisierung fÅr Import
..==
..==  Erstellungsdatum  : 21.10.2002
..==
..==  Autor             : Ozan Kesim
..==
..==  Verantwortlich    : mh
..==
..==  notwendige Pfade  : dfue, dfue1, dfue2
..==
..==  Menuepunkte       :
..==
..==  Maskenprioritaet
..==  bei EFOP          :
..==
..==  Besonderheiten    : - PrÅfprogramm fÅr EDI-Import
..==
..==  Aenderungshistorie:
..#KOR#EDI-MODUL#DATUM#éNDERUNGS-INDEX#MitarbeiterkÅrzel#
..#KOR#IMP#21.10.2002#0#ok#
..==
..========================================================================
..@@ENDHEAD
..
.input ARB
..
.. variable definitions
..@@BEGINVARDEFS
..====================================================
.set trans +
..... procedure stack pointer .....
.type integer   xprocsp
..====================================================
..@@ENDVARDEFS
..
.. alle variablen mÅssen definiert sein, sonst bricht das programm ab
.set demand -
..
.. ----------------------------------------
.continue EPROCDEF
.. procedure definitions
.. Prozedur: EKSTestVerzeichnisZugriff
..
!PROC001: ----- EKSTestVerzeichnisZugriff -----
..>> Test, ob Verzeichnis existiert und Zugriff mîglich,
..>> Anlegen, wenn nicht existent
..>>
..>> Parameter:
..>>
..>> Ein: - Name des Verzeichnisses (xnverzact)
..>>      - Schalter fÅr Verzeichnistest (xtestverz: "w"ritable / "r"eadable)
..>>
..>> Aus: - Erfolg der Operation (xprocreturn)
..>>
..>> Interne Variablen: - xsybefehl
..>>
..
..>> kein Erfolg der Operation
.formula xprocreturn = false
..
.. >> Ermitteln Zugriffsmîglichkeit auf Verzeichnis
..>> Test, ob Verzeichnis existiert
.formula xsybefehl = "test -d " + xnverzact
.system 'xsybefehl' background
..
..
.continue EL001 ? _(mehr)
.. IF001
..>> Test, ob Verzeichnis lesbar / beschreibbar ist
.formula xsybefehl = "test -" + xtestverz + " " + xnverzact
.system 'xsybefehl' background
..>> Setzen Ergebnis der Operation
.formula xprocreturn = mehr
..
.continue FI001
!EL001
..>> Test, ob Schreibbarkeits-Test
..
..
.continue EL002 ? _(xtestverz = "w")
.. IF002
..>> Test, ob noch keine Datei unter Verzeichnis-Namen existiert
.formula xsybefehl = "test -f " + xnverzact
.system 'xsybefehl' background
..
..
.continue EL003 ? _(_(mehr))
.. IF003
..>>  Anlegen Verzeichnis
.formula xsybefehl = "mkdir " + xnverzact
.system 'xsybefehl' background
..
..>> Test, ob Verzeichnis angelegt und beschreibbar
.formula xsybefehl = "test -w " + xnverzact + " -a -d " + xnverzact
.system 'xsybefehl' background
..>> Setzen Ergebnis der Operation
.formula xprocreturn = mehr
..
!EL003
.. FI003
..
!EL002
.. FI002
..
!FI001
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSTestDateiZugriff
..
!PROC002: ----- EKSTestDateiZugriff -----
..>> Test, ob Zugriff auf Datei mîglich
..>>
..>> Parameter:
..>>
..>> Ein: - Name des Verzeichnisses (xnfileact)
..>>      - Schalter fÅr Dateitest (xtestfile: "w"ritable / "r"eadable)
..>>
..>> Aus: - Erfolg der Operation (xprocreturn)
..>>
..>> Interne Variablen: - xsybefehl
..>>
..
..>> kein Erfolg der Operation
.formula xprocreturn = false
..
.. >> Ermitteln Zugriffsmîglichkeit auf Datei
..>> Test, ob Datei existiert
.formula xsybefehl = "test -f " + xnfileact
.system 'xsybefehl' background
..
..
.continue EL004 ? _(mehr)
.. IF004
..>> Test, ob Datei lesbar / beschreibbar ist
.formula xsybefehl = "test -" + xtestfile + " " + xnfileact
.system 'xsybefehl' background
..>> Setzen Ergebnis der Operation
.formula xprocreturn = mehr
..
.continue FI004
!EL004
..>> Test, ob Schreibbarkeits-Test
..
..
.continue EL005 ? _(xtestfile = "w")
.. IF005
..>> Test, ob noch kein Verzeichnis unter Datei-Namen existiert
.formula xsybefehl = "test -d " + xnfileact
.system 'xsybefehl' background
..
..
.continue EL006 ? _(_(mehr))
.. IF006
..>> Anlegen Datei
.formula xsybefehl = "touch " + xnfileact
.system 'xsybefehl' background
..
..>> Test, ob Datei angelegt und beschreibbar
.formula xsybefehl = "test -w " + xnfileact + " -a -f " + xnfileact
.system 'xsybefehl' background
..>> Setzen Ergebnis der Operation
.formula xprocreturn = mehr
..
..>> Lîschen Datei
.formula xsybefehl = "rm -f " + xnfileact + " 1> ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
..
!EL006
.. FI006
..
!EL005
.. FI005
..
!FI004
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSTestPostEmpfaenger
..
!PROC003: ----- EKSTestPostEmpfaenger -----
..>> Test, ob EKS-PostempfÑnger verfÅgbar
..>>
..>> Parameter:
..>>
..>> Ein: - Name des ABAS-PostempfÑngers (xPostEmpf)
..>>
..>> Aus: - Erfolg der Operation (xprocreturn)
..>>
..>> Interne Variablen: - xfobefehl
..>>
..
..>> kein Erfolg der Operation
.formula xprocreturn = false
..
.. >> Ermitteln Zugriffsmîglichkeit auf ABAS-PostempfÑnger
..>> Test, ob Identnummer Åbergeben
..
..
.continue EL007 ? _((xPostEmpf << 1) / "(0-9)")
.. IF007
..>> Testergebnis positiv: Test Identnummer
.formula xfobefehl = xSELPOBVId + ",num16=" + xPostEmpf + "!" + xPostEmpf
..
.continue FI007
!EL007
..>> Testergebnis negativ: Test Suchwort
.formula xfobefehl = xSELPOBVId + ",such16=" + xPostEmpf + "!" + xPostEmpf
..
!FI007
..
.. abas, JUN 2017: abas Post has been discontinued
.copy U|xprocreturn = G|true
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSTestDrucker
..
!PROC004: ----- EKSTestDrucker -----
..>> Test, ob ABAS-Drucker verfÅgbar
..>>
..>> Parameter:
..>>
..>> Ein: - Name / Nummer des ABAS-Druckers (xProtDrucker)
..>>
..>> Aus: - Erfolg der Operation (xprocreturn)
..>>
..>> Interne Variablen: - xfobefehl
..>>
..
..>> kein Erfolg der Operation
.formula xprocreturn = false
..
..>> Ermitteln Zugriffsmîglichkeit auf ABAS-Drucker
.formula xfobefehl = xProtDrucker
..>> Ermitteln ABAS-Drucker-Nummer, wenn ABAS-System-Drucker-Name eingetragen
.formula xfobefehl = xfobefehl << -1 ? _((xfobefehl << 1) / "(0-9)*")
..>> Test, ob ABAS-System-Drucker-Nummer zulÑssig
.formula xzaehl1 = xfobefehl
..>> Setzen Ergebnis der Operation
.formula xprocreturn = (xzaehl1 > 0) & (xzaehl1 <= xs92dranz)
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: EKSHoleMandantInfos
..
!PROC005: ----- EKSHoleMandantInfos -----
..>> Ermitteln Informationen Åber aktuellen ABAS-Mandanten
..>>
..>> Parameter:
..>>
..>> Ein: -
..>>
..>> Aus: - Erfolg Operation (xprocreturn)
..>>      - ABAS-Umgebungsvariable "MANDANT" (xeksmname)
..>>      - ABAS-Umgebungsvariable "MANDANTDIR" (xeksmandantdir)
..>>     (- ABAS-Umgebungsvariable "PATH" (xekspath))
..>>     (- ABAS-Umgebungsvariable "TMP" (xtmpdir))
..>>
..>> Interne Variablen: - xsybefehl
..>>                    - xntemp
..>>
..
..>> kein Erfolg der Operation
.formula xprocreturn = false
..
.. >> Ermitteln Name, Verzeichnis des ABAS-Mandanten und PATH
.formula xntemp = "XVKAUV" + panummer + ".TMP"
..
.formula xsybefehl = "echo $MNAME# > " + xntemp + " ; echo $MANDANTDIR# >> " + xntemp + " ; echo $TMP# >> " + xntemp
.system 'xsybefehl'
..
..>> erst aus zweiter Zeile holbar, obwohl in erster Zeile ???!!!
.select from
.. >> Mandantenname
.select from 'xntemp' xeksmname #
..>> Test, ob Mandantenname geholt
..
..
.continue EL008 ? _(mehr)
.. IF008
..>> Mandantenverzeichnis
.select from 'xntemp' xeksmandantdir #
..
..
.continue EL009 ? _(mehr)
.. IF009
..>> TMP-Verzeichnis
.select from 'xntemp' xtmpdir #
..
!EL009
.. FI009
..
!EL008
.. FI008
..
..>> Test, ob Informationen aus temporÑrer Datei gelesen und nicht leer
.formula xprocreturn = mehr & (((xeksmname >> "") << "") <> "") & (((xeksmandantdir >> "") << "") <> "")
..>> Listenausgabe auf absoluten Pfad nicht mîglich
.formula xtmpdir = ""
..
.formula xsybefehl = "rm -f " + xntemp + " 1> ${DEVNULL:-/dev/null} 2>&1"
.system 'xsybefehl' background
..
.continue 'xprocst.xprocsp'
..
.. Prozedur: FEHLER
..
!PROC006: ----- FEHLER -----
.output addedto 'xnfprotokollerw'
.length 1
.right 299
.tablerecord
..
_______________________________________________________________________________
..
'xftext1'

'xftext2'
'xftext3'
..
.output new WERF.WEG
..
.formula xistfproterw = true
..
.continue 'xprocst.xprocsp'
..
!EPROCDEF: ----- end procedure definitions -----
.. ----------------------------------------
..
..**ok,07.01.2003 (Aufruf "DFUE.IMP.INI" hier NEU)
.input "dfue/DFUE.IMP.INI"
..
..>> Name der Fehler-Protokoll-Datei Erweiterung
.formula xnfprotokollerw = "XIAV.IMP.F" + 'panummer' + ".TMP"
..
.menu Auswahl der PrÅfungen
Nur EDI-Import                >>
EDI-Import + Abrufe (LAB/FAB) >>
EDI-Import + Auftrag (ORDERS) >>
EDI-Import + Gutschrift       >>
?Abbruch                      >> .end  ? _grafik
..
.. Fehlercodes
..>> Fehlercodes:       - 1000 -> EKS-Mandant
..>>                    - 1001 -> EKS-LGP
..>>                    - 1002 -> EKS-Lader
..>>                    - 1003 -> Shell-Scripts
..>>                    - 1004 -> System-Programme (Binary's)
..>>                    - 1005 -> SuchschlÅssel / Selektionsleisten
..>>                    - 1006 -> EKS-EDI-Referenzdatensatz
..>>                    - 1007 -> EKS-Bearbeiter BATCH
..>>                    - 1008 -> Parameter EKS-Passwort aktueller EKS-Bearbeiter
..>>                    - 1009 -> Verzeichnis- und Datei-Zugriffsrechte aktueller EKS-Bearbeiter
..>>                    - 1010 -> EKS-PostempfÑnger
..>>                    - 1011 -> EKS-Drucker
..
.. >> Ermitteln Informationen Åber aktuellen ABAS-Mandanten
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET001"
.continue PROC005
!RET001
.formula xprocsp = xprocsp - 1
..
..
.continue EL010 ? _(_(xprocreturn))
.. IF010
.formula xftext1 = "Fehler: 1001 - Installationsfehler"
.formula xftext2 = "Mandanten-Informationen kînnen nicht ermittelt werden"
.formula xftext3 = ""
..
.formula xprocsp = xprocsp + 1
.type text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formula xprocst.xprocsp = "RET002"
.continue PROC006
!RET002
.formula xprocsp = xprocsp - 1
