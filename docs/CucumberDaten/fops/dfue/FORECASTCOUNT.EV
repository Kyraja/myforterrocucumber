..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FORECASTCOUNT.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Functionality  : Common Events
..*****************************************************************************
.set trans -
..
..
..  Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue TABINIT ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kdatumvon"
.continue TABINIT ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kdatumbis"
.continue KUNDE   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kkunde"
.continue ARTIKEL ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kartikel"
.continue BOOL1   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbzaehlen"
.continue BOOL2   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbfehler"
.continue BOOL2   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbfruehwarnung"
.continue BOOL2   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbrueckstand"
.continue BOOL2   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbsofortbedarf"
.continue SELEDI  ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbselaznachricht"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!KUNDE
.formula M|kkundebez = M|kkunde^sucherw
.continue TABINIT
..
!ARTIKEL
.formula M|kartikelbez = M|kartikel^sucherw
.continue TABINIT
..
!BOOL1
.. Toggle between general count and counting edi-processing errors
.. Default other single-problem-counts to off
.copy M|kbfehler = _M|kbzaehlen
.copy M|kbfruehwarnung = G|false
.copy M|kbrueckstand = G|false
.copy M|kbsofortbedarf = G|false
.continue TABINIT
..
!BOOL2
.. Default to general count if single-problem-counts are all unchecked
.copy M|kbzaehlen = _( M|kbfehler ; M|kbfruehwarnung ; M|kbrueckstand ; M|kbsofortbedarf )
.continue TABINIT
..
!SELEDI
.. Show switch for query "old" or "new" message types
.. Show checkbox, after first time it has been "reset" to using "Old" message type
.. Default ist "new" messages, i.e. using AZ20131 in edi message
.formula P|maskkontextfop = "fop_selaznachricht"  ? _M|kbselaznachricht
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.copy M|kmaxanzahl = 0
.continue END
..*****************************************************************************
!END
.continue
