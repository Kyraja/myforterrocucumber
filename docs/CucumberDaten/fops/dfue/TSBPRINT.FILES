..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TSBPRINT.FILES
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Functionality  : Check which files exist and are not empty
..*****************************************************************************
..!meta M|=dfue/TSBPRINT
.set trans -
.. 
.copy M|kbihssvorhanden = G|false
.continue EIHSS ? F|empty(M|kihssdatei)
.copy M|kbihssvorhanden = G|true ? F|fileexists(M|kihssdatei) & _F|isdir(M|kihssdatei) & F|filesize(M|kihssdatei)>0
!EIHSS
..
.copy M|kbimportvorhanden = G|false
.continue EIMPORT ? F|empty(M|kimportdatei)
.copy M|kbimportvorhanden = G|true ? F|fileexists(M|kimportdatei) & _F|isdir(M|kimportdatei) & F|filesize(M|kimportdatei)>0
!EIMPORT
.. 
.copy M|kbvdavorhanden = G|false
.continue EVDA ? F|empty(M|kvdadatei)
.copy M|kbvdavorhanden = G|true ? F|fileexists(M|kvdadatei) & _F|isdir(M|kvdadatei) & F|filesize(M|kvdadatei)>0
!EVDA
.. 
.copy M|kbtsbvorhanden = G|false
.continue ETSB ? F|empty(M|ktsbdatei)
.copy M|kbtsbvorhanden = G|true ? F|fileexists(M|ktsbdatei) & _F|isdir(M|ktsbdatei) & F|filesize(M|ktsbdatei)>0
!ETSB
.. 
.copy M|kbgtlvorhanden = G|false
.continue EGTL ? F|empty(M|kgtldatei)
.copy M|kbgtlvorhanden = G|true ? F|fileexists(M|kgtldatei) & _F|isdir(M|kgtldatei) & F|filesize(M|kgtldatei)>0
!EGTL
..
..*****************************************************************************
!END
.continue
