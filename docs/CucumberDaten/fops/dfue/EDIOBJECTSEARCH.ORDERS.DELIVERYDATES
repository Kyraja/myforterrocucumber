..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : EDIOBJECTSEARCH.ORDERS.DELIVERYDATES
.. Author         : carue
.. Verantwortlich : carue
.. Kontrolle      : dsch
.. Funktion       : Ermittlung des Lierfertermins bei EDIFACT ORDERS
..                  Der Liefertermin kann in der Position oder im Kopf stehen.
..                  Ist der Termin leer, wird das Tagesdatum gesetzt.
..
..*****************************************************************************
.set trans -
..
.type text xdatehead  ? _F|defined(U|xdatehead)
.type GD19 xdatetoday ? _F|defined(U|xdatetoday)
..
.formula U|xdatetoday = "."
.select screen header
.continue HEAD ? _F|empty(M|lieferdatum)
..
!DATE
.select screen line
.select screen line 'U|xaktzeile' ? U|xbsingle
..
.continue END     ? _G|mehr
..
.type text xdatetable ? _F|defined(U|xdatetable)
..
.formula U|xdatetable = M|liefdatum
..
..Assign value to date field
.formula M|liefdatum = U|xdatetoday
.formula M|liefdatum = U|xdatehead   ? _F|empty(U|xdatehead)
.formula M|liefdatum = U|xdatetable  ? _F|empty(U|xdatetable)
..
.continue DATE ? _U|xbsingle
.continue END
..
!HEAD
..read delivery date from message head
.formula U|xdatehead = M|lieferdatum
..
.continue DATE
..
..***************************************************************************
!END
.continue
