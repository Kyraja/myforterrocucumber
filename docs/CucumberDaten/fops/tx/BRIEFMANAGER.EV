..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BRIEFMANAGER.EV
.. Datum          : 29.07.2007
.. Version        : 2007
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt Ereignisse der Eingabefelder in der Personenliste
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..
.. Ablauf         : Zentrales EFOP des Briefmanagers
..
.. Functionality  : Handles such events of the input fields in the list of
..                  persons.
..
.. Program flow   : Central EFOP of the list of persons.
.. Includes       :
..*****************************************************************************
.set trans -
.type DVM2 xbrief     ? _F|defined(U|xbrief)
.type DVM2 xjournal   ? _F|defined(U|xjournal)
.type DVM2 xjmenue    ? _F|defined(U|xjmenue)
..
..------------------------------- Header -------------------------------------
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kkunde"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "knort"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kplz"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kundevon"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kundebis"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kstaat"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kkenn"
.continue KUNDE     ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bkunde"
.continue KUNDE     ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bsach"
.continue KUNDE     ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "binteressent"
.continue KUNDE     ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bisach"
.continue LIEFER    ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bliefer"
.continue LIEFER    ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bliefersach"
.continue MITARB    ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bmitarb"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kbetreuer"
.continue INIT      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "kvertret"
.continue ARB       ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "arbber"
.continue BRIEF     ? G|evtartengl ="FIELD_FILL"  & G|evtvar = "brief"
.continue LOGO      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bdrucklogo"
.continue FUSS      ? G|evtartengl ="FIELD_EXIT"    & G|evtvar = "bdruckfuss"
..----------------------------------------------------------------------------
.continue END
..
!LOGO
.formula M|drucklogo = 0 ?  M|bdrucklogo
.formula M|drucklogo = 1 ? _M|bdrucklogo
.continue INIT
..
!FUSS
.formula M|druckfuss = 0 ?  M|bdruckfuss
.formula M|druckfuss = 1 ? _M|bdruckfuss
.continue INIT
..
!KUNDE
.copy M|bmitarb      = G|FALSE
.copy M|bliefer      = G|FALSE
.copy M|bliefersach  = G|FALSE
.continue INIT
..
!LIEFER
.copy M|bkunde       = G|FALSE
.copy M|bsach        = G|FALSE
.copy M|binteressent = G|FALSE
.copy M|bisach       = G|FALSE
.copy M|bmitarb      = G|FALSE
.continue INIT
..
!MITARB
.copy M|bkunde       = G|FALSE
.copy M|bsach        = G|FALSE
.copy M|binteressent = G|FALSE
.copy M|bisach       = G|FALSE
.copy M|bliefer      = G|FALSE
.copy M|bliefersach  = G|FALSE
.continue INIT
..
!ARB
.continue ERROR1    ? _F|isdir('M|arbber') & M|arbber <> ""
.continue ERROR2    ? _F|diraccessible('M|arbber')
.formula U|xbrief   = M|arbber + "/BRIEF." + 'G|zeitpunkt:14'
.formula U|xbrief   = "BRIEF." + 'G|zeitpunkt:14'  ? F|empty(M|arbber)
.formula U|xjournal = M|arbber + "/BRJOURNAL"
.formula U|xjournal = "BRJOURNAL"                  ? F|empty(M|arbber)
.formula U|xjmenue  = M|arbber + "/BRJMENUE"
.formula U|xjmenue  = "BRJMENUE"                   ? F|empty(M|arbber)
.formula M|brief    = U|xbrief
.formula M|journal  = U|xjournal
.continue END       ? F|filenotempty('M|journal')
.input "DATEI.F"
.output addedto 'M|journal'
.set tran +
Datum      Bearbeiter    Empf„nger       Brief                                    Ihr Zeichen           Ihre Nachricht         Betreff
--------------------------------------------------------------------------------------------------------------------------------------------------------------
.set trans -
..
.continue END
..
!BRIEF
.continue END      ? _F|empty(M|brief)
.formula U|xbrief = "BRIEF." + 'G|zeitpunkt:14'
.formula M|brief  = U|xbrief
.continue END
..
!INIT
.make screen line --      ? M|tzeilen > 0
..
!END
.continue
..
!ERROR1
.formula M|brief = ""
.error -message Arbeitsbereich 'M|arbber' nicht vorhanden.
.formula M|arbber = ""
.end 1
..
!ERROR2
.error -message Zugriff auf Arbeitsbereich 'M|arbber' nicht erlaubt.
.formula M|arbber = ""
.formula U|xbrief = "BRIEF." + 'G|zeitpunkt:14'
.formula M|brief  = U|xbrief
.end 1
