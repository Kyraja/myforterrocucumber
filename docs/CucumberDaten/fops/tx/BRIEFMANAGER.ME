..
.. Functionality  :
..
.. Program flow   : Mask entry EFOP
.. Includes       :
..*****************************************************************************
.set trans -
.type DVM2 xbrief   ? _F|defined(U|xbrief)
.type DVM2 xjournal ? _F|defined(U|xjournal)
.type DVM2 xjmenue  ? _F|defined(U|xjmenue)
..
.formula M|rotz     = "icon:ball_red"
.formula M|gruenz   = "icon:ball_green"
.formula M|hinweisz = "icon:attention"
.formula M|adressez = "icon:flash"
.formula M|ball     = "icon:ball_red"
.formula M|arbber   = "tx"
.formula U|xbrief   = M|arbber + "/BRIEF." + 'G|zeitpunkt:14'
.formula U|xbrief   = "BRIEF." + 'G|zeitpunkt:14'  ? F|empty(M|arbber)
.formula U|xjournal = M|arbber + "/BRJOURNAL"
.formula U|xjournal = "BRJOURNAL"                  ? F|empty(M|arbber)
.formula U|xjmenue  = M|arbber + "/BRJMENUE"
.formula U|xjmenue  = "BRJMENUE"                   ? F|empty(M|arbber)
.formula M|brief    = U|xbrief
.formula M|journal  = U|xjournal
.formula M|jmenue   = U|xjmenue
..
.copy M|bkunde     = G|TRUE
.copy M|bsach      = G|TRUE
.copy M|bdruckfuss = G|TRUE
.copy M|bdrucklogo = G|TRUE
.formula M|spalte       = 80
..
.continue END        ? F|filenotempty('M|journal')
.input "DATEI.F"
.output addedto 'M|journal'
.set trans +
Datum      Bearbeiter    Empf„nger       Brief                                    Ihr Zeichen           Ihre Nachricht         Betreff
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
.set trans -
..
!END
.continue
