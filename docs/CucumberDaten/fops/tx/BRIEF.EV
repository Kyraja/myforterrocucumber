..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BRIEF.EV
.. Autor/Author   : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..
...Includes       :
.. include ANREDE
..*****************************************************************************
.set trans -
..
.type text xas   ? _F|defined(U|xas)
.type text xlima ? _F|defined(U|xlima)
..
.continue ERROR3 ? F|empty(M|baust3)
.continue PERSON ? F|filenotempty('M|baust3')
.continue ERROR2
..
!PERSON: Load person
.load 1 add M|person
.continue ERROR1 ? _G|mehr
.copy P|spr = 1|spr
..
.formula M|personname = 1|sucherw
.copy M|spr = 1|spr
.copy M|kas = 1|as
.formula M|kontakt = 1|kontakt
.continue VA3 ? F|empty(1|as) ; F|empty(1|kontakt)
.load 2 add 1|as
.input "ANREDE"
.continue VA5
..
!VA3: Anrede kann nicht aufgebaut werden, STD-Anrede
.set trans +
.text U|xas '1|spr' Sehr geehrte Damen und Herren,
.set trans -
..
!VA5: Commons
.formula M|anrede = U|xas
.formula M|bzeich = G|bzeichen
.assign M|drlogo = 'M|bdrucklogo(L="0")'
.assign M|drfuss = 'M|bdruckfuss(L="0")'
..
.. Buffer 1 - address data of person
.formula M|ukdnr = ""
.formula M|ans = 1|ans
.formula M|str = 1|str
.formula M|plz = 1|plz
.formula M|nort = 1|nort
.formula M|lakenn = 1|lakenn
.copy M|staat = 1|staat
.copy M|region = 1|region
.formula M|fax = 1|fax
.formula M|email = 1|email
..
.. Differences
.continue END ? 1|dnr = 11
.continue CONTACT ? 1|gruppe = 2 ; 1|gruppe = 7
.formula M|ukdnr = 1|frbez
.continue END
..
!CONTACT
.load 4 add 1|firma
.continue END ? _G|mehr
.formula M|ukdnr = 4|frbez
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -field M|person -message Bitte Person w„hlen.
.end 1
..
!ERROR2
.error -field M|baust3 -message Es wurde kein Brieftext zusammengestellt.
.end 1
..
!ERROR3
.error -field M|baust3 -message Es fehlt die Angabe eines Brieftextes.
.end 1
