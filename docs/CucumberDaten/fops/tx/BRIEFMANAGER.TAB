..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BRIEFMANAGER.TAB
.. Datum          : 29.07.2007
.. Version        : 2007
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Erzeugt eine Tabellezeile in der Personenliste.
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Tabellen-EFOP der Personenliste.
..
.. Functionality  : Creates a table row in the list of persons.
..
.. Program flow   : Table EFOP of the list of persons.
.. Includes       :
..*****************************************************************************
.set trans -
.type text xthinweis ? _F|defined(U|xthinweis)
..
.continue ZEILE ? M|bkunde & H|gruppe = 1
.continue ZEILE ? M|bsach  & H|gruppe = 2
.continue ZEILE ? M|binteressent & H|gruppe = 6
.continue ZEILE ? M|bisach & H|gruppe = 7
.continue ZEILE ? M|bmitarb
.continue ZEILE ? M|bliefer & H|gruppe = 1
.continue ZEILE ? M|bliefersach & H|gruppe = 2
.continue END
..
!ZEILE
.set trans +
.make screen line +O
.formula M|vgrtxt    = "Mitarbeiter"                 ? M|bmitarb
.formula M|vgrtxt    = "Kunde"                       ? M|bkunde & H|gruppe = 1
.formula M|vgrtxt    = "Kundenkontakt"               ? M|bsach  & H|gruppe = 2
.formula M|vgrtxt    = "Interessent"                 ? M|binteressent & H|gruppe = 6
.formula M|vgrtxt    = "Interessentenkontakt"        ? M|bisach & H|gruppe = 7
.formula M|vgrtxt    = "Lieferant"                   ? M|bliefer & H|gruppe = 1
.formula M|vgrtxt    = "Lieferantenkontakt"          ? M|bliefersach & H|gruppe = 2
.formula U|xthinweis = ""
.formula U|xthinweis = "Adressdaten sind nicht gepflegt. Diese Zeile wird nicht gedruckt." ? F|empty(H|ans)
.formula U|xthinweis = "Es ist kein Adressformat im verwendeten Land eingetragen. Diese Zeile wird nicht gedruckt." ? F|empty(H|staat^adrformat)
.formula U|xthinweis = "Adressdaten und Adressformat sind nicht gepflegt. Diese Zeile wird nicht gedruckt." ? F|empty(H|ans) & F|empty(H|staat^adrformat)
.set trans -
.formula M|tnum         = H|id
.formula M|tsuch        = H|such
.formula M|tplz         = H|plz
.copy M|tstaat     = H|staat
.formula M|tnort        = H|nort
.formula M|tkenn        = H|kenn
.formula M|tvertret     = ""
.formula M|tbetreuer    = ""
.copy M|tvertret   = H|vertret   ? F|defined(vertret)
.copy M|tbetreuer  = H|betreuer  ? F|defined(betreuer)
.formula M|thinweis     = U|xthinweis
.formula M|iconhinweisz = ""
.formula M|iconhinweisz = "icon:attention" ? F|empty(H|ans)
.formula M|hinweis2z    = "icon:flash"     ? F|empty(H|staat^adrformat)
.copy M|tdrucken   = G|TRUE  ? _F|empty(H|ans) & _F|empty(H|staat^adrformat)
..*****************************************************************************
!END
.continue
