..
.. Umsatz in Plandatensatz Kunde zurÅckschreiben
.. UmsÑtz neu Addieren und Prozent ermitteln.
..
..
.hol sperre dazu m|y40jtkunde
.fo h|y40kplanumsatz = m|y40jtplanumsatz
.bringe
..
.hol maske kopf
.fo m|y40jplanumsatz = 0
!MZ1:
.hol maske zeile 
.weiter EMZ1 ? _ mehr
.fo m|y40jplanumsatz = m|y40jplanumsatz + y40jtplanumsatz
.weiter MZ1

!EMZ1:
.hol maske kopf
.fo m|y40jsummeprozent = 0
!MZ2:
.hol maske zeile
.weiter EMZ2 ? _ mehr
.fo m|y40jtprgesamtums = (m|y40jtplanumsatz / m|y40jplanumsatz) * 100
.fo m|y40jsummeprozent = m|y40jsummeprozent + m|y40jtprgesamtums
.weiter MZ2

!EMZ2:
.weiter
