.art int xicount                             ? F|defined( U|xtcount ) = G|False
..
..
..-- Counter fÅr Tabellenzeilen
.formel U|xicount = 0
..
..-- Ende wenn Åberhaupt keine Zeilen in der Tabelle
.weiter KEINEZEILEN                          ? M|tzeilen = 0
..
..-- Kopf holen
.hole maske kopf
..
..
!MZEILE
.formel U|xicount = U|xicount +1
.hole maske zeile 'U|xicount'
..-- Zeile/Umlagerungsvorschlag freigeben nur wenn Komponenten verfÅgbar und noch nicht freigegeben
.eingabe owfo/UVFREIGEBEN.FREIGEBEN.BN       ? M|freigegeben = G|False & M|verfuegbar = G|True
.weiter ENDE                                 ? U|xicount = M|tzeilen
.weiter MZEILE
..
..
!KEINEZEILEN
.hinweis -sofort Keine UmlagerungsvorschlÑge freizugeben! Tabelle ist leer!
.weiter ENDE
..
..
!ENDE
.weiter
