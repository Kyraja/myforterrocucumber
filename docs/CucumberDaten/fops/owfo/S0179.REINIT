.formula M|yprojekt     = ""
.formula M|yprjmpproj   = ""
..
!REMPTY: empty talbe fields
.select screen line
.continue EMPTY         ? _G|mehr
.formula M|ytterm       = ""
.formula M|ytanzpos     = ""
.formula M|ytwert       = 0
.formula M|ytprjmvorg   = ""
.formula M|ytaufgabe    = ""
