..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           : owfo/M693.Y40TELEX.FAUS
.. Date           : 19.11.16
.. Version        : 2015r4n01p03
.. Author         : andre
.. Copyright      : (c) 2015 SABA International
.. Functionality  : Bezeichnung aus Verweis holen
..                  Schreibschutz fÅr lge und breite setzen
..                  Mgr und lgr fÅr Arbeitsgang Åbernehmen
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
..
..
.weiter LEER           ? m|y40telex = ""
..
.formel m|y40telname       = m|y40telex^name
.formel m|y40tytemp        = ""
..
.schutz -geschuetzt m|y40tlg 'evtzeile'      ? m|y40telex^flme =  0 & m|y40telex^gruppe = 1
.schutz -geschuetzt m|y40tbreite 'evtzeile'  ? m|y40telex^fbme =  0 & m|y40telex^gruppe = 1
.schutz -reset      m|y40tlg 'evtzeile'      ? m|y40telex^flme <> 0 & m|y40telex^gruppe = 1
.schutz -reset      m|y40tbreite 'evtzeile'  ? m|y40telex^fbme <> 0 & m|y40telex^gruppe = 1
.schutz -geschuetzt m|y40tlg 'evtzeile'      ?                        m|y40telex^gruppe = 2
.schutz -geschuetzt m|y40tbreite 'evtzeile'  ?                        m|y40telex^gruppe = 2
..
..
.formel m|y40tanzahl  = 1
.formel m|y40tmgr     = m|y40telex^mgr       ?                        m|y40telex^gruppe = 0
.formel m|y40tlgr     = m|y40telex^lgr       ?                        m|y40telex^gruppe = 0
.formel m|y40tbu      = "Ende"               ?                        m|y40telex^gruppe = 0
.formel m|y40tmgr     = ""                   ?                        m|y40telex^gruppe <> 0
.formel m|y40tlgr     = ""                   ?                        m|y40telex^gruppe <> 0
.formel m|y40tbu      = ""                   ?                        m|y40telex^gruppe <> 0
..
...box
..'m|y40telex^gruppe'
..
.weiter


!LEER:
.formel m|y40telname = ""  
.schutz -reset      m|y40tlg 'evtzeile'      
.schutz -reset      m|y40tbreite 'evtzeile'   
.formel m|y40tmgr     = ""
.formel m|y40tlgr     = ""
.formel m|y40tbu      = ""
.weiter
