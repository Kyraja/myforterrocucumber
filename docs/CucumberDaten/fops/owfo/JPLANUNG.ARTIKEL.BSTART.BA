.art text xtfarbe1 xtfarbe2
.art int xiz
.fo xtfarbe1 = "240 240 240"
.fo xtfarbe2 = "226 226 226"
.mach maske zeile --
.fo m|istumsatz  = 0
.fo m|planumsatz = 0
.art text xtsel
.fo xtsel = "$,,nummer=;such=;y40ajahr="+'m|gjahr'+";@gruppe=12;@sort = such"
.fo xtsel = "$,,nummer=;such=;@gruppe=12;@sort = such" ? m|gjahr = 0
!HOL:
.hol datei40 'xtsel'
.weiter ENDE ? _ mehr
!MZ
..menu
..'m|selexport'    >>
..'h|yselexport'   >>
..e                >>.ende
..
..weiter LOOP ? m|selexport <> "" &  m|selexport <> h|yselexport
.mach maske zeile +
.fo xiz = xiz + 1
.farbe -HINTERGRUND 240 240 240 'xiz'
.fo m|partikel  = h|nummer
.fo m|artikel   = m|partikel^y40aartikel
.fo m|epreis    = m|partikel^y40avkpreis
.fo m|gmge      = m|partikel^y40aplanmenge
