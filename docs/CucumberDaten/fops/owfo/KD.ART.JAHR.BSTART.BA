..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           : KD.ART.JAHR.BSTART.BA
.. Date           : 12.06.15
.. Version        : 2015r4n01p03
.. Author         : si/dr
.. Copyright      : (c) 2015 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.art text xtfarbe1 xtfarbe2
.art int xiz
.art real xumsist
.fo xtfarbe1 = "210 233 209"
.fo xtfarbe2 = "232 202 202"
.mach maske zeile --
..fo m|istumsatz  = 0
..fo m|planumsatz = 0
.art text xtsel
.fo xtsel = "$,,nummer=;such/==-"+'m|jahr'+";@gruppe=11;@sort = such"
!HOL:
.hol datei40 'xtsel'
.weiter ENDE ? _ mehr
!MZ
.weiter LOOP ? m|selexport <> "" & m|selexport <> h|yselexport
.mach maske zeile +
.fo xiz = xiz + 1
.farbe -HINTERGRUND 210 233 209 'xiz'
.fo m|pkunde = 'h|id'

.lade 0 dazu m|pkunde
!KDZEILE:
.lade 0 zeile
.weiter EKDZEILE ? _ mehr
.mach maske zeile +
.fo xiz = xiz + 1
.farbe -HINTERGRUND 232 202 202 'xiz'
.fo m|partikel = '0|y40ktartikel^id'
.fo m|menge    =  0|y40ktmonatsumme
..fo m|menge    =  0|y40ktjmge
.fo m|wert     =  0|y40ktgeswert
.fo m|mge1     =  0|y40ktmge01
.fo m|mge2     =  0|y40ktmge02
.fo m|mge3     =  0|y40ktmge03
.fo m|mge4     =  0|y40ktmge04
.fo m|mge5     =  0|y40ktmge05
.fo m|mge6     =  0|y40ktmge06
.fo m|mge7     =  0|y40ktmge07
.fo m|mge8     =  0|y40ktmge08
.fo m|mge9     =  0|y40ktmge09
.fo m|mge10    =  0|y40ktmge10
.fo m|mge11    =  0|y40ktmge11
.fo m|mge12    =  0|y40ktmge12
.fo m|mge13    =  0|y40ktmge13
.fo xumsist    =  xumsist + 0|y40ktgeswert 
............
.weiter KDZEILE

!LOOP:
!EKDZEILE:
.hol datei40
.weiter ENDE ? _mehr
.weiter MZ

!ENDE:
.fo m|umsist  =  xumsist
.weiter
