.formel m|mindest      =  h|y40tmindest
.formel m|verwendung   =  h|y40tverwendung  
.formel m|minbsmge     =  h|y40tminbsmge
.formel m|maxbsmge     =  h|y40tmaxbsmge
.formel m|losgr        =  h|y40tlosgr
.formel m|losbild      =  h|y40tlosbild
.formel m|maxbsmge     =  h|y40tmaxbsmge
.formel m|vpr          =  h|y40tvpr
.formel m|lief         =  h|y40tlief
.formel m|efrist       =  h|y40tefrist
.formel m|losgr        =  h|y40tlosgr
.formel m|epr          =  h|y40tepr
..
.weiter NéCHSTER


