.mach maske zeile--
..
.art text xtsel
.formel xtsel = "$,,nummer=;such=;y40tbsart="+"Fremdbeschaffung"+";@gruppe=13;@sort = such" ? m|nurkaufteile
.formel xtsel = "$,,nummer=;such="                              +";@gruppe=13;@sort = such" ?_m|nurkaufteile
!HOL:
.hol datei40 'xtsel'
..
!MZ:
.weiter ENDE ? _ mehr
.mach maske zeile +O
.formel m|tempsuch     =  h|num80
.formel m|tempname     =  h|name
.formel m|verwendung   =  h|y40tverwendung
.formel m|dispoa       =  h|y40tdispoa
.formel m|bsart        =  h|y40tbsart
