..fo h|aufgrp = "55"       ? dispoa = "mindestbestandsbezogen"
..fo h|aufgrp = "56"       ? bsart = "Eigenfertigung"
..fo h|aufgrp = "525"      ? bsart = "Lohnfertigung"
..fo h|erlgrp = "110000"   ? bsart = "Eigenfertigung" 
..fo h|erlgrp = "311000"   ? kenn / "*EDI*"  
..fo h|erlgrp = "312000"   ? such / "LF-*"  
..fo h|erlgrp = "232000"   ? such / "SABA-KP*"  
..fo h|erlgrp = "262000"   ? such / "MRA*"  
