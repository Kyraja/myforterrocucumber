..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : S0179.SEE
.. Date           : 02/11/2015
.. Version        : 1.0
.. Author         : RASC
.. Copyright      :
.. Functionality  : SCREEN_END
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type GD   U|xdate      ? _F|defined(U|xdate)
..
.set trans -
.continue END           ? _G|evtart = "maskende"
.continue END           ? F|empty(M|nummer)
.continue END           ? M|ybvorlage
.continue END           ? _G|evtkommd = "zeigen"
..
!LINES
.select screen line
.continue END           ? _G|mehr
..
.continue LINES         ? M|ytschlussre
.continue LINES         ? _F|empty(M|ytrechn)
.continue LINES         ? M|ytstorno
.continue LINES         ? _F|empty(M|ytaufgabe) & _F|empty(M|ytplanz)
..
.cursor ytplanz   'M|aktzeile'  ? F|empty(M|ytplanz)
.cursor ytaufgabe 'M|aktzeile'  ? F|empty(M|ytaufgabe) & F|empty(M|ytplanz)
.set trans +
.text U|xttext 'G|bspri' "Sie haben noch nicht alle Planzahlungen angelegt!"                    ? F|empty(M|ytplanz)
.text U|xttext 'G|bspri' "Sie haben noch nicht alle Aufgaben und Planzahlungen angelegt!"       ? F|empty(M|ytaufgabe) & F|empty(M|ytplanz)
.set trans -
.error 'U|xttext'
.continue END
..
!END
.continue
