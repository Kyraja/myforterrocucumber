..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : S0179.YTBUPLZ.BA
.. Date           : 02/11/2015
.. Version        : 1.0
.. Author         : RASC
.. Copyright      :
.. Functionality  : BUTTON_AFTER <ytbuplz>
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
..
.set trans -
.formula U|xtcmd        = 'M|ytplzid'
.continue SHOW          ? _F|empty(M|ytplzid)
.formula U|xtcmd        = 'M|ytplanz^id'
.continue SHOW          ? _F|empty(M|ytplanz)
.continue VIEW          ? _G|evtkommd = "zeigen"
.continue NOTERM        ? F|empty(M|ytterm)
.continue NOWERT        ? M|ytwert = 0
..
.set trans +
.text U|xttext 'G|bspri' "wollen Sie eine neue Planzahlung zu dieser Zeile anlegen?"
.set trans -
.box -button no:yes
'U|xttext'
.continue END           ? G|box = G|boxno
..
.input S0179.YTBUPLANZ.FOP
..
.set trans +
.text U|xttext 'G|bspri' "Planzahlung wurde angelegt - bitte Maske aktualisieren"
.set trans -
.note IMMEDIATELY 'U|xttext'
.continue END
..
!SHOW
.formula U|xtcmd        = 'U|xtcmd'+"<zeigen>"
.command -PARALLEL 'U|xtcmd'
.continue END
..
!VIEW
.set trans +
.text U|xttext 'G|bspri' "Diese Aktion darf nur im Zeigen-Modus ausgefÅhrt werden!"
.set trans -
.box
'U|xttext'
.continue END
..
!ERROR
.set trans +
.text U|xttext 'G|bspri' "Die angelegte Planzahlung konnte nicht in den Zahlungsplan zurÅckgeschrieben werden!"
.set trans -
.error 'U|xttext'
.continue END
..
!NOTERM
.set trans +
.text U|xttext 'G|bspri' "Sie mÅssen erst einen Termin eintragen!"
.set trans -
.error 'U|xttext'
.continue END
..
!NOWERT
.set trans +
.text U|xttext 'G|bspri' "Sie mÅssen erst einen Wert eintragen!"
.set trans -
.error 'U|xttext'
.continue END
..
!END
.continue
