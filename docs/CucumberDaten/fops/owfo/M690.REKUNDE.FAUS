..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*******************************************************************
..
..
.ende ? m|y40jtkunde <> ""
.ende ? m|y40jtrekunde= ""
..
.art text xtsuch xtname
.fo xtsuch = 'm|y40jtrekunde^such' + "-" + 'm|y40jjahr'
.fo xtsuch = xtsuch + "-P"  ? m|yselexport = "PRESALES"
.fo xtname = 'm|y40jtrekunde^name' + " " + 'm|y40jjahr'
.mache datei40 gruppe11
.fo such       = xtsuch
.fo name       = xtname
.fo y40kkunde  = m|y40jtrekunde^num
.fo y40kjahr   = m|num
.fo yselexport = m|yselexport
.bringe
.fo m|y40jtkunde = xtsuch
.weiter
