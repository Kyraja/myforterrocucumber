..!interpreter german translate declaration noabbrev
..*****************************************************************************
.. Name           : owfo/POS.MENGE.AUFTEILEN
.. Datum/Date     : Juli 2016
.. Version        : 2016R4 
.. Autor/Author   : Reinhard AndrÇ
.. Copyright      : (c)  2016
.. Funktion       : bei MaskenprÅfung Neuanlage der Auftragsdatei die AB-Zeile pro Woche in Zeilen pro Tag aufteilen
..                  ob aufgeteilt wird und wenn ja wie, wird aus dem Artikel gelesen
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    -------------------------------------------------------------------------
..
..
..
..*****************************************************************************
..
..****************************************************************************
..
.hol maske kopf
!MZEILE:
.hol maske zeile
.weiter EMZEILE ? _ mehr
.weiter MZEILE  ? m|y40tartikelnr^ytagesmgeab = 0
.weiter MZEILE  ? m|y40tmenge < m|y40tartikelnr^ytagesmgeab
.weiter TEILEN


!TEILEN:
.art text xartikel xabtyp xtertyp xrahmen
.art GD xdatum
.art real  xfaktor
.art int xirestmenge ximge1 ximge2 ximge3 ximge4 ximge5
.fo xartikel    = m|y40tartikelnr
.fo xabtyp      = m|y40abruftyp
.fo xtertyp     = m|y40abdattyp
.fo xrahmen     = m|yrahmen
.fo xdatum      = m|y40tdatum
.fo xfaktor     = m|y40tfaktor
.fo xirestmenge = m|y40tmenge
..
.fo ximge1      = m|y40tmenge *  m|y40tartikelnr^ymoproz/100
.fo ximge1      = f|mround(ximge1,,1)
.fo xirestmenge   = xirestmenge - ximge1 
.weiter ETEILEN ?  xirestmenge <= 0
..
.fo ximge2      = m|y40tmenge *  m|y40tartikelnr^ydiproz/100
.fo ximge2      = f|mround(ximge2,,1)
.fo xirestmenge   = xirestmenge - ximge2 
.weiter ETEILEN ?  xirestmenge <= 0
..
.fo ximge3      = m|y40tmenge *  m|y40tartikelnr^ymiproz/100
.fo ximge3      = f|mround(ximge3,,1)
.fo xirestmenge   = xirestmenge - ximge3 
.weiter ETEILEN ?  xirestmenge <= 0
..
.fo ximge4      = m|y40tmenge *  m|y40tartikelnr^ydoproz/100
.fo ximge4      = f|mround(ximge4,,1)
.fo xirestmenge   = xirestmenge - ximge4 
.weiter ETEILEN ?  xirestmenge <= 0
..
.fo ximge5      = m|y40tmenge *  m|y40tartikelnr^yfrproz/100
.fo ximge5      = f|mround(ximge5,,1)
.fo xirestmenge   = xirestmenge - ximge5 
.weiter ETEILEN 

!ETEILEN:
..box
..'y40tmenge'
..'m|y40tartikelnr^ymoproz'   'ximge1'
..'m|y40tartikelnr^ydiproz'   'ximge2'
..'m|y40tartikelnr^ymiproz'   'ximge3'
..'m|y40tartikelnr^ydoproz'   'ximge4'
..'m|y40tartikelnr^yfrproz'   'ximge5'
....
.weiter ZEILE1

!ZEILE1:   muss nicht erzeugt werden
.fo m|y40tmenge      = ximge1
.fo m|y40tdatum      = xdatum -2
.weiter ZEILE2

!ZEILE2:
.weiter ZEILE3 ? ximge2 = 0
.mach maske zeile +O
.fo m|y40tartikelnr  = xartikel
.fo m|y40tmenge      = ximge2
.fo m|y40tdatum      = xdatum -1
.fo m|y40tfaktor     = xfaktor
.fo m|y40abdattyp    = xtertyp
.fo m|y40abruftyp    = xabtyp
.fo m|yrahmen        = xrahmen
.weiter ZEILE3

!ZEILE3:
.weiter ZEILE4 ? ximge3 = 0
.mach maske zeile +O
.fo m|y40tartikelnr  = xartikel
.fo m|y40tmenge      = ximge3
.fo m|y40tdatum      = xdatum
.fo m|y40tfaktor     = xfaktor
.fo m|y40abdattyp    = xtertyp
.fo m|y40abruftyp    = xabtyp
.fo m|yrahmen        = xrahmen
.weiter ZEILE4

!ZEILE4:
.weiter ZEILE5 ? ximge4 = 0
.mach maske zeile +O
.fo m|y40tartikelnr  = xartikel
.fo m|y40tmenge      = ximge4
.fo m|y40tdatum      = xdatum + 1
.fo m|y40tfaktor     = xfaktor
.fo m|y40abdattyp    = xtertyp
.fo m|y40abruftyp    = xabtyp
.fo m|yrahmen        = xrahmen
.weiter ZEILE5

!ZEILE5:
.weiter EZEILEN ? ximge5 = 0
.mach maske zeile +O
.fo m|y40tartikelnr  = xartikel
.fo m|y40tmenge      = ximge5
.fo m|y40tdatum      = xdatum + 2
.fo m|y40tfaktor     = xfaktor
.fo m|y40abdattyp    = xtertyp
.fo m|y40abruftyp    = xabtyp
.fo m|yrahmen        = xrahmen
.weiter EZEILEN

!EZEILEN:
.weiter MZEILE

!EMZEILE
.weiter



