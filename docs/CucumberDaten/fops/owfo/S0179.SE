..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : S0179.SE
.. Date           : 02/11/2015
.. Version        : 1.0
.. Author         : RASC
.. Copyright      :
.. Functionality  : SCREEN_ENTRY
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type realx U|xrfakt    ? _F|defined(U|xrfakt)
.type real U|xrebetr    ? _F|defined(U|xrebetr)
.type real U|xurbetr    ? _F|defined(U|xurbetr)
..
.set trans -
..
.continue NEW           ? G|evtkommd = "neu"
.continue EDIT          ? G|evtkommd = "„ndern" ; G|evtkommd = "zeigen"
.continue END
..
!NEW
.continue END           ? F|empty(M|yvorgid)
.input S0179.REINIT
.continue END
..
!EDIT
.assign M|yvorgang      = M|yvorgid
.formula M|yposwert     = M|yvorgang^sumnetto
.formula M|yanzproz     = M|ysumanz * 100 / M|yposwert  ? M|yposwert > 0 & G|evtkommd = "„ndern"
.continue LINES         ? F|empty(M|yvorgpid)
.assign M|yvorgpos      = M|yvorgpid
.formula M|yposwert     = M|yvorgpos^pwert
.formula M|yanzproz     = M|ysumanz * 100 / M|yposwert  ? M|yposwert > 0 & G|evtkommd = "„ndern"
..
!LINES
.select screen line
.continue SCHLUSSRE     ? _G|mehr
..
.continue LINES         ? M|ytschlussre
.formula P|maskkontextfop       = "STORNO"      ? M|ytbsto
.assign M|ytstore       = M|ytstoid
.formula M|ytstorno     = M|ytbsto
..
.protect ytprjmvorg 'M|aktzeile'        ? F|empty(M|yprjmpproj)
.protect ytbuprjmv  'M|aktzeile'        ? F|empty(M|yprjmpproj)
.assign M|ytaufgabe     = M|ytaufgid
.assign M|ytplanz       = M|ytplzid
.formula M|ytplbetr     = M|ytplanz^zabetr      ? _F|empty(M|ytplanz)
.assign M|ytrepos       = M|ytrepid
.assign M|ytrechn       = M|ytrepid
.formula M|ytopbetr     = M|ytrechn^sumnetto    ? F|empty(M|ytrechn^ophist)
.continue NOOPHIST      ? F|empty(M|ytrechn^ophist)
.assign M|ytophist      = M|ytrechn^ophist^id
.formula U|xrfakt       = 1
.formula U|xrebetr      = M|ytrechn^ophist^rebetr
.formula U|xurbetr      = M|ytrechn^ophist^opz1^bubetr
.formula U|xrfakt       = U|xrebetr / U|xurbetr ? U|xurbetr <> 0
.formula M|ytopbetr     = M|ytrechn^sumnetto * U|xrfakt
.formula M|ytabdat      = M|ytrechn^ophist^abdat
.. 
!NOOPHIST
.continue LINES         ? F|empty(M|ytrepid)
.protect ytterm         'M|aktzeile'
.protect ytanzpos       'M|aktzeile'
.protect ytanteil       'M|aktzeile'
.protect ytwert         'M|aktzeile'
.continue LINES
..
!SCHLUSSRE
.select screen line 'M|tzeilen'
.continue ERROR         ? _G|mehr
.continue END           ? M|aktzeile = 0
..
.continue ERROR         ? _M|ytschlussre
.protect ytterm     'M|aktzeile'
.protect ytanzpos   'M|aktzeile'
.protect ytanteil   'M|aktzeile'
.protect ytwert     'M|aktzeile'
.protect ytprjmvorg 'M|aktzeile'        ? F|empty(M|yprjmpproj)
.protect ytbuprjmv  'M|aktzeile'        ? F|empty(M|yprjmpproj)
.protect ytbuplz    'M|aktzeile'
.protect ytbusto    'M|aktzeile'
..
.assign M|ytrepos       = M|ytrepid
.assign M|ytrechn       = M|ytrepid
.formula M|ytopbetr     = M|ytrechn^sumnetto    ? F|empty(M|ytrechn^ophist)
.continue PRUEFEN       ? F|empty(M|ytrechn^ophist)
.assign M|ytophist      = M|ytrechn^ophist^id
.formula U|xrfakt       = 1
.formula U|xrebetr      = M|ytrechn^ophist^rebetr
.formula U|xurbetr      = M|ytrechn^ophist^opz1^bubetr
.formula U|xrfakt       = U|xrebetr / U|xurbetr ? U|xurbetr <> 0
.formula M|ytopbetr     = M|ytrechn^sumnetto * U|xrfakt
.formula M|ytabdat      = M|ytrechn^ophist^abdat
.. 
!PRUEFEN
.continue END           ? M|ytwert = M|yposwert
..
.set trans +
.text U|xttext 'G|bspri' "Der Positionswert hat sich ver„ndert, bitte gleichen Sie die Werte in den Zeilen an!"
.set trans -
.box
'U|xttext'
.continue END           ? _G|evtkommd = "„ndern"
.formula M|ytwert       = M|yposwert
.continue END
..
!ERROR
.set trans +
.text U|xttext 'G|bspri' "Die Schlussrechnungszeile fehlt!"
.set trans -
.error 'U|xttext'
.end 1
..
!END
.continue
