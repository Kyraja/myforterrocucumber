.ende ? m|y40aartikel = ""
.fo m|such            = 'm|y40aartikel^such' +"-"+'m|y40ajahr'
.fo m|y40avkpreis     = m|y40aartikel^vpr * m|y40aartikel^vpehe
.fo m|name            = 'm|y40aartikel^name' +"-"+'m|y40ajahr'
.weiter
