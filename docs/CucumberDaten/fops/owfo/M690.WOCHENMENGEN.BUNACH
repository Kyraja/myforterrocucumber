.weiter START

das Programm geht durch alle Kundenplans„tze des betreffenden Kalenderjahres
und teilt dort in der Tabelle die jeweiligen Mengen einer Period auf die Woche 1-4 auf.
Wenn in dem Datensatz nicht eine Aufteilung erfasst wird, wird die Aufteilung aus dem Programm
ferwendet. Das Textfeld endet dann mit einem "F". Ebenso wird diese Aufteilung verwednet, wenn das Feld noch leer ist.


Woche 1 30%
Woche 2 25%
Woche 3 20%
Woche 4 25%


!START:
..
..
..art real xprozent1 xprozent2 xprozent3 xprozent4
..art text
..fo xprozent1 = 0,3
..fo xprozent2 = 0,25
..fo xprozent3 = 0.2
..fo xprozent4 = 0,25
..fo xtaufteilung = "30-25-20-25F"
...
.hol maske kopf
..
!MZ:
.hol maske zeile
.weiter EMZ ? _ mehr
.weiter MZ  ?   m|y40jtkunde = ""
.................................
.hol sperre dazu m|y40jtkunde
..
!ZEILE
.hol zeile
.weiter EZEILE ? _ mehr
..
.. Summe P1-P13 erzeugen
.fo h|y40ktmonatsumme  = h|y40ktmge01 + h|y40ktmge02 + h|y40ktmge03 + h|y40ktmge04 + h|y40ktmge05 + h|y40ktmge06 + h|y40ktmge07 + h|y40ktmge08 + h|y40ktmge09 + h|y40ktmge10 + h|y40ktmge11 + h|y40ktmge12 + h|y40ktmge13
.fo h|y40ktvkpreis     = h|y40ktartikel^y40aartikel^vpr
.fo h|y40ktgeswert     = h|y40ktmonatsumme * h|y40ktvkpreis
!P1
.art real xprozent1 xprozent2 xprozent3 xprozent4
.art text xtaufteilung
.fo xprozent1 = 0,3
.fo xprozent2 = 0,25
.fo xprozent3 = 0.2
.fo xprozent4 = 0,25
.fo xtaufteilung = "30-25-20-25F"
.art bool  xbta
.weiter P1FIX ? 'h|y40ktaufteilung01' = ""
.weiter P1FIX ? 'h|y40ktaufteilung01' / "*F*"
..
.art text  xtatmp xta1 xta2 xta3 xta4
.fo xbta = true
.fo xtatmp  = 'h|y40ktaufteilung01' 
.fo xta1    =  xtatmp << "-"
.fo xtatmp  =  xtatmp >> "-"
.fo xta2    =  xtatmp << "-"
.fo xtatmp  =  xtatmp >> "-"
.fo xta3    =  xtatmp << "-"
.fo xtatmp  =  xtatmp >> "-"
.fo xta4    =  xtatmp << "-"
.art real xprozent1 xprozent2 xprozent3 xprozent4
.fo xprozent1 = xta1
.fo xprozent2 = xta2
.fo xprozent3 = xta3
.fo xprozent4 = xta4
..
..
!P1FIX:
.art real xrrestmenge xrkwmge1 xrkwmge2 xrkwmge3 xrkwmge4
.fo xrrestmenge = h|y40ktmge01
.fo xrkwmge1    = h|y40ktmge01 * xprozent1
.fo xrkwmge1    = f|mround(xrkwmge1,,1)
.fo xrrestmenge   = xrrestmenge - xrkwmge1 
.weiter EP1 xrrestmenge <= 0
.fo xrkwmge2    = h|y40ktmge01 * xprozent2
.fo xrkwmge2    = f|mround(xrkwmge2,,1)
.fo xrrestmenge   = xrrestmenge - xrkwmge2 
.weiter EP1 xrrestmenge <= 0
.fo xrkwmge3    = h|y40ktmge01 * xprozent3
.fo xrkwmge3    = f|mround(xrkwmge3,,1)
.fo xrrestmenge   = xrrestmenge - xrkwmge3 
.weiter EP1 xrrestmenge <= 0
.fo xrkwmge4    = h|y40ktmge01 * xprozent4
.fo xrkwmge4    = f|mround(xrkwmge4,,1)
..fo xrrestmenge   = xrrestmenge - xrkwmge4
.weiter EP1

!EP1
.fo h|y40ktmge011 = xrkwmge1
.fo h|y40ktmge012 = xrkwmge2
.fo h|y40ktmge013 = xrkwmge3
.fo h|y40ktmge014 = xrkwmge4
.fo h|y40ktmge014 = xrrestmenge
