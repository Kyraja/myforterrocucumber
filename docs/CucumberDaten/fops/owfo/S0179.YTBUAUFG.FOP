..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : S0179.YTBUAUFG.FOP
.. Date           : 11/02/2015
.. Version        : 1.0
.. Author         : RASC
.. Copyright      :
.. Functionality  : Sub-FOP of S0179.YTBUAUFG.FOP
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type text U|xtref      ? _F|defined(U|xtref)
..
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xtout
.file -TEMPNAME U|xterr
.output NEW 'U|xtedp'
.input DATEI.F
# Aufgabe anlegen zu Fakturaplan
#!database=86
#!group=6
#!action=new
#!report=REF
such;ursache;projekt;name;partner;elem;evvorgang;schlag;beschr;start;startzeit;end;endzeit;
'M|such';'M|id';'M|yprojekt^id';'M|ytereignis';'M|ykuli^id';'M|yartikel^id';'M|yvorgang^id';'M|ytschlag';'M|ytereignis';'M|ytterm';8:00;'M|ytterm';17:00;
.output
.formula U|xtcmd        = "edpimport.sh -P -I " + U|xtedp
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' PASSWORD background
..
.formula U|xtref        = ""
.select from
.select from 'U|xtout' U|xtref^
.continue ERROR         ? F|empty(U|xtref) ; 'U|xtref' = "(0,0,0)"
..
.select lock object 'M|id'
.continue ERROR         ? _G|mehr
.select lock line 'M|aktzeile'
.formula H|ytaufgid     = 'U|xtref'
.rewrite
.select-
..
.assign M|ytaufgabe     = U|xtref
.continue END
..
!ERROR
.set trans +
.text U|xttext 'G|bspri' "Die Neuanlage der Aufgabe ist fehlgeschlagen - Fehlermeldung wird im Anschluss ausgegeben!"
.set trans -
.error 'U|xttext'
.edi -READONLY 'U|xterr'
.continue END
..
!END
.continue
