.art text xtselect                          ? F|defined( U|xtselect )     = G|False
.art bool xp                                ? F|defined( U|xp )           = G|False
.art bool xbverfÅgbar                       ? F|defined( U|xbverfÅgbar )  = G|False
..
..
..-- Debugginginformation anschalten?
.. .formel U|xp = G|True
..
.weiter ERRWOCHE                   ? F|empty( M|woche ) = G|True
..
.mache maske zeile --
..
.formel U|xtselect = "$,,art=;lgruppe=;mge=;tsterm=;verw=;kopf=`;wtrterm=!" + 'M|enddatum:8' + ";bveinplan==(Yes);bsart==(Relocation);@gruppe=2;@ablageart=(Active);@ordnung=sterm;@bereich=(Yes)"
..
.hole einkauf 'U|xtselect'
!UVS
.weiter AUSGABE                    ? G|mehr = G|True
.weiter PRUEF                      ? G|mehr = G|False
..
..
!PRUEF
.hole maske kopf
..
..
!MZEILE
.hole maske zeile
.weiter ENDE                       ? G|mehr = G|False
..
..
!UMLAGERUNG
.hole dazu M|uvs
.weiter ERRGROSS                   ? G|mehr  = G|False
..
.hole dazu eres
..
..
!RESERVIERUNG
?Reservierung!                     ? U|xp    = G|True
.weiter ZEILE                      ? H|elart = 3
?RES -'elart'-'elem^such' 'dispo'  ? U|xp
.weiter DISPOC                     ? H|dispoa = "mindestbestandsbezogen"
.weiter DISPOLEER                  ? H|dispo = "."
..
..
!MVERWENDUNG
.merk
.merk verwendung
..
..
!HOLVERW
.hol verwendung
?BVKENN -'bvkenn'-                 ? U|xp          = G|True
.weiter EHOLVERW                   ? bvkenn      = ""
.formel U|xbverfÅgbar = G|True     ? bvkenn      = "L"
.formel U|xbverfÅgbar = G|False    ? bvkenn      = "B"
.formel U|xbverfÅgbar = G|False    ? bvkenn      = "U"
?XBVERFöGBAR 'U|xbverfÅgbar'       ? U|xp          = G|True
.weiter MZEILE                     ? U|xbverfÅgbar = G|False
.weiter HOLVERW
..
..
!EHOLVERW
.hole
.weiter EZEILE
..
..
!DISPOC
? DISPO C                          ? U|xp = G|True
.formel U|xbverfÅgbar = G|True
.weiter EZEILE
..
..
!DISPOLEER
.formel U|xbverfÅgbar = G|True
.weiter EZEILE
..
..
!ZEILE
.hole zeile
.weiter RESERVIERUNG
..
..
!EZEILE
.formel M|verfuegbar = U|xbverfÅgbar
.weiter MZEILE
..
..
!UVSPRUEF
.formel U|xbverfÅgbar = G|True     ? F|empty( M|as^pba ) = G|True
.weiter EASPRUEF                   ? F|empty( M|as^pba ) = G|True
..-- VorgÑgner prÅfen
.formel U|xbverfÅgbar = G|True     ? as^pba^mge = 0
.formel U|xbverfÅgbar = G|False    ? as^pba^mge > 0
.weiter EASPRUEF
..
..
!EASPRUEF
.formel M|verfuegbar = U|xbverfÅgbar
.weiter MZEILE
..
..
!AUSGABE
.mache maske zeile
.formel M|uvs          = 'H|id'
.formel M|wtsterm      = 'H|wtsterm'
.formel M|wtterm       = 'H|wtterm'
.formel M|wtrterm     = 'H|wtrterm'
.formel M|artex        = 'H|artex'
.formel M|tename       = 'H|tename'
.formel M|mge          = 'H|mge'
.formel M|he           = 'H|he'
.hole weiter
.weiter UVS
