..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           : owfo/MX.URL.BI.SE
.. Datum/Date     : 08.02.2016
.. Version        :
.. Autor/Author   : mage/abas
.. Copyright      :
.. Beschreibung/
.. Description    : Define URL in order to load BI reports
..
...Includes       :
.. 
..: Integration fop.txt
..  0  * maskein     *  *  * [C] ow1/MX.URL.BAPP
..  1  * maskein     *  *  * [C] ow1/MX.URL.BAPP
..  2  * maskein     *  *  * [C] ow1/MX.URL.BAPP
..
..
..*****************************************************************************
..
.art text xtserver                                      ? _F|defined(xtserver)
.art text xtpath                                        ? _F|defined(xtpath)
.art text xtbspr                                        ? _F|defined(xtbspr)   
.art text xtpara                                        ? _F|defined(xtpara)     
.art text xtmandant                                     ? _F|defined(xtmandant)
.art text xturlbericht                                  ? _F|defined(xturlbericht)
.art text xturlbericht2                                 ? _F|defined(xturlbericht2)        
..
..*****************************************************************************
..
..
.. Replace the character "-" with "_" if operating language is "en-US"
.zuweisen U|xtbspr  =  "D"
.zuweisen U|xtbspr  =  "A"      ? G|bsprache = "A"
.formel U|xtserver  = "bi.abas.de"
.formel U|xtmandant = G|mandant
..
..: Make sure that the URLs are only for specific screens embedded
.weiter CUSTOMER                                        ? G|evtmaske = 0
..weiter SUPPLIER                                        ? G|evtmaske = 1
.weiter PRODUCT                                         ? G|evtmaske = 2
.weiter END
..
!CUSTOMER
..: Build URL for abas BI
.formel U|xturlbericht  = "http://" + U|xtserver + "/ReportServer?%2fabasGUI_Reports%2fCustomerInfo_"+ U|xtbspr +"&rs:Command=Render&client=SABA&customer="+ M|id +"&rc:Toolbar=false"
..browser 'U|xturlbericht'
.formel M|yanalyzerbi = 'U|xturlbericht'
.weiter END
..
!SUPPLIER
..: Build URL for abas BI
.formel U|xturlbericht  = "http://" + U|xtserver + "/ReportServer?%2FabasGUI_Reports%2FCustomerInfo&y1=2016&y2=2015&client=SABA&customer="+ M|id +"&rs%3AParameterLanguage=&rc%3AParameters=Collapsed&rc%3AToolbar=False"
..browser 'U|xturlbericht'
..formel M|yanalyzerbi = 'U|xturlbericht'
.weiter END
..
!PRODUCT
..: Build URL for abas BI
.formel U|xturlbericht  = "http://" + U|xtserver + "/Reportserver?%2fabasGUI_Reports%2fProductInfo_"+ U|xtbspr +"&rs:Command=Render&client=SABA&p="+ M|id +"&rc:Toolbar=false"
..browser 'U|xturlbericht'
.formel M|yanalyzerbi = 'U|xturlbericht'
.weiter END
..
!END
.weiter
