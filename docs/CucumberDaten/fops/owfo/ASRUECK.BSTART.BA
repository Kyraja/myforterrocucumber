..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           : ASRUECK.BSTART.BA
.. Date           : 02.12.14
.. Version        : 2014r3n02
.. Author         : chbo
.. Copyright      : (c) 2014 SABA International
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
..
.art text xtselect                      ? F|defined( U|xtselect )     = G|False
.art bool xp                            ? F|defined( U|xp )           = G|False
.art bool xbverfÅgbar                   ? F|defined( U|xbverfÅgbar )  = G|False
.art text xtrandkomm                    ? F|defined( U|xtrandkomm )   = G|False
.art text xtranddatei                   ? F|defined( U|xtranddatei )  = G|False
.art int  xirand                        ? F|defined( U|xirand )       = G|False
.art M1.2 xfschwankung                  ? F|defined( U|xtschwankung ) = G|False
..
..
..-- Debugausgabe
...formel U|xp    = G|True
...ausgabe bild                           ? U|xp
..
.formel M|offen = G|False
.formel M|reload = G|False
..
..-- Eingabefelder ÅberprÅfen
.weiter ERRWOCHE                        ? F|empty( M|woche ) = G|True
.weiter ERRLG                           ? M|alle = G|False & M|kassel = G|False & M|augsburg = G|False
..
...eingabe
.mache maske zeile --
..
.weiter ALLE                            ? M|alle     = G|True
.weiter INT                             ? M|kassel   = G|True
.weiter EXT                             ? M|augsburg = G|True

!ALLE
..-- Arbeitscheine fÅr alle Lagergruppen laden
.formel U|xtselect = "$,,nummer=;such=;pterm=!" + 'M|enddatum' + ";snba<>`;mge>0;@ablageart=(Active)"
.weiter HOLEAS
..
..
!INT
..-- Arbeitscheine fÅr die interne Lagergruppen laden
.weiter ERRINT                          ? F|empty( M|int ) = G|True
.formel U|xtselect = "$,,nummer=;such=;pterm=!" + 'M|enddatum' + ";lgruppe=" + 'M|int^id' + ";snba<>`;mge>0;@ablageart=(Active)"
.weiter HOLEAS
..
..
!EXT
..-- Arbeitscheine fÅr die externe Lagergruppen laden
.weiter ERREXT                          ? F|empty( M|ext ) = G|True
.formel U|xtselect = "$,,nummer=;such=;pterm=!" + 'M|enddatum' + ";lgruppe=" + 'M|ext^id' + ";snba<>`;mge>0;@ablageart=(Active)"
.weiter HOLEAS
..
..
!HOLEAS
.hole gruppe "9:1" 'U|xtselect'
!AS
.weiter AUSGABE                         ? G|mehr = G|True
.weiter PRUEF                           ? G|mehr = G|False
..
..
!PRUEF
.hole maske kopf
..
..
!MZEILE
.hole maske zeile
.weiter ENDE                            ? G|mehr = G|False
..
..
!ARBEITSSCHEIN
.hole dazu M|as
.weiter ERRGROSS                        ? G|mehr  = G|False
..
.hole dazu eres
..
..
!RESERVIERUNG
?Reservierung!                          ? U|xp    = G|True
.weiter ASPRUEF                         ? H|elart = 3 & H|as <> ""
.weiter ZEILE                           ? H|elart = 3 & H|as=""
.weiter ZEILE                           ? H|elart = 2
?RES -'elart'-'elem^such' 'dispo'       ? U|xp
.weiter DISPOC                          ? H|dispoa = "mindestbestandsbezogen"
..
..
!MVERWENDUNG
.merk
.merk verwendung
..
..
!HOLVERW
.hol verwendung
?BVKENN -'bvkenn'-                      ? U|xp          = G|True
.weiter EHOLVERW                        ? bvkenn        = ""
.formel U|xbverfÅgbar = G|True          ? bvkenn        = "L"
.formel U|xbverfÅgbar = G|False         ? bvkenn        = "B"
.formel U|xbverfÅgbar = G|False         ? bvkenn        = "U"
?XBVERFöGBAR 'U|xbverfÅgbar'            ? U|xp          = G|True
.weiter MZEILE                          ? U|xbverfÅgbar = G|False
.weiter HOLVERW
..
..
!EHOLVERW
.hole
.weiter ZEILE
..
..
!DISPOC
? DISPO C                               ? U|xp = G|True
.formel U|xbverfÅgbar = G|True
.weiter ZEILE
..
..
!ZEILE
.hole zeile
.weiter RESERVIERUNG
..
..
!EZEILE
.formel M|verfuegbar = U|xbverfÅgbar
.formel M|offen = G|True                ? M|verfuegbar = G|True
.weiter MZEILE
..
..
!ASPRUEF
.formel U|xbverfÅgbar = G|True          ? F|empty( M|as^pba ) = G|True
.weiter EASPRUEF                        ? F|empty( M|as^pba ) = G|True
..-- VorgÑgner prÅfen
.formel U|xbverfÅgbar = G|True          ? as^pba^mge = 0
.formel U|xbverfÅgbar = G|False         ? as^pba^mge > 0
.weiter EASPRUEF
..
..
!EASPRUEF
.formel M|verfuegbar = U|xbverfÅgbar
.formel M|offen = G|True                ? M|verfuegbar = G|True
.weiter MZEILE
..
..
!AUSGABE
.mache maske zeile
.formel M|as           = 'H|id'
.formel M|tsterm       = 'H|tsterm'
.formel M|tterm        = 'H|tterm'
.formel M|art          = 'H|art'
.formel M|vzeit        = 'H|vzeit'
..-- Schwankungen in der Arbeits- bzw. Maschinenzeit auf Basis der Zufallsnummer kalkulieren
.weiter ZUFALLSNR
!MITZUFALLSNR
.formel M|schwankung   = 0.95           ? U|xirand = 0
.formel M|schwankung   = 0.96           ? U|xirand = 1
.formel M|schwankung   = 0.97           ? U|xirand = 2
.formel M|schwankung   = 0.98           ? U|xirand = 3
.formel M|schwankung   = 0.99           ? U|xirand = 4
.formel M|schwankung   = 1.00           ? U|xirand = 5
.formel M|schwankung   = 1.01           ? U|xirand = 6
.formel M|schwankung   = 1.02           ? U|xirand = 7
.formel M|schwankung   = 1.03           ? U|xirand = 8
.formel M|schwankung   = 1.04           ? U|xirand = 9
.formel M|schwankung   = 1.05           ? U|xirand = 10
.formel M|vzeitschwank = M|vzeit * M|schwankung
.hole weiter
.weiter AS
..
..
!ZUFALLSNR
..-- TemporÑrdatei erzeugen und Shellkommando fÅr Zufallsnummer bauen und absetzen
.datei -TEMPNAME U|xtranddatei
.formel U|xtrandkomm = "echo $(( RANDOM % 11 )) > " + 'U|xtranddatei'
.system 'U|xtrandkomm' HINTER
.weiter ERRZUFALL                       ? G|mehr = G|False
..
..-- Zufallsnummer von Datei lesen
.hole von 'U|xtranddatei' U|xirand ^
.weiter ERRORTMP                        ? G|mehr = G|False
.hole von
.. .formel U|xirand = 5
.weiter MITZUFALLSNR
..
..
!ERRZUFALL
.hinweis -sofort Zufallsgenerator scheitert!
.weiter ENDE
..
..
!ERRTMP
.hinweis -sofort TemporÑrdatei fÅr Zufallsgenerator konnte nicht gelesen werden!
.weiter ENDE
..
..
!ERRWOCHE
.hinweis -sofort Bitte aktuelle Woche eingeben!
.weiter ENDE
..
..
!ERRGROSS
.hinweis -sofort Fehler bei der Selektion des Arbeitsscheins!
.weiter ENDE
..
..
!ERRLG
.hinweis -sofort Lagergruppekreis auswÑhlen!
.weiter ENDE
..
..
!ERRINT
.hinweis -sofort Interne Lagergruppe eingeben!
.weiter ENDE
..
..
!ERREXT
.hinweis -sofort Externe Lagergruppe eingeben!
.weiter ENDE
..
..
!ENDE
.weiter
