..
..
.weiter LEER           ? m|y40tytemp = ""
..
.formel m|y40telex         = ""
.formel m|y40telname       = m|y40tytemp^name
..
.schutz -geschuetzt m|y40tlg 'evtzeile'      ? m|y40tytemp^y40tflme =  0
.schutz -geschuetzt m|y40tbreite 'evtzeile'  ? m|y40tytemp^y40tfbme =  0 
.schutz -reset      m|y40tlg 'evtzeile'      ? m|y40tytemp^y40tflme <> 0 
.schutz -reset      m|y40tbreite 'evtzeile'  ? m|y40tytemp^y40tfbme <> 0 
..
..
...box
..'m|y40telex^gruppe'
..
.weiter


!LEER:
.formel m|y40telname = ""  
.schutz -reset      m|y40tlg 'evtzeile'      
.schutz -reset      m|y40tbreite 'evtzeile'   
.formel m|y40tmgr     = ""
.formel m|y40tlgr     = ""
.formel m|y40tbu      = ""
.weiter
