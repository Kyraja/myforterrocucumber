.weiter START
durch alle Kundens„tze laufen und dort die Istwerte der Artikel ermitteln 
und im Artikeldatensatz aufaddieren.

Zu Beginn mssen aber erst die Werte im Artikel zurckgesetzt werden.

Danach noch einmal die Istwerte der Kunden aufaddieren und in die Jahresplanung bernehmen.

!START:
..
.art text xtsel
.fo xtsel = "$,,nummer=;such=;y40ajahr=="+'m|y40jjahr'+";yselexport==" +'m|yselexport' + ";@gruppe=12;"
!HOL1:
.hol sperre datei40 'xtsel'
.weiter FHOL ? _ mehr
!NULL:
.fo h|y40aistmenge  = 0
.fo h|y40aistumsatz = 0
..
.fo h|y40aistmge01  = 0
.fo h|y40aistmge02  = 0
.fo h|y40aistmge03  = 0
.fo h|y40aistmge04  = 0
.fo h|y40aistmge05  = 0
.fo h|y40aistmge06  = 0
.fo h|y40aistmge07  = 0
.fo h|y40aistmge08  = 0
.fo h|y40aistmge09  = 0
.fo h|y40aistmge10  = 0
.fo h|y40aistmge11  = 0
.fo h|y40aistmge12  = 0
.fo h|y40aistmge13  = 0
.....................
.bringe
.hol sperre datei40
.weiter EHOL1 ? _ mehr
.weiter NULL 

!EHOL1:
.box
Werte auf 0 gesetzt
..
.weiter MKOPF


!FHOL:
.box
Selektion hat keine Daten gefunden
..
.weiter




!MKOPF:
..
.hol maske kopf
!MZ
.hol maske zeile
.weiter EMZ ? _ mehr
.weiter MZ ? m|y40jtkunde = ""
...
.lade 0 dazu m|y40jtkunde
..
!KZEILE:
.lade 0 zeile
.weiter EKZEILE ? _ mehr
.weiter KZEILE  ? 0|y40ktartikel = ""
.......
.hol sperre dazu 0|y40ktartikel
.fo h|y40aistmge01   = h|y40aistmge01 + 0|y40ktmge01
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge01
.fo h|y40aistmge02   = h|y40aistmge02 + 0|y40ktmge02
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge02
.fo h|y40aistmge03   = h|y40aistmge03 + 0|y40ktmge03
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge03
.fo h|y40aistmge04   = h|y40aistmge04 + 0|y40ktmge04
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge04
.fo h|y40aistmge05   = h|y40aistmge05 + 0|y40ktmge05
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge05
.fo h|y40aistmge06   = h|y40aistmge06 + 0|y40ktmge06
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge06
.fo h|y40aistmge07   = h|y40aistmge07 + 0|y40ktmge07
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge07
.fo h|y40aistmge08   = h|y40aistmge08 + 0|y40ktmge08
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge08
.fo h|y40aistmge09   = h|y40aistmge09 + 0|y40ktmge09
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge09
.fo h|y40aistmge10   = h|y40aistmge10 + 0|y40ktmge10
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge10
.fo h|y40aistmge11   = h|y40aistmge11 + 0|y40ktmge11
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge11
.fo h|y40aistmge12   = h|y40aistmge12 + 0|y40ktmge12
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge12
.fo h|y40aistmge13   = h|y40aistmge13 + 0|y40ktmge13
.fo h|y40aistmenge   = h|y40aistmenge + 0|y40ktmge13
...    
.fo h|y40aistwert01 = h|y40aistmge01 * h|y40avkpreis
.fo h|y40aistwert02 = h|y40aistmge02 * h|y40avkpreis
.fo h|y40aistwert03 = h|y40aistmge03 * h|y40avkpreis
.fo h|y40aistwert04 = h|y40aistmge04 * h|y40avkpreis
.fo h|y40aistwert05 = h|y40aistmge05 * h|y40avkpreis
.fo h|y40aistwert06 = h|y40aistmge06 * h|y40avkpreis
.fo h|y40aistwert07 = h|y40aistmge07 * h|y40avkpreis
