.fo h|y40aistwert11 = h|y40aistmge11 * h|y40avkpreis
.fo h|y40aistwert12 = h|y40aistmge12 * h|y40avkpreis
.fo h|y40aistwert13 = h|y40aistmge13 * h|y40avkpreis
..
.fo h|y40aistumsatz  = h|y40aistmenge * h|y40avkpreis
..
.bringe
.weiter KZEILE

!EKZEILE:
.weiter MZ

!EMZ:
.box
Istwerte ermittelt und eingetragen
..
.weiter SUMMEN

!SUMMEN:
.hol maske kopf
.fo m|y40jistumsatz= 0
!MZS:
.hol maske zeile
.weiter EMZS ? _ mehr
.art real xistumsatzsumme
.hole sperr dazu m|y40jtkunde
!KUZEILE
.hol zeile
.weiter EKUZEILE ? _ mehr 
.fo xistumsatzsumme = xistumsatzsumme + y40ktgeswert
.weiter KUZEILE

!EKUZEILE
.fo h|y40kistumsatz = xistumsatzsumme 
.bringe
.fo m|y40jtistumsatz = m|y40jtkunde^y40kistumsatz
.fo m|y40jistumsatz  = m|y40jistumsatz+ m|y40jtistumsatz
.weiter MZS

!EMZS:
.weiter

