..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           : FVFREIGEBEN.FVFREIGEBEN.BN
.. Date           : 24.11.14
.. Version        : 2014r3n02
.. Author         : chbo
.. Copyright      : (c) 2014 abas Software AG
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************

..
.art text xtdatei                           ? F|defined( U|xtdatei )   = G|False
.art text xtkomm                            ? F|defined( U|xtkomm )    = G|False
.art text xtedplog                          ? F|defined( U|xtedplog )  = G|False
.art text xtedpcopy                         ? F|defined( U|xtedpcopy ) = G|False
.art text xtcopyedp                         ? F|defined( U|xtcopyedp ) = G|False
..
..
..-- Muss der Vorschlag Åberhaupt importiert werden?
.weiter RELEASED                            ? M|freigegeben = G|True
.weiter RELOAD                              ? M|reload      = G|True
..
..-- Logdatei definineren
.formel U|xtedplog   = "tmp/XFVFREIGEBEN." + 'G|versionneu' + ".EDP.LOG"
.formel U|xtedpcopy  = "tmp/XFVFREIGEBEN." + 'G|versionneu' + ".EDP.COPY"
..
..-- Tempdatei fÅr das EDP-Import-Kommando vorbereiten
.datei -tempname U|xtdatei
.eingabe DATEI.F
.ausgabe auf 'U|xtdatei'
#!EDP_TESTFLAG2=1
#!EDP_DATE='M|dienstag:8'

sn
'M|fv^id'
.ausgabe auf WERF.WEG
.eingabe BILD.F
.ausgabe BILDSCHIRM
..
..
..-- Freigeben Åber EDP
.formel U|xtkomm = "edpimport.sh -a RELEASE -I " + 'U|xtdatei' + " 2> " + 'U|xtedplog' + " -p abas123"
.. 'U|xtkomm'
.. .edit 'U|xtdatei'
.system 'U|xtkomm' hinter
.weiter ERROR                               ? G|mehr = G|False
.weiter SUCCESS
..
..
!ERROR
.hinweis -sofort EDP-Datei 'U|xtdatei' fÅr FV 'M|fv^id' konnte nicht importiert werden!
.formel U|xtcopyedp = "cp " + 'U|xtedpdatei' + " " + 'U|xtedpcopy'
.system 'U|xtcopyedp' HINTER
.weiter END
..
..
!SUCCESS
.hinweis -sofort Fertigungsvorschlag 'M|fv^id' erfolgreich freigegeben.
.formel M|freigegeben = G|True
.weiter END
..
..
!RELEASED
.hinweis -sofort Fertigungsvorschlag 'M|fv^id' wurde schon freigegeben!
.weiter END
..
..
!RELOAD
.hinweis -sofort Die Tabelle zuerst mit Klick auf Starttaste aktualisieren!
.weiter END
..
..
!END
.weiter
