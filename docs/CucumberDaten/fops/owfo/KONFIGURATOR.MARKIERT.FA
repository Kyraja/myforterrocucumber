.art text xprocst.xprocsp ? _defined(xprocst.xprocsp)
.formel xprocst.xprocsp = "RET002" 
.weiter PROC001
!RET002
.formel xprocsp = xprocsp - 1
..
.weiter LOOP005
!ELOP005: ==============================
..
!FI001
..
!BRUTTOPREIS
.. Brutto-Preisermittlung
.. alle Preise der ausgewÑhlten Komponenten aus der Maske (ypr1) + Basispreis des Artikels (vpr9) aufsummieren.
.hol maske kopf
.art real xprsumme
.formel xprsumme = m|yartikel^vpr9
...
!PRZEILE:
.hol maske zeile
.weiter EPRZEILE ? _ mehr
.weiter PRZEILE  ? _ m|ymarkiert
..
.formel xprsumme = xprsumme + m|ypr1    
.weiter PRZEILE

!EPRZEILE:
.hol maske kopf
.fo m|ypreis = xprsumme
.weiter EBRUTTOPREIS


!EBRUTTOPREIS
.ende
..
