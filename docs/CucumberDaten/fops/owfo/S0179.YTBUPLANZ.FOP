..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : S0179.YTBUAUFG.FOP
.. Date           : 11/02/2015
.. Version        : 1.0
.. Author         : RASC
.. Copyright      :
.. Functionality  : Sub-FOP of S0179.YTBUAUFG.FOP
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
.type text U|xtcmd      ? _F|defined(U|xtcmd)
.type text U|xtedp      ? _F|defined(U|xtedp)
.type text U|xtout      ? _F|defined(U|xtout)
.type text U|xterr      ? _F|defined(U|xterr)
.type text U|xtref      ? _F|defined(U|xtref)
..
.formula U|xttext = 'M|ytereignis' + " zum Zahlungsplan " + 'M|nummer' + ": Vorgang " + 'M|yvorgang^nummer'
.file -TEMPNAME U|xtedp
.file -TEMPNAME U|xtout
.file -TEMPNAME U|xterr
.output NEW 'U|xtedp'
.input DATEI.F
# Planzahlung anlegen zu Fakturaplan
#!database=141
#!group=1
#!action=new
#!report=REF
such;name;zaeinaus;zabetr;zawaehr;termin;
?'M|such';'U|xttext';(101);'M|ytwert';'M|ywaehr^id';'M|ytterm'; ? M|yvorgang^dnr = 3
?'M|such';'U|xttext';(97);'M|ytwert';'M|ywaehr^id';'M|ytterm';  ? M|yvorgang^dnr = 4
.output
.formula U|xtcmd        = "edpimport.sh -P -I " + U|xtedp
.formula U|xtcmd        = U|xtcmd + " >" + U|xtout + " 2>" + U|xterr
.system 'U|xtcmd' PASSWORD background
..
.formula U|xtref        = ""
.select from
.select from 'U|xtout' U|xtref^
.continue ERROR         ? F|empty(U|xtref) ; 'U|xtref' = "(0,0,0)"
..
.select lock object 'M|id'
.continue ERROR         ? _G|mehr
.select lock line 'M|aktzeile'
.formula H|ytplzid      = 'U|xtref'
.rewrite
.select-
..
.assign M|ytplanz       = U|xtref
.formula M|ytplbetr     = M|ytwert
.continue END
..
!ERROR
.set trans +
.text U|xttext 'G|bspri' "Die Neuanlage der Planzahlung ist fehlgeschlagen - Fehlermeldung wird im Anschluss ausgegeben!"
.set trans -
.error 'U|xttext'
.edi -READONLY 'U|xterr'
.continue END
..
!END
.continue
