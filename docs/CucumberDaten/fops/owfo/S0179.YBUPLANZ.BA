..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : S0179.YBUPLANZ.BA
.. Date           : 11/02/2015
.. Version        : 1.0
.. Author         : RASC
.. Copyright      :
.. Functionality  : BUTTON_AFTER <ybuplanz>
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text U|xttext     ? _F|defined(U|xttext)
..
.set trans -
.continue ERROR         ? _G|evtkommd = "zeigen"
..
!LINES
.select screen line
.continue END           ? _G|mehr
..
.continue LINES         ? M|ytwert = 0
.continue LINES         ? _F|empty(M|ytplzid) ; _F|empty(M|ytplanz)
.continue LINES         ? M|ytschlussre
..
.input S0179.YTBUPLANZ.FOP
..
.continue LINES
..
!ERROR
.set trans +
.text U|xttext 'G|bspri' "Diese Aktion ist nur im Zeigen-Modus erlaubt!"
.set trans -
.error 'U|xttext'
.continue END
..
!END
.continue
