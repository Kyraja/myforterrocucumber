..
.. neuen Datensatz fr n„chstes Jahr erzeugen
.. 
..weiter WERTE
!MENU
.menu
nur Werte ermittel  >> .weiter WERTE
neues Jahr erzeugen   >> .weiter NEUJAHR
.weiter MENU


!NEUJAHR:
.art text xsuch xjahr
.hol maske kopf
..fo xsuch = 'm|such' >> -1
..fo xsuch = xsuch + "3"
..fo xjahr = 'm|y40kjahr' >> -1
..fo xjahr = xjahr + "3"
..
.hole datei40 ""
.weiter F1 ? _ mehr
.fo xjahr = h|nummer
.fo xsuch = h|such
..
.fo m|y40kprozent = 5
.fo m|such        = xsuch
.fo m|y40kjahr    = xjahr
..fo m|y40kjahr  
..
!NJZ:
.hol maske zeile
.weiter ENJZ  ? _ mehr
.art text xtsuch
.fo xtsuch = 'm|y40ktartikel^y40aartikel^such' + "-" + 'y40kjahr^y40jjahr' 
....
.fo m|y40ktartikel = xtsuch
.fo m|y40ktjmge  = m|y40ktjmge + ((m|y40ktjmge/100) * m|y40kprozent)
.weiter NJZ

!ENJZ:
.box
neue Datens„tze und Menge eingetragen 
...
.weiter WERTE
 
!F1:
.box
keinen Datensatz gefunden
....
.ende










!WERTE
.weiter GESAMTSUMME



!GESAMTSUMME:
.hol maske kopf
.fo m|y40kistumsatz = 0
..
!ZEILE
.hol maske zeile
.weiter ENDE ? _ mehr
.fo m|y40ktvkpreis = m|y40ktartikel^y40avkpreis
.fo m|y40ktgeswert = m|y40ktjmge * m|y40ktvkpreis
.fo m|y40kistumsatz = m|y40kistumsatz + y40ktgeswert
.weiter ZEILE

!ENDE
.weiter
