..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           :owfo/EFOP.M680.EXFIELD
.. Date           :
.. Version        :
.. Author         :
.. Copyright      :
.. Functionality  :
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type GD xddate ? _F|defined(U|xddate)
.type GD xdstart ? _F|defined(U|xdstart)
.type GD xdenddate ? _F|defined(U|xdenddate)
.type text xtyear  ? _F|defined(U|xtyear)
.continue CUSTOMER  ? G|evtvar = "y40kundenum" ; G|evtvar = "y40kundesuch"
.continue DATE  ? G|evtvar = "y40kw" 
.continue
!CUSTOMER
.formula M|y40kundesuch = 'M|y40kundenum^id' ?   G|evtvar = "y40kundenum" & M|y40kundenum^gruppe =1
.formula M|y40kundesuch = 'M|y40kundenum^firma^id' ?   G|evtvar = "y40kundenum" & M|y40kundenum^gruppe <>1
.formula M|y40kundenum = 'M|y40kundesuch^id' ?   G|evtvar = "y40kundesuch"
.formula M|such = "B"+'M|y40kundenum^such'   ? _F|empty(M|y40kundenum)
.formula M|such = 'M|y40kundenum^such'       ?  F|empty(M|y40kundenum)
.continue
!DATE
.formula U|xtyear = 'M|y40kw'
.formula U|xtyear = U|xtyear >> "/"
.assign U|xddate = 'M|y40kw'
.formula M|y40von = U|xddate -2
.formula M|y40bis = U|xddate +2
.formula M|y40jahr = 'F|year(M|y40bis)'
.formula M|y40monat = 'F|month(U|xddate)'
.continue




