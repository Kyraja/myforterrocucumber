..
.. PrÅfen: es mÅssen alle Prozentwerte der Planungszeilen 100 sein
.art int xiz
.art bool xbf
.hol maske kopf
!PZEILE
.hol maske zeile
.weiter EPZEILE ? _ mehr
.fo xiz = xiz +1
.fo xbf = true ? m|prmgesumme <> 100 
.farbe -HINTERGRUND 0 255 0 prmgesumme 'xiz' ? m|prmgesumme=  100 
.farbe -HINTERGRUND 255 0 0 prmgesumme 'xiz' ? m|prmgesumme<> 100
...
.. eine Zeile Åberspingen
.hol maske zeile 
.weiter EPZEILE? _ mehr
.fo xiz = xiz +1
.weiter PZEILE

!EPZEILE:
.weiter FMGE ? xbf
.. 
.weiter SCHREIBEN



!SCHREIBEN:
..  ermittelte Werte in die PlandatensÑtze zurÅckschreiben.
..
.hol maske kopf
!MZ:
.hol maske zeile
.weiter EMZ ? _ mehr
.hol sperre dazu m|partikel
.fo h|y40aprozums   =  m|prozentgesamt
.fo h|y40aprozmge01 =  m|prmge01
.fo h|y40aprozmge02 =  m|prmge02
.fo h|y40aprozmge03 =  m|prmge03
.fo h|y40aprozmge04 =  m|prmge04
.fo h|y40aprozmge05 =  m|prmge05
