.fo h|y40aprozmge08 =  m|prmge08
.fo h|y40aprozmge09 =  m|prmge09
.fo h|y40aprozmge10 =  m|prmge10
.fo h|y40aprozmge11 =  m|prmge11
.fo h|y40aprozmge12 =  m|prmge12
.fo h|y40aprozmge13 =  m|prmge13
...
.fo h|y40aplmge01   =  m|mge01
.fo h|y40aplmge02   =  m|mge02
.fo h|y40aplmge03   =  m|mge03
.fo h|y40aplmge04   =  m|mge04
.fo h|y40aplmge05   =  m|mge05
.fo h|y40aplmge06   =  m|mge06
.fo h|y40aplmge07   =  m|mge07
.fo h|y40aplmge08   =  m|mge08
.fo h|y40aplmge09   =  m|mge09
.fo h|y40aplmge10   =  m|mge10
.fo h|y40aplmge11   =  m|mge11
.fo h|y40aplmge12   =  m|mge12
.fo h|y40aplmge13   =  m|mge13
...
.fo h|y40aplwert01  = m|mge01 * m|epreis
.fo h|y40aplwert02  = m|mge02 * m|epreis
.fo h|y40aplwert03  = m|mge03 * m|epreis
.fo h|y40aplwert04  = m|mge04 * m|epreis
.fo h|y40aplwert05  = m|mge05 * m|epreis
.fo h|y40aplwert06  = m|mge06 * m|epreis
.fo h|y40aplwert07  = m|mge07 * m|epreis
.fo h|y40aplwert08  = m|mge08 * m|epreis
.fo h|y40aplwert09  = m|mge09 * m|epreis
