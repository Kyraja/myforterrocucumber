..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTIKEL.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : 
..*****************************************************************************
.set trans -
..
..<META M|='st/PACKMATERIAL'>
..
.. Start empty
.make screen line -- ? M|tzeilen > 0
..
.. Query
.formula M|select = "$,,;@gruppe=1;packmit=(Yes);pmtyp<>`"
..
.formula M|select = M|select + F|formatstr(";@numsuch={1}", M|ksuch)          ? _F|empty(M|ksuch)
.formula M|select = M|select + F|formatstr(";sucherw=`{1}", M|ksucherw)       ? _F|empty(M|ksucherw)
.formula M|select = M|select + F|formatstr(";fbetreuer={1}", M|kfbetreuer^id) ? _F|empty(M|kfbetreuer)
.formula M|select = M|select + F|formatstr(";pmtyp={1}", M|kpmtyp)            ? _F|empty(M|kpmtyp)
.formula M|select = M|select + F|formatstr(";vpkenn={1}", M|kvpkenn)          ? _F|empty(M|kvpkenn)
.formula M|select = M|select + F|formatstr(";bsart={1}", M|kbsart)            ? _F|empty(M|kbsart)
..
..*****************************************************************************
!END
.continue

