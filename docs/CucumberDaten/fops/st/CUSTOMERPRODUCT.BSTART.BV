..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CUSTOMERPRODUCT.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Start-Button
.. Functionality  : Start button
..*****************************************************************************
.set trans -
..
..<META M|='st/CUSTOMERPRODUCT'> 
..
.. Start empty
.make screen line --  ?  M|tzeilen > 0
..
.. Special OR-query for packing instructions
.continue PACK ? _F|empty(M|kpackanw) & _M|kblagerpackanw & _M|kbversandpackanw
..
.. Query customer product entries
.continue ENDBART ? _F|empty(M|kartikel) ; F|empty(M|basisartikel)
.formula M|select = "$,,;@gruppe=6"
.formula M|select = M|select + ";kuartnr=" + M|kkuartnr       ?  _F|empty(M|kkuartnr)
.formula M|select = M|select + ";art==" + M|basisartikel^id   ?  _F|empty(M|basisartikel) & F|empty(M|kartikel)
.formula M|select = M|select + ";kl==" + M|kkunde^id          ?  _F|empty(M|kkunde)
.formula M|select = M|select + ";packanwla<>`"                ?   M|kblagerpackanw   &  F|empty(M|kpackanw)
.formula M|select = M|select + ";packanwla=" + M|kpackanw^id  ?   M|kblagerpackanw   & _F|empty(M|kpackanw)
.formula M|select = M|select + ";packanw<>`"                  ?   M|kbversandpackanw &  F|empty(M|kpackanw)
.formula M|select = M|select + ";packanw=" + M|kpackanw^id    ?   M|kbversandpackanw & _F|empty(M|kpackanw)
..
.input "is/HOL.LISTE"
!ENDBART
..
.. Query customer product entries
.formula M|select = "$,,;@gruppe=6"
.formula M|select = M|select + ";kuartnr=" + M|kkuartnr       ?  _F|empty(M|kkuartnr)
.formula M|select = M|select + ";art==" + M|kartikel^id       ?  _F|empty(M|kartikel)
.formula M|select = M|select + ";art^basisartikel==" + M|basisartikel^id ?  _F|empty(M|basisartikel) & F|empty(M|kartikel)
.formula M|select = M|select + ";kl==" + M|kkunde^id          ?  _F|empty(M|kkunde)
.formula M|select = M|select + ";packanwla<>`"                ?   M|kblagerpackanw   &  F|empty(M|kpackanw)
.formula M|select = M|select + ";packanwla=" + M|kpackanw^id  ?   M|kblagerpackanw   & _F|empty(M|kpackanw)
.formula M|select = M|select + ";packanw<>`"                  ?   M|kbversandpackanw &  F|empty(M|kpackanw)
.formula M|select = M|select + ";packanw=" + M|kpackanw^id    ?   M|kbversandpackanw & _F|empty(M|kpackanw)
.continue END
..
!PACK: OR-condition for pack instruction
.formula M|select = F|formatstr("$,,;@gruppe=6;@verknuepfung=(Or);packanwla={1};packanw={1}", M|kpackanw^id) 
.formula M|kkuartnr=""
.formula M|kartikel=""
.formula M|kkunde=""
..
..*****************************************************************************
!END
.continue 
