..!interpreter english declaration noabbrev

..============================================================================
.. Name           : PRODGRP2EVTHANDLER.FO2
.. Author         : rowa
.. Verantwortlich : mh
.. Functionality  : Eventhandler for the Infosystem st/PRODGRP2
..============================================================================
..
..<VAR>
    .var GL30 xpvon            = "prodgrpvon" 
    .var GL30 xpbis            = "prodgrpbis"
    .var bool selectOverId     = G|False
..</VAR>

..<META H|='P12:29' >
..<META M|='st/PRODGRP2' >
def main(){
    .set trans -
    switch(G|evtartengl) {
        case("FIELD_EXIT") {
            .call emptyTable()
        }
        
        case("BUTTON_BEFORE") {
            .call checkRange()
            .call emptyTable()    
        }
        
        case ("BUTTON_AFTER") {
            .call getResults()
        }
    }
}

def getResults( ) { 
    .call buildSelectionString()
    .select company 'M|select'
    .call buildTable()
} 

def buildTable( ) { 
        while(G|mehr) {
            .make screen line +O
            .assign M|tprodgrp            = H|id
            .copy   M|tpgerlo             = H|pgerlo
            .copy   M|tuebest             = H|uebest
            .copy   M|tueaend             = H|ueaend
            .copy   M|tpgkst              = H|pgkst
            .copy   M|tbvzmaschkostfix    = H|bvzumaschkostfix 
            .copy   M|tbvzgkmaschkostfix  = H|bvzugkmaschkostfix
            .copy   M|tbvzumaschkostvar   = H|bvzumaschkostvar
            .copy   M|tbvzgkmaschkostvar  = H|bvzugkmaschkostvar
            .copy   M|tbvzulohnkost       = H|bvzulohnkost
            .copy   M|tbvzugklohnkost     = H|bvzugklohnkost
            .copy   M|tbvzusonderkostfix  = H|bvzusonderkostfix
            .copy   M|tbvzusonderkostvar  = H|bvzusonderkostvar
            .copy   M|tbvzumatkost        = H|bvzumatkost
            .copy   M|tbvzugkmatkost      = H|bvzugkmatkost
            .copy   M|tbvalleabgaenge     = H|bvalleabgaenge
        
            .select continue
    }
} 

def buildSelectionString( ) {
    .call checkIfId()
    .formula M|select = "$,"
    .formula M|select = M|select + ";" + M|suchfeld + "=" + M|prodgrpvon + "!" + M|prodgrpbis ? _U|selectOverId
    .formula M|select = M|select + ";id=" + M|prodgrpvon + "!" + M|prodgrpbis                 ? U|selectOverId
    .formula M|select = M|select + ";" + "pgerlo="        + M|pgerlo                          ? _F|empty(M|pgerlo)
    .formula M|select = M|select + ";" + "pgkst="         + M|pgkst                           ? _F|empty(M|pgkst)
    .formula M|select = M|select + ";" + "uebest="        + M|uebest                          ? _F|empty(M|uebest)
    .formula M|select = M|select + ";@gruppe=29;gruppe=29"
} 

def emptyTable( ) { 
    .input "is/TABLEEREN"
} 

def checkRange( ) { 
    .input "is/RANGECHECK"
    .assign M|suchfeld = U|xxtfield
}

def checkIfId( ) {
    .assign U|selectOverId = M|prodgrpvon / "\((0-9)*,(0-9)*,0\)"
} 
