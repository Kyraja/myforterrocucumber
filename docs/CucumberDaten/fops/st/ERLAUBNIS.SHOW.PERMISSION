..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.SHOW.PERMISSION
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Erzeugt eine Erlaubniszeile.
.. Functionality  : Create a permission row.
..*****************************************************************************
.set trans -
..
.make screen line +O
.copy M|tpasswort = M|aktpasswort
.copy M|tmitarbeiter = M|tpasswort^mitarb
.assign M|tbezeich = M|tpasswort^bezeich
.assign M|tabteilung = M|tpasswort^abteilung
.copy M|tinaktiv = M|tpasswort^inaktiv
.copy M|tfremdok = M|tpasswort^fremdok
.copy M|tarber2 = M|tpasswort^arber2
.assign M|ttzeilen = H|tzeilen
.continue TIPPED ? M|kgetippt
..
.. Set special fields for a database command permission
.copy M|tkomsymbol = M|dateisymbol
.assign M|tdateinr = M|kdbkomnr
.assign M|tkommando = M|kdbkomname
.continue GRPPERM ? M|kgrperlaubnis
.copy M|tgrperlaubnisse = F|groupPermissions(M|kdbkomnr, , M|aktpasswort)
.continue ACTIONS
..
!GRPPERM: Set special fields for group-specific permissions
.formula M|tgruppe = U|xi
.assign M|tvartab = F|formatstr("$,,@datenbank=12:26;typ==(Original);vdn=={1};vgr=={2}", M|kdbkomnr, M|tgruppe)
..
!ACTIONS: setting actions
.formula M|aktindex = M|startindex + 1
..
!NEXTACT
.continue ENDACT ? M|aktindex > G|maxkaktnam
.copy M|taktion.aktindex = F|cmdpermitted(M|kdbkomnr, M|aktindex, M|aktpasswort) ? F|empty(M|tvartab)
.copy M|taktion.aktindex = F|cmdpermitted(M|kdbkomnr, M|aktindex, M|aktpasswort, M|tgruppe) ? _F|empty(M|tvartab)
.formula M|aktindex = M|aktindex + 1
.continue NEXTACT
..
!ENDACT: Handle permissions of database groups
.continue END ? _M|tgrperlaubnisse
.input "st/ERLAUBNIS.SHOW.DBGROUPS"
.continue END
..
!TIPPED: Set special fields for a tipped comannd permission
.copy M|tgetippt = M|kgetippt
.copy M|tkomsymbol = M|tippsymbol
.assign M|tdateinr = M|kdbkomnr
.assign M|tkommando = M|kdbkomname
.copy M|ttipperlaubt = F|tcmdpermitted(M|kdbkomnr, M|aktpasswort)
..*****************************************************************************
!END
.continue
