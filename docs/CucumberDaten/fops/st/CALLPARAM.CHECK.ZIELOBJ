..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CALLPARAM.CHECK.ZIELOBJ
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : xg
.. Functionality  : Regarding to the permissions of the operator, this will check
.. visibility of the callparameter loaded in buffer 0. Expects receiver of
.. callparameter in buffer D.
..*****************************************************************************
.set trans -
..
.. Declarations
.type integer xdnr    ? _F|defined(U|xdnr)
.type integer xgrp    ? _F|defined(U|xgrp)
.type integer xknr    ? _F|defined(U|xknr)
..
.. Initializations
.copy U|xvisible = G|FALSE
.copy U|xerrmessage = ""
.assign U|xgrp = D|gruppe
.assign U|xdnr = D|dnr
.continue INFOSYS ? 0|zielinfosys
..
.. We have a table of variables
.assign U|xdnr = D|vdn
.assign U|xgrp = D|vgr
..
.. Is target valid?
.continue NODB ? U|xdnr = U|XNODB1 ; U|xdnr = U|XNODB2
..
.. Get mode number
.assign U|xknr = F|value(0|zielmodus, "AN120")
..
.. Do we have a allowed working space?
.continue PERMS ? _F|defined(D|arb)
.continue PERMS ?  F|diraccessible(D|arb)
.continue NODIR
..
!INFOSYS: Check permission of infosystem
.continue VISIBLE ? F|infosyspermitted(0|zielobj)
.continue NOPERMS
..
!PERMS: Check permissions of data object
.continue VISIBLE ? F|cmdpermitted(U|xdnr, U|xknr, , U|xgrp)
.continue NOPERMS
..
!VISIBLE: call of dataobject is allowed
.copy U|xvisible = G|TRUE
..*****************************************************************************
!END
.continue
..*****************************************************************************
.set trans +
..
!NODIR: The working space of the target is not allowed!
.assign U|xerrmessage = F|formatstr("Der Arbeitsbereich {1} seines Zielobjektes {2} ist nicht erlaubt", D|arb, D|nummer)
.continue END
..
!NOPERMS: The target itsself is not allowed!
.assign U|xerrmessage = F|formatstr("Das Zielobjekt {1} ist nicht erlaubt", D|nummer)
.continue END
..
!NODB: This database is not a valid database!
.assign U|xerrmessage = F|formatstr("Das Zielobjekt {1} wird nicht unterstÅtzt", D|nummer)
.continue END
