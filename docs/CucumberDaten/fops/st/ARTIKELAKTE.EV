..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTIKELAKTE.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Datensammler fuer Business-App "Artikelakte"
.. Functionality  : Data miner for Buisiness App "Product File"
..*****************************************************************************
.set trans -
..
..  Event evaluation
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue ARTIKEL ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kartikel"
.continue TABINIT ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kkunde"
.continue TABINIT ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kvon"
.continue TABINIT ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "kbis"
.continue BOOL    ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar / "kb*"
.continue BASIS   ?  G|evtartengl  = "FIELD_EXIT"      &  G|evtvar = "basisartikel"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!BASIS
.formula M|kartikel = "" ? _F|empty(M|basisartikel)
.continue TABINIT
..
!ARTIKEL
.formula M|kurl = ""
.formula M|kurl = M|kurlleer + "&product=" + 'M|kartikel^id'  ? _F|empty(M|kartikel) & _F|empty(M|kurlleer)
.copy M|klagereinheit = M|kartikel^le
.assign M|basisartikel = M|kartikel^basisartikel ? _F|empty(M|kartikel)
.continue TABINIT
..
!BOOL
.copy M|kbversand         = G|false
.copy M|kboffeneauftraege = G|false
.copy M|kbungebuchtels    = G|false
.copy M|kbgeliefert       = G|false
.copy M|kbbeschaffung     = G|false
.copy M|kbbestand         = G|false
.copy M|kbfertigung       = G|false
.copy M|kbbestellungen    = G|false
.formula M|.evtvar = G|true
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.copy M|kmaxanzahl = 0
.copy M|kmaxmenge = 0.0
.continue END
..*****************************************************************************
!END
.continue
