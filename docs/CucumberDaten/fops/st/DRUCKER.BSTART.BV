..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DRUCKER.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : TeamReport
.. Kontrolle      :
.. Funktion       : Formuliert die Datenbankanfrage.
.. Functionality  : Builds database query.
..*****************************************************************************
.set trans -
..
.. Check items
.continue ERROR1 ? _M|kstandard & _M|keigene
.continue ERROR2 ? _M|kaktiv & _M|kinaktiv
..
.. Clear table
.make screen line -- ? M|tzeilen > 0
..
.. Build database query
.formula M|select = "$,,;gruppe==1"
..
.. Asking for standard or own printers
.continue ACTIVE ? (M|kstandard & M|keigene)
.formula M|select = M|select + ";nummer=!99999"  ? M|kstandard
.formula M|select = M|select + ";nummer=!" ? M|keigene
..
!ACTIVE: Asking for active or inactive ones
.continue TYPE ? (M|kaktiv & M|kinaktiv)
.formula M|select = M|select + ";aktiv=" + 'G|TRUE'  ? M|kaktiv
.formula M|select = M|select + ";aktiv=" + 'G|FALSE' ? M|kinaktiv
..
!TYPE: Asking for type of the printers
.continue LOCATIN ? F|empty(M|kdruckertyp)
.formula M|select = M|select + ";druckertyp==" + 'M|kdruckertyp(L="0")'
..
!LOCATIN: Asking for location of the printers
.continue END ? F|empty(M|kstandort)
.formula M|select = M|select + ";standort==" + 'M|kstandort'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -line 0 -field M|kstandard -message Bitte angeben, ob Standard- oder eigene Drucker gesucht werden!
.end 1
..
!ERROR2
.error -line 0 -field M|kaktiv -message Bitte angeben, ob aktive oder inaktive Drucker gesucht werden!
.end 1
