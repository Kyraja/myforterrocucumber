..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ARCHIV.BSTART.BV
.. Autor          : kop
.. Verantwortlich : teamreport
.. Kontrolle      : mg
.. Funktion       : Bestimmt aus den Eingabefeldern die Datenbankanfrage.
.. Ablauf         : Button-vor-EFOP
..
.. Functionality  : Gets database query from the input fields.
.. Program flow   : Button after efop
..*****************************************************************************
.set trans -
..
!BUILD: Build query
.input "is/TABLEEREN"
..
.continue LAYLEER  ? F|empty(M|layout)
.continue LAYINAKT ? _M|layout^aktiv
..
.copy M|archiv = M|layout^archiv
.copy M|archivpfl = M|layout^archivpfl
..
.formula M|select = "!"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!LAYLEER
.cursor layout 0
.error Kein Layout angegeben.
.end 1
..
!LAYINAKT
.cursor layout 0
.error Layout ist nicht aktiv und kann nicht gedruckt werden.
.end 1
