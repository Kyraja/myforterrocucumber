..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUFRUFPARAMETER.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Datenbankanfrage absetzen und Treffer auswerten.
.. Functionality  : Query database and analyse hits.
..*****************************************************************************
.set trans -
..
.. Declarations
.type VP13 xsource
..
.. Initialize
.copy U|xsource = M|aufrktxt
.copy M|stufe = 0
..
.. While changing buffers save test mode into local variable
.type bool xxtestmode
.copy U|xxtestmode = M|testmode
..
.set ascreen + ? _U|xxtestmode
.input "is/FOP.BUINFOSYS.INIT"
.set ascreen - ? _U|xxtestmode
..
.assign M|menuetitel = U|xtitle
.assign M|stufe = M|stufe + 1
.continue SINGLE ? _F|empty(M|aufruf)
..
.. Looking for a matching menu
.select group "ID87:30" 'M|select'
.continue FIRSTROW ? _G|mehr
.assign M|menuapliste = H|id
.assign M|menuetitel = U|xatitle ? M|buttonfeld = "buaktion"
.assign M|stufe = M|stufe + 1
.. Select only active rows
.select line 'F|formatstr("$,,;aktiv={1};tbaumstufe<={2}", F|condexpr(M|aktiv, G|TRUE, ""), M|anzstufen)'
.continue CHCKROW
..
!NEXTROW
.select line
!CHCKROW
.continue FIRSTROW ? _G|mehr
.continue ENTRY ? F|equals(H|zeilentyp, "(MenuItem)")
..
!TABROW: Create a row
.input 'M|tab' ? _F|empty(M|tab)
.continue NEXTROW
..
!ENTRY: Load callparameter in buffer 0
.load 0 object 'H|aufruf^id'
.continue NEXTROW ? _G|mehr
.continue TABROW
..
!FIRSTROW: Mark first row
.continue HINT01 ? F|empty(M|tzeilen)
.. wegen GUI Fehler auskommentiert
..cursor tbaumtext 1
.continue END
..
!SINGLE: Load single callparameter specified in M|aufruf
.load 0 object 'M|aufruf^id'
.continue END  ? _G|mehr
.input 'M|tab' ? _F|empty(M|tab)
..*****************************************************************************
!END
.continue
..*****************************************************************************
!HINT01: Make a dummy row and comment
.make screen line +
.assign M|tbaumstat = ""
.copy M|tbaumstufe = M|stufe
.assign M|tbauminfo = M|menuetitel
.atext -language 'G|bsprache' M|tbaumtext 364 Empty menu
.assign M|tzeilentyp = ""
.copy M|taktiv = G|FALSE
.copy M|tmenuemoeglich = G|FALSE
.assign M|tdialogart = ""
.continue END
