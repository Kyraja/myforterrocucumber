..!interpreter english translate noabbrev
..*****************************************************************************
.. Name               : ARTBER.EV
.. Autor              : pw
.. Verantwortlich     : cl
.. Kontrolle          : amk
.. Funktion           : Infosystem Artikelbereichshierarchie: Eventbehandlung
.. Ablauf             : Behandelt alle Feld- und Button-Events, insbes. auch
..                      das Druecken auf Auf-/Zu-Button.
...Includes           :
.. include  st/ARTBER.TABLEEREN
..*****************************************************************************
.set trans -
..
..  ---------------------------------------------------------------------------
..  Kopfteil/Header
..  ---------------------------------------------------------------------------
.continue PRRANGE ? G|evtartengl="FIELD_EXIT"   & G|evtvar="abereich"
.continue CLRTAB  ? G|evtartengl="FIELD_EXIT"   & G|evtvar="selkategorie"
.continue CLRTAB  ? G|evtartengl="FIELD_EXIT"   & G|evtvar="nuraktiv"
.continue CLRTAB  ? G|evtartengl="FIELD_EXIT"   & G|evtvar="anzstufen"
.continue GETELEM ? G|evtartengl="BUTTON_AFTER" & G|evtvar="kbustufe"
.continue GETELEM ? G|evtartengl="BUTTON_AFTER" & G|evtvar="kbuverwend"
..  ---------------------------------------------------------------------------
..  Tabelle/Table
..  ---------------------------------------------------------------------------
.continue GETELEM ? G|evtartengl="BUTTON_AFTER" & G|evtvar="tbustufe"
.continue GETELEM ? G|evtartengl="BUTTON_AFTER" & G|evtvar="tbuverwend"
..  ---------------------------------------------------------------------------
.continue END
..
!PRRANGE: Getting description of product range
.formula M|abereichname  = M|abereich^sucherw
.continue CLRTAB
..
!GETELEM: Get element
.type VP99  xxmyobject
.continue EVTROW ? G|evtzeile > 0
.assign U|xxmyobject = M|kabereich
.continue BUTTON
..
!EVTROW
.assign U|xxmyobject = M|tabereich
..
!BUTTON
.continue END ? F|empty(U|xxmyobject)
.continue EXEC    ? G|evtartengl="BUTTON_AFTER" & (G|evtvar="kbustufe" ; G|evtvar="tbustufe")
.continue USEDLST ? G|evtartengl="BUTTON_AFTER" & (G|evtvar="kbuverwend" ; G|evtvar="tbuverwend")
.continue END
..
!EXEC: Execute command
.input "is/EXEC.COMMAND4REFERENCE"
.continue END
..
!USEDLST: Where-used list
.command -parallel 'F|formatstr("(Infosystem) ABVERWENDB ? abereich={1} | bstart=1", U|xxmyobject^id)'
.continue END
..
!CLRTAB: Clear table
.input "st/ARTBER.TABLEEREN"
..*****************************************************************************
!END
.continue
