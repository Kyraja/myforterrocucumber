..!interpreter declaration english translate
..*****************************************************************************
..  FOP-Name       : KURSHIST.EV
..  Datum          : 05.04.2005
..  Version        : 1
..  Autor          : male
..  Verantwortlich : cl
..  Kontrolle      : tiwe
..  Funktion       : Allgemeines Event-FOP des Infosystems KURSHIST
..
..  Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
..    Parameter    Bedeutung
..    ---------------------------------------------------------
..    xp...        ...
..
..  Ablauf         :
..
..  Functionality  : Event FOP for the Infosystem KURSHIST
..
..  Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    ---------------------------------------------------------
..    xp...        ...
..
..  Program flow  :
... Includes      :
..*****************************************************************************
..
..
..
..*****************************************************************************
..
..*****************************************************************************
.set trans -
.input "is/TABLEEREN"
..
.continue START   ? (G|evtvar = "bstart") & (G|evtartengl = "BUTTON_BEFORE")
.continue CHKCURR ? (G|evtvar = "inland") & (G|evtartengl = "FIELD_FILL")
.continue CHKDAT  ? ((G|evtvar = "startdat") ; (G|evtvar = "enddat")) & (G|evtartengl = "FIELD_FILL")
.continue END
..
..*****************************************************************************
!START: Start
..*****************************************************************************
.continue ERR01 ? +'M|waehr' = 0
..
.formula M|select = "$,;@gruppe=1;gruppe=1;fwaehr=" + 'M|waehr^id'
.formula M|select = M|select + ";kursdat=" + 'M|startdat' + "!" + 'M|enddat'
.formula M|select = M|select + ";@ordnung=kursdat"
..
.input "is/HOL.LISTE"
..
.continue END
..
..*****************************************************************************
!CHKCURR: Check domestic currency
..*****************************************************************************
.continue END ? +'G|evtfeldneu' = 0
.type bool xb
.select currency 'G|evtfeldneu'
.continue ERR02 ? _G|mehr
.formula U|xb = ('H|such' = 'G|inland') ; ('H|such' = 'G|ainland') ; ('H|such' = 'G|ninland')
.continue ERR02 ? _U|xb
.continue END
..
..*****************************************************************************
!CHKDAT: Check dates
..*****************************************************************************
.continue END ? +'G|evtfeldneu' = 0
.type GD xdstart xdend
.assign U|xdstart = G|evtfeldneu ? G|evtvar = "startdat"
.assign U|xdstart = M|startdat   ? G|evtvar = "enddat"
.assign U|xdend   = G|evtfeldneu ? G|evtvar = "enddat"
.assign U|xdend   = M|enddat     ? G|evtvar = "startdat"
.continue ERR03 ? +'U|xdstart' > 0 & +'U|xdend' > 0 & U|xdstart > U|xdend
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.box Fehler
Keine WÑhrung angegeben.
.error
.end 1
..
..*****************************************************************************
!ERR02
..*****************************************************************************
.box Fehler
Keine gÅltige InlandswÑhrung angegeben.
.error
.end 1
..
..*****************************************************************************
!ERR03
..*****************************************************************************
.box Fehler
Startdatum grî·er als Enddatum.
.error
.end 1

