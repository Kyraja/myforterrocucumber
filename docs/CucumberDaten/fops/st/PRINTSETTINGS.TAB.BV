.set trans -
.select screen line 'G|evtzeile'
.continue END ? F|empty(M|tlayout)
.assign M|drucker = M|tdrucker
.assign M|layout = M|tlayout
.copy M|anzahl = M|tanzahl       ? F|modifiable(M|anzahl) & _F|empty(M|tanzahl)
.copy M|exemplare = M|texemplare ? F|modifiable(M|exemplare) & _F|empty(M|texemplare)
.input "PRINTSETTINGS.TAB.AP" ? _F|empty(M|tdraufruf); _F|empty(M|tpraufruf)
.input 'M|tpreprint'          ? _F|empty(M|tpreprint)
.formula M|vorschau = M|tvorschau
!END
.continue
