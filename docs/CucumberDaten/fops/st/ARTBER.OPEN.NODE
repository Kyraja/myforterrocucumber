..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTBER.OPEN.NODE
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : amk
.. Funktion       : Bearbeitet einen Knoten.
.. Functionality  : Opens a node.
..*****************************************************************************
.set trans -
..
.. Declarations
.type VID30 xprodrange ? _F|defined(U|xprodrange)
.continue GETNODE ? _F|empty(U|xprodrange)
.continue END ? _F|defined(M|tabereich)
.continue END ? F|empty(M|tabereich)
.assign M|stufe = M|tbaumstufe
.copy U|xprodrange = M|tabereich
..
!GETNODE
.select object 'U|xprodrange'
.continue END ? _G|mehr
.formula M|selectrows = "$,,;catactiv="
.continue CATEGRY ? _M|nuraktiv
.formula M|selectrows = M|selectrows + 'M|nuraktiv'
..
!CATEGRY
.continue SELROW ? F|empty(M|selkategorie)
.formula M|selectrows = M|selectrows + ";kategorie=" + M|selkategorie^id
..
!SELROW
.select line 'M|selectrows'
..
!HASROW: Do we have a row?
.continue END ? _G|mehr
..
!HANDROW: Handle row
.continue TABROW ? F|empty(H|selekt)
..
!HANDBAR: Handle bar in row
.continue BARTYP1 ? H|selekt^typ = 1
.continue BARTYP2 ? H|selekt^typ = 2
.continue NEXTROW
..
!BARTYP1
.load 2 parts 'F|formatstr("${1},,@initialwert=(1);@maxtreffer={2}", H|selekt^id, M|kmaxleiste)'
.continue HASPART
..
!BARTYP2
.load 2 parts 'F|formatstr("$,,;sach={1};@maxtreffer={2}", H|selekt^id, M|kmaxleiste)'
..
!HASPART: Do we have a part using bar?
.continue NEXTROW ? _G|mehr
.input 'M|tab' ? _F|empty(M|tab)
..
.load 2 parts
.continue HASPART
..
!TABROW: Create a table row
.input 'M|tab' ? _F|empty(M|tab)
..
!NEXTROW
.select line
.continue HASROW
..*****************************************************************************
!END
.continue
