..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : SELECT.REPLACEMENT.PART
.. Author         : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  : Selects in U|xhit the first part that replaces specified
.. part regarding to the specified date conditions.
..
.. Name:         Description:
.. ----------------------------------------------------------------------------
.. xpart         Part that should be replaced
.. xmaxprocure   Date of last procurement of the replacement
.. xmaxusage     Date of last usage of the replacement
..*****************************************************************************
.set trans -
..
.. Definitions
.type GD        xmaxprocure ? _F|defined(U|xmaxprocure)
.type GD        xmaxusage   ? _F|defined(U|xmaxusage)
.type ID2:1     xpart       ? _F|defined(U|xpart)
.type ID2:1     xoriginal   ? _F|defined(U|xoriginal)
.type ID2:1     xreplace    ? _F|defined(U|xreplace)
.type ID2:1     xhit        ? _F|defined(U|xhit)
.type text      xselect     ? _F|defined(U|xselect)
..
.continue USAGE ? F|empty(U|xpart)
.continue END   ? F|empty(U|xpart^nachfolgeartikel)
..
.. Default hit is empty
.assign U|xhit = ""
..
.copy U|xreplace = U|xpart
..
!NEXT
.copy U|xoriginal = U|xreplace
.continue END ? F|empty(U|xoriginal)
.copy U|xreplace = U|xoriginal^nachfolgeartikel
.add U|xoriginal
.continue END ? _G|mehr
..
.continue PROCURE ? F|empty(D|lverwdatum)
.continue PROCURE ? F|empty(U|xmaxusage)
.continue NEXT    ? D|lverwdatum < U|xmaxusage
..
!PROCURE
.continue HIT     ? F|empty(D|lbsdatum)
.continue HIT     ? F|empty(U|xmaxprocure)
.continue NEXT    ? D|lbsdatum < U|xmaxprocure
..
!HIT
.assign U|xhit = D|id
.add
..*****************************************************************************
!END
.continue
..*****************************************************************************
!USAGE
..
.println -text Wrong ussage of the program
.println -text The argument U|xpart must not be empty.
.println -text The argument U|xpart is the discontinued part.
.println -text The argument U|xmaxprocure is the maximum date of procurement
.println -text The argument U|xmaxusage is the maximum date of use
.end 1
