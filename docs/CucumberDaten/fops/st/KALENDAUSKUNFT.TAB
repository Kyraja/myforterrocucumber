..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALENDAUSKUNFT.TAB
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem Kalenderauskunft: Tabellen-FOP
.. Functionality  :
.. Ablauf         :
..
..*****************************************************************************
.type ID137 xkal     ? _F|defined(U|xkal)
.type GD    xdat     ? _F|defined(U|xdat)
..
.set trans -
.formula U|xdat = M|enddat
.. 50 Jahre in die Zukunft
.formula U|xdat = 'F|expr(G|datum + 18250):8'  ? F|empty(U|xdat)
..
!NEXTKAL
.formula U|xkal = F|getwcal(M|bezobj, M|lgruppe, U|xdat)
.continue END                 ? F|empty(U|xkal)
..
!HOLKAL
.select calendar 'U|xkal'
.continue END _G|mehr
.select screen header
.make screen line +0
.assign M|tkal     = U|xkal
.assign M|tbezobj  = H|bezobj
.formula   M|tlgruppe = H|lgruppe
.copy M|tuebkal  = H|uebkal
.formula   M|tgltvon  = H|gltvon
.formula   M|tgltbis  = H|gltbis
.. Default
.assign M|ichtyp = "(WorkingDays)"
.. if customer
.assign M|ichtyp = "(ReceiptDays)" ? M|bezobj^dnr = 0
.. if supplier
.assign M|ichtyp = "(DeliveryDays)" ? M|bezobj^dnr = 1
..
.continue END                 ? F|empty(M|tgltvon) ; M|tgltvon <= M|anfdat
.copy U|xkal = H|vorgaenger
.continue HOLKAL              ? _F|empty(H|vorgaenger)
.formula U|xdat = M|tgltvon -1
.continue NEXTKAL
..
!END
.continue
