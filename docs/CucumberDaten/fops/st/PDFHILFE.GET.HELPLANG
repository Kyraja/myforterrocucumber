..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PDFHILFE.GET.HELPLANG
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : mg
.. Funktion       : Ermittelt in xlang den Kennbuchstaben der Hilfssprache in M|hsprache.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Gets in xlang the letter of the help language in M|hsprache.
..  Program flow  : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type A74   xlang  ? _F|defined(U|xlang)
.type A74   xoplang
.type AS161 xhlang
..
.assign U|xoplang = G|bsprache
..
.. Will help language be automatically defined?
.assign U|xhlang = M|hsprache
.continue AUTOMAT ? U|xhlang = "(Automatic)"
.assign U|xlang = U|xhlang
.continue ENGLISH ? _G|mehr
.continue SETHSPR
..
!AUTOMAT: is operating language a supported help language
.assign U|xhlang = U|xoplang
.continue ENGLISH ? _G|mehr
.assign U|xlang = U|xhlang
.continue ENGLISH ? _G|mehr
.continue SETHSPR
..
!ENGLISH: use default
.assign U|xoplang = "E"
.assign U|xhlang = U|xoplang
.continue GERMAN ? _G|mehr
.assign U|xlang = U|xhlang
.continue SETHSPR
..
!GERMAN: use german as last possibility
.assign U|xoplang = "D"
.assign U|xlang = U|xoplang
..
!SETHSPR: sets item "hspr"
.assign M|hspr = F|tolower('U|xlang')
.assign M|pfadquellen = F|formatstr("{1}/handbuch/h{2}/xml", E|HOMEDIR, M|hspr)
.assign M|pfadziele = F|formatstr("help/h{1}/output/pdf", M|hspr)
..*****************************************************************************
!END
.continue
