..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Formuliert und plausibilisiert die Datenbankanfrage.
.. Ablauf         : Button-vor-EFOP
..
.. Functionality  : Builds und checks the database query.
.. Program flow   : Before button efop
..*****************************************************************************
.set trans -
..
.. Check items
.continue ERROR1 ? _M|dateikom & _M|tippkom
.continue ERROR2 ? _M|datkomda & (M|kdatname <> "" ; M|kaktname <> "")
.continue ERROR3 ? _F|cmdpermitted(M|firmanr, M|zeigennr, G|passw)
..
.. Clear table while everything is fine
.make screen line -- ? M|tzeilen > 0
..
.. Initializations
.copy M|kgrperlaubnis = G|FALSE
.formula M|select = "$,,"
..
.. Build query for passwords
..
.. Always setting activation flag
.formula M|select = M|select + ";gruppe=11;inaktiv=" + 'M|inaktiv'
.continue STAFFER ? F|empty(M|passwort)
.formula M|select = M|select + ";id==" + M|passwort^id
..
!STAFFER: add criteria for staff personnel if neccessary
.continue PERMISS ? F|empty(M|mitarbeiter)
.formula M|select = M|select + ";mitarb=" + M|mitarbeiter^id
..
!PERMISS: add criterias for permission if neccessary
.continue SECTION ? F|empty(M|erlaubnis)
.formula M|select = M|select + ";@zeilen=" + 'G|TRUE'
.formula M|select = M|select + ";rechte=" + M|erlaubnis^id + ";rechteakt=" + 'G|FALSE' ?  M|erlinaktiv
.formula M|select = M|select + ";rechte=" + M|erlaubnis^id + ";rechteakt=" + 'G|TRUE'  ? _M|erlinaktiv
..
!SECTION: add criteria for a section if neccessary
.continue GROUP ? F|empty(M|abteilung)
.formula M|select = M|select + ";abteilung==" + M|abteilung
..
!GROUP: add option for group
.formula M|select = M|select + ";@gruppe=11;@ablageart=(Active)"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -message Bitte angeben, ob Datenbank-, Tipp- oder beide Kommandoarten gezeigt werden sollen!
.end 1
..
!ERROR2
.error -line 0 -field M|kdatname -message Funktion ist nicht durchfÅhrbar. ErgÑnzen Sie die unvollstÑndige Datenbankkommandoangabe! ? M|kdatname = ""
.error -line 0 -field M|kaktname -message Funktion ist nicht durchfÅhrbar. ErgÑnzen Sie die unvollstÑndige Datenbankkommandoangabe! ? M|kaktname = ""
.end 1
..
!ERROR3
.error -message Die Funktion ist nicht erlaubt. Dem Bediener fehlt die Erlaubnis: Firma zeigen.
.end 1
