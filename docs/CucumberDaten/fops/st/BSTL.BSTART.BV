..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BSTL.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Eingabeparameter.
.. Functionality  : Validates input parameters.
..*****************************************************************************
.set trans -
..
.continue ERROR1 ? F|empty(M|artikel)
.continue ERROR2 ? F|empty(M|lgruppe)
.continue ERROR3 ? _F|empty(M|fertliste) & M|artikel^id <> M|fertliste^artikel^id
.continue ERROR4 ? _F|empty(M|fertliste) & M|lgruppe^id <> M|fertliste^lgruppe^id
..
.. Everything seems to be fine
.. Clear table
.make screen line -- ? M|tzeilen > 0
..
.. Initializations
.assign M|stufe = 1
.assign M|maskenzeile = 0
..
.. Create initial database query
.formula M|select = M|artikel^id
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: No part is found
.error -field M|artikel -message Bitte zuerst den Ausgangsartikel eintragen!
.end 1
..
!ERROR2: No warehouse group is found
.error -field M|lgruppe -message Es fehlt die Angabe einer Lagergruppe!
.end 1
..
!ERROR3: Production list and part do not fit
.error -field M|fertliste -message Die Fertigungsliste 'F|trim(F|tostring(M|fertliste))' passt nicht zum angegebenen Teil 'F|trim(F|tostring(M|artikel))'!
.end 1
..
!ERROR4: Warehouse groups in production list and part do not fit
.error -field M|fertliste -message Die Lagergruppe der Fertigungsliste 'F|trim(F|tostring(M|fertliste))' ist eine andere als die angegebene 'F|trim(F|tostring(M|lgruppe))'!
.end 1
