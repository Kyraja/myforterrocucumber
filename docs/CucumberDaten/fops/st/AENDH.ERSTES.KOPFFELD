.set trans -
.. alle Kopffelder sind leer
.continue END ? F|empty(M|ausloeser2kopf) & F|empty(M|ausloeserkopf) & F|empty(felderkopf)
.input "st/AENDH.ERSTES.KOPFTITEL"   ? _U|kopftitelerledigt
..
.continue END  ? _M|auchneu
.make screen line +O
.assign M|tnummer = M|kid  ? _F|empty(M|kid)
.assign M|tsnummer = M|kid ? _F|empty(M|kid)
.copy M|typk = U|xtypk
.copy M|typt = U|xtypt
.copy M|tzeitpunkt = U|itstand
.copy M|tfeldname = U|stringlistekopf
.set foextern -
.assign T|wertneu = '1|.U|stringlistekopf'
.set foextern +
.assign M|tneu = T|wertneu
.assign M|talt = "-"
.copy M|tversionn = 1|versionn
.copy M|tbearbeiter = U|itzeichen
..*****************************************************************************
!END
.continue
