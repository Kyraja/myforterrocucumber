..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VORG.KASK.DURCH
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Durchlaeuft Vorgang
.. Ablauf         : Unterprogramm
.. Function       : Runs through a process
.. Program flow   : Subroutine
...Includes       :
.. include st/TT.PJ.BEARB
.. *****************************************************************************
.set trans -
..
.. Validate
.continue END ? F|empty(M|objektnum)
.continue END ? M|objektnum^gruppe <> 1 & M|objektnum^gruppe <> 2
..
.. Declarations
.type ID86 xprocess ? _F|defined(U|xprocess)
..
.. Initializations
.copy U|xprocess = M|objektnum^id
..
.. Start transaction
.set cancel -
.action +
..
.continue CASCADE ? U|xprocess^gruppe = 1 & M|kbkaskad
..
!PROCESS: Edit single process
.select lock transaction 'U|xprocess'
.input "st/TT.PJ.BEARB"
.continue TEND
..
!CASCADE: Cascading edit of project
.select lock transaction 'F|formatstr("$,,;projekt={1};@ablageart=(Active);@gruppe=2", U|xprocess)'
!CHCKTT
.continue PROCESS ? _G|mehr
.input "st/TT.PJ.BEARB"
.select lock transaction continue
.continue CHCKTT
..
!TEND: End of transaction
.action -
.set cancel +
.. *****************************************************************************
!END
.continue
