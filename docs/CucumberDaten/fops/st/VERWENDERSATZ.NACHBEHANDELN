..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VERWENDERSATZ.NACHBEHANDELN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : amk
.. Funktion       : Erledigt Nachbehandlungen nach dem EinfÅgen von Zeilen. Das
.. ist das Setzen von Schreibschutzen fÅr die Ersetzen-Buttons und das Berechnen
.. von Kennsummen im Kopf, in den Bauteilen sowie in den Verwendungen.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Does some reworking after filling a row: Sets protections
.. for buttons of substitution and calculates some identifying sums for the header,
.. the components and the usings.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.continue COMPONT ? M|bautwechsel
.continue REPLACE
..
!COMPONT: Update details while component has changed
.select screen line 'M|bauteilort'
.continue FATAL ? _G|mehr
.continue PROTECT ? M|bauteilers = 0
..
.. No protection for substitution function
.assign M|tbuersetzen = M|ersatzsymbol
.protection -reset tbuersetzen 'M|aktzeile'
.copy M|tersetzbar = G|TRUE
.continue REPOS
..
!PROTECT: protect component
.protection tbuersetzen 'M|aktzeile'
.continue REPOS
...............................................................................
!REPLACE: Is using substitutable?
.continue SUBSTIT ? M|aktersetzbar
..
.. Element is not substitutable
.protection tbuersetzen 'M|aktzeile'
.continue UPDATE
..
!SUBSTIT: Element is substitutable
.formula M|ersatzzahl = M|ersatzzahl + 1
.protection -reset tbuersetzen 'M|aktzeile'
.assign M|tbuersetzen = M|ersatzsymbol
.continue UPDATE
..
!UPDATE: Update component
.select screen line 'M|bauteilzeile'
.continue FATAL ? _G|mehr
.formula M|bauteilverw = M|bauteilverw + 1
.formula M|bauteilers = M|bauteilers + 1 ? M|aktersetzbar
.continue REPOS
...............................................................................
!REPOS: repositioning to former current row
.select screen line 'M|kaktzeile'
.continue FATAL ? _G|mehr
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
