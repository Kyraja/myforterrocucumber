..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PACKMATERIAL.EV.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : simple field exits -> reset table rows
..*****************************************************************************
.set trans -
..
..<META M|='st/PACKMATERIAL'>
..
.type ID87:9 xcallparam
..
.. Event evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue VIEW    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar / "*view"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "ksuch"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "ksucherw"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kfbetreuer"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpmtyp"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kvpkenn"
.continue INIT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbsart"
.. ----------- ---------- ---------- -------------------------------------------
.continue AP1     ?  G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbukunbez"
.continue AP2     ?  G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbukonto"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!VIEW
.copy M|defaultview = G|false
.copy M|dimensionsview = G|false
.copy M|salesview = G|false
.copy M|purchasingview = G|false
.copy M|tradeview = G|false
.copy M|schedulingview = G|false
.copy M|warehouseview = G|false
.copy M|accountview = G|false
.formula M|.evtvar = 'G|true'
.formula P|maskkontextfop = "std"
.formula P|maskkontextfop = "dim"                ?  M|dimensionsview
.formula P|maskkontextfop = "sale"               ?  M|salesview
.formula P|maskkontextfop = "purch"              ?  M|purchasingview
.formula P|maskkontextfop = "sale purch"         ?  M|tradeview
.formula P|maskkontextfop = "dispo"              ?  M|schedulingview
.formula P|maskkontextfop = "warehouse account"  ?  M|warehouseview
.formula P|maskkontextfop = "account"            ?  M|accountview
.continue END   
..  
!AP1  
.continue END ? _M|tbkunbez
.assign U|xcallparam = "52961"
.input "st/CALLPARAM.EXEC"
.continue END
..
!AP2    
.continue END ? _M|tbkonto
.assign U|xcallparam = "52963"
.input "st/CALLPARAM.EXEC"
.continue END
..
!INIT: remove rows
.make screen line --  ?  M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue 
