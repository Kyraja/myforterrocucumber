..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALENDAUSKUNFT.EV
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem Kalenderauskunft: Eventbehandlung
.. Functionality  :
.. Ablauf         : Behandelt alle Feld- und Button-Events
..
..*****************************************************************************
.type VID99 xvid     ? _F|defined(U|xvid)
.type text  xtkomm   ? _F|defined(U|xtkomm)
..
.set trans -
..  ---------------------------------------------------------------------------
..  Kopfteil
..  ---------------------------------------------------------------------------
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="bezobj"
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="lgruppe"
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="anfdat"
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="enddat"
.continue LEEREN     ? G|evtartengl="BUTTON_AFTER"    & G|evtvar="bstart"
.continue KALENDER   ? G|evtartengl="BUTTON_AFTER"    & G|evtvar="bukalend"
..  ---------------------------------------------------------------------------
..  Tabellenteil
..  ---------------------------------------------------------------------------
.continue END
..
!KALENDER: Eigenen Kalender anzeigen bzw. neu anlegen
.. Dispokalender: gruppe = 1 ; Kapazit„tsangebot: gruppe = 2
.continue END ?  M|tzeilen = 0
.. first loop
.type ID87:9 xcallparam  ? _F|defined(U|xcallparam)
..
!ZEILE
.select screen line
.continue NEU      ? _G|mehr
.continue ZEILE    ? M|tbezobj^id <> M|bezobj^id
.continue ZEILE    ? M|tlgruppe^id <> M|lgruppe^id
.. liegt davor
.continue AEND     ? F|empty(M|anfdat) & G|datum < M|tgltvon
.. liegt mitten drin
.continue AEND     ? F|empty(M|anfdat) & G|datum >= M|tgltvon & G|datum <= M|tgltbis & _F|empty(M|tgltbis)
.. gr”áer als von, Ende offen
.continue AEND     ? F|empty(M|anfdat) & G|datum >= M|tgltvon & F|empty(M|tgltbis)
.continue ZEILE    ? F|empty(M|anfdat)
.continue AEND     ? M|anfdat >= M|tgltvon & F|empty(M|enddat)
.continue AEND     ? M|anfdat >= M|tgltvon & M|anfdat <= M|tgltbis & _F|empty(M|enddat)
.continue ZEILE
..
!AEND: Kalender „ndern
.assign U|xcallparam = "52742" ? M|tkal^gruppe = 1
.assign U|xcallparam = "52818" ? M|tkal^gruppe = 2
.continue CALLPARAM
..
!NEU: Kalender neu
.select screen line
.continue END   ? _G|mehr
.assign U|xcallparam = "52743" ? M|tkal^gruppe = 1
.assign U|xcallparam = "52819" ? M|tkal^gruppe = 2
..
!CALLPARAM
.input "st/CALLPARAM.EXEC"
.continue LEEREN
..
!START: Startbutton
.set trans +
.error Bitte erst ein Bezugsobjekt eintragen.     ? F|empty(M|bezobj)
.end 1                                            ? F|empty(M|bezobj)
.error Plausibilit„tsprfung                      ? F|empty(M|select)
.end 1                                            ? F|empty(M|select)
.set trans -
..
.input 'M|tab'                                   ? _F|empty(M|tab)
.continue END
..
!LEEREN
.input "is/TABLEEREN"
.continue START       ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bstart"
.continue END
..
!END
.continue
