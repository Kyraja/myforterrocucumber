.set trans -
.. ---------------------- Kopf/header - ---------------------------------------
.continue SEL        ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue CLRTAB     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "anzstufen"
.continue CLRTAB     ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "wirtschaftsr"
.. ---------------------- Tabelle/table ---------------------------------------
.. ----------------------------------------------------------------------------
.continue END
..
!SEL
.continue ERROR01 ? F|empty(M|wirtschaftsr)
.assign M|select = M|wirtschaftsr^id
.formula M|stufe = 0
.continue CLRTAB ? _M|treeview
..
.formula M|kkenn     = ""
.formula M|kkrname   = ""
.formula M|klaart    = ""
.formula M|kiso2     = ""
.formula M|kiso3     = ""
.formula M|kegkenn   = ""
.formula M|kegab     = ""
.assign M|kspr    = ""
.assign M|kwaeh   = ""
.formula M|ktelnr    = ""
.formula M|kischl    = ""
.formula M|keschl    = ""
.formula M|ktsuch    = ""
.assign M|knummer = ""
.formula M|kform     = ""
.formula M|ksprname  = ""
.assign M|kttyp   = ""
.formula M|kueberg   = ""
..
.colour -background -1 -1 -1  kkenn    ? M|kkenn     = ""
.colour -background -1 -1 -1  kkrname  ? M|kkrname   = ""
.colour -background -1 -1 -1  klaart   ? M|klaart    = ""
.colour -background -1 -1 -1  kiso2    ? M|kiso2     = ""
.colour -background -1 -1 -1  kiso3    ? M|kiso3     = ""
.colour -background -1 -1 -1  kegkenn  ? M|kegkenn   = ""
.colour -background -1 -1 -1  kegab    ? 'M|kegab'   = ""
.colour -background -1 -1 -1  kspr     ? M|kspr      = ""
.colour -background -1 -1 -1  kwaeh    ? M|kwaeh     = ""
.colour -background -1 -1 -1  ktelnr   ? M|ktelnr    = ""
.colour -background -1 -1 -1  kischl   ? M|kischl    = ""
.colour -background -1 -1 -1  keschl   ? M|keschl    = ""
.colour -background -1 -1 -1  ktsuch   ? M|ktsuch    = ""
.colour -background -1 -1 -1  knummer  ? M|knummer   = ""
.colour -background -1 -1 -1  kform    ? M|kform     = ""
.colour -background -1 -1 -1  ksprname ? M|ksprname  = ""
.colour -background -1 -1 -1  kttyp    ? M|kttyp     = ""
.colour -background -1 -1 -1  kueberg  ? M|kueberg   = ""
.continue CLRTAB
..
!WIRTSCHAFT
..
!CLRTAB: Clear table
.make screen line -- ? M|tzeilen > 0
