..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CRMWEITER.EV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Behandelt Feld- und Zeilenereignisse.
.. Ablauf         : Zentrales Ereignis-FOP
.. Function       : Handles field and row events.
.. Program flow   : Central event efop
..*****************************************************************************
.set trans -
..---------------------------- Header: ----------------------------------------
.continue BUSEL  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kbusel"
.continue CLRTAB ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kbvert"
.continue CLRTAB ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kbintern"
.continue CLRTAB ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kbextern"
.continue TT     ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kbaktionen"
.continue PJ     ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kbprojekte"
.continue ABS    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kmitarb"
.continue CLRTAB ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kdstart"
.continue CLRTAB ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kdbisstart"
.continue MARK   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "selall"
.continue UNMARK ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "deselall"
..==============================================================================
.continue END
..
!ABS: Exit sender
.continue KBVERT ? F|empty(M|kmitarb)
.protection -reset kbvert 0
.continue CLRTAB
..
!KBVERT: Deactivate representation
.protection kbvert 0
.copy M|kbvert = G|FALSE
.continue CLRTAB
..
!TT: Tasks clicked
.continue TTFALSE ? 'G|evtfeldneu' = 'G|FALSE' & _M|kbprojekte
.continue CLRTAB
..
!TTFALSE: Activate projects while tasks are deactivated
.copy M|kbprojekte = G|TRUE
.protection -reset kbkaskad 0
.continue CLRTAB
..
!PJ: Projects clicked
.continue PJFALSE ? 'G|evtfeldneu' = 'G|FALSE'
.protection -reset kbkaskad 0
.continue CLRTAB
..
!PJFALSE: Activate tasks while projects are deactivated
.copy M|kbaktionen = G|TRUE ? _M|kbaktionen
.copy M|kbkaskad = G|FALSE
.protection kbkaskad 0
.continue CLRTAB
..
!BUSEL: Button selection bar clicked
.formula G|evtfeldneu  = "%"
.input "is/KOPFLEEREN"
.protection kbkaskad 0
.input "is/AUSWAHL"
.copy M|kbsel = M|select <> "!"
.continue CLRTAB
..
!CLRTAB
.copy M|kbsel = G|FALSE ? _G|evtvar = "kbusel"
.input "is/TABLEEREN"
.continue END
..
!MARK: Mark all rows
.assign M|mark = "(SelectAll)"
.input "is/TAB.MARK"
.continue END
..
!UNMARK: Unmark all rows
.assign M|mark = "(DeselectAll)"
.input "is/TAB.MARK"
..*****************************************************************************
!END
.continue
