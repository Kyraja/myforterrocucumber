..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LLI.EV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt Eingabefelder mit einfacherer Funktionalitaet.
.. Ablauf         : Zentrales EFOP
..
.. Functionality  : Handles input fields which have a simple functionality.
.. Program flow   : Central efop
..*****************************************************************************
.set trans -
..------------------------------- Header -------------------------------------
.continue BSEL    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bselect"
.continue KUNDE   ? G|evtartengl = "FIELD_FILL"  & G|evtvar = "bkunde"
.continue SACH    ? G|evtartengl = "FIELD_FILL"  & G|evtvar = "bsach"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kkunde"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "knort"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kplz"
.continue INITSEL ? G|evtartengl = "FIELD_FILL"  & G|evtvar = "zuordnen"
..----------------------------------------------------------------------------
.continue END
..
!KUNDE
.formula G|evtfeldneu = 'G|TRUE' ? G|evtfeldneu = 'G|FALSE' & M|bsach = G|FALSE
.continue INITSEL
..
!SACH
.formula G|evtfeldneu = 'G|TRUE' ? G|evtfeldneu = 'G|FALSE' & M|bkunde = G|FALSE
.continue INITSEL
..
!BSEL
.assign M|kkunde = ""
.assign M|knort = ""
.assign M|kplz = ""
.copy M|bkunde = G|FALSE
.copy M|bsach = G|FALSE
.formula G|evtfeldneu = "%"
.input "is/AUSWAHL"
.formula M|selektion = M|select <> "!"
.continue CLRTAB
..
!INITSEL
.copy M|selektion = G|FALSE
..
!CLRTAB: Clear table
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
