..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : PACKSYS.BSTART.BN
.. Autor         : fwester
.. Verantwortlich: cl
.. Kontrolle     : lei
.. Funktion      : Fuehrt Datenbankanfrage aus und laedt verwendete Pakete.
.. Ablauf        : Button-nach-EFOP
..
.. Functionality : Executes database query and loads used packages.
.. Program flow  : After button efop
..*****************************************************************************
.set trans -
..
.continue OPENROW ? G|evtvar = "tbaumaufzu"
.continue BSTART  ? G|evtvar = "bstart"
.continue END
..
!OPENROW: opens a package
.select screen line 'G|evtzeile'
.continue FATAL ? _G|mehr
..
.formula M|stufe = M|tbaumstufe
..
.. form query for level
.continue BACKWRD ? M|rueckwaerts
..
.. direction is forward
.formula M|select = ";num87==" + 'M|tpaket^nummer'
.continue QUERY
..
!BACKWRD: direction is backward
.formula M|select = ";verwpaket==" + 'M|tpaket^nummer'
..
!QUERY: add parts of query
.formula M|select = M|praeselect + M|select + M|postselect
..
!BSTART: Start button is used
.input "is/HOL.LISTE"
..
.. position to first row and show details
.input 'M|rowdetails'
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
