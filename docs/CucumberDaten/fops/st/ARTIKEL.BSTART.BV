..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTIKEL.BSTART.BV
.. Datum          : 27.10.2006
.. Version        : 2007r0n00
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Bestimmt aus den Eingabefeldern das Selektionskriterium M|select.
..                  FÅhrt PlausibilitÑtsprÅfungen fÅr die Eingabefelder aus.
.. Ablauf         : Button-Vor-EFOP fÅr Feld "isbstart"
.. Functionality  : Defines parameter M|select from the input fields.
..                  Performs consitency checks for input field data.
.. Program flow   : Before button EFOP for field "isbsart"
..*****************************************************************************
.set trans -
..
.. Selection bar was used!
.continue START  ?  M|kbsel
..
.. Special OR-query for packing instructions
.continue PACK ? _F|empty(M|kpackanw) & _M|kblagerpackanw & _M|kbversandpackanw
..
.formula M|select = "$,,;@gruppe=1"
.formula M|select = M|select + ";@numsuch=" + 'M|kartvon' + "!" + 'M|kartbis'
.formula M|select = M|select + ";gtin=" + M|kgtinvon + "!" + M|kgtinbis    ? _F|empty(M|kgtinvon)  ; _F|empty(M|kgtinbis)
.formula M|select = M|select + ";sach==" + M|ksach^id                      ? _F|empty(M|ksach)
.. Packing instructions
.formula M|select = M|select + ";packanwstdla<>`"                          ?  M|kblagerpackanw   &  F|empty(M|kpackanw)
.formula M|select = M|select + ";packanwstdla=" + M|kpackanw^id            ?  M|kblagerpackanw   & _F|empty(M|kpackanw)
.formula M|select = M|select + ";packanwstdversand<>`"                     ?  M|kbversandpackanw &  F|empty(M|kpackanw)
.formula M|select = M|select + ";packanwstdversand=" + M|kpackanw^id       ?  M|kbversandpackanw & _F|empty(M|kpackanw)
.. BaseProduct
.formula M|select = M|select + ";basisartikel==" + 'M|basisartikel^id'     ? _F|empty(M|basisartikel)
.. Range check: start value <= end value
.type PS2 xvart  ? _F|defined(U|xvart)
.assign U|xvart = M|select + ";@lesen=(No)"
.continue ERRRANGE   ? _G|mehr
.continue START
..
!PACK: OR-condition for pack instruction
.formula M|select = F|formatstr("$,,;@gruppe=1;@verknuepfung=(Or);packanwstdla={1};packanwstdversand={1}", M|kpackanw^id)
.assign M|kartvon = ""
.assign M|kartbis = ""
.assign M|kgtinvon = ""
.assign M|kgtinbis = ""
.assign M|ksach = ""
..
!START
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..
!ERRRANGE
.error
.end 1
