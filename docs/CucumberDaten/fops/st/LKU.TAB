..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LKU.TAB
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Erzeugt eine Tabellezeile.
.. Ablauf         : Tabellen-EFOP
..
.. Functionality  : Creates a table row in the list of customers.
.. Program flow   : Table efop
..*****************************************************************************
.set trans -
.type bool xbhinweis ? _F|defined(U|xbhinweis)
..
!ROW: Create row
.make screen line +O
.set trans +
.formula M|vgrtxt = "Kunde"                       ? H|gruppe = 1
.formula M|vgrtxt = "Kundenkontakt"               ? H|gruppe = 2
.formula M|vgrtxt = "Interessent"                 ? H|gruppe = 6
.formula M|vgrtxt = "Interessentenkontakt"        ? H|gruppe = 7
.set trans -
.formula M|tnum = H|id
.formula M|tans = H|ans
.formula M|lakenn = H|lakenn
.formula M|plz = H|plz
.formula M|nort = H|nort
.formula M|str = H|str
.formula M|kontakt = H|kontakt
.formula M|tele = H|tele
.formula M|mtele = H|mtele
.formula M|email = H|email
.formula M|fax = H|fax
.formula M|lakenn2 = H|lakenn2
.formula M|ustid = H|ustid
.formula M|funktion = H|funktion
.formula M|tregionnamebspr = H|region^rnamebspr
.copy M|betreuer  = H|betreuer
..
.. Setting attributes
.type integer xi ? _F|defined(U|xi)
.assign U|xi = 1
..
!FOR
.continue HINT ? U|xi > 6
.copy M|tnamebspr.U|xi = M|namebspr.U|xi
.copy M|tmerkmal.U|xi = H|merkmal.U|xi
.formula U|xi = U|xi + 1
.continue FOR
..
!HINT
.copy U|xbhinweis = G|FALSE
.copy U|xbhinweis = G|TRUE  ? F|empty(H|ans) & F|empty(H|str)
.copy M|tdrucken  = G|TRUE  ? _U|xbhinweis & _F|empty(H|staat^adrformat)
.continue STAFFER                 ? H|gruppe = 2 ; H|gruppe = 7
.. Data only customers have
.formula M|jums = H|jums
.copy M|vertret = H|vertret
.formula M|steunr = H|steunr
.formula M|prg = H|prg
.formula M|rab = H|rab
..
!COLOUR: Set colour
.. Staffer
.colour -background 'M|kundensach' 'M|aktzeile' ? H|gruppe = 2
.. Customer
.colour -background 'M|kunde' 'M|aktzeile' ? H|gruppe = 1
.. Prospective customer
.colour -background 'M|inter' 'M|aktzeile' ? H|gruppe = 6
.. Staffer of propective customer
.colour -background 'M|intersach' 'M|aktzeile' ? H|gruppe = 7
.continue RELATE ? M|stufe = 0 & M|zuordnen
.continue END
..
!STAFFER: Data only staffers have
.copy M|firma = H|firma
.continue COLOUR
..
!RELATE: Relating children at level 1 to their parent
.continue END ? _(H|gruppe = 1 ; H|gruppe = 6)
.continue END ? H|gruppe = 1 & _M|bsach
.continue END ? H|gruppe = 6 & _M|bisach
.copy M|hauptgrliste = M|grliste
.copy M|hauptselect = M|select
.formula M|grliste = 'M|datnr' + ":"
.formula M|grliste = M|grliste + "2." ? M|bsach
.formula M|grliste = M|grliste + "7" ? M|bisach
.formula M|select = M|select + ";firma=" + H|id
.reserve
.formula M|stufe = M|stufe + 1
.input "is/HOL.LISTE"
.copy M|grliste = M|hauptgrliste
.copy M|select = M|hauptselect
.formula M|stufe = M|stufe - 1
.select
..*****************************************************************************
!END
.continue
