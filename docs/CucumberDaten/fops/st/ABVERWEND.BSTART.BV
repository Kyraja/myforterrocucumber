..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABVERWEND.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Eingaben und formuliert Datenbankanfrage.
.. Functionality  : Validates inputs and builds database query.
..*****************************************************************************
.set trans -
..
.. Validations
.continue ERROR01 ? F|empty(M|abereich)
.formula M|select = M|abereich^id
.continue PRODUCT ? F|isvalue('M|select', "P2:1.2.4.5")
.assign M|select = "abereich=" + M|select
.continue QUERY
..
!PRODUCT
.assign M|select = "artikel=" + M|select
..
!QUERY: Build query
.formula M|select = F|formatstr("$,,{1};@ablageart=(Active);@gruppe=1;@zeilen={2}", M|select, G|TRUE)
..
!CLRTAB: Clear table
.input "st/ABVERWEND.TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Product or product range missed!
.error -line 0 -field M|abereich -message Bitte erst Artikel oder Artikelbereich eintragen!
.end 1
