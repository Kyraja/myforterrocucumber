..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : HOL.ARTBER
.. Autor          : pw
.. Verantwortlich : cl
.. Kontrolle      : amk
.. Funktion       : Visualisiert den Artikelbereichsbaum von der Wurzel ab.
.. Functionality  : Visualizes product range tree starting from root.
..*****************************************************************************
.set trans -
..
.. Declarations
.type integer xresolvedrow
.type VID30   xprodrange
..
.. Initializations
.assign U|xprodrange = M|select
..
.. Open root node
.input 'M|openknot' ? _F|empty(M|openknot)
.continue END ? F|empty(M|tzeilen)
.continue END ? M|stufe >= M|anzstufen
..
.. Start resolving root level
.select screen header
..
!NEXTROW
.select screen line
.continue END ? _G|mehr
.formula M|stufe = M|tbaumstufe
.continue NEXTROW ? M|tbaumstat <> "+"
.continue NEXTROW ? M|stufe >= M|anzstufen
.copy U|xprodrange = M|tabereich
.formula U|xresolvedrow = M|aktzeile
.input 'M|openknot' ? _F|empty(M|openknot)
.select screen line 'U|xresolvedrow'
.formula M|tbaumstat = "-"
.continue NEXTROW
..*****************************************************************************
!END
.continue
