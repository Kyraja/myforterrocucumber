..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TERMINALPRINTER.STANDORTDR
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      : cl
.. Functionality  : shows the combination of printer list and local printers
..*****************************************************************************
..
.set trans -
..
.type text  xselect       ? _F|defined(U|xselect)
..
.formula U|xselect = F|formatstr("$,,standort={1};", M|kstandort^id)
.select group "91:1.2.9" 'U|xselect'
.continue END ?_G|mehr
!NEXT
.make screen line +O
.assign M|tdrucker = H|id
.copy M|taktiv = H|aktiv
.copy M|tstandortdrucker = G|TRUE
.select continue
.continue NEXT ? G|mehr
..*****************************************************************************
!END
.continue
