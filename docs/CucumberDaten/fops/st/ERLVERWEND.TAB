..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLVERWEND.TAB
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Erzeugt eine Tabellenzeile.
.. Ablauf         : Tabellen-EFOP
..
.. Functionality  : Creates a table row.
.. Program flow   : Table EFOP
..*****************************************************************************
.set trans -
..
.make screen line +O
.assign M|tbaumstufe = M|stufe
.assign M|tbaumiconz = M|kbaumiconz
.copy M|istpasswort = M|tbaumstufe = 0
..
.. Control differences in visualization by level
.continue PASSDEF ? M|istpasswort
..
.. we have a permission in a definition of a password
.assign M|tpasswort = H|id
.copy M|terlaubnis = H|rechte
.assign M|tpasserlname = M|terlaubnis^sucherw
.assign M|tbaumtext = M|terlaubnis^nummer + ": " + M|tpasserlname
.copy M|taktiv = H|rechteakt
.assign M|tbaumstat = ""
.assign M|tbaumiconz = M|symbolstop ? _M|taktiv
.formula M|tbauminfo = M|terlaubnis^grbez + ": " + M|terlaubnis^such
.formula M|tbauminfo = M|tbauminfo + " (" + M|terlaubnis^prio + ")"
.continue END
..
!PASSDEF: we have a definition of a password
.copy M|istpasswort = G|TRUE
.assign M|tpasswort = H|id
.assign M|tpasserlname = M|tpasswort^sucherw
.assign M|tbaumtext = M|tpasswort^nummer + ": " + M|tpasserlname
.copy M|taktiv = _H|inaktiv
.assign M|tbaumstat = "+"
.assign M|tbaumiconz = M|symbolstop ? _M|taktiv
.formula M|tbauminfo = M|tpasswort^grbez + ": "+ M|tpasswort^mitarb^sucherw
.formula M|tbauminfo = M|tbauminfo + " (" + M|tpasswort^abteilung + ")"
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
