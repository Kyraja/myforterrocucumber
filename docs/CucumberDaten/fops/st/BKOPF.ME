..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BKOPF.ME
.. Autor          : cl
.. Verantwortlich : lei
.. Kontrolle      : cl
.. Functionality  : set default
.. Includes       :
.. include st/LOGO.ME.ENDE
..*****************************************************************************
.set trans -
..
.continue END ? _G|evtartengl = "SCREEN_ENTER"
..
.type text xspi xspr xtvbez xta xtb xtc xtw xtx xtz xt xtt xt1 x1 xbastext
.type text xtreans xtversand
.type bool xredruck ? _F|defined(U|xredruck)
.type BT34 xtfanort 
.type text xtel xfax xsteunr xustidnr xiban 
..
.set separator
.assign M|steunr = F|sysinfo(10)^steunr
.assign M|ustid  = F|sysinfo(10)^ustid
.assign M|iban   = F|sysinfo(10)^iban
..
.formula M|versandansch  = ""
.formula M|rechansch     = ""
.text U|xtversand 'P|spr' Versandanschrift:
..
.. company headquarters
.assign M|firmaans  = F|sysinfo(10)^ans
.assign M|firmastr  = F|sysinfo(10)^str
.assign M|firmaplz  = F|sysinfo(10)^plz
.assign M|firmanort = F|sysinfo(10)^nort
.assign M|firmalakenn = F|sysinfo(10)^lakenn
.assign M|firmastaat = F|sysinfo(10)^staat^id
.assign M|firmaregion = F|sysinfo(10)^region^id
..
.formula U|xtfanort   = M|firmanort
.formula M|firmanort1 = U|xtfanort << ";"
.formula U|xtfanort   = U|xtfanort >> ";"
.formula M|firmanort2 = U|xtfanort << ";"
..
.. Firmenanschrift im Adresskopf mit einzeiligem Ort / Get address of company
.formula M|txtfirmenans = F|formatstr("{1} * {2} * {3} {4}", M|firmaans, M|firmastr, M|firmaplz, M|firmanort1)
.. einzeilige Ortsangabe fr Fuázeile
.formula M|firmaort = F|formatstr("{1} {2}", M|firmaplz, M|firmanort1)
..
.. Sonst gibt es einen Fehler bei ADRESSE2
.. Zumindest lakenn2 muss besetzt sein. Die
.. Adresse wird nicht gedruckt, wenn nicht auch
.. die PLZ etc. besetzt sind.
.assign M|lakenn2   = M|lakenn  ? +'M|lakenn2' = 0
.assign M|staat2    = M|staat   ? +'M|staat2' = 0
.assign M|region2   = M|region  ? +'M|region2' = 0
..
.. individuelles FOP z.Bsp. fr weiter Felder aus dem Betriebsdatensatz
.. hier werden auch die Fuázeilentexte und MfG gefllt
.input "st/LOGO.ME.ENDE"
.. U|xtel, U|xfax werden in st/LOGO.ME.ENDE gesetzt
.assign M|firmatele  = U|xtel + " " + F|sysinfo(10)^tele
.assign M|firmafax = U|xfax + " " + F|sysinfo(10)^fax
.assign M|firmaemail = F|sysinfo(10)^email
.assign M|firmaurlt  = F|sysinfo(10)^urlt
..
.. T|xredruck wird in st/LOGO.ME.ENDE gesetzt, default = FALSE
.text U|xtreans 'P|spr' Rechnungsanschrift:  ? U|xredruck
.formula M|versandansch  = 'U|xtversand'
.formula M|rechansch     = 'U|xtreans'
..
.formula M|emailzugferd = F|sysinfo(10)^adminemail
..
.assign M|datum4 = G|datum
..
!END
.continue
