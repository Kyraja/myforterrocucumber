..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTVERWENDUNG.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Datenbanken abfragen.
.. Functionality  : Query databases.
..*****************************************************************************
.set trans -
..
.. Nothing to do
.continue END ? F|empty(M|maxselect)
..
!ITERATE
.formula M|indexselect = M|indexselect + 1
.continue END ? M|indexselect > M|maxselect
.continue ITERATE ? _M|selgroup.indexselect
.copy M|grliste = M|grliste.indexselect
.copy M|vname = M|vname.indexselect
.copy M|vnameneu = M|vnameneu.indexselect
.formula M|select = F|formatstr(M|selectmuster, M|vname, M|selectoperator, M|suchmuster, M|grliste)
.continue COMBINE ? _F|empty(M|vnameneu)
.continue GETDATA
..
!COMBINE: Add second pattern
.formula M|select = M|select + F|formatstr(";{1}{2}{3};@verknuepfung=Oder", M|vnameneu, M|selectoperator, M|suchmuster)
..
!GETDATA
.input "is/SELECT.ROWBYROW"
.continue ITERATE
..
!RESULT
.input "is/NICHTS.GEFUNDEN.BF"
..*****************************************************************************
!END
.continue
