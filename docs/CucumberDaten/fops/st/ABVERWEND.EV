..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ABVERWEND.EV
.. Autor          : pw
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt alle einfacheren Feld- und Buttonereignisse.
.. Ablauf         : Zentrales Ereignis-EFOP
...Includes       :
.. include st/ABVERWEND.TABLEEREN
..*****************************************************************************
.set trans -
..
.. ----- Header -----
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "anzstufen"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "abereich"
.continue ELEMENT ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbustufe"
.continue HIERCHY ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "kbuartber"
.. ----- Table ------
.continue ELEMENT ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbustufe"
.continue HIERCHY ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbuartber"
.continue END
..
!ELEMENT: View element
.type VP99 xxmyobject
.assign U|xxmyobject = M|kabereich ?  F|empty(G|evtzeile)
.assign U|xxmyobject = M|tabereich ? _F|empty(G|evtzeile)
.continue END ? F|empty(U|xxmyobject)
.input "is/EXEC.COMMAND4REFERENCE"
.continue END
..
!HIERCHY: View product range hierarchy
.type VP99 xxmyobject
.assign U|xxmyobject = M|kabereich ?  F|empty(G|evtzeile)
.assign U|xxmyobject = M|tabereich ? _F|empty(G|evtzeile)
.command -parallel 'F|formatstr("(Infosystem) ARTBERB ? abereich={1} | bstart=1", U|xxmyobject^id)'
.continue END
..
!CLRTAB: Clear table
.input "st/ABVERWEND.TABLEEREN"
..*****************************************************************************
!END
.continue
