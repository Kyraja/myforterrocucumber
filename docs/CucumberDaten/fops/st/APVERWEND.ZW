..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APVERWEND.ZW
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Kopiert Felder von der Tabelle in die Details.
.. Functionality  : Copies fields from table into details.
..*****************************************************************************
.set trans -
..
.assign M|elem = 0
.continue CLRDET ? F|empty(G|evtzeile)
..
.copy M|kaufruf = M|taufruf
.copy M|kkopf = M|tkopf
..
!WHILE
.formula M|elem = M|elem + 1
.continue END ? M|elem > M|elemmax
.copy M|kbez.M|elem = M|tbez.M|elem
.copy M|kkontexttyp.M|elem = M|tkontexttyp.M|elem
.copy M|kaufrktxt.M|elem = M|taufrktxt.M|elem
.copy M|kaufrktxtbez.M|elem = M|taufrktxtbez.M|elem
.copy M|kaufrtab.M|elem = M|taufrtab.M|elem
.copy M|kbuttonfeld.M|elem = M|tbuttonfeld.M|elem
.continue WHILE
..
!CLRDET: Clear details
.assign M|kaufruf = ""
.assign M|kkopf = ""
..
!WHILE2
.formula M|elem = M|elem + 1
.continue END ? M|elem > M|elemmax
.assign M|kbez.M|elem = ""
.assign M|kkontexttyp.M|elem = ""
.assign M|kaufrktxt.M|elem = ""
.assign M|kaufrktxtbez.M|elem = ""
.assign M|kaufrtab.M|elem = ""
.assign M|kbuttonfeld.M|elem = ""
.continue WHILE2
..*****************************************************************************
!END
.continue
