..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALENDHIERARCHIE.TAB
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem Kalenderhierarchie: ZEIG-EFOP
.. Functionality  :
..
.. Ablauf         : Zeile aus Hauptpuffer in Maskenpuffer laden, wenn der
..                  Zeileninhalt passt.
..                  Folgende Maskenfelder sind geeignet besetzt:
..                  - M|stufe zeigt auf Stufe des Vaterknotens
..                  - M|bstartbut zeigt an, ob Gesamtbaum aufgeklappt wird
..
..*****************************************************************************
..
.set trans -
.type bool      xaufzu  ? _F|defined(U|xaufzu)
.type PS137:1.2 xpbkal  ? _F|defined(U|xpbkal)
.type ID137     xid     ? _F|defined(U|xid)
.type text      xtsel   ? _F|defined(U|xtsel)
..
.. Zeile ist ok:
.make screen line +O
.formula M|tbaumstufe    = M|stufe + 1
.formula M|eltstufe      = "----------"<<(M|tbaumstufe-1) + 'M|tbaumstufe'
.formula U|xpbkal = H|id
.. Felder aus Hauptpufferzeile in Tabellenzeile kopieren
.copy M|tkal = U|xpbkal
.assign U|xid = M|tkal
..
!RANGE: Kalender
.assign M|tname     = U|xpbkal^namebspr
.assign M|tbezobj   = U|xpbkal^bezobj
.assign M|tbaumtext = U|xpbkal^nummer + " " + U|xpbkal^such + " " + U|xpbkal^namebspr
.assign M|tlgruppe  = U|xpbkal^lgruppe
.assign M|tuebkal   = U|xpbkal^uebkal
.assign M|tgltvon   = U|xpbkal^gltvon
.assign M|tgltbis   = U|xpbkal^gltbis
..
.. Pruefen, ob Kalender weiter aufklappbar ist
.load 1 add M|tkal
.copy U|xaufzu = G|FALSE
.formula U|xtsel "$,,uebkal=" + 'U|xid' + ";@ordnung=uebkal,gltvon;@ablageart=(Active);@gruppe=1.2"
.load 1 'G|hdatname.M|datnr' 'U|xtsel'
.continue TESTKALEND ? _G|mehr
..
!ZEILLES
.formula U|xaufzu = G|true
.continue TESTKALEND ? U|xaufzu
.load 1 'G|hdatname.M|datnr'
.continue TESTKALEND ? _G|mehr
.continue ZEILLES
..
!TESTKALEND
.formula M|tbaumstat = ""   ? _U|xaufzu
.formula M|tbaumstat = "+"  ?  U|xaufzu
.formula M|tbaumstat = "-"  ?  U|xaufzu & M|bstartbut & M|tbaumstufe < M|anzstufen
.load 1
..
..*****************************************************************************
!END
.continue
