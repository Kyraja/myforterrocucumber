..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PACKPLAUSI.BSTART.BV
.. Autor          : comu/mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Start Button - Teilestamm lesen
.. Functionality  : Start button - read item data
..*****************************************************************************
.set trans -
..
.. Nothing left to show ;-)
.continue END  ?  _M|kpackfehl & _M|kpackwarnung & _M|kpackfehlerfrei
..
.. product query
.type text   xtselTEIL
..
.. fields for PACKPLAUS.TAB
.type bool   xbkeineabmessung
.type bool   xbkeineabmessungi
.type bool   xbmitabmessung
.type bool   xbmitabmessungi
.type bool   xbkeinpackkenn
.type bool   xbfehler
.type bool   xbwarnung
.type integer    xif
.type text   xtpmtyp
.type text   xtvpkenn
..
..
.. enumeration values
..
.. A215;Packmitteltyp;1;15;PackagingType;1;215;A215;0;0;
..  -------------------------------
..  67;Container;C;(67);
..  80;Palette;P;(80);
..  66;Beh„lter;B;(66);
..  72;Packhilfsmittel;H;(72);
..  90;Zwischenlage;Z;(90);
..  70;Fllmaterial;F;(70);
..  68;Deckel;D;(68);
..  0; -leer-;;(0);
..
.. A189;Verpackungskennung;1;17;PackagingCode;1;189;A189;0;0;
..  -------------------------------
..  77;Einwegverpackung;M;(77);
..  69;Mehrwegverpackung;E;(69);
..  0; -leer-;;(0);
..
.type text   xEinwegverpackung
.type text   xMehrwegverpackung
.type text   xContainer
.type text   xPalette
.type text   xBehaelter
.type text   xPackhilfsmittel
.type text   xZwischenlage
.type text   xFuellmaterial
.type text   xDeckel
.type text   xLeer
..
.formula U|xEinwegverpackung  = "(77)"
.formula U|xMehrwegverpackung = "(69)"
.formula U|xContainer         = "(67)"
.formula U|xPalette           = "(80)"
.formula U|xBehaelter         = "(66)"
.formula U|xPackhilfsmittel   = "(72)"
.formula U|xZwischenlage      = "(90)"
.formula U|xFuellmaterial     = "(70)"
.formula U|xDeckel            = "(68)"
.formula U|xLeer              = "(0)"
..
.. text field for error messages
.type text   xtf1
.type text   xtf2
.type text   xtf3
.type text   xtf4
.type text   xtf5
.type text   xtf6
.type text   xtf7
.type text   xtf8
.type text   xtf9
..  flag for error state
.type bool   xbf1
.type bool   xbf2
.type bool   xbf3
.type bool   xbf4
.type bool   xbf5
.type bool   xbf6
.type bool   xbf7
.type bool   xbf8
.type bool   xbf9
..
.. error text if product is packaging material
.set trans +
.formula U|xtf1 = "Wenn Packmittelkennzeichen S ist, muá als Packmitteltyp Beh„lter eingetragen sein!"
.formula U|xtf2 = "Wenn Packmittelkennzeichen leer ist, muá als Packmitteltyp Packhilfsmittel oder Deckel eingetragen sein!"
.formula U|xtf4 = "Entweder Auáenvolumen oder alle Auáenabmessungen (L„nge,Breite,H”he) sollen gefllt sein!"
.formula U|xtf5 = "Wenn Packmittelkennzeichen M oder G ist, muá als Packmitteltyp Palette eingetragen sein!"
.formula U|xtf6 = "Verkaufsbezeichnung fehlt!"
.formula U|xtf7 = "Packmitteltyp fehlt!"
.formula U|xtf8 = "Der Eigentmer muá fr Mehrwegverpackung eingetragen sein!"
.formula U|xtf9 = "Leergewicht fehlt!"
.. error text if product is not packaging material
.formula U|xtf3 = "Wenn Artikel nicht als Packmittel deklariert ist, sind Packmittelangaben nicht erlaubt!"
.set trans -
..
..
.. start with empty table
.make screen line -- ? M|tzeilen > 0
..
.. build query: restrict packaging materials
.formula U|xtselTEIL = "$,,;@gruppe=1;gruppe=1;@ablage=(1);@zeilen=(0);@ordnung=nummer"
.formula U|xtselTEIL = U|xtselTEIL + ";pmtyp=" + 'M|kpmtyp'              ? _M|kbpmtypleer  &  _F|empty(M|kpmtyp)
.formula U|xtselTEIL = U|xtselTEIL + ";pmtyp=`"                          ?  M|kbpmtypleer
.formula U|xtselTEIL = U|xtselTEIL + ";packmitken=" + 'M|kpackmitken'    ? _F|empty(M|kpackmitken)
.formula U|xtselTEIL = U|xtselTEIL + ";packmit=yes"                      ?  M|kbpackmit
.formula U|xtselTEIL = U|xtselTEIL + ";packmit=no"                       ? _M|kbpackmit
..
.. query + call row efop
.select parts 'U|xtselTEIL'
!NEXT
.continue END         ? _G|mehr
.input 'M|tab'    ? _F|empty(M|tab)
.select parts
.continue NEXT
..*****************************************************************************
!END
.continue
