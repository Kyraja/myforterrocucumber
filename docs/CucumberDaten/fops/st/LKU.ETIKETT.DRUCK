..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LKU.ETTIKET.DRUCK
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : mg
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.input "is/XMLGEN.PRE.FOP"
.type text xpagename    ? _F|defined(U|xpagename)
.type integer xindex    ? _F|defined(U|xindex)
.type integer xevtzeile ? _F|defined(U|xevtzeile)
..
<?xml version="1.0" encoding="UTF-8"?>
   <RecordSet caption="0">
.type integer lastrow ? _F|defined(U|lastrow)
.formula U|lastrow = F|condexpr(G|evtzeile=0, M|tzeilen, 1)
      <Record caption="'M|arb''M|such65'" lastrow="'U|lastrow'">
.assign U|xindex=0
.select screen header
         <Head caption="0">
.input "is/XMLGEN.COMMON.HVARS"
         </Head>
.continue TT1AUSGABE ? _(U|xevtzeile > 0)
.formula U|xindex = U|xevtzeile
.select screen line 'U|xevtzeile'
.continue TT2AUSGABE
..
!TT1AUSGABE
.assign U|xindex = U|xindex+1
.select screen line
..
!TT2AUSGABE
.continue TTENDE     ? _G|mehr
.continue TT1AUSGABE ? _M|tdrucken
         <Row caption="'U|xindex'">
              <Field name="zn" abasType="'F|typeof(U|xindex)'" value="'U|xindex(L="0")'">'U|xindex'</Field>
              <Field name="tdrucken" abasType="B" style="none" value="'M|tdrucken(L="0")'">'M|tdrucken'</Field>  </Row>
.continue TTENDE ? (U|xevtzeile > 0)
.continue TT1AUSGABE
..
!TTENDE
      </Record>
   </RecordSet>
</ABASData>
.input "is/XMLGEN.POST.FOP"
.continue END
..*****************************************************************************
!END
.continue
