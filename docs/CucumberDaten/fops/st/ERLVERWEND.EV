..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Behandelt Feld- und Zeilenereignisse im Infosystem Erlaubnisse.
.. Ablauf         : Zentrales Ereignis-FOP
..
.. Functionality  : Handles field and row events of the infosystem Permissions.
.. Program flow   : Central efop
..*****************************************************************************
.set trans -
..
..------------------------------- Header ---------------------------------------
.continue CLEAR   ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "nuraktive"
.continue CLEAR   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "erlaubnis"
.continue CLEAR   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "mitarbeiter"
.continue CLEAR   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "abteilung"
.continue VIEWER  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buviewer"
..==============================================================================
.continue END
..
!VIEWER
.type ID87:9 xcallparam
.assign U|xcallparam = "52364"
.input "st/CALLPARAM.EXEC"
.continue END
..
!CLEAR: clear details
.continue END ? M|tzeilen <= 0
.assign M|kpasswort = ""
.assign M|kpasserl = ""
.assign M|kbaumiconz = ""
.assign M|kistpasswort = ""
.assign M|stufe = 0
..
!CLRTAB: clear table
.make screen line --
..*****************************************************************************
!END
.continue
