..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : PACKSYS.ZW
.. Autor         : fwester
.. Verantwortlich: cl
.. Kontrolle     : lei
.. Funktion      : Zeigt Details aus der Zeile im Kopf an.
.. Ablauf        : Zeilenwechsel-EFOP
..
.. Functionality : Shows details from row in header.
.. Program flow  : Changing row efop
..*****************************************************************************
.set trans -
..
.continue FLDEXIT ? G|evtartengl = "FIELD_EXIT"
.continue FLDFILL ? G|evtartengl = "FIELD_FILL"
.continue BUSTART ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue BUNODE  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tbaumaufzu"
.continue LINEBRK ? G|evtartengl = "ROW_CHANGED"
.continue END
..
!FLDFILL
!FLDEXIT
.continue END ? M|ktpaket^nummer = M|kpaket^nummer
.copy M|detailpaket = M|kpaket
.continue CLRDET ? F|empty(M|detailpaket)
.assign M|stufe = 0
.copy M|kteinschl = G|FALSE
.assign M|ktpfadpaket = M|pfadknoten
.continue DETAILS
..
!BUSTART
.select screen header
.continue FLDEXIT ? M|tzeilen = 0
.select screen line
.continue FATAL ? _G|mehr
.continue LINEBRK
..
!BUNODE
.select screen line 'G|evtzeile'
.continue FATAL ? _G|mehr
!LINEBRK
.continue END ? M|ktpaket^nummer = M|tpaket^nummer
.copy M|detailpaket = M|tpaket
.assign M|stufe = M|tbaumstufe
.copy M|kteinschl = M|teinschl
.copy M|ktpfadpaket = M|tbaumicon
..
!DETAILS
.load 0 dataexport 'M|detailpaket^id'
.continue ERROR1 ? _G|mehr
.copy M|ktpaket = M|detailpaket
.copy M|ktarb = 0|arb
.formula M|ktpackage = ""
.formula M|ktzeilen = 0|ozeilen
.continue END
..
!CLRDET
.assign M|stufe = 0
.copy M|kteinschl = G|FALSE
.assign M|ktpfadpaket = ""
.assign M|ktpaket = ""
.assign M|ktarb = ""
.assign M|ktpackage = ""
.assign M|ktzeilen = 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -message Das Paket 'M|tpaket^such' wurde nicht gefunden
.end 1
..
!FATAL
.error -number 1111
.end 1
