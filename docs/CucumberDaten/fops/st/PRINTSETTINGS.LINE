..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRINTSETTINGS.LINE
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      :
.. Functionality  : Creates a row in the table of the printer dialog.
..*****************************************************************************
.set trans -
..
.type text xtreetext               ? _F|defined(U|xtreetext)
.type text xtooltip                ? _F|defined(U|xtooltip)
.type text xpreprintfop            ? _F|defined(U|xpreprintfop)
.type ID88:2.3.8 xlayout           ? _F|defined(U|xlayout)
.type IPN4 xanzahl                 ? _F|defined(U|xanzahl)
.type IPN4 xexemplare              ? _F|defined(U|xexemplare)
.type ID91:1.2.9 xprinter          ? _F|defined(U|xprinter)
.type ID87:9 xcallparam            ? _F|defined(U|xcallparam)
.type ID87:9 xprcallparam          ? _F|defined(U|xprcallparam)
.type ID91:13 xprinterlist         ? _F|defined(U|xprinterlist)
.type ID88:14 xlayoutlist          ? _F|defined(U|xlayoutlist)
.type A273 xlayzeilentyp           ? _F|defined(U|xlayzeilentyp)
.type integer xtreelevel           ? _F|defined(U|xtreelevel)
.type bool xmenuemoeglich          ? _F|defined(U|xmenuemoeglich)
.type A328 xendeaktion             ? _F|defined(U|xendeaktion)
.type bool xsichtbar               ? _F|defined(U|xsichtbar)
.type bool xnurerlaubte            ? _F|defined(U|xnurerlaubte)
..
.copy U|xmenuemoeglich = G|true
.copy U|xmenuemoeglich = G|false ? _F|empty(U|xlayout) & _U|xlayout^aktiv
.copy U|xmenuemoeglich = G|false ? _F|empty(U|xlayout) & _F|empty(U|xlayout^kanal) & _U|xlayout^kanal^aktiv
.copy U|xmenuemoeglich = G|false ? _F|empty(U|xprinter) & _U|xprinter^aktiv
.continue COPYFIELDS ? _U|xmenuemoeglich
.. check callparameter with correct record only
.continue COPYFIELDS ? F|defined(M|objektsel)
..
.formula U|xmenuemoeglich = F|eval('U|xcallparam^aufrbed')   ? F|equals(U|xcallparam^aufrbedtyp, "(Formula)")
.formula U|xmenuemoeglich ='U|xcallparam^aufrbed'            ? F|equals(U|xcallparam^aufrbedtyp, "(Constant)")
.formula U|xmenuemoeglich = 'A|.U|xcallparam^aufrbed'        ? F|equals(U|xcallparam^aufrbedtyp, "(HeaderField)")
.formula U|xmenuemoeglich = 'P|.U|xcallparam^aufrbed'        ? F|equals(U|xcallparam^aufrbedtyp, "(PrintParameter)")
.continue COPYFIELDS ? _U|xmenuemoeglich
..
.formula U|xmenuemoeglich = F|eval('U|xprcallparam^aufrbed') ? F|equals(U|xprcallparam^aufrbedtyp, "(Formula)")
.formula U|xmenuemoeglich ='U|xprcallparam^aufrbed'          ? F|equals(U|xprcallparam^aufrbedtyp, "(Constant)")
.formula U|xmenuemoeglich = 'A|.U|xprcallparam^aufrbed'      ? F|equals(U|xprcallparam^aufrbedtyp, "(HeaderField)")
.formula U|xmenuemoeglich = 'P|.U|xprcallparam^aufrbed'      ? F|equals(U|xprcallparam^aufrbedtyp, "(PrintParameter)")
..
!COPYFIELDS
.continue END ? U|xnurerlaubte & _U|xmenuemoeglich
.make screen line
.formula M|tbaumstufe = U|xtreelevel
.formula M|tbaumtext = U|xtreetext
.formula M|tbauminfo =  U|xtooltip
.copy M|tlayout = U|xlayout
.copy M|tanzahl = U|xanzahl
.copy M|texemplare = U|xexemplare
.copy M|tdrucker = U|xprinter
.copy M|tbaumicon = "icon:text2" ? U|xlayzeilentyp = "(SeparatorLine)" ; U|xlayzeilentyp = "(BlankLine)"
.copy M|tbaumicon = "icon:print" ? F|empty(U|xprinter)
.copy M|tbaumicon = U|xprinter^symbol ? _F|empty(U|xprinter)
.copy M|tbaumicon = "icon:view"  ? U|xvorschau
.copy M|tdraufruf = U|xcallparam
.copy M|tpraufruf = U|xprcallparam
.assign M|tpreprint = U|xpreprintfop
.copy M|tdruckerliste = U|xprinterlist
.copy M|tlayoutliste = U|xlayoutlist
.copy M|tvorschau = U|xvorschau
..
.copy M|tsichtbar = U|xsichtbar
.copy M|tmenueendeaktion = U|xendeaktion
.copy M|tmenuemoeglich = U|xmenuemoeglich
..
.continue END ? _M|tlayout^persist ; G|avtkommd = G|kaktname12 ; F|defined(A|isref)
.protection -line 'M|aktzeile'
..*****************************************************************************
!END
.continue
