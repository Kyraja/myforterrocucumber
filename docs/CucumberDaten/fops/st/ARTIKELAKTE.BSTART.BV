..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTIKELAKTE.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Datensammler fuer Business-App "Artikelakte"
.. Functionality  : Data miner for Buisiness App "Product File"
..*****************************************************************************
.set trans -
..
.. Remove old results
.make screen line -- ? M|tzeilen > 0
.copy M|kmaxanzahl = 0
.copy M|kmaxmenge = 0.0
..
.. Check date range: von<=bis
.continue DATEOK ?  M|kbis >= M|kvon ; F|empty(M|kbis) ; F|empty(M|kvon)
.type GD xgd
.formula U|xgd = M|kvon
.formula M|kvon = M|kbis
.formula M|kbis = U|xgd
!DATEOK
..
.. Required arguments
.continue NOPROD  ?  F|empty(M|kartikel) & F|empty(M|basisartikel) & F|sysinfo(18)^verskontr
.continue NOPROD  ?  F|empty(M|kartikel) & _F|sysinfo(18)^verskontr
..
.. Stock unit
.copy M|klagereinheit = M|kartikel^le
..
..*****************************************************************************
!END
.continue
..
!NOPROD
.error Geben Sie einen Artikel oder Basisartikel an! ?  F|sysinfo(18)^verskontr
.error Geben Sie einen Artikel an!                    ? _F|sysinfo(18)^verskontr
.end 1
