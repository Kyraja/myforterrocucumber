..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ARCHIV.TAB
.. Autor          : kop
.. Verantwortlich : teamreport
.. Kontrolle      : mg
.. Funktion       : Erzeugt eine Tabellezeile.
.. Ablauf         : Tabellen-EFOP
..
.. Functionality  : Creates a table row in the list of printers.
.. Program flow   : Table efop
..*****************************************************************************
.set trans -
.type text xsel1 ? _F|defined(U|xsel1)
.type text xsel2 ? _F|defined(U|xsel2)
.type text xsel3 ? _F|defined(U|xsel3)
..
.formula U|xsel1 = "$,,0:kanal=" + M|layout^kanal^id + ";1:spdrucker=" + H|id
.formula U|xsel1 = U|xsel1 + ";@sort=Spooler-Vorschaudrucker;@zeilen=(1)"
.formula U|xsel2 = "$,,kanal=" + M|layout^kanal^id + ";datdrucker=" + H|id
.formula U|xsel2 = U|xsel2 + ";@sort=Spooler-Vorschaudrucker"
.formula U|xsel3 = "$,,sucherw==`!;kanal=" + M|layout^kanal^id + ";vordrucker=" + H|id
.formula U|xsel3 = U|xsel3 + ";@sort=Spooler-Vorschaudrucker"
..
.load 0 group "88:5" 'U|xsel1'
.continue ROW ? G|mehr
.load 0 group "88:5" 'U|xsel2'
.continue ROW ? G|mehr
.load 0 group "88:5" 'U|xsel3'
.continue ROW ? G|mehr
.continue END
..
!ROW: Create row
.make screen line +O
.formula M|tdrucker = H|id
.copy M|tarchiv = H|archiv
.copy M|taktiv = H|aktiv
.copy M|tstatus = M|greenz ? M|archiv    &  M|tarchiv
.copy M|tstatus = M|gelbz  ? _M|archiv   ; _M|tarchiv
.copy M|tstatus = M|rotz   ? M|archivpfl & _M|tarchiv
.copy M|tstatus = M|rotz   ? _M|taktiv
..
.set trans +
.formula M|tstatustext = "Druck und Archivierung m”glich" ? M|archiv    &  M|tarchiv
.formula M|tstatustext = "Druck m”glich"  ? _M|archiv   ; _M|tarchiv
.copy M|tstatustext = "Kein Druck m”glich"   ? M|archivpfl & _M|tarchiv
.copy M|tstatustext = "Kein Druck m”glich"   ? _M|taktiv
..*****************************************************************************
!END
.continue
