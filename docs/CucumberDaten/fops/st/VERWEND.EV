..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VERWEND.EV
.. Autor          : ds
.. Verantwortlich : cl 
.. Kontrolle      : tiwe
.. Funktion       : Behandelt die Eingabeparameter ausser dem Startbutton.
.. Ablauf         : Zentrales Ereignis-FOP
.. Functionality  : Handles the input parameters except the start button.
.. Program flow   : Central efop
...Includes       :
.. include st/VERWEND.TABLEEREN
..*****************************************************************************
.set trans -
..
..
..----------------------------------------------------------------------------
.. Variablendefinition
..----------------------------------------------------------------------------
.type text xtsel ? _F|defined(U|xtsel)
..
..----------------------------------------------------------------------------
.. Kopfteil/Header
..----------------------------------------------------------------------------
.continue ELEM    ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "kelem"
.continue BASIS   ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "kbasisartikel"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "klgruppe"
.continue LEVELS  ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "anzstufen"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"       & G|evtvar = "anzstufen"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL"       & G|evtvar = "knurfliststd"
..----------------------------------------------------------------------------
.. Tabellenteil/Table
..----------------------------------------------------------------------------
.continue BUELEM  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tbuelem"
.continue FORBIDD ? G|evtartengl = "ROW_MOVED_BEFORE"
..----------------------------------------------------------------------------
.continue END
..
!LEVELS: Levels has changed
.continue ERROR1 ? M|anzstufen <= 0
.continue END
..
!BUELEM: Show element
.add M|telem
.command -parallel 'D|id'
.continue END
..
!FORBIDD: Action not allowed
.end 1
..
!ELEM
.formula M|kbasisartikel = ""
.assign M|kbasisartikel = M|kelem^basisartikel ? _F|empty(M|kelem) & M|kelem^gruppe = 1
.copy M|vorgaenger = G|false
.continue CLRTAB ? F|empty(M|kelem)
.formula M|icon = M|kelem^elementicon
.continue NOART ? M|kelem^gruppe <> 1
.formula U|xtsel = "$,,nummer=;such=;nachfolgeartikel="+'M|kelem^id'+";@gruppe=1;@ablageart=(Active);"
.select parts 'U|xtsel'
.protection M|vorgaenger 0          ? _G|mehr
.protection -reset M|vorgaenger 0    ?  G|mehr    
.continue CLRTAB
!BASIS
.formula M|kelem = "" ? _F|empty(M|kbasisartikel)
.formula M|iconz = "" ? F|empty(M|kelem)
.continue CLRTAB
!NOART
.protection M|vorgaenger 0 
.continue CLRTAB
..
!CLRTAB: Clear table
.input "st/VERWEND.TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Tree level wrong!
.error -line 0 -field M|anzstufen -message Die Anzahl der Stufen muss mehr als Null sein!
.end 1
