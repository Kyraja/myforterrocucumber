..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PROJECTSUITE.ABASDMS.IDX
.. Autor          : saac
.. Verantwortlich : teamreport
.. Kontrolle      : lei
.. Funktion       : Erzeugt Indexdatei fÅr abas-DMS bei Drag und Drop mit Kontext
.. Functionality  : Creates index file for abas-DMS for drag and drop with 
..                  given context
..*****************************************************************************
.set trans -
.type text xt               ? _F|defined(U|xt)
.type P88:11 xdmsbelegart   ? _F|defined(U|xdmsbelegart)
.type VID99 xid             ? _F|defined(U|xid)
.type GD2  xtoday           ? _F|defined(U|xtoday)
.type text xbetreff         ? _F|defined(U|xbetreff)
..
.formula U|xtoday = "."
.file -tempname U|xt
..
.output new 'U|xt' -encoding "UTF-8"
.input "DATEI.F"
..
.input "STD.ABASDMS.IDX"
..
.assign U|xbetreff = M|dndbetreff    ? F|defined(M|dndbetreff)
.assign U|xbetreff = M|betreff       ? F|defined(M|betreff) & F|empty(U|xbetreff)
?Betreff='U|xbetreff'     ? _F|empty(U|xbetreff)
.continue NOBELDAT        ? _F|defined(M|beldat)
?BelDat='M|beldat(L="0")' ? _F|empty(M|beldat)
?BelDat='U|xtoday(L="0")' ? F|empty(M|beldat)
.continue ENDE
..
!NOBELDAT
BelDat='U|xtoday(L="0")'
..
!ENDE
.system 'F|expr("crlf+ < " + U|xt + " >" + U|xxmldata)' background
