..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : STRINGLISTE
.. Autor          : erwo
.. Verantwortlich : cl
.. Funktion       : Liefert das n„chste Element mit Semikolon getrennten Liste.
.. In U|stringlisterest wird diese Liste erwartet und verkrzt zurckgegeben.
.. In U|stringlistekopf wird das abgeschnittene Element zurckgegeben.
.. U|stringlisteindex wird intern verwendet.
..
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type I9   stringlisteindex   ? _F|defined(U|stringlisteindex)
.type GL   stringlistekopf    ? _F|defined(U|stringlistekopf)
.type GL   stringlisterest    ? _F|defined(U|stringlisterest)
.type GL   stringlistetrenner ? _F|defined(U|stringlistetrenner)
.type bool xkfertig           ? _F|defined(U|xkfertig)
.type bool xtfertig           ? _F|defined(U|xtfertig)
..
.assign U|stringlisteindex = F|strindex(U|stringlisterest, U|stringlistetrenner)
...continue WEITER  ? U|stringlistefop = "st/AENDH.BSTART.TABFELDNAMENPRUEFEN" ; U|stringlistefop = "st/AENDH.BSTART.FELDNAMENPRUEFEN"   
..
.. Fall 4
.continue WEITER     ?   (_M|allekopf ; M|allekopf & F|empty(ausloeser2kopf)) & (_M|alletabelle ; M|alletabelle  & F|empty(ausloeser2tabelle))
.. Fall 1
.continue KOMPLETT   ?   _F|empty(M|ausloeser2kopf) & _F|empty(M|ausloeser2tabelle)
.. Fall 2
.continue NURKOPF    ?    M|allekopf & F|empty(M|ausloeser2tabelle) & F|empty(M|ausloesertabelle) & F|empty(M|feldertabelle)
.. Fall 3
.continue NURTABELLE ?    M|alletabelle & F|empty(M|ausloeser2kopf) & F|empty(M|ausloeserkopf) & F|empty(M|felderkopf)
..
!NURKOPF: nur M|allekopf
.copy U|xkfertig = G|TRUE ? F|empty(M|ausloeser2kopf)
.input "st/AENDH.ALLEK" ?  _U|xkfertig
.continue END
..
!NURTABELLE
.copy U|xtfertig = G|TRUE ? F|empty(M|ausloeser2tabelle)
.input "st/AENDH.ALLET" ? _U|xtfertig
.continue END
..
!KOMPLETT
.continue ALLET         ?  U|xkfertig
.copy U|xkfertig = G|TRUE ? F|empty(M|ausloeser2kopf)
.input "st/AENDH.ALLEK" ? _U|xkfertig
.continue END
!ALLET
.copy U|xtfertig = G|TRUE ? F|empty(M|ausloeser2tabelle)
.input "st/AENDH.ALLET"   ? _U|xtfertig
.copy M|fertig = G|TRUE   ? U|xkfertig & _G|mehr
.continue END
..
!WEITER: Wenn es kein weiteres U|stringlistetrenner mehr gibt, geben wir den Rest zurck.
.continue TRENNER ? U|stringlisteindex > 0
..
.assign U|stringlistekopf = U|stringlisterest
.assign U|stringlisterest = ""
.continue END
..
!TRENNER
.assign U|stringlistekopf = F|substr(U|stringlisterest, 1, U|stringlisteindex - 1)
.assign U|stringlisterest = F|substr(U|stringlisterest, U|stringlisteindex + 1)
.continue END
..
..*****************************************************************************
!END
.continue
