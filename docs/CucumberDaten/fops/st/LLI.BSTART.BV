..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LLI.BSTART.BV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Bestimmt aus den Eingaben die Datenbankanfrage.
.. Ablauf         : Button-vor-EFOP
..
.. Functionality  : Builds database query from inputs.
.. Program flow   : Button after efop
..*****************************************************************************
.set trans -
..
.. Validate input parameters
.continue ERROR01 ? _(M|bkunde ; M|bsach ; M|selektion)
.formula M|grliste = M|isref^grliste
..
.. Clear table
.make screen line -- ? M|tzeilen > 0
.continue END ? M|selektion
..
.. Configure list of groups
.formula M|grliste = 'M|datnr' + ":"
.continue SUPPLY ? M|bkunde
..
!NEXT1
.continue SUSTAFF ? M|bsach
.continue BUILD
..
!SUPPLY
.formula M|grliste = M|grliste + "1"
.continue NEXT1
..
!SUSTAFF
.continue BUILD ? M|bkunde & M|zuordnen
.formula M|grliste = M|grliste + "." ? F|strindex(M|grliste, ":") <> F|length(M|grliste)
.formula M|grliste = M|grliste + "2"
..
!BUILD: Build query
.formula M|select = "$,,"
.formula M|select = M|select + "nummer=" + M|kkunde + ";nort=" + M|knort
.formula M|select = M|select + ";plz=" + M|kplz
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: No database!
.error -field M|bkunde -message Es fehlt die Angabe einer Lieferantengruppe!
.end 1
