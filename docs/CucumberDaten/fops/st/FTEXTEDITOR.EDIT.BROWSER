..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FTEXTEDITOR.EDIT.BROWSER
.. Autor          : vbrukman
.. Verantwortlich : vbrukman
.. Kontrolle      : mg
.. Functionality  : Calls free text editor for file given in M|freitextedit.
.. If M|ftexteditierbar = false, the file is readonly.
..
..*****************************************************************************
.set trans -
..
.type DVMI2 pathToText  ? _F|defined(U|pathToText)
.assign U|pathToText = M|freitextedit
.input de.abas.erp.htmleditor.oldformattonew.FTConvertOldFormatToNewMain.class 'F|formatstr("fileName={1}", U|pathToText)'
.continue ERROR01 ? _F|empty(G|status)
.continue MODHTML ? M|ftexteditierbar
.editing -readonly -html 'M|freitextedit'
.continue END
..
!MODHTML
.editing -html 'M|freitextedit'
.input de.abas.erp.htmleditor.newformattojasper.FTConvertNewFormatToJasperMain.class 'F|formatstr("fileName={1}", U|pathToText)'
.continue ERROR01 ? _F|empty(G|status)
.assign M|freitextedit = "" ? F|filesize('M|freitextedit') = 0
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Conversion of freetext failed!
.error -message Das Konvertieren des Freitextes ist gescheitert!
.end 1

