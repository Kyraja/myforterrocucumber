.set trans -
.continue END ? _F|empty(M|von) ; _F|empty(M|bis) ; _F|empty(M|bearbeiter)
.. alle Tabellenfelder sind leer
.continue END ? F|empty(M|ausloeser2tabelle) & F|empty(M|ausloesertabelle) & F|empty(feldertabelle)
.input "st/AENDH.ERSTES.ZEILENTITEL" ? _U|zeilentitelerledigt
..
.continue END ? _M|auchneu
.make screen line +O
.assign M|tnummer = M|kid  ? _F|empty(M|kid)
.assign M|tsnummer = M|kid ? _F|empty(M|kid)
.copy M|typk = U|xtypk
.copy M|typt = U|xtypt
.copy M|tzeitpunkt = U|itstand
