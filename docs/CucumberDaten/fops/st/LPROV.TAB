..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : LPROV.TAB
.. Autor          : bheim
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Filtert Treffer und erzeugt eine Tabellenzeile.
.. Ablauf         : Tabellen-EFOP
..
.. Functionality  : Filter hits and creates a table row.
.. Program flow   : Table efop
..*****************************************************************************
.set trans -
..
.continue TABROW  ?  F|empty(H|gltvon) &  F|empty(H|gltbis)
.continue TABROW  ?  F|empty(M|kvon)   &  F|empty(M|kbis)
.continue LIMITS  ? _(F|empty(H|gltvon) ; F|empty(H|gltbis))
.continue LOLIMIT ? _F|empty(H|gltvon)
.continue UPLIMIT
..
!LIMITS: Upper and lower limits exists
.continue END ? _F|empty(M|kbis) & M|kbis < H|gltvon
.continue END ? _F|empty(M|kvon) & M|kvon > H|gltbis
.continue TABROW
..
!LOLIMIT: Lower limit exists
.continue END ? _F|empty(M|kbis) & M|kbis < H|gltvon
.continue TABROW
..
!UPLIMIT: Upper limit exists
.continue END ? _F|empty(M|kvon) & M|kvon > H|gltbis
..
!TABROW
.make screen line +O
.copy M|tnum    = H|sn
.copy M|tsuch   = H|sn
.formula M|tvertpg   = H|vetpg
.formula M|tartpg    = H|artpg
.copy M|tvon    = H|gltvon
.copy M|tbis    = H|gltbis
.copy M|tprovis = H|provis
..*****************************************************************************
!END
.continue
