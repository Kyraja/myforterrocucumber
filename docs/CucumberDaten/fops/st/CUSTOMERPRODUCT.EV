..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CUSTOMERPRODUCT.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Allgemeine Ereignisee: Feldaustritt, Zeile rein/raus
.. Functionality  : General Events: field exit, row add/remove
..*****************************************************************************
.set trans -
..
.. event evaluation
.. ----------- Header -------------------------- -------------------------------
.continue TABINIT  ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kkuartnr"
.continue TABINIT  ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kkunde"
.continue ARTIKEL  ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kartikel"
.continue PROT     ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kpackanw"
.continue PBOOL    ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kblagerpackanw"
.continue PBOOL    ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "kbversandpackanw"
.continue BASIS    ?  G|evtartengl = "FIELD_EXIT"     & G|evtvar = "basisartikel"
.. ----------- ----- -------------------------- -------------------------------
.continue END
..
!ARTIKEL
.assign M|basisartikel = M|kartikel^basisartikel ? _F|empty(M|kartikel)
.continue TABINIT
..
!BASIS
.formula M|kartikel = "" ? _F|empty(M|basisartikel)
.continue TABINIT
..
!PBOOL
.type bool xb
.formula U|xb = M|.evtvar 
.copy M|kbversandpackanw = G|false
.copy M|kblagerpackanw = G|false
.formula M|.evtvar = U|xb 
.continue PROT
.. 
!PROT
.continue RESET ? F|empty(M|kpackanw) 
.continue RESET ? M|kblagerpackanw ; M|kbversandpackanw
.protection kkuartnr 0
.protection kkunde 0
.protection kartikel 0
.continue TABINIT
!RESET
.protection -reset kkuartnr 0
.protection -reset kkunde 0
.protection -reset kartikel 0
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue

