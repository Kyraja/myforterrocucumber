..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUFGABEN.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : cl
.. Funktion       : Validiert die Steuerungsparameter und formuliert die DB-
..                  Anfrage.
.. Functionality  : Validates input parameters and builds query.
..*****************************************************************************
.set trans -
..
.. Validate
.continue CLRTAB ? _M|keineeigenen
.copy M|aktmitarb = G|passw^mitarb
.continue ERROR02 ? F|empty(M|aktmitarb)
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..
.formula M|select = "$,,"
..
.. Add criteria for trigger
.continue STARTOF ? F|empty(M|ursache)
.formula M|select = M|select + ";ursache=" + M|ursache^id
..
!STARTOF: Start date
.continue CLOSING ? F|empty(M|vonstartdatum) & F|empty(M|bisstartdatum)
.continue START   ? F|empty(M|vonstartdatum) ; F|empty(M|bisstartdatum)
.continue ERROR01 ? M|vonstartdatum > M|bisstartdatum
!START
.formula M|select = M|select + ";start=" +  M|vonstartdatum:8 + "!" + M|bisstartdatum:8
..
!CLOSING: Closing date
.continue PARTNER ? F|empty(M|vonenddatum) & F|empty(M|bisenddatum)
.continue CLOSE   ? F|empty(M|vonenddatum) ; F|empty(M|bisenddatum)
.continue ERROR03 ? M|vonenddatum > M|bisenddatum
..
!CLOSE
.formula M|select = M|select + ";end=" +  M|vonenddatum:8 + "!" + M|bisenddatum:8
..
!PARTNER: business partner
.continue PROJECT ? F|empty(M|partner)
.formula M|select = M|select + ";partner=" + M|partner^id
..
!PROJECT: project
.continue ELEMENT ? F|empty(M|projekt)
.formula M|select = M|select + ";projekt=" + M|projekt^id
..
!ELEMENT: manufacturing
.continue DOCUMNT ? F|empty(M|elem)
.formula M|select = M|select + ";elem=" + M|elem^id
..
!DOCUMNT: sales or purchasing document
.continue INTERN ? F|empty(M|evvorgang)
.formula M|select = M|select + ";evvorgang=" + M|evvorgang^id
..
!INTERN: Internal task
.continue WORKFLW ? _F|empty(M|intern)
.formula M|select = M|select + ";intern=" + 'G|FALSE'
..
!WORKFLW: Add workflow description
.continue SEQENCE ? F|empty(M|ablauf)
.formula M|select = M|select + ";ablauf=" + M|ablauf^id
..
!SEQENCE: Add workflow sequence
.continue EDITOR ? F|empty(M|ablaufzust)
.formula M|select = M|select + ";ablaufzust=" + M|ablaufzust^id
..
!EDITOR: Add editing staff personnel
.continue CONFIRM ? F|empty(M|bearbeit)
.formula M|select = M|select + ";bearbeit=" + M|bearbeit^id
..
!CONFIRM: Add confirming staff personnel
.continue PRIO ? F|empty(M|bestaet)
.formula M|select = M|select + ";bestaet=" + M|bestaet^id
..
!PRIO: Add priority
.continue STATUS  ? F|empty(M|prio)
.formula M|select = M|select + ";prio=" + M|prio^id
..
!STATUS: Add status
.continue TEAM ? F|empty(M|status)
.formula M|select = M|select + ";status=" + M|status
.formula M|select = M|select + ";@ablageart=abgelegt" ? F|equals(M|status, "(Canceled)") ; F|equals(M|status, "(Confirmed)")
..
!TEAM: Add team
.continue END ? F|empty(M|team)
.formula M|select = M|select + ";team=" + M|team^id
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Wrong period!
.error -line 0 -field M|vonstartdatum -message Startdatum gr”áer als Enddatum.
.continue BREAK
..
!ERROR02: Missing user data!
.error -line 0 -field M|keineeigenen -message Im aktuellen Passwort ist kein Mitarbeiter hinterlegt!
.continue BREAK
..
!ERROR03: Wrong period!
.error -line 0 -field M|vonenddatum -message Startdatum gr”áer als Enddatum.
..
!BREAK
.end 1
