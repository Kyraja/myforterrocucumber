..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTIKEL.EV
.. Datum          : 27.10.2006
.. Version        : 2007r0n00
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Behandelt Feld- und Zeilenereignisse im Infosystem Artikel.
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Zentrales EFOP des Infosystems Artikel
..
.. Functionality  : Central EFOP of the infosystem Products
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : Handles field and row events of the infosystem Products.
..*****************************************************************************
.set trans -
..
..<META M|='st/ARTIKEL'> 
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.. buttons use own EFOP
.. ----------- ----- Kopfteil ------ -------------------------------------------
.continue ARTIKEL ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kartvon"
.continue ARTIKEL ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kartbis"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "keanbis"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "keanbis"
.continue TABINIT ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "ksach"
.continue PROT    ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kpackanw"
.continue PBOOL   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kblagerpackanw"
.continue PBOOL   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbversandpackanw"
.continue VBOOL   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "defaultview"
.continue VBOOL   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "packview"
.continue BASIS   ?  G|evtartengl = "FIELD_EXIT" & G|evtvar = "basisartikel"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!BASIS
.formula M|kartvon = "" ? _F|empty(M|basisartikel)
.formula M|kartbis = "" ? _F|empty(M|basisartikel)
.continue TABINIT
..
!ARTIKEL 
.formula M|basisartikel = "" ? _F|empty(M|kartvon) ;  _F|empty(M|kartbis)
.continue TABINIT
..
!VBOOL: Do not allow deactivating of view bools
.copy M|defaultview = G|false
.copy M|packview = G|false
.copy F|adr("M", 'G|evtvar', 0) = G|true
.formula P|maskkontextfop = "std" ? M|defaultview
.formula P|maskkontextfop = "pack" ? M|packview
.continue END
..
!PBOOL: Do not allow common activation of both package bools
.type bool xeventvar
.formula U|xeventvar = F|adr("M", 'G|evtvar', 0)
.copy M|kbversandpackanw = G|false
.copy M|kblagerpackanw = G|false
.copy F|adr("M", 'G|evtvar', 0) = U|xeventvar
.copy M|defaultview = _U|xeventvar & F|empty(M|kpackanw)
.copy M|packview = U|xeventvar ; _F|empty(M|kpackanw)
.formula P|maskkontextfop = "std" ? M|defaultview
.formula P|maskkontextfop = "pack" ? M|packview
..
!PROT: Handle field protections
.continue RESET ? F|empty(M|kpackanw)
.continue RESET ? M|kblagerpackanw ; M|kbversandpackanw
.protection kartvon 0
.protection kartbis 0
.protection kgtinvon 0
.protection kgtinbis 0
.protection ksach 0
.continue TABINIT
..
!RESET
.protection -reset kartvon 0
.protection -reset kartbis 0
.protection -reset kgtinvon 0
.protection -reset kgtinbis 0
.protection -reset ksach 0
.continue TABINIT
..
!TABINIT
.. a key field was changed, or a checkbox changed
.. remove old rows
.make screen line -- ? M|tzeilen > 0
.. any data directly entered into this mask voids earlier selections stored
.. from using selection bar,
.. data from infosystem fields are used for the selection
.formula M|kbsel = G|false
.continue END
..*****************************************************************************
!END
.continue
