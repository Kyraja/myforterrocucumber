..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : KULI.ABASDMS.IDX
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      : fwester
.. Functionality  : Does global index file output for a customer or a vendor.
..*****************************************************************************
.set trans -
..
.type VP5   xkuli          ? _F|defined(U|xkuli)
..
.continue END ? U|xkuli^dnr <> 0 & U|xkuli^dnr <> 1
.continue END ? U|xkuli^gruppe <> 1 & U|xkuli^gruppe <> 2 & U|xkuli^gruppe <> 6 & U|xkuli^gruppe <> 7
..
?KuLiKZ=K  ? U|xkuli^dnr = 0 & U|xkuli^gruppe <= 2
?KuLiKZ=I  ? U|xkuli^dnr = 0 & U|xkuli^gruppe >= 6 & U|xkuli^gruppe <= 7
?KuLiKZ=L  ? U|xkuli^dnr = 1
.continue CONTACT ? U|xkuli^gruppe = 2 ; U|xkuli^gruppe = 7
AbasKID='U|xkuli^id'
KuLiNr='U|xkuli^nummer'
KuLiSuch='U|xkuli^such'
KuLiNam='U|xkuli^ans'
KuLiPLZ='U|xkuli^plz'
KuLiOrt='U|xkuli^nort'
KuLiLKZ='U|xkuli^lakenn'
Betreuer='U|xkuli^betreuer'
Email='U|xkuli^email'
.continue END
..
!CONTACT
AbasKID='U|xkuli^firma^id'
KuLiNr='U|xkuli^firma^nummer'
KuLiSuch='U|xkuli^firma^such'
Betreuer='U|xkuli^firma^betreuer'
Email='U|xkuli^firma^email'
KuLiNam='U|xkuli^firma^ans'
KuLiPLZ='U|xkuli^firma^plz'
KuLiOrt='U|xkuli^firma^nort'
KuLiLKZ='U|xkuli^firma^lakenn'
..
KtktNr='U|xkuli^nummer'
KtktNam='U|xkuli^ans'
KtktSuch='U|xkuli^such'
AbasTID='U|xkuli^id'
..*****************************************************************************
!END
.continue
