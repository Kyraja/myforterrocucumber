..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LKU.EV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt die Ereignisse der Eingabefelder ausser denen des
.. Startbuttons.
.. Ablauf         : Zentrales EFOP
..
.. Functionality  : Handles the events of the input fields except those of the
.. startbutton.
.. Program flow   : Central efop
..*****************************************************************************
.set trans -
..------------------------------- Header -------------------------------------
.continue SELBAR  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bselect"
.continue LOESCH  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buloesch"
.continue INITSEL ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bkunde"
.continue INITSEL ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bsach"
.continue INITSEL ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "binteressent"
.continue INITSEL ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bisach"
.continue INITSEL ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "zuordnen"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "knort"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kplz"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kkundevon"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kkundebis"
.continue VSTATE  ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "staat"
.continue VREGION ? G|evtartengl = "FIELD_VALIDATION" & G|evtvar = "region"
.continue STATE   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "staat"
.continue REGION  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "region"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "merkmal1"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "merkmal2"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "merkmal3"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "merkmal4"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "merkmal5"
.continue INITSEL ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "merkmal6"
..----------------------------------------------------------------------------
.continue END
..
!VSTATE: Validate that input is a state
.continue END ? F|empty(M|staat)
.continue ERROR01 ? F|value(M|staat^typ, "AS149") <> "(Country)"
.continue END
..
!STATE: Exit state
.continue INITSEL ? F|empty(M|staat)
.continue INITSEL ? F|empty(M|region)
..
.. Clear region while region is not part of state
.continue INITSEL ? M|staat^id = M|region^staat^id
.assign M|region = ""
.continue INITSEL
..
!VREGION: Validate that input is a region
.continue END ? F|empty(M|region)
.continue ERROR02 ? F|value(M|region^typ, "AS149") <> "(Region)"
.continue END
..
!REGION: Exit region
.continue INITSEL ? F|empty(M|region)
..
.. Clear region while region is not part of state
.continue INITSEL ? M|staat^id = M|region^staat^id
.assign M|staat = M|region^staat^id
.continue INITSEL
..
!LOESCH: Remove not printable rows
.select screen line header
..
!NEXTROW
.select screen line
.continue END ? _G|mehr
.continue NEXTROW ? M|tdrucken
..
!RMROW
.make screen line -
.continue NEXTROW ? M|tdrucken
.continue RMROW
..
!SELBAR: Button selection bar was pushed
.assign M|kkundevon = ""
.assign M|kkundebis = ""
.assign M|knort = ""
.assign M|kplz = ""
.assign M|staat = ""
.assign M|region = ""
.copy M|bkunde = G|FALSE
.copy M|bsach = G|FALSE
.copy M|binteressent = G|FALSE
.copy M|bisach = G|FALSE
.copy M|zuordnen = G|FALSE
.copy M|grliste = M|isref^grliste
.formula G|evtfeldneu  = "%"
.input "is/AUSWAHL"
.copy M|selektion = M|select <> "!"
.continue INIT
..
!INITSEL: No selection bar
.copy M|selektion = G|FALSE
..
!INIT: Clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: State is not a state
.error -field M|staat -message 'M|staat^rnamebspr' ist kein Land!
.end 1
..
!ERROR02: State is not a state
.error -field M|region -message 'M|region^rnamebspr' ist keine Region!
.end 1
