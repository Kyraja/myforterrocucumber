..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRICEMAINTENANCE.REFRESH.RECORDVIEW
.. Author         : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  : If changes are made and saved to the database pricing the
.. view to them in the table of the infosystem needs a refresh done by this.
.. The refresh starts at the value specified by the item refreshrowno and ends
.. at the next row having a headerlevel. The refresh is done by an sequential
.. mix between these table rows an reloaded pricing in item tnum. Removals are
.. counted in item removedrows. Their actual removal in the infosystem is done
.. elsewhere by the java event handler class.
..*****************************************************************************
.set trans -
..
.select screen line 'M|refreshrowno'
.continue FATAL ? _G|mehr
.continue FATAL ?  M|tbaumstufe <> M|headerlevel
.continue END   ? _M|saved
..
.. Declarations
.type integer oldnumofrows ? _F|defined(U|oldnumofrows)
..
.. Initializations
.formula U|oldnumofrows = M|zeilen
..
.select object 'M|tnum^id'
.continue FATAL ? _G|mehr
..
!REFRESH: Refresh header row
.input 'M|tabheader' ? _F|empty(M|tabheader)
.. Protect row input items
.input 'M|protectscreenitems' ? _F|empty(M|protectscreenitems)
.. Finish, because we do not support adding rows
.continue END ? F|empty(U|oldnumofrows)
..
!NEXTROW: Load next screen row
.select screen line
!CHCKROW: Does next row exist
.continue END     ? _G|mehr
.continue END     ?  M|tbaumstufe = M|headerlevel
.continue DELETED ?  M|tmark & M|tremoverow
..
!NXTLINE
.select line
.continue FATAL ? _G|mehr
.input 'M|tabscaling' ? _F|empty(M|tabscaling)
.. Protect row input items
.input 'M|protectscreenitems' ? _F|empty(M|protectscreenitems)
.continue NEXTROW
..
!DELETED: Count removed rows
.formula M|removedrows = M|removedrows + 1
.continue NEXTROW
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL: Fatal error occured
.error -number 1111
.end 1
