..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ADDRESSMONITOR.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
.type integer xi          ? _F|defined(U|xi)
.type text    xgrliste.xi ? _F|defined(U|xgrliste.xi)
.type text    xgrliste1   ? _F|defined(U|xgrliste1)
.type text    xgrliste2   ? _F|defined(U|xgrliste2)
.type text    xgrliste3   ? _F|defined(U|xgrliste3)
.type text    xgrliste4   ? _F|defined(U|xgrliste4)
.type text    xgrliste5   ? _F|defined(U|xgrliste5)
.type text    xgrliste6   ? _F|defined(U|xgrliste6)
.type text    xgrliste7   ? _F|defined(U|xgrliste7)
.type text    xgrliste8   ? _F|defined(U|xgrliste8)
.type text    xgrliste9   ? _F|defined(U|xgrliste9)
.type text    xgrliste10  ? _F|defined(U|xgrliste10)
..
.continue BSTART  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "kunde"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "lieferant"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "mitarbeiter"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "einkauf"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "verkauf"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bank"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "speditionsauftrag"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "serviceprodukt"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "lager"
.continue BUGROUP ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "serviceanfrage"
.continue STATUS  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "slpstatus"
.continue DATUM   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "geprueft"
.continue PRUEF   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ungeprueft"
.continue END
..
!PRUEF
.continue CLRTAB ? _M|ungeprueft
.formula M|slpstatus = ""
.formula M|geprueft = ""
.continue CLRTAB
..
!STATUS
.copy M|ungeprueft = G|FALSE ? _F|empty(M|slpstatus) 
.continue CLRTAB
..
!DATUM
.copy M|ungeprueft = G|FALSE ? _F|empty(M|geprueft)
.continue CLRTAB
..
!BUGROUP
.formula M|bugruppe = M|bugruppe + 1 ? 'G|evtfeldneu' = 'G|TRUE'
.formula M|bugruppe = M|bugruppe - 1 ? 'G|evtfeldneu' = 'G|FALSE'
.continue UNDOBUT ? M|bugruppe = 0
.continue CLRTAB
..
!UNDOBUT: Not possible
.assign G|evtfeldneu = 'G|TRUE'
.formula M|bugruppe = 1
.continue END
..
!BSTART
.formula U|xgrliste.xi = ""
.formula U|xi = 1
..
.continue KUNDE       ? U|xi = 1 & M|kunde    
.continue SELECTMORE 
..
!KUNDE
.formula U|xgrliste.xi = "0:1.2.6.7"
.continue LOOP
..
!LIEFERANT
.formula U|xgrliste.xi = "1:1.2" 
.continue LOOP
..
!MITARBEITER
.formula U|xgrliste.xi = "11"
.continue LOOP
..
!EINKAUF
.formula U|xgrliste.xi = "4:20.21.22.23.24" 
.continue LOOP
..
!VERKAUF
.formula U|xgrliste.xi = "3:20.21.22.23.24.25.27.28.29.30.31" 
.continue LOOP
..
!BANK
.formula U|xgrliste.xi = "96:1"
.continue LOOP
..
!SPED
.formula U|xgrliste.xi = "55"
.continue LOOP
..
!SERVICE
.formula U|xgrliste.xi = "116:1"
.continue LOOP
..
!LAGER
.formula U|xgrliste.xi = "39"
.continue LOOP
..
!LOOP
.load 1 group 'U|xgrliste.xi' 'M|select'
.continue END  ? _G|mehr
.input 'M|tab' ? _F|empty(M|tab)
..
!WEITER
.load 1 continue 
.continue SELECTMORE ? _G|mehr
.input 'M|tab'       ? _F|empty(M|tab)
.continue WEITER
..
!SELECTMORE
.formula U|xi = U|xi + 1
.continue END         ? U|xi = 10
.formula U|xgrliste.xi = ""
..
.continue LIEFERANT   ? U|xi = 2  &  M|lieferant
.continue SELECTMORE  ? U|xi = 2  & _M|lieferant
.continue MITARBEITER ? U|xi = 3  &  M|mitarbeiter
.continue SELECTMORE  ? U|xi = 3  & _M|mitarbeiter
.continue EINKAUF     ? U|xi = 4  &  M|einkauf
.continue SELECTMORE  ? U|xi = 4  & _M|einkauf
.continue VERKAUF     ? U|xi = 5  &  M|verkauf
.continue SELECTMORE  ? U|xi = 5  & _M|verkauf
.continue BANK        ? U|xi = 6  &  M|bank
.continue SELECTMORE  ? U|xi = 6  & _M|bank
.continue SPED        ? U|xi = 7  &  M|speditionsauftrag
.continue SELECTMORE  ? U|xi = 7  & _M|speditionsauftrag
.continue SERVICE     ? U|xi = 8  &  M|serviceprodukt
.continue SELECTMORE  ? U|xi = 8  & _M|serviceprodukt
.continue LAGER       ? U|xi = 9  &  M|lager
.continue END         ? U|xi = 9  & _M|lager
.continue END
..
!CLRTAB
.input "is/TABLEEREN"
.continue END
..
..*****************************************************************************
!END
.continue

