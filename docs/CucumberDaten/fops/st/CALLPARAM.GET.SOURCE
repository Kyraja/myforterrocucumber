..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CALLPARAM.GET.SOURCE
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : xg
.. Functionality  : Get value of the parameter tupel (without row).
..*****************************************************************************
.set trans -
..
.. Initializations
.copy U|xcallval = ""
.copy U|xnovalue = G|FALSE
.copy U|xfatal = 0
.copy U|xadrbuff = "M"
.copy U|xadrrow = 0
..
.continue VALUE   ? F|equals(0|aufrwtyp, "(HeaderField)")
.continue MITEM   ? F|equals(0|aufrwtyp, "(TableField)")
.continue PITEM   ? F|equals(0|aufrwtyp, "(PrintParameter)")
.continue FORMULA ? F|equals(0|aufrwtyp, "(Formula)")
.continue CONSTNT ? F|equals(0|aufrwtyp, "(Constant)")
.copy U|xfatal = 3
.continue END
..
!MITEM: type is a name for a variable in the buffer M
.copy U|xadrrow = M|aktzeile
.continue VALUE
..
!PITEM: type is a name for a variable in the buffer P
.copy U|xadrbuff = "P"
..
!VALUE: Get value of variable
.continue NOVALUE ? F|empty(F|adr(U|xadrbuff, 0|aufrwert, U|xadrrow)) & 0|aufrpflicht
.set reference REF
.copy U|xcallval = 'F|adr(U|xadrbuff, 0|aufrwert, U|xadrrow)'
.set reference EXT
.continue END
..
!FORMULA: type is a FO expression
.assign U|xcallval = F|eval(0|aufrwert)
.continue END
..
!CONSTNT: type is a constant value
.copy U|xcallval = 0|aufrwert
.continue END
..
!NOVALUE: we have no value
.copy U|xnovalue = G|TRUE
..*****************************************************************************
!END
.continue
