..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VERWEND.ZW
.. Autor          : fwester
.. Verantwortlich : cl 
.. Kontrolle      : tiwe
.. Funktion       : Aktualisiert Details im Kopf aus der Zeile.
.. Ablauf         : Zeile-wechsel-EFOP
.. Functionality  : Updates details in header with row data.
.. Program flow   : Row changed efop
..*****************************************************************************
.set trans -
..
.formula M|kbaumstufe = M|tbaumstufe
.copy M|kbaumfliststd = M|tfliststd
.copy M|kbaumfertlist = M|tfertlist
.copy M|kfertlgruppe = M|tlgruppe
.copy M|kbaumelem = M|telem
.copy M|basisartikel = M|tbasisartikel
.copy M|kbaumdispo = M|tdispo
.copy M|ksprbaumd = M|tdispoa
.copy M|kbaumbsart = M|tbsart
.copy M|kbaumvater = M|tvaterelem
.formula M|kvorgaenger = M|tvorgaenger
.formula M|kbaumvpos = M|tvpos
.formula M|kbaumlaenge = M|tlaenge
.copy M|kkompeig = M|kompeig
.formula M|kkompeigz = M|kompeigz
.assign M|kbaumlme = ""
.copy M|kbaumlme = M|tellme ? _F|empty(M|tlaenge)
.formula M|kbaumbreite = M|tbreite
.assign M|kbaumbme = ""
.copy M|kbaumbme = M|telbme ? _F|empty(M|tbreite)
.formula M|kbaumanzahl = M|tanzahl
.assign M|kbaumelle = ""
.copy M|kbaumelle = M|telle ? F|empty(M|tlaenge) & F|empty(M|tbreite)
.copy M|kbaumbu = M|tbu
.copy M|kbaumersatzt = M|tersatzt
.copy M|kbaumverschl = M|tverschlt
.copy M|kbaumnwpflic = M|tnwpflicht
.copy M|kbaumserarch = M|tserarchiv
..*****************************************************************************
!END
.continue
