..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : PACKLIST.EV
.. Autor         : fwester
.. Verantwortlich: cl
.. Kontrolle     : lei
.. Funktion      : Behandelt die Feldaustrittsereignisse der Eingabefelder.
.. Ablauf        : Zentrales Ereignis-EFOP des Infosystems st/PACKLIST
..
.. Functionality : Handles field exit events of the input parameters.
.. Program flow  : Central event EFOP of the infosystem st/PACKLIST
..*****************************************************************************
.set trans -
..------------------------------- Header --------------------------------------
.continue NAME    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "hauptpaket"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "passres"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "objektliste"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "feldliste"
.continue OBJLI   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "objektliste"
.continue FELDLI  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "feldliste"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "testflagge"
..------------------------------- Table  --------------------------------------
.continue WECHSEL ? G|evtartengl = "ROW_CHANGED"
..=============================================================================
.continue END
..
!NAME: set name and modell of the package
.assign M|modell = M|hauptpaket^modell
.continue CLRTAB
..
!WECHSEL
.formula M|ktext = M|tbaumtext
.copy M|kozo = M|ozo
.copy M|kfzo = M|fzo
.copy M|kreferenz = M|referenz
.copy M|krefzeile = M|refzeile
.copy M|kfeldpass = M|feldpass
.copy M|kfeldname = M|feldname
.copy M|kfeldwert = M|feldwert
.copy M|kfeldref = M|feldref
.copy M|kelementpak = M|elementpaket
.continue END

!FELDLI
.assign M|objektliste = G|TRUE ? M|feldliste
.continue END

!OBJLI
.assign M|feldliste = G|FALSE ? _M|objektliste
.continue END

!CLRTAB: Clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
