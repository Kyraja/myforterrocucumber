..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUFGABEN.TAB
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : cl
.. Funktion       : Erzeugt eine Zeile in der Tabelle.
.. Functionality  : Creates a row in the table.
..*****************************************************************************
.set trans -
..
.continue MAKEROW ? _M|keineeigenen
..
.. Filter results
.continue END     ?  M|aktmitarb^id = H|bestaet^id & M|aktmitarb^id = H|bearbeit^id
..
!MAKEROW
.make screen line +O
..
.. General
.assign M|tbuzeigaufgabe = M|iconzeigen
.assign M|bfolge = M|iconfolge
.continue PROTECT ? H|ablagef
.continue PROTECT ? _F|cmdpermitted(86, 13, ,6)
.continue PROTECT ? F|empty(H|bestaet) ; F|empty(H|bearbeit)
.continue ISDONE  ? F|equals(M|tstatusneu, "(Done)")
.continue CONFIRM ? H|bestaet^id = G|passw^mitarb^id & H|bearbeit^id <> G|passw^mitarb^id
.continue DONE    ? H|bearbeit^id = G|passw^mitarb^id
.continue PROTECT
..
!ISDONE: Task is already done and only planer can confirm it
.continue CONFIRM ? H|bestaet^id = G|passw^mitarb^id
.continue PROTECT

!CONFIRM: Confirm task
.assign M|tstatusneu = "(Confirmed)"
.assign M|tbuaufgabefertig = "icon:garbage"
.continue TASK
..
!DONE: Task will be done
.assign M|tstatusneu = "(Done)"
.assign M|tbuaufgabefertig = M|iconfertig
.continue TASK
..
!PROTECT: User is not allowed to confirm tasks!
.protection tbuaufgabefertig 'M|aktzeile'
.protection tbuaufgabefertig2 'M|aktzeile'
..
!TASK: Copy task into mask buffer
.assign M|taufgabe = H|id
.copy M|tintern = H|intern
..
.. Date & urgency
.copy M|tstart = H|start
.copy M|tend H|end
.copy M|tstartzeit = H|startzeit
.copy M|tendzeit H|endzeit
.copy M|tstatus = H|status
.copy M|tprio = H|prio
.copy M|tablauf = H|ablauf
.copy M|tablaufzust = H|ablaufzust
..
.. Persons, documents & other assignments
.copy M|tursache = H|ursache
.copy M|tprojekt = H|projekt
.copy M|tpartner = H|partner
.copy M|tteam = H|team
.copy M|tdokumente = H|dokumente
.copy M|telem = H|elem
.copy M|tevvorgang = H|evvorgang
.formula M|ttypa = H|evvorgang^typa
.copy M|tbearbeit = H|bearbeit
.copy M|tbestaet = H|bestaet
.formula M|beschrbspr = H|beschrbspr
..*****************************************************************************
!END
.continue
