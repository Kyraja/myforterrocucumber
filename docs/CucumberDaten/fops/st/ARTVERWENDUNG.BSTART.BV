..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTVERWENDUNG.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Validiert Eingaben und formuliert Datenbankanfrage.
.. Functionality  : Validates inputs and builds database query.
..*****************************************************************************
.set trans -
..
.continue ERROR01 ? _(M|selgroup1 ; M|selgroup2 ; M|selgroup3 ; M|selgroup4)
.continue CLRTAB  ? _(F|empty(M|identnummer) & F|empty(M|auswahl))
..
.. Check error conditions
.continue CLRTAB  ? F|equals(M|operatoru, "(Empty)") ; F|equals(M|operatoru, "(Filled)")
.continue ERROR02
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..
.assign M|indexselect = 0
.assign M|vname = ""
.continue OPERAT ? F|empty(M|az) & F|empty(M|art)
..
.formula M|suchmuster = F|formatstr("^{1}[:LETTER:]*{2}$", M|suchpraefix, M|identnummer)
.formula M|auswahl = M|suchmuster
.assign M|operator = "(RegExp)"
..
!OPERAT: Set operator for DB query
.."Normal"
.assign M|selectoperator = "="    ? F|equals(M|operatoru, "(Normally)")
.."Leer"
.assign M|selectoperator = "=`"   ? F|equals(M|operatoru, "(Empty)")
.."GefÅllt"
.assign M|selectoperator = "<>`"  ? F|equals(M|operatoru, "(Filled)")
.."Gleich"
.assign M|selectoperator = "=="   ? F|equals(M|operatoru, "(Equal)")
.."Ungleich"
.assign M|selectoperator = "<>"   ? F|equals(M|operatoru, "(Unequal)")
.."Gleich G"
.assign M|selectoperator = "~"    ? F|equals(M|operatoru, "(EqualIC)")
.."Ungleich G"
.assign M|selectoperator = "~<>"  ? F|equals(M|operatoru, "(UnequalIC)")
.."Enthalten"
.assign M|selectoperator = "/"    ? F|equals(M|operatoru, "(Contain)")
.."Enthalten G"
.assign M|selectoperator = "~/"   ? F|equals(M|operatoru, "(ContainIC)")
.."Enthalten W"
.assign M|selectoperator = "//"   ? F|equals(M|operatoru, "(ContainW)")
.."Enthalten G W"
.assign M|selectoperator = "~//"  ? F|equals(M|operatoru, "(ContainICW)")
.."Normal G"
.assign M|selectoperator = "~="   ? F|equals(M|operatoru, "(NormalIC)")
.."Normal ex"
.assign M|selectoperator = "="    ? F|equals(M|operatoru, "(NormalEx)")
.."Normal G ex"
.assign M|selectoperator = "~="   ? F|equals(M|operatoru, "(NormalUEx)")
.."Matchcode"
.assign M|selectoperator = "=`"   ? F|equals(M|operatoru, "(Matchcode)")
.."Matchcode n"
.assign M|selectoperator = "<>`"  ? F|equals(M|operatoru, "(MatchcodeN)")
.."Matchcode G"
.assign M|selectoperator = "~=`"  ? F|equals(M|operatoru, "(MatchcodeIC)")
.."Matchcode G n"
.assign M|selectoperator = "~<>`" ? F|equals(M|operatoru, "(MatchcodeUN)")
.."Ausdruck"
.assign M|selectoperator = "/=="  ? F|equals(M|operatoru, "(RegExp)")
.."Ausdruck n"
.assign M|selectoperator = "/<>"  ? F|equals(M|operatoru, "(ExpressionN)")
.."Ausdruck G"
.assign M|selectoperator = "~/==" ? F|equals(M|operatoru, "(ExpressionIC)")
.."Ausdruck G n"
.assign M|selectoperator = "~/<>" ? F|equals(M|operatoru, "(ExpressionUN)")
.continue FORMAT ? F|empty(M|auswahl)
.formula M|suchmuster = M|auswahl
..
!FORMAT
.formula M|selectmuster = "$,,;"
.formula M|selectmuster = M|selectmuster + "{1}{2}{3}"
.formula M|selectmuster = M|selectmuster + ";@ablageart=(Active)"
.formula M|selectmuster = M|selectmuster + ";@zeilen=" + 'G|TRUE'
.formula M|selectmuster = M|selectmuster + ";@ordnung=such,zn"
.formula M|selectmuster = M|selectmuster + ";@datenbank={4}"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Group is missing
.error -line 0 -field M|selgroup1 -message Es fehlt die Angabe eines Suchbereiches!
.continue BREAK
..
!ERROR02: Number is missing
.error -line 0 -field M|art -message Es fehlt die Angabe einer Art!
..
!BREAK
.end 1
