..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALENDVERWEND.EV
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem Kalenderverwendung: Eventbehandlung
.. Functionality  :
.. Ablauf         : Behandelt alle Feld- und Button-Events
..
..*****************************************************************************
.type ID137 xkal     ? _F|defined(U|xkal)
.type integer   xistufe  ? _F|defined(U|xistufe)
..
.set trans -
..  ---------------------------------------------------------------------------
..  Kopfteil
..  ---------------------------------------------------------------------------
.input "is/TABLEEREN" ? G|evtartengl="FIELD_EXIT"    & G|evtvar="bmoregion"
.continue KALEND          ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kal"
.continue HOLBEZ          ? G|evtartengl="BUTTON_AFTER"  & G|evtvar="bstart"
..  ---------------------------------------------------------------------------
..  Tabellenteil
..  ---------------------------------------------------------------------------
.continue WECHSEL    ? G|evtartengl="ROW_CHANGED"
.continue END
..
!KALEND
.formula   M|select  = ""
.assign M|bezobj  = M|kal^bezobj
.formula   M|lgruppe = M|kal^lgruppe
.formula   M|gltvon  = M|kal^gltvon
.formula   M|gltbis  = M|kal^gltbis
.copy M|bmoregion = G|FALSE                ?  F|empty(M|kal)
.protection bmoregion                              ? _F|empty(M|kal)
.protection -reset bmoregion                       ?  F|empty(M|kal)
.continue LEEREN                                 ?  F|empty(M|kal)
.assign U|xkal  = M|kal
.formula M|select  = 'U|xkal'
.protection bmoregion ? M|kal^gruppe = 2 ; (M|kal^gruppe=1 & _F|empty(M|kal^dispobezobj) & M|kal^dispobezobj^dnr<>97)
.protection -reset bmoregion     ? M|kal^gruppe = 1 & (F|empty(M|kal^dispobezobj) ; M|kal^dispobezobj^dnr=97)
.continue LEEREN
..
!HOLBEZ
.error Bitte erst einen Kalender eintragen.   ? F|empty(M|kal)
.end 1                                        ? F|empty(M|kal)
..
.formula U|xistufe = 1
.input "is/TABLEEREN"
.input 'M|tab'  ? _F|empty(M|tab)
.continue END
..
!LEEREN
.input "is/TABLEEREN"
.continue END
..
!END
.continue
