..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VERWENDERSATZ.BUERSETZEN.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : amk
.. Funktion       : Steuert die Ersetzungen.
.. Ablauf         : Button-nach-EFOP
..
.. Functionality  : Controls the substitutions.
.. Program flow   : Button after efop
..*****************************************************************************
.set trans -
..
.continue ALLUSES ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "kbuersetzen"
.continue TABUSES ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tbuersetzen"
.continue FATAL
..
!ALLUSES: Change all uses in the table
.formula M|stufe = 0
.continue REPLACE
..
!TABUSES: Change certain uses in the table
.continue END ? _M|tersetzbar
.formula M|stufe = M|tbaumstufe
.continue REPLACE
..
!REPLACE: Replace uses
.input "st/VERWENDERSATZ.ERSETZEN"
..
.continue HINT1 ? _G|edp & M|erfolgreich
.continue HINT2 ? _G|edp
..
!REFRESH
.input "st/VERWENDERSATZ.AKTUALISIEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
..
..
!HINT1
.box 'M|ersatztxt'
Der Speichervorgang war erfolgreich!
.continue REFRESH
..
!HINT2
.box 'M|ersatztxt'
Der Speichervorgang ist gescheitert!
?'M|errortext' ? M|errortext <> ""
.continue ERROR3 ? M|stufe = 0
.continue REFRESH
..
!ERROR3
.continue REFRESH ? _F|filenotempty('M|error')
..
.output terminal
..
'M|error'
=================
.input -text 'M|error'
.continue REFRESH
