..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : WIRTSCHAFTSRAUM.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Beschaffung von Regionen.
.. Ablauf         : Button-nach-EFOP
..
.. Functionality  : Loads regions.
.. Program flow   : After button efop
..*****************************************************************************
.set trans -
..
.continue START ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue KNOT  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "tbaumaufzu"
..
!START: Create root element
.input "is/HOL.LISTE"
.formula M|aktknoten = M|aktzeile
.select screen header
..
!NEXT: Open knot
.select screen line 'M|aktknoten'
.continue END ? _G|mehr
.colour -foreground -1 -1 -1 -background -1 -1 -1 'M|aktzeile'
.colour -background 'M|tfarbe' 'M|aktzeile'
.continue ITERATE ? M|tbaumstat <> "+"
.continue ITERATE ? F|empty(M|identnr)
.formula M|stufe = M|tbaumstufe + 1
.continue ITERATE ? M|stufe > M|anzstufen
.formula M|select = 'F|formatstr("$,,;ueberg={1};@ordnung=such", M|identnr)'
.input "is/HOL.LISTE"
..
!ITERATE
.formula M|aktknoten = M|aktknoten + 1
.continue END ? M|aktknoten > M|tzeilen
.continue NEXT
..
!KNOT
.colour -foreground -1 -1 -1 -background -1 -1 -1 'M|aktzeile'
.colour -background 'M|tfarbe' 'M|aktzeile'
.continue ITERATE ? F|empty(M|identnr)
.formula M|stufe = M|tbaumstufe + 1
.formula M|select = 'F|formatstr("$,,;ueberg={1};@ordnung=such", M|identnr)'
.input "is/HOL.LISTE"
..*****************************************************************************
!END
.continue
