..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PROJECT.ABASDMS.IDX
.. Author         : fwester
.. Verantwortlich : teamreport
.. Kontrolle      : fwester
.. Functionality  : Creates index file for abas-DMS for drag and drop with
..                  given project.
..*****************************************************************************
.set trans -
..
.type text    xt              ? _F|defined(U|xt)
.type P88:11  xdmsbelegart    ? _F|defined(U|xdmsbelegart)
.type VID99   xid             ? _F|defined(U|xid)
.type VP5     xkuli           ? _F|defined(U|xkuli)
.type VID98   xursache        ? _F|defined(U|xursache)
.type text    xbetreff        ? _F|defined(U|xbetreff)

..
.input "dms/FIND.CONTEXT"
..
.file -tempname U|xt
..
.output new 'U|xt' -encoding "UTF-8"
.input "DATEI.F"
..
.input "STD.ABASDMS.IDX"
..
.assign U|xbetreff = M|dndbetreff    ? F|defined(M|dndbetreff)
.assign U|xbetreff = M|betreff       ? F|defined(M|betreff) & F|empty(U|xbetreff)
?Betreff='U|xbetreff'     ? _F|empty(U|xbetreff)
..
.continue SETDATE ? _F|defined(M|beldat)
?BelDat='M|beldat(L="0")' ? _F|empty(M|beldat)
..
!SETDATE
BelDat='F|value(G|datum, "GD2")(L="0")'
..
AbasPRID='U|xid^id'
ProjNr='U|xid^nummer'
ProjSuch='U|xid^such'
ProjBez='U|xid^name'
..
.copy U|xursache = U|xid^ursache
.continue WRITE                         ? F|empty(U|xursache)
.continue WRITE                         ? U|xursache^dnr > 4
.assign U|xkuli = U|xursache            ? U|xursache^dnr = 0 ; U|xursache^dnr = 1
.continue PARTNER                       ? _F|empty(U|xkuli)
.assign U|xkuli = U|xursache^kl^id      ? F|defined(U|xursache^kl)
.continue PART                          ? U|xursache^dnr = 2
.continue PURCHASE                      ? U|xursache^dnr = 4
..
?VKRAufNr='U|xursache^nummer'  ? U|xursache^ktyp = G|rako
?AbasVOID='U|xursache'         ? U|xursache^ktyp = G|rako
..
?VKAngNr='U|xursache^nummer'   ? U|xursache^ktyp = G|anko
?AbasVAID='U|xursache'         ? U|xursache^ktyp = G|anko
..
?VKAufNr='U|xursache^nummer'   ? U|xursache^ktyp = G|abko
?AbasVBID='U|xursache'         ? U|xursache^ktyp = G|abko
..
?VKLiefNr='U|xursache^nummer'  ? U|xursache^ktyp = G|liko
?AbasVLID='U|xursache'         ? U|xursache^ktyp = G|liko
..
?VKRechNr='U|xursache^nummer'  ? U|xursache^ktyp = G|reko
?AbasVRID='U|xursache'         ? U|xursache^ktyp = G|reko
.continue PARTNER
..
!PURCHASE
?EKRAufNr='U|xursache^nummer'  ? U|xursache^ktyp = G|rako
?AbasEOID='U|xursache'         ? U|xursache^ktyp = G|rako
..
?EKAnfNr='U|xursache^nummer'   ? U|xursache^ktyp = G|anko
?AbasEAID='U|xursache'         ? U|xursache^ktyp = G|anko
..
?EKBestNr='U|xursache^nummer'  ? U|xursache^ktyp = G|abko
?AbasEBID='U|xursache'         ? U|xursache^ktyp = G|abko
..
?EKLiefNr='U|xursache^nummer'  ? U|xursache^ktyp = G|liko
?AbasELID='U|xursache'         ? U|xursache^ktyp = G|liko
..
?EKRechNr='U|xursache^nummer'  ? U|xursache^ktyp = G|reko
?AbasERID='U|xursache'         ? U|xursache^ktyp = G|reko
..
!PARTNER
.input "st/KULI.ABASDMS.IDX"
.continue WRITE
..
!PART
abasaid='U|xursache'
ArtNr='U|xursache^nummer'
ArtSuch='U|xursache^such'
ArtBez='U|xursache^name'
..
!WRITE
.system 'F|expr("crlf+ < " + U|xt + " >" + U|xxmldata)' background
..*****************************************************************************
!END
.continue
