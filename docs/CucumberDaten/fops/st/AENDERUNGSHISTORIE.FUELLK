..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDERUNGSHISTORIE.FUELLK
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : lei
.. Funktion       :
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type GL   zeilenselektion   ? _F|defined(U|zeilenselektion)
.type bool xtreffer          ? _F|defined(U|xtreffer)
.type text xtext ? _F|defined(U|xtext)
.type text xftext ? _F|defined(U|xftext)
.file -tempname U|xftext
.output new 'U|xftext'
..
.assign M|select = "!"
.copy M|numsuch = _F|regmatch(M|select, "^[%$].*")
.continue GROUP   ? _M|numsuch
.assign M|select = F|formatstr("$,,@numsuch={1}", M|select)
..
!GROUP
.formula M|grliste = 'M|datnr'+":"+'M|vartabgruppe^vgr' 
.load 6 group 'M|grliste' 'M|select'
.continue END  ? _G|mehr
..
.. hier lade ich die gewÑhlte Vartab in den 7-Puffer
.load 7 metadata "6|"
.continue END ? _G|mehr
.assign U|zeilenselektion = F|formatstr("$,,vname==itversionn;vkt==0;vlgsb=;vversionausloeser=1")
.load 7 line 'U|zeilenselektion'
.copy U|xtreffer = G|TRUE ?   G|mehr
.load 7
.load 7 metadata "6|"
.continue END ? _G|mehr
.. vms = Ñnderbar, Kopf, FO bekannt (vlgsb) bleibt unberÅcksichtigt, VA gesetzt
.assign U|zeilenselektion = F|formatstr("$,,vname~/==^..;vkt==0;vlgsb=;vversionausloeser=1") ? _U|xtreffer
.assign U|zeilenselektion = F|formatstr("$,,vname~/==^..;vkt==0;vlgsb=") ? U|xtreffer
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.output addedto 'U|xftext'
.input "DATEI.F"
.formula U|xtext = 'F|substr(7|vname, 3, )'
.formula U|xtext = 'F|toupper(U|xtext)'
'U|xtext'
.output
.formula M|ausloeser2kopf = U|xftext
..
!SEL7
.load 7 line
.continue END   ? _G|mehr
.output addedto 'U|xftext'
.input "DATEI.F"
.formula U|xtext = 'F|substr(7|vname, 3, )'
.formula U|xtext = 'F|toupper(U|xtext)'
'U|xtext'
.output
.formula M|ausloeser2kopf = U|xftext
.continue SEL7
..
!END
.continue
