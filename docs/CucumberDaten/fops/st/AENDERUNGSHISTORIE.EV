..!interpreter english translate noabbrev
.. *****************************************************************************
.. FOP-Name       : AENDERUNGSHISTORIE.EV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : lei
.. Funktion       : Anzeige der énderungshistorie eines Objektes
.. Functionality  : Shows editing history of an data object.
...Includes       :
.. *****************************************************************************
.set trans -
.type text    xsel                 ? _F|defined(U|xsel)
.type text    zeilenselektion      ? _F|defined(U|zeilenselektion)
.type integer xpos                 ? _F|defined(U|xpos)
.type integer xlength              ? _F|defined(U|xlength)
.type integer xgeslength           ? _F|defined(U|xgeslength)
.type text    ausloeserkopfl       ? _F|defined(U|ausloeserkopfl)
.type text    ausloeserkopfr       ? _F|defined(U|ausloeserkopfr)
.type text    ausloesertabellel    ? _F|defined(U|ausloesertabellel)
.type text    ausloesertabeller    ? _F|defined(U|ausloesertabeller)
.type text    xneuausloeserkopf    ? _F|defined(U|xneuausloeserkopf)
.type text    xneuausloesertabelle ? _F|defined(U|xneuausloesertabelle)
.type text    xneufelderkopf       ? _F|defined(U|xneufelderkopf)
.type text    xneufeldertabelle    ? _F|defined(U|xneufeldertabelle)
.type bool    xok                  ? _F|defined(U|xok)
.type text    xausloeserkopf       ? _F|defined(U|xausloeserkopf)
.type text    xausloesertabelle    ? _F|defined(U|xausloesertabelle)
.type text    xfelderkopf          ? _F|defined(U|xfelderkopf)
.type text    xfeldertabelle       ? _F|defined(U|xfeldertabelle)
..
.continue BUDATNAME ? G|evtartengl="BUTTON_AFTER" & G|evtvar="budatname" 
.continue REIN      ? G|evtartengl="BUTTON_AFTER" & G|evtvar="burein"
.continue RAUS      ? G|evtartengl="BUTTON_AFTER" & G|evtvar="buraus"
.continue FELDER    ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bufelder"
.continue BUTTON    ? G|evtartengl="BUTTON_AFTER" & (G|evtvar="bukopf" ; G|evtvar="butabelle")
.continue BUTTON    ? G|evtartengl="BUTTON_AFTER" & (G|evtvar="tabelle" ; G|evtvar="kopf")
.continue END
..
!KWEITERE: vms = Ñnderbar, Kopf, FO bekannt, VA nicht gesetzt
.assign U|zeilenselektion = F|formatstr("%,,vname~/==^..;vbed=;vkt==0;vlgsb=1;vversionausloeser=0")
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.formula U|xfelderkopf = 'F|substr(7|vname, 3, )'
.formula U|xfelderkopf = F|toupper(U|xfelderkopf) + ","   ? F|length(M|felderkopf) < 2900
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr(".*[ ,]{1}", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr(".*[ ,]{1}[ ,]", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr("[ ,]{1}[ ,]", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr("[ ,]{1}", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr("[ ,]{1}[ ,].*", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr("{1}", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr("{1}[ ,].*", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr("{1}[ ,]", U|xfelderkopf))
.continue ERROR3   ? F|regmatch(M|felderkopf, F|formatstr(".*[ ,]{1}[ ,].*", U|xfelderkopf))
.formula M|felderkopf = M|felderkopf + U|xfelderkopf
.continue END
..
!TWEITERE
.assign U|zeilenselektion = F|formatstr("%,,vname~/==^..;vbed=;vkt==1;vlgsb=1;vversionausloeser=0")
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.formula U|xfeldertabelle = 'F|substr(7|vname, 3, )' 
.formula U|xfeldertabelle = F|toupper(U|xfeldertabelle) + ","  ?  F|length(M|feldertabelle) < 2900
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr(".*[ ,]{1}", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr(".*[ ,]{1}[ ,]", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr("[ ,]{1}[ ,]", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr("[ ,]{1}", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr("[ ,]{1}[ ,].*", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr("{1}", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr("{1}[ ,].*", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr("{1}[ ,]", U|xfeldertabelle))
.continue ERROR3   ? F|regmatch(M|feldertabelle, F|formatstr(".*[ ,]{1}[ ,].*", U|xfeldertabelle))
.formula M|feldertabelle = M|feldertabelle + U|xfeldertabelle
.continue END
..
!BUTTON
.continue ERROR2 ? F|empty(M|vartabgruppe)
.input "is/TABLEEREN"  ? M|tzeilen > 0
.formula M|select="$,,@datenbank=" + 'M|kid^dnr' + ";@gruppe=" + 'M|kid^gruppe' + ";@ablageart=versioniert, beides;id=" + 'M|kid^id' + ";"  ? _F|empty(M|kid)
.formula M|select="$,,@datenbank=" + 'M|datnr' + ";@gruppe=" + 'M|vartabgruppe^vgr' + ";@ablageart=versioniert, beides;"                    ?  F|empty(M|kid)
.formula M|kselect = 'M|select' + ";stand=" + 'M|von' + "!" + 'M|bis' + ";" + "zeichen=" + M|bearbeiter + ";"
.formula M|grliste = 'M|datnr'+":"+'M|vartabgruppe^vgr' 
.load 6 group 'M|grliste' 'M|select'
.continue END  ? _G|mehr
..
.. hier lade ich die gewÑhlte Vartab in den 7-Puffer
.load 7 metadata "6|"
.continue END ? _G|mehr
..
.continue KOPF     ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bukopf"
.continue TABELLE  ? G|evtartengl="BUTTON_AFTER" & G|evtvar="butabelle"
.continue KWEITERE ? G|evtartengl="BUTTON_AFTER" & G|evtvar="kopf"
.continue TWEITERE ? G|evtartengl="BUTTON_AFTER" & G|evtvar="tabelle"
..
!KOPF: vms = Ñnderbar, Kopf, FO bekannt, VA gesetzt
.assign U|zeilenselektion = F|formatstr("%,,vname~/==^..;vbed=;vkt==0;vlgsb=1;vversionausloeser=1")
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.formula U|xausloeserkopf = 'F|substr(7|vname, 3, )'
.formula U|xausloeserkopf = F|toupper(U|xausloeserkopf) + ","   ? F|length(M|ausloeserkopf) < 2900
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}[ ,]", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}[ ,]", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}[ ,].*", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}[ ,].*", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}[ ,]", U|xausloeserkopf))
.continue ERROR3   ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}[ ,].*", U|xausloeserkopf))
.formula M|ausloeserkopf = M|ausloeserkopf + U|xausloeserkopf
.protection -reset ausloeserkopf
.protection -reset ausloeser2kopf
.formula M|ausloeser2kopf = ""
.copy M|allekopf = G|FALSE
.continue END
..
!TABELLE: Tabelle, FO bekannt, VA gesetzt
.assign U|zeilenselektion = F|formatstr("%,,vname~/==^..;vbed=;vkt==1;vlgsb=1;vversionausloeser=1") 
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.formula U|xausloesertabelle = 'F|substr(7|vname, 3, )' 
.formula U|xausloesertabelle =  F|toupper(U|xausloesertabelle) + ","  ?  F|length(M|ausloesertabelle) < 2900
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}[ ,]", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}[ ,]", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}[ ,].*", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}[ ,].*", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}[ ,]", U|xausloesertabelle))
.continue ERROR3   ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}[ ,].*", U|xausloesertabelle))
.formula M|ausloesertabelle = M|ausloesertabelle + U|xausloesertabelle
.protection -reset ausloesertabelle
.protection -reset ausloeser2tabelle
.formula M|ausloeser2tabelle = ""
.copy M|alletabelle = G|FALSE
.continue END
..
!FELDER
.select screen header 
.continue ERROR4  ? M|tzeilen = 0
...
!LINE 
.select screen line
.continue SUM   ? _G|mehr
.continue LINE  ? _M|bauswahl
.formula U|xneuausloeserkopf = U|xneuausloeserkopf + "," + M|tfeldname       ? M|typk &  M|va & M|talt <> "-" 
.formula U|xneuausloesertabelle = U|xneuausloesertabelle + "," + M|tfeldname ? M|typt &  M|va & M|talt <> "-" 
.formula U|xneuausloeserkopf = U|xneuausloeserkopf + "," + M|tfeldname       ? M|typk & _M|va & M|talt = "-"  
.formula U|xneuausloesertabelle = U|xneuausloesertabelle + "," + M|tfeldname ? M|typt & _M|va & M|talt = "-"  
.formula U|xneufelderkopf = U|xneufelderkopf + "," + M|tfeldname             ? M|typk & _M|va & M|talt <> "-" 
.formula U|xneufeldertabelle = U|xneufeldertabelle + "," + M|tfeldname       ? M|typt & _M|va & M|talt <> "-" 
.continue LINE
..
!SUM
.continue ERROR5 ? F|empty(U|xneuausloeserkopf) & F|empty(U|xneuausloesertabelle)
.copy M|allekopf = G|FALSE
.copy M|alletabelle = G|FALSE
.. fÅhrendes "," wegschneiden
.formula U|xlength = F|length(U|xneuausloeserkopf) -1
.formula U|xneuausloeserkopf = F|substr(U|xneuausloeserkopf, 2, U|xlength)  ?  F|regmatch(U|xneuausloeserkopf, ",.*")
.formula U|xlength = F|length(U|xneuausloesertabelle) -1
.formula U|xneuausloesertabelle = F|substr(U|xneuausloesertabelle, 2, U|xlength)  ? F|regmatch(U|xneuausloesertabelle, ",.*")
.formula U|xlength = F|length(U|xneufelderkopf) -1
.formula U|xneufelderkopf = F|substr(U|xneufelderkopf, 2, U|xlength)  ? F|regmatch(U|xneufelderkopf, ",.*")
.formula U|xlength = F|length(U|xneufeldertabelle) -1
.formula U|xneufeldertabelle = F|substr(U|xneufeldertabelle, 2, U|xlength)  ? F|regmatch(U|xneufeldertabelle, ",.*")
.protection -reset ausloeserkopf
.formula M|ausloeserkopf = U|xneuausloeserkopf
.protection -reset ausloesertabelle  ? _M|dbnotab
.formula M|ausloesertabelle = U|xneuausloesertabelle
.formula M|felderkopf = U|xneufelderkopf
.formula M|feldertabelle = U|xneufeldertabelle
.formula M|ausloeser2kopf = ""
.protection ausloeser2kopf
.formula M|ausloeser2tabelle = ""
.protection ausloeser2tabelle
.protection -reset felderkopf
.protection -reset feldertabelle  ? _M|dbnotab
.input "is/TABLEEREN"
.continue END 
..
!BUDATNAME
.continue ERROR1 ? F|empty(M|tnummer)
.copy M|kid = M|tnummer
.input "is/TABLEEREN"
.input "st/AENDH.BSTART.BV"
.input "st/AENDERUNGSHISTORIE"
.continue END
..
!REIN: Felder in Selektion aufnehmen
.continue REINTABELLE ? M|typt
..
!REINKOPF
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}[ ,]", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}[ ,]", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}[ ,].*", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}[ ,].*", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}[ ,]", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}[ ,].*", M|tfeldname))
.formula M|ausloeserkopf = 'M|ausloeserkopf' + "," + 'M|tfeldname' ? _F|regmatch(M|ausloeserkopf, ".*,") & _F|empty(M|ausloeserkopf)
.formula M|ausloeserkopf = 'M|ausloeserkopf' + 'M|tfeldname'       ?  F|regmatch(M|ausloeserkopf, ".*,")
.formula M|ausloeserkopf = 'M|tfeldname'                           ?  F|empty(M|ausloeserkopf)
.copy M|allekopf = G|FALSE
.formula M|ausloeser2kopf = ""
.protection ausloeser2kopf
.protection -reset ausloeserkopf
.continue END
..
!REINTABELLE
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}", M|tfeldname))   
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}[ ,]", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}[ ,]", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}[ ,].*", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}[ ,].*", M|tfeldname))
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}[ ,]", M|tfeldname))  
.continue REINHINWEIS ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}[ ,].*", M|tfeldname))
.formula M|ausloesertabelle = 'M|ausloesertabelle' + "," + 'M|tfeldname' ? _F|regmatch(M|ausloesertabelle, ".*,") & _F|empty(M|ausloesertabelle)
.formula M|ausloesertabelle = 'M|ausloesertabelle' + 'M|tfeldname'       ?  F|regmatch(M|ausloesertabelle, ".*,")
.formula M|ausloesertabelle = 'M|tfeldname'                              ?  F|empty(M|ausloesertabelle)
.copy M|alletabelle = G|FALSE
.formula M|ausloeser2tabelle = ""
.protection ausloeser2tabelle
.protection -reset ausloesertabelle ? _M|dbnotab
.continue END
..
!REINHINWEIS
.note Feld bereits enthalten!
.continue END 
..
!RAUS: Felder aus Selektion entfernen
.continue RAUSTABELLE ? M|typt
..
!RAUSKOPF
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}[ ,]", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}[ ,]", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr("[ ,]{1}[ ,].*", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}[ ,].*", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr("{1}[ ,]", M|tfeldname))
.continue JARAUSKOPF  ? F|regmatch(M|ausloeserkopf, F|formatstr(".*[ ,]{1}[ ,].*", M|tfeldname))
.continue RAUSHINWEIS
..
!JARAUSKOPF
.formula U|xgeslength = F|length(M|ausloeserkopf)
.. an welcher Position steht das Feld tfeldname?
.formula U|xpos = F|regindex(M|ausloeserkopf, M|tfeldname) - 1  
.formula U|xlength = F|length(M|tfeldname) + 1
.formula U|ausloeserkopfl = F|substr(M|ausloeserkopf, U|xpos, -(U|xpos))
.formula U|ausloeserkopfr = F|substr(M|ausloeserkopf, (U|xpos + U|xlength), U|xgeslength)
.formula M|ausloeserkopf = U|ausloeserkopfl + U|ausloeserkopfr
.. ersetze ,, zu ,
.formula M|ausloeserkopf = F|regreplaceall(M|ausloeserkopf, "\,,", ",")
.formula U|xlength = F|length(M|ausloeserkopf) -1 
.. fÅhrendes "," wegschneiden
.formula M|ausloeserkopf = F|substr(M|ausloeserkopf, 2, U|xlength)  ?  F|regmatch(M|ausloeserkopf, ",.*")
.copy M|allekopf = G|FALSE 
.protection -reset ausloeserkopf
.continue END
..
!RAUSTABELLE
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}[ ,]", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}[ ,]", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr("[ ,]{1}[ ,].*", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}[ ,].*", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr("{1}[ ,]", M|tfeldname))
.continue JARAUSTABELLE ? F|regmatch(M|ausloesertabelle, F|formatstr(".*[ ,]{1}[ ,].*", M|tfeldname))
.continue RAUSHINWEIS
..
!JARAUSTABELLE
.formula U|xgeslength = F|length(M|ausloesertabelle)
.. an welcher Position steht das Feld tfeldname?
.formula U|xpos = F|regindex(M|ausloesertabelle, M|tfeldname) - 1
.formula U|xlength = F|length(M|tfeldname) + 1
.formula U|ausloesertabellel = F|substr(M|ausloesertabelle, xpos, -(xpos))
.formula U|ausloesertabeller = F|substr(M|ausloesertabelle, (xpos + xlength), xgeslength)
.formula M|ausloesertabelle = U|ausloesertabellel + U|ausloesertabeller
.. ersetze ,, zu ,
.formula M|ausloesertabelle = F|regreplaceall(M|ausloesertabelle, "\,,", ",")
.formula U|xlength = F|length(M|ausloesertabelle) -1
.. fÅhrendes "," wegschneiden
.formula M|ausloesertabelle = F|substr(M|ausloesertabelle, 2, U|xlength)  ?  F|regmatch(M|ausloesertabelle, ",.*")
.copy M|alletabelle = G|FALSE
.protection -reset ausloesertabelle   ? _M|dbnotab
.continue END
..
.. *****************************************************************************
!END
.continue 
..
!RAUSHINWEIS
.note Feld nicht enthalten!
.continue END
..
!ERROR01
.error Auswahl konnte nicht durchgefÅhrt werden!
.end 1
..
!ERROR2
.error Bitte Datenbank selektieren.
.end 1
..
!ERROR3 
.error Feld bereits enthalten!
.continue
..
!ERROR4
.error Keine Tabellenzeilen geladen.
.end 1
..
!ERROR5
.error Keine Auswahlfelder in Tabelle selektiert.
.end 1 
