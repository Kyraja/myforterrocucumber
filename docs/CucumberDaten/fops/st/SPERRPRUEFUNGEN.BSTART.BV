..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SPERRPRUEFUNGEN.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Beschreibt die Datenbankanfrage fuer die Sperrpruefungen.
.. Functionality  : Builds query for lock validations.
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xpvon xpbis
..
.. Initalizations
.assign U|xpvon = "19810101000000"
.assign U|xpbis = "40001231000000"
..
.. Validate range of dates
.continue ERROR1 ? F|empty(M|vonaendzeit) & F|empty(M|bisaendzeit)
.assign U|xpvon = 'M|vonaendzeit:14' ? _F|empty(M|vonaendzeit)
.assign U|xpbis = 'M|bisaendzeit:14' ? _F|empty(M|bisaendzeit)
.continue ERROR2 ? 'U|xpvon' > 'U|xpbis'
..
.. Initializations
.assign M|select = "$,,"
..
!QUERY: Build query
.formula M|select = M|select + ";aendzeit=" + 'M|vonaendzeit' + "!" + 'M|bisaendzeit'
.formula M|select = M|select + ";pruefstatus==" + 'M|pruefstatus(L="0")'
.continue STAFFER ? F|empty(M|tlobj)
.continue LIST    ? M|tlobj^gruppe = 2
.continue ENTRY   ? M|tlobj^gruppe = 3
.continue FATAL
..
!LIST: Add criteria for given list
.formula M|select = M|select + ";tlliste==" + M|tlobj^id
.continue STAFFER
..
!ENTRY: Add criteria for given entry
.formula M|select = M|select + ";tlliste==" + M|tlobj^liste^id
.formula M|select = M|select + ";tlobj==" + M|tlobj^id
..
!STAFFER: Add criteria for staffer
.continue ABASOBJ ? F|empty(M|kzeich)
.formula M|select = M|select + ";zeich==" + M|kzeich
..
!ABASOBJ: Add criteria for abas ERP object
.continue OPTIONS ? F|empty(M|probj)
.formula M|select = M|select + ";probj==" + M|probj^id
..
!OPTIONS: Add options
.formula M|select = M|select + ";@gruppe=1;@ablageart=" + M|ablageart
..
.. Clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
..*****************************************************************************
..
!ERROR1
.error -line 0 -field M|vonaendzeit -message Es fehlt die Angabe eines énderungszeitraumes!
.end 1
..
!ERROR2
.error -line 0 -field M|vonaendzeit -message Der angegebene énderungszeitraum ist ungÅltig!
.end 1
