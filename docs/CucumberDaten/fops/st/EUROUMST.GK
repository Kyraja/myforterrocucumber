..!interpreter english translate
..*****************************************************************************
..
..  Name      : EUROUMST.GK
..  Datum     : 10.05.2001
..  Autor     : bheim
..
..  Verantwortlich : bheim
..
..  Funktion  : Euroumstellung der Gemeinkostensaetze im Firmenstamm
..              <text> euroumst.gk <zeigen>
..*****************************************************************************
.set trans +
..
?Euroumstellung nicht m”glich: Eurokurs = 0.00 ? eurokurs=0.000000
.end ? eurokurs=0.000000
..
.select company lock "$,gruppe=6;@gruppe=6"
!NEXT
.end ? _mehr
..
.. Euroumstellung von den "Zuschlaegen auf die Herstellkosten"
.continue HK2 ? hkzart1 <> "Betrag"
.formula hkzuschlg1 = hkzuschlg1 / eurokurs
!HK2
.continue HK3 ? hkzart2 <> "Betrag"
.formula hkzuschlg2 = hkzuschlg2 / eurokurs
!HK3
.continue HK4 ? hkzart3 <> "Betrag"
.formula hkzuschlg3 = hkzuschlg3 / eurokurs
!HK4
.continue HK5 ? hkzart4 <> "Betrag"
.formula hkzuschlg4 = hkzuschlg4 / eurokurs
!HK5
.continue SK1 ? hkzart5 <> "Betrag"
.formula hkzuschlg5 = hkzuschlg5 / eurokurs
..
.. Euroumstellung von den "Zuschlaegen auf die Selbstkosten"
!SK1
.continue SK2 ? skzart1 <> "Betrag"
.formula skzuschlg1 = skzuschlg1 / eurokurs
!SK2
.continue SK3 ? skzart2 <> "Betrag"
.formula skzuschlg2 = skzuschlg2 / eurokurs
!SK3
.continue SK4 ? skzart3 <> "Betrag"
.formula skzuschlg3 = skzuschlg3 / eurokurs
!SK4
.continue SK5 ? skzart4 <> "Betrag"
.formula skzuschlg4 = skzuschlg4 / eurokurs
!SK5
.continue FER ? skzart5 <> "Betrag"
.formula skzuschlg5 = skzuschlg5 / eurokurs
!FER
.rewrite
.select company lock
.continue NEXT

