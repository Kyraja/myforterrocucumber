..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PRINTSYS.ZW
.. Datum          : 2005-02-15
.. Version        : 2005r2n00
.. Autor          : fwester
.. Verantwortlich : teamreport
.. Kontrolle      :
.. Funktion       : Setzt die Detailangaben im Maskenkopf beim Elementwechsel
..                  im Baum des Drucksystems.
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..    verwendet Arrayparameter (arg.i)          : nein
..    verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Zeile-wechseln-EFOP des Drucksystems.
..
.. Functionality  : If the user marks an element in the tree of the print system
..                  this program will set the details in the header of the mask.
..
.. Interface (argument with meaning)
..    used array argument (arg.i)           : no
..    used name argument  (xpname=value)    : no
..
.. Program flow  : Changing line EFOP of the print system.
...Includes      :
..*****************************************************************************
.set trans -
..
.continue END ? M|tzeilen <= 0
.continue HEADEVT ? G|evtzeile <= 0
.select screen line 'G|evtzeile'
.continue FATAL ? _G|mehr
..
!HEADEVT
.assign M|kbaumstatus = M|tbaumstat
.assign M|stufe = M|tbaumstufe
.assign M|kelementtype = M|telementtype
.assign M|kinfosys = M|tinfosys
.assign M|kcommparam = M|tcommparam
.assign M|kkopfparam = M|tcommparam^aufrtab
.assign M|kprintparam = ""
.assign M|kparampfad = M|tparampfad
.assign M|kparampfad1 = ( M|tparampfad1 << -1)
.assign M|kparamebene = M|tparamebene
.assign M|kerrormessage = M|terrormessage
.assign M|kabmodell = M|tabmodell
.continue LAYOUT ? M|kelementtype = M|colllayout ; M|kelementtype = M|printlayout ; M|kelementtype = M|paramlayout
.assign M|klayout = ""
.assign M|klayoutfile = ""
.assign M|ksubreport = ""
.assign M|kkopflayout = M|tkopflayout
.continue END
..
!LAYOUT
.assign M|klayout = M|tlayout
.assign M|klayoutfile = ""
.assign M|klayoutfile = M|tlayout^layname ? M|kelementtype = M|printlayout
.assign M|kkopflayout = M|tkopflayout
.assign M|ksubreport = M|tsubreport
.assign M|kprintparam = M|tprintparam
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
