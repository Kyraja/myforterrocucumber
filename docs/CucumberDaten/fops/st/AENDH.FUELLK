..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDH.FUELLK
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : FÅllt Freitext nach BefÅllen der Kopffelder
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type text    xftext2   ? _F|defined(U|xftext2)
.type integer xlength   ? _F|defined(U|xlength)
.type text    xtext     ? _F|defined(U|xtext)
.type text    xmerk     ? _F|defined(U|xmerk)
.type text    xmerk2    ? _F|defined(U|xmerk2)
..
.file -tempname U|xftext2
.output new 'U|xftext2'
..
.continue FSCHNITT ? F|empty(M|ausloeserkopf)
.formula U|xlength = F|length(M|ausloeserkopf)
.. fÅhrendes "," wegschneiden
.formula M|ausloeserkopf = F|substr(M|ausloeserkopf, 2, U|xlength)  ?  F|regmatch(M|ausloeserkopf, ",.*")
.. endendes "," wegschneiden
.formula U|xlength = U|xlength - 1
.formula M|ausloeserkopf = M|ausloeserkopf << U|xlength ?  F|regmatch(M|ausloeserkopf, ".*,")
.formula U|xtext = M|ausloeserkopf
.formula U|xmerk = M|ausloeserkopf
.continue ADDETO ? _F|regmatch(M|ausloeserkopf, ".*,.*")
..
!KSCHNITT: Wenn Komma vorhanden, dann schneiden
.formula U|xmerk = U|xtext <<","
.formula U|xtext = U|xtext >>","
.formula U|xlength = F|length(U|xtext) 
.formula U|xtext = F|substr(U|xtext, 2, U|xlength)  ?  F|regmatch(U|xtext, ",.*")
.continue ADDETO ? _F|empty(U|xmerk)
.formula U|xtext = M|felderkopf
.formula U|xmerk2 = M|felderkopf
.continue ADDETO2 ? _F|regmatch(M|felderkopf, ".*,.*")
.continue FSCHNITT
..
!ADDETO 
.output addedto 'U|xftext2'
.input "DATEI.F"
'U|xmerk'
.output
.continue KSCHNITT ? _F|empty(U|xtext)
.continue FERTIG   ?  F|empty(M|felderkopf)
.continue FSCHNITT ? _F|regmatch(M|ausloeserkopf, ".*,.*")
.continue KSCHNITT
..
!FSCHNITT
.formula U|xlength = F|length(M|felderkopf)
.. fÅhrendes "," wegschneiden
.formula M|felderkopf = F|substr(M|felderkopf, 2, U|xlength)  ?  F|regmatch(M|felderkopf, ",.*")
.. endendes "," wegschneiden
.formula U|xlength = U|xlength - 1
.formula M|felderkopf = M|felderkopf << U|xlength ?  F|regmatch(M|felderkopf, ".*,")
.formula U|xtext = M|felderkopf
.formula U|xmerk2 = M|felderkopf
..
!TABSCHNITT
.formula U|xmerk2 = U|xtext <<","
.formula U|xtext = U|xtext >>","
.formula U|xlength = F|length(U|xtext)
.formula U|xtext = F|substr(U|xtext, 2, U|xlength)  ?  F|regmatch(U|xtext, ",.*")
.continue ADDETO2 ? _F|empty(U|xmerk2)
.continue FERTIG  ? F|empty(U|xmerk2)
..
!ADDETO2
.output addedto 'U|xftext2'
.input "DATEI.F"
'U|xmerk2'
.output
.continue FERTIG  ? _F|regmatch(M|felderkopf, ".*,.*")
.continue TABSCHNITT
..
!FERTIG
.formula M|ausloeser2kopf = U|xftext2
..
!END
.continue

