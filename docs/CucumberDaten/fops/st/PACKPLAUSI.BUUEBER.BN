..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PACKPLAUSI.BUUEBER.BN
.. Autor          : comu/mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Žnderung der Verpackungsangaben in Teilestamm schreiben
.. Functionality  : Write changed packing data into parts database
..*****************************************************************************
.set trans -
..
.type text   xtfehler
.type text   xtsystem
..
.type text   xtupdateartikeledp
.type text   xtupdateartikeledpout
.type text   xtupdateartikeledperr
..
.select screen header
!NEXT
.select screen line
.continue END     ? _G|mehr
.continue NEXT    ? _M|tbmark
..
.. Saving a product with inside measures larger than outside measures
.. can lead to getting stuck on cylcing error messages when editing
.. this product directly.
.continue SIZES   ?  M|tpacklge  <  M|tpacklgei
.continue SIZES   ?  M|tpackbr   <  M|tpackbri
.continue SIZES   ?  M|tpackhoe  <  M|tpackhoei
.continue SIZES   ?  M|tvol      <  M|tvoli
..
.select lock nowait parts 'M|tid^id'
.continue NEXT    ? _G|mehr
.continue NEXT    ? _G|gesperrt
.. assign temporary files
.file -tempname T|xtupdateartikeledp
.file -tempname T|xtupdateartikeledpout
.file -tempname T|xtupdateartikeledperr
..
.select -
..
.output new 'T|xtupdateartikeledp'
.input "DATEI.F"
.. --- --- --- --- --- --- --- --- ---

#!action=update
#!database=2:1
#!flddelimiter=;
#!dontchange=-

id;gewicht;egtkenn;namebspr;vbezbspr;packmit;pmtyp;lief;packlge;packbr;packhoe;vol;packhoeklap;packlgei;packbri;packhoei;fuellgrad;voli;nutzlast;stapelf;auflast;ladehoe;wstoff

'M|tid^id';'M|tgewicht';'M|tegtkenn';'M|tnamebspr';'M|tvbezbspr';'M|tpackmit';'M|tpmtyp';'M|tlief^id';'M|tpacklge';'M|tpackbr';'M|tpackhoe';'M|tvol';'M|tpackhoeklap';'M|tpacklgei';'M|tpackbri';'M|tpackhoei';'M|tfuellgrad';'M|tvoli';'M|tnutzlast';'M|tstapelf';'M|tauflast';'M|tladehoe';'M|twstoff^id'

.. --- --- --- --- --- --- --- --- ---
.output
..
.formula T|xtsystem = "edpimport.sh -p " + 'T|einmalpw' + " -c EKS -I " + 'T|xtupdateartikeledp' + " >> " + 'T|xtupdateartikeledpout' + " 2>> " + 'T|xtupdateartikeledperr'
.system 'T|xtsystem' background
.continue ERRBRI  ? _G|mehr
..
.formula M|tbmark = false
.protection tbmark 'M|aktzeile'
.formula M|tshowicon = "icon:ball_blue"
.continue NEXT
..
..
!SIZES: show warning icon if sizes mismatch
.formula M|tshowicon = G|icowarn
.continue NEXT
..*****************************************************************************
!END
.continue
..
..
!ERRBRI
.error Fehler beim Schreiben von Artikel 'M|tid^nummer'!
.end 1
