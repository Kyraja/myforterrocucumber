..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KONTAKT.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt zentral Feldereignisse mit kleinerer Funktion.
.. Functionality  : Central handling of field events with a smaller function.
.. Includes       :
.. include st/KONTAKT.KONTEXT.FA
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue REFERTO ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kontext"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "erreichbare"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "adresse"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "kunde"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "kundensach"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "interessent"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "intersach"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "lieferant"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "liefersach"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "mitarbeiter"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "bank"
..--------------------------------- Table  -------------------------------------
.continue BUSTART ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbustart"
.continue EMAIL   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbuemail"
.continue EMAIL   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbuemailz"
.continue MOBILE  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbumobil"
.continue MOBILE  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbumobilz"
.continue PHONE   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbutelefon"
.continue PHONE   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbutelefonz"
.continue WWWEB   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbuinternet"
.continue WWWEB   ? G|evtartengl = "BUTTON_AFTER" & G|evtvar ="tbuinternetz"
..==============================================================================
.continue END
..
!BUSTART: Button "Start" in row is pushed
.continue END ? M|kontext^id = M|tkontakt^id
.copy M|kontext = M|tkontakt
.input "st/KONTAKT.KONTEXT.FA"
.input "st/KONTAKT.BSTART.BV"
.input "st/KONTAKT.BSTART.BN"
.continue END
..
!EMAIL
.continue END ? F|empty(M|temail)
.continue ERROR1 ? _F|diraccessible("email")
..
.type text xmail
.formula U|xmail = M|temail
.input "email/SENDTO"
.continue END
..
!WWWEB
.continue END ? F|empty(M|turlt)
.continue ERROR1 ? _F|diraccessible("email")
..
.type text xurl
.formula U|xurl = M|turlt
.input "email/BROWSER.URL"
.continue END
..
!MOBILE
.continue END ? F|empty(M|tmtele)
..
.type text xtele
.formula U|xtele = M|tmtele
.input "ANRUFEN.CTI"
.continue END
..
!PHONE
.continue END ? F|empty(M|ttele)
..
.type text xtele
.formula U|xtele = M|ttele
.input "ANRUFEN.CTI"
.continue END
..
!REFERTO: Things we have to do while leaving field "kontext"
.input "st/KONTAKT.KONTEXT.FA"
.continue CLRTAB
..
!CLRTAB: Clear table
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Workspace "email" is not allowed!
.error -message Der Arbeitsbereich "email" ist nicht erlaubt!
.end 1
