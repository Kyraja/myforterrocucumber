..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLVERWEND.OPEN.KNOT
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Zeigt einen Knoten.
.. Ablauf         : Unterprogramm
..
.. Functionality  : Opens and shows a knot.
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.continue FATAL ? F|empty(M|tpasswort)
..
!INIT: Initializations
.assign M|stufe = M|tbaumstufe + 1
.assign M|kbaumiconz = M|symbolerl
.formula M|select = "$,,"
..
.. Build query for permissions
..
.. Add criterias for permission
.formula M|select = M|select + ";gruppe=11"
.formula M|select = M|select + ";nummer==" + M|tpasswort^nummer
.formula M|select = M|select + ";rechteakt=" + 'G|TRUE' ? M|nuraktive
..
.. Add options
.formula M|select = M|select + ";@gruppe=11;@zeilen=" + 'G|TRUE'
..
.. Query
.input "is/SELECT.ROWBYROW"
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
