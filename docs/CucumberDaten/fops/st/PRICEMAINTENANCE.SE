..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRICEMAINTENANCE.SE
.. Author         : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  : Initialize buffer of mask.
...Includes       :
.. include st/PRICEMAINTENANCE.ROUNDING
.. include st/PRICEMAINTENANCE.ROUND.ALL
.. include st/PRICEMAINTENANCE.INCREASE
.. include st/PRICEMAINTENANCE.INCREASE.ALL
.. include st/PRICEMAINTENANCE.SET.DETAILS.HEADER
.. include st/PRICEMAINTENANCE.SET.DETAILS.SCALING
.. include st/PRICEMAINTENANCE.PROTECT.SCREENITEMS
.. include st/PRICEMAINTENANCE.SET.ROWREMOVAL
.. include st/PRICEMAINTENANCE.RESET.ROW
.. include st/PRICEMAINTENANCE.REFRESH.RECORDVIEW
.. include st/PRICEMAINTENANCE.CHECK.RECORD
..*****************************************************************************
.set trans -
..
.. Presettings:
.. Type of price or discount
.assign M|ktyp = "(SalesPriceList)"
.copy M|ktypvk = G|true
.copy M|setscaledprice = G|true
.. only need by LPREISE
.formula M|ekvk = ""
..
.. With price scale
.copy M|kpos = G|true
..
.. Only current date
.copy M|kvon = G|datum
.copy M|kbis = G|datum
..
.. Number of selection levels
.copy M|maxsellevel = 4
.copy M|minsellevel = 1
.copy M|maxpartnersellevel = 3
.copy M|minpartnersellevel = 2
.. Sort hits
.copy M|sort = G|false
.. Filenames
.file -screen -tempname M|sortfilename
.file -screen -tempname M|resultfilename
..
.. Set initial write protections
.protection M|partner 0
.protection M|setsurcharge 0
..
.. Levelling
.formula M|headerlevel = 1
.formula M|rowlevel = 2
..
.. Visibility
.formula P|maskkontextfop = "PRICE"
..
.. Coloring
.input "is/ABASFARBEN.DEF"
.formula M|warning = U|xabasyellow
.formula M|changerecord0 = U|xabasgrouplight
.formula M|changerecord1 = U|xabasgrouplight
.formula M|changerecord2 = U|xabasgroupdark
..
.. Used special icons
.assign M|editstatusok = "icon:ok"
.assign M|editstatuswrong = "icon:attention"
..
.. Used subroutines
.assign M|tabrefresh = "st/PRICEMAINTENANCE.REFRESH.RECORDVIEW"
.assign M|tabheader = "st/PRICEMAINTENANCE.SET.DETAILS.HEADER"
.assign M|tabscaling = "st/PRICEMAINTENANCE.SET.DETAILS.SCALING"
.assign M|rounding = "st/PRICEMAINTENANCE.ROUNDING"
.assign M|roundingall = "st/PRICEMAINTENANCE.ROUND.ALL"
.assign M|increase = "st/PRICEMAINTENANCE.INCREASE"
.assign M|increaseall = "st/PRICEMAINTENANCE.INCREASE.ALL"
.assign M|protectscreenitems = "st/PRICEMAINTENANCE.PROTECT.SCREENITEMS"
.assign M|setrowremoval = "st/PRICEMAINTENANCE.SET.ROWREMOVAL"
.assign M|resetrow = "st/PRICEMAINTENANCE.RESET.ROW"
.assign M|checkrecordrow = "st/PRICEMAINTENANCE.CHECK.RECORD"
..*****************************************************************************
!END
.continue
