..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ERLURLLADEN.FOP
.. Author         : lei
.. Verantwortlich : lei
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.. show url from password in commandwindow
.. empty urls lead to problems
..*****************************************************************************
.set trans -
.continue EMPTY ? F|empty(M|effurl)
.browser -commandwindow 'M|effurl' ? G|grafik
.note 'M|effurl' ? _G|grafik
.continue END

!EMPTY
.browser -commandwindow "about:" ? G|grafik
.note about: ? _G|grafik
.continue END

!END
.continue
