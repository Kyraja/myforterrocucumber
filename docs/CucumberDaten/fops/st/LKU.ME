..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LKU.ME
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Initialisiert die Eingabefelder in der Kundenliste.
.. Ablauf         : Maskeneintritts-EFOP
..
.. Functionality  : Initializes the input fields of the the list of customers.
.. Program flow   : Mask entry efop
..*****************************************************************************
.type BT34 xfirmanort
.set trans -
..
.. Group selection
.copy M|bkunde = G|TRUE
.copy M|bsach  = G|TRUE
..
.. Colours
.input "is/ABASFARBEN.DEF"
.formula M|kunde      = U|xabasabaslightgreen2
.formula M|kundensach = U|xabaslightgreen3
.formula M|inter      = U|xabasmidyellow
.formula M|intersach  = U|xabaslightyellow
..
.formula U|xfirmanort = F|sysinfo(10)^nort
.formula U|xfirmanort = U|xfirmanort << ";"
..
.. Get descriptions for attributes
.assign M|namebspr1 = "20080"
.assign M|namebspr2 = "20081"
.assign M|namebspr3 = "20082"
.assign M|namebspr4 = "20083"
.assign M|namebspr5 = "20084"
.assign M|namebspr6 = "20085"
..
.. Get address of company
.formula M|firmenans = F|formatstr("{1} * {2} * {3} {4}", F|sysinfo(10)^ans, F|sysinfo(10)^str, F|sysinfo(10)^plz, U|xfirmanort)
..*****************************************************************************
!END
.continue
