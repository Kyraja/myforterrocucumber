..!interpreter english translate noabbrev
..*****************************************************************************
.. Name              : SSTL.TABLEEREN
.. Autor             : wk
.. Verantwortlich    : cl
.. Kontrolle         : tiwe
.. Funktion          : Setzt Zeilendetails zurueck und loescht die Tabelle.
.. Ablauf            : Unterprogramm
..
.. Functionality     : Resets row details, clears table and sets background
.. colors.
.. Program flow      : Subroutine
...Includes          :
..*****************************************************************************
.set trans -
.select screen header
.assign M|kbaumstufe = ""
.assign M|kvpos      = ""
.assign M|kelem      = ""
.assign M|klaggr     = ""
.assign M|kdispo     = ""
.assign M|kdispoa    = ""
.assign M|kbsart     = ""
.assign M|klaenge    = ""
.assign M|klme       = ""
.assign M|kbreite    = ""
.assign M|kbme       = ""
.assign M|kmge       = ""
.assign M|kelle      = ""
.assign M|kgesamt    = ""
.assign M|ktele      = ""
.assign M|kmgr       = ""
.assign M|klgr       = ""
.assign M|kebu       = ""
.assign M|kpostext   = ""
.assign M|kfilter    = "" ? F|defined(M|kfilter)
.assign M|kfiltervgl = "" ? F|defined(M|kfiltervgl)
.assign M|kfiltervgl2= "" ? F|defined(M|kfiltervgl2)
.assign M|krelevant  = "" ? F|defined(M|krelevant)
.assign M|kauslaufstatusicon = "" ? F|defined(M|kauslaufstatusicon)
.assign M|knachfolgeartikel = "" ? F|defined(M|knachfolgeartikel)
.assign M|klbsdatum = "" ? F|defined(M|klbsdatum)
.assign M|klverwdatum = "" ? F|defined(M|klverwdatum)
.assign M|kvgltermin = "" ? F|defined(M|kvgltermin)
..
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
