..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : USTIDCHECK.EV
.. Datum          : 09.05.2007
.. Version        : 1
.. Autor          : male
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Event-FOP des Infosystems st/USTIDCHECK
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..   Argument     meaning
..   ---------------------------------------------------------
..   xp...        ...
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..
..*****************************************************************************
..
.set trans -
.continue START  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue SINGLE ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "tobjekt"
.continue SINGLE ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "tustid"
.continue END
..
..*****************************************************************************
!SINGLE
..*****************************************************************************
.formula M|tobjekt  = "" ? G|evtvar <> "tobjekt"
.formula M|tustid   = "" ? G|evtvar <> "tustid"
.formula M|tort     = ""
.formula M|tplz     = ""
.formula M|tname    = ""
.formula M|tstatusz = ""
.formula M|tcode    = ""
.formula M|ttext    = ""
..
.continue END    ? G|evtvar <> "tobjekt"
.continue END    ? F|empty(M|tobjekt)
.select object 'M|tobjekt^id'
.input "st/USTIDCHECK.TAB"
.continue END
..
..*****************************************************************************
!START
..*****************************************************************************
.formula M|fehleranz = 0
.input "is/TABLEEREN"
..
..*****************************************************************************
!GRP01
..*****************************************************************************
.formula M|datnr = 0
.formula M|grp   = 2
.input "is/HOL.LISTE" ? M|kunden
..
..*****************************************************************************
!GRP02
..*****************************************************************************
.formula M|grp   = 4
.input "is/HOL.LISTE" ? M|kundensb
..
..*****************************************************************************
!GRP11
..*****************************************************************************
.formula M|datnr = 1
.formula M|grp   = 2
.input "is/HOL.LISTE" ? M|liefer
..
..*****************************************************************************
!GRP12
..*****************************************************************************
.formula M|grp   = 4
.input "is/HOL.LISTE" ? M|liefersb
.continue END
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
