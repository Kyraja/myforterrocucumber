.set trans -
.type text xmfg      ? _F|defined(U|xmfg)
.type bool xredruck  ? _F|defined(U|xredruck)
.type text xsteunr   ? _F|defined(U|xsteunr)
.type text xustidnr  ? _F|defined(U|xustidnr)
.type text xtel      ? _F|defined(U|xtel)
.type text xfax      ? _F|defined(U|xfax)
.type text xiban     ? _F|defined(U|xiban)
.type text xvorstand ? _F|defined(U|xvorstand)
.type text xvorsitz  ? _F|defined(U|xvorsitz)
.type text xgesch    ? _F|defined(U|xgesch)
..
.. setzt in st/BKOPF.ME "Rechnungsanschrift:" falls xredruck = TRUE
.. somit kann im VK-Lieferschein zusÑtzlich die Rechnungsadresse angedruckt
.. werden. Default ist aber FALSE
...copy U|xredruck = T|TRUE
.copy U|xredruck = G|FALSE
..
.. logo
.assign M|logoz    = "images/abaslogo.jpg"
.formula M|fusslz   = ""
.formula M|firmaxyz = ""
..
.text U|xmfg 'P|spr' Mit freundlichen GrÅ·en
.formula M|mfg1 = 'U|xmfg'
.formula M|mfg2 = "Musterfirma GmbH"
.formula M|mfg3 = ""
..
.. Texte fÅr Fu·zeile
.. bank details
.formula M|konto1 = "Sparkasse Karlsruhe"
.formula M|konto2 = "Kto.-Nr. 4 444 444"
.formula M|konto3 = "BLZ 555 555 55"
.formula M|konto4 = "BIC KARSDE66"
..
.. governing body / board of management
.text U|xvorsitz 'P|spr' Vorsitzender des Aufsichtsrates
.text U|xvorstand 'P|spr' Vorstand
.text U|xgesch 'P|spr' GeschÑftsfÅhrer
.formula M|vorsitz1  = 'U|xvorsitz' +":"
.formula M|vorstand1 = 'U|xvorstand' + ": " + "Helmut Meier"
.formula M|vorsitz2  = "Max Mustermann"
.formula M|vorstand2 = "HRB 4711, AG Karlsruhe"
.formula M|vorstand3 = 'U|xgesch' + ": " + "Ulf MÅller"
..
.text U|xfax 'P|spr' Fax
.text U|xiban 'P|spr' IBAN
.text U|xustidnr 'P|spr' USt-Id-Nr
.text U|xsteunr 'P|spr' Steuer-Nr
.text U|xtel 'P|spr' Tel
.formula U|xsteunr  = 'U|xsteunr'+":"
.formula U|xustidnr = 'U|xustidnr'+":"
.formula U|xtel     = 'U|xtel'+":"
.formula U|xfax     = 'U|xfax'+":"
..
.set trans -
.. ZusÑtzliche Fu·felder
.formula M|fuss1  = ""
.formula M|fuss2  = ""
.formula M|fuss3  = ""
.formula M|fuss4  = ""
