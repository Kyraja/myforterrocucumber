..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KDINFO.BUINFO.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Startet eine weitere "Kundeninfozentrale".
.. Ablauf         : Button-nach-EFOP
..
.. Functionality  : Starts a window with another "Customer Information Centre".
.. Program flow   : After button efop
..*****************************************************************************
.set trans -
..
.continue END ? _F|defined(M|kbkdinfo)
.continue ERROR1 ? F|empty(M|knumkusa)
.continue ERROR2 ? _M|istsachkd & F|empty(M|kvertret) & F|empty(M|khaendl)
.continue ERROR2 ? _M|istsachkd & M|kvertret^id = M|knumkusa^id & M|khaendl^id = M|knumkusa^id
..
.. Declarations
.type text xmentit xkulifirma xvertret xhaendl xtcmd
.type VID7 xkuli
..
.. Initializations
.atext -language 'G|bsprache' U|xkulifirma 668 Firma
.atext -language 'G|bsprache' U|xvertret 2134 Vertreter
.text U|xhaendl 'G|bsprache' Rechnungsempf„nger
.set trans +
.formula U|xmentit = "Kundeninfozentrale aufrufen mit"
.set trans -
..
!MENU: Show menu
.continue STAFFER ? M|istsachkd
..
.. No staffer
.menu 'U|xmentit'
?'U|xvertret' >> .assign U|xkuli = M|kvertret ? _F|empty(M|kvertret)
?'U|xhaendl' >> .assign U|xkuli = M|khaendl ? _F|empty(M|khaendl)
.end 0 ? G|menue = 0
.continue COMMAND
..
!STAFFER
.menu 'U|xmentit'
'U|xkulifirma' >> .assign U|xkuli = M|knumsaku
?'U|xvertret' >> .assign U|xkuli = M|kfvertret ? _F|empty(M|kfvertret)
?'U|xhaendl' >> .assign U|xkuli = M|kfhaendl ? _F|empty(M|kfhaendl)
.end 0 ? G|menue = 0
..
!COMMAND: show infosystems for linked customer
.formula U|xtcmd = "(Infosystem) " + M|such65 + "?knumkusa=" + U|xkuli^id + "|bstart=1"
.command -parallel 'U|xtcmd'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Business partner missing!
.error -line 0 -field M|knumkusa -message Es fehlt die Angabe eines Gesch„ftspartners!
.end 1
..
!ERROR2: Business partner has no more business partner himself!
.error -message Der Gesch„ftspartner 'M|knumkusa' hat keine weiteren Gesch„ftspartner!
.end 1
