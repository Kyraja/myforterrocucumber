..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUFRUFPARAMETER.EV
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Behandelt zentral die einfacheren Ereignisse.
.. Functionality  : Central handling of simple events.
..*****************************************************************************
.set trans -
..
..------------------------------- Screen --------------------------------------
.continue EXECUTE ? G|evtartengl = "SCREEN_EXIT"
..------------------------------- Header --------------------------------------
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL"    & G|evtvar = "anzstufen"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL"    & G|evtvar = "aktiv"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL"    & G|evtvar = "nurerlaubte"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "select"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "aufruf"
.continue CLOSE   ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "menueokay"
.continue CANCEL  ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "menueabbruch"
..--------------------------------- Table  -------------------------------------
.continue CHGROW  ? G|evtartengl = "ROW_CHANGED"
..==============================================================================
.continue END
..
!CHGROW: Row changed
.copy M|kbaumtext = M|tbaumtext
.copy M|kbauminfo = M|tbauminfo
.copy M|kbaumicon = M|tbaumicon
.copy M|kaufrufparameter = M|taufrufparameter
.copy M|kmenuemoeglich = M|tmenuemoeglich
.copy M|kaktiv = M|taktiv
.copy M|kmenuean = M|tmenuean
.copy M|kmaskid = M|tmaskid
.copy M|knachricht = M|tnachricht
.copy M|kkommando = M|tkommando
.copy M|kparams = M|tparams
.copy M|kkomneu = M|tkomneu
.copy M|ksichtbar = M|tsichtbar
.copy M|kmenueendeaktion = M|tmenueendeaktion
.copy M|kreusewindow = M|treusewindow
.copy M|kzeilentyp = M|tzeilentyp
.copy M|kkontexttyp = M|tkontexttyp
.continue END
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
.continue END
..
!EXECUTE: Execute from head
.continue CLOSE  ? F|empty(M|tzeilen)
.continue FORBID ? F|empty(M|markiertzn)
.select screen line 'M|markiertzn'
.continue FORBID ? _G|mehr
.continue ERROR01 ? _M|tmenuemoeglich
..
.. Execute command depending to its dialog mode
.continue MODIFY  ? F|equals(M|tdialogartu, "(Modifying)")
.continue BLOCK   ? F|equals(M|tdialogartu, "(Blocking)")
.continue NOBLOCK ? F|equals(M|tdialogartu, "(NotBlocking)")
.continue ERROR01
..
!MODIFY
.'M|reusekom'
.continue END
..
!BLOCK
.'M|wartenkom'
.continue END
..
!NOBLOCK
.'M|parallelkom'
.continue END
..
!FORBID: Action is not allowed
.error
.end 1
..
!CLOSE: Close infosystem
.end 0 "FileSaveClose"
..
!CANCEL: Close infosystem
.end 0 "FileAbort"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Cannot execute command!
.error -message 'M|tbaumtext': Kommando ist nicht ausfÅhrbar
..
!BREAK
.end 1
