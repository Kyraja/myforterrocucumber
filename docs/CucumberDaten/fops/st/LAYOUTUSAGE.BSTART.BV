..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : LAYOUTUSAGE.BSTART.BV
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      : cl
.. Functionality  : shows all layouts and layout list, in which the selected layout is used
..*****************************************************************************
.type bool    xfirst                 ? _F|defined(U|xfirst)
.type text    xheader                ? _F|defined(U|xheader)
.type text    xheader1               ? _F|defined(U|xheader1)
.type text    xheader2               ? _F|defined(U|xheader2)
.type text    xheader3               ? _F|defined(U|xheader3)
.type text    xheader4               ? _F|defined(U|xheader4)
.type text    xsel                   ? _F|defined(U|xsel)
.type text    xsel1                  ? _F|defined(U|xsel1)
.type text    xsel2                  ? _F|defined(U|xsel2)
.type text    xsel3                  ? _F|defined(U|xsel3)
.type text    xsel4                  ? _F|defined(U|xsel4)
.type integer xcount                 ? _F|defined(U|xcount)
..
.set trans -
.continue ERRNOLAY    ? F|empty(M|klayout)
..
.set trans +
.copy U|xheader1 = "Sammellayout"
.copy U|xheader2 = "Parameterlayout"
.copy U|xheader3 = "Layout"
.copy U|xheader4 = "Layoutliste"
.set trans -
..
.copy U|xcount = 0
.copy U|xsel1 = "$,,1:tlayout==" + 'M|klayout^id' + ";@gruppe=2"
.copy U|xsel2 = ""
.copy U|xsel2 = "$,,sublayout==" + 'M|klayout^id' + ";tablayout==" + 'M|klayout^id' + ";@gruppe=8;@verknuepfung=(Or)" ? M|klayout^gruppe = 3
.copy U|xsel2 = "$,,sublayout==" + 'M|klayout^id' + ";@gruppe=8"                                                      ? M|klayout^gruppe = 2
.copy U|xsel3 = ""
.copy U|xsel3 = "$,,1:tlayout==" + 'M|klayout^id' + ";@gruppe=3"                                                      ? M|klayout^gruppe = 3
.copy U|xsel4 = "$,,1:tlayout==" + 'M|klayout^id' + ";@gruppe=14"
..
.make screen line --
!NEXT
.continue END                      ? U|xcount = 4
.copy U|xcount = U|xcount + 1
.copy U|xheader = U|xheader1       ?  U|xcount = 1
.copy U|xheader = U|xheader2       ?  U|xcount = 2
.copy U|xheader = U|xheader3       ?  U|xcount = 3
.copy U|xheader = U|xheader4       ?  U|xcount = 4
.copy U|xsel = U|xsel1             ?  U|xcount = 1
.copy U|xsel = U|xsel2             ?  U|xcount = 2
.copy U|xsel = U|xsel3             ?  U|xcount = 3
.copy U|xsel = U|xsel4             ?  U|xcount = 4
..
.continue NEXT ? F|empty(U|xsel)
.select printparameter 'U|xsel'
.set debug -
.continue NEXT ? _G|mehr
!NEXTDTL
.make screen line +O
.copy M|tbaumicon = path2clayout   ?  U|xcount = 1
.copy M|tbaumicon = path2playout   ?  U|xcount = 2
.copy M|tbaumicon = path2layout    ?  U|xcount = 3
.copy M|tbaumicon = path2layoutl   ?  U|xcount = 4
.assign M|tverwendung = H|id
.assign M|ttyp = U|xheader
..
.select continue
.continue NEXT                    ? _G|mehr
.continue NEXTDTL
..
..*****************************************************************************
!END
.continue
..
!ERRNOLAY
.cursor klayout 0
.error Das Feld Layout darf nicht leer sein.
.end 1
