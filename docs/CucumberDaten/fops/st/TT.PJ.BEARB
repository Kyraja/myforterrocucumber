..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : TT.PJ.BEARB
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion	      : Bearbeiten des Vorgangs im H-Puffer nach Stellung des
..                  Schalters xtfunktion. Stellungen von xtfunktion:
..                  W  -> 	Weiterleiten zu Mitarbeiter
.. Ablauf	      : Unterprogramm
.. Funktion	      : Edit of process loaded in buffer H depending on flag
..                  xtfunktion. Possible settings
..                  W  -> Forwarding to a staff personnel
.. Ablauf	      : Unterprogramm
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xtfunktion:1 ? _F|defined(U|xtfunktion)
..
.. Initializations
.continue OPRATOR ? U|xtfunktion = "W" ; F|empty(U|xtfunktion)
.continue END
..
!OPRATOR: Edit responsible staff
.continue PLANER ? F|equals(H|status, "(Done)")
.copy H|bearbeit = M|kzumitarb
.continue SAVEREC
..
!PLANER: Edit planer
.copy H|bestaet = M|kzumitarb
..
!SAVEREC: Write record
.rewrite
..*****************************************************************************
!END
.continue
