..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FTEXTEDITOR.BSTART.BN
.. Autor          : lei
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Beschafft die Daten fuer den Menuekoerper.
.. Functionality  : Gets data for the menu body.
..*****************************************************************************
.set trans -
..
.. Set defaults
.copy M|formathtml = G|FALSE
..
.continue CANEDIT ? M|ftexteditierbar
.continue NOEXIST ? M|ftextisnew
..
.. Default is view because freetext exist but is not writeable
.assign M|menuevorauswahl = 1
.continue READFT
..
!CANEDIT: Freetext is possibly editable
.continue NOEXIST ? M|ftextisnew
..
.. Default is edit because freetext exist and is writeable
.assign M|menuevorauswahl = 2
.continue READFT
..
!NOEXIST: Freetext does not exist
.continue DEFNEW ? M|ftexteditierbar
.. Using infosystem standalone for testing purposes
.continue DEFNEW ? _M|subdialog
.continue ERROR01
..
!DEFNEW: Default is new because freetext does not exist but is writeable
.assign M|menuevorauswahl = 3
.continue DOMENUE
..
!READFT: Read 1st row to get type of freetext
.type DVMI2 xtmpfile ? _F|defined(U|xtmpfile)
.assign U|xtmpfile = M|freitextdv
.input "st/FTEXTEDITOR.IS.HTML"
.copy M|formathtml = U|xishtml
..
!DOMENUE
..
.. View freetext
.make screen line +
.assign M|tbaumstufe = 1
.formula M|tbaumtext = M|ftextzeigen1
.formula M|tbauminfo =  M|ftextzeigen2
.copy M|tbaumicon = M|icontext
.copy M|tvorlageft = ""
.assign M|toperation = "FTOPEN"
.assign M|tmenueendeaktion = "(Done)"
..
.. This option is generally permitted if freetext exist but is not editable
.. Using this as default if database action is view.
.continue NOVIEW ? M|ftextisnew
.continue NOVIEW ? M|ftexteditierbar
.copy M|tmenuemoeglich = G|TRUE
.assign M|menuevorauswahl = M|aktzeile ? M|evtkommd = G|kaktname12
.continue EDIT
..
!NOVIEW
.copy M|tbaumicon = M|iconstop
.assign M|tbauminfo = M|ftextnichtlesen
..
!EDIT: Edit freetext
.make screen line +
.assign M|tbaumstufe = 1
.formula M|tbaumtext = M|ftextedit1
.formula M|tbauminfo =  M|ftextedit2
.copy M|tbaumicon = M|icontext
.copy M|tvorlageft = ""
.assign M|toperation = "FTEDIT"
.assign M|tmenueendeaktion = "(Done)"
..
.. This option is generally permitted if freetext exist and is editable
.. Using this as default if database action is edit.
.continue NOEDIT ? _M|ftexteditierbar ; M|ftextisnew
.copy M|tmenuemoeglich = G|TRUE
.assign M|menuevorauswahl = M|aktzeile ? M|evtkommd = G|kaktname13
.continue NEW
..
!NOEDIT
.copy M|tbaumicon = M|iconstop ?  M|ftextisnew
.copy M|tbaumicon = M|iconlock ? _M|ftextisnew & _M|ftexteditierbar
.formula M|tbauminfo = M|ftextnichtlesen ?  M|ftextisnew
.formula M|tbauminfo = M|ftextnichtedit  ? _M|ftextisnew & _M|ftexteditierbar
..
!NEW: New freetext
.make screen line +
.assign M|tbaumstufe = 1
.assign M|tbaumtext = M|ftextneu
.assign M|tbauminfo = M|ftextneu
.assign M|tbaumtext = M|ftextueb ? _M|ftextisnew
.assign M|tbauminfo = M|ftextueb ? _M|ftextisnew
.copy M|tvorlageft = ""
.assign M|tbaumstat = "+"
.assign M|toperation = "FTNOP"
.assign M|tmenueendeaktion = "(Done)"
..
.. This option is generally permitted if freetext is editable
.. If freetext already exist default is edit otherwise new
.. Using infosystem standalone for test purposes.
.continue NONEW   ? _M|subdialog & _M|ftexteditierbar & M|ftextisnew
.continue ERROR01 ? _M|ftexteditierbar & M|ftextisnew
.continue NONEW   ? _M|ftexteditierbar
.continue NEWEDIT ? _M|ftextisnew
.copy M|tmenuemoeglich = G|TRUE
.assign M|menuevorauswahl = M|aktzeile
.continue BODY
..
!NEWEDIT: Edit existing freetext while creating new one
.assign M|menuevorauswahl = 2 ? M|evtkommd = G|kaktname14 ; M|evtkommd = G|kaktname17
..
!NONEW
.copy M|tbaumicon = M|iconlock ? _M|ftextisnew & _M|ftexteditierbar
.formula M|tbauminfo = M|ftextnichtlesen ?  M|ftextisnew
.formula M|tbauminfo = M|ftextnichtedit  ? _M|ftextisnew & _M|ftexteditierbar
..
!BODY: Which type of menu body?
.continue DEFAULT ? F|empty(M|freitexttyp)
.continue TMPLATE
..
!DEFAULT
.type integer xz
.assign U|xz = 0
!NEXTDEF
.assign U|xz = U|xz + 1
.continue FOOTER  ? U|xz > 3
.copy M|ftexttyp = M|ftexttyp.U|xz
.copy M|ftexttpl = M|ftexttpl.U|xz
.input 'M|tab' ? _F|empty(M|tab)
.continue NEXTDEF
..
!TMPLATE
.load 1 object 'M|freitexttyp^id'
.continue FOOTER  ? _G|mehr
.continue TPLROW  ? _M|objektwahl
..
.. Create a menu item for a selection bar to choose a short text
.make screen line +
.assign M|tbaumstufe = 2
.formula M|tbaumtext = M|ftextauswaehlen
.formula M|tbauminfo = M|ftextobjwahl
.copy M|tbaumicon = M|iconobjwahl
.copy M|tbaumicon = M|iconstop ? _M|ftexteditierbar
.copy M|tvorlageft = ""
.assign M|toperation = "FTSEL"
.assign M|tmenueendeaktion = "(Done)"
.copy M|tmenuemoeglich = M|ftexteditierbar
.. Separator row
.make screen line +
.assign M|tbaumstufe = 2
.formula M|tbaumtext = M|ftextseparator
.assign M|tbaumicon = M|iconseparator
..
!TPLROW: Load row with template
.load 1 line
.continue DEFAULT ? _G|mehr
.copy M|template = G|TRUE
..
!NEXTTPL: Next template
.continue FOOTER  ? _G|mehr
.continue NEXTTPL ? F|empty(1|vorlage)
.input 'M|tab' ? _F|empty(M|tab)
.load 1 line
.continue NEXTTPL
..
!FOOTER
.make screen line +
.assign M|tbaumstufe = 1
.formula M|tbaumtext = M|ftextkonv
.formula M|tbauminfo = M|ftexthtmlkonv
.copy M|tbaumicon = M|icontext
.copy M|tvorlageft = ""
.assign M|toperation = "FTCONVERT"
.assign M|tmenueendeaktion = "(Done)"
.copy M|tmenuemoeglich = _M|ftextisnew & M|ftexteditierbar & _M|formathtml
.continue CNVEDIT ? M|tmenuemoeglich
..
!NOCONV
.copy M|tbaumicon = M|iconstop ?  M|ftextisnew
.copy M|tbaumicon = M|iconlock ? _M|ftextisnew & _M|ftexteditierbar
.copy M|tbaumicon = M|iconok   ?  M|formathtml
.formula M|tbauminfo = M|ftextnichtlesen ?  M|ftextisnew
.formula M|tbauminfo = M|ftextnichtedit  ? _M|ftextisnew & _M|ftexteditierbar
.formula M|tbauminfo = M|ftextisthtml    ?  M|formathtml
..
!CNVEDIT
.make screen line +
.assign M|tbaumstufe = 1
.formula M|tbaumtext = M|ftextkonvedit
.formula M|tbauminfo = M|ftexthtmlkonvedit
.copy M|tbaumicon = M|icontext
.copy M|tvorlageft = ""
.assign M|toperation = "FTOPENCONVERT"
.assign M|tmenueendeaktion = "(Done)"
.copy M|tmenuemoeglich = _M|ftextisnew & M|ftexteditierbar & _M|formathtml
.continue CURSOR ? M|tmenuemoeglich
..
!NOCEDIT
.copy M|tbaumicon = M|iconstop ?  M|ftextisnew
.copy M|tbaumicon = M|iconlock ? _M|ftextisnew & _M|ftexteditierbar
.copy M|tbaumicon = M|iconok   ?  M|formathtml
.formula M|tbauminfo = M|ftextnichtlesen ?  M|ftextisnew
.formula M|tbauminfo = M|ftextnichtedit  ? _M|ftextisnew & _M|ftexteditierbar
.formula M|tbauminfo = M|ftextisthtml    ?  M|formathtml
..
..
!CURSOR
.. View freetext
.make screen line +
.assign M|tbaumstufe = 1
.formula M|tbaumtext = M|htmlzeigen1
.formula M|tbauminfo =  M|htmlzeigen2
.copy M|tbaumicon = M|icontext
.copy M|tvorlageft = ""
.assign M|toperation = "FTNOHTML"
.assign M|tmenueendeaktion = "(Done)"
.copy M|tmenuemoeglich = M|formathtml
..
.cursor tbaumtext 'M|menuevorauswahl' ? _F|empty(M|menuevorauswahl)
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Freetext does not exist and is not writeable
.error -message Text darf nicht angelegt werden oder ist nicht vorhanden!
.end 1
