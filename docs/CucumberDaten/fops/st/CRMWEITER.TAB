..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CRMWEITER.TAB
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      :
.. Funktion       : Erzeugt und beschreibt eine Tabellenzeile.
.. Ablauf         : Tabellen-EFOP
.. Function       : Creates and writes a table row.
.. Program flow   : Table efop
..****************************************************************************
.set trans -
..
.make screen line +O
.copy M|tmark = G|FALSE
.assign M|objektnum = H|id
.formula M|tschlag = H|schlag
.copy M|tstatus = H|status
.copy M|tbearb = H|bearbeit
.copy M|tbestaet = H|bestaet
.copy M|tstart = H|start
.copy M|tend = H|end
.copy M|tbintern = H|intern
.continue PROJECT ? H|gruppe = 1
.continue TASK    ? H|gruppe = 2
.continue END
..
!TASK
.set trans +
.formula M|tvortyp = "Aufgabe"
.set trans -
.copy M|tprojekt = H|projekt
.continue END
..
!PROJECT
.set trans +
.formula M|tvortyp = "Projekt"
.set trans -
..****************************************************************************
!END
.continue
