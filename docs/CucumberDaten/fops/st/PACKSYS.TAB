..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : PACKSYS.BSTART.TAB
.. Autor         : fwester
.. Verantwortlich: cl
.. Kontrolle     : lei
.. Funktion      : Zeigt die Tabellenzeile.
.. Ablauf        : Tabellen-EFOP
..
.. Functionality : Shows table row.
.. Program flow  : Table EFOP
..*****************************************************************************
.set trans -
..
.select line 'H|selzeile'
.continue END ? _G|mehr
..
.continue BACKWRD ? M|rueckwaerts
..
.. direction is forward
.make screen line +O
.. data
.assign M|tpaket = H|verwpaket^id
.copy M|teinschl = H|einschl
..
.. what type of element do we have
.type text xselect ? _F|defined(U|xselect)
.type bool xisnode ? _F|defined(U|xisnode)
.formula U|xselect = "num87==" + 'M|tpaket^nummer' + ";"
.formula U|xselect = M|praeselect + U|xselect + M|postselect
.load 9 dataexport 'U|xselect'
.copy U|xisnode = G|mehr
..
.. view
.formula M|tbaumstufe = M|stufe + 1
.formula M|tbaumstat = "="
.formula M|tbaumstat = "+" ? U|xisnode
.assign M|tbaumicon = M|pfadblatt
.assign M|tbaumicon = M|pfadknoten ? U|xisnode
.formula M|tbaumtext = 'H|verwpaket^nummer' + ": " +'H|verwpaket^such
.formula M|tbauminfo = G|hdatname87
.continue END
..
!BACKWRD: direction is backward
.make screen line +O
.. data
.assign M|tpaket = H|id
..
.. what type of element do we have
.type text xselect ? _F|defined(U|xselect)
.type bool xisnode ? _F|defined(U|xisnode)
.formula U|xselect = "verwpaket==" + 'M|tpaket^nummer' + ";"
.formula U|xselect = M|praeselect + U|xselect + M|postselect
.load 9 dataexport 'U|xselect'
.copy U|xisnode = G|mehr
.copy M|teinschl = U|xisnode
..
.. view
.formula M|tbaumstufe = M|stufe + 1
.formula M|tbaumstat = "="
.formula M|tbaumstat = "+" ? U|xisnode
.assign M|tbaumicon = M|pfadblatt
.assign M|tbaumicon = M|pfadknoten ? U|xisnode
.formula M|tbaumtext = 'H|nummer' + ": " +'H|such
.formula M|tbauminfo = G|hdatname87
..*****************************************************************************
!END
.continue
