..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUFRUFPARAMETER.ME
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Initialisiert den Maskenpuffer.
.. Functionality  : Initialize buffer of mask
..*****************************************************************************
.set trans -
..
.. Input and control parameters
.copy M|aktiv = G|TRUE
.copy M|nurerlaubte = G|TRUE
..
.. Programs
.assign M|openknot = "st/AUFRUFPARAMETER.OPEN.NODE"
.assign M|closeknot = "is/CLOSE.EVENTNODE"
..
.. Icons
.assign M|kiconmenu = "icon:book_yellow_open"
.assign M|kiconleer = "icon:minus"
.assign M|kiconseparator = "icon:minus_black"
.assign M|kiconnichtausfuehr = "icon:stop"
..
.. Translate FO syntax and other text
.atext -language 'G|lsprache' M|fokommando 1764
.atext -language 'G|lsprache' M|foparallel 3514
.atext -language 'G|lsprache' M|fofenster  3413
.atext -language 'G|lsprache' M|fowarten   4632
.atext -language 'G|lsprache' M|foneu       683
.atext -language 'G|bsprache' M|separator  2333
..
!PRINT: Creates a tipped command which enables copying print data from origin to the new buffer
.input "st/CALLPARAM.PRINTCONF"
.assign M|erpprintconf = U|xerpprintconf
..
.. Commands
.formula M|parallelkom = M|fokommando + " -" + M|foparallel + " 'M|tkomneu'"
.formula M|parallelkom = M|parallelkom + G|DBLQUOTE + "?" + G|DBLQUOTE + "'M|tparams'"
.formula M|wartenkom = M|fokommando + " -" + M|fowarten + " 'M|tkomneu'"
.formula M|wartenkom = M|wartenkom + G|DBLQUOTE + "?" + G|DBLQUOTE + "'M|tparams'"
.formula M|reusekom = M|fokommando + " -" + M|fofenster + " 'M|tmaskid' -" + M|foneu + " 'M|tkomneu' 'M|tparams'"
..*****************************************************************************
!END
.continue
