.set trans -
..
.assign M|rot = "icon:ball_red"
.assign M|gruen = "icon:ball_green"
.assign M|orange = "icon:ball_orange"
.assign M|gruenok = "icon:ok"
.assign M|fehler = "icon:flash"
..
.assign M|roti = M|rot
.assign M|grueni = M|gruen
.assign M|orangei = M|orange
.assign M|gruenoki = M|gruenok
.assign M|fehleri = M|fehler
..
.load 0 group "91:6" "$,,;"
..
.continue END ? _G|mehr
..
..
!CHECK: check client
..
.continue MAND ? 0|eigmand
..
.load 0 continue
..
.continue CHECK ? G|mehr
.continue END
..
..
!MAND: client found
..
.assign M|mandant = 0|nummer
..
..
!END
.continue
