..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRINTSETTINGS.STANDORTDR
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      :
.. Functionality  : shows the combination of printer list and local printers
..*****************************************************************************
..
.set trans -
..
.type text       xselect             ? _F|defined(U|xselect)
.type ID91:1.2.9 xprinter            ? _F|defined(U|xprinter)
..
.formula U|xselect = F|formatstr("$,,standort={1};", M|standort^id)
.select group "91:1.2.9" 'U|xselect'
.continue END ?_G|mehr
!NEXT
.assign U|xprinter = H|id
.formula U|xtooltip = U|xlayout^sucherw + "/" + U|xprinter^sucherw
.formula U|xtreetext = 2|tmenuetext           ? F|defined(2|tmenuetext)
.formula U|xtreetext = U|xlayout^namebspr     ? F|empty(U|xtreetext)
.formula U|xtreetext  = U|xtreetext + "/" + U|xprinter^such
.input "PRINTSETTINGS.LINE"
.select continue
.continue NEXT ? G|mehr
..*****************************************************************************
!END
.continue
