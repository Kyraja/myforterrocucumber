..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDH.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : fwester
.. Funktion       : Validiert die Eingabeparameter.
.. Functionality  : Validates input parameters.
...Includes       :
.. include st/AENDH.BSTART.FELDNAMENPRUEFEN
..*****************************************************************************
.set trans -
..
.type GL    zeilenselektion       ? _F|defined(U|zeilenselektion)
.type GL    unknownheaderfields   ? _F|defined(U|unknownheaderfields)
.type GL    unknowntablefields    ? _F|defined(U|unknowntablefields)
.type bool  notableindngrerr      ? _F|defined(U|notableindngrerr)
..
.. Validating
.continue ERROR08   ?  F|empty(M|vartabgruppe)
.continue ERROR09   ?  F|empty(M|kid) & F|empty(M|bearbeiter) & F|empty(M|von) & F|empty(M|bis)
.continue ERROR10   ? (_M|allekopf & F|empty(ausloeserkopf)) & (_M|alletabelle & F|empty(ausloesertabelle))
.continue ERROR06   ?  M|datnr = 14 
.continue ERROR01   ?  F|empty(M|kid) & M|datnr = 127
.continue ERROR02   ? _F|empty(M|von) & _F|empty(M|bis) & M|von > M|bis
.continue ERROR07   ? _M|erlaubt
.continue VALIDATE
..
!VALIDATE: Validating field names
.copy U|unknownheaderfields = ""
.copy U|unknowntablefields = ""
.copy U|notableindngrerr = G|TRUE
..
.formula M|fertig = G|FALSE
.. Clear table
.input "is/TABLEEREN"
.input "st/AENDH.BSTART.FELDNAMENPRUEFEN"
..
.input "st/AENDH.FUELLT"  ? M|allekopf & _F|empty(M|ausloeser2kopf) & _M|alletabelle
.input "st/AENDH.FUELLK"  ? M|alletabelle & _F|empty(M|ausloeser2tabelle) & _M|allekopf
..
.continue ERROR03 ? _F|empty(U|unknownheaderfields)
.continue ERROR05 ? _F|empty(U|unknowntablefields)
..
.continue END
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Missed data object
.error -field M|kid -message Bitte ein Objekt oder eine Datenbank angeben.
.continue BREAK
..
!ERROR02: Illegal period.
.error -field M|von -message Geben Sie bitte einen gÅltigen Zeitraum ein!
.continue BREAK
..
!ERROR03: Unknown header fields
.error -field M|ausloeserkopf -message Die Kopffelder 'U|unknownheaderfields' sind unbekannt!
.continue BREAK
..
!ERROR05: Unknown table fields
.error -field M|ausloesertabelle -message Die Tabellenfelder 'U|unknowntablefields' sind unbekannt!
.continue BREAK
..
!ERROR06: Database is not allowed
.error -field M|dn -message Die Datenbank 'M|dn' ist nicht erlaubt!
.continue BREAK
..
!ERROR07: Database is not allowed
.error -field M|dn -message Das Kommando fÅr Datenbank 'M|dn' ist nicht erlaubt!
.end 1
..
!ERROR08: Bitte passende Gruppe angeben.
.error Bitte passende Gruppe angeben.
.cursor vartabgruppe 0
.end 1
..
!ERROR09 
.error Bitte die Ausgabe Åber einen Zeitraum und/oder einen Bearbeiter einschrÑnken.
.end 1
..
!ERROR10
.error Es wurde kein Auslîserfeld angegeben!
.cursor ausloeserkopf 0
.end 1
..
!BREAK
.end 1
