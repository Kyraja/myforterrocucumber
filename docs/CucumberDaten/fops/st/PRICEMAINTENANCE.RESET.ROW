..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PRICEMAINTENANCE.RESET.ROW
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  : If a row was marked and is set to unmarked we need to reset
.. editable items to their original values. If not validations will not work
.. properly. This resets editable items in one row to their original values.
..*****************************************************************************
.set trans -
..
.continue PARENT ? M|tbaumstufe = M|headerlevel
.continue CHILD  ? M|tbaumstufe = M|rowlevel
.continue FATAL
..
!CHILD: Do nothing while unmarked
.copy M|mgrenzeneu = M|mgrenze
.continue PRICE ? _M|ktyprabatt
..
.. Discount items
.copy M|mprozneu = M|mproz
.copy M|mnrabneu = M|mnrab
.continue END
..
!PRICE: Price items
.copy M|mpreisneu = M|mpreis
.copy M|mnpreisneu = M|mnpreis
.continue END
..
!PARENT: Do nothing while marked
.copy M|tvonneu = M|tvon
.copy M|tbisneu = M|tbis
.copy M|tsaktionneu = M|tsaktion
.copy M|gruppenprneu = M|gruppenpr
.copy M|tzrundneu = M|tzrund
.copy M|mgeabneu = M|mgeab
.continue PRICE2 ? _M|ktyprabatt
..
.. Discount items
.copy M|separatneu = M|separat
.copy M|kettrabneu = M|kettrab
.copy M|rfolgeneu = M|rfolge
.continue END
..
!PRICE2: Price items
.copy M|rundungneu = M|rundung
.copy M|mbruttoneu = M|mbrutto
.copy M|mnbruttoneu = M|mnbrutto
.copy M|rpreisneu = M|rpreis
.copy M|spreisneu = M|spreis
.copy M|nrpreisneu = M|nrpreis
.copy M|nspreisneu = M|nspreis
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
