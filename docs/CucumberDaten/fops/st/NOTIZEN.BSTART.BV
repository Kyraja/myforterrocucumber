..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : NOTIZEN.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Eingaben und formuliert DB-Anfrage.
.. Functionality  : Builds database query.
..*****************************************************************************
.set trans -
..
.continue CLRTAB  ? F|empty(M|vomdatum) & F|empty(M|bisdatum)
.continue ERROR01 ? M|vomdatum > M|bisdatum
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..
.formula M|select = "$,,"
..
.. Add criteria for trigger
.continue PARTNER ? F|empty(M|ursache)
.formula M|select = M|select + ";ursache=" + M|ursache^id
..
!PARTNER: business partner
.continue ELEMENT ? F|empty(M|partner)
.formula M|select = M|select + ";partner=" + M|partner^id
..
!ELEMENT: manufacturing
.continue DOCUMNT ? F|empty(M|elem)
.formula M|select = M|select + ";elem=" + M|elem^id
..
!DOCUMNT: sales or purchasing document
.continue INTERN ? F|empty(M|evvorgang)
.formula M|select = M|select + ";evvorgang=" + M|evvorgang^id
..
!INTERN: Internal task
.continue EDITOR ? _F|empty(M|intern)
.formula M|select = M|select + ";intern=" + 'G|FALSE'
..
!EDITOR: Add editing staff personnel
.continue TYPE ? F|empty(M|bearbeit)
.formula M|select = M|select + ";bearbeit=" + M|bearbeit^id
..
!TYPE: Add type
.continue ENTER ? F|empty(M|typ)
.formula M|select = M|select + ";typ=" + M|typ^id
..
!ENTER: Add enter date
.continue ORDER ? F|empty(M|vomdatum) & F|empty(M|bisdatum)
.formula M|select = M|select + ";datum=" + 'M|vomdatum:8' + "!" + 'M|bisdatum:8'
..
!ORDER: Order is enter date backward
.formula M|select = M|select + M|globaleordnung
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Illegal period!
.error -line 0 -field M|vomdatum -message Bitte geben Sie einen gÅltigen Zeitraum ein.
.end 1
