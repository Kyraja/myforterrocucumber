..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PDFHILFE.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : mg
.. Funktion       : Erzeugt die PDF-Onlinehilfedateien.
.. Ablauf         : Button-nach-EFOP
..
.. Functionality  : Generates PDF files for the online help.
.. Program flow   : After button efop
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xumleitungen
.type DVM2 xresult
.type bool xberror
..
.. initializations
.file -tempname U|xresult
.formula U|xumleitungen = "1>>" + U|xresult + " 2>>" + U|xresult
.copy U|xberror = G|FALSE
..
.continue COMPLET ? M|ganzehilfe
.occupy 'M|sperrname' installation ? M|sperren
.continue ERROR1 ? M|sperren & _G|gesperrt
..
!NEXT
.select screen line
.continue UPTABLE ? _G|mehr
.continue NEXT ? _M|tmark
.system 'F|formatstr("xmlpdfhelp.sh -l {1} -o {2}/{3} {4} {5}", M|hspr, M|pfadziele, M|tziel, M|tquelle, U|xumleitungen)' background
.copy U|xberror = (U|xberror ; _G|mehr)
.continue NEXT
..
!COMPLET
.occupy 'M|sperrname' installation ? M|sperren
.continue ERROR1 ? M|sperren & _G|gesperrt
.system 'F|formatstr("xmlpdfhelp.sh -l {1} -o {2}/{3} {4}", M|hspr, M|pfadziele, M|kziel, U|xumleitungen)' background
.continue ERROR2 ? _G|mehr
.occupy
..
!UPTABLE: update table
.input 'M|tab'
..
!UNLOCK
.occupy
.continue ERROR2 ? U|xberror
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.occupy
.error -message Aktion ist derzeit gesperrt. Vorgang sp„ter wiederholen
.end 1
..
!ERROR2
.occupy
.output terminal
.. Convert error message charset
.system 'F|formatstr("s3_conv 11 {1}", U|xresult)' background
..
'U|xresult'
=================
.set replacement =@
.set command =%
%input -text @U|xresult@
%set command=.
.set replacement ='
.error -message Die PDF-Erzeugung war fehlerbehaftet ? _M|ganzehilfe
.error -message Die PDF-Datei der ganzen Onlinehilfe wurde nicht erzeugt ? M|ganzehilfe
.end 1
