..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDERUNGSHISTORIE.FUELLT
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       :
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type GL   zeilenselektion   ? _F|defined(U|zeilenselektion)
.type bool xtreffer          ? _F|defined(U|xtreffer)
.type text xtextt            ? _F|defined(U|xtextt)
.type text xftextt           ? _F|defined(U|xftextt)
.type bool xmehr             ? _F|defined(U|xmehr)
..
.file -tempname U|xftextt
.output new 'U|xftextt'
..
.copy M|dbnotab = G|FALSE
.assign M|select = "!"
.copy M|numsuch = _F|regmatch(M|select, "^[%$].*")
.continue GROUP   ? _M|numsuch
.assign M|select = F|formatstr("$,,@numsuch={1}", M|select)
..
!GROUP
.formula M|grliste = 'M|datnr'+":"+'M|vartabgruppe^vgr' 
.load 4 group 'M|grliste' 'M|select'
.continue END  ? _G|mehr
..
.load 5 metadata "4|"
.continue END  ? _G|mehr
.assign U|zeilenselektion = F|formatstr("$,,vname==itversionn;vkt==0;vlgsb=;vversionausloeser=1")
.load 5 line 'U|zeilenselektion'
.copy U|xtreffer = G|TRUE ?   G|mehr
.load 5
.load 5 metadata "4|"
.continue END  ? _G|mehr
..
!HUELSEPRUEF
.assign U|zeilenselektion = F|formatstr("$,,such=;vvkopherk="+'M|vartabgruppe'+";vvkoph=ja")
.load 5 line 'U|zeilenselektion'
.copy U|xmehr = G|TRUE ? G|mehr
.load 5
.load 5 metadata "4|"
.continue END       ? _G|mehr
.continue SELTAB    ?  U|xmehr
.continue TABELLEPRUEF
..
!TABELLEPRUEF
.assign U|zeilenselektion = F|formatstr("$,,vkt==1")
.load 5 line 'U|zeilenselektion'
.continue DBNOTAB ? _G|mehr
.load 5
.load 5 metadata "4|"
.continue END  ? _G|mehr
..
!SELTAB: Tabelle, FO bekannt (vlgsb) bleibt unberÅcksichtigt, VA gesetzt
.assign U|zeilenselektion = F|formatstr("$,,vname~/==^..;vkt==1;vlgsb=;vversionausloeser=1") ? _U|xtreffer
.assign U|zeilenselektion = F|formatstr("$,,vname~/==^..;vkt==1;vlgsb=")  ? U|xtreffer
.load 5 line 'U|zeilenselektion'
.continue END ? _G|mehr
.output addedto 'U|xftextt'
.input "DATEI.F"
.formula U|xtextt = 'F|substr(5|vname, 3, )'
.formula U|xtextt = 'F|toupper(U|xtextt)'
'U|xtextt'
.output
.formula M|ausloeser2tabelle = U|xftextt
..
!SEL5
.load 5 line
.continue END     ? _G|mehr
.output addedto 'U|xftextt'
.input "DATEI.F"
.formula U|xtextt = 'F|substr(5|vname, 3, )'
.formula U|xtextt = 'F|toupper(U|xtextt)'
'U|xtextt'
.output
.formula M|ausloeser2tabelle = U|xftextt
.continue SEL5
..
!DBNOTAB
.copy M|dbnotab = G|TRUE
.copy M|alletabelle = G|FALSE
.protection alletabelle
.protection ausloesertabelle
.protection ausloeser2tabelle
.protection feldertabelle
.continue END
..
!END
.continue
