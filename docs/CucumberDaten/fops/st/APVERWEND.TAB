..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APVERWEND.TAB
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Erzeugt eine Tabellenzeile.
.. Functionality  : Creates a table row.
..*****************************************************************************
.set trans -
..
.assign M|elem = 0
.make screen line +O
..
.. Defaults
.assign M|tbaumstat = "+"
.assign M|tbaumstufe = M|stufe + 1
.assign M|tbaumtext = H|grbez
.copy M|taufruf = H|aufruf
..
!ITERATE
.formula M|elem = M|elem + 1
.continue TREETXT ? M|elem > M|elemmax
.assign M|elemmark = "ELEM" + 'M|elem'
.continue 'M|elemmark'
..
!ELEM1: Handle callparameter or callparameter list
.add H|aufruf
.continue ELEM2 ? _G|mehr
.continue MEMBERS
..
!ELEM2: Handle using of callparameter or callparameter list
.copy M|tkopf = H|kopf
.add H|kopf
.continue END ? _G|mehr
..
!MEMBERS
.copy M|tkontexttyp.M|elem = D|kontexttyp
.copy M|taufrtab.M|elem = D|aufrtab
.assign M|tbuttonfeldort.M|elem = "(HeaderField)" ? _D|aufrtab
.assign M|tbuttonfeldort.M|elem = "(TableField)"  ?  D|aufrtab
.copy M|tbuttonfeld.M|elem = D|buttonfeld ? F|defined(D|buttonfeld)
.copy M|taufrktxt.M|elem = D|aufrktxt
.copy M|tbaumiconz = D|aufrktxt^icon
.formula M|taufrktxtbez.M|elem = D|aufrktxt^grbez
.continue VARTAB  ? D|aufrktxt^dnr = 12 & D|aufrktxt^gruppe = 26
.continue INFOSYS ? D|aufrktxt^dnr = 65 & D|aufrktxt^gruppe =  1
.formula M|taufrktxtbez.M|elem = D|kontexttyp
.continue LSTTYPE
..
!VARTAB
.formula M|taufrktxtbez.M|elem = M|taufrktxtbez.M|elem + " " + D|aufrktxt^vgrtxt
.continue LSTTYPE
..
!INFOSYS
.formula M|taufrktxtbez.M|elem = M|taufrktxtbez.M|elem + " " + D|aufrktxt^sucherw
..
!LSTTYPE
.continue MENULST ? D|gruppe = 13
.continue PARTLST ? D|gruppe = 14
..
.. Simple List
.formula M|tbez.M|elem = D|grbez
.continue ITERATE
..
!MENULST: Menu list
.assign M|tbaumstat = ""
.formula M|tbez.M|elem = D|grbez
.continue ITERATE
..
!PARTLST: Partial list
.assign M|tbez.M|elem = D|typ
.continue ITERATE
..
!TREETXT
.formula M|tbaumtext = M|tbez2 + " - " + M|taufrktxtbez2
.continue VALIDATE ? M|tbaumstat = ""
.formula M|tbaumtext = M|tbaumtext + " - " + M|tbuttonfeldort2 + " " + M|tbuttonfeld2
..
!VALIDATE
.continue END ? _M|markierekonflikte
.input "st/APVERWEND.VALIDATE"
.copy M|tbaumiconz = M|konflikticon ? M|tkonflikt
..*****************************************************************************
!END
.continue
