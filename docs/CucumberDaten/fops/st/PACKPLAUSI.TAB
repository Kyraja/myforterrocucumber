..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PACKPLAUSI.TAB
.. Autor          : comu/mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Zeilen-FOP, Ausgabe der Packmittel
.. Functionality  : row efop, display of loading items
..*****************************************************************************
.set trans -
..
.. error state of packaging material
.copy U|xbf1 = G|false
.copy U|xbf2 = G|false
.copy U|xbf3 = G|false
.copy U|xbf4 = G|false
.copy U|xbf5 = G|false
.copy U|xbf6 = G|false
.copy U|xbf7 = G|false
.copy U|xbf8 = G|false
.copy U|xbf9 = G|false
..
.. Initialize product specific local fields
.copy U|xbkeineabmessung  = G|false
.copy U|xbkeineabmessungi = G|false
.copy U|xbmitabmessung    = G|false
.copy U|xbmitabmessungi   = G|false
.copy U|xbkeinpackkenn    = G|false
.copy U|xbfehler          = G|false
.copy U|xbwarnung         = G|false
.formula U|xif               = 0
.formula U|xtpmtyp           = U|xLeer
.formula U|xtvpkenn          = U|xLeer
..
.. converse text to internal value of enumeration (language compatibility)
.formula U|xtpmtyp  = F|value(H|pmtyp,"AU215")
.formula U|xtvpkenn = F|value(H|vpkenn,"AU189")
..
.. check if params for packaging material size are set
.formula U|xbmitabmessung    = H|packlge <> 0   ;  H|packbr <> 0   ;  H|packhoe <> 0
.formula U|xbkeineabmessung  = H|packlge = 0    &  H|packbr = 0    &  H|packhoe = 0
.formula U|xbmitabmessungi   = H|packlgei <> 0  ;  H|packbri <> 0  ;  H|packhoei <> 0
.formula U|xbkeineabmessungi = H|packlgei = 0   &  H|packbri = 0   &  H|packhoei = 0
.formula U|xbkeinpackkenn    = F|empty(H|packmitken)  &  (U|xtpmtyp = U|xLeer)  &  (U|xtvpkenn = U|xLeer)  &  F|empty(H|egtkenn)
..
.. skipp product that are NOT packaging materials
..  *  product is not flagged as packaging material
..  *  and does not have any specific params for "partial" packaging materials
..
.. Only create rows for packaging material and products with errors
.continue END     ? _H|packmit  &  U|xbkeinpackkenn  &  U|xbkeineabmessung  &  U|xbkeineabmessungi
.continue ARTIKEL ? _H|packmit
..
..
!PACKM: error text if product is packaging material
.. ignore erros 1, 2, 5 - if M|kbpackmitkenfehl is not set
.formula U|xbf1 = true     ?  H|packmitken = "S"     &  U|xtpmtyp = U|xPalette           &  M|kbpackmitkenfehl
.formula U|xbf1 = true     ?  H|packmitken = "S"     &  U|xtpmtyp = U|xPackhilfsmittel   &  M|kbpackmitkenfehl
.formula U|xbf1 = true     ?  H|packmitken = "S"     &  U|xtpmtyp = U|xDeckel            &  M|kbpackmitkenfehl
.formula U|xbf1 = true     ?  H|packmitken = "S"     &  U|xtpmtyp = U|xZwischenlage      &  M|kbpackmitkenfehl
.formula U|xbf1 = true     ?  H|packmitken = "S"     &  U|xtpmtyp = U|xFuellmaterial     &  M|kbpackmitkenfehl
..
.formula U|xbf2 = true     ?  F|empty(H|packmitken)  &  U|xtpmtyp = U|xBehaelter         &  M|kbpackmitkenfehl
.formula U|xbf2 = true     ?  F|empty(H|packmitken)  &  U|xtpmtyp = U|xPalette           &  M|kbpackmitkenfehl
..
.formula U|xbf5 = true     ?  H|packmitken = "M"     &  U|xtpmtyp <> U|xPalette          &  M|kbpackmitkenfehl
.formula U|xbf5 = true     ?  H|packmitken = "G"     &  U|xtpmtyp <> U|xPalette          &  M|kbpackmitkenfehl
..
.. show "must set pmtyp" if not a more specific error is shown
.formula U|xbf7 = true     ?   U|xtpmtyp = U|xLeer   & _U|xbf5 & _U|xbf1
..
.formula U|xbf3 = true     ? _H|packmit  &   F|empty(H|packmitken)  &  (U|xtpmtyp = U|xLeer)  &  (U|xtvpkenn = U|xLeer)  &  F|empty(H|egtkenn)  &  U|xbkeineabmessung  &  U|xbkeineabmessungi
.formula U|xbf4 = true     ?  H|vol = 0  &  (H|packlge = 0 ; H|packbr = 0 ; H|packhoe = 0)
.formula U|xbf6 = true     ?  F|empty(H|vbezbspr)
.formula U|xbf8 = true     ?  U|xtvpkenn = U|xMehrwegverpackung  &  F|empty(H|egtkenn)
.formula U|xbf9 = true     ?  H|gewicht = 0
.continue MAKEROW
..
!ARTIKEL: error text if product is NOT packaging material
.formula U|xbf3 = true     ?  U|xtpmtyp  <> U|xLeer
.formula U|xbf3 = true     ?  U|xtvpkenn <> U|xLeer
.formula U|xbf3 = true     ? _F|empty(H|packmitken)  &  M|kbpackmitkenfehl
.formula U|xbf3 = true     ? _F|empty(H|egtkenn)
.formula U|xbf3 = true     ?  U|xbmitabmessung
.formula U|xbf3 = true     ?  U|xbmitabmessungi
.continue MAKEROW
..
..
!MAKEROW
.. if flag kpackfehl is set - only show packaging material with errors
.formula U|xbfehler  = ( U|xbf1 ; U|xbf2 ; U|xbf3          ; U|xbf5 ; U|xbf6 ; U|xbf7 ; U|xbf8          )
.formula U|xbwarnung = (                            U|xbf4 ;                                     U|xbf9 )
.continue SHOW    ?  M|kpackfehl       &    U|xbfehler
.continue SHOW    ?  M|kpackwarnung    &    U|xbwarnung
.continue SHOW    ?  M|kpackfehlerfrei & _( U|xbfehler ; U|xbwarnung )
.continue END
..
!SHOW
.make screen line +O
.formula M|tid          = H|id
.formula M|tnamebspr    = H|sucherw
.formula M|tvbezbspr    = H|vbezbspr
.formula M|tpackmit     = H|packmit
.formula M|tpmtyp       = H|pmtyp
.formula M|tpackmitken  = H|packmitken
.formula M|tvpkenn      = H|vpkenn
.formula M|tegtkenn     = H|egtkenn
.formula M|tbsart       = H|bsart
.formula M|tlief        = H|lief^id
.formula M|tepr         = H|epr
.formula M|teland       = H|eland
.formula M|tepe1        = H|epe1
.formula M|tefrist      = H|efrist
.formula M|tvorlauf     = H|vorlauf
.formula M|tpacklge     = H|packlge
.formula M|tpackbr      = H|packbr
.formula M|tpackhoe     = H|packhoe
.formula M|tvol         = H|vol
.formula M|tgewicht     = H|gewicht
.formula M|tpackhoeklap = H|packhoeklap
.formula M|tpacklgei    = H|packlgei
.formula M|tpackbri     = H|packbri
.formula M|tpackhoei    = H|packhoei
.formula M|tfuellgrad   = H|fuellgrad
.formula M|tvoli        = H|voli
.formula M|tnutzlast    = H|nutzlast
.formula M|tnutzlast    = H|nutzlast
.formula M|tstapelf     = H|stapelf
.formula M|tauflast     = H|auflast
.formula M|tladehoe     = H|ladehoe
.formula M|twstoff      = H|wstoff^id
..
.formula M|tshowicon    = G|icook  ? _U|xbfehler  & _U|xbwarnung
.formula M|tshowicon    = G|icowarn ?  U|xbwarnung
.formula M|tshowicon    = G|icoerror    ?  U|xbfehler
.formula M|tbmark       = false
..
.formula U|xif = 0
.formula M|tfehler = ""
!NFEHLER
.formula U|xif = U|xif + 1
.formula M|tfehler = M|tfehler + ";"          ?  U|xbf.xif  &  _F|empty(M|tfehler)
.formula M|tfehler = M|tfehler + U|xtf.xif    ?  U|xbf.xif
.continue NFEHLER ? U|xif < 9
..
.protection tvbezbspr 'M|aktzeile'
.protection tbmark 'M|aktzeile'
.. .schutz tpmtyp 'M|aktzeile'
.protection tegtkenn 'M|aktzeile'
.protection tpackmitken 'M|aktzeile'
..
.protection -reset tpmtyp 'M|aktzeile'          ?  U|xbf2 ; U|xbf7  ; U|xbf5
.protection -reset tegtkenn 'M|aktzeile'        ?  U|xbf8
.protection -reset tpackmitken 'M|aktzeile'     ?  U|xbf1 ; U|xbf2  ; U|xbf5 ; U|xbf7
.protection -reset tvbezbspr 'M|aktzeile'       ?  U|xbf6
..*****************************************************************************
!END
.continue
