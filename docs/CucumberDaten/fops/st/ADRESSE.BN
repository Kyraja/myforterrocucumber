..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ADRESSE.BN
.. Autor          : lei
.. Verantwortlich : cl
.. Kontrolle      : foe
.. Funktion       : Setzt je nach Adressformat den Adressblock "ort" zusammen.
..*****************************************************************************
.type text xans ?_F|defined(U|xans)
..
.set trans -
..
.continue ? _G|evtartengl = "BUTTON_AFTER" ; _G|evtvar = "bstart"
..
.type text xland xlandname
.set separator
..
.continue LAND ? _F|sysinfo(18)^zugferd
.. Daten fÅr ZUGFeRD
.formula M|landiso2 = M|staat^iso2
.formula U|xans = M|str
.formula M|anszeile1 = U|xans <<";"
.formula U|xans = U|xans >>";"
.formula M|anszeile2 = U|xans <<";"
.formula U|xans = U|xans >>";"
.formula M|anszeile3 = U|xans
..
!LAND: Land lesen
.. leere Adressen werden immer toleriert
.continue ERRLA1    ? F|empty(M|staat)
.continue ERRLA3    ? _F|equals(M|staat^typ, "(Country)")
.assign M|rname = M|staat^rnamebspr
.copy M|laart = M|staat^laarta
.copy M|adrformat = M|staat^adrformat
.formula M|sprname = M|staat^sprname
.copy M|jasperlayout = M|adrformat^jasperlayout
.copy M|jasperlaynam = ""
..
.. Adresse im Puffer 0 aufbereiten
..
.load 0 add M|adrformat
.continue ERRLA4    ? _G|mehr
.assign 0|ans         = M|ans
.assign 0|str         = M|str
.assign 0|plz         = M|plz
.assign 0|nort        = M|nort
.assign 0|region      = M|region
.assign 0|staat       = M|staat
.assign M|adresse = 0|adresse
.assign M|ort     = 0|ort
.assign M|rname   = 0|lanamevspr
..
.. Bei Inlandsadressen wird kein Land ausgegeben
.continue INLAND ? F|equals(M|laart, "(Domestic)")
.continue SUBLAYOUT
..
!INLAND
.assign M|rname = ""
.continue SUBLAYOUT
..
!SUBLAYOUT
.input "st/FOPENDEADRESSE"
.continue ? F|empty(M|jasperlayout)
.continue HINT1 ? 'M|num65' <> 'M|jasperlayout^kontext^nummer'
.assign M|jasperlaynam = "jasper/layoutstyles/" + ( ( M|jasperlayout^layname << ".jrxml" ) >> "jasper/layout/" ) + ".jasper"
.continue
..*****************************************************************************
..
!ERRLA1
.error Staat fehlt.
.cursor staat
.end 1

!ERRLA3
.error Staat 'M|staat' ist vom Typ: 'M|staat^typ'.
.cursor staat
.end 1

!ERRLA4
.error In Staat 'M|staat' ist kein Adressformat eingetragen.
.cursor staat
.end 1

!HINT1
.note Layout 'M|jasperlayout' aus Adressformat 'M|adrformat' darf in dieser Maske nicht gedruckt werden.
.cursor adrformat
.continue
