..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDH.DIFF.ZEILEN1FELD
.. Autor          : erwo
.. Verantwortlich : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.type text  zeilenselektion       ? _F|defined(U|zeilenselektion)
..
.copy U|objekttitelerledigt = G|true  ? _U|objekttitelerledigt
.input "st/AENDH.DIFF.ZEILENTITEL"    ? _U|zeilentitelerledigt
..
.make screen line +O
.assign M|tnummer = M|kid  ? _F|empty(M|kid)
.assign M|tsnummer = M|kid ? _F|empty(M|kid)
.copy M|typk = U|xtypk
.copy M|typt = U|xtypt
.copy M|tzeitpunkt = U|itstand
.copy M|tfeldname = U|stringlistekopf
.assign M|tzeile = 1|aktzeile
.assign M|tneu = "-"
... Wert unter Beruecksichtigung der Feldprioritaet des Originalfelds anzeigen 
.set foextern -
.assign T|wertalt = '1|.U|stringlistekopf'
.set foextern +
.assign M|talt = T|wertalt
.assign M|tversionn = U|versionn
.copy M|tvversion = 1|versionn
.copy M|tbearbeiter = U|itzeichen
..
.load 6 object 'M|kid^id'
.continue END ? _G|mehr
.load 7 metadata "6|"
.continue END ? _G|mehr
.formula U|zeilenselektion = "$,,vname~/==^.."+'M|tfeldname'
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.copy M|va = 7|vversionausloeser
.formula M|bedeutung = 7|vbeds
.load 7
.load 6
..
..*****************************************************************************
!END
.continue
