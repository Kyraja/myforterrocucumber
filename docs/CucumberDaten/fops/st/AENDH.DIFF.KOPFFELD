..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDH.DIFF.KOPFFELD
.. Autor          : erwo
.. Verantwortlich : cl
.. Kontrolle      : lei
.. Funktion       :
.. Functionality  :
..
..*****************************************************************************
.type bool kopferledigt         ? _F|defined(U|kopferledigt)
.type GL   test                 ? _F|defined(U|test)
.type bool erst                 ? _F|defined(U|erst)
.type bool weiterkopf           ? _F|defined(U|weiterkopf)
.type GL   test1                ? _F|defined(U|test1)
.type text zeilenselektion      ? _F|defined(U|zeilenselektion)
..
.continue END ? U|xkfertig   
..
.set trans -
.copy U|objekttitelerledigt = G|true  ? _U|objekttitelerledigt
.input "st/AENDH.DIFF.KOPFTITEL"      ? _U|kopftitelerledigt
..
.formula U|test = ".*" + 'U|stringlistekopf' + ".*"
.. alle Kopffelder sind leer
.continue   ?  F|empty(M|ausloeserkopf) & F|empty(M|ausloeser2kopf) &  F|empty(M|felderkopf)
.continue   ? _F|defined(1|.U|stringlistekopf)
..
.continue   ? '2|.U|stringlistekopf' = '1|.U|stringlistekopf' & M|allekopf
.continue   ? '2|.U|stringlistekopf' = '1|.U|stringlistekopf' & F|regmatch(M|ausloeserkopf, U|test)
.make screen line +O
.formula M|taenderung = G|FALSE 
.formula M|taenderung = G|TRUE   ? '2|.U|stringlistekopf' <>  '1|.U|stringlistekopf'
.assign M|tnummer = M|kid  ? _F|empty(M|kid)
.assign M|tsnummer = M|kid ? _F|empty(M|kid)
.copy M|typk = U|xtypk
.copy M|typt = U|xtypt
.copy M|tzeitpunkt = U|itstand
.copy M|tfeldname = U|stringlistekopf
.set foextern -
.assign U|wertneu = '2|.U|stringlistekopf'
.assign U|wertalt = '1|.U|stringlistekopf'
.set foextern +
.assign M|tneu = U|wertneu
.assign M|talt = U|wertalt
.copy M|tversionn = U|versionn
.copy M|tvversion = U|vversionn
.copy M|tbearbeiter = U|itzeichen
.formula U|test1 = ".*" + 'U|stringlistekopf'
..
.load 6 object 'M|kid^id'
.continue END ? _G|mehr
.load 7 metadata "6|"
.continue END ? _G|mehr
.formula U|zeilenselektion = "$,,vname~/==^.."+'M|tfeldname'
.load 7 line 'U|zeilenselektion'
.continue END ? _G|mehr
.copy M|va = 7|vversionausloeser
.formula M|bedeutung = 7|vbeds
.load 7
.load 6
..
..*****************************************************************************
!END
.make screen line - ?  _M|taenderung & _M|auchneu
.continue
