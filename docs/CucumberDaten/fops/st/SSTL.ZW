..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SSTL.ZW
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Zeilenwerte in Kopfwerte kopieren.
.. Functionality  : Copys row values into header.
...Includes       :
..*****************************************************************************
.set trans -
..
.copy M|kbaumstufe = M|tbaumstufe
.copy M|kvpos = M|vpos
.copy M|kelem = M|elem
.copy M|kbasisartikel =  M|kelem^basisartikel
.copy M|kkompeig = M|kompeig
.copy M|klaggr = M|laggr
.copy M|kdispo = M|dispo
.copy M|kdispoa = M|dispoa
.copy M|kbsart = M|bsart
.copy M|klaenge = M|laenge
.assign M|klme = ""
.copy M|klme = M|ellme ? _F|empty(M|klaenge)
.copy M|kbreite = M|breite
.assign M|kbme = ""
.copy M|kbme = M|elbme ? _F|empty(M|kbreite)
.copy M|kmge = M|mge
.assign M|kelle = ""
.copy M|kelle = M|elle ? F|empty(M|klaenge) & F|empty(M|kbreite) & _F|empty(M|kmge)
.copy M|kgesamt = M|gesamt
.assign M|ktele = ""
.copy M|ktele = M|tele ? _F|empty(M|menge)
.copy M|kmgr = M|mgr
.copy M|klgr = M|lgr
.copy M|kebu = M|ebu
.copy M|kpostext = M|postext
.copy M|kfilter     = M|filter      ? F|defined(M|kfilter)
.copy M|kfiltervgl  = M|filtervgl   ? F|defined(M|kfiltervgl)
.copy M|kfiltervgl2 = M|filtervgl2  ? F|defined(M|kfiltervgl2)
.copy M|krelevant   = M|relevant    ? F|defined(M|krelevant)
.copy M|kauslaufstatusicon = M|auslaufstatusicon ? F|defined(M|kauslaufstatusicon)
.copy M|knachfolgeartikel = M|tnachfolgeartikel ? F|defined(M|knachfolgeartikel)
.copy M|klbsdatum = M|tlbsdatum ? F|defined(M|klbsdatum)
.copy M|klverwdatum = M|tlverwdatum ? F|defined(M|klverwdatum)
.copy M|kvgltermin = M|tvgltermin ? F|defined(M|kvgltermin)
..*****************************************************************************
!END
.continue
