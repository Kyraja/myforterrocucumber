..!interpreter english translate noabbrev
..*****************************************************************************
.. Name: VIEWLOCKS.FOP
.. Author: fwester
.. Verantwortlich: TeamEAF
.. Kontrolle:
..
.. Usage:
.. This EFOP is registered at the mask 1504 (object lock list) at the header
.. button "sperrenzeigen". It is called from the abas kernel without specifying
.. the directory. Its call can be overridden by an individual EFOP of the same
.. name. This must then be located in an individual directory which is located
.. in front of that of the standard EFOP in the user's workspaces.
..
.. Functionality:
.. Opens and runs a object selection showing all object locks determined by the
.. value of the mask field "id" in recording order. If the "id" is empty or not
.. defined, the dialog will be opened, but not started automatically. If the
.. "id" does not represent an object lock list as well.
..*****************************************************************************
.set trans -
..
.. Is the object selection started automatically?
.type bool autostart
.. The object lock list for which all object locks are to be shown.
.type text objectlocklist
.. The database name for the GUI command.
.type text dbname
.. The command name for the GUI command.
.type text actionname
.. The executable GUI command.
.type text commandstr
.. The formatting template for the GUI command.
.type text formatmask
..
.copy U|autostart = G|false
.copy U|objectlocklist = ""
.formula U|formatmask = "<{1}>%,,@gruppe=11;@autostart={2};@ablage=beides;ablagef=;nummer=;erfass=;enddatum=;sucherw=;sperrkonfiguration=;grund=;sperrliste={3};@ordnung=erfass.r<{4}>"
..
..Get name of database command
.input "KDATNAME.KONST"
.formula U|dbname = G|kdatname.U|kodatOBJEKTSPERRE
..
.. Get name of database action
.input "KAKTNAME.KONST"
.formula U|actionname = G|kaktname.U|koaktWAEHLEN
..
.continue FORMAT ? _F|defined(M|id)
.continue FORMAT ?  F|empty(M|id)
.continue FORMAT ? _F|isvalue('M|id', "ID193:1")
.formula U|objectlocklist = M|id
.copy U|autostart = G|TRUE
..
!FORMAT: Format GUI command
.formula U|commandstr = F|formatstr(U|formatmask, U|dbname, U|autostart, U|objectlocklist, U|actionname)
.command -parallel 'U|commandstr'
..*****************************************************************************
!END
.continue
