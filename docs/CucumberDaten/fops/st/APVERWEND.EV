..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APVERWEND.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt zentral die einfachen Feldereignisse.
.. Functionality  : Central handling of simple field events.
..*****************************************************************************
.set trans -
..
.. ----------------------------------------------------------------------------
.. Kopfteil/Header
.. ----------------------------------------------------------------------------
.continue CHECKOK ? G|evtartengl="BUTTON_BEFORE" & G|evtvar="kpruefaufruf"
.continue CHECKOK ? G|evtartengl="BUTTON_BEFORE" & G|evtvar="kpruefkopf"
.continue CLRALL  ? G|evtartengl="FIELD_EXIT"    & G|evtvar="aufruf"
.continue CLRALL  ? G|evtartengl="FIELD_EXIT"    & G|evtvar="anzstufen"
.continue CLRALL  ? G|evtartengl="FIELD_EXIT"    & G|evtvar="markierekonflikte"
.. ----------------------------------------------------------------------------
.. Tabelle/Table
.. ----------------------------------------------------------------------------
.continue FORBIDD ? G|evtartengl = "ROW_MOVED_BEFORE"
.. ----------------------------------------------------------------------------
.continue END
..
!CHECKOK: Check permitted?
.continue ERROR01 ? G|evtvar="kpruefaufruf" & F|empty(M|kaufruf)
.continue ERROR02 ? G|evtvar="kpruefkopf"   & F|empty(M|kkopf)
..
.. Check element
.continue CHK2 ? G|evtvar="kpruefkopf"
.add M|kaufruf
.continue CHK3
..
!CHK2
.add M|kkopf
!CHK3
.continue END ? _G|mehr
.continue ERROR03 ? _F|defined(D|pruefezeilen)
.end 0 'F|formatstr("{1}<(View)>?pruefezeilen=1|[invisible]=1", D|id)'
..
!FORBIDD: Action not allowed
.end 1
..
!CLRALL: Clear table and details
.input 'M|rowdetails' ? _F|empty(M|rowdetails)
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Missing element!
.error -line 0 -field M|kaufruf -message Der Gegenstand der PrÅfung ist leer!
.continue BREAK
..
!ERROR02
.error -line 0 -field M|kkopf -message Der Gegenstand der PrÅfung ist leer!
.continue BREAK
..
!ERROR03: Missing function!
.error -message Diese Funktion ist im Gegenstand der PrÅfung nicht vorhanden!
..
!BREAK
.end 1
