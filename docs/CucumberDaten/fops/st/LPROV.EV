.set trans -
..
..-----------------------------------------------------------------------------
.continue PRODGRP ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kartpg"
.continue REPRGRP ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kvertpg"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kvon"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbis"
.continue REPRSNT ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kvertreter"
.continue PRODUCT ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kartikel"
..-----------------------------------------------------------------------------
.continue END
..
!REPRGRP: Exit representative group
.assign M|kvertreter = ""
.continue CLRTAB
..
!PRODGRP: Exit product group
.assign M|kartikel = ""
.continue CLRTAB
..
!PRODUCT: Exit product
.assign M|kartpg = M|kartikel^prov
.continue CLRTAB
..
!REPRSNT: Exit representative
.assign M|kvertpg = M|kvertreter^rab
.continue CLRTAB
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
