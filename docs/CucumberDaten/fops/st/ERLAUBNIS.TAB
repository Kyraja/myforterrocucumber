..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.TAB
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Erzeugt alle Tabellenzeilen zu einem im H-Puffer geladenen
.. Passwort im Infosytem Erlaubnisse.
.. Ablauf         : Tabellen-EFOP
..
.. Functionality  : Creates in the infosystem Permissions all table rows for a
.. password which is loaded in buffer H.
.. Program flow   : Table efop
..*****************************************************************************
.set trans -
..
.. Initializations
.assign M|aktpasswort = H|id
..
.. Filter passwords
.input "ERLAUBNIS.FILTER.PASSWD"
.continue END ? _U|xxok
..
.. Define visualization of password
.assign M|aktmarke = "ALL"
.input "st/ERLAUBNIS.DEFINE.VIEW"
.continue 'M|aktmarke'
..
!ALL: Show all permissions
.copy M|kgetippt = G|FALSE
.input "ERLAUBNIS.SHOW.ALL.DB"
..
.copy M|kgetippt = G|TRUE
.input "ERLAUBNIS.SHOW.ALL.TIPPED"
.continue END
..
!ALLDB: Show all database command permissions
.copy M|kgetippt = G|FALSE
.input "ERLAUBNIS.SHOW.ALL.DB"
.continue END
..
!ALLTC: Show all tipped command permissions
.copy M|kgetippt = G|TRUE
.input "ERLAUBNIS.SHOW.ALL.TIPPED"
.continue END
..
!SINGLE: Show single permissions of both specified commands
.copy M|kgetippt = G|FALSE
.assign M|kdbkomnr = M|kdatnr
.assign M|kdbkomname = M|kdatname
.input "st/ERLAUBNIS.SHOW.PERMISSION"
..
.copy M|kgetippt = G|TRUE
.assign M|kdbkomnr = M|kkomnr
.assign M|kdbkomname = M|kkomname
.input "st/ERLAUBNIS.SHOW.PERMISSION"
.continue END
..
!ONEDB: Show single permission of specified database command
.copy M|kgetippt = G|FALSE
.assign M|kdbkomnr = M|kdatnr
.assign M|kdbkomname = M|kdatname
.input "st/ERLAUBNIS.SHOW.PERMISSION"
.continue END
..
!ONETC: Show single permission of specified tipped command
.copy M|kgetippt = G|TRUE
.assign M|kdbkomnr = M|kkomnr
.assign M|kdbkomname = M|kkomname
.input "st/ERLAUBNIS.SHOW.PERMISSION"
..*****************************************************************************
!END
.continue
