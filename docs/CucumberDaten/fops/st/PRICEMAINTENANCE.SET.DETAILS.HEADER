.copy M|gruppenprneu = H|gruppenpr
.formula M|tzrund = H|tz
.formula M|tzrundneu = H|tz
.copy M|separat = H|separat
.copy M|separatneu = H|separat
.formula M|rundung = H|rundung
.formula M|rundungneu = H|rundung
.copy M|kettrab = H|kettrab
.copy M|kettrabneu = H|kettrab
.formula M|rfolge = H|rfolge
.formula M|rfolgeneu = H|rfolge
.formula M|nrpreis = H|nrpreis
.formula M|nrpreisneu = H|nrpreis
.formula M|nspreis = H|nspreis
.formula M|nspreisneu = H|nspreis
.formula M|rpreis = H|rpreis
.formula M|rpreisneu = H|rpreis
.formula M|spreis = H|spreis
.formula M|spreisneu = H|spreis
.copy M|heinheit = H|mhe
.copy M|heinheitneu = H|mhe
.copy M|peinheit = H|mpe
.copy M|peinheitneu = H|mpe
.copy M|mgeab = H|mgeab
.copy M|mgeabneu = H|mgeab
