.copy M|tvon = H|gltvon
.copy M|tbis = H|gltbis
.copy M|tvonneu = H|gltvon
.copy M|tbisneu = H|gltbis
.copy M|tsaktion = H|saktion
.copy M|tsaktionneu = H|saktion
