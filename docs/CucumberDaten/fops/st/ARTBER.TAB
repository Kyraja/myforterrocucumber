..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ARTBER.TAB
.. Autor          : pw
.. Verantwortlich : cl
.. Kontrolle      : amk
.. Funktion       : Erzeut Tabellenzeile in der Artikelbereichshierarchie.
.. Function       : Creates a row for product range hierarchy.
..*****************************************************************************
.set trans -
..
.make screen line +O
.formula M|tbaumstufe    = M|stufe + 1
.formula M|tbaumstat     = ""
.formula M|eltstufe      = "----------"<<(M|tbaumstufe-1) + 'M|tbaumstufe'
.copy M|isartikel   = F|empty(H|abereich)
.assign M|tabereich   = H|abereich
.assign M|tabereich   = H|artikel ? M|isartikel
.assign M|tabereich   = 2|id      ?  _F|empty(H|selekt)
.copy M|taktiv      = H|catactiv
.copy M|tkategorie  = H|kategorie
.copy M|tzabereich  = H|zabereich
.assign M|tname = M|tabereich^sucherw
.formula M|tbaumtext = M|tabereich^nummer + " " + M|tabereich^such + " " + M|tname
.formula M|tbauminfo = M|tabereich^grbez + ": " + M|tbaumtext
.continue END ? M|isartikel
..
.. Do we have a leaf or node
.load 1 add M|tabereich
.continue END ? _G|mehr
.load 1 line 'M|selectrows'
.continue END ? _G|mehr
.formula M|tbaumstat = "+"
.load 1
..*****************************************************************************
!END
.continue
