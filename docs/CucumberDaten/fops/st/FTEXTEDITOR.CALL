..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FTEXTEDITOR.CALL
.. Autor          : lei
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Aufruf fuer das Menue am Freitextbutton.
.. Functionality  : Call for the menu at button freetext.
..*****************************************************************************
.set trans -
..
.. Needs gui interface
.continue END ? _G|grafik
..
.. Needs button event
.continue END ? G|evtartengl <> "BUTTON_BEFORE" & G|evtartengl <> "BUTTON_AFTER" & G|evtartengl <> "BUTTON_KERNEL"
..
.. Needs mask buffer and a customized and modifiable freetext
.continue ERROR01 ? _F|defined(M|gruppe)
.continue END     ? _F|regmatch(G|evtvarartalias, "ARTF[0-9]*")
..
.. Handle argument
.continue ERROR02 ? _F|defined(U|iseditable)
.continue ERROR03 ? _F|isvalue('U|iseditable', "B")
..
.. Define and execute command
.type text command
.formula U|command = "<(Infosystem)>10383<(Call)>"
.formula U|command = U|command + " ? evtvar = " + G|evtvar
.formula U|command = U|command + " | ftexteditierbar = " + 'U|iseditable'
.formula U|command = U|command + " | bstart = 1"
.end 0 'U|command'
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Missed context!
.error -message Dieser Dialog ben”tigt eine Maske als Aufrufkontext!
.continue BREAK
..
!ERROR02: Missed argument!
.error -message Es fehlt die Angabe der Schreibbarkeit!
.continue BREAK
..
!ERROR03: Wrong type of argument!
.error -message Das Argument zur Schreibbarkeit hat die falsche Art!
..
!BREAK
.end 1
