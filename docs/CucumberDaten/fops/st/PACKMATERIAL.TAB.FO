..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PACKMATERIAL.TAB.FO
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : drpf
.. Functionality  : 
..*****************************************************************************
.set trans -
..
..<META M|='st/PACKMATERIAL'>
..<META H|='P2:1'>
..
.make screen line +O
..
.formula M|tpackmit  = H|id
.copy M|tpmtyp       = H|pmtyp        
.copy M|tvpkenn      = H|vpkenn       
.copy M|tfbetreuer   = H|fbetreuer    
.copy M|tgewicht     = H|gewicht      
.copy M|tpacklge     = H|packlge      
.copy M|tpackbr      = H|packbr       
.copy M|tpackhoe     = H|packhoe      
.copy M|tpackhoeklap = H|packhoeklap  
.copy M|tvol         = H|vol          
.copy M|tpacklgei    = H|packlgei     
.copy M|tpackbri     = H|packbri      
.copy M|tpackhoei    = H|packhoei     
.copy M|tfuellgrad   = H|fuellgrad    
.copy M|tvoli        = H|voli         
.copy M|tnutzlast    = H|nutzlast     
.copy M|tauflast     = H|auflast      
.copy M|tvpr         = H|vpr
.copy M|twaehr       = H|vwaehr          
.copy M|tvbezbspr    = H|vbezbspr     
.copy M|tlief        = H|lief         
.copy M|tbsart       = H|bsart        
.copy M|tepr         = H|epr  
.copy M|tewaehr      = H|ewaehr         
.copy M|tefrist      = H|efrist       
.copy M|tvorlauf     = H|vorlauf      
.copy M|tdispoa      = H|dispoa       
.copy M|tmindest     = H|mindest      
.copy M|tminbsmge    = H|minbsmge     
.copy M|tzuplatz     = H|zuplatz      
.copy M|tlzu         = H|lzu          
.copy M|tabplatz     = H|abplatz      
.copy M|tlab         = H|lab          
.copy M|tbestand     = H|bestand      
..
.. Has customer product properties
.load 1 nolock parts 'F|formatstr("$,,;@gruppe=6;art={1}", H|id)'
.copy M|tbkunbez = G|mehr
.formula M|tbukunbez = M|infoicon ? G|mehr
.load 1 
.. 
.. Has pack material accounts
.load 2 nolock containeraccount 'F|formatstr("$,,;@gruppe=1;artikel={1}", H|id)'
.copy M|tbkonto = G|mehr
.formula M|tbukonto = M|infoicon ? G|mehr
.load 2 
.. 
..*****************************************************************************
!END
.continue
