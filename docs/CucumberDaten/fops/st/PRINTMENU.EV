..!interpreter english translate noabbrev
.. *****************************************************************************
.. FOP-Name       : PRINTMENU.EV
.. Autor          : saac
.. Verantwortlich : teamreport
.. Kontrolle      : cl
.. Funktion       : Druckmenue anzeigen
.. Functionality  : show print menu
...Includes       :
.. *****************************************************************************
.set trans -
..
.type bool xisinfosys                 ? _F|defined(U|xisinfosys)
..
.assign M|pdreinst =  ""
..
.continue SETOBJSE   ? G|evtartengl="FIELD_EXIT" & G|evtvar="objektsel"
.continue SETSTAND   ? G|evtartengl="FIELD_EXIT" & G|evtvar="standort"
.continue SETKONTEXT ? G|evtartengl="FIELD_EXIT" & G|evtvar="aktkontext"
?
.continue END
..
!SETKONTEXT
.protection -reset objektsel
.copy U|xisinfosys =  M|aktkontext^dnr = 65
.copy M|objektsel = G|false   ? U|xisinfosys
.protection objektsel         ? U|xisinfosys
.continue END
..
!SETOBJSE
.assign M|standort = ""       ? M|objektsel
.continue END
..
!SETSTAND
.copy M|objektsel = G|false   ? _F|empty(M|standort)
..
.. *****************************************************************************
!END
.copy M|pdreinst = M|passwort^pdreinst
.copy M|auskonfig = G|false
.copy M|auskonfig = G|true ? _F|empty(F|sysinfo(18)^pdreinst) & F|empty(M|pdreinst)
.copy M|pdreinst = F|sysinfo(18)^pdreinst  ? F|empty(M|pdreinst)
.copy M|druckerliste = M|pdreinst^drucker
.assign M|standortdrverw = ""
.copy M|standortdrverw = M|pdreinst^drucker^standortdrverw ? M|pdreinst^drucker^gruppe = 13
.copy M|layoutliste = M|pdreinst^layoutliste
.make screen line --
.continue
