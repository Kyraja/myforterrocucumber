..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : NOTIZEN.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt Zeilen- und kleinere Feldereignisse.
.. Functionality  : Handles row and smaller field events.
..*****************************************************************************
.set trans -
..
..------------------------------- Header --------------------------------------
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ursache"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "partner"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "elem"
.continue DOCUMNT ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "evvorgang"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bearbeit"
.continue CLRTAB  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "typ"
.continue CLRTAB  ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "intern"
.continue NEWNOTE ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buneuenotiz"
..--------------------------------- Table  -------------------------------------
.continue BRMNOTE ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "tbildbulegabnotiz"
.continue BRMNOTE ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "tbildbulegabnotiz2"
.continue ARMNOTE ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbildbulegabnotiz"
.continue ARMNOTE ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbildbulegabnotiz2"
.continue VIEWNOT ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbuzeignotiz"
.continue VIEWNOT ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbildbuzeignotiz"
.continue VIEWDOC ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "tbildbuzeigdok"
..==============================================================================
.continue END
..
!DOCUMNT: Document has changed
.formula M|typa = M|evvorgang^typa
.continue CLRTAB
..
!NEWNOTE: Create a new note
.continue ERROR1 ? _F|cmdpermitted(134, 14,,1)
.formula M|auswahl = "<(Notes)><(New)>"
.formula M|auswahl = M|auswahl + "?"
.continue NEWEDIT ? F|empty(M|intern)
.formula M|auswahl = M|auswahl + "intern=1" + "|"
..
!NEWEDIT: Set editor
.continue NEWTRIG ? F|empty(M|bearbeit)
.formula M|auswahl = M|auswahl + "bearbeit=" + M|bearbeit^id + "|"
..
!NEWTRIG: Set trigger
.continue EXEC ? F|empty(M|ursache)
.formula M|auswahl = M|auswahl + "ursache=" + M|ursache^id
..
!EXEC: Execute gui command
.command -parallel 'M|auswahl'
.continue END
..
!BRMNOTE: Before button file note
.continue ERROR2 ? _F|cmdpermitted(134, 10,,1)
.formula M|auswahl = "<(Notes)>" + M|tnotiz^id  + "<(Delete)>"
.continue SUBEDIT ? G|evtvar = "tbildbulegabnotiz2"
.command -wait 'M|auswahl'
.continue END
..
!SUBEDIT: Open dialog as subeditor
.end 0 'M|auswahl'
..
!ARMNOTE: Check result
.select nowait object 'M|tnotiz^id'
.continue RMROW ? _G|mehr
.continue RMROW ? H|ablagef
.continue END
..
!RMROW: Remove table row while note is filed
.make screen line -O
.continue END
..
!VIEWNOT: View note
.type VP99 xxmyobject
.assign U|xxmyobject = M|tnotiz
.input "is/EXEC.COMMAND4REFERENCE"
.continue END
..
!VIEWDOC: View document
.type VP99 xxmyobject
.assign U|xxmyobject = M|tdokumente
.input "is/EXEC.COMMAND4REFERENCE" ? _F|empty(M|tdokumente)
.continue END
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Action not allowed
.error -line 'G|evtzeile' -field 'G|evtvar' -message Eine Notiz neu anzulegen ist dem Anwender nicht erlaubt.
.end 1
..
!ERROR2: Action not allowed
.error -line 'G|evtzeile' -field 'G|evtvar' -message Eine Notiz zu entfernen ist dem Anwender nicht erlaubt.
.end 1
