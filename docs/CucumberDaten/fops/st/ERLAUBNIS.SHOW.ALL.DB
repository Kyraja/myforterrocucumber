..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.SHOW.ALL.DB
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Zeigt alle Erlaubnisse aller DB-Kommandos.
.. Functionality  : Shows all permissions of all database commands.
..*****************************************************************************
.set trans -
..
.formula M|komindex = M|startindex
.formula M|komindex = M|komindex + 1
..
!NEXTDB
.continue END ? M|komindex >= M|anzahlnamen
.continue ITERATE ? F|regmatch((" " + M|datausnahme + " "), (".* " + 'U|xdateinr.M|komindex' + " .*"))
.assign M|kdbkomnr = U|xdateinr.M|komindex
.assign M|kdbkomname = U|xdateiname.M|komindex
.input "st/ERLAUBNIS.SHOW.PERMISSION"
..
!ITERATE
.formula M|komindex = M|komindex + 1
.continue NEXTDB
..*****************************************************************************
!END
.continue
