..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALENDHIERARCHIE.EV
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem Kalenderhierarchie: Eventbehandlung
.. Functionality  :
.. Ablauf         : Behandelt alle Feld- und Button-Events, insbes. auch
..                  das Druecken auf Auf-/Zu-Button.
..
..
.. includes       : Dateien, die hier benutzt werden
..
..  include  st/HOL.KALENDHIERARCHIE
..
..*****************************************************************************
..
.type VID99 xvid     ? _F|defined(U|xvid)
.type integer   xistufe  ? _F|defined(U|xistufe)
.type text  xtkomm   ? _F|defined(U|xtkomm)
.type ID137 xkal     ? _F|defined(U|xkal)
..
.set trans -
..  ---------------------------------------------------------------------------
..  Kopfteil
..  ---------------------------------------------------------------------------
.continue LEEREN     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kal"
.continue LEEREN     ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="bstart"
.continue KBUSTUFE   ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="kbustufe"
..  ---------------------------------------------------------------------------
..  Tabellenteil
..  ---------------------------------------------------------------------------
.continue KLAPPEN    ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="tbaumaufzu"
.continue TBUSTUFE   ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="tbustufe"
.continue WECHSEL    ? G|evtartengl="ROW_CHANGED"
.continue END
..
!KALEND: Daten fuer Kopf holen
.formula M|select  = ""
.continue END                                   ? F|empty(kal)
.. Vorbelegung der Kalenderselektion Dispokalender/ Kapazit„tsangebot
.copy M|kaldispo = G|FALSE ? M|kal^gruppe = 2
.protection kaldispo               ? M|kal^gruppe = 2
.copy M|kalkapaz = G|TRUE  ? M|kal^gruppe = 2
.copy M|kaldispo = G|TRUE  ? M|kal^gruppe = 1
.copy M|kalkapaz = G|FALSE ? M|kal^gruppe = 1
.assign U|xkal  = M|kal
.formula M|select  = 'U|xkal'
.continue END
..
!START: Startbutton
.error Bitte erst einen Kalender eintragen.    ? F|empty(M|kal)
.end 1                                         ? F|empty(M|kal)
.error Plausibilit„tsprfung                   ? F|empty(M|select)
.end 1                                         ? F|empty(M|select)
..
.copy M|bstartbut = G|TRUE
.input "st/HOL.KALENDHIERARCHIE"
.continue END
..
!KLAPPEN
.continue AUFKL ? M|tbaumstat="+"
.continue ZUKLA ? M|tbaumstat="-"
.continue END
..
!AUFKL: Stufe aufklappen
.copy M|bstartbut = G|FALSE
.formula M|stufe       = M|tbaumstufe
.formula M|tbaumstat   = "-"
.input "st/HOL.KALENDHIERARCHIE"
.continue WECHSEL
..
!ZUKLA: Stufe zuklappen
.formula U|xistufe    = M|tbaumstufe
.. Die zugeklappte Stufe kennzeichnen
.formula M|tbaumstat  = "+"
.select screen line
.continue WECHSEL ? _G|mehr
..
!ZUNEXT: Zeilen der untergeordnten Kalender l”schen
.make screen line -O  ? M|tbaumstufe > U|xistufe
.continue ZUNEXT         ? M|tbaumstufe > U|xistufe
.continue WECHSEL
..
!KBUSTUFE: Kopfobjekt anzeigen
.assign U|xvid = M|kkal
.continue DOBUSTUFE
..
!TBUSTUFE: Zeilenobjekt anzeigen
.assign U|xvid = M|tkal
..
!DOBUSTUFE
.continue END ? F|empty(U|xvid)
.command -parallel 'U|xvid'
.continue END
..
!WECHSEL
.select screen line 'G|evtzeile'  ? G|evtzeile <> M|aktzeile
.copy M|kbaumstufe  = M|tbaumstufe
.copy M|kkal        = M|tkal
.copy M|kname       = M|tname
.copy M|kbezobj     = M|tbezobj
.copy M|klgruppe    = M|tlgruppe
.copy M|kuebkal     = M|tuebkal
.copy M|kgltvon     = M|tgltvon
.copy M|kgltbis     = M|tgltbis
.continue END
..
!LEEREN
.formula M|kbaumstufe      = ""
.formula M|kkal            = ""
.formula M|kname           = ""
.formula M|kbezobj         = ""
.formula M|klgruppe        = ""
.formula M|kuebkal         = ""
.formula M|kgltvon         = ""
.formula M|kgltbis         = ""
.protection -reset kaldispo        ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kal"
.copy M|kaldispo = G|TRUE  ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kal"
.copy M|kalkapaz = G|TRUE  ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kal"
..
.input "is/TABLEEREN"
.continue KALEND   ? G|evtartengl="FIELD_EXIT"    & G|evtvar="kal"
.continue START    ? G|evtartengl="BUTTON_AFTER" & G|evtvar="bstart"
.continue END
..
!END
.continue
