..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APVERWEND.OPEN.KNOT
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Klappt einen Knoten auf.
.. Functionality  : Opens a knot.
..*****************************************************************************
.set trans -
..
.. Declarations
.type ID87 xcallparam ? _F|defined(U|xcallparam)
..
.continue OPEN ? _F|empty(U|xcallparam)
.continue END  ? _F|defined(M|taufruf)
.continue END  ?  F|empty(M|taufruf)
.assign M|stufe = M|tbaumstufe
.copy U|xcallparam = M|tkopf
..
!OPEN
.select dataexport 'F|formatstr("$,,;@gruppe=12;kopf<>`;aufruf=={1};@ablageart=(Active)", U|xcallparam)'
..
!CHCKROW
.continue END ? _G|mehr
.input 'M|tab' ? _F|empty(M|tab)
.select dataexport continue
.continue CHCKROW
..*****************************************************************************
!END
.continue
