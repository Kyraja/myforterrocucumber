..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ABVERWEND.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Beschafft Daten des initialen Verwendungsnachweises.
.. Functionality  : Gets data for the initial where-used list.
..*****************************************************************************
.set trans -
..
.continue END ? F|empty(M|select)
..
.. Initializations
.formula M|stufe = 0
.formula M|noderow = 0
..
.. Open root node
.select group 'M|grliste' 'M|select'
.continue END ? _G|mehr
.continue TABLE
 ..
!CHECK
.continue HEAD ? _G|mehr
!TABLE
.continue END ? M|stufe >= M|anzstufen
.input 'M|tab' ? _F|empty(M|tab)
.select continue
.continue CHECK
..
!HEAD: Start resolving root level
.continue END ? F|empty(M|tzeilen)
.select screen header
..
!NEXT: Load next mask row
.select screen line
.continue END  ? _G|mehr
.continue NEXT ? M|tbaumstat <> "+"
.continue NEXT ? M|tbaumstufe >= M|anzstufen
.assign M|tbaumstat = "-"
.assign M|noderow = M|aktzeile
.input 'M|openknot' ? _F|empty(M|openknot)
.select screen line 'M|noderow'
.continue FATAL ? _G|mehr
.continue NEXT
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
