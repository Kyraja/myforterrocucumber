..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KDINFO.MAIL.URL.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Definiert Auswahl moeglicher Kontaktziele des Kunden/Lieferanten
..                  und oeffnet nach Auswahl durch Bediener entspechend Browser/Mailer.
.. Ablauf         : Button-nach-FOP
..
.. Functionality  : Defines a dialog with possible contacts. If the user has made
..                  his choice the browser or mail client will opened with this
..                  contact.
.. Program flow   : After button efop
..*****************************************************************************
.set trans -
.continue ERROR1 ? _F|diraccessible("email")
..
.. Declarations
.type text xtdirekt
.type text xtkunde
.type text xthaendl
.type text xtvertret
.type text xtbetreuer
.type text xtsabetreuer
.type text xtmeld
.type text xmail
.type text xurl
.type text xtmenutxt
..
.. Initialize
.assign M|auswahl = ""
.assign U|xtdirekt = ""
.assign U|xtkunde = ""
.assign U|xtsabetreuer = ""
.assign U|xthaendl = ""
.assign U|xtvertret = ""
.assign U|xtbetreuer = ""
.assign U|xmail = ""
.assign U|xurl = ""
.set trans +
.assign U|xtmeld = "Kein Kontakt vorhanden!"
.assign U|xtmenutxt = "Kontaktwahl"
..
.. Get all possible contacts
.continue WWW ? G|evtvar = "kbuwww"
.. email
.assign U|xtdirekt = "Direkt" ? _F|empty(M|knumkusa^email)
.assign U|xtkunde = "Firma" ? _F|empty(M|knumsaku^email)
.assign U|xtsabetreuer = "Firmenbetreuer" ? _F|empty(M|kbetreuer2^email)
.assign U|xtbetreuer = "Betreuer" ? _F|empty(M|kbetreuer^email)
.continue MEN ? F|defined(M|kblfinfo)
.assign U|xthaendl = "Rechnungsempf„nger" ? _F|empty(M|khaendl^email)
.assign U|xtvertret = "Vertreter" ? _F|empty(M|kvertret^email)
.continue MEN
..
!WWW
.assign U|xtdirekt = "Direkt" ? _F|empty(M|knumkusa^urlt)
.assign U|xtkunde = "Firma" ? _F|empty(M|knumsaku^urlt)
.assign U|xtsabetreuer = "Firmenbetreuer" ? _F|empty(M|kbetreuer2^urlt)
.assign U|xtbetreuer = "Betreuer" ? _F|empty(M|kbetreuer^urlt)
.continue MEN ? F|defined(M|kblfinfo)
.assign U|xthaendl = "Rechnungsempf„nger" ? _F|empty(M|khaendl^urlt)
.assign U|xtvertret = "Vertreter" ? _F|empty(M|kvertret^urlt)
.set trans -
..
!MEN: Build menu
.menu 'U|xtmenutxt'
?'U|xtmeld' ? F|empty(U|xtdirekt) & F|empty(U|xtkunde) & F|empty(U|xthaendl) & F|empty(U|xtvertret) & F|empty(U|xtbetreuer)
?'U|xtdirekt' >> .assign M|auswahl = U|xtdirekt ? _F|empty(U|xtdirekt)
?'U|xtkunde' >> .assign M|auswahl = U|xtkunde ? _F|empty(U|xtkunde)
?'U|xtsabetreuer' >> .assign M|auswahl = U|xtsabetreuer ? _F|empty(U|xtsabetreuer)
?'U|xtbetreuer' >> .assign M|auswahl = U|xtbetreuer ? _F|empty(U|xtbetreuer)
?'U|xthaendl' >> .assign M|auswahl = U|xthaendl ? _F|empty(U|xthaendl)
?'U|xtvertret' >> .assign M|auswahl = U|xtvertret ? _F|empty(U|xtvertret)
.end 0 ? G|menue = 0 ; F|empty(M|auswahl)
..
.continue MAILEN ? G|evtvar = "kbumail"
.. Set contact address
.assign U|xurl = M|knumkusa^urlt ? M|auswahl = U|xtdirekt
.assign U|xurl = M|knumsaku^urlt ? M|auswahl = U|xtkunde
.assign U|xurl = M|kbetreuer2^urlt ? M|auswahl = U|xtsabetreuer
.assign U|xurl = M|kbetreuer^urlt ? M|auswahl = U|xtbetreuer
.assign U|xurl = M|khaendl^urlt ? M|auswahl = U|xthaendl
.assign U|xurl = M|kvertret^urlt ? M|auswahl = U|xtvertret
.input "BROWSER.URL"
.continue END
..
!MAILEN
.assign U|xmail = M|knumkusa^email ? M|auswahl = U|xtdirekt
.assign U|xmail = M|knumsaku^email ? M|auswahl = U|xtkunde
.assign U|xmail = M|kbetreuer2^email ? M|auswahl = U|xtsabetreuer
.assign U|xmail = M|kbetreuer^email ? M|auswahl = U|xtbetreuer
.assign U|xmail = M|khaendl^email ? M|auswahl = U|xthaendl
.assign U|xmail = M|kvertret^email ? M|auswahl = U|xtvertret
.input "SENDTO"
..******************************************************************************
!END
.continue
..******************************************************************************
..
!ERROR1: Function not allowed!
.error -message Die Kontaktaufnahme durch diesen Button ist nicht erlaubt!
.end 1
