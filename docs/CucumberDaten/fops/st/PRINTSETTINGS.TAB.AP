..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRINTSETTING.TAB.AP
.. Author         : kop
.. Verantwortlich : teamreport
.. Kontrolle      :
.. Functionality  :
.. Sets all fields defined in layout list and printer list call parameters
.. we have two times the loop first for layout call parameter and
.. afterwards for printer call parameters 
.. caution: duplicate fields are overwritten by printer call parameter values
..*****************************************************************************
.set trans -
.type text xselstring    ? _F|defined(U|xselstring)
.type ID87:9 xlastparam  ? _F|defined(U|xlastparam)
.type bool xcondition    ? _F|defined(U|xcondition)
..
.continue PRCALLPARAM ? F|empty(M|tdraufruf)
.copy U|xlastparam = M|tdraufruf
..
!SELECTION
.copy U|xcondition = G|false
.formula U|xselstring = "$,,id==" + U|xlastparam
.select group "87:9" 'U|xselstring'
.continue PRCALLPARAM ? _G|mehr
..check condition
.continue APZLOOP ? F|empty(H|aufrbed)
.formula U|xcondition = F|eval('H|aufrbed')  ? F|equals(H|aufrbedtyp, "(Formula)")
.formula U|xcondition = 'H|aufrbed'          ? F|equals(H|aufrbedtyp, "(Constant)")
.formula U|xcondition = 'A|.H|aufrbed'       ? F|equals(H|aufrbedtyp, "(HeaderField)")
.formula U|xcondition = 'P|.H|aufrbed'       ? F|equals(H|aufrbedtyp, "(PrintParameter)")
.continue PRCALLPARAM                        ? _U|xcondition
..
!APZLOOP
.select line
.continue PRCALLPARAM ? _G|mehr
.formula M|.H|zielvar = 'A|.H|aufrwert'      ? F|equals(H|aufrwtyp, "(HeaderField)") & F|modifiable(M|.H|zielvar)
.formula M|.H|zielvar = F|eval('H|aufrwert') ? F|equals(H|aufrwtyp, "(Formula)") & F|modifiable(M|.H|zielvar)
.formula M|.H|zielvar = 'H|aufrwert'         ? F|equals(H|aufrwtyp, "(Constant)") & F|modifiable(M|.H|zielvar)
.formula M|.H|zielvar = 'P|.H|aufrwert'      ? F|equals(H|aufrwtyp, "(PrintParameter)") & F|modifiable(M|.H|zielvar)
.continue APZLOOP
..
!PRCALLPARAM
.continue END                           ? F|empty(M|tpraufruf)
.continue END                           ? U|xlastparam = M|tpraufruf^id
.copy U|xlastparam = M|tpraufruf
.continue SELECTION
..*****************************************************************************
!END
.continue
