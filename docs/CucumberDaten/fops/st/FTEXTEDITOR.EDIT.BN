..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FTEXTEDITOR.EDIT.BN
.. Autor          : lei
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Auswahl und Aufruf des Editors.
.. Functionality  : Select and call the editor.
...Includes
.. include st/FTEXTEDITOR.CONVERT2HTML
.. include st/FTEXTEDITOR.EDIT.HTML
..*****************************************************************************
.set trans -
..
.continue ERROR01 ? F|empty(M|freitextdv)
.continue SUBDIA  ? M|subdialog
.continue TMPFT
..
!SUBDIA
.continue ERROR01 ?  F|empty(M|evtvar)
.continue ERROR02 ? _F|defined(A|.M|evtvar)
..
!TMPFT: Get a temporary freetext as a copy of the standard template
.type text origftext copyftext
..
.assign U|origftext = "M|freitextdv"
.assign U|copyftext = "M|freitextedit"
.input "is/COPY.FREETEXT"
..
.. Which type do we have?
.continue HTMLTXT ? M|formathtml
.continue STNDARD
..
!STNDARD: Do default edit action
.continue CNVHTML ? M|konvert ; M|konvertedit
.continue MODIFY ? M|ftexteditierbar
.. Start editor readonly
.editing -readonly 'M|freitextedit'
.continue END
..
!MODIFY: Start editor editable
.editing 'M|freitextedit'
.assign M|freitextedit = "" ? F|filesize('M|freitextedit') = 0
.continue END ? _M|subdialog
..
!PARENT: Write file path into parent freetext
.formula A|.M|evtvar = 'M|freitextedit'
.continue END
..
!CNVHTML
.type DVMI2 xsrcfile
.assign U|xsrcfile = M|freitextedit
.input "st/FTEXTEDITOR.CONVERT2HTML"
.continue HTMLTXT ? M|konvertedit
.continue PARENT ? M|subdialog
.continue END
..
!HTMLTXT
.continue HTMLNEW ? F|isflagset(464)
.input "st/FTEXTEDITOR.EDIT.HTML"
.continue END ? _M|ftexteditierbar
.continue PARENT ? M|subdialog & U|xdiffer
.continue END
..
!HTMLNEW
.input "st/FTEXTEDITOR.EDIT.BROWSER"
.continue END ? _M|ftexteditierbar
.continue PARENT ? M|subdialog
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Field empty!
.error -message Mu·-Feld nicht ausgefÅllt!
.continue BREAK
..
!ERROR02: Field not found!
.error -line 0 -field M|evtvar -message Feld nicht gefunden!
..
!BREAK
.end 1

