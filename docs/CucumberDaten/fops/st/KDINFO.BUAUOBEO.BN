..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KDINFO.BUAUOBEO.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Zeigt das Auftrags- bzw. Bestellobligo des Gesch„ftspartners
.. Ablauf         : Button-nach-EFOP
..
.. Functionality  : Shows outstanding orders or commitments of the business partner
.. Program flow   : After button efop
..*****************************************************************************
.set trans -
..
.continue ERROR1 ? F|empty(M|knumkusa)
.continue END ? G|evtvar <> "buauo1" & G|evtvar <> "bubeo1" & G|evtvar <> "buauo2" & G|evtvar <> "bubeo2"
.continue ERROR2 ? M|knumkusa^gruppe <> 1 & M|knumkusa^gruppe <> 2
..
.. Declarations
.type text xtcmd xtparam xinfosys xmaskid xcustsupp
..
.continue STAFFER ? M|istsachkd
..
.. Business partner is not a staffer
.assign U|xcustsupp = M|knumkusa^id
.continue INFOSYS
..
!STAFFER: Business partner is a staffer
.assign U|xcustsupp = M|knumsaku^id
..
!INFOSYS: customer or supplier?
.continue LFINFO ? F|defined(M|kblfinfo)
..
.. Infosystem is customer info centre
.assign U|xinfosys = "AUO"
.continue COMMAND
..
!LFINFO: Infosystem is vendor info centre
.assign U|xinfosys = "BEO"
..
!COMMAND
.formula U|xtcmd = "(Infosystem) " + U|xinfosys
.formula U|xtparam = U|xtparam + "kkuli2=" + U|xcustsupp
.formula U|xtparam = U|xtparam + "|auswaehr=" + 'M|auswaehr^id'
.formula U|xtparam = U|xtparam + "|bstart=1"
.command -window 'M|maskidobligo' -new "'U|xtcmd'" -id U|xmaskid 'U|xtparam'
.assign M|maskidobligo = U|xmaskid
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1: Business partner missing!
.error -line 0 -field M|knumkusa -message Es fehlt die Angabe eines Gesch„ftspartners!
.end 1
..
!ERROR2: No volume of orders exists!
.error -message Das offene Auftragsvolumen des Interessenten ist null!
.end 1
