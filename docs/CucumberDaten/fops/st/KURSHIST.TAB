.make screen line +O
.assign M|tkurs = H|id
.formula M|tkursdat = H|kursdat
.formula M|tfaktieinh = H|faktieinh
.formula M|tfkurs = H|fkurs
.formula M|tfaktfeinh = H|faktfeinh
