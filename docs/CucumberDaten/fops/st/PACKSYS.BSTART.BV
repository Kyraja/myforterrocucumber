..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name      : PACKSYS.BSTART.BV
.. Autor         : fwester
.. Verantwortlich: cl
.. Kontrolle     : lei
.. Funktion      : Validiert die Eingabefelder und formuliert die DB-Anfrage.
.. Ablauf        : Button-vor-EFOP
..
.. Functionality : Validates input parameters and forms database query.
.. Program flow  : Before button efop
..*****************************************************************************
.set trans -
..
.. validations
.continue ERROR1  ? F|empty(M|kpaket)
..
.. clear table
.make screen line -- ? M|tzeilen > 0
..
.formula M|stufe = 0
.copy M|rueckwaerts = F|equals(M|krichtung, "(Backwards)")
..
.. form database query
.continue BACKWRD ? M|rueckwaerts
..
.. direction is forward
.formula M|select = ";num87==" + 'M|kpaket^nummer'
.formula M|postselect = ";verwpaket^arb==" + 'M|karb'
.continue QUERY
..
!BACKWRD: direction is backward
.formula M|select = ";verwpaket==" + 'M|kpaket^nummer'
.formula M|postselect = ";arb==" + 'M|karb'
..
!QUERY: add parts of query
.formula M|postselect = M|postselect + ";einschl==" + 'G|TRUE' ? M|keinschl
.formula M|postselect = M|postselect + ";@ablageart=(Active)"
.formula M|postselect = M|postselect + ";@zeilen=" + 'G|TRUE'
.formula M|postselect = M|postselect + ";@gruppe=10"
.formula M|select = M|praeselect + M|select + M|postselect
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR1
.error -message Zum Aufklappen der Stufe fehlt die Angabe eines Paketes!
.cursor kpaket 0 ? M|tzeilen = 0
.end 1
