..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ADDRESSMONITOR.TAB
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      :
.. Functionality  :
..*****************************************************************************
.set trans -
.type text xselect     ? _F|defined(U|xselect)
.type text xgrliste    ? _F|defined(U|xgrliste)
..
.formula U|xgrliste = "113"
..
.continue UNGEPRUEFT ? M|ungeprueft
..
!GEPRUEFT: alle oder je nach Status
.continue MAKELINE  ? F|empty(M|slpstatus) 
.continue UDEFINED2 ? F|defined(1|slpstatus2)
.continue END       ? (M|slpstatus <> F|value(1|slpstatus, "AZLI20142"))
.continue MAKELINE
..
!UDEFINED2
.continue END       ? (M|slpstatus  <> F|value(1|slpstatus, "AZLI20142")) & (M|slpstatus  <> F|value(1|slpstatus2, "AZLI20142")) 
.continue MAKELINE
..
!UNGEPRUEFT: zeigt nur ungeprÅfte = leeren Status an
.continue DEFINED2 ?  F|defined(1|slpstatus2)
.continue END      ? _F|empty(1|slpstatus) 
.continue MAKELINE
..
!DEFINED2
.continue END ?  _F|empty(1|slpstatus) ; _F|empty(1|slpstatus2)
.continue MAKELINE
..
!MAKELINE
.make screen line +O
.formula M|tgrbez = 1|grbez
.assign M|tidentnr = 1|id
.formula M|tdnr = '1|dnr'
.formula M|tgruppe = '1|gruppe'
.formula M|adresse  = 1|adresse
.formula M|adresse2 = 1|adresse2
.formula M|tadresse = 1|hashadr    ? F|defined(1|hashadr)
.formula M|tadresse2 = 1|hashadr2  ? F|defined(1|hashadr2)
..
!SEL1
.continue DELETE  ? _F|defined(1|hashadr) & _F|empty(M|geprueft)
.continue END     ? _F|defined(1|hashadr) & F|empty(M|geprueft)
.continue SEL2 ? F|empty(1|hashadr)
.formula U|xselect = "$,,nummer="+'1|hashadr'
.load 2 group 'U|xgrliste' 'U|xselect'
.continue SEL2 ? _G|mehr
.assign M|adrobj = 2|id
.copy M|tslpdatum = 2|slpdatum
.formula M|tslpstatus = '2|slpstatus'
.assign M|status = F|value(2|slpstatus, "AZI20142")
..
!SEL2
.continue UCHECKDEL  ? _F|defined(1|hashadr2)
.continue END        ? F|empty(1|hashadr2)
.formula U|xselect = "$,,nummer="+'1|hashadr2'
.load 2 group 'U|xgrliste' 'U|xselect'
.continue CHECKDEL  ? _G|mehr
.assign M|adrobj2 = 2|id
.copy M|tslpdatum2 = 2|slpdatum
.formula M|tslpstatus2 = '2|slpstatus'
.assign M|status2 = F|value(2|slpstatus, "AZI20142")
.load 2
.continue CHECKDEL
..
!UCHECKDEL
.continue DELETE ? _F|empty(M|geprueft) &  F|empty(M|tslpdatum)
.continue DELETE ? _F|empty(M|geprueft) & _F|empty(M|tslpdatum) & ('M|geprÅft:8' > 'M|tslpdatum:8') 
.continue END
..
!CHECKDEL
.continue DELETE ? _F|empty(M|geprueft) &  F|empty(M|tslpdatum) &  F|empty(M|tslpdatum2)
.continue DELETE ? _F|empty(M|geprueft) & _F|empty(M|tslpdatum) & _F|empty(M|tslpdatum2) & ('M|geprÅft:8' > 'M|tslpdatum:8') & ('M|geprÅft:8' > 'M|tslpdatum2:8')
.continue DELETE ? _F|empty(M|geprueft) & _F|empty(M|tslpdatum) & F|empty(M|tslpdatum2) & ('M|geprÅft:8' > 'M|tslpdatum:8')
.continue DELETE ? _F|empty(M|geprueft) & F|empty(M|tslpdatum) & _F|empty(M|tslpdatum2) & ('M|geprÅft:8' > 'M|tslpdatum2:8')
.continue END
..
!DELETE: Zeile lîschen, da Datumsselketion nicht erfÅllt
.make screen line -O  
.continue END
..
..*****************************************************************************
!END
.continue
