..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AUFRUFPARAMETER.OPEN.NODE
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Oeffnet ein Submenue.
.. Functionality  : Opens sub menu.
..*****************************************************************************
.set trans -
..
.. Declarations
.type VP13    U|xsource
.type text    U|xxlbuffer
.type ID87:11 U|xxsubmenu
..
.. Initialize
.assign U|xxlbuffer = "0"
.copy U|xsource = M|aufrktxt
.assign U|xxsubmenu = M|taufrufparameter^id
.continue END ? F|empty(U|xxsubmenu)
..
.. While changing buffers save test mode into local variable
.type bool xxtestmode
.copy U|xxtestmode = M|testmode
..
.set ascreen + ? _U|xxtestmode
.input "is/FOP.BUINFOSYS.INIT"
.set ascreen - ? _U|xxtestmode
..
.assign M|stufe = M|tbaumstufe
..
.. Load skip group because of the skip items
.select group "87:30" 'F|formatstr("$,,@ablageart=(Active);aufrktxt=={1};kontexttyp=={2};buttonfeld=={3};aufrtab=={4}", M|aufrktxt^id, M|kontexttyp, M|buttonfeld, M|aufrtab)'
.continue END ? _G|mehr
.formula M|stufe = M|stufe + 1
..
.. Select only active rows of needed level
.select line 'F|formatstr("$,,;aktiv={1};tbaumstufe<={2}", F|condexpr(M|aktiv, G|TRUE, ""), M|anzstufen)'
..
!CHCKROW
.continue END ? _G|mehr
.continue NEXTROW ? H|id^kopf^id <> U|xxsubmenu
.assign M|zeilentyp = H|zeilentyp
.continue ENTRY ? F|equals(M|zeilentyp, "(MenuItem)")
..
!TABROW: Create a row
.input 'M|tab' ? _F|empty(M|tab)
.continue NEXTROW
..
!ENTRY: Load callparameter in buffer 0
.load 0 object 'H|aufruf^id'
.continue NEXTROW ? _G|mehr
.continue TABROW
..
!NEXTROW
.select line
.continue CHCKROW
..*****************************************************************************
!END
.continue
