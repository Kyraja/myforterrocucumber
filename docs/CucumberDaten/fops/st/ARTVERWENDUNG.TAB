..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTVERWENDUNG.TAB
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Erzeugt zu jeder Verwendung eine Zeile.
.. Functionality  : Creates a row for each use.
..*****************************************************************************
.set trans -
..
.make screen line +O
..
.. General header data
.copy M|tzn = H|zn
.assign M|tfundort = H|id
.assign M|tdnr = H|dnr
.assign M|tgruppe = H|gruppe
.assign M|tfundortzeigen = M|iconzeigen ? F|cmdpermitted(M|tdnr, 12, , M|tgruppe)
..
.load 1 metadata "H|"
.continue SPECIAL ? _G|mehr
.assign M|tsucherw = 1|vgrtxt
.load 1
..
!SPECIAL: Special outputs
.continue SELBAR  ? M|indexselect = 1
.continue FLDNAME ? M|indexselect = 2
.continue KEYTAB  ? M|indexselect = 3
.continue FLDNAME ? M|indexselect = 4
.continue FATAL
..
!KEYTAB
.formula M|tvname = H|bvname
.formula M|tvitf = H|bvita
.formula M|tfoname = M|tvname
.continue END
..
!FLDNAME
.copy M|tvname = H|vname
.copy M|tvitf = H|vitefff
.continue FONAME
..
!SELBAR: Selection bar
.formula M|tvname = H|vname
.formula M|tvname = H|merkmalname ? F|empty(M|tvname)
.copy M|tvitf = H|merkmalart
.formula M|tfoname = M|tvname
.continue END
..
!FONAME
.formula M|tpraefix = F|substr(M|tvname, , 2)
.formula M|tfoname =  F|substr(M|tvname, 3)
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
