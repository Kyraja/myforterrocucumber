..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : CALLPARAM.GET.ROW
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : xg
.. Functionality  : Gets from buffer 0 the row for the target item.
..*****************************************************************************
.set trans -
..
.continue END ? _F|defined(0|zielwerttyp)
.continue END ? F|empty(0|zielwerttyp)
..
.. Initializations
.copy U|xtargetrow = U|XHEADER
.copy U|xfatal = 0
.copy U|xerror = 0
..
.. Analyze enummeration 224
.continue LASTROW ? F|equals(0|zielwerttyp, "(LastLine)")
.continue CURRROW ? F|equals(0|zielwerttyp, "(CurrentLine)")
.continue NUMROW  ? F|equals(0|zielwerttyp, "(LineNumber)")
.continue IDOFSRC ? F|equals(0|zielwerttyp, "(SourceID)")
.continue IDOFROW ? F|equals(0|zielwerttyp, "(RowIDOfSource)")
.copy U|xfatal = 1
.continue END
..
!LASTROW: Target is last row. Empty, if we have a row insert and no target item otherwise hash.
.copy U|xtargetrow = ""
.continue END ? F|equals(0|zielaktion, "(InsertRow)") & F|empty(0|zielvar)
.copy U|xtargetrow = U|XHASH
.continue END
..
!CURRROW: Target is current row
.copy U|xtargetrow = U|XPOINT
.continue END
..
!NUMROW: Target is a number of row
.copy U|xtargetrow = 0|zielzeile
.continue END
..
!IDOFSRC: Target is ID of the source data object
.copy U|xtargetrow = 'M|id'
.copy U|xtargetrow = 'M|isref^id' ? 0|aufrinfosys
.continue END
..
!IDOFROW: Target is id of row in source data object
.continue ERROR2 ? _F|defined(M|zid)
.copy U|xtargetrow = 'M|zid'
..*****************************************************************************
!END
.continue
..*****************************************************************************
!ERROR1
.copy U|xerror = 1
.continue END
..
!ERROR2
.copy U|xerror = 2
.continue END
