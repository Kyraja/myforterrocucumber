..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : AENDH.FUELLT
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : FÅllt Freitext nach BefÅllen der Tabellenfelder
.. Functionality  :
..
..*****************************************************************************
.set trans -
.type text    xftextt2  ? _F|defined(U|xftextt2)
.type integer xlength   ? _F|defined(U|xlength)
.type text    xttext    ? _F|defined(U|xttext)
.type text    xtmerk    ? _F|defined(U|xtmerk)
.type text    xtmerk2   ? _F|defined(U|xtmerk2)
..
.file -tempname U|xftextt2
.output new 'U|xftextt2'
..
.continue FSCHNITT ? F|empty(M|ausloesertabelle)
.formula U|xlength = F|length(M|ausloesertabelle)
.. fÅhrendes "," wegschneiden
.formula M|ausloesertabelle = F|substr(M|ausloesertabelle, 2, U|xlength)  ?  F|regmatch(M|ausloesertabelle, ",.*")
.. endendes "," wegschneiden
.formula U|xlength = U|xlength - 1
.formula M|ausloesertabelle = M|ausloesertabelle << U|xlength ?  F|regmatch(M|ausloesertabelle, ".*,")
.formula U|xttext = M|ausloesertabelle 
.formula U|xtmerk = M|ausloesertabelle
.continue ADDETO ? _F|regmatch(M|ausloesertabelle, ".*,.*")
..
!KSCHNITT: Wenn Komma vorhanden, dann schneiden
.formula U|xtmerk = U|xttext <<","
.formula U|xttext = U|xttext >>","
.formula U|xlength = F|length(U|xttext)
.formula U|xttext = F|substr(U|xttext, 2, U|xlength)  ?  F|regmatch(U|xttext, ",.*")
.continue ADDETO ? _F|empty(U|xtmerk)
.formula U|xttext = M|feldertabelle
.formula U|xtmerk2 = M|feldertabelle
.continue ADDETO2 ? _F|regmatch(M|feldertabelle, ".*,.*")
.continue FSCHNITT
..
!ADDETO
.output addedto 'U|xftextt2'
.input "DATEI.F"
'U|xtmerk'
.output
.continue KSCHNITT ? _F|empty(U|xttext)
.continue FERTIG   ?  F|empty(M|feldertabelle)
.continue FSCHNITT ? _F|regmatch(M|feldertabelle, ".*,.*")
.continue KSCHNITT
..
!FSCHNITT
.formula U|xlength = F|length(M|feldertabelle)
.. fÅhrendes "," wegschneiden
.formula M|feldertabelle = F|substr(M|feldertabelle, 2, U|xlength)  ?  F|regmatch(M|feldertabelle, ",.*")
.. endendes "," wegschneiden
.formula U|xlength = U|xlength - 1
.formula M|feldertabelle = M|feldertabelle << U|xlength ?  F|regmatch(M|feldertabelle, ".*,")
.formula U|xttext = M|feldertabelle
.formula U|xtmerk2 = M|feldertabelle
..
!TABSCHNITT
.formula U|xtmerk2 = U|xttext <<","
.formula U|xttext = U|xttext >>","
.formula U|xlength = F|length(U|xttext)
.formula U|xttext = F|substr(U|xttext, 2, U|xlength)  ?  F|regmatch(U|xttext, ",.*")
.continue ADDETO2 ? _F|empty(U|xtmerk2)
.continue FERTIG  ? F|empty(U|xtmerk2)
..
!ADDETO2
.output addedto 'U|xftextt2'
.input "DATEI.F"
'U|xtmerk2'
.output
.continue FERTIG  ? _F|regmatch(M|feldertabelle, ".*,.*")
.continue TABSCHNITT
..
!FERTIG
.formula M|ausloeser2tabelle = U|xftextt2
..
!END
.continue

