..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ARTIKELAKTE.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : carue
.. Funktion       : Datensammler fuer Business-App "Artikelakte"
.. Functionality  : Data miner for Buisiness App "Product File"
..*****************************************************************************
.set trans -
..
.. Calculate quantities in stock units for each item
.. Note: no H|lehe for work orders (production)
.. Calculate "base" (mge) and "outstanding" (limge) quantitites
.formula U|xmge = 0.0
.formula U|xmge = ( H|mge * H|lehe )     ?  F|defined(H|lehe)
.formula U|xmge = ( H|mge )              ? _F|defined(H|lehe)
.formula U|xlimge = 0.0
.formula U|xlimge = ( H|limge * H|lehe ) ?  F|defined(H|lehe)
.formula U|xlimge = ( H|limge )          ? _F|defined(H|lehe)
..
..
..  Query evaluation
.. ----------- ---------- ---------- -------------------------------------------
.continue SUM     ?  M|kbversand
.continue SUM     ?  M|kbbeschaffung
.. ----------- ---------- ---------- -------------------------------------------
.continue OFFAU   ?  M|kboffeneauftraege
.continue OFFLI   ?  M|kbungebuchtels
.continue BUCLI   ?  M|kbgeliefert
.. ----------- ---------- ---------- -------------------------------------------
.continue BESTA   ?  M|kbbestand
.continue FERTI   ?  M|kbfertigung
.continue BESTE   ?  M|kbbestellungen
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
..
!OFFAU
.make screen line +O
.formula M|tkunde = H|kopf^kunde^id
.formula M|twerk = H|kopf^werk
.formula M|tablstelle = H|kopf^ablstelle
.formula M|tvorgang = H|kopf^id
.formula M|tversand = H|planung^id
.formula M|tmenge = U|xlimge
.formula M|ttermin = H|tterm
.formula M|tsped = H|kopf^sped^id
.formula M|tzudrucken = H|kopf^sped^druck
.copy M|tlagereinheit = M|klagereinheit
.continue END
..
!OFFLI
.make screen line +O
.formula M|tkunde = H|kopf^kunde^id
.formula M|twerk = H|kopf^werk
.formula M|tablstelle = H|kopf^ablstelle
.formula M|tvorgang = H|kopf^id
.formula M|tversand = H|planung^id
.formula M|tmenge = U|xmge
.formula M|ttermin = H|tterm
.formula M|tsped = H|kopf^sped^id
.formula M|tzudrucken = H|kopf^sped^druck
.copy M|tlagereinheit = M|klagereinheit
.continue END
..
!BUCLI
.make screen line +O
.formula M|tkunde = H|kopf^kunde^id
.formula M|twerk = H|kopf^werk
.formula M|tablstelle = H|kopf^ablstelle
.formula M|tvorgang = H|kopf^id
.formula M|tversand = H|planung^id
.formula M|tmenge = U|xmge
.formula M|ttermin = H|tterm
.formula M|tsped = H|kopf^sped^id
.formula M|tzudrucken = H|kopf^sped^druck
.copy M|tlagereinheit = M|klagereinheit
.continue END
..
!BESTA
!FERTI
!BESTE
.. not supported
.continue END
..
!SUM
.formula U|xanzahl = U|xanzahl + 1
.formula U|xsummge = U|xsummge + U|xmge
.formula U|xsumlimge = U|xsumlimge + U|xlimge
.continue END
..
..*****************************************************************************
!END
.continue
