..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : FTEXTEDITOR.SET.LANGUAGE
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Functionality  : Sets output language.
.. Initially sets it to language of printing. If we do have a parent buffer
.. this will be possibly overwritten using data in buffer A. If item spr is
.. defined and not empty its value will be used. Otherwise in this order if
.. these items are defined and not empty:
.. 1. ykspr  - user-defined language
.. 2. kspr   - standard-defined language
.. 3. kl^spr - standard-defined language of business partner.
..*****************************************************************************
.set trans -
..
.copy M|spra = P|spra
.continue ABUFFER ? F|defined(A|dnr)
.continue SETLANG
..
!ABUFFER: We have a buffer A
.continue LANGOFC ? _F|defined(A|spr)
.. Especially text modules
.continue LANGOFC ? F|empty(A|spr)
.assign M|spra = A|spr
.continue SETLANG
..
!LANGOFC: Language of correspondence
.continue OWNLANG ? _F|defined(A|kspr)
.assign M|spra = A|kspr ? _F|empty(A|kspr)
..
!OWNLANG: User-defined language of correspondence
.continue SETLANG ? _F|defined(A|ykspr)
.assign M|spra = A|ykspr ? _F|empty(A|ykspr)
..
!SETLANG: Set index of language of correspondence
.copy P|spra = M|spra
.copy M|ksi = P|ksi
..*****************************************************************************
!END
.continue
