..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALENDVERWEND.TAB
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Infosystem Betriebskalenderverwendung: Eventbehandlung
.. Functionality  :
.. Ablauf         : Behandelt alle Feld- und Button-Events
..
..*****************************************************************************
.set trans -
.type VID26 xvid     ? _F|defined(U|xvid)
.type VID26 xvid2    ? _F|defined(U|xvid2)
.type VID26 xbezobj  ? _F|defined(U|xbezobj)
.type ID137 xkid     ? _F|defined(U|xkid)
.type ID137 xkal2    ? _F|defined(U|xkal2)
.type ID137 xtukal   ? _F|defined(U|xtukal)
.type GD    xdanf    ? _F|defined(U|xdanf)
.type GD    xdend    ? _F|defined(U|xdend)
.type GD    xdbis    ? _F|defined(U|xdbis)
.type text  xtsel    ? _F|defined(U|xtsel)
.type text  xdatname ? _F|defined(U|xdatname)
.type text  xtfeld   ? _F|defined(U|xtfeld)
.type text  xtsort   ? _F|defined(U|xtsort)
.type integer   xistufe  ? _F|defined(U|xistufe)
.type bool  xalles   ? _F|defined(U|xalles)
.type integer   xfirma   ? _F|defined(U|xfirma)
..
.formula U|xalles = F|empty(M|bezobj)
.formula U|xfirma = 0
..
.formula U|xdanf   = M|gltvon
.formula U|xdanf   = "19000101" ? F|empty(U|xdanf)
.formula U|xdend   = M|gltbis
.formula U|xdend   = "21000101" ? F|empty(U|xdend)
.formula U|xvid    = M|bezobj^id
.assign U|xkid  = M|kal
.formula U|xistufe = 0
..
.assign U|xtukal  = M|kal^id
.formula U|xdbis     = M|gltbis
.continue ALLES                 ? F|empty(M|bezobj)
.assign U|xbezobj = M|bezobj
..
!MZEILE1:
.make screen line +O
.assign M|tverwobj = U|xbezobj
.formula M|tname      = U|xbezobj^namebspr  ? U|xbezobj^dnr <> 97
.formula M|tname      = U|xbezobj^rnamebspr ? U|xbezobj^dnr = 97
.formula M|tverwbis   = U|xdbis
.formula M|tstufe     = U|xistufe
.formula M|tukal      = U|xtukal  ? M|tstufe > 0
..
!HOLBEZ1
.select object 'U|xvid'
.continue NKAL1 ? _G|mehr
.formula U|xvid = H|id
.. Kunde, Interessent
.continue KUNDE   ? H|dnr = 0 & (H|gruppe = 1 ; H|gruppe = 6)
.. Lieferant, Interessent?
.continue LIEF    ? H|dnr = 1 & (H|gruppe = 1 ; H|gruppe = 6)
.. Fertigungsmittel
.continue END     ? H|dnr = 2 & H|gruppe = 2 & U|xistufe = 0
.continue NKAL1   ? H|dnr = 2 & H|gruppe = 2
.. Abteilung
.continue MASCHGRP ? H|dnr = 8 & H|gruppe = 1
.. Mitarbeiter
.continue TECHNIK  ? H|dnr = 11 & H|gruppe = 1
.. Firma
.continue MITARBEIT ? H|dnr = 12 & H|gruppe = 10
.. Region
.continue REGION  ? H|dnr = 97 & M|bmoregion
.. Einsatzmittel (Serviceeinsatz)
.continue END     ? H|dnr = 115 & H|gruppe = 2 & U|xistufe = 0
.continue NKAL1   ? H|dnr = 115 & H|gruppe = 2
.. Techniker (Servicemitarbeiter)
.continue END     ? H|dnr = 117 & H|gruppe = 1 & U|xistufe = 0
.continue NKAL1
..
!ALLES: Standard -> (Region) -> Kunde
.copy U|xalles = G|TRUE
.formula U|xfirma = 1
.continue REGION ? M|bmoregion
.continue KUNDE
..
!KUNDE: Kunde -> Kundenkontakt
.formula U|xdatname = 'hdatname0'
.formula U|xtsel "$,,id=;@ablageart=(Active);@gruppe=1.2"
.continue HOLE1 ? U|xalles
.formula U|xtsel "$,,firma=" + 'U|xvid' + ";@ordnung=firma,such;@ablageart=(Both);@gruppe=2.7"
.continue HOLE1
..
!FIRMA: Firma
.formula U|xdatname = 'hdatname12'
.formula U|xtsel "$,,id=;@gruppe=10;@ablageart=(Active)"
.copy U|xalles = G|TRUE
.formula U|xfirma = 2
.continue HOLE1
..
!FERTIGM: Fertigungsmittel
.formula U|xdatname = 'hdatname2'
.formula U|xtsel "$,,id=;@gruppe=2;@ablageart=(Active)"
.formula U|xfirma = 3
.continue HOLE1
..
!EINSATZM: Einsatzmittel
.formula U|xdatname = 'hdatname115'
.formula U|xtsel "$,,id=;@gruppe=2;@ablageart=(Active)"
.formula U|xfirma = 4
.continue HOLE1
..
!ABTEILUNG: Abteilung
.formula U|xdatname = 'hdatname8'
.formula U|xtsel "$,,id=;@gruppe=1;@ablageart=(Active)"
.formula U|xfirma = 5
.continue HOLE1
..
!MITARBEIT: Firma -> Mitarbeiter
.formula U|xdatname = 'hdatname11'
.formula U|xtsel "$,,id=;@ablageart=(Active);@gruppe=1"
.copy U|xalles = G|TRUE
.continue HOLE1
..
!TECHNIK: Mitarbeiter -> Servicetechniker
.formula U|xdatname = 'hdatname117'
.formula U|xtsel "$,,id=;@ablageart=(Active);@gruppe=1"
.formula U|xfirma = 2 ? U|xalles
.continue HOLE1        ? U|xalles
.formula U|xtsel "$,,ma=" + 'U|xvid' + ";@ablageart=(Active);@gruppe=1"
.continue HOLE1
..
!LIEF: Lieferant -> Lieferantenkontakt
.formula U|xdatname = 'hdatname1'
.formula U|xtsel "$,,id=;@ablageart=(Active);@gruppe=1.2"
.continue HOLE1 ? U|xalles
.formula U|xtsel "$,,firma=" + 'U|xvid' + ";@ordnung=firma,such;@ablageart=(Active);@gruppe=2"
.continue HOLE1
..
!REGION: Region -> Åbergeordnete Region
.formula U|xdatname = 'hdatname97'
.formula U|xtsel "$,,id=;@ablageart=(Active);@gruppe=1"
.continue HOLE1 ? U|xalles
.formula U|xtsel "$,,ueberg=" + 'U|xvid' + ";@ablageart=(Active);@gruppe=1"
.continue HOLE1
..
!MASCHGRP: Abteilung -> Maschinengruppe
.formula U|xdatname = 'hdatname8'
.formula U|xtsel "$,,id=;@ablageart=(Active);@gruppe=2"
.continue HOLE1 ? U|xalles
.formula U|xtsel "$,,abtlg=" + 'U|xvid' + ";@ordnung=abtlg,num8;@ablageart=(Active);@gruppe=2"
.continue HOLE1
..
!HOLE1
.select 'U|xdatname' 'U|xtsel'
..
!NEXT
.continue NEXTOK    ? G|mehr
..
!STANDARD: Standardkalender
.. Region -> Kunde -> Lieferant
.continue KUNDE     ? U|xalles & U|xdatname = 'hdatname97'
.continue LIEF      ? U|xalles & U|xdatname = 'hdatname0'
.. U|xfirma=1: Firma -> Mitarbeiter -> Servicetechniker
.continue FIRMA  ? U|xfirma=1
.. U|xfirma=2: Firma -> Fertigungsmittel
.continue FERTIGM   ? U|xfirma=2
.. U|xfirma=3: Firma -> Einsatzmittel
.continue EINSATZM  ? U|xfirma=3
.. U|xfirma=4: Firma -> Abteilung
.continue ABTEILUNG ? U|xfirma=4
.continue TECHNIK ? U|xdatname = 'hdatname11'
.continue NKAL1
..
!NEXTOK
.formula U|xkal2 = F|getwcal(H|id, M|lgruppe^id, U|xdanf)
.. Kalender passt nicht
.continue HOLEN ? U|xkal2 <> U|xtukal
.formula U|xdbis = M|gltbis
.formula U|xkal2 = F|getwcal(H|id, M|lgruppe^id, U|xdend)
.. Kalender passt fÅr den gesamten Zeitraum
.continue MZEILE ? U|xkal2 = U|xtukal
.. Kalender passt fÅr ein Teilzeitraum
.formula U|xdbis = U|xkal2^gltvon - 1
..
!MZEILE: Zeilen aus H-Puffer
.make screen line +O
.formula M|tverwobj = H|id
.formula M|tname    = H|namebspr  ? H|dnr <> 97
.formula M|tname    = H|rnamebspr ? H|dnr = 97
.formula M|tverwbis = U|xdbis
.formula M|tstufe   = U|xistufe
.formula M|tukal    = U|xtukal  ? M|tstufe > 0
..
!HOLEN
.select 'U|xdatname'
.continue NEXT
..
!NKAL1: Ersten untergegeordneten Kalender holen
.continue NKAL ? U|xistufe > 0
.formula U|xistufe = U|xistufe + 1
.continue END ? F|empty(U|xkid)
.formula U|xtsel "$,,uebkal=" + 'U|xkid' + ";@ordnung=uebkal,gltvon;@ablageart=(Active);@gruppe=1.2"
.load 1 'G|hdatname.M|datnr' 'U|xtsel'
.continue UNTOBJ
..
!NKAL: NÑchsten untergeordneten Kalender holen
.load 1 'G|hdatname.M|datnr'
.continue UNTOBJ
..
!UNTOBJ
.continue END                       ? _G|mehr
.assign U|xvid2   = 1|bezobj
.assign U|xtukal  = 1|id
.continue NKAL                      ? U|xvid2 = M|bezobj^id
.assign U|xvid    = U|xvid2
.assign U|xbezobj = U|xvid2
.formula U|xdbis     = 1|gltbis
.continue MZEILE1
..
!END
.continue
