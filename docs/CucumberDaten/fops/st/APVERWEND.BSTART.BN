..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APVERWEND.BSTART.BN
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Beschafft alle Elemente ab der Wurzel bis zur max Stufe.
.. Functionality  : Gets all elements from root to max level.
..*****************************************************************************
.set trans -
..
.. Declarations
.type integer  xresolvedrow
.type ID87 xcallparam
..
.. Initializations
.assign U|xcallparam = M|select
..
.. Open root node
.input 'M|openknot' ? _F|empty(M|openknot)
.continue END ? F|empty(M|tzeilen)
.continue END ? M|stufe >= M|anzstufen
..
.. Start resolving root level
.select screen header
..
!NEXTROW
.select screen line
.continue END ? _G|mehr
.formula M|stufe = M|tbaumstufe
.continue NEXTROW ? M|tbaumstat <> "+"
.continue NEXTROW ? M|stufe >= M|anzstufen
.copy U|xcallparam = M|tkopf
.formula U|xresolvedrow = M|aktzeile
.input 'M|openknot' ? _F|empty(M|openknot)
.select screen line 'U|xresolvedrow'
.continue NEXTROW
..*****************************************************************************
!END
.continue
