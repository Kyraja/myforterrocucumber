..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : HOL.APLANHIERARCHIE
.. Autor          : foe
.. Verantwortlich : cl
.. Kontrolle      : foe
.. Funktion       : Infosystem Betreibskalenderhierarchie: HOL-EFOP
.. Functionality  :
..
.. Ablauf         : Aufloesen kompletter Hierarchien oder
..                  Aufklappen der akt. Maskenzeile:
..  M|bstartbut: leere Tabelle wird entsprechend den Kopfangaben neu gefuellt.
.. _M|bstartbut: die aktuelle Maskenzeile wird um eine Stufe aufgeklappt.
..  M|stufen   : Stufe der aufzuloesenden Zeile bei (_M|bstartbut), sonst bel.
..  M|select   : Selektion fuer Kopfobjekt bei (M|bstartbut), sonst bel.

..*****************************************************************************
..
.set trans -
.type bool  xbweiter   ? _F|defined(U|xbweiter)
.type ID137 xid        ? _F|defined(U|xid)
.type text  xtsel      ? _F|defined(U|xtsel)
..
.continue WEITER ? M|kalkapaz ; M|kaldispo
.. wenn Kalenderwahl nicht eingeschr„nkt wurde, wird Standardvorbelegung verwendet
.copy M|kaldispo = G|FALSE ? M|kal^gruppe = 2
.protection kaldispo               ? M|kal^gruppe = 2
.copy M|kalkapaz = G|TRUE  ? M|kal^gruppe = 2
.copy M|kaldispo = G|TRUE  ? M|kal^gruppe = 1
.copy M|kalkapaz = G|FALSE ? M|kal^gruppe = 1
..
!WEITER
.copy U|xbweiter = G|FALSE
.continue LINE         ? _M|bstartbut
..
.. ----- Oberste Stufe lesen -----
.select screen header
.formula M|stufe = 0
.continue              ? F|empty(M|select)
.select 'G|hdatname.M|datnr' 'M|select'
.continue              ? _G|mehr
.continue ZEILE
..
!STUFEN: In allen Maskenzeilen ggf. eine weitere Stufe aufloesen
.copy U|xbweiter = G|FALSE
.select screen header
.formula M|stufe = M|stufe + 1
.continue        ? (M|stufe >= M|anzstufen)
..
!NEXT: Naechste Maskenzeile pruefen und ggf. eine Stufe aufloesen
.select screen line
.continue STUFEN ? _G|mehr & U|xbweiter
.continue END    ? _G|mehr
.continue NEXT   ? (M|tbaumstufe <> M|stufe)
..
!LINE: Aktuelle Maskenzeile eine Stufe weiter aufloesen.
.assign U|xid  M|tkal^id
.continue NEXTST    ? _G|mehr
.formula U|xtsel "$,,uebkal=" + 'U|xid' + ";@ablageart=(Active);@gruppe=1"   ? M|kaldispo
.formula U|xtsel "$,,uebkal=" + 'U|xid' + ";@ablageart=(Active);@gruppe=2"   ? M|kalkapaz
.formula U|xtsel "$,,uebkal=" + 'U|xid' + ";@ablageart=(Active);@gruppe=1.2" ? M|kalkapaz & M|kaldispo
.select 'G|hdatname.M|datnr' 'U|xtsel'
.continue NEXTST    ? _G|mehr
..
!ZEILE: Tabelle in Hauptpuffer zeilenweise uebernehmen
.. Pro Zeile das Tabellen-FOP aufrufen
.input 'M|tab'  ? _F|empty(M|tab)
.copy U|xbweiter = G|TRUE
.select 'G|hdatname.M|datnr'
.continue NEXTST    ? _G|mehr
.continue ZEILE
..
!NEXTST: Naechste Maskenzeile nur, wenn per Startbutton gestartet
.continue NEXT   ? M|bstartbut
..
..*****************************************************************************
!END
.continue
