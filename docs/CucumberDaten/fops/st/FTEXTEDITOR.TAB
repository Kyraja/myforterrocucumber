..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : FTEXTEDITOR.TAB
.. Autor          : fwester
.. Verantwortlich : fwester
.. Kontrolle      : lei
.. Funktion       : Erzeugt eine Zeile als Punkt im Menuekoerper.
.. Functionality  : Creates a row as an item of the menu body.
..*****************************************************************************
.set trans -
..
.. Common data
.make screen line +
.assign M|tbaumstat = ""
.assign M|tbaumstufe = 2
.assign M|toperation = "FTNEU"
.assign M|tmenueendeaktion = "(Done)"
..
.. Which type of menu body?
.continue TMPLATE ? M|template
..
!DEFAULT
.assign M|tbaumtext = M|ftexttyp
.assign M|tbauminfo = M|ftexttempl
.copy M|tbaumicon = M|icontextneu
.copy M|tvorlageft = M|ftexttpl
.copy M|tmenuemoeglich = M|ftexteditierbar
.continue NOTEXEC ? _M|tmenuemoeglich
.continue END
..
!TMPLATE
.assign M|tvorlage = 1|vorlage
.assign M|tbaumtext = M|tvorlage^sucherw
.assign M|tbauminfo = M|ftexttempl
.copy M|tbaumicon = M|tvorlage^icontxt
.assign M|tvorlageft = F|eval("M|tvorlage^ftext" + M|ksi)
.copy M|tmenuemoeglich = _F|empty(F|eval("M|tvorlage^ftext" + M|ksi)) & M|ftexteditierbar
.continue END ? M|tmenuemoeglich
..
!NOTEXEC: Command not executable
.formula M|tbauminfo = M|ftextnichtedit ? _M|ftexteditierbar
.formula M|tbauminfo = M|ftextkeintpl   ? F|empty(M|tvorlageft)
.copy M|tbaumicon = M|iconstop
..*****************************************************************************
!END
.continue
