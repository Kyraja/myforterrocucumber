..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PRICEMAINTENANCE.TAB
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  : Creates a mask row in the table.
.. Separates two levels. 1st level which represents header of scalings and
.. 2nd level which represents a row with scaling data..
..*****************************************************************************
.set trans -
..
.continue FILEOUT ? M|sort
..
.. Coloring
.formula M|changerecord0 = M|changerecord1 ? F|empty(M|tzeilen)
.continue CHANGE2 ? M|changerecord0 = M|changerecord1
.copy M|changerecord0 = M|changerecord1
.continue HEADER
..
!CHANGE2
.copy M|changerecord0 = M|changerecord2
..
!HEADER: Header row
.make screen line +O
.copy M|lastrowno = M|aktzeile
.formula M|tbaumstufe = M|headerlevel
.formula M|trecordcolor = M|changerecord0
.colour -background 'M|trecordcolor' 'M|aktzeile'
.input 'M|tabheader' ? _F|empty(M|tabheader)
..
.copy M|header = M|tnum
..
.. Check record
.input 'M|checkrecordrow' ? _F|empty(M|checkrecordrow)
..
.. Protect row input items
.input 'M|protectscreenitems' ? _F|empty(M|protectscreenitems)
..
!PRRANGE: Range of price
.type integer currentrowno ? _F|defined(U|currentrowno)
.formula U|currentrowno = H|aktzeile + 1
!WHILE
.continue END ? U|currentrowno > H|tzeilen
.select line 'U|currentrowno'
.continue END ? _G|mehr
.continue NONEWRW ? _M|kpos ; M|zeilen < 1
.make screen line +O
.formula M|trecordcolor = M|changerecord0
.colour -background 'M|trecordcolor' 'M|aktzeile'
..
!NONEWRW
.assign M|theader = M|header
.formula M|tbaumstufe = M|rowlevel
.input 'M|tabscaling' ? _F|empty(M|tabscaling)
..
.. Check record
.input 'M|checkrecordrow' ? _F|empty(M|checkrecordrow)
..
.. Protect row and header input items
.input 'M|protectscreenitems' ? _F|empty(M|protectscreenitems)
.continue END ? _M|kpos
.formula U|currentrowno = U|currentrowno + 1
.continue WHILE
..
!FILEOUT: Print to file because we need to sort.
.continue START ? _M|init
.continue FILEROW
..
!START: Initialize file output
.copy M|init = G|TRUE
.input "DATEI.F"
.output new 'M|sortfilename'
..
!FILEROW: Output data row
'H|gltvon:8'#'H|gltbis:8'#'H|id'
..*****************************************************************************
!END
.continue
