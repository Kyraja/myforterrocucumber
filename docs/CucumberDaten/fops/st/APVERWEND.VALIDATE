..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : APVERWEND.VALIDATE
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Kontextbeziehungen zwischen Elementen.
.. Functionality  : Validates context relationships between elements.
..*****************************************************************************
.set trans -
..
.copy M|tkonflikt = G|FALSE
.copy M|tkonfliktart = 0
..
.. Check location of button
.continue ERROR01 ? M|taufrtab1 <> M|taufrtab2
..
.. Check context
.continue ALLVTAB ? F|equals(M|tkontexttyp2, "(AllTablesOfVariables)")
.continue ALLINFO ? F|equals(M|tkontexttyp2, "(AllInfosystems)")
.continue ONEVTAB ? F|equals(M|tkontexttyp2, "(SingleTableOfVariables)")
.continue ONEINFO ? F|equals(M|tkontexttyp2, "(SingleInfosystem)")
.continue ERROR02
..
!ALLVTAB: All tables needs all tables
.continue ALLNALL ? F|equals(M|tkontexttyp1, "(AllTablesOfVariables)")
.continue ERROR03
..
!ALLINFO: All infosystems need all infosystems
.continue ALLNALL ? F|equals(M|tkontexttyp1, "(AllInfosystems)")
.continue ERROR03
..
!ONEVTAB: One table allows one or all tables
.continue ONENALL ? F|equals(M|tkontexttyp1, "(AllTablesOfVariables)")
.continue ONENONE ? F|equals(M|tkontexttyp1, "(SingleTableOfVariables)")
.continue ERROR03
..
!ONEINFO: One infosystem allows one or all infosystems
.continue ONENALL ? F|equals(M|tkontexttyp1, "(AllInfosystems)")
.continue ONENONE ? F|equals(M|tkontexttyp1, "(SingleInfosystem)")
.continue ERROR03
..
!ALLNALL: All in all needs empty callers at all
.continue END ? F|empty(M|taufrktxt2) & F|empty(M|taufrktxt1)
.continue ERROR04
..
!ONENALL: One and all needs empty caller in the where-used element
.continue END ? _F|empty(M|taufrktxt2) & F|empty(M|taufrktxt1)
.continue ERROR04
..
!ONENONE: One in one needs no empty callers at all
.continue ERROR04 ? F|empty(M|taufrktxt2) ; F|empty(M|taufrktxt1)
.continue ERROR04 ? M|taufrktxt2^id <> M|taufrktxt1^id
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Mismatching button locations
.formula M|tkonfliktart = 1
.continue FOUND
..
!ERROR02: Unknown type of context
.formula M|tkonfliktart = 2
.continue FOUND
..
!ERROR03: Mismatching types of context
.formula M|tkonfliktart = 3
.continue FOUND
..
!ERROR04: Mismatching callers
.formula M|tkonfliktart = 4
..
!FOUND
.copy M|tkonflikt = G|TRUE
.continue END
