..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : TERMINALPRINTER.BSTART.BV
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      : cl
.. Functionality  : shows the combination of printer list and local printers
..*****************************************************************************
..
.set trans -
..
.make screen line --
..
.input "TERMINALPRINTER.STANDORTDR" ? _ F|empty(M|kstandort) & F|equals(M|kstandortdrucker, "(First)")
.input "TERMINALPRINTER.STANDORTDR" ? _ F|empty(M|kstandort) & F|empty(M|kdruckerliste)
.continue ENDLIST ? F|empty(M|kdruckerliste)
.select group "91:13" ' M|kdruckerliste^id'
.continue ENDLIST ?_G|mehr
.continue NEXT ? F|empty(H|stddrucker)
..
.make screen line +O
.assign M|tdrucker = H|stddrucker^id
.copy M|taktiv = H|stddrucker^aktiv
.copy M|tlistendrucker = G|TRUE
..
!NEXT
.select line
.continue ENDLIST ? _ G|mehr
.make screen line
.assign M|tdrucker = H|spdrucker^id
.copy M|taktiv = H|spdrucker^aktiv
.copy M|tlistendrucker = G|TRUE
.continue NEXT
..
!ENDLIST
.input "TERMINALPRINTER.STANDORTDR" ? _ F|empty(M|kstandort) & F|equals(M|kstandortdrucker, "(Last)")
..
..*****************************************************************************
!END
.continue

