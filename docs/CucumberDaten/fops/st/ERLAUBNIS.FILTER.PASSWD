..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.FILTER.PASSWD
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Definiert zu welchem der Passwoerter die Erlaubnisse
.. dargestellt werden.
..
.. Functionality  : Defines for which of the passwords the permissions will be
.. visualized.
..*****************************************************************************
.set trans -
..
.. Declarations
.type bool xxok ? _F|defined(U|xxok)
..
.. Initialize
.copy U|xxok = G|FALSE
..
.. Is a database command specified?
.continue TIPPED ? _M|datkomda
..
.. Does the specified database command have an specified action?
.continue ACTION  ? _F|equals(M|kaktname, "(EmptyEntry)")
..
.. Handle the specified database without an action
.continue END ?  M|kaktverbot &  F|cmdpermitted(F|tovalue('M|kdatnr',"I9"), ,M|aktpasswort)
.continue END ? _M|kaktverbot & _F|cmdpermitted(F|tovalue('M|kdatnr',"I9"), ,M|aktpasswort)
.continue TIPPED
..
!ACTION: Handle the specified database with the specified action
.continue END ?  M|kaktverbot &  F|cmdpermitted(F|tovalue('M|kdatnr',"I9"), F|tovalue('M|kaktnr',"I9"),M|aktpasswort)
.continue END ? _M|kaktverbot & _F|cmdpermitted(F|tovalue('M|kdatnr',"I9"), F|tovalue('M|kaktnr',"I9"),M|aktpasswort)
..
!TIPPED: Is a tipped command specified?
.continue TRUE ? _M|tippkomda
..
.. Handle the specified tipped command
.continue END ?  M|kkomverbot &  F|tcmdpermitted(F|tovalue('M|kkomnr',"I9"),M|aktpasswort)
.continue END ? _M|kkomverbot & _F|tcmdpermitted(F|tovalue('M|kkomnr',"I9"),M|aktpasswort)
..
!TRUE: Hit is ok
.copy U|xxok = G|TRUE
..*****************************************************************************
!END
.continue
