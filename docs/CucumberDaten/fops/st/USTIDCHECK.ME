.set trans -
.formula M|liefer  = G|true
.formula M|kunden  = G|true
.formula M|ausland = G|true
.select company "$,@gruppe=10;gruppe=10"
.continue ERR01 ? _G|mehr
.continue ERR02 ? F|empty(H|ustid)
..
.formula M|ustid = H|ustid
.select
.continue END ? F|substr(F|toupper(M|ustid), 1, 2) = "DE"
.. Nicht Deutschland
.formula M|offline = G|true
.protection offline
.continue END
..
..*****************************************************************************
!ERR01
..*****************************************************************************
.error Betriebsdatensatz nicht gefunden.
.end 1
..
..*****************************************************************************
!ERR02
..*****************************************************************************
.error Bitte die eigene Umsatzsteuer-Identifikationsnummer im Betriebsdatensatz hinterlegen.
.end 1
..
..*****************************************************************************
!END
..*****************************************************************************
.continue
