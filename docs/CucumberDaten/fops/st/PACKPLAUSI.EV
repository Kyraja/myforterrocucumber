..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PACKPLAUSI.EV
.. Autor          : comu/mh
.. Verantwortlich : mh
.. Kontrolle      :
.. Funktion       : Infosystem PACKPLAUSI, allgemeine Events
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type text xt1
.type text xt2
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kpackfehl"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kpackwarnung"
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kpackfehlerfrei"
.continue BOOL    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbpackmit"
.continue BOOL    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbartikel"
.. ----------- ---------- ---------- -------------------------------------------
.continue INIT    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kpmtyp"
.continue TYPSHU  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbpmtypleer"
.. ----------- ---------- ---------- -------------------------------------------
.continue PMKEN   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kpackmitken"
.continue PMKEN   ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "kbupmkenleer"
.continue PMKEN   ? T|evtartengl = "BUTTON_AFTER" & T|evtvar = "kbupmkenalle"
.continue KENSHU  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbpackmitkenfehl"
.. ----------- ----- Tabellenteil ----------------------------------------------
.continue ZEILE   ? T|evtartengl = "FIELD_EXIT"
.continue FORBID  ? T|evtartengl = "ROW_MOVE_BEFORE"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!BOOL
.formula M|kbartikel = _M|kbpackmit  ? T|evtvar = "kbpackmit"
.formula M|kbpackmit = _M|kbartikel  ? T|evtvar = "kbartikel"
.continue INIT
..
!PMKEN
.formula M|kpackmitken = "`"         ? T|evtvar = "kbupmkenleer"
.formula M|kpackmitken = "A!z"       ? T|evtvar = "kbupmkenalle"
.continue INIT    ? _(M|kpackmitken/"*!*")
.continue INIT    ?  +M|kpackmitken < 3
.formula U|xt1 = M|kpackmitken<<"!"
.formula U|xt2 = M|kpackmitken>>"!"
.formula M|kpackmitken = U|xt2 + "!" + U|xt1     ?  U|xt2 < U|xt1
.continue INIT
..
!KENSHU
.formula M|kpackmitken = ""          ? _M|kbpackmitkenfehl
.protection         kpackmitken         ? _M|kbpackmitkenfehl
.protection         kbupmkenleer        ? _M|kbpackmitkenfehl
.protection         kbupmkenalle        ? _M|kbpackmitkenfehl
.protection -reset  kpackmitken         ?  M|kbpackmitkenfehl
.protection -reset  kbupmkenleer        ?  M|kbpackmitkenfehl
.protection -reset  kbupmkenalle        ?  M|kbpackmitkenfehl
.continue INIT
..
!TYPSHU
.formula M|kpmtyp = ""               ?  M|kbpmtypleer
.protection         kpmtyp              ?  M|kbpmtypleer
.protection -reset  kpmtyp              ? _M|kbpmtypleer
.continue INIT
..
!ZEILE: tag row as edited
.continue END     ?  M|aktzeile = 0  ;  M|ozeilen = 0
.copy M|tbmark = G|true
.protection -reset tbmark 'M|aktzeile'
.continue END
..
!INIT: remove rows, clear header fields
.make screen line -- ? M|tzeilen > 0
.continue END
..
!FORBID: an event was triggered, which is not allowed
.error
.end 1
..*****************************************************************************
!END
.continue
