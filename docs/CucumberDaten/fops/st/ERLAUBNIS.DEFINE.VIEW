..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : ERLAUBNIS.DEFINE.VIEW
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : ba
.. Funktion       : Definiert die Darstellungsform der Erlaubnisse.
.. Functionality  : Defines how the permissions will be visualized.
..*****************************************************************************
.set trans -
..
.continue FATAL ? _M|dateikom & _M|tippkom
..
.continue ONLYSEL ? M|nurselkom
.continue END     ? M|dateikom & M|tippkom
..
.. Show all database or all tipped commands
.assign M|aktmarke = "ALLDB" ? M|dateikom
.assign M|aktmarke = "ALLTC" ? M|tippkom
.continue END
..
!ONLYSEL: Handle selected commands
.continue BOTHCAT ? M|dateikom & M|tippkom
.continue DBCMMD  ? M|dateikom
..
.. Tipped command is set
.assign M|aktmarke = "ALLTC" ? _M|tippkomda
.assign M|aktmarke = "ONETC" ?  M|tippkomda
.continue END
..
!DBCMMD: Database command ist set
.assign M|aktmarke = "ALLDB" ? _M|datkomda
.assign M|aktmarke = "ONEDB" ?  M|datkomda
.continue END
..
!BOTHCAT: Database and tipped commands are set
.continue SINGLE ?  M|datkomda & M|tippkomda
.continue END    ? _(M|datkomda & M|tippkomda)
.assign M|aktmarke = "ONEDB" ? M|datkomda
.assign M|aktmarke = "ONETC" ? M|tippkomda
.continue END
..
!SINGLE: Show both, specified database and tipped command
.assign M|aktmarke = "SINGLE"
..*****************************************************************************
!END
.continue
..*****************************************************************************
!FATAL: This case is illegal!
.error -number 1111
.end 1
