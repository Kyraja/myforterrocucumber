..!interpreter german translate declaration noabbrev
..*****************************************************************************
.. Name           : CONFIG.DS.EV
.. Datum/Date     : 05.12.12
.. Version        : 2011r4n01p01
.. Autor/Author   : doda/abas
.. Copyright      : (c) 2012
.. Funktion       : Event handling
.. Program flow   :
...Includes       :
..include is/TABLEEREN
..include ow1/CONFIG.DS.VAR.DECLARE
..include ow1/CONFIG.DS.EXCEPTION
..
.setze trans -
..*****************************************************************************
..: Input program with variable declarations
.eingabe "ow1/CONFIG.DS.VAR.DECLARE"
..*****************************************************************************
..
..
..:============================================================================
..: Control table
..:============================================================================
.weiter BNLOG           ?  G|evtart = "buttonnach" & G|evtvar = "buopenlog"
.weiter BNFILE          ?  G|evtart = "buttonnach" & G|evtvar = "buopenfile"
.weiter BNEDPOU         ?  G|evtart = "buttonnach" & G|evtvar = "ybuopenedpout"
.weiter BNTEDPO         ?  G|evtart = "buttonnach" & G|evtvar = "ybuopentedpout"
.weiter
..
..
..:============================================================================
..: Open log file
..:============================================================================
!BNLOG
.weiter ERRV001        ? _F|fileexists('M|logfile')
..formel U|xtkommd       = "<(Text)> " + 'M|logfile' + "<(View)>"
.edi 'M|logfile'
.kommando -WARTEN 'U|xtkommd'
.weiter
..
....:============================================================================
..: Open import file
..:============================================================================
!BNFILE
.weiter ERRV002        ? _F|fileexists('M|origfile')
.formel U|xtsys       = "cat " + M|origfile
.system 'U|xtsys'
.weiter
..
....:============================================================================
..: Open edp output file head
..:============================================================================
!BNEDPOU
.weiter ERRV003        ? _F|fileexists('M|yedpoutput')
.formel U|xtkommd       = "<(Text)> " + 'M|yedpoutput' + "<(View)>"
.kommando -WARTEN 'U|xtkommd'
.weiter
..
....:============================================================================
..: Open edp output file table
..:============================================================================
!BNTEDPO
.weiter ERRV004        ? _F|fileexists('M|ytedpoutput')
.formel U|xtkommd       = "<(Text)> " + 'M|ytedpoutput' + "<(View)>"
.kommando -WARTEN 'U|xtkommd'
.weiter
..
..
..:============================================================================
..: Exception handling
..:============================================================================
..: Log file can not be opened
!ERRV001
.formel U|xiexceptnr    = 301
.formel U|xtexceptxt    = "File " + 'M|logfile' + " does not exist!"
.eingabe "ow1/CONFIG.DS.EXCEPTION"
.ende 'U|xiexceptnr'
..
..
..: Import file can not be opened
!ERRV002
.formel U|xiexceptnr    = 301
.formel U|xtexceptxt    = "File " + 'M|origfile' + " does not exist!"
.eingabe "ow1/CONFIG.DS.EXCEPTION"
.ende 'U|xiexceptnr'
..
..: Import file can not be opened
!ERRV003
.formel U|xiexceptnr    = 301
.formel U|xtexceptxt    = "File " + 'M|yedpoutput' + " does not exist!"
.eingabe "ow1/CONFIG.DS.EXCEPTION"
.ende 'U|xiexceptnr'
..
..: Import file can not be opened
!ERRV004
.formel U|xiexceptnr    = 301
.formel U|xtexceptxt    = "File " + 'M|ytedpoutput' + " does not exist!"
.eingabe "ow1/CONFIG.DS.EXCEPTION"
.ende 'U|xiexceptnr'
