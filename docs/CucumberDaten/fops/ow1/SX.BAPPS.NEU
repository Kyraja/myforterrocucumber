..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ow1/SX.BAPPS.NEU
.. Autor          : mage
.. Verantwortlich : melp
.. Kontrolle      :
.. Funktion       : Im Neu-Modus B-Apps anzeigen
.. Funktionalitaet verteilt:
.type text xturl2
....set trace +
.continue END ? G|evtkommd <> "neu"
.set trans -
.continue VK  ? M|dnr = 3 & _(G|evtmaske = 855 ; G|evtmaske = 856 ; G|evtmaske = 884 ; G|evtmaske = 878)
.continue SER ? M|dnr = 3 &  (G|evtmaske = 855 ; G|evtmaske = 856 ; G|evtmaske = 884 ; G|evtmaske = 878)
.continue EK  ? M|dnr = 4 
.continue
..
!VK
.continue END ? G|evtvar <> "kunde"
.continue END ? F|empty(M|kunde)
.formula U|xturl2    = "http://"+'E|BAPPS_HOST'+":9280/erprest-2/aba/abas/erp/Sidebar?process=&view=sales&abaLayout=abaMinimal&customer="+'M|kunde^id'     
.formula M|sidebarbaurl = 'U|xturl2' 
.continue END
..
!EK
.continue END ? G|evtvar <> "lief"
.continue END ? F|empty(M|lief)
.formula U|xturl2    = "http://"+'E|BAPPS_HOST'+":9280/erprest-2/aba/abas/erp/Sidebar?process=&view=purchase&abaLayout=abaMinimal&vendor="+'M|lief^id'
.formula M|sidebarbaurl = 'U|xturl2' 
.continue END
..
!SER
.continue END ? G|evtvar <> "kunde"
.continue END ? F|empty(M|kunde)
.formula U|xturl2    = "http://"+'E|BAPPS_HOST'+":9280/erprest-2/aba/abas/erp/Sidebar?process=&view=service&abaLayout=abaMinimal&customer="+'M|kunde^id'     
.formula M|sidebarbaurl = 'U|xturl2' 
.continue END
..
!END
.continue
