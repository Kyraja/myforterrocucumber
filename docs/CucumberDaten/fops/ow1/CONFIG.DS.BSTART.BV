..!interpreter german translate declaration noabbrev
..*****************************************************************************
.. Name           : CONFIG.DS.BSTART.BV
.. Datum/Date     : 04.12.12
.. Version        : 2011r4n01p01
.. Autor/Author   : sy
.. Copyright      : (c) 2012
.. Funktion       : Prepare the configuration for import/update demo data
..
.. Program flow   :
...Includes       
..include is/TABLEEREN
..include ow1/CONFIG.DS.VAR.DECLARE
..include ow1/CONFIG.DS.EXCEPTION
..include ow1/CONFIG.DS.PRESET
..include win/tmp/bin/READ.FILES.SH
..*****************************************************************************
..: Input program with variable declarations
.eingabe "ow1/CONFIG.DS.VAR.DECLARE"
..*****************************************************************************
..
..
..set trace +
..
..:============================================================================
..: Dynamic file list processer to identify the files to be imported
..:============================================================================
..: Read import files into FILES.1.LIST or FILES.2.LIST
..  Shell script READ.FILES.SH reads automatically directory "win/tmp/data" and
..  writes a list of all EDP files in a file
..: Master Data
.formel U|xtmastfile    = "win/tmp/data/log/FILES.1.LIST"       ?  M|bmastdata
..: Transaction Data
.formel U|xtmastfile    = "win/tmp/data/log/FILES.2.LIST"       ? _M|bmastdata
..
.formel  U|xtsys        = "win/tmp/bin/READ.FILES.SH"
.system 'U|xtsys' HINTER                                        ?           _G|edp
.weiter ERRBV01                                                 ? _G|mehr & _G|edp
..
..: Copy result files with EDP import file lists into a valid work space
.formel  U|xtsys        = "cp "+ 'U|xtmastfile' + " ow1/"
.system 'U|xtsys' HINTER
.weiter ERRBV02                                                 ? _G|mehr
..
.weiter END
..
..
..:============================================================================
..: End of program
..:============================================================================
!END
..: load progrgam to preset dates for dynamization
.eingabe "ow1/CONFIG.DS.PRESET"
.weiter
..
..
..:============================================================================
..: Exception Handling
..:============================================================================
!ERRBV01
.formel U|xiexceptnr    = 101
.formel U|xtexceptxt    = "File list " + 'U|xtfilelist' + " could not be created!"
.eingabe "ow1/CONFIG.DS.EXCEPTION"
.ende 'U|xiexceptnr'
..
!ERRBV02
.formel U|xiexceptnr    = 102
.formel U|xtexceptxt    = "File list " + 'U|xtfilelist' + " could not be copied into work space!"
.eingabe "ow1/CONFIG.DS.EXCEPTION"
.ende 'U|xiexceptnr'
