.type GD xd1date xd2date xd3date xd4date
.type week xw1w xw2w
.........
.continue DISPO   ? G|evtvar= "y1w"
!DISPO
.formula U|xd1date = M|y1w
.formula M|y1dat = U|xd1date -2
.formula M|y2dat = U|xd1date +2
.formula M|y2w   = M|y1w + 49
.formula U|xd2date = M|y2w
.formula M|y3dat = U|xd1date -2
.formula M|y4dat = U|xd2date + 2
.continue
