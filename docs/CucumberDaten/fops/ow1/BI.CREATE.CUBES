..!interpreter german
.. FOP to build the bi cubes
.. ow1/BI.CREATE.CUBES
.. Stand: fr abas-Version 2015r4 (13.04.2015)
.art text xtsys xtjedoxhome xtjava xtjedoxhost xtjedoxport xttempdat
..
.. Hostname ermitteln
.datei -tempname U|xttempdat
.formel U|xtsys = "hostname >" + U|xttempdat
.sys 'xtsys'
.hole von 'U|xttempdat' xthostname^
.weiter ERR01 ? _G|mehr
..
.. Init section
..
.formel U|xtjava = "export JAVA_HOME=/usr/java/jdk1.7.0_75;"
.formel U|xtjedoxhome = "/u/jedox/ps/"
.formel U|xtjedoxhost = U|xthostname
.formel U|xtjedoxport = "7775"
..
..
.formel U|xtjedoxprgcall = U|xtjedoxhome + "/tomcat/client/etlclient.sh -s http://" + U|xtjedoxhost + ":" + U|xtjedoxport 
..
executing global jobs
..
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_global -j All_In_One"
.sys 'xtsys'
..
executing purchasing jobs
..
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_purchasing -j I_InitJob" 
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_purchasing -j II_CubePurchaseOrder"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_purchasing -j III_CubePurchaseInvoice"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_purchasing -j IV_CubePurchasePackingslip"
.sys 'xtsys'
..
executing sales jobs
..
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_sales -j I_InitJob"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_sales -j II_CubeOpportunities"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_sales -j III_CubeQuotations"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_sales -j IV_CubeOrders"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_sales -j V_CubeSalesInvoice"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_sales -j VI_CubeCRM"
.sys 'xtsys'
..
executing materialmanagement jobs
..
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_materialmanagement -j All_In_One"
.sys 'xtsys'
..
executing edi jobs
..
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_edi -j I_InitJob"
.sys 'xtsys'
.fo xtsys = U|xtjava + U|xtjedoxprgcall + " -p abas_edi -j II_Cubes"
.sys 'xtsys'
..
!ENDE
.weiter
..
!ERR01
.fehler Hostname konnte nicht ermittelt werden!
.ende 1
