..!interpreter german translate noabbrev
..*****************************************************************************
.. Name           :ow1/CONFIG.DS.PRESET
.. Datum/Date     :15.02.2013
.. Version        :
.. Autor/Author   :doda/abas
.. Copyright      :ABAS Software AG, 2013
.. Beschreibung/
.. Description    :Preset dates for dynamic transactions
..
...Includes       :
..*****************************************************************************
..
..art text xtsel         ? _F|defined(xtsel)
..
..
..*****************************************************************************
..
..:===========================================================================
..: Retrieve values from configuration and company file
..:===========================================================================
.formel M|baseyear      =  F|year(M|basedate)
.formel M|basemont      = 'F|month(M|basedate)'
.formel M|basemont      =  F|trim(("0" +  'M|basemont'))      ?  F|length(M|basemont) = 1
.formel M|yearone       =  M|baseyear - 1
.formel M|yeartwo       =  M|baseyear - 2
.formel M|yearthree     =  M|baseyear - 3
..
..:===========================================================================
..: Preset dates for sales orders
..:===========================================================================
.art int  xi                                                    ? _F|defined(xi)
.art int  xiold                                                 ? _F|defined(xiold)
.formel U|xi            =  0
.formel M|orddate.xi    =  M|basedate
..
..: Loop definition for process order dates for 9 dates
!SALORD0
.weiter EDIDATES                                                ?  U|xi = 10
..: Define order date
.formel U|xiold         =  U|xi - 1                             ?  U|xi <> 0
.formel M|orddate.xi    =  M|orddate.xiold & -(2)
..
..: Define order year
.formel M|ordyear.xi    = 'F|year(M|orddate.xi)'
..
..: Define order month
.formel M|ordmont.xi    = 'F|month(M|orddate.xi)'
.formel M|ordmont.xi    =  F|trim(("0" +  'M|ordmont.xi'))      ?  F|length(M|ordmont.xi) = 1
..
..: Define order day
.formel M|ordday.xi     = 'F|day(M|orddate.xi)'
.formel M|ordday.xi     =  F|trim(("0" +  'M|ordday.xi'))       ?  F|length(M|ordday.xi)  = 1
..
.formel U|xi            =  U|xi + 1
.weiter SALORD0
..
..
..:===========================================================================
..: Preset dates for EDI
..:===========================================================================
!EDIDATES
.art int  xi                                                    ? _F|defined(xi)
.art int  xiold                                                 ? _F|defined(xiold)
.art int  xedimont                                              ? _F|defined(xedimont)
.art int  xediyear                                              ? _F|defined(xediyear)
.formel U|xi            =  0
.formel M|edidate.xi    =  M|basedate
.formel U|xedimont = 'F|month(M|basedate)'
.formel U|xediyear = 'F|year(M|basedate)'
..
..: Loop definition for process edi dates for 9 dates
!SALEDI0
.weiter EDIHISDATES                                             ?  U|xi = 10
..: Define edier date
.formel U|xiold         =  U|xi - 1                             ?  U|xi <> 0
..
..: Add one Workday
.formel M|edidate.xi    =  M|edidate.xiold & (1)                ?  U|xi > 0
..
..: Define edier year
.formel M|ediyear.xi    =  'U|xediyear'
.formel M|ediyear.xi    =  'U|xediyear + 1'                     ?  U|xedimont = 12
..
..: Define edier month
.formel U|xedimont     = U|xedimont + 1
.formel U|xedimont     = 1                                      ?  U|xedimont > 12
.formel M|edimont.xi    = 'U|xedimont'
.formel M|edimont.xi    =  F|trim(("0" +  'M|edimont.xi'))      ?  F|length(M|edimont.xi) = 1
..
..: Define edier day
.formel M|ediday.xi     = 'F|day(M|edidate.xi)'
.formel M|ediday.xi     =  F|trim(("0" +  'M|ediday.xi'))       ?  F|length(M|ediday.xi)  = 1
..
.formel U|xi            =  U|xi + 1
.weiter SALEDI0
..
..
..:===========================================================================
..: Preset history dates for EDI   edihsday0
..:===========================================================================
!EDIHISDATES
.art int  xi                                                    ? _F|defined(xi)
.art int  xiold                                                 ? _F|defined(xiold)
.art int  xedimont                                              ? _F|defined(xedimont)
.art int  xediyear                                              ? _F|defined(xediyear)
.formel U|xi            =  0
.formel M|edihsday.xi    = 'M|basedate'
.formel M|edihsday.xi    = M|edihsday.xi -61
...formel U|xedimont = 'F|month(M|basedate)'
...formel U|xediyear = 'F|year(M|basedate)'
..
..: Loop definition for process edi dates for 9 dates
!SALEDIH0
.weiter INV0000                                                 ?  U|xi = 10
..: Define edier date
.formel U|xiold         =  U|xi - 1                             ?  U|xi <> 0
..
..: Add one Workday
.formel M|edihsday.xi    =  M|edihsday.xiold & (4)                ?  U|xi > 0
..
....: Define edier year
...formel M|ediyear.xi    =  'U|xediyear'
...formel M|ediyear.xi    =  'U|xediyear + 1'                     ?  U|xedimont = 12
....
....: Define edier month
...formel U|xedimont     = U|xedimont + 1
...formel U|xedimont     = 1                                      ?  U|xedimont > 12
...formel M|edimont.xi    = 'U|xedimont'
...formel M|edimont.xi    =  F|trim(("0" +  'M|edimont.xi'))      ?  F|length(M|edimont.xi) = 1
....
.....: Define edier day
..formel M|edihsday.xi     = 'F|day(M|edihsday.xi)'
..formel M|edihsday.xi     =  F|trim(("0" +  'M|edihsday.xi'))       ?  F|length(M|edihsday.xi)  = 1
....
.formel U|xi            =  U|xi + 1
.weiter SALEDIH0
..
..
..:===========================================================================
..: Preset dates for sales invoices
..:===========================================================================
!INV0000
.art GD2  xdcurrdate                                            ? _F|defined(xdcurrdate)
.art GD2  xdpre1date                                            ? _F|defined(xdpre1date)
.formel U|xi            =  1
..: Define first date for invoices in current year
.formel U|xdcurrdate    = "21.01." + 'M|baseyear'
.formel U|xdcurrdate    =  U|xdcurrdate & 1 
..: Define first date for invoices in previous year
.formel U|xdpre1date    = "22.01." + 'M|yearone'
.formel U|xdpre1date    =  U|xdpre1date & 1
..
..: Loop definition for process order dates for 12 dates
!SALINV0
.weiter PORD000                                                 ?  U|xi = 13
..: Define date for current and previous year
.formel M|inv0dt.xi     = 'U|xdcurrdate'
.formel M|inv1dt.xi     = 'U|xdpre1date'
..
..: Define year
.formel M|inv0yr.xi     = 'F|year(M|inv0dt.xi)'
.formel M|inv1yr.xi     = 'F|year(M|inv1dt.xi)'
..
..: Define month
.formel M|inv0mo.xi     = 'F|month(M|inv0dt.xi)'
.formel M|inv0mo.xi     =  F|trim(("0" +  'M|inv0mo.xi'))       ?  F|length(M|inv0mo.xi)  = 1
.formel M|inv1mo.xi     = 'F|month(M|inv1dt.xi)'
.formel M|inv1mo.xi     =  F|trim(("0" +  'M|inv1mo.xi'))       ?  F|length(M|inv1mo.xi)  = 1
..
..: Define day
.formel M|inv0dy.xi     = 'F|day(M|inv0dt.xi)'
.formel M|inv0dy.xi     =  F|trim(("0" +  'M|inv0dy.xi'))      ?  F|length(M|inv0dy.xi)    = 1
.formel M|inv1dy.xi     = 'F|day(M|inv1dt.xi)'
.formel M|inv1dy.xi     =  F|trim(("0" +  'M|inv1dy.xi'))      ?  F|length(M|inv1dy.xi)    = 1
..
..
.formel U|xi            =  U|xi + 1
.formel U|xdcurrdate    =  U|xdcurrdate & 21
.formel U|xdpre1date    =  U|xdpre1date & 21
..
.weiter SALINV0
..
..:===========================================================================
..: Preset dates for purchase orders
..:===========================================================================
!PORD000
.formel U|xi            =  1
..: Define first date in current year
.formel U|xdcurrdate    = "05.01." + 'M|baseyear'
.formel U|xdcurrdate    =  U|xdcurrdate & 1 
..: Define first date in previous year
.formel U|xdpre1date    = "08.01." + 'M|yearone'
.formel U|xdpre1date    =  U|xdpre1date & 1
..
..: Loop definition for process order dates for 12 dates
!PURORD0
.weiter PPAC000                                                 ?  U|xi = 13
..: Define date for current and previous year
.formel M|ppo0dt.xi     = 'U|xdcurrdate'
.formel M|ppo1dt.xi     = 'U|xdpre1date'
..
..: Define year
.formel M|ppo0yr.xi     = 'F|year(M|ppo0dt.xi)'
.formel M|ppo1yr.xi     = 'F|year(M|ppo1dt.xi)'
..
..: Define month
.formel M|ppo0mo.xi     = 'F|month(M|ppo0dt.xi)'
.formel M|ppo0mo.xi     =  F|trim(("0" +  'M|ppo0mo.xi'))       ?  F|length(M|ppo0mo.xi)  = 1
.formel M|ppo1mo.xi     = 'F|month(M|ppo1dt.xi)'
.formel M|ppo1mo.xi     =  F|trim(("0" +  'M|ppo1mo.xi'))       ?  F|length(M|ppo1mo.xi)  = 1
..
..: Define day
.formel M|ppo0dy.xi     = 'F|day(M|ppo0dt.xi)'
.formel M|ppo0dy.xi     =   F|trim(("0" +  'M|ppo0dy.xi'))      ?  F|length(M|ppo0dy.xi)    = 1
.formel M|ppo1dy.xi     = 'F|day(M|ppo1dt.xi)'
.formel M|ppo1dy.xi     =   F|trim(("0" +  'M|ppo1dy.xi'))      ?  F|length(M|ppo1dy.xi)    = 1
..
..
..: Increase counter and date (for next month)
.formel U|xi            =  U|xi + 1
.formel U|xdcurrdate    =  U|xdcurrdate & 21
.formel U|xdpre1date    =  U|xdpre1date & 21
..
.weiter PURORD0
..
..:===========================================================================
..: Preset dates for purchase packing slips
..:===========================================================================
!PPAC000
.formel U|xi            =  1
..: Define first date in current year
.formel U|xdcurrdate    = "06.01." + 'M|baseyear'
.formel U|xdcurrdate    =  U|xdcurrdate & 1 
..: Define first date in previous year
.formel U|xdpre1date    = "09.01." + 'M|yearone'
.formel U|xdpre1date    =  U|xdpre1date & 1
..
..: Loop definition for process order dates for 12 dates
!PURPAC0
.weiter PINV000                                                 ?  U|xi = 13
..: Define date for current and previous year
.formel M|pps0dt.xi     = 'U|xdcurrdate'
.formel M|pps1dt.xi     = 'U|xdpre1date'
..
..: Define year
.formel M|pps0yr.xi     = 'F|year(M|pps0dt.xi)'
.formel M|pps1yr.xi     = 'F|year(M|pps1dt.xi)'
..
..: Define month
.formel M|pps0mo.xi     = 'F|month(M|pps0dt.xi)'
.formel M|pps0mo.xi     =  F|trim(("0" +  'M|pps0mo.xi'))       ?  F|length(M|pps0mo.xi)  = 1
.formel M|pps1mo.xi     = 'F|month(M|pps1dt.xi)'
.formel M|pps1mo.xi     =  F|trim(("0" +  'M|pps1mo.xi'))       ?  F|length(M|pps1mo.xi)  = 1
..
..: Define day
.formel M|pps0dy.xi     = 'F|day(M|pps0dt.xi)'
.formel M|pps0dy.xi     =   F|trim(("0" +  'M|pps0dy.xi'))      ?  F|length(M|pps0dy.xi)    = 1
.formel M|pps1dy.xi     = 'F|day(M|pps1dt.xi)'
.formel M|pps1dy.xi     =   F|trim(("0" +  'M|pps1dy.xi'))      ?  F|length(M|pps1dy.xi)    = 1
..
..: Increase counter and date (for next month)
.formel U|xi            =  U|xi + 1
.formel U|xdcurrdate    =  U|xdcurrdate & 21
.formel U|xdpre1date    =  U|xdpre1date & 21
..
.weiter PURPAC0
..
..:===========================================================================
..: Preset dates for purchase invoices
..:===========================================================================
!PINV000
.formel U|xi            =  1
..: Define first date in current year
.formel U|xdcurrdate    = "07.01." + 'M|baseyear'
.formel U|xdcurrdate    =  U|xdcurrdate & 1 
..: Define first date in previous year
.formel U|xdpre1date    = "10.01." + 'M|yearone'
.formel U|xdpre1date    =  U|xdpre1date & 1
..
..: Loop definition for process order dates for 12 dates
!PURINV0
.weiter SERV000                                                 ?  U|xi = 13
..: Define date for current and previous year
.formel M|pin0dt.xi     = 'U|xdcurrdate'
.formel M|pin1dt.xi     = 'U|xdpre1date'
..
..: Define year
.formel M|pin0yr.xi     = 'F|year(M|pin0dt.xi)'
.formel M|pin1yr.xi     = 'F|year(M|pin1dt.xi)'
..
..: Define month
.formel M|pin0mo.xi     = 'F|month(M|pin0dt.xi)'
.formel M|pin0mo.xi     =  F|trim(("0" +  'M|pin0mo.xi'))       ?  F|length(M|pin0mo.xi)  = 1
.formel M|pin1mo.xi     = 'F|month(M|pin1dt.xi)'
.formel M|pin1mo.xi     =  F|trim(("0" +  'M|pin1mo.xi'))       ?  F|length(M|pin1mo.xi)  = 1
..
..: Define day
.formel M|pin0dy.xi     = 'F|day(M|pin0dt.xi)'
.formel M|pin0dy.xi     =  F|trim(("0" +  'M|pin0dy.xi'))      ?  F|length(M|pin0dy.xi)    = 1
.formel M|pin1dy.xi     = 'F|day(M|pin1dt.xi)'
.formel M|pin1dy.xi     =  F|trim(("0" +  'M|pin1dy.xi'))      ?  F|length(M|pin1dy.xi)    = 1
..
..: Increase counter and date (for next month)
.formel U|xi            =  U|xi + 1
.formel U|xdcurrdate    =  U|xdcurrdate & 21
.formel U|xdpre1date    =  U|xdpre1date & 21
..
.weiter PURINV0
..
..:===========================================================================
..: Preset dates for service process chain
..:===========================================================================
!SERV000
.formel U|xi            =  1
..
..: Loop definition for process order dates for 12 dates
!SERVCHAIN
.weiter END                                                     ?  U|xi = 4
..: Define first date in current year
.art GD2  xdserchai.xi                                          ? _F|defined(xdserchai.xi)
.formel U|xdserchai.xi  = "07.01." + 'M|yearone'
.formel U|xdserchai.xi  =  U|xdserchai.xi & 1 
..
..: Define date for current and previous year
.formel M|sei1dt.xi     = 'U|xdserchai.xi'
..
..: Define year
.formel M|sei1yr.xi     = 'F|year(M|sei1dt.xi)'
..
..: Define month
.formel M|sei1mo.xi     = 'F|month(M|sei1dt.xi)'
.formel M|sei1mo.xi     =  F|trim(("0" +  'M|sei1mo.xi'))       ?  F|length(M|sei1mo.xi)  = 1
..
..: Define day
.formel M|sei1dy.xi     = 'F|day(M|sei1dt.xi)'
.formel M|sei1dy.xi     =  F|trim(("0" +  'M|sei1dy.xi'))       ?  F|length(M|sei1dy.xi)  = 1
..
..: Define guarantee date
.formel M|seg1dt.xi     =  M|sei1dt.xi + 720
..
..: Define deployment year
.formel M|sed1yr.xi     = 'M|yearone'
..
..: Define date for service request
.formel M|ser1dt.xi     =  M|basedate - 90                      ?  U|xi = 1
.formel M|ser1dt.xi     =  M|basedate - 45                      ?  U|xi = 2
.formel M|ser1dt.xi     = "01.01." + 'M|baseyear'               ?  U|xi = 3
.formel M|ser1dt.xi     =  M|ser1dt.xi & 1
..
.formel M|ser1yr.xi     = 'F|year(M|ser1dt.xi)'
..
.formel M|ser1mo.xi     = 'F|month(M|ser1dt.xi)'
.formel M|ser1mo.xi     =  F|trim(("0" +  'M|ser1mo.xi'))       ?  F|length(M|ser1mo.xi)  = 1
..
.formel M|ser1dy.xi     = 'F|day(M|ser1dt.xi)'
.formel M|ser1dy.xi     =  F|trim(("0" +  'M|ser1dy.xi'))      ?  F|length(M|ser1dy.xi)    = 1
..
..: Define date for packing slip
.formel M|sep1dt.xi     = 'U|xdserchai.xi'
..
.formel M|sep1yr.xi     = 'F|year(M|sep1dt.xi)'
..
.formel M|sep1mo.xi     = 'F|month(M|sep1dt.xi)'
.formel M|sep1mo.xi     =  F|trim(("0" +  'M|sep1mo.xi'))       ?  F|length(M|sep1mo.xi)  = 1
..
.formel M|sep1dy.xi     = 'F|day(M|sep1dt.xi)'
.formel M|sep1dy.xi     =  F|trim(("0" +  'M|sep1dy.xi'))      ?  F|length(M|sep1dy.xi)    = 1
..
..: Increase counter and date (for next month)
.formel U|xi            =  U|xi + 1
..
.weiter SERVCHAIN
..
..
!END
.weiter
 
