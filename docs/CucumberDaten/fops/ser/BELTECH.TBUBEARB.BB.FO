..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BELTECH.TBUBEARB.BB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : launch tech reservation editor (BU8)
..*****************************************************************************
.set trans -
..
..<META M|='ser/BELTECH' >
..
.continue NEW ? F|empty(M|treserv)
..
!EDIT: edit existing reservation
.end 0 'F|formatstr("<(ServiceReservation)>{1}<(Edit)>", M|treserv^id)'
..
!NEW: Create new reservation
.end 0 'F|formatstr("<(ServiceReservation)><(New)>,(ServiceReservations) ? [insert]=1 | 1:resart=(OtherDate) | 1:techniker={1} | 1:termin={2}", M|ktechniker^id, M|twtdat:8)'
..
..*****************************************************************************
!END
.continue
