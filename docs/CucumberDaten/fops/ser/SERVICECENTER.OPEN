.. include ser/SERVICECENTER.AUFZU
..*****************************************************************************
.set trans -
.type bool xbauf ? _F|defined(U|xbauf)
..
!START
.copy U|xbauf=  G|FALSE
.select screen header
..
!ZEILE
.select screen line
.continue END ? _G|mehr
.continue ZEILE ? M|topen <> "icon:folder_closed"
.continue ZEILE ? M|tbaumstufe = M|anzstufen
.copy U|xbauf = G|TRUE
.input "ser/SERVICECENTER.AUFZU"
.continue ZEILE
..
!END
.continue START ? U|xbauf
.continue
