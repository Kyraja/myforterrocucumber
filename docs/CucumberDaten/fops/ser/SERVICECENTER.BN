..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERVICECENTER.BN
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.type realx  xramount    ? _F|defined(U|xramount)
.type realx  xbetrag     ? _F|defined(U|xbetrag)
.type realx  xrkurs      ? _F|defined(U|xrkurs)
.type ID94:1 xiwbu       ? _F|defined(U|xiwbu)
.type ID94:1 xland       ? _F|defined(U|xland)
.type ID94:1 xauswaehr   ? _F|defined(U|xauswaehr)
.type RP7.6  xrate       ? _F|defined(U|xrate)
.type IP1    xrundung    ? _F|defined(U|xrundung)
.type realx  xiwbuamount ? _F|defined(U|xiwbuamount)
..
.make screen line +O
.assign M|ttrans      = 7|id
.assign M|seranf      = 7|seranf ? F|defined(7|seranf)
.formula M|ttyp = 7|typa
.formula M|ttyp = 7|vorganga ? 7|typ = REKO
.formula M|ttyp = 7|lsart    ? 7|typ = LIKO
.formula M|tbaumstufe    = U|xistufe + 1
.continue MINUS                                  ? M|tbaumstufe > M|anzstufen & G|evtvar = "bstart"
.formula   M|topen       = M|iopen              ? M|tbaumstufe > 0
.formula   M|topen       = ""                   ? 7|typ = 5
.copy   M|tfold       = G|TRUE
.continue EINKAUF                                ? M|ttrans^dnr = 4
.continue VERKAUF                                ? M|ttrans^dnr = 3
.copy M|tursache    = 7|ursache
.copy M|tbearbeit   = 7|bearbeit
.. Serviceanfrage
.formula   M|ttyp1       = M|typ2a  ? M|ttrans^dnr = 122 & _7|ablagef
.formula   M|ttyp1       = M|typ2b  ? M|ttrans^dnr = 122 &  7|ablagef
.continue EINKAUF                    ? M|ttrans^dnr = 4
..
!VERKAUF
.formula M|tdate         = 7|vom
.assign M|sumnetto    = 7|sumnetto
.assign M|sumnettoinl = 7|sumnettoinl
.assign M|tvorgwaehr  = 7|land
.assign M|tauswaehr   = M|inlwaehr
.formula M|tsymbvorgw    = 7|land^symbol
.. Serviceangebot
.formula   M|ttyp2       = M|typ2a  ? 7|typ = 33 & _7|ablagef
.formula   M|ttyp2       = M|typ2b  ? 7|typ = 33 &  7|ablagef
.formula   U|xvtyp       = "(ServiceQuotation)"  ? 7|typ = 33
.. Serviceauftrag
.formula   M|ttyp3       = M|typ2a  ? 7|typ = 34 & _7|ablagef
.formula   M|ttyp3       = M|typ2b  ? 7|typ = 34 &  7|ablagef
.formula   U|xvtyp       = "(ServiceOrder)"      ? 7|typ = 34
.. VK-LS
.formula   M|ttyp4       = M|typ2a  ? 7|typ = 4  & _7|ablagef
.formula   M|ttyp4       = M|typ2b  ? 7|typ = 4  &  7|ablagef
.formula   U|xvtyp       = "(PackingSlip)"       ? 7|typ = 4
.. VK-RE
.formula   M|ttyp5       = M|typ2a  ? 7|typ = 5  & _7|ablagef
.formula   M|ttyp5       = M|typ2b  ? 7|typ = 5  &  7|ablagef
.formula   U|xvtyp       = "(Invoice)"           ? 7|typ = 5
.. Reparaturauftrag
.formula   M|ttyp6       = M|typ2a  ? 7|typ = 35 & _7|ablagef
.formula   M|ttyp6       = M|typ2b  ? 7|typ = 35 &  7|ablagef
.formula   U|xvtyp       = "(RepairOrder)"       ? 7|typ = 35
.. Kostenvoranschlag
.formula   M|ttyp7       = M|typ2a  ? 7|typ = 37 & _7|ablagef
.formula   M|ttyp7       = M|typ2b  ? 7|typ = 37 &  7|ablagef
.formula   U|xvtyp       = "(CostEstimate)"      ? 7|typ = 37
..
.copy M|tursache         = 7|serurs ? 7|typ = 37 ; 7|typ = 35 ; 7|typ = 34 ; 7|typ = 33
.formula   M|vorgart     = U|xvtyp
.continue SCHUTZ ? H|okopf^typ <> 35
.. LS aus ReparaturauftrÑge bekommen Icon fÅr Zu- oder Abgang
.formula M|lsabzu = M|zugang   ? 7|buart = 1 & 7|typ = 4
.formula M|lsabzu = M|abgang   ? 7|buart = 0 & 7|typ = 4
.continue SCHUTZ
..
!EINKAUF
.formula M|tdate         = 7|vom
.assign M|sumnetto    = 7|sumnetto
.assign M|sumnettoinl = 7|sumnettoinl
.assign M|tvorgwaehr  = 7|land
.assign M|tauswaehr   = M|inlwaehr
.formula M|tsymbvorgw    = 7|land^symbol
.. Bestellung
.formula   M|ttyp8       = M|typ2a           ?  7|typ = 3 & _7|ablagef
.formula   M|ttyp8       = M|typ2b           ?  7|typ = 3 &  7|ablagef
.formula   U|xetyp       = "(PurchaseOrder)" ?  7|typ = 3
.. EK-LS
.formula   M|ttyp9       = M|typ2a           ?  7|typ = 4 & _7|ablagef
.formula   M|ttyp9       = M|typ2b           ?  7|typ = 4 &  7|ablagef
.formula   U|xetyp       = "(PackingSlip)"   ?  7|typ = 4
.. EK-RE
.formula   M|ttyp10      = M|typ2a           ?  7|typ = 5 & _7|ablagef
.formula   M|ttyp10      = M|typ2b           ?  7|typ = 5 &  7|ablagef
.formula   U|xetyp       = "(Invoice)"       ?  7|typ = 5
.formula M|vorgart = U|xetyp
..
!SCHUTZ
.protection brerelease 'M|aktzeile'             ?  7|typ <> 3 & 7|typ <> 34 & 7|typ <> 35
.protection brerelease 'M|aktzeile'             ?  7|typ = 3  & 7|ablagef
.protection brerelease 'M|aktzeile'             ?  7|typ = 34 & 7|ablagef
.protection brerelease 'M|aktzeile'             ?  7|typ = 35 & 7|ablagef
.formula M|tpost       = M|view 
.formula M|tpost       = M|edit       ? _7|ablagef  & _F|empty(M|ttyp1)
..
.continue BSERVICE
..
.formula   M|vorgstatus    = 7|repstatus           ? 7|typ = 35 ; 7|typ = 37
.formula   M|vorgstatus    = 7|serstatus           ? 7|typ = 33 ; 7|typ = 34
.copy M|tbearbeit     = 7|betreuer            ? 7|typ <> 35
.formula   M|tnamebearbeit = 7|betreuer^sucherw    ? 7|typ <> 35
.formula   M|uebertr       = 7|uebertr
.formula   M|tbetreff      = 7|betreff
.formula   M|tdate         = 7|vom
.formula   M|trelease      = M|release               ? _7|ablagef
.formula   M|trelease      = ""                      ?  7|typ = 5
.formula   M|trelease      = ""                      ?  7|typ = 4  & _7|faktura
.formula   M|tpost         = M|post                  ?  7|uebertr
..
!BSERVICE
.assign M|ttrans      = 7|id
.assign M|seranf      = 7|seranf ? F|defined(7|seranf)
.formula M|ttyp = 7|typa
.formula M|ttyp = 7|vorganga ? 7|typ = REKO
.formula M|ttyp = 7|lsart    ? 7|typ = LIKO
.. Ordner entfernen wenn nicht mehr
.formula M|select = "$,,;okopf^typa="
.formula M|select = M|select + ";okopf="+M|ttrans^id+";kopf^typa=;kopf^nummer=;orig<>`"
.formula M|select = M|select + ";kopf^frzeich/" + M|frzeich                          ? _F|empty(M|frzeich)
.formula M|select = M|select + ";kopf^betreuer=" + M|betreuer^id                     ? _F|empty(M|betreuer)
.formula M|select = M|select + ";@ablageart=(Both);@gruppe=2;@ordnung=kopf"
.load 1 sales 'M|select'                ?  M|ttrans^dnr = 3
.load 2 purchasing 'M|select'           ?  M|ttrans^dnr = 4
.formula M|topen = ""                   ? _G|mehr
.formula   M|vorgstatus  = 7|anfstatus ? F|defined(7|anfstatus)
.formula   M|vorgstatus  = 7|repstatus ? F|defined(7|repstatus)
.formula   M|vorgstatus  = 7|serstatus ? 7|typ = 33 ; 7|typ = 34
.copy M|tauswaehr   = M|auswaehr
.formula   M|trelease    = ""                      ?  7|dnr = 122
.formula   M|tdate       = 7|anferfd               ?  7|dnr = 122
.assign M|tkunde      = 7|kunde                 ?  7|dnr <> 4
.assign M|tbetreuer   = 7|betreuer
.formula M|tfrzeich   = 7|frzeich
.formula   M|tnamebearbeit = M|tbearbeit^sucherw   ? 7|typ = 122
.formula   M|tdetail     = M|detail1
.formula   U|xramount    = 0
.continue
..
.. Umrechnungen
.formula U|xrundung    = M|auswaehr^nkst
.assign U|xrkurs    = 7|kurs
.copy U|xiwbu     = 7|iwbu
.copy U|xland     = 7|land
.copy U|xauswaehr = M|auswaehr
.formula U|xrate       = F|fxrate(M|auswaehr,7|budat,7|iwbu)
..
!ZEILE
.load 7 line
.continue TOTAL ? _G|mehr
..
.formula U|xbetrag  = F|round(U|xramount,U|xrundung)
.formula U|xramount = 7|npwert
..
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = U|xrate*U|xiwbuamount ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
..
.formula U|xramount      = U|xbetrag + F|round(U|xramount, U|xrundung)
.formula U|xramount      = U|xbetrag ? 7|typ = 16 ; 7|typ = 19 ; 7|typ = 8 ; 7|typ = 9 ; 7|typ = 10
..
.. Bruttorechnungen sind bei Endsumme zu ende
.continue TOTAL ? (7|typ = 16 ; 7|typ = 19) & 7|kobrutto
.continue ZEILE ? 7|ablagef
.continue ZEILE ? 7|art^gruppe <> 1
.continue ZEILE ? 7|kotyp <> 4
.continue ZEILE ? 7|dnr = 3 & 7|mge <= 0
..
.. wenn LS bereits gebucht, dann keine Kontrolle auf Lagerplatz nîtig
.continue ZEILE ? 7|kopf^uebertr = G|FALSE
..
.. Lagermengen auf einem Lagerplatz
.formula M|select = "$,,"
.formula M|select = M|select + ";artikel=" + 7|art^id
.formula M|select = M|select + ";platz="   + 7|platz^id
.formula M|select = M|select + ";@ablageart=(Active)"
.load 0 group "40:3" 'M|select'
.continue KEINLMGE ?  _G|mehr
.continue ZEILE    ?  7|dnr = 3 & 7|mge <= 0|bestand
..
!KEINLMGE: Kein Lagerbestand oder Lagerbestand kleiner als Liefermenge
.formula M|tshort = M|short
.continue ZEILE
..
!TOTAL: Summen
.formula M|teprice = U|xramount
.continue
..
!MINUS
.make screen line -O
.continue
