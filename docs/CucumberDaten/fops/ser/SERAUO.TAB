..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERAUO.TAB
.. Datum          : 19.06.2007
.. Version        : 2007r3n02
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Erstellt eine Zeile zu einer Vorgangsposition
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Zeilen-FOP
..
.. Functionality  : fills one row with data from a service order / offer
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : row efop
...Includes       :
..*****************************************************************************
.set trans -
..
.. Note: because of differing keys, we read service order positions
..       when selectiong outstanding service orders,
..       but read service order heads when selectiong history of
..       service orders / or reviews
..
.continue ARCHIV      ?  M|kbarchiv  ;  M|kbserano
..
!OBLIGO: outstanding start with a row
.select line 'selzeile'
.continue END     ? _T|mehr
.continue END     ? _( M|kbersatzt & H|artex^ersatzt ; M|kbverschlt & H|artex^verschlt ; _M|kbverschlt & _M|kbersatzt )
.continue END     ? H|alternativpos
.continue SHOWROW
..
!ARCHIV
.select line
.continue END     ? _T|mehr
.continue ARCHIV  ?  H|alternativpos
.continue ARCHIV  ?  M|kbdienstl           &   H|artex^gruppe  <> 5
.continue ARCHIV  ? _F|empty(M|kartex)     &   M|kartex^id     <>  H|artex^id
.continue ARCHIV  ? _F|empty(M|ktechniker) &   M|ktechniker^id <>  H|techniker^id
.continue ARCHIV  ? _F|empty(M|kserprod)   &   M|kserprod^id   <>  H|serprod^id
.continue ARCHIV  ? _F|empty(M|kartikel)   &   M|kartikel^id   <>  H|serprod^artikel^id
.continue ARCHIV  ? _F|empty(M|kprojekt)   &   M|kprojekt^id   <>  H|projekt^id
.continue ARCHIV  ? _( M|kbersatzt & H|artex^ersatzt ; M|kbverschlt & H|artex^verschlt ; _M|kbverschlt & _M|kbersatzt )
..
!SHOWROW
.make screen line +O
.copy M|tvorgang   = H|kopf
.assign M|tvom       = H|kopf^vom
.assign M|tkunde     = H|kopf^kunde
.assign M|tkunde2    = H|kopf^reempf
.assign M|tkunde3    = H|kopf^warenempf
.copy M|tartex     = H|artex
.formula   M|tmge       = H|mge
.formula   M|tlimge     = H|limge
.formula   M|tremge     = H|remge
.formula   M|tterm      = H|tterm
.copy M|tserprod   = H|serprod
.copy M|tprojekt = H|projekt
.copy M|tartikel   = H|serprod^artikel
.copy M|ttechniker = H|techniker
.formula   M|tbdienstl  = true            ? H|artex^gruppe = 5
.formula   M|tbverschlt = H|artex^verschlt
.formula   M|tbersatzt  = H|artex^ersatzt
.formula   M|tpreis     = H|preis
.formula   M|tproz      = H|proz
.copy M|tauswaeh   = H|pland
.copy M|tland      = H|pland
.formula   M|tpwert     = H|pwert
.. supplementary items are not required to have an unit, but might have one
.formula   M|the        = H|he            ? _F|empty(H|he)
.formula   M|tvpe       = H|pe            ? _F|empty(H|pe)
..
.continue ARCHIV  ?  M|kbarchiv  ;  M|kbserano
..*****************************************************************************
!END
.continue
