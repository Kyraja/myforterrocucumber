..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SAFAKTURA.EV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : as
.. Funktion       : Eventhandling Feldaustritt fr Kopffelder
.. Functionality  : event handling for field for header fields
...Includes       :
..*****************************************************************************
.set trans -
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.. kfaktpos must have a value to use the row-button to create an invoice
.. changing this field must not clear the table
.continue END     ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kfaktpos"
.continue END     ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbsammel"
.continue END     ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbzeigen
.. ----------- ---------- ---------- -------------------------------------------
.continue KUFA    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkunde"
.continue SERPR   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kserprod"
.continue ANFR    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfrage"
.. ----------- ---------- ---------- -------------------------------------------
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kvon"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbis"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbmitrechnung"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!KUFA: show name for customer
.continue TABINIT
..
!SERPR: show name for service product
.continue TABINIT
..
!ANFR: show customer for service request
.continue TABINIT ? F|empty(M|kanfrage)
.assign M|kkunde   = M|kanfrage^kunde^id
.assign M|kserprod = M|kanfrage^serprod^id
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
