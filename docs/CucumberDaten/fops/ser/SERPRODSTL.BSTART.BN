..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERPRODSTL.BSTART.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Nachbearbeitungs der Tabelle: l”scht doppelte Eintr„ge
.. Functionality  : post processing of displayed table: delete duplicate entries
..*****************************************************************************
.set trans -
..
.. row index for clearing duplicates
.type integer xizeile
.type PS2 xvartikel
.type P59 xvcharge
..
.. remove duplicate items
.. (not checking for possibly differing sales/spare/wear checkboxes)
..
.continue END     ? _M|kbduppruef
.select screen header
.continue END     ? _G|mehr
!NDUPLI
.select screen line
.continue END     ? _G|mehr
.formula U|xizeile   = M|aktzeile
.formula U|xvartikel = M|telex^id
.formula U|xvcharge  = M|tcharge^id
!NDELDUP
.select screen line
.continue EDELDUP ? _G|mehr
!DELDUP
.make screen line -O   ?  M|telex^id = U|xvartikel^id  &  M|tcharge^id = U|xvcharge^id
.continue NDUPLI          ?  M|aktzeile = U|xizeile
.continue DELDUP          ?  M|telex^id = U|xvartikel^id  &  M|tcharge^id = U|xvcharge^id
.continue NDELDUP
!EDELDUP
.select screen line 'U|xizeile'
.continue NDUPLI
..
..*****************************************************************************
!END
.continue
