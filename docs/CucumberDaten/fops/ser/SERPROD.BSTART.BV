..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERPROD.BSTART.BV
.. Datum          : 19.02.2007
.. Version        : 2007r1n00
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Startet die Selektion
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Button-Vor EFOP fuer Startbutton
..
.. Functionality  : starts selection
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : button before efop for start button
...Includes       :
..*****************************************************************************
.type text xNummer
.formula T|xNummer = "Nummer"
.set trans -
..
.formula M|select = "$,,;@ordnung=nummer"
.formula M|select = M|select + ";id="      + 'M|kprodukt^id'     ? _F|empty(M|kprodukt)
.formula M|select = M|select + ";aukunde=" + 'M|kaukunde^id'     ? _F|empty(M|kaukunde)
.formula M|select = M|select + ";kunde="   + 'M|kkunde^id'       ? _F|empty(M|kkunde)
.formula M|select = M|select + ";artikel=" + 'M|kartikel^id'     ? _F|empty(M|kartikel)
.formula M|select = M|select + ";charge="  + 'M|kcharge^id'      ? _F|empty(M|kcharge)
.. eignr is a text field, no ^id
.type text xteignr
.formula T|xteignr = F|regreplaceall('M|keignr', "/", "\\/")     ? _F|empty(M|keignr)
.formula M|select = M|select + ";eignr=`"  + 'T|xteignr'         ? _F|empty(M|keignr)
..
!START
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
