..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERPRODSTL.TAB
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Erstellt die Tabellenzeilen
.. Functionality  : Creates table rows
..*****************************************************************************
.set trans -
..
.. Search information (abas-EB "Ersatzteilkatalog")
.type integer   xi               ? _F|defined(U|xi)
.type text  xtrenn           ? _F|defined(U|xtrenn)
.type text  xid.kstufe       ? _F|defined(U|xid.kstufe)
.type text  xsuch.kstufe     ? _F|defined(U|xsuch.kstufe)
.formula U|xi = 0
.formula U|xtrenn = ";"
.formula U|xid.kstufe = 'H|elex^id'
.formula U|xsuch.kstufe = 'H|elex^such'
..
..
.. FILTER
..
.. all of the marked filter values have to match
.. otherwise abort and do not create a new row
.continue END     ?  M|kbverkauf  & _H|catsale
.continue END     ?  M|kbverschlt & _H|verschlt
.continue END     ?  M|kbersatz   & _H|ersatzt
..
..
.. NEW ROW
..
.make screen line +O
.. bom structure information
.formula M|tstufe = M|kstufe
.formula M|telserstl = H|elserstl
.. element data
.formula M|telex   = H|elex^id
.formula M|tvkbez  = H|elex^vkbez
.formula M|tvbez   = H|elex^vbezbspr
.formula M|tcharge = H|zcharge^id
.formula M|texnum  = H|zcharge^exnum
.formula M|tbverkauf  = H|catsale
.formula M|tbverschlt = H|verschlt
.formula M|tbersatz   = H|ersatzt
..
..
.. Search information (abas-EB "Ersatzteilkatalog")
.formula M|tsuchpfad = M|kprodukt^artikel^id
.formula M|tsuchtext = M|kprodukt^artikel^such
!NSUCH
.formula M|tsuchpfad = M|tsuchpfad + 'U|xtrenn' + 'U|xid.xi'
.formula M|tsuchtext = M|tsuchtext + 'U|xtrenn' + 'U|xsuch.xi'
.formula U|xi = U|xi + 1
.continue NSUCH   ?  U|xi <= M|kstufe
..
..*****************************************************************************
!END
.continue
