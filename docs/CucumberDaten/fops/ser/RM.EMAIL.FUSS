..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : RM.EMAIL.FUSS
.. Datum          : TT.MM.JJ
.. Version        :
.. Autor          : bheim
.. Verantwortlich : cl
.. Kontrolle      :
.. Funktion       :
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..   Argument     meaning
..   ---------------------------------------------------------
..   xp...        ...
..
.. Program flow   :
...Includes       :
..
.. **************************************************************
.. Funktion: Fuss der RÅckmeldung erstellen
.. **************************************************************
.set trans -
.type text xttele         ? _defined(xttele)
.type text xtfax          ? _defined(xtfax)
.type text xturlt         ? _defined(xturlt)
.type text xtemail        ? _defined(xtemail)
.type text xtvorsitz      ? _defined(xtvorsitz)
.type text xtvorstand     ? _defined(xtvorstand)
.type text xthrb          ? _defined(xthrb)
.type text xtabsfirma     ? _defined(xtabsfirma)
.type text xtabstele      ? _defined(xtabstele)
.type text xtabsurlt      ? _defined(xtabsurlt)
..
.load 0 company "$,,@gruppe=10"
.continue ENDFUSS       ? _T|mehr
.formula T|xtabsfirma = '0|knam1' + ", " + (0|str << ";") + ", " + '0|plz' + " " + (0|nort << ";")
.text xttele 'T|xspr' Service-Telefon
.text xtfax 'T|xspr' Service-Fax
.formula T|xtabstele  = ""
.formula T|xtabstele  = 'T|xttele' + ": " + '0|tele'              ? 0|tele <> ""
.formula T|xtabstele  =  T|xtabstele + ", "                       ? T|xtabstele<>"" & 0|fax<>""
.formula T|xtabstele  =  T|xtabstele + 'T|xtfax' + ": " + '0|fax' ? 0|fax <> ""
..
.text xturlt 'T|xspr' Homepage
.text xtemail 'T|xspr' E-Mail
.formula T|xtabsurlt  = ""
.formula T|xtabsurlt  = 'T|xturlt' + ": " + '0|urlt'                   ? 0|urlt <> ""
.formula T|xtabsurlt  =  T|xtabsurlt + ", "                            ? T|xtabsurlt<>"" & 0|email<>""
.formula T|xtabsurlt  =  T|xtabsurlt + 'T|xtemail' + ": " + '0|email'  ? 0|email<>""
..
.text xtvorsitz 'T|xspr' Vorsitzender des Aufsichtsrates
.formula T|xtvorsitz  = T|xtvorsitz + ": " + "Max Mustermann"
..
.text xtvorstand 'T|xspr' Vorstand
.formula T|xtvorstand = T|xtvorstand + ": " + "Helmut Meier"
.formula T|xthrb      = "HRB 0000, Amtsgericht Mannheim"
..

________________________________________________________________________________

'T|xtabsfirma                                                                  '
'T|xtabstele                                                                   '
'T|xtabsurlt                                                                   '
'T|xtvorsitz                                                                   '
'T|xtvorstand                                                                  '
'T|xthrb                                                                       '
.load 0
.continue

