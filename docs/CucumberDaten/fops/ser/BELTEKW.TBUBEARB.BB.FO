..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : BELTEKW.TBUBEARB.BB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : launch tech reservation editor (BU8)
..*****************************************************************************
.set trans -
..
..<META M|='ser/BELTEKW' >
..
.type I1 weekdaynum
.type P118:1 weekdayreserv
.type GD weekdaydate
..
.formula U|weekdaynum= 'G|evtvar' >> 1
..
.assign U|weekdayreserv = M|treserv.weekdaynum 
.formula U|weekdaydate = M|twtdat.weekdaynum
.formula U|weekdaydate = M|kvon + U|weekdaynum -1 ? F|empty(U|weekdaydate)
..
.continue NEW  ?  F|empty(U|weekdayreserv)
..
!EDIT
.end 0 'F|formatstr("<(ServiceReservation)>{3}<(Edit)> ? [insert]=1 | 1:techniker={1} | 1:termin={2}", M|ttechniker^id, U|weekdaydate:8, U|weekdayreserv^id)' 
..
!NEW
.end 0 'F|formatstr("<(ServiceReservation)><(New)>,(ServiceReservations) ? [insert]=1 | 1:techniker={1} | 1:termin={2}", M|ttechniker^id, U|weekdaydate:8)' 
..
..*****************************************************************************
!END
.continue
