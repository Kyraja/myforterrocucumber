..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SVERWEND.TAB
.. Datum          : 22.05.2007
.. Version        : 2007r3n00
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Erstellt eine Zeile im Infosystem
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : Zeilen-FOP
..
.. Functionality  : fills row with values
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : row fop
...Includes       :
..*****************************************************************************
.set trans -
..
.select line 'selzeile'
.continue END     ? _T|mehr
..
.make screen line +O
.colour -background -1 -1 -1 'M|aktzeile'
..
.formula   M|tstufe    = M|stufe
.assign M|tnummer   = H|nummer
.assign M|tkomp     = H|elex^id
.formula   M|teinsatzv = H|einsatzv
.formula   M|teinsatzb = H|einsatzb
.assign M|tbaugr    = H|artikel^id
.assign M|tserstl   = H|elserstl^id
.assign M|tserprod  = H|serprod^id
.. service / dienstleistung
.continue LOT  ?  H|gruppe <> 5
.assign M|tdienstl     = H|dienstl^id
..
!LOT: lot number / serial number
.assign M|tcharge   = H|zcharge^id
.formula   M|texnum    = H|zcharge^exnum
..
.. check boxes service item
.formula   M|tbersatz  = H|ersatzt
.formula   M|tbverschl = H|verschlt
.formula   M|tbarchiv  = H|serarchiv
..
.. sizes (not shown in default infosystem)
.formula   M|tlange    = H|lge
.copy M|tlaeein   = H|ellme         ?  H|lge <> 0
.formula   M|tbreite   = H|breite
.copy M|tbrein    = H|elbme         ?  H|breite <> 0
.formula   M|tanzahl   = H|anzahl
..
.. show structure
.formula   M|ttxstufe = 'M|tstufe'
.formula   M|ttxstufe = "------------"<<(M|stufe - 1) + 'M|tstufe'   ?  M|tstufe > 1
.formula   M|tbaumstat   = "+"                                       ?  M|tbaugr^id <> M|tserprod^artikel^id
..
.. mh, 08.09.2008: no tree for service bom
.formula   M|tbaumstat   = " "       ?  M|kbdienstl
.protection tbaumaufzu 'M|aktzeile'     ?  M|kbdienstl
..*****************************************************************************
!END
.continue
