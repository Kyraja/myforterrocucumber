..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SAINFO.EV
.. Datum          : 24.04.2007
.. Version        : 2007r2n01
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : as
.. Funktion       : Zentrales Event-FOP
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         :
..
.. Functionality  : central event efop
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
.. converse 1, ja, yes to 'T|true'
.type bool xb1
..
.type text xtErledigt
.set trans +
.formula T|xtErledigt     = "erledigt"
.set trans -
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue KUFA    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkunr"
.continue EXTDL   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kextdl"
.continue SERPR   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kserprod"
.continue STAART  ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kartikel"
.continue DESCR   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfbsch"
.continue STATUSA ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfsts"
.continue STATUSB ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbnostatus"
.continue STATUSB ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kboffen"
.continue STATUSB ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kberledigt"
.. ----------- ---------- ---------- -------------------------------------------
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfrage"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kverfdat"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kberfdat"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kextbeleg"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "ksertech"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfbearb"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfurs"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfpri"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kanfdrg"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!KUFA:
.continue TABINIT
..
!EXTDL:
.continue TABINIT
..
!SERPR:
.continue TABINIT
..
!STAART: Stammartikel
.continue TABINIT
..
!STATUSA: selbox status
.formula M|kbnostatus = false
.formula M|kberledigt = false
.formula M|kboffen = false
.continue TABINIT
..
!STATUSB: bool field status, only one may be checked, if none is checked unlock selbox
.formula T|xb1 = M|.evtvar
.formula M|.evtvar = 'T|xb1'
.formula M|kbnostatus = false    ? 'M|.T|evtvar' = 'T|true'  &  T|evtvar <> "kbnostatus"
.formula M|kberledigt = false    ? 'M|.T|evtvar' = 'T|true'  &  T|evtvar <> "kberledigt"
.formula M|kboffen    = false    ? 'M|.T|evtvar' = 'T|true'  &  T|evtvar <> "kboffen"
.formula M|kanfsts = T|xtErledigt ?  M|kberledigt
.protection "kanfsts" 0             ?  M|kbnostatus  ;  M|kberledigt  ;  M|kboffen
.protection -reset "kanfsts" 0      ? _M|kbnostatus  & _M|kberledigt  & _M|kboffen
.continue TABINIT
..
!DESCR: search for keywords in description
.formula M|kanfbsch = 'F|regreplace(M|kanfbsch, ";", "*")'   ?   +M|kanfbsch > 0
.continue TABINIT
..
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
