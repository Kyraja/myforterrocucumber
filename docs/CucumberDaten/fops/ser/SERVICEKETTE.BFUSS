.set trans -
.type bool xallenull ? _F|defined(U|xallenull)
..
.select screen header
..
!SELLINE
.select screen line
.continue END ? _G|mehr
.continue END ? M|tvorgang^dnr = 122
.copy U|xallenull = G|FALSE
.copy U|xallenull = G|TRUE ?  _F|empty(M|tvorgang) & M|limge = 0 & M|remge = 0 & M|lifrg = 0 & M|refrg = 0 & M|ils = 0 & M|ire = 0
.colour -background -1 -1 -1 'M|aktzeile'
.colour -background 'M|farbe' 'M|aktzeile'     ? _U|xallenull & _M|ablagef & _F|empty(M|tvorgang) & M|analyse & M|tvorgang^typ <> 35
.colour -background 'M|farbe' 'M|aktzeile'     ? _M|ablagef & _F|empty(M|tvorgang) & M|analyse & M|tvorgang^typ = 35
.continue SELLINE
..
..*****************************************************************************
!END
.continue
