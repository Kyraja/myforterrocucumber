..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERPRODSTL.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Liest komplette ServiceproduktstÅckliste
.. Functionality  : Reads complete service bom, all structure levels
..*****************************************************************************
.set trans -
..
.. missing required arguments
.continue ERRARG  ?  F|empty(M|kprodukt) & F|empty(M|kstl)
..
.. get service bom from serviceproduct if not filled
.formula M|kstl = M|kprodukt^serstl^id   ? F|empty(M|kstl)
..
.. update header output fields
.formula M|kcharge   = M|kprodukt^charge^id
.formula M|ktcharge  = M|kprodukt^tcharge
.formula M|keignr    = M|kprodukt^eignr
.formula M|kaukunde  = M|kprodukt^aukunde^id
.formula M|kkunde    = M|kprodukt^kunde^id
..
..
!START
.make screen line -- ? M|tzeilen > 0
.formula M|kstufe = 0
..
.select serviceproduct 'M|kstl^id'
.continue END     ? _G|mehr
..
!NEXT
.select line
.continue HOLE    ? _G|mehr & M|kstufe > 0
.continue END     ? _G|mehr
.input "ser/SERPRODSTL.TAB"
.continue NEXT    ?  F|empty(H|elserstl)
..
!MERK
.reserve lifo
.formula M|kstufe = M|kstufe + 1
.select serviceproduct 'H|elserstl^id'
.continue HOLE ? _G|mehr
.continue NEXT
!HOLE
.select lifo
.formula M|kstufe = M|kstufe - 1
.continue NEXT
..
..*****************************************************************************
!END
.continue
..
..
!ERRARG
.error Geben Sie ein Serviceprodukt oder eine ServiceproduktstÅckliste an!
.end 1
