..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SVERWEND.TBAUMAUFZU.BN
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Verwendungsbaum auf- und zuklappen
.. Functionality  : expands and closes the where-used list
...Includes       :
..*****************************************************************************
.set trans -
..
.type integer  xizeile
..
.input "is/ABASFARBEN.DEF"
..
.continue ZU      ? 'M|tbaumstat' = "-"
..
!AUF: expand full branch
.formula T|xizeile   = M|aktzeile
.formula M|select    = "$,,;@gruppe=3;elserstl=" + 'M|tnummer'
.formula M|stufe     = M|tstufe + 1
.formula M|tbaumstat = "-"
.input "is/HOL.LISTE"
.continue AUF     ?   M|aktzeile > T|xizeile
.formula M|tbaumstat = " "
.continue REPAINT
..
!ZU: close whole expanded branch
.formula M|stufe     = M|tstufe + 1
.formula M|tbaumstat = "+"
.formula T|xizeile   = M|aktzeile + 1
!ZU2
.select screen line 'T|xizeile'
.continue REPAINT ? _T|mehr
.continue REPAINT ?  M|stufe > M|tstufe
.make screen line -O
.continue REPAINT ?  T|xizeile > M|ozeilen
.continue ZU2
..
!REPAINT: repaint rows
.select screen header
!ROW
.select screen line
.continue END     ? _T|mehr
.colour -background -1 -1 -1 'M|aktzeile'
.continue ROW     ?  F|empty(M|tstufe)
.continue ROW     ?  M|tstufe = 1
.colour -background 'T|xabaslightgreen' 'M|aktzeile'
.continue ROW
..*****************************************************************************
!END
.continue
