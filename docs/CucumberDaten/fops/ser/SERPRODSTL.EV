.. Functionality  : Default events - field exits, insert row, etc.
..*****************************************************************************
.set trans -
..
.. event evaluation
.. ----------- ----- Infosystem Header -----------------------------------------
.continue PROD    ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kprodukt"
.continue PROD    ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kstl"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbersatz"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbverschlt"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbverkauf"
.continue INIT    ? G|evtartengl = "FIELD_EXIT"    & G|evtvar = "kbduppruef"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!PROD
.formula M|kstl      = M|kprodukt^serstl^id      ?  G|evtvar = "kprodukt"
.formula M|kprodukt  = M|kstl^serprod^id         ?  G|evtvar = "kstl"
.formula M|kcharge   = M|kprodukt^charge^id
.formula M|ktcharge  = M|kprodukt^tcharge
.formula M|keignr    = M|kprodukt^eignr
.formula M|kaukunde  = M|kprodukt^aukunde^id
.formula M|kkunde    = M|kprodukt^kunde^id
.continue INIT
..
!INIT: remove rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
