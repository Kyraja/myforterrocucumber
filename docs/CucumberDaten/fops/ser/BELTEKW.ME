.set trans -
..
.type integer   xitag
..
.assign T|xitag  = T|datum // 7
..
.assign M|kdatum = T|datum
.assign M|kkw    = T|datum
.assign M|kvon   = T|datum                     ? T|xitag = 1
.assign M|kvon   = T|datum - (T|xitag - 1)
.assign M|kbis   = T|datum                     ? T|xitag = 7
.assign M|kbis   = T|datum + (7 - T|xitag)
..
.assign M|kbrefresh = true
..
