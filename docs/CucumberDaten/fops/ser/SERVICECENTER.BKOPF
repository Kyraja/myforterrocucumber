..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERVICECENTER.BKOPF
.. Autor          : cl
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.type realx  xramount    ? _F|defined(U|xramount)
.type realx  xbetrag     ? _F|defined(U|xbetrag)
.type realx  xrkurs      ? _F|defined(U|xrkurs)
.type ID94:1 xiwbu       ? _F|defined(U|xiwbu)
.type ID94:1 xland       ? _F|defined(U|xland)
.type ID94:1 xauswaehr   ? _F|defined(U|xauswaehr)
.type RP7.6  xrate       ? _F|defined(U|xrate)
.type IP1    xrundung    ? _F|defined(U|xrundung)
.type realx  xiwbuamount ? _F|defined(U|xiwbuamount)
.type bool   xopen       ? _F|defined(U|xopen)
.type integer    xistufe     ? _F|defined(U|xistufe)
.type A162   xetyp       ? _F|defined(U|xetyp)
.type A163   xvtyp       ? _F|defined(U|xvtyp)
.type text   xtext       ? _F|defined(U|xtext)
.type integer xitzeile   ? _F|defined(U|xitzeile)
.type integer xtzeilen   ? _F|defined(U|xtzeilen)
..
.continue MASKE ? _F|defined(M|tbaumstufe)
.formula U|xistufe = M|tbaumstufe ?        M|tbaumstufe = 0
..
!MASKE
.select screen header       ? _U|xopen &  G|evtvar = "bstart" & G|evtartengl = "BUTTON_AFTER"
.make screen line +O
.formula   M|tbaumstufe = U|xistufe + 1 ? U|xopen ; G|evtvar = "topen" ; G|evtvar = "trelease"
.formula   M|topen      = M|iopen
.formula   M|topen      = ""            ? H|typ = 5
.formula   M|tfold      = G|TRUE
.continue DAT3   ? H|dnr = 3
.continue DAT122 ? H|dnr = 122
.continue DAT4   ? H|dnr = 4
..
!DAT122
.copy M|tursache    = H|ursache
.copy M|tbearbeit   = H|bearbeit
.formula M|tnamebearbeit = H|bearbeit^sucherw
.. Serviceanfrage
.formula   M|ttyp1       = M|typ2a  ? _H|ablagef
.formula   M|ttyp1       = M|typ2b  ?  H|ablagef
.text U|xtext 'G|bsprache' Serviceanfrage
.formula M|vorgart   = 'U|xtext'    
.continue SCHUTZ
..
!DAT3
.assign M|sumnetto    = H|sumnetto
.assign M|sumnettoinl = H|sumnettoinl
.formula M|nettosum = M|nettosum + M|sumnettoinl ? _F|empty(selvorgang)
.assign M|tvorgwaehr  = H|land
.assign M|tauswaehr   = M|inlwaehr
.formula M|tsymbvorgw    = H|land^symbol
.. Serviceangebot
.formula   M|ttyp2       = M|typ2a  ? H|typ = 33 & _H|ablagef
.formula   M|ttyp2       = M|typ2b  ? H|typ = 33 &  H|ablagef
.formula   U|xvtyp       = "(ServiceQuotation)"  ? H|typ = 33
.. Serviceauftrag
.formula   M|ttyp3       = M|typ2a  ? H|typ = 34 & _H|ablagef
.formula   M|ttyp3       = M|typ2b  ? H|typ = 34 &  H|ablagef
.formula   U|xvtyp       = "(ServiceOrder)"      ? H|typ = 34
.. VK-LS
.formula   M|ttyp4       = M|typ2a  ? H|typ = 4  & _H|ablagef
.formula   M|ttyp4       = M|typ2b  ? H|typ = 4  &  H|ablagef
.formula   U|xvtyp       = "(PackingSlip)"       ? H|typ = 4
.. VK-RE
.formula   M|ttyp5       = M|typ2a  ? H|typ = 5  & _H|ablagef
.formula   M|ttyp5       = M|typ2b  ? H|typ = 5  &  H|ablagef
.formula   U|xvtyp       = "(Invoice)"           ? H|typ = 5
.. Reaparaturauftrag
.formula   M|ttyp6       = M|typ2a  ? H|typ = 35 & _H|ablagef
.formula   M|ttyp6       = M|typ2b  ? H|typ = 35 &  H|ablagef
.formula   U|xvtyp       = "(RepairOrder)"       ? H|typ = 35
.. Kostenvoranschlag
.formula   M|ttyp7       = M|typ2a  ? H|typ = 37 & _H|ablagef
.formula   M|ttyp7       = M|typ2b  ? H|typ = 37 &  H|ablagef
.formula   U|xvtyp       = "(CostEstimate)"      ? H|typ = 37
..
.copy M|tursache         = H|serurs    ? H|typ = 37 ; H|typ = 35 ; H|typ = 34 ; H|typ = 33
..
.formula   M|vorgart     = U|xvtyp
.continue SCHUTZ
..
!DAT4
.assign M|sumnetto    = H|sumnetto
.assign M|sumnettoinl = H|sumnettoinl
.formula M|nettosum = M|nettosum + M|sumnettoinl ? _F|empty(selvorgang)
.assign M|tvorgwaehr  = H|land
.assign M|tauswaehr   = M|inlwaehr
.formula M|tsymbvorgw    = H|land^symbol
.. Bestellung
.formula   M|ttyp8       = M|typ2a                 ?  H|typ = 3 & _H|ablagef
.formula   M|ttyp8       = M|typ2b                 ?  H|typ = 3 &  H|ablagef
.formula   U|xetyp       = "(PurchaseOrder)"       ?  H|typ = 3
.. EK-LS
.formula   M|ttyp9       = M|typ2a                 ?  H|typ = 4 & _H|ablagef
.formula   M|ttyp9       = M|typ2b                 ?  H|typ = 4 &  H|ablagef
.formula   U|xetyp       = "(PackingSlip)"         ?  H|typ = 4
.. EK-RE
.formula   M|ttyp10      = M|typ2a                 ?  H|typ = 5 & _H|ablagef
.formula   M|ttyp10      = M|typ2b                 ?  H|typ = 5 &  H|ablagef
.formula   U|xetyp       = "(Invoice)"             ?  H|typ = 5
.formula M|vorgart = U|xetyp
..
!SCHUTZ
.protection brerelease 'M|aktzeile'                   ?  H|typ <> 3 & H|typ <> 34 & H|typ <> 35
.protection brerelease 'M|aktzeile'                   ?  H|typ = 3  & H|ablagef
.protection brerelease 'M|aktzeile'                   ?  H|typ = 34 & H|ablagef
.protection brerelease 'M|aktzeile'                   ?  H|typ = 35 & H|ablagef
.formula M|tpost = M|view
.formula M|tpost = M|edit       ? _H|ablagef  & _F|empty(M|ttyp1)
..
.assign M|ttrans = H|id
.assign M|seranf = H|seranf ? F|defined(H|seranf)
.formula M|ttyp = U|xtext                           ?  H|dnr = 122
.continue BSERVICE                                  ?  H|dnr = 122
.formula M|ttyp  = H|typa 
.formula M|ttyp  = H|vorganga ? H|typ = REKO
.formula M|ttyp  = H|lsart    ? H|typ = LIKO
..
.formula M|vorgstatus    = H|repstatus           ? H|typ = 35 ; H|typ = 37
.formula M|vorgstatus    = H|serstatus           ? H|typ = 33 ; H|typ = 34
.copy M|tbearbeit        = H|betreuer            ? H|typ <> 35
.formula M|tnamebearbeit = H|betreuer^sucherw    ? H|typ <> 35
.formula M|uebertr       = H|uebertr
.formula M|tbetreff      = H|betreff
.formula M|tdate         = H|vom
.formula M|trelease      = M|release             ? _H|ablagef
.formula M|trelease      = ""                    ? _H|ablagef & _F|empty(M|ttyp6)
.formula M|trelease      = ""                    ?  H|typ = 5
.formula M|trelease      = ""                    ?  H|typ = 4  & _H|faktura
.formula M|tpost         = M|post  ?  H|uebertr
..
.. Ordner entfernen wenn nicht mehr
.formula M|select = "$,,;okopf^typa=;@gruppe=2;okopf="+M|ttrans^id+";kopf^typa=;kopf^nummer=;orig<>`;@ablageart=(Both);@ordnung=kopf"
.load 1 sales 'M|select'            ?  M|ttrans^dnr = 3
.load 2 purchasing 'M|select'       ?  M|ttrans^dnr = 4
.formula M|topen = ""               ? _G|mehr
.continue CONTINUE
.. 
!BSERVICE
.load 9 object 'M|ttrans^id'
.continue            ? _G|mehr
.formula U|xitzeile = 1
.formula U|xtzeilen = 9|tzeilen
..
!SZEILE
.load 9 line
.formula M|topen = "" ? _G|mehr
.continue CONTINUE    ? _G|mehr
.continue LADEZEILE   ?  9|zn = U|xitzeile & U|xitzeile <= U|xtzeilen
..
!LADEZEI 
.copy U|xberst = G|FALSE
.load 8 sales '9|kostenv^id'
.continue SERAU      ? _G|mehr
.continue CONTINUE
..
!SERAU   
.load 8 sales '9|serau^id'
.continue REPAU      ? _G|mehr
.continue CONTINUE
..
!REPAU   
.load 8 sales '9|repau^id'
.continue EINKAUF               ? _G|mehr
.continue CONTINUE
..
!EINKAUF 
.load 8 purchasing '9|bextdl^id'
.continue IZEILE                ? _G|mehr
.continue CONTINUE
..
!IZEILE  
.formula U|xitzeile = U|xitzeile + 1
.continue SZEILE
..
!CONTINUE
.formula M|vorgstatus  = H|anfstatus ? F|defined(H|anfstatus)
.formula M|vorgstatus  = H|repstatus ? H|typ = 35 ; H|typ = 37
.formula M|vorgstatus  = H|serstatus ? H|typ = 33 ; H|typ = 34
.copy M|tauswaehr   = M|auswaehr
.formula   M|trelease    = ""                      ?  H|dnr = 122
.formula   M|tdate       = H|anferfd               ?  H|dnr = 122
.assign M|tkunde      = H|kunde^id              ?  H|dnr <> 4
.assign M|tbetreuer   = H|betreuer              ?  H|dnr <>122
.formula M|tfrzeich   = H|frzeich               ?  H|dnr <>122

.formula   M|tdetail     = M|detail1
.formula   U|xramount    = 0
.continue                                           ?  H|dnr = 122
..
.. Umrechnungen
.formula U|xrundung    = M|auswaehr^nkst
.assign U|xrkurs    = H|kurs
.copy U|xiwbu     = H|iwbu
.copy U|xland     = H|land
.copy U|xauswaehr = M|auswaehr
.formula U|xrate       = F|fxrate(M|auswaehr,H|budat,H|iwbu)
..
!ZEILE
.select line
.continue TOTAL ? _G|mehr
..
.formula U|xbetrag  = F|round(U|xramount,U|xrundung)
.formula U|xramount = H|npwert
..
.assign U|xiwbuamount = U|xramount / U|xrkurs
.assign U|xramount    = U|xiwbuamount ? U|xauswaehr = U|xiwbu & U|xiwbu <> U|xland
.assign U|xramount    = U|xramount    ? U|xauswaehr = U|xland
.assign U|xramount    = U|xrate*U|xiwbuamount ? U|xauswaehr<>U|xland & U|xauswaehr<>U|xiwbu
..
.formula U|xramount      = U|xbetrag + F|round(U|xramount, U|xrundung)
.formula U|xramount      = U|xbetrag ? H|typ = 16 ; H|typ = 19 ; H|typ = 8 ; H|typ = 9 ; H|typ = 10
..
.. Bruttorechnungen sind bei Endsumme zu ende
.continue TOTAL ? (H|typ = 16 ; H|typ = 19) & H|kobrutto
.continue ZEILE ? H|ablagef
.continue ZEILE ? H|art^gruppe <> 1
.continue ZEILE ? H|kotyp <> 4
.continue ZEILE ? H|dnr = 3 & H|mge <= 0
..
.. wenn LS bereits gebucht, dann keine Kontrolle auf Lagerplatz n”tig
.continue ZEILE ? H|kopf^uebertr = G|FALSE
..
.. Lagermengen auf einem Lagerplatz
.formula M|select = "$,,"
.formula M|select = M|select + ";artikel=" + H|art^id
.formula M|select = M|select + ";platz="   + H|platz^id
.formula M|select = M|select + ";@ablageart=(Active)"
.load 0 group "40:3" 'M|select'
.continue KEINLMGE ?  _G|mehr
.continue ZEILE    ?  H|dnr = 3 & H|mge <= 0|bestand
..
!KEINLMGE: Kein Lagerbestand oder Lagerbestand kleiner als Liefermenge
.formula M|tshort = M|short
.continue ZEILE
..
!TOTAL: Summen
.select - ? _F|empty(M|service) & _M|grliste = "122:1"
.select   ? _F|empty(M|service) & _M|grliste = "122:1"
.continue
