..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : RM.EMAIL.KOPF
.. Datum          : TT.MM.JJ
.. Version        :
.. Autor          : bheim
.. Verantwortlich : cl
.. Kontrolle      :
.. Funktion       :
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..   Argument     meaning
..   ---------------------------------------------------------
..   xp...        ...
..
.. Program flow   :
...Includes       :
..
.. ********************************************************
.. Funktion: RÅckmeldungskopf erstellen
.. ********************************************************
.set trans -
.type text xtknam1      ? _defined(xtknam1)
.type text xtabsfirma   ? _defined(xtabsfirma)
.type text xtan         ? _defined(xtan)
.type text xtvon        ? _defined(xtvon)
.type text xtvorg       ? _defined(xtvorg)
.type text xtdat        ? _defined(xtdat)
.type text xtbearb      ? _defined(xtbearb)
.type text xtans1       ? _defined(xtans1)
.type text xtans2       ? _defined(xtans2)
.type text xtans3       ? _defined(xtans3)
..
.text xtan 'xspr' An:
.text xtvon 'xspr' Von
.formula T|xtvon = T|xtvon + ":"
.text xtvorg 'xspr' Vorgangsnummer
.formula T|xtvorg = T|xtvorg + ":"
.text xtdat 'xspr' Datum
.formula T|xtdat = T|xtdat + ":"
.text xtbearb 'xspr' bearbeitet von:
..
.formula T|xtans1 = M|kunde^ans << ";"
.formula T|xtans2 = M|kunde^ans >> ";" << ";"
.formula T|xtans3 = M|kunde^ans >> ";" >> ";" << ";"
..
.load 0 company "$,,@gruppe=10"
.continue ENDKOPF       ? _T|mehr
.formula T|xtabsfirma = '0|knam1' + ", " + (0|str << ";") + ", " + '0|plz' + " " + (0|nort << ";")
________________________________________________________________________________

'xtabsfirma                                                                    '
________________________________________________________________________________

'xtan    ' 'xtans1                                     '
?           'xtans2                                     '   ? T|xtans2<>""
?           'xtans3                                     '   ? T|xtans3<>""

'xtdat   ' 'T|datum'  'xtbearb         ' 'M|tbearbeit^name                    '
________________________________________________________________________________

..
!ENDKOPF:
.load 0
.continue

