..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SAINFO.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : as
.. Funktion       : Stellt Selektionsstring zusammen
.. Functionality  : constructs selection string
...Includes       :
..*****************************************************************************
.set trans -
..
.. remember search string before setting filed / alive / both
.type text xtsel
..
.. selection with service request's id
.formula M|select = ""
.formula M|select = 'M|kanfrage^id'    ? _F|empty(M|kanfrage)
.continue START                         ? _F|empty(M|kanfrage)
..
.. check range on date
.continue ERRDATE  ?  M|kverfdat > M|kberfdat  &  _F|empty(M|kverfdat)  &  _F|empty(M|kberfdat)
..
.formula T|xtsel  = "$,,"
.formula T|xtsel  = T|xtsel + ";extnr="     + 'M|kextbeleg'                      ? _F|empty(M|kextbeleg)
.formula T|xtsel  = T|xtsel + ";bearbeit="  + 'M|kanfbearb^id'                   ? _F|empty(M|kanfbearb)
.formula T|xtsel  = T|xtsel + ";extdl="     + 'M|kextdl^id'                      ? _F|empty(M|kextdl)
.formula T|xtsel  = T|xtsel + ";techniker=" + 'M|ksertech^id'                    ? _F|empty(M|ksertech)
.formula T|xtsel  = T|xtsel + ";kunde="     + 'M|kkunr^id'                       ? _F|empty(M|kkunr)
.formula T|xtsel  = T|xtsel + ";anferfd="   + 'M|kverfdat' + "!" + 'M|kberfdat'  ? _F|empty(M|kverfdat) ; _F|empty(M|kberfdat)
.formula T|xtsel  = T|xtsel + ";serprod="   + 'M|kserprod^id'                    ? _F|empty(M|kserprod)
.formula T|xtsel  = T|xtsel + ";serprod^artikel= " + 'M|kartikel^id'             ? _F|empty(M|kartikel)
.formula T|xtsel  = T|xtsel + ";dringl="    + 'M|kanfdrg^id'                     ? _F|empty(M|kanfdrg)
.formula T|xtsel  = T|xtsel + ";ursache="   + 'M|kanfurs^id'                     ? _F|empty(M|kanfurs)
.formula T|xtsel  = T|xtsel + ";prio="      + 'M|kanfpri^id'                     ? _F|empty(M|kanfpri)
.formula T|xtsel  = T|xtsel + ";anfbesch~=`"+ 'M|kanfbsch'                       ? _F|empty(M|kanfbsch)
.formula T|xtsel  = T|xtsel + ";anfstatus=" + 'M|kanfsts'                        ? _M|kbnostatus & _M|kboffen & _M|kberledigt
.formula T|xtsel  = T|xtsel + ";anfstatus=(Completed)"                           ?  M|kberledigt
.formula T|xtsel  = T|xtsel + ";anfstatus<>(Completed)"                          ?  M|kboffen
..
.formula M|select = T|xtsel
..
!START
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
..
..
!ERRDATE: Fehler im Erfassungsdatum
.error Bitte geben Sie einen gÅltigen Zeitraum ein.
.cursor kverfdat 0
.end 1
