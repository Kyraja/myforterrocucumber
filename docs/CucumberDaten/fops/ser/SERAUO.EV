..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERAUO.EV
.. Datum          : 19.06.2007
.. Version        : 2007r3n02
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Zentrales Eventhandling
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
.. Ablauf         : FOP fr Feldaustritte und zum Blockieren der Zeilenoperationen
..
.. Functionality  : central eventhandling
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
.. Program flow   : efop for field exit and blocking of row operation
...Includes       :
..*****************************************************************************
.set trans -
..
.. event evaluation
.. ----------- ----- Kopfteil Button -------------------------------------------
.continue SERPROD ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kserprod"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kartex"
.continue DLON    ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbdienstl"    &  M|kbdienstl
.continue DLOFF   ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbdienstl"    & _M|kbdienstl
.. ----------- ---------- ---------- -------------------------------------------
.continue KTYPANO ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbserano"
.continue KTYPAUO ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbserauo"
.continue KTYPRAO ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbserrao"
.. ----------- ---------- ---------- -------------------------------------------
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbarchiv"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbersatzt"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbverschlt"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkunde"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkunde2"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kkunde3"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kartikel"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "ktechniker"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kvom"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kbis"
.continue TABINIT ? T|evtartengl = "FIELD_EXIT"    & T|evtvar = "kprojekt"
.. ----------- ---------- ---------- -------------------------------------------
.continue END
..
!DLON
.formula M|kbersatzt = false
.formula M|kbverschlt = false
.protection "kbersatzt" 0
.protection "kbverschlt" 0
.continue TABINIT
..
!DLOFF
.protection -reset "kbersatzt" 0
.protection -reset "kbverschlt" 0
.continue TABINIT
..
!SERPROD
.assign M|kartikel = M|kserprod^artikel^id
.continue TABINIT
..
!KTYPANO
.formula M|kbserauo = _M|kbserano
.formula M|kbserrao = _( M|kbserano ; M|kbserauo )
.continue TABINIT
!KTYPAUO
.formula M|kbserrao = _M|kbserauo
.formula M|kbserano = _( M|kbserauo ; M|kbserrao )
.continue TABINIT
!KTYPRAO
.formula M|kbserano = _M|kbserrao
.formula M|kbserauo = _( M|kbserrao ; M|kbserano )
.continue TABINIT
..
!TABINIT: a key field was changed, remove old rows
.make screen line -- ? M|tzeilen > 0
.continue END
..*****************************************************************************
!END
.continue
