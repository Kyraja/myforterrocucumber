..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SERAUO.BSTART.BV
.. Autor          : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Funktion       : Startbutton - Erstellt Selektionsstring
.. Functionality  : start button - builds selection query
...Includes       :
..*****************************************************************************
.set trans -
..
.. The infosystem offers two differeng selections
.. * show outstanding service orders       + restrictions
.. * show history of all service orders    + restirctions
..
.. Additional restrictions might be
.. * AR (debitor)
.. * customer (location)
.. * technician / service personnel
.. * service product
.. * master item
..
.. Note: because of differing keys, we read service order positions
..       when selectiong outstanding service orders,
..       but read service order heads when selectiong history of
..       service orders
..
.. show outstanding service orders or history of service orders?
.continue ARCHIV      ?  M|kbarchiv  ;  M|kbserano
.continue OBLIGO
..
!ARCHIV: history or "review" - reading head
.formula M|select = "$,,;ktyp=(33);wvorlage=yes;@ablageart=(Active)"     ?  M|kbserano  &  _M|kbarchiv
.formula M|select = "$,,;ktyp=(33);@ablageart=(3)"                       ?  M|kbserano  &   M|kbarchiv
.formula M|select = "$,,;ktyp=(34);@ablageart=(3)"                       ?  M|kbserauo
.formula M|select = "$,,;ktyp=(35);@ablageart=(3)"                       ?  M|kbserrao
.formula M|select = M|select + ";kunde="  + 'M|kkunde^id'                ? _F|empty(M|kkunde)
.formula M|select = M|select + ";reempf=" + 'M|kkunde2^id'               ? _F|empty(M|kkunde2)
.formula M|select = M|select + ";warenempf=" + 'M|kkunde3^id'            ? _F|empty(M|kkunde3)
.formula M|select = M|select + ";vom="    + 'M|kvom' + "!" + 'M|kbis'    ? _F|empty(M|kvom) ; _F|empty(M|kbis)
.formula M|select = M|select + ";@ordnung=nummer"
.. restrictions for positions have to be checked in row-fop!
.continue START
..
!OBLIGO: outstanding orders - reading position
.formula M|select = "$,,;kotyp=(34);aktiv=yes;@ablageart=(Active)"       ?  M|kbserauo
.formula M|select = "$,,;kotyp=(35);aktiv=yes;@ablageart=(Active)"       ?  M|kbserrao
.formula M|select = M|select + ";kopf^kunde="      + 'M|kkunde^id'       ? _F|empty(M|kkunde)
.formula M|select = M|select + ";kopf^reempf="     + 'M|kkunde2^id'      ? _F|empty(M|kkunde2)
.formula M|select = M|select + ";kopf^warenempf="  + 'M|kkunde3^id'      ? _F|empty(M|kkunde3)
.formula M|select = M|select + ";kopf^vom=" + 'M|kvom' + "!" + 'M|kbis'  ? _F|empty(M|kvom) ; _F|empty(M|kbis)
.formula M|select = M|select + ";serprod="         + 'M|kserprod^id'     ? _F|empty(M|kserprod)
.formula M|select = M|select + ";serprod^artikel=" + 'M|kartikel^id'     ? _F|empty(M|kartikel)
.formula M|select = M|select + ";techniker="       + 'M|ktechniker^id'   ? _F|empty(M|ktechniker)
.formula M|select = M|select + ";artex="           + 'M|kartex^id'       ? _F|empty(M|kartex)
.formula M|select = M|select + ";artex^gruppe=5"                         ?  M|kbdienstl
.formula M|select = M|select + ";artex^ersatzt=yes"                      ?  M|kbersatzt   & _M|kbverschlt
.formula M|select = M|select + ";artex^verschlt=yes"                     ?  M|kbverschlt  & _M|kbersatzt
.formula M|select = M|select + ";projekt=" + 'M|kprojekt^id'             ? _F|empty(M|kprojekt)
.formula M|select = M|select + ";@ordnung=kopf^nummer,zn"
..
!START
.make screen line -- ? M|tzeilen > 0
..*****************************************************************************
!END
.continue
