..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : RM.EMAIL.BUDRUCK.BV
.. Datum          : TT.MM.JJ
.. Version        :
.. Autor          : bheim
.. Verantwortlich : cl
.. Kontrolle      :
.. Funktion       :
..
.. Schnittstelle (Parameter und ihre Bedeutung)
..   verwendet Arrayparameter (arg.i)          : nein
..   verwendet Namensparameter (xpname=wert)   : nein
..
..   Parameter    Bedeutung
..   ---------------------------------------------------------
..   xp...        ...
..
.. Ablauf         :
..
.. Functionality  :
..
.. Interface (arguments and their meaning)
..   uses array argument (arg.i)           : no
..   uses name argument  (xpname=value)    : no
..
..   Argument     meaning
..   ---------------------------------------------------------
..   xp...        ...
..
.. Program flow   :
...Includes       :
..
.. *********************************************************
.. Funktion: Druck-Dialog vorbelegen
.. *********************************************************
.set trans +
.type text xtfeld    ? _defined(xtfeld)
.type text xtfehler  ? _defined(xtfehler)
..
.formula T|xtfehler = "Bitte geben Sie mindestens einen E-Mail-EmpfÑnger an."
.formula T|xtfeld   = "rman1"
.continue F1  ? M|rman1 = "" & M|rman2 = "" & M|rman3 = "" & M|rman4 = "" & M|rman5 = ""
..
.formula T|xtfehler = "Es ist keine E-Mail-Adresse vorhanden. Bitte eintragen."
.formula T|xtfeld = "rman1"  ? M|rman1 <> "" & M|rman1^email = ""
.continue F1                  ? M|rman1 <> "" & M|rman1^email = ""
.formula T|xtfeld = "rman2"  ? M|rman2 <> "" & M|rman2^email = ""
.continue F1                  ? M|rman2 <> "" & M|rman2^email = ""
.formula T|xtfeld = "rman3"  ? M|rman3 <> "" & M|rman3^email = ""
.continue F1                  ? M|rman3 <> "" & M|rman3^email = ""
.formula T|xtfeld = "rman4"  ? M|rman4 <> "" & M|rman4^email = ""
.continue F1                  ? M|rman4 <> "" & M|rman4^email = ""
.formula T|xtfeld = "rman5"  ? M|rman5 <> "" & M|rman5^email = ""
.continue F1                  ? M|rman5 <> "" & M|rman5^email = ""
..
.formula T|xtfehler = "Bitte geben Sie eine RÅckmeldung ein!"
.formula T|xtfeld = "rmtext"
.continue F1        ? M|rmtext = ""
..
.. Druck-Dialog-Felder vorbelegen
.formula P|layout  = "RM.EMAIL"
.formula P|drucker = "EMAILBILD"
.formula P|param1  = "RÅckantwort zu Ihrer Anfrage " + 'M|extnr'   ? M|extnr <> ""
.formula P|param1  = "RÅckantwort zu unserer Anfrage " + 'M|nummer'   ? M|extnr = "" & M|nummer<> ""
.formula P|email   =  ""
.formula P|email   = P|email + M|rman1^email    ? M|rman1 <> ""
.formula P|email   = P|email + ","              ? P|email <>"" & M|rman2 <> ""
.formula P|email   = P|email + M|rman2^email    ? M|rman2 <> ""
.formula P|email   = P|email + ","              ? P|email <>"" & M|rman3 <> ""
.formula P|email   = P|email + M|rman3^email    ? M|rman3 <> ""
.formula P|email   = P|email + ","              ? P|email <>"" & M|rman4 <> ""
.formula P|email   = P|email + M|rman4^email    ? M|rman4 <> ""
.formula P|email   = P|email + ","              ? P|email <>"" & M|rman5 <> ""
.formula P|email   = P|email + M|rman5^email    ? M|rman5 <> ""
.continue
.. ------------------------------------------------------------------------------
!F1: keine EmpfÑnger vorhanden
.error 'xtfehler'
.cursor 'xtfeld' 0
.end 1

