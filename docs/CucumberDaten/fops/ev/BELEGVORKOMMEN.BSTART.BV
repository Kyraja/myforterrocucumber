..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BELEGVORKOMMEN.BSTART.BV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Validiert Eingaben, formuliert DB-Anfrage und setzt Stufen.
.. Functionality  : Validates inputs, creates query and sets levels.
..*****************************************************************************
.set trans -
..
.. Validate input fields
.continue ERROR01 ? F|empty(M|abteilung)
..
.type bool issales
.copy U|issales = F|equals(M|abteilung, "(Sales)")
.continue ERROR02 ? _U|issales & F|empty(M|ekpartner) & F|empty(M|resteller) & F|empty(M|betreuer)
.continue ERROR02 ?  U|issales & F|empty(M|vkpartner) & F|empty(M|reempf) & F|empty(M|betreuer)
.continue ACTIVE  ? F|empty(M|vomvom) ; F|empty(M|vombis)
.continue ERROR04 ? M|vomvom > M|vombis
.continue START
..
!ACTIVE: bl needs no period if filing mode is active
.continue CHDATE ? F|equals(M|ablageart, "(Active)")
.continue ERROR03
..
!CHDATE: Checkdate
.continue ERROR04 ? _(F|empty(M|vomvom) ; F|empty(M|vombis)) & M|vomvom > M|vombis
..
!START: Which start or end level?
.assign M|startstufe = 0
.assign M|startstufe = 12 ? M|anz
.assign M|startstufe = 11 ? M|bar
.assign M|startstufe = 10 ? M|kaufgut
.assign M|startstufe = 9  ? M|kuli
.assign M|startstufe = 8  ? M|rueli
.assign M|startstufe = 7  ? M|reko
.assign M|startstufe = 6  ? M|liko
.assign M|startstufe = 5  ? M|ekabko ; M|vkabko
.assign M|startstufe = 4  ? M|wako
.assign M|startstufe = 3  ? M|ekanko ; M|vkanko
.assign M|startstufe = 2  ? M|rahmen
.assign M|startstufe = 1  ? M|chko
.continue ERROR00         ? M|startstufe = 0
..
.assign M|endstufe = 0
.assign M|endstufe = 1  ? M|chko
.assign M|endstufe = 2  ? M|rahmen
.assign M|endstufe = 3  ? M|ekanko ; M|vkanko
.assign M|endstufe = 4  ? M|wako
.assign M|endstufe = 5  ? M|ekabko ; M|vkabko
.assign M|endstufe = 6  ? M|liko
.assign M|endstufe = 7  ? M|reko
.assign M|endstufe = 8  ? M|rueli
.assign M|endstufe = 9  ? M|kuli
.assign M|endstufe = 10 ? M|kaufgut
.assign M|endstufe = 11 ? M|bar
.assign M|endstufe = 12 ? M|anz
..
.. Reset query
.formula M|preselect = "$,,"
..
.. Which division?
.continue PURCHAS ? _U|issales
..
!SALES: Which databases?
.assign M|grliste = "3:1"
..
.. Which partner?
.continue RECEIPT ? F|empty(M|vkpartner)
.formula M|preselect = F|formatstr("{1};kl={2}", M|preselect, M|vkpartner^id)
..
!RECEIPT: Invoice recipient
.continue PERIOD ? F|empty(M|reempf)
.formula M|preselect = F|formatstr("{1};kl2={2}", M|preselect, M|reempf^id)
.continue PERIOD
..
!PURCHAS: Which databases?
.assign M|grliste = "4:1"
..
.. Which partner?
.continue PARTY ? F|empty(M|ekpartner)
.formula M|preselect = F|formatstr("{1};kl={2}", M|preselect, M|ekpartner^id)
..
!PARTY: Invoicing party
.continue PERIOD ? F|empty(M|resteller)
.formula M|preselect = F|formatstr("{1};kl2={2}", M|preselect, M|resteller^id)
..
!PERIOD: Which period?
.continue STAFFER ? F|empty(M|vomvom) & F|empty(M|vombis)
.formula M|preselect = F|formatstr("{1};vom={2}!{3}", M|preselect, M|vomvom:8, M|vombis:8)
..
!STAFFER: Which staff personnel?
.continue FILING ? F|empty(M|betreuer)
.formula M|preselect = F|formatstr("{1};betreuer={2}", M|preselect, M|betreuer^id)
..
!FILING: Which filing mode?
.formula M|preselect = F|formatstr("{1};@ablageart={2}", M|preselect, F|value(M|ablageart, "AS193"))
..
.. Which document type?
.formula M|preselect = M|preselect + ";typ=={1}"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR00: Type of document is missing
.error -line 0 -field M|chko -message Es fehlt die Angabe mindestens einer Belegart!
.continue BREAK
..
!ERROR01: Division is missing
.error -line 0 -field M|division -message Es fehlt die Angabe der Abteilung!
.continue BREAK
..
!ERROR02: Partner is missing
.error -line 0 -field M|vkpartner -message Es fehlt die Angabe des Gesch„ftspartners oder Betreuers! ?  U|issales
.error -line 0 -field M|ekpartner -message Es fehlt die Angabe des Gesch„ftspartners oder Betreuers! ? _U|issales
.continue BREAK
..
!ERROR03: Period is incomplete
.error -line 0 -field M|vomvom -message Zeitraum ist nicht vollst„ndig
.continue BREAK
..
!ERROR04: Period is illegal
.error -line 0 -field M|vomvom -message Zeitraum ist falsch, bitte korrigieren
..
!BREAK
.end 1
