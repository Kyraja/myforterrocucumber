..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.CACHE.VP5.IN.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : Kunden/Lieferanten zu externen Angaben ermitteln
..*****************************************************************************
.set trans -
..
.. search fields must defined
.type text xsuchsteunr ? _F|defined(U|xsuchsteunr)
.type text xsuchustid  ? _F|defined(U|xsuchustid)
.type text xsuchgln    ? _F|defined(U|xsuchgln)
.type bool xskippLIEF  ? _F|defined(U|xskippLIEF)
.type bool xskippKUN   ? _F|defined(U|xskippKUN)
.type VP5 xgefundenVP5 ? _F|defined(U|xgefundenVP5)
..
..*****************************************************************************
..
.. create variablen name from parameters
.. remove all non-valid symbols (should be none, but better not risk FO complications)
.type text xvp5name ? _F|defined(U|xvp5name)
.formula U|xvp5name = F|formatstr("X{1}X{2}X{3}X{4}X{5}", U|xsuchsteunr, U|xsuchustid, U|xsuchgln, U|xskippLIEF, U|xskippKUN)
.formula U|xvp5name = F|regreplaceall(U|xvp5name, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^\ \-]", "")
..
.continue KNOWN ? F|defined(U|.xvp5name)
..
.type VP5 U|.xvp5name 
.copy    U|.xvp5name = U|xgefundenVP5
.continue SAVED
..
..*****************************************************************************
.continue
..
!SAVED
.. .println Der Wert fÅr Suche 'U|xvp5name' wurde als 'U|xgefundenVP5' in den Cache gesetzt.
.continue 
..
!KNOWN
.. .println Der Wert fÅr Suche 'U|xvp5name' war bereits gecacht.
.continue
