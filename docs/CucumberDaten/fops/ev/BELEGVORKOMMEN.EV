..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : BELEGVORKOMMEN.EV
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Behandelt zentral die Feld und Zeilenereignisse.
.. Functionality  : Central handling of field and row events.
..*****************************************************************************
.set trans -
..------------------------------- Header:  -------------------------------------
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ablageart"
.continue DIVOLD  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "abteilung"
.continue DIVISON ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "abteilung"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vomvom"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vombis"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "vkpartner"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ekpartner"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "betreuer"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "chko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "rahmen"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "vkanko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "ekanko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "wako"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "vkabko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "ekabko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "liko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "reko"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "rueli"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "kuli"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "kaufgut"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "bar"
.continue CLRREP  ? G|evtartengl = "FIELD_FILL" & G|evtvar = "anz"
.continue CRITDOC ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kkritisch"
.continue CLRREP  ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "ktterm"
..==============================================================================
.continue END
..
!CRITDOC: Critical documents clicked
.continue CLRREP ? _M|kkritisch
.continue CLRREP ? _F|empty(M|ktterm)
.assign M|ktterm = G|datum
.continue CLRREP
..
!DIVOLD: Fill field "division"
.continue OLDDIV ? G|evtfeldneu = ""
.continue END
..
!OLDDIV: reset to old value while new value is empty
.assign G|evtfeldneu = F|value(M|abteilung, "AS7")
.continue END
..
!DIVISON: Exit field "division"
.continue PURCHAS ? F|equals(M|abteilung, "(Purchasing)")
.continue SALES
..
!PURCHAS: "division" is purchasing
.protection vkpartner 0
.protection vkanko 0
.protection vkabko 0
.protection chko 0
.protection wako 0
.protection kuli 0
.assign M|vkpartner = ""
.copy M|vkanko = G|FALSE
.copy M|vkabko = G|FALSE
.copy M|wako = G|FALSE
.copy M|chko = G|FALSE
.copy M|kuli = G|FALSE
.protection -reset ekpartner 0
.protection -reset ekanko 0
.protection -reset ekabko 0
.assign P|maskkontextfop = F|value(M|abteilung, "AS7")
.assign M|grliste = "4:1"
.copy M|kritischefop = M|ekkritischefop
.continue CLRREP
..
!SALES: "division" is sales
.assign M|abteilung = "(Sales)"
.protection ekpartner 0
.protection ekanko 0
.protection ekabko 0
.assign M|ekpartner = ""
.copy M|ekabko = G|FALSE
.copy M|ekanko = G|FALSE
.protection -reset vkpartner 0
.protection -reset vkanko 0
.protection -reset vkabko 0
.protection -reset chko 0
.protection -reset wako 0
.protection -reset kuli 0           
.assign P|maskkontextfop = F|value(M|abteilung, "AS7")
.assign M|grliste = "3:1"
.copy M|kritischefop = M|vkkritischefop
.continue CLRREP
..
!CLRREP: Clear report
.input "ev/BELEGVORKOMMEN.BK"
..
!CLRTAB: Clear table
.input "is/TABLEEREN"
..*****************************************************************************
!END
.continue
