..
!SORT5: U|xtvkdat sortieren und an U|xtdat h„ngen
.continue END ? F|empty(U|xtvkdat)
.formula xtsys="sort -t# +0n +5n " + U|xtvkdat + " >>" + U|xtdat
.system 'xtsys' background
.continue ERROR1 ? _G|mehr
.continue END
!END
.input 'U|xtdat'
.continue
