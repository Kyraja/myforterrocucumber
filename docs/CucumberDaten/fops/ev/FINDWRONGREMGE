.continue T5REFFER
..
!T5REFFER: wenn Vorg„nger = Auftrag oder Rechnung mit Lagerbewgung und kein Vorg„nger
.load 7 sales 'U|xvktreffer'
.continue LOAD5 ? _G|mehr
.continue A5DDEDTO
..
!A5DDEDTO
.output addedto 'U|xtvkdat'
'7|kopf^nummer         '# '7|kopf^such    '# '7|id       '# '7|artikel^nummer '# '7|artikel^such '# '7|kotyp '# '7|kotypa    '# '5|kopf^nummer'
.output
