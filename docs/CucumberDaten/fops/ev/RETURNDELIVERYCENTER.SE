..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : RETURNDELIVERYCENTER.SE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
.input "is/ABASFARBEN.DEF"
.formula M|coloryellow = U|xabaslightyellow
..
.. default Einkauf
.copy M|beinkauf = G|TRUE
.copy M|bverkauf = G|FALSE
.assign P|maskkontextfop = "Einkauf"
.protection kunde 0
.protection vkvorg 0
.copy M|bnullzeile = G|TRUE
..
.. Set start date to 1st day one month ago
.assign M|von = F|fystartdate(F|getfy(G|datum), F|getfm(G|datum))
.assign M|von = M|von - 1
.assign M|von = F|fystartdate(F|getfy(M|von), F|getfm(M|von))
.copy M|bis = F|date('G|datum:8')
..
..*****************************************************************************
!END
.continue
