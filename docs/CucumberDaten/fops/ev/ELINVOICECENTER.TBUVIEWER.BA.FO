..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICECENTER.TBUVIEWER.BA.Fo
.. Author         : mh
.. Verantwortlich : teaminfosysteme
.. Kontrolle      :   
.. Functionality  : Open the HTML-Viewer for an E-Invoice, 
..                  Assuming the xml is inside the ftext of its EDI message
..include ev/ELINVOICE.VIEWER.FO
..*****************************************************************************
.set trans -
..           
.. Clear viewer
.formula M|khtmldateiname = ""
..
.. Nothing to do
.continue END ? F|empty(M|edinr)
..
..
.. PARAMTERS  
..   1) edi message containing the xml data
..   2) target url field
..
.type P53:0 xedi ? _F|defined(U|xedi)
.type text urlfield ? _F|defined(U|urlfield)
..
.. Generate html file for new line
.formula U|xedi = M|edinr^id
.formula U|urlfield = "M|khtmldateiname"
.input "ELINVOICE.VIEWER.FO"
..
..*****************************************************************************
!END
.continue

