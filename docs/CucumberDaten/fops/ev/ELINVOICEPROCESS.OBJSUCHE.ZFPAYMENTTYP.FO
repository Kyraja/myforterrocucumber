..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.ZFPAYMENTTYP.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type text xtext  ? _F|defined(U|xtext)
..
..<META M|='ev/ELINVOICEPROCESS'>
..
.type text xvaluestring ? _F|defined(U|xvaluestring)
.formula U|xvaluestring = 'M|SpecifiedTradePaymentMeans'
..
.colour -background -1 -1 -1  zfpaymenttypazk
..
.continue EMPTY  ? F|empty(U|xvaluestring) 
.continue NOAUFZ ? U|xvaluestring="0"
..
.. Leider lîst F|isvalue(Wert, AUFZAEHLUNG)
..    .continue NOAUFZ ? _F|isvalue(U|xvaluestring, "AZK20406")
.. eine Auswahlmenu aus, wenn der Wert xvaluestring nicht in der auf 
.. AufzÑhlung enthalten ist, statt einfach nur FALSE zu antworten.
.. daher statt dessen ein grosses IF mit den erlaubten Werten
.. Bargeld, Scheck, öberweisung, Zahlung Bankkonto, Kartenzahlung, Lastschrift, Dauerauftrag
.. SEPA öberweisung, SEPA Lastschrift, Report
.continue NOAUFZ ? U|xvaluestring<>"10" & U|xvaluestring<>"20" & U|xvaluestring<>"30" & U|xvaluestring<>"42" & U|xvaluestring<>"48" & U|xvaluestring<>"49" & U|xvaluestring<>"57" & U|xvaluestring<>"58" & U|xvaluestring<>"59" & U|xvaluestring<>"91"
..
.assign M|zfpaymenttypazk =  U|xvaluestring 
.. öberweisung / SEPA öberweisung
.assign M|zaform = "(Transfer)"     ? U|xvaluestring="58" ; U|xvaluestring="30"
.. Lastschrift / SEPA Lastschrift
.assign M|zaform = "(DebitNote)"    ? U|xvaluestring="49" ; U|xvaluestring="59"
.colour -background -1 -1 -1 bbiban
.. Scheck
.assign M|zaform = "(Check)"        ? U|xvaluestring="20"
.. alle Åbrigen auf Leer setzen
.assign M|zaform = "(EmptyEntry)"   ? F|empty(M|zaform)
.continue AUFZLEER  ? F|empty(M|zaform)
..
..*****************************************************************************
.continue
..
!EMPTY
.formula U|xtext = F|formatstr("Der SchlÅssel Zahlungsart fehlt!")
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.colour -background 'U|xabasyellow' zfpaymenttypazk
.continue
..
!AUFZLEER
.formula U|xtext = F|formatstr("Die angegebene Zahlungsart {1} wird nicht unterstÅtzt.", 'M|SpecifiedTradePaymentMeans')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.colour -background 'U|xabasyellow' zfpaymenttypazk
.continue
.. 
!NOAUFZ
.formula U|xtext = F|formatstr("Der angegebene SchlÅssel fÅr die Zahlungsart {1} ist nicht bekannt.", 'M|SpecifiedTradePaymentMeans')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.colour -background 'U|xabasyellow' zfpaymenttypazk
.continue

