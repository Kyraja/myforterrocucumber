.set trans -
..
..<META M|='ev/ELINVOICECENTER'>
..
.end 1 ? M|aktzeile = 0 
.continue ERRDEAC ? F|equals(M|edinr^edistatusaz, "(Deactivated)")
.continue NOFTEXT ? F|empty(M|edinr^nachrftext)
.continue NOVABM  ? F|empty(M|vabmodell)
..
..*****************************************************************************
.continue
..
!NOVABM
.error Nachricht 'M|edinr^nummer' hat kein Verarbeitungs-Abbildungsmodell.
.end 1
..
!ERRDEAC
.error Nachricht 'M|edinr^nummer' hat bereits Status 'M|edinr^edistatusaz' und wird nicht weiter verarbeitet.
.end 1
..
!NOFTEXT
.error Nachricht 'M|edinr^nummer' enth„lt keine XML-Nachricht im Freitext.
.end 1
