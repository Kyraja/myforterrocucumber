..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PLANNEDINVOICES.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
.type text         xtfakturasel ? _F|defined(U|xtfakturasel)
.type IP6          xanzrech     ? _F|defined(U|xanzrech)
.type IP6          xanzanz      ? _F|defined(U|xanzanz)
.type text         xtcmd        ? _F|defined(U|xtcmd)
.type ID4:1.2      xbestellung  ? _F|defined(U|xbestellung)
.type ID3:1.2      xauftrag     ? _F|defined(U|xauftrag)
.type ID3:22.28.29 xvid         ? _F|defined(U|xvid)
.type ID4:22       xeid         ? _F|defined(U|xeid)
..
.formula U|xanzrech = 0
.formula U|xanzanz  = 0
..
.. Kopf
.continue TABLEEREN ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue PLANREDAT ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "planredatvon"
.continue PLANREDAT ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "planredatbis"
.continue FAELLIG   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "faelligvon"
.continue FAELLIG   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "faelligbis"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "reart"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kunde"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "lief" 
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "rechempf"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "rechsteller"
.continue EKVK      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "verkauf"
.continue EKVK      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "einkauf"
.continue KAUFTRAG  ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kauftrag"
.continue TABLEEREN ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kbestellung"
.continue SER       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "serauftrag"
.continue REP       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "repauf"
.continue BUGROUP   ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bgeplant"
.continue BUGROUP   ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bfakt"
.continue BUGROUP   ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bgebucht"
.continue BUGROUP   ? G|evtartengl = "FIELD_FILL"   & G|evtvar = "bbezahlt"
.continue SEL       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "selplanredat"
.continue SEL       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "selfaellig"
.continue MASK      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bgeplant" 
.continue MASK      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bfakt"
.continue MASK      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bgebucht"
.continue MASK      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bbezahlt"
.continue END
..
!SER
.continue TABLEEREN ? F|empty(M|serauftrag)
.formula M|repauf = ""
.formula M|kauftrag = ""
.continue TABLEEREN
..
!REP
.continue TABLEEREN ? F|empty(M|repauf)
.formula M|serauftrag = ""
.formula M|kauftrag = ""
.continue TABLEEREN
..
!KAUFTRAG
.continue TABLEEREN ? F|empty(M|kauftrag)
.formula M|repauf = ""
.formula M|serauftrag = ""
.continue TABLEEREN
..
!SEL
.copy M|selfaellig   = G|FALSE   ?  M|selfaellig & G|evtvar = "selplanredat"
.copy M|selplanredat = G|FALSE   ?  M|selplanredat  & G|evtvar = "selfaellig"
.copy M|selplanredat = G|TRUE    ? _M|selfaellig & _M|selplanredat
.continue TABLEEREN
..
!BUGROUP
.formula M|bugruppe = M|bugruppe + 1 ? 'G|evtfeldneu' = 'G|TRUE'
.formula M|bugruppe = M|bugruppe - 1 ? 'G|evtfeldneu' = 'G|FALSE'
.continue UNDOBUT                    ? M|bugruppe = 0
.continue TABLEEREN
..
!MASK
.assign P|maskkontextfop = "geplant Einkauf"                      ? M|einkauf & M|bgeplant & _M|bfakt & _M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "fakt Einkauf"                         ? M|einkauf & M|bfakt & _M|bgeplant & _M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "gebucht Einkauf"                      ? M|einkauf & M|bgebucht & _M|bfakt & _M|bgeplant & _M|bbezahlt
.assign P|maskkontextfop = "bezahlt Einkauf"                      ? M|einkauf & M|bbezahlt & _M|bfakt & _M|bgebucht & _M|bgeplant
.assign P|maskkontextfop = "geplant fakt Einkauf"                 ? M|einkauf & M|bgeplant & M|bfakt & _M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "geplant gebucht Einkauf"              ? M|einkauf & M|bgeplant & M|bgebucht & _M|bfakt & _M|bbezahlt
.assign P|maskkontextfop = "geplant bezahlt Einkauf"              ? M|einkauf & M|bgeplant & M|bbezahlt & _M|bfakt & _M|bgebucht
.assign P|maskkontextfop = "fakt gebucht Einkauf"                 ? M|einkauf & M|bfakt & M|bgebucht & _M|bbezahlt & _M|bgeplant
.assign P|maskkontextfop = "fakt bezahlt Einkauf"                 ? M|einkauf & M|bfakt & M|bbezahlt & _M|bgeplant & _M|bgebucht
.assign P|maskkontextfop = "gebucht bezahlt Einkauf"              ? M|einkauf & M|bgebucht & M|bbezahlt & _M|bfakt & _M|bgeplant
.assign P|maskkontextfop = "geplant fakt gebucht Einkauf"         ? M|einkauf & M|bgeplant & M|bfakt & M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "fakt gebucht bezahlt Einkauf"         ? M|einkauf & M|bfakt & M|bgebucht & M|bbezahlt & _M|bgeplant
.assign P|maskkontextfop = "geplant gebucht bezahlt Einkauf"      ? M|einkauf & M|bgeplant & M|bgebucht & M|bbezahlt & _M|bfakt
.assign P|maskkontextfop = "geplant fakt bezahlt Einkauf"         ? M|einkauf & M|bgeplant & M|bfakt & M|bbezahlt & _M|bgebucht
.assign P|maskkontextfop = "geplant fakt gebucht bezahlt Einkauf" ? M|einkauf & M|bgeplant & M|bfakt & M|bgebucht & M|bbezahlt
.assign P|maskkontextfop = "geplant Verkauf"                      ? M|verkauf & M|bgeplant & _M|bfakt & _M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "fakt Verkauf"                         ? M|verkauf & M|bfakt & _M|bgeplant & _M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "gebucht Verkauf"                      ? M|verkauf & M|bgebucht & _M|bfakt & _M|bgeplant & _M|bbezahlt
.assign P|maskkontextfop = "bezahlt Verkauf"                      ? M|verkauf & M|bbezahlt & _M|bfakt & _M|bgebucht & _M|bgeplant
.assign P|maskkontextfop = "geplant fakt Verkauf"                 ? M|verkauf & M|bgeplant & M|bfakt & _M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "geplant gebucht Verkauf"              ? M|verkauf & M|bgeplant & M|bgebucht & _M|bfakt & _M|bbezahlt
.assign P|maskkontextfop = "geplant bezahlt Verkauf"              ? M|verkauf & M|bgeplant & M|bbezahlt & _M|bfakt & _M|bgebucht
.assign P|maskkontextfop = "fakt gebucht Verkauf"                 ? M|verkauf & M|bfakt & M|bgebucht & _M|bbezahlt & _M|bgeplant
.assign P|maskkontextfop = "fakt bezahlt Verkauf"                 ? M|verkauf & M|bfakt & M|bbezahlt & _M|bgeplant & _M|bgebucht
.assign P|maskkontextfop = "gebucht bezahlt Verkauf"              ? M|verkauf & M|bgebucht & M|bbezahlt & _M|bfakt & _M|bgeplant
.assign P|maskkontextfop = "geplant fakt gebucht Verkauf"         ? M|verkauf & M|bgeplant & M|bfakt & M|bgebucht & _M|bbezahlt
.assign P|maskkontextfop = "fakt gebucht bezahlt Verkauf"         ? M|verkauf & M|bfakt & M|bgebucht & M|bbezahlt & _M|bgeplant
.assign P|maskkontextfop = "geplant gebucht bezahlt Verkauf"      ? M|verkauf & M|bgeplant & M|bgebucht & M|bbezahlt & _M|bfakt
.assign P|maskkontextfop = "geplant fakt bezahlt Verkauf"         ? M|verkauf & M|bgeplant & M|bfakt & M|bbezahlt & _M|bgebucht
.assign P|maskkontextfop = "geplant fakt gebucht bezahlt Verkauf" ? M|verkauf & M|bgeplant & M|bfakt & M|bgebucht & M|bbezahlt
.continue KOPFLEEREN ? G|evtvar = "verkauf" ; G|evtvar = "einkauf"
.continue END
..
!UNDOBUT: Not possible
.assign G|evtfeldneu = 'G|TRUE'
.formula M|bugruppe = 1
.continue END
..
!EKVK
.copy M|einkauf = G|FALSE            ?  M|einkauf & G|evtvar = "verkauf"
.copy M|verkauf = G|FALSE            ?  M|verkauf & G|evtvar = "einkauf"
.copy M|verkauf = G|TRUE             ? _M|einkauf & _M|verkauf
.continue MASK
..
!PLANREDAT
.continue ERROR1 ? 'M|planredatbis:8' < 'M|planredatvon:8' & _F|empty(M|planredatbis)
.continue TABLEEREN
..
!FAELLIG
.continue ERROR1 ? 'M|faelligbis:8' < 'M|faelligvon:8' & _F|empty(M|faelligbis)
.continue TABLEEREN
..
!BSTART
.formula U|xvid = ""
.formula U|xeid = ""
.formula U|xvid = M|kauftrag^id                ? M|kauftrag^gruppe = 2 & _F|empty(M|kauftrag)
.formula U|xeid = M|kbestellung^id             ? M|kbestellung^gruppe = 2 & _F|empty(M|kbestellung)
.formula U|xvid = M|serauftrag^id              ? M|serauftrag^gruppe = 2 & _F|empty(M|serauftrag)
.formula U|xvid = M|repauf^id                  ? M|repauf^gruppe = 2 & _F|empty(M|repauf)
.formula U|xauftrag = M|kauftrag^id            ? M|kauftrag^gruppe = 1 & _F|empty(M|kauftrag)
.formula U|xauftrag = M|serauftrag^id          ? M|serauftrag^gruppe = 1 & _F|empty(M|serauftrag)
.formula U|xauftrag = M|repauf^id              ? M|repauf^gruppe = 1 & _F|empty(M|repauf)
.formula U|xauftrag = U|xvid                   ? M|kauftrag^gruppe = 2 ; M|serauftrag^gruppe = 2 ; M|repauf^gruppe = 2
.formula U|xauftrag = U|xauftrag^kopf^id       ? M|kauftrag^gruppe = 2 ; M|serauftrag^gruppe = 2 ; M|repauf^gruppe = 2
.formula U|xbestellung = M|kbestellung^id      ? M|kbestellung^gruppe = 1
.formula U|xbestellung = U|xeid                ? M|kbestellung^gruppe = 2
.formula U|xbestellung = U|xbestellung^kopf^id ? M|kbestellung^gruppe = 2
.formula U|xtfakturasel = "$,,"
.formula U|xtfakturasel = U|xtfakturasel + ";tterm=" + 'M|faelligvon:8' + "!" + 'M|faelligbis:8'
.formula U|xtfakturasel = U|xtfakturasel + ";planredat=" + 'M|planredatvon:8' + "!" + 'M|planredatbis:8'
.formula U|xtfakturasel = U|xtfakturasel + ";reart=" + M|reart                    ? _F|empty(M|reart)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang^lief=" + M|lief^id         ? _F|empty(M|lief)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang^kunde=" + M|kunde^id       ? _F|empty(M|kunde)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang^kl2=" + M|rechempf^id      ? _F|empty(M|rechempf)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang^lief2=" + M|rechsteller^id ? _F|empty(M|rechsteller)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang^dnr=3"                     ?  M|verkauf & (F|empty(M|kauftrag) & F|empty(M|repauf) & F|empty(M|serauftrag))
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang^dnr=4"                     ?  M|einkauf & F|empty(M|kbestellung)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang=" + U|xauftrag             ? _F|empty(M|kauftrag) ; _F|empty(M|serauftrag) ; _F|empty(M|repauf)
.formula U|xtfakturasel = U|xtfakturasel + ";evvorgang=" + U|xbestellung          ? _F|empty(M|kbestellung)
.formula U|xtfakturasel = U|xtfakturasel + ";@gruppe=3;@zeile=ja"
.formula U|xtfakturasel = U|xtfakturasel + ";@ordnung=planredat"                  ?  M|selplanredat
.formula U|xtfakturasel = U|xtfakturasel + ";@ordnung=tterm"                      ?  M|selfaellig
.load 9 billingplan 'U|xtfakturasel'
.continue  END        ? _G|mehr
..
!SELLINE
.load 9 line '9|selzeile'
.continue SELFAKTURA  ? _G|mehr
.input 'M|tab'        ? _F|empty(M|tab)
..
!SELFAKTURA
.load 9 billingplan
.continue  BFUSS      ? _G|mehr
.continue SELLINE
..
!BFUSS
.input 'M|bfuss'      ? _F|empty(M|bfuss)
.continue END
..
!KOPFLEEREN: schreibbare Felder
.formula M|kauftrag = ""
.formula M|kbestellung = ""
.formula M|kunde = ""
.formula M|lief = ""
.formula M|rechempf = ""
.formula M|rechsteller = ""
.formula M|reart = ""
.formula M|repauf = ""
.formula M|serauftrag = ""
.continue TABLEEREN
..
!TABLEEREN: Summenfelder l”schen / Tabelle leeren
.formula M|planrech = ""
.formula M|plananz = ""
.formula M|buchrech = ""
.formula M|buchanz = ""
.formula M|bezrech = ""
.formula M|bezanz = ""
..
.input "is/TABLEEREN"
.continue BSTART ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bstart"
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR1
.error Bis-Datum ist kleiner als Von-Datum.
.formula M|faelligbis   = "" ? G|evtvar = "faelligbis"
.formula M|planredatbis = "" ? G|evtvar = "planredatbis"
.formula M|faelligvon   = "" ? G|evtvar = "faelligvon"
.formula M|planredatvon = "" ? G|evtvar = "planredatvon"
.end 1
..
!ERROR2
.error Anzahlungsrechung erstellen gescheitert!
.end 1
