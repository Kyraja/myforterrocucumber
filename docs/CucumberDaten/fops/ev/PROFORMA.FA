..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PROFORMA.FA
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
..*****************************************************************************
.set trans -
..
.continue ERROR ?  M|ibuart <> 0
..
.type text xta ? _F|defined(U|xta)
..
.text U|xta 'P|spr' Pro-Forma-Rechnung ?  M|vtyp = 5 ; M|vtyp = 4 ; M|vtyp = 3
..
.continue PRO ? M|pro
.formula M|buart = M|buart2
.continue END
..
!PRO: proforma invoice
.formula M|buart2 = M|buart
.formula M|buart = U|xta
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR
.formula M|pro = G|FALSE
.error Negative Mengen oder Storno in Pro-Forma-Rechnung nicht m”glich.
.end 1
