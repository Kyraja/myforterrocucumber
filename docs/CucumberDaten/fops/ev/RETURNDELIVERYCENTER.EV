..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : RETURNDELIVERYCENTER.EV
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
.. 
..*****************************************************************************
.set trans -
.type integer xi          ? _F|defined(U|xi)
.type DVM2    xtmpfile    ? _F|defined(U|xtmpfile)
.type text    xtout       ? _F|defined(U|xtout)
.type text    xterr       ? _F|defined(U|xterr)
.type text    xtcmd       ? _F|defined(U|xtcmd)
.type bool    xbleer      ? _F|defined(U|xbleer)
.type text    xtsel       ? _F|defined(U|xtsel)
.type text    xselektion  ? _F|defined(U|xselektion)
.type text    xzid        ? _F|defined(U|xzid)
.type bool    xmarkiert   ? _F|defined(U|xmarkiert)
.type bool    xbrech      ? _F|defined(U|xbrech)
.type bool    xbvorg      ? _F|defined(U|xbvorg)
.type ID4     xmerkzidek  ? _F|defined(U|xmerkzidek)
.type ID3     xmerkzidvk  ? _F|defined(U|xmerkzidvk)
.type integer xzeilennr   ? _F|defined(U|xzeilennr)
.type bool    xtreffer    ? _F|defined(U|xtreffer)
..
.file -tempname U|xtmpfile
.file -tempname U|xtout
.file -tempname U|xterr
.copy U|xmarkiert = G|FALSE
.copy U|xbrech = G|FALSE
.copy U|xbvorg = G|FALSE
..
.continue EKVK       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "bverkauf"
.continue EKVK       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "beinkauf"
.continue VERKAUF    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "vkvorg"
.continue EINKAUF    ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "ekvorg"
.continue LADEN      ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buladen"
.continue ERSTELLEN  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "buerstellen"
.continue ERSTELLEN  ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "bubuerstellen"
.continue KARTIKEL   ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "artikel"
.continue KUNDE      ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "kunde"
.continue LIEF       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "lief"
.continue MGE        ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "newmge"
.continue MARK       ? G|evtartengl = "FIELD_EXIT"   & G|evtvar = "tmark"
.continue BULEER     ? G|evtartengl = "BUTTON_AFTER" & G|evtvar = "leeren"
.continue END
..
!BULEER
.formula M|lief = ""       ? M|beinkauf
.protection -reset lief 0  ? M|beinkauf
.formula M|kunde = ""      ? M|bverkauf
.protection -reset kunde 0 ? M|bverkauf
.formula M|selektion = ""
.formula M|lbed  = ""
.formula M|pbed  = ""
.formula M|kl2ek = ""
.formula M|kl2vk = ""
.formula M|vstaat = ""
.formula M|warenempf = ""
.continue TABLEEREN
..
!MARK: pbed, lbed, kl2, vstaat aus dieser Zeile in Kopf stecken
.formula U|xmerkzidek = ""
.formula U|xmerkzidvk = ""
.formula U|xmerkzidek = M|zidek  ? M|beinkauf
.formula U|xmerkzidvk = M|zidvk  ? M|bverkauf
.continue LEER  ? _M|tmark
..
.copy M|mztreffer = G|FALSE ? M|mzda
...colour -background -1 -1 -1 'M|aktzeile'
.continue CONTROL ? (_F|empty(M|pbed) ; _F|empty(M|lbed) ; _F|empty(M|kl2ek) ; _F|empty(M|vstaat)) & M|beinkauf
.continue CONTROL ? (_F|empty(M|pbed) ; _F|empty(M|lbed) ; _F|empty(M|kl2vk) ; _F|empty(M|warenempf)) & M|bverkauf
.assign M|pbed      = M|tpbed
.assign M|lbed      = M|tlbed           ? M|bverkauf
.assign M|kl2ek     = M|tkl2ek          ? M|beinkauf
.assign M|kl2vk     = M|tkl2vk          ? M|bverkauf
.assign M|vstaat    = M|tvstaat         ? M|beinkauf
.assign M|warenempf = M|twarenempf      ? M|bverkauf
..
!CONTROL 
.select screen header
..
!CSEL
.select screen line
.continue END            ? _G|mehr
.continue CSEL ? M|tmark
.copy M|tmark = G|TRUE ? M|beinkauf & U|xmerkzidek = M|zidek & _M|mzda
.copy M|tmark = G|TRUE ? M|bverkauf & U|xmerkzidvk = M|zidvk & _M|mzda
.protection tmark 'M|aktzeile'   ? M|tpbed^id <> M|pbed^id
.protection tmark 'M|aktzeile'   ? M|tlbed^id <> M|lbed^id & _F|empty(M|lbed)
.protection tmark 'M|aktzeile'   ? M|tkl2ek^id <> M|kl2ek^id & _F|empty(M|kl2ek) & M|beinkauf
.protection tmark 'M|aktzeile'   ? M|tvstaat^id <> M|vstaat^id & _F|empty(M|vstaat) & M|beinkauf
.protection tmark 'M|aktzeile'   ? M|tkl2vk^id <> M|kl2vk^id & _F|empty(M|kl2vk) & M|bverkauf
.protection tmark 'M|aktzeile'   ? M|twarenempf^id <> M|warenempf^id & _F|empty(warenempf) & M|bverkauf
.continue CSEL
..
!LEER: wenn alle tmark = false, dann Kopffelder lbed, pbed und kl2 leeren
.colour -background 'M|coloryellow' 'M|aktzeile' ? M|bfarbe & _M|tmark
.select screen header
.copy U|xbleer = G|FALSE
..
!LEERLINE
.select screen line 
.continue EMPTY          ? _G|mehr & U|xbleer
.continue PROTECT        ? _G|mehr
.copy U|xbleer = G|FALSE ?  G|mehr & M|tmark
.continue PROTECT        ?  G|mehr & M|tmark
.copy U|xbleer = G|TRUE
.continue LEERLINE
..
!EMPTY
.formula M|lbed  = ""
.formula M|pbed  = ""
.formula M|kl2ek = ""
.formula M|kl2vk = ""
.formula M|vstaat = ""
.formula M|warenempf = ""
..
!PROTECT
.select screen header
..
!PLINE
.select screen line
.continue COLORHEAD       ? _G|mehr & _F|empty(U|xmerkzidek) & M|beinkauf
.continue COLORHEAD       ? _G|mehr & _F|empty(U|xmerkzidvk) & M|bverkauf
.continue                 ? _G|mehr
.protection -reset  tmark 'M|aktzeile' ? _F|protected(M|newmge, M|aktzeile) & ((M|twarenempf^id <> M|warenempf^id & _F|empty(warenempf) & M|bverkauf & M|tkl2vk^id <> M|kl2vk^id & M|tlbed^id <> M|lbed^id & _F|empty(M|lbed) & M|tpbed^id <> M|pbed^id) ; U|xbleer)
.protection -reset  tmark 'M|aktzeile' ? _F|protected(M|newmge, M|aktzeile) & ((M|tvstaat^id <> M|vstaat^id & _F|empty(M|vstaat) & M|beinkauf & M|tkl2ek^id <> M|kl2ek^id & _F|empty(M|kl2ek) & M|tlbed^id <> M|lbed^id & _F|empty(M|lbed) & M|tpbed^id <> M|pbed^id) ; U|xbleer)
.continue PLINE
..
!COLORHEAD: rÅckwÑrts durchlaufen 
.copy U|xtreffer = G|FALSE
..
.select screen header
.formula U|xzeilennr = M|tzeilen
..
!COLORLINE
.continue                                ? U|xzeilennr = 0
.select screen line 'U|xzeilennr'
.continue                                ? _G|mehr
.formula U|xzeilennr = U|xzeilennr - 1
.continue COLORLINE ? _M|tmark 
..
.copy U|xtreffer = G|TRUE  ? M|tmark & M|beinkauf & U|xmerkzidek = M|zidek & M|mzda
.copy U|xtreffer = G|TRUE  ? M|tmark & M|bverkauf & U|xmerkzidvk = M|zidvk & M|mzda
.continue COLORLINE ? U|xtreffer
.copy M|tmark = G|FALSE    ? M|beinkauf & U|xmerkzidek = M|zidek & _M|mzda
.copy M|tmark = G|FALSE    ? M|bverkauf & U|xmerkzidvk = M|zidvk & _M|mzda
.continue COLORLINE 
..
!MGE: nur negative Zahlen erlaubt. Betrag der Zahl muss kleiner als die rueckmge sein
.continue ERROR10 ? M|newmge = 0 
.continue ERROR12 ? M|newmge > 0 & M|newmge > M|rueckmge
.continue ERROR12 ? M|newmge < 0 & M|newmge * (-1) > M|rueckmge
.formula M|newmge = M|newmge * (-1) ? M|newmge > 0
.continue END
..
!LIEF
.protection lief 0         ? _F|empty(M|lief)
.protection -reset lief 0  ?  F|empty(M|lief)
.continue TABLEEREN        ?  F|empty(M|lief)
.continue END
..
!KUNDE
.protection kunde 0        ? _F|empty(M|kunde)
.protection -reset kunde 0 ?  F|empty(M|kunde)
.continue TABLEEREN        ?  F|empty(M|kunde)
.continue END
..
!KARTIKEL
.continue ERROR16 ? _F|empty(M|artikel) & _F|equals(M|artikel^zptyp, "(SOPOItemPOS)") & _M|artikel^gruppe = 1
.formula M|vkvorg = "" ? _F|empty(M|artikel) & M|bverkauf
.formula M|ekvorg = "" ? _F|empty(M|artikel) & M|beinkauf
.continue END                  ? M|tzeilen > 0
.cursor kunde 0                ? M|bverkauf & _F|empty(M|artikel) & M|tzeilen = 0
.cursor lief 0                 ? M|beinkauf & _F|empty(M|artikel) & M|tzeilen = 0
.protection -reset kunde 0     ? M|bverkauf & _F|empty(M|artikel) & M|tzeilen = 0
.protection -reset lief 0      ? M|beinkauf & _F|empty(M|artikel) & M|tzeilen = 0
.protection kunde 0            ? M|bverkauf & _F|empty(M|vkvorg) & M|tzeilen > 0 & _F|empty(M|kunde)
.protection lief 0             ? M|beinkauf & _F|empty(M|ekvorg) & M|tzeilen > 0 & _F|empty(M|lief)
.continue END
..
!EKVK
.copy M|beinkauf = G|FALSE     ?  M|beinkauf & G|evtvar = "bverkauf"
.copy M|bverkauf = G|FALSE     ?  M|bverkauf & G|evtvar = "beinkauf"
.copy M|bverkauf = G|TRUE      ? _M|beinkauf & _M|bverkauf
.formula M|pbed  = ""
.formula M|warenempf = ""
.formula M|selektion = ""
.continue VK                   ?  M|bverkauf
.formula M|vstaat = ""
.formula M|kunde = ""
.formula M|kl2ek = ""
.assign P|maskkontextfop = "Einkauf"
.protection kunde 0
.protection vkvorg 0
.protection -reset lief 0
.protection -reset ekvorg 0
.protection -reset eknum 0
.continue TABLEEREN
..
!VK
.formula M|lbed  = ""
.formula M|lief  = ""
.formula M|kl2vk = ""
.formula M|eknum = ""
.assign P|maskkontextfop = "Verkauf"
.protection lief 0
.protection ekvorg 0    
.protection eknum 0
.protection -reset kunde 0
.protection -reset vkvorg 0
.continue TABLEEREN
..
!TABLEEREN: Tabelle leeren
.input "is/TABLEEREN"
.continue END
..
!VERKAUF: prÅfen, ob gebuchter LS bzw. gebuchte RE mit fakt         
.formula M|artikel = "" ? _F|empty(M|vkvorg) & M|bverkauf
.continue KOPFLEEREN ?  F|empty(M|vkvorg)
.continue ERROR1     ? _M|vkvorg^ktyp = 4 & _M|vkvorg^ktyp = 5
.continue ERROR1     ? _F|equals(M|vkvorg^lsart, "(PackingSlip)") & M|vkvorg^typ = 4
.continue ERROR1     ? _F|equals(M|vkvorg^vorganga, "(Invoice)") & M|vkvorg^typ = 5
.continue ERROR2     ?  M|vkvorg^uebertr
.continue ERROR3     ? _M|vkvorg^fakt & M|vkvorg^typ = 5
.formula M|kunde = M|vkvorg^kunde  ? F|empty(M|kunde)
.continue ERROR4     ?  M|vkvorg^kunde^id <> M|kunde^id  & _F|empty(M|kunde)
.continue END
..
!EINKAUF: prÅfen, ob gebuchter LS bzw gebuchte RE mit fakt
.formula M|artikel = "" ? _F|empty(M|ekvorg) & M|beinkauf
.continue KOPFLEEREN ?  F|empty(M|ekvorg)
.continue ERROR1     ? _M|ekvorg^ktyp = 4 & _M|ekvorg^ktyp = 5
.continue ERROR1     ? _F|equals(M|ekvorg^lsart, "(PackingSlip)") & M|ekvorg^typ = 4
.continue ERROR1     ? _F|equals(M|ekvorg^vorganga, "(Invoice)") & M|ekvorg^typ = 5
.continue ERROR2     ?  M|ekvorg^uebertr
.continue ERROR3     ? _M|ekvorg^fakt & M|ekvorg^typ = 5
.formula M|lief = M|ekvorg^lief   ? F|empty(M|lief)
.continue ERROR5     ?  M|ekvorg^lief^id <> M|lief^id  & _F|empty(M|lief)
.continue END
..
!LADEN
.continue ERROR7  ? F|empty(M|kunde) & F|empty(M|artikel) & F|empty(M|projekt) & F|empty(M|charge) & F|empty(M|verwendung) & F|empty(M|vkvorg) & M|bverkauf
.continue ERROR7  ? F|empty(M|lief) & F|empty(M|artikel) & F|empty(M|projekt) & F|empty(M|charge) & F|empty(M|verwendung) & F|empty(M|ekvorg) & M|beinkauf
.continue ERROR6  ? F|empty(M|kunde) & M|bverkauf
.continue ERROR6  ? F|empty(M|lief) & M|beinkauf
.continue ANFUEG  ? M|tzeilen = 0
.. Nicht angehakte Zeilen entfernen
.select screen header
.formula U|xi = M|tzeilen
..
!SELLINE 
.select screen line 'U|xi'
.continue TMARK   ? M|tmark
.make screen line -O   
.continue ANFUEG ? M|tzeilen = 0
.formula U|xi = M|tzeilen
.continue SELLINE
..
!TMARK
.formula U|xi = U|xi - 1
.continue ANFUEG ? U|xi = 0
.continue SELLINE
..
!ANFUEG
.select screen header
.select screen line 'M|tzeilen'
..
.. Lieferscheine und Rechnungen mit Lagerbewegungen mÅssen selektiert werden
.. zuerst den direkten Vorgang, dann die Lieferscheine, dann die Rechnungen
!SEL1: Seletion des Vorgangs
.continue SEL2 ? (F|empty(M|vkvorg) & M|bverkauf) ; (F|empty(M|ekvorg) & M|beinkauf)
.formula M|select = "$,,"
.formula M|select = M|select + ";id=" + M|vkvorg^id ? M|bverkauf & _F|empty(M|vkvorg)
.formula M|select = M|select + ";id=" + M|ekvorg^id ? M|beinkauf & _F|empty(M|ekvorg)
..
.copy U|xbvorg = G|TRUE
.continue SELEKTION
..
!SEL2: Lieferscheinselektion
.formula M|select = "$,,"
.formula M|select = M|select + ";typ=(PackingSlip)"
.formula M|select = M|select + ";lsart=(PackingSlip)"
.formula M|select = M|select + ";lief=" + M|lief^id      ? M|beinkauf & _F|empty(M|lief)
.formula M|select = M|select + ";kunde=" + M|kunde^id    ? M|bverkauf & _F|empty(M|kunde)
.continue SELEKTION
..
!SEL3: Selektion Rechnung mit Lagerbewegung
.copy U|xbrech = G|TRUE
.formula M|select = "$,,"
.formula M|select = M|select + ";typ=(Invoice)"
.formula M|select = M|select + ";vorgang=(Invoice)"
.formula M|select = M|select + ";fakt=TRUE"
.continue SELEKTION
..
!SELEKTION
.. WarenempfÑnger
.formula M|select = M|select + ";warenempf="+'M|warenempf^id' ? _F|empty(M|warenempf) & M|tzeilen > 0 & M|bverkauf
.. Lieferbedingung
.formula M|select = M|select + ";lbed="+'M|lbed^id'      ? _F|empty(M|lbed) & M|bverkauf 
.formula M|select = M|select + ";lbed=`"                 ?  F|empty(M|lbed) & M|tzeilen > 0 & M|bverkauf & _U|xbrech
.. Preisstellung
.formula M|select = M|select + ";pbed="+'M|pbed^id'      ? _F|empty(M|pbed)
.formula M|select = M|select + ";pbed=`"                 ?  F|empty(M|pbed) & M|tzeilen > 0 & _U|xbrech
.. Rechnungssteller
.formula M|select = M|select + ";kl2="+'M|kl2ek^id'      ? _F|empty(M|kl2ek) & M|tzeilen > 0 & M|beinkauf
.. RechnungempfÑnger
.formula M|select = M|select + ";kl2="+'M|kl2vk^id'      ? _F|empty(M|kl2vk) & M|tzeilen > 0 & M|bverkauf
.. Versendungsland
.formula M|select = M|select + ";staat="+'M|vstaat^id'  ? _F|empty(M|vstaat) & M|tzeilen > 0 & M|beinkauf
..
.formula M|select = M|select + ";@ablageart=(Both)"
.continue PART ? F|empty(M|vkvorg) & M|bverkauf
.continue PART ? F|empty(M|ekvorg) & M|beinkauf
.continue QUERY
..
!PART
.formula M|select = M|select + ";vom=" + 'M|von' + "!" + 'M|bis'
.formula M|select = M|select + ";uebertr=(No)"
.formula M|select = M|select + ";@ordnung=vom"
.continue QUERY
..
!QUERY: Query database
.load 1 purchasing 'M|select'  ? M|beinkauf
.load 1 sales 'M|select'       ? M|bverkauf
.continue ERROR14 ? _G|mehr & _F|empty(M|vkvorg) & M|bverkauf
.continue ERROR14 ? _G|mehr & _F|empty(M|ekvorg) & M|beinkauf
..
.continue SEL3     ? _G|mehr & _U|xbrech
.continue LEEREN   ? _G|mehr &  U|xbrech
..
!LOAD1LINE
.load 1 line
.continue ARTIKEL   ? _G|mehr
.continue LOAD1LINE ? _F|empty(M|artikel) & 1|artikel^id <> M|artikel^id
.continue LOAD1LINE ? _F|empty(M|verwendung) & 1|verw <> M|verwendung
.continue LOAD1LINE ? _F|empty(M|charge) & 1|charge^id <> M|charge^id
.continue KUVERK    ? M|bverkauf
.. in der Re-Position lief steht hier lief2, daher bleibt der ^-Verweis
.continue ARTIKEL   ? 1|kopf^lief^id <> M|lief^id & _F|empty(M|lief) & F|equals(1|kotyp, "(Invoice)")
.continue KUCON
!KUVERK
.. in der Re-Position kunde steht hier kunde2, daher bleibt der ^-Verweis
.continue ARTIKEL  ? 1|kopf^kunde^id <> M|kunde^id & _F|empty(M|kunde) & F|equals(1|kotyp, "(Invoice)")
!KUCON
.continue NOSTORNO ? _F|empty(M|vkvorg) & M|bverkauf
.continue NOSTORNO ? _F|empty(M|ekvorg) & M|beinkauf
.continue ARTTAB
..
!NOSTORNO: keine Storno-/stornierten LS bei Vorgang
.set trans +
.formula U|xselektion = ""
.formula U|xselektion = U|xselektion + F|formatstr("Vorgang: {1}", 'M|vkvorg')        ? _F|empty(M|vkvorg) & M|bverkauf
.formula U|xselektion = U|xselektion + F|formatstr("Vorgang: {1}", 'M|ekvorg')        ? _F|empty(M|ekvorg) & M|beinkauf
.set trans -
.formula M|selektion = U|xselektion
..
.continue TAB     ?  F|equals(1|tlsart, "(PackingSlip)") & 1|kotyp = 4
.continue TAB     ?  F|equals(1|treart, "(Invoice)") & 1|kotyp = 5 & 1|kopf^fakt
.continue ARTIKEL
..
!TAB
.input 'M|tab'
.continue LOADART1LINE
..
!ARTIKEL
.load 1 purchasing     ?  M|beinkauf
.load 1 sales          ?  M|bverkauf
.continue NOMORE       ? _G|mehr
..
!LOADART1LINE
.load 1 line
.continue ARTIKEL      ? _G|mehr
.continue LOADART1LINE ? _F|empty(M|artikel) & 1|artikel^id <> M|artikel^id
.continue LOADART1LINE ? _F|empty(M|verwendung) & 1|verw <> M|verwendung
.continue LOADART1LINE ? _F|empty(M|charge) & 1|charge^id <> M|charge^id
.continue ARTTAB
..
!NOMORE
.formula M|vkvorg = ""
.formula M|ekvorg = ""
.protection kunde 0    ? M|bverkauf
.protection lief 0     ? M|beinkauf
..
!LEEREN
.set trans +
.formula U|xselektion = ""
.formula U|xselektion = F|formatstr("Artikel: {1}", 'M|artikel')                      ? _F|empty(M|artikel)
.formula U|xselektion = U|xselektion + ", " ? _F|empty(U|xselektion)
.formula U|xselektion = U|xselektion + F|formatstr("Charge: {1}", 'M|charge')         ? _F|empty(M|charge)
.formula U|xselektion = U|xselektion + ", " ? _F|empty(U|xselektion) & _F|empty(M|charge)
.formula U|xselektion = U|xselektion + F|formatstr("Verwendung: {1}", 'M|verwendung') ? _F|empty(M|verwendung)
.formula U|xselektion = U|xselektion + ", " ? _F|empty(U|xselektion) & _F|empty(M|verwendung)
.formula U|xselektion = U|xselektion + F|formatstr("Projekt: {1}", 'M|projekt')       ? _F|empty(M|projekt)
.set trans -
..
.formula M|selektion = U|xselektion
.formula M|artikel    = ""     ? U|xbrech ; U|xbvorg
.formula M|charge     = ""     ? U|xbrech ; U|xbvorg
.formula M|projekt    = ""     ? U|xbrech ; U|xbvorg
.formula M|verwendung = ""     ? U|xbrech ; U|xbvorg
!LNEXT
.continue END   ?  U|xbvorg
.continue SEL3  ? _U|xbrech
.continue END 
..
!ARTTAB: keine Storno-/stornierten LS bei Artikel und keine Umlagerungen
.continue ARTVERK ?  M|bverkauf
.continue ARTIKEL  ? 1|kopf^lief^id <> M|lief^id & _F|empty(M|lief) & F|equals(1|kotyp, "(Invoice)")
.continue ARTCON
!ARTVERK
.continue ARTIKEL  ? 1|kopf^kunde^id <> M|kunde^id & _F|empty(M|kunde) & F|equals(1|kotyp, "(Invoice)")
!ARTCON
.continue ARTIKEL ?  F|equals(1|tlsart, "(PackingSlip)") & 1|kotyp = 4 & _F|empty(1|kopf^umplatz) & _F|empty(1|kopf^umlgruppe)
.continue TAB     ?  F|equals(1|kopf^lsart, "(PackingSlip)") & 1|kopf^typ = 4
.continue TAB     ?  F|equals(1|kopf^vorganga, "(Invoice)") & 1|kopf^typ = 5 & 1|kopf^fakt
.continue ARTIKEL 
..
!ERSTELLEN: Testen, ob Zeilen markiert sind und ob fÅr diese Zeilen die Mengen zur RÅcklieferung gesetzt sind
.select screen header
..
!SELTAB
.select screen line
.continue ERROR15     ? _G|mehr & _U|xmarkiert
.continue BUERSTELLEN ? _G|mehr & U|xmarkiert
.copy U|xmarkiert = G|TRUE ? M|tmark
.continue SELTAB      ? _M|tmark
.continue SELTAB      ?  _F|protected(M|tmark, M|aktzeile)
.continue ERROR8      ?  M|tmark & M|newmge = 0 & M|beinkauf
.continue ERROR8      ?  M|tmark & M|newmge = 0 & M|bverkauf
.continue SELTAB 
..
!BUERSTELLEN: RLS erstellen. 
.select screen header
.formula U|xi = 1
..
.output new 'U|xtmpfile'
.input "DATEI.F"
..
.continue VKNEU ? M|bverkauf
..
!EKNEU: Lieferschein neu, dann Åber Beleg anfÅgen (beleg) die Positions-IDs Åbergeben -> RLS
.. vom bekommt Tagesdatum
#!database=(Purchasing)
#!group=(PackingSlip)
#!action=new
#!dontchange=~
#!flddelimiter=#
#!userowid=1
nummer#vom\
?zn#0:beleg#0:ebeleg#0:ueb#mge#>mzsubm#!#.:einh#.:lpsuch#.:zuomge#.:charge#.:verw#.:projekt#<   ? F|sysinfo(18)^projekt 
?zn#0:beleg#0:ebeleg#0:ueb#mge#>mzsubm#!#.:einh#.:lpsuch#.:zuomge#.:charge#.:verw#<             ? _F|sysinfo(18)^projekt
~#.\
..
!EKNEUSEL
.select screen line 'U|xi'
.continue EDP    ? _G|mehr
.continue EKNEXT ? _M|tmark
..
.formula U|xtsel = ""
.formula U|xtsel = "$,,1:id="+'M|zidek'
.continue EKZUPOS   ?  F|empty(M|platz)
.continue EKNOPROJ  ? _F|sysinfo(18)^projekt
..
?0         # 'M|zidek' # 'M|eknum' # 0 # ~          # ~ # ~ #   ~            #     ~        #    ~       #      ~         #     ~             #         ~         # ~  \  ?  G|evtvar = "buerstellen"
?0         # 'M|zidek' # 'M|eknum' # 1 # ~          # ~ # ~ #   ~            #     ~        #    ~       #      ~         #     ~             #         ~         # ~  \  ?  G|evtvar = "bubuerstellen"
?'U|xtsel' # ~         # ~         # ~ # 'M|newmge' #   # + #   ~            # 'M|platz^id' # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' # 'M|tprojekt^id'   #    \  ? _M|mzda
?'U|xtsel' # ~         # ~         # ~ # 'M|newmge' #   # + # 'M|tle(L="0")' # 'M|platz^id' # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' # 'M|tljprojekt^id' #    \  ?  M|mzda
.continue EKNEXT
..
!EKNOPROJ
?0         # 'M|zidek' # 'M|eknum' # 0 # ~          # ~ # ~ #   ~            #     ~        #    ~       #      ~         #     ~             # ~  \                      ?  G|evtvar = "buerstellen"
?0         # 'M|zidek' # 'M|eknum' # 1 # ~          # ~ # ~ #   ~            #     ~        #    ~       #      ~         #     ~             # ~  \                      ?  G|evtvar = "bubuerstellen"
?'U|xtsel' # ~         # ~         # ~ # 'M|newmge' #   # + #   ~            # 'M|platz^id' # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' #    \                      ? _M|mzda
?'U|xtsel' # ~         # ~         # ~ # 'M|newmge' #   # + # 'M|tle(L="0")' # 'M|platz^id' # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' #    \                      ?  M|mzda
.continue EKNEXT
..
!EKZUPOS
?0         # 'M|zidek' # 'M|eknum' # 0 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~  \ ?  F|sysinfo(18)^projekt & G|evtvar = "buerstellen"
?0         # 'M|zidek' # 'M|eknum' # 1 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~  \ ?  F|sysinfo(18)^projekt & G|evtvar = "bubuerstellen"
?0         # 'M|zidek' # 'M|eknum' # 0 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~      \ ? _F|sysinfo(18)^projekt & G|evtvar = "buerstellen"
?0         # 'M|zidek' # 'M|eknum' # 1 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~      \ ? _F|sysinfo(18)^projekt & G|evtvar = "bubuerstellen"
?'U|xtsel' # ~         # ~         # ~ # 'M|newmge' # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~  \ ?  F|sysinfo(18)^projekt
?'U|xtsel' # ~         # ~         # ~ # 'M|newmge' # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~      \ ? _F|sysinfo(18)^projekt
.continue EKNEXT
..
!EKNEXT
.formula U|xi = U|xi + 1
.continue EDP ? U|xi > M|tzeilen
.continue EKNEUSEL
..
!VKNEU: Lieferschein neu, dann Åber Beleg anfÅgen (beleg) die Positions-IDs Åbergeben -> RLS
#!database=(Sales)
#!group=(PackingSlip)
#!action=new
#!dontchange=~
#!flddelimiter=#
#!userowid=1
nummer#vom\
?zn#0:beleg#0:ueb#mge#>mzsubm#!#.:einh#.:lpsuch#.:zuomge#.:charge#.:verw#.:projekt#<  ?  F|sysinfo(18)^projekt
?zn#0:beleg#0:ueb#mge#>mzsubm#!#.:einh#.:lpsuch#.:zuomge#.:charge#.:verw#<            ? _F|sysinfo(18)^projekt
~#.\
..
!VKNEUSEL
.select screen line 'U|xi'
.continue EDP    ? _G|mehr
.continue VKNEXT ? _M|tmark
..
.formula U|xtsel = ""
.formula U|xtsel = "$,,1:id="+'M|zidvk'
.continue ZUPOS   ?  F|empty(M|platz)
.continue NOPROJ  ? _F|sysinfo(18)^projekt
..
?0        # 'M|zidvk' # 0 # ~          # ~ # ~ #   ~            #       ~        #    ~       #      ~         #     ~             #         ~         # ~  \ ?  G|evtvar = "buerstellen"
?0        # 'M|zidvk' # 1 # ~          # ~ # ~ #   ~            #       ~        #    ~       #      ~         #     ~             #         ~         # ~  \ ?  G|evtvar = "bubuerstellen"
?'U|xtsel'# ~         # ~ # 'M|newmge' #   # + #   ~            # 'M|platz^id'   # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' # 'M|tprojekt^id'   #    \ ? _M|mzda
?'U|xtsel'# ~         # ~ # 'M|newmge' #   # + # 'M|tle(L="0")' # 'M|platz^id'   # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' # 'M|tljprojekt^id' #    \ ?  M|mzda
.continue VKNEXT
..
!NOPROJ
?0        # 'M|zidvk' # 0 # ~          # ~ # ~ #   ~            #       ~        #    ~       #      ~         #     ~             #  ~                     \ ?  G|evtvar = "buerstellen"
?0        # 'M|zidvk' # 1 # ~          # ~ # ~ #   ~            #       ~        #    ~       #      ~         #     ~             #  ~                     \ ?  G|evtvar = "bubuerstellen"
?'U|xtsel'# ~         # ~ # 'M|newmge' #   # + #   ~            # 'M|platz^id'   # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' #                        \ ? _M|mzda
?'U|xtsel'# ~         # ~ # 'M|newmge' #   # + # 'M|tle(L="0")' # 'M|platz^id'   # 'M|newmge' # 'M|tcharge^id' # 'M|tljverwendung' #                        \ ?  M|mzda
.continue VKNEXT
..
!ZUPOS
?0        # 'M|zidvk' # 0 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~  \ ?  F|sysinfo(18)^projekt & G|evtvar = "buerstellen"
?0        # 'M|zidvk' # 1 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~  \ ?  F|sysinfo(18)^projekt & G|evtvar = "bubuerstellen"
?0        # 'M|zidvk' # 0 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~      \ ? _F|sysinfo(18)^projekt & G|evtvar = "buerstellen"
?0        # 'M|zidvk' # 1 # ~          # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~      \ ? _F|sysinfo(18)^projekt & G|evtvar = "bubuerstellen"
?'U|xtsel'# ~         # ~ # 'M|newmge' # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~  \ ?  F|sysinfo(18)^projekt
?'U|xtsel'# ~         # ~ # 'M|newmge' # ~ # ~ # ~ # ~ # ~ # ~ # ~ # ~      \ ? _F|sysinfo(18)^projekt
..
!VKNEXT
.formula U|xi = U|xi + 1
.continue EDP ? U|xi > M|tzeilen
.continue VKNEUSEL
..
!EDP
.output
.system 'F|formatstr("edpimport.sh -P -I {1} >{2} 2>{3} -o updatemode=errabort", U|xtmpfile, U|xtout, U|xterr)' password background
..
.continue MEHR ? G|mehr
.box Hinweis
RÅcklieferschein erzeugen nicht erfolgreich. Bitte manuell erstellen!
.input 'U|xterr'
.continue END
..
!MEHR
.formula M|select = "$,,"
.formula M|select = M|select + ";typ=(PackingSlip)"
.formula M|select = M|select + ";lsart=(ReturnPackingSlip)"
.formula M|select = M|select + ";lief="+'M|lief'   ? M|beinkauf
.formula M|select = M|select + ";kunde="+'M|kunde' ? M|bverkauf
.formula M|select = M|select + ";vom=."
.formula M|select = M|select + ";uebertr=ja"        ?  G|evtvar = "buerstellen"
.formula M|select = M|select + ";uebertr=nein"      ?  G|evtvar = "bubuerstellen"
.formula M|select = M|select + ";ebeleg="+'M|eknum' ? _F|empty(M|eknum) & M|beinkauf
.formula M|select = M|select + ";@ablageart=(Both)"
.formula M|select = M|select + ";@richtung=(Backwards)"
.select purchasing 'M|select'   ?  M|beinkauf
.select sales 'M|select'        ?  M|bverkauf
.continue ERROR13               ? _G|mehr
..
.command -parallel 'F|formatstr("<(Purchasing)>{1}<(Edit)>", H|id)' ? M|beinkauf & G|evtvar = "buerstellen"
.command -parallel 'F|formatstr("<(Sales)>{1}<(Edit)>", H|id)'      ? M|bverkauf & G|evtvar = "buerstellen"
.command -parallel 'F|formatstr("<(Purchasing)>{1}<(View)>", H|id)' ? M|beinkauf & G|evtvar = "bubuerstellen"
.command -parallel 'F|formatstr("<(Sales)>{1}<(View)>", H|id)'      ? M|bverkauf & G|evtvar = "bubuerstellen"
..
.formula M|eknum = ""
.formula M|lbed  = ""
.formula M|pbed  = ""
.formula M|kl2ek = ""
.formula M|kl2vk = ""
.formula M|vstaat = ""
.formula M|warenempf = ""
.formula M|lief = ""
.formula M|kunde = ""
.protection -reset kunde 0   ? M|bverkauf
.protection -reset lief 0    ? M|beinkauf
.continue TABLEEREN
..
!KOPFLEEREN
.formula M|lief = ""      ? G|evtvar = "ekvorg"
.formula M|kunde = ""     ? G|evtvar = "vkvorg"
.protection -reset lief   ? G|evtvar = "ekvorg" & M|tzeilen = 0
.protection -reset kunde  ? G|evtvar = "vkvorg" & M|tzeilen = 0
.continue TABLEEREN
..
!ERROR1: Vorgang nicht vom Typ LS oder RE mit fakt
.error Es sind nur VorgÑnge vom Typ Lieferschein und Rechnungen mit Lagerbewegung erlaubt!
.continue ERROREND
..
!ERROR2: Vorgang nicht gebucht
.error Es dÅrfen nur gebuchte VorgÑnge rÅckgeliefert werden!
.continue ERROREND
..
!ERROR3: Rechnung nicht mit Lagerbewegung
.error Es dÅrfen nur Rechnungen mit Lagerbewegung rÅckgeliefert werden!
.continue ERROREND
..
!ERROR4: Kunde des eingetragenen Vorgangs passt nicht zum erten Vorgang
.error Kunde passt nicht zum erstgewÑhlten Vorgang!
.formula M|vkvorg = ""   
.cursor vkvorg 0 
.end 1
..
!ERROR5: Lieferant des eingetragenen Vorgangs passt nicht zum ersten Vorgang
.error Lieferant passt nicht zum erstgewÑhlten Vorgang!
.formula M|ekvorg = ""
.cursor ekvorg 0 
.end 1
..
!ERROR6: 
.error Bitte einen Kunden eintragen.      ? M|bverkauf
.error Bitte einen Lieferanten eintragen. ? M|beinkauf
.cursor kunde 0                           ? M|bverkauf
.cursor lief 0                            ? M|beinkauf
.end 1
..
!ERROR7
.error Bitte Selektionskriterien wie Kunde, Artikel, Charge, Projekt oder Verwendung fÅllen.       ? M|bverkauf
.error Bitte Selektionskriterien wie Lieferant, Artikel, Charge, Projekt oder Verwendung fÅllen.   ? M|beinkauf
.end 1  
..
!ERROR8
.error Bitte rÅckzuliefernde Menge in den markierten Zeilen fÅllen.
.end 1
..
!ERROR9
.error Suchwort darf nicht mit einer Zahl beginnen.
.formula M|eknum = ""
.cursor ekmum
.end 1
..
!ERROR10
.error Bitte RÅckliefermenge eingeben.
.end 1
..
!ERROR11
.error Identnummer bereits vorhanden.
.formula M|eknum = ""
.cursor eknum
.end 1
..
!ERROR12
.error GewÅnschte RÅckliefermenge zu gro·!
.formula M|newmge = 0
.cursor newmge 
.end 1
..
!ERROR13
.error Soeben erstellter RÅcklieferschein nicht gefunden!
.end 1
..
!ERROR14
.error Die Selektionskriterien aus Vorgang 'M|vkvorg' stimmen nicht mit der vorigen/weiteren Selektion Åberein. ? M|bverkauf
.error Die Selektionskriterien aus Vorgang 'M|ekvorg' stimmen nicht mit der vorigen/weiteren Selektion Åberein. ? M|beinkauf
.end 1
..
!ERROR15
.error Keine Zeile fÅr einen RÅcklieferschein markiert!
.end 1
..
!ERROR16
.error Es sind nur Zusatzpositionen vom Typ AU/BE-Position erlaubt.
.formula M|artikel = ""
.end 1
..
!ERROREND
.formula M|vkvorg = ""       ? G|evtvar = "vkvorg"
.formula M|ekvorg = ""       ? G|evtvar = "ekvorg"
.cursor vkvorg 0             ? G|evtvar = "vkvorg"
.cursor ekvorg 0             ? G|evtvar = "ekvorg"
.end 1
..
..*****************************************************************************
!END
.input 'M|bfuss' ? _F|empty(M|bfuss)
.continue

