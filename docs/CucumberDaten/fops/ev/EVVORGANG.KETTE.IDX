..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name    : EVVORGANG.KETTE.IDX
.. Autor     : saac
.. Verantwortlich : teamreport
.. Kontrolle   : lei
.. Funktion    : Indexfelder der Vorgangskette fuer abas dms
.. Functionality : Creates index fields for process chain for abas dms
..*****************************************************************************
.set trans -
.type VP10 xkopf       ? _F|defined(U|xkopf)
.type VPK2 xorig       ? _F|defined(U|xorig)
.type AN5  xktyp       ? _F|defined(U|xktyp)
.type text xnrfeld     ? _F|defined(U|xnrfeld)
.type text xidfeld     ? _F|defined(U|xidfeld)
..
.assign U|xkopf = U|xorig^kopf ? F|empty(U|xkopf)
!NEXTO
.continue END ? F|empty(U|xkopf)
.copy U|xktyp = U|xkopf^ktyp
.copy U|xnrfeld = ""
.copy U|xidfeld = ""
.continue PURCHASE ? U|xkopf^dnr = 4
.. 
!SALES: Verkauf
..Chance
.copy U|xnrfeld = "VKChanNr"   ? U|xktyp = G|chko
..Chance-ID
.copy U|xidfeld = "AbasVCID"   ? U|xktyp = G|chko
..Angebot
.copy U|xnrfeld = "VKAngNr"    ? U|xktyp = G|anko
..Angebot-ID
.copy U|xidfeld = "AbasVAID"   ? U|xktyp = G|anko
..Rahmenauftrag
.copy U|xnrfeld = "VKRAufNr"   ? U|xktyp = G|rako
..Rahmenauftrag-ID
.copy U|xidfeld = "AbasVOID"   ? U|xktyp = G|rako
..Auftrag
.copy U|xnrfeld = "VKAufNr"    ? U|xktyp = G|abko
..Auftrag-ID
.copy U|xidfeld = "AbasVBID"   ? U|xktyp = G|abko
..Webauftrag
.copy U|xnrfeld = "VKWAufNr"   ? U|xktyp = G|wako
..Webauftrag-ID
.copy U|xidfeld = "abasVIID"   ? U|xktyp = G|wako
..Lieferschein
.copy U|xnrfeld = "VKLiefNr"   ? U|xktyp = G|liko
..Lieferschein-ID
.copy U|xidfeld = "AbasVLID"   ? U|xktyp = G|liko
..R…klieferschein
.copy U|xnrfeld = "VKRLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(ReturnPackingSlip)")
..R…klieferschein-ID
.copy U|xidfeld = "AbasVMID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(ReturnPackingSlip)")
..Storno-Lieferschein
.copy U|xnrfeld = "VKSLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(PackingSlipReversal)")
..Storno-Lieferschein-ID
.copy U|xidfeld = "AbasVJID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(PackingSlipReversal)")
..Stornierter R…klieferschein
.copy U|xnrfeld = "VKRLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CanceledReturnPackingSlip)")
..Stornierter R…klieferschein-ID
.copy U|xidfeld = "AbasVMID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CanceledReturnPackingSlip)")
..Storno-R…klieferschein
.copy U|xnrfeld = "VKSRLSNr"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CancelationReturnPackingSlip)")
..Storno-R…klieferschein-ID
.copy U|xidfeld = "AbasVQID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CancelationReturnPackingSlip)")
..Kundenanlieferung
.copy U|xnrfeld = "VKKLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CustomerDelivery)")
..Kundenanlieferung-ID
.copy U|xidfeld = "AbasVKID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CustomerDelivery)")
..Stornierte Kundenanlieferung
.copy U|xnrfeld = "VKKLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CanceledCustomerDelivery)")
..Stornierte Kundenanlieferung-ID
.copy U|xidfeld = "AbasVKID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CanceledCustomerDelivery)")
..Storno-Kundenanlieferung
.copy U|xnrfeld = "VKSKLSNr"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CancelationCustomerDelivery)")
..Storno-Kundenanlieferung-ID
.copy U|xidfeld = "AbasVFID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CancelationCustomerDelivery)")
..Rechnung
.copy U|xnrfeld = "VKRechNr"   ? U|xktyp = G|reko
..Rechnung-ID
.copy U|xidfeld = "AbasVRID"   ? U|xktyp = G|reko
..Storno-Rechnung
.copy U|xnrfeld = "VKSReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(InvoiceReversal)")
..Storno-Rechnung-ID
.copy U|xidfeld = "AbasVYID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(InvoiceReversal)")
..Anzahlungsrechnung
.copy U|xnrfeld = "VKAReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(Downpayment)")
..Anzahlungsrechnung-ID
.copy U|xidfeld = "AbasVWID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(Downpayment)")
..Stornierte Anzahlungsrechnung
.copy U|xnrfeld = "VKAReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CanceledDownpayment)")
..Stornierte Anzahlungsrechnung-ID
.copy U|xidfeld = "AbasVWID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CanceledDownpayment)")
..Storno-Anzahlungsrechnung
.copy U|xnrfeld = "VKSReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationDownpayment)")
..Storno-Anzahlungsrechnung-ID
.copy U|xidfeld = "AbasVYID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationDownpayment)")
..Storno-Barzahlungsrechnung
.copy U|xnrfeld = "VKSReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CashPaymentReversal)")
..Storno-Barzahlungsrechnung-ID
.copy U|xidfeld = "AbasVYID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CashPaymentReversal)")
..Storno-Gutschrift
.copy U|xnrfeld = "VKSGsNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationCreditNoteCommercial)")
..Storno-Gutschrift-ID
.copy U|xidfeld = "AbasVZID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationCreditNoteCommercial)")
!SERVICE 
..Serviceanfrage
?VKSanfNr='U|xkopf^seranf^nummer'? _F|empty(U|xkopf^seranf)
..Serviceanfrage-ID
?AbasSAId='U|xkopf^seranf^id'    ? _F|empty(U|xkopf^seranf)
..Serviceangebot
.copy U|xnrfeld = "VKSANr"     ? U|xktyp = G|snko
..Serviceangebot-ID
.copy U|xidfeld = "AbasSNID"   ? U|xktyp = G|snko
..Serviceauftrag
.copy U|xnrfeld = "VKSerNr"    ? U|xktyp = G|sbko
..Serviceauftrag-ID
.copy U|xidfeld = "AbasSBID"   ? U|xktyp = G|sbko
..Reparaturauftrag
.copy U|xnrfeld = "VKRepNr"    ? U|xktyp = G|srko
..Reparaturauftrag-ID
.copy U|xidfeld = "AbasREID"   ? U|xktyp = G|srko
..Kostenvoranschlag
.copy U|xnrfeld = "VKKostNr"   ? U|xktyp = G|kvko
..Kostenvoranschlag-ID
.copy U|xidfeld = "AbasSKID"   ? U|xktyp = G|kvko
.continue WRITE
..
!PURCHASE
..Anfrage
.copy U|xnrfeld = "EKAnfNr"    ? U|xktyp = G|anko
..Anfrage-ID
.copy U|xidfeld = "AbasEAID"   ? U|xktyp = G|anko
..Rahmenauftrag
.copy U|xnrfeld = "EKRAufNr"   ? U|xktyp = G|rako
..Rahmenauftrag-ID
.copy U|xidfeld = "AbasEOID"   ? U|xktyp = G|rako
..Bestellung
.copy U|xnrfeld = "EKBestNr"   ? U|xktyp = G|abko
..Bestellung-ID
.copy U|xidfeld = "AbasEBID"   ? U|xktyp = G|abko
..Lieferschein
.copy U|xnrfeld = "EKLiefNr"   ? U|xktyp = G|liko
..Lieferschein-ID
.copy U|xidfeld = "AbasELID"   ? U|xktyp = G|liko
..Storno-Lieferschein
.copy U|xnrfeld = "EKSLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(PackingSlipReversal)")
..Storno-Lieferschein-ID
.copy U|xidfeld = "AbasEJID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(PackingSlipReversal)")
..R…klieferschein
.copy U|xnrfeld = "EKRLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(ReturnPackingSlip)")
..R…klieferschein-ID
.copy U|xidfeld = "AbasEMID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(ReturnPackingSlip)")
..Stornierter R…klieferschein
.copy U|xnrfeld = "EKRLSNr"    ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CanceledReturnPackingSlip)")
..Stornierter R…klieferschein-ID
.copy U|xidfeld = "AbasEMID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CanceledReturnPackingSlip)")
..Storno-R…klieferschein
.copy U|xnrfeld = "EKSRLSNr"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CancelationReturnPackingSlip)")
..Storno-R…klieferschein-ID
.copy U|xidfeld = "AbasEQID"   ? U|xktyp = G|liko & F|equals(U|xkopf^lsart,"(CancelationReturnPackingSlip)")
..Rechnung
.copy U|xnrfeld = "EKRechNr"   ? U|xktyp = G|reko
..Rechnung-ID
.copy U|xidfeld = "AbasERID"   ? U|xktyp = G|reko
..Storno-Rechnung
.copy U|xnrfeld = "EKSReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(InvoiceReversal)")
..Storno-Rechnung-ID
.copy U|xidfeld = "AbasEYID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(InvoiceReversal)")
..Anzahlungsrechnung
.copy U|xnrfeld = "EKAReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(Downpayment)")
..Anzahlungsrechnung-ID
.copy U|xidfeld = "AbasEWID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(Downpayment)")
..Stornierte Anzahlungsrechnung
.copy U|xnrfeld = "EKAReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CanceledDownpayment)")
..Stornierte Anzahlungsrechnung-ID
.copy U|xidfeld = "AbasEWID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CanceledDownpayment)")
..Storno-Anzahlungsrechnung
.copy U|xnrfeld = "EKSReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationDownpayment)")
..Storno-Anzahlungsrechnung-ID
.copy U|xidfeld = "AbasEYID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationDownpayment)")
..Storno-Barzahlung
.copy U|xnrfeld = "EKSReNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CashPaymentReversal)")
..Storno-Barzahlung-ID
.copy U|xidfeld = "AbasEYID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CashPaymentReversal)")
..Storno-Gutschrift
.copy U|xnrfeld = "EKSGsNr"    ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationCreditNoteCommercial)")
..Storno-Gutschrift-ID
.copy U|xidfeld = "AbasEZID"   ? U|xktyp = G|reko & F|equals(U|xkopf^vorganga,"(CancelationCreditNoteCommercial)")
..
!WRITE
?'U|xnrfeld'='U|xkopf^nummer' ? _F|empty(U|xnrfeld)
?'U|xidfeld'='U|xkopf^id'     ? _F|empty(U|xidfeld)
..
.assign U|xorig = U|xorig^orig^id
.assign U|xkopf = U|xorig^kopf^id
.continue NEXTO
..*****************************************************************************
!END
.continue
