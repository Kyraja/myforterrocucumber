..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ZBEDSCHLM.DATENGEN
.. Author         : vbrukman
.. Verantwortlich : vbrukman
.. Kontrolle      : teamreport
.. Functionality  :
..*****************************************************************************
.set trans -
.input "is/XMLGEN.PRE.FOP"
.type text xpagename ? _defined(U|xpagename)
.type text xtfromlabel ? _defined(U|xtfromlabel)
.type text xttolabel ? _defined(U|xttolabel)
.type text xtsellabel ? _defined(U|xtsellabel)
.type integer xindex ? _defined(U|xindex)
.type integer xevtzeile ? _defined(U|xevtzeile)
.translate -language 'P|spr' -variable U|xpagename -text "Seite"
.translate -language 'P|spr' -variable U|xtfromlabel -text "von"
.translate -language 'P|spr' -variable U|xttolabel -text "bis"
.translate -language 'P|spr' -variable U|xtsellabel -text "Operator"
<?xml version="1.0" encoding="UTF-8"?>
<ABASData abasversion='G|progvers' source="Screen">
   <RecordSet caption="0">
.type integer lastrow ? _defined(U|lastrow)
.formula U|lastrow = F|condexpr(G|evtzeile=0, M|tzeilen, 1)
.type bool isSingleRow ? _defined(U|isSingleRow)
.formula isSingleRow = G|false
      <Record caption="ZBEDSCHL" lastrow="'U|lastrow'">
.assign U|xindex=0
.set foextern -
         <Head caption="0">
              <Field name="xtfromlabel" abasType="'F|typeof(U|xtfromlabel)'">'U|xtfromlabel'</Field>
              <Field name="xttolabel" abasType="'F|typeof(U|xttolabel)'">'U|xttolabel'</Field>
              <Field name="xtsellabel" abasType="'F|typeof(U|xtsellabel)'">'U|xtsellabel'</Field>
.set foextern +
.input "is/XMLGEN.COMMON.HVARS"
.set foextern -
.type text xtretagbis ? _defined(U|xtretagbis)
.translate -language 'P|spr' -dictionary vt -variable U|xtretagbis -text "Bis Rechnungstag"
              <Field name="txtretagbis" abasType="Text">'U|xtretagbis'</Field>
.type text xtretagab ? _defined(U|xtretagab)
.translate -language 'P|spr' -dictionary vt -variable U|xtretagab -text "Ab Rechnungstag"
              <Field name="txtretagab" abasType="Text">'U|xtretagab'</Field>
         </Head>
.set foextern +
.formula U|xindex=M|aktzeile
.formula isSingleRow=G|true ? (U|xindex>0)
.continue TT1OUTPUT ? _U|isSingleRow
.select screen line 'U|xindex'
.continue TTEND ? _G|mehr
.continue TT2OUTPUT
!TT1OUTPUT
.select screen line
.continue TTEND ? _G|mehr
.formula U|xindex=M|aktzeile
!TT2OUTPUT
.set foextern -
         <Row caption="'U|xindex'">
              <Field name="zn" abasType="'F|typeof(U|xindex)'" value="'U|xindex(L="0")'">'U|xindex'</Field>
              <Field name="retagbis" abasType="IP2" style="none" value="'M|retagbis(L="0")'">'M|retagbis'</Field>
              <Field name="retagab" abasType="IP2" style="none" value="'M|retagab(L="0")'">'M|retagab'</Field>
              <Field name="zbed^nameaspr" abasType="T46" style="none">'M|zbed^nameaspr'</Field>
              <Field name="page" abasType="'F|typeof(U|xpagename)'">'U|xpagename'</Field>
.set foextern +
         </Row>
.continue TTEND ? U|isSingleRow
.continue TT1OUTPUT
!TTEND
      </Record>
   </RecordSet>
</ABASData>
.input "is/XMLGEN.POST.FOP"
.continue

