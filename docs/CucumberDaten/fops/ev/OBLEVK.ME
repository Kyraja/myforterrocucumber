..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : OBLEVK.ME
.. Autor          : tg/fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Initialisiert den Maskenpuffer.
.. Ablauf         : Maskeneintritts-EFOP
..
.. Functionality  : Initializes the mask buffer.
.. Program flow   : Mask entry efop
..*****************************************************************************
.set trans -
..
.. Equal for all
.formula P|maskkontextfop = ""
.formula M|aarts  = "(Active)"
.formula M|anafo = F|defined(M|ano)   ; F|defined(M|afo)
.formula M|aubeo = F|defined(M|auo)   ; F|defined(M|beo)
.formula M|lio   = F|defined(M|liov)  ; F|defined(M|lioe)
.formula M|reo   = F|defined(M|reov)  ; F|defined(M|reoe)
.copy M|mitalternativpos = G|FALSE
..
.. Special cases for all but not outstanding deliveries
.continue CONTROL ? M|lio
.copy M|auswaehr  = G|inland
.copy M|ausnkst = M|auswaehr^nkst
..
!CONTROL
.continue ANGEBOT ? F|defined(M|ano)
.continue ANFRAGE ? F|defined(M|afo)
.continue AUFBEST ? M|aubeo ; M|lio
.continue END
..
!ANGEBOT
.formula M|kotyps = "(Quotation)"
.continue END
..
!ANFRAGE
.formula M|kotyps = "(Request)"
.continue END
..
!AUFBEST
.formula M|kotyps = "(SalesOrder)"    ? M|datnr = 3
.formula M|kotyps = "(PurchaseOrder)" ? M|datnr = 4
..*****************************************************************************
!END
.continue
