..!interpreter english translate noabbrev src=de
..*****************************************************************************
.. FOP-Name       : OBLEVKRAHMEN.BSTART.BV
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Bestimmt aus den Eingabefeldern die Datenbankanfrage.
.. Ablauf         : Button-vor-EFOP
..
.. Functionality  : Creates database query from the input fields.
.. Program flow   : Before button efop
..
.. include ev/OBLEVKRAHMEN.BFUSS
.. include ev/OBLEVKRAHMEN.TAB2
..*****************************************************************************
.set trans -
..
.. Declarations
.type text xpvon xpbis xord
.type text    xtsel         ? _F|defined(U|xtsel)
.type integer xzn           ? _F|defined(U|xzn)
.type integer xaktzeile     ? _F|defined(U|xaktzeile)
.type bool    xbmehr        ? _F|defined(U|xbmehr)
.type P3:1    xtzrahmen     ? _F|defined(U|xtzrahmen) & F|defined(M|rauov)                  
.type P4:1    xtzrahmen     ? _F|defined(U|xtzrahmen) & F|defined(M|rauoe)
.type P3:2    xtzrahmenpos  ? _F|defined(U|xtzrahmenpos) & F|defined(M|rauov)
.type P4:2    xtzrahmenpos  ? _F|defined(U|xtzrahmenpos) & F|defined(M|rauoe)
.type text    xrahmen       ? _F|defined(U|xrahmen)
..
.set trans +
.formula U|xrahmen = "Rahmenauftrag"
.set trans -
.copy U|xbmehr = G|FALSE
.continue BSTART   ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue OPENALL  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "auf"
.continue CLOSEALL ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "zu"
.continue DETAIL   ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "tdetail"
.continue FOLGE    ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bfolge"
..
!FOLGE
.continue ERROR3 ? F|empty(M|evpos)
.type text xkomm:100
..
.assign U|xkomm = "{1}<{2}>"
.formula U|xkomm = F|formatstr(U|xkomm, M|evpos^id, "(Release)") 
.end 0 'U|xkomm'
.continue END
..
!OPENALL
.select screen header
..
!SELLINE
.select screen line
!S1ELLINE
.continue END  ? _G|mehr 
.continue OPEN ? G|evtvar = "auf" & M|tdetail = "icon:folder_closed"
.continue SELLINE
..
!CLOSEALL
.select screen header
.select screen line 1
..
!SELCLOSE
.select screen line 'M|aktzeile'
.continue END       ? M|aktzeile = M|tzeilen
.continue CLOSE     ? G|evtvar = "zu" & M|tdetail = "icon:folder_opened"
.continue CLOSE     ? G|evtvar = "zu" & M|tdetail = "" 
.select screen line ? G|evtvar = "zu" & M|tdetail = "icon:folder_closed"
.continue CLOSE     ? G|evtvar = "zu" 
.continue END
..
!OPEN: Erst Schleife Åber alle vorgÑnge mit Rahmenauftrag als direkten VorgÑnger
.. um keine Doubletten zu erhalten, mÅssen drei Schleifen selektiert werden. (okopf=leer und okopf=rahmenauftrag)
.. dann zu diesen Treffern die orig-Verfolgung
.assign U|xtzrahmen = M|tzrahmen
.assign U|xtzrahmenpos = M|tzrahmenpos
.formula U|xaktzeile = M|aktzeile + 1
.formula U|xtsel = "$,,;okopf="+'M|tzrahmen'+";gruppe=2;zrahmen=="+M|tzrahmen^id+";zrahmenpos="+M|tzrahmenpos^id+";artex=="+M|art^id+";okopf=;kotyp<>(BlanketOrder);@ablageart=(Both)"
..
.load 1 sales 'U|xtsel'       ? F|defined(M|rauov)
.load 1 purchasing 'U|xtsel'  ? F|defined(M|rauoe)
.continue SECOND ? _G|mehr
.formula M|tdetail = "icon:folder_opened"  ? M|ttypa = U|xrahmen
.continue M2AKE
..
!L2OOP
.load 1 sales       ? F|defined(M|rauov)
.load 1 purchasing  ? F|defined(M|rauoe)
.continue SECOND    ? _G|mehr
.formula M|tdetail = "icon:folder_opened"  ? M|ttypa = U|xrahmen
.continue M2AKE
..
!M2AKE
.input "ev/OBLEVKRAHMEN.TAB2"
.continue L2OOP
..
!SECOND: Schleife Åber alle VorgÑnge mit leerem okopf
.formula U|xtsel = "$,,;okopf=`;gruppe=2;zrahmen=="+U|xtzrahmen^id+";zrahmenpos="+U|xtzrahmenpos^id+";artex=="+M|art^id+";okopf=;kotyp<>(BlanketOrder);@ablageart=(Both)"
.continue SELEKTION
..
!STUFE
.continue END       ? U|xaktzeile > M|tzeilen
.select screen line 'U|xaktzeile'
.continue END       ? _G|mehr
.continue END       ? U|xbmehr & G|evtvar = "tdetail" & _F|empty(M|tzrahmen)
.continue S1ELLINE  ? U|xbmehr & G|evtvar = "auf" & _F|empty(M|tzrahmen)
.formula U|xtsel = "$,,;@gruppe=2;orig^id="+'M|evpos^id'+"okopf="+M|kopf^id+";zrahmen=="+U|xtzrahmen^id+";zrahmenpos="+U|xtzrahmenpos^id+";artex=="+M|art^id+";@ablageart=(Both)"
.formula U|xaktzeile = M|aktzeile + 1
.continue SELEKTION 
..
!SELEKTION
.copy U|xbmehr = G|FALSE
.load 1 sales 'U|xtsel'       ? F|defined(M|rauov)
.load 1 purchasing 'U|xtsel'  ? F|defined(M|rauoe)
.copy U|xbmehr = G|TRUE ? _G|mehr 
.continue STUFE         ? _G|mehr 
.. wenn kopf = leer, dann Bestellvorschlag
.continue LOOP          ?  F|empty(1|kopf)
.formula M|tdetail = "icon:folder_opened"  ? M|ttypa = U|xrahmen
.continue MAKE
..
!LOOP
.copy U|xbmehr = G|FALSE
.load 1 sales       ? F|defined(M|rauov)
.load 1 purchasing  ? F|defined(M|rauoe)
.copy U|xbmehr = G|TRUE ? _G|mehr
.continue STUFE         ? _G|mehr
.continue LOOP          ?  F|empty(1|kopf)
.formula M|tdetail = "icon:folder_opened"  ? M|ttypa = U|xrahmen
..
!MAKE
.input "ev/OBLEVKRAHMEN.TAB2"
.assign M|tbasisartikel = 1|artikel^basisartikel
.continue LOOP
..
!CLOSE
.formula U|xzn = M|zn
.select screen line 'M|aktzeile'
.formula M|tdetail = "icon:folder_closed"  ? M|tdetail = "icon:folder_opened"
.formula U|xzn  = M|aktzeile + 1
..
!CLOSEMORE
.formula U|xzn  = M|aktzeile + 1 ?  M|tdetail = "icon:folder_closed"
.continue END ? U|xzn > M|tzeilen & G|evtvar = "zu"
.continue END ? U|xzn > M|tzeilen & G|evtvar = "tdetail"
.select screen line 'U|xzn'
.continue END ?  M|ttypa = U|xrahmen & G|evtvar = "tdetail"
.continue SELCLOSE ? M|ttypa = U|xrahmen & G|evtvar = "zu"
.set trans -
...continue CLOSEMORE ? _F|empty(M|tkuli2)
.make screen line -o 
.continue CLOSEMORE
..
!DETAIL
.continue CLOSE ?  M|tdetail = "icon:folder_opened"
.continue OPEN  ?  M|tdetail = "icon:folder_closed"
.continue END
..
!BSTART
.. Check document ID no./searchword range
.type ID3:1 xdocument  ? F|defined(M|rauov)
.type ID4:1 xdocument  ? F|defined(M|rauoe)
.assign U|xdocument = "$,,;@gruppe=1;@numsuch=" + M|belegvon + "!" + M|belegbis + ";@lesen=" + 'G|FALSE'
.continue ERROR1 ? _G|mehr
..
!DATES: Check date range
.continue ERROR2 ? _F|empty(M|belegbis) & M|belegbis < M|belegvon
..
!SELECT
.formula M|select = "!" ? F|empty(M|select)
..
.. clear table
.make screen line -- ? M|tzeilen > 0
..
.. Goto END while using a selection bar
.continue END ? M|selektion
..
.. Equal for all
.formula U|xord = ""
.formula M|select = "$,,;@ablageart=" + M|aarts
..
.continue FROMTO ? F|empty(M|vorgartaz)
.formula M|select = M|select + F|formatstr(";{1}={2}", F|condexpr(M|lio, "kopf^vorgartaz", "vorgartaz"), M|vorgartaz^id)
..
!FROMTO
.continue RAHMEN  ? F|empty(M|belegvon) & F|empty(M|belegbis)
..
!RANGE: Range of numbers, searchwords
.formula U|xord = ";@ordnung=nummer"
.formula M|select = M|select + ";@numsuch=" + M|belegvon + "!" + M|belegbis
..
!RAHMEN
.continue ZEICH  ?  F|empty(M|zrahmen)
.formula M|select = M|select + ";id="+ M|zrahmen^id
..
!ZEICH
.continue DATNR  ?  F|empty(M|kzeich)
.formula M|select = M|select + ";zeich=="+ M|kzeich
..
!DATNR: Specials for sales (3) and purchasing (4)
.continue SALES    ? M|datnr = 3
.continue PURCHAS  ? M|datnr = 4
.continue FATAL
..
!SALES: Commitments of sales
.formula U|xord = ";@ordnung=ktyp,kunde,vom" ? F|empty(U|xord)
.continue RECHEMP  ? F|empty(M|kkuli)
.formula M|select = M|select + ";kl==" + M|kkuli^id
..
!RECHEMP: Invoice recipient
.continue REPRESE ? F|empty(M|kkuli2)
.formula M|select = M|select + F|formatstr(";{1}={2}", F|condexpr(M|lio, "kopf^reempf", "reempf"), M|kkuli2^id)
..
!REPRESE: Representative
.continue TYP ? F|empty(M|kvertret)
.formula M|select = M|select + F|formatstr(";{1}={2}", F|condexpr(M|lio, "kopf^vertret", "vertret"), M|kvertret^id)
.continue TYP
..
!PURCHAS: Commitments of purchase
.formula M|select = M|select + ";ebeleg==" + M|kebeleg ? F|defined(M|kebeleg)
..
.formula U|xord = ";@ordnung=ktyp,lief,vom" ? F|empty(U|xord)
.continue PARTNER ? _F|defined(M|ausschr)
.continue PARTNER ? F|empty(M|ausschr)
.formula M|select = M|select + ";ausschr==" + M|ausschr^id
..
!PARTNER
.continue RECHERS ? F|empty(M|kkuli)
.formula M|select = M|select + ";kl==" + M|kkuli^id
..
!RECHERS: Invoice to
.continue TYP ? F|empty(M|kkuli2)
.formula M|select = M|select + F|formatstr(";{1}={2}", F|condexpr(M|lio, "kopf^resteller", "resteller"), M|kkuli2^id)
..
!TYP
.formula M|select = M|select + ";typ==" + M|kotyps
..
!FOLLOW: Add options
.formula M|select = M|select + ";@gruppe=1"
.continue ORDER ? _M|wvdat
.formula M|select = M|select + ";wvorlage=" + 'G|TRUE' + ";@ordnung=tterm"
.continue END
..
!ORDER: Add order rules
.formula M|select = M|select + U|xord
.continue END
..
..*****************************************************************************
!END
.input "ev/OBLEVKRAHMEN.BFUSS"
.continue
..*****************************************************************************
!FATAL
.error -number 1111
.end 1
..
!ERROR1: Wrong range!
.. kernel shows eror message
.error
.cursor belegvon 0
.end 1
..
!ERROR2: Wrong range!
.cursor belegvon 0
.error Untergrenze ist grî·er als Obergrenze.
.end 1
..
!ERROR3
.error Folgebeleg nur fÅr Rahmenauftragsposition mîglich.
.end 1

