..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : RESERVE.RELEVANT
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      :
.. Functionality  : relevant bestimmen 
..*****************************************************************************
.set trans -
.type bool xbend   ? _F|defined(U|xbend)
..
.copy U|xbend = G|FALSE
.. lade Artikel mit StÅckliste
.load 1 add M|kartikel^id
.continue TEND  ? _G|mehr
.continue TEND  ? 1|gruppe <> 1
.. keine StÅcklistenprÅfung bei negativen Mengen
.continue TEND  ? H|mge <= 0
.copy U|xlaggr    = 1|lgruppean
.copy U|xlaggr    = U|xintlg  ? F|empty(1|lgruppean)
.copy 1|lgruppean = U|xlaggr  ? U|xlaggr^id <> U|xintlg^id ; F|equals(1|bsart, "(Relocation)")
.continue WGROUP              ? _F|equals(1|bsart, "(Relocation)") ; 1|tzeilen<>1
.load 1 line 1
.continue WGROUP              ? 1|elem^id <> 1|id
.. skip destination warehouse group, continue with source warehouse group
.copy 1|lgruppean = 1|umllg
..
!WGROUP
.load 1 header
.formula 1|gesmge = H|mge * H|lehe
.copy 1|mitaufl   = G|TRUE
.copy 1|konddat   = 9|wtterm  ?  F|defined(9|wtterm)
.copy 1|konddat   = H|wtterm  ? _F|defined(9|wtterm)
.continue END
..
..*****************************************************************************
!TEND
.copy U|xbend = G|TRUE
.continue
..
!END
.copy U|xbend = G|FALSE
.continue
