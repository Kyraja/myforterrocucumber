..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : SEPAMANDAT.TAB
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : 
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
.. SEPA
.formula M|layoutnum = 1 ?  F|empty(H|debnameabw)
.. SEPA.KONTOABW
.formula M|layoutnum = 2 ?  _F|empty(H|debnameabw)
..
.. Mandat
.formula M|sepamref   = H|sepamref
.copy M|einmallast    = H|einmallast
.formula M|sepamdatum = H|sepamdatum
.copy M|sepamverw     = H|sepamverw
.copy M|sepamaktiv    = H|sepamaktiv
..
.. Kreditor
.formula M|kredname = H|kredname
.formula M|kredstr  = H|kredstr
.formula M|kredplz  = H|kredplz
.formula M|krednort = H|krednort
.copy M|kredstaat   = H|kredstaat
.copy M|gkonto      = H|gkonto
.formula M|sepacred = H|sepacred
..
.. Debitor
.copy M|debitor      = H|debitor
.formula M|debname   = H|debname
.formula M|debstr    = H|debstr
.formula M|debplz    = H|debplz
.formula M|debnort   = H|debnort
.copy M|debstaat     = H|debstaat
.formula M|sepadebt  = H|sepadebt
.formula M|debiban   = H|debiban
.formula M|debiident = H|debiident
.formula M|debbverb  = H|debbverb^bname
..
.. Vertragspartner
.formula M|debnameabw = H|debnameabw
.formula M|vertrag    = H|vertrag
.formula M|vertrzweck = H|vertrzweck
..
.. Texte
.type text xttmpfile ? _F|defined(U|xttmpfile)
.type bool xok       ? _F|defined(U|xok)
.input "DATEI.F"
.continue TXT1
..
!TXT1
.continue TXT2      ? F|empty(H|ktext1)
.formula M|ktext1  = H|ktext1^namebspr
..
.copy M|ftext1 = H|ktext1
..
.file -screen -tempname U|xttmpfile -suffix "TXT1"
.output new 'U|xttmpfile'
.continue T1ENG ? _F|isvalue(F|tostring(M|debitor^spr, "AU72"), "A159")
.. correspondence language
.copy P|spr = M|debitor^spr ? F|modifiable(P|spr)
.formula U|xok = _F|empty(F|eval("M|ftext1^ftext" + P|ksi))
.continue TXT12 ? U|xok
..
!T1ENG: english
.continue T1GER  ? _F|isvalue("(69)", "A159")
.assign P|spr  = "(69)" ? F|modifiable(P|spr)
.formula U|xok = _F|empty(F|eval("M|ftext1^ftext" + P|ksi))
.continue TXT12 ? U|xok
..
!T1GER: german
.continue TXT2 ? _F|isvalue("(68)", "A159")
.assign P|spr  = "(68)" ?  F|modifiable(P|spr)
.formula U|xok = _F|empty(F|eval("M|ftext1^ftext" + P|ksi))
.continue TXT2 ? _U|xok
..
!TXT12
.input 'F|eval("M|ftext1^ftext" + P|ksi)'
.output new WERF.WEG
.formula M|vftext1 = 'U|xttmpfile'
.continue TXT2
..
!TXT2
