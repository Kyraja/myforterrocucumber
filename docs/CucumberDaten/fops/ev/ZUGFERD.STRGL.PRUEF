..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ZUGFERD.STRGL.PRUEF
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..
..  Einsetzbar bei folgenden Events und Masken
..
..# 990 Ñndern   maskpruef  * * * [C] ZUGFERD.STRGL.PRUEF
..# 990 neu      maskpruef  * * * [C] ZUGFERD.STRGL.PRUEF
..# 990 Rechnung maskpruef  * * * [C] ZUGFERD.STRGL.PRUEF
..# 990 retoure  maskpruef  * * * [C] ZUGFERD.STRGL.PRUEF
..# 990 storno   maskpruef  * * * [C] ZUGFERD.STRGL.PRUEF
..
..*****************************************************************************
.set trans -
.continue END   ? _F|sysinfo(18)^zugferd
..
.. Pflichtfeld Steuerart
.. vorbelegt mit Mehrwertsteuer
.assign M|zftaxtyp = "(TaxTypeCodeVAT)"
.continue ERROR1 ? F|empty(M|zftaxtyp) & _F|empty(M|zftaxcode)
..
.. Grund der Steuerbefreiung fÅllen 
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodeNull)")
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodeExempt)")
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodeReverse)")
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodeInsideEU)")
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodeOutside)")
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodeIGIC)")
.continue ERROR2 ? F|empty(M|zfvatexemp) & _F|empty(M|zftaxcode) & F|equals(M|zftaxcode, "(ZFTaxCodePSI)")
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR1
.error ZUGFeRD: Die Steuerart fehlt. Bitte eintragen.
.cursor zftaxtyp 0
.end 1
..
!ERROR2
.error ZUGFeRD: Der Grund der Steuerbefreiung fehlt. Bitte eintragen.
.cursor zfvatexemp 0
.end 1
