..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.CACHE.DELIVERY.OUT.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. search fields must defined
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
.type VP23 xgefundenVP23 ? _F|defined(U|xgefundenVP23)
..
..*****************************************************************************
..
.type bool xvp23empty ?_F|defined(U|xvp23empty)
.copy U|xvp23empty = G|false
..
.. create variablen name from parameters
.. remove all non-valid symbols (should be none, but better not risk FO complications)
.type text xvp23name ? _F|defined(U|xvp23name)
.formula U|xvp23name = F|formatstr("X{1}X{2}X{3}", U|xsuchnummer, U|xsuchlieferant, U|xsuchresteller)
.formula U|xvp23name = F|regreplaceall(U|xvp23name, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^\ \-]", "")
..
.continue END ? _F|defined(U|.xvp23name)
..
.copy    U|xgefundenVP23 = U|.xvp23name 
.continue CACHE ? _F|empty(U|xgefundenVP23)
..
.. die Suche wurde bereits durchgefuehrt, und das Ergebnis war leer
.copy U|xvp23empty = G|true
.continue EMPTY
..
..*****************************************************************************
!END
.continue
..
!EMPTY
.. .println Der Wert fÅr Suche 'U|xvp23name' ist leer.
.continue
..
!CACHE
.. .println Der Wert fÅr Suche 'U|xvp23name' wurde als 'U|xgefundenVP23' aus dem Cache gelesen.
.continue 
