.. Functionality  :
..*****************************************************************************
.set trans -
.continue LEEREN    ? G|evtartengl = "FIELD_EXIT"
.continue BSTART
..
!LEEREN
.formula M|layoutnum    = ""
.formula M|sepamref     = ""
.formula M|einmallast   = ""
.formula M|sepamdatum   = ""
.formula M|sepamverw    = ""
.formula M|sepamaktiv   = ""
.formula M|ktext1       = ""
.formula M|ktext2       = ""
.formula M|ktext3       = ""
.formula M|ktext4       = ""
.formula M|ktext5       = ""
.formula M|ftext1       = ""
.formula M|ftext2       = ""
.formula M|ftext3       = ""
.formula M|ftext4       = ""
.formula M|ftext5       = ""
.formula M|kredname     = ""
.formula M|kredstr      = ""
.formula M|kredplz      = ""
.formula M|krednort     = ""
.formula M|kredstaat    = ""
.formula M|gkonto       = ""
.formula M|sepacred     = ""
.formula M|debitor      = ""
.formula M|debname      = ""
.formula M|debstr       = ""
.formula M|debplz       = ""
.formula M|debnort      = ""
.formula M|debstaat     = ""
.formula M|sepadebt     = ""
.formula M|debiban      = ""
.formula M|debiident    = ""
.formula M|debbverb     = ""
.formula M|debnameabw   = ""
.formula M|vertrag      = ""
.formula M|vertrzweck   = ""
..
!BSTART
.select add M|num66
.continue END ? _G|mehr
.input 'M|bkopf' ? _F|empty(M|bkopf)
.input 'M|tab'   ? _F|empty(M|tab)
.input 'M|bfuss' ? _F|empty(M|bfuss)
..
.assign M|drbelegart = M|num66^drbelegart
.assign P|belegart   = M|num66^drbelegart
.formula M|barcode        = M|num66^barcode ? F|empty(M|barcode)
.formula M|barcodedrucken = G|TRUE ? M|num66^gruppe = 3
.continue END
..
..*****************************************************************************
!END
.continue
