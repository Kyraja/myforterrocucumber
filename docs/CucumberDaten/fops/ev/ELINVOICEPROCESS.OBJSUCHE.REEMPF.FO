..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.REEMPF.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type text   xtext           ? _F|defined(U|xtext)
..
.formula M|button9 = M|gruenz
..<META M|='ev/ELINVOICEPROCESS'>
..
.continue EMPTY ? F|empty(M|InvoiceTradePartyID) &  F|empty(M|BuyerTradePartySpecifiedTaxRegistration)
.. 
.formula M|eigustid = ""
.formula M|eigsteunr = ""
.copy M|reempfpasstzubetriebsdaten = G|false
.copy M|reempfpasstzubetriebsdaten = G|true ?  M|BuyerTradePartySpecifiedTaxRegistration = 'F|sysinfo(10)^steunr'
.copy M|reempfpasstzubetriebsdaten = G|true ?  M|BuyerTradePartySpecifiedTaxRegistration = 'F|sysinfo(10)^ustid'
.copy M|reempfpasstzubetriebsdaten = G|true ?  M|InvoiceTradePartyID = 'F|sysinfo(10)^gln'
.formula M|eigustid = F|sysinfo(10)^ustid
.formula M|eigsteunr = F|sysinfo(10)^steunr
.colour -background 'U|xabasyellow' reempfpasstzubetriebsdaten ? _M|reempfpasstzubetriebsdaten
.continue END ? M|reempfpasstzubetriebsdaten
..
..*****************************************************************************
..
.formula M|button9 = M|rotz 
.. Aufruf: ev/ELINVOICEPROCESS.OBJSUCHE.VP5.BUSINESSPARTNER.FO
.type text searchfop ? _F|defined(U|searchfop)
.formula U|searchfop = "ev/ELINVOICEPROCESS.OBJSUCHE.VP5.BUSINESSPARTNER.FO"
..
.. Parameter-Felder 
.type text xsuchsteunr ? _F|defined(U|xsuchsteunr)
.type text xsuchustid  ? _F|defined(U|xsuchustid)
.type text xsuchgln    ? _F|defined(U|xsuchgln)
.. Ergaenzende Parameter um Kunden/Lieferanten NICHT zu durchzsuchen
.. Hier: Kundenstamm nicht durchsuchen
.type bool xskippLIEF  ? _F|defined(U|xskippLIEF)
.type bool xskippKUN   ? _F|defined(U|xskippKUN)
.copy U|xskippKUN = G|true
..
.. Ergebnis-Felder
.type VP5 xgefundenVP5 ? _F|defined(U|xgefundenVP5)
.type text xtsuchfehler ? _F|defined(U|xtsuchfehler)
..
.formula U|xsuchsteunr = M|BuyerTradePartySpecifiedTaxRegistration
.formula U|xsuchustid = M|BuyerTradePartySpecifiedTaxRegistration
.formula U|xsuchgln = M|InvoiceTradePartyID
..
.input 'U|searchfop'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue ERROR ? F|empty(U|xgefundenVP5)
.assign M|reempf = U|xgefundenVP5
..
..*****************************************************************************
!END
.continue
..
!EMPTY
.formula U|xtext = F|formatstr("Kein passender RechnungsempfÑnger vorhanden.")
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.formula M|button9 = M|rotz
.continue
..
!ERROR
.formula U|xtext = F|formatstr("Die GLN {1} in den Betriebsdaten stimmt nicht Åberein mit der Nummer {2}.", 'F|sysinfo(10)^gln', 'M|InvoiceTradePartyID')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.formula U|xtext = F|formatstr("Die Steuernummernummer {1} bzw. die Umsatzsteuer-Identifikationsnummer {2} in den Betriebsdaten stimmt nicht Åberein mit der Nummer {3}.", 'F|sysinfo(10)^steunr', 'F|sysinfo(10)^ustid', 'M|BuyerTradePartySpecifiedTaxRegistration')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.formula U|xtext = F|formatstr("Es ist kein anderer Handelspartner mit diesen Angaben im System.")
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.formula M|button9 = M|rotz
.continue
