..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : EVVORGANG.VAR
.. Autor          : rs
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Varianten drucken
..*****************************************************************************
.set trans -
..
.type text  xtposid ? _F|defined(U|xtposid)
..
.formula U|xtposid = M|position^id
.load 5 add H|orig
.continue END  ? _G|mehr
.continue ORIG2 ? 5|kotyp <> 3
..
!STZEILE
.load 5 line
.continue END ? 5|pnum <> "A"
..
.load 7 add 5|art
.copy U|xbinres = G|false
.formula U|xtvbez  = '7|vbez.P|ksi'

!ZUPOS: Zusatzposition (Typ=12)
..      LS: die Menge wird ausgegeben / STD: der Preis wird ausgegeben
.make screen line +O
.formula M|position = 'U|xtposid'
.formula M|pos      = 5|pnum
.formula M|artikel  = 7|ident
.formula M|vbez     = 'U|xtvbez'
.continue STZEILE
..
!ORIG2
.load 6 add 5|orig
.continue END ? _G|mehr
.continue END ? 6|kotyp <> 3
..
!ST2ZEILE
.load 6 line
.continue END ? 6|pnum <> "A"
..
.load 7 add 6|art
.copy U|xbinres = G|false
.formula U|xtvbez  = '7|vbez.P|ksi'
..      LS: die Menge wird ausgegeben / STD: der Preis wird ausgegeben
.make screen line +O
.formula M|position = 'U|xtposid'
.formula M|pos      = 6|pnum
.formula M|artikel  = 7|ident
.formula M|vbez     = 'U|xtvbez'
.continue ST2ZEILE
..*****************************************************************************
!END
.continue
