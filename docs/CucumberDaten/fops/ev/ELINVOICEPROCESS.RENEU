?num4;ebeleg;lief;resteller;fakt;**ftext;zaform;bverb;vom;zbed;ident;bem\        ? _M|bewlei & _F|empty(M|zbed)
artex;mge;preis;ljtext1;pwert;kstelle;konto
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';-;'M|IssueDateTime';'M|SpecifiedTradePaymentTermsDueDateDateTime';'M|edifact^nummer';'M|DeliveryDateTime';'M|bem'\ ?  M|bewlei & 'M|kobverb' = 'M|resteller^bverb' & F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';-;'M|IssueDateTime';'M|SpecifiedTradePaymentTermsDueDateDateTime';'M|edifact^nummer';'M|bem'\                      ? _M|bewlei & 'M|kobverb' = 'M|resteller^bverb' & F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';'M|kobverb';'M|IssueDateTime';'M|SpecifiedTradePaymentTermsDueDateDateTime';'M|edifact^nummer';'M|DeliveryDateTime';'M|bem'\   ?  M|bewlei & 'M|kobverb' <> 'M|resteller^bverb' & F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';'M|kobverb';'M|IssueDateTime';'M|SpecifiedTradePaymentTermsDueDateDateTime';'M|edifact^nummer';'M|bem'\                        ? _M|bewlei & 'M|kobverb' <> 'M|resteller^bverb' & F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';-;'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|DeliveryDateTime';'M|bem'\ ?  M|bewlei & 'M|kobverb' = 'M|resteller^bverb' & _F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';-;'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|bem'\                      ? _M|bewlei & 'M|kobverb' = 'M|resteller^bverb' & _F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';'M|kobverb';'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|DeliveryDateTime';'M|bem'\   ?  M|bewlei & 'M|kobverb' <> 'M|resteller^bverb' & _F|empty(M|zbed)
?~;'M|ExchangedDocumentID';'M|lieferant^id';'M|resteller^id';FALSE;'M|notizen';'M|zaform(L="0")';'M|kobverb';'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|bem'\                        ? _M|bewlei & 'M|kobverb' <> 'M|resteller^bverb' & _F|empty(M|zbed)
..
!WGLINE
.select screen line
.continue ZUPOST  ? _G|mehr
.continue WGLINE  ? M|zeilentyp<>0 
.. Zeilentyp Zu-/Abschl„ge mssen noch korrekt eingefgt werden
'M|artikel^id';'M|BilledQuantity';'M|NetPriceProductTradePrice:2';'M|ljtext1';~;~;~\ 
.continue WGLINE
..
!ZUPOS
.select screen header
.continue OUTPUT ? _G|mehr
..
!ZUPLINE
.select screen line
.continue OUTPUT ? _G|mehr
.continue ZUPLINE ? _M|bzusatz
?'M|artikel^id';'M|BilledQuantity';~;~;'M|LineTotalAmount';'M|kstelle';'M|konto'\ ? M|zeilentyp = 0
?'M|artikel^id';~;~;~;~;'M|ChargeActualAmount';'M|kstelle';'M|konto'\             ? M|zeilentyp = 2
.continue ZUPLINE
..
!OUTPUT
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR ? _G|mehr
..
..*****************************************************************************
!END
.continue 
..
!ERROR
.formula U|xtcmd = "sed " + 'G|apostroph' + "s/^.*): //" + 'G|apostroph' + " " +'U|xterr' +" >" + 'U|xterr2'
.system 'U|xtcmd' background
.input 'U|xterr2'
.error -message Rechnung erstellen gescheitert!
.end 1

