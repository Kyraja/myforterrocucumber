..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.EINHEIT.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type text   xtext           ? _F|defined(U|xtext)
..
..<META M|='ev/ELINVOICEPROCESS'>
..<META 9|='P62:1'>
..
.colour -background -1 -1 -1 einheit 'M|aktzeile'
.. 
.continue END ? M|zeilentyp<>0
.continue NOUNIT ? F|empty(M|BilledQuantityUnitCode)
..
.. UN/ECE in Einheiten suchen
.load 9 unit 'F|formatstr("$,,;@gruppe=1;gruppe=1;zfunece=={1}", M|BilledQuantityUnitCode)'
.continue EUNECE ? _G|mehr
.assign M|einheit = 9|einheitbspr
.load 9
.continue END ? _F|empty(M|einheit)
!EUNECE
.. 
.. ISO-CODE in Einheiten suchen
.load 9 unit 'F|formatstr("$,,;@gruppe=1;gruppe=1;eiso=={1}", M|BilledQuantityUnitCode)'
.continue EISO ? _G|mehr
.assign M|einheit = 9|einheitbspr
.load 9 
.continue END
!EISO
..
.. Bekannte STUECK-Varianten 
.continue EH87 ? M|BilledQuantityUnitCode<>"H87" &  M|BilledQuantityUnitCode<>"C62"
.load 9 unit 'F|formatstr("$,,;@gruppe=1;gruppe=1;eiso=={1}", "PCE")'
.continue EH87 ? _G|mehr
.assign M|einheit = 9|einheitbspr
.load 9
.continue END
!EH87
..
.continue NOUNIT ? F|empty(M|einheit)
..
..*****************************************************************************
!END
.continue
..
!NOUNIT
.colour -background 'U|xabasyellow' einheit 'M|aktzeile' 
.formula U|xtext = F|formatstr("FEHLER: Einheit {1} ist nicht als ISO-Einheit gepflegt.", 'M|BilledQuantityUnitCode')
.formula M|fctext = 'M|fctext' + ";" + 'U|xtext'
.continue
