..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : DRUCK.BN
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Includes       :
.. include ev/EVVORGANG.TAB
.. include ev/KOPFLEEREN
..*****************************************************************************
.set trans -
..
.continue END ? _G|evtartengl = "BUTTON_AFTER" ; _G|evtvar = "bstart"
..
.type text xbsart  ? _F|defined(U|xbsart)
.type DVM2 xbatext ? _F|defined(U|xbatext)
.type DVM2 xbstext ? _F|defined(U|xbstext)
.type bool xvkliko ? _F|defined(U|xvkliko)
.type text origftext copyftext
..
.set separator
..
.input "ev/KOPFLEEREN"
.make screen line -- ? M|tzeilen > 0
.continue ERROR1     ? F|empty(M|vorgang)
..
.copy M|bewlei = F|sysinfo(18)^bewlei
.formula P|jobname = M|vorgang^nummer
.select object 'M|vorgang^id'
.continue ERR           ? _G|mehr
..
.copy M|uzeich = G|bzeichen
..
.continue BWTERM        ? F|empty(H|ftext)
.output new WERF.WEG
.file -screen -tempname M|ftext
.output new 'M|ftext'
.input "DATEI.F"
.input -text 'H|ftext'
.formula M|ftextroh = H|ftext
..
!BWTERM
.formula M|ekvk = M|vorgang^dnr
.formula M|vnummer = M|vorgang^nummer
.formula M|frzeich = M|vorgang^frzeich
.formula M|navom = M|vorgang^navom
.formula M|klbem = M|vorgang^kunde^bem  ? M|ekvk = 3
.formula M|leidat =  M|vorgang^leidat   ? M|bewlei
..
.. Firmenanschrift holen
.formula M|firmaans = F|sysinfo(10)^ans
.formula M|firmastr = F|sysinfo(10)^str
.formula M|firmaplz = F|sysinfo(10)^plz
.formula M|firmanort = F|sysinfo(10)^nort
.formula M|firmalakenn = F|sysinfo(10)^lakenn
.assign M|firmastaat = F|sysinfo(10)^staat
.assign M|firmaregion = F|sysinfo(10)^region
.formula M|steunr = F|sysinfo(10)^steunr
.formula M|ustid = F|sysinfo(10)^ustid
.assign M|firmenans = M|firmaans + " * " + M|firmastr + " * " + M|firmaplz + " " + M|firmanort
..
.assign M|drbelegart = M|vorgang^drbelegart
.assign P|belegart = M|vorgang^drbelegart
..
.continue NEXT     ? _(H|typ = G|liko & M|ekvk = 4)
.continue HALBFABR ? H|typ = G|liko & M|ekvk = 4 & F|equals(H|bsart, "(Relocation)")
..
!NEXT
.. Verkauf
.continue LSANSCHR ? H|typ = G|liko & M|ekvk = 3
.continue ANSCHR1  ? M|ekvk = 3
.. Einkauf
.continue ANSCHR1  ? M|belastung
.continue LSANSCHR ? M|ekvk = 4 & F|equals(H|lsart, "(CancelationReturnPackingSlip)") & H|typ = G|liko
.continue LSANSCHR ? M|ekvk = 4 & F|equals(H|lsart, "(CanceledReturnPackingSlip)") & H|typ = G|liko
.continue LSANSCHR ? M|ekvk = 4 & F|equals(H|lsart, "(ReturnPackingSlip)") & H|typ = G|liko
.continue INTERN   ? M|ekvk = 4 & F|equals(H|lsart, "(PackingSlipReversal)") & H|typ = G|liko
.continue INTERN   ? M|ekvk = 4 & F|equals(H|vorganga, "(CancelationCreditNoteCommercial)")
.continue INTERN   ? M|ekvk = 4 & F|equals(H|vorganga, "(CanceledCreditNoteCommercial)")
.continue INTERN   ? M|ekvk = 4 & F|equals(H|vorganga, "(CreditNoteCommercial)")
.continue INTERN   ? M|ekvk = 4 & F|equals(H|vorganga, "(Invoice)")
.continue INTERN   ? M|ekvk = 4 & (F|equals(H|vorganga, "(InvoiceReversal)") ; F|equals(H|vorganga, "(InvoiceCanceled)"))
.continue INTERN   ? M|ekvk = 4 & F|equals(H|vorganga, "(Downpayment)")
.continue INTERN   ? M|ekvk = 4 & (F|equals(H|vorganga, "(CashPayment)") ; F|equals(H|vorganga, "(CashPaymentReversal)"))
.continue INTERN   ? M|ekvk = 4 & F|equals(H|vorganga, "(CashPaymentCanceled)")
.continue INTERN   ? M|ekvk = 4 & H|typ = G|liko & (H|buart = 0 ; H|buart = 2)
.continue INTERN   ? M|ekvk = 4 & (F|equals(H|vorganga, "(CanceledDownpayment)") ; F|equals(H|vorganga, "(CancelationDownpayment)"))  
..
!ANSCHR1: Linkes Adressfeld aus Vorgang
.formula M|ans      = H|ans
.formula M|str      = H|str
.formula M|plz      = H|plz
.formula M|nort     = H|nort
.formula M|lakenn   = H|lakenn
.copy M|staat = H|staat
.formula M|sprname  = H|staat^sprname
.copy M|region = H|region
.continue FELDER  ? M|ekvk = 4 & (F|equals(H|lsart, "(CancelationReturnPackingSlip)") ; F|equals(H|lsart, "(CanceledReturnPackingSlip)") ; F|equals(H|lsart, "(ReturnPackingSlip)"))
.continue ANSCHR2 ? M|ekvk = 4
.formula M|uid = ""
.formula M|uid = H|kl2^uid   ?  H|typ = G|reko 
.formula M|uid = H|kunde^uid ? _H|typ = G|reko & M|pro
.continue ANSCHR2
..
!INTERN
.formula M|ans      = ""
.formula M|str      = "INTERN"
.formula M|plz      = ""
.formula M|nort     = ""
.formula M|lakenn   = ""
.copy M|staat  = H|staat
.formula M|sprname  = H|staat^sprname
.formula M|region   = ""
..
!RECHTSINTERN
.formula M|ans2      = H|ans
.formula M|str2      = H|str
.formula M|plz2      = H|plz
.formula M|nort2     = H|nort
.formula M|lakenn2   = H|lakenn
.copy M|staat2  = H|staat
.formula M|sprname2  = H|staat^sprname
.copy M|region2 = H|region
.continue RETURN  ?  F|empty(H|vorganga) & M|ekvk = 4 & (F|equals(H|lsart, "(CancelationReturnPackingSlip)") ; F|equals(H|lsart, "(CanceledReturnPackingSlip)") ; F|equals(H|lsart, "(ReturnPackingSlip)"))
.continue FELDER  ?  M|ekvk = 4 & F|equals(H|vorganga, "(Invoice)")
.continue FELDER  ?  M|ekvk = 4 & F|equals(H|vorganga, "(CanceledCreditNoteCommercial)")
.continue FELDER  ?  M|ekvk = 4 & F|equals(H|vorganga, "(CreditNoteCommercial)")
.continue FELDER  ?  M|ekvk = 4 & F|equals(H|vorganga, "(CancelationCreditNoteCommercial)")
.continue FELDER  ?  M|ekvk = 4 & (F|equals(H|vorganga, "(InvoiceReversal)") ; F|equals(H|vorganga, "(InvoiceCanceled)"))
.continue FELDER  ?  M|ekvk = 4 & F|equals(H|vorganga, "(Downpayment)")
.continue FELDER  ?  M|ekvk = 4 & (F|equals(H|vorganga, "(CashPayment)") ; F|equals(H|vorganga, "(CashPaymentReversal)"))
.continue FELDER  ?  M|ekvk = 4 &  F|equals(H|vorganga, "(CashPaymentCanceled)")
.continue FELDER  ?  M|ekvk = 4 & (F|equals(H|vorganga, "(CanceledDownpayment)") ; F|equals(H|vorganga, "(CancelationDownpayment)"))  
.continue ANSCHR2 ? _F|empty(F|regreplaceall(H|ans2, ";", ""))
.continue FELDER
..
!ANSCHR2: Rechtes Adressfeld aus Vorgang
.formula M|ans2      = H|ans2
.formula M|str2      = H|str2
.formula M|plz2      = H|plz2
.formula M|nort2     = H|nort2
.formula M|lakenn2   = H|lakenn2
.copy M|staat2  = H|staat2
.formula M|sprname2  = H|staat2^sprname
.copy M|region2 = H|region2
.continue FELDER ? M|ekvk = 4
.formula M|uid2 = ""
.formula M|uid2 = H|warenempf^uid ? H|typ = G|reko ; M|pro
.continue FELDER
..
!LSANSCHR: Beim LS wird standardmaessig nur ein Adressfeld gedruckt
.continue ANS2LEER ? F|empty(F|regreplaceall(H|ans2, ";", "")) & F|empty(F|regreplaceall(H|str2, ";", "")) & F|empty(F|regreplaceall(H|nort2, ";", ""))
!RETURN
.formula M|ans      = H|ans2
.formula M|str      = H|str2
.formula M|plz      = H|plz2
.formula M|nort     = H|nort2
.formula M|lakenn   = H|lakenn2
.copy M|staat  = H|staat2
.formula M|sprname  = H|staat2^sprname
.copy M|region = H|region2
.continue FELDER ? M|ekvk = 4 & H|typ = G|liko & (F|equals(H|lsart, "(CancelationReturnPackingSlip)") ; F|equals(H|lsart, "(CanceledReturnPackingSlip)") ; F|equals(H|lsart, "(ReturnPackingSlip)"))
.continue LEER   ? M|ekvk = 4 
.formula M|uid = ""
.formula M|uid = H|warenempf^uid ? M|pro
.continue LEER   
..
!ANS2LEER: keine Versandadresse gef¬Ållt, Kundenadresse wird verwendet.
.formula M|ans      = H|ans
.formula M|str      = H|str
.formula M|plz      = H|plz
.formula M|nort     = H|nort
.formula M|lakenn   = H|lakenn
.copy M|staat  = H|staat
.formula M|sprname  = H|staat^sprname
.copy M|staat2 = H|staat
.formula M|sprname2 = H|staat^sprname
.copy M|region = H|region
.continue FELDER ? M|ekvk = 4
.formula M|uid = ""
.formula M|uid = H|kunde^uid  ? H|typ = G|reko ; M|pro
.continue FELDER
..
!LEER: LS wird eigentlich nur mit einem Adressfeld gef¬Ållt, die Daten werden
.. aber dennoch zur Verf¬Ågung gestellt
.formula M|ans2      = H|ans
.formula M|str2      = H|str
.formula M|plz2      = H|plz
.formula M|nort2     = H|nort
.formula M|lakenn2   = H|lakenn
.copy M|staat2  = H|staat
.formula M|sprname2  = H|staat^sprname
.copy M|region2 = H|region
.continue FELDER
..
!HALBFABR: Halbfabrikate: linke Adresse Spediteur, rechte Adresse Konsi-Lager
.formula M|ans     = H|ans
.formula M|str     = H|str
.formula M|plz     = H|plz
.formula M|nort    = H|nort
.formula M|lakenn  = H|lakenn
.copy M|staat      = H|staat
.formula M|sprname = H|staat^sprname
.copy M|region     = H|region
..
.. in die erste Zeile des Vorganges, um das Konsilager zu kennen.
.select line
.formula M|ans2      = H|lgruppe^ans
.formula M|str2      = H|lgruppe^str
.formula M|plz2      = H|lgruppe^plz
.formula M|nort2     = H|lgruppe^nort
.formula M|lakenn2   = H|lgruppe^lakenn
.copy M|staat2  = H|lgruppe^staat
.formula M|sprname2  = H|lgruppe^staat^sprname
.copy M|region2 = H|lgruppe^region
.select header
..
!FELDER
.assign U|origftext = "H|baftextbenart"
.assign U|copyftext = "M|baftextbenart"
.input "is/COPY.FREETEXT"
.assign U|origftext = "H|bsftextbenart"
.assign U|copyftext = "M|bsftextbenart"
.input "is/COPY.FREETEXT"
.continue BSTEXT      ?  F|empty(H|batext)
..
!BATEXT
.continue ERROR4      ? _F|isfopname(H|batext)
.assign U|xbatext = F|foppath(H|batext)
.continue ERROR2      ?  F|empty(U|xbatext)
.formula M|batext    = 'U|xbatext'
..
!BSTEXT
.continue TEXT        ?  F|empty(H|bstext)
.continue ERROR5      ? _F|isfopname(H|bstext)
.assign U|xbstext = F|foppath(H|bstext)
.continue ERROR3      ?  F|empty(U|xbstext)
.formula M|bstext    = 'U|xbstext'
..
!TEXT
.copy M|vstaat     = H|vstaat
.formula M|kustid  = H|ustid
.formula M|vdat    = H|vdat
.formula M|tterm   = H|tterm
.formula M|mterm   = H|mterm
.formula M|betreff = H|betreff
.formula M|aztext  = H|atext
.formula M|stext   = H|stext
.formula M|ablade  = H|ablstelle
.formula M|ablstelle = H|ablinfotxt ? M|ekvk = 3
.formula M|werk    = H|werk
.copy M|zaform     = H|zaform
.continue NOSEPAM                   ? F|empty(H|sepamand)
.assign M|sepamand   = H|sepamand
.copy M|sepamaktiv = H|sepamand^sepamaktiv
.copy M|sepamverw  = H|sepamand^sepamverw
..
!NOSEPAM
.formula U|xvkliko        = M|ekvk = 3 & M|vorgang^typ = 4
.formula M|ftext          = 'H|ftext'
.formula M|barcode        = H|doku^barcode ? F|empty(M|barcode) & _U|xvkliko
.formula M|barcode        = H|rueckdoku^barcode ? F|empty(M|barcode) & U|xvkliko
.formula M|barcodedrucken = G|TRUE ? U|xvkliko
.continue BETREUER ? M|ekvk = 4
..
.. Vertreter und Betreuerdaten holen
.assign M|vertr   = H|vertret
..
!BETREUER
.continue KBETREUER ? F|empty(H|betreuer)
.load 3 add H|betreuer
.continue KBETREUER ? _G|mehr
.formula M|betr    = 3|name
.formula M|betel   = 3|tele
.formula M|befax   = 3|fax
.formula M|beemail = 3|email
..
!KBETREUER
.assign M|land   = H|land
..
.input "ev/EVVORGANG.TAB"
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERR: Document not found.
.error -field M|vorgang -message Keinen Vorgang gefunden.
.end 1
..
!ERROR1: Please select document.
.error -field M|vorgang -message Bitte Vorgang wÑhlen.
.end 1
..
!ERROR2: Missing text.
.error -message Der verwendete Textbaustein 'H|batext' existiert nicht (mehr).
.end 1
..
!ERROR3: Missing text.
.error -message Der verwendete Textbaustein 'H|bstext' existiert nicht (mehr).
.end 1
..
!ERROR4: Illegal name in text.
.error -message UngÅltiger FO-Dateiname im Textbaustein 'H|batext'.
.end 1
..
!ERROR5: Illegal name in text.
.error UngÅltiger FO-Dateiname im Textbaustein 'H|bstext'.
.end 1
