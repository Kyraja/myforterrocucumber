..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : POSTINVOICE.TAB
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
..
.make screen line +O
.colour -background -1 -1 -1 sumnettoinl 'M|aktzeile'
.colour -background -1 -1 -1 steuerinl 'M|aktzeile'
.colour -background -1 -1 -1 strgl 'M|aktzeile'
.colour -background -1 -1 -1 konto 'M|aktzeile'
.colour -background -1 -1 -1 proz 'M|aktzeile'
.colour -background -1 -1 -1 kstelle 'M|aktzeile'
.colour -background -1 -1 -1 steuerschl 'M|aktzeile'
.colour -background -1 -1 -1 ustva 'M|aktzeile'
.copy M|tmark = G|FALSE
.copy M|tkunde = H|kunde     ? M|bverkauf
.copy M|tlief = H|lief       ? M|beinkauf
.assign M|tvkvorg = H|id     ? M|bverkauf
.assign M|tekvorg = H|id     ? M|beinkauf
.formula M|doku = H|doku     
.formula M|ebeleg = H|ebeleg ? M|beinkauf
.copy M|vorganga = H|vorganga 
.formula M|vom = H|vom 
.formula M|budat = H|budat 
.formula M|uebertr = H|uebertr
.assign M|zbed = H|zbed
.copy M|waehr = H|waehr     ? M|bverkauf
.copy M|waehr = H|erfwaehr  ? M|beinkauf
.copy M|inlwaehr = H|iwbu
.copy M|skfaehig = G|TRUE   ? H|skbbetr <> 0
.protection hinweis 'M|aktzeile'
.formula M|rebueinzel = M|iconbuchen 
.copy M|vstrgl = H|vrgstrgl
.formula M|tdetail = M|icondetail
.formula M|netto = H|sumnetto
.formula M|pwert = H|sumbrutto
.formula M|steuer = H|sumbrutto - H|sumnetto
.formula M|sumnettoinl = H|sumnettoinl
.formula M|sumbruttoinl = H|sumbruttoinl
.formula M|steuerinl = H|sumbruttoinl - H|sumnettoinl
.copy M|fixiert = H|kursfix
.formula M|ewekurs = H|ewkurs
..
..*****************************************************************************
!END
.continue
