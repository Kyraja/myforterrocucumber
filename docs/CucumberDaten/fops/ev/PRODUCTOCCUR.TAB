..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRODUCTOCCUR.TAB
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
.type realx  xramount    ? _F|defined(U|xramount)
.type realx  xiwbuamount ? _F|defined(U|xiwbuamount)
..
.continue END    ?  _M|mitaltpos & 9|alternativpos
.formula U|xramount  = 0
..
.make screen line +o
.assign M|vkbelegnr = 9|kopf           ? M|bverkauf
.assign M|ekbelegnr = 9|kopf           ? M|beinkauf
.formula M|ttyp     = 9|kotypa
.assign M|vkpos     = 9|id             ? M|bverkauf
.assign M|ekpos     = 9|id             ? M|beinkauf
.assign M|tkunde    = 9|kunde          ? M|bverkauf 
.assign M|tkunde    = 9|kopf^warenempf ? M|bverkauf & 9|kopf^typ = 4
.assign M|tlief     = 9|lief           ? M|beinkauf
.formula M|vom      = 9|kopf^vom
.assign M|tartikel  = 9|artikel
.assign M|tbasisartikel = 9|artikel^basisartikel  ? M|bverkauf
.assign M|tekbasisartikel = 9|artikel^basisartikel ? M|beinkauf
.copy M|altpos      = 9|alternativpos
.formula M|mge      = 9|mge
.copy M|tle         = 9|he
.assign M|tbetreuer = 9|kopf^betreuer
.assign M|tvertret  = 9|kopf^vertret   ? M|bverkauf
.assign M|vorganga  = 9|treart         ? 9|kopf^typ = 5
.assign M|lsart     = 9|tlsart         ? 9|kopf^typ = 4
.formula M|ttyp     = M|vorganga       ? 9|kopf^typ = 5
.formula M|ttyp     = M|lsart          ? 9|kopf^typ = 4
.assign M|tvkzrahmen = 9|zrahmen       ? M|bverkauf
.assign M|vkzrahmenpos = 9|zrahmenpos  ? M|bverkauf
.assign M|tekzrahmen = 9|zrahmen       ? M|beinkauf
.assign M|ekzrahmenpos = 9|zrahmenpos  ? M|beinkauf
.. Erfassungsw„hrung
.formula M|netto    = 9|preis 
.assign M|pwaehr    = 9|pland
.. umgerechnet in Inlandsw„hrung
.formula U|xramount  = 9|npwert
.formula U|xiwbuamount = U|xramount
.formula U|xiwbuamount = U|xramount / 9|kopf^kurs ? 9|kopf^kurs <> 0
.formula U|xramount    = U|xramount               ? G|inland = 9|pland 
.formula U|xramount    = U|xiwbuamount            ? G|inland <> 9|pland
.. nwert: Positionswert incl. Umlagen in Erfassungsw„hrung
.. npwert: Netto-Positionswert in Erfassungsw„hrung
.formula M|gesnetto       = U|xramount 
.assign M|twaehr    = G|inland
.formula M|proz     = 9|proz
.copy M|artle       = 9|artikel^le
.formula M|mgele    = M|mge              ? M|tle = M|artle  
.formula M|mgele    = 9|lehe * M|mge     ? M|tle <> M|artle 
..
!SUMME
.formula M|nettosum = M|nettosum + M|gesnetto              ? _9|alternativpos
.formula M|altposnettosum = M|altposnettosum + M|gesnetto  ?  9|alternativpos
.formula M|gesmge = M|mgele + M|gesmge              ? _F|empty(M|artikel) & _9|alternativpos
.formula M|altposgesmge = M|mgele + M|altposgesmge  ? _F|empty(M|artikel) &  9|alternativpos
..
..*****************************************************************************
!END
.continue
