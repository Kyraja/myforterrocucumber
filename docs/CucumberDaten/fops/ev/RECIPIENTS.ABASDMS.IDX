..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : RECIPIENTS.ABASDMS.IDX
.. Author         : saac
.. Verantwortlich : teamreport
.. Kontrolle      :
.. Functionality  : Does global index file output for invoice recipient
..                  and goods recipient
..*****************************************************************************
.set trans -
..
.type VP5   xinvoicer          ? _F|defined(U|xinvoicer)
.type VP5   xgoodsr            ? _F|defined(U|xgoodsr)
..
.continue GOODREC ? F|empty(U|xinvoicer)
.continue GOODREC ? U|xinvoicer^dnr <> 0 & U|xinvoicer^dnr <> 1
.continue GOODREC ? U|xinvoicer^gruppe <> 1 & U|xinvoicer^gruppe <> 6
..
RKuLiNam='U|xinvoicer^ans'
RKuLiPLZ='U|xinvoicer^plz'
RKuLiOrt='U|xinvoicer^nort'
AbasRKID='U|xinvoicer^id'
RKuLiNr='U|xinvoicer^nummer'
RKuLiSuc='U|xinvoicer^such'
.continue GOODREC
..
!GOODREC: Goods recipient
.continue END ? F|empty(U|xgoodsr)
.continue END ? U|xgoodsr^dnr <> 0 & U|xgoodsr^dnr <> 1
.continue END ? U|xgoodsr^gruppe <> 1 & U|xgoodsr^gruppe <> 2 & U|xgoodsr^gruppe <> 6 & U|xgoodsr^gruppe <> 7
..
.continue CONTACT ? U|xgoodsr^gruppe = 2 ; U|xgoodsr^gruppe = 7
AbasWKID='U|xgoodsr^id'
WKuLiNr='U|xgoodsr^nummer'
WKuLiSuc='U|xgoodsr^such'
WKuLiNam='U|xgoodsr^ans'
WKuLiPLZ='U|xgoodsr^plz'
WKuLiOrt='U|xgoodsr^nort'
.continue END
..
!CONTACT: Contact of goods recipient
AbasWKID='U|xgoodsr^firma^id'
WKuLiNr='U|xgoodsr^firma^nummer'
WKuLiSuc='U|xgoodsr^firma^such'
WKuLiNam='U|xgoodsr^firma^ans'
WKuLiPLZ='U|xgoodsr^firma^plz'
WKuLiOrt='U|xgoodsr^firma^nort'
..
WabasTID='U|xgoodsr^id'
WktktNr='U|xgoodsr^nummer'
WktktNam='U|xgoodsr^ans'
WktktSuc='U|xgoodsr^such'
..*****************************************************************************
!END
.continue
