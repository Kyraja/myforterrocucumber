..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.REAUSRE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : teaminfosysteme
.. Functionality  : EK-Rechnung aus Rechnungspositionen 
..*****************************************************************************
.set trans -
.type text    xtcmd     ? _F|defined(U|xtcmd)
..
.select screen header
.formula M|IssueDateTime = "." ? F|empty(M|IssueDateTime)
..
.continue REAUSLS ? M|bausls
!MENGE:Rechnung aus Bestellung
#!database=(Purchasing)
#!action=invoice
#!flddelimiter=;
#!charset=eks
#!dontchange=~
?num4;ebeleg;vom;tterm;ident;**ftextbenart;leidat;bem\  ?  M|bewlei & F|empty(M|zbed)
?num4;ebeleg;vom;tterm;ident;**ftextbenart;bem\         ? _M|bewlei & F|empty(M|zbed)
?num4;ebeleg;vom;zbed;ident;**ftextbenart;leidat;bem\  ?  M|bewlei & _F|empty(M|zbed)
?num4;ebeleg;vom;zbed;ident;**ftextbenart;bem\         ? _M|bewlei & _F|empty(M|zbed)
zn;artikel;he;mge;offueb;ljtext1;mge;pwert;preis;proz
?'M|bestellung^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|tterm';'M|edifact^nummer';'M|notizen';'M|DeliveryDateTime';'M|bem'\  ?  M|bewlei & F|empty(M|zbed)
?'M|bestellung^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|tterm';'M|edifact^nummer';'M|notizen';'M|bem'\                       ? _M|bewlei & F|empty(M|zbed)
?'M|bestellung^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|notizen';'M|DeliveryDateTime';'M|bem'\  ?  M|bewlei & _F|empty(M|zbed)
?'M|bestellung^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|notizen';'M|bem'\                       ? _M|bewlei & _F|empty(M|zbed)
..
.select screen header
!SELLINE
.select screen line
.continue SELHERADER ? _G|mehr
.continue SELLINE    ? M|bzusatz
.continue SELLINE    ? M|zeilentyp <> 0
.continue SELLINE    ? _F|protected(M|bzusatz, M|aktzeile)
$,,artikel='M|artikel^id';~;'M|einheit';~;ja;'M|ljtext1';'M|BilledQuantity';~;'M|nettopreis';'M|zuabschlag'\
.continue SELLINE
..
!SELHERADER
.select screen header
..
!SELZUPOS
.select screen line
.continue OUTPUT ? _G|mehr
.continue SELZUPOS ? _M|bzusatz
?+;'M|artikel^id';'M|ljtext1';'M|billedQuantity';~;~;~;'M|LineTotalAmount';~;~\  ? M|zeilentyp = 0
?+;'M|artikel^id';'M|ljtext1';1;~;~;~;'M|ChargeActualAmount';~;~\                ? M|zeilentyp = 2 
.continue SELZUPOS
..
!REAUSLS: Rechnung aus Lieferschein
#!database=(Purchasing)
#!action=invoice
#!flddelimiter=;
#!charset=eks
#!dontchange=~
?num4;ebeleg;vom;tterm;ident;**ftextbenart;leidat;bem\  ?  M|bewlei &  F|empty(M|zbed)
?num4;ebeleg;vom;tterm;ident;**ftextbenart;bem\         ? _M|bewlei &  F|empty(M|zbed)
?num4;ebeleg;vom;zbed;ident;**ftextbenart;leidat;bem\   ?  M|bewlei & _F|empty(M|zbed)
?num4;ebeleg;vom;zbed;ident;**ftextbenart;bem\          ? _M|bewlei & _F|empty(M|zbed)
zn;artikel;he;ljtext1;mge;pwert;preis;proz
?'M|vorgang^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|tterm';'M|edifact^nummer';'M|notizen';'M|DeliveryDateTime';'M|bem'\  ?  M|bewlei & F|empty(M|zbed)
?'M|vorgang^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|tterm';'M|edifact^nummer';'M|notizen';'M|bem'\                       ? _M|bewlei & F|empty(M|zbed)
?'M|vorgang^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|notizen';'M|DeliveryDateTime';'M|bem'\  ?  M|bewlei & _F|empty(M|zbed)
?'M|vorgang^id';'M|ExchangedDocumentID';'M|IssueDateTime';'M|zbed';'M|edifact^nummer';'M|notizen';'M|bem'\                       ? _M|bewlei & _F|empty(M|zbed)
..
.select screen header
!LSELLINE
.select screen line
.continue LSELHERADER ? _G|mehr
.continue LSELLINE    ? M|bzusatz
.continue LSELLINE    ? M|zeilentyp <> 0
.continue LSELLINE    ? _F|protected(M|bzusatz, M|aktzeile)
$,,artikel='M|artikel^id';~;'M|einheit';'M|ljtext1';'M|BilledQuantity';~;'M|nettopreis';'M|zuabschlag'\
.continue LSELLINE
..
!LSELHERADER
.select screen header
..
!LSELZUPOS
.select screen line
.continue OUTPUT ? _G|mehr
.continue LSELZUPOS ? _M|bzusatz
?+;'M|artikel^id';~;'M|ljtext1';'M|billedQuantity';'M|LineTotalAmount';~;~\      ? M|zeilentyp = 0
?+;'M|artikel^id';~;'M|ljtext1';~;'M|ChargeActualAmount';~;~\                    ? M|zeilentyp = 2
.continue LSELZUPOS
..
!OUTPUT
.output
.system 'F|formatstr("edpimport.sh -p {1} -I {2} >{3} 2>{4}", G|einmalpw, U|xtmpfile, U|xtout, U|xterr)' background
.continue ERROR ? _G|mehr
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR
.formula U|xtcmd = "sed " + 'G|apostroph' + "s/^.*): //" + 'G|apostroph' + " " +'U|xterr' +" >" + 'U|xterr2'
.system 'U|xtcmd' background
.input 'U|xterr2'
.error -message Rechnung erstellen gescheitert!
.end 1

