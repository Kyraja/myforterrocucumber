..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.INVOICEEK.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : LIEFEK = Lieferschein Einkauf
..
..*****************************************************************************
.set trans -
.type text   xtext           ? _F|defined(U|xtext)
..
.formula M|button1 = M|gruenz
..<META M|='ev/ELINVOICEPROCESS'>
..
.. TODO: Suchfelder entscheiden
..
.. hier nur suczhen, wenn keine Bestellung gefunden wurde
.continue END ? _F|empty(M|bestellung)
.continue END ? _F|empty(M|liefek)
..
.. Aufruf: ev/ELINVOICEPROCESS.OBJSUCHE.INVOICE.PROCESS.FO
.type text searchfop ? _F|defined(U|searchfop)
.formula U|searchfop = "ev/ELINVOICEPROCESS.OBJSUCHE.INVOICE.PROCESS.FO"
..
.. Parameter-Felder 
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.. bereits ermittelte BusinessPartner
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
..
.. Ergebnis-Felder
.type VP23 xgefundenVP24 ? _F|defined(U|xgefundenVP24)
.type text xtsuchfehler ? _F|defined(U|xtsuchfehler)
..
.. PARAMETER FšR SUCH-AUFRUF **************************************************
.formula U|xsuchnummer = M|ExchangedDocumentID
.formula U|xsuchnummer = M|BuyerOrderReferencedDocument ? F|empty(U|xsuchnummer)
.formula U|xsuchlieferant = M|lieferant^id 
.formula U|xsuchresteller = ""
..
.input 'U|searchfop'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue ERROR ? F|empty(U|xgefundenVP24)
..*****************************************************************************
!END
.continue
..
!ERROR
.formula U|xtext = F|formatstr("Zu {1} konnte keine Rechnung mit dieser Rechnungsnummer ermittelt werden.", 'M|ExchangedDocumentID')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.formula M|button1 = M|orangez
.continue
