..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : PRINTQUEUE.SPERR
.. Autor          : saac
.. Verantwortlich : cl
.. Kontrolle      : teamreport
.. Funktion       : 
..
.. Functionality  : 
..*****************************************************************************
.set trans -
..
.assign M|statusz = ""
.continue END ? P|vorschau
..
.select modificationlock waitshort object 'M|transaction^id'
.continue ERROR   ? _G|mehr
.continue NOSPERR ? _G|gesperrt
.continue BREAK   ? M|printable & _H|druck ; H|druck & _M|printable
.continue END
..
!ERROR: Document missing
.error Kein Vorgang vorhanden!
.copy M|statusz = M|rotz
.end 1
..
!NOSPERR: Lock failed
.error Vorgang konnte nicht gesperrt werden!
.copy M|statusz = M|gelbz
.end 1
..
!BREAK: Meanwhile document has changed print flag -> ignore it
.error Vorgang wurde bereits gedruckt!
.copy M|statusz = M|blauz
.assign M|printable = H|druck
.end 1
..*****************************************************************************
!END
.select -
.continue
