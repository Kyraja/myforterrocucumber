..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : OBLEVKRAHMEN.ME
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Initialisiert den Maskenpuffer.
.. Ablauf         : Maskeneintritts-EFOP
..
.. Functionality  : Initializes the mask buffer.
.. Program flow   : Mask entry efop
..
.. include ev/OBLEVKRAHMEN.INI
..*****************************************************************************
.set trans -
..
.copy M|zgruen = G|TRUE
.copy M|zgelb = G|TRUE
.copy M|zrot = G|TRUE
..
.copy M|zgltgruen = G|TRUE
.copy M|zgltgelb = G|TRUE
.copy M|zgltrot = G|TRUE
.copy M|zgueltig = G|TRUE
..
.. Set Icons
.formula M|rotz   = G|icoerror
.formula M|gelbz  = G|icowarn
.formula M|gruenz = G|icook
.formula M|ungueltig = "icon:stop"
..
.. ohne Verzeichnis, damit ein individuelles gleichnamiges FOP gezogen werden kann
.input "OBLEVKRAHMEN.INI"
.continue VK ? M|datnr = 3
.continue EK ? M|datnr = 4
.continue FARBEN
..
!VK
.formula M|posgruenvk = 1  ? M|posgruenvk >= M|posrotvk
.formula M|posgruenvk = 1  ? M|posgruenvk >= 100 ; M|posgruenvk <= 0
.formula M|posrotvk   = 99 ? M|posrotvk >= 100 ; M|posrotvk<= 0
.formula M|posgelbv = M|posgruenvk + 1
.formula M|posgelbb = M|posrotvk -1
.formula M|gltgruenvk = 30 ? M|gltgruenvk <= M|gltrotvk ; M|gltgruenvk <= 0
.formula M|posrotvk   = 5  ? M|gltrotvk <= 0
.formula M|gltgelbv = M|gltgruenvk - 1
.formula M|gltgelbb = M|gltrotvk + 1
.continue FARBEN
..
!EK
.formula M|posgruenek = 1  ? M|posgruenek >= M|posrotek
.formula M|posgruenek = 1  ? M|posgruenek >= 100 ; M|posgruenek <=0
.formula M|posrotek   = 99 ? M|posrotek >= 100 ; M|posrotek <= 0
.formula M|posgelbv = M|posgruenek + 1
.formula M|posgelbb = M|posrotek -1
.formula M|gltgruenek = 30 ? M|gltgruenek <= M|gltrotek ; M|gltgruenek <= 0
.formula M|posrotek   = 5  ? M|gltrotek <= 0
.formula M|gltgelbv = M|gltgruenek - 1
.formula M|gltgelbb = M|gltrotek + 1
..
!FARBEN 
.input "is/ABASFARBEN.DEF"
.formula M|coloryellow = U|xabaslightyellow
..
.formula P|maskkontextfop = ""
.formula M|aarts  = "(Active)"
..
.copy M|auswaehr  = G|inland
.copy M|ausnkst = M|auswaehr^nkst
..
.formula M|kotyps = "(BlanketOrder)"
.continue END
..
!AUFBEST
.formula M|kotyps = "(SalesOrder)"    ? M|datnr = 3
.formula M|kotyps = "(PurchaseOrder)" ? M|datnr = 4
..*****************************************************************************
!END
.continue
