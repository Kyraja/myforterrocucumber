..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.LIEFVK.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : LIEFVK = Lieferschein Verkauf
..*****************************************************************************
.set trans -
.type text   xtext           ? _F|defined(U|xtext)
..
..<META M|='ev/ELINVOICEPROCESS'>
..
.. TODO: Suchfelder entscheiden
..
.continue END
..
.. Aufruf: ev/ELINVOICEPROCESS.OBJSUCHE.DELIVERY.PROCESS.FO
.type text searchfop ? _F|defined(U|searchfop)
.formula U|searchfop = "ev/ELINVOICEPROCESS.OBJSUCHE.DELIVERY.PROCESS.FO"
..
.. Parameter-Felder 
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.. bereits ermittelte BusinessPartner
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
..
.. Ergebnis-Felder
.type VP23 xgefundenVP23 ? _F|defined(U|xgefundenVP23)
.type text xtsuchfehler ? _F|defined(U|xtsuchfehler)
..
.. PARAMETER FšR SUCH-AUFRUF **************************************************
.formula U|xsuchnummer = M|FELD1
.formula U|xsuchfrzeich = M|FELD2
.formula U|xsuchlieferant = M|lieferant^id  
.formula U|xsuchresteller = ""
..
.input 'U|searchfop'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue ERROR ? F|empty(U|xgefundenVP23)
.assign M|liefvk = U|xgefundenVP23
..
.. Rechnung aus Bestellung oder Lieferschein?
.copy M|lsfakt = M|liefek^fakt ? _F|empty(M|liefvk)
..
..*****************************************************************************
!END
.continue
..
!ERROR
.formula U|xtext = F|formatstr("Zu {1} konnte kein Lieferschein mit dieser Lieferscheinnummer ermittelt werden.", 'M|KEINSUCHFELD')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue
