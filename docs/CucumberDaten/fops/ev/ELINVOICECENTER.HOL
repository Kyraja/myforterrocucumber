..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICECENTER.HOL
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : add quary parameters from header fields in the infosystem
..*****************************************************************************
.set trans -
..
..<META M|='ev/ELINVOICECENTER'>
..
.. Switch Id numbers von!bis
.type text  xtnum
..
.. start with empty table
.make screen line -- ? M|tzeilen > 0
..
.. check date range
.continue ERRDATE     ?  _F|empty(M|datumv) & _F|empty(M|datumb) & ( M|datumb < M|datumv )
..
.. build selection
.. note: the "customer" for the CENTER is the entity that sent the e-invoice 
..   in the edi database this is the "(ed)partner" 
.formula M|select = "$,,;@gruppe=0;erfass=" + 'M|datumv' + "!" + 'M|datumb'
.formula M|select = M|select + ";edinachraz=(ZUGFeRDInvoice);ediimex==IM"
.formula M|select = M|select + ";edistatusaz=" + 'M|edistatusaz' ? _F|empty(M|edistatusaz)
.formula M|select = M|select + ";partner="  + 'M|kkunde^id'  ? _F|empty(M|kkunde)  & 'M|kkunde^dnr'="0"
.formula M|select = M|select + ";partner="  + 'M|kkunde^id'  ? _F|empty(M|kkunde)  & 'M|kkunde^dnr'="1"
.formula M|select = M|select + ";status="   +  M|astatus     ? _F|empty(M|astatus)
..
.. Add num-range to Query
.continue ERRNUM  ? _F|empty(M|kedinumvon) & _F|isvalue('M|kedinumvon', "N53")
.continue ERRNUM  ? _F|empty(M|kedinumbis) & _F|isvalue('M|kedinumbis', "N53")
.continue NUMSEL  ?  F|empty(M|kedinumvon) ; F|empty(M|kedinumbis)
.continue NUMSEL  ? +M|kedinumvon<+M|kedinumbis
.continue NUMSEL  ?  M|kedinumvon<=M|kedinumbis & +M|kedinumvon=+M|kedinumbis
.formula U|xtnum = M|kedinumvon
.formula M|kedinumvon = M|kedinumbis
.formula M|kedinumbis = U|xtnum
..
!NUMSEL
.formula M|select = M|select + ";nummer=" + M|kedinumvon + "!" + M|kedinumbis  ? _F|empty(M|kedinumvon) ; _F|empty(M|kedinumbis)
..
..*****************************************************************************
.continue
..
!ERRDATE: date range has error
.error Bitte geben Sie einen gltigen Zeitraum ein.
.cursor datumv 0
.end 1
..
!ERRNUM
.error Geben Sie eine gltige Identnummer an.
.cursor kedinumvon 0
.end 1


