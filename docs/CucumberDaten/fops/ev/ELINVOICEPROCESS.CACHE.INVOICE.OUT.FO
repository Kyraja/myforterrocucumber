..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.CACHE.INVOICE.OUT.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. search fields must defined
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
.type VP23 xgefundenVP24 ? _F|defined(U|xgefundenVP24)
..
..*****************************************************************************
..
.type bool xvp24empty ?_F|defined(U|xvp24empty)
.copy U|xvp24empty = G|false
..
.. create variablen name from parameters
.. remove all non-valid symbols (should be none, but better not risk FO complications)
.type text xvp24name ? _F|defined(U|xvp24name)
.formula U|xvp24name = F|formatstr("X{1}X{2}X{3}", U|xsuchnummer, U|xsuchlieferant, U|xsuchresteller)
.formula U|xvp24name = F|regreplaceall(U|xvp24name, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^\ \-]", "")
..
.continue END ? _F|defined(U|.xvp24name)
..
.copy    U|xgefundenVP24 = U|.xvp24name 
.continue CACHE ? _F|empty(U|xgefundenVP24)
..
.. die Suche wurde bereits durchgefuehrt, und das Ergebnis war leer
.copy U|xvp24empty = G|true
.continue EMPTY
..
..*****************************************************************************
!END
.continue
..
!EMPTY
.. .println Der Wert fÅr Suche 'U|xvp24name' ist leer.
.continue
..
!CACHE
.. .println Der Wert fÅr Suche 'U|xvp24name' wurde als 'U|xgefundenVP24' aus dem Cache gelesen.
.continue 
