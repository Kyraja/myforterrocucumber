..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.CACHE.ORDER.OUT.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. search fields must defined
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
.type VP23 xgefundenVP22 ? _F|defined(U|xgefundenVP22)
..
..*****************************************************************************
..
.type bool xvp22empty ?_F|defined(U|xvp22empty)
.copy U|xvp22empty = G|false
..
.. create variablen name from parameters
.. remove all non-valid symbols (should be none, but better not risk FO complications)
.type text xvp22name ? _F|defined(U|xvp22name)
.formula U|xvp22name = F|formatstr("X{1}X{2}X{3}X{4}", U|xsuchnummer, U|xsuchfrzeich, U|xsuchlieferant, U|xsuchresteller)
.formula U|xvp22name = F|regreplaceall(U|xvp22name, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^\ \-]", "")
..
.continue END ? _F|defined(U|.xvp22name)
..
.copy U|xgefundenVP22 = U|.xvp22name 
.continue CACHE ? _F|empty(U|xgefundenVP22)
..
.. die Suche wurde bereits durchgefuehrt, und das Ergebnis war leer
.copy U|xvp22empty = G|true
.continue EMPTY
..
..*****************************************************************************
!END
.continue
..
!EMPTY
.. .println Der Wert fÅr Suche 'U|xvp22name' ist leer.
.continue
..
!CACHE
.. .println Der Wert fÅr Suche 'U|xvp22name' wurde als 'U|xgefundenVP22' aus dem Cache gelesen.
.continue 
