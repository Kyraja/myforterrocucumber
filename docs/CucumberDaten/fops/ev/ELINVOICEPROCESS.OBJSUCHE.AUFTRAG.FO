..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.AUFTRAG.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
.type text   xtext           ? _F|defined(U|xtext)
..
..<META M|='ev/ELINVOICEPROCESS'>
..
.continue END
..
.continue END ? F|empty(M|BuyerOrderReferencedDocument)
..
.. Aufruf: ev/ELINVOICEPROCESS.OBJSUCHE.ORDER.PROCESS.FO
.type text searchfop ? _F|defined(U|searchfop)
.formula U|searchfop = "ev/ELINVOICEPROCESS.OBJSUCHE.ORDER.PROCESS.FO"
..
.. Parameter-Felder 
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.. bereits ermittelte BusinessPartner
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
..
.. Ergebnis-Felder
.type VP23 xgefundenVP23 ? _F|defined(U|xgefundenVP23)
.type text xtsuchfehler ? _F|defined(U|xtsuchfehler)
..
.. PARAMETER FšR SUCH-AUFRUF **************************************************
.formula U|xsuchnummer = M|BuyerOrderReferencedDocument
.formula U|xsuchfrzeich = ""
.formula U|xsuchlieferant = M|lieferant^id  
.formula U|xsuchresteller = ""
..
.input 'U|searchfop'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue ERROR ? F|empty(U|xgefundenVP23)
.assign M|bestellung = U|xgefundenVP23
..
..*****************************************************************************
!END
.continue
..
!ERROR
.formula U|xtext = F|formatstr("Zu {1} konnte kein Auftrag ermittelt werden.",'M|BuyerOrderReferencedDocument')   ? _F|empty(M|BuyerOrderReferencedDocument)
.formula U|xtext = F|formatstr("Zu {1} konnte kein Auftrag ermittelt werden.", 'M|ExchangedDocumentID')           ? _F|empty(M|ExchangedDocumentID) 
.formula M|fctext = 'M|fctext' + ";" + 'U|xtext'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue
