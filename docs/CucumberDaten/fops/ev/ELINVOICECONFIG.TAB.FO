..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICECONFIG.TAB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  : Row fill efop
..*****************************************************************************
.set trans -
..
..<META M|='ev/ELINVOICECONFIG'>
..
.. Je nach Art das Feld unterscheiden
.continue VEN01 ? P|maskkontextfop = "Einkauf"
.continue CUS01 ? P|maskkontextfop = "Verkauf"
..
!VEN01
..<META H|='P1:0'>
..<META 9|='P1:4'>
.continue KEINZF ? F|empty(H|edinfosnr)
.load 9 supplier 'F|formatstr("$,,;@gruppe=4;@zeile=(1);klnum=={1};edinachr=={2}", H|id, M|kedinachrzugferd^id)'
.continue CVEND01
!CUS01
..<META H|='P0:0'>
..<META 9|='P0:4'>
.continue KEINZF ? F|empty(H|edinfosnr)
.load 9 customer 'F|formatstr("$,,;@gruppe=4;@zeile=(1);klnum=={1};edinachr=={2}", H|id, M|kedinachrzugferd^id)'
.continue CVEND01
!CVEND01
.continue KEINZF ? _G|mehr
.load 9 line '9|selzeile'
.continue KEINZF ? _G|mehr
.continue END ? M|kohnezugferdkonfig
.continue ZEIGEN
..
!KEINZF
.continue END ? M|kmitzugferdkonfig
..
!ZEIGEN
.make screen line +O
..
.. Je nach Art das Feld unterscheiden: tlief oder tkunde schreiben
.continue VEN02 ? P|maskkontextfop = "Einkauf"
.continue CUS02 ? P|maskkontextfop = "Verkauf"
!VEN02: ---Einkauf
.formula M|tlief = H|id
.protection M|tlief 'M|tzeilen'
.continue END ? _F|defined(9|id) 
.continue END ?  F|empty(9|id) 
..Tabelle schreiben
.formula M|tediinfolief = 9|id
.continue CVEND02
!CUS02: ---Verkauf
.formula M|tkunde = H|id
.protection M|tkunde 'M|tzeilen'
.continue END ? _F|defined(9|id) 
.continue END ?  F|empty(9|id) 
..Tabelle schreiben
.formula M|tediinfokunde = 9|id
.continue CVEND02
!CVEND02
..
..Bei beiden Arten
.formula M|tabm = 9|ieabmodell
.formula M|tabmverab = 9|abmodell
.formula M|tobjsuche = 9|suchkonfig
.formula M|taktiv = 9|erlaubt
..
..*****************************************************************************
!END
.load 9 ? F|defined(9|id)
.continue

