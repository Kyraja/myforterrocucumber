..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRODUCTOCCUR.SE
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. Initializations (only for Dashboard, please dont't change)
.copy M|sortsumdash = G|FALSE
.copy M|vorjahr = G|FALSE
..
.. Initializations 
.assign M|ablageart = "(Active)"
.copy M|bverkauf    = G|TRUE
.copy M|beinkauf    = G|FALSE
.formula M|adatum   = 'F|year(G|datum)' + "0101"
.formula M|edatum   = G|datum
.copy M|waehr       = G|inland
..
.. Visibility
.assign P|maskkontextfop = "Verkauf"         ? _F|sysinfo(18)^verskontr
.assign P|maskkontextfop = "Verkauf vkbasis" ?  F|sysinfo(18)^verskontr
..*****************************************************************************
!END
.continue
