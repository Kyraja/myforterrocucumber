..!interpreter english translate noabbrev
..*****************************************************************************
.. Name          : EVKETTE.TAB
.. Autor         : bs
.. Verantwortlich: cl
.. Kontrolle     : tiwe
.. Funktion      : Erzeugt eine Tabellenzeile in der Vorgangskette
.. Ablauf        : Unterprogramm von EVKETTE.BSTART.BN
..*****************************************************************************
.set trans -
.type bool     xiststorno  ? _F|defined(U|xiststorno)
..
.continue MACH ? M|tzeilen = 0 ; _F|empty(M|stufe)
.. Create empty row
.make screen line +O
.formula M|tstufe  = "----"
.formula M|vart    = "------------------------------"
.formula M|pnum    = "------"
.formula M|artname = ""
.assign M|land  = ""
..
!MACH: Create row
.copy U|xiststorno = G|FALSE
.copy U|xiststorno = G|TRUE ? F|equals(H|kotyp, "(PackingSlip)") & (F|equals(H|tlsart, "(CanceledCustomerDelivery)") ; F|equals(H|tlsart, "(CancelationCustomerDelivery)") ; F|equals(H|tlsart, "(CancelationReturnPackingSlip)") ; F|equals(H|tlsart, "(CanceledReturnPackingSlip)") ; F|equals(H|tlsart, "(PackingSlipCanceled)") ; F|equals(H|tlsart, "(PackingSlipReversal)"))
.copy U|xiststorno = G|TRUE ? F|equals(H|kotyp, "(Invoice)") & (F|equals(H|treart, "(CanceledDownpayment)") ; F|equals(H|treart, "(CancelationDownpayment)") ; F|equals(H|treart, "(CanceledCreditNoteCommercial)") ; F|equals(H|treart, "(CancelationCreditNoteCommercial)") ; F|equals(H|treart, "(CashPaymentReversal)") ; F|equals(H|treart, "(CashPaymentCanceled)") ; F|equals(H|treart, "(InvoiceCanceled)") ; F|equals(H|treart, "(InvoiceReversal)"))
.continue END ? U|xiststorno & M|bnostorno
..
.make screen line +O
.formula M|tstufe = 'M|stufe'
.. Vorgang/Vorgangsart/Position
.assign M|tvorgang = U|xtid
.assign M|tvorgang = M|tvorgang^kopf       ? M|tvorgang^gruppe = 2
.copy M|gebucht = G|FALSE
.copy M|gebucht = G|TRUE ? _M|tvorgang^uebertr & (F|equals(M|tvorgang^typ, "(PackingSlip)") ; F|equals(M|tvorgang^typ, "(Invoice)"))
.copy M|tpost = M|show   
.copy M|tpost = M|post             ?  H|kopf^uebertr
.copy M|tvom = M|tvorgang^vom
.copy M|tbudat = M|tvorgang^budat ? F|equals(H|kotyp, "(Invoice)")
.copy M|opstatusicon = M|tvorgang^opstatusicon
.formula M|tvorp = H|id
.formula M|vart = M|tvorgang^typa
.formula M|vart = M|tvorgang^vorganga  ?  _F|empty(M|tvorgang^vorganga) & F|equals(H|kategorie, "(Downpayment)")
.copy M|wahrsch = M|tvorgang^wahrsch
.formula M|tterm = M|tvorgang^tterm    ?  (F|equals(M|tvorgang^typ, "(Quotation)") ; F|equals(M|tvorgang^typ, "(Opportunity)"))
.copy M|tnoablage = M|tvorgang^noablage
.copy M|tausschr = M|tvorgang^ausschr
.assign M|stornopartnervorg = M|tvorgang^stornopartnervorg
.formula M|vart = M|tvorgang^lsart     ? F|equals(M|tvorgang^typ, "(PackingSlip)")
.formula M|vart = M|tvorgang^vorganga  ? F|equals(M|tvorgang^typ, "(Invoice)")
.. Artikeldaten ueber Verweis
.assign M|artikel = H|art^id
.continue ERROR01 ? _G|mehr
..
.. Positionsnummer, Preisdaten und alle Mengen
.formula M|pnum  = H|pnum
.formula M|ebeleg = H|kopf^ebeleg ? H|dnr = 4 & (F|equals(H|kotyp, "(PackingSlip)") ; F|equals(H|kotyp, "(Invoice)"))
.copy M|alternativpos = H|alternativpos
.formula M|mge   = H|mge
.copy M|the = H|he
.formula M|pwert = H|pwert
.formula M|pwert = H|fktaplanpos^anzpwert ? H|kotyp = G|ABKO & F|equals(H|kategorie, "(Downpayment)")
.copy M|land = H|kopf^land
.formula M|proz  = H|proz
.formula M|bmge  = H|bmge
.formula M|limge = H|limge
.formula M|lifrg = H|lifrg
.formula M|remge = H|remge
.formula M|refrg = H|refrg
.formula M|status = H|status
.assign M|kstelle = H|kstelle
.assign M|konto = H|konto
.formula M|ils = H|ls
.formula M|ire = H|re
.formula M|ablagef = H|ablagef
.formula M|vmge = H|vmge         ?  F|equals(M|tvorgang^typ, "(SalesOrder)")
.continue SAVEORIG               ? _F|equals(M|tvorgang^typ, "(BlanketOrder)")
.formula M|fzahlgeliefert = H|fzahlgeliefert
.formula M|fzahlabgerufen = H|fzahlabgerufen
.formula M|fzahlabrufoffen = H|fzahlabrufoffen
.formula M|zgltvon = H|zgltvon
.formula M|zgltbis = H|zgltbis
..
!SAVEORIG
.continue ITEM ? F|empty(H|okopf)
.assign M|tnvorg = H|okopf
.continue ERROR01 ? _G|mehr
..
!ITEM: Save parent item
.continue SEARCH ? F|empty(H|orig)
.assign M|tnvorp = H|orig
.continue ERROR01 ? _G|mehr
..
!SEARCH: Set flag for tracking
.. Forward
.formula M|tbvverfolg = (M|stufe >= 0)
..
.. Backward
.formula M|tbverfolg = G|TRUE  ? _F|empty(M|tnvorp) ; _F|empty(M|tnvorg)
.formula M|tbverfolg = G|FALSE ? M|stufe < 0
.. ****************************************************************************
!END
.continue
.. ****************************************************************************
..
!ERROR01
.error -message Zuweisung gescheitert!
.end 1
