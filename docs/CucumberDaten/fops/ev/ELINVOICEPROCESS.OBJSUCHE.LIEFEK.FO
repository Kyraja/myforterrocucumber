..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.OBJSUCHE.LIEFEK.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  : LIEFEK = Lieferschein Einkauf
..*****************************************************************************
.set trans -
.type text   xtext           ? _F|defined(U|xtext)
..
.formula M|button1 = M|gruenz
..<META M|='ev/ELINVOICEPROCESS'>
..
.. TODO: Suchfelder entscheiden
..
.continue END ? M|ExchangedDocumentTypeCode = "81" ; M|ExchangedDocumentTypeCode = "381"
.. hier nur suczhen, wenn keine Bestellung gefunden wurde
.continue END ? _F|empty(M|bestellung)
..
.. Aufruf: ev/ELINVOICEPROCESS.OBJSUCHE.DELIVERY.PROCESS.FO
.type text searchfop ? _F|defined(U|searchfop)
.formula U|searchfop = "ev/ELINVOICEPROCESS.OBJSUCHE.DELIVERY.PROCESS.FO"
..
.copy M|bausbe = G|FALSE
.copy M|bausls = G|FALSE
.copy M|bbeleganfuegen = G|FALSE
.copy M|breneu = G|FALSE
.copy M|bausrlsre = G|FALSE
..
.. Parameter-Felder 
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.. bereits ermittelte BusinessPartner
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
..
.. Ergebnis-Felder
.type VP23 xgefundenVP23 ? _F|defined(U|xgefundenVP23)
.type text xtsuchfehler ? _F|defined(U|xtsuchfehler)
..
.. PARAMETER FšR SUCH-AUFRUF **************************************************
.formula U|xsuchnummer = M|ExchangedDocumentID
.formula U|xsuchnummer = M|BuyerOrderReferencedDocument ? F|empty(U|xsuchnummer)
.formula U|xsuchlieferant = M|lieferant^id 
.formula U|xsuchresteller = ""
..
.input 'U|searchfop'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.continue ERROR ? F|empty(U|xgefundenVP23)
.assign M|liefek = U|xgefundenVP23
.assign M|vorgang = M|liefek
.. LS gebucht?
.copy M|lsueb = _M|liefek^ueb
.copy M|lsfakt = M|liefek^fakt
.copy M|bausls = G|TRUE  ? M|lsfakt & M|lsueb
.formula M|sumnettoliefer = M|liefek^sumnetto
.assign M|zbed = M|liefek^zbed
.formula M|button7 = M|orangez ? F|empty(M|zbed) & _F|empty(M|SpecifiedTradePaymentTerms)
.formula M|button7 = M|rotz    ? F|empty(M|zbed) & _F|empty(M|SpecifiedTradePaymentTerms) & F|empty(M|SpecifiedTradePaymentTermsDueDateDateTime)
.protection zbed 0
.protection -reset zbed 0 ?  F|empty(M|zbed) & _F|empty(M|SpecifiedTradePaymentTerms)
..
.formula M|bem = M|liefek^bem
.copy M|bausls = G|FALSE        ? M|bmehrerelief
.copy M|bbeleganfuegen = G|TRUE ? M|bmehrerelief
.formula M|vorgang = ""         ? M|bmehrerelief
..*****************************************************************************
!END
.continue
..
!ERROR
.formula U|xtext = F|formatstr("Zu {1} konnte kein Lieferschein mit dieser Lieferscheinnummer ermittelt werden.", 'M|ExchangedDocumentID')
.formula M|fctext = 'M|fctext' +";" + 'U|xtext'
.println 'U|xtsuchfehler' ? _F|empty(U|xtsuchfehler)
.formula M|button1 = M|orangez
.formula M|button7 = M|orangez     ? F|empty(M|zbed) & _F|empty(M|SpecifiedTradePaymentTerms)
.continue
