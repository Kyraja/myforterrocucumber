..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : STDM.DATENGEN
.. Author         : vbrukman
.. Verantwortlich : vbrukman
.. Kontrolle      : teamreport
.. Functionality  :
..*****************************************************************************
.set trans -
.input "is/XMLGEN.PRE.FOP"
.type text xpagename ? _defined(U|xpagename)
.type text xtfromlabel ? _defined(U|xtfromlabel)
.type text xttolabel ? _defined(U|xttolabel)
.type text xtsellabel ? _defined(U|xtsellabel)
.type integer xindex ? _defined(U|xindex)
.type integer xevtzeile ? _defined(U|xevtzeile)
.translate -language 'P|spr' -variable U|xpagename -text "Seite"
.translate -language 'P|spr' -variable U|xtfromlabel -text "von"
.translate -language 'P|spr' -variable U|xttolabel -text "bis"
.translate -language 'P|spr' -variable U|xtsellabel -text "Operator"
<?xml version="1.0" encoding="UTF-8"?>
<ABASData abasversion='G|progvers' source="Screen">
   <RecordSet caption="0">
.type integer lastrow ? _defined(U|lastrow)
.formula U|lastrow = F|condexpr(G|evtzeile=0, M|tzeilen, 1)
.type bool isSingleRow ? _defined(U|isSingleRow)
.formula isSingleRow = G|false
      <Record caption="STD" lastrow="'U|lastrow'">
.assign U|xindex=0
.set foextern -
         <Head caption="0">
              <Field name="xtfromlabel" abasType="'F|typeof(U|xtfromlabel)'">'U|xtfromlabel'</Field>
              <Field name="xttolabel" abasType="'F|typeof(U|xttolabel)'">'U|xttolabel'</Field>
              <Field name="xtsellabel" abasType="'F|typeof(U|xtsellabel)'">'U|xtsellabel'</Field>
.set foextern +
.input "is/XMLGEN.COMMON.HVARS"
.set foextern -
.type text xtzwaehr ? _defined(U|xtzwaehr)
.translate -language 'P|spr' -dictionary vt -variable U|xtzwaehr -text "WÑhrung fÅr Einzelpreis und Positionswert"
              <Field name="txtzwaehr" abasType="Text">'U|xtzwaehr'</Field>
              <Field name="such" abasType="SWK186" style="none">'M|such'</Field>
.type text xtanzpwert ? _defined(U|xtanzpwert)
.translate -language 'P|spr' -dictionary vt -variable U|xtanzpwert -text "Rechnungsbetrag"
              <Field name="txtanzpwert" abasType="Text">'U|xtanzpwert'</Field>
.type text xtzpftext ? _defined(U|xtzpftext)
.translate -language 'P|spr' -dictionary vt -variable U|xtzpftext -text "Zusatzfeld Freitext"
              <Field name="txtzpftext" abasType="Text">'U|xtzpftext'</Field>
.type text xtzbed ? _defined(U|xtzbed)
.translate -language 'P|spr' -dictionary vt -variable U|xtzbed -text "Zahlungsbedingung"
              <Field name="txtzbed" abasType="Text">'U|xtzbed'</Field>
.type text xtplanredat ? _defined(U|xtplanredat)
.translate -language 'P|spr' -dictionary vt -variable U|xtplanredat -text "Geplantes Rechnungsdatum"
              <Field name="txtplanredat" abasType="Text">'U|xtplanredat'</Field>
.type text xtreart ? _defined(U|xtreart)
.translate -language 'P|spr' -dictionary vt -variable U|xtreart -text "Rechnungsart"
              <Field name="txtreart" abasType="Text">'U|xtreart'</Field>
.type text xttterm ? _defined(U|xttterm)
.translate -language 'P|spr' -dictionary vt -variable U|xttterm -text "FÑlligkeit"
              <Field name="txttterm" abasType="Text">'U|xttterm'</Field>
         </Head>
.set foextern +
.formula U|xindex=M|aktzeile
.formula isSingleRow=G|true ? (U|xindex>0)
.continue TT1OUTPUT ? _U|isSingleRow
.select screen line 'U|xindex'
.continue TTEND ? _G|mehr
.continue TT2OUTPUT
!TT1OUTPUT
.select screen line
.continue TTEND ? _G|mehr
.formula U|xindex=M|aktzeile
!TT2OUTPUT
.set foextern -
         <Row caption="'U|xindex'">
              <Field name="zn" abasType="'F|typeof(U|xindex)'" value="'U|xindex(L="0")'">'U|xindex'</Field>
              <Field name="zwaehr" abasType="PS94:1" style="none" value="'M|zwaehr(L="0")'">'M|zwaehr'</Field>
              <Field name="zbedname" abasType="PT12:8" style="none" value="'M|zbedname(L="0")'">'M|zbedname'</Field>
              <Field name="anzpwert" abasType="R9.2" style="none" value="'M|anzpwert(L="0")'">'M|anzpwert'</Field>
              <Field name="reart" abasType="AU271" style="none" value="'M|reart(L="0")'">'M|reart'</Field>
              <Field name="zpftext" abasType="DVMR2" style="html">'M|zpftext'</Field>
              <Field name="tterm" abasType="GD2" style="none" value="'M|tterm(L="0")'">'M|tterm'</Field>
              <Field name="zbed^namebspr" abasType="T46" style="none">'M|zbed^namebspr'</Field>
              <Field name="planredat" abasType="GD2" style="none" value="'M|planredat(L="0")'">'M|planredat'</Field>
              <Field name="ptext" abasType="T38" style="none">'M|ptext'</Field>
              <Field name="status" abasType="NT1" style="none">'M|status'</Field>
              <Field name="page" abasType="'F|typeof(U|xpagename)'">'U|xpagename'</Field>
.set foextern +
         </Row>
.continue TTEND ? U|isSingleRow
.continue TT1OUTPUT
!TTEND
      </Record>
   </RecordSet>
</ABASData>
.input "is/XMLGEN.POST.FOP"
.continue

