..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : DEL.BN
..  Datum          : 07.12.04
..  Version        : 2004
..  Autor          : cl
..  Verantwortlich : cl
..  Kontrolle      :
..
..  Funktion       : startet DEL
..  Functionality  :
..
..  Ablauf         :
..  Program flow   :
..
..*****************************************************************************
.set trans -
.type ID82  xidherkunft   ? _F|defined(U|xidherkunft)
.type text  xherkunft     ? _F|defined(U|xherkunft)
.type integer   xndel         ? _F|defined(U|xndel)
.type integer   xi            ? _F|defined(U|xi)
.type text  xbasispreis   ? _F|defined(U|xbasispreis)
.type text  xnot          ? _F|defined(U|xnot)
.type text  xdzu          ? _F|defined(U|xdzu)
.type text  xddat         ? _F|defined(U|xddat)
.type text  xdmat         ? _F|defined(U|xdmat)
.type text  xdland        ? _F|defined(U|xdland)
.type text  xpreiseinheit ? _F|defined(U|xpreiseinheit)
..
.input "is/TABLEEREN"
..
.continue ERROR1     ? F|empty(M|vorgang)
..
.load 0 object 'M|vorgang^id'
.continue ERROR2     ? _G|mehr
..
!ZEILE
.load 0 line
.continue MACHE      ? _G|mehr
.continue ZEILE      ?  0|typ <> G|delpos
.continue ZEILE      ?  F|empty(0|ptext)
..
.formula U|xpreiseinheit = 0|pe
.formula U|xidherkunft = 0|herkunft^id
.copy U|xherkunft = 'U|xidherkunft'
.formula U|xbasispreis = 0|herkunft^matbasis
.formula U|xnot        = 0|herkunft^matnotiz
.formula U|xdzu        = 0|herkunft^matproz
.formula U|xddat       = 0|herkunft^matdat
.formula U|xdmat       = 0|herkunft^matart 
.formula U|xdland      = 0|herkunft^matland
.formula 0|ptext       = ""
.formula U|xi          = 0
..
!ZEILENHOL: Kam diese DEL-Notiz in diesem Vorgang schon vor?
.formula U|xi = U|xi + 1
.continue NEXTMAT    ? U|xi > U|xndel
.continue ZEILE      ? U|xherkunft = U|xherkunft.U|xi
.continue ZEILENHOL
..
!NEXTMAT: DEL-Notiz kam in diesem Vorgang noch nicht vor
.type text  xdmat.xi xdland.xi xherkunft.xi xbasispreis.xi xnot.xi xdzu.xi xddat.xi xpreiseinheit.xi
.formula U|xndel            = U|xndel + 1
.formula U|xi               = U|xndel
.formula U|xpreiseinheit.U|xi = U|xpreiseinheit
.formula U|xherkunft.U|xi     = U|xherkunft
.formula U|xbasispreis.U|xi   = U|xbasispreis
.formula U|xnot.U|xi          = U|xnot
.formula U|xdzu.U|xi          = U|xdzu
.formula U|xddat.U|xi         = U|xddat
.formula U|xdmat.U|xi         = U|xdmat
.formula U|xdland.U|xi        = U|xdland
.continue ZEILE
..
!MACHE
.continue END              ? U|xi = 0
.formula U|xi = 0
..
!MAKE
.formula U|xi = U|xi + 1
.make screen line +O
.formula M|preiseinheit  = U|xpreiseinheit.U|xi
.formula M|delmat        = U|xdmat.U|xi
.formula M|delbasis      = U|xbasispreis.U|xi
.formula M|delnotiz      = U|xnot.U|xi
.formula M|delland       = U|xdland.U|xi
.formula M|delproz       = U|xdzu.U|xi
.formula M|deldat        = U|xddat.U|xi
.formula M|delherkunft   = U|xherkunft.U|xi
.continue MAKE            ? U|xi < U|xndel
.continue END
..
..*****************************************************************************
!END
.continue
..
!ERROR2:
.error -field M|vorgang -message Keinen Vorgang gefunden.
.end 1
..
!ERROR1:
.error -field M|vorgang -message Bitte Vorgang w„hlen.
.end 1
