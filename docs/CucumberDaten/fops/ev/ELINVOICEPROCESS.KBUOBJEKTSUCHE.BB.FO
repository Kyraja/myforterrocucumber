..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.KBUOBJEKTSUCHE.BB.FO
.. Author         : cl
.. Verantwortlich : cl
.. Kontrolle      : mh
.. Functionality  :
..*****************************************************************************
.set trans -
..
..<META M|='ev/ELINVOICEPROCESS'>
..
.continue ERROR3  ? _F|empty(M|reek) & _G|evtvar = "bstart"
.continue ERROR   ? _F|empty(M|resteller) & _G|evtvar = "bueigbestell"
.continue ERROR2  ? M|tzeilen = 0
..<BLOCK> Cancel event if required conditions are not met
.continue NOSUCH  ?  F|empty(M|ediobjsuch)
.continue KEINZF  ? _F|equals(M|ediobjsuch^edinachraz, "(ZUGFeRDInvoice)")
.continue WRONGIS ? M|such <> M|ediobjsuch^srcinfosys^such
..</BLOCK>
..
.. 
..<BLOCK> Remove auxiliary rows (Zusatzzeilen bspw. ermittelte Lieferscheinpositionen entfernen)
.select screen header
.continue ENDROWS ? _G|mehr
!NEXTROW
.select screen line
.continue ENDROWS ? _G|mehr
!THISROW
.continue ENDROWS ? _F|defined(M|zeilentyptext)  
.continue NEXTROW ? _F|empty(M|zeilentyptext)
.make screen line -O
.continue THISROW
!ENDROWS 
..</BLOCK>
..
..*****************************************************************************
.continue
..
!NOSUCH
.error Keine Objektsuche definiert.
.end 1
..
!KEINZF 
.error Die Objektsuche ist fÅr ein anderes Nachrichtenformat.
.end 1
..
!WRONGIS
.error Die Objektsuche ist fÅr ein anderes Infosystem.
.end 1
..
!ERROR
.error Die Objektsuche wurde bereits gestartet.
.end 1
..
!ERROR2
.error Keine Tabellenzeilen vorhanden. Bitte zuerst den Start-Button drÅcken.
.end 1
..
!ERROR3
.error -message 'F|formatstr("Es wurde bereits eine Rechnung {1} zu EDI-Nachricht {2} erstellt.", M|reek, M|edifact)'
.end 1
