..  include ev/ELINVOICEPROCESS.CACHE.VP5.OUT.FO
..*****************************************************************************
.set trans -
..
.input "is/ABASFARBEN.DEF"
..
..<META M|='ev/ELINVOICEPROCESS'>
..<META H|='P92:11'>
..
.select ediconfiguration 'M|ediobjsuch^id'
.continue NOSUCH ? _G|mehr
..
.. Die Objektsuche ist leer, es gibt nichts zu tun
.select header
.continue END ? _G|mehr
.select line
.continue END ? _G|mehr
..
..*****************************************************************************
.. Objektesuche fuer Kopffelder
..*****************************************************************************
..
.select screen header
.continue END ? _G|mehr
..
.select header
.continue EHEAD ? _G|mehr
!NXTHDFO
.select line
.continue EHEAD ? _G|mehr
..
.input 'H|fopname' ? _H|vkt & F|defined(M|.H|zielvar)
.continue NXTHDFO 
..
!EHEAD
..
..*****************************************************************************
.. Objektesuche fuer Zeilenfelder
..*****************************************************************************
!NEXTROW
.select screen line
.continue END ? _G|mehr
..
.select header
.continue ELINE ? _G|mehr
!NXTROFO
.select line
.continue ELINE ? _G|mehr
..
.input 'H|fopname' ? H|vkt & F|defined(M|.H|zielvar)
.continue NXTROFO 

!ELINE
.continue NEXTROW
..
..*****************************************************************************
!END
.input "ev/ELINVOICEPROCESS.OBJSUCHE.NACHLAEUFER.FO"
.continue
..
!NOSUCH
.error Keine Objektsuche definiert
.end 1
