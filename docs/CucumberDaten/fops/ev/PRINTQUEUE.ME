..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : PRINTQUEUE.ME
.. Autor          : fwester
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Initialisiert den Maskenpuffer der Druckschlange in EK oder VK.
.. Ablauf         : Maskeintritts-EFOP
..
.. Functionality  : Initializes the mask buffer of the printer queue from purchase
..                  or sales.
.. Program flow   : Enter mask efop
..*****************************************************************************
.set trans -
.type text xsel ? _F|defined(U|xsel)
..
.. Initializations
.formula M|rotz   = G|icoerror
.formula M|gelbz  = G|icowarn
.formula M|gruenz = G|icook
.formula M|blauz  = G|icomessage
..
.copy M|printqueue = G|TRUE
.assign M|filingmode = "(Active)"
.assign M|division = G|kdatname3
.copy M|sales = G|TRUE
.formula M|purchtype = "(Invoice)"
.formula M|salestype = "(Invoice)"
.copy M|doctype = G|REKO
.copy M|bookdatedoc = G|TRUE
.assign M|operator = G|bzeichen
.protection purchtype 0
.protection ekdocpartner 0
.protection ekpayment 0
.protection ausschr 0
.. 
!ABSENDER: email
.formula U|xsel = "$,,gruppe=11;@gruppe=11;bezeich="+'G|bzeichen'
.load 1 company 'U|xsel'
.continue NOEMAIL ? _G|mehr
..
.formula M|emailfrom = 1|passmitarb^email
.formula M|emailfrom = 1|pemail             ? F|empty(M|emailfrom)
.load 1
..
!NOEMAIL
.formula M|emailfrom = F|sysinfo(10)^email  ? F|empty(M|emailfrom)
..
..*****************************************************************************
!END
.continue
