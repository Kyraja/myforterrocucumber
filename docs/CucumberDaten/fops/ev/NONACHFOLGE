.set trans -
.type integer  xznr    ? _F|defined(U|xznr)
.type text xtopen  ? _F|defined(U|xtopen)
..
.continue HOLZEILE           ? _G|evtvar = "topen"
.formula U|xznr = M|zn
.formula U|xtopen = M|topen
.continue OPENED
..
!HOLZEILE
.select screen line
.continue ENDE               ? _G|mehr
.continue OPENEDALL
..
!OPENED
.continue FEHLER1 ? _F|empty(M|tpart) & U|xtopen = "icon:folder_closed"
.continue FEHLER2 ? _F|empty(M|tpart) & U|xtopen = "icon:folder_opened"
.continue FEHLER1 ?  M|tdetail ="icon:minus_black" & U|xtopen = "icon:folder_closed"
.continue FEHLER2 ?  M|tdetail ="icon:minus_black" & U|xtopen = "icon:folder_opened"
.select screen line
.continue URSPRUNG  ? _G|mehr
.continue OPENED
..
!URSPRUNG
.select screen line 'U|xznr'
.continue ENDE
..
!OPENEDALL
.continue FEHLER1 ? _F|empty(M|tpart) & G|evtvar = "exp"
.continue FEHLER2 ? _F|empty(M|tpart) & G|evtvar = "coll"
.continue FEHLER1 ?  M|tdetail ="icon:minus_black" & G|evtvar = "exp"
.continue FEHLER2 ?  M|tdetail ="icon:minus_black" & G|evtvar = "coll"
.select screen line
.continue ENDE    ? _G|mehr
.continue OPENEDALL
..
!FEHLER1
.error "Nachfolger zeigen" ist bei aufgeklappten Vorgangspositionen nicht erlaubt.
.end 1
..
!FEHLER2
.error "Nachfolger verbergen"  ist bei aufgeklappten Vorgangspositionen nicht erlaubt.
.end 1
..
!ENDE
.continue
