..!interpreter english translate noabbrev src=de
..*****************************************************************************
.. FOP-Name       : OBLEVKRAHMEN.TAB2
.. Autor          : cl
.. Verantwortlich : cl
.. Kontrolle      : tiwe
.. Funktion       : Schreibt die aufgeklappten Tabellenzeilen der Rahmenauftragsobligos
.. Ablauf         : 
..
..*****************************************************************************
.set trans -
..
.make screen line +o
.assign M|kopf = 1|kopf
.formula M|ttypa = 1|kotypa
.assign M|art = 1|artikel
.formula M|mge = 1|mge
.formula M|kovom = 1|kovom
.formula M|pnum = 1|pnum
.assign M|evpos= 1|id
.assign M|tkuli = 1|kopf^kl
.formula M|tzeich = 1|kopf^zeich
.formula M|proz = 1|proz
.formula M|pwert = 1|pwert
.formula M|nwert = 1|nwert
.formula M|vorgart = M|ttypa
.formula M|vorgart = 1|tlsart ? 1|kotyp = 4
.formula M|vorgart = 1|treart ? 1|kotyp = 5
.colour -background 'M|coloryellow' 'M|aktzeile'
.continue

