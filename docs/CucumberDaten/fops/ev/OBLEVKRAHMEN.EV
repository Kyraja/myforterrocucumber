..!interpreter english translate noabbrev
..*****************************************************************************
..  FOP-Name       : OBLEVKRAHMEN.EV
..  Autor          : cl
..  Verantwortlich : cl
..  Kontrolle      : tiwe
..  Funktion       : Behandelt zentral Feld- und Zeilenereignisse.
..  Ablauf         : Zentrales Ereignis-FOP
..
..  Functionality  : Central event handling efop
..  Program flow   : Centrals event handling of fields and rows.
..*****************************************************************************
.set trans -
.type text    xtext       ? _F|defined(U|xtext)
..
..  ----------------------- Kopf/Header ---------------------------------------
.continue BSEL    ? G|evtartengl="BUTTON_AFTER"    & G|evtvar="bselect"
.continue AUV     ? G|evtartengl="FIELD_EXIT"      & G|evtvar="belegvon"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="belegbis"
.continue ARTIKEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="artikel"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kkuli"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kkuli2"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="bkrit"
.continue DISPO   ? G|evtartengl="FIELD_EXIT"      & G|evtvar="bdisponiert"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kvertret"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kzeich"
.continue DECIMAL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="auswaehr"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="wvdat"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="inkllsre"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="projekt"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="vorgartaz"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="kebeleg"
.continue DATE    ? G|evtartengl="FIELD_EXIT"      & G|evtvar="datef"
.continue DATE    ? G|evtartengl="FIELD_EXIT"      & G|evtvar="datet"
.continue RAHMEN  ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zrahmen"
.continue SUMMEVK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="posgruenvk
.continue SUMMEEK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="posgruenek"
.continue SUMMEVK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="posrotvk"
.continue SUMMEEK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="posrotek"
.continue ZEIGE   ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zgruen" 
.continue ZEIGE   ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zgelb"
.continue ZEIGE   ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zrot"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zgltgruen"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zgltgelb"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zgltrot"
.continue INITSEL ? G|evtartengl="FIELD_EXIT"      & G|evtvar="zgueltig"
.continue ATAGEEK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="gltrotek"
.continue ATAGEEK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="gltgruenek"
.continue ATAGEVK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="gltrotvk"
.continue ATAGEVK ? G|evtartengl="FIELD_EXIT"      & G|evtvar="gltgruenvk"
.continue BASIS   ? G|evtartengl="FIELD_EXIT"      & G|evtvar="basisartikel"
..------------------------- Tabelle/Table -------------------------------------
.continue BLIEF   ? G|evtartengl="BUTTON_BEFORE"  & G|evtvar="bfolge
.continue REFRESH ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="bfolge"
..-----------------------------------------------------------------------------
.continue END
..
!ARTIKEL
.formula M|basisartikel = M|artikel^basisartikel ? _F|empty(M|artikel)
.continue INITSEL
..
!BASIS
.formula M|artikel = "" ? _F|empty(M|basisartikel)
.continue INITSEL
..
!ATAGEEK
.continue ERROR04   ? M|gltrotek >= M|gltgruenek ; (M|gltgruenek - M|gltrotek <= 2)
.continue ERROR05   ? M|gltrotek < 0 ; M|gltgruenek < 0
.formula M|gltgelbv = M|gltgruenek - 1
.formula M|gltgelbb = M|gltrotek + 1
.continue INITSEL
..
!ATAGEVK
.continue ERROR04   ? M|gltrotvk >= M|gltgruenvk ; (M|gltgruenvk - M|gltrotvk <= 2)
.continue ERROR05   ? M|gltrotvk < 0 ; M|gltgruenvk < 0
.formula M|gltgelbv = M|gltgruenvk - 1
.formula M|gltgelbb = M|gltrotvk + 1
.continue INITSEL
..
!ZEIGE
.copy M|zgruen = G|TRUE ? _M|zgruen & _M|zgelb & _M|zrot
.continue INITSEL
..
!SUMMEEK
.continue ERROR04 ? M|posgruenek >= M|posrotek ; (M|posrotek - M|posgruenek <= 2)
.continue ERROR05 ? M|posgruenek < 0 ; M|posrotek < 0
.formula M|posgelbv = M|posgruenek + 1
.formula M|posgelbb = M|posrotek -1
.continue INITSEL
..
!SUMMEVK
.continue ERROR04 ? M|posgruenvk >= M|posrotvk ; (M|posrotvk - M|posgruenvk <= 2)
.continue ERROR05 ? M|posgruenvk < 0 ; M|posrotvk < 0
.formula M|posgelbv = M|posgruenvk + 1
.formula M|posgelbb = M|posrotvk -1
.continue INITSEL
..
!RAHMEN
.formula M|belegvon = "" ? _F|empty(M|zrahmen)
.formula M|belegbis = "" ? _F|empty(M|zrahmen)
.continue INITSEL
..
!DATE
.continue INITSEL ? (('M|datef' <> "" & 'M|datet' = "") ; ('M|datet' <> ""  & 'M|datef' = ""))
.continue ERROR03 ? 'M|datef:8' > 'M|datet:8'
.continue INITSEL
..
!BSEL: clear parameter in header and set selection by a selection bar
.copy M|mitalternativpos = G|FALSE
.copy M|wvdat = G|FALSE ? F|defined(M|wvdat)
.assign M|belegvon = ""   ? F|defined(M|belegvon)
.assign M|belegbis = ""   ? F|defined(M|belegbis)
.assign M|kkuli = ""      ? F|defined(M|kkuli)
.assign M|kkuli2 = ""     ? F|defined(M|kkuli2)
.assign M|artikel = ""    ? F|defined(M|artikel)
.assign M|kzeich = ""     ? F|defined(M|kzeich)
.assign M|projekt = ""    ? F|defined(M|projekt)
.assign M|kvertret = ""   ? F|defined(M|kvertret)
.assign M|ausschr = ""    ? F|defined(M|ausschr)
.assign M|vorgartaz = ""  ? F|defined(M|vorgartaz)
.assign M|kebeleg = ""    ? F|defined(M|kebeleg)
.formula G|evtfeldneu  = "%"
.input "is/AUSWAHL"
.copy M|selektion = M|select <> "!"
.continue INIT
..
!AUV: copy value from start to end of area
.formula M|belegbis = M|belegvon ? _F|empty(M|belegvon)
.formula M|zrahmen = "" ? _F|empty(M|belegvon) ; _F|empty(M|belegbis)
.continue INITSEL
..
!DISPO: Set visibility of table column "disponiert"
.formula P|maskkontextfop = ""           ? _M|bdisponiert
.formula P|maskkontextfop = "FOP_DISPO"  ?  M|bdisponiert
.continue INITSEL
..
!INITSEL: deactivate selektion bar switch
.copy M|selektion = G|FALSE
.continue INIT
..
!DECIMAL: decimal places of output currency
.input "is/EVT.FIELD.OUTCURR"
.copy M|ausnkst = M|auswaehr^nkst
..
!INIT: clear table and sum
.make screen line -- ? M|tzeilen > 0
.input 'M|bkopf' ? _F|empty(M|bkopf)
.continue END
..
!REFRESH: Refresh table
.input "is/TABLEEREN"
.input "is/HOL.LISTE.EVPOS"
.continue END
..
!BLIEF: Button before processing
.continue ERROR01 ? F|empty(M|evpos)
..
.type text xkomm:100
.continue KLS ? M|aubeo & M|kopf^dnr = 3
..
.assign U|xkomm = "{1}<{2}>"
.formula U|xkomm = F|formatstr(U|xkomm, M|evpos^id, "(Release)")  ? M|kotyps = "(BlanketOrder)" ; M|kotyps = "(Quotation)"  ; M|kotyps = "(Request)"
.formula U|xkomm = F|formatstr(U|xkomm, M|evpos^id, "(Delivery)") ? M|kotyps = "(SalesOrder)" ; M|kotyps = "(PurchaseOrder)"
.formula U|xkomm = F|formatstr(U|xkomm, M|evpos^id, "(Invoice)")  ? F|empty(M|kotyp)
.. hart gesperrte Positionen nicht in Folgebelege Åbernehmen - nur Rechnung mîglich. 
.continue END0
..
!KLS: Lieferschein / Kundenanlieferung fÅr IS AUO
.formula U|xkomm = 'M|evpos^id' + "<(Delivery)>"                                                         ? M|pwert >= 0
.formula U|xkomm = "<(Sales)><(New)>,(PackingSlip) ? lsart=(CustomerDelivery) | beleg=" + 'M|evpos^id'   ? M|pwert < 0
.continue END0
..
!END0
.end 0 'U|xkomm'
..
..*****************************************************************************
!END
.continue
..*****************************************************************************
..
!ERROR01: Missing item
.error -line 'G|evtzeile' -message Es fehlt die Angabe eines Vorgangs oder einer Position!
.end 1
..
!ERROR02: Locked Items, only possible to create invoice
.error -line 'G|evtzeile' -message Gesperrter Artikel: Folgebeleg wurde nicht erstellt.
.end 1
..
!ERROR03: Falscher Datumsbereich
.error GÅltigkeits-bis-Datum ist kleiner als GÅltigkeits-von-Datum.
.formula M|datef = "" ?  G|evtvar="datef"
.cursor datef         ?  G|evtvar="datef"
.formula M|datet = "" ?  G|evtvar="datet"
.cursor datet         ?  G|evtvar="datet"
.end 1
..
!ERROR04
.error Die Angabe fÅr Abweichung ist nicht korrekt!
.continue LEER    ? G|evtvar="posrotvk" ; G|evtvar="posrotek" ; G|evtvar="posgruenvk" ; G|evtvar="posgruenek"
.continue GLTLEER ? G|evtvar="gltrotek" ; G|evtvar="gltgruenek" ; G|evtvar="gltrotvk" ; G|evtvar="gltgruenvk"
..
!ERROR05
.error Eine negative Angabe ist nicht erlaubt!
.continue LEER    ? G|evtvar="posrotvk" ; G|evtvar="posrotek" ; G|evtvar="posgruenvk" ; G|evtvar="posgruenek"
.continue GLTLEER ? G|evtvar="gltrotek" ; G|evtvar="gltgruenek" ; G|evtvar="gltrotvk" ; G|evtvar="gltgruenvk"
..
!LEER
.formula M|posrotvk = 99               ? G|evtvar="posrotvk"
.cursor posrotvk 0                     ? G|evtvar="posrotvk"
.formula M|posgelbb = M|posrotvk - 1   ? G|evtvar="posrotvk"
.formula M|posrotek = 99               ? G|evtvar="posrotek"
.cursor posrotek 0                     ? G|evtvar="posrotek"
.formula M|posgelbb = M|posrotek - 1   ? G|evtvar="posrotek"
.formula M|posgruenvk = 1              ? G|evtvar="posgruenvk"
.cursor posgruenvk 0                   ? G|evtvar="posgruenvk"
.formula M|posgelbv = M|posgruenvk + 1 ? G|evtvar="posgruenvk"
.formula M|posgruenek = 1              ? G|evtvar="posgruenek"
.cursor posgruenek 0                   ? G|evtvar="posgruenek"
.formula M|posgelbv = M|posgruenek + 1 ? G|evtvar="posgruenek"
.end 1
..
..
!GLTLEER
.formula M|gltrotek = 1                ? G|evtvar="gltrotek"
.cursor gltrotek                       ? G|evtvar="gltrotek"
.formula M|gltgelbb = M|gltrotek + 1   ? G|evtvar="gltrotek"
.formula M|gltgruenek = 30             ? G|evtvar="gltgruenek"
.cursor gltgruenek                     ? G|evtvar="gltgruenek"
.formula M|gltgelbv = M|gltgruenek - 1 ? G|evtvar="gltgruenek"
.formula M|gltrotvk = 1                ? G|evtvar="gltrotvk"
.cursor gltrotvk                       ? G|evtvar="gltrotvk"
.formula M|gltgelbb = M|gltrotvk + 1   ? G|evtvar="gltrotvk"
.formula M|gltgruenvk = 30             ? G|evtvar="gltgruenvk"
.cursor gltgruenvk                     ? G|evtvar="gltgruenvk"
.formula M|gltgelbv = M|gltgruenvk - 1 ? G|evtvar="gltgruenvk"

