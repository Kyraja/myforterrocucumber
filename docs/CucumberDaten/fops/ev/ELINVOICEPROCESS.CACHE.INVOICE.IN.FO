..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICEPROCESS.CACHE.INVOICE.IN.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  :
..*****************************************************************************
.set trans -
..
.. search fields must defined
.type text xsuchnummer ? _F|defined(U|xsuchnummer)
.type text xsuchfrzeich ? _F|defined(U|xsuchfrzeich)
.type VP5 xsuchlieferant ? _F|defined(U|xsuchlieferant)
.type VP5 xsuchresteller ? _F|defined(U|xsuchresteller)
.type VP23 xgefundenVP24 ? _F|defined(U|xgefundenVP24)
..
..*****************************************************************************
..
.. create variablen name from parameters
.. remove all non-valid symbols (should be none, but better not risk FO complications)
.type text xvp24name ? _F|defined(U|xvp24name)
.formula U|xvp24name = F|formatstr("X{1}X{2}X{3}", U|xsuchnummer, U|xsuchlieferant, U|xsuchresteller)
.formula U|xvp24name = F|regreplaceall(U|xvp24name, "[\.\$\&\'\(\)\*\+\=\/\;\:\<\>\?\`\^\ \-]", "")
..
.continue KNOWN ? F|defined(U|.xvp24name)
..
.type VP23 U|.xvp24name 
.copy    U|.xvp24name = U|xgefundenVP24
.continue SAVED
..
..*****************************************************************************
.continue
..
!SAVED
.. .println Der Wert fÅr Suche 'U|xvp24name' wurde als 'U|xgefundenVP24' in den Cache gesetzt.
.continue 
..
!KNOWN
.. .println Der Wert fÅr Suche 'U|xvp24name' war bereits gecacht.
.continue
