..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : ELINVOICECENTER.KBUIDENTIFIZIERENUNDUEBERNEHMEN.BA.TAB.FO
.. Author         : mh
.. Verantwortlich : mh
.. Kontrolle      : cl
.. Functionality  :  Komfort-Ablauf fuer eine Zeile 
..*****************************************************************************
.set trans -
..
..<META M|='ev/ELINVOICECENTER'>
..
.type text absenderidfopBA ? _F|defined(U|absenderidfopBA)
.formula U|absenderidfopBA = "ev/ELINVOICECENTER.BUPARTNERIDENTIFIZIEREN.BA.FO"
.type text absenderuebfopBA ? _F|defined(U|absenderuebfopBA)
.formula U|absenderuebfopBA = "ev/ELINVOICECENTER.BUPARTNERUEBERNEHMEN.BA.FO"
.type text datenuebfopBA ? _F|defined(U|datenuebfopBA)
.formula U|datenuebfopBA = "ev/ELINVOICECENTER.BUDATENUEBERNEHMEN.BA.FO"
..
.. Icon for failed comfort-processing in a line
.type text icoflash ? _F|defined(U|icoflash)
.formula U|icoflash = "icon:flash"
..
..*****************************************************************************
..
.. Fehlermeldungen initialisieren
.formula M|edipartnerfehler=""
..
.. 1. skipp lines with nothing to do
.continue END ? F|empty(M|edinr)
.continue END ? F|equals(M|edinr^edistatusaz, "(Deactivated)")
..
.. 2. find message partner
.input 'U|absenderidfopBA'
.formula M|tedistatusaz = M|edinr^edistatusaz
.formula M|fotoz = G|icook        ? M|edinr^status=0
.formula M|fotoz = G|icomessage   ? M|edinr^status>=2 & M|edinr^fcode=0
.formula M|fotoz = G|icoerror     ? M|edinr^status>=2 & M|edinr^fcode<>0
.formula M|fotoz = G|icoerror     ? M|edinr^status>=4
.formula M|fotoz = G|icowarn      ? M|edinr^status>=5
.formula M|fotoz = G|icoerror     ? M|edinr^status=11
.continue ERR2 ? F|empty(M|edipartner)
..
.. 3. write message partner to edi message
.input 'U|absenderuebfopBA'
.formula M|tedistatusaz = M|edinr^edistatusaz
.formula M|fotoz = G|icook        ? M|edinr^status=0
.formula M|fotoz = G|icomessage   ? M|edinr^status>=2 & M|edinr^fcode=0
.formula M|fotoz = G|icoerror     ? M|edinr^status>=2 & M|edinr^fcode<>0
.formula M|fotoz = G|icoerror     ? M|edinr^status>=4
.formula M|fotoz = G|icowarn      ? M|edinr^status>=5
.formula M|fotoz = G|icoerror     ? M|edinr^status=11
.continue ERR3OBJ ? F|empty(M|edinr^ediobjsuch) 
.continue ERR3ABM ? F|empty(M|edinr^vabmodell)
..
.. 4. fill edi message table from e-invoice xml message 
.continue SKIPP4 ? F|empty(M|edinr^nachrftext)
.input 'U|datenuebfopBA'
.formula M|tedistatusaz = M|edinr^edistatusaz
.formula M|fotoz = G|icook        ? M|edinr^status=0
.formula M|fotoz = G|icomessage   ? M|edinr^status>=2 & M|edinr^fcode=0
.formula M|fotoz = G|icoerror     ? M|edinr^status>=2 & M|edinr^fcode<>0
.formula M|fotoz = G|icoerror     ? M|edinr^status>=4
.formula M|fotoz = G|icowarn      ? M|edinr^status>=5
.formula M|fotoz = G|icoerror     ? M|edinr^status=11
.continue ERR4 ? F|empty(M|edinr)
.load 2 nolock edifact 'M|edinr^id'
.load 2 line 
.continue ERR4LIN ? _G|mehr
.load 2 
..
..*****************************************************************************
!END
.continue
..
!ERR2
.formula M|edipartnerfehler=M|edipartnerfehler + ";" ? _F|empty(M|edipartnerfehler)
.formula M|edipartnerfehler=M|edipartnerfehler + "Der Absender konnte nicht ermittelt werden."
.formula M|fotoz = M|fehlerbeimvorbereiten
.continue
..
!ERR3OBJ
.formula M|edipartnerfehler=M|edipartnerfehler + ";" ? _F|empty(M|edipartnerfehler)
.formula M|edipartnerfehler=M|edipartnerfehler + "Ohne EDI-Objektsuche kann die Verarbeitung nicht fortgesetzt werden." 
.formula M|fotoz = M|fehlerbeimvorbereiten
.continue
..
!ERR3ABM
.formula M|edipartnerfehler=M|edipartnerfehler + ";" ? _F|empty(M|edipartnerfehler)
.formula M|edipartnerfehler=M|edipartnerfehler + "Ohne Abbildungsmodell kann die Verarbeitung nicht fortgesetzt werden." 
.formula M|fotoz = M|fehlerbeimvorbereiten
.continue
..
!SKIPP4
.formula M|edipartnerfehler=M|edipartnerfehler + ";" ? _F|empty(M|edipartnerfehler)
.formula M|edipartnerfehler=M|edipartnerfehler + "Der Nachrichtentext ist leer." 
.formula M|fotoz = M|fehlerbeimvorbereiten
.continue 
..
!ERR4
.formula M|edipartnerfehler=M|edipartnerfehler + ";" ? _F|empty(M|edipartnerfehler)
.formula M|edipartnerfehler=M|edipartnerfehler + "Das FOP ist kaputt."
.formula M|fotoz = M|fehlerbeimvorbereiten
.continue
..
!ERR4LIN
.formula M|edipartnerfehler=M|edipartnerfehler + ";" ? _F|empty(M|edipartnerfehler)
.formula M|edipartnerfehler=M|edipartnerfehler + "Die Nachricht ist unvollst„ndig."
.formula M|edipartnerfehler=M|edipartnerfehler + ";" 
.formula M|edipartnerfehler=M|edipartnerfehler + "Aus der Nachricht konnten keine Zeilen erstellt werden."
.formula M|fotoz = M|fehlerbeimvorbereiten
.continue
