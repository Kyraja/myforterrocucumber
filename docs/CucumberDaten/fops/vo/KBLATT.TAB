..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KBLATT.TAB
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Functionality  : Infosystem, KBLATT, Table-View-FOP
..*****************************************************************************
.set trans -
..
!ZEILE: load line
.load 0 line
.continue END   ? _G|mehr
.continue ZEILE ? _M|nkalkinklvkalk & F|equals(0|ksart, "(FromThePreliminaryCosting)")
..
.make screen line +O
.assign M|basisartikel = 0|elem^basisartikel
.formula M|elem       = 0|elem^id
.formula M|namebspr   = M|elem^namebspr ? F|defined(M|elem^namebspr)
.formula M|namebspr   = M|elem^name     ? F|empty(M|namebspr)
.formula M|ekart      = 0|ekart         ? _F|empty(0|ekart)
.formula M|anzahl     = 0|menge
.formula M|ele        = 0|ele
.formula M|egeinzk    = 0|egeinzk
.formula M|eggemeink  = 0|eggemeink
.formula M|eggesamk   = 0|eggesamk
.formula M|evzeit     = 0|evzeit
.formula M|evgzeit    = 0|evgzeit
.formula M|ngw        = 0|egewicht * 0|anzahl
.formula M|egmk       = 0|egmks
.assign M|kblattid    = 0|ekblatt
.copy M|efehler       = 0|efehler
.continue ZEILE
..
!END
.continue
