.set trans -
.continue END     ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "bfvsel"    
.continue BSTART  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue END
..
!BSTART
.continue FEHLER1 ? F|empty(M|kart) & F|empty(M|kba)
.continue FEHLER2 ? F|empty(M|nkblatt) ; F|empty(M|vkblatt)
.continue END
..
!FEHLER1
.error Bitte einen Artikel oder einen Betriebsauftrag auswÑhlen.
.end 1
..
!FEHLER2
.error Keine passenden Daten gefunden
.formula M|kart = ""
.formula M|kartname = ""
.end 1
..
!END
.continue
