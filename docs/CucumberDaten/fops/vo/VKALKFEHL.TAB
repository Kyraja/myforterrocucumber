..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VKALKFEHL.TAB
.. Datum/Date     : 14.10.08
.. Version        : 2009r2
.. Autor/Author   : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
..
.. Program flow   :
...Includes       :
..
..*****************************************************************************
.set trans -
.type text xtfehltext  ? _F|defined(U|xtfehltext)
.type integer  xiebene     ? _F|defined(U|xiebene)
.type text xtekblatt   ? _F|defined(U|xtekblatt)
.type bool xbnochmal   ? _F|defined(U|xbnochmal)
..
.continue STRUKTUR      ? M|bstruktur
..
.make screen line +O
.assign M|tart      = H|art
.formula M|iconfehlerz = ""                ? _H|fehler
.formula M|iconfehlerz = "icon:attention"  ?  H|fehler
.formula M|ttename     = H|tename
.assign M|tstand    = H|stand
.formula M|tzeich      = H|zeich
.formula M|tvnr        = H|vnr
.formula M|ttext       = H|text
.formula M|tfehltext   = H|fehltext
.assign M|ttyp      = H|typ
.assign M|tkblatt   = H|id
.formula M|tebene      = "0"
.continue
..
!STRUKTUR
.continue NOFEHL ?  F|empty(M|kart)
.continue NOFEHL ? _H|fehler
..
.make screen line +O
.copy M|taufgeloest = G|TRUE
.formula M|ttename     = "---------------------------"
.formula M|iconfehlerz = ""
..
!NOFEHL
.make screen line +O
.formula M|tebene      = "0"
.assign M|tart      = H|art
.formula M|iconfehlerz = ""                ? _H|fehler
.formula M|iconfehlerz = "icon:attention"  ?  H|fehler
.formula M|ttename     = H|tename
.assign M|tstand    = H|stand
.formula M|tzeich      = H|zeich
.formula M|tvnr        = H|vnr
.formula M|ttext       = H|text
.formula M|tfehltext   = H|fehltext
.assign M|ttyp      = H|typ
.assign M|tkblatt   = H|id
..
..jetzt Struktur aufl”sen, wenn Fehler
.copy M|taufgeloest = G|FALSE     ? _H|fehler & _H|stlfehler
.formula  M|iconfehlerz = ""         ? _H|fehler & _H|stlfehler
.continue                             ? _H|fehler & _H|stlfehler
..
!LOOP
.formula U|xtekblatt = ""
.copy U|xbnochmal = G|FALSE
.select screen header
..
!HMZ
.select screen line
.continue HMZE  ? _G|mehr
.continue HMZ   ? M|taufgeloest
..
.copy M|taufgeloest = G|TRUE
.formula U|xiebene     = 'M|tebene'
.formula U|xiebene     = U|xiebene + 1
.copy U|xbnochmal = G|TRUE 
.load 0 add M|tkblatt
..
!L0Z
.load 0 line
.continue L0ZE  ? _G|mehr
.continue L0Z   ? _0|efehler
.continue L0Z   ?  F|empty(0|ekblatt)
.continue L0Z   ?  U|xtekblatt = 0|ekblatt^id
..
.formula U|xtekblatt = 0|ekblatt^id
..
.make screen line +O
.formula M|tebene      = 'U|xiebene'
.load 1 add 0|ekblatt
.assign M|tart      = 1|art
.formula M|iconfehlerz = "icon:attention"
.formula M|ttename     = 1|tename
.assign M|tstand    = 1|stand
.formula M|tzeich      = 1|zeich
.formula M|tvnr        = 1|vnr
.formula M|ttext       = 1|text
.formula M|tfehltext   = 1|fehltext
.assign M|ttyp      = 1|typ
.assign M|tkblatt   = 1|id
.load 1
.continue L0Z
..
!L0ZE
.continue HMZ
..
!HMZE
.continue LOOP ? U|xbnochmal
.load 0
.continue
