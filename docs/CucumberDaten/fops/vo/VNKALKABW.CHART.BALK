..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.CHART.BALK
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : zeigt Daten in einem Balken-Diagramm an.
..*****************************************************************************
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -TITLECHART "Differenz Nachkalkulation - Vorkalkulation"
.chart -PARAM -TITLEY "Kosten in EUR"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel;Herstellungskosten"
.chart -PARAM -DECIMALSY 2
.chart -PARAM -CLUSTERED
.chart -PARAM -3D "NO"
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NOCOLOR
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOZOOM
.chart -PARAM -TOOLBAR NOTOOLS
.chart -PARAM -CONTEXTMENU NONE
.chart -STARTVALUES Differenz
.chart -VALUE 'M|kamatk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|kafremdk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|kafixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|kavarfk' -RGBCOLOR 'M|farbe3'
.chart -VALUE 'M|kahk' -RGBCOLOR 'M|farbe2'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
