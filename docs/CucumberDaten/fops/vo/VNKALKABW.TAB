..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.TAB
.. Autor          : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..nur Fertigungsvorschl„ge
..only work order suggestions
.continue ? H|herkunft^gruppe<>5
..
.type text xtselect ? _F|defined(U|xtselect)
.type bool xbmehr   ? _F|defined(U|xbmehr)
.type ARTR51000 xrbasis ? _F|defined(U|xrbasis)
.formula U|xrbasis   = 1.00
..
.. Nachkalkulationsblatt - final costing sheet
.make screen line +O
.assign M|tart    = H|art^id
.formula M|tnamebspr = M|tart^namebspr
.formula M|tstand    = H|stand
.formula M|tkbasis   = H|basis
.formula U|xrbasis   = H|basis    ? H|basis <> 0
.formula M|tle       = H|art^le
.formula M|tfehler   = H|fehler
.formula M|tzeich    = H|zeich
.formula M|twaehr    = H|waehr
.formula M|tmatek    = H|matek * U|xrbasis
.formula M|tmatek    = H|matekovk * U|xrbasis    ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tfremdek  = H|fremdek * U|xrbasis
.formula M|tfremdek  = H|fremdekovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tfixfek   = H|fixfek * U|xrbasis
.formula M|tfixfek   = H|fixfekovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tvarfek   = H|varfek * U|xrbasis
.formula M|tvarfek   = H|varfekovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|thek      = H|hek * U|xrbasis
.formula M|thek      = H|hekovk * U|xrbasis      ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tmatgk    = H|matgk * U|xrbasis
.formula M|tmatgk    = H|matgkovk * U|xrbasis    ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tfremdgk  = H|fremdgk * U|xrbasis
.formula M|tfremdgk  = H|fremdgkovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tfixfgk   = H|fixfgk * U|xrbasis
.formula M|tfixfgk   = H|fixfgkovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tvarfgk   = H|varfgk * U|xrbasis
.formula M|tvarfgk   = H|varfgkovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|thgk      = H|hgk * U|xrbasis
.formula M|thgk      = H|hgkovk * U|xrbasis      ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tmatk     = H|matk * U|xrbasis
.formula M|tmatk     = H|matkovk * U|xrbasis     ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tfremdk   = H|fremdk * U|xrbasis
.formula M|tfremdk   = H|fremdkovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tfixfk    = H|fixfk * U|xrbasis
.formula M|tfixfk    = H|fixfkovk * U|xrbasis    ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tvarfk    = H|varfk * U|xrbasis
.formula M|tvarfk    = H|varfkovk * U|xrbasis    ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|thk       = H|hk * U|xrbasis
.formula M|thk       = H|hkovk * U|xrbasis       ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.formula M|tkblatt   = H|id
.select add H|herkunft
.formula M|therkunft = H|id
.formula M|tbasis    = H|mge
.formula M|tba       = H|num4
.formula M|tabgelegt = H|ablagef
.assign M|tba2    = H|ba     ? _M|tabgelegt
.select add
.. Vorkalkulationsblatt - preliminary costing sheet
.formula U|xtselect = "$,,herkunft==" + M|therkunft^id
.formula U|xtselect = U|xtselect + ";typ==" + "(PreliminaryCostingOfSalesOrder)"
.load 0 costsheet 'U|xtselect'
.formula U|xbmehr   = _G|mehr
.copy U|xbnovkalk = G|TRUE  ? U|xbmehr
.continue ? U|xbmehr
.. Summen bilden Nachkalkulationsblatt - generating totals final costing sheet
.formula U|xrknmatek     = U|xrknmatek + M|tmatek
.formula U|xrknfremdek   = U|xrknfremdek + M|tfremdek
.formula U|xrknfixfek    = U|xrknfixfek + M|tfixfek
.formula U|xrknvarfek    = U|xrknvarfek + M|tvarfek
.formula U|xrknhek       = U|xrknhek + M|thek
.formula U|xrknmatgk     = U|xrknmatgk + M|tmatgk
.formula U|xrknfremdgk   = U|xrknfremdgk + M|tfremdgk
.formula U|xrknfixfgk    = U|xrknfixfgk + M|tfixfgk
.formula U|xrknvarfgk    = U|xrknvarfgk + M|tvarfgk
.formula U|xrknhgk       = U|xrknhgk + M|thgk
.formula U|xrknmatk      = U|xrknmatk + M|tmatk
.formula U|xrknfremdk    = U|xrknfremdk + M|tfremdk
.formula U|xrknfixfk     = U|xrknfixfk + M|tfixfk
.formula U|xrknvarfk     = U|xrknvarfk + M|tvarfk
.formula U|xrknhk        = U|xrknhk + M|thk
..
.formula M|tvstand   = 0|stand
.formula M|tvfehler  = 0|fehler
.formula M|tvzeich   = 0|zeich
.formula M|tvwaehr   = 0|waehr
.formula M|tvmatek   = 0|matek * U|xrbasis
.formula M|tvmatek   = 0|matekovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvfremdek = 0|fremdek * U|xrbasis
.formula M|tvfremdek = 0|fremdekovk * U|xrbasis ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvfixfek  = 0|fixfek * U|xrbasis
.formula M|tvfixfek  = 0|fixfekovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvvarfek  = 0|varfek * U|xrbasis
.formula M|tvvarfek  = 0|varfekovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvhek     = 0|hek * U|xrbasis
.formula M|tvhek     = 0|hekovk * U|xrbasis     ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvmatgk   = 0|matgk * U|xrbasis
.formula M|tvmatgk   = 0|matgkovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvfremdgk = 0|fremdgk * U|xrbasis
.formula M|tvfremdgk = 0|fremdgkovk * U|xrbasis ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvfixfgk  = 0|fixfgk * U|xrbasis
.formula M|tvfixfgk  = 0|fixfgkovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvvarfgk  = 0|varfgk * U|xrbasis
.formula M|tvvarfgk  = 0|varfgkovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvhgk     = 0|hgk * U|xrbasis
.formula M|tvhgk     = 0|hgkovk * U|xrbasis     ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvmatk    = 0|matk * U|xrbasis
.formula M|tvmatk    = 0|matkovk * U|xrbasis    ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvfremdk  = 0|fremdk * U|xrbasis
.formula M|tvfremdk  = 0|fremdkovk * U|xrbasis  ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvfixfk   = 0|fixfk * U|xrbasis
.formula M|tvfixfk   = 0|fixfkovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvvarfk   = 0|varfk * U|xrbasis
.formula M|tvvarfk   = 0|varfkovk * U|xrbasis   ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvhk      = 0|hk * U|xrbasis
.formula M|tvhk      = 0|hkovk * U|xrbasis      ? _M|nkalkinklvkalk & F|equals(0|typ, "(FinalCosting)")
.formula M|tvkblatt  = 0|id
..
..Summen bilden Vorkalkulationsblatt - generating totals preliminary costing sheet
.formula U|xrkvmatek     = U|xrkvmatek + M|tvmatek
.formula U|xrkvfremdek   = U|xrkvfremdek + M|tvfremdek
.formula U|xrkvfixfek    = U|xrkvfixfek + M|tvfixfek
.formula U|xrkvvarfek    = U|xrkvvarfek + M|tvvarfek
.formula U|xrkvhek       = U|xrkvhek + M|tvhek
.formula U|xrkvmatgk     = U|xrkvmatgk + M|tvmatgk
.formula U|xrkvfremdgk   = U|xrkvfremdgk + M|tvfremdgk
.formula U|xrkvfixfgk    = U|xrkvfixfgk + M|tvfixfgk
.formula U|xrkvvarfgk    = U|xrkvvarfgk + M|tvvarfgk
.formula U|xrkvhgk       = U|xrkvhgk + M|tvhgk
.formula U|xrkvmatk      = U|xrkvmatk + M|tvmatk
.formula U|xrkvfremdk    = U|xrkvfremdk + M|tvfremdk
.formula U|xrkvfixfk     = U|xrkvfixfk + M|tvfixfk
.formula U|xrkvvarfk     = U|xrkvvarfk + M|tvvarfk
.formula U|xrkvhk        = U|xrkvhk + M|tvhk
.continue
