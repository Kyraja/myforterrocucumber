..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.FA
.. Autor          : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
.. Includes       :
..  include vo/VNKALKABW.RESETHEADER
..*****************************************************************************
.set trans -
.continue KART  ? G|evtvar = "kart"
.continue RANGE ? G|evtvar = "bevon" ; G|evtvar = "bebis" ; G|evtvar = "adatum" ; G|evtvar = "edatum" ; G|evtvar = "knurabgelegt"
..
!KART
.add M|kart
.continue LEER          ? _G|mehr
..
.. Tabelle leeren
.make screen line -- ? M|tzeilen > 0
.input "vo/VNKALKABW.RESETHEADER"
..
.copy M|bselektion = G|FALSE
.formula M|bevon      = ""
.formula M|bebis      = ""
.protection bevon 0
.protection bebis 0
.continue
..
!LEER: Tabelle leeren / Kopffelder leeren / Schutz aufheben
.make screen line -- ? M|tzeilen > 0
.input "vo/VNKALKABW.RESETHEADER"
.copy M|bselektion = G|FALSE
.protection -reset bevon 0
.protection -reset bebis 0
.continue
..
!RANGE:
.. Tabelle leeren
.make screen line -- ? M|tzeilen > 0
.copy M|bselektion = G|FALSE
.input "vo/VNKALKABW.RESETHEADER"
.continue
