..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.CHART.PIE2
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem VNKALKABW, Diagramm-Anzeige
..*****************************************************************************
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE PIE
.chart -PARAM -DECIMALSY 2
.chart -PARAM -TITLECHART "Vergleich Einzelkosten"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel"
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOTOOLS
.chart -STARTVALUES Nachkalkulation
.chart -VALUE 'M|knmatek' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|knfremdek' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|knfixfek' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|knvarfek' -RGBCOLOR 'M|farbe3'
.chart -STARTVALUES Vorkalkulation
.chart -VALUE 'M|kvmatek' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|kvfremdek' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|kvfixfek' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|kvvarfek' -RGBCOLOR 'M|farbe3'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
