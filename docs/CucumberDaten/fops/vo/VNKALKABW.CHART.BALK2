..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.CHART.BALK2
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : zeigt Daten in einem Balken-Diagramm an.
..*****************************************************************************
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -TITLECHART "Prozentuale Abweichung (Basis Vorkalkulation)"
.chart -PARAM -TITLEY "%"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel;Herstellungskosten"
.chart -PARAM -DECIMALSY 2
.chart -PARAM -CLUSTERED
.chart -PARAM -3D "NO"
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NOCOLOR
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOZOOM
.chart -PARAM -TOOLBAR NOTOOLS
.chart -PARAM -CONTEXTMENU NONE
.chart -STARTVALUES
.chart -VALUE 'M|kpmatk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|kpfremdk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|kpfixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|kpvarfk' -RGBCOLOR 'M|farbe3'
.chart -VALUE 'M|kphk' -RGBCOLOR 'M|farbe2'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
