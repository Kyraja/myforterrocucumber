..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VKALKART.BV.BSTART
.. Datum          : 28.10.2008
.. Autor          : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
.set trans -
..
.type date xdleer     ? _F|defined(U|xdleer)
..
.select screen header
..
.. Diagramm leeren
.chart -INIT
.chart -SHOW chart 0
..
.. Tabelle leeren
.make screen line -- ? M|tzeilen > 0
.continue ERROR1        ? M|kart=""
..
.. test validation of date area
.continue ERROR2        ? M|adatum > M|edatum & M|edatum <> U|xdleer & M|adatum <> U|xdleer
..
.. Genearating selection string
.formula M|select = "$,,art=" + 'M|kart^id' + ";@gruppe=1;@ablageart=(3)"
.formula M|select = M|select + ";stand=" + 'M|adatum:8' + "!" + 'M|edatum:8'
.formula M|select = M|select + ";herkunft=" + 'M|kart^id' + ";@ordnung=stand"
.continue
..
!ERROR1:
.error -field M|kart -message Bitte Artikel eingeben.
.end 1

!ERROR2:
.error -field M|adatum -message Zeitraum ist ungltig. Bitte „ndern.
.end 1
