..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALKBAUM.BN.STUFE
.. Datum          : 27.07.2007
.. Version        : 2007r4
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Oeffnet ein Kalkulationsblatt.
.. Functionality  : Opens a costing sheet.
.. Ablauf         : Unterprogramm
.. Program flow   : Subroutine
..*****************************************************************************
.set trans -
..
.. Declarations
.type VP1     xelem    ? _F|defined(U|xelem)
.type ID57:1  xid      ? _F|defined(U|xid)
.type integer xelemnr  ? _F|defined(U|xelemnr)
.type bool    xbfehler ? _F|defined(U|xbfehler)
.type R7.4    xhek     ? _F|defined(U|xhek)
.type R7.4    xhgk     ? _F|defined(U|xhgk)
.type R7.4    xhk      ? _F|defined(U|xhk)
.type M4.4    xmenge   ? _F|defined(U|xmenge)
.type TAZ1    xanzeinh ? _F|defined(U|xanzeinh)
..
.. Initializations
.assign U|xelem    = ""
.assign U|xid      = ""
.formula U|xelemnr = 0
.copy U|xbfehler   = G|FALSE
.assign M|stufe    = M|tbaumstufe + 1
..
.load 8 add M|kblattid
.continue END ? _G|mehr
..
!NEXTROW: Load matching costing sheet
.load 8 line
.continue END     ? _G|mehr
.copy U|xbfehler = 8|efehler
.continue NEXTROW ? 8|elart <> 1 & 8|elart <> 4
.continue NEXTROW ? F|empty(8|ekblatt^id)
.continue NEXTROW ? U|xelem = 8|elem^id
..
!MATCHING: We have a matching sheet
.assign U|xelem    = 8|elem
.assign U|xhek     = 8|egeinzk
.assign U|xhgk     = 8|eggemeink
.assign U|xhk      = 8|eggesamk
.assign U|xmenge   = 8|menge
.assign U|xanzeinh = 8|anzeinh
..
.select object '8|ekblatt^id'
.continue END ? _G|mehr
.continue NEXTROW ? U|xid = H|id & U|xelemnr = 8|elemnr
.assign U|xid = H|id
.assign U|xelemnr  = 8|elemnr
.input 'M|tab' ? _F|empty(M|tab)
.continue NEXTROW
..*****************************************************************************
!END
.continue
