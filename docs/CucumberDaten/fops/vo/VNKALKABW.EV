..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.EV
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Eventbehandlung / Kopfteil
..
...Includes
.. include vo/VNKALKABW.RESETHEADER
..*****************************************************************************
.set trans -
..
.. Clear table
.make screen line -- ? M|tzeilen > 0
.input "vo/VNKALKABW.RESETHEADER"
..
.continue BSEL ? G|evtartengl="BUTTON_AFTER"   & G|evtvar="bselect"
.continue END
..
!BSEL
.formula M|select     = ""
.formula M|kart       = ""
.formula M|kartname   = ""
.formula M|bevon      = ""
.formula M|bebis      = ""
.formula G|evtfeldneu = "%"
.protection -reset bevon 0
.protection -reset bebis 0
..
.formula M|grliste = "2:1"
.input "is/AUSWAHL"
.formula M|bselektion = M|select <> "!"
..*****************************************************************************
!END
.continue
