..*****************************************************************************
.set trans -
.continue KART     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kart"
.continue KBA      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kba"
.continue KAUF     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kauftrag"
.continue KBEST    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbestellung"
.continue KBLATT   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kblatt"
.continue ENDLG
..
!KART
.select add M|kart
.continue ENDLG               ? _G|mehr
.formula M|kba         = ""
.formula M|kbaart      = ""
.formula M|kauftrag    = ""
.formula M|kaufart     = ""
.formula M|kbestellung = ""
.formula M|kbestart    = ""
.formula M|kblatt      = ""
.formula M|vgzeit      = 0
.formula M|vzeit       = 0
.continue ENDLG
..
!KBA
.continue ERROR  ? _F|empty(M|kba) & _(M|kba / "(0-9)*")
.formula M|kbaart      = ""
.formula M|kart        = ""
.formula M|kauftrag    = ""
.formula M|kaufart     = ""
.formula M|kbestellung = ""
.formula M|kbestart    = ""
.formula M|kblatt      = ""
.continue ENDLG
..
!KAUF
.select add M|kauftrag
.continue ENDLG         ? _G|mehr
.formula M|kart        = ""
.formula M|kba         = ""
.formula M|kbaart      = ""
.formula M|kbestellung = ""
.formula M|kbestart    = ""
.formula M|kblatt      = ""
.continue ENDLG
..
!KBEST
.select add M|kbestellung
.continue ENDLG         ? _G|mehr
.formula M|kart        = ""
.formula M|kba         = ""
.formula M|kbaart      = ""
.formula M|kauftrag    = ""
.formula M|kaufart     = ""
.formula M|kblatt      = ""
.continue ENDLG
..
!KBLATT
.formula M|kart        = ""
.formula M|kba         = ""
.formula M|kbaart      = ""
.formula M|kauftrag    = ""
.formula M|kaufart     = ""
.formula M|kbestellung = ""
.formula M|kbestart    = ""
.continue ENDLG
..
