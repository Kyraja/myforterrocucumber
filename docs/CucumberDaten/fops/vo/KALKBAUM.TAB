..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : KALKBAUM.TAB
.. Datum          : 27.7.2007
.. Version        : 2007r4
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Erzeugt je Kalkulationsblatt eine Zeile in der Tabelle.
.. Functionality  : Creates for each costing sheet a row in the table.
..
.. Ablauf         : Tabellen-EFOP
.. Program flow   : Table efop
..*****************************************************************************
.type text xsel  ? _F|defined(U|xsel)
.set trans -
..
.make screen line +O
.assign M|tbaumstufe = M|stufe
.assign M|tbaumstat = ""
.continue EMPTY ? _F|defined(H|id)
..
.. costing sheet
.assign M|elem      = H|art^id
.assign M|elemname  = H|art^namebspr
.assign M|kblattid  = H|id
.assign M|tmat      = H|art^bsart
.assign M|lgruppe   = H|lgruppe
.formula U|xsel ="$,,art=" + H|art^id + ";lgruppe=" + H|lgruppe^id +  ";@gruppe=3;@ablageart=(Active)"
.load 2 warehousedata 'U|xsel'
.continue NOEXLGR ? _G|mehr
.assign M|tmat      = 2|bsart
.assign M|lgruppe   = 2|lgruppe^id
..
!NOEXLGR
.set trans +
.assign M|tmat       = "Umlagern"   ? _G|mehr & H|lgruppe^id <> F|sysinfo(10)^intlgruppe^id & _F|empty(H|lgruppe)
.set trans -
.assign M|tkbpr      = H|kbpr       ? _F|equals(H|art^bsart, "(InhouseProduction)")
.copy M|tfehler      = 8|efehler    ? F|defined(8|efehler)
.assign M|matek      = H|matek
.formula M|matek     = H|matekovk   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|matgk      = H|matgk
.formula M|matgk     = H|matgkovk   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|matk       = H|matk
.formula M|matk      = H|matkovk    ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fremdek    = H|fremdek
.formula M|fremdek   = H|fremdekovk ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fremdgk    = ""
.assign M|fremdk     = H|fremdk
.formula M|fremdk    = H|fremdkovk  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fertfixek  = H|fixfek
.formula M|fertfixek = H|fixfekovk  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fertfixgk  = H|fixfgk
.formula M|fertfixgk = H|fixfgkovk  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fertfixk   = H|fixfk
.formula M|fertfixk  = H|fixfkovk   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fertvarek  = H|varfek
.formula M|fertvarek = H|varfekovk  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fertvargk  = H|varfgk
.formula M|fertvargk = H|varfgkovk  ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|fertvark   = H|varfk
.formula M|fertvark  = H|varfkovk   ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|gesamtek   = H|hek
.formula M|gesamtek  = H|hekovk     ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|gesamtgk   = H|hgk
.formula M|gesamtgk  = H|hgkovk     ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|gesamtk    = H|hk
.formula M|gesamtk   = H|hkovk      ? _M|nkalkinklvkalk & F|equals(H|typ, "(FinalCosting)")
.assign M|menge      = U|xmenge     ? F|defined(U|xmenge)
.assign M|tle        = U|xanzeinh   ? F|defined(U|xanzeinh)
.assign M|hek        = U|xhek       ? F|defined(U|xhek)
.assign M|hgk        = U|xhgk       ? F|defined(U|xhgk)
.assign M|hk         = U|xhk        ? F|defined(U|xhk)
..
!SHEET: load sheet
.select add M|kblattid    ? F|empty(M|kblatt)
.continue END              ? _G|mehr
..
!SHEETROW
.select line
.continue END              ? _G|mehr
.continue SHEETROW         ? H|elart <> 1 & H|elart <> 4
.continue SHEETROW         ? F|empty(H|ekblatt)
.formula M|tbaumstat = "+"
.continue END
..
!EMPTY: Identify product of position without costing sheet
.assign M|elem = 0|artex^id
.assign M|elemname = 0|artex^namebspr
..
..*****************************************************************************
!END
.continue
