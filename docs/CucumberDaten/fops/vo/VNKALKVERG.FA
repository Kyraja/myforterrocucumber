..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : VNKALKVERG.FA
..  Datum          : 03.12.2006
..  Version        : 2007
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Feldaustrittsfop VNKALKVERG
..  Functionality  : Exit field FOP
..
..  include is/HOL.VNKALKVERG
..*****************************************************************************
.type text xsel ? _F|defined(U|xsel)
.type bool xnotmehr   ? _F|defined(U|xnotmehr)
..
.set trans -
.copy U|xnotmehr = G|FALSE
.continue ENDLG    ? F|empty(M|kart) & F|empty(M|kba)
.continue KART     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kart"
.continue KBA      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kba"
.continue ENDLG
..
!KART
.protection -reset kart
.select add M|kart
.formula M|kba      = ""
.formula M|kmge     = ""
.formula M|artle    = ""
.copy M|abgelegt = G|FALSE
.continue ENDLG
..
!KBA
.protection -reset kart
.formula M|kart     = ""
.continue ERROR4 ? _F|empty(M|kba) & _(M|kba / "(0-9)*")
.. prÅfen, ob BA eine Dienstleistung enthÑlt.
.continue FEHLER3    ? M|kba / "+*"
.load 1 workorder 'M|kba'
.continue ABLAGE     ? _G|mehr
.continue FEHLER2    ? 1|art^gruppe = 5
.continue ENDLG
..
!ABLAGE: abgelegter BA
.formula M|kart = "" ? _F|empty(M|kart)
.formula U|xsel = "$,,num4="+'M|kba'+";@gruppe=5;@ablageart=(Filed)"
.load 6 purchasing 'U|xsel'
.continue FEHLER1    ? _G|mehr
.continue DIENST     ? U|xnotmehr
.load 6 purchasing
.. only one hit, no dynamic selection
.copy U|xnotmehr = G|TRUE ? _G|mehr
.continue ABLAGE          ? _G|mehr
..
.formula U|xsel = "%,,num4="+'M|kba'+";artikel=;@gruppe=5;@ablageart=(Filed);@autostart=ja"
.load 6 purchasing 'U|xsel'
.continue FEHLER1    ? _G|mehr
..
!DIENST
.continue FEHLER2    ? 6|art^gruppe = 5
.copy U|xnotmehr = G|FALSE
.formula M|kart = 6|artikel^id
.continue ENDLG
..
!ENDLG:
.input "is/TABLEEREN"
.formula M|fehler       = ""
.formula M|nkblatt      = ""
.formula M|kmatek       = ""
.formula M|kmatgk       = ""
.formula M|kmatk        = ""
.formula M|kfremdek     = ""
.formula M|kfremdk      = ""
.formula M|kfixfek      = ""
.formula M|kfixfgk      = ""
.formula M|kfixfk       = ""
.formula M|kvarfek      = ""
.formula M|kvarfgk      = ""
.formula M|kvarfk       = ""
.formula M|khek         = ""
.formula M|khgk         = ""
.formula M|khk          = ""
.formula M|basis        = ""
.formula M|brgewicht    = ""
.formula M|kbfrist      = ""
.formula M|lagereinheit = ""
.formula M|deckbei1     = ""
.formula M|deckbei2     = ""
.formula M|vkblatt      = ""
.formula M|vkmatek      = ""
.formula M|vkmatgk      = ""
.formula M|vkmatk       = ""
.formula M|vkfremdek    = ""
.formula M|vkfremdk     = ""
.formula M|vkfixfek     = ""
.formula M|vkfixfgk     = ""
.formula M|vkfixfk      = ""
.formula M|vkvarfek     = ""
.formula M|vkvarfgk     = ""
.formula M|vkvarfk      = ""
.formula M|vkhek        = ""
.formula M|vkhgk        = ""
.formula M|vkhk         = ""
.formula M|vbasis       = ""
.formula M|vbrgewicht   = ""
.formula M|vkbfrist     = ""
.formula M|vlagereinhei = ""
.assign M|ittyp1     = ""
.assign M|ittyp2     = ""
.assign M|herkunft   = ""
.formula M|vdeckbei1    = ""
.formula M|vdeckbei2    = ""
.formula M|kmge         = ""
.formula M|artle        = ""
.formula M|dkmatek      = ""
.formula M|dkmatgk      = ""
.formula M|dkmatk       = ""
.formula M|dkfremdek    = ""
.formula M|dkfremdk     = ""
.formula M|dkfixfek     = ""
.formula M|dkfixfgk     = ""
.formula M|dkfixfk      = ""
.formula M|dkvarfek     = ""
.formula M|dkvarfgk     = ""
.formula M|dkvarfk      = ""
.formula M|dkhek        = ""
.formula M|dkhgk        = ""
.formula M|dkhk         = ""
.formula M|ddeckbei1    = ""
.formula M|ddeckbei2    = ""
..
.. Diagramme leeren
.chart -INIT
.chart -SHOW chart1 0
..
.continue                ? F|empty(M|kart) & F|empty(M|kba)
.input "is/HOL.VNKALKVERG"
.continue
..
!FEHLER1
.error Kein Betriebsauftrag vorhanden.
.formula M|kba = ""
.end 1
..
!FEHLER2
.error Kein Kalkulationsvergleich fÅr Dienstleistungen mîglich!
.end 1
..
!FEHLER3
.error Falsche Eingabe.
.end 1
..
!ERROR4
.error -field M|kba -message UnzulÑssige Angabe fÅr einen Betriebsauftrag.
.formula M|kba = ""
.end 1

