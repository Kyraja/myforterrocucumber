..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : VKALKART.CHART.LINE1C
..  Datum          : 28.10.2008
..  Version        : 2008
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : zeigt fixe Fertigungskosten in einem Linien-Diagramm an
..
..  Includes       :
..*****************************************************************************
.set trans -
... nur in GUI m”glich
.end 0 ? _G|grafik & _F|isFlagSet(82)
..
.. Declarations
.type text xtcolor       ? _F|defined(U|xtcolor)
.type text xtitel        ? _F|defined(U|xtitel)
.type text xtitely       ? _F|defined(U|xtitely)
.type text xttip         ? _F|defined(U|xttip)
.type text xeinzel       ? _F|defined(U|xeinzel)
.type text xgemein       ? _F|defined(U|xgemein)
.type text xgesamt       ? _F|defined(U|xgesamt)
.type R7.4 xmax          ? _F|defined(U|xmax)
.type R7.4 xvergl        ? _F|defined(U|xvergl)
.type integer  xstepx        ? _F|defined(U|xstepx)
..
.formula U|xmax     = 10
..
.set trans +
.formula U|xtitel        = F|formatstr("Fixe Fertigungskosten des Artikels {1}", M|kart^namebspr)
.formula U|xtitely       = F|formatstr("Kosten der Vorkalkulation in {1}", G|inland)
.formula U|xttip         = "Kalkulation am {1};{2}: {3}"
.formula U|xeinzel       = "Einzelkosten"
.formula U|xgemein       = "Gemeinkosten"
.formula U|xgesamt       = "Gesamtkosten"
.set trans -
..
!CHART: Initialize chart
.chart -INIT
.chart -PARAM -CHARTTYPE LINES
.chart -PARAM -TITLECHART 'U|xtitel'
.chart -PARAM -RGBBACKCOLOR 253 253 253
.chart -PARAM -TITLEX "Zeile"
.chart -PARAM -TITLEY 'U|xtitely'
..
!EINZELKOSTEN
.formula U|xtcolor = "  0 127 255"
.chart -STARTVALUES 'U|xeinzel' -ID 'U|xeinzel' -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE1: Einzelkosten
.select screen line
.continue GEMEINKOSTEN ? _G|mehr
.chart -PARAM -MARKERX 'M|aktzeile'
.chart -VALUE 'M|tfixfek' -TIP 'F|formatstr(U|xttip, M|tstand, U|xeinzel, M|tfixfek)'
.continue ZEILE1
..
!GEMEINKOSTEN
.formula U|xtcolor = "  0  10 100"
.chart -STARTVALUES 'U|xgemein' -ID 'U|xgemein' -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE2: Gemeinkosten
.select screen line
.continue GESAMTKOSTEN ? _G|mehr
.chart -PARAM -MARKERX 'M|aktzeile'
.chart -VALUE 'M|tfixfgk' -TIP 'F|formatstr(U|xttip, M|tstand, U|xgemein, M|tfixfgk)'
.continue ZEILE2
..
!GESAMTKOSTEN
.formula U|xtcolor = "  0   0 192"
.chart -STARTVALUES 'U|xgesamt' -ID 'U|xgesamt' -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE3: Gesamtkosten
.select screen line
.continue ENDE ? _G|mehr
.chart -PARAM -MARKERX 'M|aktzeile'
.chart -VALUE 'M|tfixfk' -TIP 'F|formatstr(U|xttip, M|tstand, U|xgesamt, M|tfixfk)'
..
.formula U|xvergl = M|tfixfk
.formula U|xmax   = M|tfixfk    ? U|xmax < U|xvergl
.continue ZEILE3
..
!ENDE
.formula U|xstepx = 5  ? M|tzeilen > 50
.formula U|xstepx = 10 ? M|tzeilen > 100
.chart -PARAM -MINMAXY 0 'U|xmax'
.chart -PARAM -STEPX 'U|xstepx'
.chart -PARAM -DECIMALSY 4
.chart -SHOW chart 0
.continue
