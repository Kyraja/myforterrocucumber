..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : VNKALKVERG.TAB
..  Datum          : 03.12.2006
..  Version        : 2007
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Infosystem, VNKALKVERG, Tabellenzeigfop
..  Functionality  : Infosystem, VNKALKVERG, Table-View-FOP
..
..  Ablauf         :
..
..*****************************************************************************
.set trans -
.type text xele     ? _F|defined(U|xele)
.type DVM2 xtfile   ? _F|defined(U|xtfile)
.type DVM2 xtfile2  ? _F|defined(U|xtfile2)
.type text xtsys    ? _F|defined(U|xtsys)
.type text xtsel    ? _F|defined(U|xtsel)
.type realx xevzeit ? _F|defined(U|xevzeit)
.type text xtresm
.type text xdnsn
.type integer xiz xiz2 xiekart xifehler
.type integer  xiag     ? _F|defined(U|xiag)
..
.input "is/TABLEEREN"
..
.file -tempname U|xtfile
.file -tempname U|xtfile2
.output new 'U|xtfile'
.input "DATEI.F"
.formula U|xtresm = ""
.formula U|xiz = 0
..
.load 0 costsheet 'M|nkblatt^id'
.load 7 costsheet 'M|vkblatt^id'
..
!NKALK: Zeile laden / load line
.load 0 line
.continue NKALKE                ? _G|mehr
.continue NKALK                 ? F|equals(0|ekart, "(SetupCosts)")
.. 0 = Artikel, 1 = Arbeitsgang aus der Fertigung, 2 = Arbeitsgang Vorkalkuliert
.copy U|xiag = 0
.copy U|xiag = 1          ? 0|elem^dnr = 7 & F|equals(0|ksart, "(FromProduction)")
.copy U|xiag = 2          ? 0|elem^dnr = 7 & F|equals(0|ksart, "(FromThePreliminaryCosting)")
.formula U|xiz = U|xiz + 1     ? U|xtresm <> 0|res^id
.formula U|xdnsn = (0|res^id >> "(") << ","
.type integer xiz.xdnsn            ? _F|defined(U|xiz.U|xdnsn)
.formula U|xiz.U|xdnsn = U|xiz
.formula U|xiz2      = U|xiz2 + 1  ? F|empty(0|res)
.formula U|xiekart   = 1       ? F|equals(0|ekart, "(CM)")
.formula U|xiekart   = 2       ? F|equals(0|ekart, "(ExternalServices)")
.formula U|xiekart   = 3       ? F|equals(0|ekart, "(Wage)")
.formula U|xiekart   = 4       ? F|equals(0|ekart, "(PCFix)")
.formula U|xiekart   = 5       ? F|equals(0|ekart, "(PCVar)")
.formula U|xiekart   = 6       ? F|equals(0|ekart, "(SCFix)")
.formula U|xiekart   = 7       ? F|equals(0|ekart, "(PPVar)")
.formula U|xiekart   = 8       ? F|equals(0|ekart, "(SpecialCosts)")
.formula U|xiekart   = 9       ? F|equals(0|ekart, "(Overheads)")
.formula U|xifehler  = 0
.formula U|xifehler  = 1       ? 0|efehler
.formula U|xevzeit   = 1
.formula U|xevzeit   = 0|evzeit / 0|basis ? 0|basis <> 0
?0#'0|zn'#'U|xiz.U|xdnsn'#'U|xiz2'#'0|res^id'#'U|xiekart'#'0|ksart(L="0")'#'U|xifehler'#'0|ekblatt^id'#'0|elem^id'#'0|ele'#'0|menge'#'0|egeinzk(L="0")'#'0|eggemeink(L="0")'#'0|eggesamk(L="0")'#'U|xevzeit'#0#0#0#0#0#(0,0,0)#'0|ekart'#0#0#0#0#'xiag'#  ? xiag = 0
?0#'0|zn'#'U|xiz.U|xdnsn'#'U|xiz2'#'0|res^id'#'U|xiekart'#'0|ksart(L="0")'#'U|xifehler'#'0|ekblatt^id'#'0|elem^id'#'0|ele'#0#'0|egeinzk(L="0")'#'0|eggemeink(L="0")'#'0|eggesamk(L="0")'#'U|xevzeit'#0#0#0#0#0#(0,0,0)#'0|ekart'#'0|anzahl'#0#0#0#'xiag'# ? xiag = 1
?0#'0|zn'#'U|xiz.U|xdnsn'#'U|xiz2'#'0|res^id'#'U|xiekart'#'0|ksart(L="0")'#'U|xifehler'#'0|ekblatt^id'#'0|elem^id'#'0|ele'#0#'0|egeinzk(L="0")'#'0|eggemeink(L="0")'#'0|eggesamk(L="0")'#'U|xevzeit'#0#0#0#0#0#(0,0,0)#'0|ekart'#0#'0|anzahl'#0#0#'xiag'# ? xiag = 2
.formula U|xtresm    = 0|res^id
.continue NKALK
..
!NKALKE: jetzt Vorkalkulation
.formula U|xtresm = ""
.formula U|xiz    = 0
.formula U|xdnsn  = ""
..
!VKALK: Zeile laden / load line
.load 7 line
.continue VKALKE                  ? _G|mehr
.continue VKALK                   ? F|equals(7|ekart, "(SetupCosts)")
.. 0 = Artikel, 1 = Arbeitsgang
.copy U|xiag = 0
.copy U|xiag = 1          ? 7|elem^dnr = 7
.formula U|xdnsn   =  ( 7|res^id >> "(" ) << ","
.formula U|xiz     = 0
.formula U|xiz     = U|xiz.U|xdnsn ? F|defined(U|xiz.U|xdnsn)
.formula U|xiz2    = U|xiz2 + 1  ? _F|defined(U|xiz.U|xdnsn)
.formula U|xiekart = 1           ? F|equals(7|ekart, "(CM)")
.formula U|xiekart = 2           ? F|equals(7|ekart, "(ExternalServices)")
.formula U|xiekart = 3           ? F|equals(7|ekart, "(Wage)")
.formula U|xiekart = 4           ? F|equals(7|ekart, "(PCFix)")
.formula U|xiekart = 5           ? F|equals(7|ekart, "(PCVar)")
.formula U|xiekart = 6           ? F|equals(7|ekart, "(SCFix)")
.formula U|xiekart = 7           ? F|equals(7|ekart, "(PPVar)")
.formula U|xiekart = 8           ? F|equals(7|ekart, "(SpecialCosts)")
.formula U|xiekart = 9           ? F|equals(7|ekart, "(Overheads)")
?7#'7|zn'#'U|xiz'#'U|xiz2'#'7|res^id'#'U|xiekart'#'7|ksart(L="0")'#0#(0,0,0)#'7|elem^id'#'7|ele'#0#0#0#0#0#'7|menge'#'7|egeinzk(L="0")'#'7|eggemeink(L="0")'#'7|eggesamk(L="0")'#'7|evzeit(L="0")'#'7|ekblatt^id'#'7|ekart'#0#0#0#0#'xiag'#  ? _F|defined(U|xiz.U|xdnsn)
?7#'7|zn'#'U|xiz'#0#'7|res^id'#'U|xiekart'#'7|ksart(L="0")'#0#(0,0,0)#'7|elem^id'#'7|ele'#0#0#0#0#0#'7|menge'#'7|egeinzk(L="0")'#'7|eggemeink(L="0")'#'7|eggesamk(L="0")'#'7|evzeit(L="0")'#'7|ekblatt^id'#'7|ekart'#0#0#0#0#'xiag'#         ?  F|defined(U|xiz.U|xdnsn)
.continue VKALK
..
!VKALKE: verdichten, sortieren, zusammenfhren
.output
.formula U|xtsys = "group_by.sh -n29 -k1 -k5 -k6 -k3 -k10 -k12 -k24 -k25 -k28 -k8 -o11 -s13.4 -s14.4 -s15.4 -s16.4 -o17 -s18.4 -s19.4 -s20.4 -s21.4 -k22 -o23 -o26 -o27  " + U|xtfile + " > " + U|xtfile2
.system 'U|xtsys' background
.continue ERROR ? _G|mehr
.formula U|xtsys = "sort -t# +3 -4 +2 -3 +5 -6 -o " + U|xtfile2 + " " + U|xtfile2
.system 'U|xtsys' background
.continue ERROR1 ? _G|mehr
.formula U|xtsys = "verdkalk.sh " + U|xtfile2 + " > " + U|xtfile2 + "a; mv " + U|xtfile2 + "a " + U|xtfile2
.system 'U|xtsys' background
.continue ERROR  ? _G|mehr
.load 0
.load 7
.type text xx
.type text xekart xelem xksart xefehler xnkblatt xvkblatt
.type ID4:4  xresid
.type M11.4  xnanzahl xnfertmge xnvormge
.type R11.4  xnegeinzk xneggemeink xneggesamk
.type M11.4  xnevzeit
.type M11.4  xvanzahl xvfertmge xvvormge
.type R11.4  xvegeinzk xveggemeink xveggesamk
.type M11.4  xvevzeit
..
!HV:
.select from 'U|xtfile2' U|xx # U|xx # U|xx # U|xx # U|xresid # U|xiekart # U|xksart # U|xifehler # U|xnkblatt # U|xelem # U|xele # U|xnanzahl # U|xnegeinzk # U|xneggemeink # U|xneggesamk # U|xnevzeit # U|xvanzahl # U|xvegeinzk # U|xveggemeink # U|xveggesamk # U|xvevzeit # U|xvkblatt # U|xekart # U|xnfertmge # xnvormge # xvfertmge # xvvormge # xiag #
.continue HVE                            ? _G|mehr
.make screen line +O
..
.colour -foreground -1 -1 -1  -background -1 -1 -1   elem       'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   ekart      'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   anzahl     'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   ele        'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   egeinzk    'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   eggemeink  'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   eggesamk   'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   evzeit     'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   efehler    'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   velem      'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   vekart     'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   vanzahl    'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   vele       'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   vegeinzk   'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   veggemeink 'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   veggesamk  'M|aktzeile'
.colour -foreground -1 -1 -1  -background -1 -1 -1   vevzeit    'M|aktzeile'
..
.formula M|elem      = U|xelem
.formula M|enamebspr = M|elem^name
.formula M|enamebspr = M|elem^namebspr     ? F|defined(M|elem^namebspr)
.formula M|ekart     = U|xekart            ? _F|empty(U|xekart)
.formula M|anzahl    = U|xnanzahl          ? U|xiag = 0
.formula M|anzahl    = U|xnfertmge         ? U|xiag <> 0 & U|xnfertmge <> 0
.formula M|anzahl    = U|xnvormge          ? U|xiag <> 0 & U|xnfertmge = 0
.formula M|ele       = U|xele              ? _F|empty(U|xele)
.formula M|egeinzk   = U|xnegeinzk
.formula M|eggemeink = U|xneggemeink
.formula M|eggesamk  = U|xneggesamk
.copy M|evzeit  = U|xnevzeit
.formula M|efehler   = 'U|xifehler'
.continue NOKBN                             ? F|empty(U|xresid)
.formula U|xtsel = "$,,id="+M|nkblatt^id+";res="+U|xresid+";@gruppe=1;@ablageart=(Both)"
.select costsheet 'U|xtsel'
.continue NOKBN                             ? _G|mehr
.select line 'selzeile'
.formula M|kblattid   = H|ekblatt^id       ? _F|empty(H|ekblatt)
..
!NOKBN: Vorkalkulation
.formula M|velem      = U|xelem
.formula M|vnamebspr  = M|velem^name
.formula M|vnamebspr  = M|velem^namebspr   ? F|defined(M|velem^namebspr)
.formula M|vekart     = U|xekart           ? _F|empty(U|xekart)
.formula M|vanzahl    = U|xvanzahl
.formula M|vele       = U|xele             ? _F|empty(U|xele)
.formula M|vegeinzk   = U|xvegeinzk
.formula M|veggemeink = U|xveggemeink
.formula M|veggesamk  = U|xveggesamk
.copy M|vevzeit  = U|xvevzeit
.continue NOKBV                             ? F|empty(U|xresid)
.formula U|xtsel = "$,,id="+M|vkblatt^id+";res="+U|xresid+";@gruppe=1;@ablageart=(Both)"
.select costsheet 'U|xtsel'
.continue NOKBV                             ? _G|mehr
.select line 'selzeile'
.formula M|vkblattid   = H|ekblatt^id      ? _F|empty(H|ekblatt)
..
!NOKBV:
.colour -foreground 'M|farbe1' -background 'M|farbe1'  elem       'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  ekart      'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  anzahl     'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  ele        'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  egeinzk    'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  eggemeink  'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  eggesamk   'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  evzeit     'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  efehler    'M|aktzeile' ? M|anzahl = 0 & M|vanzahl <> 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  velem      'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  vekart     'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  vanzahl    'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  vele       'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  vegeinzk   'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  veggemeink 'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  veggesamk  'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -foreground 'M|farbe1' -background 'M|farbe1'  vevzeit    'M|aktzeile' ? M|anzahl <> 0 & M|vanzahl = 0
.colour -background 'M|farbe6' eggesamk   'M|aktzeile' ? M|eggesamk > M|veggesamk & _(M|anzahl = 0 ; M|vanzahl = 0)
.colour -background 'M|farbe2' eggesamk   'M|aktzeile' ? M|eggesamk < M|veggesamk & _(M|anzahl = 0 ; M|vanzahl = 0)
.colour -background 'M|farbe2' veggesamk  'M|aktzeile' ? M|eggesamk > M|veggesamk & _(M|anzahl = 0 ; M|vanzahl = 0)
.colour -background 'M|farbe6' veggesamk  'M|aktzeile' ? M|eggesamk < M|veggesamk & _(M|anzahl = 0 ; M|vanzahl = 0)
.continue HV
..
!HVE:
.continue
..
!ERROR
.error Verdichtung gescheitert!
.end 1
..
!ERROR1
.error Sortierung gescheitert!
.end 1
