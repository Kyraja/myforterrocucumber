..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKVERG.CHART.PIE
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem VNKALKVERG, Diagramm-Anzeige
..*****************************************************************************
.set trans -
.chart -INIT
.chart -PARAM -CHARTTYPE PIE
.chart -PARAM -DECIMALSY 2
.chart -PARAM -TITLECHART "Vergleich"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel"
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOTOOLS
.chart -STARTVALUES Nachkalkulation
.chart -VALUE 'M|kmatk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|kfremdk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|kfixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|kvarfk' -RGBCOLOR 'M|farbe3'
.chart -STARTVALUES Vorkalkulation
.chart -VALUE 'M|vkmatk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|vkfremdk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|vkfixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|vkvarfk' -RGBCOLOR 'M|farbe3'
.chart -SHOW chart1 0
..*****************************************************************************
!END
.continue
