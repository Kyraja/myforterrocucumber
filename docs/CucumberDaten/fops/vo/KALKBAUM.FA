..!interpreter english translate noabbrev
..*****************************************************************************
..
..  FOP-Name       : KALKBAUM.FA
..  Datum          : 20.6.2004
..  Version        : 2004
..  Autor          : cl
..  Verantwortlich : tiwe
..  Kontrolle      : cl
..
..  Funktion       : Feldaustrittsfop KALKBAUM
..  Functionality  : Exit field FOP
..
..  include is/TABLEEREN
..*****************************************************************************
..
.set trans -
.assign M|ittyp     = ""
.formula M|herkunft = ""
.formula M|vnr      = ""
.continue KART     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kart"
.continue KBA      ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "betrieb"
.continue KAUF     ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kauftrag"
.continue KBEST    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kbestellung"
.continue NKAUF    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "baufnk"
.continue NKBEST   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "bbestnk"
.continue VKAUF    ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "baufvk"
.continue VKBEST   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "bbestvk"
.continue KBLATT   ? G|evtartengl = "FIELD_EXIT" & G|evtvar = "kblatt"
.continue ENDLG
..
!KART
.select add M|kart
.formula M|betrieb     = ""
.formula M|kbaart      = ""
.formula M|kauftrag    = ""
.formula M|kaufsuch    = ""
.formula M|kbestellung = ""
.formula M|kbestsuch   = ""
.formula M|kblatt      = ""
.continue ENDLG
..
!KBA
.continue ERROR2             ? M|betrieb /"\?"
.continue ERROR3 ? _F|empty(M|betrieb) & _(M|betrieb / "(0-9)*")
.formula M|kbaart      = ""
.formula M|kart        = ""
.formula M|kauftrag    = ""
.formula M|kaufsuch    = ""
.formula M|kbestellung = ""
.formula M|kbestsuch   = ""
.formula M|kblatt      = ""
.continue ENDLG
..
!KAUF
.formula M|kblatt      = ""
.select add M|kauftrag
.formula M|kaufsuch    = ""    ? _G|mehr
.formula M|kart        = ""
.formula M|betrieb     = ""
.formula M|kbaart      = ""
.formula M|kbestellung = ""
.formula M|kbestsuch   = ""
.continue ENDLG        ? _G|mehr
.continue ERROR        ? H|typ = G|reko ; H|typ = G|liko
.formula M|kaufsuch    = H|such
.continue ENDLG
..
!KBEST
.select add M|kbestellung
.formula M|kbestsuch   = ""     ? _G|mehr
.formula M|kart        = ""
.formula M|betrieb     = ""
.formula M|kbaart      = ""
.formula M|kauftrag    = ""
.formula M|kaufsuch    = ""
.formula M|kblatt      = ""
.continue ENDLG       ? _G|mehr
.continue ERROR1      ?  H|typ = G|reko ; H|typ = G|liko ; H|typ = G|anko
.formula M|kbestsuch   = H|such
.continue ENDLG
..
!KBLATT
.formula M|kart        = ""
.formula M|betrieb     = ""
.formula M|kbaart      = ""
.formula M|kauftrag    = ""
.formula M|kaufsuch    = ""
.formula M|kbestellung = ""
.formula M|kbestsuch   = ""
.continue ENDLG
..
!NKAUF
.copy M|baufvk = G|FALSE
.copy M|baufnk = G|TRUE
.continue ENDLG
..
!NKBEST
.copy M|bbestvk = G|FALSE
.copy M|bbestnk = G|TRUE
.continue ENDLG
..
!VKAUF
.copy M|baufnk = G|FALSE
.copy M|baufvk = G|TRUE
.continue ENDLG
..
!VKBEST
.copy M|bbestnk = G|FALSE
.copy M|bbestvk = G|TRUE
.continue ENDLG
..
!ENDLG
.input "is/TABLEEREN"
.continue
..
!ERROR
.formula M|kauftrag = ""
.error Bitte ein Angebot oder einen Auftrag wÑhlen.
.end 1
..
!ERROR1
.formula M|kbestellung = ""
.error Bitte eine Bestellung wÑhlen.
.end 1
..
!ERROR2
.formula M|betrieb = ""
.formula M|kbaart  = ""
.end 1
..
!ERROR3
.error -field M|betrieb -message UnzulÑssige Angabe fÅr einen Betriebsauftrag.
.formula M|betrieb = ""
.end 1

