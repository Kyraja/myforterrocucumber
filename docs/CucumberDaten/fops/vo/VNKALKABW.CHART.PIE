..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.CHART.PIE
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem VNKALKABW, Diagramm-Anzeige
..*****************************************************************************
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE PIE
.chart -PARAM -DECIMALSY 2
.chart -PARAM -TITLECHART "Vergleich Gesamtkosten"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel"
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOTOOLS
.chart -STARTVALUES "Nachkalkulation"
.chart -VALUE 'M|knmatk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|knfremdk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|knfixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|knvarfk' -RGBCOLOR 'M|farbe3'
.chart -STARTVALUES "Vorkalkulation"
.chart -VALUE 'M|kvmatk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|kvfremdk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|kvfixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|kvvarfk' -RGBCOLOR 'M|farbe3'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
