.set trans -
.type text xkomm:100  ? _F|defined(U|xkomm)
..
.continue VKFJ   ? G|evtvar = "vkfj"
.continue END
..
!VKFJ
.continue ERROR2 ? _F|filenotempty('M|journal')
.editing -readonly 'M|journal'
.continue END
..
!ERROR
.error Kein Kalkulationsblatt vorhanden.
.end 1
..
!ERROR2
.error Journal 'M|journal' ist nicht vorhanden.
.end 1
..
..*****************************************************************************
!END
.continue
