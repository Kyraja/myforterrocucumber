..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKVERG.CHART.BAR
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : zeigt Daten in einem Balken-Diagramm an
..*****************************************************************************
.set trans -
.chart -INIT
.chart -PARAM -CHARTTYPE BAR
.chart -PARAM -TITLECHART "Differenz Nachkalkulation Vorkalkulation"
.chart -PARAM -TITLEY "Kosten in EUR"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel"
.chart -PARAM -DECIMALSY 4
.chart -PARAM -CLUSTERED
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NOCOLOR
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOZOOM
.chart -PARAM -TOOLBAR NOTOOLS
.chart -PARAM -CONTEXTMENU NONE
.chart -STARTVALUES Differenz
.chart -VALUE 'M|dkmatk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|dkfremdk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|dkfixfk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|dkvarfk' -RGBCOLOR 'M|farbe3'
.chart -SHOW chart1 0
..*****************************************************************************
!END
.continue
