..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.KALK
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
.. Includes
..  include vo/VNKALKABW.RESETHEADER
..*****************************************************************************
.set trans -
.type DVM2 xinfosysout  ? _F|defined(U|xinfosysout)
.type DVM2 xinfosyserr  ? _F|defined(U|xinfosyserr)
.type DVM2 xtfilefin    ? _F|defined(U|xtfilefin)
.type text xtsys        ? _F|defined(U|xtsys)
..
.file -tempname U|xtfilefin 
.file -tempname U|xinfosysout
.file -tempname U|xinfosyserr
...
.output new 'U|xtfilefin'
.input "DATEI.F"
.set question ~
? D
.set question ?
.select screen header
..
!HMZ
.select screen line
.continue HMZE    ? _G|mehr
.continue HMZ     ? M|tkblatt <> "" & M|tvkblatt <> "" & G|evtvar = "kbukalk"
.set trans -
<r+>
<Abbruch>
<Abbruch>
<Abbruch>
<Abbruch>
<r->
<Einkauf> 'M|therkunft^id'
<zeigen>
.continue NONK  ? M|tkblatt <> "" & G|evtvar = "kbukalk"
<do><do>
<menue> Nachkalkulieren
<return>
..
!NONK:
.continue NOVK  ? M|tvkblatt <> "" & G|evtvar = "kbukalk"
<do><do>
<menue> Vorkalkulieren
<menue> Standard
<return>
..
!NOVK:
<Abbruch>
<Abbruch>
<Abbruch>
.continue HMZ
..
!HMZE:
.output
.formula U|xtsys = "EKSPASSWORT=" + 'G|einmalpw' + " export EKSPASSWORT;"
.formula U|xtsys = U|xtsys + "batchlg.sh LESELADER " + 'U|xtfilefin' + " 1> " + xinfosysout + " 2> " + xinfosyserr
.system 'U|xtsys' background
.continue ERROR ? _G|mehr
..
.. Tabelle leeren
.make screen line -- ? M|tzeilen > 0
.input "vo/VNKALKABW.RESETHEADER"
.continue
..
!ERROR
.formula U|xtsys = "test -s " + xinfosyserr
.system 'U|xtsys' background
.continue BREAK ? _G|mehr
.output
.input 'U|xinfosyserr'
..
!BREAK
.error Kalkulation abgebrochen!
..
.end 1
