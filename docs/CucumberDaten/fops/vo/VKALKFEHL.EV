..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : VKALKFEHL.EV
.. Datum/Date     : 14.10.08
.. Version        : 2009r2
.. Autor/Author   : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
..
.. Ablauf         :
..
.. Functionality  :
..
.. Program flow   :
.. Includes       :
.. include is/NICHTS.GEFUNDEN.BF
..*****************************************************************************
.set trans -
..
.input "is/TABLEEREN"
.continue VNR       ? G|evtartengl = "FIELD_EXIT"    & G|evtvar="vnr"
.continue ART       ? G|evtartengl = "FIELD_EXIT"    & G|evtvar="kart"
.continue BSTART    ? G|evtartengl = "BUTTON_AFTER" & G|evtvar="bstart"
.continue
..
!VNR: Kalkulationsnummer
.copy M|bstruktur = G|FALSE
.formula M|kblatt    = ""
.formula M|kart      = ""
.continue
..
!ART: Artikel
.copy M|bstruktur = G|TRUE
.formula M|vnr       = ""
.formula M|kblatt    = ""
.continue
..
!BSTART
.copy M|bstruktur = G|TRUE ? _F|empty(M|kblatt)
.formula M|select = ""
.formula M|select = "$,,vnr=="+'M|vnr'+";fehler=true;@ordnung=fehler,vnr,typ;@gruppe=1;@ablageart=(Both)"           ?  M|vnr<>0
.formula M|select = "$,,art="+'M|kart^id'+";typ<>(FinalCosting);@ordnung=art,typ,stand;@gruppe=1;@ablageart=(Both)" ? _F|empty(M|kart) 
.formula M|select = "$,,id="+'M|kblatt^id'                                                                          ? _F|empty(M|kblatt)
.input "is/HOL.LISTE"
.input "is/NICHTS.GEFUNDEN.BF"
.continue
