..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.CHART.PIE3
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Infosystem VNKALKABW, Diagramm-Anzeige
..*****************************************************************************
.set trans -
..
.chart -INIT
.chart -PARAM -CHARTTYPE PIE
.chart -PARAM -DECIMALSY 2
.chart -PARAM -TITLECHART "Vergleich Gemeinkosten"
.chart -PARAM -MARKERX "Materialkosten;Fremdleistungen;Fertigungskosten fix;Fertigungskosten variabel"
.chart -PARAM -TOOLBAR NOCHARTTYPE
.chart -PARAM -TOOLBAR NODATAEDITOR
.chart -PARAM -TOOLBAR NOCLUSTER
.chart -PARAM -TOOLBAR NOTOOLS
.chart -STARTVALUES Nachkalkulation
.chart -VALUE 'M|knmatgk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|knfremdgk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|knfixfgk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|knvarfgk' -RGBCOLOR 'M|farbe3'
.chart -STARTVALUES Vorkalkulation
.chart -VALUE 'M|kvmatgk' -RGBCOLOR 'M|farbe5'
.chart -VALUE 'M|kvfremdgk' -RGBCOLOR 'M|farbe4'
.chart -VALUE 'M|kvfixfgk' -RGBCOLOR 'M|farbe7'
.chart -VALUE 'M|kvvarfgk' -RGBCOLOR 'M|farbe3'
.chart -SHOW chart 0
..*****************************************************************************
!END
.continue
