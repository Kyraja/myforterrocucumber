..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : NKALKART.CHART.LINE2B
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : zeigt Daten in einem Linien-Diagramm an
..*****************************************************************************
.set trans -
... nur in GUI m”glich
.end 0 ? _G|grafik
..
.type text    xtcolor  ? _F|defined(U|xtcolor)
.type text    xtip     ? _F|defined(U|xtip)
.type R7.4    xmax     ? _F|defined(U|xmax)
.type R7.4    xvergl   ? _F|defined(U|xvergl)
.type integer xmarkerx ? _F|defined(U|xmarkerx)
.type integer xstepx   ? _F|defined(U|xstepx)
..
.formula U|xmax = 10
.formula U|xmarkerx = 0
..
!CHART
.chart -INIT
.chart -PARAM -CHARTTYPE LINES
.chart -PARAM -TITLECHART "Gemeinkosten"
.chart -PARAM -RGBBACKCOLOR 253 253 253
.chart -PARAM -TITLEX "Zeile"
.chart -PARAM -TITLEY "Wert Nachkalkulation"
..
!MARKERX
.formula U|xmarkerx = U|xmarkerx + 1
.chart -PARAM -MARKERX 'U|xmarkerx'
.continue MARKERX ? U|xmarkerx < M|tzeilen
..
!MATERIALKOSTEN
.formula U|xtcolor = "111 80 200"
.chart -STARTVALUES "Materialkosten" -ID "Materialkosten" -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE1: Materialkosten
.select screen line
.continue FREMDKOSTEN ? _G|mehr
.set trans +
.formula U|xtip = "BA" + ": " + 'M|tba'
.formula U|xtip = U|xtip + " ;" + "Kalkulation am" + ": " + 'M|tstand'
.formula U|xtip = U|xtip + " ;" + "Materialkosten" + ": " + 'M|tmatgk'
.set trans -
.chart -VALUE 'M|tmatgk' -TIP 'U|xtip'
.continue ZEILE1
..
!FREMDKOSTEN
.formula U|xtcolor = "0 127 255"
.chart -STARTVALUES "Fremdleistung" -ID "Fremdleistung" -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE2: Fremdleistung
.select screen line
.continue FIXFERTKOST ? _G|mehr
.set trans +
.formula U|xtip = "BA" + ": " + 'M|tba'
.formula U|xtip = U|xtip + " ;" + "Kalkulation am" + ": " + 'M|tstand'
.formula U|xtip = U|xtip + " ;" + "Fremdleistung" + ": " + 'M|tfremdgk'
.set trans -
.chart -VALUE 'M|tfremdgk' -TIP 'U|xtip'
.continue ZEILE2
..
!FIXFERTKOST
.formula U|xtcolor = "0 10 100"
.chart -STARTVALUES "Fertigungskosten fix" -ID "Fertigungskosten fix" -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE3: Fertigungskosten fix
.select screen line
.continue FERTKOSTVAR ? _G|mehr
.set trans +
.formula U|xtip = "BA" + ": " + 'M|tba'
.formula U|xtip = U|xtip + " ;" + "Kalkulation am" + ": " + 'M|tstand'
.formula U|xtip = U|xtip + " ;" + "Fertigungskosten fix" + ": " + 'M|tfixfgk'
.set trans -
.chart -VALUE 'M|tfixfgk' -TIP 'U|xtip'
.continue ZEILE3
..
!FERTKOSTVAR
.formula U|xtcolor = "0 0 192"
.chart -STARTVALUES "Fertigungskosten variabel" -ID "Fertigungskosten variabel" -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE4:
.select screen line
.continue HERSTELL ? _G|mehr
.set trans +
.formula U|xtip = "BA" + ": " + 'M|tba'
.formula U|xtip = U|xtip + " ;" + "Kalkulation am" + ": " + 'M|tstand'
.formula U|xtip = U|xtip + " ;" + "Fertigungskosten variabel" + ": " + 'M|tvarfgk'
.set trans -
.chart -VALUE 'M|tvarfgk' -TIP 'U|xtip'
.continue ZEILE4
..
!HERSTELL
.formula U|xtcolor = " 10 100 123"
.chart -STARTVALUES "Herstellungskosten" -ID "Herstellungskosten" -RGBCOLOR 'U|xtcolor' -POINTMARKER MARBLE
..
!ZEILE5: Herstellungskosten
.select screen line
.continue ENDE ? _G|mehr
.set trans +
.formula U|xtip = "BA" + ": " + 'M|tba'
.formula U|xtip = U|xtip + " ;" + "Kalkulation am" + ": " + 'M|tstand'
.formula U|xtip = U|xtip + " ;" + "Herstellungskosten" + ": " + 'M|thgk'
.set trans -
.chart -VALUE 'M|thgk' -TIP 'U|xtip'
..
.formula U|xvergl = 'M|thgk'
.formula U|xmax = 'M|thgk' ? U|xmax < U|xvergl
.continue ZEILE5
..
!ENDE
.formula U|xstepx = 5  ? M|tzeilen > 50
.formula U|xstepx = 10 ? M|tzeilen > 100
.chart -PARAM -MINMAXY 0 'U|xmax'
.chart -PARAM -STEPX 'U|xstepx'
.chart -PARAM -DECIMALSY 4
.chart -SHOW chart 0
.continue
