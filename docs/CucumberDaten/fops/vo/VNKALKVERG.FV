..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKVERG.FV
.. Datum          : 11.05.07
.. Version        : 2007
.. Autor          : cl
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       : Fertigungsvorschlag laden, um zu kalkulieren
.. Ablauf         :
.. Functionality  :
.. Program flow   :
.. Includes       :
..*****************************************************************************
.set trans -
.type text xtkomm ? _F|defined(U|xtkomm)
..
.continue ERROR1   ? F|empty(M|kba) & F|empty(M|kart)
.load 0 object 'M|fvsel^id'
.continue ERROR    ? _G|mehr
.continue ERROR2   ? 0|artex^id <> M|kart^id
..
!AENDERN
.load 0
.formula U|xtkomm = "<(Object)>"+M|fvsel^id+"<(Edit)>"
.continue END
..
!ERROR 
.error Kein Fertigungsvorschlag vorhanden.
.end 1
..
!ERROR1
.error Kein Betriebsauftrag oder Artikel eingetragen.
.end 1
..
!ERROR2
.error Kein Fertigungsvorschlag zu diesem Artikel vorhanden.
.end 1
..
!END
.end 0 'U|xtkomm'

