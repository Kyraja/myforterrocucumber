..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : VNKALKABW.FUSS
.. Autor          : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
.. Includes       :
.. include vo/VNKALKABW.CHART.BALK
.. include vo/VNKALKABW.CHART.BALK2
.. include vo/VNKALKABW.CHART.PIE
.. include vo/VNKALKABW.CHART.PIE2
.. include vo/VNKALKABW.CHART.PIE3
..*****************************************************************************
.set trans -
..
.. Werte in Maske ausgeben
.select screen header
.formula M|knmatek = U|xrknmatek
.colour -background 'M|farbe5' knmatek
.formula M|knfremdek = U|xrknfremdek
.colour -background 'M|farbe4' knfremdek
.formula M|knfixfek = U|xrknfixfek
.colour -background 'M|farbe7' knfixfek
.formula M|knvarfek = U|xrknvarfek
.colour -background 'M|farbe3' knvarfek
.formula M|knhek = U|xrknhek
.colour -background 'M|farbe2' knhek
.formula M|kvmatek = U|xrkvmatek
.colour -background 'M|farbe5' kvmatek
.formula M|kvfremdek = U|xrkvfremdek
.colour -background 'M|farbe4' kvfremdek
.formula M|kvfixfek = U|xrkvfixfek
.colour -background 'M|farbe7' kvfixfek
.formula M|kvvarfek = U|xrkvvarfek
.colour -background 'M|farbe3' kvvarfek
.formula M|kvhek = U|xrkvhek
.colour -background 'M|farbe2' kvhek
.formula M|knmatgk = U|xrknmatgk
.colour -background 'M|farbe5' knmatgk
.formula M|knfremdgk = U|xrknfremdgk
.colour -background 'M|farbe4' knfremdgk
.formula M|knfixfgk = U|xrknfixfgk
.colour -background 'M|farbe7' knfixfgk
.formula M|knvarfgk = U|xrknvarfgk
.colour -background 'M|farbe3' knvarfgk
.formula M|knhgk = U|xrknhgk
.colour -background 'M|farbe2' knhgk
.formula M|kvmatgk = U|xrkvmatgk
.colour -background 'M|farbe5' kvmatgk
.formula M|kvfremdgk = U|xrkvfremdgk
.colour -background 'M|farbe4' kvfremdgk
.formula M|kvfixfgk = U|xrkvfixfgk
.colour -background 'M|farbe7' kvfixfgk
.formula M|kvvarfgk = U|xrkvvarfgk
.colour -background 'M|farbe3' kvvarfgk
.formula M|kvhgk = U|xrkvhgk
.colour -background 'M|farbe2' kvhgk
.formula M|knmatk = U|xrknmatk
.colour -background 'M|farbe5' knmatk
.formula M|knfremdk = U|xrknfremdk
.colour -background 'M|farbe4' knfremdk
.formula M|knfixfk = U|xrknfixfk
.colour -background 'M|farbe7' knfixfk
.formula M|knvarfk = U|xrknvarfk
.colour -background 'M|farbe3' knvarfk
.formula M|knhk = U|xrknhk
.colour -background 'M|farbe2' knhk
.formula M|kvmatk = U|xrkvmatk
.colour -background 'M|farbe5' kvmatk
.formula M|kvfremdk = U|xrkvfremdk
.colour -background 'M|farbe4' kvfremdk
.formula M|kvfixfk = U|xrkvfixfk
.colour -background 'M|farbe7' kvfixfk
.formula M|kvvarfk = U|xrkvvarfk
.colour -background 'M|farbe3' kvvarfk
.formula M|kvhk = U|xrkvhk
.colour -background 'M|farbe2' kvhk
..
.. Berechnung der absoluten Abweichung - calculating absolute variance
.formula M|kamatek     = M|knmatek - M|kvmatek
.formula M|kafremdek   = M|knfremdek - M|kvfremdek
.formula M|kafixfek    = M|knfixfek - M|kvfixfek
.formula M|kavarfek    = M|knvarfek - M|kvvarfek
.formula M|kahek       = M|knhek - M|kvhek
.formula M|kamatgk     = M|knmatgk - M|kvmatgk
.formula M|kafremdgk   = M|knfremdgk - M|kvfremdgk
.formula M|kafixfgk    = M|knfixfgk - M|kvfixfgk
.formula M|kavarfgk    = M|knvarfgk - M|kvvarfgk
.formula M|kahgk       = M|knhgk - M|kvhgk
.formula M|kamatk      = M|knmatk - M|kvmatk
.formula M|kafremdk    = M|knfremdk - M|kvfremdk
.formula M|kafixfk     = M|knfixfk - M|kvfixfk
.formula M|kavarfk     = M|knvarfk - M|kvvarfk
.formula M|kahk        = M|knhk - M|kvhk
..
.colour -foreground 'M|farbe8' kamatek     ? M|kamatek <=0
.colour -foreground 'M|farbe9' kamatek     ? M|kamatek > 0
.colour -foreground 'M|farbe8' kafremdek   ? M|kafremdek <=0
.colour -foreground 'M|farbe9' kafremdek   ? M|kafremdek > 0
.colour -foreground 'M|farbe8' kafixfek    ? M|kafixfek <=0
.colour -foreground 'M|farbe9' kafixfek    ? M|kafixfek > 0
.colour -foreground 'M|farbe8' kavarfek    ? M|kavarfek <=0
.colour -foreground 'M|farbe9' kavarfek    ? M|kavarfek > 0
.colour -foreground 'M|farbe8' kahek       ? M|kahek <=0
.colour -foreground 'M|farbe9' kahek       ? M|kahek > 0
.colour -foreground 'M|farbe8' kamatgk     ? M|kamatgk <=0
.colour -foreground 'M|farbe9' kamatgk     ? M|kamatgk > 0
.colour -foreground 'M|farbe8' kafremdgk   ? M|kafremdgk <=0
.colour -foreground 'M|farbe9' kafremdgk   ? M|kafremdgk > 0
.colour -foreground 'M|farbe8' kafremdgk   ? M|kafremdgk <=0
.colour -foreground 'M|farbe9' kafremdgk   ? M|kafremdgk > 0
.colour -foreground 'M|farbe8' kafixfgk    ? M|kafixfgk <=0
.colour -foreground 'M|farbe9' kafixfgk    ? M|kafixfgk > 0
.colour -foreground 'M|farbe8' kavarfgk    ? M|kavarfgk <=0
.colour -foreground 'M|farbe9' kavarfgk    ? M|kavarfgk > 0
.colour -foreground 'M|farbe8' kahgk       ? M|kahgk <=0
.colour -foreground 'M|farbe9' kahgk       ? M|kahgk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe5' kamatk   ? M|kamatk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe5' kamatk   ? M|kamatk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe4' kafremdk ? M|kafremdk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe4' kafremdk ? M|kafremdk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe7' kafixfk  ? M|kafixfk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe7' kafixfk  ? M|kafixfk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe3' kavarfk  ? M|kavarfk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe3' kavarfk  ? M|kavarfk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe2' kahk     ? M|kahk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe2' kahk     ? M|kahk > 0
..
.. Berechnung der prozentualen Abweichung - calculating precentage variance
.formula M|kpmatek     = (((M|knmatek / M|kvmatek)-1.00) * 100.00 )     ? M|kvmatek<>0
.formula M|kpfremdek   = (((M|knfremdek / M|kvfremdek)-1.00) * 100.00 ) ? M|kvfremdek<>0
.formula M|kpfixfek    = (((M|knfixfek / M|kvfixfek)-1.00) * 100.00 )   ? M|kvfixfek<>0
.formula M|kpvarfek    = (((M|knvarfek / M|kvvarfek)-1.00) * 100.00 )   ? M|kvvarfek<>0
.formula M|kphek       = (((M|knhek / M|kvhek)-1.00) * 100.00 )         ? M|kvhek<>0
.formula M|kpmatgk     = (((M|knmatgk / M|kvmatgk)-1.00) * 100.00 )     ? M|kvmatgk<>0
.formula M|kpfremdgk   = (((M|knfremdgk / M|kvfremdgk)-1.00) * 100.00 ) ? M|kvfremdgk<>0
.formula M|kpfixfgk    = (((M|knfixfgk / M|kvfixfgk)-1.00) * 100.00 )   ? M|kvfixfgk<>0
.formula M|kpvarfgk    = (((M|knvarfgk / M|kvvarfgk)-1.00) * 100.00 )   ? M|kvvarfgk<>0
.formula M|kphgk       = (((M|knhgk / M|kvhgk)-1.00) * 100.00 )         ? M|kvhgk<>0
.formula M|kpmatk      = (((M|knmatk / M|kvmatk)-1.00) * 100.00 )       ? M|kvmatk<>0
.formula M|kpfremdk    = (((M|knfremdk / M|kvfremdk)-1.00) * 100.00 )   ? M|kvfremdk<>0
.formula M|kpfixfk     = (((M|knfixfk / M|kvfixfk)-1.00) * 100.00 )     ? M|kvfixfk<>0
.formula M|kpvarfk     = (((M|knvarfk / M|kvvarfk)-1.00) * 100.00 )     ? M|kvvarfk<>0
.formula M|kphk        = (((M|knhk / M|kvhk)-1.00) * 100.00 )           ? M|kvhk<>0
..
.formula M|kpmatek     = 999.99     ? M|kvmatek=0 & M|knmatek<>0
.formula M|kpfremdek   = 999.99     ? M|kvfremdek=0 & M|knfremdek<>0
.formula M|kpfixfek    = 999.99     ? M|kvfixfek=0 & M|knfixfek<>0
.formula M|kpvarfek    = 999.99     ? M|kvvarfek=0 & M|knvarfek<>0
.formula M|kphek       = 999.99     ? M|kvhek=0 & M|knhek<>0
.formula M|kpmatgk     = 999.99     ? M|kvmatgk=0 & M|knmatgk<>0
.formula M|kpfremdgk   = 999.99     ? M|kvfremdgk=0 & M|knfremdgk<>0
.formula M|kpfixfgk    = 999.99     ? M|kvfixfgk=0 & M|knfixfgk<>0
.formula M|kpvarfgk    = 999.99     ? M|kvvarfgk=0 & M|knvarfgk<>0
.formula M|kphgk       = 999.99     ? M|kvhgk=0 & M|knhgk<>0
.formula M|kpmatk      = 999.99     ? M|kvmatk=0 & M|knmatk<>0
.formula M|kpfremdk    = 999.99     ? M|kvfremdk=0 & M|knfremdk<>0
.formula M|kpfixfk     = 999.99     ? M|kvfixfk=0 & M|knfixfk<>0
.formula M|kpvarfk     = 999.99     ? M|kvvarfk=0 & M|knvarfk<>0
.formula M|kphk        = 999.99     ? M|kvhk=0 & M|knhk<>0
..
.colour -foreground 'M|farbe8' kpmatek     ? M|kpmatek <=0
.colour -foreground 'M|farbe9' kpmatek     ? M|kpmatek > 0
.colour -foreground 'M|farbe8' kpfremdek   ? M|kpfremdek <=0
.colour -foreground 'M|farbe9' kpfremdek   ? M|kpfremdek > 0
.colour -foreground 'M|farbe8' kpfixfek    ? M|kpfixfek <=0
.colour -foreground 'M|farbe9' kpfixfek    ? M|kpfixfek > 0
.colour -foreground 'M|farbe8' kpvarfek    ? M|kpvarfek <=0
.colour -foreground 'M|farbe9' kpvarfek    ? M|kpvarfek > 0
.colour -foreground 'M|farbe8' kphek       ? M|kphek <=0
.colour -foreground 'M|farbe9' kphek       ? M|kphek > 0
.colour -foreground 'M|farbe8' kpmatgk     ? M|kpmatgk <=0
.colour -foreground 'M|farbe9' kpmatgk     ? M|kpmatgk > 0
.colour -foreground 'M|farbe8' kpfremdgk   ? M|kpfremdgk <=0
.colour -foreground 'M|farbe9' kpfremdgk   ? M|kpfremdgk > 0
.colour -foreground 'M|farbe8' kpfremdgk   ? M|kpfremdgk <=0
.colour -foreground 'M|farbe9' kpfremdgk   ? M|kpfremdgk > 0
.colour -foreground 'M|farbe8' kpfixfgk    ? M|kpfixfgk <=0
.colour -foreground 'M|farbe9' kpfixfgk    ? M|kpfixfgk > 0
.colour -foreground 'M|farbe8' kpvarfgk    ? M|kpvarfgk <=0
.colour -foreground 'M|farbe9' kpvarfgk    ? M|kpvarfgk > 0
.colour -foreground 'M|farbe8' kphgk       ? M|kphgk <=0
.colour -foreground 'M|farbe9' kphgk       ? M|kphgk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe5' kpmatk   ? M|kpmatk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe5' kpmatk   ? M|kpmatk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe4' kpfremdk ? M|kpfremdk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe4' kpfremdk ? M|kpfremdk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe7' kpfixfk  ? M|kpfixfk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe7' kpfixfk  ? M|kpfixfk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe3' kpvarfk  ? M|kpvarfk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe3' kpvarfk  ? M|kpvarfk > 0
.colour -foreground 'M|farbe8' -background 'M|farbe2' kphk     ? M|kphk <=0
.colour -foreground 'M|farbe9' -background 'M|farbe2' kphk     ? M|kphk > 0
..
.set trans +
.formula M|kbemerk = "Alle KalkulationsblÑtter berÅcksichtigt"                          ? _U|xbnovkalk
.formula M|kbemerk = "NachkalkulationsblÑtter ohne Vorkalkulation nicht berÅcksichtigt" ?  U|xbnovkalk
.set trans -
..
.input "vo/VNKALKABW.CHART.PIE"
.input "vo/VNKALKABW.CHART.PIE2"
.input "vo/VNKALKABW.CHART.PIE3"
.input "vo/VNKALKABW.CHART.BALK"
.input "vo/VNKALKABW.CHART.BALK2"
.continue
