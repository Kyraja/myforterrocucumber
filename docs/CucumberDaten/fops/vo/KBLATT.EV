.type bool btab ? _F|defined(btab)
..
!LGOK
.set trans -
..---------------------------- Kopfteil/Header:--------------------------------
.continue NACHBEWERTEN  ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "nachbewert"
.continue N2ACHBEWERTEN ? G|evtartengl = "BUTTON_AFTER"  & G|evtvar = "nachbewert"
.continue BSTART        ? G|evtartengl = "BUTTON_BEFORE" & G|evtvar = "bstart"
.continue END
..-----------------------------------------------------------------------------
..
!NACHBEWERTEN
.end 0 "(Revalue)"
..
!N2ACHBEWERTEN
.continue BSTART
..
!BSTART
.continue END    ? _F|empty(M|kblatt)
.continue FEHLER ?  F|empty(M|kart) & F|empty(M|kba) & F|empty(M|kauftrag) & F|empty(M|kbestellung)
.continue END
..
!FEHLER
.continue FEHLER1 ? M|kaufart = "" & M|kbestart = ""
.continue END
..
!FEHLER1
.error Bitte einen Artikel oder einen Betriebsauftrag ausw„hlen.
.end 1
..
!END
.continue
