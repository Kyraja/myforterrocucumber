..!interpreter english translate noabbrev
..*****************************************************************************
.. FOP-Name       : NKALKART.BV.BSTART
.. Autor          : jn
.. Verantwortlich : tiwe
.. Kontrolle      : cl
.. Funktion       :
.. Functionality  :
..*****************************************************************************
..
.set trans -
.type date xdleer     ? _F|defined(U|xdleer)
..
.select screen header
..
.. Diagramm leeren
.chart -INIT
.chart -SHOW chart 0
..
.. Tabelle leeren
.make screen line -- ? M|tzeilen > 0
.continue ERROR1        ? M|kart=""
..
.. test validation of date area
.continue ERROR2            ? M|adatum > M|edatum & M|edatum <> U|xdleer & M|adatum <> U|xdleer
..
.. Genearating selection string
.formula M|select = "$,,@ablageart=(Both)"
.formula M|select = M|select + ";art="   + 'M|kart^id'
.formula M|select = M|select + ";stand=" + 'M|adatum:8' + "!" + 'M|edatum:8'
.formula M|select = M|select + ";typ="   + "(FinalCosting)"
.formula M|select = M|select + ";herkunft^dnr=4"
.formula M|select = M|select + ";herkunft^ablagef=1"      ? M|knurabgelegt
.continue
..
!ERROR1:
.error -field M|kart -message Bitte Artikel eingeben.
.end 1

!ERROR2:
.error -field M|adatum -message Zeitraum ist ungÅltig. Bitte Ñndern.
.end 1
