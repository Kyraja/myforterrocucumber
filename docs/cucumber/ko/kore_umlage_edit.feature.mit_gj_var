# *****************************************************************************
#  Name           : kore_umlage_edit.feature.mit_gj_var
#  Autor          : Silvia Warth
#  Verantwortlich : sih
#  Kontrolle      : uo
#  Funktion       : Test von Plausipruefungen in den Umlageobjekten der Kostenrechnung
#                   (Kostenstellenumlage, Kostenträgermonatsumlage, Kostenträgerjahresumlage)
#                   
#
# *****************************************************************************
@persistent
Feature: Plausitest Umlageobjekte der Kore
Background:
# Vorgaengertest arbeitet mit aktuellem Datum (15.08.`date +%y`)
# Platzhalter LFDGJ wird im Testbett durch das aktuelle Jahr ersetzt!
# LFDGJ
Given I set the fake date to "15.08.LFDGJ"

Scenario: 01 Aenderung GJ in Kostenstellenumlage - Nachfragen entsprechend beantworten
# Nachfrage bez. Umlagezeilen kopieren mit ja beantworten
Given I open an editor "ksum1" from table "(Assessment):(CostCenterAssessment)" with command "UPDATE" for record "1310"
And I respond with answer "ja" to the dialog with id "Umlagezeilen kopieren"
And I set field "gjahr" to "+1"
And I save the current editor

# Nachfrage bez. Umlagezeilen kopieren einschließlich Kopie der Verkehrszahlen der Umlagezeilen und Bezugsgröße kopieren mit ja beantworten
Given I open an editor "ksum2" from table "(Assessment):(CostCenterAssessment)" with command "UPDATE" for record "1440"
And I set field "vkzkopie" to "ja"
# And I respond with answer "ja" to the dialog with id "6603"
And I respond with answer "ja" to the dialog with id "Umlagezeilen kopieren"
And I set field "gjahr" to "+1"
And I save the current editor

Scenario: 02 Pruefung auf bereits vorhandene Umlage im Zeitraum
# Kostenstellenumlage - "Umlage für diese Kostenstelle bereits vorhanden"
Given I open an editor "ksum3" from table "(Assessment):(CostCenterAssessment)" with command "COPY" for record "1121"
Then setting field "ksab" to "1121" throws the exception "4616"
And I close the current editor

# Kostenträgermonatsumlage - "Monatsumlage für diese Kostenstelle bereits vorhanden"
Given I open an editor "ktmo1" from table "(Assessment):(CostObjectMonthlyAssessment)" with command "COPY" for record "10"
Then setting field "gmonat" to "4" throws the exception "5869"
And I close the current editor

# Kostenträgerjahresumlage - "Jahresumlage für diese Kostenstelle bereits vorhanden"
Given I open an editor "ktjaum1" from table "(Assessment):(CostObjectAnnualAssessment)" with command "COPY" for record "1510"
Then saving the current editor throws the exception "5872"

Scenario: 03 Eintrag Monat in Monatsumlage - pruefen, ob eingetragener Monat groesser als Anzahl bebuchbare Monate des GJ ist
# zunächst Starttermin Ist-ILV und Plan-ILV auf 2/20 in Firma TERM anpassen
Given I'm logged in with password "annette"
Given I enable the flag 71
Given I open an editor "termine" from table "(Company):(FinancialDates)" with command "UPDATE" for record "term"
And I set field "ilviststartgj" to "." 
And I set field "ilviststartgm" to "2"
And I set field "ilvplanstartgm" to "2"
And I save the current editor
Given I disable the flag 71
Given I'm logged in with password "sy"

# Eintrag Monat 13 - "Angegebener Zeitraum ungültig!"
Given I open an editor "ktmo2" from table "(Assessment):(CostObjectMonthlyAssessment)" with command "COPY" for record "11"
And I set field "nummer" to "14"
And I set field "ksab" to "1510"
Then setting field "gmon" to "13" throws the exception "3003"
And I close the current editor

# Eintrag Monat vor dem Startdatum Ist- oder Plan-ILV - "Zeitraum ist älter als das Startdatum der ILV."
Given I open an editor "ktmo3" from table "(Assessment):(CostObjectMonthlyAssessment)" with command "COPY" for record "11"
And I set field "nummer" to "15"
And I set field "ksab" to "1510"
Then setting field "gmon" to "1" throws the exception "1250"
And I close the current editor

Scenario: 04 Nachbewerten
And I run Revaluation

