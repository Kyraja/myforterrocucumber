..!interpreter english declaration noabbrev 
..============================================================================
..  Author             : M. Boch
..  Date of Creation   : 27.07.2026
..  Name               : c.FO2
..  Path/Pfad          : owev/DRUCKNACHARCHIV.FO2
..  Function           : Individuelles Druckfop, kopiert die erstellte PDF nach win/tmp
..                     : Nimmt den aktuellen Druckjop und kopiert das erstelle PDF zusÑtzlich in den Ordner TMP
..  required Paths     :
..  Menu Items         :
..  Mask Priority      :
..  for EFOP           :
..  Starting Ticket    :
..                     History of Changes
..                     ==================
.. Ticket of Change    : 
..
..============================================================================
..<META P|='P88:10' >

..<VAR folded>
.var text xtfile
.var text xtlogfile
.var text xtsys
.var text xtdir
..</VAR>

def main() {
.formula U|xtlogfile = "owev/DRUCK.ARCH.LOG"
.formula U|xtdir = "/mnt1/AblageDMS" + 'G|mandant'
.formula U|xtfile = 'U|xtdir' + "/" + 'M|dnr' + "_" + 'M|typa' + "_" + 'M|nummer' + ".PDF"

if (F|defined(M|typa)) {
    
    switch ('M|typ(L=":")') {
        case ("(BlanketOrder)") {
            .formula U|xtfile = 'U|xtdir' + "/RA_" + 'M|nummer' + ".PDF"
        }
        case ("(Quotation)") {
            .formula U|xtfile = 'U|xtdir' + "/AN_" + 'M|nummer' + ".PDF"
        }
        case ("(SalesOrder)") {
            .formula U|xtfile = 'U|xtdir' + "/AB_" + 'M|nummer' + ".PDF"
        }
        case ("(WebOrder)") {
            .formula U|xtfile = 'U|xtdir' + "/WO_" + 'M|nummer' + ".PDF"
        }
        case ("(ServiceQuotation)") {
            .formula U|xtfile = 'U|xtdir' + "/RAN_" + 'M|nummer' + ".PDF"
        }
        case ("(RepairOrder)") {
            .formula U|xtfile = 'U|xtdir' + "/REP_" + 'M|nummer' + ".PDF"
        }
        case ("(Opportunity)") {
            .formula U|xtfile = 'U|xtdir' + "/CH_" + 'M|nummer' + ".PDF"
        }
        case ("(PackingSlip)") {
            switch (G|evtmaske) {
                case (35) {
                    .formula U|xtfile = 'U|xtdir' + "/LS_" + 'M|nummer' + ".PDF"	
                }
                case (45) {
                    .formula U|xtfile = 'U|xtdir' + "/LSE_" + 'M|nummer' + ".PDF"
                }
            }
        }
        case ("(Invoice)") {
            switch (G|evtmaske) {
                case (36) {
                    .formula U|xtfile = 'U|xtdir' + "/RE_" + 'M|nummer' + ".PDF"  
                }
                case (46) {
                    .formula U|xtfile = 'U|xtdir' + "/REE_" + 'M|nummer' + ".PDF"
                }
            }
        }
        case ("(Request)") {
            .formula U|xtfile = 'U|xtdir' + "/AF_" + 'M|nummer' + ".PDF"
        }
        case ("(PurchaseOrder)") {
            .formula U|xtfile = 'U|xtdir' + "/BE_" + 'M|nummer' + ".PDF"
        }
        default {
            .break
        }
    }
    
    .. .output terminal
    .. .println -screen 'U|xtfile'
    .. .println -screen 'U|xtsys'
    
    .formula U|xtsys = "cp " + 'P|datname' + " " + 'U|xtfile'
    .system 'U|xtsys' background
        if (G|mehr) {
        .input "DATEI.F"
        .right 255
        .output addedto 'U|xtlogfile'
        .println Dokument 'M|dnr'_'M|typa'_'M|nummer' mit Befehl 'U|xtsys' Åbertragen - Datum: 'G|zeitpunkt' von 'G|bzeichen'
        .output
    }
}
