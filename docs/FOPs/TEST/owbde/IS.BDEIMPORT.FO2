..<BLOCK folded> pruefeOffeneLeistungsmeldung
def pruefeOffeneLeistungsmeldung() {

    .formula U|xbDublette = G|false

    .formula U|xtLeistungsmeldungSel = "$,,"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";ypersonal=" + 'M|ytpersonalnr'
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yaufgabe=" + 'M|ytFANummer'
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yazeit<>`"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yezeit=`"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yarbzeit=0"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";@gruppe=1"

    .load 9 'G|hdatname.U|kodatPROJECTSUITEMELDUNGEN' nolock 'U|xtLeistungsmeldungSel'

    if (G|mehr = G|false) {

        .formula U|xbDublette = G|true

        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Erneute Leistungsmeldung-Kommen Zeit trotzt offener Leistungsmeldung."
        .call fehlerMeldung()

        .formula U|xtAufgabenTitel = "Anfang ohne Ende"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";Art: Leistungsmeldung;Typ: Gehen;BDE-ID: " + 'M|ytbdezeit' + ";FA-Nummer: " + 'M|ytFANummer' + ";Neue Anfangszeit ohne Endzeit"

        .call AufgabeErzeugen()
    }

    .load 9
}
..</BLOCK>

..<BLOCK folded> AufgabeErzeugen
def AufgabeErzeugen() {

    .copy U|xtdollarstring = "$"
    .copy U|xbdebug = G|false
    .copy U|xbgts = G|false
    .copy U|xtgts = ""
    .copy U|xbnoimp = G|false
    .copy U|xbimp = G|false

    .call edpTmpFiles()
    .call edpKopf()

    .output ADDEDTO 'U|xtEdp1'

    .println -nomoreoptions EDI|1|NEW|86:6||||
    .println -nomoreoptions SFV|1|0|name|'U|xtAufgabenTitel'|
    .println -nomoreoptions SFV|1|0|beschr|'U|xtAufgabenText';'U|xtFehlerText'|    
    .println -nomoreoptions SFV|1|0|such|'U|xypdmsuch'|
    .println -nomoreoptions SFV|1|0|bearbeit|'U|xypdmma'|
    .println -nomoreoptions SFV|1|0|bestaet|'U|xypdmma'|
    
    .println -nomoreoptions SFV|1|0|ursache|'9|id'| ? F|defined(9|id)

    .output 

    .call edpFuss()
    .call edpAusfuehren()
    
    .formula M|ytAllEdpProtokoll = U|xttmp
    
    if (U|xbimp) {
        .copy M|ytaufgabe = G|true  
    } else {
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - FA-Nummer: " + 'M|ytFANummer' + " Aufgabe konnte nicht angelegt werden!"
        .call fehlerMeldung()
    }
}
..</BLOCK>

..<BLOCK folded> pruefeFANummerExistiert
def pruefeFANummerExistiert() {

    .formula U|xbDublette = G|false

    .call AScheinOderAAufgabe()

    if (U|xbAAufgabe = G|false & M|ytsatzart = "3") {

        .formula U|xbDublette = G|true

        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - FA-Nummer: " + 'M|ytFANummer' + " existiert nicht."
        .call fehlerMeldung()

        .formula U|xtAufgabenTitel = "FA-Nummer nicht vorhanden"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";FA-Nummer: " + 'M|ytFANummer' + ";BDE-ID: " + 'M|ytbdezeit' + ";Zur gemeldeten FA-Nummer wurde kein Datensatz gefunden"

        .call AufgabeErzeugen()
    }
}
..</BLOCK>

..<Block folded> AScheinOderAAufgabe
def AScheinOderAAufgabe() {
    .. Ermittel, ob FA-Nummer ein Arbeitsschein oder eine Projekt-Arbeitsaufgabe ist
    .formula U|xbASchein = G|false
    .formula U|xbAAufgabe = G|false
    ..
    ..    .formula U|xtSel = "$,,;nummer==" + 'M|ytFaNummer' + ";typ==2"
    ..    .load 9 nolock group "09:01" 'U|xtSel'
    ..    if (G|mehr = G|true) {
    ..        .formula U|xbASchein = G|true
    ..    }
    ..    .load 9
    ..
    .formula U|xtSel = "$,,;nummer==" + 'M|ytFaNummer'
    .load 9 nolock group "149:03" 'U|xtSel'
    if (G|mehr = G|true) {
        .formula U|xbAAufgabe = G|true
    }
    .load 9
}
..</Block>

..<BLOCK folded> Proz leistungsMeldGehenEpi
def leistungsMeldGehenEpi( ) { 
    
    if (U|xbASchein = G|true & U|xbAAufgabe = G|false) {
        .call AuftragszeitEndeErzeugen()
    }
    if (U|xbASchein = G|false & U|xbAAufgabe = G|true) {
        .call LeistungsmeldungEndeErzeugen()        
    }
    
    if (U|xbASchein = G|true & U|xbAAufgabe = G|true) {
        .. ?? was tun ??
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - FA-Nummer: " + 'M|ytFANummer' + " konnte nicht zugeordnet werden."
        .call fehlerMeldung()
    }
    if (U|xbAschein = G|false & U|xbAAufgabe = G|false) {
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - FA-Nummer: " + 'M|ytFANummer' + " existiert nicht."
        .call fehlerMeldung()
    }
} 
..</BLOCK>
..
..<BLOCK folded> Proz fehlerMeldung
def fehlerMeldung( ) { 
    .output ADDEDTO 'U|xtFehlerProt'
    .println 'U|xtZeilenFehlerText'
    .output 
    .file -fop -tempname U|xttmp
    .output NEW 'U|xttmp'
    .input DATEI.F
    .println 'U|xtZeilenFehlerText'
    .output 
    if (M|ytsatzart = "2") {
        .formula M|ytPersoEdpProtokoll = U|xttmp 
    } else {
        if (U|xbAAufgabe = G|true) {
            .formula M|ytLeistMeldEdpProtokoll = U|xttmp
        }
        if (U|xbASchein = G|true) {
            .formula M|ytAuftrZeitEdpProtokoll = U|xttmp
        }
    }
    .formula M|ytAllEdpProtokoll = U|xttmp
    
    
} 
..</BLOCK>
..
..<BLOCK folded> Proz leistungsMeldKommenEpi
def leistungsMeldKommenEpi( ) {
    ..: Kenner fÅr EDP festlegen
    .copy U|xtdollarstring = "$"
    .copy U|xbdebug = G|false
    .copy U|xbgts = G|true
    .copy U|xtgts = ""
    .copy U|xbnoimp = G|false
    .copy U|xbimp = G|false
    ..
    if (U|xbASchein = G|true & U|xbAAufgabe = G|false) {
        .call AuftragszeitStartErzeugen()
    }
    if (U|xbASchein = G|false & U|xbAAufgabe = G|true) {
        .call LeistungsmeldungStartErzeugen()        
    }
    
    if (U|xbASchein = G|true & U|xbAAufgabe = G|true) {
        .. ?? was tun ??
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - FA-Nummer: " + 'M|ytFANummer' + " konnte nicht zugeordnet werden."
        .call fehlerMeldung()        
    }
    if (U|xbAschein = G|false & U|xbAAufgabe = G|false) {
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - FA-Nummer: " + 'M|ytFANummer' + " existiert nicht."
        .call fehlerMeldung()
    }
} 
..</BLOCK>
..
..<BLOCK folded> Proz persoGehenEpi
..
def persoGehenEpi( ) { 
    .formula U|xtPersonalzeitSel = "$,,"
    .formula U|xtPersonalzeitSel = U|xtPersonalzeitSel + ";ma=" + 'M|ytpersonalnr'
    .formula U|xtPersonalzeitSel = U|xtPersonalzeitSel + ";enddat=`"
    .formula U|xtPersonalzeitSel = U|xtPersonalzeitSel + ";@gruppe=1"
    .load 9 'G|hdatname.U|kodatBDE' nolock 'U|xtPersonalzeitSel'  
    if (G|mehr) {
        .formula M|ytPersonalzeit = 9|id
        .formula U|xtIdPersoZeit = 9|id
        ..: Kenner fÅr EDP festlegen
        .copy U|xtdollarstring = "$"
        .copy U|xbdebug = G|false
        .copy U|xbgts = G|true
        .copy U|xtgts = ""
        .copy U|xbnoimp = G|false
        .copy U|xbimp = G|false

        .call edpTmpFiles ( ) 
        .call edpKopf ( ) 

        ..<BLOCK> EDP-Kîrper anlegen
        .output ADDEDTO 'U|xtEdp1'
        .println -nomoreoptions EDI|1|UPDATE||REF|'U|xtIdPersoZeit'||
        if (F|empty(9|bem)) {
            .formula U|xtBem = M|ytbdezeit
        } else {
            .formula U|xtBem = U|xtBem + " - " + M|ytbdezeit
        }        
        .. .println -nomoreoptions SFV|1|0|bem|'U|xtBem'| 
        .println -nomoreoptions SFV|1|0|yCamPlusGehtID|'M|ytbdezeit'|
        .println -nomoreoptions SFV|1|0|enddat|'M|ytdfirstdat'|
        .println -nomoreoptions SFV|1|0|endzeit|'U|xzUhrzeit'|
        .println -nomoreoptions SFV|1|0|yFehlerText||
        .output 
        ..</BLOCK>l
        .call edpFuss ( ) 
        .call edpAusfuehren ( ) 
        .formula M|ytPersoEdpProtokoll = U|xtEdp2
        if (U|xbimp) {
            .copy M|ytPersoErfolgreichVerarbeitet = G|true  
        } else {  
            
            ..<BLOCK folded> Der Fehler wird ausgelesen und dann in den Personaldatensatz geschrieben. (Mit Fopmode 0)
            .set separator #
            ..            .call fehlerAuslesen          ( ) 
            ..            .formula U|xtZeilenFehlerText = U|xtFehlerText
            ..            .call fehlerMeldung ( )
            .call edpTmpFiles ( )            
            ..<BLOCK folded> EDP-Kopf anlegen
            .output new 'U|xtEdp1'
            .input DATEI.F
            .println -nomoreoptions LGN|1|||3.33|||-|||
            .println -nomoreoptions SET|1|CHARSET|EKS|
            .println -nomoreoptions SET|1|ECHOMODE|1|
            .println -nomoreoptions SET|1|FOPMODE|0|
            .println -nomoreoptions SET|1|LANG|Deutsch|
            .println -nomoreoptions SET|1|LOCKBEHAVIOR|WAIT:2|
            .println -nomoreoptions SET|1|UPDATEMODE|STRICT|
            .println -nomoreoptions EDI|1|UPDATE||REF|'U|xtIdPersoZeit'|| 
            .println -nomoreoptions SFV|1|0|yFehlerText|'U|xtFehlerText'|
            .output 
            ..</BLOCK>
            .call edpFuss ( ) 
            .call edpAusfuehren ( )
            ..</BLOCK>
            .set separator
            .formula U|xtAufgabenTitel = "Auftragszeit Ende"            
            .call AufgabeErzeugen()
            
        }
        
        .load 9
    }
} 
..</BLOCK>
..
..<Block folded> AuftragszeitStartErzeugen
def AuftragszeitStartErzeugen() {
    .assign U|xvArbeitsSchein = M|ytFANummer
    .load 9 nolock add U|xvArbeitsSchein
    if (G|mehr = G|true) {
        .call edpTmpFiles ( ) 
        .call edpKopf ( )
        ..<BLOCK> EDP-Kîrper anlegen
        .output ADDEDTO 'U|xtEdp1'
        .println -nomoreoptions EDI|1|NEW|17:2|||| 
        .println -nomoreoptions SFV|1|0|ma|'M|ytpersonalnr'|
        .println -nomoreoptions SFV|1|0|asma|'9|nummer'|    
        .println -nomoreoptions SFV|1|0|anfdat|'M|ytdfirstdat'|
        .println -nomoreoptions SFV|1|0|anfzeit|'U|xzUhrzeit'|
        .println -nomoreoptions SFV|1|0|yCamPlusStartzeitID|'M|ytbdezeit'|
        .output 
        ..</BLOCK>
        .call edpFuss ( ) 
        .call edpAusfuehren ( ) 
        ..
        .formula M|ytAuftrZeitEdpProtokoll = U|xtEdp2
        if (U|xbimp) {
            .assign M|yAuftragszeit = U|xtgts
            .copy M|ytAuftrZeitErfolgreichVerarbeitet = G|true  
        } else {
            .call AufgabeErzeugen()
        }              
    } else {
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Arbeitsschein: " + 'M|ytFANummer' + " existiert nicht"
        .call fehlerMeldung()
        .formula U|xtAufgabenTitel = "Auftragszeit Start"       
        .call AufgabeErzeugen()
    }
    .load 9
}
..</Block>
