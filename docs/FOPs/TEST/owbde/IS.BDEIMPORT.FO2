        .formula U|xtAufgabenTitel = "Doppelte Leistungsmeldung Gehen"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";Art: Leistungsmeldung;Typ: Gehen;BDE-ID: " + 'M|ytbdezeit' + ";Datensatz-ID: " + '9|id'

        .call AufgabeErzeugen()
