    if (G|mehr) {

        .formula U|xbDublette = G|true

        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Personalzeit Gehen bereits vorhanden. Datensatz-ID: " + '9|id'
        .call fehlerMeldung()

        .formula U|xtAufgabenTitel = "Doppelte Personalzeit Gehen"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";Art: Personalzeit;Typ: Gehen;BDE-ID: " + 'M|ytbdezeit' + ";Datensatz-ID: " + '9|id'

        .call AufgabeErzeugen()
    }

    .load 9
}
..</BLOCK>

..<BLOCK folded> pruefeOffenePersoZeit
def pruefeOffenePersoZeit() {

    .formula U|xbDublette = G|false

    .formula U|xtSel = "$,,"
    .formula U|xtSel = U|xtSel + ";ma=" + 'M|ytpersonalnr'
    .formula U|xtSel = U|xtSel + ";enddat=`"
    .formula U|xtSel = U|xtSel + ";@gruppe=1"

    .load 9 'G|hdatname.U|kodatBDE' nolock 'U|xtSel'

    if (G|mehr) {

        .formula U|xbDublette = G|true

        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Erneute Personal-Kommen Zeit trotzt offener Personalzeit"
        .call fehlerMeldung()

        .formula U|xtAufgabenTitel = "Anfang ohne Ende"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";Art: Personalzeit;Typ: Gehen;BDE-ID: " + 'M|ytbdezeit' + ";Neue Anfangszeit ohne Endzeit"

        .call AufgabeErzeugen()
    }

    .load 9
}
..</BLOCK>

..<BLOCK folded> pruefeLeistungsmeldungKommenDublette
def pruefeLeistungsmeldungKommenDublette() {

    .formula U|xbDublette = G|false

    .formula U|xtSel = "$,,"
