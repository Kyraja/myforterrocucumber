..<Block folded> LeistungsmeldungStartErzeugen
def LeistungsmeldungStartErzeugen() {
    .assign U|xvArbeitsAufgabe = M|ytFANummer
    .. vorher noch prÅfen, ob Arbeitsaufgabe noch "In Bearbeitung"
    .. wenn nicht, Wert merken und auf "In Bearbeitung" setzen
    .load 9 nolock add U|xvArbeitsAufgabe
    if (G|mehr = G|true) {
        .formula U|xpStatus = ""
        if ('9|ystatus(L=":")' <> "(InProgress)") {
            .formula U|xpStatus = '9|ystatus^id'
            ..
            .select lock object '9|id'
            .formula H|ystatus = "(InProgress)"
            .rewrite 
            .select -
        } 
    }    
    .load 9
    ..
    .load 9 nolock add U|xvArbeitsAufgabe
    if (G|mehr) {     
        .call edpTmpFiles ( ) 
        .call edpKopf ( )
        ..<BLOCK> EDP-Kîrper anlegen
        .output ADDEDTO 'U|xtEdp1'
        .println -nomoreoptions EDI|1|NEW|147:1|||| 
        .println -nomoreoptions SFV|1|0|ypersonal|'M|ytpersonalnr'|
        .println -nomoreoptions SFV|1|0|yaufgabe|'9|id'|    
        .println -nomoreoptions SFV|1|0|yadatum|'M|ytdfirstdat'|
        .println -nomoreoptions SFV|1|0|yazeit|'U|xzUhrzeit'|
        .println -nomoreoptions SFV|1|0|yCamPlusStartzeitID|'M|ytbdezeit'|        
        .output 
        ..</BLOCK>
        .call edpFuss ( ) 
        .call edpAusfuehren ( ) 
        .. 
        .formula M|ytLeistMeldEdpProtokoll = U|xtEdp2
        if (U|xbimp) {
            .formula M|ytLeistungsmeldung = U|xtgts
            .copy M|ytLeistMeldErfolgreichVerarbeitet = G|true  
        } else {
            .call AufgabeErzeugen()
        }
        if (F|empty(U|xpStatus) = G|false) {
            .select lock object '9|id'
            .formula H|ystatus = 'U|xpStatus^id'
            .rewrite 
            .select -
        }
        .load 9
        ..
    } else {
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Aufgabe: " + 'M|ytFANummer' + " existiert nicht"
        .call fehlerMeldung()
        .formula U|xtAufgabenTitel = "Leistungsmeldung Start"       
        .call AufgabeErzeugen()
    }
}
..</Block>
