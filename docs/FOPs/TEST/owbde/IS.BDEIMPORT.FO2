..!interpreter english declaration noabbrev 
..============================================================================
..  Author             : uklag
..  Date of Creation   : 29.06.2026
..  Name               : IS.BDEIMPORT.FO2
..  Path/Pfad          : owbde/IS.BDEIMPORT.FO2
..  Function           : Verarbeitet die Zeilen mit Satzart 2 (=Personalzeit)
..  required Paths     :
..  Menu Items         :
..  Mask Priority      :
..  for EFOP           :
..  Starting Ticket    : AP 6.11.2
..                     History of Changes
..                     ==================
.. Ticket of Change    : 
..
..============================================================================
..<META P|='P88:10'>
..<META M|='owbde/BDEIMPORT'>

..<VAR folded>
.var text U|xtSys
.var text xtZeilenFehlerText
.var text xtImpDateiName
.var text xtFehlerProt
.var text xttmp
.var text xtBem
.var text xtFehlerText
.var text xtText
.var integer xiFileVar
.var text xtIdPersoZeit
.var text U|xtSel
.var text xtLeistungsmeldungSel
.var text xtAuftragszeitSel
.var Z xzUhrzeit
.var text xtPersonalzeitSel
.var text xtdummy
.var text xtsystem
.var text xtEdp5
.var text xtEdp4
.var text xtEdp3
.var text xtEdp2
.var text xtEdp1
.var bool xbimp
.var bool xbnoimp
.var text xtgts
.var bool xbgts
.var bool xbdebug
.var text xtdollarstring
.var p149:3 xvArbeitsAufgabe
.var P9:1 U|xvArbeitsSchein
.var P109:2 xpStatus
.var bool U|xbASchein
.var bool U|xbAAufgabe
.var bool U|xbDublette
.var text U|xtDublettenID
.var text U|xtAufgabenTitel
.var text U|xtAufgabenText
..</VAR>

def main() 
{
    .call inputStdFiles()
    switch (G|evtart) {
        case ("buttonnach") {
            ..<Block folded> Verarbeiten-Button
            switch (G|evtvar) {
                case ("yimportdatarecords") {
                    if (F|empty(M|ypsdname) = G|false) {
                        ..set trace +
                        .formula U|xtImpDateiName = M|ypsdname >$ "/"
                        .formula U|xtImpDateiName = F|regreplaceall(U|xtImpDateiName, "-", "")
                        .formula U|xtFehlerProt = "rmtmp/X." + -U|xtImpDateiName + "." + 'G|versionneu' + ".TMP"
                        ..
                        .output NEW 'U|xtFehlerProt'
                        .input DATEI.F
                        .output 
                        ..
                        .select screen header
                        .select screen line   
                        while (G|mehr) {
                            
                            if (F|empty(M|ytpersonalnr) = G|false) { 
                                .load 0 nolock group "11:01" 'M|ytpersonalnr'
                                if (G|mehr = G|true) {
                                    if (0|ykeinCamPlusImport = G|false) {
                                        .load 0
                                        .formula U|xzUhrzeit = 'M|ytfirstuhr' <$ ":"
                                        
                                        .call pruefeFANummerExistiert()
                                        if (U|xbDublette = G|false) {
                                            switch (M|ytsatzart) {
                                                case ("2") {
                                                    if (F|empty(M|ytPersonalzeit) = G|true) {
                                                        switch (M|ytstatus2) {
                                                            case ("K") {
                                                                .call pruefePersoKommenDublette()

                                                                if (U|xbDublette = G|false) {
                                                                    .call pruefeOffenePersoZeit()

                                                                    if (U|xbDublette = G|false) {
                                                                        .call persoKommenEpi()
                                                                    }
                                                                }
                                                            }
                                                            case ("G") {
                                                                .call pruefePersoGehenDublette()

                                                                if (U|xbDublette = G|false) {

                                                                    .call persoGehenEpi()
                                                                    
                                                                }                                  
                                                            }
                                                        }
                                                    }
                                                }
                                                
                                                case ("3") {  
                                                    if (F|empty(M|ytLeistungsmeldung) = G|true) {                              
                                                        switch (M|ytstatus2) {
                                                            case ("1") {               
                                                                .call pruefeLeistungsmeldungKommenDublette()

                                                                if (U|xbDublette = G|false) {
                                                                    
                                                                    .call pruefeOffeneLeistungsmeldung()

                                                                    if (U|xbDublette = G|false) {
                                                                        .call alleOffenenDatensaetzeAbschliessen ( )                                                                              
                                                                        .call leistungsMeldKommenEpi ( )
                                                                    }    
                                                                }                       
                                                            }
                                                            case ("3") {                                                                                 
                                                                .call pruefeLeistungsmeldungGehenDublette()

                                                                if (U|xbDublette = G|false) {

                                                                    .call leistungsMeldGehenEpi()
                                                                    
                                                                }                              
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            .load 0
                            .select screen line 
                        }
                        .formula U|xtSys = "rm -f " + 'M|ypsdname'
                        .system 'U|xtSys' background
                        .formula M|ypsdname = ""
                        ..
                        if (F|filenotempty('U|xtFehlerProt')) {
                            .formula U|xtSys = "cp " + 'U|xtFehlerProt' + " ./win/import/bde/imp.err/"
                            .system 'U|xtSys' background
                        }
                        ..
                        .formula M|yhinweis = "Verarbeitung beendet."
                    }
                }
            }   
            ..</Block>         
        }
    }
}

..<BLOCK folded> pruefePersoKommenDublette
def pruefePersoKommenDublette() {

    .formula U|xbDublette = G|false

    .formula U|xtSel = "$,,"
    .formula U|xtSel = U|xtSel + ";yCamPlusKommtID==" + 'M|ytbdezeit'

    .load 9 'G|hdatname.U|kodatBDE' nolock 'U|xtSel'

    if (G|mehr) {

        .formula U|xbDublette = G|true

        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Personalzeit Kommen bereits vorhanden. Datensatz-ID: " + '9|id'
        .call fehlerMeldung()

        .formula U|xtAufgabenTitel = "Doppelte Personalzeit Kommen"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";Art: Personalzeit;Typ: Kommen;BDE-ID: " + 'M|ytbdezeit' + ";Datensatz-ID: " + '9|id'

        .call AufgabeErzeugen()
    }

    .load 9
}
..</BLOCK>

..<BLOCK folded> pruefePersoGehenDublette
def pruefePersoGehenDublette() {

    .formula U|xbDublette = G|false

    .formula U|xtSel = "$,,"
    .formula U|xtSel = U|xtSel + ";yCamPlusGehtID==" + 'M|ytbdezeit'

