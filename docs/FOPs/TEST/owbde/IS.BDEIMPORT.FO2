..<BLOCK folded> Proz alleOffenenDatensaetzeAbschliessen
def alleOffenenDatensaetzeAbschliessen( ) { 
    ..: Alle Auftragszeiten schlie·en
    .formula U|xtAuftragszeitSel = "$,,"
    .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";ma=" + 'M|ytpersonalnr'
    .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";endzeit=`"
    .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";@gruppe=2"
    .load 9 'G|hdatname.U|kodatBDE' nolock 'U|xtAuftragszeitSel'  
    if (G|mehr) {
        ..: Kenner fÅr EDP festlegen
        .copy U|xtdollarstring = "$"
        .copy U|xbdebug = G|false
        .copy U|xbgts = G|false
        .copy U|xtgts = ""
        .copy U|xbnoimp = G|false
        .copy U|xbimp = G|false 
        .call edpTmpFiles ( )
        .call edpKopf ( )
        ..<BLOCK> EDP-Kîrper anlegen
        .output ADDEDTO 'U|xtEdp1'
        .println -nomoreoptions EDI|1|UPDATE||REF|'9|id'|| 
        .. .println -nomoreoptions SFV|1|0|endzeit|'9|anfzeit'|
        .println -nomoreoptions SFV|1|0|endzeit|'U|xzUhrzeit'|
        .println -nomoreoptions SFV|1|0|enddat|'M|ytdfirstdat'|
        .println -nomoreoptions SFV|1|0|sofort|1|
        .output 
        ..</BLOCK>
        .call edpFuss ( ) 
        .call edpAusfuehren ( ) 
        .load 9
    } 
    ..: Alle Leistungsmeldungen schlie·en
    .formula U|xtLeistungsmeldungSel = "$,,"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";ypersonal=" + 'M|ytpersonalnr'
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yazeit<>`"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yezeit=`"
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yarbzeit=0"
    ...formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";yaufgabe<>" + 'M|ytFANummer'
    .formula U|xtLeistungsmeldungSel = U|xtLeistungsmeldungSel + ";@gruppe=1"    
    .load 9 'G|hdatname.U|kodatPROJECTSUITEMELDUNGEN' nolock 'U|xtLeistungsmeldungSel'  
    if (G|mehr) {
        ..: Kenner fÅr EDP festlegen
        .copy U|xtdollarstring = "$"
        .copy U|xbdebug = G|false
        .copy U|xbgts = G|false
        .copy U|xtgts = ""
        .copy U|xbnoimp = G|false
        .copy U|xbimp = G|false
        .call edpTmpFiles ( )
        .call edpKopf ( )
        ..<BLOCK> EDP-Kîrper anlegen
        .output ADDEDTO 'U|xtEdp1'
        .println -nomoreoptions EDI|1|UPDATE||REF|'9|id'|| 
        .. .println -nomoreoptions SFV|1|0|yezeit|'9|yazeit'|
        .println -nomoreoptions SFV|1|0|yezeit|'U|xzUhrzeit'|
        .println -nomoreoptions SFV|1|0|yedatum|'M|ytdfirstdat'|
        .output 
        ..</BLOCK>
        .call edpFuss ( ) 
        .call edpAusfuehren ( ) 
        .load 9
    } 
} 
..</BLOCK>
