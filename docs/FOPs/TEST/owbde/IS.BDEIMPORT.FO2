        .call fehlerMeldung()

        .formula U|xtAufgabenTitel = "Doppelte Leistungsmeldung Kommen"
        .formula U|xtAufgabenText = "Personalnummer: " + 'M|ytpersonalnr' + ";Art: Leistungsmeldung;Typ: Kommen;BDE-ID: " + 'M|ytbdezeit' + ";Datensatz-ID: " + '9|id'

        .call AufgabeErzeugen()
    }

    .load 9
}
..</BLOCK>

..<BLOCK folded> pruefeLeistungsmeldungGehenDublette
