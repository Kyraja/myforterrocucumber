..<BLOCK folded> Proz inputStdFiles
def inputStdFiles( ) { 
    .input SPINNER.INI
    .input DEFAULT.INI
    ...input KKOMNAME.KONST
    .input KDATNAME.KONST
    ...input KAKTNAME.KONST 
} 
