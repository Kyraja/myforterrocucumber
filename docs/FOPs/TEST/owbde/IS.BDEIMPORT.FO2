..<Block folded> AuftragszeitEndeErzeugen
def AuftragszeitEndeErzeugen() {
    .assign U|xvArbeitsschein = M|ytFANummer
    .load 9 nolock add U|xvArbeitsSchein
    if (G|mehr = G|true) {
        ..: Kenner fÅr EDP festlegen
        .copy U|xtdollarstring = "$"
        .copy U|xbdebug = G|false
        .copy U|xbgts = G|true
        .copy U|xtgts = ""
        .copy U|xbnoimp = G|false
        .copy U|xbimp = G|false
        ..
        .formula U|xtAuftragszeitSel = "$,,"
        .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";ma=" + 'M|ytpersonalnr'
        .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";as==" + 'U|xvArbeitsschein^nummer'
        .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";endzeit=`"
        .formula U|xtAuftragszeitSel = U|xtAuftragszeitSel + ";@gruppe=2"
        .load 8 'G|hdatname.U|kodatBDE' nolock 'U|xtAuftragszeitSel' 
        if (G|mehr) {
            .call edpTmpFiles ( ) 
            .call edpKopf ( ) 

            ..<BLOCK> EDP-Kîrper anlegen
            .output ADDEDTO 'U|xtEdp1'
            .println -nomoreoptions EDI|1|UPDATE||REF|'8|id'||
            .println -nomoreoptions SFV|1|0|endzeit|'U|xzUhrzeit'|
            .println -nomoreoptions SFV|1|0|enddat|'M|ytdfirstdat'|
            .println -nomoreoptions SFV|1|0|yCamPlusEndezeitID|'M|ytbdezeit'|            
            .println -nomoreoptions SFV|1|0|sofort|1|
            .output 
            ..</BLOCK>
            .call edpFuss ( ) 
            .call edpAusfuehren ( ) 
            .formula M|ytAuftrZeitEdpProtokoll = U|xtEdp2
            if (U|xbimp) {
                .assign M|yAuftragszeit = U|xtgts
                .copy M|ytAuftrZeitErfolgreichVerarbeitet = G|true  
            }
            
            .load 8
        } 
    } else {
        .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " - Arbeitsschein: " + 'M|ytFANummer' + " existiert nicht"
        .call fehlerMeldung ( )
        .formula U|xtAufgabenTitel = "Auftragszeit Ende"       
        .call AufgabeErzeugen()
    } 
}
..</Block>
