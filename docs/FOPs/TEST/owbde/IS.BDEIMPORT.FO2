..<BLOCK folded> Fehler auslesen
def fehlerAuslesen( ) { 
    .. Fehler auslesen
    .formula U|xtFehlerText = ""
    .copy U|xtsystem = "grep 'ERROR' " + U|xtedp2 + " >" + U|xtedp3
    .system 'U|xtsystem' BACKGROUND
    ..
    .copy U|xtsystem = "grep 'Fehler\\n' " + U|xtedp2 + " >>" + U|xtedp3
    .system 'U|xtsystem' BACKGROUND
    ..
    .. .input 'U|xtedp3'
    ..
    .file -TEST -OPEN U|xiFileVar 'U|xtedp3'
    if (G|mehr) {
        .file -READ U|xiFileVar U|xtText^
        while (G|mehr) {
            if (U|xtText / "*ERROR*") {
                .formula U|xtText = U|xtText << "|ERROR"
                .formula U|xtText = U|xtText >$ "|"
                if (F|empty(U|xtFehlerText)) {
                    .formula U|xtFehlerText = U|xtText
                } else {
                    .formula U|xtFehlerText = U|xtFehlerText + ";" + U|xtText
                }
            } else {
                if (U|xtText / "*Fehler\\n*") {
                    .formula U|xtText = U|xtText >> "Fehler\n"
                    .formula U|xtText = U|xtText << "|"
                    if (F|empty(U|xtFehlerText)) {
                        .formula U|xtFehlerText = U|xtText
                    } else {
                        .formula U|xtFehlerText = U|xtFehlerText + ";" + U|xtText
                    }
                }
            }
            
            .file -READ U|xiFileVar U|xtText^
        }
        .file -CLOSE U|xiFileVar
    }
} 
..</Block>
..
..<BLOCK folded> Proz persoKommenEpi
def persoKommenEpi( ) {
    ..: Kenner fÅr EDP festlegen
    .copy U|xtdollarstring = "$"
    .copy U|xbdebug = G|false
    .copy U|xbgts = G|true
    .copy U|xtgts = ""
    .copy U|xbnoimp = G|false
    .copy U|xbimp = G|false

    .call edpTmpFiles ( ) 
    .call edpKopf ( ) 

    ..<BLOCK> EDP-Kîrper anlegen
    .output ADDEDTO 'U|xtEdp1'
    .println -nomoreoptions EDI|1|NEW|17:1|||| 
    .println -nomoreoptions SFV|1|0|ma|'M|ytpersonalnr'|
    .. .println -nomoreoptions SFV|1|0|bem|'M|ytbdezeit'|  
    .println -nomoreoptions SFV|1|0|yCamPlusKommtID|'M|ytbdezeit'|  
    .println -nomoreoptions SFV|1|0|anfdat|'M|ytdfirstdat'|
    .println -nomoreoptions SFV|1|0|anfzeit|'U|xzUhrzeit'|
    .output 
    ..</BLOCK>
    .call edpFuss ( ) 
    .call edpAusfuehren ( ) 
    .. 
    ..set debug +
    .formula M|ytPersoEdpProtokoll = U|xtEdp2
    if (U|xbimp) {
        .formula M|ytPersonalzeit = U|xtgts
        .copy M|ytPersoErfolgreichVerarbeitet = G|true  
    } else {
        .formula U|xtAufgabenTitel = "Auftragszeit Starten"       
        .call AufgabeErzeugen()        
    }
} 
..</BLOCK>
..
..<BLOCK folded> Proz edpAusfuehren
def edpAusfuehren( ) { 

    if (_U|xbnoimp) {
        if (U|xyservice & U|xbdebug & _G|batchmode) {
            .editing 'U|xtEdp1'
        }
        .copy U|xtsystem = "epi < " + U|xtEdp1 + " >" + U|xtEdp2
        .system 'U|xtsystem' PASSWORD BACKGROUND
        ..<BLOCK folded> Debugausgabe
        if (U|xyservice & U|xbdebug & _G|batchmode) {
            .editing 'U|xtEdp2'
        }
        ..</BLOCK>
        if (F|filenotempty('U|xtEdp2')) {
            ..<BLOCK folded> Testen ob Datensatz erfolgreich gespeichert (aktiv)
            .copy U|xtsystem = "grep 'Daten erfolgreich gespeichert' < " + U|xtEdp2 + " >" + U|xtEdp4
            .system 'U|xtsystem' BACKGROUND
            if (F|filenotempty('U|xtEdp4')) {
                .copy U|xbimp = G|true
                if (U|xbgts) {
                    ..  Jetzt noch die Nummer des gerade erstellten Lieferscheins auslesen
                    .copy U|xTSystem = "grep 'D|1|REF|' " + U|xtEdp2 + "|awk 'BEGIN{FS=" + G|dblquote + "|" + G|dblquote + "}{print " + 'U|xtdollarstring' + "4}' > " + U|xtEdp5
                    .copy U|xTSystem = U|xTSystem + "; test -s " + U|xtEdp5
                    .system 'U|xTSystem' BACKGROUND
                    if (F|filenotempty('U|xtEdp5')) {
                        .select from
                        .select from 'U|xtEdp5' U|xtdummy
                        if (G|mehr) {
                            .formula U|xtgts = U|xtdummy

                        }                                                        
                    }
                }
            } else {
                .call fehlerAuslesen()
                .formula U|xtZeilenFehlerText = "BDE-ID:" + 'M|ytbdezeit' + " : " + U|xtFehlerText
                .call fehlerMeldung()
            }
            ..</BLOCK>
        }
    }
} 
..</BLOCK>
..
..<BLOCK folded> Proz edpFuss
def edpFuss( ) { 
    .output ADDEDTO 'U|xtEdp1'
    .println -nomoreoptions COM|1|  
    .println -nomoreoptions GTS|1| 
    .println -nomoreoptions END|1|
    .output 
} 
..</BLOCK>
..
..<BLOCK folded> Proz edpTmpFiles
def edpTmpFiles( ) { 
    ..<BLOCK folded> TemporÑrdateien erstellen / initialisieren
    .file -TEMPNAME U|xtEdp1
    .file -TEMPNAME U|xtEdp2
    .file -TEMPNAME U|xtEdp3
    .file -TEMPNAME U|xtEdp4
    .file -TEMPNAME U|xtEdp5
    ..</BLOCK>
} 
..</BLOCK>
..
..<BLOCK folded> Proz edpKopf
def edpKopf( ) { 
    .output new 'U|xtEdp1'
    .input DATEI.F
    .println -nomoreoptions LGN|1|||3.33|||-|||
    .println -nomoreoptions SET|1|CHARSET|EKS|
    .println -nomoreoptions SET|1|ECHOMODE|1|
    .println -nomoreoptions SET|1|FOPMODE|1|
    .println -nomoreoptions SET|1|LANG|Deutsch|
    .println -nomoreoptions SET|1|LOCKBEHAVIOR|WAIT:2|
    .println -nomoreoptions SET|1|UPDATEMODE|STRICT|
    .output 
} 
..</BLOCK>
