..<META P|='P88:10'>

..<VAR folded>
.type text U|xtSys 
.type text U|xTempDatei 
.type text U|xCSVDatei 
..</VAR>

def main() {
    .file -tempname U|xTempDatei
    .input DATEI.F
    ..
    .formula U|xtSys = "ls -tr win/import/bde/imp/ >" + 'U|xTempDatei'
    .system 'U|xtSys' background
    ..
    .select from 'U|xTempdatei' U|xCSVDatei^
    while (G|mehr = G|true) {
        if (-U|xCSVDatei >> 4 = ".CSV") {
            ..
            .formula U|xCSVDatei = "./win/import/bde/imp/" + 'U|xCSVDatei' 
            .formula U|xtSys = "edpinfosys.sh -p " + 'G|einmalpw' + " -n BDEIMPORT -s ypsdname,bstart,yimportdatarecords -w " + 'G|dblquote' + 'U|xCSVDatei' + ";1;1;" + 'G|dblquote'            
            .system 'U|xtSys' background
            ..
            .formula U|xtSys = "sleep 5"
            .system 'U|xtSys' background
        }
        .select from 'U|xTempdatei' U|xCSVDatei^
    }
    .select from    
}
