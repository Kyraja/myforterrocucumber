..============================================================================
..<META P|='P88:10'>
..<META M|='owbde/BDEIMPORT'>

..<VAR folded>
.type text U|xtSys 
.type text U|xTempDatei 
.type text U|xCSVDatei 
.type bool U|xbTreffer 
..</VAR>

def main() {
    ..
    .formula M|ypsdname = ""
    ..
    .file -tempname U|xTempDatei
    .input DATEI.F
    ..
    .formula U|xtSys = "ls -tr win/import/bde/imp/ >" + 'U|xTempDatei'
    .system 'U|xtSys' background
    .. 
    .. .input 'U|xTempDatei'
    .formula U|xbTreffer = G|false
    .select from 'U|xTempdatei' U|xCSVDatei^
    while (G|mehr = G|true & U|xbTreffer = false) {
        if (-U|xCSVDatei >> 4 = ".CSV") {
            .formula M|ypsdname = "./win/import/bde/imp/" + 'U|xCSVDatei'
            .formula U|xbTreffer = G|true
        }
        .select from 'U|xTempdatei' U|xCSVDatei^
    }
    .select from
    if (F|empty(M|ypsdname) = G|true) {
        .box 
        .item "Es liegen keine Dateien zum Importieren im Verzeichnis win/import/bde/imp/ vor"
        .enditem
    }else{
    .input IS.BDEIMPORT.BSTART.BA.FO
    }
    
    
}
