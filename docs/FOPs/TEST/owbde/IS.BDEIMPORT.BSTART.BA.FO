..!interpreter english translate noabbrev
..*****************************************************************************
.. Name           : IS.BDEIMPORT.BSTART.BA.FO
.. Date           : 05.05.26
.. Version        : 2201r8n20p06
.. Author         : abas-dd
.. Functionality  : Import der der BDE-Zeit-Datei
..
.. Interface (arguments and their meaning)
..    uses array argument (arg.i)           : no
..    uses name argument  (xpname=value)    : no
..
..    Argument     meaning
..    -------------------------------------------------------------------------
..
.. Program flow   :
...Includes       :
..*****************************************************************************
..
..*****************************************************************************
.type text  U|xtimportdatei     ?  F|defined(U|xtimportdatei)  = G|false
.type text  U|xtsys             ?  F|defined(U|xtsys)          = G|false
.type text  U|xterr             ?  F|defined(U|xterr)          = G|false
.type bool  U|xbdebug           ?  F|defined(U|xbdebug)        = G|false
.type int   U|xizeile           ?  F|defined(U|xizeile)        = G|false
.type text  U|xtscrfilename     ?  F|defined(U|xtscrfilename)  = G|false
.type text  U|tmpfilename       ?  F|defined(U|tmpfilename)    = G|false
.type text  U|xtdstfilename     ?  F|defined(U|xtdstfilename)  = G|false
.type text  U|xtxtarchverz      ?  F|defined(U|xtxtarchverz)   = G|false
.type text  U|xtarchfilename    ?  F|defined(U|xtarchfilename) = G|false
.type text  U|xtsatzart         ?  F|defined(U|xtsatzart)      = G|false
.type text  U|xtpersonalnr      ?  F|defined(U|xtpersonalnr)   = G|false
.type text  U|xtbdezeit         ?  F|defined(U|xtbdezeit)      = G|false
.type text  U|xtfirstdat        ?  F|defined(U|xtfirstdat)     = G|false
.type text  U|xtfirstuhr        ?  F|defined(U|xtfirstuhr)     = G|false
.type text  U|xtstatus2         ?  F|defined( U|xtstatus2)     = G|false
.type text  U|xtProjekt
.type text  U|xtKST
.type text  U|xtFANummer
..
.type int     xi1 xi2 xidescriptor 
.type text    xt1 xt2 xt3 xt4 xt5 xt6 xt7 xt8 xt9 xt10 xt11 xt12 xt13 xt14 xt15 xt16 xt17 xt18 xt19 xt20 xt21 xt22 xt23 xt24 xt25 xt26 xt27 xt28 xt29 
.type text    xt30 xt31 xt32 xt33 xt34 xt35 xt36 xt37 xt38 xt39 xt40 xt41 xt42 xt43 xt44 xt45 xt46 xt47 xt48 xt49 xt50 xt51 xt52 xt53 xt54 xt55 xt56 xt57 xt58 xt59 
.type text    xt60 xt61 xt62 xt63 xt64 xt65 xt66 xt67 xt68 xt69 xt70 xt71 xt72 xt73 xt74 xt75 xt76 xt77 xt78 xt79 xt80 xt81 xt82 xt83 xt84 xt85 xt86 xt87 xt88 xt89 
.type text    xt90 xt91 xt92 xt93 xt94
..
.continue START ? F|empty(M|ypsdname) = G|false
..
.box
Bitte erst eine Importdatei auswÑhlen.
.continue
..
!START
.formula U|xbdebug = G|false
..
.formula U|xtscrfilename = 'M|ypsdname'
.formula U|xtdstfilename = "owbde/XBDEZEIT." + 'G|versionneu' + ".TMP"
..
.
... BDE-Datei in das Arbeitsverzeichnis kopieren
.formula U|xtsys = F|formatstr("cp -fp {1} {2}", 'U|xtscrfilename', 'U|xtdstfilename')
.system 'U|xtsys' background
.continue ERR1  ? _G|mehr
..
... Archivverzeichnis erstellen
.formula U|xtxtarchverz = "./win/import/bde/imp.arch/" + 'G|datum:8'
.formula U|xtsys = F|formatstr("mkdir -p {1}" , 'U|xtxtarchverz')
.system 'U|xtsys' background
.continue ERR2  ? _G|mehr
..
... BDE-Import-Datei verschieben in das Archiv
.formula U|xtsys = F|formatstr("cp -fp {1} {2}", 'U|xtscrfilename', 'U|xtxtarchverz'+ "/" + 'U|xtarchfilename')
.system 'U|xtsys' background
.continue ERR3  ?  _G|mehr
..
.file -open U|xidescriptor 'U|xtdstfilename'
.continue ERR4  ? _G|mehr
.file -READ U|xidescriptor xt1 ; xt2 ; xt3 ; xt4 ; xt5 ; xt6 ; xt7 ; xt8 ; xt9 ; xt10 ; xt11 ; xt12 ; xt13 ; xt14 ; xt15 ; xt16 ; xt17 ; xt18 ; xt19 ; xt20 ; xt21 ; xt22 ; xt23 ; xt24 ; xt25 ; xt26 ; xt27 ; xt28 ; xt29 ; xt30 ; xt31 ; xt32 ; xt33 ; xt34 ; xt35 ; xt36 ; xt37 ; xt38 ; xt39 ; xt40 ; xt41 ; xt42 ; xt43 ; xt44 ; xt45 ; xt46 ; xt47 ; xt48 ; xt49 ; xt50 ; xt51 ; xt52 ; xt53 ; xt54 ; xt55 ; xt56 ; xt57 ; xt58 ; xt59 ; xt60 ; xt61 ; xt62 ; xt63 ; xt64 ; xt65 ; xt66 ; xt67 ; xt68 ; xt69 ; xt70 ; xt71 ; xt72 ; xt73 ; xt74 ; xt75 ; xt76 ; xt77 ; xt78 ; xt79 ; xt80 ; xt81 ; xt82 ; xt83 ; xt84 ; xt85 ; xt86 ; xt87 ; xt88 ; xt89 ; xt90 ; xt91 ; xt92 ; xt93^
..
...** Erste Zeile wird Åbersprungen
...** lîschen Tabellenzeilen bei erneuten Import
.input ARB
.input is/TABLEEREN
!WHILE: Lesen der Zeilen
.file -read U|xidescriptor xt1 ; xt2 ; xt3 ; xt4 ; xt5 ; xt6 ; xt7 ; xt8 ; xt9 ; xt10 ; xt11 ; xt12 ; xt13 ; xt14 ; xt15 ; xt16 ; xt17 ; xt18 ; xt19 ; xt20 ; xt21 ; xt22 ; xt23 ; xt24 ; xt25 ; xt26 ; xt27 ; xt28 ; xt29 ; xt30 ; xt31 ; xt32 ; xt33 ; xt34 ; xt35 ; xt36 ; xt37 ; xt38 ; xt39 ; xt40 ; xt41 ; xt42 ; xt43 ; xt44 ; xt45 ; xt46 ; xt47 ; xt48 ; xt49 ; xt50 ; xt51 ; xt52 ; xt53 ; xt54 ; xt55 ; xt56 ; xt57 ; xt58 ; xt59 ; xt60 ; xt61 ; xt62 ; xt63 ; xt64 ; xt65 ; xt66 ; xt67 ; xt68 ; xt69 ; xt70 ; xt71 ; xt72 ; xt73 ; xt74 ; xt75 ; xt76 ; xt77 ; xt78 ; xt79 ; xt80 ; xt81 ; xt82 ; xt83 ; xt84 ; xt85 ; xt86 ; xt87 ; xt88 ; xt89 ; xt90 ; xt91 ; xt92 ; xt93^
.continue END  ?  _G|mehr
.formula U|xtsatzart    =  ""
.formula U|xtpersonalnr =  ""
.formula U|xtbdezeit    =  ""
.formula U|xtfirstdat   =  ""
.formula U|xtfirstuhr   =  ""
.formula U|xtstatus2    =  ""
.formula U|xtProjekt    =  ""
.formula U|xtKST        =  ""
.formula U|xtFANummer   =  ""
..
.formula U|xtsatzart    =  'U|xt1'
.formula U|xtbdezeit    =  'U|xt9'
.formula U|xtpersonalnr =  'U|xt10'
.formula U|xtfirstdat   =  'U|xt11'
.formula U|xtfirstuhr   =  'U|xt12'
.formula U|xtstatus2    =  'U|xt41'
.formula U|xtProjekt    =  'U|xt37'
.formula U|xtKST        =  'U|xt25'
.formula U|xtFANummer   =  'U|xt16'
.println -screen <'U|xtsatzart'>|<'U|xtpersonalnr'>|<'U|xtbdezeit'>|<'U|xtfirstdat'>|<'U|xtfirstuhr'>|<'U|xtstatus2'>|  ?  U|xbdebug
.make screen line +O
.formula M|ytsatzart     =  'U|xt1'
.formula M|ytbdezeit     =  'U|xt9'
.formula M|ytpersonalnr  =  'U|xt10'
.formula M|ytdfirstdat   =  'U|xt11'
.formula M|ytfirstuhr    =  'U|xt12'
.formula M|ytstatus2     =  'U|xt41'
.formula M|ytProjekt     =  'U|xt37'
.formula M|ytKST         =  'U|xt25'
.formula M|ytFANummer    =  'U|xt16'
.continue WHILE
.continue
..
!END:
..
...** Kopffelder fÅllen
.assign  M|ypezeich  =  'G|bzeichen'
.formula M|ypsdftext =  'U|xtdstfilename'
..
... Nach erfolgreichen Import die temporÑre Datei lîschen
.formula U|xtsys = F|formatstr("rm {1}", 'U|xtdstfilename')
.system 'U|xtsys' background
.continue ERR5  ?  _G|mehr
.formula U|xterr   = "Erfolgreich in das Infosystem importiert."
.assign M|yhinweis = 'U|xterr'
.continue
..
!ERR1: Datei kopieren
.formula U|xterr   = "Kopieren der BDE-Datei fehlgeschlagen."
.assign M|yhinweis = 'U|xterr'
.error 'U|xterr'
.continue
..
!ERR2: Archivverzeichnis erstellen
.formula U|xterr   = "Archivverzeichnis erstellen fehlgeschlagen."
.assign M|yhinweis = 'U|xterr'
.error 'U|xterr'
.continue
..
!ERR3:  BDE-Import-Datei verschieben in das Archiv
.formula U|xterr   = " BDE-Import-Datei verschieben in das Archiv fehlgeschlagen."
.assign M|yhinweis = 'U|xterr'
.error 'U|xterr'
.continue
..
!ERR4: Datei îffnen
.formula U|xterr   = "ôffnen der BDE-Datei fehlgeschlagen."
.assign M|yhinweis = 'U|xterr'
.error 'U|xterr'
.continue
..
!ERR5: Datei im owbde Verzeichnis lîschen
.formula U|xterr   = "Lîschen der temporÑren BDE-Datei fehlgeschlagen."
.assign M|yhinweis = 'U|xterr'
.error 'U|xterr'
.continue

