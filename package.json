{
  "name": "cucumbergnerator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"const f='dist/index.html';let h=require('fs').readFileSync(f,'utf8');h=h.replace('type=\\\"module\\\" crossorigin ','defer ');require('fs').writeFileSync(f,h)\"",
    "build:pack": "vite build && node -e \"const f='dist/index.html';let h=require('fs').readFileSync(f,'utf8');h=h.replace('type=\\\"module\\\" crossorigin ','defer ');require('fs').writeFileSync(f,h)\"",
    "lint": "eslint .",
    "serve": "node server.js",
    "build:resources": "node scripts/prepare-build-resources.cjs",
    "build:exe": "npm run build:pack && nexe server.cjs -o build/cucumbergenerator.exe -t windows-x64-14.15.3 -r \"dist/**/*\" && node scripts/set-exe-icon.cjs && npm run build:resources",
    "preview": "vite preview",
    "i18n:export": "node scripts/export-i18n.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "docx": "^9.5.3",
    "gpt-tokenizer": "^2.9.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.7.0",
    "nexe": "^5.0.0-beta.4",
    "resedit-cli": "^3.1.0",
    "rollup": "^4.60.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.2"
  }
}
