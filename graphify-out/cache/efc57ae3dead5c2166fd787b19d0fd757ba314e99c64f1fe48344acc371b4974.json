enerator2\\src\\hooks\\useProcessFlow.ts", "source_location": "L190"}, {"caller_nid": "useprocessflow_useprocessflow", "callee": "find", "source_file": "E:\\DEV\\cucumbergenerator2\\src\\hooks\\useProcessFlow.ts", "source_location": "L195"}, {"caller_nid": "useprocessflow_useprocessflow", "callee": "find", "source_file": "E:\\DEV\\cucumbergenerator2\\src\\hooks\\useProcessFlow.ts", "source_location": "L196"}, {"caller_nid": "useprocessflow_useprocessflow", "callee": "reverse", "source_file": "E:\\DEV\\cucumbergenerator2\\src\\hooks\\useProcessFlow.ts", "source_location": "L196"}, {"caller_nid": "useprocessflow_useprocessflow", "callee": "(() => {\n    if (!diagramFlow) return null;\n    if (activeStep) {\n      const allItems = activeStep.items ?? [];\n      const lastItem = allItems[allItems.length - 1];\n      const itemName = lastItem?.name ? ` \"${lastItem.name}\"` : '';\n      // Show count if multiple items accumulated\n      const countHint = allItems.length > 1 ? ` (${allItems.length})` : '';\n      return `${activeStep.labelDe}${itemName}${countHint} \u2026`;\n    }\n    if (lastDone) {\n      const workSteps = diagramFlow.steps.filter(s => s.type !== 'branch' && s.type !== 'start' && s.type !== 'end');\n      const allDone = workSteps.every(s => s.status === 'done');\n      if (allDone) {\n        const total = workSteps.find(s => s.id === 'result-ok')?.items?.length ?? 0;\n        return total > 0 ? `\u2713 Fertig \u2014 ${total} AP${total !== 1 ? 's' : ''} generiert` : `\u2713 Abgeschlossen`;\n      }\n      return `${lastDone.labelDe} \u2713`;\n    }\n    return null;\n  })", "source_file": "E:\\DEV\\cucumbergenerator2\\src\\hooks\\useProcessFlow.ts", "source_location": "L197"}]}